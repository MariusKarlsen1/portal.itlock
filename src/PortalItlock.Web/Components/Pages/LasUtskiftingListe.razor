@page "/lasutskifting"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Sjekkliste - utskiftning av lås</PageTitle>

<h1>Sjekkliste - utskiftning av lås</h1>
<p>Mål og registrer dør, karm og hengsling ved utskiftning av lås. Trykk "Ny sjekkliste" for å registrere en ny.</p>

<a class="new-button" href="lasutskifting/ny">Ny sjekkliste</a>

@if (_lister.Count == 0)
{
    <p class="list-empty">Ingen sjekklister registrert ennå.</p>
}
else
{
    <ul class="lasutskifting-list">
        @foreach (var l in _lister)
        {
            <li>
                <a class="lasutskifting-row" href="@($"lasutskifting/{l.Id}")">
                    <span class="lasutskifting-navn">@l.Navn</span>
                    <span class="lasutskifting-meta">@(l.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private sealed class ListeRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public DateTime? Dato { get; set; }
    }

    private List<ListeRad> _lister = [];

    protected override async Task OnInitializedAsync()
    {
        _lister = await Db.LasUtskiftinger
            .OrderByDescending(l => l.OpprettetDato)
            .Select(l => new ListeRad
            {
                Id = l.Id,
                Navn = l.Navn,
                Dato = l.Dato
            })
            .ToListAsync();
    }
}
