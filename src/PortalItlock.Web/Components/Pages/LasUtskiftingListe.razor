@page "/lasutskifting"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Sjekkliste - utskiftning av lås</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Sjekkliste - utskiftning av lås</h1>
            <p class="section-hint">Mål og registrer dør, karm og hengsling ved utskiftning av lås.</p>
        </div>
    </div>
    <a class="knapp knapp-primaer" href="lasutskifting/ny"><Icon Name="plus" />Ny sjekkliste</a>
</div>

<div class="lu-faner">
    <button type="button" class="lu-fane @(!_visArkivert ? "lu-fane-aktiv" : "")" @onclick="@(() => VelgFane(false))">
        Ny <span class="lu-fane-badge">@AntallNy</span>
    </button>
    <button type="button" class="lu-fane @(_visArkivert ? "lu-fane-aktiv" : "")" @onclick="@(() => VelgFane(true))">
        Arkivert <span class="lu-fane-badge">@AntallArkivert</span>
    </button>
</div>

@{
    var synlige = _lister.Where(l => l.Arkivert == _visArkivert).ToList();
    var filtrertOgSortert = FiltrertOgSortert(synlige);
    var totalSider = Math.Max(1, (int)Math.Ceiling(filtrertOgSortert.Count / (double)_sideStorrelse));
    if (_sideNummer > totalSider)
    {
        _sideNummer = totalSider;
    }
    var sideSynlig = filtrertOgSortert.Skip((_sideNummer - 1) * _sideStorrelse).Take(_sideStorrelse).ToList();
}

@if (synlige.Count == 0)
{
    <div class="lu-tom-kort">
        <div class="lu-tom-tekst">
            <span class="lu-tom-strek"></span>
            <h2>@(_visArkivert ? "Ingen arkiverte sjekklister" : "Ingen sjekklister enda")</h2>
            <p>
                @if (_visArkivert)
                {
                    <text>Sjekklister arkiveres automatisk 14 dager etter datoen som er satt på dem. Når det skjer, finner du dem her.</text>
                }
                else
                {
                    <text>Opprett en ny sjekkliste for å måle og registrere dør, karm og hengsling ved utskiftning av lås. Da har du alle målene samlet når låsen skal bestilles.</text>
                }
            </p>
            @if (!_visArkivert)
            {
                <div class="lu-tom-knapper">
                    <a class="knapp knapp-primaer" href="lasutskifting/ny"><Icon Name="plus" />Ny sjekkliste</a>
                </div>
            }
        </div>
        <div class="lu-tom-illustrasjon" aria-hidden="true">
            <svg viewBox="0 0 300 240" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="150" cy="140" rx="128" ry="86" fill="var(--itlock-accent)" opacity="0.07" />
                <circle cx="58" cy="58" r="32" fill="var(--itlock-accent)" opacity="0.06" />
                <path d="M20 205c40-14 220-14 260 0" stroke="var(--itlock-border)" stroke-width="2" stroke-dasharray="3 6" stroke-linecap="round" />

                <circle cx="248" cy="44" r="3" fill="var(--itlock-accent)" opacity="0.3" />
                <circle cx="68" cy="32" r="2.4" fill="var(--itlock-accent)" opacity="0.3" />
                <circle cx="226" cy="156" r="2.6" fill="var(--itlock-accent)" opacity="0.3" />

                @* Dør med karm, hengsler og låskasse *@
                <g transform="translate(74 36)">
                    <rect x="0" y="0" width="104" height="168" rx="8" fill="#ffffff" stroke="var(--itlock-accent)" stroke-width="2.5" />
                    <rect x="11" y="11" width="82" height="146" rx="5" stroke="var(--itlock-border)" stroke-width="2" />

                    @* Hengsler *@
                    <rect x="-4" y="30" width="8" height="20" rx="2.5" fill="var(--itlock-accent)" />
                    <rect x="-4" y="118" width="8" height="20" rx="2.5" fill="var(--itlock-accent)" />

                    @* Låskasse med sylinder og vrider *@
                    <rect x="88" y="74" width="16" height="36" rx="4" fill="var(--itlock-accent)" />
                    <circle cx="96" cy="86" r="3.2" fill="#ffffff" />
                    <rect x="92" y="96" width="8" height="9" rx="2" fill="#ffffff" opacity="0.75" />
                </g>

                @* Målebånd som måler dørbredden *@
                <g transform="translate(74 220)">
                    <path d="M0 0h104" stroke="var(--itlock-accent)" stroke-width="2.2" stroke-linecap="round" />
                    <path d="M0-6v12M104-6v12" stroke="var(--itlock-accent)" stroke-width="2.2" stroke-linecap="round" />
                </g>

                @* Sjekkliste-ark foran døren *@
                <g transform="translate(176 92) rotate(7)">
                    <rect x="0" y="0" width="92" height="112" rx="10" fill="#ffffff" stroke="var(--itlock-accent)" stroke-width="2.5" />
                    <rect x="28" y="-9" width="36" height="18" rx="5" fill="var(--itlock-accent)" />

                    <g transform="translate(15 32)">
                        <rect x="0" y="0" width="13" height="13" rx="4" fill="var(--itlock-accent)" />
                        <path d="M2.8 6.5 5.6 9.3 10.4 3.9" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <rect x="21" y="4" width="41" height="5" rx="2.5" fill="var(--itlock-border)" />
                    </g>
                    <g transform="translate(15 58)">
                        <rect x="0" y="0" width="13" height="13" rx="4" fill="var(--itlock-accent)" />
                        <path d="M2.8 6.5 5.6 9.3 10.4 3.9" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <rect x="21" y="4" width="41" height="5" rx="2.5" fill="var(--itlock-border)" />
                    </g>
                    <g transform="translate(15 84)">
                        <rect x="0" y="0" width="13" height="13" rx="4" stroke="var(--itlock-accent)" stroke-width="2" />
                        <rect x="21" y="4" width="26" height="5" rx="2.5" fill="var(--itlock-border)" />
                    </g>
                </g>

                @* Nøkkel *@
                <g transform="translate(36 150) rotate(-24)">
                    <circle cx="0" cy="0" r="11" stroke="var(--itlock-accent)" stroke-width="4" />
                    <path d="M11 0h30" stroke="var(--itlock-accent)" stroke-width="4" stroke-linecap="round" />
                    <path d="M31 0v8M39 0v6" stroke="var(--itlock-accent)" stroke-width="4" stroke-linecap="round" />
                </g>
            </svg>
        </div>
    </div>
}
else
{
    <div class="lu-toolbar-kort">
        <div class="lu-sok-boks">
            <Icon Name="search" />
            <input value="@_sok" @oninput="OnSokEndret" placeholder="Søk i sjekklister..." />
        </div>

        <div class="lu-filter-wrap">
            <button type="button" class="lu-filter-knapp" @onclick="@(() => _filterApen = !_filterApen)">
                <Icon Name="filter" />Filter<Icon Name="chevron-down" />
            </button>
            @if (_filterApen)
            {
                <div class="lu-filter-meny">
                    <button type="button" class="@(_sortering == "nyeste" ? "lu-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("nyeste"))">Nyeste først</button>
                    <button type="button" class="@(_sortering == "dato" ? "lu-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("dato"))">Nærmeste dato</button>
                    <button type="button" class="@(_sortering == "navn" ? "lu-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("navn"))">Navn (A-Å)</button>
                </div>
            }
        </div>

        <div class="lu-visning-bytte">
            <button type="button" class="@(_valgtVisning == "liste" ? "lu-visning-aktiv" : "")" title="Listevisning" @onclick='@(() => VelgVisning("liste"))'><Icon Name="list" /></button>
            <button type="button" class="@(_valgtVisning == "rutenett" ? "lu-visning-aktiv" : "")" title="Rutenettvisning" @onclick='@(() => VelgVisning("rutenett"))'><Icon Name="grid-icon" /></button>
        </div>
    </div>

    @if (filtrertOgSortert.Count == 0)
    {
        <p class="list-empty">Ingen treff.</p>
    }
    else
    {
        @if (_valgtVisning == "rutenett")
        {
            <div class="lu-rutenett">
                @foreach (var l in sideSynlig)
                {
                    <a @key="l.Id" class="lu-kort" href="@($"lasutskifting/{l.Id}")">
                        <span class="lu-kort-ikon"><Icon Name="lock" /></span>
                        <span class="lu-kort-tekst">
                            <span class="lu-kort-navn">@l.Navn</span>
                            <span class="lu-kort-dato">@(l.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")</span>
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="lu-tabell-wrap">
                <table class="lu-tabell">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Navn</th>
                            <th>Dato</th>
                            <th>Opprettet</th>
                            <th class="lu-tabell-handlinger">Handlinger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in sideSynlig)
                        {
                            <tr @key="l.Id">
                                <td class="lu-tabell-muted">@l.Id</td>
                                <td><a class="lu-tabell-tittel" href="@($"lasutskifting/{l.Id}")">@l.Navn</a></td>
                                <td>
                                    @if (l.Dato is not null)
                                    {
                                        <span class="lu-tabell-ikontekst"><Icon Name="calendar" />@l.Dato.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <text>–</text>
                                    }
                                </td>
                                <td><span class="lu-tabell-ikontekst"><Icon Name="calendar" />@l.OpprettetDato.ToString("dd.MM.yyyy")</span></td>
                                <td class="lu-tabell-handlinger"><Icon Name="grip" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="lu-paginering">
            <label class="lu-side-velger">
                Vis
                <select value="@_sideStorrelse" @onchange="OnSideStorrelseEndret">
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                </select>
                per side
            </label>
            <div class="lu-side-knapper">
                <span class="lu-side-tekst">Side @_sideNummer av @totalSider</span>
                <button type="button" class="lu-side-knapp" disabled="@(_sideNummer <= 1)" @onclick="@(() => _sideNummer--)" title="Forrige side"><Icon Name="chevron-left" /></button>
                <button type="button" class="lu-side-knapp" disabled="@(_sideNummer >= totalSider)" @onclick="@(() => _sideNummer++)" title="Neste side"><Icon Name="arrow-right" /></button>
            </div>
        </div>
    }
}

@code {
    private sealed class ListeRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public DateTime? Dato { get; set; }
        public DateTime OpprettetDato { get; set; }

        // Flyttes automatisk til "Arkivert" 14 dager etter Dato - se
        // LasUtskifting.ErArkivert.
        public bool Arkivert => Dato.HasValue && Dato.Value.Date.AddDays(14) < DateTime.Today;
    }

    private List<ListeRad> _lister = [];
    private bool _visArkivert;
    private string _sok = "";
    private string _sortering = "nyeste";
    private string _valgtVisning = "liste";

    private async Task VelgVisning(string visning)
    {
        _valgtVisning = visning;
        await VisningPref.SettAsync("lasutskifting", visning);
    }
    private bool _filterApen;
    private int _sideStorrelse = 10;
    private int _sideNummer = 1;

    private int AntallNy => _lister.Count(l => !l.Arkivert);
    private int AntallArkivert => _lister.Count(l => l.Arkivert);

    protected override async Task OnInitializedAsync()
    {
        _valgtVisning = await VisningPref.HentAsync("lasutskifting", _valgtVisning);

        _lister = await Db.LasUtskiftinger
            .OrderByDescending(l => l.OpprettetDato)
            .Select(l => new ListeRad
            {
                Id = l.Id,
                Navn = l.Navn,
                Dato = l.Dato,
                OpprettetDato = l.OpprettetDato
            })
            .ToListAsync();
    }

    private void VelgFane(bool arkivert)
    {
        _visArkivert = arkivert;
        _sideNummer = 1;
    }

    private void OnSokEndret(ChangeEventArgs e)
    {
        _sok = e.Value?.ToString() ?? "";
        _sideNummer = 1;
    }

    private void OnSideStorrelseEndret(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var storrelse))
        {
            _sideStorrelse = storrelse;
            _sideNummer = 1;
        }
    }

    private void VelgSortering(string sortering)
    {
        _sortering = sortering;
        _filterApen = false;
        _sideNummer = 1;
    }

    private List<ListeRad> FiltrertOgSortert(IEnumerable<ListeRad> kilde)
    {
        var filtrert = string.IsNullOrWhiteSpace(_sok)
            ? kilde
            : kilde.Where(l => l.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase));

        return _sortering switch
        {
            "dato" => filtrert.OrderBy(l => l.Dato ?? DateTime.MaxValue).ToList(),
            "navn" => filtrert.OrderBy(l => l.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
            _ => filtrert.OrderByDescending(l => l.OpprettetDato).ToList()
        };
    }
}
