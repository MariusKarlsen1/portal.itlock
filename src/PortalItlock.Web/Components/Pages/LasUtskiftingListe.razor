@page "/lasutskifting"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Utskiftning av lås</PageTitle>

@{
    var synlige = _lister.Where(l => l.Arkivert == _visArkivert).ToList();
    var filtrertOgSortert = FiltrertOgSortert(synlige);
    var totalSider = Math.Max(1, (int)Math.Ceiling(filtrertOgSortert.Count / (double)_sideStorrelse));
    if (_sideNummer > totalSider)
    {
        _sideNummer = totalSider;
    }
    var fra = (_sideNummer - 1) * _sideStorrelse;
    var sideSynlig = filtrertOgSortert.Skip(fra).Take(_sideStorrelse).ToList();
}

@* L1 (lasutskifting-forslag): lista som arbeidsordre, i ett hvitt kort med
   faner, søk og filter, og annenhver grå og hvit rad. *@
<div class="lu-side @(_full ? "lu-full" : "")">
    <header class="lu-hode">
        <span class="lu-hode-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Utskiftning av lås</h1>
            <p>Mål og beslag når en lås skal byttes</p>
        </div>
    </header>

    <div class="lu-kort">
        <div class="lu-faner" role="tablist">
            <button type="button" role="tab" aria-selected="@(!_visArkivert ? "true" : "false")" class="@(!_visArkivert ? "aktiv" : "")" @onclick="@(() => VelgFane(false))">Ny <small>@AntallNy</small></button>
            <button type="button" role="tab" aria-selected="@(_visArkivert ? "true" : "false")" class="@(_visArkivert ? "aktiv" : "")" @onclick="@(() => VelgFane(true))">Arkivert <small>@AntallArkivert</small></button>
        </div>

        <div class="lu-verktoy">
            <div class="lu-sok">
                <Icon Name="search" />
                <input value="@_sok" @oninput="OnSokEndret" placeholder="Søk etter sjekkliste" aria-label="Søk etter sjekkliste" />
            </div>

            <div class="lu-filter-wrap">
                <button type="button" class="lu-knapp" @onclick="@(() => _filterApen = !_filterApen)">
                    <Icon Name="filter" />Filter<Icon Name="chevron-down" />
                </button>
                @if (_filterApen)
                {
                    <div class="lu-filter-meny">
                        <button type="button" class="@(_sortering == "nyeste" ? "aktiv" : "")" @onclick="@(() => VelgSortering("nyeste"))">Nyeste først</button>
                        <button type="button" class="@(_sortering == "dato" ? "aktiv" : "")" @onclick="@(() => VelgSortering("dato"))">Nærmeste dato</button>
                        <button type="button" class="@(_sortering == "navn" ? "aktiv" : "")" @onclick="@(() => VelgSortering("navn"))">Navn (A-Å)</button>
                    </div>
                }
            </div>

            <a class="lu-knapp lu-knapp-primaer" href="/lasutskifting/ny"><Icon Name="plus" />Ny sjekkliste</a>
            <button type="button" class="lu-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>

        @if (synlige.Count == 0)
        {
            <div class="lu-tom">
                <b>@(_visArkivert ? "Ingen arkiverte sjekklister" : "Ingen sjekklister ennå")</b>
                <span>@(_visArkivert ? "Sjekklister arkiveres av seg selv 14 dager etter datoen" : "Lag en sjekkliste når en lås skal byttes")</span>
                @if (!_visArkivert)
                {
                    <a class="lu-knapp lu-knapp-primaer" href="/lasutskifting/ny"><Icon Name="plus" />Ny sjekkliste</a>
                }
            </div>
        }
        else if (filtrertOgSortert.Count == 0)
        {
            <p class="lu-ingen">Ingen treff.</p>
        }
        else
        {
            <div class="lu-ramme">
                <table class="lu-tabell">
                    <thead>
                        <tr>
                            <th class="lu-smal-skjul">#</th>
                            <th>Sjekkliste</th>
                            <th>Dato</th>
                            <th class="lu-smal-skjul">Felt utfylt</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in sideSynlig)
                        {
                            <tr @key="l.Id" @onclick="@(() => Nav.NavigateTo($"/lasutskifting/{l.Id}"))">
                                <td class="lu-smal-skjul lu-nummer">#@l.Id</td>
                                <td><a href="@($"/lasutskifting/{l.Id}")" @onclick:stopPropagation="true">@l.Navn</a></td>
                                <td>@(l.Dato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                <td class="lu-smal-skjul">@l.AntallUtfylt av @LasUtskifting.AntallFelt</td>
                                <td>
                                    @if (l.AntallUtfylt == LasUtskifting.AntallFelt)
                                    {
                                        <span class="lu-merke lu-merke-klar">Klar</span>
                                    }
                                    else
                                    {
                                        <span class="lu-merke">Mangler mål</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="lu-fot">
                <label class="lu-side-velger">
                    Vis
                    <select value="@_sideStorrelse" @onchange="OnSideStorrelseEndret">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select>
                    per side
                </label>
                <div class="lu-side-knapper">
                    <span>Viser @(fra + 1)–@(fra + sideSynlig.Count) av @filtrertOgSortert.Count</span>
                    @if (totalSider > 1)
                    {
                        <button type="button" disabled="@(_sideNummer <= 1)" @onclick="@(() => _sideNummer--)" title="Forrige side" aria-label="Forrige side"><Icon Name="chevron-left" /></button>
                        <button type="button" disabled="@(_sideNummer >= totalSider)" @onclick="@(() => _sideNummer++)" title="Neste side" aria-label="Neste side"><Icon Name="chevron-right" /></button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private sealed class ListeRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public DateTime? Dato { get; set; }
        public DateTime OpprettetDato { get; set; }
        public int AntallUtfylt { get; set; }

        // Flyttes automatisk til "Arkivert" 14 dager etter Dato - se
        // LasUtskifting.ErArkivert.
        public bool Arkivert => Dato.HasValue && Dato.Value.Date.AddDays(14) < DateTime.Today;
    }

    private List<ListeRad> _lister = [];
    private bool _visArkivert;
    private string _sok = "";
    private string _sortering = "nyeste";
    private bool _filterApen;
    private int _sideStorrelse = 10;
    private int _sideNummer = 1;

    private int AntallNy => _lister.Count(l => !l.Arkivert);
    private int AntallArkivert => _lister.Count(l => l.Arkivert);

    private bool _full;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("lasutskifting-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("lasutskifting-bredde", "normal") == "full";

        // AntallUtfylt regnes ut i minnet, så radene hentes først.
        var rader = await Db.LasUtskiftinger
            .AsNoTracking()
            .OrderByDescending(l => l.OpprettetDato)
            .ToListAsync();

        _lister = rader.Select(l => new ListeRad
        {
            Id = l.Id,
            Navn = l.Navn,
            Dato = l.Dato,
            OpprettetDato = l.OpprettetDato,
            AntallUtfylt = l.AntallUtfylt
        }).ToList();
    }

    private void VelgFane(bool arkivert)
    {
        _visArkivert = arkivert;
        _sideNummer = 1;
    }

    private void OnSokEndret(ChangeEventArgs e)
    {
        _sok = e.Value?.ToString() ?? "";
        _sideNummer = 1;
    }

    private void OnSideStorrelseEndret(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var storrelse))
        {
            _sideStorrelse = storrelse;
            _sideNummer = 1;
        }
    }

    private void VelgSortering(string sortering)
    {
        _sortering = sortering;
        _filterApen = false;
        _sideNummer = 1;
    }

    private List<ListeRad> FiltrertOgSortert(IEnumerable<ListeRad> kilde)
    {
        var filtrert = string.IsNullOrWhiteSpace(_sok)
            ? kilde
            : kilde.Where(l => l.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase));

        return _sortering switch
        {
            "dato" => filtrert.OrderBy(l => l.Dato ?? DateTime.MaxValue).ToList(),
            "navn" => filtrert.OrderBy(l => l.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
            _ => filtrert.OrderByDescending(l => l.OpprettetDato).ToList()
        };
    }
}
