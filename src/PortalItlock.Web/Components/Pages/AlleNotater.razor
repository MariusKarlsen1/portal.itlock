@page "/notater"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Notater</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="file-text" /></span>
    <div>
        <h1>Notater</h1>
        <p class="section-hint">Alle notater ansatte har skrevet i portalen, samlet på ett sted.</p>
    </div>
</div>

<div class="filter-rad">
    <select class="filter-select" @bind="_valgtBrukerId" @bind:after="Filtrer">
        <option value="">Alle brukere</option>
        @foreach (var b in _brukere)
        {
            <option value="@b.Id">@b.Navn</option>
        }
    </select>
    <span class="antall-tekst">@_visteNotater.Count notat@(_visteNotater.Count == 1 ? "" : "er")</span>
</div>

<div class="kort notat-liste">
    @if (_visteNotater.Count == 0)
    {
        <p class="tom-liste">Ingen notater funnet.</p>
    }
    else
    {
        @foreach (var n in _visteNotater)
        {
            <div @key="n.Id" class="notat-rad">
                <span class="notat-avatar">@Initialer(n.Bruker?.Navn)</span>
                <div class="notat-innhold">
                    <div class="notat-topp">
                        <span class="notat-navn">@(n.Bruker?.Navn ?? "Ukjent bruker")</span>
                        <span class="notat-dato">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm", Kultur)</span>
                    </div>
                    <p class="notat-tekst">@n.Tekst</p>
                </div>
            </div>
        }
    }
</div>

@code {
    private static readonly CultureInfo Kultur = new("nb-NO");

    private List<Notat> _alleNotater = [];
    private List<Notat> _visteNotater = [];
    private List<Bruker> _brukere = [];
    private string _valgtBrukerId = "";

    protected override async Task OnInitializedAsync()
    {
        _alleNotater = await Db.Notater
            .Include(n => n.Bruker)
            .OrderByDescending(n => n.OpprettetDato)
            .ToListAsync();

        _brukere = _alleNotater
            .Where(n => n.Bruker is not null)
            .Select(n => n.Bruker!)
            .DistinctBy(b => b.Id)
            .OrderBy(b => b.Navn)
            .ToList();

        Filtrer();
    }

    private void Filtrer()
    {
        _visteNotater = string.IsNullOrEmpty(_valgtBrukerId)
            ? _alleNotater
            : _alleNotater.Where(n => n.BrukerId == int.Parse(_valgtBrukerId)).ToList();
    }

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        return string.Concat(
            navn.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(del => char.ToUpperInvariant(del[0])));
    }
}
