@page "/tilvalgmaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Tilvalgsmaler - Full Kontroll</PageTitle>

<h1>Tilvalgsmaler</h1>
<p class="section-hint">Ferdige maler med alternativer, bilder og priser du kan gjenbruke når du oppretter et nytt tilvalg på et prosjekt.</p>

@if (_maler.Count == 0)
{
    <p class="list-empty">Ingen maler opprettet ennå.</p>
}

<div class="mal-rutenett">
    @foreach (var m in _maler)
    {
        var alternativer = m.Alternativer.OrderBy(a => a.Rekkefolge).ToList();
        <div @key="m.Id" class="mal-kort">
            <div class="mal-kort-thumb-rad">
                @if (alternativer.Count == 0)
                {
                    <span class="mal-kort-thumb-tom">Ingen alternativer</span>
                }
                else
                {
                    @for (var i = 0; i < Math.Min(3, alternativer.Count); i++)
                    {
                        var alt = alternativer[i];
                        @if (alt.BildeData is not null)
                        {
                            <img class="mal-kort-thumb" src="@($"/tilvalgmalalternativ/{alt.Id}/bilde")" alt="@alt.Navn" />
                        }
                        else
                        {
                            <span class="mal-kort-thumb mal-kort-thumb-tom-liten"></span>
                        }
                    }
                }
            </div>
            <div>
                <div class="mal-kort-navn">@m.Navn</div>
                <div class="mal-kort-antall">@(alternativer.Count == 0 ? "Ingen alternativer" : $"{alternativer.Count} alternativ{(alternativer.Count == 1 ? "" : "er")}")</div>
            </div>
            <div class="mal-kort-footer">
                <a class="mal-kort-apne" href="@($"/tilvalgmaler/{m.Id}")">Åpne &rarr;</a>
                <button type="button" class="mal-kort-slett" @onclick="@(() => SlettMal(m))">Slett</button>
            </div>
        </div>
    }

    <button type="button" class="ny-mal-kort" @onclick="NyMal">
        <span class="ny-mal-pluss">+</span>
        <span>Ny mal</span>
    </button>
</div>

@code {
    private List<TilvalgMal> _maler = [];

    protected override async Task OnInitializedAsync()
    {
        await LastMaler();
    }

    private async Task LastMaler()
    {
        _maler = await Db.TilvalgMaler
            .Include(m => m.Alternativer)
            .OrderBy(m => m.Navn)
            .ToListAsync();
    }

    private async Task NyMal()
    {
        var mal = new TilvalgMal { Navn = "Ny mal" };
        Db.TilvalgMaler.Add(mal);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/tilvalgmaler/{mal.Id}");
    }

    private async Task SlettMal(TilvalgMal mal)
    {
        Db.TilvalgMaler.Remove(mal);
        await Db.SaveChangesAsync();
        _maler.Remove(mal);
    }
}
