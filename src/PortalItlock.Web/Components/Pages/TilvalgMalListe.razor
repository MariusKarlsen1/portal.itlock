@page "/tilvalgmaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Tilvalgsmaler - itlock</PageTitle>

<a class="back-link" href="/kundemodul">&larr; Tilbake til Kunder</a>
<h1>Tilvalgsmaler</h1>
<p class="section-hint">Ferdige maler med alternativer, bilder og priser du kan gjenbruke når du oppretter et nytt tilvalg på et prosjekt.</p>

@if (_maler.Count == 0)
{
    <p class="list-empty">Ingen maler opprettet ennå.</p>
}
else
{
    <div class="tilvalgmal-liste">
        @foreach (var m in _maler)
        {
            <a @key="m.Id" class="tilvalgmal-rad" href="@($"/tilvalgmaler/{m.Id}")">
                <div class="tilvalgmal-info">
                    <strong>@m.Navn</strong>
                    <span class="tilvalgmal-antall">@m.Alternativer.Count alternativ(er)</span>
                </div>
                <button type="button" class="remove-button" @onclick="@(() => SlettMal(m))" @onclick:stopPropagation="true" @onclick:preventDefault="true">Slett</button>
            </a>
        }
    </div>
}

<button type="button" class="add-button" @onclick="NyMal">Ny mal</button>

@code {
    private List<TilvalgMal> _maler = [];

    protected override async Task OnInitializedAsync()
    {
        await LastMaler();
    }

    private async Task LastMaler()
    {
        _maler = await Db.TilvalgMaler
            .Include(m => m.Alternativer)
            .OrderBy(m => m.Navn)
            .ToListAsync();
    }

    private async Task NyMal()
    {
        var mal = new TilvalgMal { Navn = "Ny mal" };
        Db.TilvalgMaler.Add(mal);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/tilvalgmaler/{mal.Id}");
    }

    private async Task SlettMal(TilvalgMal mal)
    {
        Db.TilvalgMaler.Remove(mal);
        await Db.SaveChangesAsync();
        _maler.Remove(mal);
    }
}
