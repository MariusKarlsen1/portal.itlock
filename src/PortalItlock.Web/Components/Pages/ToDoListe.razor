@page "/todo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>To-do liste</PageTitle>

@* TD11 (todo-td1-forslag.html): listene og gruppene i en meny inni kortet, Innboks
   øverst for det som er skrevet ned uten frist og gruppe, og hurtigknapper
   (I dag / I morgen / Neste uke) på raden. Utført-arkivet ligger nederst i menyen. *@
<div class="td-side @(_full ? "td-full" : "")">
    <div class="td-topp">
        <div>
            <h1>To-do</h1>
            <p>@Aktive.Count() igjen · @Forfalte.Count forfalt · @GjortIDag.Count gjort i dag</p>
        </div>
        <button type="button" class="td-knapp td-knapp-primaer" @onclick="ApneNyOppgave"><Icon Name="plus" />Ny oppgave</button>
    </div>

    <div class="td-kort">
        <nav class="td-meny">
            <div class="td-meny-rull">
                @foreach (var l in Lister)
                {
                    var key = l.Key;
                    var antall = IListe(key).Count;
                    <button type="button" class="td-mi @(key == "innboks" ? "td-mi-innboks" : "") @(_liste == key ? "pa" : "")" @onclick="@(() => VelgListe(key))">
                        <span class="td-mi-ikon">
                            @if (l.Farge is not null)
                            {
                                <span class="td-prikk" style="background:@l.Farge"></span>
                            }
                            else
                            {
                                <Icon Name="@l.Ikon" />
                            }
                        </span>
                        <span class="td-mi-navn">@l.Navn</span>
                        <small>@(antall > 0 ? antall : "")</small>
                    </button>
                }
                @if (MenyGrupper.Count > 0)
                {
                    <span class="td-mi-tittel">Grupper</span>
                    @foreach (var g in MenyGrupper)
                    {
                        var key = "g:" + g;
                        var antall = IListe(key).Count;
                        <button type="button" class="td-mi @(_liste == key ? "pa" : "")" @onclick="@(() => VelgListe(key))">
                            <span class="td-mi-ikon">#</span>
                            <span class="td-mi-navn">@g</span>
                            <small>@(antall > 0 ? antall : "")</small>
                        </button>
                    }
                }
            </div>
            <div class="td-meny-bunn">
                <button type="button" class="td-mi @(_liste == "utfort" ? "pa" : "")" @onclick="@(() => VelgListe("utfort"))">
                    <span class="td-mi-ikon"><Icon Name="check" /></span>
                    <span class="td-mi-navn">Utført</span>
                    <small>@_oppgaver.Count(o => o.Fullfort)</small>
                </button>
            </div>
        </nav>

        <section class="td-innhold">
            @if (_liste != "utfort")
            {
                var liste = IListe(_liste);
                <div class="td-hode">
                    <h2>@ListeNavn(_liste)</h2>
                    <small>@liste.Count igjen</small>
                    <button type="button" class="td-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                        <Icon Name="@(_full ? "minimize" : "maximize")" />
                    </button>
                </div>

                <div class="td-hurtig">
                    <span class="td-hurtig-pluss">+</span>
                    <input @bind="_hurtig" @bind:event="oninput" @onkeydown="HurtigTast" placeholder="@HurtigTekst" />
                    <span class="td-hurtig-tips"><b>i morgen</b> · <b>fredag</b> · <b>#gruppe</b> · <b>!</b> viktig</span>
                    <button type="button" class="td-hurtig-send" @onclick="LeggTilHurtig">Legg til</button>
                </div>

                @if (_liste == "innboks")
                {
                    <p class="td-info">Oppgaver uten frist og gruppe. Gi dem en dag med knappene på raden, så forsvinner de herfra.</p>
                }

                <div class="td-rull">
                    @if (_oppgaver.Count == 0)
                    {
                        <div class="td-tom">Ingen oppgaver ennå. Skriv i feltet over for å legge til din første.</div>
                    }
                    else if (liste.Count == 0 && !(_liste is "alle" or "idag" && GjortIDag.Count > 0))
                    {
                        <div class="td-tom">@(_liste == "innboks" ? "Innboksen er tom 🎉" : "Ingen oppgaver her.")</div>
                    }

                    @if (_liste == "alle" || _liste.StartsWith("g:"))
                    {
                        @foreach (var s in SeksjonerFor(liste).Where(s => s.Oppgaver.Count > 0))
                        {
                            <div class="td-sek" @key="s.Navn"><span class="td-prikk" style="background:@s.Farge"></span>@s.Navn<em>@s.Oppgaver.Count</em></div>
                            @foreach (var o in s.Oppgaver)
                            {
                                @Rad(o)
                            }
                        }
                    }
                    else
                    {
                        @foreach (var o in SorterAktive(liste))
                        {
                            @Rad(o)
                        }
                    }

                    @if (_liste is "alle" or "idag" && GjortIDag.Count > 0)
                    {
                        <div class="td-sek"><span class="td-prikk" style="background:var(--td-gronn)"></span>Gjort i dag<em>@GjortIDag.Count</em></div>
                        @foreach (var o in GjortIDag)
                        {
                            @Rad(o)
                        }
                    }
                </div>

                <div class="td-bunn">
                    <span>@Forfalte.Count forfalt · @GjortIDag.Count gjort i dag</span>
                    <button type="button" class="td-lenke" @onclick="@(() => VelgListe("utfort"))">Se alle utførte →</button>
                </div>
            }
            else
            {
                <div class="td-hode">
                    <h2>Utført</h2>
                    <small>@_oppgaver.Count(o => o.Fullfort) totalt</small>
                    <button type="button" class="td-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                        <Icon Name="@(_full ? "minimize" : "maximize")" />
                    </button>
                </div>
                <div class="td-u-verktoy">
                    <label class="td-u-sok"><Icon Name="search" /><input @bind="_uSok" @bind:event="oninput" @bind:after="@(() => _uVisAntall = 40)" placeholder="Søk i utførte oppgaver…" /></label>
                    <select @bind="_uGruppe">
                        <option value="">Alle grupper</option>
                        @foreach (var g in UtforteGrupper)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                    <button type="button" class="td-u-sorter" @onclick="@(() => _uNyestForst = !_uNyestForst)">@(_uNyestForst ? "Nyeste først ↓" : "Eldste først ↑")</button>
                </div>

                <div class="td-rull td-u-rull">
                    @if (!string.IsNullOrWhiteSpace(_uSok))
                    {
                        var treff = SokTreff;
                        <div class="td-u-info"><b>@treff.Count treff på «@_uSok.Trim()»</b> i hele historikken</div>
                        @if (treff.Count == 0)
                        {
                            <div class="td-tom">Ingen utførte oppgaver passer søket.</div>
                        }
                        @foreach (var gruppe in treff.Take(_uVisAntall).GroupBy(o => o.FullfortDato is { } d ? $"{MndLang[d.Month - 1]} {d.Year}" : "Uten dato"))
                        {
                            <div class="td-sek" @key="gruppe.Key" style="text-transform:capitalize">@gruppe.Key</div>
                            @foreach (var o in gruppe)
                            {
                                @Rad(o, o.FullfortDato is { } d ? $"uke {ISOWeek.GetWeekOfYear(d)}" : null)
                            }
                        }
                        @if (treff.Count > _uVisAntall)
                        {
                            <button type="button" class="td-knapp td-flere" @onclick="@(() => _uVisAntall += 40)">Vis flere (@(treff.Count - _uVisAntall))</button>
                        }
                    }
                    else
                    {
                        <div class="td-ar-faner">
                            @foreach (var ar in Ar)
                            {
                                <button type="button" class="@(ar == _uAr ? "pa" : "")" @onclick="@(() => VelgAr(ar))">@ar</button>
                            }
                            @if (UtenDato.Count > 0)
                            {
                                <button type="button" class="@(_uAr == 0 ? "pa" : "")" @onclick="@(() => VelgAr(0))">Tidligere</button>
                            }
                        </div>

                        @if (_uAr == 0)
                        {
                            <div class="td-u-info">Oppgaver som ble huket av før vi begynte å lagre når de ble utført.</div>
                            @foreach (var o in UtenDato)
                            {
                                @Rad(o)
                            }
                        }
                        else
                        {
                            var uker = ValgteUker;
                            var neste = new DateTime(_uAr, _uMnd, 1).AddMonths(1);
                            <div class="td-mnd-hode">
                                <button type="button" class="td-mnd-pil" @onclick="@(() => BlaMnd(-1))" title="Forrige måned">‹</button>
                                <div>
                                    <h2>@Stor(MndLang[_uMnd - 1]) @_uAr</h2>
                                    <small>@uker.Sum(u => u.Oppgaver.Count) utført · @uker.Count @(uker.Count == 1 ? "uke" : "uker")</small>
                                </div>
                                <button type="button" class="td-mnd-pil td-mnd-pil-neste" disabled="@(neste > DateTime.Today)" @onclick="@(() => BlaMnd(1))" title="Neste måned">›</button>
                            </div>
                            @if (uker.Count == 0)
                            {
                                <div class="td-tom">Ingen utførte oppgaver denne måneden.</div>
                            }
                            @foreach (var u in uker)
                            {
                                var apen = uker.Count == 1 || _apneUker.Contains(u.Mandag);
                                var sondag = u.Mandag.AddDays(6);
                                <div class="td-uke @(apen ? "" : "lukket")" @key="u.Mandag">
                                    <button type="button" class="td-uke-hode" @onclick="@(() => VeksleUke(u.Mandag))">
                                        <span class="td-uke-tekst">
                                            <b>Uke @ISOWeek.GetWeekOfYear(u.Mandag)@if (u.Mandag == Mandag(DateTime.Today)) {<span class="td-chip">denne uken</span>}</b>
                                            <small>@u.Mandag.Day. @MndKort[u.Mandag.Month - 1] – @sondag.Day. @MndKort[sondag.Month - 1] · @u.Oppgaver.Count utført</small>
                                        </span>
                                        <span class="td-uke-grupper">
                                            @foreach (var (g, n) in TopGrupper(u.Oppgaver))
                                            {
                                                <span class="td-chip">#@g @n</span>
                                            }
                                        </span>
                                        <span class="td-pil">▾</span>
                                    </button>
                                    @if (apen)
                                    {
                                        @foreach (var dag in u.Oppgaver.GroupBy(o => o.FullfortDato!.Value.Date))
                                        {
                                            <div class="td-dag-skille">@DagNavn(dag.Key)</div>
                                            @foreach (var o in dag)
                                            {
                                                @Rad(o)
                                            }
                                        }
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }
        </section>
    </div>
</div>

<div class="td-toast @(_toast is not null ? "vis" : "")">
    <span class="td-toast-ok">✓</span>
    <span>@_toast</span>
    <button type="button" @onclick="AngreSiste">Angre</button>
</div>

@if (_visNyOppgave)
{
    <div class="td-modal-overlay" @onclick="@(() => _visNyOppgave = false)">
        <div class="td-modal" @onclick:stopPropagation="true">
            <h2>@(_nyDraft.Id is null ? "Ny oppgave" : "Rediger oppgave")</h2>

            <label class="td-felt">Tittel <input @bind="_nyDraft.Tittel" @bind:event="oninput" placeholder="Hva skal gjøres?" /></label>
            <label class="td-felt">
                Gruppe
                <input @bind="_nyDraft.Gruppe" @bind:event="oninput" list="td-gruppeliste" placeholder="F.eks. Nye dører" />
                <datalist id="td-gruppeliste">
                    @foreach (var g in AlleGrupper)
                    {
                        <option value="@g" />
                    }
                </datalist>
            </label>
            <div class="td-felt-rad">
                <label class="td-felt">
                    Prioritet
                    <select @bind="_nyDraft.Prioritet">
                        @foreach (var p in Enum.GetValues<ToDoPrioritet>())
                        {
                            <option value="@p">@p.Visningsnavn()</option>
                        }
                    </select>
                </label>
                <label class="td-felt">Frist <input type="date" @bind="_nyDraft.Frist" /></label>
            </div>

            @if (_nyFeil is not null)
            {
                <p class="td-feil">@_nyFeil</p>
            }

            <div class="td-modal-actions">
                <button type="button" class="td-knapp td-knapp-primaer" @onclick="LagreOppgave">@(_nyDraft.Id is null ? "Legg til" : "Lagre")</button>
                <button type="button" class="td-knapp" @onclick="@(() => _visNyOppgave = false)">Avbryt</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo NorskKultur = new("nb-NO");
    private static readonly string[] MndKort = ["jan", "feb", "mar", "apr", "mai", "jun", "jul", "aug", "sep", "okt", "nov", "des"];
    private static readonly string[] MndLang = ["januar", "februar", "mars", "april", "mai", "juni", "juli", "august", "september", "oktober", "november", "desember"];

    private int? _naverendeBrukerId;
    private List<ToDoOppgave> _oppgaver = [];
    // Valgt liste i menyen: innboks, alle, idag, forfalt, uke, senere, uten, g:<gruppe> eller utfort.
    private string _liste = "alle";
    private bool _full;
    private string _hurtig = "";

    // Oppgaver som akkurat er huket av og er i ferd med å gli ut av listen.
    private readonly HashSet<int> _glirUt = [];
    private string? _toast;
    private int? _angreId;
    private CancellationTokenSource? _toastCts;

    // Utført-arkivet
    private string _uSok = "";
    private string _uGruppe = "";
    private bool _uNyestForst = true;
    private int _uAr = DateTime.Today.Year;
    private int _uMnd = DateTime.Today.Month;
    private DateTime? _uUke;
    private int _uVisAntall = 40;
    private readonly HashSet<DateTime> _apneUker = [Mandag(DateTime.Today)];

    private bool _visNyOppgave;
    private string? _nyFeil;

    private sealed class OppgaveDraft
    {
        public int? Id { get; set; }
        public string Tittel { get; set; } = "";
        public string Gruppe { get; set; } = "";
        public ToDoPrioritet Prioritet { get; set; } = ToDoPrioritet.Normal;
        public DateTime? Frist { get; set; }
    }

    private OppgaveDraft _nyDraft = new();

    private sealed record Seksjon(string Key, string Navn, string Farge, List<ToDoOppgave> Oppgaver);
    private sealed record Uke(DateTime Mandag, List<ToDoOppgave> Oppgaver);
    private sealed record ListeValg(string Key, string Navn, string? Farge, string Ikon);

    private static readonly ListeValg[] Lister =
    [
        new("innboks", "Innboks", null, "download"),
        new("alle", "Alle", null, "list"),
        new("idag", "I dag", "var(--td-gul)", ""),
        new("forfalt", "Forfalt", "var(--td-rust)", ""),
        new("uke", "Denne uken", "var(--td-bla)", ""),
        new("senere", "Senere", "var(--td-lilla)", ""),
        new("uten", "Uten frist", "var(--td-svak)", "")
    ];

    private static DateTime Mandag(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private static string Gruppe(ToDoOppgave o) => string.IsNullOrWhiteSpace(o.Gruppe) ? "Annet" : o.Gruppe.Trim();
    private static string Stor(string s) => char.ToUpper(s[0]) + s[1..];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _full = await VisningPref.HentAsync("todo-bredde", "normal") == "full";
        await LastDataAsync();

        // Husker sist valgte liste. Uten (eller med en gruppe som ikke finnes lenger)
        // starter vi i Innboks når det ligger noe der, ellers i Alle.
        var liste = await VisningPref.HentAsync("todo-liste", "");
        _liste = liste == "utfort" || Lister.Any(l => l.Key == liste) || (liste.StartsWith("g:") && MenyGrupper.Contains(liste[2..]))
            ? liste
            : Innboks.Count > 0 ? "innboks" : "alle";
    }

    private async Task LastDataAsync()
    {
        if (_naverendeBrukerId is null)
        {
            return;
        }

        _oppgaver = await Db.ToDoOppgaver
            .Where(o => o.BrukerId == _naverendeBrukerId)
            .ToListAsync();
    }

    private async Task VelgListe(string key)
    {
        _liste = key;
        await VisningPref.SettAsync("todo-liste", key);
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("todo-bredde", _full ? "full" : "normal");
    }

    // ---------- Å gjøre ----------

    // Oppgaver som er huket av, men fortsatt glir ut, regnes med her en liten stund.
    private IEnumerable<ToDoOppgave> Aktive => _oppgaver.Where(o => !o.Fullfort || _glirUt.Contains(o.Id));

    private List<ToDoOppgave> GjortIDag => _oppgaver
        .Where(o => o.Fullfort && !_glirUt.Contains(o.Id) && o.FullfortDato?.Date == DateTime.Today)
        .OrderByDescending(o => o.FullfortDato)
        .ToList();

    private static List<ToDoOppgave> SorterAktive(IEnumerable<ToDoOppgave> l) => l
        .OrderBy(o => o.Frist ?? DateTime.MaxValue).ThenByDescending(o => o.Prioritet).ThenBy(o => o.OpprettetDato).ToList();

    private static string SeksjonAv(ToDoOppgave o)
    {
        var idag = DateTime.Today;
        return o.Frist is not { } f ? "uten"
            : f.Date < idag ? "forfalt"
            : f.Date == idag ? "idag"
            : f.Date <= idag.AddDays(6) ? "uke"
            : "senere";
    }

    private static List<Seksjon> SeksjonerFor(List<ToDoOppgave> liste) =>
        Lister.Where(l => l.Farge is not null)
            .Select(l => new Seksjon(l.Key, l.Navn, l.Farge!, SorterAktive(liste.Where(o => SeksjonAv(o) == l.Key))))
            .ToList();

    private List<ToDoOppgave> Forfalte => Aktive.Where(o => SeksjonAv(o) == "forfalt").ToList();

    // Innboks: skrevet ned uten frist og uten gruppe - venter på å bli sortert.
    private List<ToDoOppgave> Innboks => Aktive.Where(o => o.Frist is null && string.IsNullOrWhiteSpace(o.Gruppe)).ToList();

    private List<ToDoOppgave> IListe(string key) => key switch
    {
        "innboks" => Innboks,
        "alle" => Aktive.ToList(),
        _ when key.StartsWith("g:") => Aktive.Where(o => !string.IsNullOrWhiteSpace(o.Gruppe) && o.Gruppe.Trim() == key[2..]).ToList(),
        _ => Aktive.Where(o => SeksjonAv(o) == key).ToList()
    };

    // Gruppene i menyen: de som har oppgaver igjen, pluss den som er valgt.
    private List<string> MenyGrupper => Aktive
        .Where(o => !string.IsNullOrWhiteSpace(o.Gruppe))
        .Select(o => o.Gruppe!.Trim())
        .Append(_liste.StartsWith("g:") ? _liste[2..] : null)
        .OfType<string>()
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.Create(NorskKultur, true))
        .ToList();

    private static string ListeNavn(string key) => key.StartsWith("g:") ? "#" + key[2..]
        : key == "utfort" ? "Utført"
        : Lister.FirstOrDefault(l => l.Key == key)?.Navn ?? "Alle";

    private string HurtigTekst => _liste switch
    {
        "innboks" => "Skriv det ned – sorter senere …",
        "idag" => "Ny oppgave i dag …",
        _ when _liste.StartsWith("g:") => $"Ny oppgave i #{_liste[2..]} …",
        _ => "Ny oppgave… f.eks. «Ring Per om fase 2 i morgen #Solsiden !»"
    };

    private List<string> AlleGrupper => _oppgaver.Select(Gruppe).Distinct().OrderBy(g => g).ToList();

    private static DateTime NesteUke => Mandag(DateTime.Today).AddDays(7);

    // Hurtigknappene på raden: I dag / I morgen / Neste uke.
    private async Task Flytt(ToDoOppgave o, DateTime frist)
    {
        o.Frist = frist;
        await Db.SaveChangesAsync();
    }

    private async Task HurtigTast(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LeggTilHurtig();
        }
    }

    // Forstår "i dag", "i morgen", ukedager, "#gruppe" og "!" (viktig) i teksten.
    private async Task LeggTilHurtig()
    {
        if (_naverendeBrukerId is null || string.IsNullOrWhiteSpace(_hurtig))
        {
            return;
        }

        var tekst = _hurtig;
        string? gruppe = null;
        var prioritet = ToDoPrioritet.Normal;
        DateTime? frist = null;

        var g = Regex.Match(tekst, @"#(\S+)");
        if (g.Success)
        {
            gruppe = g.Groups[1].Value;
            tekst = tekst.Remove(g.Index, g.Length);
        }
        if (tekst.Contains('!'))
        {
            prioritet = ToDoPrioritet.Hoy;
            tekst = tekst.Replace("!", "");
        }

        var idag = DateTime.Today;
        if (Regex.IsMatch(tekst, @"\bi dag\b", RegexOptions.IgnoreCase))
        {
            frist = idag;
            tekst = Regex.Replace(tekst, @"\bi dag\b", "", RegexOptions.IgnoreCase);
        }
        else if (Regex.IsMatch(tekst, @"\bi morgen\b", RegexOptions.IgnoreCase))
        {
            frist = idag.AddDays(1);
            tekst = Regex.Replace(tekst, @"\bi morgen\b", "", RegexOptions.IgnoreCase);
        }
        else
        {
            string[] dager = ["søndag", "mandag", "tirsdag", "onsdag", "torsdag", "fredag", "lørdag"];
            for (var i = 0; i < dager.Length && frist is null; i++)
            {
                var monster = $@"\b(på )?{dager[i]}\b";
                if (Regex.IsMatch(tekst, monster, RegexOptions.IgnoreCase))
                {
                    var diff = (i - (int)idag.DayOfWeek + 7) % 7;
                    frist = idag.AddDays(diff == 0 ? 7 : diff);
                    tekst = Regex.Replace(tekst, monster, "", RegexOptions.IgnoreCase);
                }
            }
        }

        tekst = Regex.Replace(tekst, @"\s+", " ").Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        // Skrevet inn mens en gruppe eller I dag er valgt: havner der.
        if (gruppe is null && _liste.StartsWith("g:"))
        {
            gruppe = _liste[2..];
        }
        if (frist is null && _liste == "idag")
        {
            frist = idag;
        }

        Db.ToDoOppgaver.Add(new ToDoOppgave
        {
            BrukerId = _naverendeBrukerId.Value,
            Tittel = tekst,
            Gruppe = gruppe,
            Prioritet = prioritet,
            Frist = frist
        });
        await Db.SaveChangesAsync();
        _hurtig = "";
        await LastDataAsync();
    }

    // ---------- hake av / angre ----------

    private async Task Hak(ToDoOppgave o)
    {
        if (o.Fullfort)
        {
            // Fra Utført: flyttes tilbake til Å gjøre.
            o.Fullfort = false;
            o.FullfortDato = null;
            await Db.SaveChangesAsync();
            return;
        }

        o.Fullfort = true;
        o.FullfortDato = DateTime.Now;
        await Db.SaveChangesAsync();

        // Vis haken, la raden gli ut, og flytt den så til Utført.
        _glirUt.Add(o.Id);
        StateHasChanged();
        await Task.Delay(750);
        _glirUt.Remove(o.Id);
        VisToast(o);
    }

    private void VisToast(ToDoOppgave o)
    {
        _angreId = o.Id;
        var tittel = o.Tittel.Length > 34 ? o.Tittel[..34] + "…" : o.Tittel;
        _toast = $"«{tittel}» flyttet til Utført";

        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Delay(5000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _toast = null;
                _ = InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
    }

    private async Task AngreSiste()
    {
        var o = _oppgaver.FirstOrDefault(x => x.Id == _angreId);
        _toast = null;
        _toastCts?.Cancel();
        if (o is { Fullfort: true })
        {
            o.Fullfort = false;
            o.FullfortDato = null;
            await Db.SaveChangesAsync();
        }
    }

    private async Task SlettOppgave(ToDoOppgave o)
    {
        Db.ToDoOppgaver.Remove(o);
        await Db.SaveChangesAsync();
        await LastDataAsync();
    }

    // ---------- ny / rediger ----------

    private void ApneNyOppgave()
    {
        _nyDraft = new OppgaveDraft();
        _nyFeil = null;
        _visNyOppgave = true;
    }

    private void ApneRediger(ToDoOppgave o)
    {
        _nyDraft = new OppgaveDraft { Id = o.Id, Tittel = o.Tittel, Gruppe = o.Gruppe ?? "", Prioritet = o.Prioritet, Frist = o.Frist };
        _nyFeil = null;
        _visNyOppgave = true;
    }

    private async Task LagreOppgave()
    {
        if (_naverendeBrukerId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_nyDraft.Tittel))
        {
            _nyFeil = "Skriv inn en tittel.";
            return;
        }

        var o = _nyDraft.Id is int id ? _oppgaver.FirstOrDefault(x => x.Id == id) : null;
        if (o is null)
        {
            o = new ToDoOppgave { BrukerId = _naverendeBrukerId.Value, Tittel = "" };
            Db.ToDoOppgaver.Add(o);
        }

        o.Tittel = _nyDraft.Tittel.Trim();
        o.Gruppe = string.IsNullOrWhiteSpace(_nyDraft.Gruppe) ? null : _nyDraft.Gruppe.Trim();
        o.Prioritet = _nyDraft.Prioritet;
        o.Frist = _nyDraft.Frist;

        await Db.SaveChangesAsync();
        _visNyOppgave = false;
        await LastDataAsync();
    }

    // ---------- Utført-arkivet: år -> måned -> uke ----------

    private IEnumerable<ToDoOppgave> UtforteFiltrert => _oppgaver
        .Where(o => o.Fullfort && o.FullfortDato is not null && !_glirUt.Contains(o.Id))
        .Where(o => string.IsNullOrEmpty(_uGruppe) || Gruppe(o) == _uGruppe);

    private List<ToDoOppgave> UtenDato => _oppgaver
        .Where(o => o.Fullfort && o.FullfortDato is null)
        .Where(o => string.IsNullOrEmpty(_uGruppe) || Gruppe(o) == _uGruppe)
        .OrderByDescending(o => o.OpprettetDato)
        .ToList();

    private List<string> UtforteGrupper => _oppgaver.Where(o => o.Fullfort).Select(Gruppe).Distinct().OrderBy(g => g).ToList();

    private List<int> Ar => _oppgaver
        .Where(o => o.Fullfort && o.FullfortDato is not null)
        .Select(o => o.FullfortDato!.Value.Year)
        .Append(DateTime.Today.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();

    private IEnumerable<ToDoOppgave> Sorter(IEnumerable<ToDoOppgave> l) => _uNyestForst
        ? l.OrderByDescending(o => o.FullfortDato ?? o.OpprettetDato)
        : l.OrderBy(o => o.FullfortDato ?? o.OpprettetDato);

    private List<ToDoOppgave> SokTreff
    {
        get
        {
            var s = _uSok.Trim();
            return Sorter(_oppgaver
                    .Where(o => o.Fullfort && !_glirUt.Contains(o.Id))
                    .Where(o => string.IsNullOrEmpty(_uGruppe) || Gruppe(o) == _uGruppe)
                    .Where(o => o.Tittel.Contains(s, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private List<Uke> ValgteUker
    {
        get
        {
            IEnumerable<ToDoOppgave> l = _uUke is { } uke
                ? UtforteFiltrert.Where(o => Mandag(o.FullfortDato!.Value) == uke)
                : UtforteFiltrert.Where(o => o.FullfortDato!.Value.Year == _uAr && o.FullfortDato.Value.Month == _uMnd);
            var uker = Sorter(l)
                .GroupBy(o => Mandag(o.FullfortDato!.Value))
                .Select(g => new Uke(g.Key, g.ToList()))
                .ToList();
            return uker;
        }
    }

    private static IEnumerable<(string Gruppe, int Antall)> TopGrupper(List<ToDoOppgave> l) => l
        .GroupBy(Gruppe)
        .Select(g => (g.Key, g.Count()))
        .OrderByDescending(g => g.Item2)
        .Take(3);

    private static string DagNavn(DateTime d) =>
        d == DateTime.Today ? "I dag"
        : d == DateTime.Today.AddDays(-1) ? "I går"
        : $"{d.ToString("dddd", NorskKultur)} {d.Day}. {MndKort[d.Month - 1]}";

    private void VelgAr(int ar)
    {
        _uAr = ar;
        _uMnd = ar == DateTime.Today.Year ? DateTime.Today.Month : 12;
        _uUke = null;
    }

    private void BlaMnd(int retning)
    {
        var ny = new DateTime(_uAr, _uMnd, 1).AddMonths(retning);
        if (ny > DateTime.Today)
        {
            return;
        }
        _uAr = ny.Year;
        _uMnd = ny.Month;
        _uUke = null;
    }

    private void VeksleUke(DateTime mandag)
    {
        if (_uUke is not null)
        {
            return;
        }
        if (!_apneUker.Add(mandag))
        {
            _apneUker.Remove(mandag);
        }
    }

    // ---------- én rad ----------

    private RenderFragment Rad(ToDoOppgave o, string? ekstra = null) => __builder =>
    {
        var ferdig = o.Fullfort;
        var idag = DateTime.Today;
        var fristKlasse = ferdig || o.Frist is null ? "" : o.Frist.Value.Date < idag ? "forfalt" : o.Frist.Value.Date == idag ? "idag" : "";
        <div class="td-rad td-p-@o.Prioritet @(ferdig ? "ferdig" : "") @(_glirUt.Contains(o.Id) ? "ut" : "")" @key="o.Id">
            <button type="button" class="td-hake" title="@(ferdig ? "Flytt tilbake til Å gjøre" : "Merk som utført")" @onclick="@(() => Hak(o))">
                <svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10" /></svg>
            </button>
            <div class="td-rad-innhold">
                <div class="td-tittel">@o.Tittel</div>
                <div class="td-meta">
                    @if (o.Frist is { } f)
                    {
                        <span class="td-chip @fristKlasse"><Icon Name="calendar" />@FristTekst(f)</span>
                    }
                    @if (o.Prioritet == ToDoPrioritet.Hoy)
                    {
                        <span class="td-chip hoy">Viktig</span>
                    }
                    else if (o.Prioritet == ToDoPrioritet.Lav)
                    {
                        <span class="td-chip">Lav</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(o.Gruppe))
                    {
                        <span class="td-chip">#@o.Gruppe</span>
                    }
                </div>
            </div>
            <div class="td-rad-hoyre">
                @if (ekstra is not null)
                {
                    <span class="td-tid">@ekstra</span>
                }
                @if (ferdig && o.FullfortDato is { } fd && ekstra is null)
                {
                    <span class="td-tid">@fd.ToString("HH:mm")</span>
                }
                <span class="td-handl">
                    @if (!ferdig)
                    {
                        @if (o.Frist?.Date != idag)
                        {
                            <button type="button" class="td-flytt" @onclick="@(() => Flytt(o, idag))">I dag</button>
                        }
                        @if (o.Frist?.Date != idag.AddDays(1))
                        {
                            <button type="button" class="td-flytt" @onclick="@(() => Flytt(o, idag.AddDays(1)))">I morgen</button>
                        }
                        @if (o.Frist?.Date != NesteUke)
                        {
                            <button type="button" class="td-flytt" @onclick="@(() => Flytt(o, NesteUke))">Neste uke</button>
                        }
                        <button type="button" title="Rediger" @onclick="@(() => ApneRediger(o))"><Icon Name="edit" /></button>
                    }
                    <button type="button" title="Slett" @onclick="@(() => SlettOppgave(o))"><Icon Name="trash" /></button>
                </span>
            </div>
        </div>
    };

    private static string FristTekst(DateTime f)
    {
        var n = (f.Date - DateTime.Today).Days;
        if (n == -1) return "i går";
        if (n == 0) return "i dag";
        if (n == 1) return "i morgen";
        if (n < 0) return $"{-n} dager over";
        if (n <= 6) return $"{f.ToString("ddd", NorskKultur).TrimEnd('.')} {f.Day}.{f.Month}";
        return $"{f.Day}.{f.Month}" + (f.Year != DateTime.Today.Year ? $".{f.Year}" : "");
    }

    public void Dispose() => _toastCts?.Cancel();
}
