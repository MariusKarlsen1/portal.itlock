@page "/lasutskifting/ny"
@page "/lasutskifting/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste")</PageTitle>

<h1>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste") - utskiftning av lås</h1>

@if (_notFound)
{
    <p class="form-error">Fant ikke sjekklisten. Den kan være slettet.</p>
}
else
{
    <div class="lasutskifting-layout">
        <div class="field-grid">
            <label class="span-2">
                Navn på sjekkliste
                <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Egersund skole - inngangsdør" />
            </label>
            <label>Dato<input type="date" @bind="_form.Dato" /></label>
        </div>

        <section class="lu-section">
            <h2>Dør</h2>
            <div class="field-grid">
                <label>1A Total<div class="unit-field"><input @bind="_form.TotalMm" /><span>mm</span></div></label>
                <label>1B Utside<div class="unit-field"><input @bind="_form.UtsideMm" /><span>mm</span></div></label>
                <label>1C Innside<div class="unit-field"><input @bind="_form.InnsideMm" /><span>mm</span></div></label>
                <label>2 Fra dørkant til senter på skilt<div class="unit-field"><input @bind="_form.AvstandDorkantTilSkiltMm" /><span>mm</span></div></label>
                <label>3 Fabrikat (lås)<input @bind="_form.DorFabrikat" /></label>
                <label>3 Nummer (lås)<input @bind="_form.DorNummer" /></label>
                <label>4 Stolpehøyde<input @bind="_form.Stolpehoyde" /></label>
                <label>5 Stolpebredde<input @bind="_form.Stolpebredde" /></label>
                <label>
                    6 Overflatebehandling
                    <select @bind="_form.Overflatebehandling">
                        <option value="">Velg</option>
                        <option value="Forniklet">Forniklet</option>
                        <option value="Messing">Messing</option>
                        <option value="Oksidert">Oksidert</option>
                        <option value="Annet">Annet</option>
                    </select>
                </label>
                @if (_form.Overflatebehandling == "Annet")
                {
                    <label>Spesifiser overflatebehandling<input @bind="_form.OverflatebehandlingAnnet" /></label>
                }
            </div>
        </section>

        <section class="lu-section">
            <h2>Karm</h2>
            <div class="field-grid">
                <label>7 Fabrikat<input @bind="_form.KarmFabrikat" /></label>
                <label>7 Nummer<input @bind="_form.KarmNummer" /></label>
                <label>8 Avstand<input @bind="_form.KarmAvstand" /></label>
                <label>
                    9 Skruer?
                    <select @bind="_form.Skruer">
                        <option value="">Velg</option>
                        <option value="Ja">Ja</option>
                        <option value="Nei">Nei</option>
                    </select>
                </label>
            </div>
        </section>

        <section class="lu-section">
            <h2>Hengsling av dør</h2>
            <div class="field-grid">
                <label>
                    Side
                    <select @bind="_form.HengslingSide">
                        <option value="">Velg</option>
                        <option value="Venstre">Venstre</option>
                        <option value="Høyre">Høyre</option>
                    </select>
                </label>
                <label>
                    Slagretning
                    <select @bind="_form.Slagretning">
                        <option value="">Velg</option>
                        <option value="Utadslående">Utadslående</option>
                        <option value="Innadslående">Innadslående</option>
                    </select>
                </label>
            </div>
        </section>

        <label class="notes-field">
            Merknad
            <textarea rows="4" @bind="_form.Merknad"></textarea>
        </label>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="save-success">@_savedMessage</p>
        }

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Save">
                @(Id.HasValue ? "Lagre endringer" : "Lagre sjekkliste")
            </button>

            @if (Id.HasValue)
            {
                @if (_confirmingDelete)
                {
                    <span class="delete-confirm">
                        Er du sikker?
                        <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                        <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    </span>
                }
                else
                {
                    <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett sjekkliste</button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private LasUtskifting _form = new() { Navn = "" };
    private bool _notFound;
    private bool _confirmingDelete;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;

        if (Id.HasValue)
        {
            var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _form = existing;
        }
        else
        {
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Sjekklisten må ha et navn.";
            return;
        }

        _error = null;

        if (!Id.HasValue)
        {
            Db.LasUtskiftinger.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er lagret.";
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
        if (existing is not null)
        {
            Db.LasUtskiftinger.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/lasutskifting");
    }
}
