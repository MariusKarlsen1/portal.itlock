@page "/lasutskifting/ny"
@page "/lasutskifting/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste")</PageTitle>

@if (_notFound)
{
    <a class="back-link" href="/lasutskifting"><Icon Name="arrow-left" />Til sjekklister</a>
    <p class="form-error">Fant ikke sjekklisten. Den kan være slettet.</p>
}
else
{
    <div class="lasutskifting-layout">
        <a class="back-link" href="/lasutskifting"><Icon Name="arrow-left" />Til sjekklister</a>

        <div class="side-header">
            <span class="side-header-ikon"><Icon Name="lock" /></span>
            <div>
                <h1>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste") - utskiftning av lås</h1>
                <p class="section-hint">@(string.IsNullOrWhiteSpace(_form.Navn) ? "Fyll inn informasjon om sjekklisten under." : _form.Navn)</p>
            </div>
        </div>

        <div class="panel">
            <div class="field-grid">
                <label class="span-2">
                    Navn på sjekkliste
                    <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Egersund skole - inngangsdør" />
                </label>
                <label>Dato<input type="date" @bind="_form.Dato" /></label>
            </div>
        </div>

        <div class="lu-measure-grid">
            <div class="lu-fields">
                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-ikon"><Icon Name="box" /></span>
                        <h2>Dør</h2>
                    </div>
                    <div class="field-grid">
                        <label><span class="punkt-label"><span class="punkt-badge">1A</span> Total</span><div class="unit-field"><input @bind="_form.TotalMm" /><span>mm</span></div></label>
                        <label><span class="punkt-label"><span class="punkt-badge">1B</span> Utside</span><div class="unit-field"><input @bind="_form.UtsideMm" /><span>mm</span></div></label>
                        <label><span class="punkt-label"><span class="punkt-badge">1C</span> Innside</span><div class="unit-field"><input @bind="_form.InnsideMm" /><span>mm</span></div></label>
                        <label><span class="punkt-label"><span class="punkt-badge">2</span> Fra dørkant til senter på skilt</span><div class="unit-field"><input @bind="_form.AvstandDorkantTilSkiltMm" /><span>mm</span></div></label>
                        <label><span class="punkt-label"><span class="punkt-badge">3</span> Fabrikat (lås)</span><input @bind="_form.DorFabrikat" /></label>
                        <label><span class="punkt-label"><span class="punkt-badge">3</span> Nummer (lås)</span><input @bind="_form.DorNummer" /></label>
                        <label><span class="punkt-label"><span class="punkt-badge">4</span> Stolpehøyde</span><input @bind="_form.Stolpehoyde" /></label>
                        <label><span class="punkt-label"><span class="punkt-badge">5</span> Stolpebredde</span><input @bind="_form.Stolpebredde" /></label>
                        <label>
                            <span class="punkt-label"><span class="punkt-badge">6</span> Overflatebehandling</span>
                            <select @bind="_form.Overflatebehandling">
                                <option value="">Velg</option>
                                <option value="Forniklet">Forniklet</option>
                                <option value="Messing">Messing</option>
                                <option value="Oksidert">Oksidert</option>
                                <option value="Annet">Annet</option>
                            </select>
                        </label>
                        @if (_form.Overflatebehandling == "Annet")
                        {
                            <label>Spesifiser overflatebehandling<input @bind="_form.OverflatebehandlingAnnet" /></label>
                        }
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-ikon"><Icon Name="grip" /></span>
                        <h2>Karm</h2>
                    </div>
                    <div class="field-grid">
                        <label><span class="punkt-label"><span class="punkt-badge">7</span> Fabrikat</span><input @bind="_form.KarmFabrikat" /></label>
                        <label><span class="punkt-label"><span class="punkt-badge">7</span> Nummer</span><input @bind="_form.KarmNummer" /></label>
                        <label><span class="punkt-label"><span class="punkt-badge">8</span> Avstand</span><input @bind="_form.KarmAvstand" /></label>
                        <label>
                            <span class="punkt-label"><span class="punkt-badge">9</span> Skruer?</span>
                            <select @bind="_form.Skruer">
                                <option value="">Velg</option>
                                <option value="Ja">Ja</option>
                                <option value="Nei">Nei</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-ikon"><Icon Name="toggle-right" /></span>
                        <h2>Hengsling av dør</h2>
                    </div>
                    <div class="field-grid">
                        <label>
                            Side
                            <select @bind="_form.HengslingSide">
                                <option value="">Velg</option>
                                <option value="Venstre">Venstre</option>
                                <option value="Høyre">Høyre</option>
                            </select>
                        </label>
                        <label>
                            Slagretning
                            <select @bind="_form.Slagretning">
                                <option value="">Velg</option>
                                <option value="Utadslående">Utadslående</option>
                                <option value="Innadslående">Innadslående</option>
                            </select>
                        </label>
                    </div>
                </div>
            </div>

            <aside class="lu-diagram">
                <img src="lasutskifting-diagram.png" alt="Målskisse: dør, karm og hengsling med punktene 1A-9 markert" />
                <p class="lu-diagram-caption">Målpunktene 1A-9 fra skjemaet, vist på dør og karm. Kilde: Norske Låsesmeder.</p>
            </aside>
        </div>

        <div class="panel">
            <label class="notes-field">
                Merknad
                <textarea rows="4" @bind="_form.Merknad"></textarea>
            </label>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="save-success">@_savedMessage</p>
        }

        <div class="form-actions">
            <button type="button" class="knapp knapp-primaer" @onclick="Save">
                <Icon Name="check" />
                @(Id.HasValue ? "Lagre endringer" : "Lagre sjekkliste")
            </button>

            @if (Id.HasValue)
            {
                @if (_confirmingDelete)
                {
                    <span class="delete-confirm" style="margin-left:auto;">
                        Er du sikker?
                        <button type="button" class="knapp knapp-fare" @onclick="ConfirmDelete">Ja, slett</button>
                        <button type="button" class="knapp" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    </span>
                }
                else
                {
                    <button type="button" class="knapp knapp-fare" style="margin-left:auto;" @onclick="@(() => _confirmingDelete = true)"><Icon Name="trash" />Slett sjekkliste</button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private LasUtskifting _form = new() { Navn = "" };
    private bool _notFound;
    private bool _confirmingDelete;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;

        if (Id.HasValue)
        {
            var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _form = existing;
        }
        else
        {
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Sjekklisten må ha et navn.";
            return;
        }

        _error = null;

        if (!Id.HasValue)
        {
            Db.LasUtskiftinger.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er lagret.";
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
        if (existing is not null)
        {
            Db.LasUtskiftinger.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/lasutskifting");
    }
}
