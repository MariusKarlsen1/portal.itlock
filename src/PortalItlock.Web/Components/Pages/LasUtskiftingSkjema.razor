@page "/lasutskifting/ny"
@page "/lasutskifting/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste")</PageTitle>

@if (_notFound)
{
    <a class="back-link" href="/lasutskifting"><Icon Name="arrow-left" />Til sjekklister</a>
    <p class="form-error">Fant ikke sjekklisten. Den kan være slettet.</p>
}
else
{
    <script>
        window.luFokuserFelt = function (id) {
            var el = document.getElementById(id);
            if (el) {
                el.focus({ preventScroll: true });
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        };
    </script>

    <div class="lasutskifting-layout lus-side @(_full ? "lus-full" : "")">
        <a class="back-link" href="/lasutskifting"><Icon Name="arrow-left" />Til sjekklister</a>

        <div class="side-header">
            <span class="side-header-ikon"><Icon Name="lock" /></span>
            <div>
                <h1>@(Id.HasValue ? "Rediger sjekkliste" : "Ny sjekkliste") - utskiftning av lås</h1>
                <p class="section-hint">@(string.IsNullOrWhiteSpace(_form.Navn) ? "Fyll inn informasjon om sjekklisten under." : _form.Navn)</p>
            </div>
        </div>

        @* LS3 (lasutskifting-skjema-forslag): alt i ett kort. Navn og dato i
           topplinja, feltene til venstre og måldiagrammet til høyre. Feltet
           du står i lyser opp som et punkt på tegningen, og et trykk på et
           punkt hopper til feltet. *@
        <div class="lus-kort">
            <div class="lus-topplinje">
                <label class="lus-navn">
                    Navn på sjekkliste
                    <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Egersund skole - inngangsdør" />
                </label>
                <label class="lus-dato">Dato<input type="date" @bind="_form.Dato" /></label>
                <button type="button" class="lus-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>

            <div class="lus-grid">
                <div class="lus-felter">
                    <section class="lus-del">
                        <div class="lus-del-hode">
                            <span class="panel-ikon"><Icon Name="box" /></span>
                            <h2>Dør</h2>
                            <small>@AntallUtfylt(_form.TotalMm, _form.UtsideMm, _form.InnsideMm, _form.AvstandDorkantTilSkiltMm, _form.DorFabrikat, _form.DorNummer, _form.Stolpehoyde, _form.Stolpebredde, _form.Overflatebehandling) av 9</small>
                        </div>
                        <div class="field-grid">
                            <label @onfocusin="@(() => _punkt = "1A")"><span class="punkt-label"><span class="punkt-badge @Aktiv("1A")">1A</span> Total</span><div class="unit-field"><input id="lu-felt-1A" @bind="_form.TotalMm" @bind:event="oninput" /><span>mm</span></div></label>
                            <label @onfocusin="@(() => _punkt = "1B")"><span class="punkt-label"><span class="punkt-badge @Aktiv("1B")">1B</span> Utside</span><div class="unit-field"><input id="lu-felt-1B" @bind="_form.UtsideMm" @bind:event="oninput" /><span>mm</span></div></label>
                            <label @onfocusin="@(() => _punkt = "1C")"><span class="punkt-label"><span class="punkt-badge @Aktiv("1C")">1C</span> Innside</span><div class="unit-field"><input id="lu-felt-1C" @bind="_form.InnsideMm" @bind:event="oninput" /><span>mm</span></div></label>
                            <label @onfocusin="@(() => _punkt = "2")"><span class="punkt-label"><span class="punkt-badge @Aktiv("2")">2</span> Fra dørkant til senter på skilt</span><div class="unit-field"><input id="lu-felt-2" @bind="_form.AvstandDorkantTilSkiltMm" @bind:event="oninput" /><span>mm</span></div></label>
                            <label @onfocusin="@(() => _punkt = "3")"><span class="punkt-label"><span class="punkt-badge @Aktiv("3")">3</span> Fabrikat (lås)</span><input id="lu-felt-3" @bind="_form.DorFabrikat" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "3")"><span class="punkt-label"><span class="punkt-badge @Aktiv("3")">3</span> Nummer (lås)</span><input @bind="_form.DorNummer" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "4")"><span class="punkt-label"><span class="punkt-badge @Aktiv("4")">4</span> Stolpehøyde</span><input id="lu-felt-4" @bind="_form.Stolpehoyde" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "5")"><span class="punkt-label"><span class="punkt-badge @Aktiv("5")">5</span> Stolpebredde</span><input id="lu-felt-5" @bind="_form.Stolpebredde" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "6")">
                                <span class="punkt-label"><span class="punkt-badge @Aktiv("6")">6</span> Overflatebehandling</span>
                                <select id="lu-felt-6" @bind="_form.Overflatebehandling">
                                    <option value="">Velg</option>
                                    <option value="Forniklet">Forniklet</option>
                                    <option value="Messing">Messing</option>
                                    <option value="Oksidert">Oksidert</option>
                                    <option value="Annet">Annet</option>
                                </select>
                            </label>
                            @if (_form.Overflatebehandling == "Annet")
                            {
                                <label @onfocusin="@(() => _punkt = "6")">Spesifiser overflatebehandling<input @bind="_form.OverflatebehandlingAnnet" /></label>
                            }
                        </div>
                    </section>

                    <section class="lus-del">
                        <div class="lus-del-hode">
                            <span class="panel-ikon"><Icon Name="grip" /></span>
                            <h2>Karm</h2>
                            <small>@AntallUtfylt(_form.KarmFabrikat, _form.KarmNummer, _form.KarmAvstand, _form.Skruer) av 4</small>
                        </div>
                        <div class="field-grid">
                            <label @onfocusin="@(() => _punkt = "7")"><span class="punkt-label"><span class="punkt-badge @Aktiv("7")">7</span> Fabrikat</span><input id="lu-felt-7" @bind="_form.KarmFabrikat" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "7")"><span class="punkt-label"><span class="punkt-badge @Aktiv("7")">7</span> Nummer</span><input @bind="_form.KarmNummer" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "8")"><span class="punkt-label"><span class="punkt-badge @Aktiv("8")">8</span> Avstand</span><input id="lu-felt-8" @bind="_form.KarmAvstand" @bind:event="oninput" /></label>
                            <label @onfocusin="@(() => _punkt = "9")">
                                <span class="punkt-label"><span class="punkt-badge @Aktiv("9")">9</span> Skruer?</span>
                                <select id="lu-felt-9" @bind="_form.Skruer">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                        </div>
                    </section>

                    <section class="lus-del">
                        <div class="lus-del-hode">
                            <span class="panel-ikon"><Icon Name="toggle-right" /></span>
                            <h2>Hengsling av dør</h2>
                            <small>@AntallUtfylt(_form.HengslingSide, _form.Slagretning) av 2</small>
                        </div>
                        <div class="field-grid">
                            <label @onfocusin="@(() => _punkt = "side")">
                                Side
                                <select id="lu-felt-side" @bind="_form.HengslingSide">
                                    <option value="">Velg</option>
                                    <option value="Venstre">Venstre</option>
                                    <option value="Høyre">Høyre</option>
                                </select>
                            </label>
                            <label @onfocusin="@(() => _punkt = "slag")">
                                Slagretning
                                <select id="lu-felt-slag" @bind="_form.Slagretning">
                                    <option value="">Velg</option>
                                    <option value="Utadslående">Utadslående</option>
                                    <option value="Innadslående">Innadslående</option>
                                </select>
                            </label>
                        </div>
                    </section>

                    <section class="lus-del">
                        <label class="notes-field" @onfocusin="@(() => _punkt = null)">
                            Merknad
                            <textarea rows="4" @bind="_form.Merknad"></textarea>
                        </label>
                    </section>
                </div>

                <aside class="lu-diagram lus-diagram">
                    <div class="lus-tegning">
                        <img src="lasutskifting-diagram.png" alt="Målskisse: dør, karm og hengsling med punktene 1A-9 markert" />
                        @foreach (var p in Punkter)
                        {
                            <button type="button" class="lus-punkt @(_punkt == p.Felt ? "aktiv" : "")" style="left:@(p.X.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(p.Y.ToString(System.Globalization.CultureInfo.InvariantCulture))%" title="@p.Navn" @onclick="@(() => VelgPunkt(p.Felt))"></button>
                        }
                    </div>
                    <p class="lu-diagram-caption">
                        @if (Punkter.FirstOrDefault(p => p.Felt == _punkt) is { } valgt)
                        {
                            <b>@valgt.Navn</b><br />
                        }
                        Trykk i et felt, så lyser punktet opp på tegningen - eller trykk et punkt for å hoppe til feltet. Kilde: Norske Låsesmeder.
                    </p>
                </aside>
            </div>

            <div class="lus-bunnlinje">
                <span class="lus-status">
                    <span class="lus-fremdrift"><i style="width:@(AntallUtfyltTotalt * 100 / 15)%"></i></span>
                    @AntallUtfyltTotalt av 15 felt fylt ut
                </span>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="form-error">@_error</p>
                }

                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <p class="save-success">@_savedMessage</p>
                }

                <span class="lus-bunnknapper">
                    @if (Id.HasValue)
                    {
                        @if (_confirmingDelete)
                        {
                            <span class="delete-confirm">
                                Er du sikker?
                                <button type="button" class="knapp knapp-fare" @onclick="ConfirmDelete">Ja, slett</button>
                                <button type="button" class="knapp" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="knapp knapp-fare" @onclick="@(() => _confirmingDelete = true)"><Icon Name="trash" />Slett sjekkliste</button>
                        }
                    }
                    <button type="button" class="knapp knapp-primaer" @onclick="Save">
                        <Icon Name="check" />
                        @(Id.HasValue ? "Lagre endringer" : "Lagre sjekkliste")
                    </button>
                </span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private LasUtskifting _form = new() { Navn = "" };
    private bool _notFound;
    private bool _confirmingDelete;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;
    private bool _full;
    private string? _punkt;

    // Punktene på lasutskifting-diagram.png i prosent av bildets bredde/høyde.
    // Side og slagretning har to avkrysningsbokser hver på tegningen.
    private sealed record Punkt(string Felt, string Navn, double X, double Y);

    private static readonly Punkt[] Punkter =
    [
        new("1A", "1A · Total", 21.4, 5.3),
        new("1B", "1B · Utside", 16.2, 7.95),
        new("1C", "1C · Innside", 26.5, 7.95),
        new("2", "2 · Fra dørkant til senter på skilt", 43.9, 13.2),
        new("3", "3 · Fabrikat og nummer (lås)", 21.0, 18.25),
        new("4", "4 · Stolpehøyde", 3.6, 25.65),
        new("5", "5 · Stolpebredde", 21.3, 34.5),
        new("6", "6 · Overflatebehandling", 49.7, 40.25),
        new("7", "7 · Fabrikat og nummer (karm)", 20.4, 68.35),
        new("8", "8 · Avstand", 13.9, 75.55),
        new("9", "9 · Skruer?", 20.2, 83.75),
        new("side", "Hengsling - side", 53.1, 65.15),
        new("side", "Hengsling - side", 53.1, 83.5),
        new("slag", "Slagretning", 50.8, 90.1),
        new("slag", "Slagretning", 50.8, 92.5)
    ];

    private string Aktiv(string punkt) => _punkt == punkt ? "aktiv" : "";

    private static int AntallUtfylt(params string?[] verdier) => verdier.Count(v => !string.IsNullOrWhiteSpace(v));

    private int AntallUtfyltTotalt => AntallUtfylt(
        _form.TotalMm, _form.UtsideMm, _form.InnsideMm, _form.AvstandDorkantTilSkiltMm, _form.DorFabrikat, _form.DorNummer,
        _form.Stolpehoyde, _form.Stolpebredde, _form.Overflatebehandling, _form.KarmFabrikat, _form.KarmNummer, _form.KarmAvstand,
        _form.Skruer, _form.HengslingSide, _form.Slagretning);

    private async Task VelgPunkt(string felt)
    {
        _punkt = felt;
        try
        {
            await JS.InvokeVoidAsync("luFokuserFelt", $"lu-felt-{felt}");
        }
        catch (JSException)
        {
            // Ikke kritisk.
        }
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("lasutskifting-skjema-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("lasutskifting-skjema-bredde", "normal") == "full";
    }


    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;

        if (Id.HasValue)
        {
            var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _form = existing;
        }
        else
        {
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Sjekklisten må ha et navn.";
            return;
        }

        _error = null;

        if (!Id.HasValue)
        {
            Db.LasUtskiftinger.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Sjekklisten \"{_form.Navn}\" er lagret.";
            _form = new LasUtskifting { Navn = "" };
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == Id.Value);
        if (existing is not null)
        {
            Db.LasUtskiftinger.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/lasutskifting");
    }
}
