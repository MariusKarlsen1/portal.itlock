    private List<DateOnly> TimelisteDager => Enumerable.Range(0, 7)
        .Select(i => _ukeMandag.AddDays(i))
        .Where(d => d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday)
                    || UkensRader.Any(r => DateOnly.FromDateTime(r.Dato) == d))
        .ToList();

    private List<DateOnly> DialogDager => Enumerable.Range(0, 7).Select(i => _ukeMandag.AddDays(i)).ToList();

    private List<TimelisteRad> TimelisteRader
    {
        get
        {
            var oppslag = _ordre.ToDictionary(a => a.Id);
            return UkensRader
                .GroupBy(r => r.ArbeidsordreId)
                .Select(g =>
                {
                    oppslag.TryGetValue(g.Key, out var ao);
                    return new TimelisteRad(
                        g.Key,
                        g.First().ProsjektNokkel,
                        ao is null ? g.First().ProsjektNavn : $"#{ao.Id} · {ao.Tittel}",
                        ao?.Kunde ?? "",
                        g.GroupBy(r => DateOnly.FromDateTime(r.Dato)).ToDictionary(x => x.Key, x => x.Sum(r => r.Timer)));
                })
                .OrderBy(r => r.Tittel, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }

    // Mine denne uken: jeg er ansvarlig og den er planlagt i uken (eller ikke
    // planlagt), eller jeg har allerede ført timer på den denne uken.
    private bool ErMinDenneUken(ArbeidsordreOption a)
    {
        if (UkensRader.Any(r => r.ArbeidsordreId == a.Id && r.MontorId == _naverendeBrukerId))
        {
            return true;
        }
        if (a.AnsvarligMontorId is null || a.AnsvarligMontorId != _naverendeBrukerId)
        {
            return false;
        }
        if (a.PlanlagtDato is null)
        {
            return true;
        }
        var fra = DateOnly.FromDateTime(a.PlanlagtDato.Value);
        var til = DateOnly.FromDateTime(a.PlanlagtSlutt ?? a.PlanlagtDato.Value);
        return fra <= UkeSondag && til >= _ukeMandag;
    }

    private List<AoGruppe> AoGrupper
    {
        get
        {
            var sok = _aoSok.Trim();
            var aktuelle = _ordre
                .Where(a => a.Status != ArbeidsordreStatus.Fakturert || a.Id == _draft.ArbeidsordreId)
                .Where(a => sok.Length == 0
                    || a.Id.ToString().Contains(sok.TrimStart('#'))
                    || a.Tittel.Contains(sok, StringComparison.CurrentCultureIgnoreCase)
                    || a.Kunde.Contains(sok, StringComparison.CurrentCultureIgnoreCase)
                    || a.ProsjektNavn.Contains(sok, StringComparison.CurrentCultureIgnoreCase))
                .ToList();
            var mine = aktuelle.Where(ErMinDenneUken).OrderBy(a => a.PlanlagtDato ?? DateTime.MaxValue).ThenBy(a => a.Tittel).ToList();
            var andre = aktuelle.Except(mine).OrderBy(a => a.Status == ArbeidsordreStatus.Ferdig).ThenByDescending(a => a.Id).ToList();
            var grupper = new List<AoGruppe>();
            if (mine.Count > 0) grupper.Add(new("Mine – planlagt denne uken", mine));
            if (andre.Count > 0) grupper.Add(new("Andre åpne arbeidsordre", andre));
            return grupper;
        }
    }

