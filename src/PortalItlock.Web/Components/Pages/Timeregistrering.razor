@page "/timeregistrering"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Timeregistrering</PageTitle>
<KreverModulVakt Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer" />

<div class="mobil-tidsreg-wrap">
    <div class="mobil-ukestripe">
        @foreach (var dag in MobilUkeDager)
        {
            <button type="button" class="mobil-ukedag @(dag == _mobilValgtDato ? "aktiv" : "")" @onclick="@(() => VelgMobilDag(dag))">
                <span class="mobil-ukedag-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
                <span class="mobil-ukedag-tall">@dag.Day.ToString("00")</span>
            </button>
        }
    </div>

    <div class="mobil-reg-form">
        <label>
            Arbeidsordre
            <select @bind="_draft.ArbeidsordreId">
                <option value="">Velg arbeidsordre...</option>
                @foreach (var a in _ordre)
                {
                    <option value="@a.Id">@a.Tittel</option>
                }
            </select>
        </label>
        <div class="mobil-reg-rad">
            <label>
                Type
                <select @bind="_draft.Type">
                    @foreach (var t in Enum.GetValues<TimeregistreringType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Start
                <input type="time" @bind="_draft.Start" />
            </label>
            <label>
                Slutt
                <input type="time" @bind="_draft.Slutt" />
            </label>
        </div>
        <button type="button" class="save-button mobil-reg-knapp" @onclick="RegistrerMobil">Registrer timer</button>
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="form-error">@_error</span>
        }
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="save-success">@_savedMessage</span>
        }
    </div>

    <div class="mobil-reg-liste">
        @if (MobilDagensRader.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert denne dagen.</p>
        }
        else
        {
            @foreach (var r in MobilDagensRader)
            {
                <div @key="@($"mobil-{r.Id}")" class="mobil-ordre-kort mobil-kant-@(r.Status == TimeregistreringStatus.Godkjent ? "gronn" : r.Status == TimeregistreringStatus.Avslatt ? "rod" : "gul")">
                    <div class="mobil-ordre-topp">
                        <span class="mobil-ordre-tittel">@r.ProsjektNavn</span>
                        <span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span>
                    </div>
                    <div class="mobil-ordre-meta">@r.Aktivitet.Visningsnavn() &middot; @r.Timer.ToString("N1", Kultur) t</div>
                </div>
            }
        }
    </div>
</div>

@* TI4 (timeregistrering-i-kort): alt som før, men i ett kort. Fanene til venstre og
   uke-velger, «I dag», Uke/Måned/Liste og utvid-knapp til høyre på samme linje. *@
<div class="tr-side @(_full ? "tr-full" : "")">

    <div class="tr-kort">
    @* TR2: kortet har samme hode som kundekortet - sti, tittel, «Registrer timer» og utvid. *@
    <div class="tr-kk-topp">
        <span class="tr-topp-ikon"><Icon Name="clock" /></span>
        <div class="tr-kk-tittel">
            <div class="tr-kk-sti"><a href="/">Hjem</a> / <a href="/timerfravarmodul">Timer og fravær</a> / Timeregistrering</div>
            <h1>Timeregistrering</h1>
        </div>
        <div class="tr-kk-knapper">
            <button type="button" class="tr-ny-knapp" @onclick="ApneRegistrer"><Icon Name="plus" />Registrer timer</button>
            <button type="button" class="tr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>
    </div>
    <div class="tr-kk-info">
        <span>Uke @ISOWeek.GetWeekOfYear(_ukeMandag.ToDateTime(TimeOnly.MinValue)) <b>@UkeSum.ToString("0.#", Kultur) av @Maluketimer.ToString("0.#", Kultur) t</b></span>
        <span>Venter på godkjenning <b>@MineRader.Where(r => r.Status == TimeregistreringStatus.Venter && r.MontorId == _naverendeBrukerId).Sum(r => r.Timer).ToString("0.#", Kultur) t</b></span>
        <span>Godkjent denne måneden <b>@MineRader.Where(r => r.Status == TimeregistreringStatus.Godkjent && r.MontorId == _naverendeBrukerId && r.Dato.Year == _ukeMandag.Year && r.Dato.Month == _ukeMandag.Month).Sum(r => r.Timer).ToString("0.#", Kultur) t</b></span>
    </div>
    <nav class="tr-faner">
        <div class="tr-fanerad">
            <button type="button" class="tr-fane @(_fane == "registrer" ? "tr-fane-aktiv" : "")" @onclick='@(() => _fane = "registrer")'>Registrer timer</button>
            <button type="button" class="tr-fane @(_fane == "mine" ? "tr-fane-aktiv" : "")" @onclick='@(() => _fane = "mine")'>Mine timer</button>
            @* Godkjenning og rapporter hører hjemme hos prosjektlederen, ikke
               her - de ligger samlet på /timegodkjenning. *@
        </div>
        <div class="tr-faner-hoyre">
            <div class="tr-ukevelger">
                <button type="button" class="tr-ukepil" title="Forrige uke" @onclick="@(() => ByttUke(-7))"><Icon Name="chevron-left" /></button>
                <span class="tr-ukevelger-tekst">
                    @Uketekst
                    <Icon Name="calendar" />
                </span>
                <button type="button" class="tr-ukepil" title="Neste uke" @onclick="@(() => ByttUke(7))"><Icon Name="chevron-right" /></button>
            </div>
            <button type="button" class="tr-idag" @onclick="GaTilIDag">I dag</button>
            <div class="tr-visningsbytte">
                <button type="button" class="@(_visning == "timeliste" ? "aktiv" : "")" @onclick='@(() => VelgVisning("timeliste"))'>Timeliste</button>
                <button type="button" class="@(_visning == "uke" ? "aktiv" : "")" @onclick='@(() => VelgVisning("uke"))'>Uke</button>
                <button type="button" class="@(_visning == "maned" ? "aktiv" : "")" @onclick='@(() => VelgVisning("maned"))'>Måned</button>
                <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick='@(() => VelgVisning("liste"))'>Liste</button>
            </div>
        </div>
    </nav>

    @if (_fane == "mine")
    {
        <div class="tr-mine">
            <div class="tr-mine-kort">
                <span class="tr-mine-lbl">Denne uken</span>
                <span class="tr-mine-num">@UkeSum.ToString("N1", Kultur) t</span>
                <span class="tr-mine-sub">Mål @Maluketimer.ToString("N1", Kultur) t</span>
            </div>
            <div class="tr-mine-kort">
                <span class="tr-mine-lbl">Denne måneden</span>
                <span class="tr-mine-num">@ManedSum.ToString("N1", Kultur) t</span>
                <span class="tr-mine-sub">@_rader.Count(r => r.Dato.Month == _ukeMandag.Month && r.Dato.Year == _ukeMandag.Year) linjer</span>
            </div>
            <div class="tr-mine-kort">
                <span class="tr-mine-lbl">Fakturerbart denne uken</span>
                <span class="tr-mine-num">@UkensRader.Where(r => r.Fakturerbar).Sum(r => r.Timer).ToString("N1", Kultur) t</span>
                <span class="tr-mine-sub">av @UkeSum.ToString("N1", Kultur) t</span>
            </div>
            <div class="tr-mine-kort">
                <span class="tr-mine-lbl">Venter på godkjenning</span>
                <span class="tr-mine-num">@_rader.Count(r => r.Status == TimeregistreringStatus.Venter)</span>
                <span class="tr-mine-sub">linjer totalt</span>
            </div>
        </div>

        @* Søk og datoperiode over tabellen. Periodefeltene står tomme som
           standard, så lista viser alt til man faktisk velger noe. *@
        <div class="tr-minefilter">
            <label class="tr-minesok">
                <Icon Name="search" />
                <input @bind="_mineSok" @bind:event="oninput" placeholder="Søk prosjekt, aktivitet eller beskrivelse …" />
            </label>
            <label class="tr-minefilter-felt">
                <span>Fra</span>
                <input type="date" @bind="_mineFra" />
            </label>
            <label class="tr-minefilter-felt">
                <span>Til</span>
                <input type="date" @bind="_mineTil" />
            </label>
            <select class="tr-minefilter-select" @bind="_mineStatus">
                <option value="">Alle statuser</option>
                <option value="@TimeregistreringStatus.Venter">Venter</option>
                <option value="@TimeregistreringStatus.Godkjent">Godkjent</option>
                <option value="@TimeregistreringStatus.Avslatt">Avslått</option>
            </select>
            @if (MineFilterAktivt)
            {
                <button type="button" class="tr-minefilter-nullstill" @onclick="NullstillMineFilter">
                    <Icon Name="x" />Nullstill
                </button>
            }
            <span class="tr-minefilter-sum">@MineFiltrerteRader.Count linjer · @MineFiltrerteRader.Sum(r => r.Timer).ToString("N1", Kultur) t</span>
        </div>

        <div class="tr-panel">
            <table class="tr-tabell">
                <thead>
                    <tr>
                        <th>Uke</th>
                        <th>Periode</th>
                        <th class="tr-h">Timer</th>
                        <th class="tr-h">Fakturerbart</th>
                        <th class="tr-h">Linjer</th>
                        <th>Godkjenning</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in MineUker)
                    {
                        <tr @key="@($"uke-{u.Ar}-{u.Uke}")">
                            <td class="tr-sterk">Uke @u.Uke</td>
                            <td>@u.Periode</td>
                            <td class="tr-h tr-sterk">@u.Timer.ToString("N1", Kultur)</td>
                            <td class="tr-h">@u.Fakturerbart.ToString("N1", Kultur)</td>
                            <td class="tr-h">@u.Antall</td>
                            <td>
                                @foreach (var merke in u.Godkjenning)
                                {
                                    <span class="tr-statusmerke tr-statusmerke-@merke.Klasse">@merke.Tekst</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (MineUker.Count == 0)
            {
                <p class="tr-tom">@(MineFilterAktivt ? "Ingen timer i det valgte utvalget." : "Ingen timer registrert ennå.")</p>
            }
        </div>
    }
    else if (_visning == "timeliste")
    {
        @* TR2: én rad per arbeidsordre, dagene som kolonner. Klikk i en celle
           åpner registreringsvinduet med arbeidsordre og dag fylt ut. *@
        var dager = TimelisteDager;
        var rader = TimelisteRader;
        <div class="tr-tl-wrap">
            <table class="tr-tl">
                <thead>
                    <tr>
                        <th>Arbeidsordre</th>
                        @foreach (var d in dager)
                        {
                            <th class="tr-tl-tall @(d == IDag ? "tr-tl-idag" : "")">@StorForbokstav(d.ToString("ddd", Kultur).TrimEnd('.')) @d.Day.@d.Month</th>
                        }
                        <th class="tr-tl-tall">Sum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rader)
                    {
                        <tr>
                            <td>
                                <span class="tr-tl-ao">
                                    <span class="tr-prikk" style="background:@FargeFor(r.Nokkel).Kant"></span>
                                    <span><b>@r.Tittel</b><small>@r.Under</small></span>
                                </span>
                            </td>
                            @foreach (var d in dager)
                            {
                                var t = r.Timer.GetValueOrDefault(d);
                                var dag = d;
                                var aoId = r.ArbeidsordreId;
                                <td class="tr-tl-tall tr-tl-celle @(t == 0 ? "tr-tl-tom" : "") @(d == IDag ? "tr-tl-idag" : "")" title="Registrer timer" @onclick="@(() => ApneRegistrer(aoId, dag))">@(t == 0 ? "–" : t.ToString("0.#", Kultur))</td>
                            }
                            <td class="tr-tl-tall tr-tl-sum">@r.Timer.Values.Sum().ToString("0.#", Kultur)</td>
                        </tr>
                    }
                    <tr class="tr-tl-ny">
                        <td colspan="@(dager.Count + 2)"><button type="button" @onclick="@(() => ApneRegistrer(null, null))"><Icon Name="plus" />Registrer timer på en arbeidsordre</button></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td>Sum per dag</td>
                        @foreach (var d in dager)
                        {
                            <td class="tr-tl-tall">@rader.Sum(r => r.Timer.GetValueOrDefault(d)).ToString("0.#", Kultur)</td>
                        }
                        <td class="tr-tl-tall">@UkeSum.ToString("0.#", Kultur) / @Maluketimer.ToString("0.#", Kultur)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="tr-tl-melding"><Icon Name="check" />@_savedMessage</p>
        }
    }
    else if (_visning == "liste")
    {
        <div class="tr-verktoylinje">
            <button type="button" class="tr-ny-knapp" @onclick="ApneNyRad"><Icon Name="plus" />Ny timelinje</button>

            <label class="tr-filter">
                <span>Prosjekt</span>
                <select @bind="_filterProsjekt">
                    <option value="0">Alle prosjekter</option>
                    @foreach (var p in Prosjekter)
                    {
                        <option value="@p.Nokkel">@p.Navn</option>
                    }
                </select>
            </label>
            <label class="tr-filter">
                <span>Aktivitet</span>
                <select @bind="_filterAktivitet">
                    <option value="">Alle aktiviteter</option>
                    @foreach (var a in Enum.GetValues<TimeAktivitet>())
                    {
                        <option value="@a">@a.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label class="tr-filter">
                <span>Montør</span>
                <select @bind="_filterMontor">
                    <option value="meg">Meg</option>
                    <option value="alle">Alle</option>
                </select>
            </label>

            <div class="tr-ukesum">
                <span class="tr-ukesum-lbl">Totalt denne uken</span>
                <span class="tr-ukesum-num">@UkeSum.ToString("N1", Kultur) t</span>
                <span class="tr-ukesum-bar"><span style="width:@UkeProsent%"></span></span>
                <span class="tr-ukesum-mal">Mål: @Maluketimer.ToString("N1", Kultur) t</span>
            </div>
        </div>

        <div class="tr-panel">
            <table class="tr-tabell tr-tabell-timer">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th>Prosjekt</th>
                        <th>Aktivitet</th>
                        <th>Beskrivelse</th>
                        <th class="tr-h">Timer</th>
                        <th class="tr-h">Start</th>
                        <th class="tr-h">Slutt</th>
                        <th class="tr-meny-kol"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FiltrerteUkerader)
                    {
                        <tr @key="r.Id">
                            <td class="tr-dato">@DatoKort(r.Dato)</td>
                            <td>
                                <span class="tr-prosjekt">
                                    <span class="tr-prikk" style="background:@FargeFor(r.ProsjektNokkel).Kant"></span>
                                    @r.ProsjektNavn
                                </span>
                            </td>
                            <td>@r.Aktivitet.Visningsnavn()</td>
                            <td class="tr-beskrivelse">@r.Beskrivelse</td>
                            <td class="tr-h tr-sterk">@r.Timer.ToString("N1", Kultur)</td>
                            <td class="tr-h">@r.Start.ToString(@"hh\:mm")</td>
                            <td class="tr-h">@r.Slutt.ToString(@"hh\:mm")</td>
                            <td class="tr-meny-kol">
                                <div class="tr-meny-wrap">
                                    <button type="button" class="tr-meny-knapp" title="Flere valg" @onclick="@(() => _apenMenyId = _apenMenyId == r.Id ? null : r.Id)">
                                        <Icon Name="more-vertical" />
                                    </button>
                                    @if (_apenMenyId == r.Id)
                                    {
                                        <div class="tr-meny">
                                            <a href="@($"/arbeidsordre/{r.ArbeidsordreId}")"><Icon Name="folder" />Åpne arbeidsordre</a>
                                            <span class="tr-meny-status">@r.Status.Visningsnavn()</span>
                                            <button type="button" disabled="@(r.Status == TimeregistreringStatus.Godkjent)" @onclick="@(() => Slett(r.Id))">
                                                <Icon Name="trash" />Slett linje
                                            </button>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (_nyRadApen)
                    {
                        <tr class="tr-nyrad">
                            <td><input type="date" @bind="_draft.Dato" /></td>
                            <td>
                                <select @bind="_draft.ArbeidsordreId">
                                    <option value="">Velg arbeidsordre …</option>
                                    @foreach (var a in _ordre)
                                    {
                                        <option value="@a.Id">@a.ProsjektNavn — @a.Tittel</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select @bind="_draft.Aktivitet">
                                    @foreach (var a in Enum.GetValues<TimeAktivitet>())
                                    {
                                        <option value="@a">@a.Visningsnavn()</option>
                                    }
                                </select>
                            </td>
                            <td><input @bind="_draft.Kommentar" placeholder="Beskrivelse" /></td>
                            <td class="tr-h tr-sterk">@DraftTimer.ToString("N1", Kultur)</td>
                            <td class="tr-h"><input type="time" @bind="_draft.Start" /></td>
                            <td class="tr-h"><input type="time" @bind="_draft.Slutt" /></td>
                            <td class="tr-meny-kol tr-nyrad-knapper">
                                <button type="button" class="tr-lagre" title="Lagre" @onclick="Registrer"><Icon Name="check" /></button>
                                <button type="button" class="tr-avbryt" title="Avbryt" @onclick="@(() => _nyRadApen = false)"><Icon Name="x" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (FiltrerteUkerader.Count == 0 && !_nyRadApen)
            {
                <p class="tr-tom">Ingen timer registrert denne uken.</p>
            }

            <div class="tr-tabellfot">
                <button type="button" class="tr-leggtil" @onclick="ApneNyRad"><Icon Name="plus" />Legg til ny rad</button>
                <span class="tr-sum">Sum <strong>@FiltrerteUkerader.Sum(r => r.Timer).ToString("N1", Kultur)</strong></span>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="tr-feil">@_error</p>
            }
        </div>
    }
    else
    {
        <div class="tr-kalender">
            <aside class="tr-sidepanel">
                <div class="tr-panel tr-minikal">
                    <div class="tr-minikal-topp">
                        <button type="button" title="Forrige måned" @onclick="@(() => ByttManed(-1))"><Icon Name="chevron-left" /></button>
                        <span>@Kultur.TextInfo.ToTitleCase(_ukeMandag.ToString("MMMM yyyy", Kultur))</span>
                        <button type="button" title="Neste måned" @onclick="@(() => ByttManed(1))"><Icon Name="chevron-right" /></button>
                    </div>
                    <div class="tr-minikal-ukedager">
                        <span>M</span><span>T</span><span>O</span><span>T</span><span>F</span><span>L</span><span>S</span>
                    </div>
                    <div class="tr-minikal-grid">
                        @foreach (var dag in MinikalenderDager)
                        {
                            @if (dag is null)
                            {
                                <span class="tr-minikal-tom"></span>
                            }
                            else
                            {
                                <button type="button"
                                        class="tr-minikal-dag @(ErIValgtUke(dag.Value) ? "i-uke" : "") @(dag.Value == IDag ? "idag" : "")"
                                        @onclick="@(() => VelgDato(dag.Value))">@dag.Value.Day</button>
                            }
                        }
                    </div>
                </div>

                <div class="tr-panel tr-prosjektfilter">
                    <h2>Prosjekter</h2>
                    <div class="tr-sokefelt">
                        <Icon Name="search" />
                        <input type="search" placeholder="Søk prosjekt …" @bind="_prosjektSok" @bind:event="oninput" />
                    </div>
                    <ul>
                        @foreach (var p in FiltrerteProsjekter)
                        {
                            <li @key="p.Nokkel">
                                <label class="tr-prosjektvalg">
                                    <input type="checkbox" checked="@(!_skjulteProsjekter.Contains(p.Nokkel))"
                                           @onchange="@(() => ToggleProsjekt(p.Nokkel))" />
                                    <span class="tr-prikk" style="background:@FargeFor(p.Nokkel).Kant"></span>
                                    <span class="tr-prosjektnavn">@p.Navn</span>
                                </label>
                            </li>
                        }
                    </ul>
                    @if (FiltrerteProsjekter.Count == 0)
                    {
                        <p class="tr-tom">Ingen treff.</p>
                    }
                </div>
            </aside>

            @if (_visning == "maned")
            {
                <div class="tr-panel tr-manedsgrid">
                    <div class="tr-manedsgrid-ukedager">
                        @foreach (var n in new[] { "Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn" })
                        {
                            <span>@n</span>
                        }
                    </div>
                    @* Hver dagrute viser selve registreringene som små brikker med
                       klokkeslett og "Aktivitet - Prosjekt", ikke bare en sum og
                       noen prikker. Ruta er en div og ikke en knapp, siden den nå
                       inneholder egne knapper. *@
                    <div class="tr-manedsgrid-dager">
                        @foreach (var dag in ManedsrutenettDager)
                        {
                            var dagensRader = SynligeRaderForDag(dag);
                            <div @key="dag"
                                 class="tr-manedsdag @(dag.Month == _ukeMandag.Month ? "" : "utenfor") @(dag == ValgtDato ? "valgt" : "") @(dag == IDag ? "idag" : "")"
                                 @onclick="@(() => VelgDato(dag))">
                                <div class="tr-manedsdag-topp">
                                    <span class="tr-manedsdag-tall">@dag.Day</span>
                                    <button type="button" class="tr-manedsdag-ny" title="@($"Legg til timer {DatoKort(dag.ToDateTime(TimeOnly.MinValue))}")"
                                            @onclick:stopPropagation="true" @onclick="@(() => NyRadForDag(dag))">
                                        <Icon Name="plus" />
                                    </button>
                                </div>

                                @foreach (var r in dagensRader.Take(3))
                                {
                                    var farge = FargeFor(r.ProsjektNokkel);
                                    <button type="button" class="tr-manedsbrikke" @key="r.Id"
                                            style="background:@farge.Flate; border-left-color:@farge.Kant; color:@farge.Blekk"
                                            @onclick:stopPropagation="true" @onclick="@(() => VelgDato(dag))">
                                        <span class="tr-manedsbrikke-ikon"><Icon Name="@AktivitetIkon(r.Aktivitet)" /></span>
                                        <span class="tr-manedsbrikke-tekst">
                                            <span class="tr-manedsbrikke-tid">@r.Start.ToString(@"hh\:mm") – @r.Slutt.ToString(@"hh\:mm")</span>
                                            <span class="tr-manedsbrikke-tittel">@r.Aktivitet.Visningsnavn() – @r.ProsjektNavn</span>
                                        </span>
                                    </button>
                                }

                                @if (dagensRader.Count > 3)
                                {
                                    <span class="tr-manedsdag-flere">+@(dagensRader.Count - 3) til</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="tr-panel tr-ukegrid" style="--tr-dager:@Kalenderdager.Count">
                    <div class="tr-ukegrid-topp">
                        <span class="tr-tidakse-hode"></span>
                        @foreach (var dag in Kalenderdager)
                        {
                            <div class="tr-daghode @(dag == IDag ? "idag" : "")">
                                <span class="tr-daghode-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.') @dag.Day. @dag.ToString("MMM", Kultur).TrimEnd('.')</span>
                                <span class="tr-daghode-sum">@SumForDag(dag).ToString("N1", Kultur) t</span>
                                <button type="button" class="tr-daghode-ny" title="@($"Legg til timer {DatoKort(dag.ToDateTime(TimeOnly.MinValue))}")" @onclick="@(() => NyRadForDag(dag))">
                                    <Icon Name="plus" />
                                </button>
                            </div>
                        }
                    </div>
                    <div class="tr-ukegrid-kropp" style="height:@(((KalSluttTime - KalStartTime) * PxPerTime) + 1)px">
                        <div class="tr-tidakse">
                            @for (var t = KalStartTime; t <= KalSluttTime; t++)
                            {
                                <span class="tr-tidakse-tall" style="top:@((t - KalStartTime) * PxPerTime)px">@t.ToString("00"):00</span>
                            }
                        </div>
                        @foreach (var dag in Kalenderdager)
                        {
                            <div class="tr-dagkolonne" @key="dag">
                                @for (var t = KalStartTime; t <= KalSluttTime; t++)
                                {
                                    <span class="tr-timelinje" style="top:@((t - KalStartTime) * PxPerTime)px"></span>
                                }
                                @foreach (var r in SynligeRaderForDag(dag))
                                {
                                    var farge = FargeFor(r.ProsjektNokkel);
                                    <div class="tr-blokk" @key="r.Id"
                                         style="top:@Topp(r.Start)px; height:@Hoyde(r.Start, r.Slutt)px; background:@farge.Flate; border-left-color:@farge.Kant; color:@farge.Blekk">
                                        <span class="tr-blokk-tittel">@r.ProsjektNavn</span>
                                        <span class="tr-blokk-aktivitet">@r.Aktivitet.Visningsnavn()</span>
                                        <span class="tr-blokk-tid">@r.Start.ToString(@"hh\:mm") – @r.Slutt.ToString(@"hh\:mm")</span>
                                        <span class="tr-blokk-timer">@r.Timer.ToString("N1", Kultur) t</span>
                                    </div>
                                }
                                @if (SynligeRaderForDag(dag).Count == 0)
                                {
                                    <button type="button" class="tr-leggtil-dag" title="@($"Legg til timer {DatoKort(dag.ToDateTime(TimeOnly.MinValue))}")" @onclick="@(() => NyRadForDag(dag))">
                                        <Icon Name="plus" />
                                        <span>Legg til timer</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>

    @if (_dialogApen)
    {
        @* Registrering rett fra uke-/månedsvisningen: pluss på en dag åpner
           dette vinduet med datoen fylt ut, i stedet for å sende brukeren
           over til listevisningen. *@
        <div class="tr-dialog-bakgrunn" @onclick="LukkDialog">
            <div class="tr-dialog" role="dialog" aria-modal="true" aria-labelledby="tr-dialog-tittel" @onclick:stopPropagation="true">
                <div class="tr-dialog-topp">
                    <div>
                        <h2 id="tr-dialog-tittel">Registrer timer</h2>
                        <span class="tr-dialog-dato">@StorForbokstav(_draft.Dato.ToString("dddd d. MMMM yyyy", Kultur))</span>
                    </div>
                    <button type="button" class="tr-dialog-lukk" title="Lukk" @onclick="LukkDialog"><Icon Name="x" /></button>
                </div>

                <div class="tr-dialog-felt">
                    <div class="tr-dialog-full tr-ao-velger">
                        <span class="tr-ao-lbl">Arbeidsordre</span>
                        @{ var valgt = _ordre.FirstOrDefault(a => a.Id == _draft.ArbeidsordreId); }
                        <button type="button" class="tr-ao-felt @(_aoListeApen ? "apen" : "")" @onclick="@(() => _aoListeApen = !_aoListeApen)">
                            @if (valgt is null)
                            {
                                <span class="tr-ao-tom">Velg arbeidsordre …</span>
                            }
                            else
                            {
                                <span class="tr-prikk" style="background:@FargeFor(valgt.ProsjektNokkel).Kant"></span>
                                <span class="tr-ao-valgt"><b>#@valgt.Id · @valgt.Tittel</b><small>@valgt.Kunde</small></span>
                            }
                            <Icon Name="chevron-down" />
                        </button>
                        @if (_aoListeApen)
                        {
                            <div class="tr-ao-liste">
                                <div class="tr-ao-sok"><input @bind="_aoSok" @bind:event="oninput" placeholder="Filtrer på nummer, tittel, prosjekt eller kunde …" /></div>
                                @{ var grupper = AoGrupper; }
                                @foreach (var g in grupper)
                                {
                                    <div class="tr-ao-grp">@g.Navn<em>@g.Ordre.Count</em></div>
                                    @foreach (var a in g.Ordre)
                                    {
                                        var id = a.Id;
                                        <button type="button" class="tr-ao-rad @(a.Id == _draft.ArbeidsordreId ? "valgt" : "")" @onclick="@(() => VelgAo(id))">
                                            <span class="tr-prikk" style="background:@FargeFor(a.ProsjektNokkel).Kant"></span>
                                            <span class="tr-ao-tekst"><b>#@a.Id · @a.Tittel</b><small>@a.Kunde</small></span>
                                            <span class="tr-ao-st">@a.Status.Visningsnavn()</span>
                                        </button>
                                    }
                                }
                                @if (grupper.Count == 0)
                                {
                                    <div class="tr-ao-ingen">Ingen arbeidsordre passer filteret.</div>
                                }
                            </div>
                        }
                    </div>
                    <label>
                        Dag
                        <select value="@_draft.Dato.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) _draft.Dato = d; })">
                            @foreach (var d in DialogDager)
                            {
                                <option value="@d.ToString("yyyy-MM-dd")">@StorForbokstav(d.ToString("dddd d. MMM", Kultur))</option>
                            }
                        </select>
                    </label>
                    <label>
                        Timetype
                        <select @bind="_draft.Aktivitet">
                            @foreach (var a in Enum.GetValues<TimeAktivitet>())
                            {
                                <option value="@a">@a.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    @if (_arbeidKoder.Count > 1)
                    {
                        <label>
                            Kode
                            <select @bind="_draft.PrisKodeId">
                                @foreach (var k in _arbeidKoder)
                                {
                                    <option value="@k.Id">@k.Kode @k.Navn</option>
                                }
                            </select>
                        </label>
                    }
                    <label>
                        Fra
                        <input type="time" @bind="_draft.Start" />
                    </label>
                    <label>
                        Til
                        <input type="time" @bind="_draft.Slutt" />
                    </label>
                    <label>
                        Pause (min)
                        <input type="number" min="0" step="5" @bind="_draft.PauseMinutter" />
                    </label>
                    <label>
                        Eller antall timer
                        <input type="number" min="0" max="24" step="0.5" placeholder="f.eks. 1,5" value="@(_antallTimer?.ToString(CultureInfo.InvariantCulture))" @onchange="SettAntallTimer" />
                    </label>
                    @* Med flere arbeidskoder bestemmer koden timetypen (normal, 50 % eller 100 % overtid). *@
                    @if (_arbeidKoder.Count <= 1)
                    {
                    <label>
                        Type
                        <select @bind="_draft.Type">
                            @foreach (var t in Enum.GetValues<TimeregistreringType>())
                            {
                                <option value="@t">@t.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    }
                    else
                    {
                    <label class="tr-avspasering">
                        <input type="checkbox" checked="@(_draft.Type == TimeregistreringType.Avspasering)"
                               @onchange="@(e => _draft.Type = e.Value is true ? TimeregistreringType.Avspasering : TimeregistreringType.NormalArbeidstid)" />
                        Avspasering
                    </label>
                    }
                    <label class="tr-dialog-full">
                        Kommentar
                        <textarea rows="2" @bind="_draft.Kommentar" placeholder="Hva ble gjort?"></textarea>
                    </label>
                </div>

                <div class="tr-dialog-bunn">
                    <span>Til sammen</span>
                    <span class="tr-dialog-sum">@DraftTimer.ToString("N1", Kultur) t</span>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="tr-feil">@_error</p>
                }

                <div class="tr-dialog-knapper">
                    <button type="button" class="tr-dialog-avbryt" @onclick="LukkDialog">Avbryt</button>
                    <button type="button" class="tr-ny-knapp" @onclick="LagreFraDialog"><Icon Name="check" />Lagre</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery] public int? ArbeidsordreId { get; set; }

    // Satt når man kommer hit fra "Ferdig" på tidsuret på Oppgaver (se
    // MinDag.razor) - forhåndsutfyller start/slutt/pause fra den fullførte
    // økten, og lar oss fjerne den pågående økten fra databasen når
    // registreringen faktisk lagres.
    [SupplyParameterFromQuery(Name = "starttid")] public string? StartTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sluttid")] public string? SluttTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "pause")] public int? PauseQuery { get; set; }
    [SupplyParameterFromQuery(Name = "oktid")] public int? OktIdQuery { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private const decimal Maluketimer = 37.5m;

    // ---------- modeller ----------

    private sealed class RegistreringDraft
    {
        public int? ArbeidsordreId { get; set; }
        public int? MontorId { get; set; }
        public DateTime Dato { get; set; } = DateTime.Today;
        public TimeregistreringType Type { get; set; } = TimeregistreringType.NormalArbeidstid;
        public TimeAktivitet Aktivitet { get; set; } = TimeAktivitet.Montering;
        public TimeOnly Start { get; set; } = new(7, 0);
        public TimeOnly Slutt { get; set; } = new(15, 0);
        public int PauseMinutter { get; set; } = 30;
        public bool Fakturerbar { get; set; } = true;
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
        public int? PrisKodeId { get; set; }
    }

    private sealed class ArbeidsordreOption
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public int ProsjektNokkel { get; set; }
        public string ProsjektNavn { get; set; } = "";
        public string Kunde { get; set; } = "";
        public ArbeidsordreStatus Status { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public DateTime? PlanlagtDato { get; set; }
        public DateTime? PlanlagtSlutt { get; set; }
    }

    private sealed record AoGruppe(string Navn, List<ArbeidsordreOption> Ordre);

    private sealed record TimelisteRad(int ArbeidsordreId, int Nokkel, string Tittel, string Under, Dictionary<DateOnly, decimal> Timer);

    private sealed class Timerad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public int ArbeidsordreId { get; set; }
        public int ProsjektNokkel { get; set; }
        public string ProsjektNavn { get; set; } = "";
        public TimeAktivitet Aktivitet { get; set; }
        public string? Beskrivelse { get; set; }
        public TimeSpan Start { get; set; }
        public TimeSpan Slutt { get; set; }
        public decimal Timer { get; set; }
        public bool Fakturerbar { get; set; }
        public TimeregistreringStatus Status { get; set; }
        public int MontorId { get; set; }
    }

    private sealed record ProsjektValg(int Nokkel, string Navn);

    private sealed record StatusMerke(string Tekst, string Klasse);

    private sealed record UkeRad(int Ar, int Uke, string Periode, decimal Timer, decimal Fakturerbart, int Antall, List<StatusMerke> Godkjenning);

    // ---------- tilstand ----------

    private RegistreringDraft _draft = new();
    // Arbeidskodene (priskoder) timene kan føres på. Velges bare når det er flere.
    private List<PrisKode> _arbeidKoder = [];
    private List<ArbeidsordreOption> _ordre = [];
    private List<Timerad> _rader = [];
    private int? _naverendeBrukerId;
    private string? _error;
    private string? _savedMessage;

    private string _fane = "registrer";
    private string _visning = "timeliste";
    private bool _aoListeApen;
    private string _aoSok = "";
    private decimal? _antallTimer;
    private DateOnly _ukeMandag = FinnMandag(DateOnly.FromDateTime(DateTime.Today));

    private int _filterProsjekt;
    private string _filterAktivitet = "";
    private string _filterMontor = "meg";
    private string _prosjektSok = "";
    private readonly HashSet<int> _skjulteProsjekter = [];
    private bool _nyRadApen;
    private bool _dialogApen;
    private int? _apenMenyId;

    private DateOnly _mobilValgtDato = DateOnly.FromDateTime(DateTime.Today);

    private static DateOnly IDag => DateOnly.FromDateTime(DateTime.Today);

    // ---------- avledet ----------

    private static DateOnly FinnMandag(DateOnly dato) => dato.AddDays(-(((int)dato.DayOfWeek + 6) % 7));

    private DateOnly UkeSondag => _ukeMandag.AddDays(6);

    private string Uketekst =>
        $"Uke {ISOWeek.GetWeekOfYear(_ukeMandag.ToDateTime(TimeOnly.MinValue))}, " +
        $"{_ukeMandag.Day}. – {UkeSondag.Day}. {UkeSondag.ToString("MMM", Kultur).TrimEnd('.')} {UkeSondag.Year}";

    private List<Timerad> MineRader => _rader
        .Where(r => _filterMontor == "alle" || r.MontorId == _naverendeBrukerId)
        .ToList();

    private List<Timerad> UkensRader => MineRader
        .Where(r => DateOnly.FromDateTime(r.Dato) >= _ukeMandag && DateOnly.FromDateTime(r.Dato) <= UkeSondag)
        .OrderBy(r => r.Dato).ThenBy(r => r.Start)
        .ToList();

    private List<Timerad> FiltrerteUkerader => UkensRader
        .Where(r => _filterProsjekt == 0 || r.ProsjektNokkel == _filterProsjekt)
        .Where(r => _filterAktivitet.Length == 0 || r.Aktivitet.ToString() == _filterAktivitet)
        .ToList();

    private decimal UkeSum => UkensRader.Sum(r => r.Timer);
    private decimal ManedSum => MineRader.Where(r => r.Dato.Year == _ukeMandag.Year && r.Dato.Month == _ukeMandag.Month).Sum(r => r.Timer);
    private int UkeProsent => Maluketimer <= 0 ? 0 : (int)Math.Min(100, Math.Round(UkeSum / Maluketimer * 100));

    private decimal DraftTimer => Math.Max(0, (decimal)(_draft.Slutt - _draft.Start).TotalHours - _draft.PauseMinutter / 60m);

    private List<ProsjektValg> Prosjekter => _ordre
        .GroupBy(a => a.ProsjektNokkel)
        .Select(g => new ProsjektValg(g.Key, g.First().ProsjektNavn))
        .OrderBy(p => p.Navn, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private List<ProsjektValg> FiltrerteProsjekter => Prosjekter
        .Where(p => _prosjektSok.Length == 0 || p.Navn.Contains(_prosjektSok.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Søket og datoperioden over "Mine timer"-tabellen.
    private string _mineSok = "";
    private DateTime? _mineFra;
    private DateTime? _mineTil;
    private string _mineStatus = "";

    private bool MineFilterAktivt =>
        _mineSok.Length > 0 || _mineFra is not null || _mineTil is not null || _mineStatus.Length > 0;

    private void NullstillMineFilter()
    {
        _mineSok = "";
        _mineFra = null;
        _mineTil = null;
        _mineStatus = "";
    }

    private List<Timerad> MineFiltrerteRader => MineRader
        .Where(r => _mineFra is null || r.Dato.Date >= _mineFra.Value.Date)
        .Where(r => _mineTil is null || r.Dato.Date <= _mineTil.Value.Date)
        .Where(r => _mineStatus.Length == 0 || r.Status.ToString() == _mineStatus)
        .Where(r => _mineSok.Length == 0
            || r.ProsjektNavn.Contains(_mineSok, StringComparison.OrdinalIgnoreCase)
            || r.Aktivitet.Visningsnavn().Contains(_mineSok, StringComparison.OrdinalIgnoreCase)
            || (r.Beskrivelse?.Contains(_mineSok, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private List<UkeRad> MineUker => MineFiltrerteRader
        .GroupBy(r => (Ar: ISOWeek.GetYear(r.Dato), Uke: ISOWeek.GetWeekOfYear(r.Dato)))
        .OrderByDescending(g => g.Key.Ar).ThenByDescending(g => g.Key.Uke)
        .Select(g =>
        {
            var mandag = FinnMandag(DateOnly.FromDateTime(g.Min(r => r.Dato)));
            return new UkeRad(
                g.Key.Ar,
                g.Key.Uke,
                $"{mandag:dd.MM} – {mandag.AddDays(6):dd.MM.yyyy}",
                g.Sum(r => r.Timer),
                g.Where(r => r.Fakturerbar).Sum(r => r.Timer),
                g.Count(),
                GodkjenningsMerker(g.ToList()));
        })
        .ToList();

    // Én uke kan ha linjer i flere tilstander, så kolonnen viser et merke pr.
    // tilstand som faktisk finnes - ikke bare den vanligste.
    private static List<StatusMerke> GodkjenningsMerker(List<Timerad> rader)
    {
        var merker = new List<StatusMerke>();

        var godkjent = rader.Count(r => r.Status == TimeregistreringStatus.Godkjent);
        var venter = rader.Count(r => r.Status == TimeregistreringStatus.Venter);
        var avslatt = rader.Count(r => r.Status == TimeregistreringStatus.Avslatt);

        if (godkjent == rader.Count)
        {
            return [new StatusMerke("Godkjent", "godkjent")];
        }

        if (venter > 0)
        {
            merker.Add(new StatusMerke($"{venter} venter", "venter"));
        }

        if (avslatt > 0)
        {
            merker.Add(new StatusMerke($"{avslatt} avslått", "avslatt"));
        }

        if (godkjent > 0)
        {
            merker.Add(new StatusMerke($"{godkjent} godkjent", "godkjent"));
        }

        return merker;
    }

    // Mandag-fredag som standard, men helgen tas med hvis det faktisk er ført
    // timer der - ellers ville de vært usynlige i kalenderen.
    private List<DateOnly> Kalenderdager
    {
        get
        {
            var antall = UkensRader.Any(r => DateOnly.FromDateTime(r.Dato) > _ukeMandag.AddDays(4)) ? 7 : 5;
            return Enumerable.Range(0, antall).Select(i => _ukeMandag.AddDays(i)).ToList();
        }
    }

    private List<DateOnly?> MinikalenderDager
    {
        get
        {
            var forste = new DateOnly(_ukeMandag.Year, _ukeMandag.Month, 1);
            var dager = new List<DateOnly?>();
            for (var i = 0; i < ((int)forste.DayOfWeek + 6) % 7; i++)
            {
                dager.Add(null);
            }
            for (var d = 1; d <= DateTime.DaysInMonth(forste.Year, forste.Month); d++)
            {
                dager.Add(new DateOnly(forste.Year, forste.Month, d));
            }
            return dager;
        }
    }

    private List<DateOnly> ManedsrutenettDager
    {
        get
        {
            var start = FinnMandag(new DateOnly(_ukeMandag.Year, _ukeMandag.Month, 1));
            return Enumerable.Range(0, 42).Select(i => start.AddDays(i)).ToList();
        }
    }

    private bool ErIValgtUke(DateOnly dag) => dag >= _ukeMandag && dag <= UkeSondag;

    private DateOnly ValgtDato => DateOnly.FromDateTime(_draft.Dato);

    // Symbolet på brikkene i månedsrutenettet - samme type arbeid skal ha samme
    // ikon uansett hvilket prosjekt timene er ført på.
    private static string AktivitetIkon(TimeAktivitet aktivitet) => aktivitet switch
    {
        TimeAktivitet.Montering => "tool",
        TimeAktivitet.Programmering => "server",
        TimeAktivitet.Service => "settings",
        TimeAktivitet.Befaring => "eye",
        TimeAktivitet.Mote => "users",
        TimeAktivitet.Dokumentasjon => "file-text",
        TimeAktivitet.Kjoring => "map-pin",
        _ => "building"
    };

    private decimal SumForDag(DateOnly dag) => MineRader.Where(r => DateOnly.FromDateTime(r.Dato) == dag).Sum(r => r.Timer);

    private List<Timerad> RaderForDag(DateOnly dag) => MineRader
        .Where(r => DateOnly.FromDateTime(r.Dato) == dag)
        .OrderBy(r => r.Start)
        .ToList();

    private List<Timerad> SynligeRaderForDag(DateOnly dag) => RaderForDag(dag)
        .Where(r => !_skjulteProsjekter.Contains(r.ProsjektNokkel))
        .ToList();

    private static string DatoKort(DateTime dato) =>
        $"{Kultur.TextInfo.ToTitleCase(dato.ToString("ddd", Kultur)).TrimEnd('.')} {dato:dd.MM}";

    // ---------- kalenderens tidsakse ----------

    private const int PxPerTime = 52;

    private int KalStartTime
    {
        get
        {
            var tidligst = UkensRader.Count == 0 ? 7 : (int)Math.Floor(UkensRader.Min(r => r.Start.TotalHours));
            return Math.Clamp(Math.Min(7, tidligst), 0, 12);
        }
    }

    private int KalSluttTime
    {
        get
        {
            var senest = UkensRader.Count == 0 ? 16 : (int)Math.Ceiling(UkensRader.Max(r => r.Slutt.TotalHours));
            return Math.Clamp(Math.Max(16, senest), KalStartTime + 4, 24);
        }
    }

    private double Topp(TimeSpan start) => Math.Max(0, (start.TotalHours - KalStartTime) * PxPerTime);
    private double Hoyde(TimeSpan start, TimeSpan slutt) => Math.Max(34, (slutt - start).TotalHours * PxPerTime);

    // Felles palett med Kalender og Min dag - se Models/AktivitetFarge.cs.
    private static Fargepar FargeFor(int nokkel) => AktivitetFarge.Velg(nokkel);

    // ---------- mobil (uendret visning) ----------

    private List<DateOnly> MobilUkeDager
    {
        get
        {
            var mandag = FinnMandag(_mobilValgtDato);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

