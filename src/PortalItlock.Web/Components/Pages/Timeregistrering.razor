    // Antall timer i stedet for fra–til: regnes om til fra 07:00 uten pause.
    private void SettAntallTimer(ChangeEventArgs e)
    {
        var tekst = e.Value?.ToString()?.Replace(',', '.');
        if (!decimal.TryParse(tekst, NumberStyles.Number, CultureInfo.InvariantCulture, out var t) || t <= 0)
        {
            _antallTimer = null;
            return;
        }
        t = Math.Min(t, 17m);
        _antallTimer = t;
        _draft.Start = new TimeOnly(7, 0);
        _draft.PauseMinutter = 0;
        _draft.Slutt = _draft.Start.AddMinutes((double)(t * 60));
    }

