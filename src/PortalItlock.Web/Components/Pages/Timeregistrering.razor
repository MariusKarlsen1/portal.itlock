    private sealed class UkeGruppe
    {
        public int Ar { get; set; }
        public int Uke { get; set; }
        public List<RegistreringRad> Rader { get; set; } = [];
        public decimal SumTimer => Rader.Sum(r => r.Timer);
        public decimal SumKm => Rader.Sum(r => r.Kilometer);
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private RegistreringDraft _draft = new();
    private List<ArbeidsordreOption> _ordre = [];
    private List<UkeGruppe> _uker = [];
    private decimal _kmSats = 5;
    private string? _error;
    private string? _savedMessage;
    private DateOnly _mobilValgtDato = DateOnly.FromDateTime(DateTime.Today);

    private List<DateOnly> MobilUkeDager
    {
        get
        {
            var diff = ((int)_mobilValgtDato.DayOfWeek + 6) % 7;
            var mandag = _mobilValgtDato.AddDays(-diff);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

    private List<RegistreringRad> MobilDagensRader =>
        _uker.SelectMany(u => u.Rader).Where(r => DateOnly.FromDateTime(r.Dato) == _mobilValgtDato).ToList();

    private void VelgMobilDag(DateOnly dag)
    {
        _mobilValgtDato = dag;
    }

    private async Task RegistrerMobil()
    {
        _draft.Dato = _mobilValgtDato.ToDateTime(TimeOnly.MinValue);
        await Registrer();
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private const decimal ForventetUketimer = 37.5m;

    private int DenneUkenAr => ISOWeek.GetYear(DateTime.Today);
    private int DenneUkenNummer => ISOWeek.GetWeekOfYear(DateTime.Today);

    private UkeGruppe? DenneUken => _uker.FirstOrDefault(u => u.Ar == DenneUkenAr && u.Uke == DenneUkenNummer);
    private decimal DenneUkenTimer => DenneUken?.SumTimer ?? 0;
    private decimal DenneUkenKm => DenneUken?.SumKm ?? 0;
    private int UkeRingProsent => (int)Math.Min(100, ForventetUketimer <= 0 ? 0 : DenneUkenTimer / ForventetUketimer * 100);

    // ---------- Skrivebord: tre visninger (Timeføring/Kalender/Arbeidsordre) ----------

    private string _hovedfane = "timeforing";
    private bool _visHurtigForm;

    private static DateOnly FinnMandag(DateOnly dato)
    {
        var diff = ((int)dato.DayOfWeek + 6) % 7;
        return dato.AddDays(-diff);
    }

    private static string KortType(TimeregistreringType type) => type switch
    {
        TimeregistreringType.NormalArbeidstid => "Normal",
        TimeregistreringType.Overtid50 => "Overtid 50%",
        TimeregistreringType.Overtid100 => "Overtid 100%",
        TimeregistreringType.Avspasering => "Avspasering",
        _ => type.ToString()
    };

    private static string DeltaTekst(decimal na, decimal forrige)
    {
        var diff = na - forrige;
        return diff switch
        {
            0 => "Uendret fra forrige uke",
            > 0 => $"+{diff.ToString("N1", Kultur)} t fra forrige uke",
            _ => $"{diff.ToString("N1", Kultur)} t fra forrige uke"
        };
    }

    private static string ProsentDeltaTekst(decimal na, decimal forrige)
    {
        if (forrige <= 0)
        {
            return na > 0 ? "Nytt fra forrige måned" : "Uendret fra forrige måned";
        }

        var prosent = Math.Round((na - forrige) / forrige * 100, 0);
        return prosent switch
        {
            0 => "Uendret fra forrige måned",
            > 0 => $"+{prosent}% fra forrige måned",
            _ => $"{prosent}% fra forrige måned"
        };
    }

    // ---------- Timeføring-fane ----------

    private DateOnly _valgtUkeMandag = FinnMandag(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly _valgtDag = DateOnly.FromDateTime(DateTime.Today);

    private List<DateOnly> UkensDager => Enumerable.Range(0, 7).Select(i => _valgtUkeMandag.AddDays(i)).ToList();

    private void GaTilIDag()
    {
        _valgtDag = DateOnly.FromDateTime(DateTime.Today);
        _valgtUkeMandag = FinnMandag(_valgtDag);
    }

    private decimal SumForDag(DateOnly dag) =>
        _uker.SelectMany(u => u.Rader).Where(r => DateOnly.FromDateTime(r.Dato) == dag).Sum(r => r.Timer);

    private List<RegistreringRad> RaderForDag(DateOnly dag) =>
        _uker.SelectMany(u => u.Rader).Where(r => DateOnly.FromDateTime(r.Dato) == dag).OrderBy(r => r.Dato).ToList();

    private decimal ForrigeUkenTimer
    {
        get
        {
            var forrigeMandag = FinnMandag(DateOnly.FromDateTime(DateTime.Today)).AddDays(-7).ToDateTime(TimeOnly.MinValue);
            var ar = ISOWeek.GetYear(forrigeMandag);
            var uke = ISOWeek.GetWeekOfYear(forrigeMandag);
            return _uker.FirstOrDefault(u => u.Ar == ar && u.Uke == uke)?.SumTimer ?? 0;
        }
    }

    private decimal DenneManedenTimer =>
        _uker.SelectMany(u => u.Rader).Where(r => r.Dato.Year == DateTime.Today.Year && r.Dato.Month == DateTime.Today.Month).Sum(r => r.Timer);

    private decimal ForrigeManedenTimer
    {
        get
        {
            var forrige = DateTime.Today.AddMonths(-1);
            return _uker.SelectMany(u => u.Rader).Where(r => r.Dato.Year == forrige.Year && r.Dato.Month == forrige.Month).Sum(r => r.Timer);
        }
    }

