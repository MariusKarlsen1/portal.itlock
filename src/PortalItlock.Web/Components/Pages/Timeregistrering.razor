@page "/timeregistrering"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Timeregistrering</PageTitle>

<div class="mobil-tidsreg-wrap">
    <div class="mobil-ukestripe">
        @foreach (var dag in MobilUkeDager)
        {
            <button type="button" class="mobil-ukedag @(dag == _mobilValgtDato ? "aktiv" : "")" @onclick="@(() => VelgMobilDag(dag))">
                <span class="mobil-ukedag-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
                <span class="mobil-ukedag-tall">@dag.Day.ToString("00")</span>
            </button>
        }
    </div>

    <div class="mobil-reg-form">
        <label>
            Arbeidsordre
            <select @bind="_draft.ArbeidsordreId">
                <option value="">Velg arbeidsordre...</option>
                @foreach (var a in _ordre)
                {
                    <option value="@a.Id">@a.Tittel</option>
                }
            </select>
        </label>
        <div class="mobil-reg-rad">
            <label>
                Type
                <select @bind="_draft.Type">
                    @foreach (var t in Enum.GetValues<TimeregistreringType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Start
                <input type="time" @bind="_draft.Start" />
            </label>
            <label>
                Slutt
                <input type="time" @bind="_draft.Slutt" />
            </label>
        </div>
        <button type="button" class="save-button mobil-reg-knapp" @onclick="RegistrerMobil">Registrer timer</button>
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="form-error">@_error</span>
        }
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="save-success">@_savedMessage</span>
        }
    </div>

    <div class="mobil-reg-liste">
        @if (MobilDagensRader.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert denne dagen.</p>
        }
        else
        {
            @foreach (var r in MobilDagensRader)
            {
                <div @key="@($"mobil-{r.Id}")" class="mobil-ordre-kort mobil-kant-@(r.Status == TimeregistreringStatus.Godkjent ? "gronn" : r.Status == TimeregistreringStatus.Avslatt ? "rod" : "gul")">
                    <div class="mobil-ordre-topp">
                        <span class="mobil-ordre-tittel">@r.ArbeidsordreTittel</span>
                        <span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span>
                    </div>
                    <div class="mobil-ordre-meta">@r.Type.Visningsnavn() &middot; @r.Timer.ToString("N1", Kultur) t</div>
                </div>
            }
        }
    </div>
</div>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="clock" /></span>
    <div>
        <h1>Timeregistrering</h1>
        <p class="section-hint">Registrer timer på en arbeidsordre. Timene summeres per uke og per arbeidsordre.</p>
    </div>
</div>

<div class="hero-rad">
    <div class="kort hero-kort">
        <div class="ring" style="background:conic-gradient(var(--itlock-accent) 0% @(UkeRingProsent)%, var(--itlock-border) @(UkeRingProsent)% 100%);">
            <div class="ring-indre">
                <span class="ring-tall">@DenneUkenTimer.ToString("N1", Kultur) t</span>
                <span class="ring-label">av @ForventetUketimer.ToString("N1", Kultur) t</span>
            </div>
        </div>
        <p class="hero-sub">Uke @DenneUkenNummer, @DenneUkenAr@(DenneUkenKm > 0 ? $" · {DenneUkenKm:N0} km kjørt" : "")</p>
    </div>

    <div class="kort form-kort">
        <div class="kort-tittel-rad"><h2>Ny registrering</h2></div>
        <div class="field-grid">
            <label>
                Dato
                <input type="date" @bind="_draft.Dato" />
            </label>
            <label class="span-2">
                Arbeidsordre
                <select @bind="_draft.ArbeidsordreId">
                    <option value="">Velg arbeidsordre...</option>
                    @foreach (var a in _ordre)
                    {
                        <option value="@a.Id">@a.Tittel</option>
                    }
                </select>
            </label>
            <label>
                Type
                <select @bind="_draft.Type">
                    @foreach (var t in Enum.GetValues<TimeregistreringType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Start
                <input type="time" @bind="_draft.Start" />
            </label>
            <label>
                Slutt
                <input type="time" @bind="_draft.Slutt" />
            </label>
            <label>
                Pause (min)
                <input @bind="_draft.PauseMinutter" />
            </label>
            <label>
                Kjørt (km)
                <input @bind="_draft.Kilometer" placeholder="0" />
            </label>
            <label class="span-2">
                Kommentar
                <input @bind="_draft.Kommentar" placeholder="Valgfritt" />
            </label>
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Registrer">Registrer timer</button>
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="form-error">@_error</span>
            }
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>
    </div>
</div>

<div class="kort">
    <div class="kort-tittel-rad">
        <h2>Timeliste</h2>
        <label class="sats-felt">
            Kjøregodtgjørelse (kr/km)
            <input @bind="_kmSats" />
        </label>
    </div>

    @if (_uker.Count == 0)
    {
        <p class="list-empty">Ingen timer registrert ennå.</p>
    }
    else
    {
        @foreach (var uke in _uker)
        {
            <div class="uke-block">
                <div class="uke-header">
                    <span>Uke @uke.Uke, @uke.Ar</span>
                    <span class="uke-sum">
                        @uke.SumTimer.ToString("N1", Kultur) t
                        @if (uke.SumKm > 0)
                        {
                            <text> · @uke.SumKm.ToString("N0", Kultur) km (@((uke.SumKm * _kmSats).ToString("N0", Kultur)) kr)</text>
                        }
                    </span>
                </div>
                <table class="reg-table">
                    <thead>
                        <tr>
                            <th>Dato</th>
                            <th>Type</th>
                            <th>Arbeidsordre</th>
                            <th>Timer</th>
                            <th>Km</th>
                            <th>Kommentar</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in uke.Rader)
                        {
                            <tr @key="r.Id">
                                <td>@r.Dato.ToString("ddd dd.MM.yyyy", Kultur)</td>
                                <td>@r.Type.Visningsnavn()</td>
                                <td><a href="@($"/arbeidsordre/{r.ArbeidsordreId}")">@r.ArbeidsordreTittel</a></td>
                                <td class="timer-cell">@r.Timer.ToString("N1", Kultur) t</td>
                                <td>@(r.Kilometer > 0 ? r.Kilometer.ToString("N0", Kultur) : "")</td>
                                <td>@r.Kommentar</td>
                                <td>
                                    <span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span>
                                </td>
                                <td class="handling-cell">
                                    @if (r.Status != TimeregistreringStatus.Godkjent)
                                    {
                                        <button type="button" class="btn-liten btn-slett" @onclick="@(() => Slett(r.Id))">Slett</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public int? ArbeidsordreId { get; set; }

    // Satt når man kommer hit fra "Ferdig" på tidsuret på Oppgaver (se
    // MinDag.razor) - forhåndsutfyller start/slutt/pause fra den fullførte
    // økten, og lar oss fjerne den pågående økten fra databasen når
    // registreringen faktisk lagres.
    [SupplyParameterFromQuery(Name = "starttid")] public string? StartTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sluttid")] public string? SluttTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "pause")] public int? PauseQuery { get; set; }
    [SupplyParameterFromQuery(Name = "oktid")] public int? OktIdQuery { get; set; }

    private sealed class RegistreringDraft
    {
        public int? ArbeidsordreId { get; set; }
        public int? MontorId { get; set; }
        public DateTime Dato { get; set; } = DateTime.Today;
        public TimeregistreringType Type { get; set; } = TimeregistreringType.NormalArbeidstid;
        public TimeOnly Start { get; set; } = new(7, 0);
        public TimeOnly Slutt { get; set; } = new(15, 0);
        public int PauseMinutter { get; set; } = 30;
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
    }

    private sealed class ArbeidsordreOption
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
    }

    private sealed class RegistreringRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public TimeregistreringType Type { get; set; }
        public int ArbeidsordreId { get; set; }
        public string ArbeidsordreTittel { get; set; } = "";
        public decimal Timer { get; set; }
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
        public TimeregistreringStatus Status { get; set; }
    }

    private sealed class UkeGruppe
    {
        public int Ar { get; set; }
        public int Uke { get; set; }
        public List<RegistreringRad> Rader { get; set; } = [];
        public decimal SumTimer => Rader.Sum(r => r.Timer);
        public decimal SumKm => Rader.Sum(r => r.Kilometer);
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private RegistreringDraft _draft = new();
    private List<ArbeidsordreOption> _ordre = [];
    private List<UkeGruppe> _uker = [];
    private decimal _kmSats = 5;
    private string? _error;
    private string? _savedMessage;
    private DateOnly _mobilValgtDato = DateOnly.FromDateTime(DateTime.Today);

    private List<DateOnly> MobilUkeDager
    {
        get
        {
            var diff = ((int)_mobilValgtDato.DayOfWeek + 6) % 7;
            var mandag = _mobilValgtDato.AddDays(-diff);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

    private List<RegistreringRad> MobilDagensRader =>
        _uker.SelectMany(u => u.Rader).Where(r => DateOnly.FromDateTime(r.Dato) == _mobilValgtDato).ToList();

    private void VelgMobilDag(DateOnly dag)
    {
        _mobilValgtDato = dag;
    }

    private async Task RegistrerMobil()
    {
        _draft.Dato = _mobilValgtDato.ToDateTime(TimeOnly.MinValue);
        await Registrer();
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private const decimal ForventetUketimer = 37.5m;

    private int DenneUkenAr => ISOWeek.GetYear(DateTime.Today);
    private int DenneUkenNummer => ISOWeek.GetWeekOfYear(DateTime.Today);

    private UkeGruppe? DenneUken => _uker.FirstOrDefault(u => u.Ar == DenneUkenAr && u.Uke == DenneUkenNummer);
    private decimal DenneUkenTimer => DenneUken?.SumTimer ?? 0;
    private decimal DenneUkenKm => DenneUken?.SumKm ?? 0;
    private int UkeRingProsent => (int)Math.Min(100, ForventetUketimer <= 0 ? 0 : DenneUkenTimer / ForventetUketimer * 100);

    protected override async Task OnInitializedAsync()
    {
        if (ArbeidsordreId.HasValue)
        {
            _draft.ArbeidsordreId = ArbeidsordreId;
        }

        if (TimeOnly.TryParse(StartTidQuery, out var startFraOkt))
        {
            _draft.Start = startFraOkt;
        }
        if (TimeOnly.TryParse(SluttTidQuery, out var sluttFraOkt))
        {
            _draft.Slutt = sluttFraOkt;
        }
        if (PauseQuery.HasValue)
        {
            _draft.PauseMinutter = PauseQuery.Value;
        }

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                var bruker = await Db.Brukere.FindAsync(bid);
                _naverendeBrukerId = bruker?.Id;
            }
        }

        _draft.MontorId = _naverendeBrukerId;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _ordre = await Db.Arbeidsordre
            .OrderBy(a => a.Tittel)
            .Select(a => new ArbeidsordreOption { Id = a.Id, Tittel = a.Tittel })
            .ToListAsync();

        var registreringer = await Db.Timeregistreringer
            .Include(t => t.Arbeidsordre)
            .Where(t => t.MontorId == _naverendeBrukerId)
            .OrderByDescending(t => t.Dato)
            .ThenByDescending(t => t.Id)
            .ToListAsync();

        var rader = registreringer.Select(t => new RegistreringRad
        {
            Id = t.Id,
            Dato = t.Dato,
            Type = t.Type,
            ArbeidsordreId = t.ArbeidsordreId,
            ArbeidsordreTittel = t.Arbeidsordre?.Tittel ?? "-",
            Timer = t.TotalTimer,
            Kommentar = t.Kommentar,
            Kilometer = t.Kilometer,
            Status = t.Status
        });

        _uker = rader
            .GroupBy(r => (Ar: ISOWeek.GetYear(r.Dato), Uke: ISOWeek.GetWeekOfYear(r.Dato)))
            .OrderByDescending(g => g.Key.Ar).ThenByDescending(g => g.Key.Uke)
            .Select(g => new UkeGruppe { Ar = g.Key.Ar, Uke = g.Key.Uke, Rader = g.ToList() })
            .ToList();
    }

    private async Task Registrer()
    {
        _error = null;
        _savedMessage = null;

        if (_draft.MontorId is null)
        {
            _error = "Fant ikke innlogget bruker.";
            return;
        }

        if (_draft.ArbeidsordreId is null)
        {
            _error = "Velg arbeidsordre.";
            return;
        }

        if (_draft.Slutt <= _draft.Start)
        {
            _error = "Slutt må være etter start.";
            return;
        }

        Db.Timeregistreringer.Add(new Models.Timeregistrering
        {
            ArbeidsordreId = _draft.ArbeidsordreId.Value,
            MontorId = _draft.MontorId.Value,
            Dato = _draft.Dato,
            Start = _draft.Start.ToTimeSpan(),
            Slutt = _draft.Slutt.ToTimeSpan(),
            PauseMinutter = _draft.PauseMinutter,
            Type = _draft.Type,
            Kommentar = string.IsNullOrWhiteSpace(_draft.Kommentar) ? null : _draft.Kommentar.Trim(),
            Kilometer = _draft.Kilometer
        });
        await Db.SaveChangesAsync();

        // Kom hit fra "Ferdig" på tidsuret på Oppgaver - den pågående økten
        // er nå omgjort til en ekte registrering, så den kan fjernes.
        if (OktIdQuery.HasValue)
        {
            var okt = await Db.AktiveTimeOkter.FirstOrDefaultAsync(o => o.Id == OktIdQuery.Value);
            if (okt is not null)
            {
                Db.AktiveTimeOkter.Remove(okt);
                await Db.SaveChangesAsync();
            }
            OktIdQuery = null;
        }

        _savedMessage = "Timer registrert.";
        var behold = new RegistreringDraft { ArbeidsordreId = _draft.ArbeidsordreId, MontorId = _draft.MontorId, Dato = _draft.Dato };
        _draft = behold;
        await LoadAsync();
    }

    private async Task Slett(int id)
    {
        var reg = await Db.Timeregistreringer.FirstOrDefaultAsync(t => t.Id == id && t.MontorId == _naverendeBrukerId);
        if (reg is null || reg.Status == TimeregistreringStatus.Godkjent)
        {
            return;
        }

        Db.Timeregistreringer.Remove(reg);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string StatusCss(TimeregistreringStatus status) => status switch
    {
        TimeregistreringStatus.Godkjent => "status-godkjent",
        TimeregistreringStatus.Avslatt => "status-avslatt",
        _ => "status-venter"
    };
}
