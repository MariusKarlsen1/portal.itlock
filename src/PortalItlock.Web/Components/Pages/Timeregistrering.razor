    protected override async Task OnInitializedAsync()
    {
        var koder = await Db.PrisKoder.AsNoTracking().OrderBy(k => k.Rekkefolge).ThenBy(k => k.Kode).ToListAsync();
        _arbeidKoder = koder.Where(k => k.Aktiv && k.Type == PrisKodeType.Arbeid && k.Enhet == PrisKodeEnhet.Time).ToList();
        _draft.PrisKodeId = PortalItlock.Web.Services.ArbeidsordreOkonomiBeregner.Montasjekode(_arbeidKoder)?.Id;

        if (ArbeidsordreId.HasValue)
        {
            _draft.ArbeidsordreId = ArbeidsordreId;
            _nyRadApen = true;
        }

        if (TimeOnly.TryParse(StartTidQuery, out var startFraOkt))
        {
            _draft.Start = startFraOkt;
        }
        if (TimeOnly.TryParse(SluttTidQuery, out var sluttFraOkt))
        {
            _draft.Slutt = sluttFraOkt;
        }
        if (PauseQuery.HasValue)
        {
            _draft.PauseMinutter = PauseQuery.Value;
        }

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var bid))
            {
                var bruker = await Db.Brukere.FindAsync(bid);
                _naverendeBrukerId = bruker?.Id;
            }
        }

        _draft.MontorId = _naverendeBrukerId;
        _visning = await VisningPref.HentAsync("timeregistrering", _visning);
        _full = await VisningPref.HentAsync("timeregistrering-bredde", "normal") == "full";

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var ordreRaw = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.Kunde)
            .OrderBy(a => a.Tittel)
            .ToListAsync();

        // Arbeidsordrer uten prosjekt får en egen "nøkkel" avledet av ordre-id
        // (negativ, så den aldri kolliderer med et ekte prosjekt). Da får de
        // likevel egen farge og eget valg i prosjektfilteret.
        _ordre = ordreRaw.Select(a => new ArbeidsordreOption
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNokkel = a.ProsjektId ?? -a.Id,
            ProsjektNavn = a.Prosjekt?.Navn ?? a.Tittel,
            Kunde = string.Join(" · ", new[] { a.Kunde?.Navn, a.Prosjekt?.Navn }.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct()),
            Status = a.Status,
            AnsvarligMontorId = a.AnsvarligMontorId,
            PlanlagtDato = a.PlanlagtDato,
            PlanlagtSlutt = a.PlanlagtSlutt
        }).ToList();

        var oppslag = _ordre.ToDictionary(a => a.Id);

        // Sorteringen på Start gjøres i minnet - SQLite kan ikke sortere på
        // TimeSpan-kolonner (NotSupportedException i ORDER BY).
        var registreringer = await Db.Timeregistreringer
            .OrderByDescending(t => t.Dato)
            .ToListAsync();

        _rader = registreringer
            .OrderByDescending(t => t.Dato)
            .ThenBy(t => t.Start)
            .Select(t =>
        {
            oppslag.TryGetValue(t.ArbeidsordreId, out var ordre);
            return new Timerad
            {
                Id = t.Id,
                Dato = t.Dato,
                ArbeidsordreId = t.ArbeidsordreId,
                ProsjektNokkel = ordre?.ProsjektNokkel ?? -t.ArbeidsordreId,
                ProsjektNavn = ordre?.ProsjektNavn ?? "Ukjent",
                Aktivitet = t.Aktivitet,
                Beskrivelse = t.Kommentar,
                Start = t.Start,
                Slutt = t.Slutt,
                Timer = t.TotalTimer,
                Fakturerbar = t.Fakturerbar,
                Status = t.Status,
                MontorId = t.MontorId
            };
        }).ToList();
    }

    private async Task Registrer()
    {
        _error = null;
        _savedMessage = null;

        if (_draft.MontorId is null)
        {
            _error = "Fant ikke innlogget bruker.";
            return;
        }

        if (_draft.ArbeidsordreId is null)
        {
            _error = "Velg arbeidsordre.";
            return;
        }

        if (_draft.Slutt <= _draft.Start)
        {
            _error = "Slutt må være etter start.";
            return;
        }

        Db.Timeregistreringer.Add(new Models.Timeregistrering
        {
            ArbeidsordreId = _draft.ArbeidsordreId.Value,
            MontorId = _draft.MontorId.Value,
            Dato = _draft.Dato,
            Start = _draft.Start.ToTimeSpan(),
            Slutt = _draft.Slutt.ToTimeSpan(),
            PauseMinutter = _draft.PauseMinutter,
            Type = _draft.Type != TimeregistreringType.Avspasering && _arbeidKoder.Count > 1 && _arbeidKoder.FirstOrDefault(k => k.Id == _draft.PrisKodeId) is { } tk ? tk.Timetype : _draft.Type,
            Aktivitet = _draft.Aktivitet,
            Fakturerbar = _draft.Fakturerbar,
            Kommentar = string.IsNullOrWhiteSpace(_draft.Kommentar) ? null : _draft.Kommentar.Trim(),
            Kilometer = _draft.Kilometer,
            PrisKodeId = _arbeidKoder.Count > 1 ? _draft.PrisKodeId : null
        });
        await Db.SaveChangesAsync();

        // Kom hit fra "Ferdig" på tidsuret på Oppgaver - den pågående økten
        // er nå omgjort til en ekte registrering, så den kan fjernes.
        if (OktIdQuery.HasValue)
        {
            var okt = await Db.AktiveTimeOkter.FirstOrDefaultAsync(o => o.Id == OktIdQuery.Value);
            if (okt is not null)
            {
                Db.AktiveTimeOkter.Remove(okt);
                await Db.SaveChangesAsync();
            }
            OktIdQuery = null;
        }

        _savedMessage = "Timer registrert.";
        _nyRadApen = false;
        _draft = new RegistreringDraft
        {
            ArbeidsordreId = _draft.ArbeidsordreId,
            MontorId = _draft.MontorId,
            Dato = _draft.Dato,
            Aktivitet = _draft.Aktivitet,
            PrisKodeId = _draft.PrisKodeId
        };

        await LoadAsync();
    }

    private async Task Slett(int id)
    {
        _apenMenyId = null;

        var reg = await Db.Timeregistreringer.FirstOrDefaultAsync(t => t.Id == id && t.MontorId == _naverendeBrukerId);
        if (reg is null || reg.Status == TimeregistreringStatus.Godkjent)
        {
            return;
        }

        Db.Timeregistreringer.Remove(reg);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string StatusCss(TimeregistreringStatus status) => status switch
    {
        TimeregistreringStatus.Godkjent => "status-godkjent",
        TimeregistreringStatus.Avslatt => "status-avslatt",
        _ => "status-venter"
    };
