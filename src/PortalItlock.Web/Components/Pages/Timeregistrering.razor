    // ---------- Kalender-fane ----------

    private string _kalenderVisning = "uke";
    private DateOnly _kalenderUke = DateOnly.FromDateTime(DateTime.Today);
    private int _kalenderOrdreFilter;
    private string _kalenderTypeFilter = "";

    private List<DateOnly> KalenderUkensDager
    {
        get
        {
            var mandag = FinnMandag(_kalenderUke);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

    private List<RegistreringRad> KalenderRaderForDag(DateOnly dag) => _uker
        .SelectMany(u => u.Rader)
        .Where(r => DateOnly.FromDateTime(r.Dato) == dag)
        .Where(r => _kalenderOrdreFilter == 0 || r.ArbeidsordreId == _kalenderOrdreFilter)
        .Where(r => string.IsNullOrEmpty(_kalenderTypeFilter) || r.Type.ToString() == _kalenderTypeFilter)
        .ToList();

    // Kalenderen viser et fast tidsrom (06-18) - punkt/høyde for hver
    // tidsblokk regnes ut fra dette, i piksler.
    private const int KalStartTime = 6;
    private const int KalPxPerTime = 50;

    private static double KalPosisjon(TimeSpan start) => Math.Max(0, (start.TotalHours - KalStartTime) * KalPxPerTime);
    private static double KalHoyde(TimeSpan start, TimeSpan slutt) => Math.Max(20, (slutt - start).TotalHours * KalPxPerTime);

    private static readonly string[] OrdreFargePalett = ["#f1e3d8", "#dbe7f7", "#d3ecdb", "#f0d9f7", "#fde7d3"];
    private static string OrdreFarge(int ordreId) => OrdreFargePalett[Math.Abs(ordreId.GetHashCode()) % OrdreFargePalett.Length];

    private List<DateOnly?> MinikalenderDager
    {
        get
        {
            var forsteIManeden = new DateOnly(_kalenderUke.Year, _kalenderUke.Month, 1);
            var offset = ((int)forsteIManeden.DayOfWeek + 6) % 7;
            var dager = new List<DateOnly?>();
            for (var i = 0; i < offset; i++)
            {
                dager.Add(null);
            }
            var antallDager = DateTime.DaysInMonth(_kalenderUke.Year, _kalenderUke.Month);
            for (var d = 1; d <= antallDager; d++)
            {
                dager.Add(new DateOnly(_kalenderUke.Year, _kalenderUke.Month, d));
            }
            return dager;
        }
    }

    private void VelgKalenderfane()
    {
        _hovedfane = "kalender";
        _kalenderUke = _valgtDag;
    }

    private async Task RegistrerFraKalender()
    {
        _draft.Dato = _kalenderUke.ToDateTime(TimeOnly.MinValue);
        await Registrer();
    }

    // ---------- Arbeidsordre-fane ----------

    private string _aoSok = "";
    private string _aoFilter = "alle";
    private int? _valgtArbeidsordreId;
    private ArbeidsordreDetaljVm? _valgtArbeidsordreDetalj;

    private List<ArbeidsordreOption> AoFiltrert => _ordre
        .Where(a => string.IsNullOrWhiteSpace(_aoSok) || a.Tittel.Contains(_aoSok, StringComparison.OrdinalIgnoreCase))
        .Where(a => _aoFilter switch
        {
            "mine" => a.AnsvarligMontorId == _naverendeBrukerId,
            "aktive" => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar or ArbeidsordreStatus.Pagaende,
            "fullforte" => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert,
            _ => true
        })
        .ToList();

    private async Task VelgArbeidsordrefane()
    {
        _hovedfane = "arbeidsordre";
        if (_valgtArbeidsordreId is null && AoFiltrert.Count > 0)
        {
            await VelgArbeidsordre(AoFiltrert[0].Id);
        }
    }

    private async Task VelgArbeidsordre(int id)
    {
        _valgtArbeidsordreId = id;

        var ordre = await Db.Arbeidsordre
            .Include(a => a.Kunde)
            .Include(a => a.Timeregistreringer).ThenInclude(t => t.Montor)
            .FirstOrDefaultAsync(a => a.Id == id);

        if (ordre is null)
        {
            _valgtArbeidsordreDetalj = null;
            return;
        }

        _valgtArbeidsordreDetalj = new ArbeidsordreDetaljVm
        {
            Id = ordre.Id,
            Tittel = ordre.Tittel,
            KundeNavn = ordre.Kunde?.Navn,
            SumTimer = ordre.Timeregistreringer.Sum(t => t.TotalTimer),
            EstimerteTimer = ordre.EstimerteTimer ?? 0,
            Rader = ordre.Timeregistreringer
                .OrderByDescending(t => t.Dato)
                .Select(t => new ArbeidsordreDetaljRad
                {
                    Id = t.Id,
                    Dato = t.Dato,
                    Type = t.Type,
                    Start = t.Start,
                    Slutt = t.Slutt,
                    PauseMinutter = t.PauseMinutter,
                    Timer = t.TotalTimer,
                    Kilometer = t.Kilometer,
                    Kommentar = t.Kommentar,
                    MontorNavn = t.Montor?.Navn ?? "-",
                    Status = t.Status
                })
                .ToList()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (ArbeidsordreId.HasValue)
        {
            _draft.ArbeidsordreId = ArbeidsordreId;
        }

        if (TimeOnly.TryParse(StartTidQuery, out var startFraOkt))
        {
            _draft.Start = startFraOkt;
        }
        if (TimeOnly.TryParse(SluttTidQuery, out var sluttFraOkt))
        {
            _draft.Slutt = sluttFraOkt;
        }
        if (PauseQuery.HasValue)
        {
            _draft.PauseMinutter = PauseQuery.Value;
        }

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                var bruker = await Db.Brukere.FindAsync(bid);
                _naverendeBrukerId = bruker?.Id;
            }
        }

        _draft.MontorId = _naverendeBrukerId;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Hentes med alle Timeregistreringer (på tvers av montører) slik at
        // Arbeidsordre-fanen kan vise reell totalsum pr. ordre - TotalTimer
        // er en [NotMapped]-beregning og må derfor summeres i minnet, ikke i
        // selve spørringen.
        var ordreRaw = await Db.Arbeidsordre
            .Include(a => a.Kunde)
            .Include(a => a.Timeregistreringer)
            .OrderBy(a => a.Tittel)
            .ToListAsync();

        _ordre = ordreRaw.Select(a => new ArbeidsordreOption
        {
            Id = a.Id,
            Tittel = a.Tittel,
            KundeNavn = a.Kunde?.Navn,
            Status = a.Status,
            AnsvarligMontorId = a.AnsvarligMontorId,
            EstimerteTimer = a.EstimerteTimer ?? 0,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer)
        }).ToList();

        var registreringer = await Db.Timeregistreringer
            .Include(t => t.Arbeidsordre)
            .Where(t => t.MontorId == _naverendeBrukerId)
            .OrderByDescending(t => t.Dato)
            .ThenByDescending(t => t.Id)
            .ToListAsync();

        var rader = registreringer.Select(t => new RegistreringRad
        {
            Id = t.Id,
            Dato = t.Dato,
            Type = t.Type,
            ArbeidsordreId = t.ArbeidsordreId,
            ArbeidsordreTittel = t.Arbeidsordre?.Tittel ?? "-",
            Start = t.Start,
            Slutt = t.Slutt,
            PauseMinutter = t.PauseMinutter,
            Timer = t.TotalTimer,
            Kommentar = t.Kommentar,
            Kilometer = t.Kilometer,
            Status = t.Status
        });

        _uker = rader
            .GroupBy(r => (Ar: ISOWeek.GetYear(r.Dato), Uke: ISOWeek.GetWeekOfYear(r.Dato)))
            .OrderByDescending(g => g.Key.Ar).ThenByDescending(g => g.Key.Uke)
            .Select(g => new UkeGruppe { Ar = g.Key.Ar, Uke = g.Key.Uke, Rader = g.ToList() })
            .ToList();
    }

    private async Task Registrer()
    {
        _error = null;
        _savedMessage = null;

        if (_draft.MontorId is null)
        {
            _error = "Fant ikke innlogget bruker.";
            return;
        }

        if (_draft.ArbeidsordreId is null)
        {
            _error = "Velg arbeidsordre.";
            return;
        }

        if (_draft.Slutt <= _draft.Start)
        {
            _error = "Slutt må være etter start.";
            return;
        }

        Db.Timeregistreringer.Add(new Models.Timeregistrering
        {
            ArbeidsordreId = _draft.ArbeidsordreId.Value,
            MontorId = _draft.MontorId.Value,
            Dato = _draft.Dato,
            Start = _draft.Start.ToTimeSpan(),
            Slutt = _draft.Slutt.ToTimeSpan(),
            PauseMinutter = _draft.PauseMinutter,
            Type = _draft.Type,
            Kommentar = string.IsNullOrWhiteSpace(_draft.Kommentar) ? null : _draft.Kommentar.Trim(),
            Kilometer = _draft.Kilometer
        });
        await Db.SaveChangesAsync();

        // Kom hit fra "Ferdig" på tidsuret på Oppgaver - den pågående økten
        // er nå omgjort til en ekte registrering, så den kan fjernes.
        if (OktIdQuery.HasValue)
        {
            var okt = await Db.AktiveTimeOkter.FirstOrDefaultAsync(o => o.Id == OktIdQuery.Value);
            if (okt is not null)
            {
                Db.AktiveTimeOkter.Remove(okt);
                await Db.SaveChangesAsync();
            }
            OktIdQuery = null;
        }

        _savedMessage = "Timer registrert.";
        var behold = new RegistreringDraft { ArbeidsordreId = _draft.ArbeidsordreId, MontorId = _draft.MontorId, Dato = _draft.Dato };
        _draft = behold;
        await LoadAsync();
    }

    private async Task Slett(int id)
    {
        var reg = await Db.Timeregistreringer.FirstOrDefaultAsync(t => t.Id == id && t.MontorId == _naverendeBrukerId);
        if (reg is null || reg.Status == TimeregistreringStatus.Godkjent)
        {
            return;
        }

        Db.Timeregistreringer.Remove(reg);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string StatusCss(TimeregistreringStatus status) => status switch
    {
        TimeregistreringStatus.Godkjent => "status-godkjent",
        TimeregistreringStatus.Avslatt => "status-avslatt",
        _ => "status-venter"
    };
