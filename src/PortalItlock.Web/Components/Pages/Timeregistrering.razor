@page "/timeregistrering"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Timeregistrering</PageTitle>

<div class="mobil-tidsreg-wrap">
    <div class="mobil-ukestripe">
        @foreach (var dag in MobilUkeDager)
        {
            <button type="button" class="mobil-ukedag @(dag == _mobilValgtDato ? "aktiv" : "")" @onclick="@(() => VelgMobilDag(dag))">
                <span class="mobil-ukedag-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
                <span class="mobil-ukedag-tall">@dag.Day.ToString("00")</span>
            </button>
        }
    </div>

    <div class="mobil-reg-form">
        <label>
            Arbeidsordre
            <select @bind="_draft.ArbeidsordreId">
                <option value="">Velg arbeidsordre...</option>
                @foreach (var a in _ordre)
                {
                    <option value="@a.Id">@a.Tittel</option>
                }
            </select>
        </label>
        <div class="mobil-reg-rad">
            <label>
                Type
                <select @bind="_draft.Type">
                    @foreach (var t in Enum.GetValues<TimeregistreringType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Start
                <input type="time" @bind="_draft.Start" />
            </label>
            <label>
                Slutt
                <input type="time" @bind="_draft.Slutt" />
            </label>
        </div>
        <button type="button" class="save-button mobil-reg-knapp" @onclick="RegistrerMobil">Registrer timer</button>
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="form-error">@_error</span>
        }
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="save-success">@_savedMessage</span>
        }
    </div>

    <div class="mobil-reg-liste">
        @if (MobilDagensRader.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert denne dagen.</p>
        }
        else
        {
            @foreach (var r in MobilDagensRader)
            {
                <div @key="@($"mobil-{r.Id}")" class="mobil-ordre-kort mobil-kant-@(r.Status == TimeregistreringStatus.Godkjent ? "gronn" : r.Status == TimeregistreringStatus.Avslatt ? "rod" : "gul")">
                    <div class="mobil-ordre-topp">
                        <span class="mobil-ordre-tittel">@r.ArbeidsordreTittel</span>
                        <span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span>
                    </div>
                    <div class="mobil-ordre-meta">@r.Type.Visningsnavn() &middot; @r.Timer.ToString("N1", Kultur) t</div>
                </div>
            }
        }
    </div>
</div>

<div class="tr-side">

    <div class="tr-topbar">
        <div class="side-header">
            <span class="side-header-ikon"><Icon Name="clock" /></span>
            <div>
                <h1>Timeregistrering</h1>
                <p class="section-hint">Registrer timer på en arbeidsordre. Timene summeres per uke og per arbeidsordre.</p>
            </div>
        </div>
        <div class="tr-topbar-knapper">
            <a class="tr-knapp" href="/rapporter"><Icon Name="trend-up" />Rapporter</a>
            <button type="button" class="tr-knapp tr-knapp-primaer" @onclick="@(() => _visHurtigForm = !_visHurtigForm)"><Icon Name="plus" />Registrer timer</button>
        </div>
    </div>

    <div class="tr-hovedtabs">
        <button type="button" class="@(_hovedfane == "timeforing" ? "aktiv" : "")" @onclick='@(() => _hovedfane = "timeforing")'><Icon Name="clock" />Timeføring</button>
        <button type="button" class="@(_hovedfane == "kalender" ? "aktiv" : "")" @onclick="VelgKalenderfane"><Icon Name="calendar" />Kalender</button>
        <button type="button" class="@(_hovedfane == "arbeidsordre" ? "aktiv" : "")" @onclick="VelgArbeidsordrefane"><Icon Name="folder" />Arbeidsordre</button>
    </div>

    @if (_visHurtigForm)
    {
        <div class="kort form-kort">
            <div class="kort-tittel-rad"><h2>Ny registrering</h2></div>
            <div class="field-grid">
                <label>
                    Dato
                    <input type="date" @bind="_draft.Dato" />
                </label>
                <label class="span-2">
                    Arbeidsordre
                    <select @bind="_draft.ArbeidsordreId">
                        <option value="">Velg arbeidsordre...</option>
                        @foreach (var a in _ordre)
                        {
                            <option value="@a.Id">@a.Tittel</option>
                        }
                    </select>
                </label>
                <label>
                    Type
                    <select @bind="_draft.Type">
                        @foreach (var t in Enum.GetValues<TimeregistreringType>())
                        {
                            <option value="@t">@t.Visningsnavn()</option>
                        }
                    </select>
                </label>
                <label>
                    Start
                    <input type="time" @bind="_draft.Start" />
                </label>
                <label>
                    Slutt
                    <input type="time" @bind="_draft.Slutt" />
                </label>
                <label>
                    Pause (min)
                    <input @bind="_draft.PauseMinutter" />
                </label>
                <label>
                    Kjørt (km)
                    <input @bind="_draft.Kilometer" placeholder="0" />
                </label>
                <label class="span-2">
                    Kommentar
                    <input @bind="_draft.Kommentar" placeholder="Valgfritt" />
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="RegistrerFraHurtigForm">Registrer timer</button>
                <button type="button" class="cancel-button" @onclick="@(() => _visHurtigForm = false)">Avbryt</button>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <span class="form-error">@_error</span>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="save-success">@_savedMessage</span>
                }
            </div>
        </div>
    }

    @if (_hovedfane == "timeforing")
    {
        <div class="tr-statrow">
            <div class="tr-statcard">
                <span class="tr-statcard-ic tr-ic-aksent"><Icon Name="clock" /></span>
                <div>
                    <div class="tr-statcard-num">@DenneUkenTimer.ToString("N1", Kultur) t</div>
                    <div class="tr-statcard-lbl">Denne uken</div>
                    <div class="tr-statcard-delta">@DeltaTekst(DenneUkenTimer, ForrigeUkenTimer)</div>
                </div>
            </div>
            <div class="tr-statcard">
                <span class="tr-statcard-ic tr-ic-blaa"><Icon Name="trend-up" /></span>
                <div>
                    <div class="tr-statcard-num">@DenneManedenTimer.ToString("N1", Kultur) t</div>
                    <div class="tr-statcard-lbl">Denne måneden</div>
                    <div class="tr-statcard-delta">@ProsentDeltaTekst(DenneManedenTimer, ForrigeManedenTimer)</div>
                </div>
            </div>
            <div class="tr-statcard">
                <span class="tr-statcard-ic tr-ic-gul"><Icon Name="calendar" /></span>
                <div>
                    <div class="tr-statcard-num">@ForventetUketimer.ToString("N1", Kultur) t</div>
                    <div class="tr-statcard-lbl">Planlagt</div>
                </div>
            </div>
            <div class="tr-statcard">
                <span class="tr-statcard-ic tr-ic-gronn"><Icon Name="check-circle" /></span>
                <div>
                    <div class="tr-statcard-num">@UkeRingProsent %</div>
                    <div class="tr-statcard-lbl">Fremdrift</div>
                </div>
            </div>
        </div>

        <div class="kort tr-dagstrip-kort">
            <div class="tr-ukenav">
                <button type="button" @onclick="@(() => _valgtUkeMandag = _valgtUkeMandag.AddDays(-7))"><Icon Name="chevron-down" /></button>
                <button type="button" @onclick="@(() => _valgtUkeMandag = _valgtUkeMandag.AddDays(7))"><Icon Name="chevron-down" /></button>
                <button type="button" class="tr-idag-knapp" @onclick="GaTilIDag">I dag</button>
            </div>
            <div class="tr-dagstrip">
                @foreach (var dag in UkensDager)
                {
                    <button type="button" class="tr-dag @(dag == _valgtDag ? "aktiv" : "")" @onclick="@(() => _valgtDag = dag)">
                        <span class="tr-dag-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
                        <span class="tr-dag-tall">@dag.Day</span>
                        <span class="tr-dag-sum">@SumForDag(dag).ToString("N1", Kultur) t</span>
                    </button>
                }
            </div>
        </div>

        <div class="kort">
            <div class="kort-tittel-rad">
                <h2>@Kultur.TextInfo.ToTitleCase(_valgtDag.ToString("dddd d. MMMM yyyy", Kultur))</h2>
                <span class="tr-dagsum-tekst">@SumForDag(_valgtDag).ToString("N1", Kultur) t</span>
            </div>

            @{ var dagensRader = RaderForDag(_valgtDag); }
            @if (dagensRader.Count == 0)
            {
                <p class="list-empty">Ingen timer registrert denne dagen.</p>
            }
            else
            {
                <table class="reg-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Arbeidsordre</th>
                            <th>Type</th>
                            <th>Start</th>
                            <th>Slutt</th>
                            <th>Pause</th>
                            <th>Timer</th>
                            <th>Km</th>
                            <th>Kommentar</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in dagensRader)
                        {
                            <tr @key="r.Id">
                                <td class="tr-td-id">#@r.ArbeidsordreId</td>
                                <td><a href="@($"/arbeidsordre/{r.ArbeidsordreId}")">@r.ArbeidsordreTittel</a></td>
                                <td>@KortType(r.Type)</td>
                                <td>@r.Start.ToString(@"hh\:mm")</td>
                                <td>@r.Slutt.ToString(@"hh\:mm")</td>
                                <td>@r.PauseMinutter</td>
                                <td class="timer-cell">@r.Timer.ToString("N1", Kultur)</td>
                                <td>@(r.Kilometer > 0 ? r.Kilometer.ToString("N0", Kultur) : "")</td>
                                <td>@r.Kommentar</td>
                                <td><span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span></td>
                                <td class="handling-cell">
                                    @if (r.Status != TimeregistreringStatus.Godkjent)
                                    {
                                        <button type="button" class="btn-liten btn-slett" @onclick="@(() => Slett(r.Id))">Slett</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_hovedfane == "kalender")
    {
        <div class="tr-kalgrid">
            <div class="kort tr-kalhoved">
                <div class="tr-kaltoolbar">
                    <div class="tr-visningtoggle">
                        <button type="button" class="@(_kalenderVisning == "uke" ? "aktiv" : "")" @onclick='@(() => _kalenderVisning = "uke")'>Uke</button>
                        <button type="button" class="@(_kalenderVisning == "maned" ? "aktiv" : "")" @onclick='@(() => _kalenderVisning = "maned")'>Måned</button>
                    </div>
                    <div class="tr-ukenav">
                        <button type="button" @onclick="@(() => _kalenderUke = _kalenderUke.AddDays(_kalenderVisning == "uke" ? -7 : -28))"><Icon Name="chevron-down" /></button>
                        <span class="tr-kalmaned">@Kultur.TextInfo.ToTitleCase(_kalenderUke.ToString("MMMM yyyy", Kultur))</span>
                        <button type="button" @onclick="@(() => _kalenderUke = _kalenderUke.AddDays(_kalenderVisning == "uke" ? 7 : 28))"><Icon Name="chevron-down" /></button>
                        <button type="button" class="tr-idag-knapp" @onclick="@(() => _kalenderUke = DateOnly.FromDateTime(DateTime.Today))">I dag</button>
                    </div>
                    <select class="tr-filter-select" @bind="_kalenderOrdreFilter">
                        <option value="0">Alle arbeidsordrer</option>
                        @foreach (var a in _ordre)
                        {
                            <option value="@a.Id">@a.Tittel</option>
                        }
                    </select>
                    <select class="tr-filter-select" @bind="_kalenderTypeFilter">
                        <option value="">Alle typer</option>
                        @foreach (var t in Enum.GetValues<TimeregistreringType>())
                        {
                            <option value="@t">@t.Visningsnavn()</option>
                        }
                    </select>
                </div>

                <div class="tr-kalukerad">
                    @foreach (var dag in KalenderUkensDager)
                    {
                        <div class="tr-kaldagheader">
                            <span>@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
                            <span class="tr-kaldagtall">@dag.Day</span>
                            <span class="tr-kaldagsum">@SumForDag(dag).ToString("N1", Kultur) t</span>
                        </div>
                    }
                </div>
                <div class="tr-kalkolonner">
                    @foreach (var dag in KalenderUkensDager)
                    {
                        <div class="tr-kalkolonne">
                            @foreach (var r in KalenderRaderForDag(dag))
                            {
                                <div class="tr-kalblokk" style="top:@(KalPosisjon(r.Start))px;height:@(KalHoyde(r.Start, r.Slutt))px;background:@OrdreFarge(r.ArbeidsordreId)">
                                    <span class="tr-kalblokk-tid">@r.Start.ToString(@"hh\:mm") - @r.Slutt.ToString(@"hh\:mm")</span>
                                    <span class="tr-kalblokk-navn">#@r.ArbeidsordreId @r.ArbeidsordreTittel</span>
                                    <span class="tr-kalblokk-timer">@r.Timer.ToString("N1", Kultur) t</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="tr-kalsidebar">
                <div class="kort tr-minikalender">
                    <div class="tr-minikal-header">
                        <span>@Kultur.TextInfo.ToTitleCase(_kalenderUke.ToString("MMMM yyyy", Kultur))</span>
                    </div>
                    <div class="tr-minikal-ukedager">
                        <span>M</span><span>T</span><span>O</span><span>T</span><span>F</span><span>L</span><span>S</span>
                    </div>
                    <div class="tr-minikal-grid">
                        @foreach (var dag in MinikalenderDager)
                        {
                            @if (dag is null)
                            {
                                <span class="tr-minikal-tom"></span>
                            }
                            else
                            {
                                <button type="button" class="tr-minikal-dag @(dag == DateOnly.FromDateTime(DateTime.Today) ? "idag" : "") @(dag == _kalenderUke ? "valgt" : "")" @onclick="@(() => _kalenderUke = dag.Value)">@dag.Value.Day</button>
                            }
                        }
                    </div>
                </div>

                <div class="kort tr-nyreg">
                    <h3>Ny registrering</h3>
                    <label>
                        Arbeidsordre
                        <select @bind="_draft.ArbeidsordreId">
                            <option value="">Velg arbeidsordre...</option>
                            @foreach (var a in _ordre)
                            {
                                <option value="@a.Id">@a.Tittel</option>
                            }
                        </select>
                    </label>
                    <label>
                        Type
                        <select @bind="_draft.Type">
                            @foreach (var t in Enum.GetValues<TimeregistreringType>())
                            {
                                <option value="@t">@t.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    <div class="tr-nyreg-rad">
                        <label>
                            Start
                            <input type="time" @bind="_draft.Start" />
                        </label>
                        <label>
                            Slutt
                            <input type="time" @bind="_draft.Slutt" />
                        </label>
                    </div>
                    <div class="tr-nyreg-rad">
                        <label>
                            Pause (min)
                            <input @bind="_draft.PauseMinutter" />
                        </label>
                        <label>
                            Kjørt (km)
                            <input @bind="_draft.Kilometer" placeholder="0" />
                        </label>
                    </div>
                    <button type="button" class="save-button tr-nyreg-knapp" @onclick="RegistrerFraKalender">Registrer timer</button>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <span class="form-error">@_error</span>
                    }
                    @if (!string.IsNullOrEmpty(_savedMessage))
                    {
                        <span class="save-success">@_savedMessage</span>
                    }
                </div>
            </div>
        </div>
    }
    else if (_hovedfane == "arbeidsordre")
    {
        <div class="tr-aogrid">
            <div class="kort tr-aoliste">
                <label class="sok-felt">
                    <Icon Name="search" />
                    <input @bind="_aoSok" @bind:event="oninput" placeholder="Søk på arbeidsordre..." />
                </label>
                <div class="tr-aofilter">
                    <button type="button" class="@(_aoFilter == "alle" ? "aktiv" : "")" @onclick='@(() => _aoFilter = "alle")'>Alle</button>
                    <button type="button" class="@(_aoFilter == "mine" ? "aktiv" : "")" @onclick='@(() => _aoFilter = "mine")'>Mine</button>
                    <button type="button" class="@(_aoFilter == "aktive" ? "aktiv" : "")" @onclick='@(() => _aoFilter = "aktive")'>Aktive</button>
                    <button type="button" class="@(_aoFilter == "fullforte" ? "aktiv" : "")" @onclick='@(() => _aoFilter = "fullforte")'>Fullførte</button>
                </div>
                <div class="tr-aorader">
                    @foreach (var a in AoFiltrert)
                    {
                        <button type="button" @key="a.Id" class="tr-aorad @(a.Id == _valgtArbeidsordreId ? "valgt" : "")" @onclick="@(() => VelgArbeidsordre(a.Id))">
                            <span class="tr-aorad-prikk" style="background:@a.Farge"></span>
                            <span class="tr-aorad-info">
                                <span class="tr-aorad-tittel">#@a.Id @a.Tittel</span>
                                <span class="tr-aorad-meta">@a.KundeNavn</span>
                            </span>
                            <span class="tr-aorad-timer">@a.SumTimer.ToString("N1", Kultur) t</span>
                        </button>
                    }
                </div>
            </div>

            <div class="tr-aodetalj">
                @if (_valgtArbeidsordreDetalj is null)
                {
                    <div class="kort"><p class="list-empty">Velg en arbeidsordre i listen til venstre.</p></div>
                }
                else
                {
                    <div class="kort tr-aoheader">
                        <div class="tr-aoheader-topp">
                            <div>
                                <span class="tr-aoheader-id">#@_valgtArbeidsordreDetalj.Id</span>
                                <h2>@_valgtArbeidsordreDetalj.Tittel</h2>
                                <span class="tr-aorad-meta">@_valgtArbeidsordreDetalj.KundeNavn</span>
                            </div>
                            <a class="tr-knapp" href="@($"/arbeidsordre/{_valgtArbeidsordreDetalj.Id}")"><Icon Name="edit" />Åpne arbeidsordre</a>
                        </div>
                    </div>

                    <div class="tr-statrow">
                        <div class="tr-statcard">
                            <span class="tr-statcard-ic tr-ic-aksent"><Icon Name="clock" /></span>
                            <div>
                                <div class="tr-statcard-num">@_valgtArbeidsordreDetalj.SumTimer.ToString("N1", Kultur) t</div>
                                <div class="tr-statcard-lbl">Totalt registrert</div>
                            </div>
                        </div>
                        <div class="tr-statcard">
                            <span class="tr-statcard-ic tr-ic-blaa"><Icon Name="calendar" /></span>
                            <div>
                                <div class="tr-statcard-num">@_valgtArbeidsordreDetalj.EstimerteTimer.ToString("N1", Kultur) t</div>
                                <div class="tr-statcard-lbl">Planlagt</div>
                            </div>
                        </div>
                        <div class="tr-statcard">
                            <span class="tr-statcard-ic tr-ic-gul"><Icon Name="tag" /></span>
                            <div>
                                <div class="tr-statcard-num">@Math.Max(0, _valgtArbeidsordreDetalj.EstimerteTimer - _valgtArbeidsordreDetalj.SumTimer).ToString("N1", Kultur) t</div>
                                <div class="tr-statcard-lbl">Gjenstår</div>
                            </div>
                        </div>
                        <div class="tr-statcard">
                            <span class="tr-statcard-ic tr-ic-gronn"><Icon Name="check-circle" /></span>
                            <div>
                                <div class="tr-statcard-num">@_valgtArbeidsordreDetalj.FremdriftProsent %</div>
                                <div class="tr-statcard-lbl">Fremdrift</div>
                            </div>
                        </div>
                    </div>

                    <div class="kort">
                        <div class="kort-tittel-rad"><h2>Registrerte timer (@_valgtArbeidsordreDetalj.Rader.Count)</h2></div>
                        @if (_valgtArbeidsordreDetalj.Rader.Count == 0)
                        {
                            <p class="list-empty">Ingen timer registrert på denne arbeidsordren ennå.</p>
                        }
                        else
                        {
                            <table class="reg-table">
                                <thead>
                                    <tr>
                                        <th>Dato</th>
                                        <th>Type</th>
                                        <th>Start</th>
                                        <th>Slutt</th>
                                        <th>Pause</th>
                                        <th>Timer</th>
                                        <th>Km</th>
                                        <th>Kommentar</th>
                                        <th>Registrert av</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in _valgtArbeidsordreDetalj.Rader)
                                    {
                                        <tr @key="r.Id">
                                            <td>@r.Dato.ToString("dd.MM.yyyy")</td>
                                            <td>@KortType(r.Type)</td>
                                            <td>@r.Start.ToString(@"hh\:mm")</td>
                                            <td>@r.Slutt.ToString(@"hh\:mm")</td>
                                            <td>@r.PauseMinutter</td>
                                            <td class="timer-cell">@r.Timer.ToString("N1", Kultur)</td>
                                            <td>@(r.Kilometer > 0 ? r.Kilometer.ToString("N0", Kultur) : "")</td>
                                            <td>@r.Kommentar</td>
                                            <td>@r.MontorNavn</td>
                                            <td><span class="status-badge @StatusCss(r.Status)">@r.Status.Visningsnavn()</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery] public int? ArbeidsordreId { get; set; }

    // Satt når man kommer hit fra "Ferdig" på tidsuret på Oppgaver (se
    // MinDag.razor) - forhåndsutfyller start/slutt/pause fra den fullførte
    // økten, og lar oss fjerne den pågående økten fra databasen når
    // registreringen faktisk lagres.
    [SupplyParameterFromQuery(Name = "starttid")] public string? StartTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sluttid")] public string? SluttTidQuery { get; set; }
    [SupplyParameterFromQuery(Name = "pause")] public int? PauseQuery { get; set; }
    [SupplyParameterFromQuery(Name = "oktid")] public int? OktIdQuery { get; set; }

    private sealed class RegistreringDraft
    {
        public int? ArbeidsordreId { get; set; }
        public int? MontorId { get; set; }
        public DateTime Dato { get; set; } = DateTime.Today;
        public TimeregistreringType Type { get; set; } = TimeregistreringType.NormalArbeidstid;
        public TimeOnly Start { get; set; } = new(7, 0);
        public TimeOnly Slutt { get; set; } = new(15, 0);
        public int PauseMinutter { get; set; } = 30;
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
    }

    private sealed class ArbeidsordreOption
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? KundeNavn { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public decimal EstimerteTimer { get; set; }
        public decimal SumTimer { get; set; }

        public string Farge => Status switch
        {
            ArbeidsordreStatus.Ny => "#0b66e6",
            ArbeidsordreStatus.Klar => "#7a2b96",
            ArbeidsordreStatus.Pagaende => "#fd7a17",
            ArbeidsordreStatus.Ferdig => "#0c9c5c",
            _ => "#9a958c"
        };
    }

    private sealed class ArbeidsordreDetaljVm
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? KundeNavn { get; set; }
        public decimal SumTimer { get; set; }
        public decimal EstimerteTimer { get; set; }
        public List<ArbeidsordreDetaljRad> Rader { get; set; } = [];

        public int FremdriftProsent => EstimerteTimer <= 0 ? 0 : (int)Math.Min(100, Math.Round(SumTimer / EstimerteTimer * 100));
    }

