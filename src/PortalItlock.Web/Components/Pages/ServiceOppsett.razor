@page "/serviceavtale-oppsett"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Oppsett for serviceavtaler</PageTitle>

@* Oppsett for serviceavtaler (Prototype serviceavtale-ny-prising-tilbud.html): bare
   standardprisene som fylles inn på nye avtaler – Priser (kategoriene) og Tillegg.
   Endringene holdes i minnet til «Lagre». Avtaler som finnes, endres ikke. *@
<a class="back-link" href="/serviceavtaler">&larr; Tilbake til serviceavtaler</a>

<div class="so">
    <div class="so-hode">
        <span class="so-ikon"><Icon Name="tag" /></span>
        <div>
            <h1>Oppsett for serviceavtaler</h1>
            <p>Standardpriser som fylles inn på nye avtaler. Avtaler som finnes fra før, endres ikke.</p>
        </div>
    </div>

    <div class="so-kort">
        <nav class="so-faner">
            <button type="button" class="@(_fane == "priser" ? "pa" : "")" @onclick="@(() => _fane = "priser")">Priser <em>@_kategorier.Count</em></button>
            <button type="button" class="@(_fane == "tillegg" ? "pa" : "")" @onclick="@(() => _fane = "tillegg")">Tillegg <em>@_tillegg.Count</em></button>
        </nav>

        <div class="so-innhold">
            @if (_fane == "priser")
            {
                <h2>Priser</h2>
                <p class="so-hint">Pris per enhet per servicerunde, eks. mva. Kategoriene kommer på fanen Prising på hver ny avtale. Endre navn og pris, eller legg til egne.</p>
                <div class="so-tw">
                    <table class="so-tab">
                        <thead><tr><th></th><th>Kategori</th><th>Beskrivelse</th><th class="n">Pris per stk.</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _kategorier.Count; i++)
                            {
                                var k = _kategorier[i];
                                var idx = i;
                                <tr @key="k">
                                    <td class="so-flytt">
                                        <button type="button" title="Flytt opp" aria-label="Flytt opp" disabled="@(idx == 0)" @onclick="@(() => Flytt(_kategorier, idx, -1))">▲</button>
                                        <button type="button" title="Flytt ned" aria-label="Flytt ned" disabled="@(idx == _kategorier.Count - 1)" @onclick="@(() => Flytt(_kategorier, idx, 1))">▼</button>
                                    </td>
                                    <td><input class="so-navn" value="@k.Navn" placeholder="Navn på kategorien" @onchange="@(e => { k.Navn = e.Value?.ToString()?.Trim() ?? ""; Endret(); })" /></td>
                                    <td><input class="so-besk" value="@k.Beskrivelse" placeholder="Kort beskrivelse" @onchange="@(e => { k.Beskrivelse = TomTilNull(e.Value); Endret(); })" /></td>
                                    <td class="n"><span class="so-pris"><input inputmode="decimal" value="@Tall(k.Pris)" @onchange="@(e => { k.Pris = LesTall(e.Value) ?? 0; Endret(); })" /><em>kr</em></span></td>
                                    <td class="n"><button type="button" class="so-x" title="Slett kategori" @onclick="@(() => { _kategorier.Remove(k); Endret(); })">×</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="so-under">
                    <button type="button" class="so-knapp" @onclick="NyKategori"><Icon Name="plus" />Ny kategori</button>
                    <span class="so-sp"></span>
                    <button type="button" class="so-lenke" @onclick="StandardKategorier">Tilbakestill til standard</button>
                </div>
            }
            else
            {
                <h2>Tillegg</h2>
                <p class="so-hint">Faste tillegg som fylles inn på fanen Tillegg på hver ny avtale, f.eks. kjøring per km. La prisen stå tom hvis den skal fylles inn per avtale.</p>
                <div class="so-tw">
                    <table class="so-tab">
                        <thead><tr><th></th><th>Beskrivelse</th><th>Hvordan</th><th class="n">Pris / sats</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _tillegg.Count; i++)
                            {
                                var t = _tillegg[i];
                                var idx = i;
                                <tr @key="t">
                                    <td class="so-flytt">
                                        <button type="button" title="Flytt opp" aria-label="Flytt opp" disabled="@(idx == 0)" @onclick="@(() => Flytt(_tillegg, idx, -1))">▲</button>
                                        <button type="button" title="Flytt ned" aria-label="Flytt ned" disabled="@(idx == _tillegg.Count - 1)" @onclick="@(() => Flytt(_tillegg, idx, 1))">▼</button>
                                    </td>
                                    <td><input class="so-navn" value="@t.Navn" placeholder="Hva gjelder linjen?" @onchange="@(e => { t.Navn = e.Value?.ToString()?.Trim() ?? ""; Endret(); })" /></td>
                                    <td>
                                        <select value="@t.Type" @onchange="@(e => { t.Type = e.Value?.ToString() ?? ServiceavtaleLinje.PerRunde; Endret(); })">
                                            @foreach (var (kode, navn) in ServiceavtaleAntall.Typer)
                                            {
                                                <option value="@kode">@navn</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="n"><span class="so-pris"><input inputmode="decimal" value="@(t.Pris is { } p ? Tall(p) : "")" placeholder="Per avtale" @onchange="@(e => { t.Pris = LesTall(e.Value); Endret(); })" /><em>@(t.Type == ServiceavtaleLinje.Prosent ? "%" : "kr")</em></span></td>
                                    <td class="n"><button type="button" class="so-x" title="Fjern linjen" @onclick="@(() => { _tillegg.Remove(t); Endret(); })">×</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="so-under">
                    <button type="button" class="so-knapp" @onclick="NyttTillegg"><Icon Name="plus" />Ny linje</button>
                </div>
            }
        </div>

        @if (_endret || !string.IsNullOrEmpty(_melding) || _feil is not null)
        {
            <div class="so-lagre @(_endret ? "" : "ok")">
                @if (_feil is not null)
                {
                    <span class="so-feil">@_feil</span>
                }
                else if (_endret)
                {
                    <span>Du har endringer som ikke er lagret</span>
                }
                else
                {
                    <span class="so-ok"><Icon Name="check" />@_melding</span>
                }
                <span class="so-sp"></span>
                @if (_endret)
                {
                    <button type="button" class="so-knapp" @onclick="Last">Angre</button>
                    <button type="button" class="so-knapp so-p" @onclick="Lagre">Lagre</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private sealed class KatRad
    {
        public int? Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Beskrivelse { get; set; }
        public decimal Pris { get; set; }
    }

    private sealed class TillRad
    {
        public int? Id { get; set; }
        public string Navn { get; set; } = "";
        public string Type { get; set; } = ServiceavtaleLinje.PerRunde;
        public decimal? Pris { get; set; }
    }

    private string _fane = "priser";
    private List<KatRad> _kategorier = [];
    private List<TillRad> _tillegg = [];
    private bool _endret;
    private string? _melding;
    private string? _feil;

    protected override async Task OnInitializedAsync()
    {
        await ServiceavtaleAntall.SikreStandard(Db);
        await Last();
    }

    private async Task Last()
    {
        _kategorier = await Db.ServicePrisKategorier.AsNoTracking().OrderBy(k => k.Rekkefolge).ThenBy(k => k.Id)
            .Select(k => new KatRad { Id = k.Id, Navn = k.Navn, Beskrivelse = k.Beskrivelse, Pris = k.Pris }).ToListAsync();
        _tillegg = await Db.ServiceTilleggMaler.AsNoTracking().OrderBy(k => k.Rekkefolge).ThenBy(k => k.Id)
            .Select(k => new TillRad { Id = k.Id, Navn = k.Navn, Type = k.Type, Pris = k.Pris }).ToListAsync();
        _endret = false;
        _feil = null;
    }

    private void Endret()
    {
        _endret = true;
        _melding = null;
        _feil = null;
    }

    private static void Flytt<T>(List<T> liste, int i, int retning)
    {
        var j = i + retning;
        if (j < 0 || j >= liste.Count)
        {
            return;
        }
        (liste[i], liste[j]) = (liste[j], liste[i]);
    }

    private void NyKategori()
    {
        _kategorier.Add(new KatRad());
        Endret();
    }

    private void NyttTillegg()
    {
        _tillegg.Add(new TillRad());
        Endret();
    }

    private void StandardKategorier()
    {
        _kategorier = ServiceavtaleAntall.StandardKategorier
            .Select(k => new KatRad { Id = _kategorier.FirstOrDefault(x => x.Navn == k.Navn)?.Id, Navn = k.Navn, Beskrivelse = k.Beskrivelse, Pris = k.Pris })
            .ToList();
        Endret();
    }

    private async Task Lagre()
    {
        if (_kategorier.Any(k => string.IsNullOrWhiteSpace(k.Navn)) || _tillegg.Any(t => string.IsNullOrWhiteSpace(t.Navn)))
        {
            _feil = "Alle linjene må ha et navn.";
            return;
        }

        var gamleKat = await Db.ServicePrisKategorier.ToListAsync();
        Db.ServicePrisKategorier.RemoveRange(gamleKat.Where(g => _kategorier.All(k => k.Id != g.Id)));
        for (var i = 0; i < _kategorier.Count; i++)
        {
            var k = _kategorier[i];
            var rad = gamleKat.FirstOrDefault(g => g.Id == k.Id);
            if (rad is null)
            {
                rad = new ServicePrisKategori { Navn = k.Navn };
                Db.ServicePrisKategorier.Add(rad);
            }
            rad.Navn = k.Navn.Trim();
            rad.Beskrivelse = k.Beskrivelse;
            rad.Pris = k.Pris;
            rad.Rekkefolge = i;
        }

        var gamleTill = await Db.ServiceTilleggMaler.ToListAsync();
        Db.ServiceTilleggMaler.RemoveRange(gamleTill.Where(g => _tillegg.All(t => t.Id != g.Id)));
        for (var i = 0; i < _tillegg.Count; i++)
        {
            var t = _tillegg[i];
            var rad = gamleTill.FirstOrDefault(g => g.Id == t.Id);
            if (rad is null)
            {
                rad = new ServiceTilleggMal { Navn = t.Navn };
                Db.ServiceTilleggMaler.Add(rad);
            }
            rad.Navn = t.Navn.Trim();
            rad.Type = t.Type;
            rad.Pris = t.Pris;
            rad.Rekkefolge = i;
        }

        await Db.SaveChangesAsync();
        await Last();
        _melding = "Lagret. Nye avtaler får disse prisene.";
    }

    private static string Tall(decimal v) => v.ToString("0.##", Kultur);

    private static decimal? LesTall(object? v)
    {
        var t = v?.ToString()?.Replace(" ", "").Replace(" ", "").Replace("kr", "").Replace("%", "").Replace(',', '.');
        return decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d >= 0 ? d : null;
    }

    private static string? TomTilNull(object? v) => string.IsNullOrWhiteSpace(v?.ToString()) ? null : v.ToString()!.Trim();
}
