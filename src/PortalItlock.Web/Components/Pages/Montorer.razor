@page "/montorer"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Montører</PageTitle>

<h1>Montører</h1>
<p>Vedlikehold listen over montører som kan settes som ansvarlig på arbeidsordre og velges ved timeregistrering.</p>

@if (_montorer.Count == 0)
{
    <p class="list-empty">Ingen montører opprettet ennå.</p>
}
else
{
    <ul class="funksjon-list">
        @foreach (var m in _montorer)
        {
            <li @key="m.Id" class="funksjon-row">
                <input @bind="m.Navn" @bind:event="oninput" />
                <span class="funksjon-count">@m.AntallTimeregistreringer registrering@(m.AntallTimeregistreringer == 1 ? "" : "er")</span>
                <button type="button" class="save-button" @onclick="@(() => LagreNavn(m))">Lagre</button>
                <button type="button" class="remove-button" @onclick="@(() => SlettMontor(m))">Slett</button>
            </li>
        }
    </ul>
}

<div class="new-funksjon">
    <h2>Ny montør</h2>
    <div class="new-funksjon-form">
        <input @bind="_nyNavn" @bind:event="oninput" placeholder="F.eks. Øyvind Havsø" />
        <button type="button" class="add-button" @onclick="OpprettMontor">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }
</div>

@code {
    private sealed class MontorRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public int AntallTimeregistreringer { get; set; }
    }

    private List<MontorRad> _montorer = [];
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _montorer = await Db.Montorer
            .OrderBy(m => m.Navn)
            .Select(m => new MontorRad { Id = m.Id, Navn = m.Navn, AntallTimeregistreringer = m.Timeregistreringer.Count })
            .ToListAsync();
    }

    private async Task OpprettMontor()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.Montorer.Add(new Montor { Navn = navn });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _feil = null;
        _melding = $"Montøren \"{navn}\" er opprettet.";
        await LoadAsync();
    }

    private async Task LagreNavn(MontorRad rad)
    {
        var navn = rad.Navn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var montor = await Db.Montorer.FirstOrDefaultAsync(m => m.Id == rad.Id);
        if (montor is null)
        {
            return;
        }

        montor.Navn = navn;
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
    }

    private async Task SlettMontor(MontorRad rad)
    {
        var montor = await Db.Montorer.FirstOrDefaultAsync(m => m.Id == rad.Id);
        if (montor is null)
        {
            return;
        }

        Db.Montorer.Remove(montor);

        try
        {
            await Db.SaveChangesAsync();
            _melding = $"\"{rad.Navn}\" er slettet.";
            _feil = null;
            await LoadAsync();
        }
        catch (DbUpdateException)
        {
            Db.Entry(montor).State = EntityState.Unchanged;
            _feil = $"\"{rad.Navn}\" har registrerte timer og kan ikke slettes.";
        }
    }
}
