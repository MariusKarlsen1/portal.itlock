@page "/plattform/prisliste"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject AbonnementService AbonnementSvc

<PageTitle>Prisliste - Plattform</PageTitle>

@* Prislisten gjelder alle organisasjoner: etablering én gang, deretter per
   lisens per måned, og tilleggsmoduler. Pakkene kan ha egne lisenspriser.
   Endringer samles og lagres med lagre-linjen, som viser hvor mange kunder
   endringen gjelder. En avtalepris på organisasjonen går foran. *@
<div class="ppl-root">
    <div class="ppl-topp">
        <div>
            <div class="ppl-eyebrow">Adminportal</div>
            <h1 class="ppl-h1">Prisliste og moduler</h1>
            <p class="ppl-hint">Alle priser eks. mva. En avtalepris på organisasjonen går foran.</p>
        </div>
        <div class="ppl-faner" role="tablist" aria-label="Prisliste">
            <button type="button" role="tab" aria-selected="@(_fane == "priser" ? "true" : "false")" @onclick="@(() => _fane = "priser")">Priser</button>
            <button type="button" role="tab" aria-selected="@(_fane == "pdf" ? "true" : "false")" @onclick="VisPdf">PDF</button>
        </div>
    </div>

    @if (_fane == "priser")
    {
        @Gruppe("Etablering", "Faktureres én gang, på første faktura", _produkter.Where(p => p.Type == PrisType.Engang))
        @Gruppe("Lisenser", "Per lisens per måned", _produkter.Where(p => p.Type == PrisType.Lisens))
        @Gruppe("Tilleggsmoduler", "Per organisasjon per måned", _produkter.Where(p => p.Type == PrisType.Modul))
    }

    @if (_fane == "pdf")
    {
        <div class="ppl-knapper">
            <a class="ppl-knapp" href="/plattform/prisliste.pdf" target="_blank">Last ned prisliste (PDF)</a>
            <a class="ppl-knapp" href="/plattform/vilkar.pdf" target="_blank">Last ned vilkår (PDF)</a>
        </div>
        @if (HarEndringer)
        {
            <p class="ppl-hint">PDF-en viser det som er lagret. Lagre endringene for å se dem her.</p>
        }
        <iframe class="ppl-pdf" src="@_pdfUrl" title="Prisliste"></iframe>
    }

    @if (HarEndringer || _lagretNettopp)
    {
        <div class="ppl-lagrelinje" role="status">
            @if (HarEndringer)
            {
                <span>@EndringTekst</span>
                <button type="button" class="ppl-angre" @onclick="AngreAsync">Angre</button>
                <button type="button" class="ppl-lagre" @onclick="LagreAsync">Lagre</button>
            }
            else
            {
                <span>Lagret ✓ Gjelder fra neste faktura.</span>
            }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private List<PrisProdukt> _produkter = [];
    private List<TenantLisens> _lisenser = [];
    private List<TenantModul> _moduler = [];
    private List<PrisPakke> _pakker = [];
    private List<PakkePris> _pakkePriser = [];
    private Dictionary<string, decimal> _lagredePriser = [];
    private string _lagret = "";
    private string _fane = "priser";
    private string? _redigerInnhold;
    private string _pdfUrl = "";
    private bool _lagretNettopp;
    private int _exAdmin = 1;
    private int _exPl = 1;
    private int _exMontor = 5;

    protected override async Task OnInitializedAsync() => await LastAsync();

    private async Task LastAsync()
    {
        _produkter = (await AbonnementSvc.PrislisteAsync()).Where(p => p.Type is PrisType.Engang or PrisType.Lisens or PrisType.Modul).ToList();
        _lisenser = await PlatformDb.TenantLisenser.AsNoTracking().ToListAsync();
        _moduler = await PlatformDb.TenantModuler.AsNoTracking().Where(m => m.Aktiv).ToListAsync();
        _pakker = await PlatformDb.PrisPakker.OrderBy(p => p.Rekkefolge).ToListAsync();
        _pakkePriser = await PlatformDb.PakkePriser.ToListAsync();
        _lagredePriser = _produkter.ToDictionary(p => p.Nokkel, p => p.Kr);
        _lagret = Bilde();
    }

    // Alt som kan endres her, for å se om noe er endret siden sist lagret.
    private string Bilde() => System.Text.Json.JsonSerializer.Serialize(new
    {
        P = _produkter.Select(p => new { p.Nokkel, p.Kr, p.Beskrivelse }),
        K = _pakker.Select(p => new { p.Nokkel, p.Navn, p.Beskrivelse, p.Innhold }),
        Pp = _pakkePriser.OrderBy(x => x.PakkeNokkel).ThenBy(x => x.ProduktNokkel).Select(x => new { x.PakkeNokkel, x.ProduktNokkel, x.Kr })
    });

    private bool HarEndringer => Bilde() != _lagret;

    private RenderFragment Gruppe(string tittel, string hint, IEnumerable<PrisProdukt> produkter) => __builder =>
    {
        var liste = produkter.ToList();
        if (liste.Count == 0)
        {
            return;
        }

        <section class="ppl-card">
            <div class="ppl-kort-topp"><h2 class="ppl-h2">@tittel</h2><span class="ppl-hint">@hint</span></div>
            <div class="ppl-rader">
                @foreach (var p in liste)
                {
                    var produkt = p;
                    var endret = _lagredePriser.TryGetValue(produkt.Nokkel, out var gammel) && gammel != produkt.Kr;
                    <div class="ppl-rad @(endret ? "endret" : "")">
                        <span class="ppl-ik">@Kortnavn(produkt.Navn)</span>
                        <span class="ppl-rad-tekst">
                            <b>@produkt.Navn</b>
                            <input @bind="produkt.Beskrivelse" @bind:event="oninput" placeholder="Beskrivelse" aria-label="@($"Beskrivelse for {produkt.Navn}")" />
                        </span>
                        <label class="ppl-pris">
                            <input type="number" min="0" step="1" @bind="produkt.Kr" @bind:event="oninput" aria-label="@($"Pris for {produkt.Navn}")" />
                            <span>kr @Enhet(produkt)</span>
                        </label>
                        <span class="ppl-bruk"><b>@IBrukHos(produkt)</b>@(produkt.Type == PrisType.Engang ? "organisasjoner" : "kunder")</span>
                    </div>
                }
            </div>
        </section>
    };

    private static string Kortnavn(string navn)
    {
        var ord = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return ord.Length switch
        {
            0 => "?",
            1 => ord[0][..Math.Min(2, ord[0].Length)].ToUpperInvariant(),
            _ => $"{char.ToUpperInvariant(ord[0][0])}{char.ToUpperInvariant(ord[1][0])}"
        };
    }

    private static string Enhet(PrisProdukt p) => (p.PakkeStorrelse ?? 1) > 1 ? $"per {p.PakkeStorrelse} per mnd" : p.Type.Enhet();

    private static string Kr(decimal v) => v.ToString("#,##0", Nb) + " kr";

    private int IBrukHos(PrisProdukt p) => p.Type switch
    {
        PrisType.Lisens => _lisenser.Where(l => PrisProdukt.ForLisens(l.Type) == p.Nokkel && l.AntallTildelt > 0).Select(l => l.TenantId).Distinct().Count(),
        PrisType.Modul => _moduler.Count(m => PrisProdukt.ForModul(m.Modul) == p.Nokkel),
        _ => _lisenser.Select(l => l.TenantId).Distinct().Count()
    };

    private decimal? PakkePris(string pakke, string produkt) =>
        _pakkePriser.FirstOrDefault(x => x.PakkeNokkel == pakke && x.ProduktNokkel == produkt)?.Kr;

    private decimal PrisI(string pakke, LisensType type)
    {
        var nokkel = PrisProdukt.ForLisens(type);
        return PakkePris(pakke, nokkel) ?? _produkter.FirstOrDefault(p => p.Nokkel == nokkel)?.Kr ?? 0;
    }

    private decimal Typisk(string pakke) =>
        Math.Max(0, _exAdmin) * PrisI(pakke, LisensType.Admin)
        + Math.Max(0, _exPl) * PrisI(pakke, LisensType.Prosjektleder)
        + Math.Max(0, _exMontor) * PrisI(pakke, LisensType.Montor);

    private string EndringTekst
    {
        get
        {
            var endret = _produkter.Where(p => _lagredePriser.TryGetValue(p.Nokkel, out var g) && g != p.Kr).ToList();
            if (endret.Count == 0)
            {
                return "Du har endringer som ikke er lagret.";
            }

            var kunder = endret.Max(IBrukHos);
            var tekst = string.Join(", ", endret.Select(p => $"{p.Navn} {Kr(_lagredePriser[p.Nokkel])} → {Kr(p.Kr)}"));
            return $"{tekst}. Gjelder {kunder} {(kunder == 1 ? "kunde" : "kunder")} fra neste faktura, unntatt de med avtalepris.";
        }
    }

    private void SettPakkePris(string pakke, string produkt, string? verdi)
    {
        var rad = _pakkePriser.FirstOrDefault(x => x.PakkeNokkel == pakke && x.ProduktNokkel == produkt);
        if (decimal.TryParse(verdi?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var kr))
        {
            if (rad is null)
            {
                rad = new PakkePris { PakkeNokkel = pakke, ProduktNokkel = produkt };
                PlatformDb.PakkePriser.Add(rad);
                _pakkePriser.Add(rad);
            }

            rad.Kr = Math.Max(0, kr);
        }
        else if (rad is not null)
        {
            PlatformDb.PakkePriser.Remove(rad);
            _pakkePriser.Remove(rad);
        }
    }

    private void VisPdf()
    {
        _fane = "pdf";
        _pdfUrl = $"/plattform/prisliste.pdf?vis=true&t={DateTime.Now.Ticks}";
    }

    private async Task LagreAsync()
    {
        foreach (var p in _produkter)
        {
            p.Kr = Math.Max(0, p.Kr);
        }

        await PlatformDb.SaveChangesAsync();
        foreach (var p in _produkter.Where(p => _lagredePriser.TryGetValue(p.Nokkel, out var g) && g != p.Kr))
        {
            await AbonnementSvc.LagrePrisAsync(p);
        }

        _lagredePriser = _produkter.ToDictionary(p => p.Nokkel, p => p.Kr);
        _lagret = Bilde();
        if (_fane == "pdf")
        {
            VisPdf();
        }

        _lagretNettopp = true;
        StateHasChanged();
        await Task.Delay(1800);
        _lagretNettopp = false;
    }

    private async Task AngreAsync()
    {
        PlatformDb.ChangeTracker.Clear();
        await LastAsync();
    }
}
