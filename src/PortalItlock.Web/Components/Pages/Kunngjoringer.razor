@page "/kunngjoringer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kunngjøringer - itlock</PageTitle>

<div class="side-header">
    <div class="side-header-ikon"><Icon Name="mail" /></div>
    <div>
        <h1>Kunngjøringer</h1>
        <p class="section-hint">Informasjon og oppdateringer for hele teamet.</p>
    </div>
    @if (ErAdminEllerPl)
    {
        <button type="button" class="knapp-primaer kunngjoring-ny-knapp" @onclick="@(() => _visNyForm = !_visNyForm)">
            <Icon Name="plus" /> Ny kunngjøring
        </button>
    }
</div>

@if (_visNyForm)
{
    <div class="kunngjoring-form">
        <label>
            Tittel
            <input @bind="_nyTittel" placeholder="F.eks. Sommerfest 2026" />
        </label>
        <label>
            Innhold
            <textarea rows="3" @bind="_nyInnhold" placeholder="Skriv kunngjøringen her..."></textarea>
        </label>
        <div class="kunngjoring-form-rad">
            <label>
                Kategori
                <select @bind="_nyKategori">
                    @foreach (var k in Enum.GetValues<KunngjoringKategori>())
                    {
                        <option value="@k">@k.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label class="kunngjoring-festet-felt">
                <input type="checkbox" @bind="_nyFestet" />
                Fest øverst
            </label>
        </div>
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
        <div class="form-actions">
            <button type="button" class="knapp-primaer" @onclick="Opprett">Publiser</button>
            <button type="button" class="cancel-button" @onclick="@(() => _visNyForm = false)">Avbryt</button>
        </div>
    </div>
}

@if (_kunngjoringer.Count == 0)
{
    <p class="list-empty">Ingen kunngjøringer ennå.</p>
}
else
{
    <div class="kunngjoring-liste">
        @foreach (var k in _kunngjoringer)
        {
            <div class="kunngjoring-post" @key="k.Id">
                <div class="kunngjoring-post-header">
                    <StatusPill Tekst="@k.Kategori.Visningsnavn()" Ikon="@k.Kategori.PillIkon()" Farge="@k.Kategori.PillFarge()" />
                    @if (k.Festet)
                    {
                        <span class="kunngjoring-festet"><Icon Name="heart" /> Festet</span>
                    }
                    <span class="kunngjoring-dato">@k.OpprettetDato.ToString("d. MMMM yyyy", _kultur)</span>
                    @if (ErAdminEllerPl)
                    {
                        <button type="button" class="remove-button" @onclick="@(() => Slett(k))">Slett</button>
                    }
                </div>
                <h2>@k.Tittel</h2>
                <p class="kunngjoring-tekst">@k.Innhold</p>
                <p class="kunngjoring-forfatter">@(k.OpprettetAvBruker?.Navn ?? "Ukjent")</p>
            </div>
        }
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private List<Kunngjoring> _kunngjoringer = [];
    private bool _visNyForm;
    private string _nyTittel = "";
    private string _nyInnhold = "";
    private KunngjoringKategori _nyKategori = KunngjoringKategori.Info;
    private bool _nyFestet;
    private string? _feil;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private bool ErAdminEllerPl;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            ErAdminEllerPl = rolleClaim is "Admin" or "Prosjektleder";

            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        await LastAsync();
        await MarkerSomLestAsync();
    }

    private async Task LastAsync()
    {
        _kunngjoringer = await Db.Kunngjoringer
            .Include(k => k.OpprettetAvBruker)
            .OrderByDescending(k => k.Festet)
            .ThenByDescending(k => k.OpprettetDato)
            .ToListAsync();
    }

    private async Task MarkerSomLestAsync()
    {
        if (_naverendeBrukerId is null || _kunngjoringer.Count == 0)
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
        if (bruker is null)
        {
            return;
        }

        var nyesteId = _kunngjoringer.Max(k => k.Id);
        if ((bruker.SisteKunngjoringSettId ?? 0) < nyesteId)
        {
            bruker.SisteKunngjoringSettId = nyesteId;
            await Db.SaveChangesAsync();
        }
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyTittel) || string.IsNullOrWhiteSpace(_nyInnhold))
        {
            _feil = "Tittel og innhold må fylles ut.";
            return;
        }

        Db.Kunngjoringer.Add(new Kunngjoring
        {
            Tittel = _nyTittel.Trim(),
            Innhold = _nyInnhold.Trim(),
            Kategori = _nyKategori,
            Festet = _nyFestet,
            OpprettetAvBrukerId = _naverendeBrukerId
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _nyTittel = "";
        _nyInnhold = "";
        _nyKategori = KunngjoringKategori.Info;
        _nyFestet = false;
        _visNyForm = false;
        await LastAsync();
        await MarkerSomLestAsync();
    }

    private async Task Slett(Kunngjoring k)
    {
        Db.Kunngjoringer.Remove(k);
        await Db.SaveChangesAsync();
        _kunngjoringer.Remove(k);
    }
}
