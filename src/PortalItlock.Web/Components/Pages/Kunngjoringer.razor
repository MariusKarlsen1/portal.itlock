    private async Task Bekreft(Kunngjoring k)
    {
        if (_naverendeBrukerId is not { } bid || HarBekreftet(k))
        {
            return;
        }

        var b = new KunngjoringBekreftelse { KunngjoringId = k.Id, BrukerId = bid, Bruker = _naverendeBruker };
        Db.KunngjoringBekreftelser.Add(b);
        if (!k.Bekreftelser.Contains(b)) { k.Bekreftelser.Add(b); }
        await Db.SaveChangesAsync();
    }

    // Stem, eller bytt stemme. Samme valg igjen trekker stemmen.
    private async Task Stem(Kunngjoring k, AvstemningValg valg)
    {
        if (_naverendeBrukerId is not { } bid)
        {
            return;
        }

        var eksisterende = k.Valg.SelectMany(v => v.Stemmer).FirstOrDefault(s => s.BrukerId == bid);
        if (eksisterende is not null)
        {
            Db.AvstemningStemmer.Remove(eksisterende);
            k.Valg.First(v => v.Id == eksisterende.ValgId).Stemmer.Remove(eksisterende);
            if (eksisterende.ValgId == valg.Id)
            {
                await Db.SaveChangesAsync();
                return;
            }
            await Db.SaveChangesAsync();
        }

        var ny = new AvstemningStemme { ValgId = valg.Id, KunngjoringId = k.Id, BrukerId = bid };
        Db.AvstemningStemmer.Add(ny);
        if (!valg.Stemmer.Contains(ny)) { valg.Stemmer.Add(ny); }
        await Db.SaveChangesAsync();
    }

    private async Task VelgBesteSvar(Kunngjoring k, KunngjoringKommentar kom)
    {
        k.BesteSvarKommentarId = k.BesteSvarKommentarId == kom.Id ? null : kom.Id;
        await Db.SaveChangesAsync();
    }

    private async Task LeggTilKommentar(Kunngjoring k)
    {
        var tekst = _kommentarUtkast.GetValueOrDefault(k.Id, "").Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        var kommentar = new KunngjoringKommentar { KunngjoringId = k.Id, Tekst = tekst, BrukerId = _naverendeBrukerId };
        Db.KunngjoringKommentarer.Add(kommentar);
        await Db.SaveChangesAsync();
        kommentar.Bruker = _naverendeBruker;
        // EF legger den nye kommentaren inn i k.Kommentarer selv (fix-up) - ikke legg til to ganger.
        if (!k.Kommentarer.Contains(kommentar)) { k.Kommentarer.Add(kommentar); }
        _kommentarUtkast[k.Id] = "";
        _visteKommentarer.Add(k.Id);
    }

    private int? _bekreftSlettId;

    private async Task Slett(Kunngjoring k)
    {
        if (_bekreftSlettId != k.Id)
        {
            _bekreftSlettId = k.Id;
            return;
        }

        Db.Kunngjoringer.Remove(k);
        await Db.SaveChangesAsync();
        _innlegg.Remove(k);
        _alleInnleggIder.RemoveAll(x => x.Id == k.Id);
        _bekreftSlettId = null;
    }

    private async Task VekslFestet(Kunngjoring k)
    {
        k.Festet = !k.Festet;
        await Db.SaveChangesAsync();
    }

    // ---------- utvalg ----------

    private List<Kunngjoring> FilterteInnlegg
    {
        get
        {
            IEnumerable<Kunngjoring> liste = _innlegg;
            var filter = _visning == Visning.Fellesskap ? _fane : _filter;
            liste = filter switch
            {
                "kunngjoringer" => liste.Where(k => k.Type == InnleggType.Kunngjoring),
                "sporsmal" => liste.Where(k => k.Type == InnleggType.Sporsmal),
                "ros" => liste.Where(k => k.Type == InnleggType.Ros),
                "arrangement" => liste.Where(k => k.Type == InnleggType.Arrangement || k.EventDato is not null),
                "avstemning" => liste.Where(k => k.Type == InnleggType.Avstemning),
                "ulest" => liste.Where(k => _ulesteVedApning.Contains(k.Id)),
                "viktig" => liste.Where(k => k.KreverBekreftelse),
                _ => liste
            };
            if (_sortering == "aktivitet")
            {
                liste = liste.OrderByDescending(k => k.Festet).ThenByDescending(SisteAktivitet);
            }
            return liste.ToList();
        }
    }

    private static DateTime SisteAktivitet(Kunngjoring k) =>
        new[] { k.OpprettetDato, k.Kommentarer.Count > 0 ? k.Kommentarer.Max(c => c.OpprettetDato) : DateTime.MinValue }.Max();

    private List<Kunngjoring> VenterPaBekreftelse => _innlegg
        .Where(k => k.KreverBekreftelse && !HarBekreftet(k) && k.OpprettetAvBrukerId != _naverendeBrukerId)
        .ToList();

    private List<(Bruker Bruker, int Antall, string Merke)> RosDenneManeden => _innlegg
        .Where(k => k.Type == InnleggType.Ros && k.RosTilBruker is not null && k.OpprettetDato >= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))
        .GroupBy(k => k.RosTilBrukerId)
        .Select(g => (g.First().RosTilBruker!, g.Count(), RosMerke.Hent(g.GroupBy(x => x.RosMerke).OrderByDescending(x => x.Count()).First().Key).Navn))
        .OrderByDescending(x => x.Item2)
        .Take(4)
        .ToList();

    private int MottakereAv(Kunngjoring k)
    {
        var f = _fellesskap.FirstOrDefault(x => x.Id == k.FellesskapId);
        var antall = f is null ? _interneBrukere.Count : AntallMedlemmer(f);
        return Math.Max(1, antall - (k.OpprettetAvBrukerId is null ? 0 : 1));
    }

    private List<Bruker> ManglerBekreftelse(Kunngjoring k)
    {
        var f = _fellesskap.FirstOrDefault(x => x.Id == k.FellesskapId);
        var medlemmer = f is null ? _interneBrukere : MedlemmerAv(f);
        return medlemmer.Where(b => b.Id != k.OpprettetAvBrukerId && !k.Bekreftelser.Any(x => x.BrukerId == b.Id)).ToList();
    }

    // ---------- hjelpere ----------

    private string Hilsen => DateTime.Now.Hour switch
    {
        var t when 10 > t => "God morgen",
        var t when 17 > t => "Hei",
        _ => "God kveld"
    };

    private static readonly string[] _avatarPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];
    private static string AvatarFarge(string navn) => _avatarPaletten[Math.Abs(StabilHash(navn)) % _avatarPaletten.Length];

    // string.GetHashCode varierer mellom prosesser - denne gir samme farge hver gang.
    private static int StabilHash(string s)
    {
        unchecked
        {
            var h = 17;
            foreach (var c in s) { h = h * 31 + c; }
            return h == int.MinValue ? 0 : h;
        }
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => string.Concat(deler[0][0], deler[^1][0]).ToUpperInvariant()
        };
    }

    private static string Forkortelse(string navn)
    {
        var deler = navn.Split([' ', '-'], StringSplitOptions.RemoveEmptyEntries).Where(d => d.Length > 0 && char.IsLetterOrDigit(d[0])).ToList();
        return deler.Count switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => string.Concat(deler[0][0], deler[^1][0]).ToUpperInvariant()
        };
    }

    private static string Fornavn(string navn) => navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;
    private static string Kort(string tekst, int maks) => maks >= tekst.Length ? tekst : tekst[..(maks - 1)].TrimEnd() + "…";

    private static string Naar(DateTime t)
    {
        if (t.Date == DateTime.Today) { return $"i dag {t:HH:mm}"; }
        if (t.Date == DateTime.Today.AddDays(-1)) { return $"i går {t:HH:mm}"; }
        if (t.Date > DateTime.Today.AddDays(-7)) { return t.ToString("dddd HH:mm", _kultur); }
        return t.Year == DateTime.Today.Year ? t.ToString("d. MMM", _kultur) : t.ToString("d. MMM yyyy", _kultur);
    }

    private static string DeltarTekst(Kunngjoring k)
    {
        var kommer = k.Pameldinger.Count(p => p.Svar == PameldingSvar.Kommer);
        var kanskje = k.Pameldinger.Count(p => p.Svar == PameldingSvar.Kanskje);
        return kommer + kanskje == 0 ? "Ingen har svart ennå" : $"{kommer} kommer · {kanskje} kanskje";
    }

    // Korte innlegg (diskusjon/kunngjøring) med fargebakgrunn vises som stor tekst.
    private static bool VisSomFargepost(Kunngjoring k) => InnleggBakgrunn.ErGyldig(k.Bakgrunn) && k.BildeData is null && 220 >= k.Innhold.Length;

