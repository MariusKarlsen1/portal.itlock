    private RenderFragment Innlegg(Kunngjoring k) => __builder =>
    {
        var ny = _ulesteVedApning.Contains(k.Id);
        var forfatter = k.OpprettetAvBruker?.Navn ?? "Ukjent";
        // VK4: viktige kunngjøringer merkes som sett når de har vært på skjermen i 2 sekunder (js/viktigsett.js).
        var viktigIkkeSett = k.KreverBekreftelse && k.OpprettetAvBrukerId != _naverendeBrukerId && !HarBekreftet(k);
        <article class="kg-post @(k.Type == InnleggType.Kunngjoring ? "kunngj" : "") @(ny ? "ny" : "") @(viktigIkkeSett ? "kg-viktig-ny" : "")" @key="k.Id" id="innlegg-@(k.Id)" data-viktig="@(viktigIkkeSett ? k.Id : null)">
            <div class="kg-ph">
                @Avatar(forfatter, "kg-av-l")
                <div>
                    <b>@forfatter</b>
                    <small>@(k.OpprettetAvBruker?.Stilling ?? k.OpprettetAvBruker?.Rolle.Visningsnavn()) · @Naar(k.OpprettetDato)</small>
                </div>
                <div class="kg-ph-hoyre">
                    @if (ny) {<span class="kg-nytt">Ny</span>}
                    @if (k.KreverBekreftelse)
                    {
                        <span class="kg-tag kg-t-viktig">⭐ Viktig</span><span class="kg-sett-prikk @(viktigIkkeSett ? "" : "sett")" title="@(viktigIkkeSett ? "Ikke sett ennå" : "Sett")"></span>
                    }
                    @if (k.Festet) {<span class="kg-tag kg-t-fest"><Icon Name="star" />Festet</span>}
                    @if (k.Type == InnleggType.Sporsmal && k.BesteSvarKommentarId is not null) {<span class="kg-tag kg-t-lost"><Icon Name="check" />Løst</span>}
                    @if (KanKunngjore(k.Fellesskap))
                    {
                        <button type="button" class="kg-mer" title="@(k.Festet ? "Løsne" : "Fest øverst")" @onclick="@(() => VekslFestet(k))"><Icon Name="@(k.Festet ? "star" : "star-tom")" /></button>
                    }
                    @if (KanSlette(k))
                    {
                        <button type="button" class="kg-mer @(_bekreftSlettId == k.Id ? "fare" : "")" title="Slett innlegget" @onclick="@(() => Slett(k))">@if (_bekreftSlettId == k.Id) {<text>Slett?</text>} else {<Icon Name="trash" />}</button>
                    }
                </div>
            </div>

            <div class="kg-merkerad">
                @if (_visning != Visning.Fellesskap && k.Fellesskap is { } f)
                {
                    <a class="kg-fra" href="@($"/kunngjoringer/fellesskap/{f.Id}")"><span class="kg-flogo kg-flogo-xxs" style="background:@f.Farge">@Forkortelse(f.Navn)</span>@f.Navn</a>
                }
                @if (k.Type != InnleggType.Diskusjon)
                {
                    <span class="kg-tag kg-t-@k.Type.ToString().ToLowerInvariant()">@k.Type.Emoji() @k.Type.Visningsnavn()</span>
                }
            </div>

            @if (k.BildeData is not null)
            {
                @* Hele bildet vises (høye bilder midt i rammen med en uskarp kopi i kantene)
                   i stedet for å skjæres til en fast stripe. *@
                <div class="kg-pbg" style="--b:url('/kunngjoringbilde/@(k.Id)?w=1200')" aria-label="@k.Tittel">
                    <img src="@($"/kunngjoringbilde/{k.Id}?w=1200")" alt="" loading="lazy" />
                    @if (!string.IsNullOrWhiteSpace(k.Sted)) {<span class="kg-pbg-over"><Icon Name="map-pin" />@k.Sted</span>}
                </div>
            }

            @if (k.Type.HarTittel())
            {
                <h3>@k.Tittel</h3>
            }

            @if (k.Type == InnleggType.Ros)
            {
                var merke = RosMerke.Hent(k.RosMerke);
                <div class="kg-roskort">
                    <span class="kg-medalje">@merke.Emoji</span>
                    <div>
                        <b>@(merke.Navn)!</b>
                        @if (!string.IsNullOrWhiteSpace(k.Innhold)) {<small>@k.Innhold</small>}
                        @if (k.RosTilBruker is { } til)
                        {
                            <div class="kg-ros-til">Til @Avatar(til.Navn, "") @til.Navn</div>
                        }
                    </div>
                </div>
            }
            else if (VisSomFargepost(k))
            {
                <div class="kg-fargepost kg-bg-@k.Bakgrunn">@k.Innhold</div>
            }
            else if (!string.IsNullOrWhiteSpace(k.Innhold))
            {
                var lang = k.Innhold.Length > 320;
                var utvidet = _utvidet.Contains(k.Id);
                <p class="kg-tx @(lang && !utvidet ? "kort" : "")">@k.Innhold</p>
                @if (lang)
                {
                    <button type="button" class="kg-semer" @onclick="@(() => { if (!_utvidet.Remove(k.Id)) { _utvidet.Add(k.Id); } })">@(utvidet ? "vis mindre" : "se mer")</button>
                }
            }

            @if (!string.IsNullOrWhiteSpace(k.InfoTekst))
            {
                <div class="kg-info">@k.InfoTekst</div>
            }

            @if (k.Type == InnleggType.Avstemning && k.Valg.Count > 0)
            {
                var totalt = k.Valg.Sum(v => v.Stemmer.Count);
                var minStemme = MinStemme(k);
                <div class="kg-poll">
                    @foreach (var v in k.Valg.OrderBy(v => v.Rekkefolge))
                    {
                        var valg = v;
                        var prosent = totalt == 0 ? 0 : (int)Math.Round(v.Stemmer.Count * 100.0 / totalt);
                        <button type="button" class="kg-valg @(minStemme == v.Id ? "min" : "")" @onclick="@(() => Stem(k, valg))">
                            <i style="width:@(prosent)%"></i><span>@(minStemme == v.Id ? "✓ " : "")@v.Tekst</span><b>@prosent%</b>
                        </button>
                    }
                    <small>@totalt @(totalt == 1 ? "stemme" : "stemmer")@(minStemme is null ? " · klikk for å stemme" : " · du har stemt – klikk igjen for å angre")</small>
                </div>
            }

            @if (k.EventDato is not null || !string.IsNullOrWhiteSpace(k.Sted) && k.BildeData is null)
            {
                <div class="kg-event">
                    @if (k.EventDato is { } dato)
                    {
                        <span class="kg-kal"><small>@dato.ToString("MMM", _kultur).TrimEnd('.')</small><b>@dato.Day</b></span>
                    }
                    <div>
                        <div class="kg-event-t1">@(k.EventDato?.ToString("dddd d. MMMM", _kultur))@(string.IsNullOrWhiteSpace(k.Sted) ? "" : $" · {k.Sted}")</div>
                        @if (!string.IsNullOrWhiteSpace(k.Detaljer)) {<div class="kg-event-t2">@k.Detaljer</div>}
                        <div class="kg-event-t2">@DeltarTekst(k)</div>
                    </div>
                    @if (_naverendeBrukerId is not null && k.EventDato is { } d && d.Date >= DateTime.Today)
                    {
                        <div class="kg-rsvp">
                            @foreach (var (svar, tekst) in PameldingValg)
                            {
                                var s = svar;
                                <button type="button" class="@(MittSvar(k) == s ? "valgt" : "")" @onclick="@(() => MeldPa(k, s))">@(MittSvar(k) == s && s == PameldingSvar.Kommer ? "✓ " : "")@tekst</button>
                            }
                        </div>
                    }
                </div>
            }

            @if (k.KreverBekreftelse)
            {
                var mottakere = MottakereAv(k);
                var bekreftet = k.Bekreftelser.Count;
                <div class="kg-bekreft">
                    <span class="kg-bekreft-tall">@Math.Min(bekreftet, mottakere) av @mottakere har sett</span>
                    @if (KanKunngjore(k.Fellesskap) && ManglerBekreftelse(k).Count > 0)
                    {
                        <button type="button" class="kg-lenke" @onclick="@(() => { if (!_visManglerBekreftelse.Remove(k.Id)) { _visManglerBekreftelse.Add(k.Id); } })">@(_visManglerBekreftelse.Contains(k.Id) ? "Skjul" : $"Hvem har ikke sett? ({ManglerBekreftelse(k).Count})")</button>
                    }
                    @if (k.OpprettetAvBrukerId != _naverendeBrukerId)
                    {
                        @if (HarBekreftet(k))
                        {
                            <span class="kg-bekreftet"><span class="kg-sett-prikk sett"></span>Du har sett denne</span>
                        }
                        else
                        {
                            <span class="kg-bekreft-vent">Merkes som sett når den har vært på skjermen</span>
                        }
                    }
                </div>
                @if (_visManglerBekreftelse.Contains(k.Id))
                {
                    <div class="kg-mangler">Har ikke sett: @string.Join(", ", ManglerBekreftelse(k).Select(b => b.Navn))</div>
                }
            }

            @{ var reaksjoner = k.Likes.GroupBy(l => l.Reaksjon).OrderByDescending(g => g.Count()).Select(g => KunngjoringReaksjon.Hent(g.Key).Emoji).Take(3).ToList(); }
            <div class="kg-preak">
                <span class="kg-emo">@foreach (var e in reaksjoner) {<em>@e</em>}@if (k.Likes.Count > 0) {<text>&nbsp;@k.Likes.Count</text>}</span>
                <span>@k.Kommentarer.Count @(k.Kommentarer.Count == 1 ? "kommentar" : "kommentarer")</span>
            </div>
            @{ var min = MinReaksjon(k); var minR = min is null ? default : KunngjoringReaksjon.Hent(min); }
            <div class="kg-handl">
                <span class="kg-handl-reager">
                    <button type="button" class="@(min is not null ? "pa" : "")" @onclick="@(() => Reager(k, min ?? KunngjoringReaksjon.Tommel))">@(min is null ? "👍 Liker" : $"{minR.Emoji} {minR.Navn}")</button>
                    <span class="kg-reagvelger">
                        @foreach (var (id, emoji, navn) in KunngjoringReaksjon.Alle)
                        {
                            var r = id;
                            <button type="button" title="@navn" @onclick="@(() => Reager(k, r))">@emoji</button>
                        }
                    </span>
                </span>
                <button type="button" @onclick="@(() => _visteKommentarer.Add(k.Id))"><Icon Name="mail" />@(k.Type == InnleggType.Sporsmal ? "Svar" : "Kommenter")</button>
            </div>

            @if (k.Kommentarer.Count > 0 || _visteKommentarer.Contains(k.Id))
            {
                var kommentarer = k.Kommentarer.OrderBy(c => c.OpprettetDato).ToList();
                var beste = kommentarer.FirstOrDefault(c => c.Id == k.BesteSvarKommentarId);
                var visAlle = _visteKommentarer.Contains(k.Id) || kommentarer.Count <= 2;
                @if (beste is not null)
                {
                    <div class="kg-svar"><span class="kg-svar-h"><Icon Name="check" />Beste svar · @(beste.Bruker?.Navn ?? "Ukjent")</span>@beste.Tekst</div>
                }
                @if (!visAlle)
                {
                    <button type="button" class="kg-vis-komm" @onclick="@(() => _visteKommentarer.Add(k.Id))">Vis alle @kommentarer.Count kommentarer</button>
                }
                @foreach (var kom in visAlle ? kommentarer : kommentarer.TakeLast(2).ToList())
                {
                    var komm = kom;
                    <div class="kg-komm" @key="kom.Id">
                        @Avatar(kom.Bruker?.Navn ?? "?", "")
                        <div class="kg-komm-boble @(kom.Id == k.BesteSvarKommentarId ? "beste" : "")">
                            <b>@(kom.Bruker?.Navn ?? "Ukjent")</b><small>@Naar(kom.OpprettetDato)</small>
                            <p>@kom.Tekst</p>
                            @if (KanVelgeBesteSvar(k) && kom.BrukerId != k.OpprettetAvBrukerId)
                            {
                                <button type="button" class="kg-beste-knapp" @onclick="@(() => VelgBesteSvar(k, komm))">@(kom.Id == k.BesteSvarKommentarId ? "✓ Beste svar" : "Merk som beste svar")</button>
                            }
                        </div>
                    </div>
                }
                <div class="kg-skriv">
                    @Avatar(_naverendeBruker?.Navn ?? "?", "")
                    <input placeholder="@(k.Type == InnleggType.Sporsmal ? "Skriv et svar …" : "Skriv en kommentar …")" value="@_kommentarUtkast.GetValueOrDefault(k.Id, "")"
                           @oninput="@(e => _kommentarUtkast[k.Id] = e.Value?.ToString() ?? "")"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilKommentar(k); } })" />
                    <button type="button" class="kg-knapp kg-knapp-p kg-knapp-liten" @onclick="@(() => LeggTilKommentar(k))">Send</button>
                </div>
            }
        </article>
    };
}
