@page "/kunngjoringer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kunngjøringer - Full Kontroll</PageTitle>

@* Oppsett "Sosial" (oktober 2026): kategorimeny til venstre, feed i midten
   med reaksjoner, kommentarer og påmelding på arrangementer, og et
   sidepanel med neste arrangement og nye kolleger. *@
<div class="kunngjoringer-side">

<div class="kg-topp">
    <div>
        <h1>Kunngjøringer</h1>
        <p>Informasjon og oppdateringer for hele teamet</p>
    </div>
    @if (ErAdminEllerPl)
    {
        <button type="button" class="kg-knapp kg-knapp-p" @onclick="@(() => _visNyForm = !_visNyForm)"><Icon Name="plus" />Ny kunngjøring</button>
    }
</div>

<div class="kg-sos">
    <nav class="kg-meny">
        <button type="button" class="@(_filter == "" ? "aktiv" : "")" @onclick="@(() => _filter = "")"><Icon Name="home" />Alt<em>@_kunngjoringer.Count</em></button>
        @foreach (var kat in Enum.GetValues<KunngjoringKategori>())
        {
            var verdi = kat.ToString();
            <button type="button" class="@(_filter == verdi ? "aktiv" : "")" @onclick="@(() => _filter = verdi)"><Icon Name="@kat.PillIkon()" />@kat.Visningsnavn()<em>@_kunngjoringer.Count(k => k.Kategori == kat)</em></button>
        }
        <button type="button" class="@(_filter == "festet" ? "aktiv" : "")" @onclick="@(() => _filter = "festet")"><Icon Name="star" />Festet<em>@_kunngjoringer.Count(k => k.Festet)</em></button>
    </nav>

    <div class="kg-feed">
        @if (ErAdminEllerPl && !_visNyForm)
        {
            <button type="button" class="kg-komponer" @onclick="@(() => _visNyForm = true)">
                <span class="kg-av kg-av-l" style="background:@AvatarFarge(_naverendeBruker?.Navn ?? "?");">@Initialer(_naverendeBruker?.Navn ?? "?")</span>
                <span class="kg-komponer-felt">Hva vil du dele@(_naverendeBruker is null ? "" : $", {Fornavn(_naverendeBruker.Navn)}")?</span>
            </button>
        }

        @if (_visNyForm)
        {
            <div class="kg-form">
                <h3>Ny kunngjøring</h3>
                <span class="kg-form-lbl">Kategori</span>
                <div class="kg-katvalg">
                    @foreach (var kat in Enum.GetValues<KunngjoringKategori>())
                    {
                        var valgt = kat;
                        <button type="button" class="kg-kat kg-kat-@kat.PillFarge() @(_nyKategori == kat ? "valgt" : "")" @onclick="@(() => _nyKategori = valgt)"><Icon Name="@kat.PillIkon()" />@kat.Visningsnavn()</button>
                    }
                </div>
                <label>Tittel<input @bind="_nyTittel" placeholder="F.eks. Sommerfest 2026" /></label>
                <label>Innhold<textarea rows="4" @bind="_nyInnhold" placeholder="Skriv kunngjøringen her..."></textarea></label>
                <label>
                    Bilde (valgfritt)
                    <InputFile OnChange="LastOppBilde" accept="image/*" />
                </label>
                @if (_nyBildeData is not null)
                {
                    <p class="kg-bilde-valgt">Bilde valgt: @_nyBildeFilnavn <button type="button" class="kg-lenke" @onclick="FjernValgtBilde">Fjern</button></p>
                }
                <span class="kg-form-lbl">Arrangement (valgfritt – gir påmelding)</span>
                <div class="kg-form-rad">
                    <label>Dato<input type="date" @bind="_nyEventDato" /></label>
                    <label>Sted<input @bind="_nySted" placeholder="F.eks. Sjøsiden Selskapslokaler" /></label>
                    <label>Detaljer<input @bind="_nyDetaljer" placeholder="F.eks. kl. 19:00 · 3-retters middag" /></label>
                </div>
                <label>Uthevet info<input @bind="_nyInfoTekst" placeholder="F.eks. Påmelding til Kari innen 10. oktober." /></label>
                <label class="kg-sjekk"><input type="checkbox" @bind="_nyFestet" />Fest øverst</label>
                @if (!string.IsNullOrEmpty(_feil))
                {
                    <p class="form-error">@_feil</p>
                }
                <div class="kg-form-knapper">
                    <button type="button" class="kg-knapp" @onclick="@(() => _visNyForm = false)">Avbryt</button>
                    <button type="button" class="kg-knapp kg-knapp-p" @onclick="Opprett"><Icon Name="send" />Publiser</button>
                </div>
            </div>
        }

        @if (Synlige.Count == 0)
        {
            <p class="list-empty">@(_kunngjoringer.Count == 0 ? "Ingen kunngjøringer ennå." : "Ingen kunngjøringer i denne kategorien.")</p>
        }

        @foreach (var k in Synlige)
        {
            var ny = k.Id > _sistSettId && k.OpprettetAvBrukerId != _naverendeBrukerId;
            <article class="kg-post @(ny ? "ny" : "")" @key="k.Id">
                <div class="kg-pb">
                    <div class="kg-forf">
                        <span class="kg-av kg-av-l" style="background:@AvatarFarge(k.OpprettetAvBruker?.Navn ?? "?");">@Initialer(k.OpprettetAvBruker?.Navn ?? "?")</span>
                        <div>
                            <b>@(k.OpprettetAvBruker?.Navn ?? "Ukjent")</b>
                            <small>@Naar(k.OpprettetDato) · <span class="kg-katnavn kg-katnavn-@k.Kategori.PillFarge()">@k.Kategori.Visningsnavn()</span></small>
                        </div>
                        <span class="kg-forf-hoyre">
                            @if (ny)
                            {
                                <span class="kg-nytt">Ny</span>
                            }
                            @if (k.Festet)
                            {
                                <span class="kg-festet"><Icon Name="star" />Festet</span>
                            }
                            @if (ErAdminEllerPl)
                            {
                                <button type="button" class="kg-slett" title="Slett kunngjøring" @onclick="@(() => Slett(k))"><Icon Name="trash" /></button>
                            }
                        </span>
                    </div>
                    <h2><a href="@($"/kunngjoring/{k.Id}")">@k.Tittel</a></h2>
                    <p class="kg-tekst">@k.Innhold</p>
                </div>

                @if (k.BildeData is not null)
                {
                    <a href="@($"/kunngjoring/{k.Id}")" class="kg-bilde" style="background-image:url('@($"/kunngjoringbilde/{k.Id}")');" aria-label="@k.Tittel"></a>
                }

                <div class="kg-pb">
                    @if (k.EventDato is not null || !string.IsNullOrWhiteSpace(k.Sted))
                    {
                        <div class="kg-event">
                            @if (k.EventDato is { } dato)
                            {
                                <span class="kg-kal"><small>@dato.ToString("MMM", _kultur).TrimEnd('.')</small><b>@dato.Day</b><span>@dato.ToString("dddd", _kultur)</span></span>
                            }
                            <div>
                                <div class="kg-event-t1">@(string.IsNullOrWhiteSpace(k.Sted) ? k.EventDato?.ToString("dddd d. MMMM", _kultur) : k.Sted)</div>
                                @if (!string.IsNullOrWhiteSpace(k.Detaljer))
                                {
                                    <div class="kg-event-t2">@k.Detaljer</div>
                                }
                            </div>
                        </div>
                        @if (KanMeldePa(k))
                        {
                            <div class="kg-rsvp">
                                @foreach (var (svar, tekst) in PameldingValg)
                                {
                                    var s = svar;
                                    <button type="button" class="@(MittSvar(k) == s ? "valgt" : "")" @onclick="@(() => MeldPa(k, s))">@(MittSvar(k) == s && s == PameldingSvar.Kommer ? "✓ " : "")@tekst</button>
                                }
                            </div>
                            <div class="kg-deltar">@DeltarTekst(k)</div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(k.InfoTekst))
                    {
                        <div class="kg-info">@k.InfoTekst</div>
                    }

                    <div class="kg-reak">
                        @foreach (var (id, emoji, navn) in KunngjoringReaksjon.Alle)
                        {
                            var r = id;
                            var antall = k.Likes.Count(l => l.Reaksjon == r);
                            <button type="button" class="@(MinReaksjon(k) == r ? "valgt" : "")" title="@navn" @onclick="@(() => Reager(k, r))">@emoji @(antall > 0 ? antall : "")</button>
                        }
                        <span class="kg-reak-komm">💬 @k.Kommentarer.Count @(k.Kommentarer.Count == 1 ? "kommentar" : "kommentarer")</span>
                    </div>

                    @if (k.Kommentarer.Count > 0)
                    {
                        var visAlle = _visteKommentarer.Contains(k.Id) || k.Kommentarer.Count <= 2;
                        var kommentarer = k.Kommentarer.OrderBy(c => c.OpprettetDato).ToList();
                        @if (!visAlle)
                        {
                            <button type="button" class="kg-vis-komm" @onclick="@(() => _visteKommentarer.Add(k.Id))">Vis alle @k.Kommentarer.Count kommentarer</button>
                        }
                        @foreach (var kom in visAlle ? kommentarer : kommentarer.TakeLast(1).ToList())
                        {
                            <div class="kg-komm" @key="kom.Id">
                                <span class="kg-av" style="background:@AvatarFarge(kom.Bruker?.Navn ?? "?");">@Initialer(kom.Bruker?.Navn ?? "?")</span>
                                <div class="kg-komm-boble"><b>@(kom.Bruker?.Navn ?? "Ukjent")</b><small>@Naar(kom.OpprettetDato)</small><p>@kom.Tekst</p></div>
                            </div>
                        }
                    }

                    <div class="kg-skriv">
                        <span class="kg-av" style="background:@AvatarFarge(_naverendeBruker?.Navn ?? "?");">@Initialer(_naverendeBruker?.Navn ?? "?")</span>
                        <input placeholder="Skriv en kommentar..." value="@GetUtkast(k.Id)"
                               @oninput="@(e => _kommentarUtkast[k.Id] = e.Value?.ToString() ?? "")"
                               @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilKommentar(k); } })" />
                        <button type="button" class="kg-knapp kg-knapp-p kg-knapp-liten" @onclick="@(() => LeggTilKommentar(k))">Send</button>
                    </div>
                </div>
            </article>
        }
    </div>

    <aside class="kg-side">
        @if (NesteArrangement is { } neste)
        {
            <div class="kg-widget">
                <h3><Icon Name="calendar" />@neste.Tittel</h3>
                <small class="kg-widget-under">@neste.EventDato!.Value.ToString("dddd d. MMMM", _kultur)@(string.IsNullOrWhiteSpace(neste.Sted) ? "" : $" · {neste.Sted}")</small>
                <div class="kg-rsvp">
                    @foreach (var (svar, tekst) in PameldingValg)
                    {
                        var s = svar;
                        <button type="button" class="@(MittSvar(neste) == s ? "valgt" : "")" @onclick="@(() => MeldPa(neste, s))">@tekst</button>
                    }
                </div>
                <div class="kg-deltar">
                    <span class="kg-stabel">
                        @foreach (var p in neste.Pameldinger.Where(p => p.Svar == PameldingSvar.Kommer).Take(5))
                        {
                            <span class="kg-av" style="background:@AvatarFarge(p.Bruker?.Navn ?? "?");" title="@p.Bruker?.Navn">@Initialer(p.Bruker?.Navn ?? "?")</span>
                        }
                    </span>
                    @DeltarTekst(neste)
                </div>
            </div>
        }

        @if (NyeKolleger.Count > 0)
        {
            <div class="kg-widget">
                <h3><Icon Name="users" />Nye kolleger</h3>
                @foreach (var n in NyeKolleger)
                {
                    <a class="kg-wrad" href="@($"/kunngjoring/{n.Id}")">
                        <span class="kg-av" style="background:#a1690a;"><Icon Name="users" /></span>
                        <span><b>@n.Tittel</b><small>@Naar(n.OpprettetDato)</small></span>
                    </a>
                }
            </div>
        }

        @if (Kommende.Count > 1)
        {
            <div class="kg-widget">
                <h3><Icon Name="calendar" />Kommende</h3>
                @foreach (var a in Kommende)
                {
                    <a class="kg-wrad" href="@($"/kunngjoring/{a.Id}")">
                        <span class="kg-kal kg-kal-liten"><small>@a.EventDato!.Value.ToString("MMM", _kultur).TrimEnd('.')</small><b>@a.EventDato.Value.Day</b></span>
                        <span><b>@a.Tittel</b><small>@(a.Sted ?? a.EventDato.Value.ToString("dddd", _kultur))</small></span>
                    </a>
                }
            </div>
        }
    </aside>
</div>

</div>

@code {
    private static readonly System.Globalization.CultureInfo _kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private List<Kunngjoring> _kunngjoringer = [];
    private bool _visNyForm;
    private string _nyTittel = "";
    private string _nyInnhold = "";
    private KunngjoringKategori _nyKategori = KunngjoringKategori.Info;
    private bool _nyFestet;
    private DateTime? _nyEventDato;
    private string? _nySted;
    private string? _nyDetaljer;
    private string? _nyInfoTekst;
    private byte[]? _nyBildeData;
    private string? _nyBildeContentType;
    private string? _nyBildeFilnavn;
    private string? _feil;

    private static readonly string[] _avatarPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private static string AvatarFarge(string navn) => _avatarPaletten[Math.Abs(navn.GetHashCode()) % _avatarPaletten.Length];

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => string.Concat(deler[0][0], deler[^1][0]).ToUpperInvariant()
        };
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;
    private bool ErAdminEllerPl;
    private readonly Dictionary<int, string> _kommentarUtkast = [];

    private string GetUtkast(int kunngjoringId) => _kommentarUtkast.GetValueOrDefault(kunngjoringId, "");

    // "" = alle, ellers en KunngjoringKategori eller "festet".
    private string _filter = "";
    // Siste kunngjøring brukeren hadde sett før siden ble åpnet - nyere får "Ny".
    private int _sistSettId = int.MaxValue;
    private readonly HashSet<int> _visteKommentarer = [];

    private static readonly (PameldingSvar Svar, string Tekst)[] PameldingValg =
    [
        (PameldingSvar.Kommer, "Jeg kommer"),
        (PameldingSvar.Kanskje, "Kanskje"),
        (PameldingSvar.KanIkke, "Kan ikke")
    ];

    private List<Kunngjoring> Synlige => _filter switch
    {
        "" => _kunngjoringer,
        "festet" => _kunngjoringer.Where(k => k.Festet).ToList(),
        _ => _kunngjoringer.Where(k => k.Kategori.ToString() == _filter).ToList()
    };

    private List<Kunngjoring> Kommende => _kunngjoringer
        .Where(k => k.EventDato is { } d && d.Date >= DateTime.Today)
        .OrderBy(k => k.EventDato)
        .Take(4)
        .ToList();

    private Kunngjoring? NesteArrangement => Kommende.FirstOrDefault();

    private List<Kunngjoring> NyeKolleger => _kunngjoringer
        .Where(k => k.Kategori == KunngjoringKategori.Nyansatt && k.OpprettetDato >= DateTime.Today.AddDays(-60))
        .OrderByDescending(k => k.OpprettetDato)
        .Take(3)
        .ToList();

    private static string Fornavn(string navn) => navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;

    private static string Naar(DateTime t)
    {
        if (t.Date == DateTime.Today) { return $"i dag {t:HH:mm}"; }
        if (t.Date == DateTime.Today.AddDays(-1)) { return $"i går {t:HH:mm}"; }
        return t.Year == DateTime.Today.Year ? t.ToString("d. MMM", _kultur) : t.ToString("d. MMM yyyy", _kultur);
    }

    private string? MinReaksjon(Kunngjoring k) => k.Likes.FirstOrDefault(l => l.BrukerId == _naverendeBrukerId)?.Reaksjon;

    private PameldingSvar? MittSvar(Kunngjoring k) => k.Pameldinger.FirstOrDefault(p => p.BrukerId == _naverendeBrukerId)?.Svar;

    private bool KanMeldePa(Kunngjoring k) => _naverendeBrukerId is not null && k.EventDato is { } d && d.Date >= DateTime.Today;

    private static string DeltarTekst(Kunngjoring k)
    {
        var kommer = k.Pameldinger.Count(p => p.Svar == PameldingSvar.Kommer);
        var kanskje = k.Pameldinger.Count(p => p.Svar == PameldingSvar.Kanskje);
        return kommer + kanskje == 0 ? "Ingen har svart ennå" : $"{kommer} kommer · {kanskje} kanskje";
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            ErAdminEllerPl = rolleClaim is "Admin" or "Prosjektleder";

            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
                _sistSettId = _naverendeBruker?.SisteKunngjoringSettId ?? 0;
            }
        }

        await LastAsync();
        await MarkerSomLestAsync();
    }

    private async Task LastAsync()
    {
        _kunngjoringer = await Db.Kunngjoringer
            .Include(k => k.OpprettetAvBruker)
            .Include(k => k.Likes)
            .Include(k => k.Kommentarer).ThenInclude(kom => kom.Bruker)
            .Include(k => k.Pameldinger).ThenInclude(p => p.Bruker)
            .AsSplitQuery()
            .OrderByDescending(k => k.Festet)
            .ThenByDescending(k => k.OpprettetDato)
            .ToListAsync();
    }

    // Én reaksjon per bruker: samme reaksjon igjen fjerner den, en annen bytter.
    private async Task Reager(Kunngjoring k, string reaksjon)
    {
        if (_naverendeBrukerId is null)
        {
            return;
        }

        var eksisterende = await Db.KunngjoringLikes
            .FirstOrDefaultAsync(l => l.KunngjoringId == k.Id && l.BrukerId == _naverendeBrukerId);

        if (eksisterende is null)
        {
            var ny = new KunngjoringLike { KunngjoringId = k.Id, BrukerId = _naverendeBrukerId.Value, Reaksjon = reaksjon };
            Db.KunngjoringLikes.Add(ny);
            if (!k.Likes.Contains(ny)) { k.Likes.Add(ny); }
        }
        else if (eksisterende.Reaksjon == reaksjon)
        {
            Db.KunngjoringLikes.Remove(eksisterende);
            k.Likes.RemoveAll(l => l.BrukerId == _naverendeBrukerId);
        }
        else
        {
            eksisterende.Reaksjon = reaksjon;
            k.Likes.RemoveAll(l => l.BrukerId == _naverendeBrukerId);
            k.Likes.Add(eksisterende);
        }

        await Db.SaveChangesAsync();
    }

    // Påmelding på arrangement: samme svar igjen trekker svaret.
    private async Task MeldPa(Kunngjoring k, PameldingSvar svar)
    {
        if (_naverendeBrukerId is null)
        {
            return;
        }

        var eksisterende = await Db.KunngjoringPameldinger
            .FirstOrDefaultAsync(p => p.KunngjoringId == k.Id && p.BrukerId == _naverendeBrukerId);

        if (eksisterende is null)
        {
            var ny = new KunngjoringPamelding { KunngjoringId = k.Id, BrukerId = _naverendeBrukerId.Value, Svar = svar, Bruker = _naverendeBruker };
            Db.KunngjoringPameldinger.Add(ny);
            if (!k.Pameldinger.Contains(ny)) { k.Pameldinger.Add(ny); }
        }
        else if (eksisterende.Svar == svar)
        {
            Db.KunngjoringPameldinger.Remove(eksisterende);
            k.Pameldinger.RemoveAll(p => p.BrukerId == _naverendeBrukerId);
        }
        else
        {
            eksisterende.Svar = svar;
            eksisterende.OppdatertDato = DateTime.Now;
            k.Pameldinger.RemoveAll(p => p.BrukerId == _naverendeBrukerId);
            k.Pameldinger.Add(eksisterende);
        }

        await Db.SaveChangesAsync();
    }

    private async Task LeggTilKommentar(Kunngjoring k)
    {
        var tekst = GetUtkast(k.Id).Trim();
        if (string.IsNullOrWhiteSpace(tekst))
        {
            return;
        }

        var kommentar = new KunngjoringKommentar
        {
            KunngjoringId = k.Id,
            Tekst = tekst,
            BrukerId = _naverendeBrukerId
        };
        Db.KunngjoringKommentarer.Add(kommentar);
        await Db.SaveChangesAsync();

        kommentar.Bruker = _naverendeBruker;
        // EF legger den nye kommentaren inn i k.Kommentarer selv (fix-up) - ikke legg til to ganger.
        if (!k.Kommentarer.Contains(kommentar)) { k.Kommentarer.Add(kommentar); }
        _kommentarUtkast[k.Id] = "";
    }

    private async Task MarkerSomLestAsync()
    {
        if (_naverendeBrukerId is null || _kunngjoringer.Count == 0)
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
        if (bruker is null)
        {
            return;
        }

        var nyesteId = _kunngjoringer.Max(k => k.Id);
        if ((bruker.SisteKunngjoringSettId ?? 0) < nyesteId)
        {
            bruker.SisteKunngjoringSettId = nyesteId;
            await Db.SaveChangesAsync();
        }
    }

    private async Task LastOppBilde(InputFileChangeEventArgs e)
    {
        _feil = null;
        var fil = e.File;
        if (fil.Size > 8_000_000)
        {
            _feil = $"\"{fil.Name}\" er for stort (maks 8 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = fil.OpenReadStream(maxAllowedSize: 8_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _nyBildeData = buffer.ToArray();
        _nyBildeContentType = string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType;
        _nyBildeFilnavn = fil.Name;
    }

    private void FjernValgtBilde()
    {
        _nyBildeData = null;
        _nyBildeContentType = null;
        _nyBildeFilnavn = null;
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyTittel) || string.IsNullOrWhiteSpace(_nyInnhold))
        {
            _feil = "Tittel og innhold må fylles ut.";
            return;
        }

        Db.Kunngjoringer.Add(new Kunngjoring
        {
            Tittel = _nyTittel.Trim(),
            Innhold = _nyInnhold.Trim(),
            Kategori = _nyKategori,
            Festet = _nyFestet,
            EventDato = _nyEventDato,
            Sted = string.IsNullOrWhiteSpace(_nySted) ? null : _nySted.Trim(),
            Detaljer = string.IsNullOrWhiteSpace(_nyDetaljer) ? null : _nyDetaljer.Trim(),
            InfoTekst = string.IsNullOrWhiteSpace(_nyInfoTekst) ? null : _nyInfoTekst.Trim(),
            OpprettetAvBrukerId = _naverendeBrukerId,
            BildeData = _nyBildeData,
            BildeContentType = _nyBildeContentType,
            BildeFilnavn = _nyBildeFilnavn
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _nyTittel = "";
        _nyInnhold = "";
        _nyKategori = KunngjoringKategori.Info;
        _nyFestet = false;
        _nyEventDato = null;
        _nySted = null;
        _nyDetaljer = null;
        _nyInfoTekst = null;
        FjernValgtBilde();
        _visNyForm = false;
        await LastAsync();
        await MarkerSomLestAsync();
    }

    private async Task Slett(Kunngjoring k)
    {
        Db.Kunngjoringer.Remove(k);
        await Db.SaveChangesAsync();
        _kunngjoringer.Remove(k);
    }
}
