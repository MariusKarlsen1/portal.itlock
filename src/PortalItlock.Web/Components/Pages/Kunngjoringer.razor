    private static async Task<(byte[]? Data, string? Type, string? Feil)> LesBilde(InputFileChangeEventArgs e)
    {
        var fil = e.File;
        if (fil.Size > 8_000_000)
        {
            return (null, null, $"\"{fil.Name}\" er for stort (maks 8 MB).");
        }

        using var buffer = new MemoryStream();
        await using (var stream = fil.OpenReadStream(maxAllowedSize: 8_000_000))
        {
            await stream.CopyToAsync(buffer);
        }
        return (buffer.ToArray(), string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType, null);
    }

    private async Task Publiser(Fellesskap? fast)
    {
        if (_nyType is not { } type || _naverendeBrukerId is not { } bid)
        {
            return;
        }

        var fellesskapId = fast?.Id ?? _nyFellesskapId ?? MineFellesskap.FirstOrDefault()?.Id;
        var f = _fellesskap.FirstOrDefault(x => x.Id == fellesskapId);
        if (f is null)
        {
            _feil = "Velg hvilket fellesskap innlegget skal deles i.";
            return;
        }
        if (type is InnleggType.Kunngjoring or InnleggType.Arrangement && !KanKunngjore(f))
        {
            _feil = "Bare ledelsen og administratorer i fellesskapet kan publisere kunngjøringer.";
            return;
        }

        var tittel = _nyTittel.Trim();
        var innhold = _nyInnhold.Trim();
        var valg = _nyValg.Select(v => v.Trim()).Where(v => v.Length > 0).ToList();

        _feil = type switch
        {
            _ when type.HarTittel() && tittel.Length == 0 => type == InnleggType.Avstemning ? "Skriv spørsmålet i avstemningen." : "Skriv en tittel.",
            InnleggType.Avstemning when valg.Count < 2 => "En avstemning trenger minst to alternativer.",
            InnleggType.Ros when _nyRosTil is null => "Velg hvem som skal få ros.",
            InnleggType.Arrangement when _nyEventDato is null => "Velg dato for arrangementet.",
            InnleggType.Diskusjon or InnleggType.Ros when innhold.Length == 0 => "Skriv noe først.",
            _ => null
        };
        if (_feil is not null)
        {
            return;
        }

        var k = new Kunngjoring
        {
            Tittel = type.HarTittel() ? tittel : Kort(innhold.Length > 0 ? innhold : type.Visningsnavn(), 80),
            Innhold = innhold,
            Type = type,
            FellesskapId = f.Id,
            OpprettetAvBrukerId = bid,
            Festet = KanKunngjore(f) && _nyFestet,
            KreverBekreftelse = type == InnleggType.Kunngjoring && _nyKrevBekreftelse,
            Bakgrunn = type is InnleggType.Diskusjon or InnleggType.Kunngjoring && InnleggBakgrunn.ErGyldig(_nyBakgrunn) ? _nyBakgrunn : null,
            BildeData = _nyBildeData,
            BildeContentType = _nyBildeContentType,
            BildeFilnavn = _nyBildeFilnavn,
            RosTilBrukerId = type == InnleggType.Ros ? _nyRosTil : null,
            RosMerke = type == InnleggType.Ros ? _nyRosMerke : null,
            EventDato = type == InnleggType.Arrangement ? _nyEventDato : null,
            Sted = type == InnleggType.Arrangement && !string.IsNullOrWhiteSpace(_nySted) ? _nySted.Trim() : null,
            Detaljer = type == InnleggType.Arrangement && !string.IsNullOrWhiteSpace(_nyDetaljer) ? _nyDetaljer.Trim() : null
        };
        if (type == InnleggType.Avstemning)
        {
            for (var i = 0; i < valg.Count; i++)
            {
                k.Valg.Add(new AvstemningValg { Tekst = valg[i], Rekkefolge = i });
            }
        }

        Db.Kunngjoringer.Add(k);
        await Db.SaveChangesAsync();

        NullstillSkjema();
        await LastFellesskapAsync();
        await LastInnleggAsync();
    }

