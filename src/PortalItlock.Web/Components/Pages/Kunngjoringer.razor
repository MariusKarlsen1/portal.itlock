@page "/kunngjoringer"
@page "/kunngjoringer/fellesskap"
@page "/kunngjoringer/fellesskap/{FellesskapId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@implements IAsyncDisposable
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>@SideTittel - Full Kontroll</PageTitle>

@* Kunngjøringer som fellesskap (oktober 2026, etter Viva Engage):
   1) /kunngjoringer/fellesskap - mine fellesskap og "Oppdag fellesskap",
   2) /kunngjoringer/fellesskap/{id} - omslag, skrivefelt med innleggstyper
      (Diskusjon, Spørsmål, Ros, Avstemning, Kunngjøring, Arrangement),
      feed og sidepanel med medlemmer, kommende og festede innlegg,
   3) /kunngjoringer - hjem-feed med alt fra fellesskapene mine.
   Innlegg kan ha bakgrunnsbilde eller fargebakgrunn. *@
@* VK4 (fellesskap-viktig-forslag.html): alt i ett kort som fyller vinduet - menyen med
   fellesskapene inni kortet til venstre, og innholdet som ruller for seg til høyre. *@
<div class="kunngjoringer-side @(_full ? "kg-full" : "")">
<div class="kg-eng kg-kortramme">
    <nav class="kg-meny">
        <div class="kg-meny-rull">
            <a href="/kunngjoringer" class="@(_visning == Visning.Hjem ? "pa" : "")"><Icon Name="home" /><span>Hjem</span>@if (UlesteTotalt > 0) {<span class="kg-ul">@UlesteTotalt</span>}</a>
            <a href="/kunngjoringer/fellesskap" class="@(_visning == Visning.Oversikt ? "pa" : "")"><Icon Name="users" />Alle fellesskap</a>

            @if (Favoritter.Count > 0)
            {
                <h5>Favoritter</h5>
                @foreach (var f in Favoritter)
                {
                    @MenyLenke(f)
                }
            }
            <h5>Mine fellesskap</h5>
            @foreach (var f in MineFellesskap)
            {
                @MenyLenke(f)
            }
            <a href="/kunngjoringer/fellesskap" class="kg-oppdag"><Icon Name="search" />Oppdag fellesskap</a>
        </div>
        @if (KanOppretteFellesskap)
        {
            <div class="kg-opprett">
                <button type="button" class="kg-ny-knapp" @onclick="@(() => _visOpprettMeny = !_visOpprettMeny)"><Icon Name="plus" />Opprett nytt</button>
                @if (_visOpprettMeny)
                {
                    <div class="kg-opprett-meny">
                        <button type="button" @onclick="NyttInnleggFraMeny"><Icon Name="edit" />Nytt innlegg</button>
                        <button type="button" @onclick="@(() => { _visOpprettMeny = false; ApneFellesskapSkjema(null); })"><Icon Name="users" />Nytt fellesskap</button>
                    </div>
                }
            </div>
        }
    </nav>

    <div class="kg-innhold">
        @if (_visning == Visning.Oversikt)
        {
            @* ---------- 1 · Fellesskap ---------- *@
            <div class="kg-ptittel">
                <div><h1>Fellesskap</h1><p>Se hva som er nytt i fellesskapene dine, og finn flere i organisasjonen</p></div>
            </div>

            <section class="kg-seksjon">
                <div class="kg-shode"><h2>Mine fellesskap</h2></div>
                <div class="kg-mine">
                    @foreach (var f in MineFellesskap)
                    {
                        var nye = UlesteI(f.Id);
                        <a class="kg-mk" href="@($"/kunngjoringer/fellesskap/{f.Id}")" @key="f.Id">
                            @Omslag(f, "kg-oms-liten")
                            <span class="kg-mk-kr">
                                <span class="kg-flogo" style="background:@f.Farge">@Forkortelse(f.Navn)</span>
                                <b>@f.Navn</b>
                                <small>@AntallMedlemmer(f) <span>medlemmer</span>@if (nye > 0) {<text> · <span class="kg-nyp">@nye nye</span></text>}</small>
                            </span>
                        </a>
                    }
                </div>
            </section>

            <div class="kg-linje"></div>

            <section class="kg-seksjon">
                <div class="kg-shode"><div><h2>Oppdag fellesskap</h2><small>Alle fellesskap i organisasjonen</small></div></div>
                <div class="kg-sokrad">
                    <label class="kg-sokfelt"><Icon Name="search" /><input placeholder="Søk i fellesskap ..." @bind="_sok" @bind:event="oninput" /></label>
                    <button type="button" class="kg-chip @(!_bareIkkeMedlem ? "pa" : "")" @onclick="@(() => _bareIkkeMedlem = false)">Alle</button>
                    <button type="button" class="kg-chip @(_bareIkkeMedlem ? "pa" : "")" @onclick="@(() => _bareIkkeMedlem = true)">Ikke medlem</button>
                </div>
                @if (OppdagListe.Count == 0)
                {
                    <p class="list-empty">Ingen fellesskap passer søket.</p>
                }
                <div class="kg-fgrid">
                    @foreach (var f in OppdagListe)
                    {
                        <div class="kg-fk" @key="f.Id" @onclick="@(() => Nav.NavigateTo($"/kunngjoringer/fellesskap/{f.Id}"))">
                            @Omslag(f, "")
                            <div class="kg-fk-kropp">
                                <div class="kg-fk-topp"><span class="kg-flogo kg-flogo-m" style="background:@f.Farge">@Forkortelse(f.Navn)</span>@Stabel(MedlemmerAv(f).Take(4))</div>
                                <h3>@f.Navn @if (f.ErObligatorisk) {<span class="kg-obl">Obligatorisk</span>}</h3>
                                <p>@(f.Beskrivelse ?? "")</p>
                                <div class="kg-fk-fot">
                                    <span><Icon Name="users" />@AntallMedlemmer(f) medlemmer</span>
                                    @MedlemKnapp(f)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else if (_visning == Visning.Fellesskap && _aktivt is { } akt)
        {
            @* ---------- 2 · Inne i et fellesskap ---------- *@
            <div class="kg-fs kg-fs-vk4">
                <div class="kg-kol">
                    <div class="kg-fhode">
                        @Omslag(akt, "kg-oms-stor")
                        <div class="kg-fi">
                            <span class="kg-flogo kg-flogo-l" style="background:@akt.Farge">@Forkortelse(akt.Navn)</span>
                            <div class="kg-fi-rad">
                                <div>
                                    <h2>@akt.Navn</h2>
                                    <p>@AntallMedlemmer(akt) medlemmer@(akt.ErObligatorisk ? " · obligatorisk" : "")</p>
                                </div>
                                <div class="kg-ikk">
                                    @if (ErMedlem(akt))
                                    {
                                        <button type="button" class="@(ErFavoritt(akt) ? "pa" : "")" title="@(ErFavoritt(akt) ? "Fjern fra favoritter" : "Legg til i favoritter")" @onclick="@(() => VekslFavoritt(akt))"><Icon Name="@(ErFavoritt(akt) ? "star" : "star-tom")" /></button>
                                    }
                                    @if (KanRedigere(akt))
                                    {
                                        <button type="button" title="Rediger fellesskap" @onclick="@(() => ApneFellesskapSkjema(akt))"><Icon Name="settings" /></button>
                                    }
                                    @MedlemKnapp(akt)
                                    <button type="button" class="kg-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
                                </div>
                            </div>
                        </div>
                        <div class="kg-ffaner">
                            @foreach (var (id, navn) in Faner)
                            {
                                var fid = id;
                                <button type="button" class="@(_fane == fid ? "pa" : "")" @onclick="@(() => _fane = fid)">@navn</button>
                            }
                        </div>
                    </div>

                    @if (_fane == "om")
                    {
                        <div class="kg-wid kg-om">
                            <h4>Om @akt.Navn</h4>
                            <p>@(akt.Beskrivelse ?? "Ingen beskrivelse.")</p>
                            <div class="kg-egen"><span>Opprettet</span><span>@akt.OpprettetDato.ToString("d. MMMM yyyy", _kultur)@(akt.OpprettetAvBruker is null ? "" : $" av {akt.OpprettetAvBruker.Navn}")</span></div>
                            <div class="kg-egen"><span>Medlemmer</span><span>@AntallMedlemmer(akt)@(akt.ErObligatorisk ? " (alle i organisasjonen)" : "")</span></div>
                            <div class="kg-egen"><span>Administratorer</span><span>@string.Join(", ", akt.Medlemmer.Where(m => m.ErAdmin).Select(m => m.Bruker?.Navn))</span></div>
                            <h4 style="margin-top:10px">Medlemmer</h4>
                            <div class="kg-medliste">
                                @foreach (var b in MedlemmerAv(akt))
                                {
                                    <span class="kg-medrad">@Avatar(b.Navn, "")<span><b>@b.Navn</b><small>@(b.Stilling ?? b.Rolle.Visningsnavn())@(ErFellesskapAdmin(akt, b.Id) ? " · administrator" : "")</small></span></span>
                                }
                            </div>
                        </div>
                    }
                    else if (_fane == "bilder")
                    {
                        var medBilde = _innlegg.Where(k => k.BildeData is not null).ToList();
                        @if (medBilde.Count == 0)
                        {
                            <p class="list-empty">Ingen bilder i dette fellesskapet ennå.</p>
                        }
                        <div class="kg-bildegrid">
                            @foreach (var k in medBilde)
                            {
                                <a href="@($"/kunngjoringbilde/{k.Id}")" target="_blank" class="kg-bb" style="--b:url('/kunngjoringbilde/@(k.Id)?w=500')" title="@k.Tittel"><img src="@($"/kunngjoringbilde/{k.Id}?w=500")" alt="" loading="lazy" /></a>
                            }
                        </div>
                    }
                    else
                    {
                        @if (ErMedlem(akt))
                        {
                            @Komponer(akt)
                        }
                        else
                        {
                            <div class="kg-blimed-boks"><span>Bli med i <b>@akt.Navn</b> for å skrive innlegg og få varsler.</span>@MedlemKnapp(akt)</div>
                        }
                        <div class="kg-sortrad">
                            <span class="kg-antall">@FilterteInnlegg.Count innlegg</span>
                            <select @bind="_sortering" class="kg-dd">
                                <option value="nyeste">Nyeste innlegg</option>
                                <option value="aktivitet">Siste aktivitet</option>
                            </select>
                        </div>
                        @Feed(FilterteInnlegg)
                    }
                </div>
            </div>
        }
        else if (_visning == Visning.Fellesskap)
        {
            <p class="list-empty">Fant ikke fellesskapet. <a href="/kunngjoringer/fellesskap">Se alle fellesskap</a></p>
        }
        else
        {
            @* ---------- 3 · Hjem ---------- *@
            <div class="kg-fs kg-fs-hjem">
                <div class="kg-kol">
                    <div class="kg-ptittel"><div><h1>@Hilsen@(_naverendeBruker is null ? "" : $", {Fornavn(_naverendeBruker.Navn)}")</h1><p>Alt nytt fra fellesskapene dine samlet på ett sted</p></div></div>

                    @if (VenterPaBekreftelse.Count > 0)
                    {
                        var forste = VenterPaBekreftelse[0];
                        <div class="kg-viktig">
                            <span class="kg-viktig-ik">📣</span>
                            <div><b>@VenterPaBekreftelse.Count @(VenterPaBekreftelse.Count == 1 ? "viktig kunngjøring" : "viktige kunngjøringer") du ikke har sett</b><small>@Kort(forste.Tittel, 70) · fra @(forste.OpprettetAvBruker?.Navn ?? "ukjent")</small></div>
                            <button type="button" class="kg-knapp kg-knapp-p" @onclick="@(() => _filter = "viktig")">Vis</button>
                        </div>
                    }

                    @if (KanSkriveNoeSted)
                    {
                        @Komponer(null)
                    }

                    <div class="kg-sokrad">
                        @foreach (var (id, navn) in HjemFilter)
                        {
                            var fid = id;
                            <button type="button" class="kg-chip @(_filter == fid ? "pa" : "")" @onclick="@(() => _filter = fid)">@navn</button>
                        }
                    </div>
                    @Feed(FilterteInnlegg)
                </div>
            </div>
        }
    </div>
</div>

@if (_visFellesskapSkjema)
{
    <div class="kg-modal-bg" @onclick="@(() => _visFellesskapSkjema = false)">
        <div class="kg-modal" @onclick:stopPropagation="true">
            <h3>@(_redigerer is null ? "Nytt fellesskap" : $"Rediger {_redigerer.Navn}")</h3>
            <label>Navn<input @bind="_fNavn" placeholder="F.eks. Montører" /></label>
            <label>Beskrivelse<textarea rows="3" @bind="_fBeskrivelse" placeholder="Hva handler fellesskapet om?"></textarea></label>
            <span class="kg-lbl">Omslag</span>
            <div class="kg-temavalg">
                @foreach (var t in FellesskapTema.Liste)
                {
                    var tid = t.Id;
                    <button type="button" class="@(_fTema == tid ? "pa" : "")" style="background:linear-gradient(135deg,@t.Fra,@t.Til);" title="@t.Navn" @onclick="@(() => _fTema = tid)">@t.Emoji[0]</button>
                }
            </div>
            <label>Eget omslagsbilde (valgfritt)<InputFile OnChange="LastOppOmslag" accept="image/*" /></label>
            @if (_fOmslagData is not null || _redigerer?.OmslagData is not null)
            {
                <p class="kg-bilde-valgt">Omslagsbilde valgt <button type="button" class="kg-lenke" @onclick="@(() => { _fOmslagData = null; _fFjernOmslag = true; })">Fjern</button></p>
            }
            @if (ErAdminEllerPl)
            {
                <label class="kg-sjekk"><input type="checkbox" @bind="_fObligatorisk" />Obligatorisk – alle i organisasjonen er medlemmer</label>
            }
            @if (!_fObligatorisk)
            {
                @* Velg hvem som skal være med. Den som oppretter er alltid med (som administrator). *@
                var treff = _interneBrukere.Where(b => string.IsNullOrWhiteSpace(_fMedSok) || b.Navn.Contains(_fMedSok.Trim(), StringComparison.OrdinalIgnoreCase) || (b.Stilling ?? "").Contains(_fMedSok.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                var alleValgt = treff.Count > 0 && treff.All(b => _fMedlemmer.Contains(b.Id));
                <div class="kg-medvelg">
                    <div class="kg-medvelg-topp">
                        <span class="kg-lbl">Medlemmer <small>@_fMedlemmer.Count valgt</small></span>
                        <button type="button" class="kg-lenke" @onclick="@(() => VelgAlleMedlemmer(treff, !alleValgt))">@(alleValgt ? "Fjern alle" : "Velg alle")</button>
                    </div>
                    <input class="kg-medvelg-sok" type="search" placeholder="Søk etter navn eller stilling …" @bind="_fMedSok" @bind:event="oninput" />
                    <div class="kg-medvelg-liste">
                        @foreach (var b in treff)
                        {
                            var bid = b.Id;
                            var meg = bid == _naverendeBrukerId;
                            var valgt = meg || _fMedlemmer.Contains(bid);
                            <label class="@(valgt ? "pa" : "")">
                                <input type="checkbox" checked="@valgt" disabled="@meg" @onchange="@(() => { if (!_fMedlemmer.Remove(bid)) _fMedlemmer.Add(bid); })" />
                                @Avatar(b.Navn, "")
                                <span><b>@b.Navn@(meg ? " (deg)" : "")</b><small>@(b.Stilling ?? b.Rolle.Visningsnavn())</small></span>
                            </label>
                        }
                        @if (treff.Count == 0)
                        {
                            <p class="list-empty">Ingen treff.</p>
                        }
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_fFeil))
            {
                <p class="form-error">@_fFeil</p>
            }
            <div class="kg-form-knapper">
                @if (_redigerer is not null && ErAdminEllerPl)
                {
                    <button type="button" class="kg-knapp kg-knapp-fare" @onclick="SlettFellesskap" style="margin-right:auto">@(_bekreftSlettFellesskap ? "Bekreft sletting" : "Slett")</button>
                }
                <button type="button" class="kg-knapp" @onclick="@(() => _visFellesskapSkjema = false)">Avbryt</button>
                <button type="button" class="kg-knapp kg-knapp-p" @onclick="LagreFellesskap">Lagre</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private static readonly System.Globalization.CultureInfo _kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private enum Visning { Hjem, Oversikt, Fellesskap }

    [Parameter] public int? FellesskapId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Visning _visning;
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;
    private bool ErAdminEllerPl;

    private List<Fellesskap> _fellesskap = [];
    private List<Bruker> _interneBrukere = [];
    private Fellesskap? _aktivt;
    private List<Kunngjoring> _innlegg = [];
    // (innleggId, fellesskapId) for alle innlegg - til ulest-tellere i menyen.
    private List<(int Id, int? FellesskapId)> _alleInnleggIder = [];
    private HashSet<int> _settAvMeg = [];
    // Uleste da siden ble åpnet - beholdes for "Ny"-merket selv etter at de er markert som sett.
    private HashSet<int> _ulesteVedApning = [];

    private string _filter = "";
    private string _fane = "samtaler";
    private string _sortering = "nyeste";
    private string _sok = "";
    private bool _bareIkkeMedlem;
    private bool _visOpprettMeny;
    private readonly HashSet<int> _visteKommentarer = [];
    private readonly HashSet<int> _utvidet = [];
    private readonly HashSet<int> _visManglerBekreftelse = [];
    private readonly Dictionary<int, string> _kommentarUtkast = [];

    private string SideTittel => _visning switch
    {
        Visning.Oversikt => "Fellesskap",
        Visning.Fellesskap => _aktivt?.Navn ?? "Fellesskap",
        _ => "Kunngjøringer"
    };

    private static readonly (string Id, string Navn)[] Faner =
        [("samtaler", "Samtaler"), ("kunngjoringer", "Kunngjøringer"), ("sporsmal", "Spørsmål"), ("arrangement", "Arrangement"), ("bilder", "Bilder"), ("om", "Om")];

    private static readonly (string Id, string Navn)[] HjemFilter =
        [("", "Alt"), ("kunngjoringer", "📣 Kunngjøringer"), ("sporsmal", "❓ Spørsmål"), ("ros", "🏅 Ros"), ("arrangement", "📅 Arrangement"), ("avstemning", "📊 Avstemning"), ("viktig", "Viktig"), ("ulest", "Ulest")];

    private static readonly (PameldingSvar Svar, string Tekst)[] PameldingValg =
        [(PameldingSvar.Kommer, "Kommer"), (PameldingSvar.Kanskje, "Kanskje"), (PameldingSvar.KanIkke, "Kan ikke")];

    // ---------- lasting ----------

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            ErAdminEllerPl = rolleClaim is "Admin" or "Prosjektleder";
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        _full = await VisningPref.HentAsync("kunngjoringer-bredde", "normal") == "full";
        await SikreStandardFellesskapAsync();
        _interneBrukere = await Db.Brukere
            .Where(b => b.Aktiv && b.KundeId == null && b.Rolle != BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .ToListAsync();
        await LastFellesskapAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var sti = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        _visning = FellesskapId is not null ? Visning.Fellesskap
            : sti.EndsWith("fellesskap", StringComparison.OrdinalIgnoreCase) ? Visning.Oversikt
            : Visning.Hjem;
        _filter = "";
        _fane = "samtaler";
        _visOpprettMeny = false;
        _aktivt = FellesskapId is { } id ? _fellesskap.FirstOrDefault(f => f.Id == id) : null;
        await LastInnleggAsync();
    }

    // Første gang: opprett "Hele firmaet" og flytt eldre kunngjøringer dit.
    private async Task SikreStandardFellesskapAsync()
    {
        if (!await Db.Fellesskap.AnyAsync())
        {
            Db.Fellesskap.Add(new Fellesskap
            {
                Navn = "Hele firmaet",
                Beskrivelse = "Fellesskapet for alle i organisasjonen. Viktige kunngjøringer fra ledelsen havner her.",
                Tema = "alle",
                Farge = FellesskapTema.Hent("alle").Til,
                ErObligatorisk = true,
                OpprettetAvBrukerId = _naverendeBrukerId
            });
            await Db.SaveChangesAsync();
        }

        if (await Db.Kunngjoringer.AnyAsync(k => k.FellesskapId == null))
        {
            var standard = await Db.Fellesskap.Where(f => f.ErObligatorisk).OrderBy(f => f.Id).FirstOrDefaultAsync()
                ?? await Db.Fellesskap.OrderBy(f => f.Id).FirstAsync();
            await Db.Kunngjoringer.Where(k => k.FellesskapId == null)
                .ExecuteUpdateAsync(s => s.SetProperty(k => k.FellesskapId, standard.Id));
        }
    }

    private async Task LastFellesskapAsync()
    {
        _fellesskap = await Db.Fellesskap
            .Include(f => f.Medlemmer).ThenInclude(m => m.Bruker)
            .Include(f => f.OpprettetAvBruker)
            .OrderByDescending(f => f.ErObligatorisk).ThenBy(f => f.Navn)
            .ToListAsync();
        _alleInnleggIder = (await Db.Kunngjoringer.Select(k => new { k.Id, k.FellesskapId }).ToListAsync())
            .Select(x => (x.Id, x.FellesskapId)).ToList();
        _settAvMeg = _naverendeBrukerId is { } b
            ? (await Db.KunngjoringVisninger.Where(v => v.BrukerId == b).Select(v => v.KunngjoringId).ToListAsync()).ToHashSet()
            : [];
    }

    private async Task LastInnleggAsync()
    {
        IQueryable<Kunngjoring> q = Db.Kunngjoringer;
        if (_visning == Visning.Fellesskap)
        {
            var fid = _aktivt?.Id ?? -1;
            q = q.Where(k => k.FellesskapId == fid);
        }
        else if (_visning == Visning.Hjem)
        {
            var mine = MineFellesskap.Select(f => f.Id).ToList();
            q = q.Where(k => k.FellesskapId != null && mine.Contains(k.FellesskapId.Value));
        }
        else
        {
            _innlegg = [];
            return;
        }

        _innlegg = await q
            .Include(k => k.OpprettetAvBruker)
            .Include(k => k.RosTilBruker)
            .Include(k => k.Fellesskap)
            .Include(k => k.Likes)
            .Include(k => k.Kommentarer).ThenInclude(c => c.Bruker)
            .Include(k => k.Pameldinger).ThenInclude(p => p.Bruker)
            .Include(k => k.Bekreftelser).ThenInclude(b => b.Bruker)
            .Include(k => k.Visninger)
            .Include(k => k.Valg).ThenInclude(v => v.Stemmer)
            .AsSplitQuery()
            .OrderByDescending(k => k.Festet).ThenByDescending(k => k.OpprettetDato)
            .Take(150)
            .ToListAsync();

        _ulesteVedApning = _innlegg.Where(k => !_settAvMeg.Contains(k.Id) && k.OpprettetAvBrukerId != _naverendeBrukerId).Select(k => k.Id).ToHashSet();
        await MarkerSomSettAsync();
    }

    // "Sett av" + uleste: registrer visning for innleggene som nå vises.
    private async Task MarkerSomSettAsync()
    {
        if (_naverendeBrukerId is not { } bid || _innlegg.Count == 0)
        {
            return;
        }

        foreach (var k in _innlegg.Where(k => !_settAvMeg.Contains(k.Id)))
        {
            var v = new KunngjoringVisning { KunngjoringId = k.Id, BrukerId = bid };
            Db.KunngjoringVisninger.Add(v);
            if (!k.Visninger.Contains(v)) { k.Visninger.Add(v); }
            _settAvMeg.Add(k.Id);
        }

        if (_naverendeBruker is { } bruker)
        {
            var nyeste = _alleInnleggIder.Count == 0 ? 0 : _alleInnleggIder.Max(x => x.Id);
            if (_visning == Visning.Hjem && (bruker.SisteKunngjoringSettId ?? 0) < nyeste)
            {
                bruker.SisteKunngjoringSettId = nyeste;
            }
        }

        await Db.SaveChangesAsync();
    }

    // ---------- medlemskap ----------

    private bool ErMedlem(Fellesskap f) => f.ErObligatorisk || f.Medlemmer.Any(m => m.BrukerId == _naverendeBrukerId);
    private bool ErFavoritt(Fellesskap f) => f.Medlemmer.Any(m => m.BrukerId == _naverendeBrukerId && m.ErFavoritt);
    private static bool ErFellesskapAdmin(Fellesskap f, int brukerId) => f.Medlemmer.Any(m => m.BrukerId == brukerId && m.ErAdmin);
    private bool KanRedigere(Fellesskap f) => ErAdminEllerPl || (_naverendeBrukerId is { } b && ErFellesskapAdmin(f, b));
    private bool KanOppretteFellesskap => ErAdminEllerPl;
    // Kunngjøring/arrangement (med "Fest øverst" og "Lest og forstått") er for ledelsen og fellesskapsadministratorer.
    private bool KanKunngjore(Fellesskap? f) => ErAdminEllerPl || (f is not null && _naverendeBrukerId is { } b && ErFellesskapAdmin(f, b));
    private bool KanSkriveNoeSted => MineFellesskap.Count > 0 && _naverendeBrukerId is not null;

    private List<Fellesskap> MineFellesskap => _fellesskap.Where(ErMedlem).ToList();
    private List<Fellesskap> Favoritter => _fellesskap.Where(ErFavoritt).ToList();

    private List<Bruker> MedlemmerAv(Fellesskap f) => f.ErObligatorisk
        ? _interneBrukere
        : f.Medlemmer.Where(m => m.Bruker is not null).Select(m => m.Bruker!).OrderByDescending(b => ErFellesskapAdmin(f, b.Id)).ThenBy(b => b.Navn).ToList();

    private int AntallMedlemmer(Fellesskap f) => f.ErObligatorisk ? _interneBrukere.Count : f.Medlemmer.Count;

    private List<Fellesskap> OppdagListe => _fellesskap
        .Where(f => !_bareIkkeMedlem || !ErMedlem(f))
        .Where(f => string.IsNullOrWhiteSpace(_sok) || f.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase) || (f.Beskrivelse ?? "").Contains(_sok, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int UlesteI(int fellesskapId) => _alleInnleggIder.Count(x => x.FellesskapId == fellesskapId && !_settAvMeg.Contains(x.Id));
    private int UlesteTotalt => MineFellesskap.Sum(f => UlesteI(f.Id));

    private async Task BliMed(Fellesskap f)
    {
        if (_naverendeBrukerId is not { } bid || f.ErObligatorisk)
        {
            return;
        }

        var eksisterende = f.Medlemmer.FirstOrDefault(m => m.BrukerId == bid);
        if (eksisterende is null)
        {
            var ny = new FellesskapMedlem { FellesskapId = f.Id, BrukerId = bid, Bruker = _naverendeBruker };
            Db.FellesskapMedlemmer.Add(ny);
            if (!f.Medlemmer.Contains(ny)) { f.Medlemmer.Add(ny); }
        }
        else
        {
            Db.FellesskapMedlemmer.Remove(eksisterende);
            f.Medlemmer.Remove(eksisterende);
        }

        await Db.SaveChangesAsync();
        if (_visning == Visning.Hjem)
        {
            await LastInnleggAsync();
        }
    }

    private async Task VekslFavoritt(Fellesskap f)
    {
        if (_naverendeBrukerId is not { } bid)
        {
            return;
        }

        var rad = f.Medlemmer.FirstOrDefault(m => m.BrukerId == bid);
        if (rad is null)
        {
            // Obligatorisk fellesskap uten egen rad - opprett en for favoritten.
            rad = new FellesskapMedlem { FellesskapId = f.Id, BrukerId = bid, Bruker = _naverendeBruker, ErFavoritt = true };
            Db.FellesskapMedlemmer.Add(rad);
            if (!f.Medlemmer.Contains(rad)) { f.Medlemmer.Add(rad); }
        }
        else
        {
            rad.ErFavoritt = !rad.ErFavoritt;
        }

        await Db.SaveChangesAsync();
    }

    // ---------- fellesskap-skjema ----------

    private bool _visFellesskapSkjema;
    private Fellesskap? _redigerer;
    private string _fNavn = "";
    private string? _fBeskrivelse;
    private string _fTema = "alle";
    private bool _fObligatorisk;
    private HashSet<int> _fMedlemmer = [];
    private string _fMedSok = "";

    private void VelgAlleMedlemmer(List<Bruker> brukere, bool velg)
    {
        foreach (var b in brukere)
        {
            if (velg)
            {
                _fMedlemmer.Add(b.Id);
            }
            else if (b.Id != _naverendeBrukerId)
            {
                _fMedlemmer.Remove(b.Id);
            }
        }
    }
    private byte[]? _fOmslagData;
    private string? _fOmslagType;
    private bool _fFjernOmslag;
    private string? _fFeil;
    private bool _bekreftSlettFellesskap;

    private void ApneFellesskapSkjema(Fellesskap? f)
    {
        _redigerer = f;
        _fNavn = f?.Navn ?? "";
        _fBeskrivelse = f?.Beskrivelse;
        _fTema = f?.Tema ?? "montor";
        _fObligatorisk = f?.ErObligatorisk ?? false;
        _fMedlemmer = f is null
            ? (_naverendeBrukerId is { } meg ? [meg] : [])
            : f.Medlemmer.Select(m => m.BrukerId).ToHashSet();
        _fMedSok = "";
        _fOmslagData = null;
        _fOmslagType = null;
        _fFjernOmslag = false;
        _fFeil = null;
        _bekreftSlettFellesskap = false;
        _visFellesskapSkjema = true;
    }

    private async Task LastOppOmslag(InputFileChangeEventArgs e)
    {
        var (data, type, feil) = await LesBilde(e);
        _fFeil = feil;
        if (data is not null)
        {
            _fOmslagData = data;
            _fOmslagType = type;
            _fFjernOmslag = false;
        }
    }

    private async Task LagreFellesskap()
    {
        if (string.IsNullOrWhiteSpace(_fNavn))
        {
            _fFeil = "Fellesskapet må ha et navn.";
            return;
        }

        var f = _redigerer;
        if (f is null)
        {
            f = new Fellesskap { Navn = _fNavn.Trim(), OpprettetAvBrukerId = _naverendeBrukerId };
            Db.Fellesskap.Add(f);
            if (_naverendeBrukerId is { } bid)
            {
                f.Medlemmer.Add(new FellesskapMedlem { BrukerId = bid, ErAdmin = true });
            }
        }

        f.Navn = _fNavn.Trim();
        f.Beskrivelse = string.IsNullOrWhiteSpace(_fBeskrivelse) ? null : _fBeskrivelse.Trim();
        f.Tema = _fTema;
        f.Farge = FellesskapTema.Hent(_fTema).Til;
        if (ErAdminEllerPl) { f.ErObligatorisk = _fObligatorisk; }
        if (_fOmslagData is not null)
        {
            f.OmslagData = _fOmslagData;
            f.OmslagContentType = _fOmslagType;
        }
        else if (_fFjernOmslag)
        {
            f.OmslagData = null;
            f.OmslagContentType = null;
        }

        // Medlemmene som er krysset av (gjelder ikke obligatoriske - der er alle med).
        if (!f.ErObligatorisk)
        {
            if (_naverendeBrukerId is { } meg)
            {
                _fMedlemmer.Add(meg);
            }
            foreach (var m in f.Medlemmer.Where(m => !_fMedlemmer.Contains(m.BrukerId)).ToList())
            {
                f.Medlemmer.Remove(m);
                if (m.Id != 0)
                {
                    Db.Remove(m);
                }
            }
            foreach (var bid in _fMedlemmer.Where(bid => f.Medlemmer.All(m => m.BrukerId != bid)))
            {
                f.Medlemmer.Add(new FellesskapMedlem { BrukerId = bid });
            }
        }

        await Db.SaveChangesAsync();
        _visFellesskapSkjema = false;
        await LastFellesskapAsync();
        Nav.NavigateTo($"/kunngjoringer/fellesskap/{f.Id}");
        if (FellesskapId == f.Id)
        {
            _aktivt = _fellesskap.FirstOrDefault(x => x.Id == f.Id);
        }
    }

    private async Task SlettFellesskap()
    {
        if (_redigerer is null)
        {
            return;
        }
        if (!_bekreftSlettFellesskap)
        {
            _bekreftSlettFellesskap = true;
            return;
        }

        Db.Fellesskap.Remove(_redigerer);
        await Db.SaveChangesAsync();
        _visFellesskapSkjema = false;
        await SikreStandardFellesskapAsync();
        await LastFellesskapAsync();
        Nav.NavigateTo("/kunngjoringer/fellesskap");
    }

