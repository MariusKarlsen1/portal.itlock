        _nyBildeFilnavn = null;
        _nyFestet = false;
        _nyKrevBekreftelse = false;
        _nyRosTil = null;
        _nyRosMerke = "godt";
        _nyValg = ["", ""];
        _nyEventDato = null;
        _nySted = null;
        _nyDetaljer = null;
        _feil = null;
    }

