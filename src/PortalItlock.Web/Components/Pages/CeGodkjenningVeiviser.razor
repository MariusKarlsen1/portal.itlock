@page "/ce/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>CE-sertifisering</PageTitle>

<a class="back-link" href="@_tilbakeLenke">&larr; Tilbake</a>

<CeGodkjenningPanel Id="Id" OnClose="Lukk" />

@code {
    [Parameter] public int Id { get; set; }

    private string _tilbakeLenke = "/ce-godkjenninger";

    protected override async Task OnParametersSetAsync()
    {
        var dorId = await Db.CeGodkjenninger.Where(c => c.Id == Id).Select(c => (int?)c.DorId).FirstOrDefaultAsync();
        _tilbakeLenke = dorId is not null ? $"/dor/{dorId}" : "/ce-godkjenninger";
    }

    private void Lukk()
    {
        Nav.NavigateTo(_tilbakeLenke);
    }
}
