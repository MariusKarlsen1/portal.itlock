@page "/plattform/fakturering"
@page "/plattform/betalinger"
@page "/plattform/brukere"
@page "/plattform/prosjekter"
@page "/plattform/support"
@page "/plattform/rapporter"
@page "/plattform/systemer"
@page "/plattform/innstillinger"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@inject NavigationManager Nav

<PageTitle>@Tittel - Plattform</PageTitle>

<div class="pfs-root">
    <div class="pfs-ikon"><Icon Name="@Ikon" /></div>
    <h1 class="pfs-h1">@Tittel</h1>
    <p class="pfs-tekst">Denne delen av plattformadministrasjonen er ikke bygget ennå.</p>
</div>

@code {
    private string Sti => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private string Tittel => Sti switch
    {
        "/plattform/fakturering" => "Fakturering",
        "/plattform/betalinger" => "Betalinger",
        "/plattform/brukere" => "Brukere",
        "/plattform/prosjekter" => "Prosjekter",
        "/plattform/support" => "Support",
        "/plattform/rapporter" => "Rapporter",
        "/plattform/systemer" => "Systemer",
        "/plattform/innstillinger" => "Innstillinger",
        _ => "Plattform"
    };

    private string Ikon => Sti switch
    {
        "/plattform/fakturering" => "file-text",
        "/plattform/betalinger" => "credit-card",
        "/plattform/brukere" => "users",
        "/plattform/prosjekter" => "box",
        "/plattform/support" => "help-circle",
        "/plattform/rapporter" => "bar-chart",
        "/plattform/systemer" => "server",
        "/plattform/innstillinger" => "settings",
        _ => "folder"
    };
}
