@page "/oppdateringer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using PortalItlock.Web.Services

<PageTitle>Oppdateringer</PageTitle>

@* Alle versjonene fra «Hva er nytt» (Services/Oppdateringer.cs). *@
<div class="opp">
    <div class="opp-hode">
        <span class="opp-ikon"><Icon Name="sparkle" /></span>
        <div>
            <h1>Oppdateringer</h1>
            <p>Det viktigste som er nytt eller bedre i portalen.</p>
        </div>
    </div>

    @foreach (var v in Oppdateringer.Alle)
    {
        <section class="opp-versjon">
            <div class="opp-v-topp">
                <span class="opp-nr">Versjon @v.Nummer</span>
                @if (v == Oppdateringer.Siste)
                {
                    <span class="opp-siste">Siste</span>
                }
                <span class="opp-dato">@v.Dato.ToString("d. MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))</span>
            </div>
            <ul>
                @foreach (var p in v.Punkter)
                {
                    <li class="@Oppdateringer.Klasse(p.Type)">
                        <span class="opp-ik"><Icon Name="@p.Ikon" /></span>
                        <div>
                            <b>@p.Tittel<span class="opp-tag">@Oppdateringer.Navn(p.Type)</span></b>
                            <span>@p.Tekst</span>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</div>
