@page "/tickets"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.TicketEskaleringService EskaleringService

<PageTitle>Tickets</PageTitle>

<h1>Tickets</h1>
<p class="section-hint">Samlet oversikt over alle henvendelser og saker - fra e-post, kundeportal eller opprettet manuelt.</p>
<AuthorizeView Roles="Admin">
    <div class="admin-verktoy-rad">
        <a class="cancel-button" href="/ticket-kategorier">Rediger kategorier (Board/Type/Subtype)</a>
        <button type="button" class="cancel-button" @onclick="SjekkEskaleringNaa" disabled="@_eskalererNaa">Sjekk eskalering nå</button>
        @if (_eskaleringMelding is not null)
        {
            <span class="section-hint">@_eskaleringMelding</span>
        }
    </div>
</AuthorizeView>

<div class="ny-ticket">
    <h2>Ny ticket</h2>
    <div class="field-grid">
        <label class="span-2">
            Tittel
            <input @bind="_nyTittel" @bind:event="oninput" placeholder="Kort beskrivelse av saken" />
        </label>
        <label>
            Kunde (valgfritt)
            <select @bind="_nyKundeId">
                <option value="">Ingen kunde satt</option>
                @foreach (var k in _kunder)
                {
                    <option value="@k.Id">@k.Navn</option>
                }
            </select>
        </label>
    </div>
    <div class="form-actions">
        <button type="button" class="add-button" @onclick="OpprettTicket" disabled="@string.IsNullOrWhiteSpace(_nyTittel)">Opprett ticket</button>
    </div>
</div>

<div class="filter-rad">
    <label>
        Søk
        <input @bind="_sokTekst" @bind:event="oninput" placeholder="Tittel eller kunde" />
    </label>
    <label>
        Status
        <select @bind="_filterStatus">
            <option value="">Alle (utenom lukkede)</option>
            @foreach (var s in TicketStatusExtensions.Rekkefolge)
            {
                <option value="@s">@s.Visningsnavn()</option>
            }
        </select>
    </label>
    <label>
        Prioritet
        <select @bind="_filterPrioritet">
            <option value="">Alle</option>
            @foreach (var p in Enum.GetValues<TicketPrioritet>())
            {
                <option value="@p">@p.Visningsnavn()</option>
            }
        </select>
    </label>
    <label>
        Ansvarlig
        <select @bind="_filterAnsvarligId">
            <option value="">Alle</option>
            @foreach (var b in _brukere)
            {
                <option value="@b.Id">@b.Navn</option>
            }
        </select>
    </label>
    <label class="filter-checkbox">
        <input type="checkbox" @bind="_visLukkede" />
        Vis lukkede
    </label>
    <label class="filter-checkbox">
        <input type="checkbox" @bind="_kunReklamasjon" />
        Kun reklamasjoner
    </label>
</div>

<div class="visning-bryter">
    <button type="button" class="@(_visning == "liste" ? "visning-knapp aktiv" : "visning-knapp")" @onclick='@(() => _visning = "liste")'>Liste</button>
    <button type="button" class="@(_visning == "board" ? "visning-knapp aktiv" : "visning-knapp")" @onclick='@(() => _visning = "board")'>Board</button>
</div>

@if (_visning == "board")
{
    @if (!string.IsNullOrEmpty(_boardMelding))
    {
        <p class="section-hint board-melding">@_boardMelding</p>
    }
    <div class="ticket-board">
        @foreach (var status in TicketStatusExtensions.Rekkefolge)
        {
            var ticketsIKolonne = FiltrerteTickets.Where(t => t.Status == status).ToList();
            <div @key="status" class="ticket-board-kolonne" @ondragover="@(() => { })" @ondragover:preventDefault="true" @ondrop="@(() => OnDrop(status))">
                <div class="ticket-board-header ticket-status-@status">
                    <span>@status.Visningsnavn()</span>
                    <span class="ticket-board-antall">@ticketsIKolonne.Count</span>
                </div>
                @if (ticketsIKolonne.Count == 0)
                {
                    <p class="ticket-board-tom">Ingen tickets her.</p>
                }
                else
                {
                    @foreach (var t in ticketsIKolonne)
                    {
                        <a @key="t.Id" class="ticket-board-kort" href="@($"/ticket/{t.Id}")" draggable="true" @ondragstart="@(() => OnDragStart(t.Id))">
                            <span class="ticket-nr">#@t.Id</span>
                            <strong>@t.Tittel</strong>
                            @if (t.ErReklamasjon)
                            {
                                <span class="reklamasjon-badge">Reklamasjon</span>
                            }
                            <span class="ticket-kunde">@(t.Kunde?.Navn ?? "Ingen kunde satt")</span>
                            <div class="ticket-board-kort-footer">
                                <span class="ticket-prioritet ticket-prioritet-@t.Prioritet">@t.Prioritet.Visningsnavn()</span>
                                <span class="ticket-ansvarlig">@(t.AnsvarligBruker?.Navn ?? "Ikke tildelt")</span>
                            </div>
                            @if (t.SlaFrist.HasValue && t.SlaFrist.Value < DateTime.Now && t.Status != TicketStatus.Lukket)
                            {
                                <span class="ticket-forfalt">Forfalt SLA</span>
                            }
                        </a>
                    }
                }
            </div>
        }
    </div>
}
else if (FiltrerteTickets.Count == 0)
{
    <p class="list-empty">Ingen tickets funnet.</p>
}
else
{
    <div class="ticket-header">
        <span>Nr</span>
        <span>Tittel</span>
        <span>Kunde</span>
        <span>Status</span>
        <span>Prioritet</span>
        <span>Ansvarlig</span>
        <span>Dato</span>
        <span></span>
    </div>
    <ul class="ticket-liste">
        @foreach (var t in FiltrerteTickets)
        {
            <li @key="t.Id">
                <a class="ticket-rad" href="@($"/ticket/{t.Id}")">
                    <span class="ticket-nr">#@t.Id</span>
                    <span class="ticket-tittel">@t.Tittel @if (t.ErReklamasjon) { <span class="reklamasjon-badge">Reklamasjon</span> }</span>
                    <span class="ticket-kunde">@(t.Kunde?.Navn ?? "Ingen kunde satt")</span>
                    <span class="ticket-status ticket-status-@t.Status">@t.Status.Visningsnavn()</span>
                    <span class="ticket-prioritet ticket-prioritet-@t.Prioritet">@t.Prioritet.Visningsnavn()</span>
                    <span class="ticket-ansvarlig">@(t.AnsvarligBruker?.Navn ?? "Ikke tildelt")</span>
                    <span class="ticket-dato">@t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                    @if (t.SlaFrist.HasValue && t.SlaFrist.Value < DateTime.Now && t.Status != TicketStatus.Lukket)
                    {
                        <span class="ticket-forfalt">Forfalt SLA</span>
                    }
                </a>
            </li>
        }
    </ul>
}

@code {
    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class BrukerOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<Ticket> _tickets = [];
    private List<KundeOption> _kunder = [];
    private List<BrukerOption> _brukere = [];

    private string _nyTittel = "";
    private int? _nyKundeId;

    private string _sokTekst = "";
    private string _filterStatus = "";
    private string _filterPrioritet = "";
    private string _filterAnsvarligId = "";
    private bool _visLukkede;
    private bool _kunReklamasjon;

    private bool _eskalererNaa;
    private string? _eskaleringMelding;

    private string _visning = "liste";
    private int? _draggetTicketId;
    private string? _boardMelding;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private async Task SjekkEskaleringNaa()
    {
        _eskalererNaa = true;
        _eskaleringMelding = null;
        try
        {
            var antall = await EskaleringService.SjekkOgVarsleAsync();
            _eskaleringMelding = antall > 0
                ? $"Varsel sendt til marius@itlock.no ({antall} ticket(er) uten eier har passert SLA-fristen)."
                : "Ingen tickets uten eier har passert SLA-fristen akkurat nå.";
            await LastAsync();
        }
        finally
        {
            _eskalererNaa = false;
        }
    }

    private List<Ticket> FiltrerteTickets => _tickets
        .Where(t => _visLukkede || t.Status != TicketStatus.Lukket)
        .Where(t => !_kunReklamasjon || t.ErReklamasjon)
        .Where(t => string.IsNullOrEmpty(_filterStatus) || t.Status.ToString() == _filterStatus)
        .Where(t => string.IsNullOrEmpty(_filterPrioritet) || t.Prioritet.ToString() == _filterPrioritet)
        .Where(t => string.IsNullOrEmpty(_filterAnsvarligId) || t.AnsvarligBrukerId == int.Parse(_filterAnsvarligId))
        .Where(t => string.IsNullOrWhiteSpace(_sokTekst)
            || t.Tittel.Contains(_sokTekst, StringComparison.OrdinalIgnoreCase)
            || (t.Kunde != null && t.Kunde.Navn.Contains(_sokTekst, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(t => t.OpprettetDato)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        await LastAsync();
    }

    private void OnDragStart(int ticketId)
    {
        _draggetTicketId = ticketId;
        _boardMelding = null;
    }

    private async Task OnDrop(TicketStatus mal)
    {
        var ticketId = _draggetTicketId;
        _draggetTicketId = null;
        if (ticketId is null)
        {
            return;
        }

        var ticket = _tickets.FirstOrDefault(t => t.Id == ticketId.Value);
        if (ticket is null || ticket.Status == mal)
        {
            return;
        }

        if (mal == TicketStatus.Lukket)
        {
            _boardMelding = "Tickets kan ikke lukkes ved å dra dem hit - åpne ticketen og bruk \"Godkjenn og lukk\", siden det krever en sluttoppsummering til kunden.";
            return;
        }

        var gammelStatus = ticket.Status;
        ticket.Status = mal;
        Db.TicketHendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = $"Status endret fra {gammelStatus.Visningsnavn()} til {mal.Visningsnavn()} (board).",
            UtfortAvBrukerId = _naverendeBrukerId
        });
        await Db.SaveChangesAsync();
        _boardMelding = null;
    }

    private async Task LastAsync()
    {
        _tickets = await Db.Tickets
            .Include(t => t.Kunde)
            .Include(t => t.AnsvarligBruker)
            .ToListAsync();

        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        _brukere = await Db.Brukere
            .OrderBy(b => b.Navn)
            .Select(b => new BrukerOption { Id = b.Id, Navn = b.Navn })
            .ToListAsync();
    }

    private async Task OpprettTicket()
    {
        var tittel = _nyTittel.Trim();
        if (tittel.Length == 0)
        {
            return;
        }

        var ticket = new Ticket { Tittel = tittel, KundeId = _nyKundeId };
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/ticket/{ticket.Id}");
    }
}
