@page "/komponenter/oppdater-priser"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PrisimportService PrisimportSvc
@inject PrisoppdateringService PrisoppdateringSvc

<PageTitle>Oppdater priser</PageTitle>

<a class="back-link" href="/komponenter">← Tilbake til komponentregisteret</a>
<h1>Oppdater priser</h1>
<p class="section-hint">
    Lim inn/last opp den årlige prislisten fra en leverandør. Denne siden oppretter aldri nye varer - den matcher kun eksisterende varer på produktkode eller GTIN/EAN,
    og oppdaterer prisen bare der den faktisk er endret. Du velger selv fra hvilken dato de nye prisene skal gjelde, slik at du kan importere prislisten når den kommer
    uten at prisene endres før f.eks. nyttår.
</p>

@if (_planlagte.Count > 0)
{
    <div class="import-card">
        <h2>Planlagte prisendringer som venter</h2>
        <table class="import-table">
            <thead>
                <tr>
                    <th>Vare</th>
                    <th>Gammel pris netto</th>
                    <th>Ny pris netto</th>
                    <th>Gammel pris veil.</th>
                    <th>Ny pris veil.</th>
                    <th>Gjelder fra</th>
                    <th>Kilde</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _planlagte)
                {
                    <tr @key="p.Id">
                        <td>@(p.Component?.Navn ?? "(slettet vare)")</td>
                        <td>@(p.GammelPrisNetto?.ToString("N2", Kultur))</td>
                        <td>@(p.NyPrisNetto?.ToString("N2", Kultur))</td>
                        <td>@(p.GammelPrisVeiledende?.ToString("N2", Kultur))</td>
                        <td>@(p.NyPrisVeiledende?.ToString("N2", Kultur))</td>
                        <td>@p.GjelderFraDato.ToString("dd.MM.yyyy")</td>
                        <td>@p.Kilde</td>
                        <td><button type="button" class="cancel-button" @onclick="@(() => SlettPlanlagt(p))">Avbryt</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_steg == 1)
{
    <div class="import-hero">
        <div class="import-card import-upload-card">
            <h2>Velg importfil</h2>
            <label class="import-dropzone @(string.IsNullOrWhiteSpace(_leverandor) ? "import-dropzone-disabled" : "")">
                <InputFile OnChange="LastOppFil" accept=".xlsx" disabled="@(string.IsNullOrWhiteSpace(_leverandor))" class="import-dropzone-input" />
                <div class="import-dropzone-content">
                    <span class="import-dropzone-ikon">📄</span>
                    <p><strong>Klikk for å velge fil</strong> eller dra og slipp den her</p>
                    <p class="import-dropzone-hint">Excel-fil (.xlsx)</p>
                </div>
            </label>
            <div class="field-grid">
                <label class="import-leverandor-felt">
                    Leverandør
                    <input @bind="_leverandor" @bind:event="oninput" placeholder="F.eks. ASSA ABLOY" />
                </label>
                <label class="import-leverandor-felt">
                    Gjelder fra dato
                    <input type="date" @bind="_gjelderFraDato" />
                </label>
            </div>
            <p class="section-hint">
                Er datoen i dag eller tilbake i tid, oppdateres prisene med en gang. Er datoen frem i tid, planlegges endringen og trer i kraft automatisk den dagen.
            </p>

            @if (!string.IsNullOrEmpty(_feil))
            {
                <p class="form-error">@_feil</p>
            }
        </div>

        <div class="import-card import-komigang-card">
            <h2>Kom i gang</h2>
            <ol>
                <li>Skriv inn leverandør og velg dato de nye prisene skal gjelde fra.</li>
                <li>Velg eller dra inn Excel-filen med prislisten.</li>
                <li>Match kolonnene mot produktkode/GTIN og pris - vi foreslår automatisk.</li>
                <li>Se gjennom valideringen og trykk Oppdater priser.</li>
            </ol>
        </div>
    </div>

    @if (_historikk.Count > 0)
    {
        <div class="import-card import-historikk-card">
            <h2>Tidligere oppdateringer</h2>
            <table class="import-historikk-table">
                <thead>
                    <tr>
                        <th>Fil</th>
                        <th>Leverandør</th>
                        <th>Dato</th>
                        <th>Av</th>
                        <th>Status</th>
                        <th>Resultat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in _historikk)
                    {
                        <tr @key="h.Id">
                            <td>@h.Filnavn</td>
                            <td>@h.Leverandor</td>
                            <td>@h.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(h.OpprettetAvBruker?.Navn ?? "-")</td>
                            <td><span class="import-status-badge @(h.Status == "Fullført" ? "import-status-badge-ok" : h.Status == "Avbrutt" ? "import-status-badge-uendret" : "import-status-badge-pagar")">@h.Status</span></td>
                            <td>@(h.AntallOppdatert is not null ? $"{h.AntallOppdatert} oppdatert" : "-")</td>
                            <td><button type="button" class="cancel-button" @onclick="@(() => SlettHistorikk(h))">Slett</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_steg == 2)
{
    <div class="import-card import-info-card">
        <h2>@_filnavn</h2>
        <p class="section-hint">Fant @_rader.Count rad(er) og @_kolonner.Count kolonne(r) i filen.</p>
    </div>

    <div class="import-card import-mapping-card">
        <h2>Match kolonner</h2>
        <p class="section-hint">Vi har forsøkt å matche kolonnene automatisk. Minst én av produktkode/GTIN må velges.</p>

        <table class="mapping-table">
            <thead>
                <tr>
                    <th>Felt i portalen</th>
                    <th>Kolonne i filen</th>
                    <th>Eksempel fra første rad</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Produktkode</td>
                    <td>
                        <select @bind="_produktkodeKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_produktkodeKolIndeks is not null && _produktkodeKolIndeks == _autoForslag.Produktkode)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_produktkodeKolIndeks)</td>
                </tr>
                <tr>
                    <td>GTIN/EAN</td>
                    <td>
                        <select @bind="_gtinKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_gtinKolIndeks is not null && _gtinKolIndeks == _autoForslag.Gtin)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_gtinKolIndeks)</td>
                </tr>
                <tr>
                    <td>Pris netto</td>
                    <td>
                        <select @bind="_prisNettoKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_prisNettoKolIndeks is not null && _prisNettoKolIndeks == _autoForslag.PrisNetto)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_prisNettoKolIndeks)</td>
                </tr>
                <tr>
                    <td>Pris veiledende</td>
                    <td>
                        <select @bind="_prisVeiledendeKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_prisVeiledendeKolIndeks is not null && _prisVeiledendeKolIndeks == _autoForslag.PrisVeiledende)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_prisVeiledendeKolIndeks)</td>
                </tr>
            </tbody>
        </table>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="VisForhandsvisning" disabled="@(_produktkodeKolIndeks is null && _gtinKolIndeks is null)">Neste</button>
            <button type="button" class="cancel-button" @onclick="AvbrytOppdatering">Avbryt</button>
            @if (!string.IsNullOrEmpty(_feil))
            {
                <span class="form-error">@_feil</span>
            }
        </div>
    </div>
}
else if (_steg == 3)
{
    <div class="import-card">
        <h2>Validering</h2>
        <p class="section-hint">
            Nye priser gjelder fra @_gjelderFraDato.ToString("dd.MM.yyyy").
            Rader med uendret pris gjør ingenting, og rader med feil er markert i rødt.
        </p>
        <div class="import-oppsummering">
            <span class="import-oppsummering-tall import-oppsummering-ok">@_forhandsvisning.Count(r => r.Feil is null && r.ErEndret) endret</span>
            <span class="import-oppsummering-tall import-oppsummering-uendret">@_forhandsvisning.Count(r => r.Feil is null && !r.ErEndret) uendret</span>
            <span class="import-oppsummering-tall import-oppsummering-feil">@_forhandsvisning.Count(r => r.Feil is not null) ikke funnet</span>
        </div>

        <table class="import-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Rad</th>
                    <th>Vare</th>
                    <th>Pris netto</th>
                    <th>Pris veiledende</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _forhandsvisning)
                {
                    <tr @key="r.RadNummer" class="@(r.Feil is not null ? "import-rad-feil" : r.ErEndret ? "import-rad-ok" : "")">
                        <td><input type="checkbox" @bind="r.Inkluder" disabled="@(r.Feil is not null || !r.ErEndret)" /></td>
                        <td>@r.RadNummer</td>
                        <td>@(r.ComponentNavn ?? r.Produktkode ?? r.Gtin)</td>
                        <td>
                            @if (r.ErEndret && r.GammelPrisNetto != r.NyPrisNetto)
                            {
                                <span class="pris-gammel">@(r.GammelPrisNetto?.ToString("N2", Kultur))</span>
                                <text> → </text>
                            }
                            @(r.NyPrisNetto?.ToString("N2", Kultur))
                        </td>
                        <td>
                            @if (r.ErEndret && r.GammelPrisVeiledende != r.NyPrisVeiledende)
                            {
                                <span class="pris-gammel">@(r.GammelPrisVeiledende?.ToString("N2", Kultur))</span>
                                <text> → </text>
                            }
                            @(r.NyPrisVeiledende?.ToString("N2", Kultur))
                        </td>
                        <td>
                            @if (r.Feil is not null)
                            {
                                <span class="import-status-badge import-status-badge-feil">@r.Feil</span>
                            }
                            else if (r.ErEndret)
                            {
                                <span class="import-status-badge import-status-badge-ok">Endret</span>
                            }
                            else
                            {
                                <span class="import-status-badge import-status-badge-uendret">Uendret</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Oppdater">
                Oppdater priser (@_forhandsvisning.Count(r => r.Inkluder && r.Feil is null && r.ErEndret) vare(r))
            </button>
            <button type="button" class="cancel-button" @onclick="@(() => _steg = 2)">Tilbake</button>
        </div>
    </div>
}
else if (_steg == 4)
{
    <div class="import-card">
        <h2>Ferdig</h2>
        <p class="save-success">
            @_oppdatertNaaAntall pris(er) oppdatert med en gang.
            @if (_planlagtAntall > 0)
            {
                <text>@_planlagtAntall prisendring(er) planlagt til @_gjelderFraDato.ToString("dd.MM.yyyy").</text>
            }
        </p>
        <button type="button" class="save-button" @onclick="NyOppdatering">Ny oppdatering</button>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private int _steg = 1;
    private string _leverandor = "";
    private DateTime _gjelderFraDato = DateTime.Today;
    private string? _feil;
    private string? _filnavn;

    private List<PlanlagtPrisendring> _planlagte = [];
    private List<Importhistorikk> _historikk = [];
    private Importhistorikk? _gjeldendeHistorikk;

    private List<PrisimportService.ArkKolonne> _kolonner = [];
    private List<string[]> _rader = [];
    private string[]? _radeksempel;
    private PrisimportService.KolonneForslag _autoForslag = new();

    private int? _produktkodeKolIndeks;
    private int? _gtinKolIndeks;
    private int? _prisNettoKolIndeks;
    private int? _prisVeiledendeKolIndeks;

    private List<PrisoppdateringService.OppdateringRad> _forhandsvisning = [];
    private int _oppdatertNaaAntall;
    private int _planlagtAntall;

    private string? Eksempel(int? kolIndeks) =>
        kolIndeks is not null && _radeksempel is not null && kolIndeks.Value < _radeksempel.Length
            ? _radeksempel[kolIndeks.Value]
            : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        await LastPlanlagteAsync();
        await LastHistorikkAsync();
    }

    private async Task LastPlanlagteAsync()
    {
        _planlagte = await Db.PlanlagtePrisendringer
            .Include(p => p.Component)
            .Where(p => !p.Utfort)
            .OrderBy(p => p.GjelderFraDato)
            .ToListAsync();
    }

    private async Task SlettPlanlagt(PlanlagtPrisendring p)
    {
        Db.PlanlagtePrisendringer.Remove(p);
        await Db.SaveChangesAsync();
        _planlagte.Remove(p);
    }

    private async Task LastHistorikkAsync()
    {
        _historikk = await Db.Importhistorikk
            .Include(h => h.OpprettetAvBruker)
            .Where(h => h.Kilde == "Oppdater priser")
            .OrderByDescending(h => h.OpprettetDato)
            .Take(15)
            .ToListAsync();
    }

    private async Task SlettHistorikk(Importhistorikk h)
    {
        Db.Importhistorikk.Remove(h);
        await Db.SaveChangesAsync();
        _historikk.Remove(h);
    }

    private async Task LastOppFil(InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;

        if (file.Size > 20_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        buffer.Position = 0;

        try
        {
            (_kolonner, _rader) = PrisimportSvc.LesFil(buffer);
        }
        catch (Exception ex)
        {
            _feil = $"Klarte ikke å lese filen: {ex.Message}";
            return;
        }

        if (_kolonner.Count == 0)
        {
            _feil = "Fant ingen data i filen.";
            return;
        }

        _filnavn = file.Name;
        _radeksempel = _rader.Count > 0 ? _rader[0] : null;

        _autoForslag = PrisimportService.AutoMatchKolonner(_kolonner);
        _produktkodeKolIndeks = _autoForslag.Produktkode;
        _gtinKolIndeks = _autoForslag.Gtin;
        _prisNettoKolIndeks = _autoForslag.PrisNetto;
        _prisVeiledendeKolIndeks = _autoForslag.PrisVeiledende;

        _gjeldendeHistorikk = new Importhistorikk
        {
            Kilde = "Oppdater priser",
            Filnavn = _filnavn,
            Leverandor = _leverandor,
            OpprettetAvBrukerId = _naverendeBrukerId,
            Status = "Pågår"
        };
        Db.Importhistorikk.Add(_gjeldendeHistorikk);
        await Db.SaveChangesAsync();
        await LastHistorikkAsync();

        _steg = 2;
    }

    private async Task VisForhandsvisning()
    {
        if (_produktkodeKolIndeks is null && _gtinKolIndeks is null)
        {
            return;
        }

        _forhandsvisning = await PrisoppdateringSvc.ForhandsvisAsync(
            _rader, _produktkodeKolIndeks, _gtinKolIndeks, _prisNettoKolIndeks, _prisVeiledendeKolIndeks);

        if (_forhandsvisning.Count == 0)
        {
            _feil = "Fant ingen gyldige rader.";
            return;
        }

        _feil = null;
        _steg = 3;
    }

    private async Task Oppdater()
    {
        (_oppdatertNaaAntall, _planlagtAntall) = await PrisoppdateringSvc.OppdaterAsync(_forhandsvisning, _gjelderFraDato, _leverandor);
        await LastPlanlagteAsync();

        if (_gjeldendeHistorikk is not null)
        {
            _gjeldendeHistorikk.Status = "Fullført";
            _gjeldendeHistorikk.AntallRader = _forhandsvisning.Count;
            _gjeldendeHistorikk.AntallOppdatert = _oppdatertNaaAntall + _planlagtAntall;
            await Db.SaveChangesAsync();
            await LastHistorikkAsync();
        }

        _steg = 4;
    }

    private async Task AvbrytOppdatering()
    {
        if (_gjeldendeHistorikk is not null)
        {
            _gjeldendeHistorikk.Status = "Avbrutt";
            await Db.SaveChangesAsync();
            await LastHistorikkAsync();
        }

        NyOppdatering();
    }

    private void NyOppdatering()
    {
        _steg = 1;
        _leverandor = "";
        _gjelderFraDato = DateTime.Today;
        _feil = null;
        _filnavn = null;
        _kolonner = [];
        _rader = [];
        _radeksempel = null;
        _autoForslag = new();
        _produktkodeKolIndeks = null;
        _gtinKolIndeks = null;
        _prisNettoKolIndeks = null;
        _prisVeiledendeKolIndeks = null;
        _forhandsvisning = [];
        _gjeldendeHistorikk = null;
    }
}
