@page "/drift/meldinger"
@layout PortalItlock.Web.Components.Layout.DriftLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Driftslisens")]
@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Meldinger - Full Kontroll</PageTitle>

<div class="dp-tittelrad">
    <div class="dp-hei">
        <h1>Meldinger</h1>
        <p>Alt som er meldt inn på byggene dine, og hvor langt det har kommet.</p>
    </div>
    <a class="dp-knapp dp-knapp-p dp-kun-pc" href="/drift/meld"><Icon Name="plus" />Meld inn en feil</a>
</div>

<div class="dp-segment">
    <button type="button" class="@(_filter == "apne" ? "aktiv" : "")" @onclick="@(() => _filter = "apne")">Åpne<em hidden="@(Apne == 0)">@Apne</em></button>
    <button type="button" class="@(_filter == "lost" ? "aktiv" : "")" @onclick="@(() => _filter = "lost")">Løst</button>
    <button type="button" class="@(_filter == "alle" ? "aktiv" : "")" @onclick="@(() => _filter = "alle")">Alle</button>
</div>

@if (_lastet && Utvalg.Count == 0)
{
    <div class="dp-kort dp-tom">@(_filter == "apne" ? "Ingen åpne meldinger – alt er i orden." : "Ingen meldinger her ennå.")</div>
}
else
{
    <div class="dp-meldinger">
        @foreach (var s in Utvalg)
        {
            <DriftMeldingRad Status="s" @key="s.Melding.Id" />
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<DriftHelper.MeldingStatus> _meldinger = [];
    private string _filter = "apne";
    private bool _lastet;

    private int Apne => _meldinger.Count(m => m.ErApen);

    private List<DriftHelper.MeldingStatus> Utvalg => _filter switch
    {
        "apne" => _meldinger.Where(m => m.ErApen).ToList(),
        "lost" => _meldinger.Where(m => !m.ErApen).ToList(),
        _ => _meldinger
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bygg = DriftHelper.MineBygg(Db, brukerId);
        _meldinger = await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => bygg.Any(p => p.Id == m.Dor!.ProsjektId)));
        if (Apne == 0 && _meldinger.Count > 0)
        {
            _filter = "alle";
        }
        _lastet = true;
    }
}
