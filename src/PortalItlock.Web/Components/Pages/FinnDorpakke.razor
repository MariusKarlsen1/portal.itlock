@page "/finn-dorpakke"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PackageMatchingService Matcher

<PageTitle>Finn dørpakke</PageTitle>

<h1>Finn dørpakke</h1>
<p>Huk av krav for å se hvilke dørpakker som passer.</p>

<div class="finn-dorpakke-layout">
    <div class="finn-dorpakke-krav">
        <RequirementSelector Dimensions="_dimensions"
                              SelectedValueIds="_selectedValueIds"
                              SelectedValueIdsChanged="OnSelectionChanged" />
    </div>

    <div class="finn-dorpakke-resultat">
        <PackageResultList Packages="_matches"
                            SelectedPackageId="_selectedPackage?.Id"
                            OnSelect="OnPackageSelected" />
    </div>

    <div class="finn-dorpakke-detalj">
        <PackageDetail Package="_selectedPackage" />
    </div>
</div>

@code {
    private List<RequirementDimension> _dimensions = [];
    private HashSet<int> _selectedValueIds = [];
    private List<Package> _matches = [];
    private Package? _selectedPackage;

    protected override async Task OnInitializedAsync()
    {
        _dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        await UpdateMatches();
    }

    private async Task OnSelectionChanged(HashSet<int> selected)
    {
        _selectedValueIds = selected;
        await UpdateMatches();
    }

    private async Task UpdateMatches()
    {
        _matches = await Matcher.FindMatchingPackagesAsync(_selectedValueIds);

        if (_selectedPackage is not null && _matches.All(p => p.Id != _selectedPackage.Id))
        {
            _selectedPackage = null;
        }
    }

    private void OnPackageSelected(int packageId)
    {
        _selectedPackage = _matches.FirstOrDefault(p => p.Id == packageId);
    }
}
