@page "/finn-dorpakke"
@rendermode InteractiveServer
@* Montører kan se og bruke kravvelgeren, men ikke endre dørpakkene selv -
   det gjøres under Oppsett og maler (se ModulRettigheter). *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PackageMatchingService Matcher
@inject VisningPreferanseService VisningPref

<PageTitle>Finn dørpakke</PageTitle>

@* P2c (finn-dorpakke-forslag): samme topp og kort som de andre listene. Kravene
   som nedtrekk (tre per rad) øverst, en oppsummeringslinje med sortering, og
   treffene som kort to og to - «Passer alle krav» og «Nesten». «Vis» åpner
   komponentene i kortet. *@
<div class="fd-side @(_full ? "fd-full" : "")">
    <div class="fd-hode">
        <div class="fd-hode-tittel">
            <span class="fd-hode-ikon"><Icon Name="box" /></span>
            <h1>Finn dørpakke</h1>
        </div>
        <p>Velg kravene til døren &ndash; du ser med en gang hvilke dørpakker som passer, og hvilke som nesten gjør det.</p>
    </div>

    <div class="fd-kort">
        <div class="fd-verktoy">
            <label class="fd-sok">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" placeholder="Søk på dørpakke eller komponent..." />
            </label>
            <AuthorizeView Roles="Admin,Prosjektleder">
                <a class="fd-kn" href="/dorpakker"><Icon Name="list" />Alle dørpakker</a>
                <a class="fd-kn" href="/ny-pakke"><Icon Name="plus" />Ny dørpakke</a>
            </AuthorizeView>
            <button type="button" class="fd-kn fd-kn-ikon" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>
        </div>

        <div class="fd-krav">
            <div class="fd-krav-topp">
                <Icon Name="filter" /><b>Krav</b>
                @if (_valgte.Count > 0)
                {
                    <small>@_valgte.Count valgt</small>
                    <button type="button" class="fd-lenke" @onclick="NullstillAlle">Nullstill</button>
                }
            </div>
            <div class="fd-krav-grid">
                @foreach (var dimensjon in _dimensjoner)
                {
                    var dim = dimensjon;
                    var valgt = dim.Verdier.FirstOrDefault(v => _valgte.Contains(v.Id));
                    <label class="fd-felt">
                        <span>@dim.Navn</span>
                        <span class="fd-velg-wrap">
                            <select class="fd-velg @(valgt is not null ? "paa" : "")" value="@(valgt?.Id.ToString() ?? "")" @onchange="@(e => VelgKrav(dim, e))" aria-label="@dim.Navn">
                                <option value="">Alle</option>
                                @foreach (var verdi in dim.Verdier.OrderBy(v => v.Rekkefolge))
                                {
                                    <option value="@verdi.Id">@verdi.Verdi</option>
                                }
                            </select>
                            @if (valgt is not null)
                            {
                                <button type="button" class="fd-fjern" title="Fjern @dim.Navn" aria-label="Fjern @dim.Navn" @onclick="@(() => FjernKrav(dim))"><Icon Name="x" /></button>
                            }
                        </span>
                    </label>
                }
            </div>
        </div>

        @if (_valgte.Count == 0)
        {
            <div class="fd-tom">
                <Icon Name="box" />
                <span>Velg krav over for å finne dørpakker.</span>
            </div>
        }
        else
        {
            var treff = Sorter(_treff.Where(PasserSok));
            var nesten = Sorter(_nesten.Select(n => n.Pakke).Where(PasserSok));
            <div class="fd-oppsum">
                <b>@treff.Count @(treff.Count == 1 ? "pakke passer" : "pakker passer")</b>
                <span>· @nesten.Count nesten · av @_antallPakker dørpakker</span>
                <select class="fd-velg fd-velg-sort" value="@_sort" @onchange="@(e => _sort = (string)e.Value!)" aria-label="Sortering">
                    <option value="billig">Billigst først</option>
                    <option value="dyr">Dyrest først</option>
                    <option value="navn">Navn</option>
                </select>
            </div>

            <div class="fd-del">Passer alle krav <span>@treff.Count</span></div>
            @if (treff.Count == 0)
            {
                <p class="fd-ingen">Ingen pakke oppfyller alle valgte krav@(nesten.Count > 0 ? " – se de som nesten passer under." : ".")</p>
            }
            else
            {
                <div class="fd-kortgrid">
                    @foreach (var p in treff)
                    {
                        @PakkeKort(p, null)
                    }
                </div>
            }

            @if (nesten.Count > 0)
            {
                <div class="fd-del">Nesten <span>mangler ett krav · @nesten.Count</span></div>
                <div class="fd-kortgrid">
                    @foreach (var p in nesten)
                    {
                        @PakkeKort(p, _nesten.First(n => n.Pakke.Id == p.Id))
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private List<RequirementDimension> _dimensjoner = [];
    private readonly HashSet<int> _valgte = [];
    private List<Package> _treff = [];
    private List<PackageMatchingService.NestenTreff> _nesten = [];
    private Dictionary<int, PackageMatchingService.PakkeKortInfo> _info = [];
    private string _sok = "";
    private string _sort = "billig";
    private int _antallPakker;
    private Package? _valgtPakke;
    private bool _full;

    private RenderFragment PakkeKort(Package p, PackageMatchingService.NestenTreff? nesten) => __builder =>
    {
        var info = _info.GetValueOrDefault(p.Id);
        var apen = _valgtPakke?.Id == p.Id;
        <div class="fd-pk @(apen ? "apen" : "")" @key="p.Id">
            <div class="fd-pk-topp">
                <span class="fd-pk-navn">
                    <b>@p.Navn</b>
                    <small>
                        @(info?.Antall ?? 0) komponent@(info?.Antall == 1 ? "" : "er")@(info is { Komponenter.Count: > 0 } ? " · " + string.Join(", ", info.Komponenter.Take(3)) + (info.Komponenter.Count > 3 ? " …" : "") : "")
                    </small>
                </span>
                <span class="fd-pk-pris">
                    <b>@(info is { SumVeil: > 0 } ? FormatKr(info.SumVeil) : "–")</b>
                    @if (info is { SumNetto: > 0 })
                    {
                        <small>netto @FormatKr(info.SumNetto)</small>
                    }
                </span>
            </div>
            <div class="fd-pk-bunn">
                @foreach (var (verdiId, verdi) in info?.Krav ?? [])
                {
                    var oppfylt = _valgte.Contains(verdiId);
                    <span class="fd-tag @(oppfylt ? "ok" : "")">@if (oppfylt) {<Icon Name="check" />}@verdi</span>
                }
                <span class="fd-pk-hoyre">
                    @if (nesten is null)
                    {
                        <span class="fd-tag ok"><Icon Name="check" />Alle krav</span>
                    }
                    else
                    {
                        <span class="fd-tag mangler">Mangler: @nesten.ManglerDimensjon</span>
                    }
                    <button type="button" class="fd-kn fd-kn-s" @onclick="@(() => VelgPakke(p.Id))"><Icon Name="@(apen ? "chevron-down" : "chevron-right")" />@(apen ? "Lukk" : "Vis")</button>
                </span>
            </div>
            @if (apen && _valgtPakke is not null)
            {
                <div class="fd-pk-detalj">
                    <div class="fd-tabwrap">
                        <table class="fd-tab">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Komponent</th>
                                    <th class="fd-h">Ant.</th>
                                    <th class="fd-h">Netto</th>
                                    <th class="fd-h">Veil.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pc in _valgtPakke.Komponenter)
                                {
                                    <tr>
                                        <td class="fd-mut">@pc.Component?.Type?.Navn</td>
                                        <td><b>@pc.Component?.Navn</b>@if (!string.IsNullOrWhiteSpace(pc.Component?.Produktkode)) {<small>@pc.Component.Produktkode</small>}</td>
                                        <td class="fd-h">@pc.Antall</td>
                                        <td class="fd-h fd-nowrap">@FormatKr(pc.Component?.PrisNetto * pc.Antall)</td>
                                        <td class="fd-h fd-nowrap">@FormatKr(pc.Component?.PrisVeiledende * pc.Antall)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3">Sum &ndash; @_valgtPakke.Komponenter.Count komponent@(_valgtPakke.Komponenter.Count == 1 ? "" : "er")@(ManglerPris > 0 ? $" ({ManglerPris} uten pris)" : "")</td>
                                    <td class="fd-h fd-nowrap">@FormatKr(Sum(pc => pc.Component?.PrisNetto))</td>
                                    <td class="fd-h fd-nowrap">@FormatKr(Sum(pc => pc.Component?.PrisVeiledende))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <AuthorizeView Roles="Admin,Prosjektleder">
                        <div class="fd-pk-handl">
                            <a class="fd-kn fd-kn-s" href="@($"rediger-pakke/{_valgtPakke.Id}")"><Icon Name="edit" />Rediger pakke</a>
                        </div>
                    </AuthorizeView>
                </div>
            }
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("finn-dorpakke-bredde", "normal") == "full";
        _dimensjoner = await Db.RequirementDimensions
            .AsNoTracking()
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();
        _antallPakker = await Db.Packages.CountAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("finn-dorpakke-bredde", _full ? "full" : "normal");
    }

    // Ett valg per krav: nytt valg erstatter det forrige i samme kravgruppe.
    private async Task VelgKrav(RequirementDimension dim, ChangeEventArgs e)
    {
        foreach (var v in dim.Verdier)
        {
            _valgte.Remove(v.Id);
        }
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            _valgte.Add(id);
        }
        await OppdaterTreff();
    }

    private async Task FjernKrav(RequirementDimension dim)
    {
        foreach (var v in dim.Verdier)
        {
            _valgte.Remove(v.Id);
        }
        await OppdaterTreff();
    }

    private bool PasserSok(Package p)
    {
        var sok = _sok.Trim();
        return sok.Length == 0
            || p.Navn.Contains(sok, StringComparison.OrdinalIgnoreCase)
            || (_info.GetValueOrDefault(p.Id)?.Komponenter.Any(k => k.Contains(sok, StringComparison.OrdinalIgnoreCase)) ?? false);
    }

    private List<Package> Sorter(IEnumerable<Package> pakker) => _sort switch
    {
        "dyr" => pakker.OrderByDescending(p => _info.GetValueOrDefault(p.Id)?.SumVeil ?? 0).ToList(),
        "navn" => pakker.OrderBy(p => p.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
        _ => pakker.OrderBy(p => _info.GetValueOrDefault(p.Id)?.SumVeil ?? 0).ToList()
    };

    private async Task NullstillAlle()
    {
        _valgte.Clear();
        await OppdaterTreff();
    }

    private async Task OppdaterTreff()
    {
        _treff = await Matcher.FindMatchingPackagesAsync(_valgte);
        _nesten = await Matcher.FinnNestenTreffAsync(_valgte);
        _info = await Matcher.HentKortInfoAsync(_treff.Select(p => p.Id).Concat(_nesten.Select(n => n.Pakke.Id)).ToList());

        if (_valgtPakke is not null && _treff.All(p => p.Id != _valgtPakke.Id) && _nesten.All(n => n.Pakke.Id != _valgtPakke.Id))
        {
            _valgtPakke = null;
        }
    }

    // Resultatlista er lastet uten komponenter - de hentes her, for den ene
    // pakken man faktisk åpner.
    private async Task VelgPakke(int pakkeId)
    {
        _valgtPakke = _valgtPakke?.Id == pakkeId ? null : await Matcher.HentPakkeMedKomponenterAsync(pakkeId);
    }

    private decimal? Sum(Func<PackageComponent, decimal?> pris)
    {
        var medPris = _valgtPakke?.Komponenter.Where(pc => pris(pc).HasValue).ToList();
        return medPris is null or { Count: 0 } ? null : medPris.Sum(pc => pris(pc)!.Value * pc.Antall);
    }

    private int ManglerPris => _valgtPakke?.Komponenter.Count(pc => pc.Component?.PrisNetto is null) ?? 0;

    private static string FormatKr(decimal? v) => v.HasValue ? v.Value.ToString("N0", Kultur) + " kr" : "–";
}
