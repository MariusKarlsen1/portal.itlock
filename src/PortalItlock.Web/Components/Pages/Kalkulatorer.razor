@page "/kalkulatorer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using PortalItlock.Web.Models

<PageTitle>Kalkulatorer - Full Kontroll</PageTitle>

@* KA1 (Prototype kalkulatorer.html): kalkulatorene samlet i én modul under
   «Prosjekt, service og tilbud», hver som et eget kort med «Åpne». Listen
   hentes fra PortalModulRegister.KalkulatorUndermoduler, så nye kalkulatorer
   legges bare til der. *@
<div class="ka-side">
    <div class="ka-kk">
        <div class="ka-kk-topp">
            <span class="ka-kk-ikon"><Icon Name="receipt" /></span>
            <div class="ka-kk-tittel">
                <div class="ka-kk-sti"><a href="/">Hjem</a> / Prosjekt, service og tilbud / Kalkulatorer</div>
                <h1>Kalkulatorer</h1>
            </div>
        </div>
        <div class="ka-kk-info">
            <span>Kalkulatorer <b>@PortalModulRegister.KalkulatorUndermoduler.Count</b></span>
            <span>Tilgang <b>prosjektleder og admin</b></span>
        </div>

        <div class="ka-innhold">
            <div class="ka-grid">
                @foreach (var k in PortalModulRegister.KalkulatorUndermoduler)
                {
                    <a class="ka-kort" href="@($"/{k.Href}")">
                        <span class="ka-kort-hd"><span class="ka-ik"><Icon Name="@k.IconNavn" /></span><b>@k.Tittel</b></span>
                        <span class="ka-kort-bd">@k.Beskrivelse</span>
                        <span class="ka-kort-ft"><span class="ka-knapp">Åpne ›</span></span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
