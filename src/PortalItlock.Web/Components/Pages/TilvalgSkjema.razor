@page "/tilvalg/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_tilvalg?.Tittel ?? "Tilvalg") - itlock</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke tilvalget. Det kan være slettet.</p>
}
else if (_tilvalg is not null)
{
    <a class="back-link" href="@($"/prosjekter/{_tilvalg.ProsjektId}")">&larr; Tilbake til @(_tilvalg.Prosjekt?.Navn ?? "prosjektet")</a>

    <div class="tilvalg-header">
        <h1>@_tilvalg.Tittel</h1>
        <span class="tilvalg-status tilvalg-status-@_tilvalg.Status">@_tilvalg.Status.Visningsnavn()</span>
    </div>

    @if (_feilmelding is not null)
    {
        <p class="form-error">@_feilmelding</p>
    }

    @if (_tilvalg.Status == TilvalgStatus.Utkast)
    {
        <section class="tilvalg-section">
            <div class="field-grid">
                <label class="span-2">
                    Tittel
                    <input @bind="_tilvalg.Tittel" @bind:event="oninput" placeholder="F.eks. Velg type vrider" />
                </label>
                <label class="span-2">
                    Beskrivelse til kunden
                    <textarea rows="3" @bind="_tilvalg.Beskrivelse" @bind:event="oninput" placeholder="Fritekst kunden ser øverst på tilvalget"></textarea>
                </label>
            </div>
            <button type="button" class="save-button" @onclick="LagreTekst">Lagre</button>
            @if (!string.IsNullOrEmpty(_lagretMelding))
            {
                <span class="save-success">@_lagretMelding</span>
            }
        </section>

        <section class="tilvalg-section">
            <h2>Alternativer</h2>
            @if (_tilvalg.Alternativer.Count == 0)
            {
                <p class="list-empty">Ingen alternativer lagt til ennå.</p>
            }
            else
            {
                <div class="tilvalg-alternativ-liste">
                    @foreach (var alt in _tilvalg.Alternativer.OrderBy(a => a.Rekkefolge))
                    {
                        <div @key="alt.Id" class="tilvalg-alternativ-rad">
                            <div class="tilvalg-alternativ-bilde">
                                @if (alt.BildeData is not null)
                                {
                                    <img src="@($"/tilvalgalternativ/{alt.Id}/bilde")" alt="@alt.Navn" />
                                }
                                else
                                {
                                    <span class="tilvalg-bilde-tom">Ingen bilde</span>
                                }
                                <InputFile OnChange="@(e => LastOppBilde(alt, e))" accept="image/*" />
                            </div>
                            <div class="tilvalg-alternativ-felt">
                                <label>
                                    Navn
                                    <input @bind="alt.Navn" @bind:event="oninput" />
                                </label>
                                <label>
                                    Utførelse
                                    <input @bind="alt.Utforelse" @bind:event="oninput" placeholder="F.eks. Krom, Sort matt" />
                                </label>
                                <label>
                                    Pris (eks. mva)
                                    <input type="number" step="0.01" min="0" @bind="alt.Pris" @bind:event="oninput" />
                                </label>
                            </div>
                            <button type="button" class="remove-button" @onclick="@(() => SlettAlternativ(alt))">Slett</button>
                        </div>
                    }
                </div>
                <button type="button" class="save-button" @onclick="LagreAlternativer">Lagre alternativer</button>
                @if (!string.IsNullOrEmpty(_lagretAlternativerMelding))
                {
                    <span class="save-success">@_lagretAlternativerMelding</span>
                }
            }

            <div class="tilvalg-nytt-alternativ">
                <input @bind="_nyttNavn" @bind:event="oninput" placeholder="Navn på nytt alternativ" />
                <input @bind="_nyUtforelse" @bind:event="oninput" placeholder="Utførelse (f.eks. Krom)" />
                <input type="number" step="0.01" min="0" @bind="_nyPris" placeholder="Pris" />
                <button type="button" class="add-button" @onclick="LeggTilAlternativ">Legg til alternativ</button>
            </div>
        </section>

        <button type="button" class="save-button" @onclick="Publiser">Publiser til kunde</button>
    }
    else if (_tilvalg.Status == TilvalgStatus.Publisert)
    {
        <p class="section-hint">Tilvalget er publisert og venter på svar fra @(_tilvalg.Prosjekt?.Kunde?.Navn ?? "kunden").</p>

        <div class="tilvalg-alternativ-liste tilvalg-alternativ-liste-lesevisning">
            @foreach (var alt in _tilvalg.Alternativer.OrderBy(a => a.Rekkefolge))
            {
                <div @key="alt.Id" class="tilvalg-alternativ-rad tilvalg-alternativ-rad-lesevisning">
                    @if (alt.BildeData is not null)
                    {
                        <img src="@($"/tilvalgalternativ/{alt.Id}/bilde")" alt="@alt.Navn" />
                    }
                    <span>@alt.Navn @(!string.IsNullOrWhiteSpace(alt.Utforelse) ? $"({alt.Utforelse})" : "")</span>
                    <span>@alt.Pris.ToString("N2") kr</span>
                </div>
            }
        </div>

        <div class="tilvalg-knapperad">
            <button type="button" class="cancel-button" @onclick="TilbakeTilUtkast">Tilbake til utkast</button>
            <button type="button" class="delete-button" @onclick="SlettTilvalg">Slett tilvalget</button>
        </div>
    }
    else
    {
        <p class="section-hint">Besvart @(_tilvalg.BesvartDato?.ToString("dd.MM.yyyy HH:mm")) av @_tilvalg.SignertAvNavn.</p>

        <div class="tilvalg-alternativ-liste tilvalg-alternativ-liste-lesevisning">
            @foreach (var alt in _tilvalg.Alternativer.OrderBy(a => a.Rekkefolge))
            {
                <div @key="alt.Id" class="tilvalg-alternativ-rad tilvalg-alternativ-rad-lesevisning @(alt.ValgtAntall > 0 ? "tilvalg-alternativ-valgt" : "")">
                    @if (alt.BildeData is not null)
                    {
                        <img src="@($"/tilvalgalternativ/{alt.Id}/bilde")" alt="@alt.Navn" />
                    }
                    <span>@alt.Navn @(!string.IsNullOrWhiteSpace(alt.Utforelse) ? $"({alt.Utforelse})" : "")</span>
                    <span>@alt.Pris.ToString("N2") kr</span>
                    <span>
                        @if (alt.ValgtAntall > 0)
                        {
                            <strong>Valgt: @alt.ValgtAntall stk - @((alt.Pris * alt.ValgtAntall).ToString("N2")) kr</strong>
                        }
                        else
                        {
                            <span class="tilvalg-ikke-valgt">Ikke valgt</span>
                        }
                    </span>
                </div>
            }
        </div>

        <p class="tilvalg-sum">Totalsum: <strong>@(_tilvalg.SumTotal?.ToString("N2")) kr eks. mva</strong></p>

        @if (!string.IsNullOrWhiteSpace(_tilvalg.KundeOnskeTekst) || _tilvalg.KundeOnskeBildeData is not null)
        {
            <div class="tilvalg-eget-onske">
                <h2>Kundens eget ønske</h2>
                @if (!string.IsNullOrWhiteSpace(_tilvalg.KundeOnskeTekst))
                {
                    <p>@_tilvalg.KundeOnskeTekst</p>
                }
                @if (_tilvalg.KundeOnskeBildeData is not null)
                {
                    <img src="@($"/tilvalg/{_tilvalg.Id}/kundebilde")" alt="Referansebilde fra kunde" class="tilvalg-eget-onske-bilde" />
                }
            </div>
        }

        @if (_tilvalg.Signatur is not null)
        {
            <div class="tilvalg-signatur-visning">
                <p><strong>Signert av:</strong> @_tilvalg.SignertAvNavn</p>
                <img src="@($"data:image/png;base64,{Convert.ToBase64String(_tilvalg.Signatur)}")" alt="Signatur" class="signatur-bilde" />
            </div>
        }

        <button type="button" class="delete-button" @onclick="SlettTilvalg">Slett tilvalget</button>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Tilvalg? _tilvalg;
    private bool _notFound;
    private string? _feilmelding;
    private string? _lagretMelding;
    private string? _lagretAlternativerMelding;
    private string _nyttNavn = "";
    private string _nyUtforelse = "";
    private decimal _nyPris;

    protected override async Task OnParametersSetAsync()
    {
        _tilvalg = await Db.Tilvalg
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(t => t.Alternativer)
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (_tilvalg is null)
        {
            _notFound = true;
            return;
        }

        if (_tilvalg.Status == TilvalgStatus.Besvart && !_tilvalg.LestAvAnsatt)
        {
            _tilvalg.LestAvAnsatt = true;
            await Db.SaveChangesAsync();
        }
    }

    private async Task LagreTekst()
    {
        await Db.SaveChangesAsync();
        _lagretMelding = "Lagret.";
    }

    private async Task LagreAlternativer()
    {
        await Db.SaveChangesAsync();
        _lagretAlternativerMelding = "Lagret.";
    }

    private async Task LeggTilAlternativ()
    {
        if (_tilvalg is null || string.IsNullOrWhiteSpace(_nyttNavn))
        {
            return;
        }

        var alternativ = new TilvalgAlternativ
        {
            TilvalgId = _tilvalg.Id,
            Navn = _nyttNavn.Trim(),
            Utforelse = string.IsNullOrWhiteSpace(_nyUtforelse) ? null : _nyUtforelse.Trim(),
            Pris = _nyPris,
            Rekkefolge = _tilvalg.Alternativer.Count
        };

        Db.TilvalgAlternativer.Add(alternativ);
        await Db.SaveChangesAsync();

        _nyttNavn = "";
        _nyUtforelse = "";
        _nyPris = 0;
    }

    private async Task SlettAlternativ(TilvalgAlternativ alt)
    {
        if (_tilvalg is null)
        {
            return;
        }

        var entitet = await Db.TilvalgAlternativer.FindAsync(alt.Id);
        if (entitet is null)
        {
            return;
        }

        Db.TilvalgAlternativer.Remove(entitet);
        await Db.SaveChangesAsync();
        _tilvalg.Alternativer.Remove(alt);
    }

    private async Task LastOppBilde(TilvalgAlternativ alt, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > 10_000_000)
        {
            _feilmelding = $"\"{file.Name}\" er for stort (maks 10 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entitet = await Db.TilvalgAlternativer.FindAsync(alt.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.BildeData = buffer.ToArray();
        entitet.BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
        await Db.SaveChangesAsync();

        alt.BildeData = entitet.BildeData;
        alt.BildeContentType = entitet.BildeContentType;
        _feilmelding = null;
    }

    private async Task Publiser()
    {
        if (_tilvalg is null)
        {
            return;
        }

        if (_tilvalg.Prosjekt?.KundeId is null)
        {
            _feilmelding = "Prosjektet har ingen kunde koblet til seg ennå. Koble kunde på prosjektet før du kan publisere.";
            return;
        }

        if (_tilvalg.Alternativer.Count == 0)
        {
            _feilmelding = "Legg til minst ett alternativ før du publiserer.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_tilvalg.Tittel))
        {
            _feilmelding = "Tilvalget må ha en tittel.";
            return;
        }

        _feilmelding = null;
        _tilvalg.Status = TilvalgStatus.Publisert;
        _tilvalg.PublisertDato = DateTime.Now;
        await Db.SaveChangesAsync();
    }

    private async Task TilbakeTilUtkast()
    {
        if (_tilvalg is null)
        {
            return;
        }

        _tilvalg.Status = TilvalgStatus.Utkast;
        _tilvalg.PublisertDato = null;
        await Db.SaveChangesAsync();
    }

    private async Task SlettTilvalg()
    {
        if (_tilvalg is null)
        {
            return;
        }

        var prosjektId = _tilvalg.ProsjektId;
        Db.Tilvalg.Remove(_tilvalg);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/prosjekter/{prosjektId}");
    }
}
