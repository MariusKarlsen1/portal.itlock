@page "/arbeidsordre/ferdigmeldte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Ferdigmeldte prosjekter</PageTitle>

<a class="back-link" href="/arbeidsordre">&larr; Tilbake til arbeidsordre</a>
<h1>Ferdigmeldte prosjekter</h1>
<p>Arbeidsordre som er ferdigmeldt, men ikke fakturert ennå. Trykk "Fakturert" her først etter at du har fakturert i Tripletex.</p>

<div class="totalt-rad">
    <p class="totalt-klar">Totalt klar til fakturering: <strong>@FormatKr(_rader.Sum(r => r.VareSum))</strong></p>
    <p class="totalt-klar">Total DG: <strong>@FormatKr(_rader.Sum(r => r.Dg))</strong> (@DgProsentTotalt.ToString("N0", Kultur) %)</p>
</div>
<a class="cancel-button" href="/arbeidsordre/oversikt">Se faktureringsoversikt &rarr;</a>

<input class="sok-felt" @bind="_sok" @bind:event="oninput" placeholder="Søk på kunde, prosjekt eller tittel..." />

@if (_filtrerte.Count == 0)
{
    <p class="list-empty">Ingen ferdigmeldte prosjekter venter på fakturering.</p>
}
else
{
    <table class="ordre-table">
        <thead>
            <tr>
                <th>Tittel</th>
                <th>Prosjekt</th>
                <th>Kunde</th>
                <th>Ansvarlig montør</th>
                <th>Timer</th>
                <th>Sum</th>
                <th>DG</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _filtrerte)
            {
                <tr @key="r.Id">
                    <td>@r.Tittel</td>
                    <td>@(r.ProsjektNavn ?? "-")</td>
                    <td>@(r.KundeNavn ?? "-")</td>
                    <td>@(r.AnsvarligMontorNavn ?? "-")</td>
                    <td class="timer-cell">@r.SumTimer.ToString("N1", Kultur) t</td>
                    <td class="timer-cell">@FormatKr(r.VareSum)</td>
                    <td class="timer-cell">@FormatKr(r.Dg) (@r.DgProsent.ToString("N0", Kultur) %)</td>
                    <td class="ordre-actions">
                        <a class="edit-link" href="@($"/arbeidsordre/{r.Id}")">Åpne</a>
                        @if (_bekrefterId == r.Id)
                        {
                            <span class="bekreft-tekst">Fakturer for @FormatKr(r.VareSum)?</span>
                            <button type="button" class="save-button" @onclick="@(() => MarkerFakturert(r))">Ja, fakturert</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _bekrefterId = null)">Avbryt</button>
                        }
                        else
                        {
                            <button type="button" class="save-button" @onclick="@(() => _bekrefterId = r.Id)">Fakturert</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="save-success">@_melding</p>
}

@code {
    private sealed class OrdreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? KundeNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public decimal SumTimer { get; set; }
        public decimal VareSum { get; set; }
        public decimal VareKost { get; set; }
        public decimal Dg => VareSum - VareKost;
        public decimal DgProsent => VareSum == 0 ? 0 : Dg / VareSum * 100;
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private List<OrdreRad> _rader = [];
    private string _sok = "";
    private string? _melding;
    private int? _bekrefterId;

    private static string FormatKr(decimal verdi) => verdi.ToString("N0", Kultur) + " kr";

    private decimal DgProsentTotalt
    {
        get
        {
            var sum = _rader.Sum(r => r.VareSum);
            return sum == 0 ? 0 : _rader.Sum(r => r.Dg) / sum * 100;
        }
    }

    private List<OrdreRad> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _rader
        : _rader.Where(r =>
            r.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase) ||
            (r.ProsjektNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        var ordre = await Db.Arbeidsordre
            .Where(a => a.Status == ArbeidsordreStatus.Ferdig)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer)
            .Include(a => a.Varer)
            .OrderBy(a => a.Tittel)
            .ToListAsync();

        _rader = ordre.Select(a => new OrdreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNavn = a.Prosjekt?.Navn,
            KundeNavn = a.Prosjekt?.Kunde?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer),
            VareSum = ArbeidsordreBeregningHelper.BeregnVareSum(a),
            VareKost = ArbeidsordreBeregningHelper.BeregnVareKost(a)
        }).ToList();
    }

    private async Task MarkerFakturert(OrdreRad r)
    {
        var ordre = await Db.Arbeidsordre.FirstOrDefaultAsync(a => a.Id == r.Id);
        if (ordre is null)
        {
            return;
        }

        ordre.Status = ArbeidsordreStatus.Fakturert;
        ordre.FakturertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        _bekrefterId = null;
        _melding = $"\"{r.Tittel}\" er markert som fakturert ({FormatKr(r.VareSum)}).";
        await LastAsync();
    }
}
