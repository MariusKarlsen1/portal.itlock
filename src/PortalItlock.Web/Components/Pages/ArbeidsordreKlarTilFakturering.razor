@page "/arbeidsordre/ferdigmeldte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Ferdigmeldte ordrer</PageTitle>

@* F13 (fakturering-forslag.html): ett kort med varsel om det som har ventet over
   30 dager, nøkkeltall i én ramme, alder som merke (grønn/gul/rød), rød kant på
   det som har ventet lenge og montørens anbefalinger under tittelen. *@
<div class="fm-kort @(_full ? "fm-full" : "")">
    <button type="button" class="fm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>
    <div class="fm-topp">
        <a class="fm-tilbake" href="/arbeidsordre">&larr; Tilbake til arbeidsordre</a>
        <h1>Ferdigmeldte ordrer</h1>
        <p>Ferdigmeldt, men ikke fakturert. Trykk &laquo;Fakturert&raquo; først etter at du har fakturert i Tripletex.</p>
    </div>

    @if (AntallOver30 > 0)
    {
        <div class="fm-varsel">
            <span class="fm-varsel-ikon"><Icon Name="alert-triangle" /></span>
            <span><b>@AntallOver30 @(AntallOver30 == 1 ? "ordre" : "ordrer") for @FormatKr(SumOver30)</b> har ventet over 30 dager på fakturering.</span>
            <button type="button" class="fm-kn fm-kn-s" @onclick="@(() => { _kunOver30 = !_kunOver30; _side = 1; })">@(_kunOver30 ? "Vis alle" : "Vis")</button>
        </div>
    }

    @if (_rader.Count > 0)
    {
        <div class="fm-kpi">
            <div class="fm-kpi-hoved">
                <span class="fm-lbl">Klar til fakturering</span>
                <b>@FormatKr(_rader.Sum(r => r.VareSum))</b>
                <small>@_rader.Count @(_rader.Count == 1 ? "ordre" : "ordrer")</small>
            </div>
            <div>
                <span class="fm-lbl">Dekningsbidrag</span>
                <b>@FormatKr(_rader.Sum(r => r.Dg))</b>
                <small>@DgProsentTotalt.ToString("N0", Kultur) % DG</small>
            </div>
            <div>
                <span class="fm-lbl">Venter over 30 dager</span>
                <b class="@(AntallOver30 > 0 ? "fm-rod" : "")">@AntallOver30 @(AntallOver30 == 1 ? "ordre" : "ordrer")</b>
                <small>@FormatKr(SumOver30)</small>
            </div>
            <div>
                <span class="fm-lbl">Venter lengst</span>
                <b>@(EldsteDager is int d ? $"{d} dager" : "–")</b>
                <small>@(EldsteRad?.Tittel ?? "siden ferdigmelding")</small>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="fm-melding">@_melding</p>
    }

    <div class="fm-verktoy">
        <label class="fm-sok">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" @bind:after="@(() => _side = 1)" placeholder="Søk på ordre, kunde eller prosjekt..." />
        </label>
        @if (_kunOver30)
        {
            <button type="button" class="fm-chip" @onclick="@(() => { _kunOver30 = false; _side = 1; })">Over 30 dager &times;</button>
        }
        <select class="fm-velg" title="Antall ordrer per side" value="@_perSide" @onchange="@(e => { _perSide = int.Parse((string)e.Value!); _side = 1; })">
            <option value="10">10 per side</option>
            <option value="15">15 per side</option>
            <option value="20">20 per side</option>
        </select>
    </div>

    @if (_filtrerte.Count == 0)
    {
        <p class="list-empty">Ingen ferdigmeldte ordrer venter på fakturering.</p>
    }
    else
    {
        <div class="fm-tabwrap">
            <table class="fm-tab">
                <thead>
                    <tr>
                        <th @onclick='@(() => SorterPa("Tittel"))'>Ordre@(SortPil("Tittel"))</th>
                        <th @onclick='@(() => SorterPa("Kunde"))'>Kunde@(SortPil("Kunde"))</th>
                        <th @onclick='@(() => SorterPa("Montor"))'>Montør@(SortPil("Montor"))</th>
                        <th @onclick='@(() => SorterPa("Dato"))'>Venter@(SortPil("Dato"))</th>
                        <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><th @onclick='@(() => SorterPa("Timer"))' class="fm-h">Timer@(SortPil("Timer"))</th></HvisModul>
                        <th @onclick='@(() => SorterPa("Belop"))' class="fm-h">Sum · DG@(SortPil("Belop"))</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _filtrerte.Skip((GjeldendeSide - 1) * _perSide).Take(_perSide))
                    {
                        var dager = DagerSiden(r);
                        <tr @key="r.Id" class="@(dager > 30 ? "fm-lenge" : "")">
                            <td>
                                <b>@r.Tittel</b>
                                <span class="fm-sub">@(r.ProsjektNavn ?? "Uten prosjekt")</span>
                                @if (!string.IsNullOrWhiteSpace(r.Notat))
                                {
                                    <span class="fm-notat" title="@r.Notat">💬 @Kort(r.Notat)</span>
                                }
                            </td>
                            <td>@(r.KundeNavn ?? "–")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                                {
                                    <span class="fm-montor">
                                        <span class="fm-avatar" style="background:@MontorFarge(r.AnsvarligMontorNavn)">@MontorInitialer(r.AnsvarligMontorNavn)</span>
                                        @r.AnsvarligMontorNavn
                                    </span>
                                }
                                else
                                {
                                    <text>–</text>
                                }
                            </td>
                            <td>
                                <span class="fm-alder @AlderKlasse(dager)" title="Ferdigmeldt @(r.FullfortDato?.ToLocalTime().ToString("dd.MM.yyyy") ?? "-")">@AlderTekst(dager)</span>
                            </td>
                            <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><td class="fm-h">@r.SumTimer.ToString("N1", Kultur) t</td></HvisModul>
                            <td class="fm-h"><b>@FormatKr(r.VareSum)</b><span class="fm-dg">@r.DgProsent.ToString("N0", Kultur) %</span></td>
                            <td class="fm-h">
                                <div class="fm-handl">
                                    @if (_bekrefterId == r.Id)
                                    {
                                        <span class="fm-bekreft">Fakturert i Tripletex?</span>
                                        <button type="button" class="fm-kn fm-kn-s fm-kn-g" @onclick="@(() => MarkerFakturert(r))">Ja, fakturert</button>
                                        <button type="button" class="fm-kn fm-kn-s" @onclick="@(() => _bekrefterId = null)">Avbryt</button>
                                    }
                                    else
                                    {
                                        <a class="fm-kn fm-kn-s" href="@($"/arbeidsordre/{r.Id}")">Åpne</a>
                                        <button type="button" class="fm-kn fm-kn-s fm-kn-p" @onclick="@(() => _bekrefterId = r.Id)">✓ Fakturert</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Sum &ndash; @_filtrerte.Count @(_filtrerte.Count == 1 ? "ordre" : "ordrer")</td>
                        <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><td class="fm-h">@_filtrerte.Sum(r => r.SumTimer).ToString("N1", Kultur) t</td></HvisModul>
                        <td class="fm-h">@FormatKr(_filtrerte.Sum(r => r.VareSum))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @Sidevelger()
    }
</div>

@code {
    private sealed class OrdreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? KundeNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public DateTime? FullfortDato { get; set; }
        public string? Notat { get; set; }
        public decimal SumTimer { get; set; }
        public decimal VareSum { get; set; }
        public decimal VareKost { get; set; }
        public decimal Dg => VareSum - VareKost;
        public decimal DgProsent => VareSum == 0 ? 0 : Dg / VareSum * 100;
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] MontorPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<OrdreRad> _rader = [];
    private string _sok = "";
    private string? _melding;
    private int? _bekrefterId;
    private bool _kunOver30;
    private string _sortFelt = "Dato";
    private bool _sortSynkende;
    private int _perSide = 10;
    private int _side = 1;

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(_filtrerte.Count / (double)_perSide));
    private int GjeldendeSide => Math.Clamp(_side, 1, AntallSider);

    private RenderFragment Sidevelger() =>
        @<div class="side-navigasjon">
            <span>Viser @((GjeldendeSide - 1) * _perSide + 1)–@Math.Min(GjeldendeSide * _perSide, _filtrerte.Count) av @_filtrerte.Count</span>
            @if (AntallSider > 1)
            {
                <div class="side-knapper">
                    <button type="button" disabled="@(GjeldendeSide == 1)" @onclick="@(() => _side = GjeldendeSide - 1)">&lsaquo;</button>
                    @for (var i = 1; i <= AntallSider; i++)
                    {
                        var nr = i;
                        <button type="button" class="@(nr == GjeldendeSide ? "aktiv" : "")" @onclick="@(() => _side = nr)">@nr</button>
                    }
                    <button type="button" disabled="@(GjeldendeSide == AntallSider)" @onclick="@(() => _side = GjeldendeSide + 1)">&rsaquo;</button>
                </div>
            }
        </div>;

    private static string FormatKr(decimal verdi) => verdi.ToString("N0", Kultur) + " kr";

    private static int? DagerSiden(OrdreRad r) => r.FullfortDato is { } d ? (DateTime.Today - d.ToLocalTime().Date).Days : null;

    private static string AlderKlasse(int? dager) => dager switch
    {
        > 30 => "rod",
        > 7 => "gul",
        _ => "gronn"
    };

    private static string AlderTekst(int? dager) => dager switch
    {
        null => "–",
        0 => "I dag",
        1 => "I går",
        _ => $"{dager} dager"
    };

    private static string Kort(string tekst)
    {
        var t = tekst.ReplaceLineEndings(" ").Trim();
        return t.Length <= 90 ? t : t[..87].TrimEnd() + "...";
    }

    private int? EldsteDager => _rader.Select(DagerSiden).Where(d => d.HasValue).Max();

    private OrdreRad? EldsteRad => _rader.Where(r => r.FullfortDato.HasValue).OrderBy(r => r.FullfortDato).FirstOrDefault();

    private int AntallOver30 => _rader.Count(r => DagerSiden(r) > 30);

    private decimal SumOver30 => _rader.Where(r => DagerSiden(r) > 30).Sum(r => r.VareSum);

    private decimal DgProsentTotalt
    {
        get
        {
            var sum = _rader.Sum(r => r.VareSum);
            return sum == 0 ? 0 : _rader.Sum(r => r.Dg) / sum * 100;
        }
    }

    private List<OrdreRad> _filtrerte
    {
        get
        {
            IEnumerable<OrdreRad> rader = _rader;
            if (_kunOver30)
            {
                rader = rader.Where(r => DagerSiden(r) > 30);
            }
            if (!string.IsNullOrWhiteSpace(_sok))
            {
                rader = rader.Where(r =>
                    r.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase) ||
                    (r.ProsjektNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            IEnumerable<OrdreRad> sortert = _sortFelt switch
            {
                "Tittel" => rader.OrderBy(r => r.Tittel, StringComparer.OrdinalIgnoreCase),
                "Prosjekt" => rader.OrderBy(r => r.ProsjektNavn, StringComparer.OrdinalIgnoreCase),
                "Kunde" => rader.OrderBy(r => r.KundeNavn, StringComparer.OrdinalIgnoreCase),
                "Montor" => rader.OrderBy(r => r.AnsvarligMontorNavn, StringComparer.OrdinalIgnoreCase),
                "Timer" => rader.OrderBy(r => r.SumTimer),
                "Belop" => rader.OrderBy(r => r.VareSum),
                "Dg" => rader.OrderBy(r => r.Dg),
                _ => rader.OrderBy(r => r.FullfortDato)
            };

            return (_sortSynkende ? sortert.Reverse() : sortert).ToList();
        }
    }

    private void SorterPa(string felt)
    {
        if (_sortFelt == felt)
        {
            _sortSynkende = !_sortSynkende;
        }
        else
        {
            _sortFelt = felt;
            _sortSynkende = felt is "Timer" or "Belop" or "Dg";
        }
        _side = 1;
    }

    private string SortPil(string felt) => _sortFelt != felt ? "" : (_sortSynkende ? " ↓" : " ↑");

    private static string MontorFarge(string navn) => MontorPaletten[Math.Abs(navn.GetHashCode()) % MontorPaletten.Length];

    private static string MontorInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    // "Utvid"-knappen øverst i kortet - samme som på tilbud og prosjekt, lagres per bruker.
    private bool _full;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("ferdigmeldte-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("ferdigmeldte-bredde", "normal") == "full";
        await LastAsync();
    }

    private async Task LastAsync()
    {
        var ordre = await Db.Arbeidsordre
            .Where(a => a.Status == ArbeidsordreStatus.Ferdig)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer)
            .Include(a => a.Varer)
            .OrderBy(a => a.Tittel)
            .ToListAsync();

        _rader = ordre.Select(a => new OrdreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNavn = a.Prosjekt?.Navn,
            KundeNavn = a.Prosjekt?.Kunde?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            FullfortDato = a.FullfortDato,
            Notat = a.Anbefalinger,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer),
            VareSum = ArbeidsordreBeregningHelper.BeregnVareSum(a),
            VareKost = ArbeidsordreBeregningHelper.BeregnVareKost(a)
        }).ToList();
    }

    private async Task MarkerFakturert(OrdreRad r)
    {
        var ordre = await Db.Arbeidsordre.FirstOrDefaultAsync(a => a.Id == r.Id);
        if (ordre is null)
        {
            return;
        }

        ordre.Status = ArbeidsordreStatus.Fakturert;
        ordre.FakturertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        _bekrefterId = null;
        _melding = $"\"{r.Tittel}\" er markert som fakturert ({FormatKr(r.VareSum)}).";
        await LastAsync();
    }
}
