@page "/arbeidsordre/fakturert"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Fakturerte ordrer</PageTitle>

@* K2 (fakturering-forslag.html): ett kort med nøkkeltall i én ramme, søylediagram
   per måned som filter, nedtrekk for år og antall per side, tabell med sumrad
   og utvid-knapp som på tilbud og ferdigmeldte ordrer. *@
<div class="fm-kort @(_full ? "fm-full" : "")">
    <button type="button" class="fm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>
    <div class="fm-topp">
        <a class="fm-tilbake" href="/arbeidsordre">&larr; Tilbake til arbeidsordre</a>
        <h1>Fakturerte ordrer</h1>
        <p>Arkiv over fakturerte arbeidsordrer &ndash; beløp, timer og hvem som gjorde jobben.</p>
    </div>

    @if (_rader.Count > 0)
    {
        <div class="fm-kpi">
            <div class="fm-kpi-hoved">
                <span class="fm-lbl">Fakturert i år</span>
                <b>@FormatKr(FakturertIAr)</b>
                <small>@AntallIAr @(AntallIAr == 1 ? "ordre" : "ordrer")</small>
            </div>
            <div>
                <span class="fm-lbl">Denne måneden</span>
                <b>@FormatKr(DenneManeden)</b>
                <small class="@(TrendProsent < 0 ? "fm-ned" : "fm-opp")">@(TrendProsent < 0 ? "▼" : "▲") @Math.Abs(TrendProsent).ToString("0") % mot forrige måned</small>
            </div>
            <div>
                <span class="fm-lbl">Snitt per ordre i år</span>
                <b>@FormatKr(SnittBelopIAr)</b>
                <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><small>@SnittTimerIAr.ToString("N1", Kultur) t i snitt</small></HvisModul>
            </div>
            <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer">
            <div>
                <span class="fm-lbl">Timer fakturert i år</span>
                <b>@TimerIAr.ToString("N1", Kultur) t</b>
                <small>på @AntallIAr @(AntallIAr == 1 ? "ordre" : "ordrer")</small>
            </div>
            </HvisModul>
        </div>

        <div class="fm-graf-boks">
            <span class="fm-lbl">Fakturert per måned · @(_ar is int a ? a.ToString() : "siste 12 måneder")</span>
            <div class="fm-graf">
                @{ var maks = Maneder.Max(m => m.Sum); }
                @foreach (var m in Maneder)
                {
                    var valgt = _maned == m.Nokkel;
                    <button type="button" class="fm-soyle @(valgt ? "valgt" : "") @(m.ErNa ? "na" : "")" title="@m.Navn: @FormatKr(m.Sum) · @m.Antall @(m.Antall == 1 ? "ordre" : "ordrer")"
                            @onclick="@(() => { _maned = valgt ? null : m.Nokkel; _side = 1; })">
                        <span class="fm-soyle-tall">@(m.Sum == 0 ? "" : KortKr(m.Sum))</span>
                        <i style="height:@(maks == 0 ? 0 : Math.Max(2, (int)Math.Round(m.Sum / maks * 90)))px"></i>
                        <span class="fm-soyle-mnd">@m.Kort</span>
                    </button>
                }
            </div>
        </div>
    }

    <div class="fm-verktoy">
        <label class="fm-sok">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" @bind:after="@(() => _side = 1)" placeholder="Søk på ordre, kunde, prosjekt eller montør..." />
        </label>
        @if (_maned is not null)
        {
            <button type="button" class="fm-chip" @onclick="@(() => { _maned = null; _side = 1; })">@ManedNavn(_maned) &times;</button>
        }
        <select class="fm-velg" title="Velg år" value="@(_ar?.ToString() ?? "alle")" @onchange="VelgAr">
            <option value="alle">Alle år</option>
            @foreach (var ar in Ar)
            {
                <option value="@ar">@ar</option>
            }
        </select>
        <select class="fm-velg" title="Antall ordrer per side" value="@_perSide" @onchange="@(e => { _perSide = int.Parse((string)e.Value!); _side = 1; })">
            <option value="10">10 per side</option>
            <option value="15">15 per side</option>
            <option value="20">20 per side</option>
        </select>
    </div>

    @if (_filtrerte.Count == 0)
    {
        <p class="list-empty">Ingen fakturerte ordrer funnet.</p>
    }
    else
    {
        <div class="fm-tabwrap">
            <table class="fm-tab">
                <thead>
                    <tr>
                        <th @onclick='@(() => SorterPa("Tittel"))'>Ordre@(SortPil("Tittel"))</th>
                        <th @onclick='@(() => SorterPa("Kunde"))'>Kunde@(SortPil("Kunde"))</th>
                        <th @onclick='@(() => SorterPa("Montor"))'>Montør@(SortPil("Montor"))</th>
                        <th @onclick='@(() => SorterPa("Dato"))'>Fakturert@(SortPil("Dato"))</th>
                        <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><th @onclick='@(() => SorterPa("Timer"))' class="fm-h">Timer@(SortPil("Timer"))</th></HvisModul>
                        <th @onclick='@(() => SorterPa("Belop"))' class="fm-h">Beløp@(SortPil("Belop"))</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _filtrerte.Skip((GjeldendeSide - 1) * _perSide).Take(_perSide))
                    {
                        <tr @key="r.Id">
                            <td>
                                <b>@r.Tittel</b>
                                <span class="fm-sub">@(r.ProsjektNavn ?? "Uten prosjekt")</span>
                            </td>
                            <td>@(r.KundeNavn ?? "–")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                                {
                                    <span class="fm-montor">
                                        <span class="fm-avatar" style="background:@MontorFarge(r.AnsvarligMontorNavn)">@MontorInitialer(r.AnsvarligMontorNavn)</span>
                                        @r.AnsvarligMontorNavn
                                    </span>
                                }
                                else
                                {
                                    <text>–</text>
                                }
                            </td>
                            <td>@(r.FakturertDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                            <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><td class="fm-h">@r.SumTimer.ToString("N1", Kultur) t</td></HvisModul>
                            <td class="fm-h"><b>@FormatKr(r.Belop)</b></td>
                            <td class="fm-h"><a class="fm-kn fm-kn-s" href="@($"/arbeidsordre/{r.Id}")">Åpne</a></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Sum &ndash; @_filtrerte.Count @(_filtrerte.Count == 1 ? "ordre" : "ordrer")@(_maned is not null ? $" i {ManedNavn(_maned).ToLowerInvariant()}" : _ar is int valgtAr ? $" i {valgtAr}" : "")</td>
                        <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><td class="fm-h">@_filtrerte.Sum(r => r.SumTimer).ToString("N1", Kultur) t</td></HvisModul>
                        <td class="fm-h">@FormatKr(_filtrerte.Sum(r => r.Belop))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @Sidevelger()
    }
</div>

@code {
    private sealed class OrdreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? KundeNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public DateTime? FakturertDato { get; set; }
        public decimal SumTimer { get; set; }
        public decimal Belop { get; set; }
    }

    private sealed record Maned(string Nokkel, string Navn, string Kort, decimal Sum, int Antall, bool ErNa);

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] MontorPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<OrdreRad> _rader = [];
    private string _sok = "";
    private int? _ar = DateTime.Today.Year;
    private string? _maned;
    private string _sortFelt = "Dato";
    private bool _sortSynkende = true;
    private int _perSide = 10;
    private int _side = 1;
    private bool _full;

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(_filtrerte.Count / (double)_perSide));
    private int GjeldendeSide => Math.Clamp(_side, 1, AntallSider);

    private RenderFragment Sidevelger() =>
        @<div class="side-navigasjon">
            <span>Viser @((GjeldendeSide - 1) * _perSide + 1)–@Math.Min(GjeldendeSide * _perSide, _filtrerte.Count) av @_filtrerte.Count</span>
            @if (AntallSider > 1)
            {
                <div class="side-knapper">
                    <button type="button" disabled="@(GjeldendeSide == 1)" @onclick="@(() => _side = GjeldendeSide - 1)">&lsaquo;</button>
                    @for (var i = 1; i <= AntallSider; i++)
                    {
                        var nr = i;
                        <button type="button" class="@(nr == GjeldendeSide ? "aktiv" : "")" @onclick="@(() => _side = nr)">@nr</button>
                    }
                    <button type="button" disabled="@(GjeldendeSide == AntallSider)" @onclick="@(() => _side = GjeldendeSide + 1)">&rsaquo;</button>
                </div>
            }
        </div>;

    private decimal FakturertIAr { get; set; }
    private int AntallIAr { get; set; }
    private decimal SnittBelopIAr { get; set; }
    private decimal SnittTimerIAr { get; set; }
    private decimal TimerIAr { get; set; }
    private decimal DenneManeden { get; set; }
    private decimal ForrigeManeden { get; set; }
    private double TrendProsent { get; set; }

    // Årene det finnes fakturerte ordrer i, nyeste først (alltid med inneværende år).
    private List<int> Ar => _rader.Where(r => r.FakturertDato.HasValue).Select(r => r.FakturertDato!.Value.Year)
        .Append(DateTime.Today.Year).Distinct().OrderByDescending(a => a).ToList();

    private static string ManedNokkel(DateTime d) => $"{d.Year}-{d.Month:00}";

    private static string ManedNavn(string nokkel)
    {
        var d = DateTime.ParseExact(nokkel + "-01", "yyyy-MM-dd", Kultur);
        var navn = d.ToString("MMMM yyyy", Kultur);
        return char.ToUpper(navn[0]) + navn[1..];
    }

    // Søylene: alle månedene i valgt år, eller de siste 12 månedene når "Alle år" er valgt.
    private List<Maned> Maneder
    {
        get
        {
            var na = DateTime.Today;
            var start = _ar is int a ? new DateTime(a, 1, 1) : new DateTime(na.Year, na.Month, 1).AddMonths(-11);
            return Enumerable.Range(0, 12).Select(i =>
            {
                var d = start.AddMonths(i);
                var nokkel = ManedNokkel(d);
                var iManed = _rader.Where(r => r.FakturertDato.HasValue && ManedNokkel(r.FakturertDato.Value) == nokkel).ToList();
                return new Maned(nokkel, d.ToString("MMMM yyyy", Kultur), d.ToString("MMM", Kultur).TrimEnd('.'),
                    iManed.Sum(r => r.Belop), iManed.Count, d.Year == na.Year && d.Month == na.Month);
            }).ToList();
        }
    }

    private List<OrdreRad> _filtrerte
    {
        get
        {
            IEnumerable<OrdreRad> rader = _rader;
            if (_maned is not null)
            {
                rader = rader.Where(r => r.FakturertDato.HasValue && ManedNokkel(r.FakturertDato.Value) == _maned);
            }
            else if (_ar is int ar)
            {
                rader = rader.Where(r => r.FakturertDato.HasValue && r.FakturertDato.Value.Year == ar);
            }

            if (!string.IsNullOrWhiteSpace(_sok))
            {
                rader = rader.Where(r =>
                    r.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase) ||
                    (r.ProsjektNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.AnsvarligMontorNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            IEnumerable<OrdreRad> sortert = _sortFelt switch
            {
                "Tittel" => rader.OrderBy(r => r.Tittel, StringComparer.OrdinalIgnoreCase),
                "Prosjekt" => rader.OrderBy(r => r.ProsjektNavn, StringComparer.OrdinalIgnoreCase),
                "Kunde" => rader.OrderBy(r => r.KundeNavn, StringComparer.OrdinalIgnoreCase),
                "Montor" => rader.OrderBy(r => r.AnsvarligMontorNavn, StringComparer.OrdinalIgnoreCase),
                "Timer" => rader.OrderBy(r => r.SumTimer),
                "Belop" => rader.OrderBy(r => r.Belop),
                _ => rader.OrderBy(r => r.FakturertDato)
            };

            return (_sortSynkende ? sortert.Reverse() : sortert).ToList();
        }
    }

    private void VelgAr(ChangeEventArgs e)
    {
        var verdi = (string)e.Value!;
        _ar = verdi == "alle" ? null : int.Parse(verdi);
        _maned = null;
        _side = 1;
    }

    private void SorterPa(string felt)
    {
        if (_sortFelt == felt)
        {
            _sortSynkende = !_sortSynkende;
        }
        else
        {
            _sortFelt = felt;
            _sortSynkende = felt is "Dato" or "Timer" or "Belop";
        }
        _side = 1;
    }

    private string SortPil(string felt) => _sortFelt != felt ? "" : (_sortSynkende ? " ↓" : " ↑");

    private static string FormatKr(decimal verdi) => verdi.ToString("N0", Kultur) + " kr";

    // Kort beløp over søylene: 12 400 kr -> 12k, 1 250 000 kr -> 1,3 mill.
    private static string KortKr(decimal verdi) => verdi >= 1_000_000m
        ? (verdi / 1_000_000m).ToString("0.#", Kultur) + " mill"
        : verdi >= 1000m ? (verdi / 1000m).ToString("0", Kultur) + "k" : verdi.ToString("0", Kultur);

    private static string MontorFarge(string navn) => MontorPaletten[Math.Abs(navn.GetHashCode()) % MontorPaletten.Length];

    private static string MontorInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    // "Utvid"-knappen øverst i kortet - samme som på tilbud og ferdigmeldte, lagres per bruker.
    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("fakturerte-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("fakturerte-bredde", "normal") == "full";

        var ordre = await Db.Arbeidsordre
            .Where(a => a.Status == ArbeidsordreStatus.Fakturert)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .Include(a => a.KodeLinjer)
            .Include(a => a.Tilbud!).ThenInclude(t => t.Linjer)
            .Include(a => a.Varer)
            .OrderByDescending(a => a.FakturertDato)
            .ToListAsync();

        _rader = ordre.Select(a => new OrdreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNavn = a.Prosjekt?.Navn,
            KundeNavn = a.Prosjekt?.Kunde?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            FakturertDato = a.FakturertDato,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer),
            Belop = ArbeidsordreBeregningHelper.BeregnVareSum(a)
        }).ToList();

        var naDato = DateTime.Today;
        var iAr = _rader.Where(r => r.FakturertDato.HasValue && r.FakturertDato.Value.Year == naDato.Year).ToList();
        FakturertIAr = iAr.Sum(r => r.Belop);
        AntallIAr = iAr.Count;
        TimerIAr = iAr.Sum(r => r.SumTimer);
        SnittBelopIAr = AntallIAr > 0 ? FakturertIAr / AntallIAr : 0;
        SnittTimerIAr = AntallIAr > 0 ? TimerIAr / AntallIAr : 0;

        DenneManeden = _rader.Where(r => r.FakturertDato.HasValue && r.FakturertDato.Value.Year == naDato.Year && r.FakturertDato.Value.Month == naDato.Month).Sum(r => r.Belop);
        var forrigeManedDato = naDato.AddMonths(-1);
        ForrigeManeden = _rader.Where(r => r.FakturertDato.HasValue && r.FakturertDato.Value.Year == forrigeManedDato.Year && r.FakturertDato.Value.Month == forrigeManedDato.Month).Sum(r => r.Belop);
        TrendProsent = ForrigeManeden > 0
            ? (double)((DenneManeden - ForrigeManeden) / ForrigeManeden * 100m)
            : (DenneManeden > 0 ? 100.0 : 0.0);
    }
}
