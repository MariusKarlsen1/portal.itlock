@page "/"
@rendermode InteractiveServer

<PageTitle>Itlock Full Kontroll</PageTitle>

<div class="home-hero">
    <h1>Itlock Full Kontroll</h1>
    <p class="home-lede">
        Internt verktøy for prosjektering, befaring og det daglige arbeidet med dørpakker,
        komponenter og krav. Velg hvem du er, så finner du raskt det du trenger.
    </p>
</div>

<div class="role-grid">
    @foreach (var rolle in Roller)
    {
        <button type="button"
                class="role-card @(_valgtRolle == rolle.Nokkel ? "role-card-active" : "")"
                @onclick="@(() => VelgRolle(rolle.Nokkel))">
            <span class="role-card-title">@rolle.Tittel</span>
            <span class="role-card-desc">@rolle.Beskrivelse</span>
        </button>
    }
</div>

@if (_valgtRolle is not null)
{
    var valgt = Roller.First(r => r.Nokkel == _valgtRolle);

    <div class="home-links">
        @foreach (var link in valgt.Lenker)
        {
            <a class="home-card" href="@link.Href">
                <span class="home-card-title">@link.Tittel</span>
                <span class="home-card-desc">@link.Beskrivelse</span>
            </a>
        }
    </div>
}

<p class="home-footer">Laget av Marius Karlsen, itlock AS</p>

@code {
    private sealed record Lenke(string Tittel, string Beskrivelse, string Href);
    private sealed record Rolle(string Nokkel, string Tittel, string Beskrivelse, List<Lenke> Lenker);

    private string? _valgtRolle;

    private void VelgRolle(string nokkel)
    {
        _valgtRolle = _valgtRolle == nokkel ? null : nokkel;
    }

    private static readonly List<Rolle> Roller =
    [
        new Rolle(
            "montorer",
            "For montører",
            "Guide, befaring og vedlegg til bruk i felt",
            [
                new Lenke("Befaringsliste", "Sjekkliste og notater fra befaring", "befaringsliste"),
                new Lenke("Utskiftning av lås", "Sjekkliste med mål på dør, karm og hengsling", "lasutskifting"),
                new Lenke("Dørmiljø", "Tegninger til bruk på befaring og i prosjektering", "dormiljo"),
                new Lenke("Kobling", "Guide for kobling", "guide/kobling"),
                new Lenke("Oppsett adgangskontroll", "Guide for oppsett av adgangskontroll", "guide/oppsett-adgangskontroll"),
                new Lenke("Arbeidsordre", "Se arbeidsordre med info om jobben og ansvarlig montør", "arbeidsordre"),
                new Lenke("Timeregistrering", "Registrer timer på en arbeidsordre", "timeregistrering"),
            ]),
        new Rolle(
            "prosjektledere",
            "For prosjektledere",
            "Systemer, prosjektering og prosjekter",
            [
                new Lenke("Prosjekter", "Dører, plantegninger og montasjestatus per prosjekt", "prosjekter"),
                new Lenke("Finn dørpakke", "Huk av krav og finn riktig dørpakke til prosjektet", "finn-dorpakke"),
                new Lenke("Prisoverslag", "Rask kalkulator med komponenter, timer og påslag", "prisoverslag"),
                new Lenke("Systemregister", "Søk opp låssystem, kunde, adresse og rekvirenter", "systemregister"),
            ]),
        new Rolle(
            "admin",
            "For admin",
            "Opprett og vedlikehold grunnlagsdata",
            [
                new Lenke("Ny pakke", "Sett sammen en ny dørpakke, eller rediger en eksisterende", "ny-pakke"),
                new Lenke("Kravdimensjoner", "Vedlikehold kravkategoriene kravvelgeren bygger på", "kravdimensjoner"),
                new Lenke("Dørfunksjoner", "Opprett og vedlikehold dørfunksjoner som kan legges på dører", "dorfunksjoner"),
                new Lenke("Komponentregister", "Søk, prissett og administrer komponenter og leverandører", "komponenter"),
                new Lenke("Arbeidsordre", "Opprett arbeidsordre med info om jobben og ansvarlig montør", "arbeidsordre"),
                new Lenke("Montører", "Opprett og vedlikehold listen over montører", "montorer"),
                new Lenke("Kunder", "Opprett og vedlikehold kunderegisteret", "kunder"),
                new Lenke("Timeoversikt", "Sammendrag og eksport av timer til lønn", "timeoversikt"),
            ]),
    ];
}
