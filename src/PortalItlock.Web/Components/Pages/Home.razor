@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject PortalItlock.Web.Services.GeocodingService Geokoding
@inject IJSRuntime JS

<PageTitle>Full Kontroll</PageTitle>

<div class="home-page @(AktivLayout == HjemLayout.Dashboard3 ? "home-page-dash3" : "")">

    @if (_visNyhet && _sisteNyhet is not null)
    {
        <div class="nyhet-banner">
            <span class="nyhet-banner-ikon"><Icon Name="bell" /></span>
            <div class="nyhet-banner-innhold">
                <strong>@_sisteNyhet.Tittel</strong>
                <p>@_sisteNyhet.Innhold</p>
            </div>
            <button type="button" class="nyhet-banner-lukk" @onclick="LukkNyhet" aria-label="Lukk"><Icon Name="x" /></button>
        </div>
    }

    @if (AktivLayout == HjemLayout.Dashboard3)
    {
        <div class="hd3-greetrow">
            <div>
                <div class="hd3-greet-date">@Idag</div>
                <h1 class="hd3-greet-h1">@Hilsen</h1>
                <p class="hd3-greet-sub">@HeroSetning</p>
            </div>
            <div class="hd3-statrow">
                <a href="/arbeidsordre" class="hd3-statcard">
                    <span class="hd3-statcard-ic hd3-ic-gronn"><Icon Name="check-circle" /></span>
                    <div><div class="hd3-statcard-num">@_ferdigDenneUken</div><div class="hd3-statcard-lbl">Ferdig denne uken</div></div>
                </a>
                <a href="/service" class="hd3-statcard">
                    <span class="hd3-statcard-ic hd3-ic-gul"><Icon Name="clock" /></span>
                    <div><div class="hd3-statcard-num">@_serviceavtalerVarsel</div><div class="hd3-statcard-lbl">Nærmer seg forfall</div></div>
                </a>
                <a href="/service" class="hd3-statcard">
                    <span class="hd3-statcard-ic hd3-ic-aksent"><Icon Name="file-text" /></span>
                    <div><div class="hd3-statcard-num">@_hd3UtenNesteDato</div><div class="hd3-statcard-lbl">Uten neste dato</div></div>
                </a>
                <a href="/service" class="hd3-statcard">
                    <span class="hd3-statcard-ic hd3-ic-aksent"><Icon Name="calendar" /></span>
                    <div><div class="hd3-statcard-num">@_hd3TotaltAvtaler</div><div class="hd3-statcard-lbl">Totalt avtaler</div></div>
                </a>
            </div>
        </div>

        <div class="hd3-rolerow">
            @foreach (var rolle in Roller)
            {
                <button type="button" class="hd3-rolecard" @onclick="@(() => VelgRolle(rolle.Nokkel))">
                    <span class="hd3-rolecard-ic"><Icon Name="@IkonForRolle(rolle.Nokkel)" /></span>
                    <span class="hd3-rolecard-info"><span class="hd3-rolecard-title">@TittelFor(rolle)</span><span class="hd3-rolecard-sub">@BeskrivelseFor(rolle)</span></span>
                    <span class="hd3-rolecard-arrow"><Icon Name="chevron-down" /></span>
                </button>
            }
        </div>

        <div class="hd3-widgetgrid">
            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="calendar" /></span><span class="hd3-widget-title">Neste service</span></span>
                    <a href="/service" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_hd3NesteService.Count == 0)
                {
                    <p class="home-dash-tom">Ingen kommende service registrert.</p>
                }
                else
                {
                    @foreach (var s in _hd3NesteService)
                    {
                        <a href="@s.Href" class="hd3-wl">
                            <span class="hd3-wl-dot" style="background:@s.Farge"></span>
                            <span class="hd3-wl-info"><span class="hd3-wl-title">@s.Navn</span><span class="hd3-wl-sub">@s.Adresse</span></span>
                            <span class="hd3-wl-right"><span class="hd3-wl-val" style="color:@s.Farge">@s.RelativTekst</span><span class="hd3-wl-chev"><Icon Name="chevron-down" /></span></span>
                        </a>
                    }
                }
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="map" /></span><span class="hd3-widget-title">Aktivitet på kart</span></span>
                    <span class="hd3-kart-legend">
                        <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#9A4E24"></span>Service</span>
                        <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#0b66e6"></span>Prosjekt</span>
                        <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#0c9c5c"></span>Arbeidsordre</span>
                    </span>
                </div>
                <div class="hd3-mapwrap"><div id="hd3-kart" class="hd3-kart"></div></div>
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="bell" /></span><span class="hd3-widget-title">Oppgaver og frister</span></span>
                    <a href="/foresporsler" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_hd3Oppgaver.Count == 0)
                {
                    <p class="home-dash-tom">Ingen nye forespørsler eller driftsmeldinger.</p>
                }
                else
                {
                    @foreach (var o in _hd3Oppgaver)
                    {
                        <a href="@o.Href" class="hd3-wl">
                            <span class="hd3-wl-ic" style="background:@o.BakgrunnFarge;color:@o.Farge"><Icon Name="@o.Ikon" /></span>
                            <span class="hd3-wl-info"><span class="hd3-wl-title">@o.Navn</span><span class="hd3-wl-sub">@o.Undertekst</span></span>
                            <span class="hd3-wl-right"><span class="hd3-wl-time">@o.DatoTekst</span><span class="hd3-wl-chev"><Icon Name="chevron-down" /></span></span>
                        </a>
                    }
                }
            </div>
        </div>

        <div class="hd3-widgetgrid">
            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="folder" /></span><span class="hd3-widget-title">Pågående prosjekter</span></span>
                    <a href="/prosjekter" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_dashAktiveProsjekter.Count == 0)
                {
                    <p class="home-dash-tom">Ingen aktive prosjekter akkurat nå.</p>
                }
                else
                {
                    @foreach (var p in _dashAktiveProsjekter)
                    {
                        var fremdrift = ProsjektFremdrift(p);
                        <a href="@($"/prosjekter/{p.Id}")" class="hd3-wl">
                            <span class="hd3-wl-ic hd3-ic-aksent"><Icon Name="folder" /></span>
                            <span class="hd3-wl-info" style="flex:0 0 120px;"><span class="hd3-wl-title">@p.Navn</span><span class="hd3-wl-sub">@ProsjektSted(p)</span></span>
                            <span class="hd3-progress-track"><span class="hd3-progress-fill" style="width:@(fremdrift)%"></span></span>
                            <span class="hd3-progress-pct">@(fremdrift)%</span>
                        </a>
                    }
                }
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="bell" /></span><span class="hd3-widget-title">Meldinger og varsler</span></span>
                    <a href="/tilbud" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_hd3Meldinger.Count == 0)
                {
                    <p class="home-dash-tom">Ingen hendelser registrert ennå.</p>
                }
                else
                {
                    @foreach (var m in _hd3Meldinger)
                    {
                        <a href="@m.Href" class="hd3-wl">
                            <span class="hd3-wl-ic" style="background:@m.BakgrunnFarge;color:@m.Farge"><Icon Name="@m.Ikon" /></span>
                            <span class="hd3-wl-info"><span class="hd3-wl-title">@m.Tittel</span><span class="hd3-wl-sub">@m.Undertekst</span></span>
                            <span class="hd3-wl-right"><span class="hd3-wl-time">@m.TidTekst</span><span class="hd3-wl-dot" style="background:@m.Farge"></span></span>
                        </a>
                    }
                }
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head" style="margin-bottom:14px;">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="box" /></span><span class="hd3-widget-title">Snarveier</span></span>
                </div>
                <div class="hd3-snarveigrid">
                    <a href="/service" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="clock" /></span><span class="hd3-snarvei-lbl">Ny serviceavtale</span></a>
                    <a href="/arbeidsordre" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="file-text" /></span><span class="hd3-snarvei-lbl">Ny arbeidsordre</span></a>
                    <a href="/kunder" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="users" /></span><span class="hd3-snarvei-lbl">Ny kunde</span></a>
                    <a href="/prosjekter" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="folder" /></span><span class="hd3-snarvei-lbl">Nytt prosjekt</span></a>
                    <a href="/timeregistrering" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="clock" /></span><span class="hd3-snarvei-lbl">Registrer timer</span></a>
                    <a href="/rapporter" class="hd3-snarvei"><span class="hd3-snarvei-ic"><Icon Name="trend-up" /></span><span class="hd3-snarvei-lbl">Generer rapport</span></a>
                </div>
            </div>
        </div>
    }
    else if (AktivLayout == HjemLayout.Bilde)
    {
        <div class="home-dash-hero">
            <img src="home-hero-montor.png?v=6" alt="" class="home-dash-hero-img" draggable="false" />
            <div class="home-dash-hero-scrim"></div>
            <div class="home-dash-hero-top-scrim"></div>

            <div class="home-dash-hero-text">
                <span class="home-dash-date-pill">@Idag</span>
                @if (Hilsen is not null)
                {
                    <h1>@Hilsen</h1>
                }
                @if (HeroSetning is not null)
                {
                    <p>@HeroSetning</p>
                }
            </div>
        </div>

        <div class="home-dash-roles">
            @foreach (var rolle in Roller)
            {
                <button type="button" class="home-dash-role-card" @onclick="@(() => VelgRolle(rolle.Nokkel))">
                    <img src="@BildeForRolle(rolle.Nokkel)" alt="" />
                    <span class="home-dash-role-text">
                        <span class="home-dash-role-title">@TittelFor(rolle)</span>
                        <span class="home-dash-role-desc">@BeskrivelseFor(rolle)</span>
                    </span>
                    <span class="home-dash-role-pil"><Icon Name="chevron-down" /></span>
                </button>
            }
        </div>

        <div class="home-dash-kpi">
            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="folder" /></span>
                    <div><div class="home-dash-kpi-tall">@_aktiveProsjekter</div><div class="home-dash-kpi-label">Aktive prosjekter</div></div>
                </div>
                <div class="home-dash-kpi-status home-dash-kpi-status-gronn">
                    @(_dashNyeProsjekterDenneUken > 0 ? $"+{_dashNyeProsjekterDenneUken} denne uken" : "Uendret denne uken")
                </div>
            </div>

            <a href="/arbeidsordre" class="home-dash-kpi-kort home-dash-kpi-link">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="check-circle" /></span>
                    <div><div class="home-dash-kpi-tall">@_dashApneArbeidsordre</div><div class="home-dash-kpi-label">Åpne arbeidsordrer</div></div>
                </div>
                @if (_dagensJobber > 0)
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-aksent">@_dagensJobber planlagt i dag</div>
                }
                else
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-gronn">Ingen planlagt i dag</div>
                }
                <span class="home-dash-kpi-pil"><Icon Name="chevron-down" /></span>
            </a>

            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="users" /></span>
                    <div><div class="home-dash-kpi-tall">@_dashMontorerUteIDag</div><div class="home-dash-kpi-label">Montører ute i dag</div></div>
                </div>
                <div class="home-dash-kpi-status home-dash-kpi-status-gronn">
                    @(_dashMontorerUteIDag > 0 ? $"{_dagensJobber} oppdrag totalt" : "Ingen ute i dag")
                </div>
            </div>

            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="clock" /></span>
                    <div><div class="home-dash-kpi-tall">@(_dashTimerDenneUken.ToString("0")) t</div><div class="home-dash-kpi-label">Registrert denne uken</div></div>
                </div>
                @if (_dashTimerEndringProsent is { } endring)
                {
                    <div class="home-dash-kpi-status @(endring >= 0 ? "home-dash-kpi-status-gronn" : "home-dash-kpi-status-aksent")">@(endring >= 0 ? "+" : "")@(endring.ToString("0")) % fra forrige uke</div>
                }
                else
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-gronn">Denne uken</div>
                }
            </div>
        </div>

        <div class="home-dash-grid">
            <div class="home-dash-panel">
                <div class="home-dash-panel-header">
                    <span><Icon Name="folder" />Aktive prosjekter</span>
                    <a href="/prosjekter">Se alle &rarr;</a>
                </div>
                @if (_dashAktiveProsjekter.Count == 0)
                {
                    <p class="home-dash-tom">Ingen aktive prosjekter akkurat nå.</p>
                }
                else
                {
                    <div class="home-dash-panel-liste">
                        @foreach (var p in _dashAktiveProsjekter)
                        {
                            var fremdrift = ProsjektFremdrift(p);
                            <a href="@($"/prosjekter/{p.Id}")" class="home-dash-prosjekt-rad">
                                <img class="home-dash-prosjekt-bilde" src="home-prosjekt-standard.png" alt="" />
                                <span class="home-dash-prosjekt-info">
                                    <span class="home-dash-prosjekt-navn">@p.Navn</span>
                                    <span class="home-dash-prosjekt-sted">@ProsjektSted(p)</span>
                                    <span class="home-dash-prosjekt-progress">
                                        <span class="home-dash-progress-track"><span class="home-dash-progress-fill" style="width:@(fremdrift)%"></span></span>
                                        <span class="home-dash-progress-tall">@(fremdrift)%</span>
                                    </span>
                                </span>
                                <span class="home-dash-pill home-dash-pill-gronn">Pågående</span>
                                <span class="home-dash-prosjekt-pil"><Icon Name="chevron-down" /></span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="home-dash-panel">
                <div class="home-dash-panel-header">
                    <span><Icon Name="check-circle" />Dagens arbeidsordrer</span>
                    <a href="/arbeidsordre">Se alle &rarr;</a>
                </div>
                @if (_dashDagensArbeidsordre.Count == 0)
                {
                    <p class="home-dash-tom">Ingen arbeidsordre planlagt i dag.</p>
                }
                else
                {
                    <div class="home-dash-panel-liste">
                        @foreach (var a in _dashDagensArbeidsordre)
                        {
                            <a href="@($"/arbeidsordre/{a.Id}")" class="home-dash-ao-rad">
                                <span class="home-dash-ao-ikon"><Icon Name="@a.Status.PillIkon()" /></span>
                                <span class="home-dash-ao-tid">@(a.PlanlagtDato?.ToString("HH:mm"))</span>
                                <span class="home-dash-ao-info">
                                    <span class="home-dash-ao-tittel">@a.Tittel</span>
                                    <span class="home-dash-ao-sted">@(a.Prosjekt?.Navn ?? a.Sted)</span>
                                </span>
                                @if (ArbeidsordrePagar(a))
                                {
                                    <span class="home-dash-pill home-dash-pill-gronn">Pågår</span>
                                }
                                else if (a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert)
                                {
                                    <span class="home-dash-pill home-dash-pill-gronn">Ferdig</span>
                                }
                                else
                                {
                                    <span class="home-dash-pill home-dash-pill-beige">Ikke startet</span>
                                }
                                <span class="home-dash-ao-avatar">@(a.AnsvarligMontor?.Initialer ?? "?")</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="home-hero-banner">
            <div class="home-hero-inner">
                <div class="home-hero-text">
                    <span class="home-dato-pill">@Idag</span>
                    @if (Hilsen is not null)
                    {
                        <h1 class="home-hilsen">@Hilsen</h1>
                    }
                    @if (HeroSetning is not null)
                    {
                        <p class="home-hero-sub">@HeroSetning</p>
                    }
                </div>

                @if (_alleStats.Count > 0)
                {
                    <div class="home-hero-stats-wrap">
                        <div class="home-hero-stats-marquee">
                            <div class="home-hero-stats-track" style="animation-duration:@(MarqueeVarighet.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                                @foreach (var stat in _alleStats)
                                {
                                    @StatMarkup(stat)
                                }
                                <div class="home-hero-stats-dup" aria-hidden="true">
                                    @foreach (var stat in _alleStats)
                                    {
                                        @StatMarkup(stat)
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_nesteJobb is not null)
        {
            <a href="@($"/arbeidsordre/{_nesteJobb.Id}")" class="neste-jobb-kort">
                <span class="neste-jobb-ikon"><Icon Name="calendar" /></span>
                <span class="neste-jobb-tekst">
                    <span class="neste-jobb-label">Neste jobb i dag · @_nesteJobb.Klokkeslett</span>
                    <span class="neste-jobb-tittel">
                        @_nesteJobb.Tittel
                        @if (_nesteJobb.KundeNavn is not null)
                        {
                            <text> · @_nesteJobb.KundeNavn</text>
                        }
                    </span>
                    @if (_nesteJobb.Adresse is not null)
                    {
                        <span class="neste-jobb-adresse">@_nesteJobb.Adresse</span>
                    }
                </span>
                <span class="neste-jobb-pil"><Icon Name="chevron-down" /></span>
            </a>
        }

        <div class="home-divider" aria-hidden="true">
            <span class="home-divider-linje"></span>
        </div>

        <section class="home-section">
            <div class="role-grid">
                @foreach (var rolle in Roller)
                {
                    <button type="button"
                            class="role-card role-card-@rolle.Nokkel @(_valgtRolle == rolle.Nokkel ? "role-card-active" : "")"
                            @onclick="@(() => VelgRolle(rolle.Nokkel))">
                        <span class="role-card-ikon"><Icon Name="@IkonForRolle(rolle.Nokkel)" /></span>
                        <span class="role-card-title">@TittelFor(rolle)</span>
                        <span class="role-card-desc">@BeskrivelseFor(rolle)</span>
                    </button>
                }
            </div>
        </section>
    }

    @if (_valgtRolle is not null)
    {
        var valgt = Roller.First(r => r.Nokkel == _valgtRolle);
        var hub = _valgtHub;

        <div class="modul-modal-bakteppe" @onclick="LukkModulPanel">
            <div class="modul-modal modul-modal-@_valgtRolle" @onclick:stopPropagation="true">
                <div class="modul-modal-header">
                    @if (hub is not null)
                    {
                        <button type="button" class="modul-modal-tilbake" @onclick="@(() => _valgtHub = null)" aria-label="Tilbake">
                            <Icon Name="arrow-left" />
                        </button>
                        <span class="modul-modal-ikon"><Icon Name="@hub.IconNavn" /></span>
                        <span class="modul-modal-header-tekst">
                            <span class="modul-modal-tittel">@hub.Tittel</span>
                            <span class="modul-modal-beskrivelse">@hub.Beskrivelse</span>
                        </span>
                    }
                    else
                    {
                        <span class="modul-modal-ikon"><Icon Name="@IkonForRolle(_valgtRolle)" /></span>
                        <span class="modul-modal-header-tekst">
                            <span class="modul-modal-tittel">@valgt.Tittel</span>
                            <span class="modul-modal-beskrivelse">@valgt.Beskrivelse</span>
                        </span>
                    }
                    <button type="button" class="modul-modal-lukk" @onclick="LukkModulPanel" aria-label="Lukk">
                        <Icon Name="x" />
                    </button>
                </div>
                <div class="modul-modal-innhold">
                    @if (hub is not null)
                    {
                        <div class="home-links">
                            @foreach (var link in hub.Undermoduler ?? [])
                            {
                                <a class="home-card" href="@($"{link.Href}?fra=hjem&rolle={_valgtRolle}&hub={hub.Href}")">
                                    <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                    <span class="home-card-tekst">
                                        <span class="home-card-title">@link.Tittel</span>
                                        <span class="home-card-desc">@link.Beskrivelse</span>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var gruppe in valgt.Grupper)
                        {
                            <div class="home-links-gruppe">
                                <h3 class="home-links-gruppe-navn">@gruppe.Navn</h3>
                                <div class="home-links">
                                    @foreach (var link in gruppe.Lenker)
                                    {
                                        @if (link.Undermoduler is not null)
                                        {
                                            <button type="button" class="home-card home-card-knapp" @onclick="@(() => _valgtHub = link)">
                                                <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                                <span class="home-card-tekst">
                                                    <span class="home-card-title">@link.Tittel</span>
                                                    <span class="home-card-desc">@link.Beskrivelse</span>
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="home-card" href="@($"{link.Href}?fra=hjem&rolle={_valgtRolle}")">
                                                <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                                <span class="home-card-tekst">
                                                    <span class="home-card-title">@link.Tittel</span>
                                                    <span class="home-card-desc">@link.Beskrivelse</span>
                                                </span>
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @if (VisBiler)
    {
        <div class="home-drive-strip" aria-hidden="true">
            @foreach (var delay in DriveDelays)
            {
                <div class="home-drive-track" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                    <div class="home-drive-shadow" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s"></div>
                    <div class="home-drive-tilt">
                        <img src="img/itlock-bil.png?v=6" alt="" class="home-drive-car" />
                    </div>
                </div>
            }
        </div>
    }

    <p class="home-footer">Laget av Marius Karlsen</p>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // Negative animation-delay hopper hver bil rett inn på et gitt punkt i
    // 13s-syklusen, slik at de fordeler seg jevnt etter hverandre langs banen.
    private static readonly double[] DriveDelays = [0, -3.25, -6.5, -9.75];

    // Sett til true igjen for å vise de kjørende servicebilene på forsiden.
    private const bool VisBiler = false;

    private sealed record HeroStat(string? Href, string Ikon, int Verdi, string Label, bool Varsel);
    private sealed record NesteJobb(int Id, string Tittel, string Klokkeslett, string? KundeNavn, string? Adresse);

    // Sekunder pr. nøkkeltall i den kontinuerlige marquee-animasjonen -
    // styrer farten (holder tempoet likt uansett hvor mange nøkkeltall
    // som faktisk vises, siden varigheten skaleres med antallet).
    private const double MarqueeSekunderPrStat = 4.0;

    private string? _valgtRolle;
    private Lenke? _valgtHub;
    private HjemmesideTekst? _tekst;

    private int _aktiveProsjekter;
    private int _avvikSomVenter;
    private int _dagensJobber;
    private int _ferdigDenneUken;
    private int _serviceavtalerVarsel;
    private bool _visServiceavtaleVarsel;
    private int _nyligFakturerteOrdre;
    private int _kunderTrengerOppfolging;
    private int _varerLavBeholdning;
    private int _lisensVarsel;

    private List<HeroStat> _alleStats = [];
    private NesteJobb? _nesteJobb;

    // ---------- Data til det nye, bilde-baserte dashboardet (kun Fullversjon) ----------
    private List<Prosjekt> _dashAktiveProsjekter = [];
    private List<Arbeidsordre> _dashDagensArbeidsordre = [];
    private int _dashApneArbeidsordre;
    private int _dashMontorerUteIDag;
    private int _dashNyeProsjekterDenneUken;
    private decimal _dashTimerDenneUken;
    private decimal? _dashTimerEndringProsent;

    private static readonly ArbeidsordreStatus[] ApneArbeidsordreStatuser =
        [ArbeidsordreStatus.Ny, ArbeidsordreStatus.Klar, ArbeidsordreStatus.Pagaende];

    private async Task LastInnDashboardData(DateTime mandag, DateTime sondag)
    {
        _dashAktiveProsjekter = await Db.Prosjekter
            .Include(p => p.Arbeidsordre)
            .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.UnderArbeid || p.Status == ProsjektStatus.Serviceavtale)
            .OrderByDescending(p => p.OpprettetDato)
            .Take(3)
            .ToListAsync();

        _dashApneArbeidsordre = await Db.Arbeidsordre.CountAsync(a => ApneArbeidsordreStatuser.Contains(a.Status));

        _dashDagensArbeidsordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today)
            .OrderBy(a => a.PlanlagtDato)
            .Take(4)
            .ToListAsync();

        _dashMontorerUteIDag = await Db.Arbeidsordre
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today && a.AnsvarligMontorId != null)
            .Select(a => a.AnsvarligMontorId)
            .Distinct()
            .CountAsync();

        _dashNyeProsjekterDenneUken = await Db.Prosjekter.CountAsync(p => p.OpprettetDato >= mandag);

        var denneUkenTimer = await Db.Timeregistreringer
            .Where(t => t.Dato >= mandag && t.Dato <= sondag)
            .ToListAsync();
        _dashTimerDenneUken = denneUkenTimer.Sum(t => t.TotalTimer);

        var forrigeMandag = mandag.AddDays(-7);
        var forrigeTimer = await Db.Timeregistreringer
            .Where(t => t.Dato >= forrigeMandag && t.Dato < mandag)
            .ToListAsync();
        var forrigeSum = forrigeTimer.Sum(t => t.TotalTimer);
        _dashTimerEndringProsent = forrigeSum > 0
            ? Math.Round((_dashTimerDenneUken - forrigeSum) / forrigeSum * 100, 0)
            : null;
    }

    // ---------- Data til Dashboard3 (widget-rutenett med kart) ----------
    private sealed record Hd3NesteService(string Href, string Navn, string Adresse, string Farge, string RelativTekst, DateTime SortDato);
    private sealed record Hd3Oppgave(string Href, string Navn, string Undertekst, string Ikon, string Farge, string BakgrunnFarge, string DatoTekst, DateTime SortDato);
    private sealed record Hd3Melding(string Href, string Tittel, string Undertekst, string Ikon, string Farge, string BakgrunnFarge, string TidTekst, DateTime SortDato);

    private int _hd3TotaltAvtaler;
    private int _hd3UtenNesteDato;
    private List<Hd3NesteService> _hd3NesteService = [];
    private List<Hd3Oppgave> _hd3Oppgaver = [];
    private List<Hd3Melding> _hd3Meldinger = [];

    private static readonly ArbeidsordreStatus[] Hd3ApneOrdreStatuser =
        [ArbeidsordreStatus.Ny, ArbeidsordreStatus.Klar, ArbeidsordreStatus.Pagaende];

    private async Task LastInnDashboard3Data()
    {
        // ---------- Neste service: serviceavtaler + arbeidsordre med planlagt dato, sortert etter nærmest først ----------
        var serviceProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.Kunde)
            .ToListAsync();

        var serviceProsjektIder = serviceProsjekter.Select(p => p.Id).ToList();
        var runder = await Db.Servicerunder.Where(r => serviceProsjektIder.Contains(r.ProsjektId)).ToListAsync();

        var serviceRader = serviceProsjekter.Select(p => new
        {
            Prosjekt = p,
            NesteServiceDato = runder.Where(r => r.ProsjektId == p.Id)
                .OrderByDescending(r => r.Dato)
                .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato
        }).ToList();

        _hd3TotaltAvtaler = serviceRader.Count;
        _hd3UtenNesteDato = serviceRader.Count(r => !r.NesteServiceDato.HasValue);

        var planlagteOrdre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Where(a => Hd3ApneOrdreStatuser.Contains(a.Status) && a.PlanlagtDato != null)
            .ToListAsync();

        _hd3NesteService = serviceRader
            .Where(r => r.NesteServiceDato.HasValue)
            .Select(r => new Hd3NesteService(
                $"/serviceavtaler/{r.Prosjekt.Id}",
                r.Prosjekt.Navn,
                ProsjektSted(r.Prosjekt),
                Hd3ServiceFarge(r.NesteServiceDato!.Value),
                Hd3RelativTid(r.NesteServiceDato!.Value),
                r.NesteServiceDato!.Value))
            .Concat(planlagteOrdre.Select(a => new Hd3NesteService(
                $"/arbeidsordre/{a.Id}",
                a.Tittel,
                a.Prosjekt?.Navn ?? "Ingen prosjekt",
                Hd3ServiceFarge(a.PlanlagtDato!.Value),
                Hd3RelativTid(a.PlanlagtDato!.Value),
                a.PlanlagtDato!.Value)))
            .OrderBy(x => x.SortDato)
            .Take(4)
            .ToList();

        // ---------- Oppgaver og frister: nye forespørsler og driftsmeldinger, nyeste først ----------
        var nyeForesporsler = await Db.Foresporsler
            .Where(f => !f.Lest)
            .OrderByDescending(f => f.MottattDato)
            .Take(4)
            .ToListAsync();

        var nyeDriftsmeldinger = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .Where(m => !m.LestAvAnsatt)
            .OrderByDescending(m => m.OpprettetDato)
            .Take(4)
            .ToListAsync();

        _hd3Oppgaver = nyeForesporsler
            .Select(f => new Hd3Oppgave(
                $"/foresporsler?id={f.Id}",
                f.Emne,
                string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn,
                "mail",
                "#2054a3",
                "#dbe7f7",
                Hd3RelativTid(f.MottattDato),
                f.MottattDato))
            .Concat(nyeDriftsmeldinger.Select(m => new Hd3Oppgave(
                $"/driftsmelding/{m.Id}",
                string.IsNullOrWhiteSpace(m.Tittel) ? $"Dør {m.Dor?.Dornummer}" : m.Tittel!,
                m.Dor?.Prosjekt?.Navn ?? "",
                "tool",
                "#a32020",
                "#f7d3d3",
                Hd3RelativTid(m.OpprettetDato),
                m.OpprettetDato)))
            .OrderByDescending(x => x.SortDato)
            .Take(4)
            .ToList();

        // ---------- Meldinger og varsler: tilbud-hendelser + kunder som trenger oppfølging ----------
        var tilbudHendelser = await Db.TilbudHendelser
            .Include(h => h.Tilbud)
            .OrderByDescending(h => h.Tidspunkt)
            .Take(4)
            .ToListAsync();

        var kunderTrengerOppfolging = await Db.Kunder
            .Where(k => k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today)
            .OrderBy(k => k.NesteOppfolgingsDato)
            .Take(4)
            .ToListAsync();

        _hd3Meldinger = tilbudHendelser
            .Where(h => h.Tilbud is not null)
            .Select(h =>
            {
                var (ikon, farge, bakgrunn, tittel) = Hd3HendelseVisning(h.Beskrivelse);
                return new Hd3Melding(
                    $"/tilbud/{h.TilbudId}",
                    $"{tittel} - {h.Tilbud!.Tittel}",
                    h.Beskrivelse,
                    ikon,
                    farge,
                    bakgrunn,
                    Hd3RelativTid(h.Tidspunkt),
                    h.Tidspunkt);
            })
            .Concat(kunderTrengerOppfolging.Select(k => new Hd3Melding(
                $"/kunder/{k.Id}",
                $"Oppfølging - {k.Navn}",
                "Trenger oppfølging",
                "users",
                "#a1690a",
                "#f4e3c7",
                Hd3RelativTid(k.NesteOppfolgingsDato!.Value),
                k.NesteOppfolgingsDato!.Value)))
            .OrderByDescending(x => x.SortDato)
            .Take(4)
            .ToList();

        await LastInnHd3KartAsync(serviceProsjekter, planlagteOrdre);
    }

    // Egen, hex-fargebasert variant av TilbudSkjema sin HendelseVisning (som
    // returnerer StatusPill-fargenavn, ikke hex) - samme tekst-gjenkjenning,
    // tilpasset Dashboard3 sin fargepalett.
    private static (string Ikon, string Farge, string Bakgrunn, string Tittel) Hd3HendelseVisning(string beskrivelse)
    {
        if (beskrivelse.StartsWith("Tilbudet ble opprettet", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "#2b7a4b", "#d3ecdb", "Tilbud opprettet");
        }
        if (beskrivelse.StartsWith("Status endret", StringComparison.OrdinalIgnoreCase))
        {
            return ("clock", "#2054a3", "#dce8f7", "Status endret");
        }
        if (beskrivelse.StartsWith("Genererte PDF", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "#2A2017", "#EEE7DF", "PDF generert");
        }
        if (beskrivelse.Contains("pris", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.Contains("rigg/drift", StringComparison.OrdinalIgnoreCase))
        {
            return ("trend-up", "#D98B3F", "#FBEFDB", "Pris oppdatert");
        }
        if (beskrivelse.StartsWith("Vare", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret antall", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.Contains("synkronisert", StringComparison.OrdinalIgnoreCase))
        {
            return ("box", "#6B46C1", "#E3DEF6", "Vare oppdatert");
        }

        return ("bell", "#9A4E24", "#F3E9DC", "Tilbud lagret");
    }

    private static string Hd3ServiceFarge(DateTime nesteServiceDato) => nesteServiceDato.Date switch
    {
        var d when d < DateTime.Today => "#C23B3B",
        var d when d <= DateTime.Today.AddDays(14) => "#D98B3F",
        _ => "#2b7a4b"
    };

    private static string Hd3RelativTid(DateTime dato)
    {
        var dager = (dato.Date - DateTime.Today).Days;
        if (dager < 0)
        {
            return $"{-dager} dager siden";
        }
        if (dager == 0)
        {
            return "I dag";
        }
        if (dager <= 60)
        {
            return $"Om {dager} dager";
        }
        var maneder = (int)Math.Round(dager / 30.0);
        return $"Om {maneder} mnd";
    }

    // Samme geokodingsmønster som Serviceavtaler.razor - lagrer posisjon på
    // selve Prosjektet slik at kartet slipper å geokode på nytt neste visning.
    // Kartet viser nå alle tre typene aktivitet samtidig: serviceavtaler,
    // andre aktive prosjekter og åpne arbeidsordre - samme punkt-fasong
    // (pin+rikPopup) som Arbeidsordre/Prosjekter sine egne kartvisninger.
    private async Task LastInnHd3KartAsync(List<Prosjekt> serviceProsjekter, List<Arbeidsordre> planlagteOrdre)
    {
        var aktiveProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.UnderArbeid)
            .ToListAsync();

        var alleProsjekter = serviceProsjekter.Concat(aktiveProsjekter).ToList();

        var endret = false;
        foreach (var p in alleProsjekter.Where(p => p.Latitude is null && !string.IsNullOrWhiteSpace(p.Adresse)))
        {
            var treff = await Geokoding.GeocodeAsync(p.Adresse!, p.Postnr, p.Sted);
            if (treff is null)
            {
                continue;
            }

            p.Latitude = treff.Value.Latitude;
            p.Longitude = treff.Value.Longitude;
            endret = true;
        }

        if (endret)
        {
            await Db.SaveChangesAsync();
        }

        var punkter = new List<object>();

        punkter.AddRange(serviceProsjekter
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"service-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#9A4E24",
                pin = true,
                rikPopup = true,
                statusTekst = "Serviceavtale",
                statusBg = "#F3E9DC",
                href = $"/serviceavtaler/{p.Id}"
            }));

        punkter.AddRange(aktiveProsjekter
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"prosjekt-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#0b66e6",
                pin = true,
                rikPopup = true,
                statusTekst = p.Status?.Visningsnavn(),
                statusBg = "#dbe7f7",
                href = $"/prosjekter/{p.Id}"
            }));

        punkter.AddRange(planlagteOrdre
            .Where(a => (a.Latitude ?? a.Prosjekt?.Latitude) is not null && (a.Longitude ?? a.Prosjekt?.Longitude) is not null)
            .Select(a => (object)new
            {
                id = $"ao-{a.Id}",
                lat = a.Latitude ?? a.Prosjekt!.Latitude!.Value,
                lng = a.Longitude ?? a.Prosjekt!.Longitude!.Value,
                tittel = a.Tittel,
                undertekst = a.Prosjekt?.Navn ?? "",
                farge = "#0c9c5c",
                pin = true,
                rikPopup = true,
                statusTekst = a.Status.Visningsnavn(),
                statusBg = "#d3ecdb",
                href = $"/arbeidsordre/{a.Id}"
            }));

        _hd3KartPunkter = punkter;
    }

    private List<object> _hd3KartPunkter = [];
    private bool _hd3KartInitialisert;

    private static string BildeForRolle(string nokkel) => nokkel switch
    {
        "montorer" => "home-role-montor.png?v=3",
        "prosjektledere" => "home-role-prosjektleder.png?v=3",
        "admin" => "home-role-admin.png?v=3",
        _ => "home-role-montor.png?v=3",
    };

    private static int ProsjektFremdrift(Prosjekt p)
    {
        if (p.Arbeidsordre.Count == 0)
        {
            return 0;
        }

        var ferdige = p.Arbeidsordre.Count(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert);
        return (int)Math.Round(100.0 * ferdige / p.Arbeidsordre.Count);
    }

    private static string ProsjektSted(Prosjekt p) => string.IsNullOrWhiteSpace(p.Sted) ? "Flere lokasjoner" : p.Sted;

    private static bool ArbeidsordrePagar(Arbeidsordre a) => a.Status == ArbeidsordreStatus.Pagaende;

    private Nyhet? _sisteNyhet;
    private Bruker? _naverendeBruker;
    private bool _visNyhet;

    // "Dashboard-stil" i Tilpass meny lar brukeren selv velge mellom tre
    // Hjem-layouter: Klassisk (marquee-nøkkeltall, rollekort-grid), Bilde
    // (bilde-basert dashboard) og Dashboard3 (widget-grid med kart). Styres
    // av Bruker sitt HjemLayoutValg-felt - men aldri på mobil, som alltid
    // bruker Klassisk uansett valg (se AktivLayout).
    private HjemLayout AktivLayout => Verktoylinje.ErMobilvisning
        ? HjemLayout.Klassisk
        : _naverendeBruker?.HjemLayoutValg ?? HjemLayout.Bilde;

    // Lenkene i modul-modalen (se markup over) legger på "?fra=hjem&rolle=...
    // &hub=..." før navigering til en undermodul, slik at MainLayout sin
    // generiske tilbakepil kan sende brukeren tilbake til "/" MED akkurat
    // samme modal-tilstand åpen igjen - "veien tilbake skal være helt lik
    // veien inn" - i stedet for en tom forside. Leses derfor tilbake her ved
    // oppstart. Ukjente/manglende verdier ignoreres stille (vanlig besøk på
    // "/" uten disse parameterne skal fortsatt vise en helt vanlig forside).
    private void GjenopprettModulPanelFraUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("rolle", out var rolleParam))
        {
            return;
        }

        var rolle = Roller.FirstOrDefault(r => r.Nokkel == rolleParam);
        if (rolle is null)
        {
            return;
        }

        _valgtRolle = rolle.Nokkel;

        if (query.TryGetValue("hub", out var hubParam))
        {
            _valgtHub = rolle.Grupper
                .SelectMany(g => g.Lenker)
                .FirstOrDefault(l => l.Undermoduler is not null && l.Href == hubParam);
        }
    }

    private async Task LukkNyhet()
    {
        if (_naverendeBruker is null || _sisteNyhet is null)
        {
            return;
        }

        _naverendeBruker.SisteNyhetSettId = _sisteNyhet.Id;
        await Db.SaveChangesAsync();
        _visNyhet = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;

        GjenopprettModulPanelFraUrl();

        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (rolleClaim == "Kunde")
        {
            Nav.NavigateTo("/kunde", forceLoad: true);
            return;
        }

        if (rolleClaim == "Driftslisens")
        {
            Nav.NavigateTo("/drift", forceLoad: true);
            return;
        }

        BrukerRolle? rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : null;
        int? brukerId = null;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
        {
            brukerId = bid;
        }

        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();

        if (brukerId.HasValue)
        {
            _naverendeBruker = await Db.Brukere.FindAsync(brukerId.Value);
        }

        _sisteNyhet = await Db.Nyheter.OrderByDescending(n => n.Id).FirstOrDefaultAsync();
        if (_sisteNyhet is not null && _naverendeBruker is not null)
        {
            _visNyhet = (_naverendeBruker.SisteNyhetSettId ?? 0) < _sisteNyhet.Id;
        }

        var mandag = FinnForrigeMandag(DateTime.Today);
        var sondag = mandag.AddDays(6);

        _aktiveProsjekter = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Aktiv);
        _avvikSomVenter = await Db.Avvik.CountAsync(a => a.Status == AvvikStatus.SendtTilKunde);

        var dagensQuery = Db.Arbeidsordre.Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today);
        var ferdigQuery = Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig
            && a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= mandag && a.PlanlagtDato.Value.Date <= sondag);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            dagensQuery = dagensQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
            ferdigQuery = ferdigQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        _dagensJobber = await dagensQuery.CountAsync();
        _ferdigDenneUken = await ferdigQuery.CountAsync();

        if (AktivLayout != HjemLayout.Klassisk)
        {
            await LastInnDashboardData(mandag, sondag);
        }

        if (AktivLayout == HjemLayout.Dashboard3)
        {
            await LastInnDashboard3Data();
        }

        var nesteJobbQuery = Db.Arbeidsordre
            .Include(a => a.Kunde)
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today
                && a.Status != ArbeidsordreStatus.Ferdig && a.Status != ArbeidsordreStatus.Fakturert);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            nesteJobbQuery = nesteJobbQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        var forsteJobb = await nesteJobbQuery.OrderBy(a => a.PlanlagtDato).FirstOrDefaultAsync();
        if (forsteJobb is not null)
        {
            _nesteJobb = new NesteJobb(
                forsteJobb.Id,
                forsteJobb.Tittel,
                forsteJobb.PlanlagtDato!.Value.ToString("HH:mm"),
                forsteJobb.Kunde?.Navn,
                string.IsNullOrWhiteSpace(forsteJobb.Adresse) ? null : forsteJobb.Adresse);
        }

        _visServiceavtaleVarsel = rolle == BrukerRolle.Admin || rolle == BrukerRolle.Prosjektleder;
        if (_visServiceavtaleVarsel)
        {
            var serviceProsjektIder = await Db.Prosjekter
                .Where(p => p.Status == ProsjektStatus.Serviceavtale)
                .Select(p => p.Id)
                .ToListAsync();

            if (serviceProsjektIder.Count > 0)
            {
                var runder = await Db.Servicerunder
                    .Where(r => serviceProsjektIder.Contains(r.ProsjektId))
                    .ToListAsync();

                var terskel = DateTime.Today.AddDays(14);
                _serviceavtalerVarsel = serviceProsjektIder.Count(pid =>
                {
                    var neste = runder.Where(r => r.ProsjektId == pid)
                        .OrderByDescending(r => r.Dato)
                        .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;
                    return neste.HasValue && neste.Value.Date <= terskel;
                });
            }

            var siste7Dager = DateTime.Now.AddDays(-7);
            _nyligFakturerteOrdre = await Db.Arbeidsordre.CountAsync(a =>
                a.Status == ArbeidsordreStatus.Fakturert && a.FakturertDato != null && a.FakturertDato >= siste7Dager);

            _kunderTrengerOppfolging = await Db.Kunder.CountAsync(k =>
                k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today);

            _varerLavBeholdning = await Db.Components.CountAsync(c =>
                c.Aktiv && c.ILagerstyring && c.Minimumsbeholdning != null && c.Lagerantall <= c.Minimumsbeholdning.Value);

            var lisensTerskel = DateTime.Today.AddDays(30);
            _lisensVarsel = await Db.KundeLisenser.CountAsync(l => l.UtlopsDato.Date <= lisensTerskel);
        }

        _alleStats =
        [
            new("/prosjekter", "folder", _aktiveProsjekter, "Aktive prosjekter", false),
            new(null, "alert", _avvikSomVenter, "Avvik venter", _avvikSomVenter > 0),
            new("/kalender", "calendar", _dagensJobber, "Dagens jobber", false),
            new("/arbeidsordre", "check-circle", _ferdigDenneUken, "Ferdig denne uken", false),
        ];

        if (_visServiceavtaleVarsel)
        {
            _alleStats.Add(new("/service", "clock", _serviceavtalerVarsel, "Serviceavtaler nærmer seg forfall", _serviceavtalerVarsel > 0));
            _alleStats.Add(new("/arbeidsordre/fakturert", "receipt", _nyligFakturerteOrdre, "Fakturert siste 7 dager", false));
            _alleStats.Add(new("/kundeoppfolging", "users", _kunderTrengerOppfolging, "Kunder trenger oppfølging", _kunderTrengerOppfolging > 0));
            _alleStats.Add(new("/lager", "box", _varerLavBeholdning, "Lav lagerbeholdning", _varerLavBeholdning > 0));
            _alleStats.Add(new("/lisenser", "clock", _lisensVarsel, "Lisenser går ut snart", _lisensVarsel > 0));
        }
    }

