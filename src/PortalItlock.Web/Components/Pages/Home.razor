    private int FakturaTotalt => _fakturaPerManed.Sum(m => m.Antall);

    private static string FormatKr(decimal verdi) =>
        verdi.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) + " kr";

    private string FakturaSumFormatert => FormatKr(_fakturaSum);

    private (string Linje, string Omrade, double Lengde, List<GrafPunkt> Punkter) FakturaGraf
    {
        get
        {
            const double bredde = 300;
            const double hoyde = 100;
            const double toppMargin = 14;
            const double bunn = hoyde - 8;

            var maks = _fakturaPerManed.Count > 0 ? _fakturaPerManed.Max(m => m.Antall) : 0;
            var antallPunkter = _fakturaPerManed.Count;
            var steg = antallPunkter > 1 ? bredde / (antallPunkter - 1) : 0;

            var punkter = _fakturaPerManed
                .Select((m, i) =>
                {
                    var x = i * steg;
                    var y = maks == 0
                        ? bunn
                        : bunn - (m.Antall / (double)maks) * (bunn - toppMargin);
                    return new GrafPunkt(x, y);
                })
                .ToList();

            if (punkter.Count == 0)
            {
                return ("", "", 1, punkter);
            }

            var kultur = System.Globalization.CultureInfo.InvariantCulture;
            var linje = "M " + string.Join(" L ", punkter.Select(p =>
                $"{p.X.ToString(kultur)},{p.Y.ToString(kultur)}"));

            var omrade = linje
                + $" L {punkter[^1].X.ToString(kultur)},{hoyde.ToString(kultur)}"
                + $" L {punkter[0].X.ToString(kultur)},{hoyde.ToString(kultur)} Z";

            var lengde = 0.0;
            for (var i = 1; i < punkter.Count; i++)
            {
                var dx = punkter[i].X - punkter[i - 1].X;
                var dy = punkter[i].Y - punkter[i - 1].Y;
                lengde += Math.Sqrt(dx * dx + dy * dy);
            }

            return (linje, omrade, Math.Max(lengde, 1), punkter);
        }
    }

    private int AktivitetHoyde(int antall)
    {
        var maks = _ukeAktivitet.Count > 0 ? _ukeAktivitet.Max(d => d.Antall) : 0;
        if (maks == 0)
        {
            return 6;
        }

        return Math.Max(6, (int)Math.Round(100.0 * antall / maks));
    }

    private static string Idag
    {
        get
        {
            var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
            var tekst = DateTime.Now.ToString("dddd d. MMMM", kultur);
            return char.ToUpper(tekst[0], kultur) + tekst[1..];
        }
    }
