@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Itlock Full Kontroll</PageTitle>

<div class="home-hero">
    <div class="home-hero-title-row">
        <h1>@(_tekst?.Tittel ?? "Itlock Full Kontroll")</h1>
        <div class="home-hero-emblem" aria-hidden="true">
            <div class="home-coin">
                <svg class="home-coin-face" viewBox="0 0 100 100">
                    <circle cx="50" cy="38" r="22" fill="currentColor" />
                    <path d="M38 50 L62 50 L70 88 L30 88 Z" fill="currentColor" />
                </svg>
                <svg class="home-coin-face home-coin-back" viewBox="0 0 100 100">
                    <circle cx="50" cy="38" r="22" fill="currentColor" />
                    <path d="M38 50 L62 50 L70 88 L30 88 Z" fill="currentColor" />
                </svg>
            </div>
        </div>
    </div>
    <p class="home-lede">
        @(_tekst?.Ingress ?? "Internt verktøy for prosjektering, befaring og det daglige arbeidet med dørpakker, komponenter og krav. Velg hvem du er, så finner du raskt det du trenger.")
    </p>
</div>

<div class="dashboard-grid">
    <a href="/prosjekter" class="dashboard-card">
        <Icon Name="folder" />
        <span class="dashboard-tall">@_aktiveProsjekter</span>
        <span class="dashboard-label">Aktive prosjekter</span>
    </a>
    <div class="dashboard-card">
        <Icon Name="alert" />
        <span class="dashboard-tall">@_avvikSomVenter</span>
        <span class="dashboard-label">Avvik som venter på godkjenning</span>
    </div>
    <a href="/kalender" class="dashboard-card">
        <Icon Name="calendar" />
        <span class="dashboard-tall">@_dagensJobber</span>
        <span class="dashboard-label">Dagens jobber</span>
    </a>
    <a href="/arbeidsordre" class="dashboard-card">
        <Icon Name="check-circle" />
        <span class="dashboard-tall">@_ferdigDenneUken</span>
        <span class="dashboard-label">Ferdigstilt denne uken</span>
    </a>
    @if (_visServiceavtaleVarsel)
    {
        <a href="/serviceavtaler" class="dashboard-card @(_serviceavtalerVarsel > 0 ? "dashboard-card-varsel" : "")">
            <Icon Name="clock" />
            <span class="dashboard-tall">@_serviceavtalerVarsel</span>
            <span class="dashboard-label">Serviceavtaler som nærmer seg forfall</span>
        </a>
        <a href="/arbeidsordre/fakturert" class="dashboard-card">
            <Icon Name="receipt" />
            <span class="dashboard-tall">@_nyligFakturerteOrdre</span>
            <span class="dashboard-label">Ordre ferdigmeldt siste 7 dager</span>
        </a>
        <a href="/kundeoppfolging" class="dashboard-card @(_kunderTrengerOppfolging > 0 ? "dashboard-card-varsel" : "")">
            <Icon Name="users" />
            <span class="dashboard-tall">@_kunderTrengerOppfolging</span>
            <span class="dashboard-label">Kunder som trenger oppfølging</span>
        </a>
        <a href="/lager" class="dashboard-card @(_varerLavBeholdning > 0 ? "dashboard-card-varsel" : "")">
            <Icon Name="box" />
            <span class="dashboard-tall">@_varerLavBeholdning</span>
            <span class="dashboard-label">Varer med lav lagerbeholdning</span>
        </a>
    }
</div>

<div class="role-grid">
    @foreach (var rolle in Roller)
    {
        <button type="button"
                class="role-card @(_valgtRolle == rolle.Nokkel ? "role-card-active" : "")"
                @onclick="@(() => VelgRolle(rolle.Nokkel))">
            <span class="role-card-title">@TittelFor(rolle)</span>
            <span class="role-card-desc">@BeskrivelseFor(rolle)</span>
        </button>
    }
</div>

@if (_valgtRolle is not null)
{
    var valgt = Roller.First(r => r.Nokkel == _valgtRolle);

    <div class="home-links-panel @(_valgtRolle is "prosjektledere" or "admin" ? "home-links-panel-row" : "")">
        @foreach (var gruppe in valgt.Grupper)
        {
            <div class="home-links-gruppe">
                <h2 class="home-links-gruppe-navn">@gruppe.Navn</h2>
                <div class="home-links">
                    @foreach (var link in gruppe.Lenker)
                    {
                        <a class="home-card" href="@link.Href">
                            <span class="home-card-title">@link.Tittel</span>
                            <span class="home-card-desc">@link.Beskrivelse</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}

@if (VisBiler)
{
    <div class="home-drive-strip" aria-hidden="true">
        @foreach (var delay in DriveDelays)
        {
            <div class="home-drive-track" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                <div class="home-drive-shadow" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s"></div>
                <div class="home-drive-tilt">
                    <img src="img/itlock-bil.png?v=6" alt="" class="home-drive-car" />
                </div>
            </div>
        }
    </div>
}

<p class="home-footer">Laget av Marius Karlsen, itlock AS</p>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private sealed record Lenke(string Tittel, string Beskrivelse, string Href);
    private sealed record LenkeGruppe(string Navn, List<Lenke> Lenker);
    private sealed record Rolle(string Nokkel, string Tittel, string Beskrivelse, List<LenkeGruppe> Grupper);

    // Negative animation-delay hopper hver bil rett inn på et gitt punkt i
    // 13s-syklusen, slik at de fordeler seg jevnt etter hverandre langs banen.
    private static readonly double[] DriveDelays = [0, -3.25, -6.5, -9.75];

    // Sett til true igjen for å vise de kjørende servicebilene på forsiden.
    private const bool VisBiler = false;

    private string? _valgtRolle;
    private HjemmesideTekst? _tekst;

    private int _aktiveProsjekter;
    private int _avvikSomVenter;
    private int _dagensJobber;
    private int _ferdigDenneUken;
    private int _serviceavtalerVarsel;
    private bool _visServiceavtaleVarsel;
    private int _nyligFakturerteOrdre;
    private int _kunderTrengerOppfolging;
    private int _varerLavBeholdning;

    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (rolleClaim == "Kunde")
        {
            Nav.NavigateTo("/kunde", forceLoad: true);
            return;
        }

        BrukerRolle? rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : null;
        int? brukerId = null;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
        {
            brukerId = bid;
        }

        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();

        var mandag = FinnForrigeMandag(DateTime.Today);
        var sondag = mandag.AddDays(6);

        _aktiveProsjekter = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Aktiv);
        _avvikSomVenter = await Db.Avvik.CountAsync(a => a.Status == AvvikStatus.SendtTilKunde);

        var dagensQuery = Db.Arbeidsordre.Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today);
        var ferdigQuery = Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig
            && a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= mandag && a.PlanlagtDato.Value.Date <= sondag);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            dagensQuery = dagensQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
            ferdigQuery = ferdigQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        _dagensJobber = await dagensQuery.CountAsync();
        _ferdigDenneUken = await ferdigQuery.CountAsync();

        _visServiceavtaleVarsel = rolle == BrukerRolle.Admin || rolle == BrukerRolle.Prosjektleder;
        if (_visServiceavtaleVarsel)
        {
            var serviceProsjektIder = await Db.Prosjekter
                .Where(p => p.Status == ProsjektStatus.Serviceavtale)
                .Select(p => p.Id)
                .ToListAsync();

            if (serviceProsjektIder.Count > 0)
            {
                var runder = await Db.Servicerunder
                    .Where(r => serviceProsjektIder.Contains(r.ProsjektId))
                    .ToListAsync();

                var terskel = DateTime.Today.AddDays(14);
                _serviceavtalerVarsel = serviceProsjektIder.Count(pid =>
                {
                    var neste = runder.Where(r => r.ProsjektId == pid)
                        .OrderByDescending(r => r.Dato)
                        .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;
                    return neste.HasValue && neste.Value.Date <= terskel;
                });
            }

            var siste7Dager = DateTime.Now.AddDays(-7);
            _nyligFakturerteOrdre = await Db.Arbeidsordre.CountAsync(a =>
                a.Status == ArbeidsordreStatus.Fakturert && a.FakturertDato != null && a.FakturertDato >= siste7Dager);

            _kunderTrengerOppfolging = await Db.Kunder.CountAsync(k =>
                k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today);

            _varerLavBeholdning = await Db.Components.CountAsync(c =>
                c.Aktiv && c.ILagerstyring && c.Minimumsbeholdning != null && c.Lagerantall <= c.Minimumsbeholdning.Value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hjem.js?v=1");
        await _module.InvokeVoidAsync("attachTilt", ".dashboard-card");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }

    private void VelgRolle(string nokkel)
    {
        _valgtRolle = _valgtRolle == nokkel ? null : nokkel;
    }

    private string TittelFor(Rolle rolle) => (rolle.Nokkel, _tekst) switch
    {
        ("montorer", { } t) => t.MontorerTittel,
        ("prosjektledere", { } t) => t.ProsjektlederTittel,
        ("admin", { } t) => t.AdminTittel,
        _ => rolle.Tittel,
    };

    private string BeskrivelseFor(Rolle rolle) => (rolle.Nokkel, _tekst) switch
    {
        ("montorer", { } t) => t.MontorerBeskrivelse,
        ("prosjektledere", { } t) => t.ProsjektlederBeskrivelse,
        ("admin", { } t) => t.AdminBeskrivelse,
        _ => rolle.Beskrivelse,
    };

    private static readonly List<Rolle> Roller =
    [
        new Rolle(
            "montorer",
            "For montører",
            "Guide, befaring og vedlegg til bruk i felt",
            [
                new LenkeGruppe("Moduler", [
                    new Lenke("Befaring", "Befaringsliste og utskiftning av lås", "befaringsmodul"),
                    new Lenke("Guider", "Kobling, dørmiljø og oppsett adgangskontroll", "guidermodul"),
                    new Lenke("Prosjekt", "Prosjekter og arbeidsordre", "prosjektmodul"),
                    new Lenke("Timer og fravær", "Fravær og timeregistrering", "timerfravarmodul"),
                ]),
                new LenkeGruppe("Kart og kalender", [
                    new Lenke("Kart", "Se dagens jobber geografisk", "kart"),
                    new Lenke("Kalender", "Se planlagte arbeidsordre i månedsvisning", "kalender"),
                ]),
            ]),
        new Rolle(
            "prosjektledere",
            "For prosjektledere",
            "Systemer, prosjektering og prosjekter",
            [
                new LenkeGruppe("Prosjektering", [
                    new Lenke("Prosjektering", "Prosjekter, dørpakker, prisoverslag, serviceavtaler og systemregister samlet på ett sted", "prosjekteringmodul"),
                ]),
                new LenkeGruppe("Kunder", [
                    new Lenke("Kunder", "Kunderegister, oppfølging, portaltilgang og tilvalg samlet på ett sted", "kundemodul"),
                ]),
                new LenkeGruppe("Drift", [
                    new Lenke("Drift", "Kart, kalender og fravær samlet på ett sted", "driftmodul"),
                ]),
            ]),
        new Rolle(
            "admin",
            "For admin",
            "Opprett og vedlikehold grunnlagsdata",
            [
                new LenkeGruppe("Oppsett og maler", [
                    new Lenke("Oppsett og maler", "Dørpakker, krav, sjekklister, tilvalg og dokumenter samlet på ett sted", "oppsettmodul"),
                ]),
                new LenkeGruppe("Komponenter og priser", [
                    new Lenke("Komponenter og priser", "Komponentregister, prisimport, rabattgrupper og lagerstyring samlet på ett sted", "komponentprismodul"),
                ]),
                new LenkeGruppe("Brukere og kunder", [
                    new Lenke("Brukere og kunder", "Brukere, kunder, kundeoppfølging og fravær samlet på ett sted", "brukerkundemodul"),
                ]),
            ]),
    ];
}
