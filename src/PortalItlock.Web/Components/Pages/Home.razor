    private static string Idag
    {
        get
        {
            var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
            var tekst = DateTime.Now.ToString("dddd d. MMMM", kultur);
            return char.ToUpper(tekst[0], kultur) + tekst[1..];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Hurtigvalgene ligger i nettleseren, så de kan først hentes når det
        // finnes en JS-forbindelse - altså etter første render.
        if (firstRender && AktivLayout == HjemLayout.Dashboard3)
        {
            await LastHurtigvalg();
            StateHasChanged();
        }

        if (AktivLayout != HjemLayout.Dashboard3 || _hd3KartPunkter.Count == 0)
        {
            return;
        }

        if (!_hd3KartInitialisert)
        {
            // Kartet på forsiden er lite, og med standard klyngeradius (48px)
            // endte alle punktene i én eller to bobler man måtte zoome helt
            // inn for å åpne. Liten radius + tidlig oppsplitting gjør at man
            // ser de faktiske punktene med en gang.
            await JS.InvokeVoidAsync("kart.init", "hd3-kart", _hd3KartPunkter, null,
                new { klyngeRadius = 14, sluttKlyngeZoom = 10 });
            _hd3KartInitialisert = true;
            _hd3KartPunkterVedForrigeRender = _hd3KartPunkter.Count;
        }
        else if (_hd3KartPunkter.Count != _hd3KartPunkterVedForrigeRender)
        {
            // Nye punkter kan dukke opp etter at kartet først ble vist, siden
            // geokoding av manglende adresser nå skjer i bakgrunnen (se
            // GeokodHd3KartIBakgrunnenAsync) i stedet for å blokkere
            // sidevisningen. oppdaterPunkter tegner markørene på nytt uten å
            // nullstille kartets zoom/posisjon slik kart.init ville gjort.
            await JS.InvokeVoidAsync("kart.oppdaterPunkter", _hd3KartPunkter);
            _hd3KartPunkterVedForrigeRender = _hd3KartPunkter.Count;
        }
    }

    private int _hd3KartPunkterVedForrigeRender;
}
