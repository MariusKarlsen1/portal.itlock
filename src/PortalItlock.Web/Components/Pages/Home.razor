@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Itlock Full Kontroll</PageTitle>

<div class="home-hero">
    <h1>Itlock Full Kontroll</h1>
    <p class="home-lede">
        Internt verktøy for prosjektering, befaring og det daglige arbeidet med dørpakker,
        komponenter og krav. Velg hvem du er, så finner du raskt det du trenger.
    </p>
</div>

<div class="dashboard-grid">
    <a href="/prosjekter" class="dashboard-card">
        <span class="dashboard-tall">@_aktiveProsjekter</span>
        <span class="dashboard-label">Aktive prosjekter</span>
    </a>
    <div class="dashboard-card">
        <span class="dashboard-tall">@_avvikSomVenter</span>
        <span class="dashboard-label">Avvik som venter på godkjenning</span>
    </div>
    <a href="/kalender" class="dashboard-card">
        <span class="dashboard-tall">@_dagensJobber</span>
        <span class="dashboard-label">Dagens jobber</span>
    </a>
    <a href="/arbeidsordre" class="dashboard-card">
        <span class="dashboard-tall">@_ferdigDenneUken</span>
        <span class="dashboard-label">Ferdigstilt denne uken</span>
    </a>
</div>

<div class="role-grid">
    @foreach (var rolle in Roller)
    {
        <button type="button"
                class="role-card @(_valgtRolle == rolle.Nokkel ? "role-card-active" : "")"
                @onclick="@(() => VelgRolle(rolle.Nokkel))">
            <span class="role-card-title">@rolle.Tittel</span>
            <span class="role-card-desc">@rolle.Beskrivelse</span>
        </button>
    }
</div>

@if (_valgtRolle is not null)
{
    var valgt = Roller.First(r => r.Nokkel == _valgtRolle);

    <div class="home-links">
        @foreach (var link in valgt.Lenker)
        {
            <a class="home-card" href="@link.Href">
                <span class="home-card-title">@link.Tittel</span>
                <span class="home-card-desc">@link.Beskrivelse</span>
            </a>
        }
    </div>
}

<p class="home-footer">Laget av Marius Karlsen, itlock AS</p>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private sealed record Lenke(string Tittel, string Beskrivelse, string Href);
    private sealed record Rolle(string Nokkel, string Tittel, string Beskrivelse, List<Lenke> Lenker);

    private string? _valgtRolle;

    private int _aktiveProsjekter;
    private int _avvikSomVenter;
    private int _dagensJobber;
    private int _ferdigDenneUken;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (rolleClaim == "Kunde")
        {
            Nav.NavigateTo("/kunde", forceLoad: true);
            return;
        }

        BrukerRolle? rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : null;
        int? brukerId = null;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
        {
            brukerId = bid;
        }

        var mandag = FinnForrigeMandag(DateTime.Today);
        var sondag = mandag.AddDays(6);

        _aktiveProsjekter = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Aktiv);
        _avvikSomVenter = await Db.Avvik.CountAsync(a => a.Status == AvvikStatus.SendtTilKunde);

        var dagensQuery = Db.Arbeidsordre.Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today);
        var ferdigQuery = Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig
            && a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= mandag && a.PlanlagtDato.Value.Date <= sondag);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            dagensQuery = dagensQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
            ferdigQuery = ferdigQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        _dagensJobber = await dagensQuery.CountAsync();
        _ferdigDenneUken = await ferdigQuery.CountAsync();
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }

    private void VelgRolle(string nokkel)
    {
        _valgtRolle = _valgtRolle == nokkel ? null : nokkel;
    }

    private static readonly List<Rolle> Roller =
    [
        new Rolle(
            "montorer",
            "For montører",
            "Guide, befaring og vedlegg til bruk i felt",
            [
                new Lenke("Befaringsliste", "Sjekkliste og notater fra befaring", "befaringsliste"),
                new Lenke("Utskiftning av lås", "Sjekkliste med mål på dør, karm og hengsling", "lasutskifting"),
                new Lenke("Dørmiljø", "Tegninger til bruk på befaring og i prosjektering", "dormiljo"),
                new Lenke("Kobling", "Guide for kobling", "guide/kobling"),
                new Lenke("Oppsett adgangskontroll", "Guide for oppsett av adgangskontroll", "guide/oppsett-adgangskontroll"),
                new Lenke("Prosjekter", "Prosjekter du er lagt til på", "prosjekter"),
                new Lenke("Arbeidsordre", "Se arbeidsordre med info om jobben og ansvarlig montør", "arbeidsordre"),
                new Lenke("Timeregistrering", "Registrer timer på en arbeidsordre", "timeregistrering"),
                new Lenke("Kart", "Se dagens jobber geografisk", "kart"),
                new Lenke("Kalender", "Se planlagte arbeidsordre i månedsvisning", "kalender"),
            ]),
        new Rolle(
            "prosjektledere",
            "For prosjektledere",
            "Systemer, prosjektering og prosjekter",
            [
                new Lenke("Prosjekter", "Dører, plantegninger og montasjestatus per prosjekt", "prosjekter"),
                new Lenke("Finn dørpakke", "Huk av krav og finn riktig dørpakke til prosjektet", "finn-dorpakke"),
                new Lenke("Prisoverslag", "Rask kalkulator med komponenter, timer og påslag", "prisoverslag"),
                new Lenke("Systemregister", "Søk opp låssystem, kunde, adresse og rekvirenter", "systemregister"),
                new Lenke("Kart", "Se montørenes jobber geografisk for en valgt dag", "kart"),
                new Lenke("Kalender", "Se planlagte arbeidsordre for alle montører i månedsvisning", "kalender"),
            ]),
        new Rolle(
            "admin",
            "For admin",
            "Opprett og vedlikehold grunnlagsdata",
            [
                new Lenke("Ny pakke", "Sett sammen en ny dørpakke, eller rediger en eksisterende", "ny-pakke"),
                new Lenke("Kravdimensjoner", "Vedlikehold kravkategoriene kravvelgeren bygger på", "kravdimensjoner"),
                new Lenke("Dørfunksjoner", "Opprett og vedlikehold dørfunksjoner som kan legges på dører", "dorfunksjoner"),
                new Lenke("Komponentregister", "Søk, prissett og administrer komponenter og leverandører", "komponenter"),
                new Lenke("Prisimport", "Last opp prisliste fra leverandør, oppdater priser og legg til nye varer", "komponenter/prisimport"),
                new Lenke("Rabattgrupper", "Faste rabattavtaler per leverandør/produktserie, brukes til å beregne nettopris automatisk", "rabattgrupper"),
                new Lenke("Arbeidsordre", "Opprett arbeidsordre med info om jobben og ansvarlig montør", "arbeidsordre"),
                new Lenke("Sjekklistemaler", "Digitale sjekklister per dørtype til bruk på arbeidsordre", "sjekklistemaler"),
                new Lenke("Brukere", "Opprett brukere med e-post, stilling og tilgang til portalen", "brukere"),
                new Lenke("Kunder", "Opprett og vedlikehold kunderegisteret", "kunder"),
                new Lenke("Forsider", "Lag forside-/forbeholdstekster til bruk på tilbud", "forsider"),
                new Lenke("Timeoversikt", "Sammendrag og eksport av timer til lønn", "timeoversikt"),
            ]),
    ];
}
