@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject PortalItlock.Web.Services.GeocodingService Geokoding
@inject ProtectedLocalStorage LokalLagring
@inject IJSRuntime JS

<PageTitle>Full Kontroll</PageTitle>

<div class="home-page @(AktivLayout == HjemLayout.Dashboard3 ? "home-page-dash3" : "")">

    @if (_visNyhet && _sisteNyhet is not null)
    {
        <div class="nyhet-banner">
            <span class="nyhet-banner-ikon"><Icon Name="bell" /></span>
            <div class="nyhet-banner-innhold">
                <strong>@_sisteNyhet.Tittel</strong>
                <p>@_sisteNyhet.Innhold</p>
            </div>
            <button type="button" class="nyhet-banner-lukk" @onclick="LukkNyhet" aria-label="Lukk"><Icon Name="x" /></button>
        </div>
    }

    @if (AktivLayout == HjemLayout.Dashboard3)
    {
        <div class="hd3-greetrow">
            <div>
                <div class="hd3-greet-date">@Idag</div>
                <h1 class="hd3-greet-h1">@Hilsen</h1>
                <p class="hd3-greet-sub">@HeroSetning</p>
            </div>

            @* Samme nøkkeltall som den klassiske forsiden - Fakturert siste 7
               dager, lav lagerbeholdning og resten. Det er ikke plass til alle
               på én rad, så de bytter seg selv ut hvert 30. sekund. Prikkene
               under viser hvor mange sett det er, og kan klikkes. *@
            @if (_alleStats.Count > 0)
            {
                <div class="hd3-statwrap">
                    <div class="hd3-statrow">
                        @foreach (var stat in SynligeStats)
                        {
                            @if (stat.Href is null)
                            {
                                <div class="hd3-statcard" @key="stat.Label">
                                    <span class="hd3-statcard-ic @(stat.Varsel ? "hd3-ic-rod" : "hd3-ic-aksent")"><Icon Name="@stat.Ikon" /></span>
                                    <span class="hd3-statcard-tekst">
                                        <span class="hd3-statcard-num">@stat.Verdi</span>
                                        <span class="hd3-statcard-lbl">@stat.Label</span>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <a href="@($"{stat.Href}?fra=hjem")" class="hd3-statcard" @key="stat.Label">
                                    <span class="hd3-statcard-ic @(stat.Varsel ? "hd3-ic-rod" : "hd3-ic-aksent")"><Icon Name="@stat.Ikon" /></span>
                                    <span class="hd3-statcard-tekst">
                                        <span class="hd3-statcard-num">@stat.Verdi</span>
                                        <span class="hd3-statcard-lbl">@stat.Label</span>
                                    </span>
                                </a>
                            }
                        }
                    </div>

                    @if (AntallStatSider > 1)
                    {
                        <div class="hd3-statprikker">
                            @for (var i = 0; i < AntallStatSider; i++)
                            {
                                var side = i;
                                <button type="button"
                                        class="hd3-statprikk @(side == _statSide ? "hd3-statprikk-aktiv" : "")"
                                        aria-label="@($"Vis nøkkeltall {side + 1} av {AntallStatSider}")"
                                        @onclick="@(() => _statSide = side)"></button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Hurtigvalg + alle moduler, i stedet for de tre rolleknappene. Hvilke
           moduler som dukker opp her styres av tilgangen på hver enkelt modul
           (se PortalModulRegister), ikke av hvilken seksjon man går inn i.
           Hurtigvalgene lagres i nettleseren, ikke i databasen. *@
        <div class="hd3-modulrad">
            <section class="hd3-panel">
                <div class="hd3-panel-topp">
                    <h2 class="hd3-panel-tittel">Mine hurtigvalg</h2>
                    @* Tilpassingen startes fra Tilpass meny under navnet ditt
                       øverst - her står bare "Ferdig" for å komme ut igjen. *@
                    @if (_tilpasserHurtigvalg)
                    {
                        <button type="button" class="hd3-panel-knapp" @onclick="VekslTilpass">
                            <Icon Name="check" />Ferdig
                        </button>
                    }
                </div>

                @if (_tilpasserHurtigvalg)
                {
                    <p class="hd3-panel-hjelp">Stjernemerk modulene du vil ha som hurtigvalg.</p>
                    <div class="hd3-hurtiggrid">
                        @foreach (var lenke in BladLenker)
                        {
                            var erValgt = _hurtigvalg.Contains(lenke.Href);
                            <button type="button" class="hd3-hurtig @(erValgt ? "hd3-hurtig-valgt" : "")"
                                    @onclick="@(() => VekslHurtigvalg(lenke.Href))">
                                <span class="hd3-hurtig-stjerne @(erValgt ? "" : "hd3-hurtig-stjerne-av")">
                                    <Icon Name="@(erValgt ? "star" : "star-tom")" />
                                </span>
                                <span class="hd3-hurtig-ic"><Icon Name="@lenke.IconNavn" /></span>
                                <span class="hd3-hurtig-lbl">@lenke.Tittel</span>
                            </button>
                        }
                    </div>
                }
                else if (_hurtigvalgLastet && Hurtigvalg.Count == 0)
                {
                    <p class="home-dash-tom">Ingen hurtigvalg valgt ennå - trykk «Tilpass» for å legge til moduler her.</p>
                }
                else
                {
                    <div class="hd3-hurtiggrid">
                        @foreach (var lenke in Hurtigvalg)
                        {
                            <a href="@($"/{lenke.Href}?fra=hjem")" class="hd3-hurtig">
                                <span class="hd3-hurtig-stjerne"><Icon Name="star" /></span>
                                <span class="hd3-hurtig-ic"><Icon Name="@lenke.IconNavn" /></span>
                                <span class="hd3-hurtig-lbl">@lenke.Tittel</span>
                            </a>
                        }
                    </div>
                }
            </section>

            <section class="hd3-panel">
                <div class="hd3-panel-topp">
                    <h2 class="hd3-panel-tittel">Alle moduler</h2>
                    @if (Kategorier.Count > AntallSynligeKategorier)
                    {
                        <button type="button" class="hd3-panel-knapp hd3-panel-knapp-flat" @onclick="@(() => _viserAlleKategorier = !_viserAlleKategorier)">
                            @(_viserAlleKategorier ? "Vis færre" : "Se alle")
                            <Icon Name="@(_viserAlleKategorier ? "chevron-left" : "chevron-right")" />
                        </button>
                    }
                </div>
                <div class="hd3-kategorigrid">
                    @foreach (var kategori in SynligeKategorier)
                    {
                        <button type="button" class="hd3-kategori" @onclick="@(() => VelgRolle(kategori.Nokkel))">
                            <span class="hd3-kategori-plus" aria-hidden="true"><Icon Name="plus" /></span>
                            <span class="hd3-kategori-ic hd3-kat-@kategori.Nokkel"><Icon Name="@IkonForRolle(kategori.Nokkel)" /></span>
                            <span class="hd3-kategori-tekst">
                                <span class="hd3-kategori-navn">@kategori.Tittel</span>
                                <span class="hd3-kategori-sub">@kategori.Beskrivelse</span>
                            </span>
                        </button>
                    }
                </div>
            </section>
        </div>

        @* Ett rutenett for alle fem widgetene, ikke to rader - det er det som
           lar kartet i midten spenne over begge radene og gå helt ned til
           bunnen av "Hendelser og kundeoppfølging". Plasseringen:

             Kalender    | Kart      | Forespørsler, drift og ferdigmeldt
             Prosjekter  | (kartet)  | Hendelser og kundeoppfølging

           Kartet er det eneste med eksplisitt plassering; de fire andre
           autoplasseres og hopper over cellene kartet har tatt. *@
        <div class="hd3-widgetgrid hd3-widgetgrid-to-rader">
            @* Kalender med tidsakse: samme uke-oppsett som /kalender, men
               komprimert til en widget. Leser kun arbeidsordre - ingen
               planlegging skjer her, man klikker seg videre til ordren. *@
            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="calendar" /></span><span class="hd3-widget-title">Kalender &ndash; uke @_kalUkenummer</span></span>
                    <span class="hd3-kal-nav">
                        <button type="button" class="hd3-kal-navknapp" @onclick="ForrigeUke" aria-label="Forrige uke"><Icon Name="chevron-left" /></button>
                        <button type="button" class="hd3-kal-navknapp" @onclick="NesteUke" aria-label="Neste uke"><Icon Name="chevron-right" /></button>
                        <button type="button" class="hd3-kal-idag" @onclick="GaTilDenneUken">I dag</button>
                        <a href="/kalender?fra=hjem" class="hd3-widget-link">Åpne<Icon Name="chevron-down" /></a>
                    </span>
                </div>
                <div class="hd3-kal-dagrad">
                    <span></span>
                    @foreach (var d in _kalDager)
                    {
                        <span class="hd3-kal-dag @(d.ErIDag ? "hd3-kal-dag-idag" : "")">
                            <span class="hd3-kal-dagnavn">@d.Navn</span>
                            <span class="hd3-kal-dagdato">@d.DatoTekst</span>
                        </span>
                    }
                </div>
                <div class="hd3-kal-rute">
                    <div class="hd3-kal-akse">
                        @foreach (var t in KalenderTimer)
                        {
                            <span class="hd3-kal-time" style="top:@KalTopp(t)">@(t.ToString("00")):00</span>
                        }
                    </div>
                    @foreach (var d in _kalDager)
                    {
                        <div class="hd3-kal-kolonne">
                            @foreach (var t in KalenderTimer)
                            {
                                <span class="hd3-kal-linje" style="top:@KalTopp(t)"></span>
                            }
                            @foreach (var h in d.Hendelser)
                            {
                                <a href="@h.Href" class="hd3-kal-hendelse" title="@($"{h.Tittel} · {h.TidTekst}")"
                                   style="top:@h.Topp;height:@h.Hoyde;left:@h.Venstre;width:@h.Bredde;border-left-color:@h.Kant;background:@h.Flate;color:@h.Blekk">
                                    <span class="hd3-kal-h-tittel">@h.Tittel</span>
                                    <span class="hd3-kal-h-sted">@h.Sted</span>
                                    <span class="hd3-kal-h-tid">@h.TidTekst</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="hd3-widget hd3-widget-kart">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="map" /></span><span class="hd3-widget-title">Aktivitet på kart</span></span>
                    <span class="hd3-kart-topp-hoyre">
                        <span class="hd3-kart-legend">
                            <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#9A4E24"></span>Service</span>
                            <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#0b66e6"></span>Prosjekt</span>
                            <span class="hd3-kart-legend-item"><span class="hd3-kart-legend-dot" style="background:#0c9c5c"></span>Arbeidsordre</span>
                        </span>
                        @* Samme to flatene som kartsidene ellers i portalen
                           bruker (se kart.js settBakgrunn). *@
                        <span class="hd3-kart-flatevelger">
                            <button type="button" class="hd3-kart-flate @(_hd3KartFlate == "kart" ? "aktiv" : "")"
                                    @onclick="@(() => ByttKartflate("kart"))">Kart</button>
                            <button type="button" class="hd3-kart-flate @(_hd3KartFlate == "satellitt" ? "aktiv" : "")"
                                    @onclick="@(() => ByttKartflate("satellitt"))">Satellitt</button>
                        </span>
                    </span>
                </div>
                <div class="hd3-mapwrap"><div id="hd3-kart" class="hd3-kart"></div></div>
            </div>

            @* Flyttet opp hit fra rad 2, og utvidet med ferdigmeldte ordrer -
               widgeten viser nå begge retninger: det som kommer inn, og det
               som er gjort unna. *@
            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="bell" /></span><span class="hd3-widget-title">Forespørsler, drift og ferdigmeldt</span></span>
                    <a href="/foresporsler?fra=hjem" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_hd3Oppgaver.Count == 0)
                {
                    <p class="home-dash-tom">Ingen nye forespørsler, driftsmeldinger eller ferdigmeldte ordrer.</p>
                }
                else
                {
                    @foreach (var o in _hd3Oppgaver)
                    {
                        <a href="@o.Href" class="hd3-wl">
                            <span class="hd3-wl-ic" style="background:@o.BakgrunnFarge;color:@o.Farge"><Icon Name="@o.Ikon" /></span>
                            <span class="hd3-wl-info"><span class="hd3-wl-title">@o.Navn</span><span class="hd3-wl-sub">@o.Undertekst</span></span>
                            <span class="hd3-wl-right"><span class="hd3-wl-time">@o.DatoTekst</span><span class="hd3-wl-chev"><Icon Name="chevron-down" /></span></span>
                        </a>
                    }
                }
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="folder" /></span><span class="hd3-widget-title">Pågående prosjekter</span></span>
                    <a href="/prosjekter" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_dashAktiveProsjekter.Count == 0)
                {
                    <p class="home-dash-tom">Ingen aktive prosjekter akkurat nå.</p>
                }
                else
                {
                    @foreach (var p in _dashAktiveProsjekter)
                    {
                        var fremdrift = ProsjektFremdrift(p);
                        <a href="@($"/prosjekter/{p.Id}")" class="hd3-wl">
                            <span class="hd3-wl-ic hd3-ic-aksent"><Icon Name="folder" /></span>
                            <span class="hd3-wl-info" style="flex:0 0 120px;"><span class="hd3-wl-title">@p.Navn</span><span class="hd3-wl-sub">@ProsjektSted(p)</span></span>
                            <span class="hd3-progress-track"><span class="hd3-progress-fill" style="width:@(fremdrift)%"></span></span>
                            <span class="hd3-progress-pct">@(fremdrift)%</span>
                        </a>
                    }
                }
            </div>

            <div class="hd3-widget">
                <div class="hd3-widget-head">
                    <span class="hd3-widget-head-l"><span class="hd3-widget-ic"><Icon Name="bell" /></span><span class="hd3-widget-title">Hendelser og kundeoppfølging</span></span>
                    <a href="/tilbud?fra=hjem" class="hd3-widget-link">Se alle<Icon Name="chevron-down" /></a>
                </div>
                @if (_hd3Meldinger.Count == 0)
                {
                    <p class="home-dash-tom">Ingen hendelser eller kundeoppfølging registrert ennå.</p>
                }
                else
                {
                    @foreach (var m in _hd3Meldinger)
                    {
                        <a href="@m.Href" class="hd3-wl">
                            <span class="hd3-wl-ic" style="background:@m.BakgrunnFarge;color:@m.Farge"><Icon Name="@m.Ikon" /></span>
                            <span class="hd3-wl-info"><span class="hd3-wl-title">@m.Tittel</span><span class="hd3-wl-sub">@m.Undertekst</span></span>
                            <span class="hd3-wl-right"><span class="hd3-wl-time">@m.TidTekst</span><span class="hd3-wl-dot" style="background:@m.Farge"></span></span>
                        </a>
                    }
                }
            </div>
        </div>
    }
    else if (AktivLayout == HjemLayout.Bilde)
    {
        <div class="home-dash-hero">
            <img src="home-hero-montor.png?v=6" alt="" class="home-dash-hero-img" draggable="false" />
            <div class="home-dash-hero-scrim"></div>
            <div class="home-dash-hero-top-scrim"></div>

            <div class="home-dash-hero-text">
                <span class="home-dash-date-pill">@Idag</span>
                @if (Hilsen is not null)
                {
                    <h1>@Hilsen</h1>
                }
                @if (HeroSetning is not null)
                {
                    <p>@HeroSetning</p>
                }
            </div>
        </div>

        @* Samme modulkategorier som på hoveddashboardet - ingen rolleknapper
           igjen i noen av Hjem-stilene. *@
        <div class="home-dash-roles">
            @foreach (var kategori in SynligeKategorier)
            {
                <button type="button" class="home-dash-role-card" @onclick="@(() => VelgRolle(kategori.Nokkel))">
                    <span class="home-dash-role-vannmerke" aria-hidden="true"><Icon Name="@IkonForRolle(kategori.Nokkel)" /></span>
                    <span class="home-dash-role-ikon"><Icon Name="@IkonForRolle(kategori.Nokkel)" /></span>
                    <span class="home-dash-role-text">
                        <span class="home-dash-role-title">@kategori.Tittel</span>
                        <span class="home-dash-role-desc">@kategori.Beskrivelse</span>
                    </span>
                    <span class="home-dash-role-pil"><Icon Name="chevron-down" /></span>
                </button>
            }
            @if (Kategorier.Count > AntallSynligeKategorier)
            {
                <button type="button" class="home-dash-role-card home-dash-role-mer" @onclick="@(() => _viserAlleKategorier = !_viserAlleKategorier)">
                    <span class="home-dash-role-ikon"><Icon Name="@(_viserAlleKategorier ? "chevron-left" : "grid")" /></span>
                    <span class="home-dash-role-text">
                        <span class="home-dash-role-title">@(_viserAlleKategorier ? "Vis færre" : "Se alle moduler")</span>
                        <span class="home-dash-role-desc">@(_viserAlleKategorier ? "Vis bare de vanligste kategoriene" : $"{Kategorier.Count} kategorier totalt")</span>
                    </span>
                </button>
            }
        </div>

        <div class="home-dash-kpi">
            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="folder" /></span>
                    <div><div class="home-dash-kpi-tall">@_aktiveProsjekter</div><div class="home-dash-kpi-label">Aktive prosjekter</div></div>
                </div>
                <div class="home-dash-kpi-status home-dash-kpi-status-gronn">
                    @(_dashNyeProsjekterDenneUken > 0 ? $"+{_dashNyeProsjekterDenneUken} denne uken" : "Uendret denne uken")
                </div>
            </div>

            <a href="/arbeidsordre" class="home-dash-kpi-kort home-dash-kpi-link">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="check-circle" /></span>
                    <div><div class="home-dash-kpi-tall">@_dashApneArbeidsordre</div><div class="home-dash-kpi-label">Åpne arbeidsordrer</div></div>
                </div>
                @if (_dagensJobber > 0)
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-aksent">@_dagensJobber planlagt i dag</div>
                }
                else
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-gronn">Ingen planlagt i dag</div>
                }
                <span class="home-dash-kpi-pil"><Icon Name="chevron-down" /></span>
            </a>

            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="users" /></span>
                    <div><div class="home-dash-kpi-tall">@_dashMontorerUteIDag</div><div class="home-dash-kpi-label">Montører ute i dag</div></div>
                </div>
                <div class="home-dash-kpi-status home-dash-kpi-status-gronn">
                    @(_dashMontorerUteIDag > 0 ? $"{_dagensJobber} oppdrag totalt" : "Ingen ute i dag")
                </div>
            </div>

            <div class="home-dash-kpi-kort">
                <div class="home-dash-kpi-rad">
                    <span class="home-dash-kpi-ikon"><Icon Name="clock" /></span>
                    <div><div class="home-dash-kpi-tall">@(_dashTimerDenneUken.ToString("0")) t</div><div class="home-dash-kpi-label">Registrert denne uken</div></div>
                </div>
                @if (_dashTimerEndringProsent is { } endring)
                {
                    <div class="home-dash-kpi-status @(endring >= 0 ? "home-dash-kpi-status-gronn" : "home-dash-kpi-status-aksent")">@(endring >= 0 ? "+" : "")@(endring.ToString("0")) % fra forrige uke</div>
                }
                else
                {
                    <div class="home-dash-kpi-status home-dash-kpi-status-gronn">Denne uken</div>
                }
            </div>
        </div>

        <div class="home-dash-grid">
            <div class="home-dash-panel">
                <div class="home-dash-panel-header">
                    <span><Icon Name="folder" />Aktive prosjekter</span>
                    <a href="/prosjekter">Se alle &rarr;</a>
                </div>
                @if (_dashAktiveProsjekter.Count == 0)
                {
                    <p class="home-dash-tom">Ingen aktive prosjekter akkurat nå.</p>
                }
                else
                {
                    <div class="home-dash-panel-liste">
                        @foreach (var p in _dashAktiveProsjekter)
                        {
                            var fremdrift = ProsjektFremdrift(p);
                            <a href="@($"/prosjekter/{p.Id}")" class="home-dash-prosjekt-rad">
                                <img class="home-dash-prosjekt-bilde" src="home-prosjekt-standard.png" alt="" />
                                <span class="home-dash-prosjekt-info">
                                    <span class="home-dash-prosjekt-navn">@p.Navn</span>
                                    <span class="home-dash-prosjekt-sted">@ProsjektSted(p)</span>
                                    <span class="home-dash-prosjekt-progress">
                                        <span class="home-dash-progress-track"><span class="home-dash-progress-fill" style="width:@(fremdrift)%"></span></span>
                                        <span class="home-dash-progress-tall">@(fremdrift)%</span>
                                    </span>
                                </span>
                                <span class="home-dash-pill home-dash-pill-gronn">Pågående</span>
                                <span class="home-dash-prosjekt-pil"><Icon Name="chevron-down" /></span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="home-dash-panel">
                <div class="home-dash-panel-header">
                    <span><Icon Name="check-circle" />Dagens arbeidsordrer</span>
                    <a href="/arbeidsordre">Se alle &rarr;</a>
                </div>
                @if (_dashDagensArbeidsordre.Count == 0)
                {
                    <p class="home-dash-tom">Ingen arbeidsordre planlagt i dag.</p>
                }
                else
                {
                    <div class="home-dash-panel-liste">
                        @foreach (var a in _dashDagensArbeidsordre)
                        {
                            <a href="@($"/arbeidsordre/{a.Id}")" class="home-dash-ao-rad">
                                <span class="home-dash-ao-ikon"><Icon Name="@a.Status.PillIkon()" /></span>
                                <span class="home-dash-ao-tid">@(a.PlanlagtDato?.ToString("HH:mm"))</span>
                                <span class="home-dash-ao-info">
                                    <span class="home-dash-ao-tittel">@a.Tittel</span>
                                    <span class="home-dash-ao-sted">@(a.Prosjekt?.Navn ?? a.Sted)</span>
                                </span>
                                @if (ArbeidsordrePagar(a))
                                {
                                    <span class="home-dash-pill home-dash-pill-gronn">Pågår</span>
                                }
                                else if (a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert)
                                {
                                    <span class="home-dash-pill home-dash-pill-gronn">Ferdig</span>
                                }
                                else
                                {
                                    <span class="home-dash-pill home-dash-pill-beige">Ikke startet</span>
