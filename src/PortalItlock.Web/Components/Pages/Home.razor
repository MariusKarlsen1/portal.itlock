                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="home-hero-banner">
            <div class="home-hero-inner">
                <div class="home-hero-text">
                    <span class="home-dato-pill">@Idag</span>
                    @if (Hilsen is not null)
                    {
                        <h1 class="home-hilsen">@Hilsen</h1>
                    }
                    @if (HeroSetning is not null)
                    {
                        <p class="home-hero-sub">@HeroSetning</p>
                    }
                </div>

                @if (_alleStats.Count > 0)
                {
                    <div class="home-hero-stats-wrap">
                        <div class="home-hero-stats-marquee">
                            <div class="home-hero-stats-track" style="animation-duration:@(MarqueeVarighet.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                                @foreach (var stat in _alleStats)
                                {
                                    @StatMarkup(stat)
                                }
                                <div class="home-hero-stats-dup" aria-hidden="true">
                                    @foreach (var stat in _alleStats)
                                    {
                                        @StatMarkup(stat)
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_nesteJobb is not null)
        {
            <a href="@($"/arbeidsordre/{_nesteJobb.Id}")" class="neste-jobb-kort">
                <span class="neste-jobb-ikon"><Icon Name="calendar" /></span>
                <span class="neste-jobb-tekst">
                    <span class="neste-jobb-label">Neste jobb i dag · @_nesteJobb.Klokkeslett</span>
                    <span class="neste-jobb-tittel">
                        @_nesteJobb.Tittel
                        @if (_nesteJobb.KundeNavn is not null)
                        {
                            <text> · @_nesteJobb.KundeNavn</text>
                        }
                    </span>
                    @if (_nesteJobb.Adresse is not null)
                    {
                        <span class="neste-jobb-adresse">@_nesteJobb.Adresse</span>
                    }
                </span>
                <span class="neste-jobb-pil"><Icon Name="chevron-down" /></span>
            </a>
        }

        <div class="home-divider" aria-hidden="true">
            <span class="home-divider-linje"></span>
        </div>

        @* Én felles modulseksjon i stedet for de tre rolleknappene. Kortene
           viser et utvalg; "Se alle" folder ut resten. Hva som vises styres av
           tilgangen på hver modul, ikke av hvilken seksjon man går inn i. *@
        <section class="home-section">
            <div class="modul-seksjon-topp">
                <h2 class="modul-seksjon-tittel">Alle moduler</h2>
                @if (Kategorier.Count > AntallSynligeKategorier)
                {
                    <button type="button" class="modul-se-alle" @onclick="@(() => _viserAlleKategorier = !_viserAlleKategorier)">
                        @(_viserAlleKategorier ? "Vis færre" : "Se alle")
                        <Icon Name="@(_viserAlleKategorier ? "chevron-left" : "chevron-right")" />
                    </button>
                }
            </div>
            <div class="role-grid">
                @foreach (var kategori in SynligeKategorier)
                {
                    <button type="button"
                            class="role-card role-card-@kategori.Nokkel @(_valgtRolle == kategori.Nokkel ? "role-card-active" : "")"
                            @onclick="@(() => VelgRolle(kategori.Nokkel))">
                        <span class="role-card-ikon"><Icon Name="@IkonForRolle(kategori.Nokkel)" /></span>
                        <span class="role-card-title">@kategori.Tittel</span>
                        <span class="role-card-desc">@kategori.Beskrivelse</span>
                    </button>
                }
            </div>
        </section>
    }

    @if (_valgtRolle is not null)
    {
        var valgt = Kategorier.First(k => k.Nokkel == _valgtRolle);
        var hub = _valgtHub;

        @* Kategorier som inneholder hub-moduler (i praksis Administrasjon)
           vises i et bredere vindu med ALT innholdet utbrettet med en gang -
           én overskrift per hub og modulene rett under. Slipper å klikke seg
           gjennom et ekstra nivå for å finne fram. *@
        var harHubber = hub is null && valgt.Grupper
            .SelectMany(g => g.Lenker)
            .Any(l => l.Undermoduler is { Count: > 0 });

        <div class="modul-modal-bakteppe" @onclick="LukkModulPanel">
            <div class="modul-modal modul-modal-@_valgtRolle @(harHubber ? "modul-modal-bred" : "")" @onclick:stopPropagation="true">
                <div class="modul-modal-header">
                    @if (hub is not null)
                    {
                        <button type="button" class="modul-modal-tilbake" @onclick="@(() => _valgtHub = null)" aria-label="Tilbake">
                            <Icon Name="arrow-left" />
                        </button>
                        <span class="modul-modal-ikon"><Icon Name="@hub.IconNavn" /></span>
                        <span class="modul-modal-header-tekst">
                            <span class="modul-modal-tittel">@hub.Tittel</span>
                            <span class="modul-modal-beskrivelse">@hub.Beskrivelse</span>
                        </span>
                    }
                    else
                    {
                        <span class="modul-modal-ikon"><Icon Name="@IkonForRolle(_valgtRolle)" /></span>
                        <span class="modul-modal-header-tekst">
                            <span class="modul-modal-tittel">@valgt.Tittel</span>
                            <span class="modul-modal-beskrivelse">@valgt.Beskrivelse</span>
                        </span>
                    }
                    <button type="button" class="modul-modal-lukk" @onclick="LukkModulPanel" aria-label="Lukk">
                        <Icon Name="x" />
                    </button>
                </div>
                <div class="modul-modal-innhold">
                    @if (hub is not null)
                    {
                        <div class="home-links">
                            @foreach (var link in hub.Undermoduler ?? [])
                            {
                                <a class="home-card" href="@($"{link.Href}?fra=hjem&rolle={_valgtRolle}&hub={hub.Href}")">
                                    <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                    <span class="home-card-tekst">
                                        <span class="home-card-title">@link.Tittel</span>
                                        <span class="home-card-desc">@link.Beskrivelse</span>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var gruppe in valgt.Grupper)
                        {
                            var vanlige = gruppe.Lenker.Where(l => l.Undermoduler is null or { Count: 0 }).ToList();
                            var hubber = gruppe.Lenker.Where(l => l.Undermoduler is { Count: > 0 }).ToList();

                            @if (vanlige.Count > 0)
                            {
                                <div class="home-links-gruppe">
                                    <h3 class="home-links-gruppe-navn">@gruppe.Navn</h3>
                                    <div class="home-links">
                                        @foreach (var link in vanlige)
                                        {
                                            <a class="home-card" href="@($"{link.Href}?fra=hjem&rolle={_valgtRolle}")">
                                                <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                                <span class="home-card-tekst">
                                                    <span class="home-card-title">@link.Tittel</span>
                                                    <span class="home-card-desc">@link.Beskrivelse</span>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            @* Hubene brettes ut: overskriften er hubens navn, og
                               modulene under ligger rett under den. *@
                            @foreach (var hubLenke in hubber)
                            {
                                <div class="home-links-gruppe">
                                    <h3 class="home-links-gruppe-navn">
                                        <span class="home-links-gruppe-ikon"><Icon Name="@hubLenke.IconNavn" /></span>
                                        @hubLenke.Tittel
                                    </h3>
                                    <div class="home-links">
                                        @foreach (var link in hubLenke.Undermoduler!)
                                        {
                                            <a class="home-card" href="@($"{link.Href}?fra=hjem&rolle={_valgtRolle}&hub={hubLenke.Href}")">
                                                <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                                <span class="home-card-tekst">
                                                    <span class="home-card-title">@link.Tittel</span>
                                                    <span class="home-card-desc">@link.Beskrivelse</span>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }

    @if (VisBiler)
    {
        <div class="home-drive-strip" aria-hidden="true">
            @foreach (var delay in DriveDelays)
            {
                <div class="home-drive-track" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                    <div class="home-drive-shadow" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s"></div>
                    <div class="home-drive-tilt">
                        <img src="img/itlock-bil.png?v=6" alt="" class="home-drive-car" />
                    </div>
                </div>
            }
        </div>
    }

    <p class="home-footer">Laget av Marius Karlsen</p>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // Negative animation-delay hopper hver bil rett inn på et gitt punkt i
    // 13s-syklusen, slik at de fordeler seg jevnt etter hverandre langs banen.
    private static readonly double[] DriveDelays = [0, -3.25, -6.5, -9.75];

    // Sett til true igjen for å vise de kjørende servicebilene på forsiden.
    private const bool VisBiler = false;

    private sealed record HeroStat(string? Href, string Ikon, int Verdi, string Label, bool Varsel);
    private sealed record NesteJobb(int Id, string Tittel, string Klokkeslett, string? KundeNavn, string? Adresse);

    // Sekunder pr. nøkkeltall i den kontinuerlige marquee-animasjonen -
    // styrer farten (holder tempoet likt uansett hvor mange nøkkeltall
    // som faktisk vises, siden varigheten skaleres med antallet).
    private const double MarqueeSekunderPrStat = 4.0;

    private string? _valgtRolle;
    private Lenke? _valgtHub;
    private HjemmesideTekst? _tekst;

    private int _aktiveProsjekter;
    private int _avvikSomVenter;
    private int _dagensJobber;
    private int _ferdigDenneUken;
    private int _serviceavtalerVarsel;
    private bool _visServiceavtaleVarsel;
    private int _nyligFakturerteOrdre;
    private int _kunderTrengerOppfolging;
    private int _varerLavBeholdning;
    private int _lisensVarsel;

    private List<HeroStat> _alleStats = [];

    // Nøkkeltallene på Dashboard3 ligger ved siden av hilsenen, og det er bare
    // plass til fire om gangen. Resten bytter seg inn hvert 30. sekund i
    // stedet for å presse kortene sammen eller lage en ekstra rad.
    private const int StatsPrSide = 4;
    private int _statSide;

    private int AntallStatSider =>
        _alleStats.Count == 0 ? 1 : (int)Math.Ceiling(_alleStats.Count / (double)StatsPrSide);

    private List<HeroStat> SynligeStats => _alleStats
        .Skip(Math.Min(_statSide, AntallStatSider - 1) * StatsPrSide)
        .Take(StatsPrSide)
        .ToList();

    private async Task RullerNokkeltallAsync(CancellationToken token)
    {
        try
        {
            using var klokke = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await klokke.WaitForNextTickAsync(token))
            {
                _statSide = (_statSide + 1) % AntallStatSider;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Siden er forlatt - ingenting å rydde opp i.
        }
    }
    private NesteJobb? _nesteJobb;

    // ---------- Data til det nye, bilde-baserte dashboardet (kun Fullversjon) ----------
    private List<Prosjekt> _dashAktiveProsjekter = [];
    private List<Arbeidsordre> _dashDagensArbeidsordre = [];
    private int _dashApneArbeidsordre;
    private int _dashMontorerUteIDag;
    private int _dashNyeProsjekterDenneUken;
    private decimal _dashTimerDenneUken;
    private decimal? _dashTimerEndringProsent;

    private static readonly ArbeidsordreStatus[] ApneArbeidsordreStatuser =
        [ArbeidsordreStatus.Ny, ArbeidsordreStatus.Klar, ArbeidsordreStatus.Pagaende];

    private async Task LastInnDashboardData(DateTime mandag, DateTime sondag)
    {
        _dashAktiveProsjekter = await Db.Prosjekter
            .Include(p => p.Arbeidsordre)
            .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.UnderArbeid || p.Status == ProsjektStatus.Serviceavtale)
            .OrderByDescending(p => p.OpprettetDato)
            .Take(3)
            .ToListAsync();

        _dashApneArbeidsordre = await Db.Arbeidsordre.CountAsync(a => ApneArbeidsordreStatuser.Contains(a.Status));

        _dashDagensArbeidsordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today)
            .OrderBy(a => a.PlanlagtDato)
            .Take(4)
            .ToListAsync();

        _dashMontorerUteIDag = await Db.Arbeidsordre
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today && a.AnsvarligMontorId != null)
            .Select(a => a.AnsvarligMontorId)
            .Distinct()
            .CountAsync();

        _dashNyeProsjekterDenneUken = await Db.Prosjekter.CountAsync(p => p.OpprettetDato >= mandag);

        var denneUkenTimer = await Db.Timeregistreringer
            .Where(t => t.Dato >= mandag && t.Dato <= sondag)
            .ToListAsync();
        _dashTimerDenneUken = denneUkenTimer.Sum(t => t.TotalTimer);

        var forrigeMandag = mandag.AddDays(-7);
        var forrigeTimer = await Db.Timeregistreringer
            .Where(t => t.Dato >= forrigeMandag && t.Dato < mandag)
            .ToListAsync();
        var forrigeSum = forrigeTimer.Sum(t => t.TotalTimer);
        _dashTimerEndringProsent = forrigeSum > 0
            ? Math.Round((_dashTimerDenneUken - forrigeSum) / forrigeSum * 100, 0)
            : null;
    }

    // ---------- Data til Dashboard3 (widget-rutenett med kart) ----------
    private sealed record Hd3Oppgave(string Href, string Navn, string Undertekst, string Ikon, string Farge, string BakgrunnFarge, string DatoTekst, DateTime SortDato);
    private sealed record Hd3Melding(string Href, string Tittel, string Undertekst, string Ikon, string Farge, string BakgrunnFarge, string TidTekst, DateTime SortDato);

    private List<Hd3Oppgave> _hd3Oppgaver = [];
    private List<Hd3Melding> _hd3Meldinger = [];

    private static readonly ArbeidsordreStatus[] Hd3ApneOrdreStatuser =
        [ArbeidsordreStatus.Ny, ArbeidsordreStatus.Klar, ArbeidsordreStatus.Pagaende];

    private async Task LastInnDashboard3Data()
    {
        // ---------- Kalenderuka ----------
        _kalMandag = FinnForrigeMandag(DateTime.Today);
        await LastKalenderUke();

        // ---------- Serviceavtaler og planlagte ordre: punkter til kartwidgeten ----------
        var serviceProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.Kunde)
            .ToListAsync();

        var planlagteOrdre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Where(a => Hd3ApneOrdreStatuser.Contains(a.Status) && a.PlanlagtDato != null)
            .ToListAsync();

        // ---------- Inn og ut: nye forespørsler, driftsmeldinger og
        // ferdigmeldte ordrer, nyeste først. Widgeten dekker begge retninger -
        // det som kommer inn, og det som er gjort unna. ----------
        var nyeForesporsler = await Db.Foresporsler
            .Where(f => !f.Lest)
            .OrderByDescending(f => f.MottattDato)
            .Take(6)
            .ToListAsync();

        var nyeDriftsmeldinger = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .Where(m => !m.LestAvAnsatt)
            .OrderByDescending(m => m.OpprettetDato)
            .Take(6)
            .ToListAsync();

        var ferdigmeldteSporring = Db.Arbeidsordre
            .AsNoTracking()
            .Include(a => a.Prosjekt)
            .Include(a => a.FullfortAvBruker)
            .Where(a => a.Status == ArbeidsordreStatus.Ferdig && a.FullfortDato != null);

        if (_naverendeRolle == BrukerRolle.Montor && _naverendeBruker is not null)
        {
            var mineId = _naverendeBruker.Id;
            ferdigmeldteSporring = ferdigmeldteSporring.Where(a => a.AnsvarligMontorId == mineId);
        }

        var ferdigmeldte = await ferdigmeldteSporring
            .OrderByDescending(a => a.FullfortDato)
            .Take(6)
            .ToListAsync();

        _hd3Oppgaver = nyeForesporsler
            .Select(f => new Hd3Oppgave(
                $"/foresporsler?id={f.Id}",
                f.Emne,
                string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn,
                "mail",
                "#2054a3",
                "#dbe7f7",
                Hd3RelativTid(f.MottattDato),
                f.MottattDato))
            .Concat(nyeDriftsmeldinger.Select(m => new Hd3Oppgave(
                $"/driftsmelding/{m.Id}",
                string.IsNullOrWhiteSpace(m.Tittel) ? $"Dør {m.Dor?.Dornummer}" : m.Tittel!,
                m.Dor?.Prosjekt?.Navn ?? "",
                "tool",
                "#a32020",
                "#f7d3d3",
                Hd3RelativTid(m.OpprettetDato),
                m.OpprettetDato)))
            .Concat(ferdigmeldte.Select(a => new Hd3Oppgave(
                $"/arbeidsordre/{a.Id}",
                a.Tittel,
                string.Join(" · ", new[]
                {
                    "Ferdigmeldt",
                    a.FullfortAvBruker?.Navn,
                    a.Prosjekt?.Navn
                }.Where(s => !string.IsNullOrWhiteSpace(s))),
                "check-circle",
                "#2b7a4b",
                "#d3ecdb",
                Hd3RelativTid(a.FullfortDato!.Value),
                a.FullfortDato!.Value)))
            .OrderByDescending(x => x.SortDato)
            .Take(7)
            .ToList();

        // ---------- Meldinger og varsler: tilbud-hendelser + kunder som trenger oppfølging ----------
        var tilbudHendelser = await Db.TilbudHendelser
            .Include(h => h.Tilbud)
            .OrderByDescending(h => h.Tidspunkt)
            .Take(4)
            .ToListAsync();

        var kunderTrengerOppfolging = await Db.Kunder
            .Where(k => k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today)
            .OrderBy(k => k.NesteOppfolgingsDato)
            .Take(4)
            .ToListAsync();

        _hd3Meldinger = tilbudHendelser
            .Where(h => h.Tilbud is not null)
            .Select(h =>
            {
                var (ikon, farge, bakgrunn, tittel) = Hd3HendelseVisning(h.Beskrivelse);
                return new Hd3Melding(
                    $"/tilbud/{h.TilbudId}",
                    $"{tittel} - {h.Tilbud!.Tittel}",
                    h.Beskrivelse,
                    ikon,
                    farge,
                    bakgrunn,
                    Hd3RelativTid(h.Tidspunkt),
                    h.Tidspunkt);
            })
            .Concat(kunderTrengerOppfolging.Select(k => new Hd3Melding(
                $"/kunder/{k.Id}",
                $"Oppfølging - {k.Navn}",
                "Trenger oppfølging",
                "users",
                "#a1690a",
                "#f4e3c7",
                Hd3RelativTid(k.NesteOppfolgingsDato!.Value),
                k.NesteOppfolgingsDato!.Value)))
            .OrderByDescending(x => x.SortDato)
            .Take(4)
            .ToList();

        await LastInnHd3KartAsync(serviceProsjekter, planlagteOrdre);
    }

    // ---------- Mine hurtigvalg ----------
    // Hurtigvalgene ligger i nettleseren (ProtectedLocalStorage), ikke i
    // databasen - ingen nye tabeller eller kolonner. Lista inneholder bare
    // Href-ene; hva som faktisk vises filtreres alltid mot modulene brukeren
    // har tilgang til, slik at et gammelt hurtigvalg aldri kan gi snarvei til
    // noe man ikke slipper inn på likevel.
    private const string HurtigvalgNokkel = "itlock-hurtigvalg";

    private static readonly string[] StandardHurtigvalg =
        ["kalender", "arbeidsordre", "prosjekter", "kunder", "guide/kobling", "dormiljo", "timeregistrering"];

    private List<string> _hurtigvalg = [];
    private bool _tilpasserHurtigvalg;
    private bool _hurtigvalgLastet;

    private List<Lenke> BladLenker => PortalModulRegister.BladLenkerFor(_naverendeRolle);

    private List<Lenke> Hurtigvalg => _hurtigvalg
        .Select(href => BladLenker.FirstOrDefault(l => l.Href == href))
        .Where(l => l is not null)
        .Select(l => l!)
        .ToList();

    private void VekslTilpass() => _tilpasserHurtigvalg = !_tilpasserHurtigvalg;

    private async Task VekslHurtigvalg(string href)
    {
        if (!_hurtigvalg.Remove(href))
        {
            _hurtigvalg.Add(href);
        }

        await LagreHurtigvalg();
    }

    private async Task LagreHurtigvalg()
    {
        try
        {
            await LokalLagring.SetAsync(HurtigvalgNokkel, _hurtigvalg);
        }
        catch (Exception)
        {
            // Nettleserlagring kan være avslått. Hurtigvalgene gjelder da bare
            // for denne økten - forsiden skal uansett ikke feile på det.
        }
    }

    private List<string> StandardHurtigvalgForBruker() => StandardHurtigvalg
        .Where(href => BladLenker.Any(l => l.Href == href))
        .ToList();

    // "Tilpass" i Tilpass meny (se TopBar) navigerer hit med dette flagget, så
    // tilpassingen er slått på med én gang man lander på forsiden.
    private void LesTilpassFlaggFraUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("tilpassHurtigvalg", out var verdi) && verdi == "1")
        {
            _tilpasserHurtigvalg = true;
        }
    }

