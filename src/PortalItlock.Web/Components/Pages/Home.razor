    // ---------- Kalender-widget med tidsakse ----------
    private sealed record KalHendelse(
        string Href, string Tittel, string Sted, string TidTekst,
        string Topp, string Hoyde, string Kant, string Flate, string Blekk,
        // Venstrekant og bredde i prosent. Hendelser som overlapper i tid
        // deler dagkolonnen mellom seg i stedet for å legge seg oppå
        // hverandre - se FordelSideVedSide.
        string Venstre, string Bredde);

    private sealed record KalDag(string Navn, string DatoTekst, bool ErIDag, List<KalHendelse> Hendelser);

    // Tidsaksen går fra 07 til 16. Jobber utenfor dette klemmes inn i kantene
    // slik at en tidlig eller sen jobb fortsatt er synlig i widgeten.
    private const double KalFraTime = 7;
    private const double KalTilTime = 16;
    private static readonly int[] KalenderTimer = [7, 9, 11, 13, 15];

    private DateTime _kalMandag;
    private int _kalUkenummer;
    private List<KalDag> _kalDager = [];

    // nb-NO gir "man." med punktum - kalenderen vil ha "Man" som i designet.
    private static string KortDagsnavn(DateTime dato, System.Globalization.CultureInfo kultur)
    {
        var navn = kultur.DateTimeFormat.GetAbbreviatedDayName(dato.DayOfWeek).TrimEnd('.');
        return navn.Length == 0 ? navn : char.ToUpper(navn[0], kultur) + navn[1..];
    }

    private static string KalProsent(double verdi) =>
        verdi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string KalTopp(int time) => KalProsent((time - KalFraTime) * 100 / (KalTilTime - KalFraTime));

    private async Task ForrigeUke()
    {
        _kalMandag = _kalMandag.AddDays(-7);
        await LastKalenderUke();
    }

    private async Task NesteUke()
    {
        _kalMandag = _kalMandag.AddDays(7);
        await LastKalenderUke();
    }

    private async Task GaTilDenneUken()
    {
        _kalMandag = FinnForrigeMandag(DateTime.Today);
        await LastKalenderUke();
    }

    // Plasserer en aktivitet i tidsaksen. Alt som ligger utenfor 07-16 klemmes
    // inn i kanten, slik at en tidlig eller sen post fortsatt er synlig.
    private static (string Topp, string Hoyde) KalPlassering(double fraTimer, double tilTimer)
    {
        var spenn = KalTilTime - KalFraTime;
        var start = Math.Clamp(fraTimer, KalFraTime, KalTilTime - 0.5);
        var slutt = Math.Clamp(tilTimer, start + 0.5, KalTilTime);

        return (
            KalProsent((start - KalFraTime) * 100 / spenn),
            KalProsent(Math.Max((slutt - start) * 100 / spenn, 14)));
    }

    private async Task LastKalenderUke()
    {
        var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
        _kalUkenummer = System.Globalization.ISOWeek.GetWeekOfYear(_kalMandag);

        var fredag = _kalMandag.AddDays(5);
        var mineId = _naverendeRolle == BrukerRolle.Montor ? _naverendeBruker?.Id : null;

        // Arbeidsordre med planlagt dato i uka.
        var ordreSporring = Db.Arbeidsordre
            .AsNoTracking()
            .Include(a => a.Prosjekt)
            .Where(a => a.PlanlagtDato != null
                && a.PlanlagtDato.Value >= _kalMandag
                && a.PlanlagtDato.Value < fredag);

        // Hendelser lagt inn manuelt på /kalender - møter, fravær, service,
        // opplæring og interne oppgaver. Uten disse viste widgeten bare en del
        // av det som faktisk står i kalenderen.
        var hendelseSporring = Db.Ressursplaner
            .AsNoTracking()
            .Where(r => r.Dato >= _kalMandag && r.Dato < fredag);

        // Montører ser bare sine egne poster, akkurat som i kalendermodulen.
        if (mineId is { } id)
        {
            ordreSporring = ordreSporring.Where(a => a.AnsvarligMontorId == id);
            hendelseSporring = hendelseSporring.Where(r => r.MontorId == id);
        }

        var ordre = await ordreSporring.ToListAsync();
        var hendelser = await hendelseSporring.ToListAsync();

        _kalDager = Enumerable.Range(0, 5).Select(i =>
        {
            var dato = _kalMandag.AddDays(i);

            var fraOrdre = ordre
                .Where(a => a.PlanlagtDato!.Value.Date == dato.Date)
                .Select(a =>
                {
                    var start = a.PlanlagtDato!.Value;
                    var slutt = a.PlanlagtSlutt ?? start.AddHours((double)(a.EstimerteTimer ?? 2m));
                    var fraTimer = start.TimeOfDay.TotalHours <= 0 ? 8 : start.TimeOfDay.TotalHours;
                    var tilTimer = slutt.Date > start.Date ? KalTilTime : slutt.TimeOfDay.TotalHours;

                    // Samme fargevalg som kalendermodulen: fargen følger
                    // prosjektet (eller ordren), ikke statusen, slik at samme
                    // jobb har samme farge begge steder.
                    var farge = AktivitetFarge.Velg(a.ProsjektId ?? a.Id);
                    var (topp, hoyde) = KalPlassering(fraTimer, tilTimer);

                    return new KalRaa(fraTimer, tilTimer, new KalHendelse(
                        $"/arbeidsordre/{a.Id}",
                        a.Tittel,
                        a.Prosjekt?.Navn ?? a.Sted ?? "",
                        $"{start:HH:mm}–{slutt:HH:mm}",
                        topp, hoyde,
                        farge.Kant, farge.Flate, farge.Blekk,
                        "0%", "100%"));
                });

            var fraHendelser = hendelser
                .Where(r => r.Dato.Date == dato.Date)
                .Select(r =>
                {
                    var kategori = string.IsNullOrWhiteSpace(r.Kategori) ? KalenderKategori.Internt : r.Kategori;
                    var farge = KalenderKategori.Fargepar(kategori);
                    var fraTimer = r.Fra.TotalHours;
                    var tilTimer = r.Til.TotalHours > fraTimer ? r.Til.TotalHours : fraTimer + 1;
                    var (topp, hoyde) = KalPlassering(fraTimer, tilTimer);

                    return new KalRaa(fraTimer, tilTimer, new KalHendelse(
                        "/kalender?fra=hjem",
                        r.Tittel,
                        string.IsNullOrWhiteSpace(r.Info) ? KalenderKategori.Navn(kategori) : r.Info,
                        $"{r.Fra:hh\\:mm}–{r.Til:hh\\:mm}",
                        topp, hoyde,
                        farge.Kant, farge.Flate, farge.Blekk,
                        "0%", "100%"));
                });

            return new KalDag(
                KortDagsnavn(dato, kultur),
                dato.ToString("d.M", kultur),
                dato.Date == DateTime.Today,
                FordelSideVedSide(fraOrdre.Concat(fraHendelser).OrderBy(x => x.Fra).ThenBy(x => x.Til).ToList()));
        }).ToList();
    }

    // En hendelse med tidene sine beholdt, slik at overlapp kan regnes ut før
    // den får sin endelige plassering.
    private sealed record KalRaa(double Fra, double Til, KalHendelse Hendelse);

    // Ligger det flere jobber på samme tid - typisk tre ulike montører samme
    // formiddag - legger de seg oppå hverandre hvis alle får full bredde.
    // Her deles dagkolonnen i stedet mellom dem som faktisk overlapper: to
    // samtidige får halv bredde hver, tre får en tredjedel, og så videre.
    // Hendelser som ikke overlapper med noe beholder full bredde, så en rolig
    // dag ser like ren ut som før. Hver blokk får 1 % luft mot naboen.
    private static List<KalHendelse> FordelSideVedSide(List<KalRaa> raa)
    {
        if (raa.Count <= 1)
        {
            return raa.Select(r => r.Hendelse).ToList();
        }

        var resultat = new List<KalHendelse>(raa.Count);

        // Del dagen i klynger: en ny klynge begynner først når en hendelse
        // starter etter at ALT i den forrige klyngen er ferdig.
        var klyngeStart = 0;
        var klyngeSlutt = raa[0].Til;

        for (var i = 1; i <= raa.Count; i++)
        {
            if (i < raa.Count && raa[i].Fra < klyngeSlutt)
            {
                klyngeSlutt = Math.Max(klyngeSlutt, raa[i].Til);
                continue;
            }

            // Klyngen [klyngeStart, i) er ferdig - gi hver hendelse sitt spor.
            // Et spor gjenbrukes så snart det er ledig, slik at A og C kan
            // dele spor når bare B overlapper dem begge.
            var spor = new List<double>();
            var sporFor = new int[i - klyngeStart];

            for (var j = klyngeStart; j < i; j++)
            {
                var valgt = spor.FindIndex(sluttTid => raa[j].Fra >= sluttTid);
                if (valgt < 0)
                {
                    spor.Add(raa[j].Til);
                    valgt = spor.Count - 1;
                }
                else
                {
                    spor[valgt] = raa[j].Til;
                }

                sporFor[j - klyngeStart] = valgt;
            }

            var antallSpor = Math.Max(spor.Count, 1);
            var bredde = 100.0 / antallSpor;

            for (var j = klyngeStart; j < i; j++)
            {
                var kolonne = sporFor[j - klyngeStart];
                resultat.Add(raa[j].Hendelse with
                {
                    Venstre = KalProsent(kolonne * bredde),
                    Bredde = KalProsent(antallSpor == 1 ? 100 : bredde - 1)
                });
            }

            if (i < raa.Count)
            {
                klyngeStart = i;
                klyngeSlutt = raa[i].Til;
            }
        }

        return resultat;
    }


    // Egen, hex-fargebasert variant av TilbudSkjema sin HendelseVisning (som
    // returnerer StatusPill-fargenavn, ikke hex) - samme tekst-gjenkjenning,
    // tilpasset Dashboard3 sin fargepalett.
    private static (string Ikon, string Farge, string Bakgrunn, string Tittel) Hd3HendelseVisning(string beskrivelse)
    {
        if (beskrivelse.StartsWith("Tilbudet ble opprettet", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "#2b7a4b", "#d3ecdb", "Tilbud opprettet");
        }
        if (beskrivelse.StartsWith("Status endret", StringComparison.OrdinalIgnoreCase))
        {
            return ("clock", "#2054a3", "#dce8f7", "Status endret");
        }
        if (beskrivelse.StartsWith("Genererte PDF", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "#2A2017", "#EEE7DF", "PDF generert");
        }
        if (beskrivelse.Contains("pris", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.Contains("rigg/drift", StringComparison.OrdinalIgnoreCase))
        {
            return ("trend-up", "#D98B3F", "#FBEFDB", "Pris oppdatert");
        }
        if (beskrivelse.StartsWith("Vare", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret antall", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.Contains("synkronisert", StringComparison.OrdinalIgnoreCase))
        {
            return ("box", "#6B46C1", "#E3DEF6", "Vare oppdatert");
        }

        return ("bell", "#9A4E24", "#F3E9DC", "Tilbud lagret");
    }

    private static string Hd3RelativTid(DateTime dato)
    {
        var dager = (dato.Date - DateTime.Today).Days;
        if (dager < 0)
        {
            return $"{-dager} dager siden";
        }
        if (dager == 0)
        {
            return "I dag";
        }
        if (dager <= 60)
        {
            return $"Om {dager} dager";
        }
        var maneder = (int)Math.Round(dager / 30.0);
        return $"Om {maneder} mnd";
    }

    // Samme geokodingsmønster som Serviceavtaler.razor - lagrer posisjon på
    // selve Prosjektet slik at kartet slipper å geokode på nytt neste visning.
    // Kartet viser nå alle tre typene aktivitet samtidig: serviceavtaler,
    // andre aktive prosjekter og åpne arbeidsordre - samme punkt-fasong
    // (pin+rikPopup) som Arbeidsordre/Prosjekter sine egne kartvisninger.
    private async Task LastInnHd3KartAsync(List<Prosjekt> serviceProsjekter, List<Arbeidsordre> planlagteOrdre)
    {
        var aktiveProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.UnderArbeid)
            .ToListAsync();

        var alleProsjekter = serviceProsjekter.Concat(aktiveProsjekter).ToList();

        // Viser kartet UMIDDELBART med de punktene som allerede har lagret
        // lat/lng, i stedet for å blokkere hele forsiden (appens mest
        // besøkte side) mens manglende adresser slås opp mot en ekstern
        // tjeneste (kunne tidligere ta opp til N×5s - se CODE_REVIEW.md
        // 2026-10-08). Manglende punkter dukker opp etter hvert som
        // geokodingen fullfører i bakgrunnen (GeokodHd3KartIBakgrunnenAsync),
        // samme sluttresultat som før - bare ikke blokkerende.
        BySettHd3KartPunkter(serviceProsjekter, aktiveProsjekter, planlagteOrdre);
        _ = GeokodHd3KartIBakgrunnenAsync(alleProsjekter, serviceProsjekter, aktiveProsjekter, planlagteOrdre, _disposedCts.Token);
    }

    private readonly CancellationTokenSource _disposedCts = new();

    private async Task GeokodHd3KartIBakgrunnenAsync(
        List<Prosjekt> alleProsjekter, List<Prosjekt> serviceProsjekter, List<Prosjekt> aktiveProsjekter,
        List<Arbeidsordre> planlagteOrdre, CancellationToken ct)
    {
        var endret = false;
        var forste = true;

        foreach (var p in alleProsjekter.Where(p => p.Latitude is null && !string.IsNullOrWhiteSpace(p.Adresse)))
        {
            if (ct.IsCancellationRequested)
            {
                break;
            }

            // Nominatim (geokodingstjenesten) sine bruksvilkår tillater maks
            // 1 forespørsel/sekund - overholdes eksplisitt her siden kallene
            // kjører sekvensielt i bakgrunnen uten at brukeren venter på dem.
            if (!forste)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromMilliseconds(1100), ct);
                }
                catch (TaskCanceledException)
                {
                    break;
                }
            }
            forste = false;

            (double Latitude, double Longitude)? treff;
            try
            {
                treff = await Geokoding.GeocodeAsync(p.Adresse!, p.Postnr, p.Sted);
            }
            catch
            {
                continue;
            }

            if (treff is null || ct.IsCancellationRequested)
            {
                continue;
            }

            p.Latitude = treff.Value.Latitude;
            p.Longitude = treff.Value.Longitude;
            endret = true;

            BySettHd3KartPunkter(serviceProsjekter, aktiveProsjekter, planlagteOrdre);
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                break;
            }
        }

        if (endret && !ct.IsCancellationRequested)
        {
            try
            {
                await Db.SaveChangesAsync();
            }
            catch
            {
                // Best-effort bakgrunnsoppgave - siden kan ha blitt forlatt/disposed underveis.
            }
        }
    }

    private void BySettHd3KartPunkter(List<Prosjekt> serviceProsjekter, List<Prosjekt> aktiveProsjekter, List<Arbeidsordre> planlagteOrdre)
    {
        var punkter = new List<object>();

        punkter.AddRange(serviceProsjekter
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"service-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#9A4E24",
                pin = true,
                rikPopup = true,
                statusTekst = "Serviceavtale",
                statusBg = "#F3E9DC",
                href = $"/serviceavtaler/{p.Id}"
            }));

        punkter.AddRange(aktiveProsjekter
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"prosjekt-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#0b66e6",
                pin = true,
                rikPopup = true,
                statusTekst = p.Status?.Visningsnavn(),
                statusBg = "#dbe7f7",
                href = $"/prosjekter/{p.Id}"
            }));

        punkter.AddRange(planlagteOrdre
            .Where(a => (a.Latitude ?? a.Prosjekt?.Latitude) is not null && (a.Longitude ?? a.Prosjekt?.Longitude) is not null)
            .Select(a => (object)new
            {
                id = $"ao-{a.Id}",
                lat = a.Latitude ?? a.Prosjekt!.Latitude!.Value,
                lng = a.Longitude ?? a.Prosjekt!.Longitude!.Value,
                tittel = a.Tittel,
                undertekst = a.Prosjekt?.Navn ?? "",
                farge = "#0c9c5c",
                pin = true,
                rikPopup = true,
                statusTekst = a.Status.Visningsnavn(),
                statusBg = "#d3ecdb",
                href = $"/arbeidsordre/{a.Id}"
            }));

        _hd3KartPunkter = punkter;
    }

    private List<object> _hd3KartPunkter = [];
    private bool _hd3KartInitialisert;

    // Kart eller satellitt på forsidekartet. Begge flatene finnes allerede i
    // kart.js (settBakgrunn) og brukes av kartsidene ellers i portalen.
    private string _hd3KartFlate = "kart";

