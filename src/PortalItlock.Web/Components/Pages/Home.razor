@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje

<PageTitle>Itlock Full Kontroll</PageTitle>

<div class="home-page">

    @if (_visNyhet && _sisteNyhet is not null)
    {
        <div class="nyhet-banner">
            <span class="nyhet-banner-ikon"><Icon Name="bell" /></span>
            <div class="nyhet-banner-innhold">
                <strong>@_sisteNyhet.Tittel</strong>
                <p>@_sisteNyhet.Innhold</p>
            </div>
            <button type="button" class="nyhet-banner-lukk" @onclick="LukkNyhet" aria-label="Lukk"><Icon Name="x" /></button>
        </div>
    }

    <div class="home-hero-banner">
        <div class="home-hero-inner">
            <div class="home-hero-text">
                <span class="home-dato-pill">@Idag</span>
                @if (Hilsen is not null)
                {
                    <h1 class="home-hilsen">@Hilsen</h1>
                }
                @if (HeroSetning is not null)
                {
                    <p class="home-hero-sub">@HeroSetning</p>
                }
            </div>

            @if (!Verktoylinje.FullversjonAktiv && _alleStats.Count > 0)
            {
                <div class="home-hero-stats-wrap">
                    <div class="home-hero-stats-marquee">
                        <div class="home-hero-stats-track" style="animation-duration:@(MarqueeVarighet.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                            @foreach (var stat in _alleStats)
                            {
                                @StatMarkup(stat)
                            }
                            <div class="home-hero-stats-dup" aria-hidden="true">
                                @foreach (var stat in _alleStats)
                                {
                                    @StatMarkup(stat)
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!Verktoylinje.FullversjonAktiv && _nesteJobb is not null)
    {
        <a href="@($"/arbeidsordre/{_nesteJobb.Id}")" class="neste-jobb-kort">
            <span class="neste-jobb-ikon"><Icon Name="calendar" /></span>
            <span class="neste-jobb-tekst">
                <span class="neste-jobb-label">Neste jobb i dag · @_nesteJobb.Klokkeslett</span>
                <span class="neste-jobb-tittel">
                    @_nesteJobb.Tittel
                    @if (_nesteJobb.KundeNavn is not null)
                    {
                        <text> · @_nesteJobb.KundeNavn</text>
                    }
                </span>
                @if (_nesteJobb.Adresse is not null)
                {
                    <span class="neste-jobb-adresse">@_nesteJobb.Adresse</span>
                }
            </span>
            <span class="neste-jobb-pil"><Icon Name="chevron-down" /></span>
        </a>
    }

    <div class="home-divider" aria-hidden="true">
        <span class="home-divider-linje"></span>
    </div>

    <section class="home-section">
        <div class="role-grid">
            @foreach (var rolle in Roller)
            {
                <button type="button"
                        class="role-card role-card-@rolle.Nokkel @(_valgtRolle == rolle.Nokkel ? "role-card-active" : "")"
                        @onclick="@(() => VelgRolle(rolle.Nokkel))">
                    <span class="role-card-ikon"><Icon Name="@IkonForRolle(rolle.Nokkel)" /></span>
                    <span class="role-card-title">@TittelFor(rolle)</span>
                    <span class="role-card-desc">@BeskrivelseFor(rolle)</span>
                </button>
            }
        </div>
    </section>

    @if (_valgtRolle is not null)
    {
        var valgt = Roller.First(r => r.Nokkel == _valgtRolle);

        <div class="modul-modal-bakteppe" @onclick="LukkModulPanel">
            <div class="modul-modal modul-modal-@_valgtRolle" @onclick:stopPropagation="true">
                <div class="modul-modal-header">
                    <span class="modul-modal-ikon"><Icon Name="@IkonForRolle(_valgtRolle)" /></span>
                    <span class="modul-modal-header-tekst">
                        <span class="modul-modal-tittel">@valgt.Tittel</span>
                        <span class="modul-modal-beskrivelse">@valgt.Beskrivelse</span>
                    </span>
                    <button type="button" class="modul-modal-lukk" @onclick="LukkModulPanel" aria-label="Lukk">
                        <Icon Name="x" />
                    </button>
                </div>
                <div class="modul-modal-innhold">
                    @foreach (var gruppe in valgt.Grupper)
                    {
                        <div class="home-links-gruppe">
                            <h3 class="home-links-gruppe-navn">@gruppe.Navn</h3>
                            <div class="home-links">
                                @foreach (var link in gruppe.Lenker)
                                {
                                    <a class="home-card" href="@link.Href">
                                        <span class="home-card-ikon"><Icon Name="@link.IconNavn" /></span>
                                        <span class="home-card-tekst">
                                            <span class="home-card-title">@link.Tittel</span>
                                            <span class="home-card-desc">@link.Beskrivelse</span>
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (VisBiler)
    {
        <div class="home-drive-strip" aria-hidden="true">
            @foreach (var delay in DriveDelays)
            {
                <div class="home-drive-track" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s">
                    <div class="home-drive-shadow" style="animation-delay:@(delay.ToString(System.Globalization.CultureInfo.InvariantCulture))s"></div>
                    <div class="home-drive-tilt">
                        <img src="img/itlock-bil.png?v=6" alt="" class="home-drive-car" />
                    </div>
                </div>
            }
        </div>
    }

    <p class="home-footer">Laget av Marius Karlsen, itlock AS</p>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // Negative animation-delay hopper hver bil rett inn på et gitt punkt i
    // 13s-syklusen, slik at de fordeler seg jevnt etter hverandre langs banen.
    private static readonly double[] DriveDelays = [0, -3.25, -6.5, -9.75];

    // Sett til true igjen for å vise de kjørende servicebilene på forsiden.
    private const bool VisBiler = false;

    private sealed record HeroStat(string? Href, string Ikon, int Verdi, string Label, bool Varsel);
    private sealed record NesteJobb(int Id, string Tittel, string Klokkeslett, string? KundeNavn, string? Adresse);

    // Sekunder pr. nøkkeltall i den kontinuerlige marquee-animasjonen -
    // styrer farten (holder tempoet likt uansett hvor mange nøkkeltall
    // som faktisk vises, siden varigheten skaleres med antallet).
    private const double MarqueeSekunderPrStat = 4.0;

    private string? _valgtRolle;
    private HjemmesideTekst? _tekst;

    private int _aktiveProsjekter;
    private int _avvikSomVenter;
    private int _dagensJobber;
    private int _ferdigDenneUken;
    private int _serviceavtalerVarsel;
    private bool _visServiceavtaleVarsel;
    private int _nyligFakturerteOrdre;
    private int _kunderTrengerOppfolging;
    private int _varerLavBeholdning;
    private int _lisensVarsel;

    private List<HeroStat> _alleStats = [];
    private NesteJobb? _nesteJobb;

    private Nyhet? _sisteNyhet;
    private Bruker? _naverendeBruker;
    private bool _visNyhet;

    private async Task LukkNyhet()
    {
        if (_naverendeBruker is null || _sisteNyhet is null)
        {
            return;
        }

        _naverendeBruker.SisteNyhetSettId = _sisteNyhet.Id;
        await Db.SaveChangesAsync();
        _visNyhet = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;

        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (rolleClaim == "Kunde")
        {
            Nav.NavigateTo("/kunde", forceLoad: true);
            return;
        }

        if (rolleClaim == "Driftslisens")
        {
            Nav.NavigateTo("/drift", forceLoad: true);
            return;
        }

        BrukerRolle? rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : null;
        int? brukerId = null;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
        {
            brukerId = bid;
        }

        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();

        if (brukerId.HasValue)
        {
            _naverendeBruker = await Db.Brukere.FindAsync(brukerId.Value);
        }

        _sisteNyhet = await Db.Nyheter.OrderByDescending(n => n.Id).FirstOrDefaultAsync();
        if (_sisteNyhet is not null && _naverendeBruker is not null)
        {
            _visNyhet = (_naverendeBruker.SisteNyhetSettId ?? 0) < _sisteNyhet.Id;
        }

        var mandag = FinnForrigeMandag(DateTime.Today);
        var sondag = mandag.AddDays(6);

        _aktiveProsjekter = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Aktiv);
        _avvikSomVenter = await Db.Avvik.CountAsync(a => a.Status == AvvikStatus.SendtTilKunde);

        var dagensQuery = Db.Arbeidsordre.Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today);
        var ferdigQuery = Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig
            && a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= mandag && a.PlanlagtDato.Value.Date <= sondag);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            dagensQuery = dagensQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
            ferdigQuery = ferdigQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        _dagensJobber = await dagensQuery.CountAsync();
        _ferdigDenneUken = await ferdigQuery.CountAsync();

        var nesteJobbQuery = Db.Arbeidsordre
            .Include(a => a.Kunde)
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == DateTime.Today
                && a.Status != ArbeidsordreStatus.Ferdig && a.Status != ArbeidsordreStatus.Fakturert);

        if (rolle == BrukerRolle.Montor && brukerId.HasValue)
        {
            nesteJobbQuery = nesteJobbQuery.Where(a => a.AnsvarligMontorId == brukerId.Value);
        }

        var forsteJobb = await nesteJobbQuery.OrderBy(a => a.PlanlagtDato).FirstOrDefaultAsync();
        if (forsteJobb is not null)
        {
            _nesteJobb = new NesteJobb(
                forsteJobb.Id,
                forsteJobb.Tittel,
                forsteJobb.PlanlagtDato!.Value.ToString("HH:mm"),
                forsteJobb.Kunde?.Navn,
                string.IsNullOrWhiteSpace(forsteJobb.Adresse) ? null : forsteJobb.Adresse);
        }

        _visServiceavtaleVarsel = rolle == BrukerRolle.Admin || rolle == BrukerRolle.Prosjektleder;
        if (_visServiceavtaleVarsel)
        {
            var serviceProsjektIder = await Db.Prosjekter
                .Where(p => p.Status == ProsjektStatus.Serviceavtale)
                .Select(p => p.Id)
                .ToListAsync();

            if (serviceProsjektIder.Count > 0)
            {
                var runder = await Db.Servicerunder
                    .Where(r => serviceProsjektIder.Contains(r.ProsjektId))
                    .ToListAsync();

                var terskel = DateTime.Today.AddDays(14);
                _serviceavtalerVarsel = serviceProsjektIder.Count(pid =>
                {
                    var neste = runder.Where(r => r.ProsjektId == pid)
                        .OrderByDescending(r => r.Dato)
                        .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;
                    return neste.HasValue && neste.Value.Date <= terskel;
                });
            }

            var siste7Dager = DateTime.Now.AddDays(-7);
            _nyligFakturerteOrdre = await Db.Arbeidsordre.CountAsync(a =>
                a.Status == ArbeidsordreStatus.Fakturert && a.FakturertDato != null && a.FakturertDato >= siste7Dager);

            _kunderTrengerOppfolging = await Db.Kunder.CountAsync(k =>
                k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today);

            _varerLavBeholdning = await Db.Components.CountAsync(c =>
                c.Aktiv && c.ILagerstyring && c.Minimumsbeholdning != null && c.Lagerantall <= c.Minimumsbeholdning.Value);

            var lisensTerskel = DateTime.Today.AddDays(30);
            _lisensVarsel = await Db.KundeLisenser.CountAsync(l => l.UtlopsDato.Date <= lisensTerskel);
        }

        _alleStats =
        [
            new("/prosjekter", "folder", _aktiveProsjekter, "Aktive prosjekter", false),
            new(null, "alert", _avvikSomVenter, "Avvik venter", _avvikSomVenter > 0),
            new("/kalender", "calendar", _dagensJobber, "Dagens jobber", false),
            new("/arbeidsordre", "check-circle", _ferdigDenneUken, "Ferdig denne uken", false),
        ];

        if (_visServiceavtaleVarsel)
        {
            _alleStats.Add(new("/service", "clock", _serviceavtalerVarsel, "Serviceavtaler nærmer seg forfall", _serviceavtalerVarsel > 0));
            _alleStats.Add(new("/arbeidsordre/fakturert", "receipt", _nyligFakturerteOrdre, "Fakturert siste 7 dager", false));
            _alleStats.Add(new("/kundeoppfolging", "users", _kunderTrengerOppfolging, "Kunder trenger oppfølging", _kunderTrengerOppfolging > 0));
            _alleStats.Add(new("/lager", "box", _varerLavBeholdning, "Lav lagerbeholdning", _varerLavBeholdning > 0));
            _alleStats.Add(new("/lisenser", "clock", _lisensVarsel, "Lisenser går ut snart", _lisensVarsel > 0));
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }

    private void VelgRolle(string nokkel)
    {
        _valgtRolle = _valgtRolle == nokkel ? null : nokkel;
    }

    private void LukkModulPanel() => _valgtRolle = null;

    private string TittelFor(Rolle rolle) => (rolle.Nokkel, _tekst) switch
    {
        ("montorer", { } t) => t.MontorerTittel,
        ("prosjektledere", { } t) => t.ProsjektlederTittel,
        ("admin", { } t) => t.AdminTittel,
        _ => rolle.Tittel,
    };

    private string BeskrivelseFor(Rolle rolle) => (rolle.Nokkel, _tekst) switch
    {
        ("montorer", { } t) => t.MontorerBeskrivelse,
        ("prosjektledere", { } t) => t.ProsjektlederBeskrivelse,
        ("admin", { } t) => t.AdminBeskrivelse,
        _ => rolle.Beskrivelse,
    };

    private static string IkonForRolle(string nokkel) => nokkel switch
    {
        "montorer" => "tool",
        "prosjektledere" => "folder",
        "admin" => "lock",
        _ => "users",
    };

    private static List<Rolle> Roller => PortalModulRegister.Roller;

    private string? Hilsen
    {
        get
        {
            if (_naverendeBruker is null)
            {
                return null;
            }

            var fornavn = _naverendeBruker.Navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? _naverendeBruker.Navn;
            var time = DateTime.Now.Hour;
            var hilsen = time is >= 7 and < 10 ? "God morgen" : time is >= 10 and < 16 ? "Hei" : "God kveld";
            return $"{hilsen} {fornavn}!";
        }
    }

    private string? HeroSetning
    {
        get
        {
            if (_naverendeBruker is null || Verktoylinje.FullversjonAktiv)
            {
                return null;
            }

            if (_dagensJobber == 0 && _avvikSomVenter == 0)
            {
                return "Ingen jobber planlagt i dag - god anledning til å ta unna annet.";
            }

            if (_dagensJobber > 0 && _avvikSomVenter > 0)
            {
                var jobbOrd = _dagensJobber == 1 ? "jobb" : "jobber";
                return $"Du har {_dagensJobber} {jobbOrd} i dag og {_avvikSomVenter} avvik som venter på godkjenning.";
            }

            if (_dagensJobber > 0)
            {
                var jobbOrd = _dagensJobber == 1 ? "jobb" : "jobber";
                return $"Du har {_dagensJobber} {jobbOrd} i dag.";
            }

            return $"{_avvikSomVenter} avvik venter på godkjenning.";
        }
    }

    private double MarqueeVarighet => Math.Max(_alleStats.Count, 1) * MarqueeSekunderPrStat;

    private RenderFragment<HeroStat> StatMarkup => stat =>
        @<text>
            @if (stat.Href is not null)
            {
                <a href="@stat.Href" class="home-hero-stat @(stat.Varsel ? "home-hero-stat-varsel" : "")">
                    <span class="home-hero-stat-ikon"><Icon Name="@stat.Ikon" /></span>
                    <span class="home-hero-stat-value">@stat.Verdi</span>
                    <span class="home-hero-stat-label">@stat.Label</span>
                </a>
            }
            else
            {
                <div class="home-hero-stat @(stat.Varsel ? "home-hero-stat-varsel" : "")">
                    <span class="home-hero-stat-ikon"><Icon Name="@stat.Ikon" /></span>
                    <span class="home-hero-stat-value">@stat.Verdi</span>
                    <span class="home-hero-stat-label">@stat.Label</span>
                </div>
            }
        </text>;


    private static string Idag
    {
        get
        {
            var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
            var tekst = DateTime.Now.ToString("dddd d. MMMM", kultur);
            return char.ToUpper(tekst[0], kultur) + tekst[1..];
        }
    }
}
