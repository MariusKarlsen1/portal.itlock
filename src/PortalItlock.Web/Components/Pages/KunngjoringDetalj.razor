@page "/kunngjoring/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_k?.Tittel ?? "Kunngjøring") - Full Kontroll</PageTitle>

<div class="kunngjoring-detalj-side">

<a class="tilbake-link" href="/kunngjoringer"><Icon Name="arrow-left" />Tilbake til kunngjøringer</a>

@if (_k is null)
{
    <p class="list-empty">Fant ikke kunngjøringen.</p>
}
else
{
    <div class="kd-kort">
        <div class="kd-cover @(_k.BildeData is null ? "kd-cover-tom" : "")" style="@(_k.BildeData is not null ? $"background-image:url('/kunngjoringbilde/{_k.Id}')" : "")">
            <div class="kd-cover-topprad">
                <span class="kd-cover-pill kd-pill-@_k.Kategori.PillFarge()"><Icon Name="@_k.Kategori.PillIkon()" />@_k.Kategori.Visningsnavn()</span>
                @if (_k.EventDato.HasValue)
                {
                    <span class="kd-datoboks">
                        <span class="kd-datoboks-dag">@_k.EventDato.Value.Day</span>
                        <span class="kd-datoboks-maned">@_k.EventDato.Value.ToString("MMM", _kultur)</span>
                    </span>
                }
            </div>
            <div class="kd-cover-tekst">
                <h1>@_k.Tittel</h1>
                @if (_k.EventDato.HasValue || !string.IsNullOrWhiteSpace(_k.Sted))
                {
                    <p>
                        @(_k.EventDato?.ToString("d. MMMM", _kultur))
                        @if (_k.EventDato.HasValue && !string.IsNullOrWhiteSpace(_k.Sted))
                        {
                            <text> &middot; </text>
                        }
                        @_k.Sted
                    </p>
                }
            </div>
        </div>

        <div class="kd-body">
            <div class="kd-forfatter-rad">
                <span class="kunngjoring-avatar" style="background:@AvatarFarge(_k.OpprettetAvBruker?.Navn ?? "?");">@Initialer(_k.OpprettetAvBruker?.Navn ?? "?")</span>
                <div class="kd-forfatter-info">
                    <strong>@(_k.OpprettetAvBruker?.Navn ?? "Ukjent")</strong>
                    <span>@_k.OpprettetDato.ToString("d. MMMM yyyy", _kultur)</span>
                </div>
                <button type="button" class="kunngjoring-like-knapp @(HarLikt() ? "likt" : "")" @onclick="ToggleLike" title="@(HarLikt() ? "Fjern liker" : "Lik")">
                    <Icon Name="heart" />
                    @if (_k.Likes.Count > 0)
                    {
                        <span>@_k.Likes.Count</span>
                    }
                </button>
                @if (ErAdminEllerPl)
                {
                    <button type="button" class="kd-meny-knapp" @onclick="@(() => _visSlettBekreft = !_visSlettBekreft)" title="Mer">⋯</button>
                }
            </div>

            @if (_visSlettBekreft)
            {
                <div class="kd-slett-rad">
                    Slette denne kunngjøringen?
                    <button type="button" class="delete-confirm-button" @onclick="Slett">Ja, slett</button>
                    <button type="button" class="cancel-button" @onclick="@(() => _visSlettBekreft = false)">Avbryt</button>
                </div>
            }

            <h2 class="kd-tittel">@_k.Tittel</h2>
            <p class="kd-innhold">@_k.Innhold</p>

            @if (_k.EventDato.HasValue || !string.IsNullOrWhiteSpace(_k.Sted) || !string.IsNullOrWhiteSpace(_k.Detaljer))
            {
                <div class="kd-metarad">
                    @if (_k.EventDato.HasValue)
                    {
                        <span class="kd-meta"><Icon Name="calendar" />@_k.EventDato.Value.ToString("dddd d. MMMM yyyy", _kultur)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_k.Sted))
                    {
                        <span class="kd-meta"><Icon Name="map" />@_k.Sted</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_k.Detaljer))
                    {
                        <span class="kd-meta"><Icon Name="tag" />@_k.Detaljer</span>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_k.InfoTekst))
            {
                <div class="kd-info-boks">
                    <span class="kd-info-ikon">i</span>
                    <span>@_k.InfoTekst</span>
                </div>
            }

            <h3 class="kd-kommentar-tittel">Kommentarer (@_k.Kommentarer.Count)</h3>

            @if (_k.Kommentarer.Count > 0)
            {
                <div class="kd-kommentarer">
                    @foreach (var kom in _k.Kommentarer.OrderBy(c => c.OpprettetDato))
                    {
                        <div class="kd-kommentar" @key="kom.Id">
                            <span class="kunngjoring-avatar kunngjoring-avatar-liten" style="background:@AvatarFarge(kom.Bruker?.Navn ?? "?");">@Initialer(kom.Bruker?.Navn ?? "?")</span>
                            <span class="kd-kommentar-navn">@(kom.Bruker?.Navn ?? "Ukjent")</span>
                            <span class="kd-kommentar-tekst">@kom.Tekst</span>
                            <span class="kd-kommentar-dato">@kom.OpprettetDato.ToString("d. MMM yyyy", _kultur)</span>
                        </div>
                    }
                </div>
            }

            <div class="kd-kommentar-input-rad">
                <input placeholder="Skriv en kommentar..." @bind="_kommentarUtkast" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilKommentar(); } })" />
                <button type="button" class="knapp-primaer" @onclick="LeggTilKommentar">Send</button>
            </div>
        </div>
    </div>
}

</div>

@code {
    [Parameter] public int Id { get; set; }

    private static readonly System.Globalization.CultureInfo _kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] _avatarPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private Kunngjoring? _k;
    private string _kommentarUtkast = "";
    private bool _visSlettBekreft;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;
    private bool ErAdminEllerPl;

    private static string AvatarFarge(string navn) => _avatarPaletten[Math.Abs(navn.GetHashCode()) % _avatarPaletten.Length];

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => string.Concat(deler[0][0], deler[^1][0]).ToUpperInvariant()
        };
    }

    private bool HarLikt() => _k is not null && _naverendeBrukerId is not null && _k.Likes.Any(l => l.BrukerId == _naverendeBrukerId);

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            ErAdminEllerPl = rolleClaim is "Admin" or "Prosjektleder";

            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        await LastAsync();
    }

    private async Task LastAsync()
    {
        _k = await Db.Kunngjoringer
            .Include(k => k.OpprettetAvBruker)
            .Include(k => k.Likes)
            .Include(k => k.Kommentarer).ThenInclude(kom => kom.Bruker)
            .FirstOrDefaultAsync(k => k.Id == Id);
    }

    private async Task ToggleLike()
    {
        if (_k is null || _naverendeBrukerId is null)
        {
            return;
        }

        var eksisterende = await Db.KunngjoringLikes
            .FirstOrDefaultAsync(l => l.KunngjoringId == _k.Id && l.BrukerId == _naverendeBrukerId);

        if (eksisterende is not null)
        {
            Db.KunngjoringLikes.Remove(eksisterende);
            _k.Likes.RemoveAll(l => l.BrukerId == _naverendeBrukerId);
        }
        else
        {
            var ny = new KunngjoringLike { KunngjoringId = _k.Id, BrukerId = _naverendeBrukerId.Value };
            Db.KunngjoringLikes.Add(ny);
            _k.Likes.Add(ny);
        }

        await Db.SaveChangesAsync();
    }

    private async Task LeggTilKommentar()
    {
        if (_k is null)
        {
            return;
        }

        var tekst = _kommentarUtkast.Trim();
        if (string.IsNullOrWhiteSpace(tekst))
        {
            return;
        }

        var kommentar = new KunngjoringKommentar
        {
            KunngjoringId = _k.Id,
            Tekst = tekst,
            BrukerId = _naverendeBrukerId
        };
        Db.KunngjoringKommentarer.Add(kommentar);
        await Db.SaveChangesAsync();

        kommentar.Bruker = _naverendeBruker;
        _k.Kommentarer.Add(kommentar);
        _kommentarUtkast = "";
    }

    private async Task Slett()
    {
        if (_k is null)
        {
            return;
        }

        Db.Kunngjoringer.Remove(_k);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/kunngjoringer");
    }
}
