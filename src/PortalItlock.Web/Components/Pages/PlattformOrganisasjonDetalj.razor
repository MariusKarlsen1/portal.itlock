                </section>
                <section class="pod-card">
                    <h3 class="pod-h3">Logg</h3>
                    <div class="pod-tidslinje">
                        @foreach (var h in _hendelser.Take(40))
                        {
                            <div><time>@h.Tidspunkt.ToString("dd.MM.yy HH:mm")</time><span>@h.Tekst@(h.Av is { } av ? $" ({av})" : "")</span></div>
                        }
                        <div><time>@_tenant.OpprettetDato.ToString("dd.MM.yy HH:mm")</time><span>Organisasjonen opprettet</span></div>
                    </div>
                </section>
            </div>
