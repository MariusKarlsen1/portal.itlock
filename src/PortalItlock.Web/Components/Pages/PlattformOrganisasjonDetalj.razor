    {
        _fane = fane;
        if (underFane is not null)
        {
            _oppsettFane = underFane;
        }
    }

    private static string Kr(decimal v) => v.ToString("#,##0", Nb) + " kr";

    private int Tildelt(LisensType t) => _lisenser.Where(l => l.Type == t).Sum(l => l.AntallTildelt);
    private int IBrukFor(LisensType t) => t.Rolle() is { } r ? _brukere.Count(b => b.Aktiv && b.Rolle == r) : 0;
    private int AnsattLisenser => LisensTypeExtensions.Ansatte.Sum(Tildelt);
    private int AnsatteIBruk => LisensTypeExtensions.Ansatte.Sum(IBrukFor);

    private string IBruk(AbonnementService.Linje l)
    {
        var type = LisensTypeExtensions.Aktive.FirstOrDefault(t => PrisProdukt.ForLisens(t) == l.Nokkel, LisensType.Brukere);
        return type == LisensType.Brukere ? "–" : IBrukFor(type).ToString();
    }

