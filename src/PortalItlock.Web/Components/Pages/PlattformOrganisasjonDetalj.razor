    // ---------- Pakke ----------
    private List<PrisPakke> _pakker = [];
    private PlattformInnstillinger _plattform = new();

    private List<PakkePris> _pakkePriserAlle = [];
    private Dictionary<string, decimal> _produktKr = [];

    // Endringer samles her og lagres først når man trykker «Lagre endringer».
    private readonly Dictionary<string, int> _utkast = [];
    private string? _utkastPakke;
    private bool _pakkeEndret;
    private bool _visAvtalepris;
    private bool _lagrerUtkast;

    private bool HarUtkast => _utkast.Count > 0 || _pakkeEndret;

    // Linjene slik de blir med utkastet: nytt antall og pakkens priser.
    private List<AbonnementService.Linje> Forhandsvis => _linjer.Select(l =>
    {
        var antall = _utkast.TryGetValue(l.Nokkel, out var a) ? a : l.Antall;
        if (!_pakkeEndret)
        {
            return l with { Antall = antall };
        }

        var liste = _pakkePriserAlle.FirstOrDefault(x => x.PakkeNokkel == _utkastPakke && x.ProduktNokkel == l.Nokkel)?.Kr
            ?? _produktKr.GetValueOrDefault(l.Nokkel, l.Listepris);
        return l with { Antall = antall, Listepris = liste, Pris = l.HarAvtalepris ? l.Pris : liste };
    }).ToList();

    private IEnumerable<string> UtkastPunkter
    {
        get
        {
            if (_pakkeEndret)
            {
                yield return $"Pakke {PakkeNavn(_abo?.Pakke)} → {PakkeNavn(_utkastPakke)}";
            }

            foreach (var l in _linjer.Where(l => _utkast.ContainsKey(l.Nokkel)))
            {
                var nytt = _utkast[l.Nokkel];
                yield return l.Type == PrisType.Lisens
                    ? $"{l.Navn} {l.Antall} → {nytt}"
                    : $"{l.Navn} slås {(nytt > 0 ? "på" : "av")}";
            }
        }
    }

    private string PakkeNavn(string? nokkel) => _pakker.FirstOrDefault(p => p.Nokkel == nokkel)?.Navn ?? "Egendefinert";

    private static LisensType? LisensFor(AbonnementService.Linje l) =>
        LisensTypeExtensions.Aktive.Where(t => PrisProdukt.ForLisens(t) == l.Nokkel).Select(t => (LisensType?)t).FirstOrDefault();

    private int? BrukTall(AbonnementService.Linje l) => LisensFor(l) is { } t && t.Rolle() is not null ? IBrukFor(t) : null;

    private static string LisensKort(string navn)
    {
        var ord = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return ord.Length switch
        {
            0 => "?",
            1 => ord[0][..Math.Min(2, ord[0].Length)].ToUpperInvariant(),
            _ => $"{char.ToUpperInvariant(ord[0][0])}{char.ToUpperInvariant(ord[1][0])}"
        };
    }

    private void SettUtkast(string nokkel, int antall)
    {
        antall = Math.Max(0, antall);
        var lagret = _linjer.FirstOrDefault(l => l.Nokkel == nokkel)?.Antall ?? 0;
        if (antall == lagret)
        {
            _utkast.Remove(nokkel);
        }
        else
        {
            _utkast[nokkel] = antall;
        }

        _aboMelding = null;
    }

    private void EndreUtkast(string nokkel, int endring)
    {
        var na = _utkast.TryGetValue(nokkel, out var a) ? a : _linjer.FirstOrDefault(l => l.Nokkel == nokkel)?.Antall ?? 0;
        SettUtkast(nokkel, na + endring);
    }

    private void VelgUtkastPakke(string? nokkel)
    {
        _utkastPakke = nokkel;
        _pakkeEndret = nokkel != _abo?.Pakke;
        _aboMelding = null;
    }

    private void AngreUtkast()
    {
        _utkast.Clear();
        _pakkeEndret = false;
        _utkastPakke = null;
        _aboMelding = null;
    }

    private async Task LagreUtkast()
    {
        if (_abo is null || _tenant is null || !HarUtkast)
        {
            return;
        }

        _lagrerUtkast = true;
        try
        {
            var punkter = UtkastPunkter.ToList();
            if (_pakkeEndret)
            {
                _abo.Pakke = _utkastPakke;
                await PlatformDb.SaveChangesAsync();
                await AbonnementSvc.LoggAsync(_tenant.Id, $"Pakke: {PakkeNavn(_abo.Pakke)}", "credit-card", _plattformBruker);
            }

            foreach (var (nokkel, antall) in _utkast)
            {
                await AbonnementSvc.SettAntallAsync(_tenant.Id, nokkel, antall, _plattformBruker);
                if (nokkel.StartsWith("modul:"))
                {
                    TilleggsmodulService.Nullstill(Cache, _tenant.Id);
                }
            }

            AngreUtkast();
            _aboMelding = $"Lagret: {string.Join(", ", punkter)}.";
            await LastAbonnementAsync();
        }
        finally
        {
            _lagrerUtkast = false;
        }
    }

    // ---------- Deaktivere og slette brukere ----------
    private int? _bekreftSlettBruker;

    private async Task SettBrukerAktiv(Bruker b, bool aktiv)
    {
        if (_tenant is null)
        {
            return;
        }

        var options = new DbContextOptionsBuilder<ApplicationDbContext>().UseSqlite(_tenant.ConnectionString).Options;
        await using var db = new ApplicationDbContext(options);
        var feil = aktiv
            ? await BrukerAdministrasjon.AktiverAsync(db, Tilgang, _tenant.Id, b.Id, null)
            : await BrukerAdministrasjon.DeaktiverAsync(db, Tilgang, _tenant.Id, b.Id, null);
        _brukerFeil = feil;
        _brukerMelding = feil is null ? (aktiv ? $"{b.Navn} er aktivert." : $"{b.Navn} er deaktivert og logget ut.") : null;
        if (feil is null)
        {
            await AbonnementSvc.LoggAsync(_tenant.Id, $"{b.Navn} {(aktiv ? "aktivert" : "deaktivert")}", "users", _plattformBruker);
        }

        await LastBrukereAsync();
        await LastAbonnementAsync();
    }

    private async Task SlettBrukerIOrg(Bruker b)
    {
        _bekreftSlettBruker = null;
        if (_tenant is null)
        {
            return;
        }

        var options = new DbContextOptionsBuilder<ApplicationDbContext>().UseSqlite(_tenant.ConnectionString).Options;
        await using var db = new ApplicationDbContext(options);
        var (feil, helt) = await BrukerAdministrasjon.SlettAsync(db, Tilgang, _tenant.Id, b.Id, null);
        _brukerFeil = feil;
        _brukerMelding = feil is null ? (helt ? $"{b.Navn} er slettet og logget ut." : $"{b.Navn} er slettet og logget ut. Timer og arbeidsordre står fortsatt på navnet.") : null;
        if (feil is null)
        {
            await AbonnementSvc.LoggAsync(_tenant.Id, $"{b.Navn} slettet", "trash", _plattformBruker);
        }

        await LastBrukereAsync();
        await LastAbonnementAsync();
    }

    // ---------- Backup ----------
    private List<TenantBackup> _backuper = [];
    private bool _tarBackup;
    private string? _backupMelding;
    private string? _backupFeil;
    private TenantBackup? _bekreftGjenoppretting;

    private async Task LastBackuperAsync()
    {
        if (_tenant is null)
        {
            return;
        }

        _backuper = await PlatformDb.TenantBackuper.AsNoTracking()
            .Where(b => b.TenantId == _tenant.Id && !b.ErPlattform)
            .OrderByDescending(b => b.Tidspunkt)
            .ToListAsync();
    }

    private async Task TaBackupNa()
    {
        if (_tenant is null)
        {
            return;
        }

        _tarBackup = true;
        _backupMelding = null;
        _backupFeil = null;
        StateHasChanged();
        try
        {
            var b = await BackupSvc.TaAsync(_tenant, BackupType.Manuell, _plattformBruker);
            if (b.Feil is null)
            {
                _backupMelding = $"Backup tatt: {Storrelse(b.DatabaseStorrelse)}, kontrollert og kryptert.";
            }
            else
            {
                _backupFeil = $"Backup feilet: {b.Feil}";
            }
        }
        finally
        {
            _tarBackup = false;
        }

        await LastBackuperAsync();
    }

    private async Task Gjenopprett()
    {
        if (_bekreftGjenoppretting is not { } backup)
        {
            return;
        }

        _tarBackup = true;
        _backupMelding = null;
        _backupFeil = null;
        StateHasChanged();
        try
        {
            var feil = await BackupSvc.GjenopprettAsync(backup.Id, _plattformBruker);
            if (feil is null)
            {
                _backupMelding = $"{_tenant?.Navn} er satt tilbake til {backup.Tidspunkt:dd.MM.yyyy HH:mm}. Dagens data ble lagret som en egen kopi først.";
            }
            else
            {
                _backupFeil = feil;
            }
        }
        finally
        {
            _tarBackup = false;
            _bekreftGjenoppretting = null;
        }

        await LastBackuperAsync();
        await LastBrukereAsync();
        await LastAbonnementAsync();
    }

    private static string Storrelse(long byte_)
    {
        if (byte_ <= 0)
        {
            return "–";
        }

        var mb = byte_ / 1024m / 1024m;
        return mb >= 1024 ? $"{mb / 1024:0.0} GB" : mb >= 1 ? $"{mb:0.#} MB" : $"{byte_ / 1024m:0} kB";
    }

    // ---------- E-post og varsler ----------
    private async Task LagreEpost()
    {
        _epostFeil = null;
        _epostMelding = null;
        if (_innstillinger is null || _tenant is null)
        {
            return;
        }

        var navn = _epostNavn.Trim().ToLowerInvariant();
        if (OrganisasjonOppsett.SjekkEpostNavn(PlatformDb, navn, _tenant.Id) is { } feil)
        {
            _epostFeil = feil;
            return;
        }

        var svarEpost = _svarTilEpost?.Trim();
        if (_svarTil == "epost" && (string.IsNullOrEmpty(svarEpost) || !svarEpost.Contains('@')))
        {
            _epostFeil = "Skriv inn e-postadressen svarene skal gå til.";
            return;
        }

        _innstillinger.EpostNavn = navn;
        _innstillinger.AvsenderNavn = string.IsNullOrWhiteSpace(_avsenderNavn) ? _tenant.Navn : _avsenderNavn.Trim();
        _innstillinger.SvarTilPortal = _svarTil == "portal";
        _innstillinger.SvarTilEpost = _svarTil == "epost" ? svarEpost : null;
        _innstillinger.SistEndret = DateTime.Now;
        await PlatformDb.SaveChangesAsync();
        _epostNavn = navn;
        _avsenderNavn = _innstillinger.AvsenderNavn;
        _epostMelding = $"Lagret. Adressen er {OrganisasjonOppsett.Adresse(navn)}.";
    }

    private async Task LeggTilMottaker()
    {
        _mottakerFeil = null;
        var epost = _nyMottakerEpost.Trim();
        if (epost.Length < 5 || !epost.Contains('@') || !epost.Contains('.'))
        {
            _mottakerFeil = "Skriv inn en gyldig e-postadresse.";
            return;
        }

        if (_mottakere.Any(m => string.Equals(m.Epost, epost, StringComparison.OrdinalIgnoreCase)))
        {
            _mottakerFeil = $"{epost} er allerede mottaker.";
            return;
        }

        var ny = new TenantVarselMottaker
        {
            TenantId = Id,
            Epost = epost,
            Beskrivelse = string.IsNullOrWhiteSpace(_nyMottakerBeskrivelse) ? null : _nyMottakerBeskrivelse.Trim()
        };
        PlatformDb.TenantVarselMottakere.Add(ny);
        await PlatformDb.SaveChangesAsync();
        _mottakere.Add(ny);
        _nyMottakerEpost = "";
        _nyMottakerBeskrivelse = "";
    }

    private async Task VekslVarsel(TenantVarselMottaker m, VarselType type)
    {
        switch (type)
        {
            case VarselType.Service: m.Service = !m.Service; break;
            case VarselType.Lisens: m.Lisens = !m.Lisens; break;
            case VarselType.Ticket: m.Ticket = !m.Ticket; break;
            case VarselType.Prosjektokonomi: m.Prosjektokonomi = !m.Prosjektokonomi; break;
        }

        await PlatformDb.SaveChangesAsync();
    }

    private async Task FjernMottaker(TenantVarselMottaker m)
    {
        PlatformDb.TenantVarselMottakere.Remove(m);
        await PlatformDb.SaveChangesAsync();
        _mottakere.Remove(m);
    }

    // Fakturert per måned siste 12 måneder (etter periodens startmåned).
    private void BeregnOmsetningHistorikk()
    {
        var liste = new List<(string Mnd, decimal Belop, bool ErNa)>();
        var naManed = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        var fakturerte = _fakturaer.Where(f => f.Status is not (PlattformFakturaStatus.Utkast or PlattformFakturaStatus.Kreditert)).ToList();

        for (var i = 11; i >= 0; i--)
        {
            var maned = naManed.AddMonths(-i);
            var belop = fakturerte.Where(f => f.PeriodeFra.Year == maned.Year && f.PeriodeFra.Month == maned.Month).Sum(f => f.BelopEksMva);
            liste.Add((maned.ToString("MMM", Nb), belop, maned == naManed));
        }

        _omsetningHistorikk = liste;
        _omsetningMaks = liste.Count == 0 ? 0 : liste.Max(p => p.Belop);
    }

    private void BeregnAktivitet()
    {
        if (_tenant is null) { return; }
        var hendelser = new List<AktivitetHendelse>
        {
            new("building", "Organisasjon opprettet", _tenant.Navn, _tenant.OpprettetDato)
        };

        if (_tenant.SistOppdatert.HasValue)
        {
            hendelser.Add(new AktivitetHendelse("edit", "Organisasjon oppdatert", _tenant.Navn, _tenant.SistOppdatert.Value));
        }

        foreach (var l in _lisenser)
        {
            hendelser.Add(new AktivitetHendelse("credit-card", $"{l.Type.Visningsnavn()} oppdatert", _tenant.Navn, l.SistEndret));
        }

        _aktivitet = hendelser.OrderByDescending(h => h.Tidspunkt).Take(8).ToList();
    }

    private async Task Lagre()
    {
        if (_tenant is null) { return; }
        _tenant.SistOppdatert = DateTime.Now;
        await PlatformDb.SaveChangesAsync();
        BeregnAktivitet();
    }

    private async Task OnLogoValgt(InputFileChangeEventArgs e)
    {
        if (_tenant is null) { return; }
        _logoFeil = null;
        var file = e.File;
        if (file.Size > 5_000_000)
        {
            _logoFeil = "Logoet er for stort (maks 5 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 5_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _tenant.LogoData = buffer.ToArray();
        _tenant.LogoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        await Lagre();
    }

    private async Task FjernLogo()
    {
        if (_tenant is null) { return; }
        _tenant.LogoData = null;
        _tenant.LogoContentType = null;
        await Lagre();
    }

    private async Task VelgTema(string temaId)
    {
        if (_tenant is null) { return; }
        _tenant.Tema = temaId;
        await Lagre();
    }


