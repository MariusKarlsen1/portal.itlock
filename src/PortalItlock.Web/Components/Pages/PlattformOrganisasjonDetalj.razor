                                @foreach (var t in NotatTyper)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </label>
                        <label class="pod-label" for="pod-notat-oppf">Følg opp (valgfritt)
                            <input id="pod-notat-oppf" class="pod-input" type="date" @bind="_nyNotatOppfolging" />
                        </label>
                        <label class="pod-label pod-notat-tekst" for="pod-notat-tekst">Notat
                            <textarea id="pod-notat-tekst" class="pod-input" rows="3" @bind="_nyNotatTekst" placeholder="Hva ble sagt eller avtalt?"></textarea>
                        </label>
                    </div>
                    <div class="pod-knapperad"><button type="button" class="pod-btn-primary" @onclick="LagreNotat">Lagre notat</button></div>
