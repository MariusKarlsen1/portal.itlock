    // ---------- Oppstart og oppfølging ----------
    private sealed record Punkt(string Tittel, string Tekst, bool Klar, string Status, string Ikon);

    private List<Punkt> OppstartPunkter
    {
        get
        {
            if (_tenant is null || _innstillinger is null)
            {
                return [];
            }

            var admin = _brukere.FirstOrDefault(b => b.Rolle == BrukerRolle.Admin && b.Aktiv);
            var harPassord = admin is not null && !string.IsNullOrEmpty(admin.PasswordHash);
            var harLisenser = _lisenser.Any(l => l.AntallTildelt > 0);
            var signert = _abo?.AvtaleSignert is not null && _abo.DatabehandleravtaleSignert is not null;
            return
            [
                new("Lisenser og moduler", $"{_lisenser.Sum(l => l.AntallTildelt)} lisenser · {Kr(Maanedsbelop)} per måned", harLisenser, harLisenser ? "Klar" : "Mangler", "credit-card"),
                new("Administrator", admin is null ? "Ingen aktiv administrator" : $"{admin.Navn} · {admin.Epost}{(harPassord ? "" : " · har ikke satt passord")}", harPassord, admin is null ? "Mangler" : harPassord ? "Klar" : "Venter", "users"),
                new("Påminnelser", _mottakere.Count > 0 ? $"{_mottakere.Count} {(_mottakere.Count == 1 ? "mottaker" : "mottakere")}" : "Ingen valgt, går til administratorene", _mottakere.Count > 0, _mottakere.Count > 0 ? "Klar" : "Velg", "bell"),
                new("Avtale og databehandleravtale", signert ? $"Signert {_abo!.AvtaleSignert:dd.MM.yyyy} og {_abo.DatabehandleravtaleSignert:dd.MM.yyyy}" : "Ikke registrert som signert", signert, signert ? "Klar" : "Ikke signert", "file-text"),
                new("E-postadresse", OrganisasjonOppsett.Adresse(_innstillinger.EpostNavn ?? ""), _plattform.EpostPerOrganisasjon, _plattform.EpostPerOrganisasjon ? "Klar" : "Reservert", "mail"),
                BackupPunkt(),
                new("Tripletex", !string.IsNullOrWhiteSpace(_innstillinger.TripletexEmployeeTokenKryptert) ? $"Koblet{(_innstillinger.TripletexFirma is { } tf ? $" til {tf}" : "")}" : "Mangler ansattnøkkel fra firmaet", !string.IsNullOrWhiteSpace(_innstillinger.TripletexEmployeeTokenKryptert), !string.IsNullOrWhiteSpace(_innstillinger.TripletexEmployeeTokenKryptert) ? "Klar" : "Mangler", "link-ikon"),
            ];
        }
    }

    private Punkt BackupPunkt()
    {
        var siste = _backuper.FirstOrDefault(b => b.Feil is null);
        var ok = siste is not null && siste.Tidspunkt > DateTime.Now.AddDays(-2);
        return new Punkt("Backup", siste is null ? "Første kopi tas i natt etter kl. 02" : $"Siste {siste.Tidspunkt:dd.MM.yyyy HH:mm} · {Storrelse(siste.DatabaseStorrelse)}",
            ok, ok ? "Klar" : siste is null ? "Venter" : "For gammel", "server");
    }

    private sealed record Oppfolging(string Tittel, string Tekst, string Ikon, bool Rod, string Knapp, string Fane, string? UnderFane = null);

    private List<Oppfolging> Oppfolgingspunkter()
    {
        var liste = new List<Oppfolging>();
        if (_tenant is null)
        {
            return liste;
        }

        foreach (var f in _fakturaer.Where(f => f.ErForfalt))
        {
            liste.Add(new($"Faktura for {AbonnementService.PeriodeTekst(f.PeriodeFra, f.PeriodeTil)} er forfalt", $"{Kr(f.Utestaende ?? f.BelopEksMva)}, forfalt {f.Forfall:dd.MM.yyyy}", "receipt", true, "Se faktura", "fakturaer"));
        }

        foreach (var f in _fakturaer.Where(f => f.Status == PlattformFakturaStatus.Utkast))
        {
            liste.Add(new("Fakturautkast venter", $"{AbonnementService.PeriodeTekst(f.PeriodeFra, f.PeriodeTil)}, {Kr(f.BelopEksMva)}", "receipt", false, "Se over", "fakturaer"));
        }

        foreach (var n in _notater.Where(n => !n.Utfort && n.Oppfolging is { } o && o.Date <= DateTime.Today.AddDays(3)))
        {
            liste.Add(new("Følg opp", $"{n.Oppfolging:dd.MM}: {n.Tekst}", "calendar", n.Oppfolging!.Value.Date < DateTime.Today, "Notater", "logg"));
        }

        foreach (var t in LisensTypeExtensions.Aktive.Where(t => Tildelt(t) > 0 && IBrukFor(t) >= Tildelt(t)))
        {
            liste.Add(new($"Alle {Tildelt(t)} {t.Visningsnavn().ToLowerInvariant()} er i bruk", "Neste de legger til, må du aktivere først", "users", false, "Abonnement", "abonnement"));
        }

        if (_abo?.ProveperiodeTil is { } prove && prove.Date >= DateTime.Today && prove.Date <= DateTime.Today.AddDays(7))
        {
            liste.Add(new("Prøveperioden slutter snart", $"Til {prove:dd.MM.yyyy}. Deretter faktureres de.", "calendar", false, "Abonnement", "abonnement"));
        }

        foreach (var p in OppstartPunkter.Where(p => !p.Klar && p.Status is "Mangler" or "Ikke signert" or "Venter" or "For gammel"))
        {
            liste.Add(new(p.Tittel, p.Tekst, p.Ikon, false, "Oppsett", "oppsett", "oppstart"));
        }

        return liste;
    }

    // ---------- Tripletex for organisasjonen ----------
    private string _txNokkel = "";
    private bool _txTester;
    private string? _txMelding;
    private bool _txFeil;

    private async Task LagreTripletex()
    {
        if (_innstillinger is null || string.IsNullOrWhiteSpace(_txNokkel))
        {
            _txMelding = "Lim inn nøkkelen først.";
            _txFeil = true;
            return;
        }

        _innstillinger.TripletexEmployeeTokenKryptert = Hemmelig.Krypter(_txNokkel.Trim());
        _innstillinger.TripletexFirma = null;
        _innstillinger.TripletexTestet = null;
        _txNokkel = "";
        await PlatformDb.SaveChangesAsync();
        await AbonnementSvc.LoggAsync(Id, "Tripletex-nøkkel lagt inn", "link-ikon", _plattformBruker);
        await TestLagretTripletex();
    }

    private async Task TestLagretTripletex()
    {
        if (_innstillinger is null || _tenant is null)
        {
            return;
        }

        _txTester = true;
        StateHasChanged();
        try
        {
            var nokler = TripletexOppslag.For(_tenant);
            if (nokler is null)
            {
                _txMelding = "Full Kontroll sitt consumer token mangler. Legg det inn under Innstillinger.";
                _txFeil = true;
                return;
            }

            var svar = await TripletexOppslag.Lag(nokler, _tenant.Id).TestTilkoblingAsync();
            _txFeil = !svar.Ok;
            if (svar.Ok)
            {
                _innstillinger.TripletexFirma = svar.FirmaNavn;
                _innstillinger.TripletexTestet = DateTime.Now;
                await PlatformDb.SaveChangesAsync();
                _txMelding = null;
            }
            else
            {
                _txMelding = $"Tripletex godtok ikke nøkkelen: {svar.Feilmelding}";
            }
        }
        finally
        {
            _txTester = false;
        }
    }

    private async Task FjernTripletex()
    {
        if (_innstillinger is null)
        {
            return;
        }

        _innstillinger.TripletexEmployeeTokenKryptert = null;
        _innstillinger.TripletexFirma = null;
        _innstillinger.TripletexTestet = null;
        await PlatformDb.SaveChangesAsync();
        await AbonnementSvc.LoggAsync(Id, "Tripletex-nøkkel fjernet", "link-ikon", _plattformBruker);
        _txMelding = "Nøkkelen er fjernet. Tripletex er stengt for organisasjonen.";
        _txFeil = false;
    }

