@page "/plattform/organisasjoner/{Id:int}"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache
@inject TenantStatistikkService Statistikk
@inject TenantOppslagService Oppslag
@inject NavigationManager Nav
@inject AbonnementService AbonnementSvc
@inject PlattformFakturaService FakturaSvc
@inject OrganisasjonBackupService BackupSvc
@inject BrukerTilgang Tilgang
@inject HemmelighetService Hemmelig
@inject TripletexNokkelOppslag TripletexOppslag
@inject InvitasjonService Invitasjon
@inject PlattformOppsettService Oppsett

<PageTitle>@(_tenant?.Navn ?? "Organisasjon") - Plattform</PageTitle>

@if (_tenant is null)
{
    @* Gammel lenke eller slettet organisasjon - vis alle, så man alltid kommer videre. *@
    <div class="pod-root">
        <div class="pod-brodsmule">
            <NavLink href="/plattform">Oversikt</NavLink>
        </div>
        <section class="pod-card">
            <h3 class="pod-h3">Fant ikke organisasjon @Id</h3>
            <p class="pod-tom-tekst">Den kan være slettet, eller lenken er gammel. Velg organisasjonen du vil administrere:</p>
            @foreach (var t in _alleTenants)
            {
                <a class="pod-lisens-rad pod-velg-org" href="@($"/plattform/organisasjoner/{t.Id}")">
                    <span class="pod-lisens-info"><span>@t.Navn</span><span class="pod-lisens-bruk">@(t.Subdomene is { Length: > 0 } s ? $"{s}.full-kontroll.no" : "full-kontroll.no") · @t.Status.Visningsnavn()</span></span>
                    <span class="pod-lisens-bruk">Åpne →</span>
                </a>
            }
        </section>
    </div>
}
else
{
    <div class="pod-root">
        <div class="pod-brodsmule">
            <NavLink href="/plattform/organisasjoner">Organisasjoner</NavLink>
            <span>/</span>
            <span class="pod-brodsmule-na">@_tenant.Navn</span>
        </div>

        <div class="pod-stortkort">
        <div class="pod-header">
            <div class="pod-header-venstre">
                @if (_tenant.LogoData is not null)
                {
                    <img class="pod-logo" src="@($"/plattform/organisasjon/{_tenant.Id}/logo?v={_tenant.SistOppdatert?.Ticks}")" alt="Logo" />
                }
                else
                {
                    var (bg, ink) = AvatarFarge(_tenant.Id);
                    <div class="pod-logo pod-logo-initialer" style="background:@bg; color:@ink;">@Initialer(_tenant.Navn)</div>
                }
                <div>
                    <div class="pod-navn-rad">
                        <h1 class="pod-h1">@_tenant.Navn</h1>
                        <span class="pod-badge pod-badge-@StatusKlasse(_tenant.Status)"><span class="pod-dot"></span>@_tenant.Status.Visningsnavn()</span>
                    </div>
                    <div class="pod-meta-rad">
                        @if (!string.IsNullOrWhiteSpace(_tenant.Subdomene))
                        {
                            <span><Icon Name="building" />@_tenant.Subdomene</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Kundeansvarlig))
                        {
                            <span><Icon Name="users" />@_tenant.Kundeansvarlig</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Epost))
                        {
                            <span><Icon Name="mail" />@_tenant.Epost</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Telefon))
                        {
                            <span><Icon Name="phone" />@_tenant.Telefon</span>
                        }
                        <span><Icon Name="calendar" />Opprettet @_tenant.OpprettetDato.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="pod-header-handlinger">
                <a class="pod-btn-ghost" href="@($"/plattform/organisasjoner/{Id}/tilbud.pdf")" target="_blank"><Icon Name="file-text" /> Tilbud (PDF)</a>
                <button type="button" class="pod-btn-ghost" @onclick="@(() => VisFane("logg"))"><Icon Name="clock" /> Nytt notat</button>
                <button type="button" class="pod-btn-ghost" @onclick="@(() => VisFane("innstillinger"))"><Icon Name="edit" /> Rediger</button>
            </div>
        </div>

        <div class="pod-faner" role="tablist" aria-label="Organisasjon">
            <button type="button" role="tab" aria-selected="@(_fane == "oversikt" ? "true" : "false")" class="pod-fane @(_fane == "oversikt" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("oversikt"))"><Icon Name="home" /> Oversikt</button>
            <button type="button" role="tab" aria-selected="@(_fane == "abonnement" ? "true" : "false")" class="pod-fane @(_fane == "abonnement" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("abonnement"))"><Icon Name="credit-card" /> Abonnement</button>
            <button type="button" role="tab" aria-selected="@(_fane == "fakturaer" ? "true" : "false")" class="pod-fane @(_fane == "fakturaer" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("fakturaer"))">
                <Icon Name="receipt" /> Fakturaer
                @if (AntallFakturaVarsel > 0)
                {
                    <span class="pod-fane-tall @(_fakturaer.Any(f => f.ErForfalt) ? "" : "pod-fane-tall-gul")">@AntallFakturaVarsel</span>
                }
            </button>
            <button type="button" role="tab" aria-selected="@(_fane == "brukere" ? "true" : "false")" class="pod-fane @(_fane == "brukere" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("brukere"))"><Icon Name="users" /> Brukere</button>
            <button type="button" role="tab" aria-selected="@(_fane == "oppsett" ? "true" : "false")" class="pod-fane @(_fane == "oppsett" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("oppsett"))">
                <Icon Name="settings" /> Oppsett
                @if (OppstartPunkter.Count(p => !p.Klar) > 0)
                {
                    <span class="pod-fane-tall pod-fane-tall-gul">@OppstartPunkter.Count(p => !p.Klar)</span>
                }
            </button>
            <button type="button" role="tab" aria-selected="@(_fane == "logg" ? "true" : "false")" class="pod-fane @(_fane == "logg" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("logg"))"><Icon Name="clock" /> Logg og notater</button>
            <button type="button" role="tab" aria-selected="@(_fane == "innstillinger" ? "true" : "false")" class="pod-fane @(_fane == "innstillinger" ? "pod-fane-aktiv" : "")" @onclick="@(() => VisFane("innstillinger"))"><Icon Name="edit" /> Innstillinger</button>
        </div>
        <div class="pod-innhold">

        @* ================= OVERSIKT ================= *@
        @if (_fane == "oversikt")
        {
            var brukerLisens = AnsattLisenser;
            var brukereIBruk = AnsatteIBruk;
            var utestaende = _fakturaer.Where(f => f.Status == PlattformFakturaStatus.Fakturert).Sum(f => f.Utestaende ?? 0);
            var forfalte = _fakturaer.Where(f => f.ErForfalt).ToList();
            <div class="pod-kpi-grid pod-kpi-grid-4">
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Per måned</span><span class="pod-kpi-ikon"><Icon Name="credit-card" /></span></div>
                    <div class="pod-kpi-verdi">@Kr(Maanedsbelop)</div>
                    <div class="pod-kpi-sub">eks. mva, fra abonnementet</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Utestående</span><span class="pod-kpi-ikon"><Icon Name="receipt" /></span></div>
                    <div class="pod-kpi-verdi @(forfalte.Count > 0 ? "pod-rod" : "")">@Kr(utestaende)</div>
                    <div class="pod-kpi-sub">inkl. mva · @(forfalte.Count > 0 ? $"{forfalte.Count} forfalt" : "ingen forfalte")</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Brukere</span><span class="pod-kpi-ikon"><Icon Name="users" /></span></div>
                    <div class="pod-kpi-verdi">@brukereIBruk av @brukerLisens</div>
                    <div class="pod-kpi-sub">lisenser i bruk</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Neste faktura</span><span class="pod-kpi-ikon"><Icon Name="calendar" /></span></div>
                    <div class="pod-kpi-verdi">@(_forhandsvisning?.PeriodeFra.ToString("dd.MM.yyyy") ?? "–")</div>
                    <div class="pod-kpi-sub">@(_forhandsvisning is { } fv ? $"{Kr(fv.BelopEksMva)} eks. mva" : "")</div>
                </div>
            </div>

            <div class="pod-midt-rad pod-midt-rad-to">
                <section class="pod-card">
                    <h3 class="pod-h3">Trenger oppfølging</h3>
                    @{
                        var punkter = Oppfolgingspunkter();
                    }
                    @if (punkter.Count == 0)
                    {
                        <p class="pod-tom-tekst">Alt ser bra ut. Ingenting å følge opp.</p>
                    }
                    else
                    {
                        <div class="pod-sjekk">
                            @foreach (var p in punkter)
                            {
                                var punkt = p;
                                <div class="pod-sjekk-rad">
                                    <span class="pod-sjekk-ikon @(punkt.Rod ? "pod-sjekk-rod" : "pod-sjekk-gul")"><Icon Name="@punkt.Ikon" /></span>
                                    <span class="pod-sjekk-tekst">@punkt.Tittel<small>@punkt.Tekst</small></span>
                                    <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => VisFane(punkt.Fane, punkt.UnderFane))">@punkt.Knapp</button>
                                </div>
                            }
                        </div>
                    }
                </section>
                <section class="pod-card">
                    @{
                        var klare = OppstartPunkter.Count(p => p.Klar);
                    }
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Oppsett</h3>
                        <span class="pod-oppstart-teller">@klare av @OppstartPunkter.Count klart</span>
                    </div>
                    <div class="pod-fremdrift"><i style="width:@((OppstartPunkter.Count == 0 ? 0 : klare * 100 / OppstartPunkter.Count).ToString(CultureInfo.InvariantCulture))%"></i></div>
                    <div class="pod-sjekk">
                        @foreach (var p in OppstartPunkter)
                        {
                            <div class="pod-sjekk-rad pod-sjekk-rad-tett">
                                <span class="pod-sjekk-tekst">@p.Tittel</span>
                                <span class="pod-chip @(p.Klar ? "pod-chip-ok" : "pod-chip-gul")">@p.Status</span>
                            </div>
                        }
                    </div>
                    <button type="button" class="pod-vis-alle" @onclick="@(() => VisFane("oppsett", "oppstart"))">Gå til oppsett →</button>
                </section>
            </div>

            <div class="pod-midt-rad">
                <section class="pod-card">
                    <h3 class="pod-h3">Om organisasjonen</h3>
                    <div class="pod-info-rad"><span>Org.nr</span><strong>@(_tenant.OrgNr ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Adresse</span><strong>@(_tenant.Adresse ?? "-")@(string.IsNullOrWhiteSpace(_tenant.Postnr) && string.IsNullOrWhiteSpace(_tenant.Sted) ? "" : $", {_tenant.Postnr} {_tenant.Sted}")</strong></div>
                    <div class="pod-info-rad"><span>Kontaktperson</span><strong>@(_tenant.Kundeansvarlig ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>E-post</span><strong>@(_tenant.Epost ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Telefon</span><strong>@(_tenant.Telefon ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Kunde siden</span><strong>@(_abo?.Startdato.ToString("dd.MM.yyyy") ?? _tenant.OpprettetDato.ToString("dd.MM.yyyy"))</strong></div>
                </section>

                <section class="pod-card">
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Fakturert siste 12 måneder</h3>
                    </div>
                    <div class="pod-stolpediagram">
                        @foreach (var punkt in _omsetningHistorikk)
                        {
                            var hoyde = _omsetningMaks <= 0 ? 4 : Math.Max(4, (double)(punkt.Belop / _omsetningMaks) * 100);
                            <div class="pod-stolpe-kol" title="@($"{punkt.Mnd}: {punkt.Belop:N0} kr")">
                                <div class="pod-stolpe @(punkt.ErNa ? "pod-stolpe-na" : "")" style="height: @(hoyde.ToString(CultureInfo.InvariantCulture))%"></div>
                                <span class="pod-stolpe-label">@punkt.Mnd</span>
                            </div>
                        }
                    </div>
                    <p class="pod-tom-tekst">Sum av fakturaer per periode, eks. mva.</p>
                </section>

                <section class="pod-card">
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Siste notat</h3>
                        <button type="button" class="pod-vis-alle" @onclick="@(() => VisFane("logg"))">Alle →</button>
                    </div>
                    @if (_notater.FirstOrDefault() is { } sisteNotat)
                    {
                        <div class="pod-notat">
                            <small>@sisteNotat.Dato.ToString("dd.MM.yyyy") · @sisteNotat.Type@(sisteNotat.Av is { } av ? $" · {av}" : "")</small>
                            <span>@sisteNotat.Tekst</span>
                            @if (sisteNotat.Oppfolging is { } opp && !sisteNotat.Utfort)
                            {
                                <small class="@(opp.Date <= DateTime.Today ? "pod-rod" : "")">Følg opp @opp.ToString("dd.MM.yyyy")</small>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="pod-tom-tekst">Ingen notater ennå.</p>
                    }
                </section>
            </div>
        }

        @* ================= ABONNEMENT ================= *@
        @if (_fane == "abonnement" && _abo is not null)
        {
            var visning = Forhandsvis;
            var visSum = AbonnementService.Maanedsbelop(visning, _plattform);
            var visRabattProsent = AbonnementService.RabattProsent(visning, _plattform);
            var visRabatt = Math.Round(AbonnementService.Rabattgrunnlag(visning) * visRabattProsent / 100m, 2);
            var ansattLinjer = visning.Where(l => l.Type == PrisType.Lisens && LisensFor(l) is { } t && LisensTypeExtensions.Ansatte.Contains(t)).ToList();
            var aktivPakke = _pakkeEndret ? _utkastPakke : _abo.Pakke;
            var aktivPakkeNavn = _pakker.FirstOrDefault(p => p.Nokkel == aktivPakke)?.Navn ?? "Egendefinert";

            <div class="pod-ab-stripe">
                <div><span class="pod-ab-eyebrow">Per måned, eks. mva</span><b>@Kr(visSum)</b><small>pakke @aktivPakkeNavn</small></div>
                <div><span class="pod-ab-eyebrow">Per år</span><b>@Kr(visSum * 12)</b><small>faktureres @_abo.Intervall.Visningsnavn().ToLowerInvariant()</small></div>
                <div><span class="pod-ab-eyebrow">Lisenser i bruk</span><b>@AnsatteIBruk av @ansattLinjer.Sum(l => l.Antall)</b><small>ansatte</small></div>
                <div><span class="pod-ab-eyebrow">Neste faktura</span><b>@_abo.NesteFakturaFra.ToString("dd.MM.yyyy")</b><small>@(_forhandsvisning is { } nf ? $"{Kr(nf.BelopEksMva)} eks. mva" : "")</small></div>
            </div>

            <div class="pod-ab-oppsett">
                <div class="pod-ab-venstre">
                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Pakke</h3><span class="pod-tom-tekst">Pakken bestemmer prisen per lisens</span><a class="pod-vis-alle" href="/plattform/prisliste">Prisliste →</a></div>
                        <div class="pod-ab-pakker">
                            @foreach (var p in _pakker)
                            {
                                var pakke = p;
                                var fra = _pakkePriserAlle.Where(x => x.PakkeNokkel == pakke.Nokkel && x.ProduktNokkel == PrisProdukt.ForLisens(LisensType.Montor)).Select(x => (decimal?)x.Kr).FirstOrDefault();
                                <button type="button" class="pod-ab-pakke" aria-pressed="@(aktivPakke == pakke.Nokkel ? "true" : "false")" @onclick="@(() => VelgUtkastPakke(pakke.Nokkel))">
                                    <b>@pakke.Navn</b>
                                    <small>@pakke.Beskrivelse</small>
                                    @if (fra is { } f)
                                    {
                                        <span>@Kr(f) per lisens</span>
                                    }
                                </button>
                            }
                            <button type="button" class="pod-ab-pakke" aria-pressed="@(aktivPakke is null ? "true" : "false")" @onclick="@(() => VelgUtkastPakke(null))">
                                <b>Egendefinert</b>
                                <small>Listepris og egne avtalepriser</small>
                                <span>Egne priser</span>
                            </button>
                        </div>
                    </section>

                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Lisenser</h3><button type="button" class="pod-ab-lenke" @onclick="@(() => _visAvtalepris = !_visAvtalepris)">@(_visAvtalepris ? "Ferdig" : "Endre avtalepris")</button></div>
                        <div class="pod-ab-lisenser">
                            @foreach (var l in visning.Where(l => l.Type == PrisType.Lisens))
                            {
                                var linje = l;
                                var bruk = BrukTall(linje);
                                var over = bruk is { } b1 && b1 > linje.Antall;
                                var full = bruk is { } b2 && b2 >= linje.Antall && linje.Antall > 0;
                                var bredde = bruk is null ? 0 : linje.Antall == 0 ? (bruk > 0 ? 100 : 0) : Math.Min(100, bruk.Value * 100 / linje.Antall);
                                var endret = _utkast.ContainsKey(linje.Nokkel);
                                <div class="pod-ab-lisens @(endret ? "endret" : "")">
                                    <span class="pod-ab-ikon">@LisensKort(linje.Navn)</span>
                                    <div class="pod-ab-info">
                                        <b>@linje.Navn</b>
                                        @if (bruk is not null)
                                        {
                                            <div class="pod-ab-bruk">
                                                <span class="pod-ab-bar @(over ? "over" : full ? "full" : "")"><i style="width:@(bredde)%"></i></span>
                                                @if (over)
                                                {
                                                    <span class="pod-ab-rod">@bruk i bruk, @(bruk - linje.Antall) for få</span>
                                                }
                                                else
                                                {
                                                    <span>@bruk av @linje.Antall i bruk</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <small>@linje.Beskrivelse</small>
                                        }
                                    </div>
                                    <div class="pod-ab-teller">
                                        <button type="button" aria-label="@($"Færre {linje.Navn}")" disabled="@(linje.Antall <= 0)" @onclick="@(() => EndreUtkast(linje.Nokkel, -1))">−</button>
                                        <span>@linje.Antall</span>
                                        <button type="button" aria-label="@($"Flere {linje.Navn}")" @onclick="@(() => EndreUtkast(linje.Nokkel, 1))">+</button>
                                    </div>
                                    <div class="pod-ab-sum">
                                        @if (_visAvtalepris)
                                        {
                                            <label>Avtalepris
                                                <input class="pod-input" type="number" min="0" placeholder="@linje.Listepris.ToString("0", CultureInfo.InvariantCulture)"
                                                       value="@(linje.HarAvtalepris ? linje.Pris.ToString("0.##", CultureInfo.InvariantCulture) : "")" aria-label="@($"Avtalepris {linje.Navn}")"
                                                       @onchange="@(e => SettAvtalepris(linje.Nokkel, e.Value?.ToString()))" />
                                            </label>
                                        }
                                        else
                                        {
                                            <b>@Kr(linje.Sum)</b>
                                            <small class="@(linje.HarAvtalepris ? "avtale" : "")">@Kr(linje.Pris) @(linje.HarAvtalepris ? "avtalepris" : linje.PakkeStorrelse > 1 ? $"per pakke à {linje.PakkeStorrelse}" : "per stk")</small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Tilleggsmoduler</h3></div>
                        <div class="pod-ab-moduler">
                            @foreach (var l in visning.Where(l => l.Type is PrisType.Fast or PrisType.Modul))
                            {
                                var linje = l;
                                <div class="pod-ab-modul @(_utkast.ContainsKey(linje.Nokkel) ? "endret" : "")">
                                    <span><b>@linje.Navn</b><small>@(linje.Beskrivelse is { Length: > 0 } bs ? $"{bs} · " : "")@Kr(linje.Pris)/mnd</small></span>
                                    <button type="button" class="pod-modul-bryter" role="switch" aria-checked="@(linje.Antall > 0 ? "true" : "false")" aria-label="@linje.Navn"
                                            @onclick="@(() => SettUtkast(linje.Nokkel, linje.Antall > 0 ? 0 : 1))"></button>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Fakturering og avtale</h3></div>
                        <div class="pod-ab-segment" role="group" aria-label="Faktureres">
                            @foreach (var i in Enum.GetValues<FakturaIntervall>())
                            {
                                var intervall = i;
                                <button type="button" aria-pressed="@(_abo.Intervall == intervall ? "true" : "false")" @onclick="@(async () => { _abo.Intervall = intervall; await LagreAbonnement(); })">@intervall.Visningsnavn()</button>
                            }
                        </div>
                        <div class="pod-ab-felter">
                            <label class="pod-label" for="pod-fakturaepost">Faktura sendes til
                                <input id="pod-fakturaepost" class="pod-input" type="email" @bind="_abo.FakturaEpost" @bind:after="LagreAbonnement" placeholder="faktura@firma.no" />
                            </label>
                            <label class="pod-label" for="pod-frist">Betalingsfrist (dager)
                                <input id="pod-frist" class="pod-input" type="number" min="0" max="90" @bind="_abo.BetalingsfristDager" @bind:after="LagreAbonnement" />
                            </label>
                            <label class="pod-label" for="pod-etablering">Etablering (tom = listepris)
                                <input id="pod-etablering" class="pod-input" type="number" min="0" @bind="_abo.Etableringsgebyr" @bind:after="LagreAbonnement" disabled="@_abo.EtableringFakturert" />
                            </label>
                            <label class="pod-label" for="pod-start">Kunde siden
                                <input id="pod-start" class="pod-input" type="date" @bind="_abo.Startdato" @bind:after="LagreAbonnement" />
                            </label>
                            <label class="pod-label" for="pod-prove">Prøveperiode til
                                <input id="pod-prove" class="pod-input" type="date" @bind="_abo.ProveperiodeTil" @bind:after="LagreAbonnement" />
                            </label>
                            <label class="pod-label" for="pod-binding">Binding til
                                <input id="pod-binding" class="pod-input" type="date" @bind="_abo.BindingTil" @bind:after="LagreAbonnement" />
                            </label>
                            <label class="pod-label" for="pod-neste">Neste faktura gjelder fra
                                <input id="pod-neste" class="pod-input" type="date" @bind="_abo.NesteFakturaFra" @bind:after="LagreAbonnement" />
                            </label>
                        </div>
                        @if (_abo.EtableringFakturert)
                        {
                            <p class="pod-tom-tekst">Etableringen er fakturert.</p>
                        }
                    </section>

                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Endringer</h3></div>
                        @{
                            var endringer = _hendelser.Where(h => h.Ikon is "credit-card" or "tag").Take(8).ToList();
                        }
                        @if (endringer.Count == 0)
                        {
                            <p class="pod-tom-tekst">Ingen endringer ennå.</p>
                        }
                        else
                        {
                            <div class="pod-tidslinje">
                                @foreach (var h in endringer)
                                {
                                    <div><time>@h.Tidspunkt.ToString("dd.MM.yy")</time><span>@h.Tekst</span></div>
                                }
                            </div>
                        }
                    </section>
                </div>

                <aside class="pod-ab-sammendrag">
                    <section class="pod-card pod-ab-kort">
                        <div class="pod-ab-topp"><h3 class="pod-h3">Sammendrag</h3><span class="pod-ab-chip">@aktivPakkeNavn</span></div>
                        <div class="pod-ab-kvittering">
                            @foreach (var l in visning.Where(l => l.Antall > 0 && l.Sum > 0))
                            {
                                <div><span>@(l.Type == PrisType.Lisens ? $"{l.Antall} × {l.Navn}" : l.Navn)</span><span>@Kr(l.Sum)</span></div>
                            }
                            @if (visRabatt > 0)
                            {
                                <div class="rabatt"><span>Volumrabatt @visRabattProsent %</span><span>−@Kr(visRabatt)</span></div>
                            }
                            <div class="sum"><span>Per måned</span><span>@Kr(visSum)</span></div>
                        </div>
                        @if (HarUtkast)
                        {
                            var diff = visSum - Maanedsbelop;
                            var iDag = DateTime.Today;
                            var dagerIgjen = DateTime.DaysInMonth(iDag.Year, iDag.Month) - iDag.Day + 1;
                            var prorata = Math.Round(diff * dagerIgjen / DateTime.DaysInMonth(iDag.Year, iDag.Month));
                            <div class="pod-ab-endring">
                                <b>@(diff >= 0 ? "+" : "−")@Kr(Math.Abs(diff)) per måned</b>
                                <ul>
                                    @foreach (var punkt in UtkastPunkter)
                                    {
                                        <li>@punkt</li>
                                    }
                                </ul>
                                <small>@(diff > 0 ? $"Ca. {Kr(prorata)} legges på neste faktura for resten av perioden." : "Gjelder fra neste faktura.")</small>
                            </div>
                        }
                        <div class="pod-ab-knapper">
                            <button type="button" class="pod-btn-ghost" disabled="@(!HarUtkast)" @onclick="AngreUtkast">Angre</button>
                            <button type="button" class="pod-btn-primary" disabled="@(!HarUtkast || _lagrerUtkast)" @onclick="LagreUtkast">@(_lagrerUtkast ? "Lagrer …" : "Lagre endringer")</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_aboMelding))
                        {
                            <p class="pod-suksessmelding">@_aboMelding</p>
                        }
                        <a class="pod-btn-ghost pod-ab-pdf" href="@($"/plattform/organisasjoner/{Id}/tilbud.pdf")" target="_blank"><Icon Name="file-text" /> Tilbud (PDF)</a>
                    </section>
                </aside>
            </div>
        }

        @* ================= FAKTURAER ================= *@
        @if (_fane == "fakturaer")
        {
                @if (!_tripletexKlar)
                {
                    <p class="pod-varselstripe">Tripletex er ikke satt opp under Innstillinger, så fakturaer kan ikke sendes dit. Du kan fakturere på annen måte og markere dem som fakturert og betalt her.</p>
                }
                @if (_forhandsvisning is { } neste && !_fakturaer.Any(f => f.Status == PlattformFakturaStatus.Utkast))
                {
                    <section class="pod-card pod-forhand">
                        <div class="pod-kort-header-rad">
                            <span>
                                <h3 class="pod-h3">Neste faktura: @AbonnementService.PeriodeTekst(neste.PeriodeFra, neste.PeriodeTil)</h3>
                                <p class="pod-tom-tekst">Lages automatisk @neste.PeriodeFra.ToString("dd.MM.yyyy") som utkast. Du ser over og sender den selv.</p>
                            </span>
                            <b class="pod-forhand-sum">@Kr(neste.BelopEksMva) <small>eks. mva</small></b>
                        </div>
                        @FakturaLinjer(neste)
                        <div class="pod-knapperad">
                            <button type="button" class="pod-btn-ghost" disabled="@(neste.Linjer.Count == 0)" @onclick="LagFakturaNa">Lagre som utkast</button>
                            <button type="button" class="pod-btn-primary" disabled="@(neste.Linjer.Count == 0)" @onclick="VisNesteFaktura"><Icon Name="eye" /> Forhåndsvis</button>
                        </div>
                    </section>
                }
                @if (!string.IsNullOrEmpty(_fakturaFeil))
                {
                    <p class="pod-feilmelding">@_fakturaFeil</p>
                }
                @if (!string.IsNullOrEmpty(_fakturaMelding))
                {
                    <p class="pod-suksessmelding">@_fakturaMelding</p>
                }

                <section class="pod-card">
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Fakturaer (@_fakturaer.Count)</h3>
                        @if (_tripletexKlar)
                        {
                            <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="HentBetalinger"><Icon Name="download" /> Hent status fra Tripletex</button>
                        }
                    </div>
                    @if (_fakturaer.Count == 0)
                    {
                        <p class="pod-tom-tekst">Ingen fakturaer ennå.</p>
                    }
                    else
                    {
                        <div class="pod-tabell-ramme">
                            <table class="pod-varsel-tabell">
                                <thead><tr><th>Periode</th><th class="pod-n">Beløp eks. mva</th><th>Tripletex</th><th>Forfall</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var f in _fakturaer)
                                    {
                                        var faktura = f;
                                        <tr class="pod-klikkrad" @onclick="@(() => _apenFaktura = _apenFaktura == faktura.Id ? null : faktura.Id)">
                                            <td><b>@AbonnementService.PeriodeTekst(faktura.PeriodeFra, faktura.PeriodeTil)</b><small>Laget @faktura.Opprettet.ToString("dd.MM.yyyy")</small></td>
                                            <td class="pod-n">@Kr(faktura.BelopEksMva)</td>
                                            <td>@(faktura.TripletexFakturaNummer is { } fnr ? $"Faktura {fnr}" : faktura.TripletexOrdreNummer is { } onr ? $"Ordre {onr}" : "–")</td>
                                            <td>@(faktura.Forfall?.ToString("dd.MM.yyyy") ?? "–")</td>
                                            <td><span class="pod-chip @FakturaKlasse(faktura)">@FakturaStatus(faktura)</span></td>
                                            <td class="pod-n" @onclick:stopPropagation="true">
                                                <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => VisFakturaPdf(faktura))"><Icon Name="eye" /> Vis</button>
                                                @if (faktura.Status == PlattformFakturaStatus.Utkast)
                                                {
                                                    @if (_tripletexKlar)
                                                    {
                                                        <button type="button" class="pod-btn-primary pod-btn-liten" disabled="@_sender" @onclick="@(() => SendFaktura(faktura.Id))">Send til Tripletex</button>
                                                    }
                                                    <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => MarkerFaktura(faktura.Id, PlattformFakturaStatus.Fakturert))">Marker fakturert</button>
                                                    <button type="button" class="pod-btn-ghost pod-btn-liten" title="Slett utkastet" aria-label="Slett utkastet" @onclick="@(() => SlettUtkast(faktura.Id))"><Icon Name="trash" /></button>
                                                }
                                                else if (faktura.Status is PlattformFakturaStatus.Fakturert or PlattformFakturaStatus.SendtTilTripletex)
                                                {
                                                    <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => MarkerFaktura(faktura.Id, PlattformFakturaStatus.Betalt))">Marker betalt</button>
                                                }
                                            </td>
                                        </tr>
                                        @if (_apenFaktura == faktura.Id)
                                        {
                                            <tr class="pod-faktura-detalj"><td colspan="6">
                                                @FakturaLinjer(faktura)
                                                @if (!string.IsNullOrEmpty(faktura.Feil))
                                                {
                                                    <p class="pod-feilmelding">@faktura.Feil</p>
                                                }
                                            </td></tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="pod-tom-tekst">Sendt til Tripletex blir fakturaen en ordre klar til fakturering. Fakturer den der, så hentes fakturanummer, forfall og betaling hit hver sjette time.</p>
                    }
                </section>
            @if (_fakturaPdfErNeste)
            {
                <PdfPreviewModal Url="@_fakturaPdfUrl" Tittel="@_fakturaPdfTittel" SaveButtonText="Lagre som utkast" OnSave="LagreNesteFraForhandsvisning" OnClose="@(() => _fakturaPdfUrl = null)" />
            }
            else
            {
                <PdfPreviewModal Url="@_fakturaPdfUrl" Tittel="@_fakturaPdfTittel" OnClose="@(() => _fakturaPdfUrl = null)" />
            }
        }

        @* ================= BRUKERE ================= *@
        @if (_fane == "brukere")
        {
            <section class="pod-card">
                <div class="pod-kort-header-rad">
                    <h3 class="pod-h3">Brukere (@_brukere.Count)</h3>
                    <span class="pod-tom-tekst">@string.Join(" · ", LisensTypeExtensions.Aktive.Select(t => $"{t.Kortnavn()} {IBrukFor(t)} av {Tildelt(t)}"))</span>
                    <button type="button" class="pod-btn-primary" @onclick="@(() => _visNyBruker = !_visNyBruker)"><Icon Name="plus" /> Ny bruker</button>
                </div>

                @if (_visNyBruker)
                {
                    <div class="pod-form-grid">
                        <label class="pod-label">Navn<input class="pod-input" @bind="_nyBrukerNavn" placeholder="F.eks. Kari Hansen" /></label>
                        <label class="pod-label">E-post<input class="pod-input" @bind="_nyBrukerEpost" placeholder="kari@eksempel.no" /></label>
                        <label class="pod-label">
                            Rolle
                            <select class="pod-input" @bind="_nyBrukerRolle">
                                @foreach (var r in Enum.GetValues<BrukerRolle>())
                                {
                                    <option value="@r">@r.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="pod-knapperad">
                        <button type="button" class="pod-btn-primary" @onclick="OpprettBruker">Opprett bruker</button>
                        <button type="button" class="pod-btn-ghost" @onclick="@(() => _visNyBruker = false)">Avbryt</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_brukerFeil))
                {
                    <p class="pod-feilmelding">@_brukerFeil</p>
                }
                @if (!string.IsNullOrEmpty(_brukerMelding))
                {
                    <p class="pod-suksessmelding">@_brukerMelding</p>
                }
                @if (!string.IsNullOrEmpty(_invMelding))
                {
                    <p class="@(_invFeil ? "pod-feilmelding" : "pod-suksessmelding")">@_invMelding</p>
                }

                @if (_brukere.Count == 0)
                {
                    <p class="pod-tom-tekst">Ingen brukere ennå.</p>
                }
                else
                {
                    <div class="pod-tabell-ramme">
                        <table class="pod-varsel-tabell">
                            <thead><tr><th>Navn</th><th>Rolle</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var b in _brukere)
                                {
                                    var bruker = b;
                                    <tr class="@(bruker.Aktiv ? "" : "pod-dempet")">
                                        <td><b>@bruker.Navn</b><small>@bruker.Epost</small></td>
                                        <td><span class="pod-rolle-pille">@bruker.Rolle.Visningsnavn()</span></td>
                                        <td><span class="pod-badge pod-badge-@(bruker.Aktiv ? "aktiv" : "oppsagt")"><span class="pod-dot"></span>@(bruker.Aktiv ? (string.IsNullOrEmpty(bruker.PasswordHash) ? "Har ikke satt passord" : "Aktiv") : "Deaktivert")</span></td>
                                        <td class="pod-n">
                                            @if (_bekreftSlettBruker == bruker.Id)
                                            {
                                                <span class="pod-rod">Slette @bruker.Navn?</span>
                                                <button type="button" class="pod-btn-slett pod-btn-liten" @onclick="@(() => SlettBrukerIOrg(bruker))">Ja, slett</button>
                                                <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => _bekreftSlettBruker = null)">Avbryt</button>
                                            }
                                            else
                                            {
                                                @if (bruker.Aktiv && string.IsNullOrEmpty(bruker.PasswordHash))
                                                {
                                                    <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => SendInvitasjon(bruker))">Send invitasjon</button>
                                                }
                                                <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => SettBrukerAktiv(bruker, !bruker.Aktiv))">@(bruker.Aktiv ? "Deaktiver" : "Aktiver")</button>
                                                <button type="button" class="pod-btn-ghost pod-btn-liten" title="Slett brukeren" aria-label="@($"Slett {bruker.Navn}")" @onclick="@(() => _bekreftSlettBruker = bruker.Id)"><Icon Name="trash" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @* ================= OPPSETT ================= *@
        @if (_fane == "oppsett" && _innstillinger is not null)
        {
            <div class="pod-under-faner">
                <nav class="pod-under-meny" aria-label="Oppsett">
                    @foreach (var (nokkel, navn) in new[] { ("oppstart", "Oppstart"), ("epost", "E-post og varsler"), ("tripletex", "Tripletex"), ("backup", "Backup") })
                    {
                        var n = nokkel;
                        <button type="button" class="@(_oppsettFane == n ? "aktiv" : "")" aria-current="@(_oppsettFane == n ? "true" : "false")" @onclick="@(() => _oppsettFane = n)">@navn</button>
                    }
                </nav>
                <div class="pod-under-innhold">
                    @if (_oppsettFane == "oppstart")
                    {
                        <div class="pod-midt-rad pod-midt-rad-to">
                            <section class="pod-card">
                                <div class="pod-kort-header-rad">
                                    <h3 class="pod-h3">Klar til bruk?</h3>
                                    <span class="pod-oppstart-teller">@OppstartPunkter.Count(p => p.Klar) av @OppstartPunkter.Count klart</span>
                                </div>
                                <div class="pod-sjekk">
                                    @foreach (var p in OppstartPunkter)
                                    {
                                        <div class="pod-sjekk-rad">
                                            <span class="pod-sjekk-ikon @(p.Klar ? "pod-sjekk-ok" : "pod-sjekk-gul")"><Icon Name="@(p.Klar ? "check" : p.Ikon)" /></span>
                                            <span class="pod-sjekk-tekst">@p.Tittel<small>@p.Tekst</small></span>
                                            <span class="pod-chip @(p.Klar ? "pod-chip-ok" : "pod-chip-gul")">@p.Status</span>
                                        </div>
                                    }
                                </div>
                            </section>
                            <section class="pod-card">
                                <h3 class="pod-h3">Avtale og databehandleravtale</h3>
                                <p class="pod-tom-tekst">Registrer når kunden har signert abonnementsvilkårene og databehandleravtalen. Databehandleravtalen er påkrevd etter GDPR, siden du lagrer kundens data.</p>
                                @if (_abo is not null)
                                {
                                    <label class="pod-label" for="pod-avtale">Abonnementsavtale signert
                                        <input id="pod-avtale" class="pod-input" type="date" @bind="_abo.AvtaleSignert" @bind:after="LagreAbonnement" />
                                    </label>
                                    <label class="pod-label" for="pod-dba">Databehandleravtale signert
                                        <input id="pod-dba" class="pod-input" type="date" @bind="_abo.DatabehandleravtaleSignert" @bind:after="LagreAbonnement" />
                                    </label>
                                }
                                <h3 class="pod-h3 pod-h3-mellom">Dette trenger du fra daglig leder</h3>
                                <ul class="pod-innhent">
                                    <li>Firmanavn, org.nr. og logo</li>
                                    <li>Administrator: navn og e-post</li>
                                    <li>Ønsket e-postnavn, for eksempel <b>@(_innstillinger.EpostNavn ?? "firmanavn")</b>@("@" + OrganisasjonOppsett.EpostDomene)</li>
                                    <li>Hvem som skal få påminnelsene</li>
                                    <li>Antall brukere, moduler og fakturaadresse</li>
                                    <li>Tripletex-nøkkel, når koblingen per firma er klar</li>
                                </ul>
                            </section>
                        </div>
                    }
                    @if (_oppsettFane == "epost")
                    {
                        <div class="pod-midt-rad pod-midt-rad-to">
                            <section class="pod-card">
                                <div class="pod-kort-header-rad">
                                    <h3 class="pod-h3">Organisasjonens e-postadresse</h3>
                                    <span class="pod-chip @(_plattform.EpostPerOrganisasjon ? "pod-chip-ok" : "pod-chip-gul")">@(_plattform.EpostPerOrganisasjon ? "I bruk" : "Slås på under Innstillinger")</span>
                                </div>
                                <p class="pod-tom-tekst">Brukes både som avsender og som innboks. E-post til adressen havner i portalen til @_tenant.Navn, og bare der.</p>
                                <label class="pod-label" for="pod-epostnavn">Adresse
                                    <span class="pod-adresse">
                                        <input id="pod-epostnavn" class="pod-input" @bind="_epostNavn" @bind:event="oninput" />
                                        <span>@("@" + OrganisasjonOppsett.EpostDomene)</span>
                                    </span>
                                </label>
                                <label class="pod-label" for="pod-avsender">Avsendernavn
                                    <input id="pod-avsender" class="pod-input" @bind="_avsenderNavn" @bind:event="oninput" placeholder="@_tenant.Navn" />
                                </label>
                                <label class="pod-label" for="pod-svartil">Når kunden svarer på en e-post
                                    <select id="pod-svartil" class="pod-input" @bind="_svarTil">
                                        <option value="portal">Svaret kommer inn i portalen (Forespørsler)</option>
                                        <option value="epost">Svaret går til en vanlig e-postadresse</option>
                                    </select>
                                </label>
                                @if (_svarTil == "epost")
                                {
                                    <label class="pod-label" for="pod-svarepost">Svar går til
                                        <input id="pod-svarepost" class="pod-input" type="email" @bind="_svarTilEpost" placeholder="post@firma.no" />
                                    </label>
                                }
                                <p class="pod-tom-tekst">Kunden ser: <b>@(string.IsNullOrWhiteSpace(_avsenderNavn) ? _tenant.Navn : _avsenderNavn)</b> &lt;@OrganisasjonOppsett.Adresse(string.IsNullOrWhiteSpace(_epostNavn) ? "…" : _epostNavn.Trim().ToLowerInvariant())&gt;</p>
                                <div class="pod-knapperad"><button type="button" class="pod-btn-primary" @onclick="LagreEpost">Lagre</button></div>
                                @if (!string.IsNullOrEmpty(_epostFeil))
                                {
                                    <p class="pod-feilmelding">@_epostFeil</p>
                                }
                                @if (!string.IsNullOrEmpty(_epostMelding))
                                {
                                    <p class="pod-suksessmelding">@_epostMelding</p>
                                }
                            </section>
                            <section class="pod-card">
                                <h3 class="pod-h3">Tips til firmaet</h3>
                                <p class="pod-tom-tekst">Vil firmaet at e-post til sin vanlige adresse også skal komme inn i portalen, lager de en videresending fra for eksempel post@("@")firma.no til adressen over. Det gjøres med en regel i Outlook eller Gmail.</p>
                            </section>
                        </div>
            
                        <section class="pod-card">
                            <h3 class="pod-h3">Hvem får påminnelsene?</h3>
                            <p class="pod-tom-tekst">Hver påminnelse går til dem som har den slått på. Er listen tom, går påminnelsene til organisasjonens aktive administratorer.</p>
                            <div class="pod-tabell-ramme">
                                <table class="pod-varsel-tabell">
                                    <thead>
                                        <tr>
                                            <th>Mottaker</th>
                                            @foreach (var type in Enum.GetValues<VarselType>())
                                            {
                                                <th class="pod-c" title="@type.Forklaring()">@type.Visningsnavn()</th>
                                            }
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in _mottakere)
                                        {
                                            var mottaker = m;
                                            <tr>
                                                <td><b>@mottaker.Epost</b><small>@mottaker.Beskrivelse</small></td>
                                                @foreach (var type in Enum.GetValues<VarselType>())
                                                {
                                                    var t = type;
                                                    var pa = mottaker.Gjelder(t);
                                                    <td class="pod-c"><button type="button" class="pod-modul-bryter" role="switch" aria-checked="@(pa ? "true" : "false")" aria-label="@($"{t.Visningsnavn()} til {mottaker.Epost}")" @onclick="@(() => VekslVarsel(mottaker, t))"></button></td>
                                                }
                                                <td class="pod-c"><button type="button" class="pod-btn-ghost pod-btn-liten" title="Fjern mottaker" aria-label="@($"Fjern {mottaker.Epost}")" @onclick="@(() => FjernMottaker(mottaker))"><Icon Name="trash" /></button></td>
                                            </tr>
                                        }
                                        @if (_mottakere.Count == 0)
                                        {
                                            <tr><td colspan="6" class="pod-tom-tekst">Ingen mottakere valgt. Påminnelsene går til administratorene.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="pod-ny-mottaker">
                                <input class="pod-input" type="email" @bind="_nyMottakerEpost" placeholder="E-post, for eksempel service@firma.no" aria-label="E-post til ny mottaker" />
                                <input class="pod-input" @bind="_nyMottakerBeskrivelse" placeholder="Hvem, for eksempel Serviceavdelingen" aria-label="Beskrivelse" />
                                <button type="button" class="pod-btn-ghost" @onclick="LeggTilMottaker"><Icon Name="plus" /> Legg til</button>
                            </div>
                            @if (!string.IsNullOrEmpty(_mottakerFeil))
                            {
                                <p class="pod-feilmelding">@_mottakerFeil</p>
                            }
                        </section>
                    }
                    @if (_oppsettFane == "tripletex")
                    {
                        var harNokkel = !string.IsNullOrWhiteSpace(_innstillinger.TripletexEmployeeTokenKryptert);
                        <section class="pod-card">
                            <div class="pod-kort-header-rad">
                                <h3 class="pod-h3">Tripletex</h3>
                                <span class="pod-chip @(harNokkel ? "pod-chip-ok" : "pod-chip-gul")">@(harNokkel ? "Koblet" : "Ikke koblet")</span>
                            </div>
                            @if (_tenant.ErStandard && !harNokkel)
                            {
                                <p class="pod-varselstripe">Til egen nøkkel er lagt inn, bruker @_tenant.Navn nøklene under <a href="/plattform/innstillinger">Innstillinger</a>. Legg inn @(_tenant.Navn) sin egen ansattnøkkel her, så er den koblet som alle andre.</p>
                            }
                                <p class="pod-tom-tekst">Firmaet lager en ansattnøkkel i Tripletex under Innstillinger → Integrasjoner → API-tilgang, og sender den til deg. Lim den inn her. Den lagres kryptert og vises aldri igjen.</p>
                                <label class="pod-label" for="pod-txnokkel">Ansattnøkkel (employee token)
                                    <input id="pod-txnokkel" class="pod-input" type="password" autocomplete="off" @bind="_txNokkel" placeholder="@(harNokkel ? "Lagret · lim inn en ny for å bytte" : "Lim inn nøkkelen fra firmaet")" />
                                </label>
                                <div class="pod-knapperad">
                                    <button type="button" class="pod-btn-primary" disabled="@_txTester" @onclick="LagreTripletex">@(_txTester ? "Tester …" : "Lagre og test")</button>
                                    @if (harNokkel)
                                    {
                                        <button type="button" class="pod-btn-ghost" disabled="@_txTester" @onclick="TestLagretTripletex">Test igjen</button>
                                        <button type="button" class="pod-btn-ghost" @onclick="FjernTripletex"><Icon Name="trash" /> Fjern</button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(_innstillinger.TripletexFirma))
                                {
                                    <p class="pod-suksessmelding">Koblet til @_innstillinger.TripletexFirma@(_innstillinger.TripletexTestet is { } tt ? $", testet {tt:dd.MM.yyyy HH:mm}" : "").</p>
                                }
                                @if (!string.IsNullOrEmpty(_txMelding))
                                {
                                    <p class="@(_txFeil ? "pod-feilmelding" : "pod-suksessmelding")">@_txMelding</p>
                                }
                                <p class="pod-tom-tekst">Når nøkkelen er lagt inn, får organisasjonen Tripletex i portalen sin: synk av kunder, arbeidsordre som ordre, og fakturaoversikt.</p>
                        </section>
                    }
                    @if (_oppsettFane == "backup")
                    {
                        var siste = _backuper.FirstOrDefault(b => b.Feil is null);
                        var feilet = _backuper.FirstOrDefault() is { Feil: not null } f0 ? f0 : null;
                        <div class="pod-kpi-grid pod-kpi-grid-3">
                            <div class="pod-card pod-kpi">
                                <div class="pod-kpi-topp"><span class="pod-eyebrow">Siste backup</span><span class="pod-kpi-ikon"><Icon Name="server" /></span></div>
                                <div class="pod-kpi-verdi @(siste is null || siste.Tidspunkt < DateTime.Now.AddDays(-2) ? "pod-rod" : "")">@(siste is null ? "Ingen ennå" : RelativTid(siste.Tidspunkt))</div>
                                <div class="pod-kpi-sub">@(siste is null ? "Tas i natt etter kl. 02" : siste.Kontrollert ? "Kontrollert og i orden" : "Ikke kontrollert")</div>
                            </div>
                            <div class="pod-card pod-kpi">
                                <div class="pod-kpi-topp"><span class="pod-eyebrow">Størrelse</span><span class="pod-kpi-ikon"><Icon Name="box" /></span></div>
                                <div class="pod-kpi-verdi">@(siste is null ? "–" : Storrelse(siste.DatabaseStorrelse))</div>
                                <div class="pod-kpi-sub">@(siste is null ? "" : $"{Storrelse(siste.Storrelse)} komprimert og kryptert")</div>
                            </div>
                            <div class="pod-card pod-kpi">
                                <div class="pod-kpi-topp"><span class="pod-eyebrow">Kopier lagret</span><span class="pod-kpi-ikon"><Icon Name="list" /></span></div>
                                <div class="pod-kpi-verdi">@_backuper.Count(b => b.Feil is null)</div>
                                <div class="pod-kpi-sub">@_backuper.Count(b => b.Type == BackupType.Daglig && b.Feil is null) daglige · @_backuper.Count(b => b.Type == BackupType.Ukentlig && b.Feil is null) ukentlige · @_backuper.Count(b => b.Type == BackupType.Manedlig && b.Feil is null) månedlige</div>
                            </div>
                        </div>

                        @if (feilet is not null)
                        {
                            <p class="pod-varselstripe">Siste forsøk @feilet.Tidspunkt.ToString("dd.MM.yyyy HH:mm") feilet: @feilet.Feil</p>
                        }
                        @if (BackupSvc.Lagring.Type == BackupLagringType.Lokal)
                        {
                            <p class="pod-varselstripe">Kopiene lagres på serveren. Det beskytter mot feil og sletting, men ikke mot at serveren forsvinner. Sett Backup:AzureSasUrl for å lagre dem i Azure i stedet.</p>
                        }

                        <section class="pod-card">
                            <div class="pod-kort-header-rad">
                                <h3 class="pod-h3">Sikkerhetskopier</h3>
                                <span class="pod-tom-tekst">@BackupSvc.Lagring.Beskrivelse · kryptert med AES-256</span>
                                <button type="button" class="pod-btn-primary" disabled="@_tarBackup" @onclick="TaBackupNa"><Icon Name="plus" /> @(_tarBackup ? "Tar backup …" : "Ta backup nå")</button>
                            </div>
                            @if (!string.IsNullOrEmpty(_backupMelding))
                            {
                                <p class="pod-suksessmelding">@_backupMelding</p>
                            }
                            @if (!string.IsNullOrEmpty(_backupFeil))
                            {
                                <p class="pod-feilmelding">@_backupFeil</p>
                            }
                            @if (_backuper.Count == 0)
                            {
                                <p class="pod-tom-tekst">Ingen kopier ennå. Den første tas i natt etter kl. 02, eller trykk «Ta backup nå».</p>
                            }
                            else
                            {
                                <div class="pod-tabell-ramme">
                                    <table class="pod-varsel-tabell">
                                        <thead><tr><th>Tatt</th><th>Type</th><th class="pod-n">Størrelse</th><th>Kontroll</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var b in _backuper)
                                            {
                                                var backup = b;
                                                <tr>
                                                    <td><b>@backup.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</b><small>@(backup.Av ?? "Automatisk")</small></td>
                                                    <td>@backup.Type.Visningsnavn()</td>
                                                    <td class="pod-n">@(backup.Feil is null ? Storrelse(backup.DatabaseStorrelse) : "–")</td>
                                                    <td>
                                                        @if (backup.Feil is not null)
                                                        {
                                                            <span class="pod-chip pod-chip-rod" title="@backup.Feil">Feilet</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="pod-chip @(backup.Kontrollert ? "pod-chip-ok" : "pod-chip-gul")">@(backup.Kontrollert ? "I orden" : "Ikke kontrollert")</span>
                                                        }
                                                    </td>
                                                    <td class="pod-n">
                                                        @if (backup.Feil is null)
                                                        {
                                                            <a class="pod-btn-ghost pod-btn-liten" href="@($"/plattform/backup/{backup.Id}/last-ned")" target="_blank"><Icon Name="download" /> Last ned</a>
                                                            <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => _bekreftGjenoppretting = backup)">Gjenopprett</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (_bekreftGjenoppretting is { } gb)
                            {
                                <div class="pod-bekreft">
                                    <b>Gjenopprette @_tenant.Navn fra @gb.Tidspunkt.ToString("dd.MM.yyyy HH:mm")?</b>
                                    <span>Portalen deres settes tilbake til dette tidspunktet, og alt som er lagt inn etterpå forsvinner. Det tas en ny kopi av dagens data først, så du kan angre. Brukere som er inne nå, bør laste siden på nytt etterpå.</span>
                                    <div class="pod-knapperad">
                                        <button type="button" class="pod-btn-slett" disabled="@_tarBackup" @onclick="Gjenopprett">@(_tarBackup ? "Gjenoppretter …" : "Gjenopprett")</button>
                                        <button type="button" class="pod-btn-ghost" @onclick="@(() => _bekreftGjenoppretting = null)">Avbryt</button>
                                    </div>
                                </div>
                            }
                            <p class="pod-tom-tekst">Tas hver natt etter kl. 02. Beholdes: 14 daglige, 8 ukentlige og 12 månedlige. Manuelle kopier og kopier tatt før gjenoppretting beholdes i 60 dager. Nedlastet kopi er en vanlig SQLite-fil med alle data, også bilder og vedlegg.</p>
                            @if (!BackupSvc.NokkelFraOppsett)
                            {
                                <p class="pod-tom-tekst">Krypteringsnøkkelen er laget automatisk og ligger på serveren (backup-nokkel.txt i datamappen). Legg en kopi av den i passordhvelvet ditt, eller sett den som Backup:Nokkel. Uten nøkkelen kan kopiene ikke åpnes.</p>
                            }
                        </section>
                    }
                </div>
            </div>
        }

        @* ================= LOGG OG NOTATER ================= *@
