@page "/plattform/organisasjoner/{Id:int}"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject TenantStatistikkService Statistikk
@inject TenantOppslagService Oppslag
@inject NavigationManager Nav

<PageTitle>@(_tenant?.Navn ?? "Organisasjon") - Plattform</PageTitle>

@if (_tenant is null)
{
    <p class="pod-tom">Fant ikke organisasjonen.</p>
}
else
{
    <div class="pod-root">
        <div class="pod-brodsmule">
            <NavLink href="/plattform">Organisasjoner</NavLink>
            <span>/</span>
            <span class="pod-brodsmule-na">@_tenant.Navn</span>
        </div>

        <div class="pod-header">
            <div class="pod-header-venstre">
                @if (_tenant.LogoData is not null)
                {
                    <img class="pod-logo" src="@($"/plattform/organisasjon/{_tenant.Id}/logo?v={_tenant.SistOppdatert?.Ticks}")" alt="Logo" />
                }
                else
                {
                    var (bg, ink) = AvatarFarge(_tenant.Id);
                    <div class="pod-logo pod-logo-initialer" style="background:@bg; color:@ink;">@Initialer(_tenant.Navn)</div>
                }
                <div>
                    <div class="pod-navn-rad">
                        <h1 class="pod-h1">@_tenant.Navn</h1>
                        <span class="pod-badge pod-badge-@StatusKlasse(_tenant.Status)"><span class="pod-dot"></span>@_tenant.Status</span>
                    </div>
                    <div class="pod-meta-rad">
                        @if (!string.IsNullOrWhiteSpace(_tenant.Subdomene))
                        {
                            <span><Icon Name="building" />@_tenant.Subdomene</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Kundeansvarlig))
                        {
                            <span><Icon Name="users" />@_tenant.Kundeansvarlig</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Epost))
                        {
                            <span><Icon Name="mail" />@_tenant.Epost</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenant.Telefon))
                        {
                            <span><Icon Name="phone" />@_tenant.Telefon</span>
                        }
                        <span><Icon Name="calendar" />Opprettet @_tenant.OpprettetDato.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
            <div class="pod-header-handlinger">
                <button type="button" class="pod-btn-ghost" @onclick="@(() => _fane = "innstillinger")"><Icon Name="edit" /> Rediger</button>
            </div>
        </div>

        <div class="pod-faner">
            <button type="button" class="pod-fane @(_fane == "oversikt" ? "pod-fane-aktiv" : "")" @onclick="@(() => _fane = "oversikt")"><Icon Name="home" /> Oversikt</button>
            <button type="button" class="pod-fane @(_fane == "fakturering" ? "pod-fane-aktiv" : "")" @onclick="@(() => _fane = "fakturering")"><Icon Name="file-text" /> Fakturering</button>
            <button type="button" class="pod-fane @(_fane == "brukere" ? "pod-fane-aktiv" : "")" @onclick="@(() => _fane = "brukere")"><Icon Name="users" /> Brukere</button>
            <button type="button" class="pod-fane @(_fane == "aktivitet" ? "pod-fane-aktiv" : "")" @onclick="@(() => _fane = "aktivitet")"><Icon Name="trend-up" /> Aktivitet</button>
            <button type="button" class="pod-fane @(_fane == "innstillinger" ? "pod-fane-aktiv" : "")" @onclick="@(() => _fane = "innstillinger")"><Icon Name="settings" /> Innstillinger</button>
        </div>

        @if (_fane == "oversikt")
        {
            <div class="pod-kpi-grid">
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Månedlig omsetning</span><span class="pod-kpi-ikon"><Icon Name="file-text" /></span></div>
                    <div class="pod-kpi-verdi">@ManedligBelop(_tenant.Id).ToString("N0") kr</div>
                    <div class="pod-kpi-sub">Aktiverte lisenser</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Totalt fakturert i år</span><span class="pod-kpi-ikon"><Icon Name="receipt" /></span></div>
                    <div class="pod-kpi-verdi">0 kr</div>
                    <div class="pod-kpi-sub">Fakturering ikke tatt i bruk</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Utestående beløp</span><span class="pod-kpi-ikon"><Icon Name="credit-card" /></span></div>
                    <div class="pod-kpi-verdi">0 kr</div>
                    <div class="pod-kpi-sub">Ingen forfalte fakturaer</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Antall brukere</span><span class="pod-kpi-ikon"><Icon Name="users" /></span></div>
                    <div class="pod-kpi-verdi">@_brukere.Count(b => b.Rolle != BrukerRolle.Kunde)</div>
                    <div class="pod-kpi-sub">Aktive brukere</div>
                </div>
                <div class="pod-card pod-kpi">
                    <div class="pod-kpi-topp"><span class="pod-eyebrow">Siste faktura</span><span class="pod-kpi-ikon"><Icon Name="receipt" /></span></div>
                    <div class="pod-kpi-verdi">-</div>
                    <div class="pod-kpi-sub">Ingen fakturaer ennå</div>
                </div>
            </div>

            <div class="pod-midt-rad">
                <section class="pod-card">
                    <h3 class="pod-h3">Om organisasjonen</h3>
                    <div class="pod-info-rad"><span>Organisasjonsnavn</span><strong>@_tenant.Navn</strong></div>
                    <div class="pod-info-rad"><span>Domene</span><strong>@(_tenant.Subdomene ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Org.nr</span><strong>@(_tenant.OrgNr ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Adresse</span><strong>@(_tenant.Adresse ?? "-")@(string.IsNullOrWhiteSpace(_tenant.Postnr) && string.IsNullOrWhiteSpace(_tenant.Sted) ? "" : $", {_tenant.Postnr} {_tenant.Sted}")</strong></div>
                    <div class="pod-info-rad"><span>Kontaktperson</span><strong>@(_tenant.Kundeansvarlig ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>E-post</span><strong>@(_tenant.Epost ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Telefon</span><strong>@(_tenant.Telefon ?? "-")</strong></div>
                    <div class="pod-info-rad"><span>Status</span><strong>@_tenant.Status</strong></div>
                    <div class="pod-info-rad"><span>Opprettet</span><strong>@_tenant.OpprettetDato.ToString("dd.MM.yyyy")</strong></div>
                </section>

                <section class="pod-card">
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Omsetning siste 12 måneder</h3>
                    </div>
                    <div class="pod-stolpediagram">
                        @foreach (var punkt in _omsetningHistorikk)
                        {
                            var hoyde = _omsetningMaks <= 0 ? 4 : Math.Max(4, (double)(punkt.Belop / _omsetningMaks) * 100);
                            <div class="pod-stolpe-kol" title="@($"{punkt.Mnd}: {punkt.Belop:N0} kr")">
                                <div class="pod-stolpe @(punkt.ErNa ? "pod-stolpe-na" : "")" style="height: @(hoyde.ToString(CultureInfo.InvariantCulture))%"></div>
                                <span class="pod-stolpe-label">@punkt.Mnd</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="pod-card">
                    <h3 class="pod-h3">Fakturaer som krever oppfølging</h3>
                    <p class="pod-tom-tekst">Fakturering er ikke tatt i bruk ennå.</p>
                </section>
            </div>

            <div class="pod-midt-rad pod-midt-rad-to">
                <section class="pod-card">
                    <div class="pod-kort-header-rad">
                        <h3 class="pod-h3">Brukere (@_brukere.Count)</h3>
                        <button type="button" class="pod-vis-alle" @onclick="@(() => _fane = "brukere")">Vis alle →</button>
                    </div>
                    @if (_brukere.Count == 0)
                    {
                        <p class="pod-tom-tekst">Ingen brukere ennå.</p>
                    }
                    else
                    {
                        @foreach (var b in _brukere.Take(5))
                        {
                            <div class="pod-bruker-rad">
                                <span class="pod-bruker-navn">@b.Navn</span>
                                <span class="pod-bruker-epost">@b.Epost</span>
                                <span class="pod-rolle-pille">@b.Rolle.Visningsnavn()</span>
                                <span class="pod-badge pod-badge-@(b.Aktiv ? "aktiv" : "oppsagt")"><span class="pod-dot"></span>@(b.Aktiv ? "Aktiv" : "Inaktiv")</span>
                            </div>
                        }
                    }
                </section>

                <section class="pod-card">
                    <h3 class="pod-h3">Nylig aktivitet</h3>
                    @if (_aktivitet.Count == 0)
                    {
                        <p class="pod-tom-tekst">Ingen aktivitet registrert ennå.</p>
                    }
                    else
                    {
                        @foreach (var hendelse in _aktivitet)
                        {
                            <div class="pod-aktivitet-rad">
                                <span class="pod-aktivitet-ikon"><Icon Name="@hendelse.Ikon" /></span>
                                <span class="pod-aktivitet-tekst">
                                    <span class="pod-aktivitet-tittel">@hendelse.Tittel</span>
                                    <span class="pod-aktivitet-sub">@hendelse.Undertekst</span>
                                </span>
                                <span class="pod-aktivitet-tid">@RelativTid(hendelse.Tidspunkt)</span>
                            </div>
                        }
                    }
                </section>
            </div>
        }

        @if (_fane == "fakturering")
        {
            <section class="pod-card">
                <h3 class="pod-h3">Fakturering</h3>
                <p class="pod-tom-tekst">Fakturering er ikke tatt i bruk for organisasjonene ennå.</p>
            </section>
        }

        @if (_fane == "brukere")
        {
            <section class="pod-card">
                <div class="pod-kort-header-rad">
                    <h3 class="pod-h3">Brukere (@_brukere.Count)</h3>
                    <button type="button" class="pod-btn-primary" @onclick="@(() => _visNyBruker = !_visNyBruker)"><Icon Name="plus" /> Ny bruker</button>
                </div>

                @if (_visNyBruker)
                {
                    <div class="pod-form-grid">
                        <label class="pod-label">Navn<input class="pod-input" @bind="_nyBrukerNavn" placeholder="F.eks. Kari Hansen" /></label>
                        <label class="pod-label">E-post<input class="pod-input" @bind="_nyBrukerEpost" placeholder="kari@eksempel.no" /></label>
                        <label class="pod-label">
                            Rolle
                            <select class="pod-input" @bind="_nyBrukerRolle">
                                @foreach (var r in Enum.GetValues<BrukerRolle>())
                                {
                                    <option value="@r">@r.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="pod-knapperad">
                        <button type="button" class="pod-btn-primary" @onclick="OpprettBruker">Opprett bruker</button>
                        <button type="button" class="pod-btn-ghost" @onclick="@(() => _visNyBruker = false)">Avbryt</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_brukerFeil))
                {
                    <p class="pod-feilmelding">@_brukerFeil</p>
                }
                @if (!string.IsNullOrEmpty(_brukerMelding))
                {
                    <p class="pod-suksessmelding">@_brukerMelding</p>
                }

                @if (_brukere.Count == 0)
                {
                    <p class="pod-tom-tekst">Ingen brukere ennå.</p>
                }
                else
                {
                    <div class="pod-tabell-hode">
                        <div>Navn</div>
                        <div>E-post</div>
                        <div>Rolle</div>
                        <div>Status</div>
                    </div>
                    @foreach (var b in _brukere)
                    {
                        <div class="pod-tabell-rad">
                            <div>@b.Navn</div>
                            <div>@b.Epost</div>
                            <div><span class="pod-rolle-pille">@b.Rolle.Visningsnavn()</span></div>
                            <div><span class="pod-badge pod-badge-@(b.Aktiv ? "aktiv" : "oppsagt")"><span class="pod-dot"></span>@(b.Aktiv ? "Aktiv" : "Inaktiv")</span></div>
                        </div>
                    }
                }
            </section>
        }

        @if (_fane == "aktivitet")
        {
            <section class="pod-card">
                <h3 class="pod-h3">Aktivitet</h3>
                @if (_aktivitet.Count == 0)
                {
                    <p class="pod-tom-tekst">Ingen aktivitet registrert ennå.</p>
                }
                else
                {
                    @foreach (var hendelse in _aktivitet)
                    {
                        <div class="pod-aktivitet-rad">
                            <span class="pod-aktivitet-ikon"><Icon Name="@hendelse.Ikon" /></span>
                            <span class="pod-aktivitet-tekst">
                                <span class="pod-aktivitet-tittel">@hendelse.Tittel</span>
                                <span class="pod-aktivitet-sub">@hendelse.Undertekst</span>
                            </span>
                            <span class="pod-aktivitet-tid">@RelativTid(hendelse.Tidspunkt)</span>
                        </div>
                    }
                }
            </section>
        }

        @if (_fane == "innstillinger")
        {
            <section class="pod-card">
                <h3 class="pod-h3">Grunninformasjon</h3>
                <div class="pod-form-grid">
                    <label class="pod-label">Org.nr<input class="pod-input" @bind="_tenant.OrgNr" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">Adresse<input class="pod-input" @bind="_tenant.Adresse" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">Postnr<input class="pod-input" @bind="_tenant.Postnr" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">Sted<input class="pod-input" @bind="_tenant.Sted" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">Telefon<input class="pod-input" @bind="_tenant.Telefon" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">E-post<input class="pod-input" @bind="_tenant.Epost" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">Kontaktperson<input class="pod-input" @bind="_tenant.Kundeansvarlig" @bind:event="oninput" @bind:after="Lagre" /></label>
                    <label class="pod-label">
                        Type
                        <select class="pod-input" @bind="_tenant.Type" @bind:after="Lagre">
                            <option value="">Ikke satt</option>
                            @foreach (var t in Enum.GetValues<TenantType>())
                            {
                                <option value="@t">@t.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    @if (!_tenant.ErStandard)
                    {
                        <label class="pod-label">
                            Status
                            <select class="pod-input" @bind="_tenant.Status" @bind:after="Lagre">
                                @foreach (var s in Enum.GetValues<TenantStatus>())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </label>
                    }
                </div>
            </section>

            <section class="pod-card">
                <h3 class="pod-h3">Merkevare i portalen</h3>
                <p class="pod-tom-tekst">Vises i organisasjonens egen portal - sidemeny, innloggingsside og fargetema.</p>
                <label class="pod-label">
                    Visningsnavn (under "Organisasjon" i sidemenyen)
                    <input class="pod-input" @bind="_tenant.PortalVisningsnavn" @bind:event="oninput" @bind:after="Lagre" placeholder="@_tenant.Navn" />
                </label>

                <div class="pod-logo-rad">
                    @if (_tenant.LogoData is not null)
                    {
                        <img class="pod-logo-forhandsvisning" src="@($"/plattform/organisasjon/{_tenant.Id}/logo?v={_tenant.SistOppdatert?.Ticks}")" alt="Logo" />
                        <button type="button" class="pod-btn-ghost" @onclick="FjernLogo">Fjern logo</button>
                    }
                    else
                    {
                        <span class="pod-tom-tekst">Ingen logo lastet opp</span>
                    }
                    <label class="pod-btn-ghost pod-logo-opplasting">
                        Last opp logo
                        <InputFile OnChange="OnLogoValgt" accept="image/*" style="display:none;" />
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(_logoFeil))
                {
                    <p class="pod-feilmelding">@_logoFeil</p>
                }

                <div class="pod-form-grid">
                    <label class="pod-label">
                        Merkevarefarge
                        <input type="color" class="pod-input pod-fargevelger" value="@(_tenant.TemaFarge ?? "#835e41")" @onchange="@(e => SettFarge(false, (string)e.Value!))" />
                    </label>
                    <label class="pod-label">
                        Bakgrunnsfarge
                        <input type="color" class="pod-input pod-fargevelger" value="@(_tenant.TemaBakgrunn ?? "#f4f0e9")" @onchange="@(e => SettFarge(true, (string)e.Value!))" />
                    </label>
                </div>
            </section>

            <section class="pod-card">
                <h3 class="pod-h3">Lisenser</h3>
                <p class="pod-tom-tekst">Antall de kan ta i bruk før de må vente på at du aktiverer flere.</p>
                @foreach (var type in Enum.GetValues<LisensType>())
                {
                    var lisens = _lisenser.First(l => l.Type == type);
                    var brukt = type == LisensType.Brukere ? _brukere.Count(b => b.Rolle != BrukerRolle.Kunde) : _brukere.Count(b => b.Rolle == BrukerRolle.Kunde);
                    <div class="pod-lisens-rad">
                        <div class="pod-lisens-info">
                            <span>@type.Visningsnavn()</span>
                            <span class="pod-lisens-bruk @(brukt >= lisens.AntallTildelt ? "pod-lisens-bruk-full" : "")">@brukt av @lisens.AntallTildelt i bruk</span>
                        </div>
                        <input type="number" min="0" class="pod-input pod-lisens-input" @bind="lisens.AntallTildelt" />
                        <button type="button" class="pod-btn-ghost" @onclick="@(() => LagreLisens(lisens))">Aktiver</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_lisensMelding))
                {
                    <p class="pod-suksessmelding">@_lisensMelding</p>
                }
            </section>

            @if (!_tenant.ErStandard)
            {
                <section class="pod-card pod-faresone">
                    <h3 class="pod-h3 pod-faresone-tittel">Faresone</h3>
                    <p class="pod-tom-tekst">Sletter organisasjonen og all data permanent - brukere, prosjekter, dokumenter og alt annet. Kan ikke angres.</p>

                    @if (!_visSlettBekreftelse)
                    {
                        <button type="button" class="pod-btn-slett" @onclick="@(() => _visSlettBekreftelse = true)"><Icon Name="trash" /> Slett organisasjon</button>
                    }
                    else
                    {
                        <label class="pod-label">
                            Skriv <strong>@SlettBekreftelseFasit</strong> for å bekrefte at du vil slette @_tenant.Navn for alltid
                            <input class="pod-input" @bind="_slettBekreftelseTekst" @bind:event="oninput" placeholder="@SlettBekreftelseFasit" />
                        </label>
                        <div class="pod-knapperad">
                            <button type="button" class="pod-btn-slett" disabled="@(_slettBekreftelseTekst != SlettBekreftelseFasit || _sletter)" @onclick="SlettOrganisasjon">
                                <Icon Name="trash" /> @(_sletter ? "Sletter..." : "Slett for alltid")
                            </button>
                            <button type="button" class="pod-btn-ghost" @onclick="@(() => { _visSlettBekreftelse = false; _slettBekreftelseTekst = ""; })">Avbryt</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_slettFeil))
                    {
                        <p class="pod-feilmelding">@_slettFeil</p>
                    }
                </section>
            }
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Tenant? _tenant;
    private string _fane = "oversikt";
    private List<Bruker> _brukere = [];
    private List<TenantLisens> _lisenser = [];
    private List<LisensPris> _lisensPriser = [];
    private List<AktivitetHendelse> _aktivitet = [];
    private List<(string Mnd, decimal Belop, bool ErNa)> _omsetningHistorikk = [];
    private decimal _omsetningMaks;

    private bool _visNyBruker;
    private string _nyBrukerNavn = "";
    private string _nyBrukerEpost = "";
    private BrukerRolle _nyBrukerRolle = BrukerRolle.Montor;
    private string? _brukerFeil;
    private string? _brukerMelding;

    private const string SlettBekreftelseFasit = "JEG SLETTER DENNE!!";
    private bool _visSlettBekreftelse;
    private string _slettBekreftelseTekst = "";
    private bool _sletter;
    private string? _slettFeil;

    private string? _logoFeil;
    private string? _lisensMelding;

    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private static readonly (string Bg, string Ink)[] AvatarPalett =
    [
        ("#F1E7DA", "#8A5A34"),
        ("#E3EEE6", "#3C6E55"),
        ("#E5E8F1", "#4B5A8A"),
        ("#F1E3DD", "#8A4334"),
        ("#EAE8F4", "#5A4B8A")
    ];

    protected override async Task OnInitializedAsync() => await LastAltAsync();

    private async Task LastAltAsync()
    {
        _tenant = await PlatformDb.Tenants.FirstOrDefaultAsync(t => t.Id == Id);
        if (_tenant is null)
        {
            return;
        }

        _lisensPriser = await PlatformDb.LisensPriser.ToListAsync();

        _lisenser = await PlatformDb.TenantLisenser.Where(l => l.TenantId == Id).ToListAsync();
        foreach (var type in Enum.GetValues<LisensType>())
        {
            if (_lisenser.All(l => l.Type != type))
            {
                var ny = new TenantLisens { TenantId = Id, Type = type, AntallTildelt = 0 };
                PlatformDb.TenantLisenser.Add(ny);
                _lisenser.Add(ny);
            }
        }
        await PlatformDb.SaveChangesAsync();

        await LastBrukereAsync();
        BeregnOmsetningHistorikk();
        BeregnAktivitet();
    }

    private async Task LastBrukereAsync()
    {
        if (_tenant is null) { return; }
        var options = new DbContextOptionsBuilder<ApplicationDbContext>().UseSqlite(_tenant.ConnectionString).Options;
        await using var db = new ApplicationDbContext(options);
        _brukere = await db.Brukere.OrderBy(b => b.Navn).ToListAsync();
    }

    private decimal PrisFor(LisensType type) => _lisensPriser.FirstOrDefault(p => p.Type == type)?.KrPerManed ?? 0;

    private decimal ManedligBelop(int tenantId) =>
        _lisenser.Where(l => l.TenantId == tenantId).Sum(l => l.AntallTildelt * PrisFor(l.Type));

    private void BeregnOmsetningHistorikk()
    {
        if (_tenant is null) { return; }
        var liste = new List<(string Mnd, decimal Belop, bool ErNa)>();
        var naManed = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

        for (var i = 11; i >= 0; i--)
        {
            var maned = naManed.AddMonths(-i);
            var sluttAvManed = maned.AddMonths(1).AddDays(-1);
            var belop = _tenant.OpprettetDato <= sluttAvManed ? ManedligBelop(_tenant.Id) : 0;
            liste.Add((maned.ToString("MMM", Nb), belop, maned == naManed));
        }

        _omsetningHistorikk = liste;
        _omsetningMaks = liste.Count == 0 ? 0 : liste.Max(p => p.Belop);
    }

    private void BeregnAktivitet()
    {
        if (_tenant is null) { return; }
        var hendelser = new List<AktivitetHendelse>
        {
            new("building", "Organisasjon opprettet", _tenant.Navn, _tenant.OpprettetDato)
        };

        if (_tenant.SistOppdatert.HasValue)
        {
            hendelser.Add(new AktivitetHendelse("edit", "Organisasjon oppdatert", _tenant.Navn, _tenant.SistOppdatert.Value));
        }

        foreach (var l in _lisenser)
        {
            hendelser.Add(new AktivitetHendelse("credit-card", $"{l.Type.Visningsnavn()} oppdatert", _tenant.Navn, l.SistEndret));
        }

        _aktivitet = hendelser.OrderByDescending(h => h.Tidspunkt).Take(8).ToList();
    }

    private async Task Lagre()
    {
        if (_tenant is null) { return; }
        _tenant.SistOppdatert = DateTime.Now;
        await PlatformDb.SaveChangesAsync();
        BeregnAktivitet();
    }

    private async Task OnLogoValgt(InputFileChangeEventArgs e)
    {
        if (_tenant is null) { return; }
        _logoFeil = null;
        var file = e.File;
        if (file.Size > 5_000_000)
        {
            _logoFeil = "Logoet er for stort (maks 5 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 5_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _tenant.LogoData = buffer.ToArray();
        _tenant.LogoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        await Lagre();
    }

    private async Task FjernLogo()
    {
        if (_tenant is null) { return; }
        _tenant.LogoData = null;
        _tenant.LogoContentType = null;
        await Lagre();
    }

    private async Task SettFarge(bool erBakgrunn, string hex)
    {
        if (_tenant is null) { return; }
        if (erBakgrunn) { _tenant.TemaBakgrunn = hex; } else { _tenant.TemaFarge = hex; }
        await Lagre();
    }

    private async Task LagreLisens(TenantLisens lisens)
    {
        lisens.SistEndret = DateTime.Now;
        await PlatformDb.SaveChangesAsync();
        _lisensMelding = $"{lisens.Type.Visningsnavn()} oppdatert til {lisens.AntallTildelt}.";
        BeregnAktivitet();
    }

    // Krever bekreftelsestekst skrevet nøyaktig for å unngå utilsiktet
    // sletting - sletter organisasjonens rad i platform.db FØR selve
    // SQLite-filen slettes fra disk, slik at vi aldri havner i en
    // mellomtilstand med en organisasjon-rad som peker til en fil som ikke
    // lenger finnes.
    private async Task SlettOrganisasjon()
    {
        if (_tenant is null || _tenant.ErStandard || _slettBekreftelseTekst != SlettBekreftelseFasit)
        {
            return;
        }

        _slettFeil = null;
        _sletter = true;
        StateHasChanged();
        try
        {
            var lisenser = await PlatformDb.TenantLisenser.Where(l => l.TenantId == _tenant.Id).ToListAsync();
            PlatformDb.TenantLisenser.RemoveRange(lisenser);
            PlatformDb.Tenants.Remove(_tenant);
            await PlatformDb.SaveChangesAsync();

            var dataSource = _tenant.ConnectionString
                .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(del => del.Split('=', 2))
                .Where(par => par.Length == 2 && par[0].Equals("Data Source", StringComparison.OrdinalIgnoreCase))
                .Select(par => par[1])
                .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(dataSource) && File.Exists(dataSource))
            {
                // Microsoft.Data.Sqlite holder native SQLite-tilkoblinger åpne i en
                // pool for gjenbruk selv etter at DbContext-instansen er disposet -
                // uten å tømme poolen først feiler File.Delete med "filen er i bruk
                // av en annen prosess", selv om ingen C#-kode faktisk bruker den lenger.
                Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools();
                File.Delete(dataSource);
            }

            Nav.NavigateTo("/plattform", forceLoad: true);
        }
        catch (Exception ex)
        {
            _slettFeil = $"Klarte ikke å slette organisasjonen: {ex.Message}";
            _sletter = false;
        }
    }

    private async Task OpprettBruker()
    {
        _brukerFeil = null;
        _brukerMelding = null;

        if (_tenant is null) { return; }
        var navn = _nyBrukerNavn.Trim();
        var epost = _nyBrukerEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _brukerFeil = "Navn og e-post må fylles ut.";
            return;
        }

        if (await Oppslag.FinnTenantForEpostAsync(epost) is not null)
        {
            _brukerFeil = "Denne e-posten er allerede registrert hos en organisasjon.";
            return;
        }

        var options = new DbContextOptionsBuilder<ApplicationDbContext>().UseSqlite(_tenant.ConnectionString).Options;
        await using var db = new ApplicationDbContext(options);
        db.Brukere.Add(new Bruker { Navn = navn, Epost = epost, Rolle = _nyBrukerRolle });
        await db.SaveChangesAsync();

        _nyBrukerNavn = "";
        _nyBrukerEpost = "";
        _nyBrukerRolle = BrukerRolle.Montor;
        _visNyBruker = false;
        _brukerMelding = $"Brukeren \"{navn}\" er opprettet. De kan sette passord via \"Sett passord\" på innloggingssiden.";
        await LastBrukereAsync();
    }

    private static string StatusKlasse(TenantStatus status) => status switch
    {
        TenantStatus.Aktiv => "aktiv",
        TenantStatus.Suspendert => "suspendert",
        _ => "oppsagt"
    };

    private static string Initialer(string navn)
    {
        var ord = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (ord.Length == 0) { return "?"; }
        if (ord.Length == 1) { return ord[0].Length >= 2 ? ord[0][..2].ToUpperInvariant() : ord[0].ToUpperInvariant(); }
        return $"{ord[0][0]}{ord[^1][0]}".ToUpperInvariant();
    }

    private static (string Bg, string Ink) AvatarFarge(int tenantId) => AvatarPalett[Math.Abs(tenantId) % AvatarPalett.Length];

    private static string RelativTid(DateTime tidspunkt)
    {
        var diff = DateTime.Now - tidspunkt;
        if (diff.TotalMinutes < 1) { return "Nå nettopp"; }
        if (diff.TotalMinutes < 60) { return $"{(int)diff.TotalMinutes} min siden"; }
        if (diff.TotalHours < 24) { return $"{(int)diff.TotalHours} t siden"; }
        if (diff.TotalDays < 2) { return $"I går, {tidspunkt:HH:mm}"; }
        if (diff.TotalDays < 7) { return $"{(int)diff.TotalDays} dager siden"; }
        return tidspunkt.ToString("dd.MM.yyyy");
    }

    private record AktivitetHendelse(string Ikon, string Tittel, string Undertekst, DateTime Tidspunkt);
}
