    private int RabattProsent => AbonnementService.RabattProsent(_linjer, _plattform);
    private decimal RabattBelop => Math.Round(AbonnementService.Rabattgrunnlag(_linjer) * RabattProsent / 100m, 2);
    private int AntallFakturaVarsel => _fakturaer.Count(f => f.ErForfalt || f.Status == PlattformFakturaStatus.Utkast);

    private async Task LastAbonnementAsync()
    {
        if (_tenant is null)
        {
            return;
        }

        if (_plattformBruker is null && AuthStateTask is not null)
        {
            _plattformBruker = (await AuthStateTask).User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
        }

        _abo = await AbonnementSvc.SikreAbonnementAsync(_tenant);
        _plattform = await Oppsett.HentAsync();
        _pakker = await PlatformDb.PrisPakker.AsNoTracking().OrderBy(p => p.Rekkefolge).ToListAsync();
        _linjer = await AbonnementSvc.LinjerAsync(_tenant.Id);
        _pakkePriserAlle = await PlatformDb.PakkePriser.AsNoTracking().ToListAsync();
        _produktKr = (await AbonnementSvc.PrislisteAsync()).ToDictionary(p => p.Nokkel, p => p.Kr);
        _forhandsvisning = await AbonnementSvc.ForhandsvisNesteAsync(_tenant);
        _fakturaer = await PlatformDb.PlattformFakturaer.Include(f => f.Linjer)
            .Where(f => f.TenantId == _tenant.Id)
            .OrderByDescending(f => f.PeriodeFra).ThenByDescending(f => f.Id)
            .ToListAsync();
        _hendelser = await PlatformDb.TenantHendelser.AsNoTracking()
            .Where(h => h.TenantId == _tenant.Id)
            .OrderByDescending(h => h.Tidspunkt).ThenByDescending(h => h.Id)
            .Take(100).ToListAsync();
        _notater = await PlatformDb.TenantNotater
            .Where(n => n.TenantId == _tenant.Id)
            .OrderByDescending(n => n.Dato)
            .ToListAsync();
        _tripletexKlar = await FakturaSvc.TripletexKlarAsync();
        await LastBackuperAsync();
        BeregnOmsetningHistorikk();
    }

