                            <small>@notat.Dato.ToString("dd.MM.yyyy HH:mm") · @notat.Type@(notat.Av is { } av ? $" · {av}" : "")</small>
                            <span>@notat.Tekst</span>
                            @if (notat.Oppfolging is { } opp)
                            {
                                <span class="pod-notat-oppf">
                                    <small class="@(!notat.Utfort && opp.Date <= DateTime.Today ? "pod-rod" : "")">@(notat.Utfort ? "Fulgt opp" : "Følg opp") @opp.ToString("dd.MM.yyyy")</small>
                                    @if (!notat.Utfort)
                                    {
                                        <button type="button" class="pod-btn-ghost pod-btn-liten" @onclick="@(() => FullforNotat(notat))"><Icon Name="check" /> Fulgt opp</button>
                                    }
                                </span>
                            }
                        </div>
