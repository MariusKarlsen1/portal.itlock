        helhet == 0 ? "0" : (100.0 * del / helhet).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // ok = ferdig, na = her er vi nå, "" = ikke startet
    private sealed record Fase(string Nr, string Navn, string Tittel, string Tekst, string Tilstand, string Fane, int Prosent);

    // Hovedtilbudet: det godkjente, ellers det sist sendte, eller det nyeste.
    private Tilbud? HovedTilbud =>
        _tilbud.FirstOrDefault(t => t.Status == EndringsmeldingStatus.Godkjent)
        ?? _tilbud.FirstOrDefault(t => t.Status == EndringsmeldingStatus.SendtTilKunde)
        ?? _tilbud.FirstOrDefault();

    // Tegningen som vises på Oversikt: den med flest plasserte dører.
    private Plantegning? OversiktTegning =>
        _plantegninger
            .OrderByDescending(p => _dorer.Count(d => d.PlantegningId == p.Id && d.PosX.HasValue))
            .FirstOrDefault(p => p.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));

    private static string KortTid(int minutter)
    {
        var t = minutter / 60;
        var m = minutter % 60;
        return t > 0 ? (m > 0 ? $"{t}t {m}m" : $"{t}t") : $"{m}m";
    }

    private static (string Ikon, string Klasse) AktivitetIkon(string tekst) =>
        tekst.Contains("dør", StringComparison.OrdinalIgnoreCase) ? ("door", "os-brun")
        : tekst.StartsWith("Plantegning", StringComparison.OrdinalIgnoreCase) ? ("map", "os-bla")
        : tekst.StartsWith("Tilbud", StringComparison.OrdinalIgnoreCase) ? ("file-text", "os-gul")
        : ("folder", "os-gronn");

