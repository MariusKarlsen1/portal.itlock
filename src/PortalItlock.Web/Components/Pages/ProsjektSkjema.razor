    private async Task OnPlantegningSelected(InputFileChangeEventArgs e)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (!Id.HasValue)
        {
            return;
        }

        // Blazor InputFile kan i sjeldne tilfeller sende change-hendelsen to ganger for samme filvalg.
        // Semaforen serialiserer kallene slik at duplikat-sjekken under alltid ser forrige opplasting.
        await _plantegningUploadLock.WaitAsync();
        try
        {
            var file0 = e.File;
            if (_sisteOpplasting is { } forrige && forrige.Navn == file0.Name && forrige.Storrelse == file0.Size
                && DateTime.UtcNow - forrige.Tidspunkt < TimeSpan.FromSeconds(3))
            {
                return;
            }
            _sisteOpplasting = (file0.Name, file0.Size, DateTime.UtcNow);

            _plantegningFeil = null;

            // Navn er ikke lenger påkrevd før filvalg - de fleste velger fil først og fyller ev.
            // navn etterpå, og opplastingen skal ikke stoppe stille på det. Faller tilbake til
            // filnavnet (uten filending) hvis navnefeltet står tomt.
            var navn = string.IsNullOrWhiteSpace(_nyPlantegningNavn)
                ? Path.GetFileNameWithoutExtension(file0.Name)
                : _nyPlantegningNavn.Trim();

            var file = e.File;
            if (file.Size > 20_000_000)
            {
                _plantegningFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                return;
            }

            _uploadingPlantegning = true;
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var rawBytes = buffer.ToArray();
            var erPdf = file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                || string.Equals(file.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase);

            byte[] bildeData;
            string contentType;

            if (erPdf)
            {
                try
                {
                    using var bitmap = PDFtoImage.Conversion.ToImage(rawBytes, page: 0, options: new PDFtoImage.RenderOptions(Dpi: 200));
                    using var image = SKImage.FromBitmap(bitmap);
                    using var encoded = image.Encode(SKEncodedImageFormat.Png, 90);
                    bildeData = encoded.ToArray();
                    contentType = "image/png";
                }
                catch (Exception)
                {
                    _plantegningFeil = $"Klarte ikke å lese PDF-filen \"{file.Name}\". Prøv å laste opp den som bilde i stedet.";
                    return;
                }
            }
            else
            {
                bildeData = rawBytes;
                contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
            }

            var plantegning = new Plantegning
            {
                ProsjektId = Id.Value,
                Navn = navn,
                Byggetrinn = string.IsNullOrWhiteSpace(_nyPlantegningByggetrinn) ? null : _nyPlantegningByggetrinn.Trim(),
                Filnavn = file.Name,
                ContentType = contentType,
                Data = bildeData
            };

            Db.Plantegninger.Add(plantegning);
            await Db.SaveChangesAsync();
            await ReloadPlantegninger();
            _nyPlantegningNavn = "";
            _nyPlantegningByggetrinn = "";
        }
        finally
        {
            _uploadingPlantegning = false;
            _plantegningInputKey++;
            _plantegningUploadLock.Release();
        }
    }

