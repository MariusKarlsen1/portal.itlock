    private async Task LastOppVedlegg(InputFileChangeEventArgs e, int? mappeId)
    {
        if (!Id.HasValue || _uploadingVedlegg)
        {
            return;
        }

        _vedleggFeil = null;
        _uploadingVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > 20_000_000)
                {
                    _vedleggFeil = $"\"{file.Name}\" er for stor (maks 20 MB) og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }

                var vedlegg = new ProsjektVedlegg
                {
                    ProsjektId = Id.Value,
                    Filnavn = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    Data = buffer.ToArray(),
                    MappeId = mappeId
                };

                Db.ProsjektVedlegg.Add(vedlegg);
            }

            await Db.SaveChangesAsync();
        }
        finally
        {
            _uploadingVedlegg = false;
        }
    }

