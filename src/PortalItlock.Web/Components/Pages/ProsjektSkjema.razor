    private async Task FlyttVedleggTil(ProsjektVedlegg v, object? valgtVerdi)
    {
        var verdi = valgtVerdi?.ToString();
        if (string.IsNullOrEmpty(verdi))
        {
            return;
        }

        var malMappeId = verdi == "ukategorisert" ? (int?)null : int.Parse(verdi);
        if (v.MappeId == malMappeId)
        {
            return;
        }

        v.MappeId = malMappeId;
        await Db.SaveChangesAsync();
