    // Plantegninger

    private async Task OnPlantegningSelected(InputFileChangeEventArgs e)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (!Id.HasValue)
        {
            return;
        }

        // Blazor InputFile kan i sjeldne tilfeller sende change-hendelsen to ganger for samme filvalg.
        // Semaforen serialiserer kallene slik at duplikat-sjekken under alltid ser forrige opplasting.
        await _plantegningUploadLock.WaitAsync();
        try
        {
            var file0 = e.File;
            if (_sisteOpplasting is { } forrige && forrige.Navn == file0.Name && forrige.Storrelse == file0.Size
                && DateTime.UtcNow - forrige.Tidspunkt < TimeSpan.FromSeconds(3))
            {
                return;
            }
            _sisteOpplasting = (file0.Name, file0.Size, DateTime.UtcNow);

            _plantegningFeil = null;

            // Navn er ikke lenger påkrevd før filvalg - de fleste velger fil først og fyller ev.
            // navn etterpå, og opplastingen skal ikke stoppe stille på det. Faller tilbake til
            // filnavnet (uten filending) hvis navnefeltet står tomt.
            var navn = string.IsNullOrWhiteSpace(_nyPlantegningNavn)
                ? Path.GetFileNameWithoutExtension(file0.Name)
                : _nyPlantegningNavn.Trim();

            var file = e.File;
            if (file.Size > 20_000_000)
            {
                _plantegningFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                return;
            }

            _uploadingPlantegning = true;
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var rawBytes = buffer.ToArray();
            var erPdf = file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                || string.Equals(file.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase);

            byte[] bildeData;
            string contentType;

            if (erPdf)
            {
                try
                {
                    using var bitmap = PDFtoImage.Conversion.ToImage(rawBytes, page: 0, options: new PDFtoImage.RenderOptions(Dpi: 200));
                    using var image = SKImage.FromBitmap(bitmap);
                    using var encoded = image.Encode(SKEncodedImageFormat.Png, 90);
                    bildeData = encoded.ToArray();
                    contentType = "image/png";
                }
                catch (Exception)
                {
                    _plantegningFeil = $"Klarte ikke å lese PDF-filen \"{file.Name}\". Prøv å laste opp den som bilde i stedet.";
                    return;
                }
            }
            else
            {
                bildeData = rawBytes;
                contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
            }

            var plantegning = new Plantegning
            {
                ProsjektId = Id.Value,
                Navn = navn,
                Byggetrinn = string.IsNullOrWhiteSpace(_nyPlantegningByggetrinn) ? null : _nyPlantegningByggetrinn.Trim(),
                Filnavn = file.Name,
                ContentType = contentType,
                Data = bildeData
            };

            Db.Plantegninger.Add(plantegning);
            await Db.SaveChangesAsync();
            await ReloadPlantegninger();
            _nyPlantegningNavn = "";
            _nyPlantegningByggetrinn = "";
        }
        finally
        {
            _uploadingPlantegning = false;
            _plantegningInputKey++;
            _plantegningUploadLock.Release();
        }
    }

    private void StartGruppeRename(string gruppeNavn)
    {
        _editingGruppe = gruppeNavn;
        _gruppeRenameInput = gruppeNavn == "Ugruppert" ? "" : gruppeNavn;
    }

    private async Task LagreGruppeNavn(string gammeltNavn)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        var nyttNavn = string.IsNullOrWhiteSpace(_gruppeRenameInput) ? null : _gruppeRenameInput.Trim();
        if (nyttNavn == UgruppertNavn)
        {
            return;
        }

        var berorte = _plantegninger.Where(p => GruppeAv(p) == gammeltNavn);

        foreach (var p in berorte)
        {
            p.Byggetrinn = nyttNavn;
        }

        // Byggetrinnet beholder plassen sin i rekkefølgen med nytt navn; tomt navn fjerner det.
        foreach (var b in _byggetrinn.Where(b => b.Navn == gammeltNavn).ToList())
        {
            if (nyttNavn is null || _byggetrinn.Any(x => x != b && string.Equals(x.Navn, nyttNavn, StringComparison.OrdinalIgnoreCase)))
            {
                Db.ProsjektByggetrinn.Remove(b);
            }
            else
            {
                b.Navn = nyttNavn;
            }
        }

        await Db.SaveChangesAsync();
        _editingGruppe = null;
        await ReloadPlantegninger();
    }

    private async Task FlyttPlantegning(Plantegning p, string? nyGruppe)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(nyGruppe))
        {
            return;
        }

        p.Byggetrinn = nyGruppe == UgruppertNavn ? null : nyGruppe;
        _menyTegningId = null;
        await Db.SaveChangesAsync();
        await ReloadPlantegninger();
    }

    private async Task RemovePlantegning(Plantegning p)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        // Filen ligger i samme rad (PlantegningFil) og må lastes for at EF skal slette raden.
        await Db.Entry(p).Reference(x => x.Fil).LoadAsync();
        Db.Plantegninger.Remove(p);
        _menyTegningId = null;
        _bekreftSlettTegningId = null;
        await Db.SaveChangesAsync();
        await ReloadPlantegninger();
    }

    private async Task ReloadPlantegninger()
    {
        _plantegninger = await Db.Plantegninger
            .Where(p => p.ProsjektId == Id!.Value)
            .ToListAsync();
        _byggetrinn = await Db.ProsjektByggetrinn
            .Where(b => b.ProsjektId == Id!.Value)
            .ToListAsync();

        // Byggetrinn som er skrevet inn andre steder (f.eks. ved opplasting fra serviceavtalen)
        // legges til bakerst, så de også kan sorteres og stå tomme.
        var mangler = _plantegninger
            .Select(GruppeAv)
            .Where(n => n != UgruppertNavn && !_byggetrinn.Any(b => b.Navn == n))
            .Distinct()
            .OrderBy(n => n)
            .ToList();
        if (mangler.Count > 0)
        {
            var neste = _byggetrinn.Count == 0 ? 0 : _byggetrinn.Max(b => b.Rekkefolge) + 1;
            foreach (var n in mangler)
            {
                var b = new ProsjektByggetrinn { ProsjektId = Id!.Value, Navn = n, Rekkefolge = neste++ };
                Db.ProsjektByggetrinn.Add(b);
                _byggetrinn.Add(b);
            }

            await Db.SaveChangesAsync();
        }
    }

