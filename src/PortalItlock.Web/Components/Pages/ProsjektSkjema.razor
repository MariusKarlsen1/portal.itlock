    private List<AktivitetRad> SisteAktivitet
    {
        get
        {
            List<AktivitetRad> alle =
            [
                // Dører lagt til samme dag vises som én linje, ikke én per dør.
                .. _dorer.GroupBy(d => d.OpprettetDato.Date).Select(g => g.Count() == 1
                    ? new AktivitetRad($"Dør {g.First().Dornummer} ble lagt til", g.First().OpprettetDato)
                    : new AktivitetRad($"{g.Count()} dører ble lagt til ({g.Min(d => d.Dornummer)} – {g.Max(d => d.Dornummer)})", g.Max(d => d.OpprettetDato))),
                .. _plantegninger.Select(p => new AktivitetRad($"Plantegning «{p.Navn}» ble lastet opp", p.OpprettetDato)),
                .. _tilbud.Select(t => new AktivitetRad($"Tilbud «{t.Tittel}» ble opprettet", t.OpprettetDato)),
                .. _vedlegg.Select(v => new AktivitetRad($"Vedlegg «{v.Filnavn}» ble lastet opp", v.OpprettetDato)),
            ];

            return alle.OrderByDescending(a => a.Dato).Take(5).ToList();
        }
    }

