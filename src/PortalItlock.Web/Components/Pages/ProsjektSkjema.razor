    // En nettopp opprettet dør åpnes på fanen Detaljer, ellers Oversikt.
    private int? _nyDorId;

    // Piler i dørvinduet for å bla til forrige/neste dør.
    private Dor? NaboDor(int steg)
    {
        var i = _selectedDoor is null ? -1 : _dorer.IndexOf(_selectedDoor);
        var j = i + steg;
        return i >= 0 && j >= 0 && j < _dorer.Count ? _dorer[j] : null;
    }

    private EventCallback ByttDorCallback(Dor? dor) =>
        dor is null ? default : EventCallback.Factory.Create(this, () => _selectedDoor = dor);

    private async Task EndreStatus(Dor d, ChangeEventArgs e)
    {
        // Montert/ikke montert er ett av de fire montøren SKAL kunne gjøre,
        // selv om resten av prosjektet er lesing for dem.
        if (!ModulRettigheter.KanSetteMontertStatus(_naverendeRolle))
        {
            return;
        }

        if (e.Value is not string s || !Enum.TryParse<MontasjeStatus>(s, out var status))
        {
            return;
        }

        d.Status = status;
        d.MontertDato = status == MontasjeStatus.FerdigMontert ? DateTime.Now : null;
        d.MontertAvBrukerId = status == MontasjeStatus.FerdigMontert ? _naverendeBrukerId : null;
        d.MontertAvBruker = status == MontasjeStatus.FerdigMontert ? _naverendeBruker : null;
        await Db.SaveChangesAsync();
    }

