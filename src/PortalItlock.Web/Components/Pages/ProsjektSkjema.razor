                                <tr @key="m.Id">
                                    <td><span class="pe-p"><span class="pe-av" style="background:@PersonFarge(m.Navn);">@PersonInitialer(m.Navn)</span><b>@m.Navn</b></span></td>
                                    <td>@if (!string.IsNullOrWhiteSpace(m.Epost)) {<a class="pe-lenke" href="@($"mailto:{m.Epost}")"><Icon Name="mail" />@m.Epost</a>} else {<span class="pe-mut">–</span>}</td>
                                    <td>
                                        <span class="pe-pill pe-r-@m.Rolle">@m.Rolle.Visningsnavn()</span>
                                        @if (m.Rolle == BrukerRolle.Montor)
                                        {
                                            <button type="button" class="pe-lenke pe-lenke-kn" @onclick="@(() => EndreAnsvarligMontor(new ChangeEventArgs { Value = medlem.Id.ToString() }))"><Icon Name="star" />Gjør til ansvarlig montør</button>
                                        }
                                    </td>
                                    <td class="pe-h"><button type="button" class="pe-x" title="Fjern fra prosjektet" @onclick="@(() => FjernMedlem(medlem))"><Icon Name="x" /></button></td>
                                </tr>
