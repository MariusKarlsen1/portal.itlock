    private void GenererBeslagsliste()
    {
        var byggetrinnParam = _valgteByggetrinn.Count == 0 ? "" : $"&byggetrinn={Uri.EscapeDataString(string.Join(",", _valgteByggetrinn))}";
        _beslagslistePdfSavedMessage = null;
        _beslagslistePreviewUrl = $"/prosjekt/{Id}/beslagsliste/pdf?v={DateTime.UtcNow.Ticks}{byggetrinnParam}";
    }

    private async Task LagreBeslagslistePdf()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var byggetrinn = _valgteByggetrinn.Count == 0 ? null : string.Join(",", _valgteByggetrinn);
        var bytes = await BeslagslistePdfService.GenerateAsync(Id.Value, byggetrinn);
        if (bytes is null)
        {
            return;
        }

        var linjer = await BeslagslistePdfService.GetSnapshotLinjerAsync(Id.Value, byggetrinn);
        var forrige = _lagredeBeslagslistePdfer.OrderByDescending(p => p.OpprettetDato).FirstOrDefault();

        if (forrige is not null && ErUendretSidenForrige(forrige, linjer))
        {
            _beslagslistePdfSavedMessage = "Ingen endringer siden forrige lagring.";
            return;
        }

        var totalsum = linjer.Sum(l => l.Antall * (l.Pris ?? 0));
        var nokkeltall = new List<LagretPdfNokkeltall>
        {
            new("Antall varelinjer", linjer.Count.ToString(), linjer.Count, ""),
            new("Totalsum", totalsum.ToString("N0") + " kr", totalsum, "kr"),
        };

        var etikett = _valgteByggetrinn.Count == 0 ? "" : $" ({string.Join(", ", _valgteByggetrinn)})";
        var pdf = await LagretPdfService.LagreAsync(
            "Beslagsliste", Id.Value, $"Beslagsliste - {_form.Navn}{etikett} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes, linjer, nokkeltall);

        _lagredeBeslagslistePdfer.Add(pdf);
        _beslagslistePdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private static bool ErUendretSidenForrige(LagretPdf forrige, List<LagretPdfLinje> nyLinjer)
    {
        if (string.IsNullOrEmpty(forrige.DataJson))
        {
            return false;
        }

        var gamleLinjer = System.Text.Json.JsonSerializer.Deserialize<List<LagretPdfLinje>>(forrige.DataJson) ?? [];
        return gamleLinjer.Count == nyLinjer.Count
            && gamleLinjer.OrderBy(l => l.Navn).SequenceEqual(nyLinjer.OrderBy(l => l.Navn));
    }

    private static string FriBreddeValue(bool? verdi) => verdi switch
    {
        true => "Ja",
        false => "Nei",
        null => ""
    };

    private static bool? ParseFriBredde(ChangeEventArgs e) => e.Value?.ToString() switch
    {
        "Ja" => true,
        "Nei" => false,
        _ => null
    };

    private static string FriBreddePillKlasse(bool? verdi) => verdi switch
    {
        true => "dorid-pill-ja",
        false => "dorid-pill-nei",
        _ => "dorid-pill-uklar"
    };

    private int DorIdAntallFriBredde => _dorIdMaler.Count(m => m.FriBredde086 == true);

    private int DorIdAntallMedCeInfo => _dorIdMaler.Count(m =>
        !string.IsNullOrWhiteSpace(m.CeDorblad) || !string.IsNullOrWhiteSpace(m.CeGlasstykkelse));

    private int DorIdAntallDortyper => _dorIdMaler
        .Where(m => !string.IsNullOrWhiteSpace(m.Dortype))
        .Select(m => m.Dortype!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
