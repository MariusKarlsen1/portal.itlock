                    <a class="ph-knapp ph-knapp-liten ph-knapp-primar" href="@($"/prosjekt/{Id}/lasplan")">Åpne låsplan</a>
                </div>
                <div class="p5-dk">
                    <span class="p5-di s-gul"><Icon Name="file-text" /></span>
                    <div><b>Låsplan som PDF</b><small>Lages fra låsplan-matrisen</small></div>
                    <a class="ph-knapp ph-knapp-liten" href="@($"/prosjekt/{Id}/lasplan/pdf")" target="_blank">Last ned</a>
                </div>
            </div>
        </div>
    }
    </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] private string? Navn { get; set; }
    [SupplyParameterFromQuery] private int? KundeId { get; set; }
    [SupplyParameterFromQuery] private string? Adresse { get; set; }
    [SupplyParameterFromQuery] private string? Kontaktperson { get; set; }
    // Åpner en bestemt fane, f.eks. ?fane=beslagsliste fra produktsammendraget.
    [SupplyParameterFromQuery(Name = "fane")] private string? StartFane { get; set; }

    private Prosjekt _form = new() { Navn = "" };
    private List<Dor> _dorer = [];
    private Dor? _selectedDoor;
    private bool _visDorImport;
    private bool _visBrannkontroll;
    private string _dorSok = "";
    private string _dorEtasjeFilter = "";
    private string _dorSoneFilter = "";
    private string _dorByggetrinnFilter = "";

    private sealed class KomponentIBrukOption
    {
        public int ComponentId { get; set; }
        public string Navn { get; set; } = "";
        public int AntallDorer { get; set; }
    }

    private sealed class ByttSearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
    }

    private int? _byttGammelComponentId;
    private int? _byttNyKomponentId;
    private string? _byttNyKomponentNavn;
    private string _byttSok = "";
    private List<ByttSearchResult> _byttSearchResults = [];
    private bool _confirmingBytte;
    private bool _visByttKomponent;
    private string? _byttMelding;

    private List<KomponentIBrukOption> KomponenterIBruk => _dorer
        .SelectMany(d => d.Komponenter)
        .Where(dk => dk.Component is not null)
        .GroupBy(dk => dk.ComponentId)
        .Select(g => new KomponentIBrukOption
        {
            ComponentId = g.Key,
            Navn = g.First().Component!.Navn,
            AntallDorer = g.Select(dk => dk.DorId).Distinct().Count()
        })
        .OrderBy(k => k.Navn)
        .ToList();

    // Dørene komponenten skal byttes på - alle med komponenten er valgt fra start.
    private HashSet<int> _byttValgteDorer = [];

    private int AntallDorerMedValgtKomponent => _byttGammelComponentId is null
        ? 0
        : _dorer.Count(d => _byttValgteDorer.Contains(d.Id) && d.Komponenter.Any(dk => dk.ComponentId == _byttGammelComponentId));

    private void OnByttGammelChanged()
    {
        _byttValgteDorer = _byttGammelComponentId is null
            ? []
            : _dorer.Where(d => d.Komponenter.Any(dk => dk.ComponentId == _byttGammelComponentId)).Select(d => d.Id).ToHashSet();
        _byttNyKomponentId = null;
        _byttNyKomponentNavn = null;
        _byttSok = "";
        _byttSearchResults = [];
        _confirmingBytte = false;
        _byttMelding = null;
    }

    private async Task OnByttSokChanged()
    {
        var term = _byttSok.Trim();
        if (term.Length < 2)
        {
            _byttSearchResults = [];
            return;
        }

        _byttSearchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new ByttSearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor })
            .ToListAsync();
    }

    private void VelgNyKomponent(ByttSearchResult r)
    {
        _byttNyKomponentId = r.Id;
        _byttNyKomponentNavn = r.Navn;
        _byttSok = "";
        _byttSearchResults = [];
    }

    private async Task ByttKomponentOveralt()
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (_byttGammelComponentId is null || _byttNyKomponentId is null)
        {
            return;
        }

        var gammelId = _byttGammelComponentId.Value;
        var nyId = _byttNyKomponentId.Value;
        var nyComponent = await Db.Components.FindAsync(nyId);
        var antallOppdatert = 0;

        foreach (var dor in _dorer.Where(d => _byttValgteDorer.Contains(d.Id)))
        {
            var gammel = dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == gammelId);
            if (gammel is null)
            {
                continue;
            }

            var eksisterendeNy = dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == nyId);
            if (eksisterendeNy is not null)
            {
                eksisterendeNy.Antall += gammel.Antall;
            }
            else
            {
                var nyDk = new DorKomponent
                {
                    DorId = dor.Id,
                    ComponentId = nyId,
                    Component = nyComponent,
                    Antall = gammel.Antall,
                    Enhet = gammel.Enhet,
                    LevertAv = gammel.LevertAv
                };
                dor.Komponenter.Add(nyDk);
                Db.DorKomponenter.Add(nyDk);
            }

            dor.Komponenter.Remove(gammel);
            Db.DorKomponenter.Remove(gammel);
            antallOppdatert++;
        }

        await Db.SaveChangesAsync();
        if (antallOppdatert > 0)
        {
            await TilbudSync.SyncSylinderAsync(Id!.Value, nyId);
        }
        _byttMelding = $"Byttet ut komponent på {antallOppdatert} dør(er).";
        _byttValgteDorer = [];
        _byttGammelComponentId = null;
        _byttNyKomponentId = null;
        _byttNyKomponentNavn = null;
        _confirmingBytte = false;
    }

    private List<string> DistinkteEtasjer =>
        _dorer.Select(d => d.Etasje).Where(e => !string.IsNullOrWhiteSpace(e)).Distinct().OrderBy(e => e).ToList()!;

    private List<string> DistinkteSoner =>
        _dorer.Select(d => d.Sone).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s).ToList()!;

    private List<string> DistinkteByggetrinn =>
        ByggetrinnHelper.Sorter(_dorer.Select(d => d.Plantegning?.Byggetrinn).Where(b => !string.IsNullOrWhiteSpace(b)).Distinct()!).ToList();

    // Enkel, mekanisk konsistenssjekk - IKKE en juridisk vurdering opp mot TEK/byggeregelverket eller
    // maskindirektivet/NS-EN 16005. Flagger kun ting som er avledet av data allerede registrert på
    // dørene, se "Regelverk"-guiden (Guider) for kildene sjekkene er basert på:
    //  - En brannklasse med "C" (f.eks. EI60C, EI30-CSa) er selvlukkende-kravet i TEK17 §11-8 - slike
    //    dører bør ha en lukkefunksjon (dørlukker eller automatikk) registrert.
    //  - En slik dør som i tillegg er i rømningsvei bør ha AUTOMATIKK spesifikt (ikke bare manuell
    //    dørlukker), av hensyn til maks åpningskraft for rømningsdører (TEK17 §12-13).
    //  - Enhver dør med automatikk er en motordrevet dør (maskin) og bør ha en sikkerhetssensor
    //    registrert, jf. maskindirektivet/NS-EN 16005-kravene til automatiske gangdører.
    private static bool HarFunksjon(Dor d, params string[] nokkelord) =>
        d.Funksjoner.Any(f => nokkelord.Any(n => f.Navn.Contains(n, StringComparison.OrdinalIgnoreCase)));

    private static bool KreverSelvlukking(Dor d) =>
        !string.IsNullOrWhiteSpace(d.Brann) && d.Brann.Contains('C');

    private static bool HarLukkefunksjon(Dor d) => HarFunksjon(d, "lukker", "automatikk");
    private static bool HarAutomatikk(Dor d) => HarFunksjon(d, "automatikk");
    private static bool ErRomningsvei(Dor d) => HarFunksjon(d, "rømning");
    private static bool HarSikkerhetssensor(Dor d) => HarFunksjon(d, "sensor");

    private List<Dor> DorerManglerLukker =>
        _dorer
            .Where(d => KreverSelvlukking(d) && !HarLukkefunksjon(d))
            .OrderBy(d => d.Dornummer)
            .ToList();

    private List<Dor> RomningsveiManglerAutomatikk =>
        _dorer
            .Where(d => KreverSelvlukking(d) && ErRomningsvei(d) && !HarAutomatikk(d))
            .OrderBy(d => d.Dornummer)
            .ToList();

    private List<Dor> AutomatikkManglerSensor =>
        _dorer
            .Where(HarAutomatikk)
            .Where(d => !HarSikkerhetssensor(d))
            .OrderBy(d => d.Dornummer)
            .ToList();

    private List<(string Sone, List<Dor> Dorer)> SonerMedUliktBrannkrav =>
        _dorer
            .Where(d => !string.IsNullOrWhiteSpace(d.Sone) && !string.IsNullOrWhiteSpace(d.Brann))
            .GroupBy(d => d.Sone!)
            .Where(g => g.Select(d => d.Brann).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1)
            .Select(g => (Sone: g.Key, Dorer: g.OrderBy(d => d.Dornummer).ToList()))
            .OrderBy(x => x.Sone)
            .ToList();

    private int AntallBrannavvik =>
        DorerManglerLukker.Select(d => d.Id)
            .Union(RomningsveiManglerAutomatikk.Select(d => d.Id))
            .Union(AutomatikkManglerSensor.Select(d => d.Id))
            .Union(SonerMedUliktBrannkrav.SelectMany(s => s.Dorer.Select(d => d.Id)))
            .Distinct()
            .Count();

    private string _dorStatusFilter = "";

    private static string Andel0(int del, int helhet) => helhet == 0 ? "0" : Math.Round(100.0 * del / helhet).ToString("0");

    // ---- Prosjektkort P6: knapper over tabellene ----
    private bool _dorBrannFilter;
    private string _tilbudChip = "";

    private string DorChip => _dorBrannFilter ? "brann" : _dorStatusFilter;

    private void VelgDorChip(string verdi)
    {
        _dorBrannFilter = verdi == "brann";
        _dorStatusFilter = verdi == "brann" ? "" : verdi;
    }

    private static string DorStatusPill(MontasjeStatus s) => s switch
    {
        MontasjeStatus.FerdigMontert => "s-ok",
        MontasjeStatus.Montert => "s-gul",
        _ => "s-gra"
    };

    private static string TilbudStatusTekst(EndringsmeldingStatus s) => s switch
    {
        EndringsmeldingStatus.Utkast => "Utkast",
        EndringsmeldingStatus.SendtTilKunde => "Sendt",
        EndringsmeldingStatus.Godkjent => "Godkjent",
        EndringsmeldingStatus.Avslatt => "Avslått",
        _ => s.Visningsnavn()
    };

    private static string TilbudPill(EndringsmeldingStatus s) => s switch
    {
        EndringsmeldingStatus.SendtTilKunde => "s-gul",
        EndringsmeldingStatus.Godkjent => "s-ok",
        EndringsmeldingStatus.Avslatt => "s-rod",
        _ => "s-gra"
    };

    // Montert per vare på Montering-fanen: summen av beslag med samme vare
    // som er krysset av som montert på dørene.
    private int MontertForVare(int? componentId) => componentId is null
        ? 0
        : _dorer.SelectMany(d => d.Komponenter).Where(k => k.ComponentId == componentId && k.Montert).Sum(k => k.Antall);

    private sealed record BeslagRad(string Navn, int Antall, int Dorer);

    private List<BeslagRad> BeslagOppsummering => _dorer
        .SelectMany(d => d.Komponenter)
        .GroupBy(k => k.Component?.Navn ?? "Ukjent vare")
        .Select(g => new BeslagRad(g.Key, g.Sum(k => k.Antall), g.Select(k => k.DorId).Distinct().Count()))
        .OrderByDescending(b => b.Antall)
        .ToList();

    private List<Dor> FiltrerteDorer => _dorer.Where(d =>
        (!_dorBrannFilter || !string.IsNullOrWhiteSpace(d.Brann)) &&
        (string.IsNullOrWhiteSpace(_dorStatusFilter) || d.Status.ToString() == _dorStatusFilter) &&
        (string.IsNullOrWhiteSpace(_dorEtasjeFilter) || d.Etasje == _dorEtasjeFilter) &&
        (string.IsNullOrWhiteSpace(_dorSoneFilter) || d.Sone == _dorSoneFilter) &&
        (string.IsNullOrWhiteSpace(_dorByggetrinnFilter) || d.Plantegning?.Byggetrinn == _dorByggetrinnFilter) &&
        MatcherDorSok(d, _dorSok)).ToList();

    private static bool MatcherDorSok(Dor d, string sok)
    {
        if (string.IsNullOrWhiteSpace(sok))
        {
            return true;
        }

        var s = sok.Trim();
        return (d.Dornummer?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Etasje?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Sone?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.DorTil?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Romnr?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void NullstillDorFilter()
    {
        _dorSok = "";
        _dorEtasjeFilter = "";
        _dorSoneFilter = "";
        _dorByggetrinnFilter = "";
