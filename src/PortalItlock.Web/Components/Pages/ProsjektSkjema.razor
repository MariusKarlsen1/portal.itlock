                {
                    var person = _form.Medlemmer.FirstOrDefault(m => m.Id == valgtId);
                    var rolleNokkel = nokkel;
                    <div class="pe-rk @(person is null ? "pe-tom" : "")">
                        @if (person is not null)
                        {
                            <span class="pe-av pe-av-stor" style="background:@PersonFarge(person.Navn);">@PersonInitialer(person.Navn)</span>
                        }
                        else
                        {
                            <span class="pe-av pe-av-stor pe-av-tom"><Icon Name="users" /></span>
                        }
                        <span class="pe-rk-t">
                            <span class="pe-lbl">@tittel</span>
                            <b>@(person?.Navn ?? "Ikke satt")</b>
