    private string TabClass(string tab) => _activeTab == tab ? "tab-button tab-button-active" : "tab-button";

    private List<Bruker> TilgjengeligeBrukere =>
        _alleBrukere.Where(b => !_form.Medlemmer.Any(m => m.Id == b.Id)).ToList();

    private int KalkulertMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutter ?? 0));

    private int BruktMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.Montert).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutter ?? 0));

    private int GjenstaendeMontasjeMinutter =>
        Math.Max(0, KalkulertMontasjeMinutter - BruktMontasjeMinutter);

    private int AntallBeslagTotalt => _dorer.SelectMany(d => d.Komponenter).Sum(dk => dk.Antall);

    private int AntallBeslagMontert => _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.Montert).Sum(dk => dk.Antall);

    private static string FormatTid(int minutter)
    {
        if (minutter <= 0)
        {
            return "0 min";
        }

        var timer = minutter / 60;
        var rest = minutter % 60;
        return timer > 0 ? $"{timer}t {rest}min" : $"{rest} min";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_hasLoaded && _loadedId == Id)
        {
            return;
        }

        _hasLoaded = true;
        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _beslagslistePreviewUrl = null;
        _error = null;
        _notFound = false;
        _ingenTilgang = false;
        _activeTab = "oversikt";
        _selectedDoor = null;

        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();
        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();

        if (Id.HasValue)
        {
            var existing = await Db.Prosjekter
                .Include(p => p.Plantegninger)
                .Include(p => p.Vedlegg)
                .Include(p => p.Tilbud).ThenInclude(t => t.OpprinneligTilbud)
                .Include(p => p.Medlemmer)
                .FirstOrDefaultAsync(p => p.Id == Id.Value);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            if (_naverendeRolle == BrukerRolle.Montor && !existing.Medlemmer.Any(m => m.Id == _naverendeBrukerId))
            {
                _ingenTilgang = true;
                return;
            }

            _form = existing;
            _plantegninger = existing.Plantegninger;
            _vedlegg = existing.Vedlegg;
            _tilbud = existing.Tilbud.OrderByDescending(t => t.OpprettetDato).ToList();

            _koblingsskjemaer = await Db.KoblingsSkjemaer
                .Include(k => k.Kategori)
                .Where(k => k.ProsjektId == Id)
                .OrderBy(k => k.Navn)
                .ToListAsync();

            _dorIdMaler = await Db.DorIdMaler
                .Where(m => m.ProsjektId == Id.Value)
                .OrderBy(m => m.Kode)
                .ToListAsync();

            _dorer = await Db.Dorer
                .Where(d => d.ProsjektId == Id.Value)
                .Include(d => d.Plantegning)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.MontertAvBruker)
                .Include(d => d.MontertAvBruker)
                .Include(d => d.Funksjoner)
                .OrderBy(d => d.Dornummer)
                .ToListAsync();

            _byggetrinnListe = ByggetrinnHelper.Sorter(_dorer
                .Where(d => !string.IsNullOrWhiteSpace(d.Plantegning?.Byggetrinn))
                .Select(d => d.Plantegning!.Byggetrinn!.Trim())
                .Distinct()).ToList();

            _fdvVedlegg = await Db.FdvVedlegg
                .Where(v => v.ProsjektId == Id.Value)
                .OrderBy(v => v.Navn)
                .ToListAsync();

            _lagredeFdvPdfer = await LagretPdfService.HentAsync("Fdv", Id.Value);
            _lagredeBeslagslistePdfer = await LagretPdfService.HentAsync("Beslagsliste", Id.Value);
        }
        else
        {
            if (_naverendeRolle == BrukerRolle.Montor)
            {
                _ingenTilgang = true;
                return;
            }

            _plantegninger = [];
            _vedlegg = [];
            _tilbud = [];
            _dorer = [];
            _dorIdMaler = [];
            _form = new Prosjekt { Navn = "" };
        }
    }

    private async Task Lagre()
    {
