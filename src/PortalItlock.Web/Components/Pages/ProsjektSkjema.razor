    private List<Fase> Faser
    {
        get
        {
            var harDorer = _dorer.Count > 0;
            var godkjent = _tilbud.FirstOrDefault(t => t.Status == EndringsmeldingStatus.Godkjent);
            var sendt = _tilbud.Any(t => t.Status == EndringsmeldingStatus.SendtTilKunde);
            var alleFerdig = harDorer && _dorer.All(d => d.Status == MontasjeStatus.FerdigMontert);
            var harFdv = _lagredeFdvPdfer.Count > 0;
            var ferdigProsjekt = _form.Status is ProsjektStatus.Overlevert or ProsjektStatus.Avsluttet;

            var dorTilstand = harDorer ? "ok" : "na";
            var tilbudTilstand = godkjent is not null ? "ok" : harDorer ? "na" : "";
            var montTilstand = alleFerdig ? "ok" : (godkjent is not null || AntallBeslagMontert > 0) ? "na" : "";
            var dokTilstand = harFdv && alleFerdig ? "ok" : alleFerdig ? "na" : "";

            return
            [
                new("1", "Registrert", "Prosjekt", "Kunde, adresse og CE", "ok", "oversikt", 100),
                new("2", "Bygget", harDorer ? $"{_dorer.Count} dører" : "Ingen dører", harDorer ? $"{AntallBeslagTotalt} beslag · {_plantegninger.Count} plantegning{(_plantegninger.Count == 1 ? "" : "er")}" : "Legg inn dørene", dorTilstand, "dorer", harDorer ? 100 : 0),
                new("3", "Tilbud", godkjent is not null ? "Godkjent" : sendt ? "Sendt til kunde" : _tilbud.Count > 0 ? "Utkast" : "Ikke laget",
                    HovedTilbud is { } ht ? (ht.SendtSum.HasValue ? $"{ht.Tittel} · {ht.SendtSum.Value.ToString("N0", NorskKultur)} kr" : ht.Tittel) : "Lages fra dørene",
                    tilbudTilstand, "tilbud", godkjent is not null ? 100 : sendt ? 60 : _tilbud.Count > 0 ? 30 : 0),
                new("4", "Montering", alleFerdig ? "Ferdig" : AntallBeslagMontert > 0 ? "Pågår" : "Ikke startet", harDorer ? $"{AntallDorer(MontasjeStatus.FerdigMontert)} av {_dorer.Count} dører ferdig" : "–", montTilstand, "dorer", TotalProsent),
                new("5", "Dokumentasjon", harFdv ? "FDV laget" : "Klar til å lage", "FDV, beslagsliste, låsplan", dokTilstand, "fdv", harFdv ? 100 : 0),
                new("6", "Overlevert", ferdigProsjekt ? "Overlevert" : "Faktura", ferdigProsjekt ? "Overlevert kunden" : "Overføres til Tripletex", ferdigProsjekt ? "ok" : "", "oversikt", ferdigProsjekt ? 100 : 0),
            ];
        }
    }

    private (string Tittel, string Tekst, string Knapp, string Fane)? NesteSteg
    {
        get
        {
            if (_dorer.Count == 0)
            {
                return ("Legg inn dørene", "Prosjektet har ingen dører ennå. Legg dem til én og én, eller importer et dørskjema.", "Gå til dører", "dorer");
            }
            if (_tilbud.Count == 0 && !SkjulteFaner.Contains("tilbud"))
            {
                return ("Lag tilbudet", $"{_dorer.Count} dører og {AntallBeslagTotalt} beslag er klare til å regnes ut.", "Gå til tilbud", "tilbud");
            }
            var ikkeStartet = _dorer.Where(d => d.Status == MontasjeStatus.IkkeStartet).Select(d => d.Dornummer).ToList();
            if (ikkeStartet.Count > 0)
            {
                var navn = string.Join(", ", ikkeStartet.Take(4)) + (ikkeStartet.Count > 4 ? " …" : "");
                var ord = ikkeStartet.Count == 1 ? "dør er" : "dører er";
                return ($"{ikkeStartet.Count} {ord} ikke startet", $"{navn} · ca. {FormatTid(GjenstaendeMontasjeMinutter)} montasje gjenstår.", "Se dørene", "dorer");
            }
            var pagar = AntallDorer(MontasjeStatus.Montert);
            if (pagar > 0)
            {
                return ($"Montasje pågår på {pagar} {(pagar == 1 ? "dør" : "dører")}", $"{AntallBeslagMontert} av {AntallBeslagTotalt} beslag er montert.", "Se dørene", "dorer");
            }
            if (_lagredeFdvPdfer.Count == 0)
            {
                return ("Alle dører er ferdig montert", "Lag FDV-dokumentasjonen til kunden.", "Gå til FDV", "fdv");
            }
            return null;
        }
    }

