    private async Task OpprettByggetrinn()
    {
        if (!KanRedigereProsjekt || !Id.HasValue)
        {
            return;
        }

        var navn = _nyttByggetrinnNavn.Trim();
        if (navn.Length == 0 || navn == UgruppertNavn)
        {
            return;
        }

        if (!_byggetrinn.Any(b => string.Equals(b.Navn, navn, StringComparison.OrdinalIgnoreCase)))
        {
            var neste = _byggetrinn.Count == 0 ? 0 : _byggetrinn.Max(b => b.Rekkefolge) + 1;
            Db.ProsjektByggetrinn.Add(new ProsjektByggetrinn { ProsjektId = Id.Value, Navn = navn, Rekkefolge = neste });
        }
        else
        {
            navn = _byggetrinn.First(b => string.Equals(b.Navn, navn, StringComparison.OrdinalIgnoreCase)).Navn;
        }

        if (_nyttByggetrinnForTegning is int tegningId && _plantegninger.FirstOrDefault(p => p.Id == tegningId) is { } tegning)
        {
            tegning.Byggetrinn = navn;
        }

        await Db.SaveChangesAsync();
        _visNyttByggetrinn = false;
        _nyttByggetrinnForTegning = null;
        await ReloadPlantegninger();
    }

    private async Task SlettByggetrinn(string navn)
    {
        if (!KanRedigereProsjekt || _plantegninger.Any(p => GruppeAv(p) == navn))
        {
            return;
        }

        Db.ProsjektByggetrinn.RemoveRange(_byggetrinn.Where(b => b.Navn == navn));
        await Db.SaveChangesAsync();
        await ReloadPlantegninger();
    }

    // Slipp på et byggetrinn: en tegning flyttes dit, et byggetrinn legges foran det.
    private async Task SlippPaGruppe(string malGruppe)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (_draTegningId is int tegningId && _plantegninger.FirstOrDefault(p => p.Id == tegningId) is { } tegning)
        {
            _draTegningId = null;
            if (GruppeAv(tegning) != malGruppe)
            {
                await FlyttPlantegning(tegning, malGruppe);
            }

            return;
        }

        if (_draGruppe is { } fra && fra != malGruppe && malGruppe != UgruppertNavn)
        {
            _draGruppe = null;
            var rekke = _byggetrinn.OrderBy(b => b.Rekkefolge).ThenBy(b => b.Navn).ToList();
            var flyttes = rekke.FirstOrDefault(b => b.Navn == fra);
            if (flyttes is null)
            {
                return;
            }

            rekke.Remove(flyttes);
            var foran = rekke.FindIndex(b => b.Navn == malGruppe);
            rekke.Insert(foran < 0 ? rekke.Count : foran, flyttes);
            for (var i = 0; i < rekke.Count; i++)
            {
                rekke[i].Rekkefolge = i;
            }

            await Db.SaveChangesAsync();
        }

        _draGruppe = null;
    }

