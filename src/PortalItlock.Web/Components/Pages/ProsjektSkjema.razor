    protected override async Task OnParametersSetAsync()
    {
        if (!_pkFullLastet)
        {
            _pkFullLastet = true;
            _pkFull = await VisningPref.HentAsync("prosjektkort-bredde", "normal") == "full";
        }

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        // Står man på en fane rollen ikke skal se - f.eks. fordi rollen er
        // byttet med "Vis som" mens siden var åpen - faller man tilbake til
        // Oversikt i stedet for å se innholdet i en skjult fane.
        if (SkjulteFaner.Contains(_activeTab))
        {
            _activeTab = "status";
        }

        if (_hasLoaded && _loadedId == Id)
        {
            ApneDorIdFraLenke();
            return;
        }

        _hasLoaded = true;
        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _beslagslistePreviewUrl = null;
        _error = null;
        _notFound = false;
        _ingenTilgang = false;
        // ?fane=... (f.eks. fra produktsammendraget) åpner en bestemt fane.
        // «modell» (3D) er fjernet - gamle lenker dit havner på Oversikt.
        _activeTab = string.IsNullOrWhiteSpace(StartFane) || SkjulteFaner.Contains(StartFane) || StartFane == "modell" ? "status" : StartFane;
        _selectedDoor = null;

        // AsNoTracking: disse tre er rene oppslagslister (nedtrekksmenyer for
        // kunde/bruker/forsidemal) - verifisert at ingen av dem noensinne
        // muteres og lagres direkte fra denne siden (kun lest via
        // FirstOrDefault/foreach andre steder i filen), se CODE_REVIEW.md 2026-10-08.
        _kunder = await Db.Kunder.AsNoTracking().OrderBy(k => k.Navn).ToListAsync();
        _alleBrukere = await Db.Brukere.AsNoTracking().OrderBy(b => b.Navn).ToListAsync();

        if (Id.HasValue)
        {
            var existing = await Db.Prosjekter
                .Include(p => p.Plantegninger)
                .Include(p => p.Vedlegg)
                .Include(p => p.Tilbud).ThenInclude(t => t.OpprinneligTilbud)
                .Include(p => p.Tilbud).ThenInclude(t => t.Linjer)
                .Include(p => p.Tilbud).ThenInclude(t => t.KodeLinjer)
                .Include(p => p.MonteringLinjer).ThenInclude(m => m.Component)
                .Include(p => p.Medlemmer)
                .FirstOrDefaultAsync(p => p.Id == Id.Value);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            if (_naverendeRolle == BrukerRolle.Montor && !existing.Medlemmer.Any(m => m.Id == _naverendeBrukerId))
            {
                _ingenTilgang = true;
                return;
            }

            _form = existing;
            _plantegninger = existing.Plantegninger;
            // Byggetrinnene (også tomme) og rekkefølgen deres.
            await ReloadPlantegninger();
            _vedlegg = existing.Vedlegg;
            _mapper = await Db.ProsjektMapper
                .Where(m => m.ProsjektId == Id.Value)
                .OrderBy(m => m.Sortering).ThenBy(m => m.Navn)
                .ToListAsync();
            _lenker = await Db.ProsjektLenker
                .Where(l => l.ProsjektId == Id.Value)
                .OrderBy(l => l.Navn)
                .ToListAsync();
            _tilbud = existing.Tilbud.OrderByDescending(t => t.OpprettetDato).ToList();
            _monteringLinjer = existing.MonteringLinjer.OrderBy(m => m.Rekkefolge).ToList();

            // Kun til visning på Oversikt - selve ordrene redigeres på
            // arbeidsordresiden som før.
            _prosjektOrdre = await Db.Arbeidsordre
                .AsNoTracking()
                .Include(a => a.AnsvarligMontor)
                .Where(a => a.ProsjektId == Id.Value)
                .OrderByDescending(a => a.PlanlagtDato ?? a.OpprettetDato)
                .Take(30)
                .ToListAsync();

            // AsNoTracking: kun lest/filtrert her (vist i en liste med lenke
            // til egen redigeringsside, KoblingsSkjemaVisning.razor) -
            // verifisert at ingen felter på disse muteres+lagres fra denne
            // siden, se CODE_REVIEW.md 2026-10-08.
            _koblingsskjemaer = await Db.KoblingsSkjemaer
                .AsNoTracking()
                .Include(k => k.Kategori)
                .Where(k => k.ProsjektId == Id)
                .OrderBy(k => k.Navn)
                .ToListAsync();

            _dorIdMaler = await Db.DorIdMaler
                .Where(m => m.ProsjektId == Id.Value)
                .OrderBy(m => m.Kode)
                .ToListAsync();
            await LastProsjektAvvikAsync();

            _dorer = await Db.Dorer
                .Where(d => d.ProsjektId == Id.Value)
                .Include(d => d.Plantegning)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.Component).ThenInclude(c => c!.Type)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.MontertAvBruker)
                .Include(d => d.MontertAvBruker)
                .Include(d => d.OppdatertAvBruker)
                .Include(d => d.Funksjoner)
                .OrderBy(d => d.Dornummer)
                .ToListAsync();
            ApneDorIdFraLenke();

            _byggetrinnListe = ByggetrinnHelper.Sorter(_dorer
                .Where(d => !string.IsNullOrWhiteSpace(d.Plantegning?.Byggetrinn))
                .Select(d => d.Plantegning!.Byggetrinn!.Trim())
                .Distinct()).ToList();

            _lagredeFdvPdfer = await LagretPdfService.HentAsync("Fdv", Id.Value);
            _lagredeBeslagslistePdfer = await LagretPdfService.HentAsync("Beslagsliste", Id.Value);
        }
        else
        {
            if (_naverendeRolle == BrukerRolle.Montor)
            {
                _ingenTilgang = true;
                return;
            }

            _plantegninger = [];
            _vedlegg = [];
            _mapper = [];
            _tilbud = [];
            _monteringLinjer = [];
            _dorer = [];
            _dorIdMaler = [];
            _form = new Prosjekt
            {
                Navn = Navn ?? "",
                KundeId = KundeId,
                Adresse = Adresse,
                Kontaktperson = Kontaktperson,
            };
        }
        await LastKontakter();
    }

    private sealed record KontaktValg(string Navn, string? Rolle, string? Telefon, string? Epost);
    private List<KontaktValg> _kontakter = [];
    private bool _annenKontakt;

    // Kundens hovedkontakt + kontaktpersoner, til nedtrekkslisten på prosjektet.
    private async Task LastKontakter()
    {
        _kontakter = [];
        if (_form.KundeId is int kid && _kunder.FirstOrDefault(k => k.Id == kid) is { } kunde)
        {
            if (!string.IsNullOrWhiteSpace(kunde.Kontaktperson))
            {
                _kontakter.Add(new(kunde.Kontaktperson.Trim(), "Hovedkontakt", kunde.Telefon, kunde.Epost));
            }
            var personer = await Db.KundeKontaktpersoner.AsNoTracking().Where(k => k.KundeId == kid).OrderBy(k => k.Navn).ToListAsync();
            foreach (var pr in personer)
            {
                if (!string.IsNullOrWhiteSpace(pr.Navn) && !_kontakter.Any(k => string.Equals(k.Navn, pr.Navn.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    _kontakter.Add(new(pr.Navn.Trim(), pr.Rolle, pr.Telefon, pr.Epost));
                }
            }
        }
        // Står det en person som ikke finnes på kunden, vises fritekstfeltet så den ikke forsvinner.
        _annenKontakt = !string.IsNullOrWhiteSpace(_form.Kontaktperson)
            && !_kontakter.Any(k => string.Equals(k.Navn, _form.Kontaktperson.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private async Task KundeEndret() => await LastKontakter();

    private void VelgKontakt(ChangeEventArgs e)
    {
        var verdi = e.Value?.ToString() ?? "";
        if (verdi == "__annen")
        {
            _annenKontakt = true;
            _form.Kontaktperson = null;
            return;
        }
        if (string.IsNullOrEmpty(verdi))
        {
            _form.Kontaktperson = null;
            return;
        }
        var k = _kontakter.FirstOrDefault(x => x.Navn == verdi);
        _form.Kontaktperson = verdi;
        if (k is not null)
        {
            _form.Telefon = k.Telefon;
            _form.Epost = k.Epost;
        }
    }

    private async Task AutoLagre()
    {
        if (Id.HasValue && KanRedigereProsjekt)
        {
            await Db.SaveChangesAsync();
        }
    }

    private async Task Lagre()
    {
        // Serverside-sperre, ikke bare en skjult knapp: montører kan lese
        // prosjektet, men ikke lagre endringer på det.
        if (!KanRedigereProsjekt)
        {
            _error = "Du har ikke tilgang til å endre prosjektopplysningene.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Prosjektet må ha et navn.";
            return;
        }

        if (_form.Status is null)
        {
            _error = "Du må velge en status for prosjektet.";
            return;
        }

        _error = null;

        if (!Id.HasValue)
        {
            Db.Prosjekter.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Prosjektet \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Prosjektet \"{_form.Navn}\" er lagret.";
            // Nytt prosjekt: fortsett i Rediger (Prosjektinfo). Eksisterende prosjekter åpner på Oversikt.
            Nav.NavigateTo($"/prosjekter/{_form.Id}?fane=oversikt");
        }
    }

    private async Task ConfirmDelete()
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Prosjekter.FirstOrDefaultAsync(p => p.Id == Id.Value);
        if (existing is not null)
        {
            Db.Prosjekter.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/prosjekter");
    }

