                }
                <div class="pe-fot">
                    <span><b>@_form.Medlemmer.Count</b> @(_form.Medlemmer.Count == 1 ? "person" : "personer") på prosjektet</span>
                    <span><b>@_form.Medlemmer.Count(m => m.Id != _form.ProsjektlederId && m.Id != _form.AnsvarligMontorId)</b> i tillegg til de ansvarlige</span>
