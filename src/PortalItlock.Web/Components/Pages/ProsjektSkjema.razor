@page "/prosjekter/ny"
@page "/prosjekter/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using SkiaSharp
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject FdvPdfService FdvPdfService
@inject DorBeslagslistePdfService BeslagslistePdfService
@inject LagretPdfService LagretPdfService
@inject TilbudSyncService TilbudSync

<PageTitle>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</PageTitle>

@if (_ingenTilgang)
{
    <p class="form-error">Du har ikke tilgang til dette prosjektet.</p>
}
else if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else
{
    <h1>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</h1>

    @if (Id.HasValue && _form.Status == ProsjektStatus.Serviceavtale)
    {
        <a class="back-link" href="@($"/serviceavtaler/{Id}")">&larr; Til serviceavtalen</a>
    }

    @if (Id.HasValue)
    {
        <nav class="prosjekt-tabs">
            <button type="button" class="@TabClass("oversikt")" @onclick="@(() => _activeTab = "oversikt")">Oversikt</button>
            <button type="button" class="@TabClass("status")" @onclick="@(() => _activeTab = "status")">Status</button>
            <button type="button" class="@TabClass("dorer")" @onclick="@(() => _activeTab = "dorer")">Dører</button>
            <button type="button" class="@TabClass("plantegninger")" @onclick="@(() => _activeTab = "plantegninger")">Plantegninger</button>
            <button type="button" class="@TabClass("vedlegg")" @onclick="@(() => _activeTab = "vedlegg")">Vedlegg</button>
            <button type="button" class="@TabClass("tilbud")" @onclick="@(() => _activeTab = "tilbud")">Tilbud</button>
            <button type="button" class="@TabClass("fdv")" @onclick="@(() => _activeTab = "fdv")">FDV</button>
            <button type="button" class="@TabClass("dorid")" @onclick="@(() => _activeTab = "dorid")">Dør ID</button>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="@TabClass("personer")" @onclick="@(() => _activeTab = "personer")">Personer</button>
            }
            <button type="button" class="@TabClass("beslagsliste")" @onclick="@(() => _activeTab = "beslagsliste")">Beslagsliste</button>
            <button type="button" class="@TabClass("lasplan")" @onclick="@(() => _activeTab = "lasplan")">Låsplan</button>
        </nav>
    }

    @if (!Id.HasValue || _activeTab == "oversikt")
    {
        <div class="prosjekt-layout">
            <section class="prosjekt-section">
                <h2>Prosjektinformasjon</h2>
                <div class="field-grid">
                    <label class="span-2">
                        Navn
                        <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Lillesand sparebank" />
                    </label>
                    <label>
                        Kunde
                        <select @bind="_form.KundeId">
                            <option value="">Ikke satt</option>
                            @foreach (var k in _kunder)
                            {
                                <option value="@k.Id">@k.Navn</option>
                            }
                        </select>
                    </label>
                    <label>System<input @bind="_form.System" placeholder="F.eks. PXP, iLOQ" /></label>
                    <label>
                        Status
                        <select @bind="_form.Status">
                            <option value="">Velg status...</option>
                            @foreach (var s in Enum.GetValues<ProsjektStatus>())
                            {
                                <option value="@s">@s.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    <label>Adresse<input @bind="_form.Adresse" /></label>
                    <label>Post nr<input @bind="_form.Postnr" /></label>
                    <label>Sted<input @bind="_form.Sted" /></label>
                    <label>Kontaktperson<input @bind="_form.Kontaktperson" /></label>
                    <label>Telefon<input @bind="_form.Telefon" /></label>
                    <label>E-post<input @bind="_form.Epost" /></label>
                    <label>
                        Byggkategori (CE)
                        <select @bind="_form.Byggkategori">
                            <option value="">Ikke satt</option>
                            @foreach (var k in CeAlternativer.Byggkategorier)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </label>
                    <label>
                        Risikoklasse (CE)
                        <select @bind="_form.Risikoklasse">
                            <option value="">Ikke satt</option>
                            @foreach (var r in CeAlternativer.Risikoklasser)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </label>
                    <label>
                        CE-gyldighet (standard)
                        <select @bind="_form.CeGyldighetMåneder">
                            @foreach (var m in CeAlternativer.GyldighetMånederAlternativer)
                            {
                                <option value="@m">@m måneder</option>
                            }
                        </select>
                    </label>
                    <label class="span-2">
                        Notater
                        <textarea rows="3" @bind="_form.Notater"></textarea>
                    </label>
                </div>
            </section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <p class="save-success">@_savedMessage</p>
            }

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">
                    @(Id.HasValue ? "Lagre endringer" : "Lagre prosjekt")
                </button>

                @if (Id.HasValue)
                {
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker? Dette sletter også dører og plantegninger i prosjektet.
                            <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett prosjekt</button>
                    }
                }
            </div>
        </div>
    }
    else if (_activeTab == "status")
    {
        <div class="prosjekt-layout">
            <div class="status-grid">
                <div class="status-card">
                    <Icon Name="clock" />
                    <span class="status-label">Kalkulert montasjetid</span>
                    <span class="status-value">@FormatTid(KalkulertMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <Icon Name="tool" />
                    <span class="status-label">Total tidsforbruk</span>
                    <span class="status-value">@FormatTid(BruktMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <Icon Name="calendar" />
                    <span class="status-label">Estimert gjenværende montasjetid</span>
                    <span class="status-value">@FormatTid(GjenstaendeMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <Icon Name="trend-up" />
                    <span class="status-label">Fremdrift</span>
                    <span class="status-value">@AntallBeslagMontert/@AntallBeslagTotalt <span class="status-unit">beslag</span></span>
                </div>
            </div>
            <p class="section-hint">Basert på montasjetid registrert per vare i Komponentregisteret og hvilke beslag som er krysset av som montert på prosjektets dører.</p>
        </div>
    }
    else if (_activeTab == "dorer")
    {
        <div class="dorer-layout">
            <div class="dorer-list-wrap">
                <button type="button" class="add-button" @onclick="LeggTilDor">Legg til dør</button>

                @if (_dorer.Count > 0)
                {
                    <div class="bytt-komponent-panel">
                        <h3>Bytt komponent på alle dører</h3>
                        <p class="section-hint">
                            Velg en komponent som er i bruk i prosjektet og en erstatning. Alle dører med den gamle
                            komponenten oppdateres til den nye, og monteringsstatus nullstilles siden det er en ny fysisk del.
                        </p>

                        <div class="bytt-komponent-felt">
                            <select @bind="_byttGammelComponentId" @bind:after="OnByttGammelChanged">
                                <option value="">Velg komponent å bytte ut...</option>
                                @foreach (var k in KomponenterIBruk)
                                {
                                    <option value="@k.ComponentId">@k.Navn (@k.AntallDorer dør(er))</option>
                                }
                            </select>

                            <div class="bytt-sok-wrap">
                                <input @bind="_byttSok" @bind:event="oninput" @bind:after="OnByttSokChanged"
                                       placeholder="Søk ny komponent..." disabled="@(_byttGammelComponentId is null)" />
                                @if (_byttSearchResults.Count > 0)
                                {
                                    <ul class="search-results">
                                        @foreach (var r in _byttSearchResults)
                                        {
                                            <li>
                                                <button type="button" class="search-result" @onclick="@(() => VelgNyKomponent(r))">
                                                    <span class="search-result-name">@r.Navn</span>
                                                    <span class="search-result-meta">@r.Leverandor</span>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        @if (_byttNyKomponentNavn is not null)
                        {
                            <p class="section-hint">Ny komponent: <strong>@_byttNyKomponentNavn</strong></p>

                            @if (!_confirmingBytte)
                            {
                                <button type="button" class="save-button" @onclick="@(() => _confirmingBytte = true)">
                                    Bytt ut på @AntallDorerMedValgtKomponent dør(er)
                                </button>
                            }
                            else
                            {
                                <span class="delete-confirm">
                                    Er du sikker? Dette kan ikke angres.
                                    <button type="button" class="delete-confirm-button" @onclick="ByttKomponentOveralt">Ja, bytt ut</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingBytte = false)">Avbryt</button>
                                </span>
                            }
                        }

                        @if (!string.IsNullOrEmpty(_byttMelding))
                        {
                            <p class="save-success">@_byttMelding</p>
                        }
                    </div>
                }

                @if (_dorer.Count == 0)
                {
                    <p class="list-empty">Ingen dører registrert ennå.</p>
                }
                else
                {
                    <div class="dorer-filter-bar">
                        <input class="dorer-filter-sok" @bind="_dorSok" @bind:event="oninput" placeholder="Søk på dørnummer, etasje, sone, rom..." />
                        <select @bind="_dorEtasjeFilter">
                            <option value="">Alle etasjer</option>
                            @foreach (var etasje in DistinkteEtasjer)
                            {
                                <option value="@etasje">@etasje</option>
                            }
                        </select>
                        <select @bind="_dorSoneFilter">
                            <option value="">Alle soner</option>
                            @foreach (var sone in DistinkteSoner)
                            {
                                <option value="@sone">@sone</option>
                            }
                        </select>
                        @if (!string.IsNullOrWhiteSpace(_dorSok) || !string.IsNullOrWhiteSpace(_dorEtasjeFilter) || !string.IsNullOrWhiteSpace(_dorSoneFilter))
                        {
                            <button type="button" class="cancel-button" @onclick="NullstillDorFilter">Nullstill filter</button>
                        }
                        <span class="dorer-filter-count">@FiltrerteDorer.Count av @_dorer.Count dører</span>
                    </div>

                    @if (FiltrerteDorer.Count == 0)
                    {
                        <p class="list-empty">Ingen dører matcher filteret.</p>
                    }
                    else
                    {
                    <table class="dorer-table">
                        <thead>
                            <tr>
                                <th>Dørnummer</th>
                                <th>Etasje</th>
                                <th>Sone</th>
                                <th>Plassering</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in FiltrerteDorer)
                            {
                                <tr @key="d.Id" class="@(_selectedDoor?.Id == d.Id ? "dorer-row-selected" : "")">
                                    <td>@d.Dornummer</td>
                                    <td>@d.Etasje</td>
                                    <td>@d.Sone</td>
                                    <td>@(d.Plantegning?.Navn ?? "Ikke plassert")</td>
                                    <td>
                                        <select class="status-select @StatusSelectClass(d.Status)" value="@d.Status" @onchange="@((ChangeEventArgs e) => EndreStatus(d, e))">
                                            <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                            <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                            <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                                        </select>
                                    </td>
                                    <td><button type="button" class="remove-button" @onclick="@(() => SelectDoor(d))">Rediger</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    }
                }
            </div>

            @if (_selectedDoor is not null)
            {
                <DorRedigering Dor="_selectedDoor"
                                AlleDorer="_dorer"
                                OnClose="@(() => _selectedDoor = null)"
                                OnDeleted="OnDoorDeleted"
                                OnUnplaced="OnDoorUnplaced"
                                OnCloned="OnDoorsCloned"
                                OnSaved="StateHasChanged" />
            }
        </div>
    }
    else if (_activeTab == "plantegninger")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Last opp plantegninger og plasser dører på dem for å følge opp montasje.</p>

            @if (_plantegninger.Count > 0)
            {
                @foreach (var gruppe in PlantegningGrupper)
                {
                    <div @key="gruppe.Navn" class="plantegning-gruppe">
                        <div class="plantegning-gruppe-header">
                            <button type="button" class="gruppe-toggle" @onclick="@(() => ToggleGruppe(gruppe.Navn))">
                                <span class="gruppe-chevron">@(ErGruppeLukket(gruppe.Navn) ? "▸" : "▾")</span>
                                <span class="@CssHidden(_editingGruppe == gruppe.Navn)">@gruppe.Navn <span class="gruppe-count">(@gruppe.Plantegninger.Count)</span></span>
                            </button>
                            <span class="gruppe-rename-form @CssHidden(_editingGruppe != gruppe.Navn)">
                                <input @bind="_gruppeRenameInput" @bind:event="oninput" placeholder="Gruppenavn" />
                                <button type="button" class="save-button" @onclick="@(() => LagreGruppeNavn(gruppe.Navn))">Lagre</button>
                                <button type="button" class="cancel-button" @onclick="@(() => _editingGruppe = null)">Avbryt</button>
                            </span>
                            <button type="button" class="gruppe-rename-button @CssHidden(_editingGruppe == gruppe.Navn)" @onclick="@(() => StartGruppeRename(gruppe.Navn))">Endre navn</button>
                        </div>
                        <ul class="vedlegg-list @CssHidden(ErGruppeLukket(gruppe.Navn))">
                            @foreach (var p in gruppe.Plantegninger)
                            {
                                <li @key="p.Id" class="vedlegg-item">
                                    <a href="@($"/plantegning/{p.Id}")">@p.Navn</a>
                                    @if (AlleGruppeNavn.Count() > 1)
                                    {
                                        <select class="plantegning-flytt" @onchange="@(e => FlyttPlantegning(p, e.Value?.ToString()))">
                                            <option value="">Flytt til...</option>
                                            @foreach (var g in AlleGruppeNavn.Where(g => g != gruppe.Navn))
                                            {
                                                <option value="@g">@g</option>
                                            }
                                        </select>
                                    }
                                    <button type="button" class="remove-button" @onclick="@(() => RemovePlantegning(p))">Fjern</button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <p class="list-empty">Ingen plantegninger lastet opp ennå.</p>
            }

            <div class="vedlegg-upload">
                <input @bind="_nyPlantegningNavn" @bind:event="oninput" placeholder="Navn, f.eks. 1. etasje" />
                <input @bind="_nyPlantegningByggetrinn" @bind:event="oninput" placeholder="Byggetrinn (valgfritt)" />
                <InputFile @key="_plantegningInputKey" OnChange="OnPlantegningSelected" accept="image/*,.pdf,application/pdf" />
            </div>

            @if (_uploadingPlantegning)
            {
                <p class="list-empty">Laster opp...</p>
            }
            @if (!string.IsNullOrEmpty(_plantegningFeil))
            {
                <p class="form-error">@_plantegningFeil</p>
            }
        </div>
    }
    else if (_activeTab == "vedlegg")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Kravspek, grunnlag, tilbud og annen dokumentasjon som tilhører prosjektet. Skriv inn en mappe for å organisere filene, eller velg en du allerede har brukt.</p>

            @if (_vedlegg.Count > 0)
            {
                @foreach (var gruppe in VedleggGruppert)
                {
                    <div class="vedlegg-mappe">
                        <div class="vedlegg-mappe-header">
                            <h3 class="vedlegg-mappe-navn">@gruppe.Key</h3>
                            <label class="vedlegg-mappe-legg-til">
                                + Legg til fil
                                <InputFile OnChange="@(e => LeggTilIMappe(e, gruppe.Key == "Ukategorisert" ? null : gruppe.Key))" multiple />
                            </label>
                        </div>
                        <ul class="vedlegg-list">
                            @foreach (var v in gruppe)
                            {
                                <li @key="v.Id" class="vedlegg-item">
                                    <a href="@($"/prosjektvedlegg/{v.Id}")" target="_blank">@v.Filnavn</a>
                                    <button type="button" class="remove-button" @onclick="@(() => RemoveVedlegg(v))">Fjern</button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <p class="list-empty">Ingen vedlegg lastet opp ennå.</p>
            }

            <div class="vedlegg-upload">
                <label class="vedlegg-mappe-felt">
                    Mappe
                    <input list="vedlegg-mapper" @bind="_valgtVedleggType" @bind:event="oninput" placeholder="F.eks. Kravspek, Grunnlag, Tilbud..." />
                    <datalist id="vedlegg-mapper">
                        @foreach (var m in VedleggMapperForslag)
                        {
                            <option value="@m" />
                        }
                    </datalist>
                </label>
                <InputFile OnChange="OnVedleggSelected" multiple />
            </div>

            @if (_uploadingVedlegg)
            {
                <p class="list-empty">Laster opp...</p>
            }
            @if (!string.IsNullOrEmpty(_vedleggFeil))
            {
                <p class="form-error">@_vedleggFeil</p>
            }

            @if (_koblingsskjemaer.Count > 0)
            {
                <div class="vedlegg-mappe">
                    <h3 class="vedlegg-mappe-navn">Koblingsskjema</h3>
                    <ul class="vedlegg-list">
                        @foreach (var k in _koblingsskjemaer)
                        {
                            <li @key="k.Id" class="vedlegg-item">
                                <a href="@($"/koblingsskjema/{k.Id}")">@k.Navn</a>
                                <span class="vedlegg-type">@(k.Kategori?.Navn ?? "-")</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else if (_activeTab == "tilbud")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Lag tilbud basert på varene som er registrert på prosjektets dører.</p>

            @if (_tilbud.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var t in _tilbud)
                    {
                        <li @key="t.Id" class="vedlegg-item">
                            <a href="@($"/tilbud/{t.Id}")">@t.Tittel</a>
                            @if (t.Type == TilbudType.Endringsmelding)
                            {
                                <span class="endringsmelding-badge">Tillegg/endringsmelding</span>
                                <span class="vedlegg-type">@t.Status.Visningsnavn()</span>
                                @if (t.OpprinneligTilbud is not null)
                                {
                                    <span class="vedlegg-type">Tillegg til: @t.OpprinneligTilbud.Tittel</span>
                                }
                            }
                            <span class="vedlegg-type">@t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                            <button type="button" class="remove-button" @onclick="@(() => RemoveTilbud(t))">Slett</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="list-empty">Ingen tilbud opprettet ennå.</p>
            }

            <div class="tilbud-knapperad">
                <button type="button" class="add-button" @onclick="NyttTilbud">Nytt tilbud</button>

                <div class="endringsmelding-velger">
                    @if (_tilbud.Any(x => x.Type == TilbudType.Tilbud))
                    {
                        <select @bind="_valgtOpprinneligTilbudId">
                            <option value="">(ikke koblet til et bestemt tilbud)</option>
                            @foreach (var t in _tilbud.Where(x => x.Type == TilbudType.Tilbud))
                            {
                                <option value="@t.Id">Tillegg til: @t.Tittel</option>
                            }
                        </select>
                    }
                    <button type="button" class="add-button" @onclick="NyEndringsmelding">Ny endringsmelding/tillegg</button>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "fdv")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Samler FDV-dokumentasjonen for alle varer som er lagt på prosjektets dører, i én PDF. Hver vare kommer med kun én gang selv om den er brukt på flere dører.</p>

            <div class="field-grid">
                <label class="span-2">
                    Forside-mal
                    <div class="forside-mal-rad">
                        <select @bind="_valgtFdvForsideMalId">
                            <option value="">Velg forside...</option>
                            @foreach (var f in _forsideMaler)
                            {
                                <option value="@f.Id">@f.Navn</option>
                            }
                        </select>
                        <button type="button" class="cancel-button" @onclick="BrukFdvForsideMal" disabled="@(_valgtFdvForsideMalId is null)">Bruk</button>
                    </div>
                </label>

                <label class="span-2">
                    Forside / forbehold
                    <ForsideTekstRedigering @bind-Value="_form.FdvForside" Rows="8" Placeholder="Tekst til forsiden av FDV-samlingen." />
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="LagreFdvForside">Lagre forside</button>
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="save-success">@_savedMessage</span>
                }
            </div>

            <div class="fdv-vedlegg-section">
                <h3>Ekstra PDF-vedlegg</h3>
                <p class="section-hint">Legg til en PDF (f.eks. for en vare uten registrert FDV) som blir med når du genererer FDV for prosjektet.</p>

                @if (_fdvVedlegg.Count > 0)
                {
                    <ul class="vedlegg-list">
                        @foreach (var v in _fdvVedlegg)
                        {
                            <li @key="v.Id" class="vedlegg-item">
                                <span>@v.Navn</span>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveFdvVedlegg(v))">Fjern</button>
                            </li>
                        }
                    </ul>
                }

                <div class="vedlegg-upload">
                    <InputFile OnChange="OnFdvVedleggSelected" accept="application/pdf" multiple />
                </div>
                @if (_uploadingFdvVedlegg)
                {
                    <p class="list-empty">Laster opp...</p>
