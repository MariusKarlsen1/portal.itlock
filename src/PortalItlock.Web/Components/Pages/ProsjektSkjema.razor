    private sealed record VedleggMappeGruppe(int? MappeId, string Navn, List<ProsjektVedlegg> Filer);

    private List<VedleggMappeGruppe> VedleggGruppert
    {
        get
        {
            var grupper = _mapper
                .OrderBy(m => m.Sortering).ThenBy(m => m.Navn)
                .Select(m => new VedleggMappeGruppe(m.Id, m.Navn, _vedlegg.Where(v => v.MappeId == m.Id).OrderByDescending(v => v.OpprettetDato).ToList()))
                .ToList();

            grupper.Add(new VedleggMappeGruppe(null, "Ukategorisert", _vedlegg.Where(v => v.MappeId == null).OrderByDescending(v => v.OpprettetDato).ToList()));
            return grupper;
        }
    }

    // Ukategorisert vises kun på forsiden når den faktisk inneholder filer -
    // den skal ikke være en mappe man "oppretter"/ser tom, bare et sted filer
    // havner inntil de sorteres i en ekte mappe.
    private List<VedleggMappeGruppe> SynligeVedleggMapper
    {
        get
        {
            var synlige = VedleggGruppert.Where(g => g.MappeId.HasValue || g.Filer.Count > 0);
            if (!string.IsNullOrWhiteSpace(_vedleggSok))
            {
                var sok = _vedleggSok.Trim();
                synlige = synlige.Where(g => g.Navn.Contains(sok, StringComparison.OrdinalIgnoreCase)
                    || g.Filer.Any(f => f.Filnavn.Contains(sok, StringComparison.OrdinalIgnoreCase)));
            }
            return synlige.ToList();
        }
    }

    private List<KoblingsSkjema> SynligeKoblingsskjemaer =>
        string.IsNullOrWhiteSpace(_vedleggSok)
            ? _koblingsskjemaer
            : _koblingsskjemaer.Where(k => k.Navn.Contains(_vedleggSok.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private static string FilIkon(string contentType) => contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? "image" : "file-text";

