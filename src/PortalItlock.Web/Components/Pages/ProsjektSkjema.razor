@page "/prosjekter/ny"
@page "/prosjekter/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using SkiaSharp
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject FdvPdfService FdvPdfService
@inject DorBeslagslistePdfService BeslagslistePdfService
@inject LagretPdfService LagretPdfService
@inject TilbudSyncService TilbudSync
@inject PostnummerService Postnummer
@inject MobilVerktoylinjeService Verktoylinje
@inject VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</PageTitle>

@if (_ingenTilgang)
{
    <p class="form-error">Du har ikke tilgang til dette prosjektet.</p>
}
else if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else
{
    @if (Id.HasValue && _form.Status == ProsjektStatus.Serviceavtale)
    {
        <a class="back-link" href="@($"/serviceavtaler/{Id}")">&larr; Til serviceavtalen</a>
    }

    @* Prosjektkort P6 (oktober 2026): på PC ligger topp, infolinje, faner og
       innhold samlet i ett hvitt kort, som kundekortet. Mobil er uendret. *@
    <div class="pk-kort @(Id.HasValue && !_erMobilvisning ? "pk-kort-aktiv" : "") @(_pkFull && Id.HasValue && !_erMobilvisning ? "pk-full" : "")">
    @if (Id.HasValue && !_erMobilvisning)
    {
        <button type="button" class="pk-utvid" title="@(_pkFull ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslPkFull">
            <Icon Name="@(_pkFull ? "minimize" : "maximize")" />
        </button>
    }
    <div class="prosjekt-header">
        @if (Id.HasValue)
        {
            @* Fremdriftsring - samme tall som "Totalt komplett" på oversikten. *@
            <div class="ph-ring" title="Totalt komplett: @TotalProsent %">
                <svg viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15" class="ph-ring-spor" />
                    <circle cx="18" cy="18" r="15" class="ph-ring-fyll" style="stroke-dasharray:@((TotalProsent * 0.942).ToString(System.Globalization.CultureInfo.InvariantCulture)) 94.2" />
                </svg>
                <b>@TotalProsent%</b>
            </div>
        }
        else
        {
            <span class="prosjekt-header-ikon"><Icon Name="folder" /></span>
        }
        <div class="prosjekt-header-tekst">
            @if (Id.HasValue)
            {
                <div class="ph-smule">
                    <a href="/prosjekter">Prosjekter</a>
                    @if (KundeNavn is not null)
                    {
                        <span>/</span>@KundeNavn
                    }
                    <span>/</span>P-@Id
                </div>
            }
            <h1>
                @(Id.HasValue ? _form.Navn : "Nytt prosjekt")
                @if (Id.HasValue && _form.Status.HasValue)
                {
                    <StatusPill Tekst="@_form.Status.Value.Visningsnavn()" Ikon="@_form.Status.Value.PillIkon()" Farge="@_form.Status.Value.PillFarge()" />
                }
            </h1>
            @if (Id.HasValue && _erMobilvisning)
            {
                <div class="prosjekt-header-meta">
                    @if (KundeNavn is not null)
                    {
                        <span><Icon Name="users" />@KundeNavn</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Adresse))
                    {
                        <span><Icon Name="map" />@_form.Adresse@(string.IsNullOrWhiteSpace(_form.Sted) ? "" : $", {_form.Sted}")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
                    {
                        <span><Icon Name="phone" />@_form.Kontaktperson@(string.IsNullOrWhiteSpace(_form.Telefon) ? "" : $" · {_form.Telefon}")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.System))
                    {
                        <span><Icon Name="lock" />@_form.System</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Tek))
                    {
                        <span><Icon Name="file-text" />@_form.Tek · @_form.Type.Visningsnavn()</span>
                    }
                </div>
            }
        </div>
        @if (Id.HasValue && !_erMobilvisning && KanRedigereProsjekt)
        {
            @* "Ny"-menyen er bare snarveier til fanene der tingene lages. *@
            <div class="ph-handlinger">
                @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                {
                    <a class="ph-knapp" href="@($"tel:{_form.Telefon}")"><Icon Name="phone" />Ring kontakt</a>
                }
                <button type="button" class="ph-knapp @(_activeTab == "oversikt" ? "ph-knapp-aktiv" : "")" @onclick="@(() => { _activeTab = "oversikt"; _visNyMeny = false; })"><Icon Name="file-text" />Rediger</button>
                <button type="button" class="ph-knapp ph-knapp-primar" @onclick="@(() => _visNyMeny = !_visNyMeny)"><Icon Name="plus" />Ny<Icon Name="chevron-down" /></button>
                @if (_visNyMeny)
                {
                    <div class="ph-ny-bakgrunn" @onclick="@(() => _visNyMeny = false)"></div>
                    <div class="ph-ny-liste">
                        <button type="button" @onclick="@(() => VelgFraNyMeny("dorer"))"><Icon Name="door" />Ny dør</button>
                        @if (!SkjulteFaner.Contains("tilbud"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("tilbud"))"><Icon Name="file-text" />Nytt tilbud</button>
                            <button type="button" @onclick="@(() => VelgFraNyMeny("tilbud"))"><Icon Name="file-text" />Endringsmelding / tillegg</button>
                        }
                        <a href="/arbeidsordre"><Icon Name="tool" />Arbeidsordre</a>
                        <button type="button" @onclick="@(() => VelgFraNyMeny("plantegninger"))"><Icon Name="map" />Last opp plantegning</button>
                        @if (!SkjulteFaner.Contains("vedlegg"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("vedlegg"))"><Icon Name="folder" />Vedlegg</button>
                        }
                        @if (!SkjulteFaner.Contains("personer"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("personer"))"><Icon Name="users" />Legg til person</button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Id.HasValue && !_erMobilvisning)
    {
        <div class="pk-infolinje">
            @if (KundeNavn is not null)
            {
                <span><Icon Name="users" />Kunde <b>@KundeNavn</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Adresse))
            {
                <span><Icon Name="map-pin" /><b>@_form.Adresse@(string.IsNullOrWhiteSpace(_form.Sted) ? "" : $", {_form.Sted}")</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
            {
                <span><Icon Name="phone" /><b>@_form.Kontaktperson</b>@(string.IsNullOrWhiteSpace(_form.Telefon) ? "" : $" · {_form.Telefon}")</span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.System))
            {
                <span><Icon Name="lock" /><b>@_form.System</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Tek))
            {
                <span><Icon Name="file-text" /><b>@_form.Tek</b> · @_form.Type.Visningsnavn()</span>
            }
            <span><Icon Name="calendar" />Opprettet <b>@_form.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</b>@if (_form.OverlevertDato is { } ov) {<span> · overlevert <b>@ov.ToString("dd.MM.yyyy")</b></span>}</span>
        </div>
    }

    @if (Id.HasValue)
    {
        @* Fanene står i den rekkefølgen jobben gjøres: oversikt, bygget, salg
           og jobb, dokumentasjon og samarbeid (uten skillestreker). Montører skal ikke se
           Tilbud, Vedlegg, Montering eller Personer - hvilke faner som skjules
           står i ModulRettigheter, ett sted. Prosjektinfo (skjemaet) har ingen
           egen fane - den åpnes med «Rediger»-knappen øverst. *@
        <nav class="prosjekt-tabs">
            <button type="button" class="@TabClass("status")" @onclick="@(() => _activeTab = "status")"><Icon Name="home" />Oversikt</button>
            <button type="button" class="@TabClass("dorer")" @onclick="@(() => _activeTab = "dorer")">Dører<span class="tab-antall">@_dorer.Count</span></button>
            <button type="button" class="@TabClass("plantegninger")" @onclick="@(() => _activeTab = "plantegninger")">Plantegninger<span class="tab-antall">@_plantegninger.Count</span></button>
            <button type="button" class="@TabClass("dorid") mobil-admin-fane" @onclick="@(() => _activeTab = "dorid")">Dør ID<span class="tab-antall">@_dorIdMaler.Count</span></button>
            @if (!SkjulteFaner.Contains("tilbud"))
            {
                <button type="button" class="@TabClass("tilbud") mobil-admin-fane" @onclick="@(() => _activeTab = "tilbud")">Tilbud<span class="tab-antall @(_tilbud.Any(t => t.Status == EndringsmeldingStatus.Godkjent) ? "tab-antall-ok" : "")">@_tilbud.Count</span></button>
            }
            @if (!SkjulteFaner.Contains("montering"))
            {
                <button type="button" class="@TabClass("montering") mobil-admin-fane" @onclick="@(() => _activeTab = "montering")">Montering</button>
            }
            <button type="button" class="@TabClass("avvik")" @onclick="@(() => _activeTab = "avvik")">Avvik @if (_prosjektAvvik.Any(a => a.Status == AvvikStatus.Apent)) {<span class="tab-antall tab-antall-rod">@_prosjektAvvik.Count(a => a.Status == AvvikStatus.Apent)</span>}</button>
            <button type="button" class="@TabClass("fdv") mobil-admin-fane" @onclick="@(() => _activeTab = "fdv")">FDV</button>
            <button type="button" class="@TabClass("beslagsliste") mobil-admin-fane" @onclick="@(() => _activeTab = "beslagsliste")">Beslagsliste</button>
            <button type="button" class="@TabClass("lasplan") mobil-admin-fane" @onclick="@(() => _activeTab = "lasplan")">Låsplan</button>
            @if (!SkjulteFaner.Contains("personer"))
            {
                <button type="button" class="@TabClass("personer") mobil-admin-fane" @onclick="@(() => _activeTab = "personer")">Personer<span class="tab-antall">@_form.Medlemmer.Count</span></button>
            }
            @if (!SkjulteFaner.Contains("vedlegg"))
            {
                <button type="button" class="@TabClass("vedlegg") mobil-admin-fane" @onclick="@(() => _activeTab = "vedlegg")">Vedlegg</button>
            }
        </nav>
    }

    <div class="pk-innhold">

    @if (!Id.HasValue || _activeTab == "oversikt")
    {
        <div class="prosjekt-layout">
            <section class="prosjekt-section">
                <h2>Prosjektinformasjon</h2>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Grunnleggende</p>
                    <div class="field-grid">
                        <label class="span-2">
                            Navn
                            <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Lillesand sparebank" disabled="@_erMobilvisning" />
                        </label>
                        <label>
                            Kunde
                            <select @bind="_form.KundeId" @bind:after="KundeEndret" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var k in _kunder)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                        </label>
                        <label>System<input @bind="_form.System" placeholder="F.eks. PXP, iLOQ" disabled="@_erMobilvisning" /></label>
                        <label>
                            Prosjekttype
                            <select @bind="_form.Type" disabled="@_erMobilvisning">
                                @foreach (var t in Enum.GetValues<ProsjektType>())
                                {
                                    <option value="@t">@t.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                        <label>
                            Status
                            <select @bind="_form.Status" @bind:after="OnStatusEndret" disabled="@_erMobilvisning">
                                <option value="">Velg status...</option>
                                @foreach (var s in Enum.GetValues<ProsjektStatus>().Where(s => s != ProsjektStatus.Avsluttet))
                                {
                                    <option value="@s">@s.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                        @if (_form.Status == ProsjektStatus.Overlevert || _form.OverlevertDato.HasValue)
                        {
                            <label>
                                Overlevert dato
                                <input type="date" value="@_form.OverlevertDato?.ToString("yyyy-MM-dd")"
                                       @onchange="@(e => _form.OverlevertDato = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" disabled="@_erMobilvisning" />
                            </label>
                        }
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Adresse og kontakt</p>
                    <div class="field-grid">
                        <label>Adresse<AdresseFelt @bind-Value="_form.Adresse" Valgt="VelgProsjektAdresse" Disabled="@_erMobilvisning" /></label>
                        <label>Post nr<input @bind="_form.Postnr" @bind:after="OppdaterStedFraPostnr" disabled="@_erMobilvisning" /></label>
                        <label>Sted<input @bind="_form.Sted" @bind:after="OppdaterPostnrFraSted" disabled="@_erMobilvisning" /></label>
                        @if (_kontakter.Count > 0 && !_annenKontakt)
                        {
                            <label>
                                Kontaktperson
                                <select value="@(_form.Kontaktperson ?? "")" @onchange="VelgKontakt" disabled="@_erMobilvisning">
                                    <option value="">Velg kontaktperson</option>
                                    @foreach (var k in _kontakter)
                                    {
                                        <option value="@k.Navn">@k.Navn@(string.IsNullOrWhiteSpace(k.Rolle) ? "" : $" ({k.Rolle})")</option>
                                    }
                                    <option value="__annen">Annen person …</option>
                                </select>
                            </label>
                        }
                        else
                        {
                            <label>
                                Kontaktperson
                                <input @bind="_form.Kontaktperson" disabled="@_erMobilvisning" />
                                @if (_kontakter.Count > 0 && !_erMobilvisning)
                                {
                                    <button type="button" style="align-self:flex-start;margin-top:4px;padding:0;border:0;background:none;color:var(--accent, #2563eb);font-size:.8rem;cursor:pointer" @onclick="() => _annenKontakt = false">Velg fra kunden</button>
                                }
                            </label>
                        }
                        <label>Telefon<input @bind="_form.Telefon" disabled="@_erMobilvisning" /></label>
                        <label>E-post<input @bind="_form.Epost" disabled="@_erMobilvisning" /></label>
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">CE-klassifisering</p>
                    <div class="field-grid">
                        <label>
                            Byggeregelverk (TEK)
                            <select @bind="_form.Tek" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var t in CeAlternativer.TekVersjoner)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </label>
                        <label>
                            Byggkategori (CE)
                            <select @bind="_form.Byggkategori" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var k in CeAlternativer.Byggkategorier)
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </label>
                        <label>
                            Risikoklasse (CE)
                            <select @bind="_form.Risikoklasse" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var r in CeAlternativer.Risikoklasser)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </label>
                        <label>
                            CE-gyldighet (standard)
                            <select @bind="_form.CeGyldighetMåneder" disabled="@_erMobilvisning">
                                @foreach (var m in CeAlternativer.GyldighetMånederAlternativer)
                                {
                                    <option value="@m">@m måneder</option>
                                }
                            </select>
                        </label>
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Notater</p>
                    <div class="field-grid">
                        <label class="span-2">
                            Interne notater
                            <textarea rows="3" @bind="_form.Notater" @bind:after="AutoLagre" disabled="@(_erMobilvisning || !KanRedigereProsjekt)"></textarea>
                        </label>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <p class="save-success">@_savedMessage</p>
            }

            <div class="form-actions">
                @if (KanRedigereProsjekt)
                {
                    <button type="button" class="save-button" @onclick="Lagre">
                        @(Id.HasValue ? "Lagre endringer" : "Lagre prosjekt")
                    </button>
                }
            </div>

            @* Sletting står i en egen boks nederst, langt unna Lagre, så den
               ikke trykkes ved et uhell. *@
            @if (Id.HasValue && !_erMobilvisning && KanRedigereProsjekt)
            {
                <div class="faresone">
                    <div class="faresone-tekst">
                        <strong>Slett prosjekt</strong>
                        <span>Sletter prosjektet med dører og plantegninger. Kan ikke angres.</span>
                    </div>
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker? Dette sletter også dører og plantegninger i prosjektet.
                            <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett prosjekt</button>
                    }
                </div>
            }
        </div>
    }
    else if (_activeTab == "status")
    {
        <div class="prosjekt-layout @(_erMobilvisning ? "" : "dashbord-layout")">
            @if (_erMobilvisning)
            {
                <div class="fullforing-boks">
                    <div class="fullforing-header">
                        <Icon Name="check-circle" />
                        <span class="status-label">Fullføringsgrad</span>
                    </div>
                    <div class="fremdrift-rad">
                        <span class="fremdrift-navn">Timer ferdig</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(TidsProsent)%"></div></div>
                        <span class="fremdrift-prosent">@TidsProsent%</span>
                    </div>
                    <div class="fremdrift-rad">
                        <span class="fremdrift-navn">Beslag montert</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(BeslagProsent)%"></div></div>
                        <span class="fremdrift-prosent">@BeslagProsent%</span>
                    </div>
                    <div class="fremdrift-rad fremdrift-rad-total">
                        <span class="fremdrift-navn">Totalt komplett</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(TotalProsent)%"></div></div>
                        <span class="fremdrift-prosent">@TotalProsent%</span>
                    </div>
                </div>
                <div class="mobil-status-kort">
                    <div class="mobil-status-rad">
                        <Icon Name="clock" />
                        <span class="mobil-status-label">Kalkulert tid</span>
                        <span class="mobil-status-verdi">@FormatTid(KalkulertMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="tool" />
                        <span class="mobil-status-label">Tidsforbruk</span>
                        <span class="mobil-status-verdi">@FormatTid(BruktMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="calendar" />
                        <span class="mobil-status-label">Gjenværende</span>
                        <span class="mobil-status-verdi">@FormatTid(GjenstaendeMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="trend-up" />
                        <span class="mobil-status-label">Fremdrift</span>
                        <span class="mobil-status-verdi">@AntallBeslagMontert/@AntallBeslagTotalt beslag</span>
                    </div>
                </div>
            }
            else
            {
                @* ---------- Oversikt (skrivebord) ----------
                   Nøkkeltall, plantegning, arbeidsordre og aktivitet - alt er lesevisning med lenker videre til
                   fanene, der selve arbeidet gjøres som før. *@
                <div class="ov-kpi">
                    <div>
                        <small><span class="ov-kpi-ik ov-kpi-ik-gronn"><Icon Name="check-circle" /></span>Totalt komplett</small>
                        <b>@TotalProsent %</b>
                        <span>timer og beslag samlet</span>
                        <span class="ov-bar"><i class="ov-bar-gronn" style="width:@(TotalProsent)%"></i></span>
                    </div>
                    <div>
                        <small><span class="ov-kpi-ik ov-kpi-ik-brun"><Icon Name="lock" /></span>Beslag montert</small>
                        <b>@AntallBeslagMontert / @AntallBeslagTotalt</b>
                        <span>@BeslagProsent %</span>
                        <span class="ov-bar"><i class="ov-bar-brun" style="width:@(BeslagProsent)%"></i></span>
                    </div>
                    <div>
                        <small><span class="ov-kpi-ik ov-kpi-ik-bla"><Icon Name="clock" /></span>Montasjetid</small>
                        <b>@KortTid(BruktMontasjeMinutter)</b>
                        <span>brukt av @KortTid(KalkulertMontasjeMinutter) · @KortTid(GjenstaendeMontasjeMinutter) igjen</span>
                        <span class="ov-bar"><i class="ov-bar-bla" style="width:@(TidsProsent)%"></i></span>
                    </div>
                    <div>
                        <small><span class="ov-kpi-ik ov-kpi-ik-gul"><Icon Name="file-text" /></span>Tilbud</small>
                        @if (TilbudAntallGodkjent > 0)
                        {
                            <b>@TilbudSumGodkjent.ToString("N0", NorskKultur)</b>
                            <span>kr · @(TilbudAntallGodkjent == 1 ? "godkjent" : $"{TilbudAntallGodkjent} tilbud godkjent")</span>
                            <span class="ov-bar"><i class="ov-bar-gul" style="width:100%"></i></span>
                        }
                        else if (HovedTilbud is { } ht)
                        {
                            <b>@(ht.SendtSum.HasValue ? ht.SendtSum.Value.ToString("N0", NorskKultur) : ht.Status.Visningsnavn())</b>
                            <span>@(ht.SendtSum.HasValue ? "kr · " : "")@ht.Status.Visningsnavn().ToLowerInvariant()</span>
                            <span class="ov-bar"><i class="ov-bar-gul" style="width:@(ht.Status == EndringsmeldingStatus.Godkjent ? 100 : ht.Status == EndringsmeldingStatus.SendtTilKunde ? 60 : 25)%"></i></span>
                        }
                        else
                        {
                            <b>–</b>
                            <span>ikke laget ennå</span>
                            <span class="ov-bar"><i class="ov-bar-gul" style="width:0%"></i></span>
                        }
                    </div>
                </div>

                <div class="ov-grid">
                    <div class="ov-kol">
                        @if (OversiktTegning is { } tegning)
                        {
                            var ferdig = AntallDorer(MontasjeStatus.FerdigMontert);
                            var pagar = AntallDorer(MontasjeStatus.Montert);
                            var ikke = AntallDorer(MontasjeStatus.IkkeStartet);
                            var tegninger = OversiktTegninger;
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3><Icon Name="map" />@(tegninger.Count > 1 ? "Tegninger" : tegning.Navn)</h3>
                                    <div class="ov-forklaring">
                                        <span><i class="ov-s-ferdig"></i>Ferdig @ferdig</span>
                                        <span><i class="ov-s-pagar"></i>Pågår @pagar</span>
                                        <span><i class="ov-s-ikke"></i>Ikke startet @ikke</span>
                                        <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "plantegninger")">Alle tegninger →</button>
                                    </div>
                                </div>
                                @if (tegninger.Count > 1)
                                {
                                    @* P1: én knapp per tegning - den med sist aktivitet vises først. *@
                                    <div class="ov-tegnvalg">
                                        @foreach (var (t, sist) in tegninger)
                                        {
                                            <button type="button" class="@(t.Id == tegning.Id ? "pa" : "")" @onclick="@(() => _oversiktTegningId = t.Id)">
                                                @t.Navn<small>· @AktivitetTidTekst(sist).ToLowerInvariant()</small>
                                            </button>
                                        }
                                    </div>
                                }
                                @* Pinnene ligger i samme boks som bildet (ov-plan-flate), så prosentene
                                   treffer tegningen også når den skaleres ned. *@
                                <div class="ov-plan" data-hjulzoom>
                                    <div class="ov-plan-flate" data-hjulzoom-flate>
                                    <img src="@($"/plantegningbilde/{tegning.Id}")" alt="@tegning.Navn" loading="lazy" />
                                    @foreach (var d in _dorer.Where(d => d.PlantegningId == tegning.Id && d.PosX.HasValue && d.PosY.HasValue))
                                    {
                                        var dorKlasse = d.Status switch { MontasjeStatus.FerdigMontert => "ferdig", MontasjeStatus.Montert => "pagar", _ => "ikke" };
                                        <button type="button" class="ov-pin" title="@($"{d.Dornummer} · {d.Status.Visningsnavn()}")"
                                                style="left:@(d.PosX!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(d.PosY!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                                                @onclick="@(() => TilDor(d))">
                                            <i class="ov-s-@dorKlasse"></i><span>@d.Dornummer</span>
                                        </button>
                                    }
                                    </div>
                                </div>
                            </section>
                        }
                        else
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3><Icon Name="door" />Dørene</h3>
                                    <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "dorer")">Åpne dørlisten →</button>
                                </div>
                                @if (_dorer.Count == 0)
                                {
                                    <p class="ov-tom">Ingen dører registrert ennå.</p>
                                }
                                else
                                {
                                    <div class="ov-dorer">
                                        @foreach (var d in _dorer.OrderBy(d => d.Dornummer).Take(24))
                                        {
                                            var dorKlasse = d.Status switch { MontasjeStatus.FerdigMontert => "ferdig", MontasjeStatus.Montert => "pagar", _ => "ikke" };
                                            <button type="button" class="ov-dor ov-dor-@dorKlasse" title="@($"{d.Dornummer} · {d.Status.Visningsnavn()}")" @onclick="@(() => TilDor(d))">
                                                @d.Dornummer
                                                <small>@(d.Romnr ?? d.Etasje ?? "")</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </section>
                        }

                        <section class="ov-kort">
                            <div class="ov-kort-topp">
                                <h3><Icon Name="tool" /><span>Arbeidsordre på prosjektet</span>@if (_prosjektOrdre.Count > 0) {<span class="ov-teller">@_prosjektOrdre.Count</span>}</h3>
                                <button type="button" class="ov-lenke" style="border:0;background:none;cursor:pointer;font:inherit" @onclick="NyArbeidsordrePaProsjekt">+ Ny arbeidsordre</button>
                            </div>
                            @if (_prosjektOrdre.Count == 0)
                            {
                                <p class="ov-tom">Ingen arbeidsordre på prosjektet ennå.</p>
                            }
                            else
                            {
                                <div class="ov-liste">
                                    @foreach (var a in _visAlleOrdre ? _prosjektOrdre : _prosjektOrdre.Take(3))
                                    {
                                        var st = OrdreStatus(a.Status);
                                        var under = string.Join(" · ", new[] { $"AO-{a.Id}", a.AnsvarligMontor?.Navn, a.PlanlagtDato?.ToString("d. MMM", NorskKultur) }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                        <div class="ov-rad">
                                            <span class="ov-rad-ikon @st.Klasse"><Icon Name="@(a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert ? "check" : a.Status == ArbeidsordreStatus.Pagaende ? "tool" : "calendar")" /></span>
                                            <span class="ov-rad-tekst"><b>@a.Tittel</b><span>@under</span></span>
                                            <span class="ov-rad-hoyre">
                                                <span class="ov-chip @st.Klasse">@(a.Status == ArbeidsordreStatus.Pagaende ? "● " : "")@st.Tekst</span>
                                                <a class="ph-knapp ph-knapp-liten" href="@($"/arbeidsordre/{a.Id}")">Åpne</a>
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (_prosjektOrdre.Count > 3)
                                {
                                    <div class="ov-flere"><button type="button" @onclick="@(() => _visAlleOrdre = !_visAlleOrdre)">@(_visAlleOrdre ? "Vis færre" : $"Vis alle {_prosjektOrdre.Count} arbeidsordre")</button></div>
                                }
                            }
                        </section>

                        @if (SisteAktivitet.Count > 0)
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp"><h3><Icon Name="clock" />Siste aktivitet<span class="ov-teller">@SisteAktivitet.Count</span></h3></div>
                                <div class="ov-liste">
                                    @foreach (var a in _visAlleAktivitet ? SisteAktivitet : SisteAktivitet.Take(5))
                                    {
                                        var (ikon, klasse) = AktivitetIkon(a.Tekst);
                                        <div class="ov-rad">
                                            <span class="ov-rad-ikon @klasse"><Icon Name="@ikon" /></span>
                                            <span class="ov-rad-tekst"><b>@a.Tekst</b></span>
                                            <span class="ov-tid">@AktivitetTidTekst(a.Dato)</span>
                                        </div>
                                    }
                                </div>
                                @if (SisteAktivitet.Count > 5)
                                {
                                    <div class="ov-flere"><button type="button" @onclick="@(() => _visAlleAktivitet = !_visAlleAktivitet)">@(_visAlleAktivitet ? "Vis færre" : $"Vis {SisteAktivitet.Count - 5} eldre hendelser")</button></div>
                                }
                            </section>
                        }
                    </div>

                    <div class="ov-kol">
                        <section class="ov-kort">
                            <div class="ov-kort-topp">
                                <h3>Prosjektinfo</h3>
                                <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "oversikt")">@(KanRedigereProsjekt ? "Rediger" : "Vis alt")</button>
                            </div>
                            @* P1: kunde og kontakt øverst (kunden som lenke, Ring-knapp), tekniske felt som små bokser. *@
                            <div class="ov-pki">
                                <h4>Kunde og kontakt</h4>
                                <div class="ov-pki-rad">
                                    <i><Icon Name="building" /></i>
                                    <span>
                                        <small>Kunde</small>
                                        @if (_form.KundeId is int kundeId && KundeNavn is not null)
                                        {
                                            <b><a href="@($"/kunder/{kundeId}")">@KundeNavn</a></b>
                                        }
                                        else
                                        {
                                            <b class="ov-pki-tom">Ikke satt</b>
                                        }
                                    </span>
                                </div>
                                <div class="ov-pki-rad">
                                    <i><Icon Name="users" /></i>
                                    <span>
                                        <small>Kontaktperson</small>
                                        <b class="@(string.IsNullOrWhiteSpace(_form.Kontaktperson) ? "ov-pki-tom" : "")">@(string.IsNullOrWhiteSpace(_form.Kontaktperson) ? "Ikke satt" : _form.Kontaktperson)</b>
                                        @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                                        {
                                            <small>@_form.Telefon</small>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                                    {
                                        <a class="ov-pki-kn" href="@($"tel:{_form.Telefon}")"><Icon Name="phone" />Ring</a>
                                    }
                                </div>
                                <h4>Teknisk</h4>
                                <div class="ov-pki-bokser">
                                    @foreach (var (navn, verdi) in new[] { ("System", _form.System), ("Regelverk", _form.Tek), ("Byggkategori", _form.Byggkategori), ("Risikoklasse", _form.Risikoklasse) })
                                    {
                                        <div class="@(string.IsNullOrWhiteSpace(verdi) ? "ov-pki-tom" : "")"><small>@navn</small><b>@(string.IsNullOrWhiteSpace(verdi) ? "Ikke satt" : verdi)</b></div>
                                    }
                                </div>
                            </div>
                        </section>

                        <section class="ov-kort">
                            <div class="ov-kort-topp"><h3>Dokumentasjon</h3></div>
                            <div class="ov-liste">
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-gronn"><Icon Name="folder" /></span>
                                    <span class="ov-rad-tekst"><b>FDV</b><span>@(_lagredeFdvPdfer.Count > 0 ? $"{_lagredeFdvPdfer.Count} lagret" : "Ikke laget ennå")</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "fdv")">Lag</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-brun"><Icon Name="dokument-linjer" /></span>
                                    <span class="ov-rad-tekst"><b>Beslagsliste</b><span>@AntallBeslagTotalt beslag · @_dorer.Count dører</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "beslagsliste")">Lag</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-bla"><Icon Name="lock" /></span>
                                    <span class="ov-rad-tekst"><b>Låsplan</b><span>Sylindre og nøkler</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "lasplan")">Åpne</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon @(AntallBrannavvik > 0 ? "os-rod" : "os-gronn")"><Icon Name="alert-triangle" /></span>
                                    <span class="ov-rad-tekst"><b>Brannkontroll</b><span>@(AntallBrannavvik > 0 ? $"{AntallBrannavvik} avvik å se på" : "Ingen avvik")</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "dorer")">Se</button>
                                </div>
                            </div>
                        </section>

                        @if (_form.Medlemmer.Count > 0)
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3>Personer<span class="ov-teller">@_form.Medlemmer.Count</span></h3>
                                    @if (!SkjulteFaner.Contains("personer"))
                                    {
                                        <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "personer")">Alle →</button>
                                    }
                                </div>
                                <div class="ov-personer">
                                    @foreach (var m in _form.Medlemmer.OrderByDescending(m => m.Id == _form.ProsjektlederId).ThenByDescending(m => m.Id == _form.AnsvarligMontorId).Take(_visAllePersoner ? int.MaxValue : 4))
                                    {
                                        var rolleTekst = m.Id == _form.ProsjektlederId ? "Prosjektleder" : m.Id == _form.AnsvarligMontorId ? "Ansvarlig montør" : m.Rolle.Visningsnavn();
                                        <div class="ov-person">
                                            <span class="ov-avatar" style="background:@AvatarFarge(m.Navn)">@Initialer(m.Navn)</span>
                                            <span>@m.Navn<small>@rolleTekst</small></span>
                                        </div>
                                    }
                                </div>
                                @if (_form.Medlemmer.Count > 4)
                                {
                                    <div class="ov-flere"><button type="button" @onclick="@(() => _visAllePersoner = !_visAllePersoner)">@(_visAllePersoner ? "Vis færre" : $"Vis alle {_form.Medlemmer.Count} personer")</button></div>
                                }
                            </section>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "dorer")
    {
        <div class="dorer-layout">
            <div class="dorer-list-wrap p5-dorer">
                @if (!_erMobilvisning)
                {
                    @* P6: søk, statusknapper og knappene på én linje over tabellen. *@
                    <div class="p5-topp">
                        <label class="p5-sok"><Icon Name="search" /><input @bind="_dorSok" @bind:event="oninput" placeholder="Søk dørnummer, rom …" /></label>
                        <span class="dx-seg">
                            <button type="button" class="p5-chip @(DorChip == "" ? "pa" : "")" @onclick='@(() => VelgDorChip(""))'>Alle <em>@_dorer.Count</em></button>
                            <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.FerdigMontert) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.FerdigMontert)))">Ferdig <em>@AntallDorer(MontasjeStatus.FerdigMontert)</em></button>
                            <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.Montert) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.Montert)))">Pågår <em>@AntallDorer(MontasjeStatus.Montert)</em></button>
                            <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.IkkeStartet) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.IkkeStartet)))">Ikke startet <em>@AntallDorer(MontasjeStatus.IkkeStartet)</em></button>
                        </span>
                        <button type="button" class="p5-chip dx-brannchip @(DorChip == "brann" ? "pa" : "")" @onclick='@(() => VelgDorChip("brann"))'>Branndører <em>@_dorer.Count(d => !string.IsNullOrWhiteSpace(d.Brann))</em></button>
                        @if (DistinkteEtasjer.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorEtasjeFilter">
                                <option value="">Alle etasjer</option>
                                @foreach (var etasje in DistinkteEtasjer)
                                {
                                    <option value="@etasje">@etasje</option>
                                }
                            </select>
                        }
                        @if (DistinkteSoner.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorSoneFilter">
                                <option value="">Alle soner</option>
                                @foreach (var sone in DistinkteSoner)
                                {
                                    <option value="@sone">@sone</option>
                                }
                            </select>
                        }
                        @if (DistinkteByggetrinn.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorByggetrinnFilter">
                                <option value="">Alle byggetrinn</option>
                                @foreach (var bt in DistinkteByggetrinn)
                                {
                                    <option value="@bt">@bt</option>
                                }
                            </select>
                        }
                        <span class="dx-gruppe">
                            @if (_dorer.Count > 0)
                            {
                                @* K3: Brannkontroll, Bytt komponent og status på flere dører samlet i én meny. *@
                                <span class="dx-nedtrekk">
                                    <button type="button" class="ph-knapp ph-knapp-liten @(_visRedigerMeny ? "dx-pa" : "")" @onclick="@(() => _visRedigerMeny = !_visRedigerMeny)"><Icon Name="edit" />Rediger dører<span class="dx-pil"><Icon Name="chevron-down" /></span></button>
                                    @if (_visRedigerMeny)
                                    {
                                        <div class="dx-meny-bakgrunn" @onclick="@(() => _visRedigerMeny = false)"></div>
                                        <div class="dx-meny">
                                            <button type="button" @onclick='@(() => ApneDorPanel("brann"))'>
                                                <span class="dx-mi dx-mi-rod"><Icon Name="alert-triangle" /></span>
                                                <span><b>Brannkontroll @if (AntallBrannavvik > 0) {<span class="dx-tall">@AntallBrannavvik</span>}</b><small>Sjekk brannklasse mot beslag, lukker og rømning</small></span>
                                            </button>
                                            <button type="button" @onclick='@(() => ApneDorPanel("bytt"))'>
                                                <span class="dx-mi dx-mi-bla"><Icon Name="refresh" /></span>
                                                <span><b>Bytt komponent</b><small>Bytt en del på flere dører samtidig</small></span>
                                            </button>
                                            @if (ModulRettigheter.KanSetteMontertStatus(_naverendeRolle))
                                            {
                                                <hr />
                                                <button type="button" @onclick='@(() => ApneDorPanel("status"))'>
                                                    <span class="dx-mi dx-mi-gronn"><Icon Name="check-circle" /></span>
                                                    <span><b>Sett status på flere</b><small>Huk av dørene i listen først</small></span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </span>
                            }
                            <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="LeggTilDor"><Icon Name="plus" />Legg til dør</button>
                            <button type="button" class="ph-knapp ph-knapp-liten" title="Importer dørskjema" @onclick="@(() => _visDorImport = true)">Importer</button>
                        </span>
                    </div>

                    @if (_valgteDorer.Count > 0)
                    {
                        <div class="dx-handling">
                            <b>@_valgteDorer.Count @(_valgteDorer.Count == 1 ? "dør" : "dører") valgt</b>
                            <button type="button" @onclick='@(() => ApneDorPanel("bytt"))'><Icon Name="refresh" />Bytt komponent</button>
                            @if (ModulRettigheter.KanSetteMontertStatus(_naverendeRolle))
                            {
                                <button type="button" @onclick='@(() => ApneDorPanel("status"))'><Icon Name="check-circle" />Sett status</button>
                            }
                            <button type="button" @onclick="@(() => _activeTab = "dorid")"><Icon Name="printer" />Skriv ut dør-ID</button>
                            <button type="button" class="dx-handling-brann" @onclick='@(() => ApneDorPanel("brann"))'><Icon Name="alert-triangle" />Brannkontroll</button>
                            <button type="button" class="dx-handling-fjern" @onclick="@(() => _valgteDorer.Clear())">Fjern valg</button>
                        </div>
                    }
                    @if (_dorKunBrannavvik)
                    {
                        <div class="dx-filterinfo"><Icon Name="alert-triangle" />Viser bare dører med brannavvik.<button type="button" @onclick="@(() => _dorKunBrannavvik = false)">Vis alle dører</button></div>
                    }
                }

                @if (_dorPanel is not null && !_erMobilvisning)
                {
                    @* K3: Brannkontroll, Bytt komponent og Sett status i et panel fra høyre. *@
                    <div class="dx-bakteppe" @onclick="LukkDorPanel"></div>
                    <aside class="dx-panel">
                        <div class="dx-panel-topp">
                            @if (_dorPanel == "brann")
                            {
                                <span class="dx-mi dx-mi-rod"><Icon Name="alert-triangle" /></span>
                                <span><b>Brannkontroll</b><small>Brannklasse mot beslag · @(AntallBrannavvik > 0 ? $"{AntallBrannavvik} avvik" : "ingen avvik")</small></span>
                            }
                            else if (_dorPanel == "bytt")
                            {
                                <span class="dx-mi dx-mi-bla"><Icon Name="refresh" /></span>
                                <span><b>Bytt komponent</b><small>På flere dører samtidig</small></span>
                            }
                            else
                            {
                                <span class="dx-mi dx-mi-gronn"><Icon Name="check-circle" /></span>
                                <span><b>Sett status</b><small>@(_valgteDorer.Count > 0 ? $"{_valgteDorer.Count} dører valgt" : "Ingen dører valgt")</small></span>
                            }
                            <button type="button" class="dx-lukk" title="Lukk" @onclick="LukkDorPanel"><Icon Name="x" /></button>
                        </div>
                        <div class="dx-panel-inn">
                            @if (_dorPanel == "brann")
                            {
                            <p class="section-hint">
                                Sjekker at branndører har lukker, og at rømningsdører og automatikk har riktig beslag.
                                En påminnelse, ikke en godkjenning. <a href="/guide/regelverk" target="_blank">Les mer</a>
                            </p>

                            @if (AntallBrannavvik == 0)
                            {
                                <p class="brannkontroll-ok"><Icon Name="check-circle" />Ingen avvik funnet i brannklasse/lukkefunksjon.</p>
                            }
                            else
                            {
                                @if (DorerManglerLukker.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Selvlukkende krav (C) uten lukkefunksjon (@DorerManglerLukker.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in DorerManglerLukker)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => { LukkDorPanel(); SelectDoor(d); })">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (RomningsveiManglerAutomatikk.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Rømningsvei med selvlukkende krav (C), men uten dørautomatikk - maks åpningskraft (@RomningsveiManglerAutomatikk.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in RomningsveiManglerAutomatikk)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => { LukkDorPanel(); SelectDoor(d); })">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (AutomatikkManglerSensor.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Dørautomatikk uten sikkerhetssensor (@AutomatikkManglerSensor.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in AutomatikkManglerSensor)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => { LukkDorPanel(); SelectDoor(d); })">@d.Dornummer</button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (SonerMedUliktBrannkrav.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Ulik brannklasse innad i samme sone</p>
                                        @foreach (var sone in SonerMedUliktBrannkrav)
                                        {
                                            <div class="brannkontroll-sone">
                                                <span class="brannkontroll-sone-navn">Sone @sone.Sone</span>
                                                <div class="brannkontroll-liste">
                                                    @foreach (var d in sone.Dorer)
                                                    {
                                                        <button type="button" class="brannkontroll-chip" @onclick="@(() => { LukkDorPanel(); SelectDoor(d); })">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            }
                            else if (_dorPanel == "bytt")
                            {
                        <p class="section-hint">
                            Velg delen, dørene og den nye delen. Den nye delen står som ikke montert.
                        </p>

                        <div class="bytt-komponent-felt">
                            <select @bind="_byttGammelComponentId" @bind:after="OnByttGammelChanged">
                                <option value="">Velg komponent å bytte ut...</option>
                                @foreach (var k in KomponenterIBruk)
                                {
                                    <option value="@k.ComponentId">@k.Navn (@k.AntallDorer dør(er))</option>
                                }
                            </select>

                            <div class="bytt-sok-wrap">
                                <input @bind="_byttSok" @bind:event="oninput" @bind:after="OnByttSokChanged"
                                       placeholder="Bytt med – søk i komponentregisteret (navn, leverandør, produktkode)..." disabled="@(_byttGammelComponentId is null)" />
                                @if (_byttSearchResults.Count > 0)
                                {
                                    <ul class="search-results">
                                        @foreach (var r in _byttSearchResults)
                                        {
                                            <li>
                                                <button type="button" class="search-result" @onclick="@(() => VelgNyKomponent(r))">
                                                    <span class="search-result-name">@r.Navn</span>
                                                    <span class="search-result-meta">@r.Leverandor</span>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (_byttSok.Trim().Length >= 2)
                                {
                                    <span class="bytt-ingen-treff">Ingen treff i komponentregisteret.</span>
                                }
                            </div>
                        </div>

                        @if (_byttGammelComponentId is not null)
                        {
                            var dorerMedGammel = _dorer.Where(d => d.Komponenter.Any(dk => dk.ComponentId == _byttGammelComponentId)).OrderBy(d => d.Dornummer).ToList();
                            <div class="bytt-dorvalg">
                                <div class="bytt-dorvalg-topp">
                                    <strong>Velg dører</strong>
                                    <span class="bytt-dorvalg-antall">@_byttValgteDorer.Count av @dorerMedGammel.Count valgt</span>
                                    <button type="button" class="bytt-dorvalg-lenke" @onclick="@(() => { _byttValgteDorer = dorerMedGammel.Select(d => d.Id).ToHashSet(); _confirmingBytte = false; })">Alle</button>
                                    <button type="button" class="bytt-dorvalg-lenke" @onclick="@(() => { _byttValgteDorer.Clear(); _confirmingBytte = false; })">Ingen</button>
                                </div>
                                <div class="bytt-dorvalg-liste">
                                    @foreach (var d in dorerMedGammel)
                                    {
                                        var valgt = _byttValgteDorer.Contains(d.Id);
                                        <label @key="d.Id" class="bytt-dor @(valgt ? "valgt" : "")">
                                            <input type="checkbox" checked="@valgt" @onchange="@(() => { if (!_byttValgteDorer.Remove(d.Id)) _byttValgteDorer.Add(d.Id); _confirmingBytte = false; })" />
                                            <b>@d.Dornummer</b>
                                            @if (!string.IsNullOrWhiteSpace(d.DorTil))
                                            {
                                                <span>@d.DorTil</span>
                                            }
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        @if (_byttNyKomponentNavn is not null)
                        {
                            <p class="section-hint">Ny komponent: <strong>@_byttNyKomponentNavn</strong></p>

                            @if (!_confirmingBytte)
                            {
                                <button type="button" class="save-button" disabled="@(AntallDorerMedValgtKomponent == 0)" @onclick="@(() => _confirmingBytte = true)">
                                    Bytt ut på @AntallDorerMedValgtKomponent dør(er)
                                </button>
                            }
                            else
                            {
                                <span class="delete-confirm">
                                    Er du sikker? Dette kan ikke angres.
                                    <button type="button" class="delete-confirm-button" @onclick="ByttKomponentOveralt">Ja, bytt ut</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingBytte = false)">Avbryt</button>
                                </span>
                            }
                        }

                        @if (!string.IsNullOrEmpty(_byttMelding))
                        {
                            <p class="save-success">@_byttMelding</p>
                        }
                            }
                            else if (_valgteDorer.Count == 0)
                            {
                                <p class="section-hint">Huk av dørene i listen først, så kan du sette status på alle samtidig.</p>
                            }
                            else
                            {
                                <p class="section-hint">Velg ny status for de @_valgteDorer.Count valgte dørene.</p>
                                <label class="dx-felt">Ny status
                                    <select @bind="_nyDorStatus">
                                        <option value="@MontasjeStatus.FerdigMontert">Ferdig</option>
                                        <option value="@MontasjeStatus.Montert">Pågår</option>
                                        <option value="@MontasjeStatus.IkkeStartet">Ikke startet</option>
                                    </select>
                                </label>
                            }
                        </div>
                        <div class="dx-panel-bunn">
                            <button type="button" class="ph-knapp ph-knapp-liten" @onclick="LukkDorPanel">Lukk</button>
                            @if (_dorPanel == "brann" && AntallBrannavvik > 0)
                            {
                                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="@(() => { _dorKunBrannavvik = true; _dorSide = 1; LukkDorPanel(); })">Vis bare disse dørene</button>
                            }
                            else if (_dorPanel == "status" && _valgteDorer.Count > 0)
                            {
                                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="SettStatusPaValgte">Sett status på @_valgteDorer.Count dører</button>
                            }
                        </div>
                    </aside>
                }

                @if (_dorer.Count == 0)
                {
                    @* Knappene for å legge til / importere står i overskriften. *@
                    <p class="list-empty">Ingen dører registrert ennå.</p>
                }
                else
                {
                    @if (_erMobilvisning)
                    {
                        <div class="dorer-filter-bar">
                            <div class="dorer-filter-bar-venstre">
                            <label class="dorer-sok-felt">
                                <Icon Name="search" />
                                <input class="dorer-filter-sok" @bind="_dorSok" @bind:event="oninput" placeholder="Søk på dørnummer, etasje, sone, rom..." />
                            </label>
                            <select @bind="_dorStatusFilter">
                                <option value="">Alle statuser</option>
                                <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                            </select>
                            </div>
                            <span class="dorer-filter-count">@FiltrerteDorer.Count av @_dorer.Count dører</span>
                        </div>
                    }

                    @if (FiltrerteDorer.Count == 0)
                    {
                        <p class="list-empty p5-tom">Ingen dører matcher filteret. <button type="button" class="p5-lenke" @onclick="@(() => { NullstillDorFilter(); VelgDorChip(""); })">Nullstill filter</button></p>
                    }
                    else
                    {
                        @* Begge visninger rendres alltid - ren CSS (@media, ikke server-side
                           _erMobilvisning) avgjør hvilken som vises. Dørlisten sluttet å dukke
                           opp på mobil gjentatte ganger med server-valgt gren (avhengig av at
                           JS-interop-deteksjonen rekker å slå til) - CSS-breddevalg kan ikke
                           havne fast i "feil" tilstand på samme måte, siden nettleseren
                           reevaluerer det løpende ut fra faktisk vindusbredde. *@
                        <div class="mobil-dorer-kort-liste">
                            @foreach (var d in FiltrerteDorer)
                            {
                                <div @key="d.Id" class="mobil-dor-kort mobil-kant-@d.Status.PillFarge()" @onclick="@(() => SelectDoor(d))">
                                    <div class="mobil-dor-kort-info">
                                        <span class="mobil-dor-kort-navn">@d.Dornummer</span>
                                        <span class="mobil-dor-kort-meta">@d.Etasje / @d.Sone</span>
                                    </div>
                                    <select class="status-select @StatusSelectClass(d.Status)" value="@d.Status" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs e) => EndreStatus(d, e))">
                                        <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                        <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                        <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                                    </select>
                                </div>
                            }
                        </div>

                    var brannIder = BrannavvikIder;
                    var sideDorer = SideDorer;
                    <div class="dorer-table-wrap p5-tabwrap dx-tabwrap">
                        <table class="p5-tab dx-tab">
                            <thead>
                                <tr>
                                    <th class="dx-cb"><input type="checkbox" title="Velg alle på siden" checked="@(sideDorer.Count > 0 && sideDorer.All(x => _valgteDorer.Contains(x.Id)))" @onchange="@(e => VelgAlleDorerPaSiden(sideDorer, e))" /></th>
                                    <th>Dør</th><th>Rom</th><th>Etasje</th><th>Brann</th><th>Beslag</th><th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in sideDorer)
                                {
                                    var dor = d;
                                    var beslagTotalt = d.Komponenter.Where(k => k.MonteresAvOss).Sum(k => k.Antall);
                                    var beslagMontert = d.Komponenter.Where(k => k.MonteresAvOss && k.Montert).Sum(k => k.Antall);
                                    var dorFarge = d.Status switch { MontasjeStatus.FerdigMontert => "#2e7d4f", MontasjeStatus.Montert => "#d4892b", _ => "#c9bda9" };
                                    <tr @key="d.Id" class="@(_selectedDoor?.Id == d.Id ? "dorer-row-selected" : "") @(_valgteDorer.Contains(d.Id) ? "dx-valgt" : "")" @onclick="@(() => SelectDoor(dor))">
                                        <td class="dx-cb" @onclick:stopPropagation="true"><input type="checkbox" checked="@_valgteDorer.Contains(d.Id)" @onchange="@(() => { if (!_valgteDorer.Remove(dor.Id)) _valgteDorer.Add(dor.Id); })" /></td>
                                        <td><b>@d.Dornummer</b>@if (brannIder.Contains(d.Id)) {<span class="dx-varsel" title="Brannavvik - se Brannkontroll"><Icon Name="alert-triangle" /></span>}</td>
                                        <td>@(string.IsNullOrWhiteSpace(d.Romnr) ? (d.Plantegning?.Navn ?? "–") : d.Romnr)</td>
                                        <td>@(string.IsNullOrWhiteSpace(d.Etasje) ? "–" : d.Etasje)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(d.Brann))
                                            {
                                                <span class="p5-smule">–</span>
                                            }
                                            else
                                            {
                                                <span class="p5-pill s-rod">@d.Brann</span>
                                            }
                                        </td>
                                        <td><span class="p5-rad"><span class="p5-bar p5-bar-90"><i style="width:@Andel(beslagMontert, beslagTotalt)%;background:@dorFarge"></i></span><span class="p5-smule">@beslagMontert/@beslagTotalt</span></span></td>
                                        <td>
                                            <select class="p5-statusvelger @DorStatusPill(d.Status)" value="@d.Status" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs e) => EndreStatus(dor, e))">
                                                <option value="@MontasjeStatus.IkkeStartet">Ikke startet</option>
                                                <option value="@MontasjeStatus.Montert">Pågår</option>
                                                <option value="@MontasjeStatus.FerdigMontert">Ferdig</option>
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dx-bunn">
                        <span>Viser @(DorSideStart)–@(DorSideSlutt) av @FiltrerteDorer.Count dører</span>
                        <span class="dx-sider">
                            <button type="button" disabled="@(GjeldendeDorSide <= 1)" @onclick="@(() => _dorSide = GjeldendeDorSide - 1)">&lsaquo;</button>
                            @for (var side = 1; side <= TotaltDorSider; side++)
                            {
                                var denneSiden = side;
                                <button type="button" class="@(denneSiden == GjeldendeDorSide ? "pa" : "")" @onclick="@(() => _dorSide = denneSiden)">@denneSiden</button>
                            }
                            <button type="button" disabled="@(GjeldendeDorSide >= TotaltDorSider)" @onclick="@(() => _dorSide = GjeldendeDorSide + 1)">&rsaquo;</button>
                            <select @bind="_dorPerSide" @bind:after="@(() => _dorSide = 1)">
                                <option value="20">20 per side</option>
                                <option value="50">50 per side</option>
                                <option value="100">100 per side</option>
                            </select>
                        </span>
                    </div>
                    }
                }
            </div>

            @if (_selectedDoor is not null)
            {
                <div class="dor-modal-overlay">
                    <div class="dor-modal-panel">
                        @if (!_erMobilvisning)
                        {
                            // Dørvinduet er dørsiden (S13). En ny dør åpnes rett i redigering (Rediger), en eksisterende på Oversikt.
                            var forrigeDor = NaboDor(-1);
                            var nesteDor = NaboDor(1);
                            <DorDetalj Id="_selectedDoor.Id"
                                       IModal="true"
                                       MedRedigering="true"
                                       StartFane="@(_selectedDoor.Id == _nyDorId ? "detaljer" : null)"
                                       AlleDorer="_dorer"
                                       OnLukk="@(() => { _selectedDoor = null; _nyDorId = null; })"
                                       OnDeleted="OnDoorDeleted"
                                       OnUnplaced="OnDoorUnplaced"
                                       OnCloned="OnDoorsCloned"
                                       OnSaved="StateHasChanged"
                                       OnForrige="ByttDorCallback(forrigeDor)"
                                       OnNeste="ByttDorCallback(nesteDor)"
                                       ForrigeNavn="@forrigeDor?.Dornummer"
                                       NesteNavn="@nesteDor?.Dornummer" />
                        }
                        else
                        {
                            <DorRedigering Dor="_selectedDoor"
                                            AlleDorer="_dorer"
                                            ProsjektOverlevertDato="_form.OverlevertDato"
                                            ErMobilvisning="_erMobilvisning"
                                            OnClose="@(() => _selectedDoor = null)"
                                            OnDeleted="OnDoorDeleted"
                                            OnUnplaced="OnDoorUnplaced"
                                            OnCloned="OnDoorsCloned"
                                            OnSaved="StateHasChanged" />
                        }
                    </div>
                </div>
            }

            @if (_visDorImport && Id.HasValue)
            {
                <DorImportModal ProsjektId="Id.Value" OnClose="@(() => _visDorImport = false)" OnImportert="OnDorerImportert" />
            }
        </div>
    }
    else if (_activeTab == "plantegninger")
    {
        <div class="prosjekt-layout plantegninger-layout">
            @if (!_erMobilvisning)
            {
                @* B1: byggetrinn som kort med tegningene som fliser. Tegninger dras mellom
                   byggetrinn (eller flyttes med ⋮), og byggetrinnene dras for å endre rekkefølgen. *@
                <div class="bt-topp">
                    <label class="bt-sok"><Icon Name="search" /><input type="search" @bind="_tegningSok" @bind:event="oninput" placeholder="Søk i tegninger" /></label>
                    @if (KanRedigereProsjekt)
                    {
                        <button type="button" class="bt-kn" @onclick="StartNyttByggetrinn"><Icon Name="plus" />Nytt byggetrinn</button>
                        <label class="bt-kn bt-kn-p">
                            <Icon Name="upload" />Last opp tegning
                            <InputFile @key="@($"topp-{_plantegningInputKey}")" OnChange="@(e => LastOppTil(e, null))" accept="image/*,.pdf,application/pdf" />
                        </label>
                    }
                </div>
                @if (KanRedigereProsjekt && _plantegninger.Count > 0)
                {
                    <p class="bt-tips"><Icon Name="grip" />Dra tegninger mellom byggetrinn, eller bruk ⋮ på tegningen. Dra byggetrinnene i håndtaket for å endre rekkefølgen.</p>
                }

                @if (_uploadingPlantegning)
                {
                    <p class="list-empty">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_plantegningFeil))
                {
                    <p class="form-error">@_plantegningFeil</p>
                }
            }

            @if (_plantegninger.Count > 0 || (_byggetrinn.Count > 0 && !_erMobilvisning))
            {
                @if (_erMobilvisning)
                {
                    <div class="mobil-plantegning-liste">
                        @foreach (var gruppe in PlantegningGrupper)
                        {
                            <div @key="gruppe.Navn" class="mobil-plantegning-gruppe">
                                <button type="button" class="mobil-plantegning-gruppe-header" @onclick="@(() => ToggleGruppe(gruppe.Navn))">
                                    <Icon Name="folder" />
                                    <span class="mobil-plantegning-gruppe-navn">@gruppe.Navn</span>
                                    <span class="mobil-plantegning-gruppe-count">@gruppe.Plantegninger.Count etasje@(gruppe.Plantegninger.Count == 1 ? "" : "r")</span>
                                    <span class="mobil-plantegning-chevron @(ErGruppeLukket(gruppe.Navn) ? "" : "apen")">
                                        <Icon Name="chevron-down" />
                                    </span>
                                </button>
                                @if (!ErGruppeLukket(gruppe.Navn))
                                {
                                    <div class="mobil-plantegning-kort-liste">
                                        @foreach (var p in gruppe.Plantegninger)
                                        {
                                            <a @key="p.Id" class="mobil-plantegning-kort" href="@($"/plantegning/{p.Id}")">
                                                <img class="mobil-plantegning-thumb" src="@($"/plantegningbilde/{p.Id}")" alt="" loading="lazy" />
                                                <span class="mobil-plantegning-kort-info">
                                                    <span class="mobil-plantegning-kort-navn">@p.Navn</span>
                                                    @{ var antallDorer = DorerPaPlantegning(p.Id); }
                                                    <span class="mobil-plantegning-kort-meta">@antallDorer dør@(antallDorer == 1 ? "" : "er")</span>
                                                </span>
                                                <span class="mobil-plantegning-kort-pil">
                                                    <Icon Name="chevron-down" />
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    @foreach (var gruppe in SynligeGrupper)
                    {
                        var navn = gruppe.Navn;
                        var erUgruppert = navn == UgruppertNavn;
                        var dorer = gruppe.Plantegninger.Sum(t => DorerPaPlantegning(t.Id));
                        var ferdig = gruppe.Plantegninger.Sum(t => FerdigePaPlantegning(t.Id));
                        <section @key="navn" class="bt-g" data-slipp
                                 @ondragover:preventDefault="true" @ondrop="@(() => SlippPaGruppe(navn))" @ondrop:preventDefault="true">
                            <div class="bt-gh" draggable="@((KanRedigereProsjekt && !erUgruppert) ? "true" : "false")" data-dra="gruppe"
                                 @ondragstart="@(() => { if (!erUgruppert) { _draGruppe = navn; _draTegningId = null; } })">
                                @if (KanRedigereProsjekt && !erUgruppert)
                                {
                                    <span class="bt-grep" title="Dra for å endre rekkefølgen"><Icon Name="grip" /></span>
                                }
                                <span class="bt-ik"><Icon Name="folder" /></span>
                                @if (_editingGruppe == navn)
                                {
                                    <input class="bt-inp" @bind="_gruppeRenameInput" @bind:event="oninput" placeholder="Navn på byggetrinn"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") { await LagreGruppeNavn(navn); } else if (e.Key == "Escape") { _editingGruppe = null; } })" />
                                    <button type="button" class="bt-kn bt-kn-p bt-liten" @onclick="@(() => LagreGruppeNavn(navn))">Lagre</button>
                                    <button type="button" class="bt-kn bt-liten" @onclick="@(() => _editingGruppe = null)">Avbryt</button>
                                }
                                else
                                {
                                    <b>@navn</b>
                                    <small>@gruppe.Plantegninger.Count tegning@(gruppe.Plantegninger.Count == 1 ? "" : "er") · @dorer dør@(dorer == 1 ? "" : "er")</small>
                                    @if (dorer > 0)
                                    {
                                        <span class="bt-bar"><i style="width:@(ferdig * 100 / dorer)%"></i></span>
                                        <small>@(ferdig * 100 / dorer) % ferdig montert</small>
                                    }
                                }
                                <span class="bt-gh-h">
                                    @if (KanRedigereProsjekt && !erUgruppert && _editingGruppe != navn)
                                    {
                                        <button type="button" class="bt-kn bt-liten" @onclick="@(() => StartGruppeRename(navn))"><Icon Name="edit" />Endre navn</button>
                                        @if (gruppe.Plantegninger.Count == 0)
                                        {
                                            <button type="button" class="bt-ikn" title="Slett tomt byggetrinn" @onclick="@(() => SlettByggetrinn(navn))"><Icon Name="trash" /></button>
                                        }
                                    }
                                    <button type="button" class="bt-ikn" title="@(ErGruppeLukket(navn) ? "Vis" : "Skjul")" @onclick="@(() => ToggleGruppe(navn))">
                                        <span class="bt-chev @(ErGruppeLukket(navn) ? "" : "apen")"><Icon Name="chevron-down" /></span>
                                    </button>
                                </span>
                            </div>
                            @if (!ErGruppeLukket(navn))
                            {
                                <div class="bt-tiles">
                                    @foreach (var p in gruppe.Plantegninger)
                                    {
                                        var tegning = p;
                                        var antallDorer = DorerPaPlantegning(p.Id);
                                        var antallFerdig = FerdigePaPlantegning(p.Id);
                                        <div @key="p.Id" class="bt-t" draggable="@(KanRedigereProsjekt ? "true" : "false")" data-dra="tegning"
                                             @ondragstart="@(() => { _draTegningId = tegning.Id; _draGruppe = null; })">
                                            <a class="bt-t-bilde" href="@($"/plantegning/{p.Id}")" draggable="false">
                                                <img src="@($"/plantegningbilde/{p.Id}")" alt="" loading="lazy" draggable="false" />
                                            </a>
                                            @if (KanRedigereProsjekt)
                                            {
                                                <span class="bt-t-grep" title="Dra for å flytte"><Icon Name="grip" /></span>
                                                <button type="button" class="bt-t-meny" title="Flere valg" @onclick="@(() => VekslTegningMeny(tegning.Id))"><Icon Name="more-vertical" /></button>
                                            }
                                            <div class="bt-t-inn">
                                                @if (_redigerTegningId == p.Id)
                                                {
                                                    <input class="bt-inp" @bind="_tegningNavnInput" @bind:event="oninput"
                                                           @onkeydown="@(async e => { if (e.Key == "Enter") { await LagreTegningNavn(tegning); } else if (e.Key == "Escape") { _redigerTegningId = null; } })" />
                                                    <span class="bt-t-knapper">
                                                        <button type="button" class="bt-kn bt-kn-p bt-liten" @onclick="@(() => LagreTegningNavn(tegning))">Lagre</button>
                                                        <button type="button" class="bt-kn bt-liten" @onclick="@(() => _redigerTegningId = null)">Avbryt</button>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <a href="@($"/plantegning/{p.Id}")"><b>@p.Navn</b></a>
                                                    <span class="bt-t-meta">
                                                        <Icon Name="door" />@antallDorer dør@(antallDorer == 1 ? "" : "er")
                                                        <span class="bt-t-bar"><i style="width:@(antallDorer == 0 ? 0 : antallFerdig * 100 / antallDorer)%"></i></span>
                                                        @(antallDorer == 0 ? 0 : antallFerdig * 100 / antallDorer) %
                                                    </span>
                                                }
                                            </div>
                                            @if (_menyTegningId == p.Id)
                                            {
                                                <div class="bt-meny">
                                                    <button type="button" @onclick="@(() => StartTegningNavn(tegning))"><Icon Name="edit" />Gi nytt navn</button>
                                                    <small>Flytt til</small>
                                                    @foreach (var mal in AlleGruppeNavn.Where(g => g != navn))
                                                    {
                                                        var malNavn = mal;
                                                        <button type="button" @onclick="@(() => FlyttPlantegning(tegning, malNavn))"><Icon Name="folder" />@malNavn</button>
                                                    }
                                                    <button type="button" @onclick="@(() => StartNyttByggetrinn(tegning.Id))"><Icon Name="plus" />Nytt byggetrinn …</button>
                                                    <hr />
                                                    @if (_bekreftSlettTegningId == p.Id)
                                                    {
                                                        <button type="button" class="bt-rod" @onclick="@(() => RemovePlantegning(tegning))"><Icon Name="trash" />Ja, slett tegningen</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="bt-rod" @onclick="@(() => _bekreftSlettTegningId = tegning.Id)"><Icon Name="trash" />Slett tegning</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (KanRedigereProsjekt && string.IsNullOrWhiteSpace(_tegningSok))
                                    {
                                        <label class="bt-ny-t">
                                            <Icon Name="upload" />
                                            <span>@(gruppe.Plantegninger.Count == 0 ? "Last opp første tegning" : "Last opp tegning hit")</span>
                                            <InputFile @key="@($"{navn}-{_plantegningInputKey}")" OnChange="@(e => LastOppTil(e, erUgruppert ? null : navn))" accept="image/*,.pdf,application/pdf" />
                                        </label>
                                    }
                                </div>
                            }
                        </section>
                    }
                }
            }
            else if (_byggetrinn.Count == 0)
            {
                <p class="list-empty">Ingen plantegninger lastet opp ennå.</p>
            }

            @if (_visNyttByggetrinn && !_erMobilvisning)
            {
                <div class="bt-nygr">
                    <Icon Name="folder" />
                    <input class="bt-inp" @bind="_nyttByggetrinnNavn" @bind:event="oninput" placeholder="Navn, f.eks. BT2 · Parkeringskjeller"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettByggetrinn(); } else if (e.Key == "Escape") { _visNyttByggetrinn = false; } })" />
                    <button type="button" class="bt-kn bt-kn-p" @onclick="OpprettByggetrinn">Opprett</button>
                    <button type="button" class="bt-kn" @onclick="@(() => _visNyttByggetrinn = false)">Avbryt</button>
                </div>
            }
        </div>
    }
    else if (_activeTab == "avvik")
    {
        @* A1: alle avvik i én tabell med status og alder, grå overskrift og annenhver grå/hvit
           rad. Hvert avvik har egen side (/avvik/{id}). *@
        var avvikVis = _prosjektAvvik.Where(a => _avvikFilter switch
        {
            "apne" => a.Status == AvvikStatus.Apent,
            "sendt" => a.Status is AvvikStatus.SendtTilKunde or AvvikStatus.Godkjent,
            "lukket" => a.Status == AvvikStatus.Lukket,
            _ => true
        }).OrderBy(a => a.Status == AvvikStatus.Lukket).ThenByDescending(a => a.OpprettetDato).ToList();
        var apneAvvik = _prosjektAvvik.Where(a => a.Status != AvvikStatus.Lukket).ToList();
        <div class="prosjekt-layout pa-layout">
            <div class="av-topp">
                @foreach (var (nokkel, navn, antall) in new[]
                {
                    ("alle", "Alle", _prosjektAvvik.Count),
                    ("apne", "Åpne", _prosjektAvvik.Count(a => a.Status == AvvikStatus.Apent)),
                    ("sendt", "Sendt til kunde", _prosjektAvvik.Count(a => a.Status is AvvikStatus.SendtTilKunde or AvvikStatus.Godkjent)),
                    ("lukket", "Lukket", _prosjektAvvik.Count(a => a.Status == AvvikStatus.Lukket))
                })
                {
                    var n = nokkel;
                    <button type="button" class="av-chip @(_avvikFilter == nokkel ? "pa" : "")" aria-pressed="@(_avvikFilter == nokkel ? "true" : "false")" @onclick="@(() => _avvikFilter = n)">@navn <em>@antall</em></button>
                }
                <span class="av-hoyre">
                    @if (_prosjektAvvik.Count > 0)
                    {
                        <a class="av-kn" href="@($"/prosjekter/{Id}/avvik/pdf")" target="_blank"><Icon Name="download" />Avviksrapport (PDF)</a>
                    }
                    <button type="button" class="av-kn av-kn-p" @onclick="@(() => _visMeldAvvik = true)" disabled="@(_dorer.Count == 0)"><Icon Name="plus" />Meld avvik</button>
                </span>
            </div>

            @if (avvikVis.Count == 0)
            {
                <p class="list-empty">@(_prosjektAvvik.Count == 0 ? "Ingen avvik meldt på prosjektet." : "Ingen avvik her.")</p>
            }
            else
            {
                <div class="av-k">
                    <div class="av-scroll">
                        <table class="av-tab">
                            <thead><tr><th>Nr.</th><th>Avvik</th><th>Dør</th><th class="pa-valg">Ansvarlig</th><th>Prioritet</th><th>Status</th><th class="pa-valg">Meldt</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var a in avvikVis)
                                {
                                    var avvikId = a.Id;
                                    var dager = (DateTime.Today - a.OpprettetDato.Date).Days;
                                    <tr @key="a.Id" @onclick="@(() => Nav.NavigateTo($"/avvik/{avvikId}"))">
                                        <td class="av-nr">@a.NummerTekst</td>
                                        <td>
                                            <a class="av-tittel" href="@($"/avvik/{a.Id}")" @onclick:stopPropagation="true">@a.Overskrift</a>
                                            <small>@(a.OpprettetAvBruker?.Navn ?? "Ukjent")@(_avvikBilder.GetValueOrDefault(a.Id) is > 0 and var nb ? $" · {nb} bilde{(nb == 1 ? "" : "r")}" : "")</small>
                                        </td>
                                        <td>
                                            @if (a.Dor is { } dor)
                                            {
                                                <button type="button" class="av-dor" title="Åpne døren" @onclick="@(() => { _activeTab = "dorer"; _selectedDoor = _dorer.FirstOrDefault(d => d.Id == dor.Id); })" @onclick:stopPropagation="true"><Icon Name="door" />@dor.Dornummer</button>
                                            }
                                        </td>
                                        <td class="pa-valg">@(a.AnsvarligBruker?.Navn ?? "–")</td>
                                        <td><span class="av-p @(a.Prioritet == AvvikPrioritet.Hoy ? "av-hoy" : "av-norm")">@a.Prioritet.Visningsnavn()</span></td>
                                        <td><span class="av-p @AvvikStatusKlasse(a.Status)">@a.Status.Visningsnavn()@(a.Status == AvvikStatus.Lukket && a.LukketDato is { } ld ? $" {ld:dd.MM}" : "")</span></td>
                                        <td class="pa-valg av-meldt">@a.OpprettetDato.ToString("dd.MM")<small class="@(a.Status != AvvikStatus.Lukket && dager > 14 ? "gml" : "")">@(a.Status == AvvikStatus.Lukket ? "lukket" : $"{dager} {(dager == 1 ? "dag" : "dager")}")</small></td>
                                        <td class="av-pil"><Icon Name="chevron-right" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="av-fot">
                        <span><b>@apneAvvik.Count</b> åpne</span>
                        <span><b>@apneAvvik.Count(a => a.Prioritet == AvvikPrioritet.Hoy)</b> med høy prioritet</span>
                        @if (apneAvvik.Count > 0)
                        {
                            <span>Eldste åpne: <b>@((DateTime.Today - apneAvvik.Min(a => a.OpprettetDato).Date).Days) dager</b></span>
                        }
                        <span class="av-hoyre">Trykk på et avvik for å se bilder, utbedring og signatur</span>
                    </div>
                </div>
            }
        </div>

        @if (_visMeldAvvik && Id is int pid)
        {
            <MeldAvvikDialog ProsjektId="pid" Dorer="_dorer" OnLukk="@(() => _visMeldAvvik = false)" OnMeldt="ProsjektAvvikMeldt" />
        }
    }
    else if (_activeTab == "vedlegg")
    {
        <div class="prosjekt-layout vedlegg-layout">
            @if (!_mappeApnet)
            {
                @* V1 (vedlegg-forslag.html): søk og Alle / PDF / Bilder til venstre, Ny mappe og
                   Last opp filer til høyre, mappene i en tabell med annenhver grå/hvit rad og
                   koblingsskjema som eget kort under. *@
                var alleFiler = VedleggGruppert.SelectMany(g => g.Filer).ToList();
                var mapperVist = SynligeVedleggMapper
                    .Select(g => (Gruppe: g, Filer: g.Filer.Where(f => PasserVedleggType(f)).ToList()))
                    .Where(x => _vedleggType == "alle" || x.Filer.Count > 0)
                    .ToList();
                <div class="ve-topp">
                    <input class="ve-sok" type="search" @bind="_vedleggSok" @bind:event="oninput" placeholder="Søk mappe eller fil …" aria-label="Søk" />
                    @foreach (var (verdi, tekst) in new[] { ("alle", "Alle"), ("pdf", "PDF"), ("bilde", "Bilder") })
                    {
                        var antall = alleFiler.Count(f => verdi == "alle" || VedleggType(f) == verdi);
                        <button type="button" class="ve-chip @(_vedleggType == verdi ? "pa" : "")" @onclick="@(() => _vedleggType = verdi)">@tekst <em>@antall</em></button>
                    }
                    <span class="ve-hoyre">
                        @if (_visNyMappe)
                        {
                            <input class="ve-inp" @bind="_nyMappeNavn" @bind:event="oninput" autofocus
                                   @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettMappe(); _visNyMappe = !string.IsNullOrEmpty(_vedleggFeil); } else if (e.Key == "Escape") { _visNyMappe = false; } })"
                                   placeholder="Navn på ny mappe" />
                            <button type="button" class="ve-kn ve-kn-p" disabled="@string.IsNullOrWhiteSpace(_nyMappeNavn)" @onclick="@(async () => { await OpprettMappe(); _visNyMappe = !string.IsNullOrEmpty(_vedleggFeil); })">Opprett</button>
                            <button type="button" class="ve-kn" @onclick="@(() => { _visNyMappe = false; _nyMappeNavn = ""; })">Avbryt</button>
                        }
                        else
                        {
                            <button type="button" class="ve-kn" @onclick="@(() => { _visNyMappe = true; _vedleggFeil = null; })"><Icon Name="plus" />Ny mappe</button>
                            <label class="ve-kn ve-kn-p ve-opp" title="Filer uten mappe havner i «Ukategorisert»">
                                <Icon Name="upload" />Last opp filer
                                <InputFile OnChange="@(e => LastOppVedlegg(e, null))" multiple />
                            </label>
                        }
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(_vedleggFeil))
                {
                    <p class="form-error">@_vedleggFeil</p>
                }

                <div class="ve-k">
                    @if (mapperVist.Count == 0)
                    {
                        <p class="ve-ingen">@(string.IsNullOrWhiteSpace(_vedleggSok) && _vedleggType == "alle" ? "Ingen mapper opprettet ennå. Trykk «Ny mappe» for å lage den første, eller last opp filer direkte." : "Ingen treff.")</p>
                    }
                    else
                    {
                        <table class="ve-tab">
                            <thead><tr><th>Mappe</th><th class="c">Filer</th><th>Sist endret</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var (gruppe, filer) in mapperVist)
                                {
                                    var mappeId = gruppe.MappeId;
                                    var sist = gruppe.Filer.Count == 0 ? (DateTime?)null : gruppe.Filer.Max(f => f.OpprettetDato);
                                    <tr @key="@(mappeId?.ToString() ?? "ukategorisert")" class="ve-klikk" @onclick="@(() => ApneMappe(mappeId))">
                                        <td><span class="ve-n"><span class="ve-mi @(mappeId is null ? "ve-mi-u" : "")"><Icon Name="folder" /></span><b>@gruppe.Navn</b></span></td>
                                        <td class="c">@filer.Count</td>
                                        <td class="ve-mut">@(sist is { } d ? d.ToLocalTime().ToString("dd.MM.yyyy") : "–")</td>
                                        <td class="ve-h ve-pil"><Icon Name="chevron-right" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="ve-fot">
                        <span><b>@_mapper.Count</b> @(_mapper.Count == 1 ? "mappe" : "mapper")</span>
                        <span><b>@alleFiler.Count</b> @(alleFiler.Count == 1 ? "fil" : "filer")</span>
                        <span class="ve-hoyre">Åpne en mappe for å laste opp filer rett i den</span>
                    </div>
                </div>

                @* Lenker til filer som ligger andre steder (OneDrive, SharePoint, Dalux …). *@
                <div class="ve-k">
                    <div class="ve-th">
                        Lenker <small>@_lenker.Count</small>
                        <span class="ve-hoyre">
                            @if (!_visNyLenke)
                            {
                                <button type="button" class="ve-kn ve-kn-l" @onclick="@(() => { _visNyLenke = true; _lenkeFeil = null; })"><Icon Name="plus" />Legg til lenke</button>
                            }
                        </span>
                    </div>
                    @if (_visNyLenke)
                    {
                        <div class="ve-lenkeskjema">
                            <input class="ve-inp" @bind="_nyLenkeNavn" @bind:event="oninput" placeholder="Navn, f.eks. Tegninger i Dalux" aria-label="Navn på lenken" />
                            <input class="ve-inp ve-inp-url" type="url" @bind="_nyLenkeUrl" @bind:event="oninput" placeholder="https://…" aria-label="Adresse"
                                   @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilLenke(); } })" />
                            <button type="button" class="ve-kn ve-kn-p" @onclick="LeggTilLenke" disabled="@string.IsNullOrWhiteSpace(_nyLenkeUrl)">Lagre</button>
                            <button type="button" class="ve-kn" @onclick="@(() => { _visNyLenke = false; _nyLenkeNavn = ""; _nyLenkeUrl = ""; _lenkeFeil = null; })">Avbryt</button>
                            @if (!string.IsNullOrEmpty(_lenkeFeil))
                            {
                                <span class="ve-feil">@_lenkeFeil</span>
                            }
                        </div>
                    }
                    @{
                        var lenkeSok = _vedleggSok.Trim();
                        var lenkerVist = _lenker.Where(l => lenkeSok.Length == 0 || l.Navn.Contains(lenkeSok, StringComparison.OrdinalIgnoreCase) || l.Url.Contains(lenkeSok, StringComparison.OrdinalIgnoreCase)).ToList();
                    }
                    @if (lenkerVist.Count == 0)
                    {
                        <p class="ve-ingen">@(_lenker.Count == 0 ? "Ingen lenker ennå. Legg til lenker til mapper i OneDrive, SharePoint, Dalux, Google Drive eller lignende." : "Ingen treff.")</p>
                    }
                    else
                    {
                        <table class="ve-tab">
                            <tbody>
                                @foreach (var l in lenkerVist)
                                {
                                    var lenke = l;
                                    var (kilde, kildeKlasse) = LenkeKilde(l.Url);
                                    <tr @key="l.Id">
                                        <td><span class="ve-n"><span class="ve-mi ve-mi-l ve-l-@kildeKlasse"><Icon Name="link" /></span><span><b>@l.Navn</b><small class="ve-url">@l.Url</small></span></span></td>
                                        <td class="ve-mut">@kilde</td>
                                        <td class="ve-h ve-nowrap">
                                            <a class="ve-lenke" href="@l.Url" target="_blank" rel="noopener noreferrer">Åpne <Icon Name="external-link" /></a>
                                            @if (_slettLenkeId == l.Id)
                                            {
                                                <button type="button" class="ve-kn ve-kn-l ve-kn-rod" @onclick="@(() => SlettLenke(lenke))">Fjern</button>
                                                <button type="button" class="ve-kn ve-kn-l" @onclick="@(() => _slettLenkeId = null)">Avbryt</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="ve-x" title="Fjern lenken" @onclick="@(() => _slettLenkeId = lenke.Id)"><Icon Name="x" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (SynligeKoblingsskjemaer.Count > 0)
                {
                    <div class="ve-k">
                        <div class="ve-th">Koblingsskjema <small>@SynligeKoblingsskjemaer.Count</small></div>
                        <table class="ve-tab">
                            <tbody>
                                @foreach (var k in SynligeKoblingsskjemaer)
                                {
                                    <tr @key="k.Id">
                                        <td><span class="ve-n"><span class="ve-mi ve-mi-k"><Icon Name="file-text" /></span><b>@k.Navn</b></span></td>
                                        <td class="ve-mut">@(k.Kategori?.Navn ?? "–")</td>
                                        <td class="ve-h"><a class="ve-lenke" href="@($"/koblingsskjema/{k.Id}")">Åpne <Icon Name="chevron-right" /></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                var gruppe = VedleggGruppert.FirstOrDefault(g => g.MappeId == _apenMappeId) ?? new VedleggMappeGruppe(_apenMappeId, "Ukategorisert", []);

                <button type="button" class="back-link vedlegg-tilbake" @onclick="LukkMappe">← Tilbake til mapper</button>

                <div class="vedlegg-mappe-detalj-header">
                    @if (gruppe.MappeId.HasValue && _redigererMappeId == gruppe.MappeId)
                    {
                        <div class="vedlegg-mappe-detalj-tittel vedlegg-mappe-detalj-tittel-rediger">
                            <span class="vedlegg-panel-ikon"><Icon Name="folder" /></span>
                            <input class="vedlegg-mappe-rediger-input" @bind="_redigerMappeNavn" @bind:event="oninput"
                                   @onkeydown="@(async e => { if (e.Key == "Enter") { await LagreMappeNavn(gruppe.MappeId!.Value); } })" autofocus />
                            <button type="button" class="icon-button" title="Lagre navn" @onclick="@(() => LagreMappeNavn(gruppe.MappeId!.Value))"><Icon Name="check-circle" /></button>
                            <button type="button" class="icon-button" title="Avbryt" @onclick="@(() => _redigererMappeId = null)"><Icon Name="x" /></button>
                        </div>
                    }
                    else
                    {
                        <div class="vedlegg-mappe-detalj-tittel">
                            <span class="vedlegg-panel-ikon"><Icon Name="folder" /></span>
                            <h2>@gruppe.Navn</h2>
                            <span class="vedlegg-mappe-kort-antall">@gruppe.Filer.Count</span>
                        </div>
                        <div class="vedlegg-mappe-kort-handlinger">
                            @if (gruppe.MappeId.HasValue)
                            {
                                <button type="button" class="cancel-button vedlegg-handling-btn" @onclick="@(() => StartRedigerMappe(gruppe))"><Icon Name="edit" />Gi nytt navn</button>
                            }
                            @if (gruppe.MappeId.HasValue)
                            {
                                @if (_sletterMappeId == gruppe.MappeId)
                                {
                                    <span class="fjern-bekreft">
                                        Slett mappe?
                                        <button type="button" class="remove-button" @onclick="@(() => SlettMappe(gruppe.MappeId!.Value))">Ja</button>
                                        <button type="button" class="cancel-button" @onclick="@(() => _sletterMappeId = null)">Avbryt</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="cancel-button vedlegg-handling-btn vedlegg-handling-btn-slett" @onclick="@(() => _sletterMappeId = gruppe.MappeId)"><Icon Name="trash" />Slett mappe</button>
                                }
                            }
                        </div>
                    }
                </div>

                <label class="vedlegg-dropzone">
                    <span class="vedlegg-dropzone-ikon"><Icon Name="upload" /></span>
                    <span class="vedlegg-dropzone-tekst">
                        <strong>Last opp filer</strong>
                        <span>Dra og slipp, eller velg fra maskinen din</span>
                    </span>
                    <span class="add-button vedlegg-dropzone-knapp">Velg filer</span>
                    <InputFile OnChange="@(e => LastOppVedlegg(e, gruppe.MappeId))" multiple />
                </label>

                @if (_uploadingVedlegg)
                {
                    <p class="list-empty">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_vedleggFeil))
                {
                    <p class="form-error">@_vedleggFeil</p>
                }

                @if (gruppe.Filer.Count == 0)
                {
                    <div class="vedlegg-mappe-tom">
                        <Icon Name="file-text" />
                        <p>Ingen filer i denne mappen ennå.</p>
                    </div>
                }
                else
                {
                    <div class="vedlegg-tabell-kort">
                        <table class="vedlegg-fil-tabell p5-tab">
                            <thead>
                                <tr>
                                    <th>Navn</th>
                                    <th>Størrelse</th>
                                    <th>Lastet opp</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in gruppe.Filer)
                                {
                                    <tr @key="v.Id">
                                        <td class="vedlegg-fil-navn-celle">
                                            <span class="vedlegg-fil-ikon"><Icon Name="@FilIkon(v.ContentType)" /></span>
                                            <button type="button" class="vedlegg-fil-lenke" @onclick="@(() => VisForhandsvisning(v))">@v.Filnavn</button>
                                        </td>
                                        <td class="vedlegg-tabell-meta">@FormatFilstorrelse(v.Data.Length)</td>
                                        <td class="vedlegg-tabell-meta">@v.OpprettetDato.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (_mapper.Count > 0)
                                            {
                                                <select class="vedlegg-flytt-velger" @onchange="@(e => FlyttVedleggTil(v, e.Value))">
                                                    <option value="">Flytt til...</option>
                                                    @if (gruppe.MappeId is not null)
                                                    {
                                                        <option value="ukategorisert">Ukategorisert</option>
                                                    }
                                                    @foreach (var m in _mapper.Where(m => m.Id != gruppe.MappeId))
                                                    {
                                                        <option value="@m.Id">@m.Navn</option>
                                                    }
                                                </select>
                                            }
                                        </td>
                                        <td class="vedlegg-tabell-handling"><button type="button" class="icon-button icon-button-slett" title="Fjern" @onclick="@(() => RemoveVedlegg(v))"><Icon Name="trash" /></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_forhandsvistVedlegg is not null)
            {
                <div class="vedlegg-forhandsvisning-overlay" @onclick="LukkForhandsvisning">
                    <div class="vedlegg-forhandsvisning-panel" @onclick:stopPropagation="true">
                        <div class="vedlegg-forhandsvisning-header">
                            <h3>@_forhandsvistVedlegg.Filnavn</h3>
                            <button type="button" class="vedlegg-forhandsvisning-lukk" @onclick="LukkForhandsvisning">✕</button>
                        </div>
                        @if (_forhandsvistVedlegg.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@($"/prosjektvedlegg/{_forhandsvistVedlegg.Id}")" alt="@_forhandsvistVedlegg.Filnavn" class="vedlegg-forhandsvisning-bilde" />
                        }
                        else
                        {
                            <iframe src="@($"/prosjektvedlegg/{_forhandsvistVedlegg.Id}")" class="vedlegg-forhandsvisning-iframe" title="@_forhandsvistVedlegg.Filnavn"></iframe>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "tilbud")
    {
        @* S1: knapper øverst, tabell annenhver grå/hvit. Beløpet regnes alltid fra tilbudet
           (samme som «Totalt eks. mva» der), og datoene for sendt og godkjent blir stående. *@
        var synligeTilbud = _tilbud.Where(t => _tilbudChip == "" || t.Status.ToString() == _tilbudChip).ToList();
        <div class="prosjekt-layout tilbud-layout">
            <div class="tb-topp">
                <button type="button" class="tb-chip @(_tilbudChip == "" ? "pa" : "")" @onclick='@(() => _tilbudChip = "")'>Alle <em>@_tilbud.Count</em></button>
                @foreach (var st in new[] { EndringsmeldingStatus.Utkast, EndringsmeldingStatus.SendtTilKunde, EndringsmeldingStatus.Godkjent, EndringsmeldingStatus.Avslatt })
                {
                    var status = st;
                    var antall = _tilbud.Count(t => t.Status == status);
                    @if (antall > 0)
                    {
                        <button type="button" class="tb-chip @(_tilbudChip == status.ToString() ? "pa" : "")" @onclick="@(() => _tilbudChip = status.ToString())">@TilbudStatusTekst(status) <em>@antall</em></button>
                    }
                }
                <span class="tb-hoyre">
                    <button type="button" class="tb-kn" @onclick="StartEndringsmelding"><Icon Name="plus" />Endringsmelding / tillegg</button>
                    <button type="button" class="tb-kn tb-kn-p" @onclick="NyttTilbud"><Icon Name="plus" />Nytt tilbud</button>
                </span>
            </div>

            @if (_tilbud.Count > 0)
            {
                <div class="tb-k">
                    <div class="tb-scroll">
                        <table class="tb-tab">
                            <thead><tr><th>Tilbud</th><th>Type</th><th class="h">Beløp eks. mva</th><th>Sendt</th><th>Godkjent</th><th>Status</th><th></th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in synligeTilbud)
                                {
                                    var tilbud = t;
                                    <tr @key="t.Id" @onclick="@(() => Nav.NavigateTo($"/tilbud/{tilbud.Id}"))">
                                        <td class="tb-tittel"><b>@t.Tittel</b><small>@(t.Type == TilbudType.Endringsmelding && t.OpprinneligTilbud is not null ? $"Tillegg til: {t.OpprinneligTilbud.Tittel}" : $"T-{t.OpprettetDato.Year}-{t.Id:000}")</small></td>
                                        <td>@(t.Type == TilbudType.Endringsmelding ? "Endringsmelding" : "Hovedtilbud")</td>
                                        <td class="h tb-n"><b>@TilbudBeregningHelper.BeregnTotaltUtenMva(t).ToString("N0", Kultur) kr</b></td>
                                        <td class="tb-n">@if (t.SendtDato is { } sendt) {@sendt.ToString("dd.MM.yyyy")} else {<span class="tb-tom">–</span>}</td>
                                        <td class="tb-n">@if (t.GodkjentDato is { } godkjent) {@godkjent.ToString("dd.MM.yyyy")} else {<span class="tb-tom">–</span>}</td>
                                        <td><span class="tb-p @TilbudPill(t.Status)">@if (t.Status == EndringsmeldingStatus.Godkjent) {<Icon Name="check" />} @TilbudStatusTekst(t.Status)</span></td>
                                        <td class="h"><RadMeny Navn="@t.Tittel" RedigerHref="@($"/tilbud/{tilbud.Id}")" OnSlett="@(() => { _slettTilbudId = tilbud.Id; _slettTilbudNavn = tilbud.Tittel; })" /></td>
                                        <td class="tb-pil"><Icon Name="chevron-right" /></td>
                                    </tr>
                                }
                                @if (synligeTilbud.Count == 0)
                                {
                                    <tr><td colspan="8" class="tb-ingen">Ingen tilbud med denne statusen.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="tb-fot">
                        @foreach (var (navn, status) in new[] { ("Godkjent", EndringsmeldingStatus.Godkjent), ("Sendt, venter svar", EndringsmeldingStatus.SendtTilKunde), ("Utkast", EndringsmeldingStatus.Utkast) })
                        {
                            var liste = _tilbud.Where(t => t.Status == status).ToList();
                            @if (liste.Count > 0)
                            {
                                <span>@navn <b>@liste.Sum(TilbudBeregningHelper.BeregnTotaltUtenMva).ToString("N0", Kultur) kr</b></span>
                            }
                        }
                        <span class="tb-hoyre">Alle beløp eks. mva · hentes fra tilbudet</span>
                    </div>
                </div>
            }
            else
            {
                <p class="list-empty">Ingen tilbud opprettet ennå.</p>
            }

            @if (_velgOpprinnelig)
            {
                <div class="dor-modal-overlay" @onclick="@(() => _velgOpprinnelig = false)">
                    <div class="tb-modal" @onclick:stopPropagation="true">
                        <h3>Endringsmelding / tillegg</h3>
                        <label>
                            Gjelder tilbud
                            <select @bind="_valgtOpprinneligTilbudId">
                                <option value="">(ikke koblet til et bestemt tilbud)</option>
                                @foreach (var t in _tilbud.Where(x => x.Type == TilbudType.Tilbud))
                                {
                                    <option value="@t.Id">@t.Tittel · T-@t.OpprettetDato.Year-@t.Id.ToString("000")</option>
                                }
                            </select>
                        </label>
                        <div class="tb-modal-knapper">
                            <button type="button" class="tb-kn" @onclick="@(() => _velgOpprinnelig = false)">Avbryt</button>
                            <button type="button" class="tb-kn tb-kn-p" @onclick="NyEndringsmelding"><Icon Name="plus" />Opprett</button>
                        </div>
                    </div>
                </div>
            }
            <SlettDialog Type="SletteType.Tilbud" Id="_slettTilbudId" Navn="@_slettTilbudNavn" OnLukk="@(() => _slettTilbudId = null)" OnSlettet="TilbudSlettet" />
        </div>
    }
    else if (_activeTab == "montering")
    {
        @* O1: nøkkeltall med fremdrift, tabell med grå overskrift og annenhver grå/hvit rad
           (uten Montert-kolonne), og sum nederst. *@
        <div class="prosjekt-layout montering-layout">
            <div class="mo-tall">
                <div><span>Kalkulert</span><b>@KortTid(TotaltMonteringMinutter)</b><small>fra dørene</small></div>
                <div><span>Brukt</span><b>@KortTid(BruktMontasjeMinutter)</b><small>@TidsProsent % av kalkulert</small><i class="mo-bar"><i style="width:@(Math.Min(100, TidsProsent))%"></i></i></div>
                <div><span>Igjen</span><b>@KortTid(GjenstaendeMontasjeMinutter)</b><small>beslag som ikke er montert</small></div>
                <div><span>Beslag montert</span><b>@AntallBeslagMontert / @AntallBeslagTotalt</b><small>@BeslagProsent %</small><i class="mo-bar mo-bar-ok"><i style="width:@(Math.Min(100, BeslagProsent))%"></i></i></div>
            </div>
            <div class="mo-topp">
                <span class="mo-hint"><Icon Name="help-circle" />Antall hentes fra dørene. Minutter per stk hentes fra varene, men kan endres her.</span>
                <span class="mo-hoyre">
                    @if (_monteringLinjer.Any(l => l.ComponentId.HasValue))
                    {
                        <button type="button" class="mo-kn" @onclick="HentMinutterForAlle"><Icon Name="clock" />Hent minutter for alle</button>
                    }
                    <button type="button" class="mo-kn mo-kn-p" @onclick="SynkMontering"><Icon Name="sparkle" />Synk fra dørene</button>
                </span>
            </div>

            @if (!string.IsNullOrEmpty(_monteringSyncMessage))
            {
                <p class="save-success">@_monteringSyncMessage</p>
            }

            @if (_monteringLinjer.Count == 0)
            {
                <p class="list-empty p5-tom">Ingen varer lagt til ennå. Trykk «Synk fra dørene» for å hente inn alt som er registrert på dørene i prosjektet.</p>
            }
            else
            {
                <div class="mo-k">
                    <table class="mo-tab">
                        <thead>
                            <tr><th>Beslag</th><th class="c">Antall</th><th class="h">Min/stk</th><th class="h">Totalt</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _monteringLinjer)
                            {
                                <tr @key="l.Id">
                                    <td><b>@l.Navn</b></td>
                                    <td class="c mo-nr">@l.Antall @(string.IsNullOrWhiteSpace(l.Enhet) ? "stk" : l.Enhet)</td>
                                    <td class="h"><span class="mo-min"><input inputmode="numeric" @bind="l.Minutter" @bind:after="LagreMontering" placeholder="0" aria-label="Minutter per stk for @l.Navn" /><em>min</em></span></td>
                                    <td class="h mo-nr"><b>@KortTid((l.Minutter ?? 0) * l.Antall)</b></td>
                                    <td class="h mo-nowrap">
                                        @if (l.ComponentId.HasValue)
                                        {
                                            <button type="button" class="mo-ik" title="Hent minutt fra vare" @onclick="@(() => HentMinuttFraVare(l))"><Icon Name="clock" /></button>
                                        }
                                        <button type="button" class="mo-ik" title="Fjern" @onclick="@(() => FjernMonteringLinje(l))"><Icon Name="x" /></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="mo-fot">
                        <span><b>@_monteringLinjer.Count</b> varer</span>
                        <span><b>@_monteringLinjer.Sum(l => l.Antall)</b> stk</span>
                        <span class="mo-hoyre">Totalt <b>@KortTid(TotaltMonteringMinutter)</b></span>
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "fdv")
    {
        @* FDV E: én tabell med varene fra dørene, felles med serviceavtalen (FdvPanel). *@
        <FdvPanel ProsjektId="Id!.Value" OnEndret="FdvEndret" />
    }
    else if (_activeTab == "dorid")
    {
        @* Dør ID i samme oppsett som Dører: verktøylinje, tabell annenhver grå/hvit, og
           Dør ID-kortet når man trykker på en rad. Feltene heter det samme som på døren. *@
        var synligeMaler = SynligeDorIdMaler;
        <div class="prosjekt-layout dorid-layout">
            <div class="di-topp">
                <label class="di-sok"><Icon Name="search" /><input type="search" @bind="_dorIdSok" @bind:event="oninput" placeholder="Søk i Dør ID" /></label>
                <select class="di-filter" @bind="_dorIdBrannFilter" aria-label="Brann">
                    <option value="">Alle brannklasser</option>
                    @foreach (var b in _dorIdMaler.Select(m => m.Brann?.Trim()).Where(b => !string.IsNullOrWhiteSpace(b)).Distinct().OrderBy(b => b))
                    {
                        <option value="@b">@b</option>
                    }
                </select>
                <select class="di-filter" @bind="_dorIdKonstrFilter" aria-label="Dørkonstruksjon">
                    <option value="">Alle konstruksjoner</option>
                    @foreach (var k in _dorIdMaler.Select(m => m.Dorkonstruksjon?.Trim()).Where(k => !string.IsNullOrWhiteSpace(k)).Distinct().OrderBy(k => k))
                    {
                        <option value="@k">@k</option>
                    }
                </select>
                @if (KanRedigereProsjekt)
                {
                    <button type="button" class="di-kn di-kn-p di-hoyre" @onclick="StartNyDorIdMal"><Icon Name="plus" />Ny Dør ID</button>
                }
            </div>

            @if (_dorIdMaler.Count > 0)
            {
                <div class="di-k">
                    <div class="dorid-tabell-scroll">
                        <table class="di-tab">
                            <thead>
                                <tr>
                                    <th>Dør ID</th>
                                    <th>Dørkonstruksjon</th>
                                    <th>Fløyer</th>
                                    <th class="di-tall">Bredde mm</th>
                                    <th class="di-tall">Høyde mm</th>
                                    <th>Brann</th>
                                    <th>Lyd</th>
                                    <th>Fri bredde 0,86 m</th>
                                    <th>Brukes på</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in synligeMaler)
                                {
                                    var mal = m;
                                    var antall = _dorer.Count(d => d.DorIdMalId == m.Id);
                                    <tr @key="m.Id" class="di-rad" @onclick="@(() => ApneDorIdMal(mal))">
                                        <td class="di-kode">@m.Kode</td>
                                        <td>@(string.IsNullOrWhiteSpace(m.Dorkonstruksjon) ? "–" : m.Dorkonstruksjon)</td>
                                        <td>@(m.ToFloyet switch { true => "2-fløyet", false => "1-fløyet", _ => "–" })</td>
                                        <td class="di-tall">@(m.Bredde?.ToString() ?? "–")</td>
                                        <td class="di-tall">@(m.Hoyde?.ToString() ?? "–")</td>
                                        <td>@if (!string.IsNullOrWhiteSpace(m.Brann)) {<span class="di-p di-rod">@m.Brann</span>} else {<span class="di-tom">–</span>}</td>
                                        <td>@(string.IsNullOrWhiteSpace(m.Lyd) ? "–" : m.Lyd)</td>
                                        <td>
                                            @if (m.FriBredde086 is true)
                                            {
                                                <span class="di-p di-gronn"><Icon Name="check" />Ja</span>
                                            }
                                            else if (m.FriBredde086 is false)
                                            {
                                                <span class="di-p di-gul">Nei</span>
                                            }
                                            else
                                            {
                                                <span class="di-tom">Ikke satt</span>
                                            }
                                        </td>
                                        <td><span class="di-p di-bla">@antall @(antall == 1 ? "dør" : "dører")</span></td>
                                        <td class="di-pil"><Icon Name="chevron-right" /></td>
                                    </tr>
                                }
                                @if (synligeMaler.Count == 0)
                                {
                                    <tr><td colspan="10" class="di-ingen">Ingen Dør ID passer søket.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="di-fot">
                        @_dorIdMaler.Count Dør ID · @_dorer.Count(d => d.DorIdMalId is not null) dører koblet
                        <span>Trykk på en rad for å se og endre alt på Dør ID-en</span>
                    </div>
                </div>
            }
            else
            {
                <div class="di-tomt">
                    <Icon Name="tag" />
                    <span><b>Ingen Dør ID ennå</b>En Dør ID er en dørspesifikasjon (konstruksjon, mål, brann, lyd …) som kan brukes på mange dører.</span>
                    @if (KanRedigereProsjekt)
                    {
                        <button type="button" class="di-kn di-kn-p" @onclick="StartNyDorIdMal"><Icon Name="plus" />Ny Dør ID</button>
                    }
                </div>
            }

            @* ---------- Ny Dør ID ---------- *@
            @if (_nyMal is { } nm)
            {
                <div class="dor-modal-overlay" @onclick="@(() => _nyMal = null)">
                    <div class="di-modal" @onclick:stopPropagation="true">
                        <div class="di-mh">
                            <span class="di-mh-ik"><Icon Name="tag" /></span>
                            <div><h2>Ny Dør ID</h2><small>@_form.Navn</small></div>
                            <button type="button" class="di-x" title="Lukk" @onclick="@(() => _nyMal = null)"><Icon Name="x" /></button>
                        </div>
                        <div class="di-mb">
                            <label class="di-f">Dør ID<input class="di-stor" @bind="nm.Kode" @bind:event="oninput" placeholder="F.eks. A.YD100-N" autofocus /></label>
                            <div class="di-sek">
                                <h4>Døren</h4>
                                <div class="di-gr">
                                    @DorIdKonstruksjon(nm, false)
                                    @DorIdFloyer(nm, false)
                                    <label class="di-f">Bredde (mm)<input inputmode="numeric" @bind="nm.Bredde" /></label>
                                    <label class="di-f">Høyde (mm)<input inputmode="numeric" @bind="nm.Hoyde" /></label>
                                </div>
                            </div>
                            <div class="di-sek">
                                <h4>Krav</h4>
                                <div class="di-gr di-gr3">
                                    <label class="di-f">Brann<input @bind="nm.Brann" placeholder="F.eks. EI60" /></label>
                                    <label class="di-f">Lyd<input @bind="nm.Lyd" placeholder="F.eks. 35 dB" /></label>
                                    @DorIdFriBredde(nm, false)
                                </div>
                            </div>
                            @if (_nyMalFlere)
                            {
                                <div class="di-sek">
                                    <h4>Detaljer</h4>
                                    <div class="di-gr">@DorIdDetaljer(nm, false)</div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="di-utvid" @onclick="@(() => _nyMalFlere = true)"><Icon Name="chevron-down" />Flere felt – farger, karm, terskel, sparkeplate, A/B-mål, glass, CE og merknad</button>
                            }
                            <p class="di-hint"><Icon Name="help-circle" />Dører som får denne Dør ID-en, får dørkonstruksjon, fløyer, bredde, høyde, brann, lyd og fri bredde fylt ut automatisk.</p>
                            @if (!string.IsNullOrEmpty(_nyMalFeil))
                            {
                                <p class="form-error">@_nyMalFeil</p>
                            }
                        </div>
                        <div class="di-mf">
                            <button type="button" class="di-kn" @onclick="@(() => _nyMal = null)">Avbryt</button>
                            <span class="di-hoyre">
                                <button type="button" class="di-kn" @onclick="@(() => OpprettDorIdMal(lagEnTil: true))">Opprett og lag en til</button>
                                <button type="button" class="di-kn di-kn-p" @onclick="@(() => OpprettDorIdMal(lagEnTil: false))"><Icon Name="check" />Opprett Dør ID</button>
                            </span>
                        </div>
                    </div>
                </div>
            }

            @* ---------- Dør ID-kortet ---------- *@
            @if (_aapenDorIdMal is { } dm)
            {
                var dorerMedId = _dorer.Where(d => d.DorIdMalId == dm.Id).OrderBy(d => d.Dornummer).ToList();
                var laast = !KanRedigereProsjekt;
                <div class="dor-modal-overlay" @onclick="@(() => _aapenDorIdMal = null)">
                    <div class="di-modal di-modal-bred" @onclick:stopPropagation="true">
                        <div class="di-mh">
                            <span class="di-mh-ik"><Icon Name="tag" /></span>
                            <div><small>@_form.Navn · Dør ID</small><h2>@dm.Kode</h2></div>
                            <span class="di-merker">
                                @if (!string.IsNullOrWhiteSpace(dm.Brann)) { <span class="di-p di-rod">@dm.Brann</span> }
                                @if (!string.IsNullOrWhiteSpace(dm.Lyd)) { <span class="di-p di-gra">@dm.Lyd</span> }
                                <span class="di-p di-bla">@dorerMedId.Count @(dorerMedId.Count == 1 ? "dør" : "dører")</span>
                            </span>
                            <button type="button" class="di-x" title="Lukk" @onclick="@(() => _aapenDorIdMal = null)"><Icon Name="x" /></button>
                        </div>
                        <div class="di-kort">
                            <div class="di-kol">
                                <section class="di-bk">
                                    <h4>Døren</h4>
                                    <div class="di-gr">
                                        <label class="di-f di-span2">Dør ID<input @bind="dm.Kode" @bind:after="LagreDorIdKort" disabled="@laast" /></label>
                                        @DorIdKonstruksjon(dm, true)
                                        @DorIdFloyer(dm, true)
                                        <label class="di-f">Bredde (mm)<input inputmode="numeric" @bind="dm.Bredde" @bind:after="LagreDorIdKort" disabled="@laast" /></label>
                                        <label class="di-f">Høyde (mm)<input inputmode="numeric" @bind="dm.Hoyde" @bind:after="LagreDorIdKort" disabled="@laast" /></label>
                                    </div>
                                </section>
                                <section class="di-bk">
                                    <h4>Detaljer</h4>
                                    <div class="di-gr">@DorIdDetaljer(dm, true)</div>
                                </section>
                            </div>
                            <div class="di-kol">
                                <section class="di-bk">
                                    <h4>Krav</h4>
                                    <div class="di-gr">
                                        <label class="di-f">Brann<input @bind="dm.Brann" @bind:after="LagreDorIdKort" disabled="@laast" placeholder="F.eks. EI60" /></label>
                                        <label class="di-f">Lyd<input @bind="dm.Lyd" @bind:after="LagreDorIdKort" disabled="@laast" placeholder="F.eks. 35 dB" /></label>
                                        @DorIdFriBredde(dm, true)
                                    </div>
                                </section>
                                <section class="di-bk">
                                    <h4><Icon Name="check-circle" />CE-godkjenning</h4>
                                    <div class="di-gr">
                                        <label class="di-f">
                                            Dørblad
                                            <select @bind="dm.CeDorblad" @bind:after="LagreDorIdKort" disabled="@laast">
                                                <option value="">Velg...</option>
                                                @foreach (var d in CeAlternativer.DorbladAlternativer)
                                                {
                                                    <option value="@d">@d</option>
                                                }
                                            </select>
                                        </label>
                                        <label class="di-f">
                                            Glasstykkelse eller dørtype
                                            <select @bind="dm.CeGlasstykkelse" @bind:after="LagreDorIdKort" disabled="@laast">
                                                <option value="">Velg...</option>
                                                @foreach (var g in CeAlternativer.GlasstykkelseAlternativer)
                                                {
                                                    <option value="@g">@g</option>
                                                }
                                            </select>
                                        </label>
                                    </div>
                                </section>
                                <section class="di-bk">
                                    <h4>Dører med denne Dør ID <span class="di-p di-bla">@dorerMedId.Count</span></h4>
                                    @if (dorerMedId.Count == 0)
                                    {
                                        <p class="di-tom-tekst">Ingen dører bruker denne Dør ID-en ennå. Velg den under «Dør ID» når du redigerer en dør.</p>
                                    }
                                    else
                                    {
                                        <div class="di-chips">
                                            @foreach (var d in dorerMedId)
                                            {
                                                var dor = d;
                                                <button type="button" @onclick="@(() => { _aapenDorIdMal = null; _activeTab = "dorer"; _selectedDoor = dor; })">@d.Dornummer</button>
                                            }
                                        </div>
                                        <p class="di-hint"><Icon Name="link-ikon" />Endringer i Døren og Krav oppdateres på dørene. Felt som er endret på selve døren, blir stående.</p>
                                    }
                                </section>
                            </div>
                        </div>
                        <div class="di-mf">
                            <span class="di-lagret">@(_dorIdMelding ?? "Endringer lagres automatisk")</span>
                            @if (KanRedigereProsjekt)
                            {
                                <button type="button" class="di-kn di-kn-rod di-hoyre" @onclick="@(async () => { await SlettDorIdMal(dm); _aapenDorIdMal = null; })"><Icon Name="trash" />Slett Dør ID</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "personer" && _naverendeRolle != BrukerRolle.Montor)
    {
        @* P5 (personer-forslag.html): søk og forklaring til venstre, Legg til person til høyre,
           prosjektleder og ansvarlig montør som to kort med «Bytt», og «Andre med tilgang» i en
           tabell under - uten de som allerede står i kortene. *@
        var psok = _personSok.Trim();
        var andre = _form.Medlemmer
            .Where(m => m.Id != _form.ProsjektlederId && m.Id != _form.AnsvarligMontorId)
            .Where(m => psok.Length == 0 || m.Navn.Contains(psok, StringComparison.OrdinalIgnoreCase) || (m.Epost ?? "").Contains(psok, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.Navn)
            .ToList();
        <div class="prosjekt-layout personer-layout">
            <div class="pe-topp">
                <input class="pe-sok" type="search" @bind="_personSok" @bind:event="oninput" placeholder="Søk person …" aria-label="Søk" />
                <span class="pe-hint"><Icon Name="help-circle" />Admin og prosjektledere har alltid tilgang.</span>
                <span class="pe-hoyre">
                    <select class="pe-velg" @bind="_valgtNyttMedlemId" aria-label="Velg person">
