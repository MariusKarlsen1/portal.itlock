    else if (_activeTab == "lasplan")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">
                Matrise over sylindere og nøkler for prosjektet. Merk komponenter som sylindere på tilbudets varer (kolonnen "Låsplan"),
