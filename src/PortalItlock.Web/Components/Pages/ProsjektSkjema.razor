    private List<DorIdMal> SynligeDorIdMaler => _dorIdMaler
        .Where(m => string.IsNullOrWhiteSpace(_dorIdSok) || m.Kode.Contains(_dorIdSok.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(m => _dorIdBrannFilter == "" || m.Brann?.Trim() == _dorIdBrannFilter)
        .Where(m => _dorIdKonstrFilter == "" || m.Dorkonstruksjon?.Trim() == _dorIdKonstrFilter)
        .ToList();

    private void StartNyDorIdMal()
    {
        _nyMal = new DorIdMal { ProsjektId = Id ?? 0, Kode = "", ToFloyet = false };
        _nyMalFlere = false;
        _nyMalFeil = null;
    }

    private async Task OpprettDorIdMal(bool lagEnTil)
    {
        if (!KanRedigereProsjekt || _nyMal is null || !Id.HasValue)
        {
            return;
        }

        var kode = _nyMal.Kode.Trim();
        if (kode.Length == 0)
        {
            _nyMalFeil = "Skriv inn Dør ID.";
            return;
        }

        if (_dorIdMaler.Any(m => string.Equals(m.Kode.Trim(), kode, StringComparison.OrdinalIgnoreCase)))
        {
            _nyMalFeil = $"Dør ID «{kode}» finnes allerede i prosjektet.";
            return;
        }

        _nyMal.Kode = kode;
        _nyMal.ProsjektId = Id.Value;
        Db.DorIdMaler.Add(_nyMal);
        await Db.SaveChangesAsync();

        _dorIdMaler.Add(_nyMal);
        _dorIdMaler = _dorIdMaler.OrderBy(m => m.Kode).ToList();
        if (lagEnTil)
        {
            // Neste Dør ID starter med samme konstruksjon, fløyer og krav - bare koden er tom.
            var forrige = _nyMal;
            _nyMal = new DorIdMal
            {
                ProsjektId = Id.Value, Kode = "", Dorkonstruksjon = forrige.Dorkonstruksjon, ToFloyet = forrige.ToFloyet,
                Bredde = forrige.Bredde, Hoyde = forrige.Hoyde, Brann = forrige.Brann, Lyd = forrige.Lyd, FriBredde086 = forrige.FriBredde086
            };
            _nyMalFeil = null;
        }
        else
        {
            _nyMal = null;
        }
    }

