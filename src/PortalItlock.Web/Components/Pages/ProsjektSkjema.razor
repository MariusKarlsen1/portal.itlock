    private async Task SynkMontering()
    {
        var gruppert = _dorer.SelectMany(d => d.Komponenter)
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall) })
            .ToList();

        foreach (var g in gruppert)
        {
            var linje = _monteringLinjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);
            if (linje is null)
            {
                linje = new MonteringLinje
                {
                    ProsjektId = _form.Id,
                    ComponentId = g.ComponentId,
                    Component = g.Component,
                    Navn = g.Component.Navn,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    Minutter = g.Component.MontasjeMinutterProsjekt,
                    Rekkefolge = _monteringLinjer.Count
                };
                _monteringLinjer.Add(linje);
                Db.MonteringLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Enhet = g.Component.Enhet;
            }
        }

        await Db.SaveChangesAsync();
        _monteringSyncMessage = $"{gruppert.Count} varetyper synkronisert fra prosjektets dører.";
    }

