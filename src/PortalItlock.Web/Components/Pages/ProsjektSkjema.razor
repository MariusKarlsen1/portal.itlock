    private int KalkulertMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.MonteresAvOss).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutterProsjekt ?? 0));

    private int BruktMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.MonteresAvOss && dk.Montert).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutterProsjekt ?? 0));

    private int GjenstaendeMontasjeMinutter =>
        Math.Max(0, KalkulertMontasjeMinutter - BruktMontasjeMinutter);

    private int AntallBeslagTotalt => _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.MonteresAvOss).Sum(dk => dk.Antall);

    private int AntallBeslagMontert => _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.MonteresAvOss && dk.Montert).Sum(dk => dk.Antall);

    private int TidsProsent =>
        KalkulertMontasjeMinutter > 0 ? (int)Math.Round(100.0 * BruktMontasjeMinutter / KalkulertMontasjeMinutter) : 0;

    private int BeslagProsent =>
        AntallBeslagTotalt > 0 ? (int)Math.Round(100.0 * AntallBeslagMontert / AntallBeslagTotalt) : 0;

    private int TotalProsent => (int)Math.Round((TidsProsent + BeslagProsent) / 2.0);

    private static string FormatTid(int minutter)
    {
        if (minutter <= 0)
        {
            return "0 min";
        }

        var timer = minutter / 60;
        var rest = minutter % 60;
        return timer > 0 ? $"{timer}t {rest}min" : $"{rest} min";
    }

