                    <p class="pe-ingen">@(psok.Length > 0 ? "Ingen treff." : "Ingen andre er lagt til ennå. Velg en person øverst og trykk «Legg til person».")</p>
                }
                else
                {
                    <table class="pe-tab">
                        <thead><tr><th>Person</th><th>E-post</th><th>Brukertype</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var m in andre)
