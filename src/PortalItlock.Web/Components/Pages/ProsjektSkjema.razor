    // Avvik på prosjektets dører (fanen Avvik). Bildene telles for seg, så
    // bildedataene ikke lastes.
    private async Task LastProsjektAvvikAsync()
    {
        if (Id is not int pid)
        {
            return;
        }

        _prosjektAvvik = await Db.Avvik.AsNoTracking()
            .Include(a => a.Dor)
            .Include(a => a.OpprettetAvBruker)
            .Include(a => a.AnsvarligBruker)
            .Where(a => a.Dor!.ProsjektId == pid)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();
        var ider = _prosjektAvvik.Select(a => a.Id).ToList();
        _avvikBilder = await Db.AvvikMedia.Where(m => ider.Contains(m.AvvikId))
            .GroupBy(m => m.AvvikId)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);
    }

    private async Task ProsjektAvvikMeldt(Avvik avvik)
    {
        _visMeldAvvik = false;
        await LastProsjektAvvikAsync();
        _avvikFilter = "alle";
    }

    // Dør-ID-kortet lagrer hvert felt med en gang, og oppdaterer dørene som følger Dør ID-en.
    private async Task LagreDorIdKort()
    {
        if (!KanRedigereProsjekt || _aapenDorIdMal is not { } m)
        {
            return;
        }

        var antall = DorIdSynk.Oppdater(m, _dorIdForrige, _dorer);
        await Db.SaveChangesAsync();
        _dorIdForrige = DorIdSynk.Verdier(m);
        _dorIdMelding = antall > 0 ? $"Lagret · oppdatert på {antall} {(antall == 1 ? "dør" : "dører")}" : "Lagret";
    }

    private async Task SlettDorIdMal(DorIdMal m)
    {
        if (!KanRedigereProsjekt)
        {
            return;
        }

        Db.DorIdMaler.Remove(m);
        await Db.SaveChangesAsync();
        _dorIdMaler.Remove(m);
    }

    // Personer

    private async Task LeggTilMedlem()
    {
        if (_valgtNyttMedlemId is null)
        {
            return;
        }

        // _alleBrukere er lest uten sporing; den sporede brukeren må kobles til, ellers
        // prøver EF å opprette brukeren på nytt (samme Id) og lagringen feiler. Samme
        // person kan være med på mange prosjekter - det er bare koblingen som lagres.
        var id = _valgtNyttMedlemId.Value;
        if (_form.Medlemmer.Any(m => m.Id == id))
        {
            _valgtNyttMedlemId = null;
            return;
        }

        var bruker = await Db.Brukere.FindAsync(id);
        if (bruker is null)
        {
            return;
        }

        _form.Medlemmer.Add(bruker);
        await Db.SaveChangesAsync();
        _valgtNyttMedlemId = null;
    }

    private async Task FjernMedlem(Bruker b)
    {
        _form.Medlemmer.Remove(b);
        if (_form.ProsjektlederId == b.Id)
        {
            _form.ProsjektlederId = null;
        }
        if (_form.AnsvarligMontorId == b.Id)
        {
            _form.AnsvarligMontorId = null;
        }
        await Db.SaveChangesAsync();
    }

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private static string PersonFarge(string navn) => PersonPaletten[navn.Sum(c => (int)c) % PersonPaletten.Length]; // Fast farge per navn (GetHashCode endres ved hver omstart)

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

