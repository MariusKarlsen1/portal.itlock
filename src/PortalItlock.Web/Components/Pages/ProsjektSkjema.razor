    // Dør ID

    private async Task OpprettDorIdMal()
    {
        if (string.IsNullOrWhiteSpace(_nyDorIdKode) || !Id.HasValue)
        {
            return;
        }

        var mal = new DorIdMal { ProsjektId = Id.Value, Kode = _nyDorIdKode.Trim() };
        Db.DorIdMaler.Add(mal);
        await Db.SaveChangesAsync();

        _dorIdMaler.Add(mal);
        _dorIdMaler = _dorIdMaler.OrderBy(m => m.Kode).ToList();
        _nyDorIdKode = "";
    }

