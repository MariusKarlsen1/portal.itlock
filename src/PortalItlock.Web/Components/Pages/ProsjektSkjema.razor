                    : new AktivitetRad($"{g.Count()} dører ble lagt til ({g.Min(d => d.Dornummer)} – {g.Max(d => d.Dornummer)})", g.Max(d => d.OpprettetDato))),
                .. _plantegninger.Select(p => new AktivitetRad($"Plantegning «{p.Navn}» ble lastet opp", p.OpprettetDato)),
                .. _tilbud.Select(t => new AktivitetRad($"Tilbud «{t.Tittel}» ble opprettet", t.OpprettetDato)),
                .. _vedlegg.Select(v => new AktivitetRad($"Vedlegg «{v.Filnavn}» ble lastet opp", v.OpprettetDato)),
            ];

            return alle.OrderByDescending(a => a.Dato).Take(30).ToList();
        }
    }

    private (DateTime Dato, string? Av)? SistOppdatert
    {
        get
        {
            if (_dorer.Count == 0)
            {
                return null;
            }

            return _dorer
                .Select(d => (Dato: d.OppdatertDato ?? d.OpprettetDato, Av: d.OppdatertAvBruker?.Navn ?? d.MontertAvBruker?.Navn))
                .OrderByDescending(x => x.Dato)
                .First();
        }
    }

    private static string AktivitetTidTekst(DateTime dato)
    {
        var dager = (int)(DateTime.UtcNow.Date - dato.Date).TotalDays;
        return dager switch
        {
            <= 0 => "I dag",
            1 => "I går",
            _ => $"For {dager} dager siden"
        };
    }
