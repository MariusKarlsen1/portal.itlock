@page "/prosjekter/ny"
@page "/prosjekter/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using SkiaSharp
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject FdvPdfService FdvPdfService
@inject DorBeslagslistePdfService BeslagslistePdfService
@inject LagretPdfService LagretPdfService
@inject TilbudSyncService TilbudSync
@inject PostnummerService Postnummer
@inject MobilVerktoylinjeService Verktoylinje
@inject VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</PageTitle>

@if (_ingenTilgang)
{
    <p class="form-error">Du har ikke tilgang til dette prosjektet.</p>
}
else if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else
{
    @if (Id.HasValue && _form.Status == ProsjektStatus.Serviceavtale)
    {
        <a class="back-link" href="@($"/serviceavtaler/{Id}")">&larr; Til serviceavtalen</a>
    }

    @* Prosjektkort P6 (oktober 2026): på PC ligger topp, infolinje, faner og
       innhold samlet i ett hvitt kort, som kundekortet. Mobil er uendret. *@
    <div class="pk-kort @(Id.HasValue && !_erMobilvisning ? "pk-kort-aktiv" : "") @(_pkFull && Id.HasValue && !_erMobilvisning ? "pk-full" : "")">
    @if (Id.HasValue && !_erMobilvisning)
    {
        <button type="button" class="pk-utvid" title="@(_pkFull ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslPkFull">
            <Icon Name="@(_pkFull ? "minimize" : "maximize")" />
        </button>
    }
    <div class="prosjekt-header">
        @if (Id.HasValue)
        {
            @* Fremdriftsring - samme tall som "Totalt komplett" på oversikten. *@
            <div class="ph-ring" title="Totalt komplett: @TotalProsent %">
                <svg viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15" class="ph-ring-spor" />
                    <circle cx="18" cy="18" r="15" class="ph-ring-fyll" style="stroke-dasharray:@((TotalProsent * 0.942).ToString(System.Globalization.CultureInfo.InvariantCulture)) 94.2" />
                </svg>
                <b>@TotalProsent%</b>
            </div>
        }
        else
        {
            <span class="prosjekt-header-ikon"><Icon Name="folder" /></span>
        }
        <div class="prosjekt-header-tekst">
            @if (Id.HasValue)
            {
                <div class="ph-smule">
                    <a href="/prosjekter">Prosjekter</a>
                    @if (KundeNavn is not null)
                    {
                        <span>/</span>@KundeNavn
                    }
                    <span>/</span>P-@Id
                </div>
            }
            <h1>
                @(Id.HasValue ? _form.Navn : "Nytt prosjekt")
                @if (Id.HasValue && _form.Status.HasValue)
                {
                    <StatusPill Tekst="@_form.Status.Value.Visningsnavn()" Ikon="@_form.Status.Value.PillIkon()" Farge="@_form.Status.Value.PillFarge()" />
                }
            </h1>
            @if (Id.HasValue && _erMobilvisning)
            {
                <div class="prosjekt-header-meta">
                    @if (KundeNavn is not null)
                    {
                        <span><Icon Name="users" />@KundeNavn</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Adresse))
                    {
                        <span><Icon Name="map" />@_form.Adresse@(string.IsNullOrWhiteSpace(_form.Sted) ? "" : $", {_form.Sted}")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
                    {
                        <span><Icon Name="phone" />@_form.Kontaktperson@(string.IsNullOrWhiteSpace(_form.Telefon) ? "" : $" · {_form.Telefon}")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.System))
                    {
                        <span><Icon Name="lock" />@_form.System</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Tek))
                    {
                        <span><Icon Name="file-text" />@_form.Tek · @_form.Type.Visningsnavn()</span>
                    }
                </div>
            }
        </div>
        @if (Id.HasValue && !_erMobilvisning && KanRedigereProsjekt)
        {
            @* "Ny"-menyen er bare snarveier til fanene der tingene lages. *@
            <div class="ph-handlinger">
                @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                {
                    <a class="ph-knapp" href="@($"tel:{_form.Telefon}")"><Icon Name="phone" />Ring kontakt</a>
                }
                <button type="button" class="ph-knapp" @onclick="@(() => { _activeTab = "oversikt"; _visNyMeny = false; })"><Icon Name="file-text" />Rediger</button>
                <button type="button" class="ph-knapp ph-knapp-primar" @onclick="@(() => _visNyMeny = !_visNyMeny)"><Icon Name="plus" />Ny<Icon Name="chevron-down" /></button>
                @if (_visNyMeny)
                {
                    <div class="ph-ny-bakgrunn" @onclick="@(() => _visNyMeny = false)"></div>
                    <div class="ph-ny-liste">
                        <button type="button" @onclick="@(() => VelgFraNyMeny("dorer"))"><Icon Name="door" />Ny dør</button>
                        @if (!SkjulteFaner.Contains("tilbud"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("tilbud"))"><Icon Name="file-text" />Nytt tilbud</button>
                            <button type="button" @onclick="@(() => VelgFraNyMeny("tilbud"))"><Icon Name="file-text" />Endringsmelding / tillegg</button>
                        }
                        <a href="/arbeidsordre"><Icon Name="tool" />Arbeidsordre</a>
                        <button type="button" @onclick="@(() => VelgFraNyMeny("plantegninger"))"><Icon Name="map" />Last opp plantegning</button>
                        @if (!SkjulteFaner.Contains("vedlegg"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("vedlegg"))"><Icon Name="folder" />Vedlegg</button>
                        }
                        @if (!SkjulteFaner.Contains("personer"))
                        {
                            <button type="button" @onclick="@(() => VelgFraNyMeny("personer"))"><Icon Name="users" />Legg til person</button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Id.HasValue && !_erMobilvisning)
    {
        <div class="pk-infolinje">
            @if (KundeNavn is not null)
            {
                <span><Icon Name="users" />Kunde <b>@KundeNavn</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Adresse))
            {
                <span><Icon Name="map-pin" /><b>@_form.Adresse@(string.IsNullOrWhiteSpace(_form.Sted) ? "" : $", {_form.Sted}")</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
            {
                <span><Icon Name="phone" /><b>@_form.Kontaktperson</b>@(string.IsNullOrWhiteSpace(_form.Telefon) ? "" : $" · {_form.Telefon}")</span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.System))
            {
                <span><Icon Name="lock" /><b>@_form.System</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.Tek))
            {
                <span><Icon Name="file-text" /><b>@_form.Tek</b> · @_form.Type.Visningsnavn()</span>
            }
            <span><Icon Name="calendar" />Opprettet <b>@_form.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</b>@if (_form.OverlevertDato is { } ov) {<span> · overlevert <b>@ov.ToString("dd.MM.yyyy")</b></span>}</span>
        </div>
    }

    @if (Id.HasValue)
    {
        @* Fanene står i den rekkefølgen jobben gjøres, gruppert med en tynn
           strek: oversikt | bygget | salg og jobb | dokumentasjon | samarbeid,
           og prosjektinfo (skjemaet) helt til høyre. Montører skal ikke se
           Tilbud, Vedlegg, Montering eller Personer - hvilke faner som skjules
           står i ModulRettigheter, ett sted. *@
        <nav class="prosjekt-tabs">
            <button type="button" class="@TabClass("status")" @onclick="@(() => _activeTab = "status")"><Icon Name="home" />Oversikt</button>
            <span class="tab-skille"></span>
            <button type="button" class="@TabClass("dorer")" @onclick="@(() => _activeTab = "dorer")">Dører<span class="tab-antall">@_dorer.Count</span></button>
            <button type="button" class="@TabClass("plantegninger")" @onclick="@(() => _activeTab = "plantegninger")">Plantegninger<span class="tab-antall">@_plantegninger.Count</span></button>
            <button type="button" class="@TabClass("dorid") mobil-admin-fane" @onclick="@(() => _activeTab = "dorid")">Dør ID<span class="tab-antall">@_dorIdMaler.Count</span></button>
            @if (!SkjulteFaner.Contains("tilbud") || !SkjulteFaner.Contains("montering"))
            {
                <span class="tab-skille mobil-admin-fane"></span>
            }
            @if (!SkjulteFaner.Contains("tilbud"))
            {
                <button type="button" class="@TabClass("tilbud") mobil-admin-fane" @onclick="@(() => _activeTab = "tilbud")">Tilbud<span class="tab-antall @(_tilbud.Any(t => t.Status == EndringsmeldingStatus.Godkjent) ? "tab-antall-ok" : "")">@_tilbud.Count</span></button>
            }
            @if (!SkjulteFaner.Contains("tilbud") && _naverendeRolle is BrukerRolle.Admin or BrukerRolle.Prosjektleder)
            {
                <button type="button" class="@TabClass("okonomi") mobil-admin-fane" @onclick="@(() => _activeTab = "okonomi")">Økonomi</button>
            }
            @if (!SkjulteFaner.Contains("montering"))
            {
                <button type="button" class="@TabClass("montering") mobil-admin-fane" @onclick="@(() => _activeTab = "montering")">Montering</button>
            }
            <span class="tab-skille mobil-admin-fane"></span>
            <button type="button" class="@TabClass("fdv") mobil-admin-fane" @onclick="@(() => _activeTab = "fdv")">FDV</button>
            <button type="button" class="@TabClass("beslagsliste") mobil-admin-fane" @onclick="@(() => _activeTab = "beslagsliste")">Beslagsliste</button>
            <button type="button" class="@TabClass("lasplan") mobil-admin-fane" @onclick="@(() => _activeTab = "lasplan")">Låsplan</button>
            @if (!SkjulteFaner.Contains("personer") || !SkjulteFaner.Contains("vedlegg"))
            {
                <span class="tab-skille mobil-admin-fane"></span>
            }
            @if (!SkjulteFaner.Contains("personer"))
            {
                <button type="button" class="@TabClass("personer") mobil-admin-fane" @onclick="@(() => _activeTab = "personer")">Personer<span class="tab-antall">@_form.Medlemmer.Count</span></button>
            }
            @if (!SkjulteFaner.Contains("vedlegg"))
            {
                <button type="button" class="@TabClass("vedlegg") mobil-admin-fane" @onclick="@(() => _activeTab = "vedlegg")">Vedlegg</button>
            }
            <button type="button" class="@TabClass("oversikt") tab-hoyre" @onclick="@(() => _activeTab = "oversikt")"><Icon Name="file-text" />Prosjektinfo</button>
        </nav>
    }

    <div class="pk-innhold">

    @if (!Id.HasValue || _activeTab == "oversikt")
    {
        <div class="prosjekt-layout">
            <section class="prosjekt-section">
                <h2>Prosjektinformasjon</h2>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Grunnleggende</p>
                    <div class="field-grid">
                        <label class="span-2">
                            Navn
                            <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Lillesand sparebank" disabled="@_erMobilvisning" />
                        </label>
                        <label>
                            Kunde
                            <select @bind="_form.KundeId" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var k in _kunder)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                        </label>
                        <label>System<input @bind="_form.System" placeholder="F.eks. PXP, iLOQ" disabled="@_erMobilvisning" /></label>
                        <label>
                            Prosjekttype
                            <select @bind="_form.Type" disabled="@_erMobilvisning">
                                @foreach (var t in Enum.GetValues<ProsjektType>())
                                {
                                    <option value="@t">@t.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                        <label>
                            Status
                            <select @bind="_form.Status" @bind:after="OnStatusEndret" disabled="@_erMobilvisning">
                                <option value="">Velg status...</option>
                                @foreach (var s in Enum.GetValues<ProsjektStatus>().Where(s => s != ProsjektStatus.Avsluttet))
                                {
                                    <option value="@s">@s.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                        @if (_form.Status == ProsjektStatus.Overlevert || _form.OverlevertDato.HasValue)
                        {
                            <label>
                                Overlevert dato
                                <input type="date" value="@_form.OverlevertDato?.ToString("yyyy-MM-dd")"
                                       @onchange="@(e => _form.OverlevertDato = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" disabled="@_erMobilvisning" />
                            </label>
                        }
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Adresse og kontakt</p>
                    <div class="field-grid">
                        <label>Adresse<input @bind="_form.Adresse" disabled="@_erMobilvisning" /></label>
                        <label>Post nr<input @bind="_form.Postnr" @bind:after="OppdaterStedFraPostnr" disabled="@_erMobilvisning" /></label>
                        <label>Sted<input @bind="_form.Sted" disabled="@_erMobilvisning" /></label>
                        <label>Kontaktperson<input @bind="_form.Kontaktperson" disabled="@_erMobilvisning" /></label>
                        <label>Telefon<input @bind="_form.Telefon" disabled="@_erMobilvisning" /></label>
                        <label>E-post<input @bind="_form.Epost" disabled="@_erMobilvisning" /></label>
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">CE-klassifisering</p>
                    <div class="field-grid">
                        <label>
                            Byggeregelverk (TEK)
                            <select @bind="_form.Tek" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var t in CeAlternativer.TekVersjoner)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </label>
                        <label>
                            Byggkategori (CE)
                            <select @bind="_form.Byggkategori" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var k in CeAlternativer.Byggkategorier)
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </label>
                        <label>
                            Risikoklasse (CE)
                            <select @bind="_form.Risikoklasse" disabled="@_erMobilvisning">
                                <option value="">Ikke satt</option>
                                @foreach (var r in CeAlternativer.Risikoklasser)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </label>
                        <label>
                            CE-gyldighet (standard)
                            <select @bind="_form.CeGyldighetMåneder" disabled="@_erMobilvisning">
                                @foreach (var m in CeAlternativer.GyldighetMånederAlternativer)
                                {
                                    <option value="@m">@m måneder</option>
                                }
                            </select>
                        </label>
                    </div>
                </div>

                <div class="skjema-seksjon">
                    <p class="skjema-seksjon-tittel">Notater</p>
                    <div class="field-grid">
                        <label class="span-2">
                            Interne notater
                            <textarea rows="3" @bind="_form.Notater" @bind:after="AutoLagre" disabled="@(_erMobilvisning || !KanRedigereProsjekt)"></textarea>
                        </label>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <p class="save-success">@_savedMessage</p>
            }

            <div class="form-actions">
                @if (KanRedigereProsjekt)
                {
                    <button type="button" class="save-button" @onclick="Lagre">
                        @(Id.HasValue ? "Lagre endringer" : "Lagre prosjekt")
                    </button>
                }
            </div>

            @* Sletting står i en egen boks nederst, langt unna Lagre, så den
               ikke trykkes ved et uhell. *@
            @if (Id.HasValue && !_erMobilvisning && KanRedigereProsjekt)
            {
                <div class="faresone">
                    <div class="faresone-tekst">
                        <strong>Slett prosjekt</strong>
                        <span>Sletter prosjektet med dører og plantegninger. Kan ikke angres.</span>
                    </div>
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker? Dette sletter også dører og plantegninger i prosjektet.
                            <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett prosjekt</button>
                    }
                </div>
            }
        </div>
    }
    else if (_activeTab == "status")
    {
        <div class="prosjekt-layout @(_erMobilvisning ? "" : "dashbord-layout")">
            @if (_erMobilvisning)
            {
                <div class="fullforing-boks">
                    <div class="fullforing-header">
                        <Icon Name="check-circle" />
                        <span class="status-label">Fullføringsgrad</span>
                    </div>
                    <div class="fremdrift-rad">
                        <span class="fremdrift-navn">Timer ferdig</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(TidsProsent)%"></div></div>
                        <span class="fremdrift-prosent">@TidsProsent%</span>
                    </div>
                    <div class="fremdrift-rad">
                        <span class="fremdrift-navn">Beslag montert</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(BeslagProsent)%"></div></div>
                        <span class="fremdrift-prosent">@BeslagProsent%</span>
                    </div>
                    <div class="fremdrift-rad fremdrift-rad-total">
                        <span class="fremdrift-navn">Totalt komplett</span>
                        <div class="fremdrift-bar"><div class="fremdrift-fyll" style="width:@(TotalProsent)%"></div></div>
                        <span class="fremdrift-prosent">@TotalProsent%</span>
                    </div>
                </div>
                <div class="mobil-status-kort">
                    <div class="mobil-status-rad">
                        <Icon Name="clock" />
                        <span class="mobil-status-label">Kalkulert tid</span>
                        <span class="mobil-status-verdi">@FormatTid(KalkulertMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="tool" />
                        <span class="mobil-status-label">Tidsforbruk</span>
                        <span class="mobil-status-verdi">@FormatTid(BruktMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="calendar" />
                        <span class="mobil-status-label">Gjenværende</span>
                        <span class="mobil-status-verdi">@FormatTid(GjenstaendeMontasjeMinutter)</span>
                    </div>
                    <div class="mobil-status-rad">
                        <Icon Name="trend-up" />
                        <span class="mobil-status-label">Fremdrift</span>
                        <span class="mobil-status-verdi">@AntallBeslagMontert/@AntallBeslagTotalt beslag</span>
                    </div>
                </div>
            }
            else
            {
                @* ---------- Oversikt (skrivebord) ----------
                   Faselinje, neste steg, nøkkeltall, plantegning, arbeidsordre
                   og aktivitet - alt er lesevisning med lenker videre til
                   fanene, der selve arbeidet gjøres som før. *@
                <div class="ov-faser">
                    @foreach (var f in Faser)
                    {
                        <button type="button" class="ov-fase @(f.Tilstand == "ok" ? "ov-fase-ok" : f.Tilstand == "na" ? "ov-fase-na" : "")" @onclick="@(() => _activeTab = f.Fane)">
                            <span class="ov-fase-topp">
                                <span>@f.Nr · @f.Navn</span>
                                @if (f.Tilstand == "ok")
                                {
                                    <span>✓</span>
                                }
                                else if (f.Tilstand == "na" && f.Prosent > 0 && f.Prosent < 100)
                                {
                                    <span>@f.Prosent %</span>
                                }
                            </span>
                            <b>@f.Tittel</b>
                            <small>@f.Tekst</small>
                            <span class="ov-fase-linje"><i style="width:@(f.Prosent)%"></i></span>
                        </button>
                    }
                </div>

                @if (NesteSteg is { } neste)
                {
                    <div class="ov-neste">
                        <span class="ov-neste-ikon"><Icon Name="sparkle" /></span>
                        <div class="ov-neste-tekst">
                            <small>Neste steg</small>
                            <b>@neste.Tittel</b>
                            <span>@neste.Tekst</span>
                        </div>
                        <button type="button" class="ph-knapp ph-knapp-primar" @onclick="@(() => _activeTab = neste.Fane)"><Icon Name="plus" />@neste.Knapp</button>
                    </div>
                }

                <div class="ov-kpi">
                    <div>
                        <small>Totalt komplett</small>
                        <b>@TotalProsent %</b>
                        <span>timer og beslag samlet</span>
                        <span class="ov-bar"><i class="ov-bar-gronn" style="width:@(TotalProsent)%"></i></span>
                    </div>
                    <div>
                        <small>Beslag montert</small>
                        <b>@AntallBeslagMontert / @AntallBeslagTotalt</b>
                        <span>@BeslagProsent %</span>
                        <span class="ov-bar"><i class="ov-bar-brun" style="width:@(BeslagProsent)%"></i></span>
                    </div>
                    <div>
                        <small>Montasjetid</small>
                        <b>@KortTid(BruktMontasjeMinutter)</b>
                        <span>brukt av @KortTid(KalkulertMontasjeMinutter) · @KortTid(GjenstaendeMontasjeMinutter) igjen</span>
                        <span class="ov-bar"><i class="ov-bar-bla" style="width:@(TidsProsent)%"></i></span>
                    </div>
                    <div>
                        <small>Tilbud</small>
                        @if (HovedTilbud is { } ht)
                        {
                            <b>@(ht.SendtSum.HasValue ? ht.SendtSum.Value.ToString("N0", NorskKultur) : ht.Status.Visningsnavn())</b>
                            <span>@(ht.SendtSum.HasValue ? "kr · " : "")@ht.Status.Visningsnavn().ToLowerInvariant()</span>
                            <span class="ov-bar"><i class="ov-bar-gul" style="width:@(ht.Status == EndringsmeldingStatus.Godkjent ? 100 : ht.Status == EndringsmeldingStatus.SendtTilKunde ? 60 : 25)%"></i></span>
                        }
                        else
                        {
                            <b>–</b>
                            <span>ikke laget ennå</span>
                            <span class="ov-bar"><i class="ov-bar-gul" style="width:0%"></i></span>
                        }
                    </div>
                </div>

                <div class="ov-grid">
                    <div class="ov-kol">
                        @if (OversiktTegning is { } tegning)
                        {
                            var ferdig = AntallDorer(MontasjeStatus.FerdigMontert);
                            var pagar = AntallDorer(MontasjeStatus.Montert);
                            var ikke = AntallDorer(MontasjeStatus.IkkeStartet);
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3><Icon Name="map" />@tegning.Navn</h3>
                                    <div class="ov-forklaring">
                                        <span><i class="ov-s-ferdig"></i>Ferdig @ferdig</span>
                                        <span><i class="ov-s-pagar"></i>Pågår @pagar</span>
                                        <span><i class="ov-s-ikke"></i>Ikke startet @ikke</span>
                                        <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "plantegninger")">Alle tegninger →</button>
                                    </div>
                                </div>
                                <div class="ov-plan">
                                    <img src="@($"/plantegningbilde/{tegning.Id}")" alt="@tegning.Navn" loading="lazy" />
                                    @foreach (var d in _dorer.Where(d => d.PlantegningId == tegning.Id && d.PosX.HasValue && d.PosY.HasValue))
                                    {
                                        var dorKlasse = d.Status switch { MontasjeStatus.FerdigMontert => "ferdig", MontasjeStatus.Montert => "pagar", _ => "ikke" };
                                        <button type="button" class="ov-pin" title="@($"{d.Dornummer} · {d.Status.Visningsnavn()}")"
                                                style="left:@(d.PosX!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(d.PosY!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                                                @onclick="@(() => TilDor(d))">
                                            <i class="ov-s-@dorKlasse"></i>@d.Dornummer
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                        else
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3><Icon Name="door" />Dørene</h3>
                                    <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "dorer")">Åpne dørlisten →</button>
                                </div>
                                @if (_dorer.Count == 0)
                                {
                                    <p class="ov-tom">Ingen dører registrert ennå.</p>
                                }
                                else
                                {
                                    <div class="ov-dorer">
                                        @foreach (var d in _dorer.OrderBy(d => d.Dornummer).Take(24))
                                        {
                                            var dorKlasse = d.Status switch { MontasjeStatus.FerdigMontert => "ferdig", MontasjeStatus.Montert => "pagar", _ => "ikke" };
                                            <button type="button" class="ov-dor ov-dor-@dorKlasse" title="@($"{d.Dornummer} · {d.Status.Visningsnavn()}")" @onclick="@(() => TilDor(d))">
                                                @d.Dornummer
                                                <small>@(d.Romnr ?? d.Etasje ?? "")</small>
                                            </button>
                                        }
                                    </div>
                                }
                            </section>
                        }

                        <section class="ov-kort">
                            <div class="ov-kort-topp">
                                <h3><Icon Name="tool" />Arbeidsordre på prosjektet</h3>
                                <a class="ov-lenke" href="/arbeidsordre">Alle →</a>
                            </div>
                            @if (_prosjektOrdre.Count == 0)
                            {
                                <p class="ov-tom">Ingen arbeidsordre på prosjektet ennå.</p>
                            }
                            else
                            {
                                <div class="ov-liste">
                                    @foreach (var a in _prosjektOrdre)
                                    {
                                        var st = OrdreStatus(a.Status);
                                        var under = string.Join(" · ", new[] { $"AO-{a.Id}", a.AnsvarligMontor?.Navn, a.PlanlagtDato?.ToString("d. MMM", NorskKultur) }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                        <div class="ov-rad">
                                            <span class="ov-rad-ikon @st.Klasse"><Icon Name="@(a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert ? "check" : a.Status == ArbeidsordreStatus.Pagaende ? "tool" : "calendar")" /></span>
                                            <span class="ov-rad-tekst"><b>@a.Tittel</b><span>@under</span></span>
                                            <span class="ov-rad-hoyre">
                                                <span class="ov-chip @st.Klasse">@(a.Status == ArbeidsordreStatus.Pagaende ? "● " : "")@st.Tekst</span>
                                                <a class="ph-knapp ph-knapp-liten" href="@($"/arbeidsordre/{a.Id}")">Åpne</a>
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        @if (SisteAktivitet.Count > 0)
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp"><h3><Icon Name="clock" />Siste aktivitet</h3></div>
                                <div class="ov-liste">
                                    @foreach (var a in SisteAktivitet)
                                    {
                                        var (ikon, klasse) = AktivitetIkon(a.Tekst);
                                        <div class="ov-rad">
                                            <span class="ov-rad-ikon @klasse"><Icon Name="@ikon" /></span>
                                            <span class="ov-rad-tekst"><b>@a.Tekst</b></span>
                                            <span class="ov-tid">@AktivitetTidTekst(a.Dato)</span>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <div class="ov-kol">
                        <section class="ov-kort">
                            <div class="ov-kort-topp">
                                <h3>Prosjektinfo</h3>
                                <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "oversikt")">@(KanRedigereProsjekt ? "Rediger" : "Vis alt")</button>
                            </div>
                            <div class="ov-info">
                                <div><span>Kunde</span><b>@(KundeNavn ?? "Ikke satt")</b></div>
                                <div><span>Kontakt</span><b>@(string.IsNullOrWhiteSpace(_form.Kontaktperson) ? "Ikke satt" : _form.Kontaktperson)</b></div>
                                <div><span>Telefon</span><b>@(string.IsNullOrWhiteSpace(_form.Telefon) ? "Ikke satt" : _form.Telefon)</b></div>
                                <div><span>System</span><b>@(string.IsNullOrWhiteSpace(_form.System) ? "Ikke satt" : _form.System)</b></div>
                                <div><span>Regelverk</span><b>@(string.IsNullOrWhiteSpace(_form.Tek) ? "Ikke satt" : _form.Tek)</b></div>
                                <div><span>Byggkategori</span><b>@(string.IsNullOrWhiteSpace(_form.Byggkategori) ? "Ikke satt" : _form.Byggkategori)</b></div>
                                <div><span>Risikoklasse</span><b>@(string.IsNullOrWhiteSpace(_form.Risikoklasse) ? "Ikke satt" : _form.Risikoklasse)</b></div>
                            </div>
                        </section>

                        <section class="ov-kort">
                            <div class="ov-kort-topp"><h3>Dokumentasjon</h3></div>
                            <div class="ov-liste">
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-gronn"><Icon Name="folder" /></span>
                                    <span class="ov-rad-tekst"><b>FDV</b><span>@(_lagredeFdvPdfer.Count > 0 ? $"{_lagredeFdvPdfer.Count} lagret" : "Ikke laget ennå")</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "fdv")">Lag</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-brun"><Icon Name="dokument-linjer" /></span>
                                    <span class="ov-rad-tekst"><b>Beslagsliste</b><span>@AntallBeslagTotalt beslag · @_dorer.Count dører</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "beslagsliste")">Lag</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon os-bla"><Icon Name="lock" /></span>
                                    <span class="ov-rad-tekst"><b>Låsplan</b><span>Sylindre og nøkler</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "lasplan")">Åpne</button>
                                </div>
                                <div class="ov-rad">
                                    <span class="ov-rad-ikon @(AntallBrannavvik > 0 ? "os-rod" : "os-gronn")"><Icon Name="alert-triangle" /></span>
                                    <span class="ov-rad-tekst"><b>Brannkontroll</b><span>@(AntallBrannavvik > 0 ? $"{AntallBrannavvik} avvik å se på" : "Ingen avvik")</span></span>
                                    <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _activeTab = "dorer")">Se</button>
                                </div>
                            </div>
                        </section>

                        @if (_form.Medlemmer.Count > 0)
                        {
                            <section class="ov-kort">
                                <div class="ov-kort-topp">
                                    <h3>Personer</h3>
                                    @if (!SkjulteFaner.Contains("personer"))
                                    {
                                        <button type="button" class="ov-lenke" @onclick="@(() => _activeTab = "personer")">Alle →</button>
                                    }
                                </div>
                                <div class="ov-personer">
                                    @foreach (var m in _form.Medlemmer.OrderByDescending(m => m.Id == _form.ProsjektlederId).ThenByDescending(m => m.Id == _form.AnsvarligMontorId).Take(5))
                                    {
                                        var rolleTekst = m.Id == _form.ProsjektlederId ? "Prosjektleder" : m.Id == _form.AnsvarligMontorId ? "Ansvarlig montør" : m.Rolle.Visningsnavn();
                                        <div class="ov-person">
                                            <span class="ov-avatar" style="background:@AvatarFarge(m.Navn)">@Initialer(m.Navn)</span>
                                            <span>@m.Navn<small>@rolleTekst</small></span>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "dorer")
    {
        <div class="dorer-layout">
            <div class="dorer-list-wrap p5-dorer">
                @if (!_erMobilvisning)
                {
                    @* P6: søk, statusknapper og knappene på én linje over tabellen. *@
                    <div class="p5-topp">
                        <label class="p5-sok"><Icon Name="search" /><input @bind="_dorSok" @bind:event="oninput" placeholder="Søk dørnummer, rom …" /></label>
                        <button type="button" class="p5-chip @(DorChip == "" ? "pa" : "")" @onclick='@(() => VelgDorChip(""))'>Alle <em>@_dorer.Count</em></button>
                        <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.FerdigMontert) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.FerdigMontert)))">Ferdig <em>@AntallDorer(MontasjeStatus.FerdigMontert)</em></button>
                        <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.Montert) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.Montert)))">Pågår <em>@AntallDorer(MontasjeStatus.Montert)</em></button>
                        <button type="button" class="p5-chip @(DorChip == nameof(MontasjeStatus.IkkeStartet) ? "pa" : "")" @onclick="@(() => VelgDorChip(nameof(MontasjeStatus.IkkeStartet)))">Ikke startet <em>@AntallDorer(MontasjeStatus.IkkeStartet)</em></button>
                        <button type="button" class="p5-chip @(DorChip == "brann" ? "pa" : "")" @onclick='@(() => VelgDorChip("brann"))'>Branndører <em>@_dorer.Count(d => !string.IsNullOrWhiteSpace(d.Brann))</em></button>
                        @if (DistinkteEtasjer.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorEtasjeFilter">
                                <option value="">Alle etasjer</option>
                                @foreach (var etasje in DistinkteEtasjer)
                                {
                                    <option value="@etasje">@etasje</option>
                                }
                            </select>
                        }
                        @if (DistinkteSoner.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorSoneFilter">
                                <option value="">Alle soner</option>
                                @foreach (var sone in DistinkteSoner)
                                {
                                    <option value="@sone">@sone</option>
                                }
                            </select>
                        }
                        @if (DistinkteByggetrinn.Skip(1).Any())
                        {
                            <select class="p5-velg" @bind="_dorByggetrinnFilter">
                                <option value="">Alle byggetrinn</option>
                                @foreach (var bt in DistinkteByggetrinn)
                                {
                                    <option value="@bt">@bt</option>
                                }
                            </select>
                        }
                        <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar p5-hoyre" @onclick="LeggTilDor"><Icon Name="plus" />Legg til dør</button>
                        <button type="button" class="ph-knapp ph-knapp-liten" @onclick="@(() => _visDorImport = true)">Importer dørskjema</button>
                    </div>
                }

                @if (_dorer.Count > 0 && !_erMobilvisning)
                {
                    <div class="pv-utvid-kort">
                    <div class="brannkontroll-panel @(_visBrannkontroll ? "apen" : "")">
                        <button type="button" class="brannkontroll-toggle" @onclick="@(() => _visBrannkontroll = !_visBrannkontroll)">
                            <span class="brannkontroll-toggle-ikon @(AntallBrannavvik > 0 ? "har-avvik" : "")">
                                <Icon Name="@(AntallBrannavvik > 0 ? "alert" : "check-circle")" />
                            </span>
                            <strong>Brannkontroll</strong>
                            <small class="pv-utvid-under">· EI-krav mot beslag på dørene</small>
                            @if (AntallBrannavvik > 0)
                            {
                                <span class="brannkontroll-badge">@AntallBrannavvik avvik</span>
                            }
                            else
                            {
                                <span class="brannkontroll-badge brannkontroll-badge-ok">Ingen avvik</span>
                            }
                            <span class="bytt-komponent-chevron"><Icon Name="chevron-down" /></span>
                        </button>
                        <div class="brannkontroll-body">
                            <p class="section-hint">
                                Enkel konsistenssjekk basert på registrerte brannklasser og dørfunksjoner i prosjektet
                                (@(string.IsNullOrWhiteSpace(_form.Tek) ? "byggeregelverk ikke satt" : _form.Tek)) - ikke en juridisk vurdering.
                                Sjekker selvlukkende-krav (C i brannklassen), rømningsvei/åpningskraft og sensor på
                                automatikk - se <a href="/guide/regelverk" target="_blank">Regelverk-guiden</a> for kildene.
                                Bruk som en påminnelse om å dobbeltsjekke, ikke et godkjentstempel.
                            </p>

                            @if (AntallBrannavvik == 0)
                            {
                                <p class="brannkontroll-ok"><Icon Name="check-circle" />Ingen avvik funnet i brannklasse/lukkefunksjon.</p>
                            }
                            else
                            {
                                @if (DorerManglerLukker.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Selvlukkende krav (C) uten lukkefunksjon (@DorerManglerLukker.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in DorerManglerLukker)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => SelectDoor(d))">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (RomningsveiManglerAutomatikk.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Rømningsvei med selvlukkende krav (C), men uten dørautomatikk - maks åpningskraft (@RomningsveiManglerAutomatikk.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in RomningsveiManglerAutomatikk)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => SelectDoor(d))">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (AutomatikkManglerSensor.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Dørautomatikk uten sikkerhetssensor (@AutomatikkManglerSensor.Count)</p>
                                        <div class="brannkontroll-liste">
                                            @foreach (var d in AutomatikkManglerSensor)
                                            {
                                                <button type="button" class="brannkontroll-chip" @onclick="@(() => SelectDoor(d))">@d.Dornummer</button>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (SonerMedUliktBrannkrav.Count > 0)
                                {
                                    <div class="brannkontroll-gruppe">
                                        <p class="brannkontroll-gruppe-tittel">Ulik brannklasse innad i samme sone</p>
                                        @foreach (var sone in SonerMedUliktBrannkrav)
                                        {
                                            <div class="brannkontroll-sone">
                                                <span class="brannkontroll-sone-navn">Sone @sone.Sone</span>
                                                <div class="brannkontroll-liste">
                                                    @foreach (var d in sone.Dorer)
                                                    {
                                                        <button type="button" class="brannkontroll-chip" @onclick="@(() => SelectDoor(d))">@d.Dornummer <span class="brannkontroll-chip-detalj">(@d.Brann)</span></button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="bytt-komponent-panel @(_visByttKomponent ? "apen" : "")">
                        <button type="button" class="bytt-komponent-toggle" @onclick="@(() => _visByttKomponent = !_visByttKomponent)">
                            <span class="bytt-komponent-toggle-ikon"><Icon Name="tool" /></span>
                            <strong>Bytt komponent på dører</strong>
                            <small class="pv-utvid-under">· f.eks. bytt sylinder på flere dører samtidig</small>
                            <span class="bytt-komponent-chevron"><Icon Name="chevron-down" /></span>
                        </button>
                        <div class="bytt-komponent-body">
                        <p class="section-hint">
                            Velg en komponent som er i bruk i prosjektet, hvilke dører den skal byttes på, og søk opp
                            erstatningen i komponentregisteret. Monteringsstatus nullstilles siden det er en ny fysisk del.
                        </p>

                        <div class="bytt-komponent-felt">
                            <select @bind="_byttGammelComponentId" @bind:after="OnByttGammelChanged">
                                <option value="">Velg komponent å bytte ut...</option>
                                @foreach (var k in KomponenterIBruk)
                                {
                                    <option value="@k.ComponentId">@k.Navn (@k.AntallDorer dør(er))</option>
                                }
                            </select>

                            <div class="bytt-sok-wrap">
                                <input @bind="_byttSok" @bind:event="oninput" @bind:after="OnByttSokChanged"
                                       placeholder="Bytt med – søk i komponentregisteret (navn, leverandør, produktkode)..." disabled="@(_byttGammelComponentId is null)" />
                                @if (_byttSearchResults.Count > 0)
                                {
                                    <ul class="search-results">
                                        @foreach (var r in _byttSearchResults)
                                        {
                                            <li>
                                                <button type="button" class="search-result" @onclick="@(() => VelgNyKomponent(r))">
                                                    <span class="search-result-name">@r.Navn</span>
                                                    <span class="search-result-meta">@r.Leverandor</span>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (_byttSok.Trim().Length >= 2)
                                {
                                    <span class="bytt-ingen-treff">Ingen treff i komponentregisteret.</span>
                                }
                            </div>
                        </div>

                        @if (_byttGammelComponentId is not null)
                        {
                            var dorerMedGammel = _dorer.Where(d => d.Komponenter.Any(dk => dk.ComponentId == _byttGammelComponentId)).OrderBy(d => d.Dornummer).ToList();
                            <div class="bytt-dorvalg">
                                <div class="bytt-dorvalg-topp">
                                    <strong>Velg dører</strong>
                                    <span class="bytt-dorvalg-antall">@_byttValgteDorer.Count av @dorerMedGammel.Count valgt</span>
                                    <button type="button" class="bytt-dorvalg-lenke" @onclick="@(() => { _byttValgteDorer = dorerMedGammel.Select(d => d.Id).ToHashSet(); _confirmingBytte = false; })">Alle</button>
                                    <button type="button" class="bytt-dorvalg-lenke" @onclick="@(() => { _byttValgteDorer.Clear(); _confirmingBytte = false; })">Ingen</button>
                                </div>
                                <div class="bytt-dorvalg-liste">
                                    @foreach (var d in dorerMedGammel)
                                    {
                                        var valgt = _byttValgteDorer.Contains(d.Id);
                                        <label @key="d.Id" class="bytt-dor @(valgt ? "valgt" : "")">
                                            <input type="checkbox" checked="@valgt" @onchange="@(() => { if (!_byttValgteDorer.Remove(d.Id)) _byttValgteDorer.Add(d.Id); _confirmingBytte = false; })" />
                                            <b>@d.Dornummer</b>
                                            @if (!string.IsNullOrWhiteSpace(d.DorTil))
                                            {
                                                <span>@d.DorTil</span>
                                            }
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        @if (_byttNyKomponentNavn is not null)
                        {
                            <p class="section-hint">Ny komponent: <strong>@_byttNyKomponentNavn</strong></p>

                            @if (!_confirmingBytte)
                            {
                                <button type="button" class="save-button" disabled="@(AntallDorerMedValgtKomponent == 0)" @onclick="@(() => _confirmingBytte = true)">
                                    Bytt ut på @AntallDorerMedValgtKomponent dør(er)
                                </button>
                            }
                            else
                            {
                                <span class="delete-confirm">
                                    Er du sikker? Dette kan ikke angres.
                                    <button type="button" class="delete-confirm-button" @onclick="ByttKomponentOveralt">Ja, bytt ut</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingBytte = false)">Avbryt</button>
                                </span>
                            }
                        }

                        @if (!string.IsNullOrEmpty(_byttMelding))
                        {
                            <p class="save-success">@_byttMelding</p>
                        }
                        </div>
                    </div>
                    </div>
                }

                @if (_dorer.Count == 0)
                {
                    @* Knappene for å legge til / importere står i overskriften. *@
                    <p class="list-empty">Ingen dører registrert ennå.</p>
                }
                else
                {
                    @if (_erMobilvisning)
                    {
                        <div class="dorer-filter-bar">
                            <div class="dorer-filter-bar-venstre">
                            <label class="dorer-sok-felt">
                                <Icon Name="search" />
                                <input class="dorer-filter-sok" @bind="_dorSok" @bind:event="oninput" placeholder="Søk på dørnummer, etasje, sone, rom..." />
                            </label>
                            <select @bind="_dorStatusFilter">
                                <option value="">Alle statuser</option>
                                <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                            </select>
                            </div>
                            <span class="dorer-filter-count">@FiltrerteDorer.Count av @_dorer.Count dører</span>
                        </div>
                    }

                    @if (FiltrerteDorer.Count == 0)
                    {
                        <p class="list-empty p5-tom">Ingen dører matcher filteret. <button type="button" class="p5-lenke" @onclick="@(() => { NullstillDorFilter(); VelgDorChip(""); })">Nullstill filter</button></p>
                    }
                    else
                    {
                        @* Begge visninger rendres alltid - ren CSS (@media, ikke server-side
                           _erMobilvisning) avgjør hvilken som vises. Dørlisten sluttet å dukke
                           opp på mobil gjentatte ganger med server-valgt gren (avhengig av at
                           JS-interop-deteksjonen rekker å slå til) - CSS-breddevalg kan ikke
                           havne fast i "feil" tilstand på samme måte, siden nettleseren
                           reevaluerer det løpende ut fra faktisk vindusbredde. *@
                        <div class="mobil-dorer-kort-liste">
                            @foreach (var d in FiltrerteDorer)
                            {
                                <div @key="d.Id" class="mobil-dor-kort mobil-kant-@d.Status.PillFarge()" @onclick="@(() => SelectDoor(d))">
                                    <div class="mobil-dor-kort-info">
                                        <span class="mobil-dor-kort-navn">@d.Dornummer</span>
                                        <span class="mobil-dor-kort-meta">@d.Etasje / @d.Sone</span>
                                    </div>
                                    <select class="status-select @StatusSelectClass(d.Status)" value="@d.Status" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs e) => EndreStatus(d, e))">
                                        <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                        <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                        <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                                    </select>
                                </div>
                            }
                        </div>

                    <div class="dorer-table-wrap p5-tabwrap">
                        <table class="p5-tab">
                            <thead>
                                <tr><th>Dør</th><th>Rom</th><th>Etasje</th><th>Brann</th><th>Beslag</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in FiltrerteDorer)
                                {
                                    var dor = d;
                                    var beslagTotalt = d.Komponenter.Sum(k => k.Antall);
                                    var beslagMontert = d.Komponenter.Where(k => k.Montert).Sum(k => k.Antall);
                                    var dorFarge = d.Status switch { MontasjeStatus.FerdigMontert => "#2e7d4f", MontasjeStatus.Montert => "#d4892b", _ => "#c9bda9" };
                                    <tr @key="d.Id" class="@(_selectedDoor?.Id == d.Id ? "dorer-row-selected" : "")" @onclick="@(() => SelectDoor(dor))">
                                        <td><b>@d.Dornummer</b></td>
                                        <td>@(string.IsNullOrWhiteSpace(d.Romnr) ? (d.Plantegning?.Navn ?? "–") : d.Romnr)</td>
                                        <td>@(string.IsNullOrWhiteSpace(d.Etasje) ? "–" : d.Etasje)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(d.Brann))
                                            {
                                                <span class="p5-smule">–</span>
                                            }
                                            else
                                            {
                                                <span class="p5-pill s-rod">@d.Brann</span>
                                            }
                                        </td>
                                        <td><span class="p5-rad"><span class="p5-bar p5-bar-90"><i style="width:@Andel(beslagMontert, beslagTotalt)%;background:@dorFarge"></i></span><span class="p5-smule">@beslagMontert/@beslagTotalt</span></span></td>
                                        <td>
                                            <select class="p5-statusvelger @DorStatusPill(d.Status)" value="@d.Status" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs e) => EndreStatus(dor, e))">
                                                <option value="@MontasjeStatus.IkkeStartet">Ikke startet</option>
                                                <option value="@MontasjeStatus.Montert">Pågår</option>
                                                <option value="@MontasjeStatus.FerdigMontert">Ferdig</option>
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                }
            </div>

            @if (_selectedDoor is not null)
            {
                <div class="dor-modal-overlay">
                    <div class="dor-modal-panel">
                        @if (!_erMobilvisning)
                        {
                            // Dørvinduet er dørsiden (S13) - redigering ligger i fanene Detaljer og Beslag.
                            var forrigeDor = NaboDor(-1);
                            var nesteDor = NaboDor(1);
                            <DorDetalj Id="_selectedDoor.Id"
                                       IModal="true"
                                       MedRedigering="true"
                                       StartFane="@(_selectedDoor.Id == _nyDorId ? "detaljer" : null)"
                                       AlleDorer="_dorer"
                                       OnLukk="@(() => _selectedDoor = null)"
                                       OnDeleted="OnDoorDeleted"
                                       OnUnplaced="OnDoorUnplaced"
                                       OnCloned="OnDoorsCloned"
                                       OnSaved="StateHasChanged"
                                       OnForrige="ByttDorCallback(forrigeDor)"
                                       OnNeste="ByttDorCallback(nesteDor)"
                                       ForrigeNavn="@forrigeDor?.Dornummer"
                                       NesteNavn="@nesteDor?.Dornummer" />
                        }
                        else
                        {
                            <DorRedigering Dor="_selectedDoor"
                                            AlleDorer="_dorer"
                                            ProsjektOverlevertDato="_form.OverlevertDato"
                                            ErMobilvisning="_erMobilvisning"
                                            OnClose="@(() => _selectedDoor = null)"
                                            OnDeleted="OnDoorDeleted"
                                            OnUnplaced="OnDoorUnplaced"
                                            OnCloned="OnDoorsCloned"
                                            OnSaved="StateHasChanged" />
                        }
                    </div>
                </div>
            }

            @if (_visDorImport && Id.HasValue)
            {
                <DorImportModal ProsjektId="Id.Value" OnClose="@(() => _visDorImport = false)" OnImportert="OnDorerImportert" />
            }
        </div>
    }
    else if (_activeTab == "plantegninger")
    {
        <div class="prosjekt-layout plantegninger-layout">
            @if (!_erMobilvisning)
            {
                <div class="p5-topp">
                    <span class="p5-smule">Klikk en tegning for å plassere og åpne dører.</span>
                    <input class="p5-inp p5-hoyre" type="text" @bind="_nyPlantegningNavn" @bind:event="oninput" placeholder="Navn, f.eks. 1. etasje (valgfritt)" />
                    <input class="p5-inp" type="text" @bind="_nyPlantegningByggetrinn" @bind:event="oninput" placeholder="Byggetrinn (valgfritt)" />
                    <label class="ph-knapp ph-knapp-liten ph-knapp-primar">
                        <Icon Name="plus" />Last opp plantegning
                        <InputFile @key="_plantegningInputKey" OnChange="OnPlantegningSelected" accept="image/*,.pdf,application/pdf" style="display:none;" />
                    </label>
                </div>

                @if (_uploadingPlantegning)
                {
                    <p class="list-empty">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_plantegningFeil))
                {
                    <p class="form-error">@_plantegningFeil</p>
                }
            }

            @if (_plantegninger.Count > 0)
            {
                @if (_erMobilvisning)
                {
                    <div class="mobil-plantegning-liste">
                        @foreach (var gruppe in PlantegningGrupper)
                        {
                            <div @key="gruppe.Navn" class="mobil-plantegning-gruppe">
                                <button type="button" class="mobil-plantegning-gruppe-header" @onclick="@(() => ToggleGruppe(gruppe.Navn))">
                                    <Icon Name="folder" />
                                    <span class="mobil-plantegning-gruppe-navn">@gruppe.Navn</span>
                                    <span class="mobil-plantegning-gruppe-count">@gruppe.Plantegninger.Count etasje@(gruppe.Plantegninger.Count == 1 ? "" : "r")</span>
                                    <span class="mobil-plantegning-chevron @(ErGruppeLukket(gruppe.Navn) ? "" : "apen")">
                                        <Icon Name="chevron-down" />
                                    </span>
                                </button>
                                @if (!ErGruppeLukket(gruppe.Navn))
                                {
                                    <div class="mobil-plantegning-kort-liste">
                                        @foreach (var p in gruppe.Plantegninger)
                                        {
                                            <a @key="p.Id" class="mobil-plantegning-kort" href="@($"/plantegning/{p.Id}")">
                                                <img class="mobil-plantegning-thumb" src="@($"/plantegningbilde/{p.Id}")" alt="" loading="lazy" />
                                                <span class="mobil-plantegning-kort-info">
                                                    <span class="mobil-plantegning-kort-navn">@p.Navn</span>
                                                    @{ var antallDorer = DorerPaPlantegning(p.Id); }
                                                    <span class="mobil-plantegning-kort-meta">@antallDorer dør@(antallDorer == 1 ? "" : "er")</span>
                                                </span>
                                                <span class="mobil-plantegning-kort-pil">
                                                    <Icon Name="chevron-down" />
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    @foreach (var gruppe in PlantegningGrupper)
                    {
                        <div @key="gruppe.Navn" class="plantegning-gruppe p5-tegngruppe @(PlantegningGrupper.Count() > 1 ? "" : "p5-en-gruppe")">
                            <div class="plantegning-gruppe-header">
                                <button type="button" class="gruppe-toggle" @onclick="@(() => ToggleGruppe(gruppe.Navn))">
                                    <span class="gruppe-chevron @(ErGruppeLukket(gruppe.Navn) ? "" : "apen")"><Icon Name="chevron-down" /></span>
                                    <span class="@CssHidden(_editingGruppe == gruppe.Navn)">@gruppe.Navn <span class="gruppe-count">@gruppe.Plantegninger.Count tegning@(gruppe.Plantegninger.Count == 1 ? "" : "er")</span></span>
                                </button>
                                <span class="gruppe-rename-form @CssHidden(_editingGruppe != gruppe.Navn)">
                                    <input @bind="_gruppeRenameInput" @bind:event="oninput" placeholder="Gruppenavn" />
                                    <button type="button" class="save-button" @onclick="@(() => LagreGruppeNavn(gruppe.Navn))">Lagre</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _editingGruppe = null)">Avbryt</button>
                                </span>
                                <button type="button" class="gruppe-rename-button @CssHidden(_editingGruppe == gruppe.Navn)" @onclick="@(() => StartGruppeRename(gruppe.Navn))">Endre navn</button>
                            </div>
                            <div class="p5-tegn @CssHidden(ErGruppeLukket(gruppe.Navn))">
                                @foreach (var p in gruppe.Plantegninger)
                                {
                                    <div @key="p.Id" class="p5-tg">
                                        <a class="p5-tg-bilde" href="@($"/plantegning/{p.Id}")">
                                            <img src="@($"/plantegningbilde/{p.Id}")" alt="" loading="lazy" />
                                        </a>
                                        <div class="p5-tg-info">
                                            <a href="@($"/plantegning/{p.Id}")"><b>@p.Navn</b></a>
                                            @{ var antallDorer = DorerPaPlantegning(p.Id); }
                                            <span class="p5-smule">@antallDorer dør@(antallDorer == 1 ? "" : "er")@(string.IsNullOrWhiteSpace(p.Byggetrinn) ? "" : $" · {p.Byggetrinn}")</span>
                                        </div>
                                        <div class="p5-tg-handling">
                                            @if (AlleGruppeNavn.Count() > 1)
                                            {
                                                <select class="plantegning-flytt" @onchange="@(e => FlyttPlantegning(p, e.Value?.ToString()))">
                                                    <option value="">Flytt til...</option>
                                                    @foreach (var g in AlleGruppeNavn.Where(g => g != gruppe.Navn))
                                                    {
                                                        <option value="@g">@g</option>
                                                    }
                                                </select>
                                            }
                                            <button type="button" class="ikon-btn-fjern" title="Fjern" @onclick="@(() => RemovePlantegning(p))"><Icon Name="x" /></button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p class="list-empty">Ingen plantegninger lastet opp ennå.</p>
            }
        </div>
    }
    else if (_activeTab == "vedlegg")
    {
        <div class="prosjekt-layout vedlegg-layout">
            @if (!_mappeApnet)
            {
                <div class="p5-topp">
                    <label class="p5-sok">
                        <Icon Name="search" />
                        <input @bind="_vedleggSok" @bind:event="oninput" placeholder="Søk mappe eller fil" />
                    </label>
                    <button type="button" class="p5-chip pa">Alle <em>@SynligeVedleggMapper.Sum(g => g.Filer.Count)</em></button>
                    <input class="p5-inp p5-hoyre" @bind="_nyMappeNavn" @bind:event="oninput"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettMappe(); } })"
                           placeholder="Navn på ny mappe" />
                    <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="OpprettMappe"><Icon Name="plus" />Ny mappe</button>
                </div>

                @if (!string.IsNullOrEmpty(_vedleggFeil))
                {
                    <p class="form-error">@_vedleggFeil</p>
                }

                @if (SynligeVedleggMapper.Count == 0)
                {
                    <p class="list-empty">@(string.IsNullOrWhiteSpace(_vedleggSok) ? "Ingen mapper opprettet ennå. Lag den første over." : "Ingen treff på søket.")</p>
                }
                else
                {
                    <div class="p5-tegn">
                        @foreach (var gruppe in SynligeVedleggMapper)
                        {
                            <button type="button" @key="@(gruppe.MappeId?.ToString() ?? "ukategorisert")"
                                    class="p5-tg p5-mappe" @onclick="@(() => ApneMappe(gruppe.MappeId))">
                                <span class="p5-tg-bilde p5-mappe-ikon"><Icon Name="folder" /></span>
                                <span class="p5-tg-info"><b>@gruppe.Navn</b><span class="p5-smule">@gruppe.Filer.Count fil@(gruppe.Filer.Count == 1 ? "" : "er")</span></span>
                            </button>
                        }
                    </div>
                }

                @if (SynligeKoblingsskjemaer.Count > 0)
                {
                    <section class="p5-seksjon">
                        <h4>Koblingsskjema</h4>
                        <div class="p5-liste">
                            @foreach (var k in SynligeKoblingsskjemaer)
                            {
                                <a class="p5-lr" @key="k.Id" href="@($"/koblingsskjema/{k.Id}")">
                                    <span class="p5-ik"><Icon Name="file-text" /></span>
                                    <span><b>@k.Navn</b></span>
                                    <span class="p5-smule">@(k.Kategori?.Navn ?? "-")</span>
                                </a>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                var gruppe = VedleggGruppert.FirstOrDefault(g => g.MappeId == _apenMappeId) ?? new VedleggMappeGruppe(_apenMappeId, "Ukategorisert", []);

                <button type="button" class="back-link vedlegg-tilbake" @onclick="LukkMappe">← Tilbake til mapper</button>

                <div class="vedlegg-mappe-detalj-header">
                    @if (gruppe.MappeId.HasValue && _redigererMappeId == gruppe.MappeId)
                    {
                        <div class="vedlegg-mappe-detalj-tittel vedlegg-mappe-detalj-tittel-rediger">
                            <span class="vedlegg-panel-ikon"><Icon Name="folder" /></span>
                            <input class="vedlegg-mappe-rediger-input" @bind="_redigerMappeNavn" @bind:event="oninput"
                                   @onkeydown="@(async e => { if (e.Key == "Enter") { await LagreMappeNavn(gruppe.MappeId!.Value); } })" autofocus />
                            <button type="button" class="icon-button" title="Lagre navn" @onclick="@(() => LagreMappeNavn(gruppe.MappeId!.Value))"><Icon Name="check-circle" /></button>
                            <button type="button" class="icon-button" title="Avbryt" @onclick="@(() => _redigererMappeId = null)"><Icon Name="x" /></button>
                        </div>
                    }
                    else
                    {
                        <div class="vedlegg-mappe-detalj-tittel">
                            <span class="vedlegg-panel-ikon"><Icon Name="folder" /></span>
                            <h2>@gruppe.Navn</h2>
                            <span class="vedlegg-mappe-kort-antall">@gruppe.Filer.Count</span>
                        </div>
                        <div class="vedlegg-mappe-kort-handlinger">
                            @if (gruppe.MappeId.HasValue)
                            {
                                <button type="button" class="cancel-button vedlegg-handling-btn" @onclick="@(() => StartRedigerMappe(gruppe))"><Icon Name="edit" />Gi nytt navn</button>
                            }
                            @if (gruppe.MappeId.HasValue)
                            {
                                @if (_sletterMappeId == gruppe.MappeId)
                                {
                                    <span class="fjern-bekreft">
                                        Slett mappe?
                                        <button type="button" class="remove-button" @onclick="@(() => SlettMappe(gruppe.MappeId!.Value))">Ja</button>
                                        <button type="button" class="cancel-button" @onclick="@(() => _sletterMappeId = null)">Avbryt</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="cancel-button vedlegg-handling-btn vedlegg-handling-btn-slett" @onclick="@(() => _sletterMappeId = gruppe.MappeId)"><Icon Name="trash" />Slett mappe</button>
                                }
                            }
                        </div>
                    }
                </div>

                <label class="vedlegg-dropzone">
                    <span class="vedlegg-dropzone-ikon"><Icon Name="upload" /></span>
                    <span class="vedlegg-dropzone-tekst">
                        <strong>Last opp filer</strong>
                        <span>Dra og slipp, eller velg fra maskinen din</span>
                    </span>
                    <span class="add-button vedlegg-dropzone-knapp">Velg filer</span>
                    <InputFile OnChange="@(e => LastOppVedlegg(e, gruppe.MappeId))" multiple />
                </label>

                @if (_uploadingVedlegg)
                {
                    <p class="list-empty">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_vedleggFeil))
                {
                    <p class="form-error">@_vedleggFeil</p>
                }

                @if (gruppe.Filer.Count == 0)
                {
                    <div class="vedlegg-mappe-tom">
                        <Icon Name="file-text" />
                        <p>Ingen filer i denne mappen ennå.</p>
                    </div>
                }
                else
                {
                    <div class="vedlegg-tabell-kort">
                        <table class="vedlegg-fil-tabell p5-tab">
                            <thead>
                                <tr>
                                    <th>Navn</th>
                                    <th>Størrelse</th>
                                    <th>Lastet opp</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in gruppe.Filer)
                                {
                                    <tr @key="v.Id">
                                        <td class="vedlegg-fil-navn-celle">
                                            <span class="vedlegg-fil-ikon"><Icon Name="@FilIkon(v.ContentType)" /></span>
                                            <button type="button" class="vedlegg-fil-lenke" @onclick="@(() => VisForhandsvisning(v))">@v.Filnavn</button>
                                        </td>
                                        <td class="vedlegg-tabell-meta">@FormatFilstorrelse(v.Data.Length)</td>
                                        <td class="vedlegg-tabell-meta">@v.OpprettetDato.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (_mapper.Count > 0)
                                            {
                                                <select class="vedlegg-flytt-velger" @onchange="@(e => FlyttVedleggTil(v, e.Value))">
                                                    <option value="">Flytt til...</option>
                                                    @if (gruppe.MappeId is not null)
                                                    {
                                                        <option value="ukategorisert">Ukategorisert</option>
                                                    }
                                                    @foreach (var m in _mapper.Where(m => m.Id != gruppe.MappeId))
                                                    {
                                                        <option value="@m.Id">@m.Navn</option>
                                                    }
                                                </select>
                                            }
                                        </td>
                                        <td class="vedlegg-tabell-handling"><button type="button" class="icon-button icon-button-slett" title="Fjern" @onclick="@(() => RemoveVedlegg(v))"><Icon Name="trash" /></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_forhandsvistVedlegg is not null)
            {
                <div class="vedlegg-forhandsvisning-overlay" @onclick="LukkForhandsvisning">
                    <div class="vedlegg-forhandsvisning-panel" @onclick:stopPropagation="true">
                        <div class="vedlegg-forhandsvisning-header">
                            <h3>@_forhandsvistVedlegg.Filnavn</h3>
                            <button type="button" class="vedlegg-forhandsvisning-lukk" @onclick="LukkForhandsvisning">✕</button>
                        </div>
                        @if (_forhandsvistVedlegg.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@($"/prosjektvedlegg/{_forhandsvistVedlegg.Id}")" alt="@_forhandsvistVedlegg.Filnavn" class="vedlegg-forhandsvisning-bilde" />
                        }
                        else
                        {
                            <iframe src="@($"/prosjektvedlegg/{_forhandsvistVedlegg.Id}")" class="vedlegg-forhandsvisning-iframe" title="@_forhandsvistVedlegg.Filnavn"></iframe>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_activeTab == "tilbud")
    {
        <div class="prosjekt-layout tilbud-layout">
            <div class="p5-topp">
                <button type="button" class="p5-chip @(_tilbudChip == "" ? "pa" : "")" @onclick='@(() => _tilbudChip = "")'>Alle <em>@_tilbud.Count</em></button>
                @foreach (var st in new[] { EndringsmeldingStatus.Utkast, EndringsmeldingStatus.SendtTilKunde, EndringsmeldingStatus.Godkjent, EndringsmeldingStatus.Avslatt })
                {
                    var status = st;
                    var antall = _tilbud.Count(t => t.Status == status);
                    @if (antall > 0)
                    {
                        <button type="button" class="p5-chip @(_tilbudChip == status.ToString() ? "pa" : "")" @onclick="@(() => _tilbudChip = status.ToString())">@TilbudStatusTekst(status) <em>@antall</em></button>
                    }
                }
                @if (_tilbud.Any(x => x.Type == TilbudType.Tilbud))
                {
                    <select class="p5-velg p5-hoyre" @bind="_valgtOpprinneligTilbudId" title="Hvilket tilbud en ny endringsmelding gjelder">
                        <option value="">(ikke koblet til et bestemt tilbud)</option>
                        @foreach (var t in _tilbud.Where(x => x.Type == TilbudType.Tilbud))
                        {
                            <option value="@t.Id">Tillegg til: @t.Tittel</option>
                        }
                    </select>
                }
                <button type="button" class="ph-knapp ph-knapp-liten @(_tilbud.Any(x => x.Type == TilbudType.Tilbud) ? "" : "p5-hoyre")" @onclick="NyEndringsmelding">Ny endringsmelding / tillegg</button>
                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="NyttTilbud"><Icon Name="plus" />Nytt tilbud</button>
            </div>

            @if (_tilbud.Count > 0)
            {
                <table class="p5-tab">
                    <thead><tr><th>Tilbud</th><th>Type</th><th>Sendt</th><th class="h">Beløp</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var t in _tilbud.Where(t => _tilbudChip == "" || t.Status.ToString() == _tilbudChip))
                        {
                            var tilbud = t;
                            <tr @key="t.Id" @onclick="@(() => Nav.NavigateTo($"/tilbud/{tilbud.Id}"))">
                                <td><b>@t.Tittel</b><small>@(t.Type == TilbudType.Endringsmelding && t.OpprinneligTilbud is not null ? $"Tillegg til: {t.OpprinneligTilbud.Tittel}" : $"T-{t.OpprettetDato.Year}-{t.Id:000}")</small></td>
                                <td>@(t.Type == TilbudType.Endringsmelding ? "Endringsmelding" : "Hovedtilbud")</td>
                                <td>@(t.SendtDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                <td class="h p5-mono">@if (t.SendtSum is { } sum) {<b>@sum.ToString("N0", Kultur) kr</b>} else {<span class="p5-smule">–</span>}</td>
                                <td><span class="p5-pill @TilbudPill(t.Status)">@TilbudStatusTekst(t.Status)</span></td>
                                <td class="h"><button type="button" class="p5-ikonknapp" title="Slett" @onclick="@(() => RemoveTilbud(tilbud))" @onclick:stopPropagation="true"><Icon Name="trash" /></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="list-empty">Ingen tilbud opprettet ennå.</p>
            }
        </div>
    }
    else if (_activeTab == "okonomi" && Id.HasValue)
    {
        <div class="prosjekt-layout okonomi-layout">
            @if (_form.Status == ProsjektStatus.Overlevert)
            {
                <p class="okonomi-overlevert">Prosjektet er overlevert og ligger i <a href="@($"/etterkalkyle?prosjekt={Id}")">Etterkalkyle</a> for gjennomgang.</p>
            }
            <ProsjektOkonomiPanel ProsjektId="@Id.Value" />
        </div>
    }
    else if (_activeTab == "montering")
    {
        <div class="prosjekt-layout montering-layout">
            <div class="p5-tall4">
                <div><span class="p5-lbl">Kalkulert</span><b>@KortTid(TotaltMonteringMinutter)</b><small>fra dørene</small></div>
                <div><span class="p5-lbl">Brukt</span><b>@KortTid(BruktMontasjeMinutter)</b><small>@TidsProsent %</small></div>
                <div><span class="p5-lbl">Igjen</span><b>@KortTid(GjenstaendeMontasjeMinutter)</b><small>beslag som ikke er montert</small></div>
                <div><span class="p5-lbl">Beslag montert</span><b>@AntallBeslagMontert / @AntallBeslagTotalt</b><small>@BeslagProsent %</small></div>
            </div>
            <div class="p5-topp">
                <span class="p5-smule">Minutter per beslag hentes fra varene og synkes fra dørene.</span>
                @if (_monteringLinjer.Any(l => l.ComponentId.HasValue))
                {
                    <button type="button" class="ph-knapp ph-knapp-liten p5-hoyre" @onclick="HentMinutterForAlle">Hent minutter for alle</button>
                }
                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar @(_monteringLinjer.Any(l => l.ComponentId.HasValue) ? "" : "p5-hoyre")" @onclick="SynkMontering"><Icon Name="sparkle" />Synk fra dørene</button>
            </div>

            @if (!string.IsNullOrEmpty(_monteringSyncMessage))
            {
                <p class="save-success">@_monteringSyncMessage</p>
            }

            @if (_monteringLinjer.Count == 0)
            {
                <p class="list-empty p5-tom">Ingen varer lagt til ennå. Trykk «Synk fra dørene» for å hente inn alt som er registrert på dørene i prosjektet.</p>
            }
            else
            {
                <table class="p5-tab">
                    <thead>
                        <tr><th>Beslag</th><th class="c">Antall</th><th class="c">Montert</th><th class="h">Min/stk</th><th class="h">Totalt</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _monteringLinjer)
                        {
                            <tr @key="l.Id" class="p5-redig">
                                <td><b>@l.Navn</b>@if (!string.IsNullOrWhiteSpace(l.Enhet)) {<small>@l.Enhet</small>}</td>
                                <td class="c"><input class="p5-inp-flat" @bind="l.Antall" @bind:after="LagreMontering" /></td>
                                <td class="c">@MontertForVare(l.ComponentId)</td>
                                <td class="h"><input class="p5-inp-flat" @bind="l.Minutter" @bind:after="LagreMontering" placeholder="min" /></td>
                                <td class="h p5-mono"><b>@KortTid((l.Minutter ?? 0) * l.Antall)</b></td>
                                <td class="h p5-nowrap">
                                    @if (l.ComponentId.HasValue)
                                    {
                                        <button type="button" class="p5-ikonknapp" title="Hent minutt fra vare" @onclick="@(() => HentMinuttFraVare(l))"><Icon Name="clock" /></button>
                                    }
                                    <button type="button" class="p5-ikonknapp" title="Fjern" @onclick="@(() => FjernMonteringLinje(l))"><Icon Name="x" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_activeTab == "fdv")
    {
        <div class="prosjekt-layout fdv-layout">
            <div class="p5-dokk">
                <div class="p5-dk">
                    <span class="p5-di s-ok"><Icon Name="file-text" /></span>
                    <div><b>FDV-dokumentasjon</b><small>@(_lagredeFdvPdfer.Count > 0 ? $"{_lagredeFdvPdfer.Count} lagret" : "Ikke generert ennå") · @_dorer.Count dører, @AntallBeslagTotalt beslag</small></div>
                    <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="GenererFdv" disabled="@(FdvKomponenterFiltrert.Count == 0 && _fdvVedlegg.Count == 0)">Generer FDV</button>
                </div>
                <div class="p5-dk">
                    <span class="p5-di s-gra"><Icon Name="folder" /></span>
                    <div><b>Produktdatablad</b><small>@FdvKomponenterFiltrert.Count vare@(FdvKomponenterFiltrert.Count == 1 ? "" : "r") har FDV-ark · @_fdvVedlegg.Count ekstra PDF</small></div>
                </div>
            </div>
            @if (_lagredeFdvPdfer.Count == 0)
            {
                <span class="p5-smule">Lagrede versjoner vises her når FDV er generert.</span>
            }

            @* To kolonner: forsiden til venstre, varer, vedlegg og lagrede PDF-er til høyre. *@
            <div class="pv-to-kol">
            <div class="pv-stabel">
            <div class="fdv-panel">
                <div class="fdv-panel-header">
                    <span class="fdv-panel-ikon"><Icon Name="file-text" /></span>
                    <h2>Forside</h2>
                </div>
                <div class="field-grid">
                    <label class="span-2">
                        Forside-mal
                        <div class="forside-mal-rad">
                            <select @bind="_valgtFdvForsideMalId">
                                <option value="">Velg forside...</option>
                                @foreach (var f in _forsideMaler)
                                {
                                    <option value="@f.Id">@f.Navn</option>
                                }
                            </select>
                            <button type="button" class="cancel-button" @onclick="BrukFdvForsideMal" disabled="@(_valgtFdvForsideMalId is null)">Bruk</button>
                        </div>
                    </label>

                    <label class="span-2">
                        Forside / forbehold
                        <ForsideTekstRedigering @bind-Value="_form.FdvForside" Rows="8" Placeholder="Tekst til forsiden av FDV-samlingen." />
                    </label>
                </div>

                <div class="form-actions">
                    <button type="button" class="save-button" @onclick="LagreFdvForside">Lagre forside</button>
                    @if (!string.IsNullOrEmpty(_savedMessage))
                    {
                        <span class="save-success">@_savedMessage</span>
                    }
                </div>
            </div>
            </div>

            <div class="pv-stabel">
            <div class="fdv-panel">
                <div class="fdv-panel-header">
                    <span class="fdv-panel-ikon"><Icon Name="folder" /></span>
                    <h2>Varer med FDV-dokumentasjon</h2>
                </div>

                @if (_byggetrinnListe.Count > 1)
                {
                    <div class="fdv-byggetrinn-chips">
                        <span class="fdv-byggetrinn-lbl">Byggetrinn</span>
                        <button type="button" class="fdv-chip @(_valgteByggetrinn.Count == 0 ? "aktiv" : "")" @onclick="@(() => VelgAlleByggetrinn(true))">Alle</button>
                        @foreach (var b in _byggetrinnListe)
                        {
                            <button type="button" class="fdv-chip @(_valgteByggetrinn.Contains(b) ? "aktiv" : "")" @onclick="@(() => ToggleByggetrinn(b, !_valgteByggetrinn.Contains(b)))">@b</button>
                        }
                    </div>
                }

                @if (FdvKomponenterFiltrert.Count > 0)
                {
                    <div class="fdv-komponent-liste">
                        @foreach (var k in FdvKomponenterFiltrert)
                        {
                            <div @key="k.Id" class="fdv-komponent-rad">
                                <span class="fdv-komponent-ikon"><Icon Name="check-circle" /></span>
                                <span class="fdv-komponent-navn">@k.Navn</span>
                                <span class="fdv-komponent-kode">@k.Produktkode</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="list-empty">Ingen av varene på prosjektets dører har FDV-dokumentasjon registrert ennå.</p>
                }
            </div>

            <div class="fdv-panel">
                <div class="fdv-panel-header">
                    <span class="fdv-panel-ikon"><Icon Name="folder" /></span>
                    <h2>Ekstra PDF-vedlegg</h2>
                </div>
                <p class="section-hint">Legg til en PDF (f.eks. for en vare uten registrert FDV) som blir med når du genererer FDV for prosjektet.</p>

                @if (_fdvVedlegg.Count > 0)
                {
                    <div class="fdv-fil-liste">
                        @foreach (var v in _fdvVedlegg)
                        {
                            <div @key="v.Id" class="fdv-fil-rad">
                                <span class="fdv-fil-ikon"><Icon Name="file-text" /></span>
                                <span class="fdv-fil-navn">@v.Navn</span>
                                <button type="button" class="icon-button" title="Fjern" @onclick="@(() => RemoveFdvVedlegg(v))"><Icon Name="x" /></button>
                            </div>
                        }
                    </div>
                }

                <label class="fdv-dropzone">
                    <span class="fdv-dropzone-ikon"><Icon Name="upload" /></span>
                    <span class="fdv-dropzone-tekst">
                        <strong>Last opp PDF-vedlegg</strong>
                        <span>Dra og slipp, eller velg fra maskinen din</span>
                    </span>
                    <InputFile OnChange="OnFdvVedleggSelected" accept="application/pdf" multiple />
                </label>
                @if (_uploadingFdvVedlegg)
                {
                    <p class="list-empty">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_fdvVedleggFeil))
                {
                    <p class="form-error">@_fdvVedleggFeil</p>
                }
            </div>


            <div class="fdv-panel">
                <div class="fdv-panel-header">
                    <span class="fdv-panel-ikon"><Icon Name="folder" /></span>
                    <h2>Lagrede PDF-er</h2>
                </div>
                <LagredePdfListe Pdfer="_lagredeFdvPdfer" />
            </div>
            </div>
            </div>

            <PdfPreviewModal Url="@_fdvPreviewUrl" Tittel="Forhåndsvisning av FDV" SaveMessage="@_fdvPdfSavedMessage"
                              OnSave="LagreFdvPdf" OnClose="@(() => _fdvPreviewUrl = null)" />
        </div>
    }
    else if (_activeTab == "dorid")
    {
        <div class="prosjekt-layout dorid-layout">
            <div class="p5-topp">
                <span class="p5-smule">Gjenbrukbare dørspesifikasjoner som kan hentes inn på dørene.</span>
                <input class="p5-inp p5-hoyre" @bind="_nyDorIdKode" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_nyDorIdKode)) { await OpprettDorIdMal(); } })"
                       placeholder="Dør-ID, f.eks. A.YD100-N" />
                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="OpprettDorIdMal" disabled="@string.IsNullOrWhiteSpace(_nyDorIdKode)"><Icon Name="plus" />Opprett Dør-ID</button>
            </div>


            @if (_dorIdMaler.Count > 0)
            {
                <div class="dorid-tabell-kort">
                    <div class="dorid-tabell-scroll">
                        <table class="dorid-table p5-tab">
                            <thead>
                                <tr>
                                    <th>Dør ID</th>
                                    <th>Brann</th>
                                    <th>Lyd</th>
                                    <th>Fri bredde (min 0,86m)</th>
                                    <th>Bredde (mm)</th>
                                    <th>Høyde (mm)</th>
                                    <th>Dørtype</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in _dorIdMaler)
                                {
                                    <tr @key="m.Id" class="@("dorid-rad" + (_apneDorIdDetaljer.Contains(m.Id) ? " apen" : ""))">
                                        <td><input class="dorid-cell-input dorid-kode-input" @bind="m.Kode" /></td>
                                        <td><input class="dorid-cell-input" @bind="m.Brann" /></td>
                                        <td><input class="dorid-cell-input" @bind="m.Lyd" /></td>
                                        <td>
                                            <select class="dorid-cell-input @FriBreddePillKlasse(m.FriBredde086)" value="@FriBreddeValue(m.FriBredde086)" @onchange="@(e => m.FriBredde086 = ParseFriBredde(e))">
                                                <option value="">Ikke satt</option>
                                                <option value="Ja">Ja</option>
                                                <option value="Nei">Nei</option>
                                            </select>
                                        </td>
                                        <td><input @bind="m.Bredde" class="dorid-cell-input dorid-tall-input" /></td>
                                        <td><input @bind="m.Hoyde" class="dorid-cell-input dorid-tall-input" /></td>
                                        <td><input class="dorid-cell-input" @bind="m.Dortype" /></td>
                                        <td>
                                            <div class="dorid-handling-rad">
                                                <button type="button" class="dorid-chevron-btn @(_apneDorIdDetaljer.Contains(m.Id) ? "apen" : "")" @onclick="@(() => ToggleDorIdDetaljer(m.Id))">@(_apneDorIdDetaljer.Contains(m.Id) ? "Skjul" : "Detaljer")<Icon Name="chevron-down" /></button>
                                                <button type="button" class="icon-button icon-button-slett" title="Slett" @onclick="@(() => SlettDorIdMal(m))"><Icon Name="trash" /></button>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (_apneDorIdDetaljer.Contains(m.Id))
                                    {
                                        <tr @key="@($"{m.Id}-detaljer")" class="dorid-detaljer-row">
                                            <td colspan="8">
                                                <div class="dorid-detalj-panel">
                                                    <div class="dorid-seksjon-tittel">Dørspesifikasjon</div>
                                                    <div class="dorid-detaljer-form">
                                                        <label>Farge karm <input @bind="m.FargeKarm" /></label>
                                                        <label>
                                                            Dør konstruksjon
                                                            <select @bind="m.Dorkonstruksjon">
                                                                <option value="">Ikke satt</option>
                                                                @foreach (var k in CeAlternativer.Konstruksjoner)
                                                                {
                                                                    <option value="@k">@k</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>Farge dørblad <input @bind="m.FargeDorblad" /></label>
                                                        <label>Karmtype <input @bind="m.Karmtype" /></label>
                                                        <label>
                                                            Karmkonstruksjon
                                                            <select @bind="m.Karmkonstruksjon">
                                                                <option value="">Ikke satt</option>
                                                                @foreach (var k in CeAlternativer.Konstruksjoner)
                                                                {
                                                                    <option value="@k">@k</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>Terskel <input @bind="m.Terskel" /></label>
                                                        <label>Sparkeplate <input @bind="m.Sparkeplate" /></label>
                                                        <label>A mål <input @bind="m.AMal" class="dorid-tall-input" /></label>
                                                        <label>B mål <input @bind="m.BMal" class="dorid-tall-input" /></label>
                                                        <label>
                                                            Glass i dør
                                                            <select value="@FriBreddeValue(m.GlassIDor)" @onchange="@(e => m.GlassIDor = ParseFriBredde(e))">
                                                                <option value="">Ikke satt</option>
                                                                <option value="Ja">Ja</option>
                                                                <option value="Nei">Nei</option>
                                                            </select>
                                                        </label>
                                                        <label class="span-2">Merknad dør id <textarea rows="2" @bind="m.Merknad"></textarea></label>
                                                    </div>
                                                    <div class="dorid-ce-boks">
                                                        <span class="dorid-ce-tittel"><Icon Name="check-circle" />CE godkjenning info</span>
                                                        <div class="dorid-detaljer-form">
                                                            <label>
                                                                Dørblad
                                                                <select @bind="m.CeDorblad">
                                                                    <option value="">Velg...</option>
                                                                    @foreach (var d in CeAlternativer.DorbladAlternativer)
                                                                    {
                                                                        <option value="@d">@d</option>
                                                                    }
                                                                </select>
                                                            </label>
                                                            <label>
                                                                Glasstykkelse eller dørtype
                                                                <select @bind="m.CeGlasstykkelse">
                                                                    <option value="">Velg...</option>
                                                                    @foreach (var g in CeAlternativer.GlasstykkelseAlternativer)
                                                                    {
                                                                        <option value="@g">@g</option>
                                                                    }
                                                                </select>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="save-button" @onclick="LagreDorIdMaler">Lagre endringer</button>
                    @if (!string.IsNullOrEmpty(_dorIdMessage))
                    {
                        <span class="save-success">@_dorIdMessage</span>
                    }
                </div>
            }
            else
            {
                <p class="list-empty">Ingen Dør ID opprettet ennå. Opprett den første over.</p>
            }
        </div>
    }
    else if (_activeTab == "personer" && _naverendeRolle != BrukerRolle.Montor)
    {
        <div class="prosjekt-layout personer-layout">
            <div class="p5-topp">
                <span class="p5-smule">Personer med tilgang til prosjektet. Admin og prosjektledere har alltid tilgang.</span>
                <select class="p5-velg p5-hoyre" @bind="_valgtNyttMedlemId">
                    <option value="">Velg person...</option>
                    @foreach (var b in TilgjengeligeBrukere)
                    {
                        <option value="@b.Id">@b.Navn (@b.Rolle.Visningsnavn())</option>
                    }
                </select>
                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="LeggTilMedlem" disabled="@(_valgtNyttMedlemId is null)"><Icon Name="plus" />Legg til person</button>
            </div>

            @if (_form.Medlemmer.Count > 0)
            {
                @* Personene til venstre, nøkkelrollene til høyre. *@
                <div class="pv-to-kol pv-to-kol-smal">
                <div class="p5-liste">
                    @foreach (var m in _form.Medlemmer)
                    {
                        var rolleTekst = _form.ProsjektlederId == m.Id ? "Prosjektleder" : _form.AnsvarligMontorId == m.Id ? "Ansvarlig montør" : m.Rolle.Visningsnavn();
                        var rolleKlasse = _form.ProsjektlederId == m.Id ? "s-lilla" : _form.AnsvarligMontorId == m.Id ? "s-bla" : "s-gra";
                        <div @key="m.Id" class="p5-lr">
                            <span class="p5-av" style="background:@PersonFarge(m.Navn);">@PersonInitialer(m.Navn)</span>
                            <span><b>@m.Navn</b><small>@m.Epost</small></span>
                            <span class="p5-rad">
                                <span class="p5-pill @rolleKlasse">@rolleTekst</span>
                                <button type="button" class="p5-ikonknapp" title="Fjern" @onclick="@(() => FjernMedlem(m))"><Icon Name="x" /></button>
                            </span>
                        </div>
                    }
                </div>

                <div class="personer-panel">
                    <div class="personer-panel-header">
                        <span class="personer-panel-ikon"><Icon Name="check-circle" /></span>
                        <h2>Nøkkelroller</h2>
                    </div>
                    <div class="nokkelrolle-grid">
                        <label>
                            Prosjektleder
                            <select value="@(_form.ProsjektlederId?.ToString() ?? "")" @onchange="EndreProsjektleder">
                                <option value="">Ikke satt</option>
                                @foreach (var m in _form.Medlemmer)
                                {
                                    <option value="@m.Id">@m.Navn</option>
                                }
                            </select>
                        </label>
                        <label>
                            Ansvarlig montør
                            <select value="@(_form.AnsvarligMontorId?.ToString() ?? "")" @onchange="EndreAnsvarligMontor">
                                <option value="">Ikke satt</option>
                                @foreach (var m in _form.Medlemmer)
                                {
                                    <option value="@m.Id">@m.Navn</option>
                                }
                            </select>
                        </label>
                    </div>
                </div>
                </div>
            }
            else
            {
                <p class="list-empty">Ingen personer lagt til ennå.</p>
            }
        </div>
    }
    else if (_activeTab == "beslagsliste")
    {
        <div class="prosjekt-layout beslagsliste-layout">
            <div class="p5-topp">
                <span class="p5-smule">Én PDF-side per dør med dørinfo, dørfunksjoner og beslag.</span>
                <a class="ph-knapp ph-knapp-liten p5-hoyre" href="@($"/prosjekt/{Id}/plukkliste")">Åpne plukkliste</a>
                <a class="ph-knapp ph-knapp-liten" href="@($"/prosjekt/{Id}/produktsammendrag")">Produktsammendrag</a>
                <button type="button" class="ph-knapp ph-knapp-liten ph-knapp-primar" @onclick="GenererBeslagsliste">Generer beslagsliste</button>
            </div>

            @* Beslagene til venstre, lagrede PDF-er til høyre. *@
            <div class="pv-to-kol">
            <div class="pv-stabel">
            @if (BeslagOppsummering.Count == 0)
            {
                <p class="list-empty p5-tom">Ingen beslag registrert på dørene ennå.</p>
            }
            else
