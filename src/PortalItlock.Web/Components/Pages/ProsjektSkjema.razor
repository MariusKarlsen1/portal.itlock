            </p>
            <a class="add-button" href="@($"/prosjekt/{Id}/lasplan")">Åpne låsplan</a>
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private Prosjekt _form = new() { Navn = "" };
    private List<Dor> _dorer = [];
    private Dor? _selectedDoor;
    private string _dorSok = "";
    private string _dorEtasjeFilter = "";
    private string _dorSoneFilter = "";

    private sealed class KomponentIBrukOption
    {
        public int ComponentId { get; set; }
        public string Navn { get; set; } = "";
        public int AntallDorer { get; set; }
    }

    private sealed class ByttSearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
    }

    private int? _byttGammelComponentId;
    private int? _byttNyKomponentId;
    private string? _byttNyKomponentNavn;
    private string _byttSok = "";
    private List<ByttSearchResult> _byttSearchResults = [];
    private bool _confirmingBytte;
    private string? _byttMelding;

    private List<KomponentIBrukOption> KomponenterIBruk => _dorer
        .SelectMany(d => d.Komponenter)
        .Where(dk => dk.Component is not null)
        .GroupBy(dk => dk.ComponentId)
        .Select(g => new KomponentIBrukOption
        {
            ComponentId = g.Key,
            Navn = g.First().Component!.Navn,
            AntallDorer = g.Select(dk => dk.DorId).Distinct().Count()
        })
        .OrderBy(k => k.Navn)
        .ToList();

    private int AntallDorerMedValgtKomponent => _byttGammelComponentId is null
        ? 0
        : _dorer.Count(d => d.Komponenter.Any(dk => dk.ComponentId == _byttGammelComponentId));

    private void OnByttGammelChanged()
    {
        _byttNyKomponentId = null;
        _byttNyKomponentNavn = null;
        _byttSok = "";
        _byttSearchResults = [];
        _confirmingBytte = false;
        _byttMelding = null;
    }

    private async Task OnByttSokChanged()
    {
        var term = _byttSok.Trim();
        if (term.Length < 2)
        {
            _byttSearchResults = [];
            return;
        }

        _byttSearchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new ByttSearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor })
            .ToListAsync();
    }

    private void VelgNyKomponent(ByttSearchResult r)
    {
        _byttNyKomponentId = r.Id;
        _byttNyKomponentNavn = r.Navn;
        _byttSok = "";
        _byttSearchResults = [];
    }

    private async Task ByttKomponentOveralt()
    {
        if (_byttGammelComponentId is null || _byttNyKomponentId is null)
        {
            return;
        }

        var gammelId = _byttGammelComponentId.Value;
        var nyId = _byttNyKomponentId.Value;
        var nyComponent = await Db.Components.FindAsync(nyId);
        var antallOppdatert = 0;

        foreach (var dor in _dorer)
        {
            var gammel = dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == gammelId);
            if (gammel is null)
            {
                continue;
            }

            var eksisterendeNy = dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == nyId);
            if (eksisterendeNy is not null)
            {
                eksisterendeNy.Antall += gammel.Antall;
            }
            else
            {
                var nyDk = new DorKomponent
                {
                    DorId = dor.Id,
                    ComponentId = nyId,
                    Component = nyComponent,
                    Antall = gammel.Antall,
                    Enhet = gammel.Enhet,
                    LevertAv = gammel.LevertAv
                };
                dor.Komponenter.Add(nyDk);
                Db.DorKomponenter.Add(nyDk);
            }

            dor.Komponenter.Remove(gammel);
            Db.DorKomponenter.Remove(gammel);
            antallOppdatert++;
        }

        await Db.SaveChangesAsync();
        if (antallOppdatert > 0)
        {
            await TilbudSync.SyncSylinderAsync(Id!.Value, nyId);
        }
        _byttMelding = $"Byttet ut komponent på {antallOppdatert} dør(er).";
        _byttGammelComponentId = null;
        _byttNyKomponentId = null;
        _byttNyKomponentNavn = null;
        _confirmingBytte = false;
    }

    private List<string> DistinkteEtasjer =>
        _dorer.Select(d => d.Etasje).Where(e => !string.IsNullOrWhiteSpace(e)).Distinct().OrderBy(e => e).ToList()!;

    private List<string> DistinkteSoner =>
        _dorer.Select(d => d.Sone).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s).ToList()!;

    private List<Dor> FiltrerteDorer => _dorer.Where(d =>
        (string.IsNullOrWhiteSpace(_dorEtasjeFilter) || d.Etasje == _dorEtasjeFilter) &&
        (string.IsNullOrWhiteSpace(_dorSoneFilter) || d.Sone == _dorSoneFilter) &&
        MatcherDorSok(d, _dorSok)).ToList();

    private static bool MatcherDorSok(Dor d, string sok)
    {
        if (string.IsNullOrWhiteSpace(sok))
        {
            return true;
        }

        var s = sok.Trim();
        return (d.Dornummer?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Etasje?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Sone?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.DorTil?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.Romnr?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void NullstillDorFilter()
    {
        _dorSok = "";
        _dorEtasjeFilter = "";
        _dorSoneFilter = "";
    }
    private List<Plantegning> _plantegninger = [];

    private IEnumerable<(string Navn, List<Plantegning> Plantegninger)> PlantegningGrupper =>
        _plantegninger
            .GroupBy(p => string.IsNullOrWhiteSpace(p.Byggetrinn) ? "Ugruppert" : p.Byggetrinn!.Trim())
            .OrderBy(g => g.Key == "Ugruppert" ? 1 : 0)
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.OrderBy(p => p.Navn).ToList()));

    private IEnumerable<string> AlleGruppeNavn => PlantegningGrupper.Select(g => g.Navn);

    private string _nyPlantegningNavn = "";
    private string _nyPlantegningByggetrinn = "";
    private bool _uploadingPlantegning;
    private string? _plantegningFeil;
    private int _plantegningInputKey;
    private (string Navn, long Storrelse, DateTime Tidspunkt)? _sisteOpplasting;
    private readonly SemaphoreSlim _plantegningUploadLock = new(1, 1);
    private string? _editingGruppe;
    private string _gruppeRenameInput = "";
    private readonly HashSet<string> _lukkedeGrupper = [];

    private bool ErGruppeLukket(string navn) => _lukkedeGrupper.Contains(navn);

    private void ToggleGruppe(string navn)
    {
        if (!_lukkedeGrupper.Add(navn))
        {
            _lukkedeGrupper.Remove(navn);
        }
    }

    private static string CssHidden(bool skjult) => skjult ? "skjult" : "";
    private List<ProsjektVedlegg> _vedlegg = [];
    private List<KoblingsSkjema> _koblingsskjemaer = [];
    private string _valgtVedleggType = "";

    private static readonly string[] StandardVedleggMapper = ["Kravspek", "Grunnlag", "Tilbud", "Prosjekt", "Sikkerhetsskjema", "Bestillingsskjema", "Låsplan", "Annet"];

    private List<IGrouping<string, ProsjektVedlegg>> VedleggGruppert => _vedlegg
        .GroupBy(v => string.IsNullOrWhiteSpace(v.Type) ? "Ukategorisert" : v.Type!)
        .OrderBy(g => g.Key == "Ukategorisert" ? 1 : 0)
        .ThenBy(g => g.Key)
        .ToList();

    private List<string> VedleggMapperForslag => StandardVedleggMapper
        .Concat(_vedlegg.Where(v => !string.IsNullOrWhiteSpace(v.Type)).Select(v => v.Type!))
        .Distinct()
        .OrderBy(m => m)
        .ToList();
    private bool _uploadingVedlegg;
    private string? _vedleggFeil;
    private List<Tilbud> _tilbud = [];
    private string _valgtOpprinneligTilbudId = "";
    private List<string> _byggetrinnListe = [];
    private HashSet<string> _valgteByggetrinn = [];
    private List<Component> FdvKomponenterFiltrert => _dorer
        .Where(d => _valgteByggetrinn.Count == 0 || (d.Plantegning?.Byggetrinn is not null && _valgteByggetrinn.Contains(d.Plantegning.Byggetrinn)))
        .SelectMany(d => d.Komponenter)
        .Select(dk => dk.Component!)
        .Where(c => c.FdvData != null)
        .DistinctBy(c => c.Id)
        .OrderBy(c => c.Navn)
        .ToList();
    private string? _fdvPreviewUrl;
    private List<FdvVedlegg> _fdvVedlegg = [];
    private bool _uploadingFdvVedlegg;
    private string? _fdvVedleggFeil;
    private List<Kunde> _kunder = [];
    private List<DorIdMal> _dorIdMaler = [];
    private readonly HashSet<int> _apneDorIdDetaljer = [];
    private string _nyDorIdKode = "";
    private string? _dorIdMessage;
    private string _activeTab = "oversikt";
    private bool _notFound;
    private bool _ingenTilgang;
    private bool _confirmingDelete;
    private int? _loadedId;
    private bool _hasLoaded;
    private string? _error;
    private string? _savedMessage;
    private List<Bruker> _alleBrukere = [];
    private int? _valgtNyttMedlemId;
    private string? _beslagslistePreviewUrl;
    private List<LagretPdf> _lagredeFdvPdfer = [];
    private string? _fdvPdfSavedMessage;
    private List<LagretPdf> _lagredeBeslagslistePdfer = [];
    private string? _beslagslistePdfSavedMessage;
    private List<TilbudForside> _forsideMaler = [];
    private int? _valgtFdvForsideMalId;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
