@page "/prosjekter/ny"
@page "/prosjekter/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using SkiaSharp
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</PageTitle>

@if (_ingenTilgang)
{
    <p class="form-error">Du har ikke tilgang til dette prosjektet.</p>
}
else if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else
{
    <h1>@(Id.HasValue ? _form.Navn : "Nytt prosjekt")</h1>

    @if (Id.HasValue)
    {
        <nav class="prosjekt-tabs">
            <button type="button" class="@TabClass("oversikt")" @onclick="@(() => _activeTab = "oversikt")">Oversikt</button>
            <button type="button" class="@TabClass("status")" @onclick="@(() => _activeTab = "status")">Status</button>
            <button type="button" class="@TabClass("dorer")" @onclick="@(() => _activeTab = "dorer")">Dører</button>
            <button type="button" class="@TabClass("plantegninger")" @onclick="@(() => _activeTab = "plantegninger")">Plantegninger</button>
            <button type="button" class="@TabClass("vedlegg")" @onclick="@(() => _activeTab = "vedlegg")">Vedlegg</button>
            <button type="button" class="@TabClass("tilbud")" @onclick="@(() => _activeTab = "tilbud")">Tilbud</button>
            <button type="button" class="@TabClass("dorid")" @onclick="@(() => _activeTab = "dorid")">Dør ID</button>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="@TabClass("personer")" @onclick="@(() => _activeTab = "personer")">Personer</button>
            }
            <button type="button" class="@TabClass("info")" @onclick="@(() => _activeTab = "info")">Prosjektinformasjon</button>
        </nav>
    }

    @if (!Id.HasValue || _activeTab == "oversikt")
    {
        <div class="prosjekt-layout">
            <section class="prosjekt-section">
                <h2>Prosjektinformasjon</h2>
                <div class="field-grid">
                    <label class="span-2">
                        Navn
                        <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Lillesand sparebank" />
                    </label>
                    <label>
                        Kunde
                        <select @bind="_form.KundeId">
                            <option value="">Ikke satt</option>
                            @foreach (var k in _kunder)
                            {
                                <option value="@k.Id">@k.Navn</option>
                            }
                        </select>
                    </label>
                    <label>System<input @bind="_form.System" placeholder="F.eks. PXP, iLOQ" /></label>
                    <label>
                        Status
                        <select @bind="_form.Status">
                            <option value="">Velg status...</option>
                            @foreach (var s in Enum.GetValues<ProsjektStatus>())
                            {
                                <option value="@s">@s.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    <label>Adresse<input @bind="_form.Adresse" /></label>
                    <label>Post nr<input @bind="_form.Postnr" /></label>
                    <label>Sted<input @bind="_form.Sted" /></label>
                    <label>Kontaktperson<input @bind="_form.Kontaktperson" /></label>
                    <label>Telefon<input @bind="_form.Telefon" /></label>
                    <label>E-post<input @bind="_form.Epost" /></label>
                    <label class="span-2">
                        Notater
                        <textarea rows="3" @bind="_form.Notater"></textarea>
                    </label>
                </div>
            </section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <p class="save-success">@_savedMessage</p>
            }

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">
                    @(Id.HasValue ? "Lagre endringer" : "Lagre prosjekt")
                </button>

                @if (Id.HasValue)
                {
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker? Dette sletter også dører og plantegninger i prosjektet.
                            <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett prosjekt</button>
                    }
                }
            </div>
        </div>
    }
    else if (_activeTab == "status")
    {
        <div class="prosjekt-layout">
            <div class="status-grid">
                <div class="status-card">
                    <span class="status-label">Kalkulert montasjetid</span>
                    <span class="status-value">@FormatTid(KalkulertMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <span class="status-label">Total tidsforbruk</span>
                    <span class="status-value">@FormatTid(BruktMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <span class="status-label">Estimert gjenværende montasjetid</span>
                    <span class="status-value">@FormatTid(GjenstaendeMontasjeMinutter)</span>
                </div>
                <div class="status-card">
                    <span class="status-label">Fremdrift</span>
                    <span class="status-value">@AntallBeslagMontert/@AntallBeslagTotalt <span class="status-unit">beslag</span></span>
                </div>
            </div>
            <p class="section-hint">Basert på montasjetid registrert per vare i Komponentregisteret og hvilke beslag som er krysset av som montert på prosjektets dører.</p>
        </div>
    }
    else if (_activeTab == "dorer")
    {
        <div class="dorer-layout">
            <div class="dorer-list-wrap">
                <button type="button" class="add-button" @onclick="LeggTilDor">Legg til dør</button>

                @if (_dorer.Count == 0)
                {
                    <p class="list-empty">Ingen dører registrert ennå.</p>
                }
                else
                {
                    <table class="dorer-table">
                        <thead>
                            <tr>
                                <th>Dørnummer</th>
                                <th>Etasje</th>
                                <th>Sone</th>
                                <th>Plassering</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _dorer)
                            {
                                <tr @key="d.Id" class="@(_selectedDoor?.Id == d.Id ? "dorer-row-selected" : "")">
                                    <td>@d.Dornummer</td>
                                    <td>@d.Etasje</td>
                                    <td>@d.Sone</td>
                                    <td>@(d.Plantegning?.Navn ?? "Ikke plassert")</td>
                                    <td>
                                        <select class="status-select @StatusSelectClass(d.Status)" value="@d.Status" @onchange="@((ChangeEventArgs e) => EndreStatus(d, e))">
                                            <option value="@MontasjeStatus.IkkeStartet">@MontasjeStatus.IkkeStartet.Visningsnavn()</option>
                                            <option value="@MontasjeStatus.Montert">@MontasjeStatus.Montert.Visningsnavn()</option>
                                            <option value="@MontasjeStatus.FerdigMontert">@MontasjeStatus.FerdigMontert.Visningsnavn()</option>
                                        </select>
                                    </td>
                                    <td><button type="button" class="remove-button" @onclick="@(() => SelectDoor(d))">Rediger</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (_selectedDoor is not null)
            {
                <DorRedigering Dor="_selectedDoor"
                                OnClose="@(() => _selectedDoor = null)"
                                OnDeleted="OnDoorDeleted"
                                OnUnplaced="OnDoorUnplaced"
                                OnSaved="StateHasChanged" />
            }
        </div>
    }
    else if (_activeTab == "plantegninger")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Last opp plantegninger og plasser dører på dem for å følge opp montasje.</p>

            @if (_plantegninger.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var p in _plantegninger)
                    {
                        <li @key="p.Id" class="vedlegg-item">
                            <a href="@($"/plantegning/{p.Id}")">@p.Navn</a>
                            <span class="vedlegg-type">@(string.IsNullOrWhiteSpace(p.Byggetrinn) ? "Ugruppert" : p.Byggetrinn)</span>
                            <button type="button" class="remove-button" @onclick="@(() => RemovePlantegning(p))">Fjern</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="list-empty">Ingen plantegninger lastet opp ennå.</p>
            }

            <div class="vedlegg-upload">
                <input @bind="_nyPlantegningNavn" @bind:event="oninput" placeholder="Navn, f.eks. 1. etasje" />
                <input @bind="_nyPlantegningByggetrinn" @bind:event="oninput" placeholder="Byggetrinn (valgfritt)" />
                <InputFile OnChange="OnPlantegningSelected" accept="image/*,.pdf,application/pdf" />
            </div>

            @if (_uploadingPlantegning)
            {
                <p class="list-empty">Laster opp...</p>
            }
            @if (!string.IsNullOrEmpty(_plantegningFeil))
            {
                <p class="form-error">@_plantegningFeil</p>
            }
        </div>
    }
    else if (_activeTab == "vedlegg")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Sikkerhetsskjema, bestillingsskjema, låsplan og annen dokumentasjon som tilhører prosjektet.</p>

            @if (_vedlegg.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var v in _vedlegg)
                    {
                        <li @key="v.Id" class="vedlegg-item">
                            <a href="@($"/prosjektvedlegg/{v.Id}")" target="_blank">@v.Filnavn</a>
                            <span class="vedlegg-type">@(string.IsNullOrWhiteSpace(v.Type) ? "Ukategorisert" : v.Type)</span>
                            <button type="button" class="remove-button" @onclick="@(() => RemoveVedlegg(v))">Fjern</button>
                        </li>
                    }
                </ul>
            }

            <div class="vedlegg-upload">
                <select @bind="_valgtVedleggType">
                    <option value="">Velg type</option>
                    <option value="Sikkerhetsskjema">Sikkerhetsskjema</option>
                    <option value="Bestillingsskjema">Bestillingsskjema</option>
                    <option value="Låsplan">Låsplan</option>
                    <option value="Annet">Annet</option>
                </select>
                <InputFile OnChange="OnVedleggSelected" multiple />
            </div>

            @if (_uploadingVedlegg)
            {
                <p class="list-empty">Laster opp...</p>
            }
            @if (!string.IsNullOrEmpty(_vedleggFeil))
            {
                <p class="form-error">@_vedleggFeil</p>
            }
        </div>
    }
    else if (_activeTab == "tilbud")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Lag tilbud basert på varene som er registrert på prosjektets dører.</p>

            @if (_tilbud.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var t in _tilbud)
                    {
                        <li @key="t.Id" class="vedlegg-item">
                            <a href="@($"/tilbud/{t.Id}")">@t.Tittel</a>
                            <span class="vedlegg-type">@t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                            <button type="button" class="remove-button" @onclick="@(() => RemoveTilbud(t))">Slett</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="list-empty">Ingen tilbud opprettet ennå.</p>
            }

            <button type="button" class="add-button" @onclick="NyttTilbud">Nytt tilbud</button>
        </div>
    }
    else if (_activeTab == "dorid")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Lag gjenbrukbare dørspesifikasjoner (Dør ID) som kan hentes inn på dørene i prosjektet.</p>

            @if (_dorIdMaler.Count > 0)
            {
                <table class="dorid-table">
                    <thead>
                        <tr>
                            <th>Dør ID</th>
                            <th>Brann</th>
                            <th>Lyd</th>
                            <th>Fri bredde (min 0,86m)</th>
                            <th>Bredde (mm)</th>
                            <th>Høyde (mm)</th>
                            <th>Dørtype</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _dorIdMaler)
                        {
                            <tr @key="m.Id">
                                <td><input @bind="m.Kode" /></td>
                                <td><input @bind="m.Brann" /></td>
                                <td><input @bind="m.Lyd" /></td>
                                <td>
                                    <select value="@FriBreddeValue(m.FriBredde086)" @onchange="@(e => m.FriBredde086 = ParseFriBredde(e))">
                                        <option value="">Ikke satt</option>
                                        <option value="Ja">Ja</option>
                                        <option value="Nei">Nei</option>
                                    </select>
                                </td>
                                <td><input @bind="m.Bredde" class="dorid-tall-input" /></td>
                                <td><input @bind="m.Hoyde" class="dorid-tall-input" /></td>
                                <td><input @bind="m.Dortype" /></td>
                                <td><button type="button" class="remove-button" @onclick="@(() => SlettDorIdMal(m))">Slett</button></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="form-actions">
                    <button type="button" class="save-button" @onclick="LagreDorIdMaler">Lagre endringer</button>
                    @if (!string.IsNullOrEmpty(_dorIdMessage))
                    {
                        <span class="save-success">@_dorIdMessage</span>
                    }
                </div>
            }
            else
            {
                <p class="list-empty">Ingen Dør ID opprettet ennå.</p>
            }

            <div class="new-dorid">
                <h2>Ny Dør ID</h2>
                <div class="new-dorid-form">
                    <input @bind="_nyDorIdKode" @bind:event="oninput" placeholder="Dør ID, f.eks. A.YD100-N" />
                    <button type="button" class="add-button" @onclick="OpprettDorIdMal" disabled="@string.IsNullOrWhiteSpace(_nyDorIdKode)">Opprett</button>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "personer" && _naverendeRolle != BrukerRolle.Montor)
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Legg til personer som skal ha tilgang til å åpne dette prosjektet. Admin og prosjektledere har alltid tilgang til alle prosjekter.</p>

            @if (_form.Medlemmer.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var m in _form.Medlemmer)
                    {
                        <li @key="m.Id" class="vedlegg-item">
                            <span>@m.Navn <span class="vedlegg-type">@m.Rolle.Visningsnavn()</span></span>
                            <button type="button" class="remove-button" @onclick="@(() => FjernMedlem(m))">Fjern</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="list-empty">Ingen personer lagt til ennå.</p>
            }

            <div class="vedlegg-upload">
                <select @bind="_valgtNyttMedlemId">
                    <option value="">Velg person...</option>
                    @foreach (var b in TilgjengeligeBrukere)
                    {
                        <option value="@b.Id">@b.Navn (@b.Rolle.Visningsnavn())</option>
                    }
                </select>
                <button type="button" class="add-button" @onclick="LeggTilMedlem" disabled="@(_valgtNyttMedlemId is null)">Legg til</button>
            </div>
        </div>
    }
    else if (_activeTab == "info")
    {
        <div class="prosjekt-layout">
            <p class="section-hint">Generell informasjon om prosjektet, tilgangsdetaljer, kontaktpersoner osv.</p>
            <textarea class="info-textarea" rows="14" @bind="_form.Info" placeholder="Skriv inn informasjon om prosjektet..."></textarea>
            <div class="form-actions">
                <button type="button" class="save-button" @onclick="LagreInfo">Lagre</button>
                @if (!string.IsNullOrEmpty(_infoMessage))
                {
                    <span class="save-success">@_infoMessage</span>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private Prosjekt _form = new() { Navn = "" };
    private List<Dor> _dorer = [];
    private Dor? _selectedDoor;
    private List<Plantegning> _plantegninger = [];
    private string _nyPlantegningNavn = "";
    private string _nyPlantegningByggetrinn = "";
    private bool _uploadingPlantegning;
    private string? _plantegningFeil;
    private List<ProsjektVedlegg> _vedlegg = [];
    private string _valgtVedleggType = "";
    private bool _uploadingVedlegg;
    private string? _vedleggFeil;
    private List<Tilbud> _tilbud = [];
    private List<Kunde> _kunder = [];
    private List<DorIdMal> _dorIdMaler = [];
    private string _nyDorIdKode = "";
    private string? _dorIdMessage;
    private string _activeTab = "oversikt";
    private bool _notFound;
    private bool _ingenTilgang;
    private bool _confirmingDelete;
    private int? _loadedId;
    private bool _hasLoaded;
    private string? _error;
    private string? _savedMessage;
    private List<Bruker> _alleBrukere = [];
    private int? _valgtNyttMedlemId;
    private string? _infoMessage;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private string TabClass(string tab) => _activeTab == tab ? "tab-button tab-button-active" : "tab-button";

    private List<Bruker> TilgjengeligeBrukere =>
        _alleBrukere.Where(b => !_form.Medlemmer.Any(m => m.Id == b.Id)).ToList();

    private int KalkulertMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutter ?? 0));

    private int BruktMontasjeMinutter =>
        _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.Montert).Sum(dk => dk.Antall * (dk.Component?.MontasjeMinutter ?? 0));

    private int GjenstaendeMontasjeMinutter =>
        Math.Max(0, KalkulertMontasjeMinutter - BruktMontasjeMinutter);

    private int AntallBeslagTotalt => _dorer.SelectMany(d => d.Komponenter).Sum(dk => dk.Antall);

    private int AntallBeslagMontert => _dorer.SelectMany(d => d.Komponenter).Where(dk => dk.Montert).Sum(dk => dk.Antall);

    private static string FormatTid(int minutter)
    {
        if (minutter <= 0)
        {
            return "0 min";
        }

        var timer = minutter / 60;
        var rest = minutter % 60;
        return timer > 0 ? $"{timer}t {rest}min" : $"{rest} min";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_hasLoaded && _loadedId == Id)
        {
            return;
        }

        _hasLoaded = true;
        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _infoMessage = null;
        _error = null;
        _notFound = false;
        _ingenTilgang = false;
        _activeTab = "oversikt";
        _selectedDoor = null;

        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();

        if (Id.HasValue)
        {
            var existing = await Db.Prosjekter
                .Include(p => p.Plantegninger)
                .Include(p => p.Vedlegg)
                .Include(p => p.Tilbud)
                .Include(p => p.Medlemmer)
                .FirstOrDefaultAsync(p => p.Id == Id.Value);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            if (_naverendeRolle == BrukerRolle.Montor && !existing.Medlemmer.Any(m => m.Id == _naverendeBrukerId))
            {
                _ingenTilgang = true;
                return;
            }

            _form = existing;
            _plantegninger = existing.Plantegninger;
            _vedlegg = existing.Vedlegg;
            _tilbud = existing.Tilbud.OrderByDescending(t => t.OpprettetDato).ToList();

            _dorIdMaler = await Db.DorIdMaler
                .Where(m => m.ProsjektId == Id.Value)
                .OrderBy(m => m.Kode)
                .ToListAsync();

            _dorer = await Db.Dorer
                .Where(d => d.ProsjektId == Id.Value)
                .Include(d => d.Plantegning)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
                .Include(d => d.Komponenter).ThenInclude(dk => dk.MontertAvBruker)
                .Include(d => d.Funksjoner)
                .OrderBy(d => d.Dornummer)
                .ToListAsync();
        }
        else
        {
            if (_naverendeRolle == BrukerRolle.Montor)
            {
                _ingenTilgang = true;
                return;
            }

            _plantegninger = [];
            _vedlegg = [];
            _tilbud = [];
            _dorer = [];
            _dorIdMaler = [];
            _form = new Prosjekt { Navn = "" };
        }
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Prosjektet må ha et navn.";
            return;
        }

        _error = null;

        if (!Id.HasValue)
        {
            Db.Prosjekter.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Prosjektet \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Prosjektet \"{_form.Navn}\" er lagret.";
            Nav.NavigateTo($"/prosjekter/{_form.Id}");
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Prosjekter.FirstOrDefaultAsync(p => p.Id == Id.Value);
        if (existing is not null)
        {
            Db.Prosjekter.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/prosjekter");
    }

    // Dører

    private async Task LeggTilDor()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var dor = new Dor { ProsjektId = Id.Value, Dornummer = "Ny dør" };
        Db.Dorer.Add(dor);
        await Db.SaveChangesAsync();

        _dorer.Add(dor);
        SelectDoor(dor);
    }

    private void SelectDoor(Dor d)
    {
        _selectedDoor = d;
    }

    private async Task EndreStatus(Dor d, ChangeEventArgs e)
    {
        if (e.Value is not string s || !Enum.TryParse<MontasjeStatus>(s, out var status))
        {
            return;
        }

        d.Status = status;
        d.MontertDato = status == MontasjeStatus.FerdigMontert ? DateTime.Today : null;
        await Db.SaveChangesAsync();
    }

    private static string StatusSelectClass(MontasjeStatus status) => status switch
    {
        MontasjeStatus.FerdigMontert => "status-select-ferdig",
