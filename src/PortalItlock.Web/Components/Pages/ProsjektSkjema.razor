    // Kjente tjenester får eget navn og farge; alt annet vises med domenet.
    private static (string Kilde, string Klasse) LenkeKilde(string url)
    {
        var host = Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host.ToLowerInvariant() : "";
        return host switch
        {
            _ when host.Contains("onedrive") || host.EndsWith("1drv.ms") => ("OneDrive", "od"),
            _ when host.Contains("sharepoint") => ("SharePoint", "sp"),
            _ when host.Contains("dalux") => ("Dalux", "dx"),
            _ when host.Contains("drive.google") || host.Contains("docs.google") => ("Google Drive", "gd"),
            _ when host.Contains("dropbox") => ("Dropbox", "db"),
            "" => ("Lenke", "an"),
            _ => (host.StartsWith("www.") ? host[4..] : host, "an")
        };
    }

    private async Task LeggTilLenke()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var url = _nyLenkeUrl.Trim();
        if (!url.Contains("://"))
        {
            url = "https://" + url;
        }

        // Bare vanlige nettadresser - ikke javascript: o.l.
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || (uri.Scheme != Uri.UriSchemeHttps && uri.Scheme != Uri.UriSchemeHttp) || string.IsNullOrEmpty(uri.Host))
        {
            _lenkeFeil = "Skriv inn en gyldig adresse som starter med https://";
            return;
        }

        var navn = string.IsNullOrWhiteSpace(_nyLenkeNavn) ? LenkeKilde(uri.ToString()).Kilde : _nyLenkeNavn.Trim();
        var lenke = new ProsjektLenke { ProsjektId = Id.Value, Navn = navn, Url = uri.ToString() };
        Db.ProsjektLenker.Add(lenke);
        await Db.SaveChangesAsync();

        _lenker.Add(lenke);
        _lenker = _lenker.OrderBy(l => l.Navn).ToList();
        _visNyLenke = false;
        _nyLenkeNavn = "";
        _nyLenkeUrl = "";
        _lenkeFeil = null;
    }

