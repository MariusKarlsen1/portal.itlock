@page "/priskoder"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@inject NavigationManager Nav

@* Priskodene ligger nå i komponentregisteret under «Koder og tillegg». Gamle
   lenker og bokmerker sendes dit. *@
@code {
    protected override void OnInitialized() => Nav.NavigateTo("/komponenter?fane=koder", replace: true);
}
