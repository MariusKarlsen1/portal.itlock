@page "/kundemodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kunder - itlock</PageTitle>

<h1>Kunder</h1>
<p class="section-hint">Alt som gjelder kunder samlet på ett sted: kunderegister, oppfølging, portaltilgang og tilvalg.</p>

<div class="kundemodul-grid">
    <a href="/kunder" class="kundemodul-card">
        <Icon Name="users" />
        <span class="kundemodul-card-title">Kunderegister</span>
        <span class="kundemodul-card-desc">Opprett og vedlikehold kunder med kontaktinfo og adresse.</span>
    </a>
    <a href="/kundeoppfolging" class="kundemodul-card @(_kunderTrengerOppfolging > 0 ? "kundemodul-card-varsel" : "")">
        <Icon Name="clock" />
        @if (_kunderTrengerOppfolging > 0)
        {
            <span class="kundemodul-card-tall">@_kunderTrengerOppfolging</span>
        }
        <span class="kundemodul-card-title">Kundeoppfølging</span>
        <span class="kundemodul-card-desc">Kunder som bør følges opp, med logg og påminnelser.</span>
    </a>
    <a href="/kundetilganger" class="kundemodul-card">
        <Icon Name="bell" />
        <span class="kundemodul-card-title">Kundetilganger</span>
        <span class="kundemodul-card-desc">Administrer innlogging til kundeportalen.</span>
    </a>
    <a href="/tilvalg" class="kundemodul-card @(_tilvalgVarsel > 0 ? "kundemodul-card-varsel" : "")">
        <Icon Name="tag" />
        @if (_tilvalgVarsel > 0)
        {
            <span class="kundemodul-card-tall">@_tilvalgVarsel</span>
        }
        <span class="kundemodul-card-title">Tilvalg</span>
        <span class="kundemodul-card-desc">Publiser tilvalg til kunder, og se svar med valg og signatur.</span>
    </a>
    <a href="/tilvalgmaler" class="kundemodul-card">
        <Icon Name="tag" />
        <span class="kundemodul-card-title">Tilvalgsmaler</span>
        <span class="kundemodul-card-desc">Ferdige maler med alternativer, bilder og priser til gjenbruk.</span>
    </a>
</div>

@code {
    private int _kunderTrengerOppfolging;
    private int _tilvalgVarsel;

    protected override async Task OnInitializedAsync()
    {
        _kunderTrengerOppfolging = await Db.Kunder.CountAsync(k =>
            k.NesteOppfolgingsDato != null && k.NesteOppfolgingsDato.Value.Date <= DateTime.Today);

        _tilvalgVarsel = await Db.Tilvalg.CountAsync(t => t.Status == TilvalgStatus.Besvart && !t.LestAvAnsatt);
    }
}
