@page "/rapporter/resultat"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Resultatrapport - Full Kontroll</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="file-text" /></span>
    <div>
        <h1>Resultatrapport</h1>
        <p class="section-hint">
            Omsetning pr. inntektskonto for valgt periode, beregnet fra ferdigmeldte
            arbeidsordre i portalen (samme oppsett som Tripletex sin resultatrapport,
            men uavhengig av om ordren er fakturert i Tripletex ennå) - inntektskontoene
            som er satt på varer i komponentregisteret dukker opp her.
        </p>
    </div>
</div>

<div class="kort filter-kort">
    <label class="felt">
        <span class="felt-label">Fra</span>
        <input type="date" @bind="_fraDato" />
    </label>
    <label class="felt">
        <span class="felt-label">Til</span>
        <input type="date" @bind="_tilDato" />
    </label>
    <button type="button" class="knapp-primaer" @onclick="HentRapport" disabled="@_lasterNa">
        @(_lasterNa ? "Henter..." : "Vis rapport")
    </button>
</div>

@if (_harHentet)
{
    @if (_rader.Count == 0)
    {
        <p class="list-empty">Ingen ferdigmeldt omsetning i denne perioden.</p>
    }
    else
    {
        <div class="kort stat-kort">
            <span class="stat-label">Total omsetning</span>
            <span class="stat-verdi">@_rader.Sum(r => r.Sum).ToString("N0", Kultur) kr</span>
        </div>

        <div class="kort tabell-kort">
            <table class="rapport-table">
                <thead>
                    <tr>
                        <th class="konto-kolonne">Konto</th>
                        <th>Navn</th>
                        <th class="tall-cell">Omsetning</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rader)
                    {
                        <tr>
                            <td class="konto-tag">@(r.Nummer?.ToString() ?? "-")</td>
                            <td>@r.Navn</td>
                            <td class="tall-cell">@r.Sum.ToString("N0", Kultur) kr</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">Totalt</td>
                        <td class="tall-cell">@_rader.Sum(r => r.Sum).ToString("N0", Kultur) kr</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private DateTime _fraDato = new(DateTime.Today.Year, 1, 1);
    private DateTime _tilDato = DateTime.Today;
    private bool _lasterNa;
    private bool _harHentet;

    private sealed record KontoRad(int? Nummer, string Navn, decimal Sum);
    private List<KontoRad> _rader = [];

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _lasterNa = true;
        try
        {
            var tilEksklusiv = _tilDato.Date.AddDays(1);
            var ordrer = await Db.Arbeidsordre
                .Where(a => a.FullfortDato != null && a.FullfortDato >= _fraDato.Date && a.FullfortDato < tilEksklusiv)
                .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer).ThenInclude(l => l.Component).ThenInclude(c => c!.Inntektskonto)
                .Include(a => a.Varer).ThenInclude(v => v.Component).ThenInclude(c => c!.Inntektskonto)
                .ToListAsync();

            _rader = ordrer
                .SelectMany(ArbeidsordreOkonomiBeregner.BeregnLinjer)
                .GroupBy(l => (l.KontoNummer, KontoNavn: l.KontoNavn ?? "Ikke satt inntektskonto"))
                .Select(g => new KontoRad(g.Key.KontoNummer, g.Key.KontoNavn, g.Sum(l => l.Belop)))
                .OrderBy(r => r.Nummer ?? int.MaxValue)
                .ToList();
            _harHentet = true;
        }
        finally
        {
            _lasterNa = false;
        }
    }
}
