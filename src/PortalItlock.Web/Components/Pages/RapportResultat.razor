@page "/rapporter/resultat"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Resultatrapport - Full Kontroll</PageTitle>

@* R1 (Prototype resultatrapport.html): samme kort som kunde- og produktrapporten.
   Omsetningen deles på kundetype (privat, bedrift, borettslag osv. fra kundekortet)
   - ikke på inntektskonto - med varer og arbeid per type, og omsetning per måned. *@
<RapportRamme Tittel="Resultatrapport" Undertittel="Omsetning per kundetype" Ikon="file-text" Kilde="portal"
              Periode="_periode" OnPeriodeEndret="HentRapport" VisSammenlign="true" Laster="_laster"
              OnEksporter="Eksporter" SomKundekort="true" Gruppe="Økonomi">
    @if (_harHentet && _rader.Count == 0)
    {
        <p class="rr-tom">Ingen ferdigmeldt omsetning i denne perioden.</p>
    }
    else if (_harHentet)
    {
        var total = _rader.Sum(r => r.Sum);
        var totalFor = _forrige.Values.Sum();
        var privat = _rader.Where(r => r.Type == KundeType.Privatperson).Sum(r => r.Sum);
        var bedrift = total - privat - _rader.Where(r => r.Type is null).Sum(r => r.Sum);
        var beste = _maaneder.OrderByDescending(m => m.Naa).FirstOrDefault();
        var maksStolpe = Math.Max(1, _maaneder.Max(m => Math.Max(m.Naa, Sml ? m.For : 0)));

        <div class="rr-kpis">
            <div class="rr-kpi"><small>Omsetning</small><b>@RapportPeriode.Kr(total)</b><span><RapportDelta Naa="total" For="@(Sml ? totalFor : null)" /> @(Sml ? $"mot {_periode.SmlTekst}" : "i perioden")</span></div>
            <div class="rr-kpi"><small>Bedrifter og andre</small><b>@RapportPeriode.Prosent(bedrift, total)</b><span>@RapportPeriode.Kr(bedrift)</span></div>
            <div class="rr-kpi"><small>Privatpersoner</small><b>@RapportPeriode.Prosent(privat, total)</b><span>@RapportPeriode.Kr(privat)</span></div>
            <div class="rr-kpi"><small>Beste @(_perAr ? "år" : "måned")</small><b>@(beste?.Navn ?? "–")</b><span>@(beste is null ? "" : RapportPeriode.Kr(beste.Naa))</span></div>
        </div>

        <div class="rr-tile">
            <div class="rr-tile-t">
                <h2>Omsetning per @(_perAr ? "år" : "måned")</h2>
                <span class="rr-farge">
                    <span><i style="background:var(--itlock-accent)"></i>Valgt periode</span>
                    @if (Sml)
                    {
                        <span><i style="background:color-mix(in srgb, var(--itlock-accent) 14%, var(--itlock-surface))"></i>@(char.ToUpper(_periode.SmlTekst[0]) + _periode.SmlTekst[1..])</span>
                    }
                </span>
            </div>
            <div class="rr-graf">
                @foreach (var m in _maaneder)
                {
                    <div title="@($"{m.Navn}: {RapportPeriode.Kr(m.Naa)}{(Sml ? $" (mot {RapportPeriode.Kr(m.For)})" : "")}")">
                        <i class="naa" style="height:@Pst(m.Naa, maksStolpe)"></i>
                        @if (Sml)
                        {
                            <i class="for" style="height:@Pst(m.For, maksStolpe)"></i>
                        }
                    </div>
                }
            </div>
            <div class="rr-mnd">
                @foreach (var m in _maaneder)
                {
                    <span>@m.Navn</span>
                }
            </div>
        </div>

        <div class="rr-tile">
            <div class="rr-tile-t"><h2>Per kundetype</h2>@if (Sml){<small>@_periode.Tekst mot @_periode.SmlTekst</small>}</div>
            <div class="rr-tabwrap">
                <table class="rr-tab">
                    <thead>
                        <tr>
                            <th>Kundetype</th>
                            <th>Andel</th>
                            <th class="n">Varer</th>
                            <th class="n">Arbeid</th>
                            <th class="n">Omsetning</th>
                            @if (Sml)
                            {
                                <th class="n">@(char.ToUpper(_periode.SmlTekst[0]) + _periode.SmlTekst[1..])</th>
                                <th class="n">Endring</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rader)
                        {
                            <tr>
                                <td><b>@TypeNavn(r.Type)</b></td>
                                <td><span class="rr-andel"><span class="rr-bar"><i style="width:@Pst(r.Sum, total)"></i></span><span>@RapportPeriode.Prosent(r.Sum, total)</span></span></td>
                                <td class="n">@RapportPeriode.Kr(r.Varer)</td>
                                <td class="n">@RapportPeriode.Kr(r.Arbeid)</td>
                                <td class="n">@RapportPeriode.Kr(r.Sum)</td>
                                @if (Sml)
                                {
                                    var f = _forrige.GetValueOrDefault(Nokkel(r.Type));
                                    <td class="n dempet">@(f == 0 ? "–" : RapportPeriode.Kr(f))</td>
                                    <td class="n"><RapportDelta Naa="r.Sum" For="f" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2">Sum omsetning</td>
                            <td class="n">@RapportPeriode.Kr(_rader.Sum(r => r.Varer))</td>
                            <td class="n">@RapportPeriode.Kr(_rader.Sum(r => r.Arbeid))</td>
                            <td class="n">@RapportPeriode.Kr(total)</td>
                            @if (Sml)
                            {
                                <td class="n dempet">@RapportPeriode.Kr(totalFor)</td>
                                <td class="n"><RapportDelta Naa="total" For="totalFor" /></td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</RapportRamme>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private readonly RapportPeriode _periode = new();
    private bool _laster;
    private bool _harHentet;

    private sealed record TypeRad(KundeType? Type, decimal Varer, decimal Arbeid)
    {
        public decimal Sum => Varer + Arbeid;
    }

    private sealed record Stolpe(string Navn, decimal Naa, decimal For);

    private List<TypeRad> _rader = [];
    private Dictionary<string, decimal> _forrige = [];
    private List<Stolpe> _maaneder = [];
    private bool _perAr;

    private bool Sml => _periode.Sammenlign;

    private static string Pst(decimal del, decimal total) =>
        (total == 0 ? 0 : Math.Max(0, del) / total * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string TypeNavn(KundeType? t) => t?.Visningsnavn() ?? "Kundetype ikke satt";

    private static string Nokkel(KundeType? t) => t?.ToString() ?? "";

    // Kundetypen settes på kundekortet; arbeid er linjer uten vare (montasje o.l.).
    private static List<TypeRad> Grupper(List<RapportData.OrdreLinjer> ordrer) => ordrer
        .GroupBy(o => o.Kunde?.Type)
        .Select(g => new TypeRad(
            g.Key,
            g.SelectMany(o => o.Linjer).Where(l => l.ComponentId is not null).Sum(l => l.Belop),
            g.SelectMany(o => o.Linjer).Where(l => l.ComponentId is null).Sum(l => l.Belop)))
        .Where(r => r.Sum != 0)
        .OrderByDescending(r => r.Sum)
        .ToList();

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _laster = true;
        try
        {
            var naa = await RapportData.HentAsync(Db, _periode.Fra, _periode.Til);
            _rader = Grupper(naa);

            var forrige = Sml
                ? await RapportData.HentAsync(Db, _periode.SmlFra, _periode.SmlTil)
                : new List<RapportData.OrdreLinjer>();
            _forrige = Grupper(forrige).ToDictionary(r => Nokkel(r.Type), r => r.Sum);

            LagStolper(naa, forrige);
            _harHentet = true;
        }
        finally
        {
            _laster = false;
        }
    }

    // Én stolpe per måned i perioden (eller per år hvis perioden er over to år).
    private void LagStolper(List<RapportData.OrdreLinjer> naa, List<RapportData.OrdreLinjer> forrige)
    {
        var start = new DateTime(_periode.Fra.Year, _periode.Fra.Month, 1);
        var slutt = new DateTime(_periode.Til.Year, _periode.Til.Month, 1);
        var antallMnd = (slutt.Year - start.Year) * 12 + slutt.Month - start.Month + 1;
        _perAr = antallMnd > 24;

        if (_perAr)
        {
            _maaneder = Enumerable.Range(_periode.Fra.Year, _periode.Til.Year - _periode.Fra.Year + 1)
                .Select(ar => new Stolpe(
                    ar.ToString(Kultur),
                    naa.Where(o => o.Fullfort.Year == ar).Sum(o => o.Sum),
                    forrige.Where(o => o.Fullfort.Year == ar - 1).Sum(o => o.Sum)))
                .ToList();
            return;
        }

        _maaneder = Enumerable.Range(0, Math.Max(1, antallMnd))
            .Select(i => start.AddMonths(i))
            .Select(m => new Stolpe(
                m.ToString(antallMnd > 12 ? "MMM yy" : "MMM", Kultur).TrimEnd('.'),
                naa.Where(o => o.Fullfort.Year == m.Year && o.Fullfort.Month == m.Month).Sum(o => o.Sum),
                forrige.Where(o => o.Fullfort.Year == m.Year - 1 && o.Fullfort.Month == m.Month).Sum(o => o.Sum)))
            .ToList();
    }

    private async Task Eksporter()
    {
        var rader = new List<object?[]> { new object?[] { "Kundetype", "Varer", "Arbeid", "Omsetning", Sml ? $"Sammenligning ({_periode.SmlTekst})" : null } };
        rader.AddRange(_rader.Select(r => new object?[] { TypeNavn(r.Type), r.Varer, r.Arbeid, r.Sum, Sml ? _forrige.GetValueOrDefault(Nokkel(r.Type)) : null }));
        rader.Add(new object?[] { "Sum omsetning", _rader.Sum(r => r.Varer), _rader.Sum(r => r.Arbeid), _rader.Sum(r => r.Sum), Sml ? _forrige.Values.Sum() : null });
        await JS.InvokeVoidAsync("rapport.lastNedCsv", $"Resultatrapport {_periode.Tekst}.csv", RapportData.Csv(rader));
    }
}
