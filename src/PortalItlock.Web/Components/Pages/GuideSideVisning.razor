@page "/guide/{Nokkel}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>@_tittel</PageTitle>

<h1>@_tittel</h1>

@if (_redigerer)
{
    <textarea class="guide-editor" rows="20" @bind="_innhold"></textarea>
    <div class="guide-actions">
        <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
        <button type="button" class="cancel-button" @onclick="AvbrytRedigering">Avbryt</button>
    </div>
}
else
{
    @if (string.IsNullOrWhiteSpace(_innhold))
    {
        <p class="guide-empty">Ingen innhold lagt inn ennå.</p>
    }
    else
    {
        <div class="guide-content">@_innhold</div>
    }

    <div class="guide-actions">
        <button type="button" class="save-button" @onclick="StartRedigering">Rediger</button>
    </div>

    @if (_sistOppdatert.HasValue)
    {
        <p class="guide-meta">Sist oppdatert: @_sistOppdatert.Value.ToString("dd.MM.yyyy HH:mm")</p>
    }
}

@code {
    [Parameter] public string Nokkel { get; set; } = "";

    private static readonly Dictionary<string, string> Titler = new()
    {
        ["kobling"] = "Kobling",
        ["oppsett-adgangskontroll"] = "Oppsett adgangskontroll"
    };

    private int _id;
    private string _tittel = "Guide";
    private string _innhold = "";
    private string _innholdVedRedigeringStart = "";
    private bool _redigerer;
    private DateTime? _sistOppdatert;
    private string? _loadetNokkel;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetNokkel == Nokkel)
        {
            return;
        }

        _loadetNokkel = Nokkel;
        _redigerer = false;
        _tittel = Titler.TryGetValue(Nokkel, out var kjentTittel) ? kjentTittel : Nokkel;

        var eksisterende = await Db.GuideSider.FirstOrDefaultAsync(g => g.Nokkel == Nokkel);
        if (eksisterende is null)
        {
            _id = 0;
            _innhold = "";
            _sistOppdatert = null;
        }
        else
        {
            _id = eksisterende.Id;
            _innhold = eksisterende.Innhold ?? "";
            _tittel = eksisterende.Tittel;
            _sistOppdatert = eksisterende.SistOppdatert;
        }
    }

    private void StartRedigering()
    {
        _innholdVedRedigeringStart = _innhold;
        _redigerer = true;
    }

    private void AvbrytRedigering()
    {
        _innhold = _innholdVedRedigeringStart;
        _redigerer = false;
    }

    private async Task Lagre()
    {
        if (_id == 0)
        {
            var ny = new GuideSide
            {
                Nokkel = Nokkel,
                Tittel = _tittel,
                Innhold = _innhold,
                SistOppdatert = DateTime.UtcNow
            };
            Db.GuideSider.Add(ny);
            await Db.SaveChangesAsync();
            _id = ny.Id;
        }
        else
        {
            var eksisterende = await Db.GuideSider.FirstAsync(g => g.Id == _id);
            eksisterende.Innhold = _innhold;
            eksisterende.SistOppdatert = DateTime.UtcNow;
            await Db.SaveChangesAsync();
        }

        _sistOppdatert = DateTime.UtcNow;
        _redigerer = false;
    }
}
