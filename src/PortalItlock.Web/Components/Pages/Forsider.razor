@page "/forsider"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Forsider</PageTitle>

<h1>Forsider</h1>
<p class="section-hint">
    Lag gjenbrukbare forside-/forbeholdstekster som kan velges når du genererer et tilbud.
    Skriv og formater teksten direkte i boksen, med overskrifter, fet skrift, lister og lenker.
</p>

<div class="layout">
    <div class="kort side-liste">
        @if (_forsider.Count == 0)
        {
            <p class="tom-liste">Ingen forsider opprettet ennå.</p>
        }
        else
        {
            @foreach (var f in _forsider)
            {
                <div @key="f.Id" class="liste-rad @(f.Id == _valgtId ? "liste-rad-aktiv" : "")" @onclick="@(() => VelgForside(f.Id))">
                    <span class="liste-navn">@(string.IsNullOrWhiteSpace(f.Navn) ? "(Uten navn)" : f.Navn)</span>
                    <span class="liste-pil">&rsaquo;</span>
                </div>
            }
        }
        <div class="ny-rad">
            <input class="ny-input" @bind="_nyNavn" @bind:event="oninput" placeholder="Navn på ny forside"
                   @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettForside(); } })" />
            <button type="button" class="btn-liten btn-primaer" @onclick="OpprettForside" disabled="@string.IsNullOrWhiteSpace(_nyNavn)">Opprett</button>
        </div>
    </div>

    <div class="hoved">
        @if (_valgt is null)
        {
            <div class="kort tom-hoved">
                <p class="tom-liste">Velg en forside i listen til venstre, eller opprett en ny.</p>
            </div>
        }
        else
        {
            <input class="navn-input" @bind="_valgt.Navn" @bind:event="oninput" placeholder="Navn på forsiden" />
            <div class="kort">
                <ForsideTekstRedigering @key="_valgt.Id" @bind-Value="_valgt.Innhold" Rows="16" Placeholder="Tilbudsforutsetninger og forbehold ..." />
            </div>
            <div class="footer-rad">
                <button type="button" class="btn-liten btn-primaer" @onclick="@(() => LagreForside(_valgt))">Lagre</button>
                <button type="button" class="btn-liten btn-fare" @onclick="@(() => SlettForside(_valgt))">Slett</button>
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <span class="save-success">@_melding</span>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<TilbudForside> _forsider = [];
    private string _nyNavn = "";
    private string? _melding;
    private int? _valgtId;

    private TilbudForside? _valgt => _forsider.FirstOrDefault(f => f.Id == _valgtId);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _forsider = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
        if (_valgtId is null || !_forsider.Any(f => f.Id == _valgtId))
        {
            _valgtId = _forsider.FirstOrDefault()?.Id;
        }
    }

    private void VelgForside(int id)
    {
        _valgtId = id;
        _melding = null;
    }

    private async Task OpprettForside()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var forside = new TilbudForside { Navn = navn };
        Db.TilbudForsider.Add(forside);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _melding = $"Forsiden \"{navn}\" er opprettet.";
        await LoadAsync();
        _valgtId = forside.Id;
    }

    private async Task LagreForside(TilbudForside forside)
    {
        await Db.SaveChangesAsync();
        _melding = $"\"{forside.Navn}\" er lagret.";
    }

    private async Task SlettForside(TilbudForside forside)
    {
        Db.TilbudForsider.Remove(forside);
        await Db.SaveChangesAsync();
        _melding = $"\"{forside.Navn}\" er slettet.";
        _valgtId = null;
        await LoadAsync();
    }
}
