@page "/forsider"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Forsider</PageTitle>

<h1>Forsider</h1>
<p>
    Lag gjenbrukbare forside-/forbeholdstekster som kan velges når du genererer et tilbud.
    Bruk <code>#</code> foran en linje for hovedoverskrift og <code>##</code> for underoverskrift, ellers vanlig avsnitt.
</p>

@if (_forsider.Count == 0)
{
    <p class="list-empty">Ingen forsider opprettet ennå.</p>
}
else
{
    @foreach (var f in _forsider)
    {
        <div @key="f.Id" class="forside-card">
            <input class="forside-navn" @bind="f.Navn" @bind:event="oninput" placeholder="Navn på forsiden" />
            <textarea rows="12" @bind="f.Innhold" placeholder="# Tilbudsforutsetninger og forbehold&#10;&#10;## Montering&#10;Montasje, rigg, drift og kjøring er inkludert i tilbudet."></textarea>
            <div class="form-actions">
                <button type="button" class="save-button" @onclick="@(() => LagreForside(f))">Lagre</button>
                <button type="button" class="delete-button" @onclick="@(() => SlettForside(f))">Slett</button>
            </div>
        </div>
    }
}

<div class="new-funksjon">
    <h2>Ny forside</h2>
    <div class="new-funksjon-form">
        <input @bind="_nyNavn" @bind:event="oninput" placeholder="F.eks. Standard - Lås &amp; beslag" />
        <button type="button" class="add-button" @onclick="OpprettForside" disabled="@string.IsNullOrWhiteSpace(_nyNavn)">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
</div>

@code {
    private List<TilbudForside> _forsider = [];
    private string _nyNavn = "";
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _forsider = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
    }

    private async Task OpprettForside()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.TilbudForsider.Add(new TilbudForside { Navn = navn });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _melding = $"Forsiden \"{navn}\" er opprettet.";
        await LoadAsync();
    }

    private async Task LagreForside(TilbudForside forside)
    {
        await Db.SaveChangesAsync();
        _melding = $"\"{forside.Navn}\" er lagret.";
    }

    private async Task SlettForside(TilbudForside forside)
    {
        Db.TilbudForsider.Remove(forside);
        await Db.SaveChangesAsync();
        _melding = $"\"{forside.Navn}\" er slettet.";
        await LoadAsync();
    }
}
