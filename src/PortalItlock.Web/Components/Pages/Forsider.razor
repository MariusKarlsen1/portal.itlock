@page "/forsider"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Forsider</PageTitle>

@* P1 (Prototype forsider.html): ett kort som kundekortet med grå infolinje og
   forsidene i grå meny til venstre med søk og blå strek. Til høyre står navnet,
   teksten med verktøylinjen fast øverst, og slett i egen boks. Endringer lagres
   fra lagre-linjen nederst. *@
<div class="sm @(_full ? "sm-full" : "")">
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="sm-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="sm-kort">
        <div class="sm-topp">
            <span class="sm-ikon"><Icon Name="folder" /></span>
            <div class="sm-tittel">
                <div class="sm-smule"><NavLink href="/oppsettmodul">Oppsett</NavLink> / Tilbud</div>
                <h1>Forsider</h1>
            </div>
            <div class="sm-knapper">
                @if (_valgt is { } aktiv)
                {
                    <button type="button" class="sm-knapp" @onclick="@(() => DupliserForside(aktiv))"><Icon Name="clipboard" />Dupliser</button>
                }
                <button type="button" class="sm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>
        </div>

        <div class="sm-info">
            <span><b>@_forsider.Count</b> @(_forsider.Count == 1 ? "forside" : "forsider")</span>
            <span>Velges når du lager et tilbud, og står først i tilbudet</span>
        </div>

        <div class="sm-kropp">
            <nav class="sm-meny">
                <label class="sm-sok">
                    <Icon Name="search" />
                    <input type="search" @bind="_search" @bind:event="oninput" placeholder="Finn forside" />
                </label>
                <div class="sm-liste">
                    @foreach (var f in _filtrert)
                    {
                        var id = f.Id;
                        <button type="button" @key="f.Id" class="sm-fane @(f.Id == _valgtId ? "pa" : "")" @onclick="@(() => Velg(id))">
                            <Icon Name="folder" />
                            <span>@(string.IsNullOrWhiteSpace(f.Navn) ? "(Uten navn)" : f.Navn)@(f.Endret ? " •" : "")</span>
                        </button>
                    }
                    @if (_filtrert.Count == 0)
                    {
                        <p class="sm-dempet">@(_forsider.Count == 0 ? "Ingen forsider ennå." : "Ingen treff.")</p>
                    }
                </div>
                <div class="sm-ny">
                    <input @bind="_nyNavn" @bind:event="oninput" placeholder="＋ Ny forside"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettForside(); } })" />
                    @if (!string.IsNullOrWhiteSpace(_nyNavn))
                    {
                        <button type="button" class="sm-knapp primaer" @onclick="OpprettForside">Opprett</button>
                    }
                </div>
            </nav>

            <div class="sm-innhold">
                @if (_valgt is { } valgt)
                {
                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>Forside</h3></div>
                        <div class="sm-skjema">
                            <label class="sm-felt s2">
                                <span>Navn på forsiden</span>
                                <input @bind="valgt.Navn" @bind:event="oninput" placeholder="F.eks. Standard forbehold" />
                            </label>
                        </div>
                    </section>

                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>Tekst</h3><small>overskrifter, fet skrift, lister og lenker</small></div>
                        <div class="fs-editor">
                            <ForsideTekstRedigering @key="valgt.Id" @bind-Value="valgt.Innhold" Rows="18" Placeholder="Tilbudsforutsetninger og forbehold ..." />
                        </div>
                    </section>

                    <div class="sm-fare">
                        <div>
                            <b>Slett forside</b>
                            <span>Forsiden fjernes fra listen. Tilbud som allerede er laget, beholder teksten.</span>
                        </div>
                        @if (_bekreftSlett)
                        {
                            <span class="sm-knapperad">
                                <button type="button" class="sm-knapp fare" @onclick="@(() => SlettForside(valgt))">Ja, slett</button>
                                <button type="button" class="sm-knapp" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="sm-knapp fare" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett</button>
                        }
                    </div>
                }
                else
                {
                    <p class="sm-dempet">Velg en forside i menyen, eller lag en ny nederst i menyen.</p>
                }
            </div>
        </div>
    </div>

    @if (_forsider.Any(f => f.Endret))
    {
        var antall = _forsider.Count(f => f.Endret);
        <div class="sm-lagrebar">
            <span><Icon Name="edit" /><b>Endringer i @antall @(antall == 1 ? "forside" : "forsider")</b> er ikke lagret</span>
            <span class="sm-knapperad">
                <button type="button" class="sm-knapp" @onclick="Forkast">Forkast</button>
                <button type="button" class="sm-knapp primaer" @onclick="LagreAlle"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class ForsideDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Innhold { get; set; }
        public string OpprinneligNavn { get; set; } = "";
        public string? OpprinneligInnhold { get; set; }

        // Sammenligner med det som er lagret, så editoren ikke gir falske «endringer».
        public bool Endret => Navn != OpprinneligNavn || (Innhold ?? "") != (OpprinneligInnhold ?? "");
    }

    private List<ForsideDraft> _forsider = [];
    private string _search = "";
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;
    private int? _valgtId;
    private bool _bekreftSlett;
    private bool _full;

    private ForsideDraft? _valgt => _forsider.FirstOrDefault(f => f.Id == _valgtId);

    private List<ForsideDraft> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _forsider
        : _forsider.Where(f => f.Navn.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (f.Innhold?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("forsider-bredde", "normal") == "full";
        await LoadAsync();
        _valgtId = _forsider.FirstOrDefault()?.Id;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("forsider-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        _forsider = (await Db.TilbudForsider.AsNoTracking().OrderBy(f => f.Navn).ToListAsync())
            .Select(f => new ForsideDraft
            {
                Id = f.Id,
                Navn = f.Navn,
                Innhold = f.Innhold,
                OpprinneligNavn = f.Navn,
                OpprinneligInnhold = f.Innhold
            }).ToList();

        if (_valgtId is not null && _forsider.All(f => f.Id != _valgtId))
        {
            _valgtId = _forsider.FirstOrDefault()?.Id;
        }
    }

    private void Velg(int id)
    {
        _valgtId = id;
        _bekreftSlett = false;
        _feil = null;
    }

    private async Task Forkast()
    {
        _feil = null;
        _melding = null;
        await LoadAsync();
    }

    private async Task LagreAlle()
    {
        _feil = null;
        var endrede = _forsider.Where(f => f.Endret).ToList();
        if (endrede.Any(f => string.IsNullOrWhiteSpace(f.Navn)))
        {
            _feil = "Alle forsider må ha et navn.";
            return;
        }

        foreach (var draft in endrede)
        {
            var forside = await Db.TilbudForsider.FirstOrDefaultAsync(f => f.Id == draft.Id);
            if (forside is null)
            {
                continue;
            }

            forside.Navn = draft.Navn.Trim();
            forside.Innhold = draft.Innhold;
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
        _melding = endrede.Count == 1 ? $"«{endrede[0].Navn.Trim()}» er lagret." : $"{endrede.Count} forsider er lagret.";
    }

    private async Task OpprettForside()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var ny = new TilbudForside { Navn = navn };
        Db.TilbudForsider.Add(ny);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _search = "";
        _feil = null;
        _melding = $"«{navn}» er opprettet. Skriv teksten under.";
        await LastPaNyttBeholdEndringer();
        Velg(ny.Id);
    }

    private async Task DupliserForside(ForsideDraft forside)
    {
        var kopi = new TilbudForside { Navn = $"{forside.Navn.Trim()} (kopi)", Innhold = forside.Innhold };
        Db.TilbudForsider.Add(kopi);
        await Db.SaveChangesAsync();

        _melding = $"«{kopi.Navn}» er laget.";
        _feil = null;
        await LastPaNyttBeholdEndringer();
        Velg(kopi.Id);
    }

    private async Task SlettForside(ForsideDraft forside)
    {
        _bekreftSlett = false;
        var entitet = await Db.TilbudForsider.FirstOrDefaultAsync(f => f.Id == forside.Id);
        if (entitet is not null)
        {
            Db.TilbudForsider.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _melding = $"«{forside.Navn}» er slettet.";
        _feil = null;
        _valgtId = null;
        await LastPaNyttBeholdEndringer();
        _valgtId = _forsider.FirstOrDefault()?.Id;
    }

    // Laster listen på nytt uten å miste ulagrede endringer i andre forsider.
    private async Task LastPaNyttBeholdEndringer()
    {
        var ulagret = _forsider.Where(f => f.Endret).ToList();
        await LoadAsync();
        foreach (var f in ulagret)
        {
            var i = _forsider.FindIndex(x => x.Id == f.Id);
            if (i >= 0)
            {
                _forsider[i] = f;
            }
        }
    }
}
