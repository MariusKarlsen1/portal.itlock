@page "/kunde/avvik/{Id:int}"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Avvik til godkjenning</PageTitle>

@if (_ikkeFunnet)
{
    <p class="dp-feil">Fant ikke avviket, eller det tilhører ikke deg.</p>
    <a class="dp-tilbake" href="/kunde"><Icon Name="arrow-left" />Tilbake</a>
}
else if (_avvik is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    <a class="dp-tilbake" href="/kunde"><Icon Name="arrow-left" />Hjem</a>
    <div class="dp-tittelrad">
        <div class="dp-hei">
            <h1>Avvik på dør @_avvik.Dor?.Dornummer</h1>
            <p>@_avvik.Dor?.Prosjekt?.Navn@(_avvik.SendtTilKundeDato.HasValue ? $" · sendt {_avvik.SendtTilKundeDato.Value:dd.MM.yyyy}" : "")</p>
        </div>
        <button type="button" class="dp-knapp" @onclick="@(() => _pdfPreviewUrl = $"/avvik/{_avvik.Id}/pdf")"><Icon Name="file-text" />Vis PDF</button>
    </div>
    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Avvik" OnClose="@(() => _pdfPreviewUrl = null)" />

    <div class="dp-to-kol">
        <div class="dp-kol">
            <div class="dp-kort dp-rapport">
                <h3>Hva vi fant</h3>
                <p>@_avvik.Beskrivelse</p>
                @if (!string.IsNullOrWhiteSpace(_avvik.UtbedringBeskrivelse))
                {
                    <span class="dp-lbl">Forslag til utbedring</span>
                    <p>@_avvik.UtbedringBeskrivelse</p>
                }
            </div>
            @if (_avvik.Pris.HasValue)
            {
                <div class="dp-kort dp-prisboks">
                    <div class="dp-ln dp-sum"><span>Pris for utbedring</span><span>@_avvik.Pris.Value.ToString("N2") kr</span></div>
                    <small style="color:var(--dp-dempet)">Eks. mva</small>
                </div>
            }
        </div>

        <div class="dp-kol">
            @if (_avvik.Status == AvvikStatus.Godkjent)
            {
                <div class="dp-kort dp-kvittering" style="padding:1.4rem 1rem">
                    <div class="dp-hake"><Icon Name="check" /></div>
                    <h1 style="font-size:1.3rem">Godkjent</h1>
                    <p>Du godkjente dette avviket @_avvik.SignertDato?.ToString("dd.MM.yyyy 'kl.' HH:mm"). Vi tar det med ved neste besøk.</p>
                </div>
            }
            else
            {
                <div class="dp-kort dp-skjema">
                    <h2 style="margin:0;font-size:1.1rem;font-weight:600">Godkjenn</h2>
                    <p style="margin:0;color:var(--dp-dempet);font-size:.88rem">Signer under for å godkjenne avviket og prisen for utbedring.</p>

                    <span class="dp-lbl">Fullt navn</span>
                    <input class="dp-felt" @bind="_signertAvNavn" @bind:event="oninput" placeholder="Fullt navn" />

                    <span class="dp-lbl">Signer med fingeren eller musen</span>
                    <div class="dp-signatur">
                        <canvas id="sig-canvas-avvik" width="500" height="180"></canvas>
                    </div>

                    @if (!string.IsNullOrEmpty(_feil))
                    {
                        <p class="dp-feil">@_feil</p>
                    }

                    <div class="dp-send-rad dp-knapperad">
                        <button type="button" class="dp-send dp-send-sekundar" @onclick="RensSignatur">Tøm</button>
                        <button type="button" class="dp-send" style="background:var(--dp-gronn)" @onclick="Godkjenn">
                            <Icon Name="check" />Godkjenn@(_avvik.Pris.HasValue ? $" {_avvik.Pris.Value:N0} kr" : "")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Avvik? _avvik;
    private bool _ikkeFunnet;
    private string _signertAvNavn = "";
    private string? _feil;
    private bool _canvasInitialisert;
    private string? _pdfPreviewUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            _ikkeFunnet = true;
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Kunde).FirstOrDefaultAsync(b => b.Id == brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeFunnet = true;
            return;
        }

        var avvik = await Db.Avvik
            .Include(a => a.Dor).ThenInclude(d => d!.Prosjekt)
            .FirstOrDefaultAsync(a => a.Id == Id);

        if (avvik?.Dor?.Prosjekt?.KundeId != bruker.KundeId)
        {
            _ikkeFunnet = true;
            return;
        }

        _avvik = avvik;
        _signertAvNavn = bruker.Kunde?.Navn ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_canvasInitialisert && _avvik is not null && _avvik.Status != AvvikStatus.Godkjent)
        {
            await JS.InvokeVoidAsync("signatur.init", "sig-canvas-avvik");
            _canvasInitialisert = true;
        }
    }

    private async Task RensSignatur()
    {
        await JS.InvokeVoidAsync("signatur.clear", "sig-canvas-avvik");
    }

    private async Task Godkjenn()
    {
        _feil = null;
        if (string.IsNullOrWhiteSpace(_signertAvNavn))
        {
            _feil = "Skriv inn fullt navn.";
            return;
        }

        var tom = await JS.InvokeAsync<bool>("signatur.isEmpty", "sig-canvas-avvik");
        if (tom)
        {
            _feil = "Signer i feltet før du godkjenner.";
            return;
        }

        var base64 = await JS.InvokeAsync<string>("signatur.getPngBase64", "sig-canvas-avvik");
        var entitet = await Db.Avvik.FindAsync(Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Signatur = Convert.FromBase64String(base64);
        entitet.SignertAvNavn = _signertAvNavn.Trim();
        entitet.SignertDato = DateTime.Now;
        entitet.Status = AvvikStatus.Godkjent;
        await Db.SaveChangesAsync();

        _avvik!.Status = AvvikStatus.Godkjent;
        _avvik.SignertDato = entitet.SignertDato;
    }
}
