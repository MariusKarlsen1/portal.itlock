@page "/servicerunder/{RundeId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject ServicerapportPdfService RapportPdf
@inject LagretPdfService LagretPdf
@inject IJSRuntime JS

<PageTitle>Servicerunde</PageTitle>

@* Fase 4 serviceavtaler (Prototype serviceavtaler komplett.html, Servicerunder):
   runden føres dør for dør. Dørliste eller plantegning til venstre, valgt dør med
   kontrollpunkter til høyre. Alt lagres med en gang. Fullførte runder er
   skrivebeskyttet og viser øyeblikksbildet slik det var. *@
@if (_runde is null)
{
    <p class="form-error">@(_ikkeFunnet ? "Fant ikke servicerunden." : "Laster …")</p>
}
else
{
    var ferdig = _runde.FullfortDato is not null;
    var ok = _dorer.Count(d => d.Status == ServicerundeDorStatus.Ok);
    var avvik = _dorer.Count(d => d.Status == ServicerundeDorStatus.Avvik);
    var gjenstar = _dorer.Count - ok - avvik;
    <div class="srk">
        <a class="srk-tilbake" href="@($"/serviceavtaler/{_runde.ProsjektId}?fane=service")">← @_avtaleNavn</a>
        <div class="srk-kort">
            <div class="srk-topp">
                <span class="srk-ikon"><Icon Name="tool" /></span>
                <div class="srk-tittel">
                    <div class="srk-smule">Serviceavtaler / @_avtaleNavn</div>
                    <h1>Servicerunde @_runde.Dato.ToString("dd.MM.yyyy")
                        @if (ferdig)
                        {
                            <span class="srk-pill gronn"><Icon Name="lock" />Fullført @_runde.FullfortDato?.ToString("dd.MM.yyyy")</span>
                        }
                        else
                        {
                            <span class="srk-pill bla">Pågår</span>
                        }
                    </h1>
                </div>
                <div class="srk-knapper">
                    <a class="srk-knapp" href="@($"/servicerunde/{_runde.Id}/pdf")" target="_blank"><Icon Name="file-text" />@(ferdig ? "Servicerapport (PDF)" : "Forhåndsvis rapport")</a>
                    @if (!ferdig)
                    {
                        <button type="button" class="srk-knapp primaer" @onclick="@(() => _visFullfor = true)"><Icon Name="check" />Fullfør runden</button>
                    }
                </div>
            </div>
            <div class="srk-info">
                <span><b>@(ok + avvik) av @_dorer.Count</b> dører kontrollert</span>
                <span>Avvik <b class="@(avvik > 0 ? "rod" : "")">@avvik</b></span>
                <span>Gjenstår <b>@gjenstar</b></span>
                @if (_avvikFraRunden.Count > 0)
                {
                    <span>Avvik opprettet <b>@_avvikFraRunden.Count</b></span>
                }
                <span>Øyeblikksbilde av dører og komponenter fra @_runde.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                @if (!ferdig)
                {
                    <span class="srk-lagret"><Icon Name="check" />Lagres fortløpende</span>
                }
            </div>
            <div class="srk-fremdrift"><i class="ok" style="width:@Pst(ok)%"></i><i class="av" style="width:@Pst(avvik)%"></i></div>

            @if (_visFullfor && !ferdig)
            {
                <div class="srk-bak" @onclick="@(() => _visFullfor = false)">
                    <div class="ff-dlg" role="dialog" aria-modal="true" aria-label="Fullfør runden" @onclick:stopPropagation="true">
                        <h3>Fullføre og låse runden?</h3>
                        <ul class="ff-liste">
                            <li class="@(gjenstar > 0 ? "adv" : "ok")">@(gjenstar > 0 ? $"{gjenstar} {(gjenstar == 1 ? "dør er" : "dører er")} ikke sjekket og blir stående som ikke sjekket" : "Alle dørene er sjekket")</li>
                            <li class="@(avvik > 0 ? "adv" : "ok")">@(avvik > 0 ? $"{avvik} avvik blir opprettet på avtalen" : "Ingen avvik")</li>
                            <li class="ok">Servicerapporten lagres under Rapporter</li>
                            <li>Runden låses og kan ikke endres etterpå</li>
                        </ul>
                        <div class="ff-knapper">
                            <button type="button" class="srk-knapp" @onclick="@(() => _visFullfor = false)">Avbryt</button>
                            <button type="button" class="srk-knapp primaer" @onclick="Fullfor">Fullfør og lås</button>
                        </div>
                    </div>
                </div>
            }

            @if (ferdig)
            {
                <div class="srk-signatur">
                    @if (_runde.KundeSignatur is { Length: > 0 })
                    {
                        <div>
                            <b><Icon Name="check" />Signert av kunden</b>
                            <span>@_runde.KundeSignertAv · @_runde.KundeSignertDato?.ToString("dd.MM.yyyy HH:mm") – signaturen står på servicerapporten</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <b>Kundens signatur</b>
                            <span>La kunden signere på skjermen. Rapporten lagres på nytt med signaturen.</span>
                            <input class="srk-signavn" placeholder="Kundens navn" @bind="_signertAv" />
                        </div>
                        <canvas id="sig-servicerunde" width="420" height="140"></canvas>
                        <div class="srk-signknapper">
                            <button type="button" class="srk-knapp" @onclick="TomSignatur">Tøm</button>
                            <button type="button" class="srk-knapp primaer" disabled="@string.IsNullOrWhiteSpace(_signertAv)" @onclick="LagreSignatur"><Icon Name="check" />Lagre signatur</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_signFeil))
                        {
                            <span class="form-error">@_signFeil</span>
                        }
                    }
                </div>
            }

            @* Utfylling til rapporten (Prototype servicerunde enkel sjekk.html): fanene
               Plantegning · Dørliste · Utfylling til rapport, som fanene på avtalen. *@
            <nav class="srk-faner">
                @if (_tegninger.Count > 0)
                {
                    <button type="button" class="@(_visning == "plan" ? "pa" : "")" @onclick="@(() => _visning = "plan")">Plantegning</button>
                }
                <button type="button" class="@(_visning == "liste" || (_visning == "plan" && _tegninger.Count == 0) ? "pa" : "")" @onclick="@(() => _visning = "liste")">Dørliste <em>@_dorer.Count</em></button>
                <button type="button" class="@(_visning == "rapp" ? "pa" : "")" @onclick="@(() => _visning = "rapp")">Utfylling til rapport @if (_runde.Deler.Count + _bildeIder.Count > 0) {<em>@(_runde.Deler.Count + _bildeIder.Count)</em>}</button>
            </nav>

            @if (_visning == "rapp")
            {
                @Utfylling(ferdig)
            }
            else
            {
            <div class="srk-kropp">
                <div class="srk-venstre">
                    <div class="srk-verktoy">
                        <span class="srk-chips">
                            <button type="button" class="@(_filter == "alle" ? "pa" : "")" @onclick="@(() => _filter = "alle")">Alle <i>@_dorer.Count</i></button>
                            <button type="button" class="@(_filter == "ikke" ? "pa" : "")" @onclick="@(() => _filter = "ikke")">Ikke kontrollert <i>@gjenstar</i></button>
                            <button type="button" class="@(_filter == "avvik" ? "pa" : "")" @onclick="@(() => _filter = "avvik")">Avvik <i>@avvik</i></button>
                        </span>
                    </div>

                    @if (_visning == "plan" && _tegninger.Count > 0)
                    {
                        var tegning = _tegninger.FirstOrDefault(t => t.Id == _valgtTegning) ?? _tegninger[0];
                        <div class="srk-tegningvalg">
                            <label for="srk-tegning">Plantegning</label>
                            <select id="srk-tegning" value="@tegning.Id" @onchange="@(e => _valgtTegning = int.TryParse(e.Value?.ToString(), out var tid) ? tid : null)">
                                @foreach (var t in _tegninger)
                                {
                                    var paTegning = _dorer.Where(d => d.PlantegningId == t.Id).ToList();
                                    <option value="@t.Id">@t.Navn · @paTegning.Count(d => d.Status != ServicerundeDorStatus.IkkeKontrollert)/@paTegning.Count sjekket</option>
                                }
                            </select>
                            @if (_tegninger.Count > 1)
                            {
                                <span>@_tegninger.Count tegninger</span>
                            }
                        </div>
                        @if (tegning.ErBilde)
                        {
                            <div class="srk-plan" data-hjulzoom @key="tegning.Id">
                                <div class="srk-plan-flate" data-hjulzoom-flate>
                                    <img src="@($"/plantegningbilde/{tegning.Id}")" alt="@tegning.Navn" />
                                    @foreach (var d in Filtrert.Where(d => d.PlantegningId == tegning.Id && d.PosX.HasValue && d.PosY.HasValue))
                                    {
                                        <button type="button" @key="d.Id" class="srk-pin @PrikkKlasse(d) @(d == _valgt ? "valgt" : "")"
                                                style="left:@d.PosX!.Value.ToString(CultureInfo.InvariantCulture)%;top:@d.PosY!.Value.ToString(CultureInfo.InvariantCulture)%"
                                                title="@d.Dornummer @d.Rom" @onclick="@(() => Velg(d))"><i></i><span>@d.Dornummer</span></button>
                                    }
                                </div>
                            </div>
                            <div class="srk-forklaring">
                                <span><i class="ok"></i>OK</span>
                                <span><i class="avvik"></i>Avvik</span>
                                <span><i class="pagar"></i>Påbegynt</span>
                                <span><i class="ikke"></i>Ikke kontrollert</span>
                                <span class="srk-forklaring-h">Rull for å zoome · trykk på en dør</span>
                            </div>
                        }
                        else
                        {
                            <p class="srk-dempet">Tegningen «@tegning.Navn» er ikke et bilde og kan ikke vises med dørene på. Bruk dørlisten.</p>
                        }
                    }
                    else
                    {
                        <div class="srk-liste">
                            @if (Filtrert.Count == 0)
                            {
                                <p class="srk-dempet">Ingen dører her.</p>
                            }
                            @foreach (var gruppe in Filtrert.GroupBy(d => string.IsNullOrWhiteSpace(d.Etasje) ? "Uten etasje" : $"{d.Etasje}. etasje"))
                            {
                                <div class="srk-etg">@gruppe.Key</div>
                                @foreach (var d in gruppe)
                                {
                                    <button type="button" @key="d.Id" class="srk-rad @(d == _valgt ? "valgt" : "")" @onclick="@(() => Velg(d))">
                                        <span class="srk-prikk @PrikkKlasse(d)"></span>
                                        <b>@d.Dornummer</b>
                                        <span class="srk-rom">@d.Rom</span>
                                        <span class="srk-kat">@d.Kategori</span>
                                        <span class="srk-pill @PillKlasse(d.Status)">@StatusTekst(d.Status)</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
            }


                @* D9 (Prototype servicerunde enkel sjekk.html): døren sjekkes med ett valg -
                   Ikke sjekket / Sjekket / Avvik. «Sjekket» = alle punktene på døren er sjekket
                   (de settes OK, så rapporten viser hele listen). Sjekklisten vises bare til info. *@
                @if (_apen && _valgt is { } v)
                {
                    var indeks = _dorer.IndexOf(v);
                    var st = v.Status;
                    var stKl = st == ServicerundeDorStatus.Ok ? "ok" : st == ServicerundeDorStatus.Avvik ? "av" : "";
                    var grupper = v.Punkter.Where(p => !ErAvvikPunkt(p)).OrderBy(p => p.Rekkefolge)
                        .GroupBy(p => string.IsNullOrWhiteSpace(p.Kilde) ? "Generelt" : p.Kilde!).ToList();
                    var antallPunkter = v.Punkter.Count(p => !ErAvvikPunkt(p));
                    var avvikPunkt = v.Punkter.FirstOrDefault(ErAvvikPunkt);
                    var andreAvvik = v.Punkter.Where(p => !ErAvvikPunkt(p) && p.Status == ServicerundeDorStatus.Avvik).ToList();
                    var komponenter = ServicerundeMotor.LesKomponenter(v.KomponenterJson).ToList();
                    <div class="dk-bak" @onclick="@(() => _apen = false)">
                    <div class="dk" @onclick:stopPropagation="true">
                        <div class="dk-topp @stKl">
                            <div class="dk-r1">
                                <span class="dk-nr @stKl">@if (st == ServicerundeDorStatus.Ok) {<i>✓</i>} else if (st == ServicerundeDorStatus.Avvik) {<i>!</i>}<span>@v.Dornummer</span></span>
                                <div class="dk-tt">
                                    <b>Dør @v.Dornummer</b>
                                    <span>@(string.Join(" · ", new[] { v.Rom, string.IsNullOrWhiteSpace(v.Etasje) ? null : $"{v.Etasje}. etasje" }.Where(s => !string.IsNullOrWhiteSpace(s))))</span>
                                </div>
                                <button type="button" class="dk-x" title="Lukk" @onclick="@(() => _apen = false)">×</button>
                            </div>
                            <div class="dk-meta">
                                @if (!string.IsNullOrWhiteSpace(v.Kategori))
                                {
                                    <span class="kat">@v.Kategori</span>
                                }
                            </div>
                        </div>

                        <div class="dk-kropp">
                            @if (ferdig)
                            {
                                <span class="srk-pill @PillKlasse(st)" style="justify-self:start">@StatusTekst(st)</span>
                            }
                            else
                            {
                                <div class="d9-seg">
                                    <button type="button" class="@(st == ServicerundeDorStatus.IkkeKontrollert ? "pa" : "")" @onclick="@(() => SettDorStatus(v, ServicerundeDorStatus.IkkeKontrollert))">○ Ikke sjekket</button>
                                    <button type="button" class="ok @(st == ServicerundeDorStatus.Ok ? "pa" : "")" @onclick="@(() => SettDorStatus(v, ServicerundeDorStatus.Ok))">✓ Sjekket</button>
                                    <button type="button" class="av @(st == ServicerundeDorStatus.Avvik ? "pa" : "")" @onclick="@(() => SettDorStatus(v, ServicerundeDorStatus.Avvik))">⚠ Avvik</button>
                                </div>
                            }
                            <p class="dk-forkl">«Sjekket» = alle punktene som hører til dør @v.Dornummer er sjekket (@antallPunkter @(antallPunkter == 1 ? "punkt" : "punkter"))</p>

                            @if (st == ServicerundeDorStatus.Avvik)
                            {
                                <div class="dk-avvik">
                                    <div class="dk-avvik-t">⚠ Avvik på døren</div>
                                    @if (avvikPunkt is not null)
                                    {
                                        @if (ferdig)
                                        {
                                            <div><b>@avvikPunkt.Tekst</b>@if (!string.IsNullOrWhiteSpace(avvikPunkt.Kommentar)) {<span>: @avvikPunkt.Kommentar</span>}</div>
                                        }
                                        else
                                        {
                                            <select value="@(avvikPunkt.Kilde == "Generelt" ? "" : avvikPunkt.Kilde)" @onchange="@(e => SettAvvikType(v, e.Value?.ToString()))">
                                                <option value="">Hva gjelder det? (valgfritt)</option>
                                                @foreach (var g in grupper.Select(g => g.Key).Where(k => k != "Generelt"))
                                                {
                                                    <option value="@g">@g</option>
                                                }
                                            </select>
                                            <textarea placeholder="Hva er feil, og hva bør gjøres? Blir avvik på avtalen når runden fullføres." @onchange="@(e => SettAvvikTekst(v, e.Value?.ToString()))">@avvikPunkt.Kommentar</textarea>
                                        }
                                    }
                                    @foreach (var p in andreAvvik)
                                    {
                                        <div class="dk-avvik-l"><b>@p.Tekst</b>@if (!string.IsNullOrWhiteSpace(p.Kommentar)) {<span>: @p.Kommentar</span>}</div>
                                    }
                                </div>
                            }

                            @if (!ferdig && _uspesifisert.TryGetValue(v.DorId, out var mangler) && mangler.Count > 0)
                            {
                                <div class="srk-spes">
                                    <div class="srk-spes-t"><span class="srk-pill gul">Spesifiser</span><b>@mangler.Count @(mangler.Count == 1 ? "komponent" : "komponenter") uten produkt</b></div>
                                    @foreach (var type in mangler)
                                    {
                                        <div class="srk-spes-r" @key="type">
                                            <b>@type – hvilken modell?</b>
                                            <input placeholder="Søk" @onchange="@(e => SokProdukt(type, e.Value?.ToString()))" />
                                            <select @onchange="@(e => SpesifiserPaDor(v, type, e.Value?.ToString()))">
                                                <option value="">Velg …</option>
                                                @foreach (var pr in _produkter.GetValueOrDefault(type) ?? [])
                                                {
                                                    <option value="@pr.Id">@pr.Navn@(string.IsNullOrWhiteSpace(pr.Produktkode) ? "" : $" ({pr.Produktkode})")</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            }

                            @{ var dorMeldinger = _apneMeldinger.Where(m => m.Melding.DorId == v.DorId).ToList();
                               var dorAvvik = _apneAvvik.Where(a => a.DorId == v.DorId).ToList(); }
                            @foreach (var m in dorMeldinger)
                            {
                                <div class="dk-sak rod"><b><a href="@($"/driftsmelding/{m.Melding.Id}")">Åpen driftsmelding: @(m.Melding.Tittel ?? m.Melding.Tekst)</a></b><span>@m.Melding.OpprettetDato.ToString("dd.MM.yyyy") · @m.Navn · lukkes ikke av servicerunden</span></div>
                            }
                            @foreach (var a in dorAvvik)
                            {
                                <div class="dk-sak"><b><a href="@($"/avvik/{a.Id}")">Åpent avvik @a.NummerTekst: @(a.Tittel ?? a.Beskrivelse)</a></b><span>Registrert @a.OpprettetDato.ToString("dd.MM.yyyy") – sjekk om det er utbedret</span></div>
                            }
                            @if (_avvikFraRunden.TryGetValue(v.Id, out var rundeAvvik))
                            {
                                <a class="dk-sak rod" href="@($"/avvik/{rundeAvvik.Id}")"><b>@rundeAvvik.NummerTekst opprettet fra runden</b><span>Følges opp under Avvik og driftsmeldinger →</span></a>
                            }

                            @Seksjon("liste", "☰", "Sjekkliste", $"{antallPunkter} punkter", @<div class="dk-si">
                                @foreach (var gruppe in grupper)
                                {
                                    <div class="dk-grp" @key="gruppe.Key">
                                        <b>@gruppe.Key</b>
                                        <ul>
                                            @foreach (var p in gruppe)
                                            {
                                                <li @key="p.Id">@p.Tekst@if (!string.IsNullOrWhiteSpace(p.Standard)) {<em> (@p.Standard)</em>}</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (!ferdig)
                                {
                                    <div class="dk-ekstra">
                                        <input placeholder="Ekstra punkt for denne døren" @bind="_nyttPunkt" @bind:event="oninput" />
                                        <label title="Punktet kommer med på denne døren i alle senere runder"><input type="checkbox" @bind="_nyttPunktFast" />Fast</label>
                                        <button type="button" class="srk-knapp liten" disabled="@string.IsNullOrWhiteSpace(_nyttPunkt)" @onclick="@(() => LeggTilPunkt(v))">Legg til</button>
                                    </div>
                                }
                            </div>)
                            @Seksjon("notat", "✎", "Notat", string.IsNullOrWhiteSpace(v.Notat) ? "Tomt" : "1 notat", @<div class="dk-si">
                                @if (ferdig)
                                {
                                    <p class="srk-dempet">@(string.IsNullOrWhiteSpace(v.Notat) ? "Ingen notat." : v.Notat)</p>
                                }
                                else
                                {
                                    <textarea class="dk-felt" placeholder="Notat til døren …" @onchange="@(e => LagreNotat(v, e.Value?.ToString()))">@v.Notat</textarea>
                                }
                            </div>)
                            @Seksjon("komp", "⚙", "Komponenter", komponenter.Count.ToString(), @<div class="dk-si">
                                @foreach (var k in komponenter)
                                {
                                    <div class="dk-komp"><b>@k.Navn</b><span>@(k.Servicetype ?? k.Komponenttype ?? "–")</span></div>
                                }
                            </div>)
                            @if (_tidligere.TryGetValue(v.DorId, out var tidl) && tidl.Count > 0)
                            {
                                @Seksjon("hist", "↺", "Tidligere runder", tidl.Count.ToString(), @<div class="dk-si">
                                    @foreach (var t in tidl)
                                    {
                                        <div class="dk-hist"><b>@t.Dato.ToString("dd.MM.yyyy")</b><span class="srk-pill @PillKlasse(t.Status)">@StatusTekst(t.Status)</span>@if (!string.IsNullOrWhiteSpace(t.Merknad)) {<small>@t.Merknad</small>}</div>
                                    }
                                </div>)
                            }
                        </div>

                        <div class="dk-bunn">
                            <button type="button" class="srk-knapp" disabled="@(indeks <= 0)" @onclick="@(() => Velg(_dorer[indeks - 1]))">←</button>
                            <div class="dk-tell">
                                <b>Dør @(indeks + 1) av @_dorer.Count</b>
                                @if (_dorer.Count <= 40)
                                {
                                    <div class="dk-prikker">
                                        @foreach (var x in _dorer)
                                        {
                                            <i class="@(x.Status == ServicerundeDorStatus.Ok ? "ok" : x.Status == ServicerundeDorStatus.Avvik ? "av" : "") @(x == v ? "na" : "")"></i>
                                        }
                                    </div>
                                }
                            </div>
                            <button type="button" class="srk-knapp primaer" @onclick="NesteDor">Neste dør →</button>
                        </div>
                    </div>
                    </div>
                }

            @* Fullfør nederst: når montøren er ferdig med alt, låses runden. *@
            @if (ferdig)
            {
                <div class="ff-bunn les">
                    <div><b>Runden er fullført og låst</b><span>Ingenting kan endres. Rapporten ligger under Rapporter på avtalen.</span></div>
                </div>
            }
            else
            {
                <div class="ff-bunn">
                    <div class="ff-sjekk">
                        <span class="@(gjenstar == 0 ? "ok" : "")">@(ok + avvik) av @_dorer.Count dører sjekket</span>
                        <span class="@(ServicerundeMotor.ErStandardStatus(_runde.StatusBeskrivelse) ? "" : "ok")">Oppsummering</span>
                        <span class="@(string.IsNullOrWhiteSpace(RikTekst.TilTekst(_runde.Anbefalinger)) ? "" : "ok")">Anbefalinger</span>
                    </div>
                    <span class="ff-sp"></span>
                    <div class="ff-tekst"><b>Ferdig med alt?</b><span>Fullfør runden når alle dører er sjekket og rapporten er fylt ut.</span></div>
                    <button type="button" class="srk-knapp primaer ff-knapp" @onclick="@(() => _visFullfor = true)">Fullfør og lås runden</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int RundeId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Servicerunde? _runde;
    private bool _ikkeFunnet, _visFullfor;
    private string _avtaleNavn = "";
    private List<ServicerundeDor> _dorer = [];
    private ServicerundeDor? _valgt;
    private string _visning = "plan", _filter = "alle";
    private int? _valgtTegning;
    private int? _brukerId;
    private List<DriftHelper.MeldingStatus> _apneMeldinger = [];
    private List<Avvik> _apneAvvik = [];
    private Dictionary<int, List<TidligereRad>> _tidligere = [];
    private List<Tegning> _tegninger = [];
    private Dictionary<int, Avvik> _avvikFraRunden = [];

    private async Task LastAvvikFraRunden()
    {
        var ider = _dorer.Select(d => d.Id).ToList();
        _avvikFraRunden = (await Db.Avvik.AsNoTracking().Where(a => a.ServicerundeDorId != null && ider.Contains(a.ServicerundeDorId.Value)).ToListAsync())
            .GroupBy(a => a.ServicerundeDorId!.Value).ToDictionary(g => g.Key, g => g.First());
    }

    private sealed record TidligereRad(DateTime Dato, string Status, string? Merknad);
    private sealed record Tegning(int Id, string Navn, bool ErBilde);

    private List<ServicerundeDor> Filtrert => _filter switch
    {
        "ikke" => _dorer.Where(d => d.Status == ServicerundeDorStatus.IkkeKontrollert).ToList(),
        "avvik" => _dorer.Where(d => d.Status == ServicerundeDorStatus.Avvik).ToList(),
        _ => _dorer
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            _brukerId = (await AuthStateTask).User.VisningsBrukerId();
        }
        _runde = await Db.Servicerunder.Include(r => r.Prosjekt)
            .Include(r => r.Dorer).ThenInclude(d => d.Punkter)
            .Include(r => r.Deler)
            .FirstOrDefaultAsync(r => r.Id == RundeId && r.DorForDor);
        if (_runde is null)
        {
            _ikkeFunnet = true;
            return;
        }
        _bildeIder = await Db.ServicerundeMedia.AsNoTracking().Where(m => m.ServicerundeId == RundeId).OrderBy(m => m.Id).Select(m => m.Id).ToListAsync();
        _avtaleNavn = _runde.Prosjekt?.Navn ?? "Serviceavtale";
        _dorer = _runde.Dorer.OrderBy(d => d.Rekkefolge).ToList();
        if (_runde.FullfortDato is null && _dorer.Any(d => d.PosX is null || d.PlantegningId is null))
        {
            // Døren er plassert på plantegningen etter at runden startet – hent plasseringen nå.
            var mangler = _dorer.Where(d => d.PosX is null || d.PlantegningId is null).Select(d => d.DorId).ToList();
            var plass = await Db.Dorer.AsNoTracking()
                .Where(d => mangler.Contains(d.Id) && d.PlantegningId != null && d.PosX != null && d.PosY != null)
                .Select(d => new { d.Id, d.PlantegningId, Navn = d.Plantegning!.Navn, d.PosX, d.PosY })
                .ToListAsync();
            foreach (var x in plass)
            {
                foreach (var rd in _dorer.Where(r => r.DorId == x.Id))
                {
                    rd.PlantegningId = x.PlantegningId;
                    rd.PlantegningNavn = x.Navn;
                    rd.PosX = x.PosX;
                    rd.PosY = x.PosY;
                }
            }
            if (plass.Count > 0)
            {
                await Db.SaveChangesAsync();
            }
        }
        _valgt ??= _dorer.FirstOrDefault(d => d.Status == ServicerundeDorStatus.IkkeKontrollert) ?? _dorer.FirstOrDefault();

        var dorIder = _dorer.Select(d => d.DorId).ToList();
        _apneMeldinger = (await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => dorIder.Contains(m.DorId)))).Where(m => m.ErApen).ToList();
        _apneAvvik = await Db.Avvik.AsNoTracking().Where(a => dorIder.Contains(a.DorId) && a.Status != AvvikStatus.Godkjent && a.Status != AvvikStatus.Lukket).ToListAsync();

        var tidligere = await Db.ServicerundeDorer.AsNoTracking()
            .Where(d => dorIder.Contains(d.DorId) && d.ServicerundeId != RundeId && d.Servicerunde!.FullfortDato != null)
            .Select(d => new { d.DorId, d.Servicerunde!.Dato, d.Status, d.Notat })
            .ToListAsync();
        _tidligere = tidligere.GroupBy(x => x.DorId).ToDictionary(g => g.Key,
            g => g.OrderByDescending(x => x.Dato).Take(3).Select(x => new TidligereRad(x.Dato, x.Status, x.Notat)).ToList());

        var tegningIder = _dorer.Where(d => d.PlantegningId != null).Select(d => d.PlantegningId!.Value).Distinct().ToList();
        var finnes = await Db.Plantegninger.AsNoTracking().Where(p => tegningIder.Contains(p.Id)).Select(p => new { p.Id, p.Navn, p.ContentType }).ToListAsync();
        _tegninger = tegningIder.Select(id =>
        {
            var f = finnes.FirstOrDefault(x => x.Id == id);
            var navn = f?.Navn ?? _dorer.First(d => d.PlantegningId == id).PlantegningNavn ?? "Plantegning";
            return new Tegning(id, navn, f is not null && f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        }).OrderBy(t => t.Navn).ToList();
        _valgtTegning ??= _valgt?.PlantegningId ?? _tegninger.FirstOrDefault()?.Id;
        if (!_tegninger.Any(t => t.ErBilde) && _visning == "plan")
        {
            _visning = "liste";
        }
        await LastAvvikFraRunden();
        await LastUspesifisert();
    }

    // U6: døren åpnes i et vindu over plantegningen.
    private bool _apen;

    private Task Velg(ServicerundeDor d)
    {
        _valgt = d;
        _apen = true;
        _visSaker = false;
        if (d.PlantegningId is { } t)
        {
            _valgtTegning = t;
        }
        return Task.CompletedTask;
    }

    private async Task NesteDor()
    {
        if (_valgt is null) return;
        var i = _dorer.IndexOf(_valgt);
        var neste = _dorer.Skip(i + 1).FirstOrDefault(d => d.Status == ServicerundeDorStatus.IkkeKontrollert)
            ?? _dorer.FirstOrDefault(d => d.Status == ServicerundeDorStatus.IkkeKontrollert)
            ?? (i + 1 < _dorer.Count ? _dorer[i + 1] : null);
        if (neste is not null)
        {
            await Velg(neste);
        }
    }

    // Åpne saker på døren (driftsmeldinger og avvik) vises samlet når det er flere.
    private bool _visSaker;

    private bool KanEndre => _runde is { FullfortDato: null };

    // T4: komponenter på dørene som bare har type (fra befaringen).
    private Dictionary<int, List<string>> _uspesifisert = [];
    private Dictionary<string, List<Component>> _produkter = [];
    private string _nyttPunkt = "";
    private bool _nyttPunktFast = true;

    private async Task LastUspesifisert()
    {
        var dorIder = _dorer.Select(d => d.DorId).ToList();
        var typeKart = await ServiceRegelMotor.HentTypeKart(Db);
        var rader = await Db.DorKomponenter.AsNoTracking()
            .Where(k => dorIder.Contains(k.DorId) && k.Component!.ErPlassholder)
            .Select(k => new { k.DorId, k.Component!.ComponentTypeId })
            .ToListAsync();
        _uspesifisert = rader
            .Select(r => (r.DorId, Type: r.ComponentTypeId is { } id ? typeKart.GetValueOrDefault(id) : null))
            .Where(x => x.Type is not null)
            .GroupBy(x => x.DorId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Type!).Distinct().ToList());
        foreach (var t in _uspesifisert.Values.SelectMany(x => x).Distinct().Where(t => !_produkter.ContainsKey(t)))
        {
            _produkter[t] = await ServiceBefaring.ProdukterFor(Db, t, null);
        }
    }

    private async Task SokProdukt(string type, string? sok) =>
        _produkter[type] = await ServiceBefaring.ProdukterFor(Db, type, sok);

    private async Task SpesifiserPaDor(ServicerundeDor v, string type, string? verdi)
    {
        if (!KanEndre || !int.TryParse(verdi, out var pid)) return;
        Db.LoggBrukerId = _brukerId;
        await ServiceBefaring.Spesifiser(Db, [v.DorId], type, pid);
        Db.LoggBrukerId = null;
        await LastUspesifisert();
    }

    private async Task LeggTilPunkt(ServicerundeDor v)
    {
        var tekst = _nyttPunkt.Trim();
        if (!KanEndre || tekst.Length == 0) return;
        var nr = v.Punkter.Count == 0 ? 0 : v.Punkter.Max(p => p.Rekkefolge) + 1;
        // Er døren allerede sjekket, regnes det nye punktet som sjekket også.
        v.Punkter.Add(new ServicerundeDorPunkt { Tekst = tekst, Kilde = _nyttPunktFast ? "Denne døren" : "Kun denne runden", Rekkefolge = nr,
            Status = v.Status == ServicerundeDorStatus.IkkeKontrollert ? null : ServicerundeDorStatus.Ok });
        if (_nyttPunktFast)
        {
            Db.ServiceKontrollpunkter.Add(new ServiceKontrollpunkt { Servicetype = "Dør", Tekst = tekst, DorId = v.DorId, Rekkefolge = nr, EndretDato = DateTime.Now });
        }
        _nyttPunkt = "";
        await OppdaterDor(v);
    }

    private async Task OppdaterDor(ServicerundeDor d)
    {
        d.Status = ServicerundeMotor.BeregnStatus(d);
        d.KontrollertDato = d.Status == ServicerundeDorStatus.IkkeKontrollert ? null : DateTime.Now;
        d.KontrollertAvBrukerId = d.Status == ServicerundeDorStatus.IkkeKontrollert ? null : _brukerId;
        await Db.SaveChangesAsync();
    }

    // ---- D9: én status for hele døren ----
    // Avviket lagres som et eget punkt («Avvik på …»), så det blir et vanlig
    // avvik når runden fullføres (ServicerundeMotor.Fullfor) og står på rapporten.
    private const string AvvikPrefiks = "Avvik på ";
    private static bool ErAvvikPunkt(ServicerundeDorPunkt p) => p.Tekst.StartsWith(AvvikPrefiks, StringComparison.Ordinal);

    private readonly HashSet<string> _apneSeksjoner = [];

    private RenderFragment Seksjon(string nokkel, string ikon, string tittel, string info, RenderFragment innhold) => __builder =>
    {
        var apen = _apneSeksjoner.Contains(nokkel);
        <div class="dk-seksjon @(apen ? "apen" : "")">
            <button type="button" class="dk-sh" @onclick="@(() => { if (!_apneSeksjoner.Remove(nokkel)) { _apneSeksjoner.Add(nokkel); } })">
                <span class="dk-ik">@ikon</span>@tittel<em>@info</em><span class="dk-pil">›</span>
            </button>
            @if (apen)
            {
                @innhold
            }
        </div>
    };

    private async Task SettDorStatus(ServicerundeDor d, string status)
    {
        if (!KanEndre) return;
        var avvikPunkter = d.Punkter.Where(ErAvvikPunkt).ToList();
        var vanlige = d.Punkter.Where(p => !ErAvvikPunkt(p)).ToList();
        if (status == ServicerundeDorStatus.Ok)
        {
            foreach (var p in vanlige)
            {
                p.Status = ServicerundeDorStatus.Ok;
                p.Kommentar = null;
            }
            FjernAvvikPunkter(d, avvikPunkter);
        }
        else if (status == ServicerundeDorStatus.Avvik)
        {
            foreach (var p in vanlige.Where(p => p.Status != ServicerundeDorStatus.Avvik))
            {
                p.Status = ServicerundeDorStatus.Ok;
            }
            if (avvikPunkter.Count == 0 && !vanlige.Any(p => p.Status == ServicerundeDorStatus.Avvik))
            {
                var nr = d.Punkter.Count == 0 ? 0 : d.Punkter.Max(p => p.Rekkefolge) + 1;
                d.Punkter.Add(new ServicerundeDorPunkt { Tekst = AvvikPrefiks + "døren", Kilde = "Generelt", Status = ServicerundeDorStatus.Avvik, Rekkefolge = nr });
            }
        }
        else
        {
            foreach (var p in vanlige)
            {
                p.Status = null;
                p.Kommentar = null;
            }
            FjernAvvikPunkter(d, avvikPunkter);
        }
        await OppdaterDor(d);
    }

    private void FjernAvvikPunkter(ServicerundeDor d, List<ServicerundeDorPunkt> punkter)
    {
        foreach (var p in punkter)
        {
            d.Punkter.Remove(p);
            if (p.Id != 0)
            {
                Db.Remove(p);
            }
        }
    }

    private async Task SettAvvikType(ServicerundeDor d, string? gruppe)
    {
        if (!KanEndre || d.Punkter.FirstOrDefault(ErAvvikPunkt) is not { } p) return;
        p.Kilde = string.IsNullOrWhiteSpace(gruppe) ? "Generelt" : gruppe;
        p.Tekst = AvvikPrefiks + (string.IsNullOrWhiteSpace(gruppe) ? "døren" : gruppe.ToLowerInvariant());
        await Db.SaveChangesAsync();
    }

    private async Task SettAvvikTekst(ServicerundeDor d, string? tekst)
    {
        if (!KanEndre || d.Punkter.FirstOrDefault(ErAvvikPunkt) is not { } p) return;
        p.Kommentar = string.IsNullOrWhiteSpace(tekst) ? null : tekst.Trim();
        await Db.SaveChangesAsync();
    }

    private async Task SettPunkt(ServicerundeDor d, ServicerundeDorPunkt p, string status)
    {
        if (!KanEndre) return;
        p.Status = p.Status == status ? null : status;
        if (p.Status != ServicerundeDorStatus.Avvik)
        {
            p.Kommentar = null;
        }
        await OppdaterDor(d);
    }

    // Prikkfarge: OK, avvik, påbegynt (noen punkter satt) eller ikke kontrollert.
    private static string PrikkKlasse(ServicerundeDor d) =>
        d.Status == ServicerundeDorStatus.Ok ? "ok"
        : d.Status == ServicerundeDorStatus.Avvik ? "avvik"
        : d.Punkter.Any(p => p.Status is not null) ? "pagar"
        : "ikke";

    private async Task GruppeOk(ServicerundeDor d, string kilde)
    {
        if (!KanEndre) return;
        foreach (var p in d.Punkter.Where(p => p.Status is null && (string.IsNullOrWhiteSpace(p.Kilde) ? "Generelt" : p.Kilde) == kilde))
        {
            p.Status = ServicerundeDorStatus.Ok;
        }
        await OppdaterDor(d);
    }

    private async Task RestenOk(ServicerundeDor d)
    {
        if (!KanEndre) return;
        foreach (var p in d.Punkter.Where(p => p.Status is null))
        {
            p.Status = ServicerundeDorStatus.Ok;
        }
        await OppdaterDor(d);
    }

    private async Task LagreKommentar(ServicerundeDorPunkt p, string? tekst)
    {
        if (!KanEndre) return;
        p.Kommentar = string.IsNullOrWhiteSpace(tekst) ? null : tekst.Trim();
        await Db.SaveChangesAsync();
    }

    private async Task LagreNotat(ServicerundeDor d, string? tekst)
    {
        if (!KanEndre) return;
        d.Notat = string.IsNullOrWhiteSpace(tekst) ? null : tekst.Trim();
        await Db.SaveChangesAsync();
    }

    private async Task Fullfor()
    {
        if (_runde is null || !KanEndre) return;
        foreach (var tom in _runde.Deler.Where(d => string.IsNullOrWhiteSpace(d.Beskrivelse)).ToList())
        {
            _runde.Deler.Remove(tom);
            Db.ServicerundeDeler.Remove(tom);
        }
        await ServicerundeMotor.Fullfor(Db, _runde, _brukerId);
        _visFullfor = false;
        await LastAvvikFraRunden();
        await LagreRapport();
    }

    // ---- Utfylling til rapporten ----
