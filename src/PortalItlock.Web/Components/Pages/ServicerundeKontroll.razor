    private async Task LagreOppsummering(string? html)
    {
        if (_runde is null || !KanEndre) return;
        _runde.StatusBeskrivelse = string.IsNullOrWhiteSpace(RikTekst.TilTekst(html)) ? "Pågår" : html!;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task LagreAnbefalinger(string? html)
    {
        if (_runde is null || !KanEndre) return;
        _runde.Anbefalinger = string.IsNullOrWhiteSpace(RikTekst.TilTekst(html)) ? null : html;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task LeggTilDel()
    {
        if (_runde is null || !KanEndre) return;
        _runde.Deler.Add(new ServicerundeDel { Beskrivelse = "", Dato = DateTime.Now });
        await Db.SaveChangesAsync();
    }

    private async Task SettDelDor(ServicerundeDel d, string? verdi)
    {
        if (!KanEndre) return;
        d.DorId = int.TryParse(verdi, out var id) ? id : null;
        await Db.SaveChangesAsync();
    }

    private async Task SettDelTekst(ServicerundeDel d, string? verdi, bool feil)
    {
        if (!KanEndre) return;
        var t = verdi?.Trim() ?? "";
        if (feil) d.Feil = t.Length == 0 ? null : t; else d.Beskrivelse = t;
        await Db.SaveChangesAsync();
    }

    private async Task FjernDel(ServicerundeDel d)
    {
        if (_runde is null || !KanEndre) return;
        _runde.Deler.Remove(d);
        Db.ServicerundeDeler.Remove(d);
        await Db.SaveChangesAsync();
    }

    private async Task SettNesteService(ChangeEventArgs e)
    {
        if (_runde is null || !KanEndre) return;
        _runde.NesteServiceDato = DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt) ? dt.Date : null;
        await Db.SaveChangesAsync();
    }

    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        if (_runde is null || !KanEndre) return;
        _bildeFeil = null;
        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }
            var m = new ServicerundeMedia
            {
                ServicerundeId = _runde.Id,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name
            };
            Db.ServicerundeMedia.Add(m);
            await Db.SaveChangesAsync();
            Db.Entry(m).State = EntityState.Detached;
            _bildeIder.Add(m.Id);
        }
    }

    private async Task FjernBilde(int id)
    {
        if (!KanEndre) return;
        await Db.ServicerundeMedia.Where(m => m.Id == id && m.ServicerundeId == RundeId).ExecuteDeleteAsync();
        _bildeIder.Remove(id);
    }

    // ---- Fase 6: rapport og kundens signatur ----
    private string? _signertAv, _signFeil;
    private bool _signaturKlar;

    // Rapporten lagres automatisk på runden (og vises under rundene på avtalen).
    private async Task LagreRapport()
    {
        if (_runde is null) return;
        var bytes = await RapportPdf.GenerateAsync(_runde.Id);
        if (bytes is not null)
        {
            await LagretPdf.LagreAsync("Servicerunde", _runde.Id, $"Servicerapport - {_avtaleNavn} - {_runde.Dato:dd.MM.yyyy}.pdf", bytes);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var trengs = _runde is { FullfortDato: not null } r && r.KundeSignatur is not { Length: > 0 };
        if (trengs && !_signaturKlar)
        {
            _signaturKlar = true;
            await JS.InvokeVoidAsync("signatur.init", "sig-servicerunde");
        }
        else if (!trengs)
        {
            _signaturKlar = false;
        }
    }

    private async Task TomSignatur() => await JS.InvokeVoidAsync("signatur.clear", "sig-servicerunde");

    private async Task LagreSignatur()
    {
        if (_runde is null || string.IsNullOrWhiteSpace(_signertAv)) return;
        var b64 = await JS.InvokeAsync<string?>("signatur.getPngBase64", "sig-servicerunde");
        if (string.IsNullOrEmpty(b64))
        {
            _signFeil = "Signaturfeltet er tomt.";
            return;
        }
        _signFeil = null;
        _runde.KundeSignatur = Convert.FromBase64String(b64);
        _runde.KundeSignertAv = _signertAv.Trim();
        _runde.KundeSignertDato = DateTime.Now;
        await Db.SaveChangesAsync();
        await LagreRapport();
    }

    private double Pst(int n) => _dorer.Count == 0 ? 0 : Math.Round(100.0 * n / _dorer.Count, 1);

    private static string StatusTekst(string s) => s switch
    {
        ServicerundeDorStatus.Ok => "OK",
        ServicerundeDorStatus.Avvik => "Avvik",
        _ => "Ikke kontrollert"
    };

    private static string PillKlasse(string s) => s switch
    {
        ServicerundeDorStatus.Ok => "gronn",
        ServicerundeDorStatus.Avvik => "rod",
        _ => "gra"
    };
