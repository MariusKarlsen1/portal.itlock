@page "/rapporter/produkt"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Produktrapport - itlock</PageTitle>

<a class="back-link" href="/rapportermodul">&larr; Tilbake til rapporter</a>
<h1>Produktrapport</h1>
<p class="section-hint">
    Salg pr. vare for valgt periode, beregnet fra ferdigmeldte arbeidsordre i
    portalen (samme oppsett som Tripletex sin produktrapport, men uavhengig
    av om ordren er fakturert i Tripletex ennå).
</p>

<div class="rapport-filter">
    <label>
        Fra
        <input type="date" @bind="_fraDato" />
    </label>
    <label>
        Til
        <input type="date" @bind="_tilDato" />
    </label>
    <label>
        Kunde (valgfritt)
        <input @bind="_kundeSok" @bind:event="oninput" placeholder="Kundenavn - la stå tomt for alle" />
    </label>
    <button type="button" class="save-button" @onclick="HentRapport" disabled="@_lasterNa">
        @(_lasterNa ? "Henter..." : "Vis rapport")
    </button>
</div>

@if (_harHentet)
{
    @if (_rader.Count == 0)
    {
        <p class="list-empty">Ingen ferdigmeldt salg i denne perioden (evt. med dette kundefilteret).</p>
    }
    else
    {
        <table class="rapport-table">
            <thead>
                <tr>
                    <th>Vare</th>
                    <th>Antall</th>
                    <th>Omsetning</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rader)
                {
                    <tr>
                        <td>@r.Navn</td>
                        <td class="tall-cell">@r.Antall.ToString("N0", Kultur)</td>
                        <td class="tall-cell">@r.Sum.ToString("N0", Kultur) kr</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private DateTime _fraDato = new(DateTime.Today.Year, 1, 1);
    private DateTime _tilDato = DateTime.Today;
    private string _kundeSok = "";
    private bool _lasterNa;
    private bool _harHentet;

    private sealed record ProduktRad(string Navn, decimal Antall, decimal Sum);
    private List<ProduktRad> _rader = [];

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _lasterNa = true;
        try
        {
            var tilEksklusiv = _tilDato.Date.AddDays(1);
            var query = Db.Arbeidsordre
                .Where(a => a.FullfortDato != null && a.FullfortDato >= _fraDato.Date && a.FullfortDato < tilEksklusiv);

            if (!string.IsNullOrWhiteSpace(_kundeSok))
            {
                query = query.Where(a =>
                    (a.Kunde != null && a.Kunde.Navn.Contains(_kundeSok))
                    || (a.Prosjekt != null && a.Prosjekt.Kunde != null && a.Prosjekt.Kunde.Navn.Contains(_kundeSok)));
            }

            var ordrer = await query
                .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer).ThenInclude(l => l.Component)
                .Include(a => a.Varer).ThenInclude(v => v.Component)
                .ToListAsync();

            _rader = ordrer
                .SelectMany(ArbeidsordreOkonomiBeregner.BeregnLinjer)
                .GroupBy(l => l.Navn)
                .Select(g => new ProduktRad(g.Key, g.Sum(l => l.Antall), g.Sum(l => l.Belop)))
                .OrderByDescending(r => r.Sum)
                .ToList();
            _harHentet = true;
        }
        finally
        {
            _lasterNa = false;
        }
    }
}
