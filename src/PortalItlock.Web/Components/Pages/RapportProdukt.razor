@page "/rapporter/produkt"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Produktrapport - Full Kontroll</PageTitle>

<RapportRamme Tittel="Produktrapport" Undertittel="Salg per vare og arbeid." Ikon="box" Kilde="portal"
              Periode="_periode" OnPeriodeEndret="HentRapport" VisSammenlign="true" Laster="_laster"
              OnEksporter="Eksporter">
    <Filtre>
        <label class="pr-kunde">
            <Icon Name="users" />
            <input type="search" placeholder="Alle kunder" aria-label="Filtrer på kunde" @bind="_kundeSok" @bind:after="HentRapport" />
        </label>
    </Filtre>
    <ChildContent>
        @if (_harHentet && _rader.Count == 0)
        {
            <p class="rr-tom">Ingen ferdigmeldt salg i denne perioden@(string.IsNullOrWhiteSpace(_kundeSok) ? "" : " for denne kunden").</p>
        }
        else if (_harHentet)
        {
            var total = _rader.Sum(r => r.Sum);
            var antall = _rader.Where(r => !r.ErArbeid).Sum(r => r.Antall);
            var arbeid = _rader.Where(r => r.ErArbeid).Sum(r => r.Sum);
            decimal? totalFor = Sml ? _forrige.Values.Sum(v => v.Sum) : null;
            decimal? antallFor = Sml ? _forrige.Values.Where(v => !v.ErArbeid).Sum(v => v.Antall) : null;
            <div class="rr-kpis">
                <div class="rr-kpi"><small>Omsetning</small><b>@RapportPeriode.Kr(total)</b><span><RapportDelta Naa="total" For="totalFor" /> @(Sml ? $"mot {_periode.SmlTekst}" : "i perioden")</span></div>
                <div class="rr-kpi"><small>Solgte varer</small><b>@RapportPeriode.Tall(antall)</b><span><RapportDelta Naa="antall" For="antallFor" /> enheter</span></div>
                <div class="rr-kpi"><small>Ulike varer</small><b>@_rader.Count(r => !r.ErArbeid)</b><span>solgt minst én gang</span></div>
                <div class="rr-kpi"><small>Varer / arbeid</small><b>@Andel(total - arbeid, total) / @Andel(arbeid, total)</b><span>% av omsetningen</span></div>
            </div>

            <div class="rr-tile">
                <div class="rr-tile-t">
                    <h2>Salg per vare</h2>
                    <div class="rr-tile-verktoy">
                        <div class="rr-minseg">
                            <button type="button" class="@(_sorter == "sum" ? "pa" : "")" @onclick='@(() => _sorter = "sum")'>Omsetning</button>
                            <button type="button" class="@(_sorter == "antall" ? "pa" : "")" @onclick='@(() => _sorter = "antall")'>Antall</button>
                            <button type="button" class="@(_sorter == "pris" ? "pa" : "")" @onclick='@(() => _sorter = "pris")'>Snittpris</button>
                        </div>
                        <label class="rr-sok"><Icon Name="search" /><input type="search" placeholder="Søk vare …" @bind="_sok" @bind:event="oninput" /></label>
                    </div>
                </div>
                @{
                    var liste = Sortert;
                    var vis = _visAlle ? liste : liste.Take(15).ToList();
                    var maks = liste.Count == 0 ? 0 : liste.Max(r => r.Sum);
                }
                @if (liste.Count == 0)
                {
                    <p class="rr-tom">Ingen varer passer søket.</p>
                }
                else
                {
                    <div class="rr-tabwrap">
                        <table class="rr-tab">
                            <thead>
                                <tr>
                                    <th>Vare</th>
                                    <th>Andel</th>
                                    <th class="n">Antall</th>
                                    <th class="n">Snittpris</th>
                                    <th class="n">Omsetning</th>
                                    @if (Sml)
                                    {
                                        <th class="n">Endring</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in vis)
                                {
                                    <tr>
                                        <td>@r.Navn <span class="rr-pille @(r.ErArbeid ? "rr-p-blaa" : "rr-p-gra")">@(r.ErArbeid ? "Arbeid" : "Vare")</span></td>
                                        <td><span class="rr-andel"><span class="rr-bar"><i style="width:@Pst(r.Sum, maks)"></i></span><span>@RapportPeriode.Prosent(r.Sum, total)</span></span></td>
                                        <td class="n">@RapportPeriode.Tall(r.Antall)</td>
                                        <td class="n">@RapportPeriode.Kr(r.Antall == 0 ? 0 : r.Sum / r.Antall)</td>
                                        <td class="n">@RapportPeriode.Kr(r.Sum)</td>
                                        @if (Sml)
                                        {
                                            <td class="n"><RapportDelta Naa="r.Sum" For="(_forrige.TryGetValue(r.Navn, out var f) ? f.Sum : 0)" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4">Sum @(string.IsNullOrWhiteSpace(_sok) ? "" : "(filtrert)")</td>
                                    <td class="n">@RapportPeriode.Kr(liste.Sum(r => r.Sum))</td>
                                    @if (Sml)
                                    {
                                        <td></td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    @if (liste.Count > 15)
                    {
                        <div class="rr-mer">
                            <button type="button" class="rr-knapp liten" @onclick="@(() => _visAlle = !_visAlle)">
                                @(_visAlle ? "Vis bare topp 15 ↑" : $"Vis alle {liste.Count} ↓")
                            </button>
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
</RapportRamme>

@code {
    private readonly RapportPeriode _periode = new();
    private bool _laster;
    private bool _harHentet;
    private string _kundeSok = "";
    private string _sok = "";
    private string _sorter = "sum";
    private bool _visAlle;

    private sealed record ProduktRad(string Navn, bool ErArbeid, decimal Antall, decimal Sum);
    private List<ProduktRad> _rader = [];
    private Dictionary<string, ProduktRad> _forrige = [];

    private bool Sml => _periode.Sammenlign;

    private static string Pst(decimal del, decimal total) =>
        (total == 0 ? 0 : Math.Max(0, del) / total * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Andel(decimal del, decimal total) =>
        (total == 0 ? 0 : del / total * 100).ToString("0", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"));

    private List<ProduktRad> Sortert
    {
        get
        {
            var liste = _rader.Where(r => string.IsNullOrWhiteSpace(_sok) || r.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase));
            return (_sorter switch
            {
                "antall" => liste.OrderByDescending(r => r.Antall),
                "pris" => liste.OrderByDescending(r => r.Antall == 0 ? 0 : r.Sum / r.Antall),
                _ => liste.OrderByDescending(r => r.Sum)
            }).ToList();
        }
    }

    private static List<ProduktRad> Grupper(List<RapportData.OrdreLinjer> ordrer) => ordrer
        .SelectMany(o => o.Linjer)
        .GroupBy(l => l.Navn)
        .Select(g => new ProduktRad(g.Key, g.All(l => l.ComponentId is null), g.Sum(l => l.Antall), g.Sum(l => l.Belop)))
        .ToList();

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _laster = true;
        try
        {
            _rader = Grupper(await RapportData.HentAsync(Db, _periode.Fra, _periode.Til, _kundeSok.Trim()));
            _forrige = Sml
                ? Grupper(await RapportData.HentAsync(Db, _periode.SmlFra, _periode.SmlTil, _kundeSok.Trim())).ToDictionary(r => r.Navn)
                : [];
            _harHentet = true;
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task Eksporter()
    {
        var rader = new List<object?[]> { new object?[] { "Vare", "Type", "Antall", "Snittpris", "Omsetning" } };
        rader.AddRange(Sortert.Select(r => new object?[]
        {
            r.Navn, r.ErArbeid ? "Arbeid" : "Vare", r.Antall, r.Antall == 0 ? 0 : Math.Round(r.Sum / r.Antall, 2), r.Sum
        }));
        await JS.InvokeVoidAsync("rapport.lastNedCsv", $"Produktrapport {_periode.Tekst}.csv", RapportData.Csv(rader));
    }
}
