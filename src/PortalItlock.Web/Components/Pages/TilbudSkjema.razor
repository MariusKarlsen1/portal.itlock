    [JSInvokable]
    public async Task FullforDrag(int draggetLinjeId, int? maalLinjeId)
    {
        if (_tilbud is null || maalLinjeId is null || draggetLinjeId == maalLinjeId)
        {
            return;
        }

        var dragget = _tilbud.Linjer.FirstOrDefault(l => l.Id == draggetLinjeId);
        var maal = _tilbud.Linjer.FirstOrDefault(l => l.Id == maalLinjeId);
        if (dragget is null || maal is null)
        {
            return;
        }

        var ordered = _tilbud.Linjer.OrderBy(l => l.Rekkefolge).ToList();
        ordered.Remove(dragget);
        var maalIndex = ordered.IndexOf(maal);
        ordered.Insert(maalIndex, dragget);

        for (var i = 0; i < ordered.Count; i++)
        {
            ordered[i].Rekkefolge = i;
        }

        await Db.SaveChangesAsync();
        StateHasChanged();
    }

