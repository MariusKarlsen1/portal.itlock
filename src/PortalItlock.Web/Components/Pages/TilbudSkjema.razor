            return _tilbud.SendtDato is { } sendt
                ? $"E-post til {til} {sendt.Date.AddDays(dager):dddd d. MMMM}, hvis tilbudet fortsatt står som sendt."
                : $"E-post til {til} {dager} dager etter at status settes til «{EndringsmeldingStatus.SendtTilKunde.Visningsnavn()}».";
