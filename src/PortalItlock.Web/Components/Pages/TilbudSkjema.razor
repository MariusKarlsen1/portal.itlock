    private decimal BeregnUtpris(decimal innpris, decimal? veiledende = null) =>
        BeregnUtpris(innpris, veiledende, _tilbud!.PrisType, _tilbud.PrisType == TilbudPrisType.Rabatt ? 0 : _tilbud.Prosentsats);

    private static decimal BeregnUtpris(decimal innpris, decimal? veiledende, TilbudPrisType prisType, decimal prosentsats) => prisType switch
    {
        TilbudPrisType.Paslag => Math.Round(innpris * (1 + prosentsats / 100m), 2),
        TilbudPrisType.Veiledende => veiledende ?? innpris,
        TilbudPrisType.Rabatt => Math.Round((veiledende ?? innpris) * (1 - prosentsats / 100m), 2),
        _ => prosentsats >= 100 ? innpris : Math.Round(innpris / (1 - prosentsats / 100m), 2)
    };

    private void OppdaterLinjePris(TilbudLinje l)
    {
        if (l.Component?.IngenRabattTilgjengelig == true)
        {
            l.RabattProsent = 0;
        }

        var prisType = l.PrisType ?? _tilbud!.PrisType;
        if (prisType == TilbudPrisType.Rabatt)
        {
            l.Utpris = BeregnUtpris(l.Innpris, l.PrisVeiledende, prisType, l.RabattProsent);
            return;
        }

        var prosentsats = l.Prosentsats ?? _tilbud!.Prosentsats;
        var beregnet = BeregnUtpris(l.Innpris, l.PrisVeiledende, prisType, prosentsats);
        l.Utpris = Math.Round(beregnet * (1 - l.RabattProsent / 100m), 2);
    }

