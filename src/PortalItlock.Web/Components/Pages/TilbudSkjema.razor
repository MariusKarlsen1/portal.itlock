    private async Task AutoLagreDebounced()
    {
        _autoLagreCts?.Cancel();
        _autoLagreCts = new CancellationTokenSource();
        var token = _autoLagreCts.Token;
        try
        {
            await Task.Delay(1500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!token.IsCancellationRequested)
        {
            await Db.SaveChangesAsync();
        }
    }

