@page "/tilbud/{Id:int}"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using System.Text.Json
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject TilbudPdfService TilbudPdfService
@inject LagretPdfService LagretPdfService

<PageTitle>@(_tilbud?.Tittel ?? "Tilbud")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke tilbudet. Det kan være slettet.</p>
}
else if (_tilbud is not null)
{
    <a class="back-link" href="@($"/prosjekter/{_tilbud.ProsjektId}")">← Tilbake til prosjektet</a>
    <h1>@_tilbud.Tittel</h1>

    @if (_tilbud.Type == TilbudType.Endringsmelding)
    {
        <p class="endringsmelding-info">
            <span class="endringsmelding-badge">Endringsmelding/tillegg</span>
            @if (_tilbud.OpprinneligTilbud is not null)
            {
                <span>Tillegg til: @_tilbud.OpprinneligTilbud.Tittel</span>
            }
        </p>
    }

    <section class="tilbud-section">
        <h2>Tilbudsinformasjon</h2>
        <div class="field-grid">
            <label class="span-2">
                Tittel
                <input @bind="_tilbud.Tittel" @bind:event="oninput" />
            </label>
            @if (_tilbud.Type == TilbudType.Endringsmelding)
            {
                <label>
                    Status
                    <select @bind="_tilbud.Status">
                        @foreach (var s in Enum.GetValues<EndringsmeldingStatus>())
                        {
                            <option value="@s">@s.Visningsnavn()</option>
                        }
                    </select>
                </label>
            }
            <label>
                Type
                <select @bind="_tilbud.PrisType" @bind:after="OppdaterPriser">
                    @foreach (var t in Enum.GetValues<TilbudPrisType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Prosentsats
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.Prosentsats" @bind:after="OppdaterPriser" />
                    <span class="input-suffix">%</span>
                </span>
            </label>
            <label>
                Timepris
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.Timepris" @bind:after="OppdaterMontasjekostAutomatisk" />
                    <span class="input-suffix">kr/t</span>
                </span>
            </label>
            <label>
                Estimert monteringstid
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.EstimertTimerOverride" @bind:after="OppdaterMontasjekostAutomatisk" placeholder="@KalkulertArbeidstidTimer.ToString("N2", Kultur)" />
                    <span class="input-suffix">t</span>
                </span>
            </label>
            <label>
                Rigg/drift
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.RiggDriftProsent" @bind:after="OppdaterMontasjekostAutomatisk" placeholder="0" />
                    <span class="input-suffix">%</span>
                </span>
            </label>
            <label>
                Pris på montering
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.Montasjekost" placeholder="@FormatKr(KalkulertMontasjekost)" />
                    <span class="input-suffix">kr</span>
                </span>
            </label>
            <label>
                Montasjekost
                <span class="input-suffix-wrap">
                    <input @bind="_tilbud.MontasjeInnpris" placeholder="0,00" />
                    <span class="input-suffix">kr/t</span>
                </span>
            </label>
        </div>
        <div class="estimat-stat-liste">
            <span>Estimat m/ Rigg og Drift <strong>@FormatTimer(EstimertArbeidstidTimerMedRigg)</strong></span>
        </div>
        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            <button type="button" class="cancel-button" @onclick="@(() => _tilbud.EstimertTimerOverride = null)">Bruk kalkulert monteringstid</button>
            <button type="button" class="cancel-button" @onclick="@(() => _tilbud.Montasjekost = KalkulertMontasjekost)">Bruk kalkulert pris på montering</button>
            @if (_lenketArbeidsordreId.HasValue)
            {
                <a class="add-button" href="@($"/arbeidsordre/{_lenketArbeidsordreId}")">Åpne arbeidsordre</a>
            }
            else
            {
                <button type="button" class="add-button" @onclick="OpprettArbeidsordre">Opprett arbeidsordre</button>
            }
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>
    </section>

    <section class="tilbud-section">
        <h2>Sammendrag</h2>
        <div class="sammendrag-grid">
            <div><Icon Name="box" /><span>Varekost</span><strong>@FormatKr(Varekost)</strong></div>
            <div><Icon Name="tool" /><span>Montasjekost</span><strong>@FormatKr(MontasjeInnpris)</strong></div>
            <div><Icon Name="tag" /><span>Utpris varer</span><strong>@FormatKr(UtprisVarer)</strong></div>
            <div><Icon Name="tool" /><span>Pris på montering</span><strong>@FormatKr(Montasjekost)</strong></div>
            <div><Icon Name="receipt" /><span>Totalt uten mva</span><strong>@FormatKr(TotaltUtenMva)</strong></div>
            <div><Icon Name="trend-up" /><span>Dekningsbidrag varer</span><strong>@FormatKr(DekningsbidragVarer) (@DekningsbidragVarerProsent.ToString("N1", Kultur) %)</strong></div>
            <div><Icon Name="trend-up" /><span>Dekningsbidrag montering</span><strong>@FormatKr(DekningsbidragMontering) (@DekningsbidragMonteringProsent.ToString("N1", Kultur) %)</strong></div>
            <div><Icon Name="trend-up" /><span>Dekningsbidrag totalt</span><strong>@FormatKr(DekningsbidragTotalt) (@DekningsbidragTotaltProsent.ToString("N1", Kultur) %)</strong></div>
        </div>
    </section>

    <section class="tilbud-section">
        <h2>Varer</h2>
        <div class="varer-toolbar">
            <button type="button" class="add-button" @onclick="SynkVarer">Synk varer</button>
            <button type="button" class="add-button" @onclick="OppdaterPriser">Oppdater priser</button>
        </div>
        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <p class="save-success">@_syncMessage</p>
        }

        <div class="component-search">
            <label>
                Legg til vare - søk i komponentregisteret
                <input @bind="_componentSearch" @bind:event="oninput" @bind:after="OnComponentSearchChanged" placeholder="Søk på navn, leverandør eller produktkode" />
            </label>

            @if (_searchResults.Count > 0)
            {
                <ul class="search-results">
                    @foreach (var r in _searchResults)
                    {
                        <li>
                            <button type="button" class="search-result" @onclick="@(() => AddFromSearch(r))">
                                <span class="search-result-name">@r.Navn</span>
                                <span class="search-result-meta">@r.Leverandor</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (_componentSearch.Trim().Length >= 2)
            {
                <p class="search-empty">Ingen treff.</p>
            }
        </div>

        <div class="linje-legg-til">
            <input @bind="_nyLinjeNavn" @bind:event="oninput" placeholder="Fritekstlinje, f.eks. Rigg/drift" />
            <button type="button" class="add-button" @onclick="LeggTilLinje" disabled="@string.IsNullOrWhiteSpace(_nyLinjeNavn)">Legg til linje</button>
        </div>

        @if (_tilbud.Linjer.Count > 0)
        {
            <table class="varer-table">
                <thead>
                    <tr>
                        <th>Varenavn</th>
                        <th>Innpris</th>
                        <th>Ekstra rabatt inn</th>
                        <th>Antall</th>
                        <th>DG/Påslag</th>
                        <th>%</th>
                        <th>Rabatt</th>
                        <th>Utpris</th>
                        <th>Levert</th>
                        <th>Totalt</th>
                        <th>Låsplan</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _tilbud.Linjer.OrderBy(l => l.Rekkefolge))
                    {
                        <tr @key="l.Id">
                            <td>@l.Navn</td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="pris-input" @bind="l.Innpris" />
                                    <span class="input-suffix">kr</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.EkstraRabattInnProsent" title="Reduserer varekosten (DG-grunnlaget) uten å påvirke utpris, f.eks. ved ekstra rabatt fra leverandør." />
                                    <span class="input-suffix">%</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.Antall" @bind:after="OppdaterMontasjekostAutomatisk" />
                                    <span class="input-suffix">@(string.IsNullOrWhiteSpace(l.Enhet) ? "stk" : l.Enhet)</span>
                                </span>
                            </td>
                            <td>
                                <select class="pris-input" @bind="l.PrisType" @bind:after="@(() => OppdaterLinjePris(l))">
                                    <option value="">@(_tilbud!.PrisType.Visningsnavn()) (standard)</option>
                                    <option value="@TilbudPrisType.Dekningsgrad">DG</option>
                                    <option value="@TilbudPrisType.Paslag">Påslag</option>
                                </select>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.Prosentsats" @bind:after="@(() => OppdaterLinjePris(l))" placeholder="@_tilbud.Prosentsats.ToString("N0", Kultur)" />
                                    <span class="input-suffix">%</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.RabattProsent" @bind:after="@(() => OppdaterLinjePris(l))" />
                                    <span class="input-suffix">%</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="pris-input" @bind="l.Utpris" />
                                    <span class="input-suffix">kr</span>
                                </span>
                            </td>
                            <td>
                                <select class="pris-input" @bind="l.LevertAv" title="F = itlock leverer og priser. Ld = leveres komplett av dørprodusent. Le = leveres komplett av elektro.">
                                    <option value="@LevertAv.F">F</option>
                                    <option value="@LevertAv.Ld">Ld</option>
                                    <option value="@LevertAv.Le">Le</option>
                                </select>
                            </td>
                            <td class="totalt-cell">@(l.LevertAv == LevertAv.F ? FormatKr(l.Utpris * l.Antall) : "–")</td>
                            <td>
                                @if (l.Component is not null)
                                {
                                    <input type="checkbox" title="Sylinder - tas med i låsplanen" @bind="l.Component.ErSylinder" @bind:after="@(() => LagreLasplanFlagg(l))" />
                                }
                            </td>
                            <td><button type="button" class="remove-button" @onclick="@(() => FjernLinje(l))">Fjern</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="list-empty">Ingen varer lagt til ennå. Trykk "Synk varer" for å hente inn alt som er registrert på dørene i prosjektet.</p>
        }
    </section>

    <section class="tilbud-section">
        <button type="button" class="save-button" @onclick="@(() => _visGenerer = !_visGenerer)">Generer tilbud</button>
        <a class="cancel-button" href="@($"/tilbud/{Id}/tripletex-csv")" target="_blank">Eksporter til Tripletex (CSV)</a>

        @if (_visGenerer)
        {
            <div class="generer-panel">
                <h3>Innhold i PDF</h3>
                <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisEnhetspris" /> Vis enhetspris</label>
                <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SummerAlleBeslag" /> Summer alle beslag (sammendrag)</label>
                <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SkjulVarenummerISammendrag" /> Skjul varenummer i sammendrag</label>
                <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisAlleDorerFraBeslagsliste" /> Vis alle dører fra beslagsliste</label>
                @if (_tilbud.VisAlleDorerFraBeslagsliste)
                {
                    <label class="checkbox-row checkbox-row-indent"><input type="checkbox" @bind="_tilbud.VisPrisPerDor" /> Vis pris per dør</label>
                }

                @if (_byggetrinnListe.Count > 1)
                {
                    <div class="byggetrinn-velger">
                        <span>Byggetrinn dette tilbudet gjelder for (styrer både sammendraget/summen og evt. dørliste over)</span>
                        <label class="checkbox-row">
                            <input type="checkbox" checked="@string.IsNullOrEmpty(_tilbud.ByggetrinnFilter)" @onchange="@(e => VelgAlleByggetrinn((bool)e.Value!))" /> Alle
                        </label>
                        @foreach (var b in _byggetrinnListe)
                        {
                            <label class="checkbox-row">
                                <input type="checkbox" checked="@ErByggetrinnValgt(b)" @onchange="@(e => ToggleByggetrinn(b, (bool)e.Value!))" /> @b
                            </label>
                        }
                    </div>
                }

                <label class="span-2">
                    Forside-mal
                    <div class="forside-mal-rad">
                        <select @bind="_valgtForsideMalId">
                            <option value="">Velg forside...</option>
                            @foreach (var f in _forsideMaler)
                            {
                                <option value="@f.Id">@f.Navn</option>
                            }
                        </select>
                        <button type="button" class="cancel-button" @onclick="BrukForsideMal" disabled="@(_valgtForsideMalId is null)">Bruk</button>
                    </div>
                </label>

                <label class="span-2">
                    Forside / forbehold
                    <ForsideTekstRedigering @bind-Value="_tilbud.Forside" Rows="8" Placeholder="Tekst til forsiden av tilbudet, f.eks. forbehold og betingelser." />
                </label>

                <div class="form-actions">
                    <button type="button" class="save-button" @onclick="GenererPdf">Generer PDF</button>
                    <button type="button" class="cancel-button" @onclick="@(() => _visGenerer = false)">Avbryt</button>
                </div>
            </div>
        }
    </section>

    <section class="tilbud-section">
        <h2>Lagrede PDF-er</h2>
        <LagredePdfListe Pdfer="_lagredePdfer" TillatSammenligning="true" />
    </section>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av tilbud" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreTilbudPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class SearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Tilbud? _tilbud;
    private bool _notFound;
    private string? _savedMessage;
    private string? _syncMessage;
    private string _componentSearch = "";
    private List<SearchResult> _searchResults = [];
    private string _nyLinjeNavn = "";
    private bool _visGenerer;
    private string? _pdfPreviewUrl;
    private int? _loadedId;
    private int? _lenketArbeidsordreId;
    private List<TilbudForside> _forsideMaler = [];
    private List<MonteringLinje> _monteringLinjer = [];
    private List<string> _byggetrinnListe = [];
    private int? _valgtForsideMalId;
    private List<LagretPdf> _lagredePdfer = [];
    private string? _pdfSavedMessage;

    private decimal Varekost => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F).Sum(l => l.Innpris * (1 - l.EkstraRabattInnProsent / 100m) * l.Antall) ?? 0;
    private decimal UtprisVarer => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F).Sum(l => l.Utpris * l.Antall) ?? 0;
    private int EstimertMinutter => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F)
        .Sum(l => (FinnMonteringMinutter(l.ComponentId) ?? l.MontasjeMinutter ?? 0) * l.Antall) ?? 0;

    private int? FinnMonteringMinutter(int? componentId) =>
        componentId.HasValue ? _monteringLinjer.FirstOrDefault(m => m.ComponentId == componentId)?.Minutter : null;
    private decimal KalkulertArbeidstidTimer => EstimertMinutter / 60m;
    private decimal EstimertArbeidstidTimer => _tilbud?.EstimertTimerOverride ?? KalkulertArbeidstidTimer;
    private decimal EstimertArbeidstidTimerMedRigg => EstimertArbeidstidTimer * (1 + (_tilbud?.RiggDriftProsent ?? 0) / 100m);
    private decimal KalkulertMontasjekost => Math.Round((_tilbud?.Timepris ?? 0) * EstimertArbeidstidTimerMedRigg, 2);
    private decimal Montasjekost => _tilbud?.Montasjekost ?? KalkulertMontasjekost;
    private decimal TotaltUtenMva => UtprisVarer + Montasjekost;
    private decimal DekningsbidragVarer => UtprisVarer - Varekost;
    private decimal DekningsbidragVarerProsent => UtprisVarer == 0 ? 0 : DekningsbidragVarer / UtprisVarer * 100;
    private decimal MontasjeInnpris => (_tilbud?.MontasjeInnpris ?? 0) * EstimertArbeidstidTimerMedRigg;
    private decimal DekningsbidragMontering => Montasjekost - MontasjeInnpris;
    private decimal DekningsbidragMonteringProsent => Montasjekost == 0 ? 0 : DekningsbidragMontering / Montasjekost * 100;
    private decimal DekningsbidragTotalt => DekningsbidragVarer + DekningsbidragMontering;
    private decimal DekningsbidragTotaltProsent => TotaltUtenMva == 0 ? 0 : DekningsbidragTotalt / TotaltUtenMva * 100;

    private static string FormatKr(decimal value) => value.ToString("N2", Kultur) + " kr";

    private static string FormatTimer(decimal timer)
    {
        var totalMinutter = (int)Math.Round(timer * 60);
        var t = totalMinutter / 60;
        var m = totalMinutter % 60;
        return t > 0 ? $"{t}t {m}min" : $"{m}min";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _visGenerer = false;
        _pdfPreviewUrl = null;
        _savedMessage = null;
        _syncMessage = null;

        _tilbud = await Db.Tilbud
            .Include(t => t.Linjer).ThenInclude(l => l.Component)
            .Include(t => t.OpprinneligTilbud)
            .FirstOrDefaultAsync(t => t.Id == Id);

        _notFound = _tilbud is null;
        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();

        if (_tilbud is not null)
        {
            _monteringLinjer = await Db.MonteringLinjer
                .Where(m => m.ProsjektId == _tilbud.ProsjektId && m.ComponentId != null)
                .ToListAsync();

            var byggetrinnFraPlantegninger = await Db.Plantegninger
                .Where(p => p.ProsjektId == _tilbud.ProsjektId && p.Byggetrinn != null && p.Byggetrinn != "")
                .Select(p => p.Byggetrinn!)
                .Distinct()
                .ToListAsync();
            _byggetrinnListe = ByggetrinnHelper.Sorter(byggetrinnFraPlantegninger).ToList();

            _tilbud.Montasjekost ??= KalkulertMontasjekost;
        }

        _lenketArbeidsordreId = _tilbud is null
            ? null
            : (await Db.Arbeidsordre.FirstOrDefaultAsync(a => a.TilbudId == _tilbud.Id))?.Id;

        _lagredePdfer = await LagretPdfService.HentAsync("Tilbud", Id);
    }

    private async Task OpprettArbeidsordre()
    {
        var ordre = new Arbeidsordre
        {
            Tittel = _tilbud!.Tittel,
            ProsjektId = _tilbud.ProsjektId,
            TilbudId = _tilbud.Id
        };
        Db.Arbeidsordre.Add(ordre);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/arbeidsordre/{ordre.Id}");
    }

    private decimal BeregnUtpris(decimal innpris) => BeregnUtpris(innpris, _tilbud!.PrisType, _tilbud.Prosentsats);

    private static decimal BeregnUtpris(decimal innpris, TilbudPrisType prisType, decimal prosentsats) => prisType switch
    {
        TilbudPrisType.Paslag => Math.Round(innpris * (1 + prosentsats / 100m), 2),
        _ => prosentsats >= 100 ? innpris : Math.Round(innpris / (1 - prosentsats / 100m), 2)
    };

    private void OppdaterLinjePris(TilbudLinje l)
    {
        var prisType = l.PrisType ?? _tilbud!.PrisType;
        var prosentsats = l.Prosentsats ?? _tilbud!.Prosentsats;
        var beregnet = BeregnUtpris(l.Innpris, prisType, prosentsats);
        l.Utpris = Math.Round(beregnet * (1 - l.RabattProsent / 100m), 2);
    }

    private async Task Lagre()
    {
        _tilbud!.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SynkVarer()
    {
        var brukt = await Db.DorKomponenter
            .Where(dk => dk.Dor!.ProsjektId == _tilbud!.ProsjektId)
            .Include(dk => dk.Component)
            .ToListAsync();

        var gruppert = brukt
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall), LevertAv = g.First().LevertAv })
            .ToList();

        foreach (var g in gruppert)
        {
            var innpris = g.Component.PrisNetto ?? 0;
            var linje = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);

            if (linje is null)
            {
                linje = new TilbudLinje
                {
                    TilbudId = _tilbud.Id,
                    ComponentId = g.ComponentId,
                    Navn = g.Component.Navn,
                    Innpris = innpris,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    MontasjeMinutter = g.Component.MontasjeMinutterProsjekt,
                    Utpris = BeregnUtpris(innpris),
                    LevertAv = g.LevertAv,
                    Rekkefolge = _tilbud.Linjer.Count
                };
                _tilbud.Linjer.Add(linje);
                Db.TilbudLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Innpris = innpris;
                linje.Enhet = g.Component.Enhet;
                linje.MontasjeMinutter = g.Component.MontasjeMinutterProsjekt;
                linje.Utpris = BeregnUtpris(innpris);
                linje.LevertAv = g.LevertAv;
            }
        }

        OppdaterMontasjekostAutomatisk();
        await Db.SaveChangesAsync();
        _syncMessage = $"{gruppert.Count} varetyper synkronisert fra prosjektets dører.";
    }

    private async Task LagreLasplanFlagg(TilbudLinje linje)
    {
        await Db.SaveChangesAsync();
    }

    private void OppdaterPriser()
    {
        foreach (var l in _tilbud!.Linjer.Where(l => l.ComponentId is not null))
        {
            OppdaterLinjePris(l);
        }
    }

    private void OppdaterMontasjekostAutomatisk()
    {
        _tilbud!.Montasjekost = KalkulertMontasjekost;
    }

    private async Task OnComponentSearchChanged()
    {
        var term = _componentSearch.Trim();
        if (term.Length < 2)
        {
            _searchResults = [];
            return;
        }

        _searchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor })
            .ToListAsync();
    }

    private async Task AddFromSearch(SearchResult r)
    {
        var existing = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == r.Id);
        if (existing is not null)
        {
            existing.Antall += 1;
        }
        else
        {
            var component = await Db.Components.FindAsync(r.Id);
            if (component is null)
            {
                return;
            }

            var innpris = component.PrisNetto ?? 0;
            var linje = new TilbudLinje
            {
                TilbudId = _tilbud.Id,
                ComponentId = component.Id,
                Navn = component.Navn,
                Innpris = innpris,
                Utpris = BeregnUtpris(innpris),
                Antall = 1,
                Enhet = component.Enhet,
                MontasjeMinutter = component.MontasjeMinutterProsjekt,
                Rekkefolge = _tilbud.Linjer.Count
            };
            _tilbud.Linjer.Add(linje);
            Db.TilbudLinjer.Add(linje);
        }

        await Db.SaveChangesAsync();
        _componentSearch = "";
        _searchResults = [];
    }

    private async Task LeggTilLinje()
    {
        if (string.IsNullOrWhiteSpace(_nyLinjeNavn))
        {
            return;
        }

        var linje = new TilbudLinje
        {
            TilbudId = _tilbud!.Id,
            Navn = _nyLinjeNavn.Trim(),
            Innpris = 0,
            Utpris = 0,
            Antall = 1,
            Rekkefolge = _tilbud.Linjer.Count
        };
        _tilbud.Linjer.Add(linje);
        Db.TilbudLinjer.Add(linje);
        await Db.SaveChangesAsync();
        _nyLinjeNavn = "";
    }

    private async Task FjernLinje(TilbudLinje l)
    {
        Db.TilbudLinjer.Remove(l);
        await Db.SaveChangesAsync();
        _tilbud!.Linjer.Remove(l);
    }

    private void VelgAlleByggetrinn(bool valgt)
    {
        if (valgt)
        {
            _tilbud!.ByggetrinnFilter = null;
        }
    }

    private bool ErByggetrinnValgt(string byggetrinn)
    {
        var valgte = (_tilbud?.ByggetrinnFilter ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
        return valgte.Contains(byggetrinn);
    }

    private void ToggleByggetrinn(string byggetrinn, bool valgt)
    {
        var valgte = (_tilbud!.ByggetrinnFilter ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (valgt && !valgte.Contains(byggetrinn))
        {
            valgte.Add(byggetrinn);
        }
        else if (!valgt)
        {
            valgte.Remove(byggetrinn);
        }
        _tilbud.ByggetrinnFilter = valgte.Count == 0 ? null : string.Join(",", valgte);
    }

    private void BrukForsideMal()
    {
        if (_valgtForsideMalId is null)
        {
            return;
        }

        var mal = _forsideMaler.FirstOrDefault(f => f.Id == _valgtForsideMalId);
        if (mal is null)
        {
            return;
        }

        _tilbud!.Forside = mal.Innhold;
    }

    private async Task GenererPdf()
    {
        _tilbud!.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/tilbud/{Id}/pdf?v={DateTime.UtcNow.Ticks}";
        _visGenerer = false;
    }

    private async Task LagreTilbudPdf()
    {
        var bytes = await TilbudPdfService.GenerateAsync(Id);
        if (bytes is null || _tilbud is null)
        {
            return;
        }

        var linjer = await TilbudPdfService.GetSnapshotLinjerAsync(Id);
        var nokkeltall = new List<LagretPdfNokkeltall>
        {
            new("Estimert timer", EstimertArbeidstidTimer.ToString("N1", Kultur) + " t", EstimertArbeidstidTimer, "t"),
            new("Montasjekost", FormatKr(Montasjekost), Montasjekost, "kr"),
            new("Totalt uten mva", FormatKr(TotaltUtenMva), TotaltUtenMva, "kr"),
        };

        var forrige = _lagredePdfer.OrderByDescending(p => p.OpprettetDato).FirstOrDefault();

        if (forrige is not null && linjer is not null && ErUendretSidenForrige(forrige, linjer, nokkeltall))
        {
            _pdfSavedMessage = "Ingen endringer siden forrige lagring.";
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Tilbud", Id, $"Tilbud - {_tilbud.Tittel} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes, linjer, nokkeltall);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private static bool ErUendretSidenForrige(LagretPdf forrige, List<LagretPdfLinje> nyLinjer, List<LagretPdfNokkeltall> nyeNokkeltall)
    {
        if (string.IsNullOrEmpty(forrige.DataJson))
        {
            return false;
        }

        var gamleLinjer = JsonSerializer.Deserialize<List<LagretPdfLinje>>(forrige.DataJson) ?? [];
        var linjerLike = gamleLinjer.Count == nyLinjer.Count
            && gamleLinjer.OrderBy(l => l.Navn).SequenceEqual(nyLinjer.OrderBy(l => l.Navn));

        if (!linjerLike)
        {
            return false;
        }

        var gamleNokkeltall = string.IsNullOrEmpty(forrige.NokkeltallJson)
            ? []
            : JsonSerializer.Deserialize<List<LagretPdfNokkeltall>>(forrige.NokkeltallJson) ?? [];

        return gamleNokkeltall.OrderBy(n => n.Navn).SequenceEqual(nyeNokkeltall.OrderBy(n => n.Navn));
    }
}
