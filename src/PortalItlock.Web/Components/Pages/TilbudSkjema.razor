    private async Task OnComponentSearchChanged()
    {
        var term = _componentSearch.Trim();
        if (term.Length < 2)
        {
            _searchResults = [];
            return;
        }

        _searchResults = await MedBildeflagg(await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor, BildeStorrelse = c.BildeStorrelse })
            .ToListAsync());
    }

    // Bildeflagget hentes for seg - c.Filer.BildeData i selve søket gir en join
    // som leser alle filene i databasen (se KomponentFilerExtensions).
    private async Task<List<SearchResult>> MedBildeflagg(List<SearchResult> treff)
    {
        var medBilde = await Db.KomponenterMedFilAsync("BildeData", treff.Select(t => t.Id).ToList());
        foreach (var t in treff)
        {
            t.HarBilde = medBilde.Contains(t.Id);
        }

        return treff;
    }

    private async Task AddFromSearch(SearchResult r)
    {
        var existing = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == r.Id);
        if (existing is not null)
        {
            var fra = existing.Antall;
            existing.Antall += 1;
            Db.TilbudHendelser.Add(NyHendelse($"Endret antall fra {FormatAntall(fra)} til {FormatAntall(existing.Antall)} på {existing.Navn}"));
        }
        else
        {
            var component = await Db.Components.Include(c => c.Produktgrupper).FirstOrDefaultAsync(c => c.Id == r.Id);
            if (component is null)
            {
                return;
            }

            var innpris = component.PrisNetto ?? 0;
            var linje = new TilbudLinje
            {
                TilbudId = _tilbud.Id,
                ComponentId = component.Id,
                Navn = component.Navn,
                Innpris = innpris,
                PrisVeiledende = component.PrisVeiledende,
                Antall = 1,
                Enhet = component.Enhet,
                MontasjeMinutter = EffektivMontasjeMinutter(component),
                RabattProsent = await HentKundeRabattProsent(component),
                Rekkefolge = _tilbud.Linjer.Count
            };
            OppdaterLinjePris(linje);
            _tilbud.Linjer.Add(linje);
            Db.TilbudLinjer.Add(linje);
            Db.TilbudHendelser.Add(NyHendelse($"Vare lagt til: {linje.Navn}"));
        }

        await Db.SaveChangesAsync();
        await OppdaterHendelser();
        _componentSearch = "";
        _searchResults = [];
    }

