    private async Task LeggTilGruppering()
    {
        var linje = new TilbudLinje
        {
            TilbudId = _tilbud!.Id,
            Navn = "",
            ErGruppering = true,
            Innpris = 0,
            Utpris = 0,
            Antall = 1,
            Rekkefolge = _tilbud.Linjer.Count
        };
