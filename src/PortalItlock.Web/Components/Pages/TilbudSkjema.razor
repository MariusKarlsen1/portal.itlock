    private async Task<decimal> HentKundeRabattProsent(Component component)
    {
        // Varer merket "ingen rabatt tilgjengelig" skal aldri få rabatt i
        // tilbud, verken auto-utfylt fra kunderabatt eller (se OppdaterLinjePris/
        // input-feltet i markup) skrevet inn manuelt.
        if (component.IngenRabattTilgjengelig)
        {
            return 0;
        }

        var idListe = component.Produktgrupper.Select(p => p.Id).ToList();
        if (idListe.Count == 0 || _tilbud?.Prosjekt?.KundeId is null)
        {
            return 0;
        }

        var rabatt = await Db.KundeRabatter.FirstOrDefaultAsync(r =>
            r.KundeId == _tilbud.Prosjekt.KundeId && idListe.Contains(r.ProduktgruppeId));
        return rabatt?.RabattProsent ?? 0;
    }

    private async Task SynkVarer()
    {
        var brukt = await Db.DorKomponenter
            .Where(dk => dk.Dor!.ProsjektId == _tilbud!.ProsjektId)
            .Include(dk => dk.Component).ThenInclude(c => c!.Produktgrupper)
            .ToListAsync();

        var gruppert = brukt
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall), LevertAv = g.First().LevertAv })
            .ToList();

        foreach (var g in gruppert)
        {
            var innpris = g.Component.PrisNetto ?? 0;
            var linje = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);

            if (linje is null)
            {
                linje = new TilbudLinje
                {
                    TilbudId = _tilbud.Id,
                    ComponentId = g.ComponentId,
                    Navn = g.Component.Navn,
                    Innpris = innpris,
                    PrisVeiledende = g.Component.PrisVeiledende,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    MontasjeMinutter = EffektivMontasjeMinutter(g.Component),
                    LevertAv = g.LevertAv,
                    RabattProsent = await HentKundeRabattProsent(g.Component),
                    Rekkefolge = _tilbud.Linjer.Count
                };
                OppdaterLinjePris(linje);
                _tilbud.Linjer.Add(linje);
                Db.TilbudLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Innpris = innpris;
                linje.PrisVeiledende = g.Component.PrisVeiledende;
                linje.Enhet = g.Component.Enhet;
                linje.MontasjeMinutter = EffektivMontasjeMinutter(g.Component);
                linje.Utpris = BeregnUtpris(innpris, g.Component.PrisVeiledende);
                linje.LevertAv = g.LevertAv;
            }
        }

        OppdaterMontasjekostAutomatisk();
        if (gruppert.Count > 0)
        {
            Db.TilbudHendelser.Add(NyHendelse($"{gruppert.Count} varetyper synkronisert fra prosjektets dører"));
        }
        await Db.SaveChangesAsync();
        await OppdaterHendelser();
        _syncMessage = $"{gruppert.Count} varetyper synkronisert fra prosjektets dører.";
    }

