    private string OppfolgingTekst
    {
        get
        {
            if (_tilbud?.OppfolgingDager is not { } dager)
            {
                return "Du får ingen e-post om å følge opp dette tilbudet.";
            }

            var til = _oppfolgingBrukere.FirstOrDefault(b => b.Id == _tilbud.OppfolgingBrukerId)?.Navn ?? "ingen";
            if (_tilbud.OppfolgingSendt)
            {
                return $"Påminnelsen er sendt til {til}.";
