    private static string FormatAntall(decimal verdi) => verdi.ToString("0.##", Kultur);

    // Sjekker om en sporet egenskap faktisk er endret siden sist lagret - brukes
    // til å generere beskrivende historikk-linjer ("Endret antall fra 2 til 3 på
    // X") for felter som er direkte to-veis bundet i skjemaet (@@bind) og derfor
    // ikke har noen egen lagre-knapp/handler, kun den store Lagre-knappen øverst.
    private static bool FeltEndret(EntityEntry entry, string felt, out object? fra, out object? til)
    {
        var prop = entry.Property(felt);
        fra = prop.OriginalValue;
        til = prop.CurrentValue;
        return prop.IsModified && !Equals(fra, til);
    }

    private List<TilbudHendelse> FinnVareOgPrisEndringer()
    {
        var funnet = new List<TilbudHendelse>();

        foreach (var entry in Db.ChangeTracker.Entries<TilbudLinje>())
        {
            if (entry.Entity.ErGruppering || entry.State != EntityState.Modified)
            {
                continue;
            }

            var navn = entry.Entity.Navn;
            if (FeltEndret(entry, nameof(TilbudLinje.Antall), out var antallFra, out var antallTil))
            {
                funnet.Add(NyHendelse($"Endret antall fra {antallFra} til {antallTil} på {navn}"));
            }
            if (FeltEndret(entry, nameof(TilbudLinje.Innpris), out var innFra, out var innTil))
            {
                funnet.Add(NyHendelse($"Endret innpris fra {FormatKr((decimal)innFra!)} til {FormatKr((decimal)innTil!)} på {navn}"));
            }
            if (FeltEndret(entry, nameof(TilbudLinje.Utpris), out var utFra, out var utTil))
            {
                funnet.Add(NyHendelse($"Endret utpris fra {FormatKr((decimal)utFra!)} til {FormatKr((decimal)utTil!)} på {navn}"));
            }
        }

        if (_tilbud is not null)
        {
            var tilbudEntry = Db.Entry(_tilbud);
            if (FeltEndret(tilbudEntry, nameof(Tilbud.Timepris), out var tpFra, out var tpTil))
            {
                funnet.Add(NyHendelse($"Endret timepris fra {FormatKr((decimal)tpFra!)} til {FormatKr((decimal)tpTil!)}"));
            }
            if (FeltEndret(tilbudEntry, nameof(Tilbud.Prosentsats), out var psFra, out var psTil))
            {
                funnet.Add(NyHendelse($"Endret prosentsats fra {((decimal)psFra!).ToString("0.#", Kultur)} % til {((decimal)psTil!).ToString("0.#", Kultur)} %"));
            }
            if (FeltEndret(tilbudEntry, nameof(Tilbud.MontasjeInnpris), out var miFra, out var miTil))
            {
                funnet.Add(NyHendelse($"Endret montasjekost fra {FormatKr((decimal)(miFra ?? 0m))} til {FormatKr((decimal)(miTil ?? 0m))}"));
            }
            if (FeltEndret(tilbudEntry, nameof(Tilbud.EstimertTimerOverride), out var etFra, out var etTil))
            {
                funnet.Add(NyHendelse($"Endret estimert montasjetid fra {FormatTimer((decimal)(etFra ?? 0m))} til {FormatTimer((decimal)(etTil ?? 0m))}"));
            }
            if (FeltEndret(tilbudEntry, nameof(Tilbud.RiggDriftProsent), out var rdFra, out var rdTil))
            {
                funnet.Add(NyHendelse($"Endret rigg/drift fra {((decimal)(rdFra ?? 0m)).ToString("0.#", Kultur)} % til {((decimal)(rdTil ?? 0m)).ToString("0.#", Kultur)} %"));
            }
        }

        return funnet;
    }

