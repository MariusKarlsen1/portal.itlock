@page "/tilbud/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using System.Text.Json
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject TilbudPdfService TilbudPdfService
@inject LagretPdfService LagretPdfService
@inject IJSRuntime JS

<PageTitle>@(_tilbud?.Tittel ?? "Tilbud")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke tilbudet. Det kan være slettet.</p>
}
else if (_tilbud is not null)
{
    @if (ErServiceTilbud)
    {
        <a class="tilbud-tilbake-link" href="/tilbud-service"><Icon Name="arrow-left" />Tilbake til tilbud service</a>
    }
    else
    {
        <a class="tilbud-tilbake-link" href="@($"/prosjekter/{_tilbud.ProsjektId}")"><Icon Name="arrow-left" />Tilbake til prosjektet</a>
    }

    <div class="tilbud-editor-header">
        <div class="tilbud-editor-header-venstre">
            <span class="tilbud-editor-header-ikon"><Icon Name="file-text" /></span>
            <div>
                <h1>@_tilbud.Tittel <span class="status-badge @StatusBadgeKlasse(_tilbud.Status)">@_tilbud.Status.Visningsnavn()</span></h1>
                @if (_tilbud.Type == TilbudType.Endringsmelding)
                {
                    <div class="tilbud-editor-meta">
                        <span class="tillegg-badge">Endringsmelding/tillegg</span>
                        @if (_tilbud.OpprinneligTilbud is not null)
                        {
                            <span>Tillegg til: @_tilbud.OpprinneligTilbud.Tittel</span>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="tilbud-editor-header-actions">
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
            @if (_lenketArbeidsordreId.HasValue)
            {
                <a class="cancel-button" href="@($"/arbeidsordre/{_lenketArbeidsordreId}")"><Icon Name="edit" />Åpne arbeidsordre</a>
            }
            else
            {
                <button type="button" class="cancel-button" @onclick="OpprettArbeidsordre"><Icon Name="edit" />Opprett arbeidsordre</button>
            }
            <button type="button" class="save-button" @onclick="Lagre"><Icon Name="check" />Lagre</button>
        </div>
    </div>

    <div class="tilbud-panel">
        <div class="tilbud-panel-header">
            <span class="tilbud-panel-ikon"><Icon Name="file-text" /></span>
            <h2>Tilbudsinformasjon</h2>
        </div>

        <div class="skjema-seksjon">
            <p class="skjema-seksjon-tittel">Grunnleggende</p>
            <div class="field-grid">
                <label class="span-2">
                    Tittel
                    <input @bind="_tilbud.Tittel" @bind:event="oninput" />
                </label>
                <label class="span-2">
                    Forespørsel/beskrivelse
                    <textarea rows="3" @bind="_tilbud.ForesporselBeskrivelse" @bind:event="oninput" @bind:after="AutoLagreDebounced"></textarea>
                </label>
            </div>
        </div>

        <div class="skjema-seksjon">
            <p class="skjema-seksjon-tittel">Status og prising</p>
            <div class="field-grid">
                <label>
                    Status
                    <select @bind="_tilbud.Status" @bind:after="StatusEndret">
                        @foreach (var s in Enum.GetValues<EndringsmeldingStatus>())
                        {
                            <option value="@s">@s.Visningsnavn()</option>
                        }
                    </select>
                </label>
                @if (_tilbud.SendtDato.HasValue)
                {
                    <label>
                        Sendt dato
                        <input value="@_tilbud.SendtDato.Value.ToString("dd.MM.yyyy")" disabled />
                    </label>
                }
                <label>
                    Type
                    <select @bind="_tilbud.PrisType" @bind:after="OppdaterPriser">
                        @foreach (var t in TilgjengeligePrisTyper)
                        {
                            <option value="@t">@t.Visningsnavn()</option>
                        }
                    </select>
                </label>
                <label>
                    Prosentsats
                    <span class="input-suffix-wrap">
                        <input @bind="_tilbud.Prosentsats" @bind:after="OppdaterPriser" />
                        <span class="input-suffix">%</span>
                    </span>
                </label>
                <label>
                    Timepris
                    <span class="input-suffix-wrap">
                        <input @bind="_tilbud.Timepris" @bind:after="OppdaterMontasjekostAutomatisk" />
                        <span class="input-suffix">kr/t</span>
                    </span>
                </label>
                <label>
                    @(ErServiceTilbud ? "Estimert montasjetid arbeidsordre" : "Estimert Montasjetid prosjekt")
                    <span class="input-suffix-wrap">
                        <input @bind="_tilbud.EstimertTimerOverride" @bind:after="OppdaterMontasjekostAutomatisk" />
                        <span class="input-suffix">t</span>
                    </span>
                </label>
            </div>
        </div>

        <div class="skjema-seksjon">
            <p class="skjema-seksjon-tittel">Rigg og montasje</p>
            <div class="field-grid">
                @if (!ErServiceTilbud)
                {
                    <label>
                        Rigg/drift
                        <span class="input-suffix-wrap">
                            <input @bind="_tilbud.RiggDriftProsent" @bind:after="OppdaterMontasjekostAutomatisk" placeholder="0" />
                            <span class="input-suffix">%</span>
                        </span>
                    </label>
                }
                <label>
                    Montasjekost
                    <span class="input-suffix-wrap">
                        <input @bind="_tilbud.MontasjeInnpris" placeholder="0,00" />
                        <span class="input-suffix">kr/t</span>
                    </span>
                </label>
            </div>
            <div class="indikasjon-rad">
                <span class="indikasjon-lbl">@(ErServiceTilbud ? "Indikasjon fra varer" : "Indikasjon fra varer m/ Rigg og Drift")</span>
                <span class="indikasjon-verdi">@FormatTimer(IndikasjonTimerMedRigg)</span>
            </div>
        </div>
    </div>

    <div class="tilbud-panel">
        <div class="tilbud-panel-header">
            <span class="tilbud-panel-ikon"><Icon Name="trend-up" /></span>
            <h2>Sammendrag</h2>
        </div>
        <div class="sammendrag-grid">
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="box" /></span>
                <span class="nokkel-lbl">Varekost</span>
                <span class="nokkel-verdi">@FormatKr(Varekost)</span>
            </div>
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="tool" /></span>
                <span class="nokkel-lbl">Montasjekost</span>
                <span class="nokkel-verdi">@FormatKr(MontasjeInnpris)</span>
            </div>
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="tag" /></span>
                <span class="nokkel-lbl">Utpris varer</span>
                <span class="nokkel-verdi">@FormatKr(UtprisVarer)</span>
            </div>
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="tool" /></span>
                <span class="nokkel-lbl">Pris på montering</span>
                <span class="nokkel-verdi">@FormatKr(Montasjekost)</span>
            </div>
            <div class="nokkel-kort total">
                <span class="nokkel-ikon"><Icon Name="receipt" /></span>
                <span class="nokkel-lbl">Totalt uten mva</span>
                <span class="nokkel-verdi">@FormatKr(TotaltUtenMva)</span>
            </div>
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="trend-up" /></span>
                <span class="nokkel-lbl">Dekningsbidrag varer</span>
                <span class="nokkel-verdi gronn">@FormatKr(DekningsbidragVarer)</span>
                <span class="nokkel-sub">@DekningsbidragVarerProsent.ToString("N1", Kultur) %</span>
            </div>
            <div class="nokkel-kort">
                <span class="nokkel-ikon"><Icon Name="trend-up" /></span>
                <span class="nokkel-lbl">Dekningsbidrag montering</span>
                <span class="nokkel-verdi">@FormatKr(DekningsbidragMontering)</span>
                <span class="nokkel-sub">@DekningsbidragMonteringProsent.ToString("N1", Kultur) %</span>
            </div>
            <div class="nokkel-kort total">
                <span class="nokkel-ikon"><Icon Name="trend-up" /></span>
                <span class="nokkel-lbl">Dekningsbidrag totalt</span>
                <span class="nokkel-verdi gronn">@FormatKr(DekningsbidragTotalt)</span>
                <span class="nokkel-sub">@DekningsbidragTotaltProsent.ToString("N1", Kultur) %</span>
            </div>
        </div>
    </div>

    @if (_hendelser.Count > 0)
    {
        <div class="tilbud-panel">
            <div class="tilbud-panel-header">
                <span class="tilbud-panel-ikon"><Icon Name="clock" /></span>
                <h2>Historikk</h2>
            </div>
            <ul class="hendelse-liste">
                @foreach (var h in _hendelser)
                {
                    <li @key="h.Id">
                        <span class="hendelse-dato">@h.Tidspunkt.ToString("dd.MM.yyyy HH:mm") @(h.UtfortAvBruker is not null ? $"- {h.UtfortAvBruker.Navn}" : "")</span>
                        <span>@h.Beskrivelse</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="tilbud-panel">
        <div class="tilbud-panel-header">
            <span class="tilbud-panel-ikon"><Icon Name="box" /></span>
            <h2>Varer</h2>
        </div>
        <div class="varer-toolbar">
            @if (ErServiceTilbud)
            {
                <button type="button" class="add-button" @onclick="OppdaterArbeidsordreEstimat"><Icon Name="check" />Oppdater</button>
            }
            else
            {
                <button type="button" class="add-button" @onclick="SynkVarer"><Icon Name="check" />Synk varer</button>
            }
            <button type="button" class="cancel-button" @onclick="OppdaterPriser"><Icon Name="trend-up" />Oppdater priser</button>
        </div>
        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <p class="save-success">@_syncMessage</p>
        }

        <div class="varer-legg-til-rad">
        <div class="component-search">
            <span class="varer-sok-tittel">Legg til vare - søk i komponentregisteret</span>
            <label class="varer-sok-felt">
                <Icon Name="search" />
                <input @bind="_componentSearch" @bind:event="oninput" @bind:after="OnComponentSearchChanged" placeholder="Søk på navn, leverandør eller produktkode" />
            </label>

            @if (_searchResults.Count > 0)
            {
                <ul class="search-results">
                    @foreach (var r in _searchResults)
                    {
                        <li @key="r.Id" class="search-result-item" @onmouseenter="@(() => VisBildeForhandsvisning(r))" @onmouseleave="SkjulBildeForhandsvisning">
                            <button type="button" class="search-result" @onclick="@(() => AddFromSearch(r))">
                                <span class="search-result-name">@r.Navn</span>
                                <span class="search-result-meta">@r.Leverandor</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (_componentSearch.Trim().Length >= 2)
            {
                <p class="search-empty">Ingen treff.</p>
            }

            @if (_hoverBilde is not null)
            {
                var storrelse = _hoverBilde.BildeStorrelse ?? 220;
                <img src="@($"/komponent/{_hoverBilde.Id}/bilde")" alt="" class="search-result-bilde-forhandsvisning"
                     style="width:@(storrelse)px;height:@(storrelse)px;" />
            }
        </div>

        <div class="linje-legg-til">
            <input @bind="_nyLinjeNavn" @bind:event="oninput" placeholder="Fritekstlinje, f.eks. Rigg/drift" />
            <button type="button" class="cancel-button" @onclick="LeggTilLinje" disabled="@string.IsNullOrWhiteSpace(_nyLinjeNavn)"><Icon Name="plus" />Legg til linje</button>
        </div>
        </div>

        @if (_tilbud.Linjer.Count > 0)
        {
            <div class="varer-tabell-kort">
            <div class="varer-tabell-scroll">
            <table class="varer-table" id="tilbud-varer-tabell">
                <thead>
                    <tr>
                        <th></th>
                        <th>Varenavn</th>
                        <th>Innpris</th>
                        <th>Ekstra rabatt inn</th>
                        <th>Antall</th>
                        <th>DG/Påslag</th>
                        <th>%</th>
                        <th>Rabatt</th>
                        <th>Utpris</th>
                        @if (!ErServiceTilbud)
                        {
                            <th>Levert</th>
                        }
                        <th>Totalt</th>
                        @if (!ErServiceTilbud)
                        {
                            <th>Låsplan</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _tilbud.Linjer.OrderBy(l => l.Rekkefolge))
                    {
                        if (l.ErGruppering)
                        {
                            <tr @key="l.Id" class="gruppering-row" data-linje-id="@l.Id">
                                <td class="drag-handle-cell"><Icon Name="grip" /></td>
                                <td colspan="20" class="gruppering-cell">
                                    <div class="gruppering-innhold">
                                        <input class="gruppering-tittel-input" @bind="l.Navn" @bind:event="oninput" @bind:after="@(() => LagreLinje(l))" placeholder="Tittel..." />
                                        <textarea class="gruppering-beskrivelse-input" rows="2" @bind="l.Beskrivelse" @bind:event="oninput" @bind:after="@(() => LagreLinje(l))" placeholder="Beskrivelse (valgfritt)..."></textarea>
                                    </div>
                                    <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => FjernLinje(l))"><Icon Name="x" /></button>
                                </td>
                            </tr>
                            continue;
                        }

                        <tr @key="l.Id" data-linje-id="@l.Id">
                            <td class="drag-handle-cell"><Icon Name="grip" /></td>
                            <td>
                                @if (l.ComponentId is null && string.IsNullOrWhiteSpace(l.Navn))
                                {
                                    <button type="button" class="produkt-velg-button" @onclick="@(() => ApneProduktVelger(l))">+ Produkt</button>
                                }
                                else
                                {
                                    <div class="vare-navn-celle"><span class="vare-ikon"><Icon Name="tool" /></span><span class="vare-navn">@l.Navn</span></div>
                                }
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="pris-input" @bind="l.Innpris" />
                                    <span class="input-suffix">kr</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.EkstraRabattInnProsent" title="Reduserer varekosten (DG-grunnlaget) uten å påvirke utpris, f.eks. ved ekstra rabatt fra leverandør." />
                                    <span class="input-suffix">%</span>
                                </span>
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="antall-input" @bind="l.Antall" @bind:after="OppdaterMontasjekostAutomatisk" />
                                    <span class="input-suffix">@(string.IsNullOrWhiteSpace(l.Enhet) ? "stk" : l.Enhet)</span>
                                </span>
                            </td>
                            <td>
                                <select class="pris-input" @bind="l.PrisType" @bind:after="@(() => OppdaterLinjePris(l))">
                                    <option value="">@(_tilbud!.PrisType.Visningsnavn()) (standard)</option>
                                    <option value="@TilbudPrisType.Dekningsgrad">DG</option>
                                    <option value="@TilbudPrisType.Paslag">Påslag</option>
                                    @if (ErServiceTilbud)
                                    {
                                        <option value="@TilbudPrisType.Veiledende">Veiledende</option>
                                        <option value="@TilbudPrisType.Rabatt">Rabatt</option>
                                    }
                                </select>
                            </td>
                            <td>
                                @if (EffektivPrisType(l) is TilbudPrisType.Dekningsgrad or TilbudPrisType.Paslag)
                                {
                                    <span class="input-suffix-wrap">
                                        <input class="antall-input" @bind="l.Prosentsats" @bind:after="@(() => OppdaterLinjePris(l))" placeholder="@_tilbud.Prosentsats.ToString("N0", Kultur)" />
                                        <span class="input-suffix">%</span>
                                    </span>
                                }
                            </td>
                            <td>
                                @if (EffektivPrisType(l) == TilbudPrisType.Rabatt)
                                {
                                    <span class="input-suffix-wrap" title="@(l.Component?.IngenRabattTilgjengelig == true ? "Denne varen er merket \"ingen rabatt tilgjengelig\"" : null)">
                                        <input class="antall-input" @bind="l.RabattProsent" @bind:after="@(() => OppdaterLinjePris(l))" disabled="@(l.Component?.IngenRabattTilgjengelig == true)" />
                                        <span class="input-suffix">%</span>
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="input-suffix-wrap">
                                    <input class="pris-input" @bind="l.Utpris" />
                                    <span class="input-suffix">kr</span>
                                </span>
                            </td>
                            @if (!ErServiceTilbud)
                            {
                                <td>
                                    <select class="pris-input levert-select @LevertAvKlasse(l.LevertAv)" @bind="l.LevertAv" title="F = itlock leverer og priser. Ld = leveres komplett av dørprodusent. Le = leveres komplett av elektro.">
                                        <option value="@LevertAv.F">F</option>
                                        <option value="@LevertAv.Ld">Ld</option>
                                        <option value="@LevertAv.Le">Le</option>
                                    </select>
                                </td>
                            }
                            <td class="totalt-cell">@(l.LevertAv == LevertAv.F ? FormatKr(l.Utpris * l.Antall) : "–")</td>
                            @if (!ErServiceTilbud)
                            {
                                <td>
                                    @if (l.Component is not null)
                                    {
                                        <input type="checkbox" title="Sylinder - tas med i låsplanen" @bind="l.Component.ErSylinder" @bind:after="@(() => LagreLasplanFlagg(l))" />
                                    }
                                </td>
                            }
                            <td><button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => FjernLinje(l))"><Icon Name="x" /></button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            </div>
        }
        else
        {
            <p class="list-empty">
                @if (ErServiceTilbud)
                {
                    <text>Ingen varer lagt til ennå. Søk opp varer i komponentregisteret over.</text>
                }
                else
                {
                    <text>Ingen varer lagt til ennå. Trykk "Synk varer" for å hente inn alt som er registrert på dørene i prosjektet.</text>
                }
            </p>
        }

        <div class="ny-rad-rad">
            <button type="button" class="cancel-button" @onclick="LeggTilTomRad"><Icon Name="plus" />Ny rad</button>
            <button type="button" class="cancel-button" @onclick="LeggTilGruppering"><Icon Name="plus" />Ny gruppering</button>
        </div>
    </div>

    @if (_produktVelgerLinje is not null)
    {
        <div class="produkt-modal-overlay" @onclick="LukkProduktVelger">
            <div class="produkt-modal" @onclick:stopPropagation="true">
                <div class="produkt-modal-header">
                    <span>Velg produkt</span>
                    <button type="button" class="produkt-modal-close" @onclick="LukkProduktVelger">✕</button>
                </div>
                <input class="produkt-modal-sok" @bind="_produktVelgerSok" @bind:event="oninput" @bind:after="SokProduktVelger"
                       placeholder="Søk på navn, leverandør eller produktkode" autofocus />
                @if (_produktVelgerResultater.Count > 0)
                {
                    <ul class="produkt-modal-resultater">
                        @foreach (var r in _produktVelgerResultater)
                        {
                            <li @key="r.Id" class="search-result-item" @onmouseenter="@(() => VisProduktVelgerBilde(r))" @onmouseleave="SkjulBildeForhandsvisning">
                                <button type="button" class="@(r.Id == _produktVelgerValgtId ? "produkt-modal-resultat valgt" : "produkt-modal-resultat")" @onclick="@(() => _produktVelgerValgtId = r.Id)">
                                    <span class="search-result-name">@r.Navn</span>
                                    <span class="search-result-meta">@r.Leverandor</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (_produktVelgerSok.Trim().Length >= 2)
                {
                    <p class="search-empty">Ingen treff.</p>
                }
                @if (_produktVelgerHoverBilde is not null)
                {
                    var storrelse = _produktVelgerHoverBilde.BildeStorrelse ?? 220;
                    <img src="@($"/komponent/{_produktVelgerHoverBilde.Id}/bilde")" alt="" class="search-result-bilde-forhandsvisning"
                         style="width:@(storrelse)px;height:@(storrelse)px;" />
                }
                <div class="produkt-modal-actions">
                    <button type="button" class="save-button" disabled="@(_produktVelgerValgtId is null)" @onclick="BekreftProduktValg">Bekreft</button>
                    <button type="button" class="cancel-button" @onclick="LukkProduktVelger">Avbryt</button>
                </div>
            </div>
        </div>
    }

    <div class="tilbud-handling-rad">
        <button type="button" class="save-button" @onclick="@(() => _visGenerer = !_visGenerer)"><Icon Name="file-text" />Generer tilbud</button>
        <a class="cancel-button" href="@($"/tilbud/{Id}/tripletex-csv")" target="_blank"><Icon Name="box" />Eksporter til Tripletex (CSV)</a>
    </div>

    @if (_visGenerer)
    {
        <div class="tilbud-panel generer-panel">
            <div class="tilbud-panel-header">
                <span class="tilbud-panel-ikon"><Icon Name="file-text" /></span>
                <h2>Innhold i PDF</h2>
            </div>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisEnhetspris" /> Vis enhetspris</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SummerAlleBeslag" /> Summer alle beslag (sammendrag)</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SkjulVarenummerISammendrag" /> Skjul varenummer i sammendrag</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisAlleDorerFraBeslagsliste" /> Vis alle dører fra beslagsliste</label>
            @if (_tilbud.VisAlleDorerFraBeslagsliste)
            {
                <label class="checkbox-row checkbox-row-indent"><input type="checkbox" @bind="_tilbud.VisPrisPerDor" /> Vis pris per dør</label>
            }

            @if (_byggetrinnListe.Count > 1)
            {
                <div class="byggetrinn-chips">
                    <span class="byggetrinn-chips-lbl">Byggetrinn dette tilbudet gjelder for (styrer både sammendraget/summen og evt. dørliste over)</span>
                    <button type="button" class="chip @(string.IsNullOrEmpty(_tilbud.ByggetrinnFilter) ? "aktiv" : "")" @onclick="() => VelgAlleByggetrinn(true)">Alle</button>
                    @foreach (var b in _byggetrinnListe)
                    {
                        <button type="button" class="chip @(ErByggetrinnValgt(b) ? "aktiv" : "")" @onclick="() => ToggleByggetrinn(b, !ErByggetrinnValgt(b))">@b</button>
                    }
                </div>
            }

            <label class="span-2">
                Forside-mal
                <div class="forside-mal-rad">
                    <select @bind="_valgtForsideMalId">
                        <option value="">Velg forside...</option>
                        @foreach (var f in _forsideMaler)
                        {
                            <option value="@f.Id">@f.Navn</option>
                        }
                    </select>
                    <button type="button" class="cancel-button" @onclick="BrukForsideMal" disabled="@(_valgtForsideMalId is null)">Bruk</button>
                </div>
            </label>

            <label class="span-2">
                Forside / forbehold
                <ForsideTekstRedigering @bind-Value="_tilbud.Forside" Rows="8" Placeholder="Tekst til forsiden av tilbudet, f.eks. forbehold og betingelser." />
            </label>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="GenererPdf">Generer PDF</button>
                <button type="button" class="cancel-button" @onclick="@(() => _visGenerer = false)">Avbryt</button>
            </div>
        </div>
    }

    <div class="tilbud-panel">
        <div class="tilbud-panel-header">
            <span class="tilbud-panel-ikon"><Icon Name="file-text" /></span>
            <h2>Lagrede PDF-er</h2>
        </div>
        <LagredePdfListe Pdfer="_lagredePdfer" TillatSammenligning="true" />
    </div>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av tilbud" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreTilbudPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class SearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
        public bool HarBilde { get; set; }
        public int? BildeStorrelse { get; set; }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Tilbud? _tilbud;
    private bool _notFound;
    private string? _savedMessage;
    private string? _syncMessage;
    private string _componentSearch = "";
    private List<SearchResult> _searchResults = [];
    private SearchResult? _hoverBilde;
    private SearchResult? _produktVelgerHoverBilde;
    private string _nyLinjeNavn = "";
    private bool _visGenerer;
    private string? _pdfPreviewUrl;
    private int? _loadedId;
    private int? _lenketArbeidsordreId;
    private List<TilbudForside> _forsideMaler = [];
    private List<MonteringLinje> _monteringLinjer = [];
    private List<string> _byggetrinnListe = [];
    private int? _valgtForsideMalId;
    private List<LagretPdf> _lagredePdfer = [];
    private string? _pdfSavedMessage;
    private bool _dragKoblet;
    private DotNetObjectReference<TilbudSkjema>? _dotNetRef;
    private TilbudLinje? _produktVelgerLinje;
    private string _produktVelgerSok = "";
    private List<SearchResult> _produktVelgerResultater = [];
    private int? _produktVelgerValgtId;

    private List<TilbudHendelse> _hendelser = [];
    private EndringsmeldingStatus? _sisteLoggetStatus;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private decimal Varekost => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F && !l.ErGruppering).Sum(l => l.Innpris * (1 - l.EkstraRabattInnProsent / 100m) * l.Antall) ?? 0;
    private decimal UtprisVarer => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F && !l.ErGruppering).Sum(l => l.Utpris * l.Antall) ?? 0;
    private int EstimertMinutter => _tilbud?.Linjer.Where(l => l.LevertAv == LevertAv.F && !l.ErGruppering)
        .Sum(l => (FinnMonteringMinutter(l.ComponentId) ?? l.MontasjeMinutter ?? 0) * l.Antall) ?? 0;

    private int? FinnMonteringMinutter(int? componentId) =>
        componentId.HasValue ? _monteringLinjer.FirstOrDefault(m => m.ComponentId == componentId)?.Minutter : null;
    private decimal KalkulertArbeidstidTimer => EstimertMinutter / 60m;
    private decimal IndikasjonTimerMedRigg => KalkulertArbeidstidTimer * (1 + (_tilbud?.RiggDriftProsent ?? 0) / 100m);
    private decimal EstimertArbeidstidTimer => _tilbud?.EstimertTimerOverride ?? 0;
    private decimal EstimertArbeidstidTimerMedRigg => EstimertArbeidstidTimer * (1 + (_tilbud?.RiggDriftProsent ?? 0) / 100m);
    private decimal KalkulertMontasjekost => Math.Round((_tilbud?.Timepris ?? 0) * EstimertArbeidstidTimerMedRigg, 2);
    private decimal Montasjekost => _tilbud?.Montasjekost ?? KalkulertMontasjekost;
    private decimal TotaltUtenMva => UtprisVarer + Montasjekost;
    private decimal DekningsbidragVarer => UtprisVarer - Varekost;
    private decimal DekningsbidragVarerProsent => UtprisVarer == 0 ? 0 : DekningsbidragVarer / UtprisVarer * 100;
    private decimal MontasjeInnpris => (_tilbud?.MontasjeInnpris ?? 0) * EstimertArbeidstidTimerMedRigg;
    private decimal DekningsbidragMontering => Montasjekost - MontasjeInnpris;
    private decimal DekningsbidragMonteringProsent => Montasjekost == 0 ? 0 : DekningsbidragMontering / Montasjekost * 100;
    private decimal DekningsbidragTotalt => DekningsbidragVarer + DekningsbidragMontering;
    private decimal DekningsbidragTotaltProsent => TotaltUtenMva == 0 ? 0 : DekningsbidragTotalt / TotaltUtenMva * 100;

    private static string FormatKr(decimal value) => value.ToString("N2", Kultur) + " kr";

    private static string StatusBadgeKlasse(EndringsmeldingStatus status) => status switch
    {
        EndringsmeldingStatus.SendtTilKunde => "status-sendt",
        EndringsmeldingStatus.Godkjent => "status-godkjent",
        EndringsmeldingStatus.Avslatt => "status-avslatt",
        _ => "status-utkast"
    };

    private static string LevertAvKlasse(LevertAv levertAv) => levertAv switch
    {
        LevertAv.F => "levert-f",
        LevertAv.Ld => "levert-ld",
        LevertAv.Le => "levert-le",
        _ => ""
    };

    private static string FormatTimer(decimal timer)
    {
        var totalMinutter = (int)Math.Round(timer * 60);
        var t = totalMinutter / 60;
        var m = totalMinutter % 60;
        return t > 0 ? $"{t}t {m}min" : $"{m}min";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dragKoblet && _tilbud is not null && _tilbud.Linjer.Count > 0)
        {
            _dragKoblet = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tilbudlinjer.kobleManuellDrag", "tilbud-varer-tabell", _dotNetRef);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_naverendeBrukerId is null && AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _visGenerer = false;
        _pdfPreviewUrl = null;
        _savedMessage = null;
        _syncMessage = null;

        _tilbud = await Db.Tilbud
            .Include(t => t.Linjer).ThenInclude(l => l.Component)
            .Include(t => t.OpprinneligTilbud)
            .Include(t => t.Prosjekt)
            .FirstOrDefaultAsync(t => t.Id == Id);

        _notFound = _tilbud is null;
        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();

        if (_tilbud is not null)
        {
            _sisteLoggetStatus = _tilbud.Status;
            _hendelser = await Db.TilbudHendelser
                .Include(h => h.UtfortAvBruker)
                .Where(h => h.TilbudId == _tilbud.Id)
                .OrderByDescending(h => h.Tidspunkt)
                .ToListAsync();

            _monteringLinjer = await Db.MonteringLinjer
                .Where(m => m.ProsjektId == _tilbud.ProsjektId && m.ComponentId != null)
                .ToListAsync();

            var byggetrinnFraPlantegninger = await Db.Plantegninger
                .Where(p => p.ProsjektId == _tilbud.ProsjektId && p.Byggetrinn != null && p.Byggetrinn != "")
                .Select(p => p.Byggetrinn!)
                .Distinct()
                .ToListAsync();
            _byggetrinnListe = ByggetrinnHelper.Sorter(byggetrinnFraPlantegninger).ToList();

            _tilbud.Montasjekost = KalkulertMontasjekost;
        }

        _lenketArbeidsordreId = _tilbud is null
            ? null
            : (await Db.Arbeidsordre.FirstOrDefaultAsync(a => a.TilbudId == _tilbud.Id))?.Id;

        _lagredePdfer = await LagretPdfService.HentAsync("Tilbud", Id);
    }

    private async Task StatusEndret()
    {
        if (_tilbud is null || _sisteLoggetStatus == _tilbud.Status)
        {
            return;
        }

        Db.TilbudHendelser.Add(new TilbudHendelse
        {
            TilbudId = _tilbud.Id,
            Beskrivelse = $"Status endret fra \"{_sisteLoggetStatus?.Visningsnavn()}\" til \"{_tilbud.Status.Visningsnavn()}\".",
            UtfortAvBrukerId = _naverendeBrukerId
        });

        // Fryser dato og sum på sendetidspunktet - Tilbudsreserve-rapporten skal
        // vise hva som faktisk ble sendt til kunden, ikke et tall som endrer seg
        // i etterkant hvis noen redigerer linjene på tilbudet senere.
        if (_tilbud.Status == EndringsmeldingStatus.SendtTilKunde)
        {
            _tilbud.SendtDato = DateTime.Today;
            _tilbud.SendtSum = TotaltUtenMva;
        }

        _sisteLoggetStatus = _tilbud.Status;
        await Db.SaveChangesAsync();

        _hendelser = await Db.TilbudHendelser
            .Include(h => h.UtfortAvBruker)
            .Where(h => h.TilbudId == _tilbud.Id)
            .OrderByDescending(h => h.Tidspunkt)
            .ToListAsync();
    }

    private async Task OpprettArbeidsordre()
    {
        var ordre = new Arbeidsordre
        {
            Tittel = _tilbud!.Tittel,
            ProsjektId = _tilbud.ProsjektId,
            TilbudId = _tilbud.Id
        };
        Db.Arbeidsordre.Add(ordre);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/arbeidsordre/{ordre.Id}");
    }

    private decimal BeregnUtpris(decimal innpris, decimal? veiledende = null) =>
        BeregnUtpris(innpris, veiledende, _tilbud!.PrisType, _tilbud.PrisType == TilbudPrisType.Rabatt ? 0 : _tilbud.Prosentsats);

    private static decimal BeregnUtpris(decimal innpris, decimal? veiledende, TilbudPrisType prisType, decimal prosentsats) => prisType switch
    {
        TilbudPrisType.Paslag => Math.Round(innpris * (1 + prosentsats / 100m), 2),
        TilbudPrisType.Veiledende => veiledende ?? innpris,
        TilbudPrisType.Rabatt => Math.Round((veiledende ?? innpris) * (1 - prosentsats / 100m), 2),
        _ => prosentsats >= 100 ? innpris : Math.Round(innpris / (1 - prosentsats / 100m), 2)
    };

    private void OppdaterLinjePris(TilbudLinje l)
    {
        if (l.Component?.IngenRabattTilgjengelig == true)
        {
            l.RabattProsent = 0;
        }

        var prisType = l.PrisType ?? _tilbud!.PrisType;
        if (prisType == TilbudPrisType.Rabatt)
        {
            l.Utpris = BeregnUtpris(l.Innpris, l.PrisVeiledende, prisType, l.RabattProsent);
            return;
        }

        var prosentsats = l.Prosentsats ?? _tilbud!.Prosentsats;
        var beregnet = BeregnUtpris(l.Innpris, l.PrisVeiledende, prisType, prosentsats);
        l.Utpris = Math.Round(beregnet * (1 - l.RabattProsent / 100m), 2);
    }

    private async Task Lagre()
    {
        _tilbud!.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private CancellationTokenSource? _autoLagreCts;

    private async Task AutoLagreDebounced()
    {
        _autoLagreCts?.Cancel();
        _autoLagreCts = new CancellationTokenSource();
        var token = _autoLagreCts.Token;
        try
        {
            await Task.Delay(1500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!token.IsCancellationRequested)
        {
            await Db.SaveChangesAsync();
        }
    }

    private bool ErServiceTilbud => _tilbud?.Prosjekt?.Status == ProsjektStatus.Serviceavtale;

    private IEnumerable<TilbudPrisType> TilgjengeligePrisTyper => ErServiceTilbud
        ? Enum.GetValues<TilbudPrisType>()
        : [TilbudPrisType.Dekningsgrad, TilbudPrisType.Paslag];

    private TilbudPrisType EffektivPrisType(TilbudLinje l) => l.PrisType ?? _tilbud!.PrisType;

    private int? EffektivMontasjeMinutter(Component c) =>
        _tilbud?.Prosjekt?.Status == ProsjektStatus.Serviceavtale
            ? c.MontasjeMinutterArbeidsordre
            : c.MontasjeMinutterProsjekt;

    private async Task<decimal> HentKundeRabattProsent(Component component)
    {
        // Varer merket "ingen rabatt tilgjengelig" skal aldri få rabatt i
        // tilbud, verken auto-utfylt fra kunderabatt eller (se OppdaterLinjePris/
        // input-feltet i markup) skrevet inn manuelt.
        if (component.IngenRabattTilgjengelig)
        {
            return 0;
        }

        var idListe = component.Produktgrupper.Select(p => p.Id).ToList();
        if (idListe.Count == 0 || _tilbud?.Prosjekt?.KundeId is null)
        {
            return 0;
        }

        var rabatt = await Db.KundeRabatter.FirstOrDefaultAsync(r =>
            r.KundeId == _tilbud.Prosjekt.KundeId && idListe.Contains(r.ProduktgruppeId));
        return rabatt?.RabattProsent ?? 0;
    }

    private async Task SynkVarer()
    {
        var brukt = await Db.DorKomponenter
            .Where(dk => dk.Dor!.ProsjektId == _tilbud!.ProsjektId)
            .Include(dk => dk.Component).ThenInclude(c => c!.Produktgrupper)
            .ToListAsync();

        var gruppert = brukt
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall), LevertAv = g.First().LevertAv })
            .ToList();

        foreach (var g in gruppert)
        {
            var innpris = g.Component.PrisNetto ?? 0;
            var linje = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);

            if (linje is null)
            {
                linje = new TilbudLinje
                {
                    TilbudId = _tilbud.Id,
                    ComponentId = g.ComponentId,
                    Navn = g.Component.Navn,
                    Innpris = innpris,
                    PrisVeiledende = g.Component.PrisVeiledende,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    MontasjeMinutter = EffektivMontasjeMinutter(g.Component),
                    LevertAv = g.LevertAv,
                    RabattProsent = await HentKundeRabattProsent(g.Component),
                    Rekkefolge = _tilbud.Linjer.Count
                };
                OppdaterLinjePris(linje);
                _tilbud.Linjer.Add(linje);
                Db.TilbudLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Innpris = innpris;
                linje.PrisVeiledende = g.Component.PrisVeiledende;
                linje.Enhet = g.Component.Enhet;
                linje.MontasjeMinutter = EffektivMontasjeMinutter(g.Component);
                linje.Utpris = BeregnUtpris(innpris, g.Component.PrisVeiledende);
                linje.LevertAv = g.LevertAv;
            }
        }

        OppdaterMontasjekostAutomatisk();
        await Db.SaveChangesAsync();
        _syncMessage = $"{gruppert.Count} varetyper synkronisert fra prosjektets dører.";
    }

    private async Task LagreLasplanFlagg(TilbudLinje linje)
    {
        await Db.SaveChangesAsync();
    }

    private void OppdaterPriser()
    {
        foreach (var l in _tilbud!.Linjer.Where(l => l.ComponentId is not null))
        {
            OppdaterLinjePris(l);
        }
    }

    private async Task OppdaterArbeidsordreEstimat()
    {
        foreach (var l in _tilbud!.Linjer.Where(l => l.Component is not null))
        {
            l.MontasjeMinutter = EffektivMontasjeMinutter(l.Component!);
        }

        OppdaterMontasjekostAutomatisk();
        await Db.SaveChangesAsync();
        _syncMessage = "Estimert montasjetid arbeidsordre oppdatert fra varene.";
    }

    private void OppdaterMontasjekostAutomatisk()
    {
        _tilbud!.Montasjekost = KalkulertMontasjekost;
    }

    // Drevet av faktiske Blazor-hendelser (ikke ren CSS :hover) - mer
    // pålitelig enn en ren CSS-styrt popup, som viste seg å ikke fungere
    // konsekvent for brukeren. Vises alltid ved siden av selve søkefeltet
    // (posisjonert via CSS relativt til .component-search/.produkt-modal),
    // ikke ved musepekeren - samme sted uansett hvor i listen man holder musen.
    private void VisBildeForhandsvisning(SearchResult r)
    {
        _hoverBilde = r.HarBilde ? r : null;
    }

    private void VisProduktVelgerBilde(SearchResult r)
    {
        _produktVelgerHoverBilde = r.HarBilde ? r : null;
    }

    private void SkjulBildeForhandsvisning()
    {
        _hoverBilde = null;
        _produktVelgerHoverBilde = null;
    }

    private async Task OnComponentSearchChanged()
    {
        var term = _componentSearch.Trim();
        if (term.Length < 2)
        {
            _searchResults = [];
            return;
        }

        _searchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor, HarBilde = c.BildeData != null, BildeStorrelse = c.BildeStorrelse })
            .ToListAsync();
    }

    private async Task AddFromSearch(SearchResult r)
    {
        var existing = _tilbud!.Linjer.FirstOrDefault(l => l.ComponentId == r.Id);
        if (existing is not null)
        {
            existing.Antall += 1;
        }
        else
        {
            var component = await Db.Components.Include(c => c.Produktgrupper).FirstOrDefaultAsync(c => c.Id == r.Id);
            if (component is null)
            {
                return;
            }

            var innpris = component.PrisNetto ?? 0;
            var linje = new TilbudLinje
            {
                TilbudId = _tilbud.Id,
                ComponentId = component.Id,
                Navn = component.Navn,
                Innpris = innpris,
                PrisVeiledende = component.PrisVeiledende,
                Antall = 1,
                Enhet = component.Enhet,
                MontasjeMinutter = EffektivMontasjeMinutter(component),
                RabattProsent = await HentKundeRabattProsent(component),
                Rekkefolge = _tilbud.Linjer.Count
            };
            OppdaterLinjePris(linje);
            _tilbud.Linjer.Add(linje);
            Db.TilbudLinjer.Add(linje);
        }

        await Db.SaveChangesAsync();
        _componentSearch = "";
        _searchResults = [];
    }

    private async Task LeggTilLinje()
    {
        if (string.IsNullOrWhiteSpace(_nyLinjeNavn))
        {
            return;
        }

        var linje = new TilbudLinje
        {
            TilbudId = _tilbud!.Id,
            Navn = _nyLinjeNavn.Trim(),
            Innpris = 0,
            Utpris = 0,
            Antall = 1,
            Rekkefolge = _tilbud.Linjer.Count
        };
        _tilbud.Linjer.Add(linje);
        Db.TilbudLinjer.Add(linje);
        await Db.SaveChangesAsync();
        _nyLinjeNavn = "";
    }

    private async Task FjernLinje(TilbudLinje l)
    {
        Db.TilbudLinjer.Remove(l);
        await Db.SaveChangesAsync();
        _tilbud!.Linjer.Remove(l);
    }

    private async Task LeggTilTomRad()
    {
        var linje = new TilbudLinje
        {
            TilbudId = _tilbud!.Id,
            Navn = "",
            Innpris = 0,
            Utpris = 0,
            Antall = 1,
            Rekkefolge = _tilbud.Linjer.Count
        };
        _tilbud.Linjer.Add(linje);
        Db.TilbudLinjer.Add(linje);
        await Db.SaveChangesAsync();
