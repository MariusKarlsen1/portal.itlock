    // Kategoriserer en hendelse ut fra beskrivelsesteksten (ikon+farge+kort
    // tittel for tidslinjen) - rekkefølgen på sjekkene betyr noe: "pris"-
    // treffet må komme før "antall", siden "Endret antall ... på {varenavn}"
    // aldri skal havne i pris-bøtta selv om varenavnet skulle inneholde "pris".
    private static (string Ikon, string Farge, string Tittel) HendelseVisning(string beskrivelse)
    {
        if (beskrivelse.StartsWith("Tilbudet ble opprettet", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "gronn", "Tilbud opprettet");
        }
        if (beskrivelse.StartsWith("Status endret", StringComparison.OrdinalIgnoreCase))
        {
            return ("clock", "noytral", "Status endret");
        }
        if (beskrivelse.StartsWith("Genererte PDF", StringComparison.OrdinalIgnoreCase))
        {
            return ("file-text", "mork", "PDF generert");
        }
        if (beskrivelse.StartsWith("Endret innpris", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret utpris", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret timepris", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret prosentsats", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret montasjekost", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret estimert montasjetid", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret rigg/drift", StringComparison.OrdinalIgnoreCase))
        {
            return ("trend-up", "teal", "Pris oppdatert");
        }
        if (beskrivelse.StartsWith("Vare lagt til", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Vare fjernet", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.StartsWith("Endret antall", StringComparison.OrdinalIgnoreCase)
            || beskrivelse.Contains("synkronisert", StringComparison.OrdinalIgnoreCase))
        {
            return ("box", "blaa", "Vare oppdatert");
        }

        return ("check", "orange", "Tilbud lagret");
    }

