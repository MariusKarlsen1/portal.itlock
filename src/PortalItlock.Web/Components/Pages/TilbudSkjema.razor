        {
            _produktVelgerResultater = [];
            return;
        }

        _produktVelgerResultater = await MedBildeflagg(await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor, BildeStorrelse = c.BildeStorrelse })
            .ToListAsync());
    }

    private async Task BekreftProduktValg()
    {
        if (_produktVelgerLinje is null || _produktVelgerValgtId is null)
        {
            return;
        }

        var component = await Db.Components.Include(c => c.Produktgrupper).FirstOrDefaultAsync(c => c.Id == _produktVelgerValgtId.Value);
        if (component is null)
        {
            return;
        }

        var linje = _produktVelgerLinje;
        linje.ComponentId = component.Id;
        linje.Component = component;
        linje.Navn = component.Navn;
        linje.Innpris = component.PrisNetto ?? 0;
        linje.PrisVeiledende = component.PrisVeiledende;
        linje.Enhet = component.Enhet;
        linje.MontasjeMinutter = EffektivMontasjeMinutter(component);
        linje.RabattProsent = await HentKundeRabattProsent(component);
        OppdaterLinjePris(linje);

        Db.TilbudHendelser.Add(NyHendelse($"Vare lagt til: {linje.Navn}"));
        await Db.SaveChangesAsync();
        await OppdaterHendelser();
        LukkProduktVelger();
    }

    private void VelgAlleByggetrinn(bool valgt)
    {
        if (valgt)
        {
            _tilbud!.ByggetrinnFilter = null;
        }
    }

    private bool ErByggetrinnValgt(string byggetrinn)
    {
        var valgte = (_tilbud?.ByggetrinnFilter ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
        return valgte.Contains(byggetrinn);
    }

    private void ToggleByggetrinn(string byggetrinn, bool valgt)
    {
        var valgte = (_tilbud!.ByggetrinnFilter ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (valgt && !valgte.Contains(byggetrinn))
        {
            valgte.Add(byggetrinn);
        }
        else if (!valgt)
        {
            valgte.Remove(byggetrinn);
        }
        _tilbud.ByggetrinnFilter = valgte.Count == 0 ? null : string.Join(",", valgte);
    }

    private void BrukForsideMal()
    {
        if (_valgtForsideMalId is null)
        {
            return;
        }

        var mal = _forsideMaler.FirstOrDefault(f => f.Id == _valgtForsideMalId);
        if (mal is null)
        {
            return;
        }

        _tilbud!.Forside = mal.Innhold;
    }

    private async Task GenererPdf()
    {
        _tilbud!.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/tilbud/{Id}/pdf?v={DateTime.UtcNow.Ticks}";
        _visGenerer = false;
    }

    private async Task LagreTilbudPdf()
    {
        var bytes = await TilbudPdfService.GenerateAsync(Id);
        if (bytes is null || _tilbud is null)
        {
            return;
        }

        var linjer = await TilbudPdfService.GetSnapshotLinjerAsync(Id);
        var nokkeltall = new List<LagretPdfNokkeltall>
        {
            new("Estimert timer", EstimertArbeidstidTimer.ToString("N1", Kultur) + " t", EstimertArbeidstidTimer, "t"),
            new("Montasjekost", FormatKr(Montasjekost), Montasjekost, "kr"),
            new("Totalt uten mva", FormatKr(TotaltUtenMva), TotaltUtenMva, "kr"),
        };

        var forrige = _lagredePdfer.OrderByDescending(p => p.OpprettetDato).FirstOrDefault();

        if (forrige is not null && linjer is not null && ErUendretSidenForrige(forrige, linjer, nokkeltall))
        {
            _pdfSavedMessage = "Ingen endringer siden forrige lagring.";
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Tilbud", Id, $"Tilbud - {_tilbud.Tittel} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes, linjer, nokkeltall);

        _lagredePdfer.Add(pdf);

        Db.TilbudHendelser.Add(NyHendelse($"Genererte PDF: {pdf.Navn}"));
        await Db.SaveChangesAsync();
        await OppdaterHendelser();

        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private static bool ErUendretSidenForrige(LagretPdf forrige, List<LagretPdfLinje> nyLinjer, List<LagretPdfNokkeltall> nyeNokkeltall)
    {
        if (string.IsNullOrEmpty(forrige.DataJson))
        {
            return false;
        }

        var gamleLinjer = JsonSerializer.Deserialize<List<LagretPdfLinje>>(forrige.DataJson) ?? [];
        var linjerLike = gamleLinjer.Count == nyLinjer.Count
            && gamleLinjer.OrderBy(l => l.Navn).SequenceEqual(nyLinjer.OrderBy(l => l.Navn));

        if (!linjerLike)
        {
            return false;
        }

        var gamleNokkeltall = string.IsNullOrEmpty(forrige.NokkeltallJson)
            ? []
            : JsonSerializer.Deserialize<List<LagretPdfNokkeltall>>(forrige.NokkeltallJson) ?? [];

        return gamleNokkeltall.OrderBy(n => n.Navn).SequenceEqual(nyeNokkeltall.OrderBy(n => n.Navn));
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
