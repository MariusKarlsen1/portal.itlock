@page "/tilbud/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.ChangeTracking
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using System.Text.Json
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject TilbudPdfService TilbudPdfService
@inject LagretPdfService LagretPdfService
@inject IJSRuntime JS
@inject VisningPreferanseService VisningPref

<PageTitle>@(_tilbud?.Tittel ?? "Tilbud")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke tilbudet. Det kan være slettet.</p>
}
else if (_tilbud is not null)
{
    @* Tilbudskort T12 (tilbudkort-forslag.html): ett kort med topp, infolinje,
       meny til venstre med summen under, og innholdet til høyre. *@
    var varelinjeAntall = _tilbud.Linjer.Count(l => !l.ErGruppering);
    var gyldigDager = _tilbud.GyldigTil.HasValue ? (_tilbud.GyldigTil.Value.Date - DateTime.Today).Days : (int?)null;

    <div class="tk-kort @(_tkFull ? "tk-full" : "")">
        <button type="button" class="tk-utvid" title="@(_tkFull ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslTkFull">
            <Icon Name="@(_tkFull ? "minimize" : "maximize")" />
        </button>
        <div class="tk-topp">
            <span class="tk-ikon"><Icon Name="receipt" /></span>
            <div class="tk-tittel">
                <div class="tk-smul">
                    @if (ErServiceTilbud)
                    {
                        <a href="/tilbud-service">Tilbud service</a>
                    }
                    else
                    {
                        <a href="/prosjekter">Prosjekter</a>
                        <span> / </span>
                        <a href="@($"/prosjekter/{_tilbud.ProsjektId}")">@(_tilbud.Prosjekt?.Navn ?? "Prosjekt")</a>
                    }
                    <span> / Tilbud #@_tilbud.Id</span>
                </div>
                <h1>@_tilbud.Tittel <span class="status-badge @StatusBadgeKlasse(_tilbud.Status)">@_tilbud.Status.Visningsnavn()</span></h1>
                @if (_tilbud.Type == TilbudType.Endringsmelding)
                {
                    <div class="tilbud-editor-meta">
                        <span class="tillegg-badge">Endringsmelding/tillegg</span>
                        @if (_tilbud.OpprinneligTilbud is not null)
                        {
                            <span>Tillegg til: @_tilbud.OpprinneligTilbud.Tittel</span>
                        }
                    </div>
                }
            </div>
            <div class="tk-handl">
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="save-success">@_savedMessage</span>
                }
                @if (_lenketArbeidsordreId.HasValue)
                {
                    <a class="tk-kn" href="@($"/arbeidsordre/{_lenketArbeidsordreId}")"><Icon Name="tool" />Åpne arbeidsordre</a>
                }
                else
                {
                    <button type="button" class="tk-kn" @onclick="OpprettArbeidsordre"><Icon Name="tool" />Opprett arbeidsordre</button>
                }
                <button type="button" class="tk-kn" @onclick="@(() => { _aktivFane = Fane.Pdf; _visGenerer = true; })"><Icon Name="file-text" />Generer PDF</button>
                <button type="button" class="tk-kn tk-kn-p" @onclick="Lagre"><Icon Name="check" />Lagre</button>
            </div>
        </div>

        <div class="tk-info">
            <span><Icon Name="folder" /><b>@(_tilbud.Prosjekt?.Kunde?.Navn ?? _tilbud.Prosjekt?.Navn ?? "-")</b></span>
            <span><Icon Name="users" /><b>@(string.IsNullOrWhiteSpace(_tilbud.KontaktpersonNavn) ? "Ingen kontaktperson" : _tilbud.KontaktpersonNavn)</b>@if (!string.IsNullOrWhiteSpace(_tilbud.KontaktpersonTelefon)) {<span> · @_tilbud.KontaktpersonTelefon</span>}</span>
            <span><Icon Name="calendar" />Tilbudsdato <b>@_tilbud.OpprettetDato.ToString("dd.MM.yyyy")</b></span>
            <span>
                <Icon Name="clock" />Gyldig til <b>@(_tilbud.GyldigTil?.ToString("dd.MM.yyyy") ?? "ikke satt")</b>
                @if (gyldigDager is { } dager)
                {
                    <span class="tk-pill @(dager < 0 ? "tk-rod" : dager <= 30 ? "tk-gul" : "tk-gra")">@(dager < 0 ? $"utløpt for {-dager} dager siden" : dager == 0 ? "i dag" : dager == 1 ? "i morgen" : $"om {dager} dager")</span>
                }
            </span>
            <span><Icon Name="box" />Levering <b>@(string.IsNullOrWhiteSpace(_tilbud.Leveringstid) ? "ikke satt" : _tilbud.Leveringstid)</b></span>
            <span><Icon Name="tag" /><b>@PrisTypeKort(_tilbud.PrisType) @_tilbud.Prosentsats.ToString("0.#", Kultur) %</b><span> · @_tilbud.Timepris.ToString("N0", Kultur) kr/t</span></span>
        </div>

        <div class="tk-grid">
            <div class="tk-meny">
                <nav class="tk-faner">
                    <button type="button" class="@MenyKlasse(Fane.Oversikt)" @onclick="@(() => _aktivFane = Fane.Oversikt)"><Icon Name="grid" />Oversikt</button>
                    <button type="button" class="@MenyKlasse(Fane.Varelinjer)" @onclick="@(() => _aktivFane = Fane.Varelinjer)"><Icon Name="tool" />Varelinjer <em>@varelinjeAntall</em></button>
                    <button type="button" class="@MenyKlasse(Fane.Info)" @onclick="@(() => _aktivFane = Fane.Info)"><Icon Name="file-text" />Info</button>
                    <button type="button" class="@MenyKlasse(Fane.Sammendrag)" @onclick="@(() => _aktivFane = Fane.Sammendrag)"><Icon Name="receipt" />Sammendrag</button>
                    <button type="button" class="@MenyKlasse(Fane.Pdf)" @onclick="@(() => _aktivFane = Fane.Pdf)"><Icon Name="file-text" />PDF og dokumenter <em>@_lagredePdfer.Count</em></button>
                    <button type="button" class="@MenyKlasse(Fane.Historikk)" @onclick="@(() => _aktivFane = Fane.Historikk)"><Icon Name="clock" />Historikk <em>@_hendelser.Count</em></button>
                </nav>
                <div class="tk-menysum">
                    <span class="tk-lbl">Totalt eks. mva</span>
                    <b>@FormatKrHel(TotaltUtenMva)</b>
                    <span class="tk-sm">@FormatKrHel(TotaltUtenMva * 1.25m) inkl. mva</span>
                    <span class="tk-sm tk-gronn">DB @FormatKrHel(DekningsbidragTotalt) · @DekningsbidragTotaltProsent.ToString("N1", Kultur) %</span>
                </div>
            </div>

            <div class="tk-kropp">
                @switch (_aktivFane)
                {
                    case Fane.Oversikt:
                        <div class="tk-tall4">
                            <div><span class="tk-lbl">Totalt eks. mva</span><b>@FormatKrHel(TotaltUtenMva)</b><small>@FormatKrHel(TotaltUtenMva * 1.25m) inkl. mva</small></div>
                            <div><span class="tk-lbl">Dekningsbidrag</span><b class="tk-gronn">@FormatKrHel(DekningsbidragTotalt)</b><small>@DekningsbidragTotaltProsent.ToString("N1", Kultur) % av totalen</small></div>
                            <div><span class="tk-lbl">Montasje</span><b>@FormatTimer(EstimertArbeidstidTimerMedRigg)</b><small>@FormatKrHel(Montasjekost) · @_tilbud.Timepris.ToString("N0", Kultur) kr/t</small></div>
                            <div><span class="tk-lbl">Varelinjer</span><b>@varelinjeAntall</b><small>@_tilbud.Linjer.Count(l => l.ErGruppering) grupper · @_tilbud.Linjer.Count(l => !l.ErGruppering && l.LevertAv != LevertAv.F) levert av andre</small></div>
                        </div>
                        <div class="tk-to">
                            <div class="tk-kol">
                                <div class="tk-seksjon">
                                    <h4>Varelinjer <button type="button" @onclick="@(() => _aktivFane = Fane.Varelinjer)">Alle @varelinjeAntall →</button></h4>
                                    @if (varelinjeAntall == 0)
                                    {
                                        <p class="list-empty">Ingen varer lagt til ennå.</p>
                                    }
                                    else
                                    {
                                        <div class="tk-liste">
                                            @foreach (var l in _tilbud.Linjer.Where(l => !l.ErGruppering).OrderBy(l => l.Rekkefolge).Take(6))
                                            {
                                                <div @key="l.Id" class="tk-lr">
                                                    <span class="tk-ik"><Icon Name="tool" /></span>
                                                    <div><b>@(string.IsNullOrWhiteSpace(l.Navn) ? "Uten navn" : l.Navn)</b><small>@FormatAntall(l.Antall) @(string.IsNullOrWhiteSpace(l.Enhet) ? "stk" : l.Enhet) × @FormatKrHel(l.Utpris)@(l.LevertAv == LevertAv.F ? "" : " · " + l.LevertAv.Forklaring().ToLowerInvariant())</small></div>
                                                    <span class="tk-bel">@(l.LevertAv == LevertAv.F ? FormatKrHel(l.Utpris * l.Antall) : "–")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="tk-seksjon">
                                    <h4>Forespørsel</h4>
                                    <div class="tk-boks tk-tekst">@(string.IsNullOrWhiteSpace(_tilbud.ForesporselBeskrivelse) ? "Ingen beskrivelse lagt inn." : _tilbud.ForesporselBeskrivelse)</div>
                                </div>
                            </div>
                            <div class="tk-kol">
                                <div class="tk-boks">
                                    <h3>Totalsum</h3>
                                    <div class="tk-sumr"><span>Varer</span><b>@FormatKrHel(UtprisVarer)</b></div>
                                    <div class="tk-sumr"><span>Montering (@FormatTimer(EstimertArbeidstidTimerMedRigg))</span><b>@FormatKrHel(Montasjekost)</b></div>
                                    <div class="tk-sumr"><span>Totalt eks. mva</span><b>@FormatKrHel(TotaltUtenMva)</b></div>
                                    <div class="tk-sumr"><span>MVA 25 %</span><b>@FormatKrHel(TotaltUtenMva * 0.25m)</b></div>
                                    <div class="tk-sumt"><span>Totalt inkl. mva</span><span>@FormatKrHel(TotaltUtenMva * 1.25m)</span></div>
                                </div>
                                <div class="tk-boks">
                                    <h3>Dekning <span class="tk-pill tk-ok">@DekningsbidragTotaltProsent.ToString("N1", Kultur) %</span></h3>
                                    <div class="tk-dekn">
                                        <div class="tk-sumr"><span>Dekningsbidrag varer</span><b class="tk-gronn">@FormatKrHel(DekningsbidragVarer) · @DekningsbidragVarerProsent.ToString("N1", Kultur) %</b></div>
                                        <span class="tk-bar"><i style="width:@(Math.Clamp(DekningsbidragVarerProsent, 0, 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></span>
                                    </div>
                                    <div class="tk-dekn">
                                        <div class="tk-sumr"><span>Dekningsbidrag montering</span><b class="tk-gronn">@FormatKrHel(DekningsbidragMontering) · @DekningsbidragMonteringProsent.ToString("N1", Kultur) %</b></div>
                                        <span class="tk-bar"><i style="width:@(Math.Clamp(DekningsbidragMonteringProsent, 0, 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></span>
                                    </div>
                                    <div class="tk-sumr tk-sumr-linje"><span><b>Totalt</b></span><b class="tk-gronn">@FormatKrHel(DekningsbidragTotalt)</b></div>
                                </div>
                            </div>
                        </div>
                        break;

                    case Fane.Info:
                        <div class="tk-boks">
                            <h3>Grunnleggende</h3>
                            <div class="tk-ff">
                                <label class="tk-felt tk-span2">Tittel<input @bind="_tilbud.Tittel" @bind:event="oninput" /></label>
                                <label class="tk-felt">
                                    Status
                                    <select @bind="_tilbud.Status" @bind:after="StatusEndret">
                                        @foreach (var s in Enum.GetValues<EndringsmeldingStatus>())
                                        {
                                            <option value="@s">@s.Visningsnavn()</option>
                                        }
                                    </select>
                                </label>
                                <div class="tk-felt tk-alle tk-oppfolging">
                                    Påminnelse om oppfølging på e-post
                                    <div class="tk-oppfolging-rad">
                                        <select aria-label="Når påminnelsen skal komme" value="@(_tilbud.OppfolgingDager?.ToString() ?? "")" @onchange="SettOppfolgingDager">
                                            <option value="">Ingen påminnelse</option>
                                            @foreach (var d in OppfolgingValg(_tilbud.OppfolgingDager))
                                            {
                                                <option value="@d">@d @(d == 1 ? "dag" : "dager") etter at det er sendt</option>
                                            }
                                        </select>
                                        @if (_tilbud.OppfolgingDager is not null)
                                        {
                                            <input type="number" min="1" max="365" aria-label="Antall dager" value="@_tilbud.OppfolgingDager" @onchange="SettOppfolgingDager" />
                                            <select aria-label="Hvem som får påminnelsen" value="@(_tilbud.OppfolgingBrukerId?.ToString() ?? "")" @onchange="SettOppfolgingBruker">
                                                @foreach (var b in _oppfolgingBrukere)
                                                {
                                                    <option value="@b.Id">Til @b.Navn</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                    <small class="tk-oppfolging-hint">@OppfolgingTekst</small>
                                </div>
                                <label class="tk-felt tk-alle">Forespørsel / beskrivelse<textarea rows="3" @bind="_tilbud.ForesporselBeskrivelse" @bind:event="oninput" @bind:after="AutoLagreDebounced"></textarea></label>
                            </div>
                        </div>
                        <div class="tk-to tk-to-like">
                            <div class="tk-boks">
                                <h3>Kontaktperson</h3>
                                <div class="tk-ff tk-ff2">
                                    <label class="tk-felt tk-span2">Navn<input @bind="_tilbud.KontaktpersonNavn" @bind:event="oninput" @bind:after="AutoLagreDebounced" /></label>
                                    <label class="tk-felt">Telefon<input @bind="_tilbud.KontaktpersonTelefon" @bind:event="oninput" @bind:after="AutoLagreDebounced" /></label>
                                    <label class="tk-felt">E-post<input @bind="_tilbud.KontaktpersonEpost" @bind:event="oninput" @bind:after="AutoLagreDebounced" /></label>
                                </div>
                            </div>
                            <div class="tk-boks">
                                <h3>Gyldighet og levering</h3>
                                <div class="tk-ff tk-ff2">
                                    <label class="tk-felt">Gyldig til<input type="date" value="@(_tilbud.GyldigTil?.ToString("yyyy-MM-dd"))" @onchange="@((ChangeEventArgs e) => { _tilbud.GyldigTil = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null; })" @onchange:after="AutoLagreDebounced" /></label>
                                    <label class="tk-felt">Leveringstid<input @bind="_tilbud.Leveringstid" @bind:event="oninput" @bind:after="AutoLagreDebounced" placeholder="f.eks. 4-5 uker" /></label>
                                    @if (_tilbud.SendtDato.HasValue)
                                    {
                                        <label class="tk-felt">Sendt dato<input value="@_tilbud.SendtDato.Value.ToString("dd.MM.yyyy")" disabled /></label>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="tk-boks">
                            <h3>Prising, rigg og montasje</h3>
                            <div class="tk-ff tk-ff4">
                                <label class="tk-felt">
                                    Type
                                    <select @bind="_tilbud.PrisType" @bind:after="OppdaterPriser">
                                        @foreach (var t in TilgjengeligePrisTyper)
                                        {
                                            <option value="@t">@t.Visningsnavn()</option>
                                        }
                                    </select>
                                </label>
                                <label class="tk-felt">Prosentsats<span class="input-suffix-wrap"><input @bind="_tilbud.Prosentsats" @bind:after="OppdaterPriser" /><span class="input-suffix">%</span></span></label>
                                <label class="tk-felt">Timepris<span class="input-suffix-wrap"><input @bind="_tilbud.Timepris" @bind:after="OppdaterMontasjekostAutomatisk" /><span class="input-suffix">kr/t</span></span></label>
                                <label class="tk-felt">@(ErServiceTilbud ? "Estimert montasjetid arbeidsordre" : "Estimert montasjetid prosjekt")<span class="input-suffix-wrap"><input @bind="_tilbud.EstimertTimerOverride" @bind:after="OppdaterMontasjekostAutomatisk" /><span class="input-suffix">t</span></span></label>
                                @if (!ErServiceTilbud)
                                {
                                    <label class="tk-felt">Rigg/drift<span class="input-suffix-wrap"><input @bind="_tilbud.RiggDriftProsent" @bind:after="OppdaterMontasjekostAutomatisk" placeholder="0" /><span class="input-suffix">%</span></span></label>
                                }
                                <label class="tk-felt">Montasjekost<span class="input-suffix-wrap"><input @bind="_tilbud.MontasjeInnpris" placeholder="0,00" /><span class="input-suffix">kr/t</span></span></label>
                            </div>
                            <div class="tk-indikasjon">
                                <span>@(ErServiceTilbud ? "Indikasjon fra varer" : "Indikasjon fra varer m/ rigg og drift")</span>
                                <b>@FormatTimer(IndikasjonTimerMedRigg)</b>
                            </div>
                        </div>
                        break;

                    case Fane.Sammendrag:
                        <div class="tk-tall4">
                            <div><span class="tk-lbl">Varekost</span><b>@FormatKrHel(Varekost)</b></div>
                            <div><span class="tk-lbl">Montasjekost</span><b>@FormatKrHel(MontasjeInnpris)</b></div>
                            <div><span class="tk-lbl">Utpris varer</span><b>@FormatKrHel(UtprisVarer)</b></div>
                            <div><span class="tk-lbl">Pris på montering</span><b>@FormatKrHel(Montasjekost)</b></div>
                        </div>
                        <div class="tk-tall4 tk-tall3">
                            <div><span class="tk-lbl">Dekningsbidrag varer</span><b class="tk-gronn">@FormatKrHel(DekningsbidragVarer)</b><small>@DekningsbidragVarerProsent.ToString("N1", Kultur) %</small></div>
                            <div><span class="tk-lbl">Dekningsbidrag montering</span><b class="tk-gronn">@FormatKrHel(DekningsbidragMontering)</b><small>@DekningsbidragMonteringProsent.ToString("N1", Kultur) %</small></div>
                            <div><span class="tk-lbl">Dekningsbidrag totalt</span><b class="tk-gronn">@FormatKrHel(DekningsbidragTotalt)</b><small>@DekningsbidragTotaltProsent.ToString("N1", Kultur) %</small></div>
                        </div>
                        break;

                    case Fane.Historikk:
                        <div class="tk-historikk">
            @if (_hendelser.Count > 0)
            {
                <div class="tidslinje">
                    @foreach (var h in _hendelser)
                    {
                        var (ikon, farge, tittel) = HendelseVisning(h.Beskrivelse);
                        <div class="hend" @key="h.Id">
                            <div class="hend-linje"></div>
                            <div class="hend-ikon hend-ikon-@farge"><Icon Name="@ikon" /></div>
                            <div class="hend-body">
                                <div>
                                    <div class="hend-tittel">@tittel</div>
                                    <div class="hend-meta">@(h.UtfortAvBruker?.Navn ?? "Ukjent bruker") · @h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="hend-beskrivelse">@h.Beskrivelse</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="list-empty">Ingen hendelser registrert ennå.</p>
            }
                        </div>
                        break;

                    case Fane.Pdf:
                        <div class="tk-pdf">
    <div class="tilbud-handling-rad">
        <button type="button" class="save-button" @onclick="@(() => _visGenerer = !_visGenerer)"><Icon Name="file-text" />Generer tilbud</button>
        <a class="cancel-button" href="@($"/tilbud/{Id}/tripletex-csv")" target="_blank"><Icon Name="box" />Eksporter til Tripletex (CSV)</a>
    </div>

    @if (_visGenerer)
    {
        <div class="tilbud-panel generer-panel">
            <div class="tilbud-panel-header">
                <span class="tilbud-panel-ikon"><Icon Name="file-text" /></span>
                <h2>Innhold i PDF</h2>
            </div>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisEnhetspris" /> Vis enhetspris</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SummerAlleBeslag" /> Summer alle beslag (sammendrag)</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.SkjulVarenummerISammendrag" /> Skjul varenummer i sammendrag</label>
            <label class="checkbox-row"><input type="checkbox" @bind="_tilbud.VisAlleDorerFraBeslagsliste" /> Vis alle dører fra beslagsliste</label>
            @if (_tilbud.VisAlleDorerFraBeslagsliste)
            {
                <label class="checkbox-row checkbox-row-indent"><input type="checkbox" @bind="_tilbud.VisPrisPerDor" /> Vis pris per dør</label>
            }

            @if (_byggetrinnListe.Count > 1)
            {
                <div class="byggetrinn-chips">
                    <span class="byggetrinn-chips-lbl">Byggetrinn dette tilbudet gjelder for (styrer både sammendraget/summen og evt. dørliste over)</span>
                    <button type="button" class="chip @(string.IsNullOrEmpty(_tilbud.ByggetrinnFilter) ? "aktiv" : "")" @onclick="() => VelgAlleByggetrinn(true)">Alle</button>
                    @foreach (var b in _byggetrinnListe)
                    {
                        <button type="button" class="chip @(ErByggetrinnValgt(b) ? "aktiv" : "")" @onclick="() => ToggleByggetrinn(b, !ErByggetrinnValgt(b))">@b</button>
                    }
                </div>
            }

            <label class="span-2">
                Forside-mal
                <div class="forside-mal-rad">
                    <select @bind="_valgtForsideMalId">
                        <option value="">Velg forside...</option>
                        @foreach (var f in _forsideMaler)
                        {
                            <option value="@f.Id">@f.Navn</option>
                        }
                    </select>
                    <button type="button" class="cancel-button" @onclick="BrukForsideMal" disabled="@(_valgtForsideMalId is null)">Bruk</button>
                </div>
            </label>

            <label class="span-2">
                Forside / forbehold
                <ForsideTekstRedigering @bind-Value="_tilbud.Forside" Rows="8" Placeholder="Tekst til forsiden av tilbudet, f.eks. forbehold og betingelser." />
            </label>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="GenererPdf">Generer PDF</button>
                <button type="button" class="cancel-button" @onclick="@(() => _visGenerer = false)">Avbryt</button>
            </div>
        </div>
    }

    <div class="tilbud-panel">
        <div class="tilbud-panel-header">
            <span class="tilbud-panel-ikon"><Icon Name="file-text" /></span>
            <h2>Lagrede PDF-er</h2>
        </div>
        <LagredePdfListe Pdfer="_lagredePdfer" TillatSammenligning="true" />
    </div>
                        </div>
                        break;

                    default:
                        <div class="tk-varer">
        <div class="varer-toolbar">
            @if (ErServiceTilbud)
            {
                <button type="button" class="add-button" @onclick="OppdaterArbeidsordreEstimat"><Icon Name="check" />Oppdater</button>
            }
            else
            {
                <button type="button" class="add-button" @onclick="SynkVarer"><Icon Name="check" />Synk varer</button>
            }
            <button type="button" class="cancel-button" @onclick="OppdaterPriser"><Icon Name="trend-up" />Oppdater priser</button>
        </div>
        @if (!string.IsNullOrEmpty(_syncMessage))
