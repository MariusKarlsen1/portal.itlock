@page "/prisoverslag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Prisoverslag</PageTitle>

<div class="overslag-header">
    <div class="overslag-header-tittel">
        <span class="overslag-header-ikon"><Icon Name="receipt" /></span>
        <h1>Prisoverslag</h1>
    </div>
    <p>Rask kalkulator for et grovt prisoverslag: legg til komponenter, timer og påslag.</p>
</div>

<div class="overslag-toolbar">
    <label class="sok-felt overslag-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på navn eller kunde" />
    </label>
    <a class="new-button" href="prisoverslag/ny"><Icon Name="plus" />Nytt overslag</a>
</div>

@if (_alle.Count > 0)
{
    <div class="overslag-stats">
        <div class="overslag-stat">
            <span class="overslag-stat-tall">@_alle.Count</span>
            <span class="overslag-stat-etikett">Totalt overslag</span>
        </div>
        <div class="overslag-stat">
            <span class="overslag-stat-tall">@_alle.Sum(o => o.Totalsum).ToString("N0", CultureInfo.GetCultureInfo("nb-NO")) kr</span>
            <span class="overslag-stat-etikett">Samlet verdi</span>
        </div>
    </div>
}

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen prisoverslag funnet.</p>
}
else
{
    <div class="overslag-grid">
        @foreach (var o in _filtrert)
        {
            <a class="overslag-kort" href="@($"prisoverslag/{o.Id}")">
                <div class="overslag-kort-topp">
                    <span class="overslag-navn">@o.Navn</span>
                    <span class="overslag-sum-badge">@o.Totalsum.ToString("N0", CultureInfo.GetCultureInfo("nb-NO")) kr</span>
                </div>
                <div class="overslag-kort-linje">
                    <Icon Name="users" />
                    <span>@(string.IsNullOrWhiteSpace(o.Kunde) ? "Ingen kunde satt" : o.Kunde)</span>
                </div>
                <div class="overslag-kort-linje">
                    <Icon Name="calendar" />
                    <span>@o.OpprettetDato.ToString("dd.MM.yyyy")</span>
                </div>
            </a>
        }
    </div>
}

@code {
    private sealed class OverslagRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kunde { get; set; }
        public DateTime OpprettetDato { get; set; }
        public decimal Totalsum { get; set; }
    }

    private List<OverslagRad> _alle = [];
    private string _search = "";

    private List<OverslagRad> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _alle
        : _alle.Where(o =>
                o.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (o.Kunde?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var overslag = await Db.Prisoverslag
            .Include(o => o.Linjer)
            .OrderByDescending(o => o.OpprettetDato)
            .ToListAsync();

        _alle = overslag.Select(o => new OverslagRad
        {
            Id = o.Id,
            Navn = o.Navn,
            Kunde = o.Kunde,
            OpprettetDato = o.OpprettetDato,
            Totalsum = o.Linjer.Sum(l => l.PrisNetto * l.Antall) * (1 + o.PaslagProsent / 100m)
                       + o.AntallTimer * o.Timepris
        }).ToList();
    }
}
