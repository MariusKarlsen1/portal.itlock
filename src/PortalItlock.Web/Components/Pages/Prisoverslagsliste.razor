@page "/prisoverslag"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Prisoverslag</PageTitle>

<h1>Prisoverslag</h1>
<p>Rask kalkulator for et grovt prisoverslag: legg til komponenter, timer og påslag.</p>

<a class="new-button" href="prisoverslag/ny">Nytt overslag</a>

<input class="search-input"
       @bind="_search"
       @bind:event="oninput"
       placeholder="Søk på navn eller kunde" />

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen prisoverslag funnet.</p>
}
else
{
    <ul class="overslag-list">
        @foreach (var o in _filtrert)
        {
            <li>
                <a class="overslag-row" href="@($"prisoverslag/{o.Id}")">
                    <span class="overslag-navn">@o.Navn</span>
                    <span class="overslag-meta">
                        @(string.IsNullOrWhiteSpace(o.Kunde) ? "Ingen kunde satt" : o.Kunde)
                        · @o.OpprettetDato.ToString("dd.MM.yyyy")
                        · @o.Totalsum.ToString("N0", CultureInfo.GetCultureInfo("nb-NO")) kr
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private sealed class OverslagRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kunde { get; set; }
        public DateTime OpprettetDato { get; set; }
        public decimal Totalsum { get; set; }
    }

    private List<OverslagRad> _alle = [];
    private string _search = "";

    private List<OverslagRad> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _alle
        : _alle.Where(o =>
                o.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (o.Kunde?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var overslag = await Db.Prisoverslag
            .Include(o => o.Linjer)
            .OrderByDescending(o => o.OpprettetDato)
            .ToListAsync();

        _alle = overslag.Select(o => new OverslagRad
        {
            Id = o.Id,
            Navn = o.Navn,
            Kunde = o.Kunde,
            OpprettetDato = o.OpprettetDato,
            Totalsum = o.Linjer.Sum(l => l.PrisNetto * l.Antall) * (1 + o.PaslagProsent / 100m)
                       + o.AntallTimer * o.Timepris
        }).ToList();
    }
}
