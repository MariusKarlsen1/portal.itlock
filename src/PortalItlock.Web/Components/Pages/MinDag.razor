@page "/min-dag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject MobilVerktoylinjeService Verktoylinje

<PageTitle>Min dag</PageTitle>

<h1>Min dag</h1>
<p class="section-hint">Dagens jobber samlet - adresse, kontaktperson og varer å pakke, uten å måtte inn på hver arbeidsordre.</p>
<a class="kalender-lenke" href="/kalender">Se full kalender (månedsvisning) &rarr;</a>

<div class="dag-verktoylinje">
    <button type="button" class="cancel-button" @onclick="ForrigeDag">&larr;</button>
    <span class="dag-dato">@Kultur.TextInfo.ToTitleCase(_valgtDato.ToString("dddd dd. MMMM", Kultur))</span>
    <button type="button" class="cancel-button" @onclick="NesteDag">&rarr;</button>
    <button type="button" class="cancel-button" @onclick="GaTilIDag">I dag</button>

    @if (_naverendeRolle != BrukerRolle.Montor)
    {
        <label class="dag-montor-velger">
            Montør
            <select @bind="_valgtMontorId" @bind:after="LastAsync">
                <option value="">Velg montør...</option>
                @foreach (var m in _montorer)
                {
                    <option value="@m.Id">@m.Navn</option>
                }
            </select>
        </label>
    }
</div>

<div class="mobil-ukestripe">
    @foreach (var dag in UkeDager)
    {
        <button type="button" class="mobil-ukedag @(dag == _valgtDato ? "aktiv" : "")" @onclick="@(() => VelgDag(dag))">
            <span class="mobil-ukedag-navn">@Kultur.TextInfo.ToTitleCase(dag.ToString("ddd", Kultur)).TrimEnd('.')</span>
            <span class="mobil-ukedag-tall">@dag.Day.ToString("00")</span>
        </button>
    }
</div>
@if (_laster)
{
    <p class="list-empty">Laster...</p>
}
else if (_valgtMontorId is null)
{
    <p class="list-empty">Velg en montør for å se dagen.</p>
}
else if (_jobber.Count == 0)
{
    <p class="list-empty mobil-tom-tekst-skjul">Ingen jobber planlagt denne dagen.</p>
    @if (ErHelg)
    {
        <div class="mobil-tom-tilstand mobil-tom-helg">
            <svg class="mobil-tom-figur" viewBox="0 0 140 110" width="140" height="110" xmlns="http://www.w3.org/2000/svg">
                <circle cx="108" cy="26" r="16" fill="#f0b429" />
                <g stroke="#f0b429" stroke-width="3" stroke-linecap="round">
                    <line x1="108" y1="2" x2="108" y2="-4" />
                    <line x1="130" y1="10" x2="134" y2="6" />
                    <line x1="138" y1="26" x2="144" y2="26" />
                </g>
                <line x1="14" y1="46" x2="14" y2="80" stroke="#a08a6b" stroke-width="5" stroke-linecap="round" />
                <line x1="122" y1="46" x2="122" y2="80" stroke="#a08a6b" stroke-width="5" stroke-linecap="round" />
                <path d="M14 52 Q68 88 122 52" stroke="#835e41" stroke-width="6" fill="none" stroke-linecap="round" />
                <path d="M34 58 Q68 76 102 58" stroke="#292927" stroke-width="7" fill="none" stroke-linecap="round" opacity="0.12" />
                <circle cx="40" cy="53" r="7" fill="#292927" opacity="0.12" />
            </svg>
            <h2>Dette er en helg!</h2>
            <p>Er du sikker på at du vil jobbe denne dagen?</p>
            <p class="mobil-tom-hint">Tid for å lade opp!</p>
        </div>
    }
    else
    {
        <div class="mobil-tom-tilstand">
            <svg class="mobil-tom-figur" viewBox="0 0 100 120" width="100" height="120" xmlns="http://www.w3.org/2000/svg">
                <rect x="15" y="14" width="70" height="98" rx="8" fill="#ffffff" stroke="#ddd6cb" stroke-width="3" />
                <rect x="35" y="4" width="30" height="16" rx="4" fill="#835e41" />
                <line x1="30" y1="42" x2="70" y2="42" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                <line x1="30" y1="56" x2="70" y2="56" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                <line x1="30" y1="70" x2="55" y2="70" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                <circle cx="68" cy="96" r="17" fill="#f4f0e9" stroke="#2b7a4b" stroke-width="3" />
                <path d="M60 96 l6 6 l12 -13" stroke="#2b7a4b" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h2>Hmmm...</h2>
            <p>Det ser ikke ut som du har arbeidsordre eller prosjekter for denne dagen.</p>
            <p class="mobil-tom-hint">Sjekk med prosjektleder om du er usikker.</p>
        </div>
    }
}
else
{
    <div class="jobb-liste">
        @foreach (var jobb in _jobber)
        {
            <div class="jobb-kort">
                <div class="jobb-header">
                    <span class="jobb-tid">@(jobb.TidTekst ?? "Ikke satt")</span>
                    <span class="status-badge @StatusKlasse(jobb.Status)">@jobb.Status.Visningsnavn()</span>
                </div>
                <h2><a href="@($"/arbeidsordre/{jobb.Id}")">@jobb.Tittel</a></h2>
                @if (jobb.ProsjektNavn is not null)
                {
                    <p class="jobb-prosjekt">@jobb.ProsjektNavn</p>
                }

                <div class="jobb-info-rad">
                    @if (jobb.Adresse is not null)
                    {
                        <a class="jobb-lenke" href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(jobb.Adresse)}")" target="_blank">
                            📍 @jobb.Adresse
                        </a>
                    }
                    @if (jobb.Kontaktperson is not null)
                    {
                        <span class="jobb-kontakt">👤 @jobb.Kontaktperson</span>
                    }
                    @if (jobb.Telefon is not null)
                    {
                        <a class="jobb-lenke" href="@($"tel:{jobb.Telefon}")">📞 @jobb.Telefon</a>
                    }
                </div>

                @if (jobb.Varer.Count > 0)
                {
                    <div class="jobb-varer">
                        <span class="jobb-varer-tittel">Varer å pakke</span>
                        <ul class="varer-liste">
                            @foreach (var v in jobb.Varer)
                            {
                                <li>
                                    <span>@v.Navn</span>
                                    <span class="varer-antall">@v.Antall @v.Enhet</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>
}

@if (_naverendeBrukerId.HasValue)
{
    <div class="mobil-tidsur-wrap">
        @if (_aktivOkt is null)
        {
            <p class="mobil-tidsur-label">Start å registrere arbeidstimene dine:</p>
            <div class="mobil-tidsur-rad">
                <button type="button" class="mobil-tidsur-hovedknapp start" @onclick="StartOkt">
                    Start / 00:00:00
                </button>
            </div>
        }
        else
        {
            <p class="mobil-tidsur-label">Fullfør registreringen av arbeidstimene dine:</p>
            <div class="mobil-tidsur-rad">
                <button type="button" class="mobil-tidsur-hovedknapp ferdig" @onclick="@(() => _visFerdigBekreftelse = true)">
                    FERDIG / @ElapsedTid.ToString(@"hh\:mm\:ss")
                </button>
                <button type="button" class="mobil-tidsur-pauseknapp @(OktPagaendePause ? "aktiv" : "")" @onclick="TogglePause" title="@(OktPagaendePause ? "Fortsett" : "Ta pause")">
                    <Icon Name="@(OktPagaendePause ? "play" : "pause")" />
                </button>
            </div>
        }
    </div>

    @if (_visFerdigBekreftelse)
    {
        <div class="mobil-tidsur-modal-overlay" @onclick="@(() => _visFerdigBekreftelse = false)">
            <div class="mobil-tidsur-modal" @onclick:stopPropagation="true">
                <p class="mobil-tidsur-modal-tittel">Er du sikker på at du vil markere slutten av arbeidsdagen?</p>
                <p class="mobil-tidsur-modal-stats">Arbeidsdagen varte @((int)ElapsedTid.TotalHours)t @(ElapsedTid.Minutes)min.</p>
                <div class="mobil-tidsur-modal-knapper">
                    <button type="button" class="cancel-button" @onclick="@(() => _visFerdigBekreftelse = false)">Tilbake</button>
                    <button type="button" class="save-button" @onclick="BekreftFullfor">Bekreft</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class VareRad
    {
        public required string Navn { get; set; }
        public decimal Antall { get; set; }
        public string Enhet { get; set; } = "stk";
    }

    private sealed class JobbRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? Adresse { get; set; }
        public string? Kontaktperson { get; set; }
        public string? Telefon { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public DateTime? Start { get; set; }
        public DateTime? Slutt { get; set; }
        public List<VareRad> Varer { get; set; } = [];

        public string? TidTekst => Start is null
            ? null
            : Slutt is null
                ? Start.Value.ToString("HH:mm")
                : $"{Start.Value:HH:mm}–{Slutt.Value:HH:mm}";
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private BrukerRolle? _naverendeRolle;
    private int? _naverendeBrukerId;

    private DateOnly _valgtDato = DateOnly.FromDateTime(DateTime.Today);
    private bool ErHelg => _valgtDato.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
    private int? _valgtMontorId;
    private List<MontorOption> _montorer = [];
    private List<JobbRad> _jobber = [];
    private bool _laster = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        _montorer = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Montor && b.Aktiv)
            .OrderBy(m => m.Navn)
            .Select(m => new MontorOption { Id = m.Id, Navn = m.Navn })
            .ToListAsync();

        _valgtMontorId = _naverendeRolle == BrukerRolle.Montor || Verktoylinje.ErMobilvisning
            ? _naverendeBrukerId
            : _montorer.FirstOrDefault()?.Id;

        if (_naverendeBrukerId.HasValue)
        {
            _aktivOkt = await Db.AktiveTimeOkter.FirstOrDefaultAsync(o => o.BrukerId == _naverendeBrukerId.Value);
            OppdaterTikking();
        }

        Verktoylinje.Endret += OnVerktoylinjeEndret;

        await LastAsync();
    }

    // Mobilstatusen avgjøres endelig først etter første render (se
    // MobilFilterKnapp for hvorfor) - dersom den slår om til mobil etter at
    // vi allerede har lastet med montør-listens standardvalg, må vi bytte
    // til den pålogget brukeren sin egen dag i stedet (på mobil skal man
    // aldri kunne velge montør, selv som admin - se ErMobilvisning-sjekken
    // over og at velgeren er fjernet fra markup).
    private void OnVerktoylinjeEndret()
    {
        InvokeAsync(async () =>
        {
            if (Verktoylinje.ErMobilvisning && _naverendeRolle != BrukerRolle.Montor && _valgtMontorId != _naverendeBrukerId)
            {
                _valgtMontorId = _naverendeBrukerId;
                await LastAsync();
            }

            StateHasChanged();
        });
    }

    private List<DateOnly> UkeDager
    {
        get
        {
            var diff = ((int)_valgtDato.DayOfWeek + 6) % 7;
            var mandag = _valgtDato.AddDays(-diff);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

    private void VelgDag(DateOnly dag)
    {
        _valgtDato = dag;
        _ = LastAsync();
    }

    private void ForrigeDag()
    {
        _valgtDato = _valgtDato.AddDays(-1);
        _ = LastAsync();
    }

    private void NesteDag()
    {
        _valgtDato = _valgtDato.AddDays(1);
        _ = LastAsync();
    }

    private void GaTilIDag()
    {
        _valgtDato = DateOnly.FromDateTime(DateTime.Today);
        _ = LastAsync();
    }

    private static string StatusKlasse(ArbeidsordreStatus status) => status switch
    {
        ArbeidsordreStatus.Fakturert => "status-badge-fakturert",
        ArbeidsordreStatus.Ferdig => "status-badge-ferdig",
        ArbeidsordreStatus.Pagaende => "status-badge-pagaende",
        ArbeidsordreStatus.Klar => "status-badge-klar",
        _ => "status-badge-ny"
    };

    private async Task LastAsync()
    {
        _laster = true;

        if (_valgtMontorId is null)
        {
            _jobber = [];
            _laster = false;
            return;
        }

        var dagStart = _valgtDato.ToDateTime(TimeOnly.MinValue);
        var dagSlutt = dagStart.AddDays(1);

        var ordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.Varer)
            .Where(a => a.AnsvarligMontorId == _valgtMontorId
                && a.PlanlagtDato != null && a.PlanlagtDato >= dagStart && a.PlanlagtDato < dagSlutt)
            .OrderBy(a => a.PlanlagtDato)
            .ToListAsync();

        var tilbudIder = ordre.Where(a => a.TilbudId.HasValue).Select(a => a.TilbudId!.Value).Distinct().ToList();
        var tilbudLinjer = tilbudIder.Count == 0
            ? []
            : await Db.TilbudLinjer
                .Where(l => tilbudIder.Contains(l.TilbudId) && !l.ErGruppering && l.LevertAv == LevertAv.F)
                .OrderBy(l => l.Rekkefolge)
                .ToListAsync();

        _jobber = ordre.Select(a =>
        {
            var adresseDeler = new[] { a.Adresse ?? a.Prosjekt?.Adresse, a.Postnr ?? a.Prosjekt?.Postnr, a.Sted ?? a.Prosjekt?.Sted }
                .Where(s => !string.IsNullOrWhiteSpace(s));
            var adresse = string.Join(" ", adresseDeler);

            var varer = a.TilbudId.HasValue
                ? tilbudLinjer.Where(l => l.TilbudId == a.TilbudId.Value)
                    .Select(l => new VareRad { Navn = l.Navn, Antall = l.Antall, Enhet = l.Enhet ?? "stk" })
                    .ToList()
                : a.Varer.Select(v => new VareRad { Navn = v.Navn, Antall = v.Antall, Enhet = "stk" }).ToList();

            return new JobbRad
            {
                Id = a.Id,
                Tittel = a.Tittel,
                ProsjektNavn = a.Prosjekt?.Navn,
                Adresse = string.IsNullOrWhiteSpace(adresse) ? null : adresse,
                Kontaktperson = string.IsNullOrWhiteSpace(a.Prosjekt?.Kontaktperson) ? null : a.Prosjekt!.Kontaktperson,
                Telefon = string.IsNullOrWhiteSpace(a.Prosjekt?.Telefon) ? null : a.Prosjekt!.Telefon,
                Status = a.Status,
                Start = a.PlanlagtDato,
                Slutt = a.PlanlagtSlutt,
                Varer = varer
            };
        }).ToList();

        _laster = false;
    }

    // Tidsur ("Start"-knappen nederst på mobil) - se AktivTimeOkt.cs for
    // hvorfor dette er lagret i databasen og ikke bare et felt her.
    private AktivTimeOkt? _aktivOkt;
    private bool _visFerdigBekreftelse;
    private System.Threading.Timer? _tikkTimer;

    private bool OktPagaendePause => _aktivOkt?.PauseStartTidspunkt is not null;

    private TimeSpan ElapsedTid
    {
        get
        {
            if (_aktivOkt is null)
            {
                return TimeSpan.Zero;
            }

            // Mens økten er på pause skal den viste tiden fryse - bruk
            // pause-tidspunktet som referanse i stedet for "nå" så den ikke
            // fortsetter å tikke.
            var referanse = _aktivOkt.PauseStartTidspunkt ?? DateTime.Now;
            var netto = (referanse - _aktivOkt.StartTidspunkt) - TimeSpan.FromMinutes(_aktivOkt.AkkumulertPauseMinutter);
            return netto > TimeSpan.Zero ? netto : TimeSpan.Zero;
        }
    }

    private async Task StartOkt()
    {
        if (!_naverendeBrukerId.HasValue || _aktivOkt is not null)
        {
            return;
        }

        var okt = new AktivTimeOkt { BrukerId = _naverendeBrukerId.Value, StartTidspunkt = DateTime.Now };
        Db.AktiveTimeOkter.Add(okt);
        await Db.SaveChangesAsync();

        _aktivOkt = okt;
        OppdaterTikking();
    }

    private async Task TogglePause()
    {
        if (_aktivOkt is null)
        {
            return;
        }

        if (OktPagaendePause)
        {
            var pauseVarighet = DateTime.Now - _aktivOkt.PauseStartTidspunkt!.Value;
            _aktivOkt.AkkumulertPauseMinutter += Math.Max(0, (int)Math.Round(pauseVarighet.TotalMinutes));
            _aktivOkt.PauseStartTidspunkt = null;
        }
        else
        {
            _aktivOkt.PauseStartTidspunkt = DateTime.Now;
        }

        await Db.SaveChangesAsync();
        OppdaterTikking();
    }

    private void BekreftFullfor()
    {
        if (_aktivOkt is null)
        {
            return;
        }

        _visFerdigBekreftelse = false;

        var start = _aktivOkt.StartTidspunkt;
        var slutt = DateTime.Now;
        var pauseMinutter = _aktivOkt.AkkumulertPauseMinutter;

        var query = $"?starttid={start:HH:mm}&sluttid={slutt:HH:mm}&pause={pauseMinutter}&oktid={_aktivOkt.Id}";
        Nav.NavigateTo($"/timeregistrering{query}");
    }

    // Kjører et serverside-tikk hvert sekund mens økten går og ikke er på
    // pause, slik at den viste tiden oppdateres uten at brukeren må
    // refreshe. Stoppes/startes på nytt ved hver tilstandsendring for å
    // unngå å tikke i det uendelige når det ikke trengs.
    private void OppdaterTikking()
    {
        _tikkTimer?.Dispose();
        _tikkTimer = null;

        if (_aktivOkt is null || OktPagaendePause)
        {
            return;
        }

        _tikkTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _tikkTimer?.Dispose();
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
