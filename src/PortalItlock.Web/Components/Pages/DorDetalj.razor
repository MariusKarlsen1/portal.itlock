@page "/dor/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AvvikPdfService AvvikPdfService
@inject LagretPdfService LagretPdfService

@if (!IModal)
{
    <PageTitle>Dør @(_dor?.Dornummer)</PageTitle>
}

@if (_notFound)
{
    <p class="form-error">Fant ikke døren. Den kan være slettet.</p>
}
else if (_dor is null)
{
    <p>Laster...</p>
}
else
{
    var montertAntall = _dor.Komponenter.Count(k => k.Montert);
    var beslagAntall = _dor.Komponenter.Count;
    var apneAvvik = _avvik.Count(a => a.Status == AvvikStatus.Apent);
    var garantiLinjer = GarantiBeregning.Linjer(_dor, _dor.Prosjekt?.OverlevertDato);
    var lengstGaranti = garantiLinjer.Where(l => l.UtlopsDato.HasValue).OrderByDescending(l => l.UtlopsDato).FirstOrDefault();
    var historikk = HistorikkRader;

    <div class="ds-kort @(IModal ? "ds-kort-modal" : "")">
        <div class="ds-topp">
            <span class="ds-ikon"><Icon Name="door" /></span>
            <div class="ds-tittel">
                <div class="ds-smul">
                    @if (IModal && OnTilbake.HasDelegate)
                    {
                        <button type="button" class="ds-tilbake" @onclick="@(() => OnTilbake.InvokeAsync())">‹ Tilbake til redigering</button>
                        <span> · </span>
                    }
                    else if (!IModal && !Embed)
                    {
                        <a class="ds-tilbake" href="@($"/prosjekter/{_dor.ProsjektId}")">‹ Tilbake til prosjektet</a>
                        <span> · </span>
                    }
                    <span>@_dor.Prosjekt?.Navn</span>
                </div>
                <h1>
                    <span>Dørside @_dor.Dornummer</span>
                    <StatusPill Tekst="@_dor.Status.Visningsnavn()" Ikon="@_dor.Status.PillIkon()" Farge="@_dor.Status.PillFarge()" />
                </h1>
            </div>
            <div class="ds-handl">
                @if (OnForrige.HasDelegate || OnNeste.HasDelegate)
                {
                    <span class="ds-navpil">
                        <button type="button" disabled="@(!OnForrige.HasDelegate)" @onclick="@(() => OnForrige.InvokeAsync())">‹ @ForrigeNavn</button>
                        <button type="button" disabled="@(!OnNeste.HasDelegate)" @onclick="@(() => OnNeste.InvokeAsync())">@NesteNavn ›</button>
                    </span>
                }
                <button type="button" class="ds-kn" @onclick="@(() => VelgFane("avvik"))"><Icon Name="alert" />Meld avvik</button>
                <button type="button" class="ds-kn" @onclick="@(() => VelgFane("logg"))"><Icon Name="camera" />Bilde</button>
                @if (IModal && OnTilbake.HasDelegate)
                {
                    <button type="button" class="ds-kn ds-kn-p" @onclick="@(() => OnTilbake.InvokeAsync())">Rediger dør</button>
                }
                <button type="button" class="ds-qr-mini" title="QR-kode" @onclick="@(() => VelgFane("qr"))">
                    <img src="@($"/dor/{_dor.Id}/qr.png")" alt="QR-kode for dør @_dor.Dornummer" />
                </button>
                @if (IModal && OnLukk.HasDelegate)
                {
                    <button type="button" class="ds-ikk" title="Lukk" @onclick="@(() => OnLukk.InvokeAsync())"><Icon Name="x" /></button>
                }
            </div>
        </div>

        <div class="ds-info">
            <span><Icon Name="map-pin" />Rom <b>@(_dor.Romnr ?? "-")</b>@if (!string.IsNullOrWhiteSpace(_dor.DorTil)) {<span> · til <b>@_dor.DorTil</b></span>}</span>
            <span><Icon Name="building" /><b>@(_dor.Etasje ?? "-")</b> · sone <b>@(_dor.Sone ?? "-")</b></span>
            <span><Icon Name="door" /><b>@(_dor.Dortype ?? "-")</b>@if (!string.IsNullOrWhiteSpace(_dor.BxH)) {<span> · @_dor.BxH</span>}</span>
            <span><Icon Name="alert-triangle" />Brann <b>@(_dor.Brann ?? "-")</b></span>
            @if (_dor.DorIdMal is not null)
            {
                <span><Icon Name="tag" />Dør-ID <b>@_dor.DorIdMal.Kode</b></span>
            }
            @if (lengstGaranti is not null)
            {
                <span><Icon Name="shield" />Garanti <b>til @lengstGaranti.UtlopsDato!.Value.Year</b></span>
            }
        </div>

        <nav class="ds-faner">
            <button type="button" class="@FaneKlasse("oversikt")" @onclick="@(() => VelgFane("oversikt"))"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="@FaneKlasse("beslag")" @onclick="@(() => VelgFane("beslag"))"><Icon Name="tool" />Beslag <em>@montertAntall/@beslagAntall</em></button>
            <button type="button" class="@FaneKlasse("dok")" @onclick="@(() => VelgFane("dok"))"><Icon Name="file-text" />Dokumentasjon <em>@(_ceGodkjenninger.Count + _sylinderRader.Count + _prinsippskisser.Count)</em></button>
            <button type="button" class="@FaneKlasse("logg")" @onclick="@(() => VelgFane("logg"))"><Icon Name="image" />Bilder og historikk <em>@(_media.Count + historikk.Count)</em></button>
            <button type="button" class="@FaneKlasse("avvik")" @onclick="@(() => VelgFane("avvik"))"><Icon Name="alert" />Avvik og drift <em class="@(apneAvvik > 0 ? "ds-em-rod" : "")">@(apneAvvik > 0 ? apneAvvik : _avvik.Count + _driftsmeldinger.Count)</em></button>
            <button type="button" class="@FaneKlasse("qr")" @onclick="@(() => VelgFane("qr"))"><Icon Name="qr" />QR-kode</button>
            @if (MedRedigering)
            {
                <button type="button" class="@FaneKlasse("detaljer") ds-fane-hoyre" @onclick="@(() => VelgFane("detaljer"))"><Icon Name="edit" />Detaljer</button>
            }
        </nav>

        <div class="ds-kropp">
            @switch (_fane)
            {
                case "detaljer" or "beslag" when MedRedigering:
                    <DorRedigering Dor="_dor"
                                   Seksjon="@_fane"
                                   AlleDorer="AlleDorer"
                                   ProsjektOverlevertDato="_dor.Prosjekt?.OverlevertDato"
                                   OnClose="@(() => OnLukk.InvokeAsync())"
                                   OnDeleted="@(() => OnDeleted.InvokeAsync())"
                                   OnUnplaced="@(() => OnUnplaced.InvokeAsync())"
                                   OnCloned="@((List<Dor> nye) => OnCloned.InvokeAsync(nye))"
                                   OnSaved="@(() => OnSaved.InvokeAsync())" />
                    break;

                case "beslag":
                    <div class="ds-rad">
                        <span class="ds-hint ds-flex">Beslag legges til og endres i dørvinduet. Her ser du hva som er montert, og kan fjerne beslag.</span>
                        @if (IModal && OnTilbake.HasDelegate)
                        {
                            <button type="button" class="ds-kn" @onclick="@(() => OnTilbake.InvokeAsync())"><Icon Name="edit" />Rediger beslag</button>
                        }
                    </div>
                    @if (beslagAntall == 0)
                    {
                        <p class="list-empty">Ingen beslag registrert.</p>
                    }
                    else
                    {
                        <div class="ds-tab-wrap">
                            <table class="ds-tab">
                                <thead>
                                    <tr><th>Vare</th><th class="ds-c">Antall</th><th>Enhet</th><th>Plass.</th><th>Levert av</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var dk in _dor.Komponenter.ToList())
                                    {
                                        <tr @key="dk.ComponentId">
                                            <td><b>@dk.Component?.Navn</b>@if (!string.IsNullOrWhiteSpace(dk.Component?.Produktkode)) {<small>@dk.Component!.Produktkode</small>}</td>
                                            <td class="ds-c">@dk.Antall</td>
                                            <td>@(dk.Enhet ?? "-")</td>
                                            <td>@(dk.Plassering switch { DorKomponentPlassering.Hengselside => "H", DorKomponentPlassering.Karmside => "K", _ => "-" })</td>
                                            <td>@dk.LevertAv</td>
                                            <td>
                                                @if (dk.Montert)
                                                {
                                                    <span class="ds-pill ds-ok">✓ Montert @(dk.MontertDato?.ToString("dd.MM")) @(dk.MontertAvBruker is not null ? $"({dk.MontertAvBruker.Initialer})" : "")</span>
                                                }
                                                else
                                                {
                                                    <span class="ds-pill ds-gra">Ikke montert</span>
                                                }
                                            </td>
                                            <td><button type="button" class="ds-ikk ds-ikk-liten" title="Fjern beslag" @onclick="@(() => FjernBeslag(dk))"><Icon Name="x" /></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <span class="ds-sm">@montertAntall av @beslagAntall montert</span>
                    }
                    break;

                case "dok":
                    <div class="ds-seksjon">
                        <h4>CE-godkjenning</h4>
                        @if (_apenCeId is not null)
                        {
                            <div class="ce-modal-overlay">
                                <div class="ce-modal">
                                    <CeGodkjenningPanel Id="_apenCeId.Value" OnClose="LukkCePanel" StartRedigerbar="_apenCeRedigerbar" />
                                </div>
                            </div>
                        }
                        @if (_ceGodkjenninger.Count > 0)
                        {
                            <div class="ds-tab-wrap">
                                <table class="ds-tab">
                                    <thead>
                                        <tr><th>Nummer</th><th>Status</th><th>Vilkår</th><th>Gyldig til</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ce in _ceGodkjenninger)
                                        {
                                            <tr @key="ce.Id">
                                                <td><b>@ce.Sertifiseringsnummer</b></td>
                                                <td>@ce.Status.Visningsnavn()</td>
                                                <td>
                                                    @if (CeValideringsService.ErGodkjent(ce, _dor.Komponenter))
                                                    {
                                                        <span class="ds-pill ds-ok">Oppfylt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ds-pill ds-gul">Ikke oppfylt</span>
                                                    }
                                                </td>
                                                <td>@ce.GyldigTil.ToString("dd.MM.yyyy")</td>
                                                <td><button type="button" class="ds-kn ds-kn-s" @onclick="@(() => { _apenCeId = ce.Id; _apenCeRedigerbar = false; })">Åpne</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="list-empty">Ingen CE-godkjenning startet på denne døren.</p>
                        }
                        @if (_harAutomatikk)
                        {
                            <div class="ds-rad"><button type="button" class="ds-kn ds-kn-p ds-kn-s" @onclick="StartCeGodkjenning"><Icon Name="plus" />Start CE-godkjenning</button></div>
                        }
                        else
                        {
                            <span class="ds-hint">CE-godkjenning kan startes når døren har dørautomatikk under Beslag.</span>
                        }
                    </div>

                    <div class="ds-seksjon">
                        <h4>Låsplan <a href="@($"/prosjekt/{_dor.ProsjektId}/lasplan")">Åpne full låsplan →</a></h4>
                        @if (_sylinderRader.Count == 0)
                        {
                            <p class="list-empty">Ingen sylindere registrert på denne døren.</p>
                        }
                        else
                        {
                            <div class="ds-liste">
                                @foreach (var rad in _sylinderRader)
                                {
                                    <div @key="rad.ComponentId" class="ds-lr">
                                        <span class="ds-ik"><Icon Name="lock" /></span>
                                        <div><b>Syl.mrk @rad.SylMrk · @rad.Navn</b><small>Nøkler: @(rad.Nokler.Count > 0 ? string.Join(", ", rad.Nokler) : "ingen registrert")</small></div>
                                        <span></span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="ds-seksjon">
                        <h4>Prinsippskisse</h4>
                        @if (_prinsippskisser.Count == 0)
                        {
                            <p class="list-empty">Ingen prinsippskisse laget ennå. Trykk "Ny prinsippskisse" for å generere en basert på beslaget på denne døren.</p>
                        }
                        else
                        {
                            <div class="ds-liste">
                                @foreach (var s in _prinsippskisser)
                                {
                                    <div @key="s.Id" class="ds-lr">
                                        <span class="prinsippskisse-forhandsvisning"><KoblingsSkjemaMiniPreview Symboler="s.Symboler" Streker="s.Streker" /></span>
                                        <div><b>@s.Navn</b><small>@(s.OppdatertDato is null ? $"Opprettet {s.OpprettetDato:dd.MM.yyyy}" : $"Oppdatert {s.OppdatertDato:dd.MM.yyyy}")</small></div>
                                        <a class="ds-kn ds-kn-s" href="@($"/koblingsskjema/{s.Id}")"><Icon Name="maximize" />Åpne</a>
                                    </div>
                                }
                            </div>
                        }
                        <AuthorizeView Roles="Admin,Prosjektleder">
                            <div class="ds-rad">
                                <input class="ds-inp ds-flex" @bind="_nyPrinsippskisseNavn" @bind:event="oninput" placeholder="@($"Prinsippskisse - dør {_dor.Dornummer}")" />
                                <button type="button" class="ds-kn ds-kn-p ds-kn-s" @onclick="OpprettPrinsippskisse"><Icon Name="plus" />Ny prinsippskisse</button>
                            </div>
                        </AuthorizeView>
                    </div>
                    break;

                case "logg":
                    <div class="ds-to">
                        <div class="ds-seksjon">
                            <h4>Historikk</h4>
                            @if (historikk.Count == 0)
                            {
                                <p class="list-empty">Ingen historikk registrert ennå.</p>
                            }
                            else
                            {
                                <div>
                                    @foreach (var h in historikk)
                                    {
                                        @HistorikkLinje(h)
                                    }
                                </div>
                            }
                        </div>
                        <div class="ds-seksjon">
                            <h4>Bilder og video</h4>
                            <label class="dropzone">
                                <span class="dropzone-ikon"><Icon Name="upload" /></span>
                                <span class="dropzone-tekst">
                                    <strong>Last opp bilde eller video</strong>
                                    <span>Velg om det er «Før» eller «Etter»</span>
                                </span>
                                <select @bind="_nyMediaTidspunkt">
                                    <option value="@DorMediaTidspunkt.For">Før</option>
                                    <option value="@DorMediaTidspunkt.Etter">Etter</option>
                                </select>
                                <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
                            </label>
                            @if (!string.IsNullOrEmpty(_mediaFeil))
                            {
                                <p class="form-error">@_mediaFeil</p>
                            }
                            @if (_media.Count == 0)
                            {
                                <p class="list-empty">Ingen filer lagt til.</p>
                            }
                            else
                            {
                                <div class="ds-bilder">
                                    @foreach (var m in _media)
                                    {
                                        @MediaFlis(m)
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case "avvik":
                    <div class="ds-seksjon">
                        <h4>Avvik</h4>
                        <div class="ds-rad">
                            <textarea class="ds-inp ds-flex" @bind="_nyAvvikBeskrivelse" placeholder="Beskriv avviket..."></textarea>
                            <button type="button" class="ds-kn ds-kn-p" @onclick="MeldAvvik"><Icon Name="plus" />Meld avvik</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_avvikFeil))
                        {
                            <p class="form-error">@_avvikFeil</p>
                        }
                        @if (_avvik.Count == 0)
                        {
                            <p class="list-empty">Ingen avvik registrert på denne døren.</p>
                        }
                        @foreach (var a in _avvik)
                        {
                            <div @key="a.Id" class="ds-avv">
                                <div class="ds-rad ds-mellom">
                                    <span class="avvik-status avvik-status-@a.Status">@a.Status.Visningsnavn()</span>
                                    <span class="ds-sm">@a.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(a.OpprettetAvBruker is not null ? $"· {a.OpprettetAvBruker.Navn}" : "")</span>
                                </div>
                                <span>@a.Beskrivelse</span>

                                <AuthorizeView Roles="Admin,Prosjektleder">
                                    <Authorized>
                                        @if (a.Status == AvvikStatus.Apent)
                                        {
                                            <div class="avvik-prisform">
                                                <textarea @bind="a.UtbedringBeskrivelse" placeholder="Foreslått utbedring (valgfritt)"></textarea>
                                                <input @bind="a.Pris" placeholder="Pris eks. mva" class="price-input" />
                                                <button type="button" class="save-button" @onclick="@(() => LagreAvvikPris(a))">Lagre</button>
                                                <button type="button" class="edit-button" @onclick="@(() => VisAvvikPdf(a.Id))">Forhåndsvis PDF</button>
                                                <button type="button" class="edit-button" disabled="@(!a.Pris.HasValue)" @onclick="@(() => SendTilKunde(a))">Send til kunde</button>
                                            </div>
                                        }
                                        else
                                        {
                                            @if (a.Pris.HasValue)
                                            {
                                                <p><strong>Pris for utbedring:</strong> @a.Pris.Value.ToString("N2", Kultur) kr eks. mva</p>
                                            }
                                            <button type="button" class="edit-button" @onclick="@(() => VisAvvikPdf(a.Id))">Vis PDF</button>
                                        }
                                    </Authorized>
                                </AuthorizeView>

                                @if (a.Status == AvvikStatus.Godkjent)
                                {
                                    <p class="save-success">Godkjent av @a.SignertAvNavn - @a.SignertDato?.ToString("dd.MM.yyyy HH:mm")</p>
                                }

                                <AuthorizeView Roles="Admin,Prosjektleder">
                                    <Authorized>
                                        <div class="avvik-pdfliste">
                                            <LagredePdfListe Pdfer="@_lagredePdfer.GetValueOrDefault(a.Id, [])" />
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        }
                    </div>

                    <div class="ds-seksjon">
                        <h4>Driftsmeldinger</h4>
                        @if (_driftsmeldinger.Count == 0)
                        {
                            <span class="ds-hint">Ingen driftsmeldinger på denne døren.</span>
                        }
                        @foreach (var m in _driftsmeldinger)
                        {
                            <div @key="m.Id" class="ds-avv">
                                <span class="ds-sm">@m.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(m.InnmeldtAvBruker is not null ? $"· {m.InnmeldtAvBruker.Navn}" : "")</span>
                                <span>@m.Tekst</span>
                                @if (m.Media.Count > 0)
                                {
                                    <div class="drift-melding-media">
                                        @foreach (var media in m.Media)
                                        {
                                            @if (media.ContentType.StartsWith("video/"))
                                            {
                                                <video controls class="drift-melding-video" src="@($"/driftsmeldingmedia/{media.Id}/fil")"></video>
                                            }
                                            else
                                            {
                                                <a href="@($"/driftsmeldingmedia/{media.Id}/fil")" target="_blank">
                                                    <img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="@media.Filnavn" class="drift-melding-bilde" />
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    break;

                case "qr":
                    <div class="ds-boks ds-qr-boks">
                        <div class="ds-qr"><img src="@($"/dor/{_dor.Id}/qr.png")" alt="QR-kode for dør @_dor.Dornummer" /></div>
                        <div class="ds-qr-tekst">
                            <b>QR-kode for @_dor.Dornummer</b>
                            <span class="ds-sm">Skriv ut og fest på dørkarmen. Skanning åpner denne dørsiden direkte.</span>
                            <div class="ds-rad">
                                <a href="@($"/dor/{_dor.Id}/qr.png")" download="@($"qr-dor-{_dor.Dornummer}.png")" class="ds-kn ds-kn-p ds-kn-s"><Icon Name="download" />Last ned PNG</a>
                            </div>
                        </div>
                    </div>
                    break;

                default:
                    <div class="ds-tall4">
                        <div>
                            <span class="ds-lbl">Beslag montert</span>
                            <b>@montertAntall / @beslagAntall</b>
                            <span class="ds-bar"><i style="width:@(beslagAntall == 0 ? 0 : montertAntall * 100 / beslagAntall)%"></i></span>
                        </div>
                        <div>
                            <span class="ds-lbl">Garanti</span>
                            @if (_dor.Prosjekt?.OverlevertDato is null)
                            {
                                <b>Ikke startet</b><small>starter ved overlevering</small>
                            }
                            else if (lengstGaranti is null)
                            {
                                <b>-</b><small>ingen garantitid på beslag</small>
                            }
                            else
                            {
                                <b>til @lengstGaranti.UtlopsDato!.Value.Year</b><small>@lengstGaranti.ComponentNavn</small>
                            }
                        </div>
                        <div>
                            <span class="ds-lbl">Åpne avvik</span>
                            <b class="@(apneAvvik > 0 ? "ds-rod" : "")">@apneAvvik</b>
                            <small>@(_avvik.FirstOrDefault(a => a.Status == AvvikStatus.Apent)?.Beskrivelse ?? "ingen åpne")</small>
                        </div>
                        <div>
                            <span class="ds-lbl">Sist oppdatert</span>
                            <b>@((_dor.OppdatertDato ?? _dor.OpprettetDato).ToString("dd.MM"))</b>
                            <small>@(_dor.OppdatertAvBruker?.Navn ?? $"opprettet {_dor.OpprettetDato:dd.MM.yyyy}")</small>
                        </div>
                    </div>

                    <div class="ds-to">
                        <div class="ds-kol">
                            <div class="ds-seksjon">
                                <h4>Spesifikasjon</h4>
                                <div class="ds-info2">
                                    <div><small>Romnr</small><b>@(_dor.Romnr ?? "-")</b></div>
                                    <div><small>Etasje / sone</small><b>@(_dor.Etasje ?? "-") · @(_dor.Sone ?? "-")</b></div>
                                    <div><small>Dørtype</small><b>@(_dor.Dortype ?? "-")</b></div>
                                    <div><small>B x H</small><b>@(_dor.BxH ?? "-")</b></div>
                                    <div><small>Brann</small><b>@(_dor.Brann ?? "-")</b></div>
                                    <div><small>Lyd</small><b>@(_dor.Lyd ?? "-")</b></div>
                                </div>
                            </div>
                            <div class="ds-seksjon">
                                <h4>Dørfunksjoner</h4>
                                @if (_dor.Funksjoner.Count == 0)
                                {
                                    <span class="ds-hint">Ingen dørfunksjoner registrert.</span>
                                }
                                else
                                {
                                    <div class="ds-chips">
                                        @foreach (var f in _dor.Funksjoner)
                                        {
                                            <span class="ds-fchip">@f.Navn</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="ds-seksjon">
                                <h4>Beslag <button type="button" @onclick="@(() => VelgFane("beslag"))">Alle →</button></h4>
                                @if (beslagAntall == 0)
                                {
                                    <p class="list-empty">Ingen beslag registrert.</p>
                                }
                                else
                                {
                                    <div class="ds-liste">
                                        @foreach (var dk in _dor.Komponenter.ToList())
                                        {
                                            <div @key="dk.ComponentId" class="ds-lr">
                                                <span class="ds-ik"><Icon Name="tool" /></span>
                                                <div><b>@dk.Component?.Navn</b><small>@(string.IsNullOrWhiteSpace(dk.Component?.Produktkode) ? "" : dk.Component!.Produktkode + " · ")@dk.Antall @dk.Enhet</small></div>
                                                @if (dk.Montert)
                                                {
                                                    <span class="ds-pill ds-ok">Montert @(dk.MontertAvBruker?.Initialer) @(dk.MontertDato?.ToString("dd.MM"))</span>
                                                }
                                                else
                                                {
                                                    <span class="ds-sm">Ikke montert</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="ds-kol">
                            <div class="ds-seksjon">
                                <h4>Siste hendelser <button type="button" @onclick="@(() => VelgFane("logg"))">Alle →</button></h4>
                                @if (historikk.Count == 0)
                                {
                                    <p class="list-empty">Ingen historikk registrert ennå.</p>
                                }
                                else
                                {
                                    <div>
                                        @foreach (var h in historikk.Take(5))
                                        {
                                            @HistorikkLinje(h)
                                        }
                                    </div>
                                }
                            </div>
                            <div class="ds-seksjon">
                                <h4>Bilder <button type="button" @onclick="@(() => VelgFane("logg"))">Alle →</button></h4>
                                <div class="ds-bilder">
                                    @foreach (var m in _media.Take(4))
                                    {
                                        @MediaFlis(m)
                                    }
                                    <button type="button" class="ds-bilde ds-bilde-ny" @onclick="@(() => VelgFane("logg"))">+ Last opp</button>
                                </div>
                            </div>
                            <div class="ds-seksjon">
                                <h4>Garanti</h4>
                                @if (_dor.Prosjekt?.OverlevertDato is null)
                                {
                                    <span class="ds-hint">Nedtelling starter når prosjektet settes til "Overlevert".</span>
                                }
                                else if (garantiLinjer.Count == 0)
                                {
                                    <span class="ds-hint">Ingen beslag med registrert garantitid på produktet.</span>
                                }
                                else
                                {
                                    <div class="ds-liste">
                                        @foreach (var linje in garantiLinjer)
                                        {
                                            <div class="ds-lr">
                                                <span class="ds-ik"><Icon Name="shield" /></span>
                                                <div><b>@linje.ComponentNavn</b></div>
                                                @if (linje.UtlopsDato.HasValue)
                                                {
                                                    var utlopt = linje.UtlopsDato.Value.Date < DateTime.Today;
                                                    <span class="ds-pill @(utlopt ? "ds-rod-pill" : "ds-ok")">@(utlopt ? $"Utløp {linje.UtlopsDato.Value:dd.MM.yyyy}" : $"Til {linje.UtlopsDato.Value:dd.MM.yyyy}")</span>
                                                }
                                                else
                                                {
                                                    <span class="ds-pill ds-gra">Ingen garantitid</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <span class="ds-sm">Opprettet @_dor.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                    break;
            }
        </div>
    </div>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Avvik" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreAvvikPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Embed { get; set; }
    [SupplyParameterFromQuery(Name = "ce")] public int? ApneCeId { get; set; }
    [SupplyParameterFromQuery(Name = "rediger")] public bool? ApneCeRedigerbar { get; set; }
    [SupplyParameterFromQuery(Name = "ny")] public bool? StartNyCe { get; set; }

    // Brukes når dørsiden vises i samme vindu som døren (prosjekt/plantegning)
    // i stedet for som egen side.
    [Parameter] public bool IModal { get; set; }
    [Parameter] public EventCallback OnTilbake { get; set; }
    [Parameter] public EventCallback OnLukk { get; set; }
    [Parameter] public EventCallback OnForrige { get; set; }
    [Parameter] public EventCallback OnNeste { get; set; }
    [Parameter] public string? ForrigeNavn { get; set; }
    [Parameter] public string? NesteNavn { get; set; }

    // Når dørsiden er selve dørvinduet i prosjektet/plantegningen: fanene
    // Detaljer og Beslag viser redigeringen fra DorRedigering.
    [Parameter] public bool MedRedigering { get; set; }
    [Parameter] public List<Dor> AlleDorer { get; set; } = [];
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnUnplaced { get; set; }
    [Parameter] public EventCallback<List<Dor>> OnCloned { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private async Task VelgFane(string fane)
    {
        // Etter redigering i Detaljer/Beslag hentes tallene i de andre fanene på nytt.
        if (MedRedigering && _fane is "detaljer" or "beslag" && fane != _fane)
        {
            _fane = fane;
            await LastAsync();
            return;
        }

        _fane = fane;
    }

    // Ny dør åpnes på Detaljer, ellers Oversikt.
    [Parameter] public string? StartFane { get; set; }

    private string _fane = "oversikt";
    private int? _lastetId;

    private string FaneKlasse(string fane) => _fane == fane ? "ds-fane ds-fane-aktiv" : "ds-fane";

    private RenderFragment HistorikkLinje(HistorikkRad h) =>
        @<div class="ds-tli">
            <span class="ds-tli-ik ds-tli-@h.Type"><Icon Name="@(h.Type switch { "Avvik" => "alert", "Driftsmelding" => "bell", _ => "edit" })" /></span>
            <div><b>@h.Tekst</b><small>@h.Type · @h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</small></div>
        </div>;

    private RenderFragment MediaFlis(DorMedia m) =>
        @<div @key="m.Id" class="ds-bilde">
            @if (m.ContentType.StartsWith("video/"))
            {
                <video controls src="@($"/dormedia/{m.Id}")"></video>
            }
            else
            {
                <img src="@($"/dormedia/{m.Id}")" alt="@m.Filnavn" />
            }
            <span class="ds-bilde-merke">@m.Tidspunkt.Visningsnavn()</span>
            <button type="button" class="ds-bilde-fjern" title="Slett" @onclick="@(() => SlettMedia(m))"><Icon Name="x" /></button>
        </div>;
    private bool _apenCeIdInitFraQuery;
    private bool _apenCeRedigerbar;
    private bool _startNyCeInitFraQuery;

    private sealed class SylinderRad
    {
        public int ComponentId { get; set; }
        public string Navn { get; set; } = "";
        public string SylMrk { get; set; } = "-";
        public List<string> Nokler { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Dor? _dor;
    private bool _notFound;
    private List<SylinderRad> _sylinderRader = [];
    private List<DorMedia> _media = [];
    private List<Avvik> _avvik = [];
    private List<Driftsmelding> _driftsmeldinger = [];
    private List<DorHendelse> _dorHendelser = [];
    private List<KoblingsSkjema> _prinsippskisser = [];
    private string _nyPrinsippskisseNavn = "";
    private const int PrinsippskisseKategoriId = 4;

    private sealed class HistorikkRad
    {
        public required string Type { get; set; }
        public required int Id { get; set; }
        public required DateTime Tidspunkt { get; set; }
        public required string Tekst { get; set; }
    }

    private List<HistorikkRad> HistorikkRader =>
        _dorHendelser.Select(h => new HistorikkRad { Type = "Endring", Id = h.Id, Tidspunkt = h.Tidspunkt, Tekst = h.Beskrivelse + (h.UtfortAvBruker is not null ? $" ({h.UtfortAvBruker.Initialer})" : "") })
            .Concat(_avvik.Select(a => new HistorikkRad { Type = "Avvik", Id = a.Id, Tidspunkt = a.OpprettetDato, Tekst = a.Beskrivelse }))
            .Concat(_driftsmeldinger.Select(m => new HistorikkRad { Type = "Driftsmelding", Id = m.Id, Tidspunkt = m.OpprettetDato, Tekst = m.Tekst }))
            .OrderByDescending(h => h.Tidspunkt)
            .ToList();
    private List<CeGodkjenning> _ceGodkjenninger = [];
    private bool _harAutomatikk;
    private int? _apenCeId;
    private DorMediaTidspunkt _nyMediaTidspunkt = DorMediaTidspunkt.For;
    private string? _mediaFeil;
    private string _nyAvvikBeskrivelse = "";
    private string? _avvikFeil;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private int? _aktivAvvikId;
    private Dictionary<int, List<LagretPdf>> _lagredePdfer = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    protected override async Task OnParametersSetAsync()
    {
        // I vinduet rendres siden på nytt hver gang forelderen gjør det - last
        // bare inn på nytt når det er en annen dør.
        if (_lastetId == Id)
        {
            return;
        }

        _lastetId = Id;
        _fane = StartFane ?? "oversikt";
        await LastAsync();
    }

    private async Task LastAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _dor = await Db.Dorer
            .Include(d => d.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(d => d.DorIdMal)
            .Include(d => d.Funksjoner)
            .Include(d => d.MontertAvBruker)
            .Include(d => d.OppdatertAvBruker)
            .Include(d => d.Komponenter).ThenInclude(k => k.Component).ThenInclude(c => c!.Type)
            .Include(d => d.Komponenter).ThenInclude(k => k.MontertAvBruker)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (_dor is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;

        if (!_apenCeIdInitFraQuery)
        {
            _apenCeIdInitFraQuery = true;
            if (ApneCeId.HasValue)
            {
                _apenCeId = ApneCeId.Value;
                _apenCeRedigerbar = ApneCeRedigerbar == true;
            }
        }

        _harAutomatikk = _dor.Komponenter.Any(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.DorAutomatikk);
        _ceGodkjenninger = await Db.CeGodkjenninger
            .Where(c => c.DorId == Id)
            .Include(c => c.Media)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();

        if (!_startNyCeInitFraQuery)
        {
            _startNyCeInitFraQuery = true;
            if (StartNyCe == true && _apenCeId is null)
            {
                await StartCeGodkjenning();
            }
        }

        // Uten selve filinnholdet - bildene/videoene hentes via /dormedia/{id}, og
        // å laste alle filene her gjorde dørvinduet tregt å åpne.
        _media = await Db.DorMedia.AsNoTracking().Where(m => m.DorId == Id).OrderByDescending(m => m.OpprettetDato)
            .Select(m => new DorMedia { Id = m.Id, DorId = m.DorId, Data = Array.Empty<byte>(), ContentType = m.ContentType, Filnavn = m.Filnavn, Tidspunkt = m.Tidspunkt, OpprettetDato = m.OpprettetDato })
            .ToListAsync();
        _avvik = await Db.Avvik.Where(a => a.DorId == Id).Include(a => a.OpprettetAvBruker)
            .OrderByDescending(a => a.OpprettetDato).ToListAsync();

        _dorHendelser = await Db.DorHendelser.Where(h => h.DorId == Id).Include(h => h.UtfortAvBruker)
            .OrderByDescending(h => h.Tidspunkt).ToListAsync();

        _driftsmeldinger = await Db.Driftsmeldinger.Where(m => m.DorId == Id)
            .Include(m => m.InnmeldtAvBruker).Include(m => m.Media)
            .OrderByDescending(m => m.OpprettetDato).ToListAsync();

        _prinsippskisser = await Db.KoblingsSkjemaer.Where(s => s.DorId == Id)
            .Include(s => s.Symboler).Include(s => s.Streker)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato).ToListAsync();

        var uleste = _driftsmeldinger.Where(m => !m.LestAvAnsatt).ToList();
        if (uleste.Count > 0)
        {
            var uleseIder = uleste.Select(m => m.Id).ToList();
            await Db.Driftsmeldinger.Where(m => uleseIder.Contains(m.Id))
                .ExecuteUpdateAsync(s => s.SetProperty(m => m.LestAvAnsatt, true).SetProperty(m => m.LestDato, DateTime.Now));
        }

        // Ett samlet oppslag for alle avvik i stedet for ett DB-kall per avvik
        // (N+1-mønster, se CODE_REVIEW.md 2026-10-08) - samme data/sortering
        // som før, siden lesestedet (LagredePdfListe) allerede bruker
        // GetValueOrDefault(id, []) for avvik uten lagrede PDF-er.
        _lagredePdfer = await LagretPdfService.HentForFlereAsync("Avvik", _avvik.Select(a => a.Id).ToList());

        var sylinderKomponenter = _dor.Komponenter.Where(k => k.Component?.ErSylinder == true).ToList();
        var componentIder = sylinderKomponenter.Select(k => k.ComponentId).ToList();

        var krysser = await Db.NokkelSylindere
            .Where(ns => ns.DorId == Id && componentIder.Contains(ns.ComponentId))
            .Include(ns => ns.Nokkel)
            .ToListAsync();

        // Syl.mrk-nummeret følger samme rekkefølge som i låsplan-matrisen/PDF-en for hele prosjektet.
        var alleSylinderKomponenter = await Db.DorKomponenter
            .Where(k => k.Dor!.ProsjektId == _dor.ProsjektId && k.Component!.ErSylinder)
            .Include(k => k.Dor)
            .OrderBy(k => k.Dor!.Dornummer)
            .ToListAsync();

        var sylMrkPerComponent = new Dictionary<int, string>();
        var sylNummer = 0;
        foreach (var dk in alleSylinderKomponenter)
        {
            sylNummer++;
            if (dk.DorId == Id)
            {
                sylMrkPerComponent[dk.ComponentId] = sylNummer.ToString();
            }
        }

        _sylinderRader = sylinderKomponenter.Select(k => new SylinderRad
        {
            ComponentId = k.ComponentId,
            Navn = k.Component!.Navn,
            SylMrk = sylMrkPerComponent.TryGetValue(k.ComponentId, out var mrk) ? mrk : "-",
            Nokler = krysser.Where(ns => ns.ComponentId == k.ComponentId)
                .Select(ns => ns.Nokkel!.Merking ?? ns.Nokkel!.Navn)
                .ToList()
        }).ToList();
    }

    private async Task OpprettPrinsippskisse()
    {
        var navn = _nyPrinsippskisseNavn.Trim();
        if (navn.Length == 0)
        {
            navn = $"Prinsippskisse - dør {_dor!.Dornummer}";
        }

        var skjema = new KoblingsSkjema { KategoriId = PrinsippskisseKategoriId, DorId = Id, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        GenererSymbolerFraBestykning(skjema.Id);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    // Autogenererer en startskisse ut fra dørens bestykning, i samme stil som
    // de håndtegnede rørførings-/koblingsskissene i dørmiljø-biblioteket:
    // hvert produkt som en utfylt, merket boks, med en stiplet linje inn mot
    // døren i midten (tilsvarer "Koblingsnode"-mønsteret der). Komponenter
    // fordeles i kolonner etter Plassering (Hengselside/Karmside) - uten
    // registrert plassering havner de på den korteste kolonnen slik at alt
    // vises. Dette er kun et startpunkt - alt kan flyttes/omformes/slettes
    // videre i editoren.
    private void GenererSymbolerFraBestykning(int skjemaId)
    {
        const double dorX = 42, dorY = 8, dorBredde = 16, dorHoyde = 84;

        Db.KoblingsSymboler.Add(new KoblingsSymbol
        {
            KoblingsSkjemaId = skjemaId,
            ElementType = KoblingsElementType.Tekstboks,
            Tekst = $"Dør {_dor!.Dornummer}",
            Farge = "#292927",
            FontStorrelse = 13,
            PosX = 38,
            PosY = 1,
            Bredde = 24,
            Hoyde = 5,
            ZIndex = 2
        });
        Db.KoblingsSymboler.Add(new KoblingsSymbol
        {
            KoblingsSkjemaId = skjemaId,
            ElementType = KoblingsElementType.Rektangel,
            Farge = "#292927",
            Strokbredde = 2,
            PosX = dorX,
            PosY = dorY,
            Bredde = dorBredde,
            Hoyde = dorHoyde,
            ZIndex = 0
        });

        var hengsel = _dor.Komponenter.Where(k => k.Plassering == DorKomponentPlassering.Hengselside).ToList();
        var karm = _dor.Komponenter.Where(k => k.Plassering == DorKomponentPlassering.Karmside).ToList();
        foreach (var k in _dor.Komponenter.Where(k => k.Plassering is null))
        {
            (hengsel.Count <= karm.Count ? hengsel : karm).Add(k);
        }

        LeggSymbolKolonne(skjemaId, hengsel, startX: 3, koblesTilX: dorX, dorY: dorY, dorHoyde: dorHoyde);
        LeggSymbolKolonne(skjemaId, karm, startX: 65, koblesTilX: dorX + dorBredde, dorY: dorY, dorHoyde: dorHoyde);
    }

    // koblesTilX er x-koordinaten på dørens kant boksene skal trekke en
    // stiplet linje til (venstre kant for hengselside, høyre kant for
    // karmside), slik at alle komponentene visuelt peker inn mot døren -
    // samme "comb"-mønster som i de håndtegnede referanseskissene.
    private void LeggSymbolKolonne(int skjemaId, List<DorKomponent> komponenter, double startX, double koblesTilX, double dorY, double dorHoyde)
    {
        if (komponenter.Count == 0)
        {
            return;
        }

        var startY = dorY + 2;
        var sluttY = dorY + dorHoyde - 2;
        var radHoyde = Math.Min(10, (sluttY - startY) / komponenter.Count);
        const double boksBredde = 30;

        var y = startY;
        foreach (var k in komponenter)
        {
            var boksHoyde = Math.Max(radHoyde - 2, 4);
            var navn = k.Component?.Navn ?? "Ukjent komponent";
            if (k.Antall > 1)
            {
                navn += $" ({k.Antall} stk)";
            }

            Db.KoblingsSymboler.Add(new KoblingsSymbol
            {
                KoblingsSkjemaId = skjemaId,
                ElementType = KoblingsElementType.Rektangel,
                Navn = navn,
                Farge = "#835e41",
                Strokbredde = 1,
                Fylt = true,
                PosX = startX,
                PosY = y,
                Bredde = boksBredde,
                Hoyde = boksHoyde,
                ZIndex = 1
            });

            var linjeY = y + boksHoyde / 2;
            var boksKantX = startX < koblesTilX ? startX + boksBredde : startX;
            var punkter = JsonSerializer.Serialize(new[]
            {
                new KoblingsStrekPunkt { X = boksKantX, Y = linjeY },
                new KoblingsStrekPunkt { X = koblesTilX, Y = linjeY }
            });
            Db.KoblingsStreker.Add(new KoblingsStrek
            {
                KoblingsSkjemaId = skjemaId,
                PunkterJson = punkter,
                Farge = "#835e41",
                Tykkelse = 1,
                Stiplet = true
            });

            y += radHoyde;
        }
    }

    private async Task FjernBeslag(DorKomponent dk)
    {
        Db.DorHendelser.Add(new DorHendelse
        {
            DorId = Id,
            Beskrivelse = $"Fjernet {dk.Component?.Navn}",
            UtfortAvBrukerId = _naverendeBrukerId
        });

        Db.DorKomponenter.Remove(dk);
        _dor!.Komponenter.Remove(dk);

        var krysser = await Db.NokkelSylindere.Where(ns => ns.DorId == Id && ns.ComponentId == dk.ComponentId).ToListAsync();
        Db.NokkelSylindere.RemoveRange(krysser);

        await Db.SaveChangesAsync();
        await LastAsync();
    }

    private async Task LastOppMedia(InputFileChangeEventArgs e)
    {
        _mediaFeil = null;
        var file = e.File;

        if (file.Size > 50_000_000)
        {
            _mediaFeil = $"\"{file.Name}\" er for stor (maks 50 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var media = new DorMedia
        {
            DorId = Id,
            Data = buffer.ToArray(),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            Filnavn = file.Name,
            Tidspunkt = _nyMediaTidspunkt
        };
        Db.DorMedia.Add(media);
        await Db.SaveChangesAsync();

        _media.Insert(0, media);
    }

    private async Task SlettMedia(DorMedia media)
    {
        var entitet = await Db.DorMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.DorMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _media.Remove(media);
    }

    private async Task MeldAvvik()
    {
        _avvikFeil = null;
        if (string.IsNullOrWhiteSpace(_nyAvvikBeskrivelse))
        {
            _avvikFeil = "Skriv en beskrivelse av avviket.";
            return;
        }

        var avvik = new Avvik
        {
            DorId = Id,
            Beskrivelse = _nyAvvikBeskrivelse.Trim(),
            OpprettetAvBrukerId = _naverendeBrukerId
        };
        Db.Avvik.Add(avvik);
        await Db.SaveChangesAsync();

        avvik.OpprettetAvBruker = _naverendeBrukerId.HasValue ? await Db.Brukere.FindAsync(_naverendeBrukerId.Value) : null;
        _avvik.Insert(0, avvik);
        _nyAvvikBeskrivelse = "";
    }

    private async Task LagreAvvikPris(Avvik avvik)
    {
        var entitet = await Db.Avvik.FindAsync(avvik.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.UtbedringBeskrivelse = string.IsNullOrWhiteSpace(avvik.UtbedringBeskrivelse) ? null : avvik.UtbedringBeskrivelse.Trim();
        entitet.Pris = avvik.Pris;
        await Db.SaveChangesAsync();
    }

    private void VisAvvikPdf(int avvikId)
    {
        _aktivAvvikId = avvikId;
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/avvik/{avvikId}/pdf";
    }

    private async Task LagreAvvikPdf()
    {
        if (_aktivAvvikId is not { } avvikId)
        {
            return;
        }

        var bytes = await AvvikPdfService.GenerateAsync(avvikId);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Avvik", avvikId, $"Avvik - {_dor?.Dornummer} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        if (!_lagredePdfer.TryGetValue(avvikId, out var liste))
        {
            liste = [];
            _lagredePdfer[avvikId] = liste;
        }
        liste.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task StartCeGodkjenning()
    {
        if (_dor is null)
        {
            return;
        }

        var antall = await Db.CeGodkjenninger.CountAsync();
        var nummer = $"CE-ITL-DOR-{DateTime.Now:yyMM}-{antall + 1:0000}";

        var automatikk = _dor.Komponenter.FirstOrDefault(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.DorAutomatikk);
        var gyldighetMåneder = _dor.Prosjekt?.CeGyldighetMåneder is > 0 ? _dor.Prosjekt!.CeGyldighetMåneder : 12;
        var gyldigFra = DateTime.Now;

        var ce = new CeGodkjenning
        {
            DorId = _dor.Id,
            Sertifiseringsnummer = nummer,
            OpprettetAvBrukerId = _naverendeBrukerId,
            KundeNavn = _dor.Prosjekt?.Kunde?.Navn,
            Kontaktperson = _dor.Prosjekt?.Kontaktperson,
            ProsjektNavn = _dor.Prosjekt?.Navn,
            Adresse = _dor.Prosjekt?.Adresse,
            Etasje = _dor.Etasje,
            DorTil = _dor.DorTil,
            Dornummer = _dor.Dornummer,
            DorIdKode = _dor.DorIdMal?.Kode,
            Byggkategori = _dor.Prosjekt?.Byggkategori,
            Risikoklasse = _dor.Prosjekt?.Risikoklasse,
            GyldighetMåneder = gyldighetMåneder,
            GyldigFra = gyldigFra,
            GyldigTil = gyldigFra.AddMonths(gyldighetMåneder),
            Produsent = automatikk?.Component?.Produsent,
            ProdusentAdresse = automatikk?.Component?.ProdusentAdresse,
            ProdusentPostnr = automatikk?.Component?.ProdusentPostnr,
            ProdusentSted = automatikk?.Component?.ProdusentSted,
            ProdusentLand = automatikk?.Component?.ProdusentLand,
            ProdusentOrgnr = automatikk?.Component?.ProdusentOrgnr,
            ItemNavn = automatikk?.Component?.Navn,
            Antall = automatikk?.Antall,
            BreddeMm = _dor.Bredde,
            HoydeMm = _dor.Hoyde,
            Brannklasse = _dor.Brann,
            FriBredde086 = _dor.FriBredde086,
            Dorkonstruksjon = _dor.DorIdMal?.Dorkonstruksjon,
            Karmkonstruksjon = _dor.DorIdMal?.Karmkonstruksjon,
            GlassIDor = _dor.DorIdMal?.GlassIDor switch { true => "Med glass", false => "Uten glass", null => null }
        };

        Db.CeGodkjenninger.Add(ce);
        await Db.SaveChangesAsync();

        _apenCeId = ce.Id;
    }

    private async Task LukkCePanel()
    {
        _apenCeId = null;
        _ceGodkjenninger = await Db.CeGodkjenninger
            .Where(c => c.DorId == Id)
            .Include(c => c.Media)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();
    }

    private async Task SendTilKunde(Avvik avvik)
    {
        var entitet = await Db.Avvik.FindAsync(avvik.Id);
        if (entitet is null || !entitet.Pris.HasValue)
        {
            return;
        }

        entitet.Status = AvvikStatus.SendtTilKunde;
        entitet.SendtTilKundeDato = DateTime.Now;
        await Db.SaveChangesAsync();

        avvik.Status = AvvikStatus.SendtTilKunde;
        avvik.SendtTilKundeDato = entitet.SendtTilKundeDato;
    }
}
