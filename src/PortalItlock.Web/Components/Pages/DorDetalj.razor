@page "/dor/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.ITenantContext TenantContext

@if (!IModal)
{
    <PageTitle>Dør @(_dor?.Dornummer)</PageTitle>
}

@if (_notFound)
{
    <p class="form-error">Fant ikke døren. Den kan være slettet.</p>
}
else if (_dor is null)
{
    <p>Laster...</p>
}
else
{
    var montertAntall = _dor.Komponenter.Count(k => k.Montert);
    var beslagAntall = _dor.Komponenter.Count;
    var apneAvvik = _avvik.Count(a => a.Status == AvvikStatus.Apent);
    var garantiLinjer = GarantiBeregning.Linjer(_dor, _dor.Prosjekt?.OverlevertDato);
    var lengstGaranti = garantiLinjer.Where(l => l.UtlopsDato.HasValue).OrderByDescending(l => l.UtlopsDato).FirstOrDefault();
    var historikk = HistorikkRader;

    <div class="ds-kort @(IModal ? "ds-kort-modal" : "")">
        <div class="ds-topp">
            <span class="ds-ikon"><Icon Name="door" /></span>
            <div class="ds-tittel">
                <div class="ds-smul">
                    @if (IModal && OnTilbake.HasDelegate)
                    {
                        <button type="button" class="ds-tilbake" @onclick="@(() => OnTilbake.InvokeAsync())">‹ Tilbake til redigering</button>
                        <span> · </span>
                    }
                    else if (!IModal && !Embed)
                    {
                        <a class="ds-tilbake" href="@($"/prosjekter/{_dor.ProsjektId}")">‹ Tilbake til prosjektet</a>
                        <span> · </span>
                    }
                    <span>@_dor.Prosjekt?.Navn</span>
                </div>
                <h1>
                    <span>Dørside @_dor.Dornummer</span>
                    <StatusPill Tekst="@_dor.Status.Visningsnavn()" Ikon="@_dor.Status.PillIkon()" Farge="@_dor.Status.PillFarge()" />
                </h1>
            </div>
            <div class="ds-handl">
                @if (OnForrige.HasDelegate || OnNeste.HasDelegate)
                {
                    <span class="ds-navpil">
                        <button type="button" disabled="@(!OnForrige.HasDelegate)" @onclick="@(() => OnForrige.InvokeAsync())">‹ @ForrigeNavn</button>
                        <button type="button" disabled="@(!OnNeste.HasDelegate)" @onclick="@(() => OnNeste.InvokeAsync())">@NesteNavn ›</button>
                    </span>
                }
                <button type="button" class="ds-kn" @onclick="@(async () => { await VelgFane("avvik"); _visMeldAvvik = true; })"><Icon Name="alert" />Meld avvik</button>
                <button type="button" class="ds-kn" @onclick="@(() => VelgFane("logg"))"><Icon Name="camera" />Bilde</button>
                @if (IModal && OnTilbake.HasDelegate)
                {
                    <button type="button" class="ds-kn ds-kn-p" @onclick="@(() => OnTilbake.InvokeAsync())">Rediger dør</button>
                }
                <button type="button" class="ds-qr-mini" title="QR-kode" @onclick="@(() => VelgFane("qr"))">
                    <img src="@($"/dor/{_dor.Id}/qr.png")" alt="QR-kode for dør @_dor.Dornummer" />
                </button>
                @if (IModal && OnLukk.HasDelegate)
                {
                    <button type="button" class="ds-ikk" title="Lukk" @onclick="@(() => OnLukk.InvokeAsync())"><Icon Name="x" /></button>
                }
            </div>
        </div>

        <div class="ds-info">
            <span><Icon Name="map-pin" />Rom <b>@(_dor.Romnr ?? "-")</b>@if (!string.IsNullOrWhiteSpace(_dor.DorTil)) {<span> · til <b>@_dor.DorTil</b></span>}</span>
            <span><Icon Name="building" /><b>@(_dor.Etasje ?? "-")</b> · sone <b>@(_dor.Sone ?? "-")</b></span>
            <span><Icon Name="door" /><b>@(_dor.Dortype ?? "-")</b>@if (!string.IsNullOrWhiteSpace(_dor.BxH)) {<span> · @_dor.BxH</span>}</span>
            <span><Icon Name="alert-triangle" />Brann <b>@(_dor.Brann ?? "-")</b></span>
            @if (_dor.DorIdMal is not null)
            {
                <span><Icon Name="tag" />Dør-ID <b>@_dor.DorIdMal.Kode</b></span>
            }
            @if (lengstGaranti is not null)
            {
                <span><Icon Name="shield" />Garanti <b>til @lengstGaranti.UtlopsDato!.Value.Year</b></span>
            }
        </div>

        <nav class="ds-faner">
            <button type="button" class="@FaneKlasse("oversikt")" @onclick="@(() => VelgFane("oversikt"))"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="@FaneKlasse("beslag")" @onclick="@(() => VelgFane("beslag"))"><Icon Name="tool" />Beslag <em>@montertAntall/@beslagAntall</em></button>
            <button type="button" class="@FaneKlasse("dok")" @onclick="@(() => VelgFane("dok"))"><Icon Name="file-text" />Dokumentasjon <em>@(_ceGodkjenninger.Count + _sylinderRader.Count + _prinsippskisser.Count)</em></button>
            <button type="button" class="@FaneKlasse("logg")" @onclick="@(() => VelgFane("logg"))"><Icon Name="image" />Bilder og historikk <em>@(_media.Count + historikk.Count)</em></button>
            <button type="button" class="@FaneKlasse("avvik")" @onclick="@(() => VelgFane("avvik"))"><Icon Name="alert" />Avvik og drift <em class="@(apneAvvik > 0 ? "ds-em-rod" : "")">@(apneAvvik > 0 ? apneAvvik : _avvik.Count + _driftsmeldinger.Count)</em></button>
            <button type="button" class="@FaneKlasse("qr")" @onclick="@(() => VelgFane("qr"))"><Icon Name="qr" />QR-kode</button>
            @if (MedRedigering)
            {
                <button type="button" class="@FaneKlasse("detaljer") ds-fane-hoyre" @onclick="@(() => VelgFane("detaljer"))"><Icon Name="edit" />Detaljer</button>
            }
        </nav>

        <div class="ds-kropp">
            @switch (_fane)
            {
                case "detaljer" or "beslag" when MedRedigering:
                    <DorRedigering Dor="_dor"
                                   Seksjon="@_fane"
                                   AlleDorer="AlleDorer"
                                   ProsjektOverlevertDato="_dor.Prosjekt?.OverlevertDato"
                                   OnClose="@(() => OnLukk.InvokeAsync())"
                                   OnDeleted="@(() => OnDeleted.InvokeAsync())"
                                   OnUnplaced="@(() => OnUnplaced.InvokeAsync())"
                                   OnCloned="@((List<Dor> nye) => OnCloned.InvokeAsync(nye))"
                                   OnSaved="@(() => OnSaved.InvokeAsync())" />
                    break;

                case "beslag":
                    <div class="ds-rad">
                        <span class="ds-hint ds-flex">Beslag legges til og endres i dørvinduet. Her ser du hva som er montert, og kan fjerne beslag.</span>
                        @if (IModal && OnTilbake.HasDelegate)
                        {
                            <button type="button" class="ds-kn" @onclick="@(() => OnTilbake.InvokeAsync())"><Icon Name="edit" />Rediger beslag</button>
                        }
                    </div>
                    @if (beslagAntall == 0)
                    {
                        <p class="list-empty">Ingen beslag registrert.</p>
                    }
                    else
                    {
                        <div class="ds-tab-wrap">
                            <table class="ds-tab">
                                <thead>
                                    <tr><th>Vare</th><th class="ds-c">Antall</th><th>Enhet</th><th>Plass.</th><th>Levert av</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var dk in _dor.Komponenter.ToList())
                                    {
                                        <tr @key="dk.ComponentId">
                                            <td><b>@dk.Component?.Navn</b>@if (!string.IsNullOrWhiteSpace(dk.Component?.Produktkode)) {<small>@dk.Component!.Produktkode</small>}</td>
                                            <td class="ds-c">@dk.Antall</td>
                                            <td>@(dk.Enhet ?? "-")</td>
                                            <td>@(dk.Plassering switch { DorKomponentPlassering.Hengselside => "H", DorKomponentPlassering.Karmside => "K", _ => "-" })</td>
                                            <td>@dk.LevertAv</td>
                                            <td>
                                                @if (dk.Montert)
                                                {
                                                    <span class="ds-pill ds-ok">✓ Montert @(dk.MontertDato?.ToString("dd.MM")) @(dk.MontertAvBruker is not null ? $"({dk.MontertAvBruker.Initialer})" : "")</span>
                                                }
                                                else
                                                {
                                                    <span class="ds-pill ds-gra">Ikke montert</span>
                                                }
                                            </td>
                                            <td><button type="button" class="ds-ikk ds-ikk-liten" title="Fjern beslag" @onclick="@(() => FjernBeslag(dk))"><Icon Name="x" /></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <span class="ds-sm">@montertAntall av @beslagAntall montert</span>
                    }
                    break;

                case "dok":
                    @* D1: tre kort med grått hode (CE-godkjenning, Låsplan, Prinsippskisse), tabeller annenhver grå/hvit,
                       og tomme kort som én stiplet linje. *@
                    @if (_apenCeId is not null)
                    {
                        <div class="ce-modal-overlay">
                            <div class="ce-modal">
                                <CeGodkjenningPanel Id="_apenCeId.Value" OnClose="LukkCePanel" StartRedigerbar="_apenCeRedigerbar" />
                            </div>
                        </div>
                    }
                    <div class="dk-wrap">
                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik"><Icon Name="shield" /></span>
                                <b>CE-godkjenning</b>
                                @if (_ceGodkjenninger.Count > 0)
                                {
                                    <span class="dk-teller">@_ceGodkjenninger.Count</span>
                                }
                                @if (_harAutomatikk)
                                {
                                    <button type="button" class="dk-kn dk-kn-p" @onclick="StartCeGodkjenning"><Icon Name="plus" />Start CE-godkjenning</button>
                                }
                            </div>
                            @if (_ceGodkjenninger.Count > 0)
                            {
                                <div class="dk-tab-wrap">
                                    <table class="dk-tab">
                                        <thead>
                                            <tr><th>Nummer</th><th>Status</th><th>Vilkår</th><th>Gyldig til</th><th></th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ce in _ceGodkjenninger)
                                            {
                                                var utlopt = ce.GyldigTil.Date < DateTime.Today;
                                                <tr @key="ce.Id">
                                                    <td>
                                                        <b>@ce.Sertifiseringsnummer</b>
                                                        <small>@(utlopt ? "Utløpt · " : "")@(ce.OpprettetAvBruker is not null ? $"{ce.OpprettetAvBruker.Navn} · " : "")@ce.OpprettetDato.ToString("dd.MM.yyyy")</small>
                                                    </td>
                                                    <td><span class="dk-pill @CeStatusKlasse(ce.Status)">@if (ce.Status == CeGodkjenningStatus.Godkjent) {<Icon Name="check" />}@ce.Status.Visningsnavn()</span></td>
                                                    <td>
                                                        @if (CeValideringsService.ErGodkjent(ce, _dor.Komponenter))
                                                        {
                                                            <span class="dk-pill dk-gronn">Oppfylt</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="dk-pill dk-gul">Ikke oppfylt</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (utlopt)
                                                        {
                                                            <span class="dk-pill dk-rod"><Icon Name="alert-triangle" />@ce.GyldigTil.ToString("dd.MM.yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            @ce.GyldigTil.ToString("dd.MM.yyyy")
                                                        }
                                                    </td>
                                                    <td class="dk-handling">
                                                        <button type="button" class="dk-kn" @onclick="@(() => { _apenCeId = ce.Id; _apenCeRedigerbar = false; })">Åpne</button>
                                                        <a class="dk-kn" href="@($"/ce/{ce.Id}/pdf")" target="_blank" rel="noopener"><Icon Name="download" />PDF</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="dk-tom">
                                    <Icon Name="shield" />
                                    @if (_harAutomatikk)
                                    {
                                        <span>Ingen CE-godkjenning startet på denne døren ennå</span>
                                    }
                                    else
                                    {
                                        <span>CE-godkjenning kan startes når døren har dørautomatikk under Beslag</span>
                                        <button type="button" class="dk-kn" @onclick="@(() => VelgFane("beslag"))">Til Beslag →</button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik"><Icon Name="lock" /></span>
                                <b>Låsplan</b>
                                @if (_sylinderRader.Count > 0)
                                {
                                    <span class="dk-teller">@_sylinderRader.Count</span>
                                }
                                <a class="dk-lenke" href="@($"/prosjekt/{_dor.ProsjektId}/lasplan")">Åpne full låsplan →</a>
                            </div>
                            @if (_sylinderRader.Count == 0)
                            {
                                <div class="dk-tom"><Icon Name="lock" /><span>Ingen sylindere registrert på denne døren</span></div>
                            }
                            else
                            {
                                <div class="dk-liste">
                                    @foreach (var rad in _sylinderRader)
                                    {
                                        <div @key="rad.ComponentId" class="dk-rad">
                                            <span class="dk-sym"><Icon Name="lock" /></span>
                                            <div><b>Syl.mrk @rad.SylMrk · @rad.Navn</b>@if (rad.Nokler.Count == 0) {<small>Ingen nøkler registrert</small>}</div>
                                            <div class="dk-nokler">
                                                @foreach (var n in rad.Nokler)
                                                {
                                                    <span class="dk-chip">@n</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik"><Icon Name="krets-noder" /></span>
                                <b>Prinsippskisse</b>
                                @if (_prinsippskisser.Count > 0)
                                {
                                    <span class="dk-teller">@_prinsippskisser.Count</span>
                                    <AuthorizeView Roles="Admin,Prosjektleder">
                                        <button type="button" class="dk-kn" @onclick="OpprettPrinsippskisse"><Icon Name="plus" />Ny prinsippskisse</button>
                                    </AuthorizeView>
                                }
                            </div>
                            @if (_prinsippskisser.Count == 0)
                            {
                                <div class="dk-tom">
                                    <Icon Name="krets-noder" />
                                    <span>Ingen prinsippskisse ennå – lages automatisk ut fra beslaget på døren</span>
                                    <AuthorizeView Roles="Admin,Prosjektleder">
                                        <button type="button" class="dk-kn dk-kn-p" @onclick="OpprettPrinsippskisse"><Icon Name="plus" />Ny prinsippskisse</button>
                                    </AuthorizeView>
                                </div>
                            }
                            else
                            {
                                <div class="dk-liste">
                                    @foreach (var sk in _prinsippskisser)
                                    {
                                        <div @key="sk.Id" class="dk-rad">
                                            <span class="prinsippskisse-forhandsvisning"><KoblingsSkjemaMiniPreview Symboler="sk.Symboler" Streker="sk.Streker" /></span>
                                            <div><b>@sk.Navn</b><small>@(sk.OppdatertDato is null ? $"Opprettet {sk.OpprettetDato:dd.MM.yyyy}" : $"Oppdatert {sk.OppdatertDato:dd.MM.yyyy}")</small></div>
                                            <a class="dk-kn" href="@($"/koblingsskjema/{sk.Id}")"><Icon Name="maximize" />Åpne</a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    break;

                case "logg":
                    @* G1: bilder øverst (Før | Etter side om side), historikken som tabell i Arbeidsordre-stil
                       med de nyeste først og «Se mer» for eldre. *@
                    var forMedia = _media.Where(m => m.Tidspunkt == DorMediaTidspunkt.For).ToList();
                    var etterMedia = _media.Where(m => m.Tidspunkt == DorMediaTidspunkt.Etter).ToList();
                    var filtrertHist = _histFilter is null ? historikk : historikk.Where(h => h.Type == _histFilter).ToList();
                    <div class="dk-wrap">
                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik"><Icon Name="image" /></span>
                                <b>Bilder og video</b>
                                @if (_media.Count > 0)
                                {
                                    <span class="dk-teller">@_media.Count</span>
                                }
                                <span class="hb-hoyre">
                                    <span class="hb-seg" role="group" aria-label="Før eller etter">
                                        <button type="button" class="@(_nyMediaTidspunkt == DorMediaTidspunkt.For ? "pa" : "")" @onclick="@(() => _nyMediaTidspunkt = DorMediaTidspunkt.For)">Før</button>
                                        <button type="button" class="@(_nyMediaTidspunkt == DorMediaTidspunkt.Etter ? "pa" : "")" @onclick="@(() => _nyMediaTidspunkt = DorMediaTidspunkt.Etter)">Etter</button>
                                    </span>
                                    <label class="dk-kn dk-kn-p hb-last">
                                        <Icon Name="upload" />Last opp
                                        <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
                                    </label>
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(_mediaFeil))
                            {
                                <p class="form-error hb-feil">@_mediaFeil</p>
                            }
                            <div class="hb-sbs">
                                <div>
                                    <div class="hb-del">Før @if (forMedia.Count > 0) {<em>@forMedia.Count</em>}</div>
                                    <div class="hb-grid">
                                        @foreach (var m in forMedia)
                                        {
                                            @MediaFlis(m)
                                        }
                                        @if (forMedia.Count == 0)
                                        {
                                            <label class="hb-ny" @onclick="@(() => _nyMediaTidspunkt = DorMediaTidspunkt.For)">
                                                <Icon Name="camera" /><span>Ta bilde /<br />last opp</span>
                                                <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
                                            </label>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <div class="hb-del">Etter @if (etterMedia.Count > 0) {<em>@etterMedia.Count</em>}</div>
                                    <div class="hb-grid">
                                        @foreach (var m in etterMedia)
                                        {
                                            @MediaFlis(m)
                                        }
                                        <label class="hb-ny" @onclick="@(() => _nyMediaTidspunkt = DorMediaTidspunkt.Etter)">
                                            <Icon Name="camera" /><span>Ta bilde /<br />last opp</span>
                                            <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik"><Icon Name="clock" /></span>
                                <b>Historikk</b>
                                @if (historikk.Count > 0)
                                {
                                    <span class="dk-teller">@historikk.Count</span>
                                }
                            </div>
                            @if (historikk.Count == 0)
                            {
                                <div class="dk-tom"><Icon Name="clock" /><span>Ingen historikk registrert ennå</span></div>
                            }
                            else
                            {
                                <div class="hb-filter">
                                    <button type="button" class="@(_histFilter is null ? "pa" : "")" @onclick="@(() => VelgHistFilter(null))">Alle<em>@historikk.Count</em></button>
                                    @foreach (var gruppe in historikk.GroupBy(h => h.Type).OrderBy(g => g.Key))
                                    {
                                        var type = gruppe.Key;
                                        <button type="button" class="@(_histFilter == type ? "pa" : "")" @onclick="@(() => VelgHistFilter(type))">@HistTypeNavn(type)<em>@gruppe.Count()</em></button>
                                    }
                                </div>
                                <div class="dk-tab-wrap">
                                    <table class="dk-tab">
                                        <thead>
                                            <tr><th style="width:150px">Dato</th><th style="width:150px">Type</th><th>Hendelse</th><th style="width:160px">Utført av</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in filtrertHist.Take(_histVis))
                                            {
                                                <tr @key="@($"{h.Type}-{h.Id}")">
                                                    <td class="hb-dato">@h.Tidspunkt.ToString("dd.MM.yyyy") <span>@h.Tidspunkt.ToString("HH:mm")</span></td>
                                                    <td><span class="dk-pill @HistTypeKlasse(h.Type)"><Icon Name="@HistTypeIkon(h.Type)" />@h.Type</span></td>
                                                    <td><b class="hb-tekst">@h.Rentekst</b></td>
                                                    <td>@(h.UtfortAv ?? "–")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (filtrertHist.Count > _histVis)
                                {
                                    <div class="hb-se">
                                        <button type="button" @onclick="@(() => _histVis += 10)">Se mer <Icon Name="chevron-down" /></button>
                                        <small>@(filtrertHist.Count - _histVis) eldre @(filtrertHist.Count - _histVis == 1 ? "hendelse" : "hendelser")</small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    break;

                case "avvik":
                    @* A1: avvik og driftsmeldinger som to tabeller i Arbeidsordre-stil, nyeste først,
                       5 om gangen med «Se mer». Hvert avvik har sin egen side (/avvik/{id}). *@
                    var avvikApne = _avvik.Where(a => a.Status is AvvikStatus.Apent or AvvikStatus.SendtTilKunde).ToList();
                    var avvikViste = _avvikKunApne ? avvikApne : _avvik;
                    var nyeMeldinger = _driftsmeldinger.Count(m => !m.LestAvAnsatt);
                    <div class="dk-wrap">
                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik av-ik-rod"><Icon Name="alert-triangle" /></span>
                                <b>Avvik</b>
                                @if (avvikApne.Count > 0)
                                {
                                    <span class="dk-teller av-teller-rod">@avvikApne.Count åpne</span>
                                }
                                else if (_avvik.Count > 0)
                                {
                                    <span class="dk-teller">@_avvik.Count</span>
                                }
                                <button type="button" class="dk-kn av-kn-rod" @onclick="@(() => _visMeldAvvik = true)"><Icon Name="plus" />Meld avvik</button>
                            </div>
                            @if (_avvik.Count == 0)
                            {
                                <div class="dk-tom"><Icon Name="alert-triangle" /><span>Ingen avvik registrert på denne døren</span></div>
                            }
                            else
                            {
                                <div class="hb-filter">
                                    <button type="button" class="@(_avvikKunApne ? "pa" : "")" @onclick="@(() => { _avvikKunApne = true; _avvikVis = ListeStart; })">Åpne<em>@avvikApne.Count</em></button>
                                    <button type="button" class="@(!_avvikKunApne ? "pa" : "")" @onclick="@(() => { _avvikKunApne = false; _avvikVis = ListeStart; })">Alle<em>@_avvik.Count</em></button>
                                </div>
                                @if (avvikViste.Count == 0)
                                {
                                    <div class="dk-tom"><Icon Name="check" /><span>Ingen åpne avvik – alle er lukket eller godkjent</span></div>
                                }
                                else
                                {
                                    <div class="dk-tab-wrap">
                                        <table class="dk-tab av-tab">
                                            <thead>
                                                <tr><th style="width:110px">Nr.</th><th>Avvik</th><th>Prioritet</th><th>Ansvarlig</th><th>Status</th><th></th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var a in avvikViste.Take(_avvikVis))
                                                {
                                                    <tr @key="a.Id" class="av-klikk" @onclick="@(() => Nav.NavigateTo($"/avvik/{a.Id}"))">
                                                        <td class="av-nr"><a href="@($"/avvik/{a.Id}")" @onclick:stopPropagation="true">@a.NummerTekst</a></td>
                                                        <td><b class="hb-tekst">@a.Overskrift</b><small>@a.OpprettetDato.ToString("dd.MM.yyyy")@(a.OpprettetAvBruker is not null ? $" · {a.OpprettetAvBruker.Navn}" : "")</small></td>
                                                        <td><span class="dk-pill @(a.Prioritet == AvvikPrioritet.Hoy ? "dk-rod" : "dk-gra")">@(a.Prioritet switch { AvvikPrioritet.Hoy => "Høy", AvvikPrioritet.Lav => "Lav", _ => "Normal" })</span></td>
                                                        <td>@(a.AnsvarligBruker?.Navn ?? "–")</td>
                                                        <td><span class="dk-pill @AvvikStatusKlasse(a.Status)">@if (a.Status is AvvikStatus.Lukket or AvvikStatus.Godkjent) {<Icon Name="check" />}@a.Status.Visningsnavn()</span></td>
                                                        <td class="av-pil"><Icon Name="chevron-right" /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (avvikViste.Count > _avvikVis)
                                    {
                                        <div class="hb-se">
                                            <button type="button" @onclick="@(() => _avvikVis += 10)">Se mer <Icon Name="chevron-down" /></button>
                                            <small>@(avvikViste.Count - _avvikVis) eldre avvik</small>
                                        </div>
                                    }
                                }
                            }
                        </div>

                        <div class="dk-kort">
                            <div class="dk-hode">
                                <span class="dk-hode-ik av-ik-gul"><Icon Name="bell" /></span>
                                <b>Driftsmeldinger</b>
                                @if (nyeMeldinger > 0)
                                {
                                    <span class="dk-teller">@nyeMeldinger @(nyeMeldinger == 1 ? "ny" : "nye")</span>
                                }
                                else if (_driftsmeldinger.Count > 0)
                                {
                                    <span class="dk-teller">@_driftsmeldinger.Count</span>
                                }
                            </div>
                            @if (_driftsmeldinger.Count == 0)
                            {
                                <div class="dk-tom"><Icon Name="bell" /><span>Ingen driftsmeldinger på denne døren</span></div>
                            }
                            else
                            {
                                <div class="dk-tab-wrap">
                                    <table class="dk-tab av-tab">
                                        <thead>
                                            <tr><th style="width:150px">Dato</th><th>Melding</th><th>Kategori</th><th>Meldt av</th><th>Status</th><th></th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in _driftsmeldinger.Take(_driftVis))
                                            {
                                                <tr @key="m.Id" class="av-klikk" @onclick="@(() => Nav.NavigateTo($"/driftsmelding/{m.Id}"))">
                                                    <td class="hb-dato">@m.OpprettetDato.ToString("dd.MM.yyyy") <span>@m.OpprettetDato.ToString("HH:mm")</span></td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(m.Tittel))
                                                        {
                                                            <b class="hb-tekst">@m.Tittel</b>
                                                            <small class="av-tekst">@m.Tekst</small>
                                                        }
                                                        else
                                                        {
                                                            <b class="hb-tekst av-tekst">@m.Tekst</b>
                                                        }
                                                        @if (m.Media.Count > 0)
                                                        {
                                                            <span class="av-mini">
                                                                @foreach (var media in m.Media.Where(x => x.ContentType.StartsWith("image/")).Take(3))
                                                                {
                                                                    <img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="" loading="lazy" />
                                                                }
                                                                @if (m.Media.Any(x => x.ContentType.StartsWith("video/")))
                                                                {
                                                                    <span class="av-video"><Icon Name="play" /></span>
                                                                }
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>@(string.IsNullOrWhiteSpace(m.Kategori) ? "–" : m.Kategori)</td>
                                                    <td>@(m.InnmeldtAvBruker?.Navn ?? "–")</td>
                                                    <td>
                                                        @if (m.Haster && !m.LestAvAnsatt)
                                                        {
                                                            <span class="dk-pill dk-rod">Haster</span>
                                                        }
                                                        else if (!m.LestAvAnsatt)
                                                        {
                                                            <span class="dk-pill dk-gul">Ny</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="dk-pill dk-gra"><Icon Name="check" />Lest</span>
                                                        }
                                                    </td>
                                                    <td class="av-pil"><Icon Name="chevron-right" /></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (_driftsmeldinger.Count > _driftVis)
                                {
                                    <div class="hb-se">
                                        <button type="button" @onclick="@(() => _driftVis += 10)">Se mer <Icon Name="chevron-down" /></button>
                                        <small>@(_driftsmeldinger.Count - _driftVis) eldre @(_driftsmeldinger.Count - _driftVis == 1 ? "melding" : "meldinger")</small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    break;

                case "qr":
                    @* R1: ferdig etikett til venstre (slik den skrives ut), knapper og lenke til høyre. *@
                    var qrLenke = $"{Nav.BaseUri.TrimEnd('/')}/dor/{_dor.Id}";
                    var qrRom = string.Join(" · ", new[] { _dor.Romnr, _dor.DorTil }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    var qrEtasje = string.Join(" · ", new[] { string.IsNullOrWhiteSpace(_dor.Etasje) ? null : $"{_dor.Etasje}. etg", string.IsNullOrWhiteSpace(_dor.Sone) ? null : $"sone {_dor.Sone}" }.Where(x => x is not null));
                    <div class="dk-kort">
                        <div class="dk-hode">
                            <span class="dk-hode-ik"><Icon Name="qr" /></span>
                            <b>QR-kode for @_dor.Dornummer</b>
                        </div>
                        <div class="qk-inn">
                            <div class="qk-etikett">
                                <div class="qk-topp"><b>@_firmanavn</b><span>@_dor.Prosjekt?.Navn</span></div>
                                <div class="qk-midt">
                                    <img src="@($"/dor/{_dor.Id}/qr.png")" alt="QR-kode for dør @_dor.Dornummer" />
                                    <div>
                                        <div class="qk-nr">@_dor.Dornummer</div>
                                        @if (qrRom.Length > 0)
                                        {
                                            <small>@qrRom</small>
                                        }
                                        @if (qrEtasje.Length > 0)
                                        {
                                            <small>@qrEtasje</small>
                                        }
                                    </div>
                                </div>
                                <div class="qk-fot">Skann for service eller for å melde feil</div>
                            </div>
                            <div class="qk-hoyre">
                                <div class="qk-knapper">
                                    <a class="dk-kn dk-kn-p" href="@($"/dor/{_dor.Id}/etikett.pdf")" target="_blank" rel="noopener"><Icon Name="printer" />Skriv ut etikett (PDF)</a>
                                    <a class="dk-kn" href="@($"/dor/{_dor.Id}/qr.png")" download="@($"qr-dor-{_dor.Dornummer}.png")"><Icon Name="download" />Last ned PNG</a>
                                    <button type="button" class="dk-kn" @onclick="@(() => KopierQrLenke(qrLenke))"><Icon Name="link-ikon" />@(_qrLenkeKopiert ? "Kopiert!" : "Kopier lenke")</button>
                                </div>
                                <div class="qk-lenke"><Icon Name="link-ikon" /><code>@qrLenke</code></div>
                                <div class="qk-hint"><Icon Name="help-circle" /><span>Fest etiketten på dørkarmen. Når den skannes, åpnes denne døren for den som har tilgang – vaktmestere med driftslisens kommer rett til «meld feil».</span></div>
                            </div>
                        </div>
                    </div>
                    break;

                default:
                    @* K1: tallene med små ikoner, seksjonene som kort med grått hode (ds-e5). *@
                    <div class="ds-tall4 ds-e5-tall">
                        <div>
                            <span class="ds-lbl"><span class="ds-lik ds-lik-bla"><Icon Name="lock" /></span>Beslag montert</span>
                            <b>@montertAntall / @beslagAntall</b>
                            <span class="ds-bar"><i style="width:@(beslagAntall == 0 ? 0 : montertAntall * 100 / beslagAntall)%"></i></span>
                        </div>
                        <div>
                            <span class="ds-lbl"><span class="ds-lik ds-lik-gronn"><Icon Name="shield" /></span>Garanti</span>
                            @if (_dor.Prosjekt?.OverlevertDato is null)
                            {
                                <b>Ikke startet</b><small>starter ved overlevering</small>
                            }
                            else if (lengstGaranti is null)
                            {
                                <b>-</b><small>ingen garantitid på beslag</small>
                            }
                            else
                            {
                                <b>til @lengstGaranti.UtlopsDato!.Value.Year</b><small>@lengstGaranti.ComponentNavn</small>
                            }
                        </div>
                        <div>
                            <span class="ds-lbl"><span class="ds-lik ds-lik-rod"><Icon Name="alert-triangle" /></span>Åpne avvik</span>
                            <b class="@(apneAvvik > 0 ? "ds-rod" : "")">@apneAvvik</b>
                            <small>@(_avvik.FirstOrDefault(a => a.Status == AvvikStatus.Apent)?.Beskrivelse ?? "ingen åpne")</small>
                        </div>
                        <div>
                            <span class="ds-lbl"><span class="ds-lik"><Icon Name="clock" /></span>Sist oppdatert</span>
                            <b>@((_dor.OppdatertDato ?? _dor.OpprettetDato).ToString("dd.MM"))</b>
                            <small>@(_dor.OppdatertAvBruker?.Navn ?? $"opprettet {_dor.OpprettetDato:dd.MM.yyyy}")</small>
                        </div>
                    </div>

                    <div class="ds-to ds-e5">
                        <div class="ds-kol">
                            @* P3: spesifikasjonen som fliser med ikon; dørfunksjoner som én linje når det ikke er noen. *@
                            <div class="ds-seksjon">
                                <h4>Spesifikasjon <button type="button" @onclick="@(() => VelgFane("detaljer"))">Rediger →</button></h4>
                                <div class="ds-fliser">
                                    @SpecFlis("map-pin", "Rom", string.IsNullOrWhiteSpace(_dor.Romnr) ? null : (string.IsNullOrWhiteSpace(_dor.DorTil) ? _dor.Romnr : $"{_dor.Romnr} · {_dor.DorTil}"))
                                    @SpecFlis("grid", "Etasje / sone", string.IsNullOrWhiteSpace(_dor.Etasje) && string.IsNullOrWhiteSpace(_dor.Sone) ? null : $"{(_dor.Etasje ?? "-")} · {(_dor.Sone ?? "-")}")
                                    @SpecFlis("alert-triangle", "Brannklasse", _dor.Brann, rod: true)
                                    @SpecFlis("door", "Dørtype", _dor.Dortype)
                                    @SpecFlis("maximize", "Mål (B × H)", _dor.BxH)
                                    @SpecFlis("bell", "Lydkrav", _dor.Lyd)
                                </div>
                                @if (_dor.Funksjoner.Count == 0)
                                {
                                    <div class="ds-funklinje"><Icon Name="list" />Ingen dørfunksjoner registrert<button type="button" @onclick="@(() => VelgFane("detaljer"))">+ Legg til</button></div>
                                }
                                else
                                {
                                    <div class="ds-chips ds-funkchips">
                                        @foreach (var f in _dor.Funksjoner)
                                        {
                                            <span class="ds-fchip">@f.Navn</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="ds-seksjon">
                                <h4><span>Beslag @if (beslagAntall > 0) {<span class="ds-teller">@montertAntall av @beslagAntall montert</span><span class="ds-minibar"><i style="width:@(montertAntall * 100 / beslagAntall)%"></i></span>}</span><button type="button" @onclick="@(() => VelgFane("beslag"))">Beslag-fanen →</button></h4>
                                @if (beslagAntall == 0)
                                {
                                    <p class="list-empty">Ingen beslag registrert.</p>
                                }
                                else
                                {
                                    <div class="ds-liste">
                                        @{ var alleBeslag = _dor.Komponenter.ToList(); }
                                        @foreach (var dk in _visAlleBeslag ? alleBeslag : alleBeslag.Take(5))
                                        {
                                            <div @key="dk.ComponentId" class="ds-lr">
                                                <span class="ds-vbilde"><Icon Name="tool" /><img src="@($"/komponent/{dk.ComponentId}/bilde?w=80")" alt="" loading="lazy" onerror="this.style.display='none'" /></span>
                                                <div><b>@dk.Component?.Navn</b><small>@(string.IsNullOrWhiteSpace(dk.Component?.Produktkode) ? "" : dk.Component!.Produktkode + " · ")@dk.Antall @dk.Enhet</small></div>
                                                @if (dk.Montert)
                                                {
                                                    <span class="ds-status ds-status-ok"><Icon Name="check" />Montert @(dk.MontertAvBruker?.Initialer) @(dk.MontertDato?.ToString("dd.MM"))</span>
                                                }
                                                else
                                                {
                                                    <span class="ds-status ds-status-ikke">Ikke montert</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (alleBeslag.Count > 5)
                                    {
                                        <div class="ds-flere"><button type="button" @onclick="@(() => _visAlleBeslag = !_visAlleBeslag)">@(_visAlleBeslag ? "Vis færre" : $"Vis alle {alleBeslag.Count} beslag")</button></div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="ds-kol">
                            @if (_dor.Plantegning is { } tegning && tegning.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                            {
                                @* P3: hvor døren er - tegningen med døren markert. *@
                                <div class="ds-seksjon">
                                    <h4>Plassering <a href="@($"/plantegning/{tegning.Id}")">Åpne tegning →</a></h4>
                                    <div class="ds-plan">
                                        <img src="@($"/plantegningbilde/{tegning.Id}")" alt="@tegning.Navn" loading="lazy" />
                                        @if (_dor.PosX.HasValue && _dor.PosY.HasValue)
                                        {
                                            <span class="ds-plan-pin" style="left:@(_dor.PosX.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(_dor.PosY.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%">@_dor.Dornummer</span>
                                        }
                                    </div>
                                    <div class="ds-plan-fot">@tegning.Navn@(string.IsNullOrWhiteSpace(_dor.DorTil) ? "" : $" · {_dor.DorTil}")</div>
                                </div>
                            }
                            <div class="ds-seksjon">
                                <h4><span>Siste hendelser @if (historikk.Count > 0) {<span class="ds-teller">@historikk.Count</span>}</span><button type="button" @onclick="@(() => VelgFane("logg"))">Historikk-fanen →</button></h4>
                                @if (historikk.Count == 0)
                                {
                                    <p class="list-empty">Ingen historikk registrert ennå.</p>
                                }
                                else
                                {
                                    <div>
                                        @foreach (var h in _visAlleHendelser ? historikk : historikk.Take(3))
                                        {
                                            @HistorikkLinje(h)
                                        }
                                    </div>
                                    @if (historikk.Count > 3)
                                    {
                                        <div class="ds-flere"><button type="button" @onclick="@(() => _visAlleHendelser = !_visAlleHendelser)">@(_visAlleHendelser ? "Vis færre" : $"Vis alle {historikk.Count} hendelser")</button></div>
                                    }
                                }
                            </div>
                            <div class="ds-seksjon">
                                <h4>Bilder <button type="button" @onclick="@(() => VelgFane("logg"))">Alle →</button></h4>
                                <div class="ds-bilder">
                                    @foreach (var m in _media.Take(4))
                                    {
                                        @MediaFlis(m)
                                    }
                                    <button type="button" class="ds-bilde ds-bilde-ny" @onclick="@(() => VelgFane("logg"))">+ Last opp</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;
            }
        </div>
    </div>

    @if (_visMeldAvvik)
    {
        <MeldAvvikDialog ProsjektId="_dor.ProsjektId" DorId="_dor.Id" OnLukk="@(() => _visMeldAvvik = false)" OnMeldt="AvvikMeldt" />
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Embed { get; set; }
    [SupplyParameterFromQuery(Name = "ce")] public int? ApneCeId { get; set; }
    [SupplyParameterFromQuery(Name = "rediger")] public bool? ApneCeRedigerbar { get; set; }
    [SupplyParameterFromQuery(Name = "ny")] public bool? StartNyCe { get; set; }

    // Brukes når dørsiden vises i samme vindu som døren (prosjekt/plantegning)
    // i stedet for som egen side.
    [Parameter] public bool IModal { get; set; }
    [Parameter] public EventCallback OnTilbake { get; set; }
    [Parameter] public EventCallback OnLukk { get; set; }
    [Parameter] public EventCallback OnForrige { get; set; }
    [Parameter] public EventCallback OnNeste { get; set; }
    [Parameter] public string? ForrigeNavn { get; set; }
    [Parameter] public string? NesteNavn { get; set; }

    // Når dørsiden er selve dørvinduet i prosjektet/plantegningen: fanene
    // Detaljer og Beslag viser redigeringen fra DorRedigering.
    [Parameter] public bool MedRedigering { get; set; }
    [Parameter] public List<Dor> AlleDorer { get; set; } = [];
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnUnplaced { get; set; }
    [Parameter] public EventCallback<List<Dor>> OnCloned { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private async Task VelgFane(string fane)
    {
        // Etter redigering i Detaljer/Beslag hentes tallene i de andre fanene på nytt.
        if (MedRedigering && _fane is "detaljer" or "beslag" && fane != _fane)
        {
            _fane = fane;
            await LastAsync();
            return;
        }

        _fane = fane;
    }

    // Ny dør åpnes på Detaljer, ellers Oversikt.
    [Parameter] public string? StartFane { get; set; }

    private string _fane = "oversikt";
    private int? _lastetId;

    private static string CeStatusKlasse(CeGodkjenningStatus status) => status switch
    {
        CeGodkjenningStatus.Godkjent => "dk-gronn",
        CeGodkjenningStatus.TilGjennomgang => "dk-gul",
        CeGodkjenningStatus.Avvist => "dk-rod",
        _ => "dk-bla"
    };

    private string FaneKlasse(string fane) => _fane == fane ? "ds-fane ds-fane-aktiv" : "ds-fane";

    // K1: Oversikt viser de 5 første beslagene, resten bak «Vis alle».
    private bool _visAlleBeslag;
    private bool _visAlleHendelser;

    private RenderFragment SpecFlis(string ikon, string navn, string? verdi, bool rod = false) => __builder =>
    {
        var tom = string.IsNullOrWhiteSpace(verdi) || verdi.Trim() == "-";
        <div class="ds-flis @(tom ? "ds-flis-tom" : rod ? "ds-flis-rod" : "")">
            <i><Icon Name="@ikon" /></i>
            <span><small>@navn</small><b>@(tom ? "Ikke satt" : verdi)</b></span>
        </div>
    };

    private static MarkupString SpecVerdi(string? verdi) =>
        string.IsNullOrWhiteSpace(verdi) || verdi.Trim() == "-"
            ? new MarkupString("<span class=\"ds-ikke-satt\">Ikke satt</span>")
            : new MarkupString(System.Net.WebUtility.HtmlEncode(verdi));

    private RenderFragment HistorikkLinje(HistorikkRad h) =>
        @<div class="ds-tli">
            <span class="ds-tli-ik ds-tli-@h.Type"><Icon Name="@(h.Type switch { "Avvik" => "alert", "Driftsmelding" => "bell", _ => "edit" })" /></span>
            <div><b>@h.Tekst</b><small>@h.Type · @h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</small></div>
        </div>;

    private RenderFragment MediaFlis(DorMedia m) =>
        @<div @key="m.Id" class="ds-bilde">
            @if (m.ContentType.StartsWith("video/"))
            {
                <video controls src="@($"/dormedia/{m.Id}")"></video>
            }
            else
            {
                <img src="@($"/dormedia/{m.Id}")" alt="@m.Filnavn" />
            }
            <span class="ds-bilde-merke">@m.Tidspunkt.Visningsnavn() · @m.OpprettetDato.ToString("dd.MM")</span>
            <button type="button" class="ds-bilde-fjern" title="Slett" @onclick="@(() => SlettMedia(m))"><Icon Name="x" /></button>
        </div>;
    private bool _apenCeIdInitFraQuery;
    private bool _apenCeRedigerbar;
    private bool _startNyCeInitFraQuery;

    private sealed class SylinderRad
    {
        public int ComponentId { get; set; }
        public string Navn { get; set; } = "";
        public string SylMrk { get; set; } = "-";
        public List<string> Nokler { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Dor? _dor;
    private bool _notFound;
    private List<SylinderRad> _sylinderRader = [];
    private List<DorMedia> _media = [];
    private List<Avvik> _avvik = [];
    private List<Driftsmelding> _driftsmeldinger = [];
    private List<DorHendelse> _dorHendelser = [];
    private List<KoblingsSkjema> _prinsippskisser = [];
    private string _nyPrinsippskisseNavn = "";
    private const int PrinsippskisseKategoriId = 4;

    private sealed class HistorikkRad
    {
        public required string Type { get; set; }
        public required int Id { get; set; }
        public required DateTime Tidspunkt { get; set; }
        public required string Tekst { get; set; }
        // G1: teksten uten initialer og hvem som gjorde det, til historikktabellen.
        public string Rentekst { get; set; } = "";
        public string? UtfortAv { get; set; }
    }

    // G1: historikken viser de nyeste først, 5 om gangen ved «Se mer», og kan filtreres på type.
    private const int HistorikkStart = 5;
    private int _histVis = HistorikkStart;
    private string? _histFilter;

    // R1: firmanavnet på etiketten og «Kopier lenke».
    private string _firmanavn = "";
    private bool _qrLenkeKopiert;

    private async Task KopierQrLenke(string lenke)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", lenke);
            _qrLenkeKopiert = true;
        }
        catch (JSException)
        {
            // Utklippstavlen kan være sperret av nettleseren - lenken står synlig under knappene.
        }
    }

    // A1: avvik og driftsmeldinger, nyeste først, 5 om gangen.
    private const int ListeStart = 5;
    private int _avvikVis = ListeStart;
    private int _driftVis = ListeStart;
    private bool _avvikKunApne = true;

