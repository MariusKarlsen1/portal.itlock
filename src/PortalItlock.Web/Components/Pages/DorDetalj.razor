    private List<HistorikkRad> HistorikkRader =>
        _dorHendelser.Select(h => new HistorikkRad { Type = "Endring", Id = h.Id, Tidspunkt = h.Tidspunkt, Tekst = h.Beskrivelse + (h.UtfortAvBruker is not null ? $" ({h.UtfortAvBruker.Initialer})" : ""), Rentekst = h.Beskrivelse, UtfortAv = h.UtfortAvBruker?.Navn })
            .Concat(_avvik.Select(a => new HistorikkRad { Type = "Avvik", Id = a.Id, Tidspunkt = a.OpprettetDato, Tekst = a.Beskrivelse, Rentekst = a.Beskrivelse, UtfortAv = a.OpprettetAvBruker?.Navn }))
            .Concat(_driftsmeldinger.Select(m => new HistorikkRad { Type = "Driftsmelding", Id = m.Id, Tidspunkt = m.OpprettetDato, Tekst = m.Tekst, Rentekst = m.Tekst, UtfortAv = m.InnmeldtAvBruker?.Navn }))
            .OrderByDescending(h => h.Tidspunkt)
            .ToList();
    private List<CeGodkjenning> _ceGodkjenninger = [];
    private bool _harAutomatikk;
    private int? _apenCeId;
    private DorMediaTidspunkt _nyMediaTidspunkt = DorMediaTidspunkt.For;
    private string? _mediaFeil;
    private bool _visMeldAvvik;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    protected override async Task OnParametersSetAsync()
    {
        // I vinduet rendres siden på nytt hver gang forelderen gjør det - last
        // bare inn på nytt når det er en annen dør.
        if (_lastetId == Id)
        {
            return;
        }

        _lastetId = Id;
        _fane = StartFane ?? "oversikt";
        _qrLenkeKopiert = false;
        _firmanavn = RapportProfil.Fra(TenantContext.Current).Navn;
        _histVis = HistorikkStart;
        _histFilter = null;
        _avvikVis = ListeStart;
        _driftVis = ListeStart;
        _avvikKunApne = true;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _dor = await Db.Dorer
            .Include(d => d.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(d => d.DorIdMal)
            .Include(d => d.Plantegning)
            .Include(d => d.Funksjoner)
            .Include(d => d.MontertAvBruker)
            .Include(d => d.OppdatertAvBruker)
            .Include(d => d.Komponenter).ThenInclude(k => k.Component).ThenInclude(c => c!.Type)
            .Include(d => d.Komponenter).ThenInclude(k => k.MontertAvBruker)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (_dor is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;

        if (!_apenCeIdInitFraQuery)
        {
            _apenCeIdInitFraQuery = true;
            if (ApneCeId.HasValue)
            {
                _apenCeId = ApneCeId.Value;
                _apenCeRedigerbar = ApneCeRedigerbar == true;
            }
        }

        _harAutomatikk = _dor.Komponenter.Any(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.DorAutomatikk);
        _ceGodkjenninger = await Db.CeGodkjenninger
            .Where(c => c.DorId == Id)
            .Include(c => c.Media)
            .Include(c => c.OpprettetAvBruker)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();

        if (!_startNyCeInitFraQuery)
        {
            _startNyCeInitFraQuery = true;
            if (StartNyCe == true && _apenCeId is null)
            {
                await StartCeGodkjenning();
            }
        }

        // Uten selve filinnholdet - bildene/videoene hentes via /dormedia/{id}, og
        // å laste alle filene her gjorde dørvinduet tregt å åpne.
        _media = await Db.DorMedia.AsNoTracking().Where(m => m.DorId == Id).OrderByDescending(m => m.OpprettetDato)
            .Select(m => new DorMedia { Id = m.Id, DorId = m.DorId, Data = Array.Empty<byte>(), ContentType = m.ContentType, Filnavn = m.Filnavn, Tidspunkt = m.Tidspunkt, OpprettetDato = m.OpprettetDato })
            .ToListAsync();
        _avvik = await Db.Avvik.Where(a => a.DorId == Id).Include(a => a.OpprettetAvBruker).Include(a => a.AnsvarligBruker)
            .OrderByDescending(a => a.OpprettetDato).ToListAsync();

        _dorHendelser = await Db.DorHendelser.Where(h => h.DorId == Id).Include(h => h.UtfortAvBruker)
            .OrderByDescending(h => h.Tidspunkt).ToListAsync();

        _driftsmeldinger = await Db.Driftsmeldinger.Where(m => m.DorId == Id)
            .Include(m => m.InnmeldtAvBruker).Include(m => m.Media)
            .OrderByDescending(m => m.OpprettetDato).ToListAsync();

        _prinsippskisser = await Db.KoblingsSkjemaer.Where(s => s.DorId == Id)
            .Include(s => s.Symboler).Include(s => s.Streker)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato).ToListAsync();

        var uleste = _driftsmeldinger.Where(m => !m.LestAvAnsatt).ToList();
        if (uleste.Count > 0)
        {
            var uleseIder = uleste.Select(m => m.Id).ToList();
            await Db.Driftsmeldinger.Where(m => uleseIder.Contains(m.Id))
                .ExecuteUpdateAsync(s => s.SetProperty(m => m.LestAvAnsatt, true).SetProperty(m => m.LestDato, DateTime.Now));
        }

        // Ett samlet oppslag for alle avvik i stedet for ett DB-kall per avvik
        // (N+1-mønster, se CODE_REVIEW.md 2026-10-08) - samme data/sortering
        // som før, siden lesestedet (LagredePdfListe) allerede bruker
        // GetValueOrDefault(id, []) for avvik uten lagrede PDF-er.

        var sylinderKomponenter = _dor.Komponenter.Where(k => k.Component?.ErSylinder == true).ToList();
        var componentIder = sylinderKomponenter.Select(k => k.ComponentId).ToList();

        var krysser = await Db.NokkelSylindere
            .Where(ns => ns.DorId == Id && componentIder.Contains(ns.ComponentId))
            .Include(ns => ns.Nokkel)
            .ToListAsync();

        // Syl.mrk-nummeret følger samme rekkefølge som i låsplan-matrisen/PDF-en for hele prosjektet.
        var alleSylinderKomponenter = await Db.DorKomponenter
            .Where(k => k.Dor!.ProsjektId == _dor.ProsjektId && k.Component!.ErSylinder)
            .Include(k => k.Dor)
            .OrderBy(k => k.Dor!.Dornummer)
            .ToListAsync();

        var sylMrkPerComponent = new Dictionary<int, string>();
        var sylNummer = 0;
        foreach (var dk in alleSylinderKomponenter)
        {
            sylNummer++;
            if (dk.DorId == Id)
            {
                sylMrkPerComponent[dk.ComponentId] = sylNummer.ToString();
            }
        }

        _sylinderRader = sylinderKomponenter.Select(k => new SylinderRad
        {
            ComponentId = k.ComponentId,
            Navn = k.Component!.Navn,
            SylMrk = sylMrkPerComponent.TryGetValue(k.ComponentId, out var mrk) ? mrk : "-",
            Nokler = krysser.Where(ns => ns.ComponentId == k.ComponentId)
                .Select(ns => ns.Nokkel!.Merking ?? ns.Nokkel!.Navn)
                .ToList()
        }).ToList();
    }

    private async Task OpprettPrinsippskisse()
    {
        var navn = _nyPrinsippskisseNavn.Trim();
        if (navn.Length == 0)
        {
            navn = $"Prinsippskisse - dør {_dor!.Dornummer}";
        }

        var skjema = new KoblingsSkjema { KategoriId = PrinsippskisseKategoriId, DorId = Id, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        GenererSymbolerFraBestykning(skjema.Id);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    // Autogenererer en startskisse ut fra dørens bestykning, i samme stil som
    // de håndtegnede rørførings-/koblingsskissene i dørmiljø-biblioteket:
    // hvert produkt som en utfylt, merket boks, med en stiplet linje inn mot
    // døren i midten (tilsvarer "Koblingsnode"-mønsteret der). Komponenter
    // fordeles i kolonner etter Plassering (Hengselside/Karmside) - uten
    // registrert plassering havner de på den korteste kolonnen slik at alt
    // vises. Dette er kun et startpunkt - alt kan flyttes/omformes/slettes
    // videre i editoren.
    private void GenererSymbolerFraBestykning(int skjemaId)
    {
        const double dorX = 42, dorY = 8, dorBredde = 16, dorHoyde = 84;

        Db.KoblingsSymboler.Add(new KoblingsSymbol
        {
            KoblingsSkjemaId = skjemaId,
            ElementType = KoblingsElementType.Tekstboks,
            Tekst = $"Dør {_dor!.Dornummer}",
            Farge = "#292927",
            FontStorrelse = 13,
            PosX = 38,
            PosY = 1,
            Bredde = 24,
            Hoyde = 5,
            ZIndex = 2
        });
        Db.KoblingsSymboler.Add(new KoblingsSymbol
        {
            KoblingsSkjemaId = skjemaId,
            ElementType = KoblingsElementType.Rektangel,
            Farge = "#292927",
            Strokbredde = 2,
            PosX = dorX,
            PosY = dorY,
            Bredde = dorBredde,
            Hoyde = dorHoyde,
            ZIndex = 0
        });

        var hengsel = _dor.Komponenter.Where(k => k.Plassering == DorKomponentPlassering.Hengselside).ToList();
        var karm = _dor.Komponenter.Where(k => k.Plassering == DorKomponentPlassering.Karmside).ToList();
        foreach (var k in _dor.Komponenter.Where(k => k.Plassering is null))
        {
            (hengsel.Count <= karm.Count ? hengsel : karm).Add(k);
        }

        LeggSymbolKolonne(skjemaId, hengsel, startX: 3, koblesTilX: dorX, dorY: dorY, dorHoyde: dorHoyde);
        LeggSymbolKolonne(skjemaId, karm, startX: 65, koblesTilX: dorX + dorBredde, dorY: dorY, dorHoyde: dorHoyde);
    }

    // koblesTilX er x-koordinaten på dørens kant boksene skal trekke en
    // stiplet linje til (venstre kant for hengselside, høyre kant for
    // karmside), slik at alle komponentene visuelt peker inn mot døren -
    // samme "comb"-mønster som i de håndtegnede referanseskissene.
    private void LeggSymbolKolonne(int skjemaId, List<DorKomponent> komponenter, double startX, double koblesTilX, double dorY, double dorHoyde)
    {
        if (komponenter.Count == 0)
        {
            return;
        }

        var startY = dorY + 2;
        var sluttY = dorY + dorHoyde - 2;
        var radHoyde = Math.Min(10, (sluttY - startY) / komponenter.Count);
        const double boksBredde = 30;

        var y = startY;
        foreach (var k in komponenter)
        {
            var boksHoyde = Math.Max(radHoyde - 2, 4);
            var navn = k.Component?.Navn ?? "Ukjent komponent";
            if (k.Antall > 1)
            {
                navn += $" ({k.Antall} stk)";
            }

            Db.KoblingsSymboler.Add(new KoblingsSymbol
            {
                KoblingsSkjemaId = skjemaId,
                ElementType = KoblingsElementType.Rektangel,
                Navn = navn,
                Farge = "#835e41",
                Strokbredde = 1,
                Fylt = true,
                PosX = startX,
                PosY = y,
                Bredde = boksBredde,
                Hoyde = boksHoyde,
                ZIndex = 1
            });

            var linjeY = y + boksHoyde / 2;
            var boksKantX = startX < koblesTilX ? startX + boksBredde : startX;
            var punkter = JsonSerializer.Serialize(new[]
            {
                new KoblingsStrekPunkt { X = boksKantX, Y = linjeY },
                new KoblingsStrekPunkt { X = koblesTilX, Y = linjeY }
            });
            Db.KoblingsStreker.Add(new KoblingsStrek
            {
                KoblingsSkjemaId = skjemaId,
                PunkterJson = punkter,
                Farge = "#835e41",
                Tykkelse = 1,
                Stiplet = true
            });

            y += radHoyde;
        }
    }

    private async Task FjernBeslag(DorKomponent dk)
    {
        Db.DorHendelser.Add(new DorHendelse
        {
            DorId = Id,
            Beskrivelse = $"Fjernet {dk.Component?.Navn}",
            UtfortAvBrukerId = _naverendeBrukerId
        });

        Db.DorKomponenter.Remove(dk);
        _dor!.Komponenter.Remove(dk);

        var krysser = await Db.NokkelSylindere.Where(ns => ns.DorId == Id && ns.ComponentId == dk.ComponentId).ToListAsync();
        Db.NokkelSylindere.RemoveRange(krysser);

        await Db.SaveChangesAsync();
        await LastAsync();
    }

    private async Task LastOppMedia(InputFileChangeEventArgs e)
    {
        _mediaFeil = null;
        var file = e.File;

        if (file.Size > 50_000_000)
        {
            _mediaFeil = $"\"{file.Name}\" er for stor (maks 50 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var media = new DorMedia
        {
            DorId = Id,
            Data = buffer.ToArray(),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            Filnavn = file.Name,
            Tidspunkt = _nyMediaTidspunkt
        };
        Db.DorMedia.Add(media);
        await Db.SaveChangesAsync();

        _media.Insert(0, media);
    }

    private async Task SlettMedia(DorMedia media)
    {
        var entitet = await Db.DorMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.DorMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _media.Remove(media);
    }

    // Nytt avvik fra «Meld avvik»: øverst i listen. E-posten til ansvarlig sendes ved lagring.
    private async Task AvvikMeldt(Avvik avvik)
    {
        _visMeldAvvik = false;
        avvik.OpprettetAvBruker = avvik.OpprettetAvBrukerId is int b ? await Db.Brukere.FindAsync(b) : null;
        _avvik.Insert(0, avvik);
    }

    private async Task StartCeGodkjenning()
    {
        if (_dor is null)
        {
            return;
        }

        var nummer = await CeGodkjenningFabrikk.NesteNummerAsync(Db);
        var ce = CeGodkjenningFabrikk.ForDor(_dor, nummer, _naverendeBrukerId);

        Db.CeGodkjenninger.Add(ce);
        await Db.SaveChangesAsync();

        _apenCeId = ce.Id;
    }

    private async Task LukkCePanel()
    {
        _apenCeId = null;
        _ceGodkjenninger = await Db.CeGodkjenninger
            .Where(c => c.DorId == Id)
            .Include(c => c.Media)
            .Include(c => c.OpprettetAvBruker)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();
    }

