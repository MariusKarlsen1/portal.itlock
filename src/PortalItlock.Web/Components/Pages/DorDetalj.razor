@page "/dor/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject AvvikPdfService AvvikPdfService
@inject LagretPdfService LagretPdfService

<PageTitle>Dør @(_dor?.Dornummer)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke døren. Den kan være slettet.</p>
}
else if (_dor is null)
{
    <p>Laster...</p>
}
else
{
    @if (!Embed)
    {
        <a class="back-link" href="@($"/prosjekter/{_dor.ProsjektId}")"><Icon Name="arrow-left" />Tilbake til prosjektet</a>
    }

    <div class="id-kort">
        <div class="id-topprad">
            <div class="id-navn">
                <span class="id-ikon"><Icon Name="folder" /></span>
                <div>
                    <h1>Dør @_dor.Dornummer</h1>
                    <p class="id-sub">@_dor.Prosjekt?.Navn@(string.IsNullOrWhiteSpace(_dor.DorTil) ? "" : $" · {_dor.DorTil}")</p>
                </div>
            </div>
            <div class="id-status-wrap">
                <StatusPill Tekst="@_dor.Status.Visningsnavn()" Ikon="@_dor.Status.PillIkon()" Farge="@_dor.Status.PillFarge()" />
                @if (_dor.MontertDato.HasValue)
                {
                    <span class="status-dato">
                        @_dor.MontertDato.Value.ToString("dd.MM.yyyy HH:mm") @(_dor.MontertAvBruker is not null ? $"({_dor.MontertAvBruker.Initialer})" : "")
                    </span>
                }
            </div>
        </div>
        <div class="id-specs">
            <div><div class="id-spec-lbl">Romnr</div><div class="id-spec-val">@(_dor.Romnr ?? "-")</div></div>
            <div><div class="id-spec-lbl">Etasje</div><div class="id-spec-val">@(_dor.Etasje ?? "-")</div></div>
            <div><div class="id-spec-lbl">Sone</div><div class="id-spec-val">@(_dor.Sone ?? "-")</div></div>
            <div><div class="id-spec-lbl">Dørtype</div><div class="id-spec-val">@(_dor.Dortype ?? "-")</div></div>
            <div><div class="id-spec-lbl">B x H</div><div class="id-spec-val">@(_dor.BxH ?? "-")</div></div>
            <div><div class="id-spec-lbl">Brann</div><div class="id-spec-val">@(_dor.Brann ?? "-")</div></div>
            <div><div class="id-spec-lbl">Lyd</div><div class="id-spec-val">@(_dor.Lyd ?? "-")</div></div>
            <div>
                <div class="id-spec-lbl">Sist oppdatert</div>
                <div class="id-spec-val id-spec-val-liten">
                    @if (_dor.OppdatertDato.HasValue)
                    {
                        @_dor.OppdatertDato.Value.ToString("dd.MM.yyyy HH:mm")
                        @(_dor.OppdatertAvBruker is not null ? $" ({_dor.OppdatertAvBruker.Initialer})" : "")
                    }
                    else
                    {
                        <text>-</text>
                    }
                </div>
            </div>
        </div>
        @if (_dor.Funksjoner.Count > 0)
        {
            <div class="funksjon-chips">
                @foreach (var f in _dor.Funksjoner)
                {
                    <span class="funksjon-chip">@f.Navn</span>
                }
            </div>
        }
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="shield" /></span>
            <h2>Garanti</h2>
        </div>
        @{
            var garantiLinjer = GarantiBeregning.Linjer(_dor, _dor.Prosjekt?.OverlevertDato);
        }
        <div class="garanti-boks">
            <Icon Name="clock" />
            @if (_dor.Prosjekt?.OverlevertDato is null)
            {
                <span class="garanti-info">Nedtelling starter når prosjektet settes til "Overlevert"</span>
            }
            else if (garantiLinjer.Count == 0)
            {
                <span class="garanti-info">Ingen beslag med registrert garantitid på produktet</span>
            }
            else
            {
                <ul class="garanti-liste">
                    @foreach (var linje in garantiLinjer)
                    {
                        <li>
                            @linje.ComponentNavn
                            @if (linje.UtlopsDato.HasValue)
                            {
                                <span class="@(linje.UtlopsDato.Value.Date < DateTime.Today ? "garanti-utlopt" : "garanti-ok")">
                                    @(linje.UtlopsDato.Value.Date < DateTime.Today ? $"Utløp {linje.UtlopsDato.Value:dd.MM.yyyy}" : $"Til {linje.UtlopsDato.Value:dd.MM.yyyy}")
                                </span>
                            }
                            else
                            {
                                <span class="garanti-info">Ingen garantitid satt på produktet</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        <p class="id-opprettet">Opprettet @_dor.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</p>
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="clock" /></span>
            <h2>Historikk</h2>
        </div>
        <p class="section-hint">Endringer, avvik og driftsmeldinger på denne døren, nyest først.</p>

        @if (HistorikkRader.Count == 0)
        {
            <p class="list-empty">Ingen historikk registrert ennå.</p>
        }
        else
        {
            <ul class="historikk-liste">
                @foreach (var h in HistorikkRader)
                {
                    <li @key="@($"{h.Type}-{h.Id}")" class="historikk-rad">
                        <span class="historikk-type historikk-type-@h.Type">@h.Type</span>
                        <div class="historikk-tekst-wrap">
                            <span class="historikk-tekst">@h.Tekst</span>
                            <span class="historikk-tidspunkt">@h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="tool" /></span>
            <h2>Beslag</h2>
        </div>
        @if (_dor.Komponenter.Count == 0)
        {
            <p class="list-empty">Ingen beslag registrert.</p>
        }
        else
        {
            <div class="tabell-kort">
            <table class="dor-table">
                <thead>
                    <tr><th>Navn</th><th>Antall</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var dk in _dor.Komponenter.ToList())
                    {
                        <tr @key="dk.ComponentId">
                            <td>@dk.Component?.Navn</td>
                            <td>@dk.Antall @dk.Enhet</td>
                            <td>
                                @if (dk.Montert)
                                {
                                    <span class="beslag-status-pill beslag-status-montert">Montert @(dk.MontertDato?.ToString("dd.MM.yyyy HH:mm")) @(dk.MontertAvBruker is not null ? $"({dk.MontertAvBruker.Initialer})" : "")</span>
                                }
                                else
                                {
                                    <span class="beslag-status-pill beslag-status-ikke">Ikke montert</span>
                                }
                            </td>
                            <td><button type="button" class="ikon-btn" title="Fjern beslag" @onclick="@(() => FjernBeslag(dk))"><Icon Name="x" /></button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

    @if (_harAutomatikk)
    {
        <div class="dor-panel">
            <div class="dor-panel-header">
                <span class="dor-panel-ikon"><Icon Name="check-circle" /></span>
                <h2>CE-godkjenning</h2>
            </div>
            @if (_apenCeId is not null)
            {
                <div class="ce-modal-overlay">
                    <div class="ce-modal">
                        <CeGodkjenningPanel Id="_apenCeId.Value" OnClose="LukkCePanel" StartRedigerbar="_apenCeRedigerbar" />
                    </div>
                </div>
            }
            else
            {
                @if (_ceGodkjenninger.Count > 0)
                {
                    <div class="tabell-kort">
                    <table class="dor-table">
                        <thead>
                            <tr><th>Nummer</th><th>Status</th><th>Vilkår</th><th>Gyldig til</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ce in _ceGodkjenninger)
                            {
                                <tr @key="ce.Id">
                                    <td>@ce.Sertifiseringsnummer</td>
                                    <td>@ce.Status.Visningsnavn()</td>
                                    <td>
                                        @if (CeValideringsService.ErGodkjent(ce, _dor.Komponenter))
                                        {
                                            <span class="beslag-status-pill beslag-status-montert">Oppfylt</span>
                                        }
                                        else
                                        {
                                            <span class="beslag-status-pill beslag-status-ikke">Ikke oppfylt</span>
                                        }
                                    </td>
                                    <td>@ce.GyldigTil.ToString("dd.MM.yyyy")</td>
                                    <td><button type="button" class="edit-button" @onclick="@(() => { _apenCeId = ce.Id; _apenCeRedigerbar = false; })">Åpne</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                else
                {
                    <p class="list-empty">Ingen CE-godkjenning startet på denne døren.</p>
                }
                <button type="button" class="add-button" @onclick="StartCeGodkjenning"><Icon Name="plus" />Start CE-godkjenning</button>
            }
        </div>
    }

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="lock" /></span>
            <h2>Låsplan for denne døren</h2>
        </div>
        @if (_sylinderRader.Count == 0)
        {
            <p class="list-empty">Ingen sylindere registrert på denne døren.</p>
        }
        else
        {
            <div class="tabell-kort">
            <table class="dor-table">
                <thead>
                    <tr><th>Syl.mrk</th><th>Sylinder</th><th>Nøkler som åpner</th></tr>
                </thead>
                <tbody>
                    @foreach (var rad in _sylinderRader)
                    {
                        <tr @key="rad.ComponentId">
                            <td>@rad.SylMrk</td>
                            <td>@rad.Navn</td>
                            <td>@(rad.Nokler.Count > 0 ? string.Join(", ", rad.Nokler) : "Ingen registrert")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        <a class="lasplan-lenke" href="@($"/prosjekt/{_dor.ProsjektId}/lasplan")">Åpne full låsplan for prosjektet<Icon Name="arrow-left" /></a>
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="image" /></span>
            <h2>Bilder og video</h2>
        </div>
        <p class="section-hint">Dokumenter tilstand før og etter arbeid på døren.</p>

        <label class="dropzone">
            <span class="dropzone-ikon"><Icon Name="upload" /></span>
            <span class="dropzone-tekst">
                <strong>Last opp bilde eller video</strong>
                <span>Velg om det er «Før» eller «Etter»</span>
            </span>
            <select @bind="_nyMediaTidspunkt">
                <option value="@DorMediaTidspunkt.For">Før</option>
                <option value="@DorMediaTidspunkt.Etter">Etter</option>
            </select>
            <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
        </label>
        @if (!string.IsNullOrEmpty(_mediaFeil))
        {
            <p class="form-error">@_mediaFeil</p>
        }

        @foreach (var gruppe in new[] { DorMediaTidspunkt.For, DorMediaTidspunkt.Etter })
        {
            var bilder = _media.Where(m => m.Tidspunkt == gruppe).ToList();
            <p class="media-gruppe-tittel">@gruppe.Visningsnavn()</p>
            @if (bilder.Count == 0)
            {
                <p class="list-empty">Ingen filer lagt til.</p>
            }
            else
            {
                <div class="media-grid">
                    @foreach (var m in bilder)
                    {
                        <div @key="m.Id" class="media-item">
                            @if (m.ContentType.StartsWith("video/"))
                            {
                                <video controls src="@($"/dormedia/{m.Id}")"></video>
                            }
                            else
                            {
                                <img src="@($"/dormedia/{m.Id}")" alt="@m.Filnavn" />
                            }
                            <button type="button" class="media-fjern-btn" title="Slett" @onclick="@(() => SlettMedia(m))"><Icon Name="x" /></button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="bell" /></span>
            <h2>Driftsmeldinger</h2>
        </div>

        @if (_driftsmeldinger.Count == 0)
        {
            <p class="list-empty">Ingen driftsmeldinger registrert på denne døren.</p>
        }
        else
        {
            @foreach (var m in _driftsmeldinger)
            {
                <div @key="m.Id" class="drift-melding-kort">
                    <p class="drift-melding-meta">@m.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(m.InnmeldtAvBruker is not null ? $"- {m.InnmeldtAvBruker.Navn}" : "")</p>
                    <p class="drift-melding-tekst">@m.Tekst</p>
                    @if (m.Media.Count > 0)
                    {
                        <div class="drift-melding-media">
                            @foreach (var media in m.Media)
                            {
                                @if (media.ContentType.StartsWith("video/"))
                                {
                                    <video controls class="drift-melding-video" src="@($"/driftsmeldingmedia/{media.Id}/fil")"></video>
                                }
                                else
                                {
                                    <a href="@($"/driftsmeldingmedia/{media.Id}/fil")" target="_blank">
                                        <img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="@media.Filnavn" class="drift-melding-bilde" />
                                    </a>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="alert" /></span>
            <h2>Avvik</h2>
        </div>

        @if (_avvik.Count == 0)
        {
            <p class="list-empty">Ingen avvik registrert på denne døren.</p>
        }
        else
        {
            <div class="avvik-liste">
                @foreach (var a in _avvik)
                {
                    <div @key="a.Id" class="avvik-kort">
                        <div class="avvik-header">
                            <span class="avvik-status avvik-status-@a.Status">@a.Status.Visningsnavn()</span>
                            <span class="avvik-dato">@a.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(a.OpprettetAvBruker is not null ? $"({a.OpprettetAvBruker.Initialer})" : "")</span>
                        </div>
                        <p>@a.Beskrivelse</p>

                        <AuthorizeView Roles="Admin,Prosjektleder">
                            <Authorized>
                                @if (a.Status == AvvikStatus.Apent)
                                {
                                    <div class="avvik-prisform">
                                        <textarea @bind="a.UtbedringBeskrivelse" placeholder="Foreslått utbedring (valgfritt)"></textarea>
                                        <input @bind="a.Pris" placeholder="Pris eks. mva" class="price-input" />
                                        <button type="button" class="save-button" @onclick="@(() => LagreAvvikPris(a))">Lagre</button>
                                        <button type="button" class="edit-button" @onclick="@(() => VisAvvikPdf(a.Id))">Forhåndsvis PDF</button>
                                        <button type="button" class="edit-button" disabled="@(!a.Pris.HasValue)" @onclick="@(() => SendTilKunde(a))">Send til kunde</button>
                                    </div>
                                }
                                else
                                {
                                    @if (a.Pris.HasValue)
                                    {
                                        <p><strong>Pris for utbedring:</strong> @a.Pris.Value.ToString("N2", Kultur) kr eks. mva</p>
                                    }
                                    <button type="button" class="edit-button" @onclick="@(() => VisAvvikPdf(a.Id))">Vis PDF</button>
                                }
                            </Authorized>
                        </AuthorizeView>

                        @if (a.Status == AvvikStatus.Godkjent)
                        {
                            <p class="save-success">Godkjent av @a.SignertAvNavn - @a.SignertDato?.ToString("dd.MM.yyyy HH:mm")</p>
                        }

                        <AuthorizeView Roles="Admin,Prosjektleder">
                            <Authorized>
                                <div class="avvik-pdfliste">
                                    <LagredePdfListe Pdfer="@_lagredePdfer.GetValueOrDefault(a.Id, [])" />
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }

        <div class="nytt-avvik-form">
            <textarea @bind="_nyAvvikBeskrivelse" placeholder="Beskriv avviket..."></textarea>
            <button type="button" class="add-button" @onclick="MeldAvvik"><Icon Name="plus" />Meld avvik</button>
        </div>
        @if (!string.IsNullOrEmpty(_avvikFeil))
        {
            <p class="form-error">@_avvikFeil</p>
        }

        <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Avvik" SaveMessage="@_pdfSavedMessage"
                          OnSave="LagreAvvikPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
    </div>

    <div class="dor-panel">
        <div class="dor-panel-header">
            <span class="dor-panel-ikon"><Icon Name="settings" /></span>
            <h2>QR-kode</h2>
        </div>
        <p class="section-hint">Skriv ut og fest på dørkarmen. Skanning åpner denne siden direkte.</p>
        <div class="qr-kort">
            <div class="qr-bilde-wrap">
                <img class="qr-bilde" src="@($"/dor/{_dor.Id}/qr.png")" alt="QR-kode for dør @_dor.Dornummer" />
            </div>
            <div class="qr-tekst">
                <p>Denne QR-koden peker direkte til denne dørsiden.</p>
                <a href="@($"/dor/{_dor.Id}/qr.png")" download="@($"qr-dor-{_dor.Dornummer}.png")" class="add-button">Last ned QR-kode</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Embed { get; set; }
    [SupplyParameterFromQuery(Name = "ce")] public int? ApneCeId { get; set; }
    [SupplyParameterFromQuery(Name = "rediger")] public bool? ApneCeRedigerbar { get; set; }
    private bool _apenCeIdInitFraQuery;
    private bool _apenCeRedigerbar;

    private sealed class SylinderRad
    {
        public int ComponentId { get; set; }
        public string Navn { get; set; } = "";
        public string SylMrk { get; set; } = "-";
        public List<string> Nokler { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Dor? _dor;
    private bool _notFound;
    private List<SylinderRad> _sylinderRader = [];
    private List<DorMedia> _media = [];
    private List<Avvik> _avvik = [];
    private List<Driftsmelding> _driftsmeldinger = [];
    private List<DorHendelse> _dorHendelser = [];

    private sealed class HistorikkRad
    {
        public required string Type { get; set; }
        public required int Id { get; set; }
        public required DateTime Tidspunkt { get; set; }
        public required string Tekst { get; set; }
    }

    private List<HistorikkRad> HistorikkRader =>
        _dorHendelser.Select(h => new HistorikkRad { Type = "Endring", Id = h.Id, Tidspunkt = h.Tidspunkt, Tekst = h.Beskrivelse + (h.UtfortAvBruker is not null ? $" ({h.UtfortAvBruker.Initialer})" : "") })
            .Concat(_avvik.Select(a => new HistorikkRad { Type = "Avvik", Id = a.Id, Tidspunkt = a.OpprettetDato, Tekst = a.Beskrivelse }))
            .Concat(_driftsmeldinger.Select(m => new HistorikkRad { Type = "Driftsmelding", Id = m.Id, Tidspunkt = m.OpprettetDato, Tekst = m.Tekst }))
            .OrderByDescending(h => h.Tidspunkt)
            .ToList();
    private List<CeGodkjenning> _ceGodkjenninger = [];
    private bool _harAutomatikk;
    private int? _apenCeId;
    private DorMediaTidspunkt _nyMediaTidspunkt = DorMediaTidspunkt.For;
    private string? _mediaFeil;
    private string _nyAvvikBeskrivelse = "";
    private string? _avvikFeil;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private int? _aktivAvvikId;
    private Dictionary<int, List<LagretPdf>> _lagredePdfer = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _dor = await Db.Dorer
            .Include(d => d.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(d => d.DorIdMal)
            .Include(d => d.Funksjoner)
            .Include(d => d.MontertAvBruker)
            .Include(d => d.OppdatertAvBruker)
            .Include(d => d.Komponenter).ThenInclude(k => k.Component).ThenInclude(c => c!.Type)
            .Include(d => d.Komponenter).ThenInclude(k => k.MontertAvBruker)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (_dor is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;

        if (!_apenCeIdInitFraQuery)
        {
            _apenCeIdInitFraQuery = true;
            if (ApneCeId.HasValue)
            {
                _apenCeId = ApneCeId.Value;
                _apenCeRedigerbar = ApneCeRedigerbar == true;
            }
        }

        _harAutomatikk = _dor.Komponenter.Any(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.DorAutomatikk);
        _ceGodkjenninger = await Db.CeGodkjenninger
            .Where(c => c.DorId == Id)
            .Include(c => c.Media)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();

        _media = await Db.DorMedia.Where(m => m.DorId == Id).OrderByDescending(m => m.OpprettetDato).ToListAsync();
        _avvik = await Db.Avvik.Where(a => a.DorId == Id).Include(a => a.OpprettetAvBruker)
            .OrderByDescending(a => a.OpprettetDato).ToListAsync();

        _dorHendelser = await Db.DorHendelser.Where(h => h.DorId == Id).Include(h => h.UtfortAvBruker)
            .OrderByDescending(h => h.Tidspunkt).ToListAsync();

        _driftsmeldinger = await Db.Driftsmeldinger.Where(m => m.DorId == Id)
            .Include(m => m.InnmeldtAvBruker).Include(m => m.Media)
            .OrderByDescending(m => m.OpprettetDato).ToListAsync();

        var uleste = _driftsmeldinger.Where(m => !m.LestAvAnsatt).ToList();
        if (uleste.Count > 0)
        {
            var uleseIder = uleste.Select(m => m.Id).ToList();
            await Db.Driftsmeldinger.Where(m => uleseIder.Contains(m.Id))
                .ExecuteUpdateAsync(s => s.SetProperty(m => m.LestAvAnsatt, true));
        }

        _lagredePdfer = [];
        foreach (var a in _avvik)
        {
            _lagredePdfer[a.Id] = await LagretPdfService.HentAsync("Avvik", a.Id);
        }

        var sylinderKomponenter = _dor.Komponenter.Where(k => k.Component?.ErSylinder == true).ToList();
        var componentIder = sylinderKomponenter.Select(k => k.ComponentId).ToList();

        var krysser = await Db.NokkelSylindere
            .Where(ns => ns.DorId == Id && componentIder.Contains(ns.ComponentId))
            .Include(ns => ns.Nokkel)
            .ToListAsync();

        // Syl.mrk-nummeret følger samme rekkefølge som i låsplan-matrisen/PDF-en for hele prosjektet.
        var alleSylinderKomponenter = await Db.DorKomponenter
            .Where(k => k.Dor!.ProsjektId == _dor.ProsjektId && k.Component!.ErSylinder)
            .Include(k => k.Dor)
            .OrderBy(k => k.Dor!.Dornummer)
            .ToListAsync();

        var sylMrkPerComponent = new Dictionary<int, string>();
        var sylNummer = 0;
        foreach (var dk in alleSylinderKomponenter)
        {
            sylNummer++;
            if (dk.DorId == Id)
            {
                sylMrkPerComponent[dk.ComponentId] = sylNummer.ToString();
            }
        }

        _sylinderRader = sylinderKomponenter.Select(k => new SylinderRad
        {
            ComponentId = k.ComponentId,
            Navn = k.Component!.Navn,
            SylMrk = sylMrkPerComponent.TryGetValue(k.ComponentId, out var mrk) ? mrk : "-",
            Nokler = krysser.Where(ns => ns.ComponentId == k.ComponentId)
                .Select(ns => ns.Nokkel!.Merking ?? ns.Nokkel!.Navn)
                .ToList()
        }).ToList();
    }

    private async Task FjernBeslag(DorKomponent dk)
    {
        Db.DorHendelser.Add(new DorHendelse
        {
            DorId = Id,
            Beskrivelse = $"Fjernet {dk.Component?.Navn}",
            UtfortAvBrukerId = _naverendeBrukerId
        });

        Db.DorKomponenter.Remove(dk);
        _dor!.Komponenter.Remove(dk);

        var krysser = await Db.NokkelSylindere.Where(ns => ns.DorId == Id && ns.ComponentId == dk.ComponentId).ToListAsync();
        Db.NokkelSylindere.RemoveRange(krysser);

        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task LastOppMedia(InputFileChangeEventArgs e)
    {
        _mediaFeil = null;
        var file = e.File;

        if (file.Size > 50_000_000)
        {
            _mediaFeil = $"\"{file.Name}\" er for stor (maks 50 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var media = new DorMedia
        {
            DorId = Id,
            Data = buffer.ToArray(),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            Filnavn = file.Name,
            Tidspunkt = _nyMediaTidspunkt
        };
        Db.DorMedia.Add(media);
        await Db.SaveChangesAsync();

        _media.Insert(0, media);
    }

    private async Task SlettMedia(DorMedia media)
    {
        var entitet = await Db.DorMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.DorMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _media.Remove(media);
    }

    private async Task MeldAvvik()
    {
        _avvikFeil = null;
        if (string.IsNullOrWhiteSpace(_nyAvvikBeskrivelse))
        {
            _avvikFeil = "Skriv en beskrivelse av avviket.";
            return;
        }

        var avvik = new Avvik
        {
            DorId = Id,
            Beskrivelse = _nyAvvikBeskrivelse.Trim(),
            OpprettetAvBrukerId = _naverendeBrukerId
        };
        Db.Avvik.Add(avvik);
        await Db.SaveChangesAsync();

        avvik.OpprettetAvBruker = _naverendeBrukerId.HasValue ? await Db.Brukere.FindAsync(_naverendeBrukerId.Value) : null;
        _avvik.Insert(0, avvik);
        _nyAvvikBeskrivelse = "";
    }

    private async Task LagreAvvikPris(Avvik avvik)
    {
        var entitet = await Db.Avvik.FindAsync(avvik.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.UtbedringBeskrivelse = string.IsNullOrWhiteSpace(avvik.UtbedringBeskrivelse) ? null : avvik.UtbedringBeskrivelse.Trim();
        entitet.Pris = avvik.Pris;
        await Db.SaveChangesAsync();
    }

    private void VisAvvikPdf(int avvikId)
    {
        _aktivAvvikId = avvikId;
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/avvik/{avvikId}/pdf";
    }

    private async Task LagreAvvikPdf()
    {
        if (_aktivAvvikId is not { } avvikId)
        {
            return;
        }

        var bytes = await AvvikPdfService.GenerateAsync(avvikId);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Avvik", avvikId, $"Avvik - {_dor?.Dornummer} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        if (!_lagredePdfer.TryGetValue(avvikId, out var liste))
        {
            liste = [];
            _lagredePdfer[avvikId] = liste;
        }
        liste.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

