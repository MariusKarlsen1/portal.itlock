@page "/nyheter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Nyheter</PageTitle>

<h1>Nyheter</h1>
<p class="section-hint">Genereres automatisk hver gang det pushes en endring til portalen. Den nyeste vises som en "Hva er nytt"-boks på forsiden for alle brukere, til de lukker den.</p>

@if (_nyheter.Count == 0)
{
    <p class="list-empty">Ingen oppdateringer registrert ennå.</p>
}
else
{
    <ul class="nyhet-liste">
        @foreach (var n in _nyheter)
        {
            <li @key="n.Id" class="nyhet-rad">
                <div class="nyhet-header">
                    <strong>@n.Tittel</strong>
                    <span class="nyhet-dato">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                    <button type="button" class="remove-button" @onclick="@(() => SlettNyhet(n))">Slett</button>
                </div>
                <p class="nyhet-tekst">@n.Innhold</p>
            </li>
        }
    </ul>
}

@code {
    private List<Nyhet> _nyheter = [];

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _nyheter = await Db.Nyheter.OrderByDescending(n => n.OpprettetDato).ToListAsync();
    }

    private async Task SlettNyhet(Nyhet n)
    {
        Db.Nyheter.Remove(n);
        await Db.SaveChangesAsync();
        _nyheter.Remove(n);
    }
}
