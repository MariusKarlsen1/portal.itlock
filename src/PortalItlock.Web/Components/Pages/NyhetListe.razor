@page "/nyheter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Nyheter</PageTitle>

<h1>Nyheter</h1>
<p class="section-hint">Det som legges inn her vises som en "Hva er nytt"-boks på forsiden for alle brukere, til de lukker den.</p>

<div class="ny-nyhet">
    <h2>Ny nyhet</h2>
    <div class="field-grid">
        <label class="span-2">
            Tittel
            <input @bind="_nyTittel" @bind:event="oninput" placeholder="F.eks. Ny Service modul" />
        </label>
        <label class="span-2">
            Innhold
            <textarea rows="4" @bind="_nyInnhold" placeholder="Hva er nytt eller endret?"></textarea>
        </label>
    </div>
    <div class="form-actions">
        <button type="button" class="add-button" @onclick="OpprettNyhet" disabled="@(string.IsNullOrWhiteSpace(_nyTittel) || string.IsNullOrWhiteSpace(_nyInnhold))">Publiser</button>
    </div>
</div>

@if (_nyheter.Count == 0)
{
    <p class="list-empty">Ingen nyheter publisert ennå.</p>
}
else
{
    <ul class="nyhet-liste">
        @foreach (var n in _nyheter)
        {
            <li @key="n.Id" class="nyhet-rad">
                <div class="nyhet-header">
                    <strong>@n.Tittel</strong>
                    <span class="nyhet-dato">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                    <button type="button" class="remove-button" @onclick="@(() => SlettNyhet(n))">Slett</button>
                </div>
                <p class="nyhet-tekst">@n.Innhold</p>
            </li>
        }
    </ul>
}

@code {
    private List<Nyhet> _nyheter = [];
    private string _nyTittel = "";
    private string _nyInnhold = "";

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _nyheter = await Db.Nyheter.OrderByDescending(n => n.OpprettetDato).ToListAsync();
    }

    private async Task OpprettNyhet()
    {
        if (string.IsNullOrWhiteSpace(_nyTittel) || string.IsNullOrWhiteSpace(_nyInnhold))
        {
            return;
        }

        Db.Nyheter.Add(new Nyhet { Tittel = _nyTittel.Trim(), Innhold = _nyInnhold.Trim() });
        await Db.SaveChangesAsync();

        _nyTittel = "";
        _nyInnhold = "";
        await LastAsync();
    }

    private async Task SlettNyhet(Nyhet n)
    {
        Db.Nyheter.Remove(n);
        await Db.SaveChangesAsync();
        _nyheter.Remove(n);
    }
}
