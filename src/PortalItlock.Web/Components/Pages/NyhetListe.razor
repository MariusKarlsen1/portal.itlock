@page "/nyheter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Nyheter</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="bell" /></span>
    <div>
        <h1>Nyheter</h1>
        <p class="section-hint">Genereres automatisk hver gang det pushes en endring til portalen. Den nyeste vises som en "Hva er nytt"-boks på forsiden for alle brukere, til de lukker den.</p>
    </div>
</div>

@if (_nyheter.Count == 0)
{
    <p class="list-empty">Ingen oppdateringer registrert ennå.</p>
}
else
{
    <div class="nyhet-rutenett">
        @foreach (var n in _nyheter)
        {
            <div @key="n.Id" class="nyhet-kort">
                <span class="nyhet-dato">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                <span class="nyhet-tittel">@n.Tittel</span>
                <p class="nyhet-tekst @(ErApen(n.Id) ? "" : "nyhet-tekst-avkortet")">@n.Innhold</p>
                <div class="nyhet-footer">
                    <button type="button" class="les-mer-knapp" @onclick="@(() => ToggleApen(n.Id))">@(ErApen(n.Id) ? "Vis mindre" : "Les mer")</button>
                    <button type="button" class="remove-button" @onclick="@(() => SlettNyhet(n))">Slett</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Nyhet> _nyheter = [];
    private HashSet<int> _apne = [];

    private bool ErApen(int id) => _apne.Contains(id);

    private void ToggleApen(int id)
    {
        if (!_apne.Add(id))
        {
            _apne.Remove(id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _nyheter = await Db.Nyheter.OrderByDescending(n => n.OpprettetDato).ToListAsync();
    }

    private async Task SlettNyhet(Nyhet n)
    {
        Db.Nyheter.Remove(n);
        await Db.SaveChangesAsync();
        _nyheter.Remove(n);
    }
}
