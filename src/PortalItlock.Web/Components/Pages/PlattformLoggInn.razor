@page "/plattform/logg-inn"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@using PortalItlock.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Plattform - logg inn</PageTitle>

<div class="login-card">
    <h1>Plattform</h1>
    <p class="sett-passord-hint">Egen innlogging for deg som eier løsningen - helt adskilt fra kundenes egne kontoer.</p>

    @if (Feil == "1")
    {
        <p class="login-error">Feil e-post eller passord.</p>
    }
    @if (ForMange == "1")
    {
        <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
    }
    @if (Satt == "1")
    {
        <p class="login-success">Passord satt. Du kan nå logge inn.</p>
    }

    <form method="post" action="/plattform/konto/login">
        <label>
            E-post
            <input type="email" name="username" autocomplete="username" required autofocus />
        </label>
        <label>
            Passord
            <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Logg inn</button>
    </form>

    <a class="login-sett-passord" href="/plattform/sett-passord">Sett passord første gang</a>
    <a class="login-sett-passord" href="/plattform/glemt-passord">Glemt passord?</a>
    <a class="login-for-kunden" href="/login">Til vanlig innlogging</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }
}
