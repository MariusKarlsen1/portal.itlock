@page "/integrasjoner/tripletex"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject PortalItlock.Web.Services.TripletexService Tripletex
@inject PortalItlock.Web.Services.TripletexSyncService TripletexSync

<PageTitle>Tripletex-integrasjon</PageTitle>

<h1>Tripletex-integrasjon</h1>
<p class="section-hint">
    Kobler direkte til Tripletex sitt API - for øyeblikket mot <strong>testmiljøet</strong>
    (api-test.tripletex.tech), for å teste koblingen før den eventuelt pekes mot
    den ekte produksjonskontoen. Dette er uavhengig av den eksisterende manuelle
    CSV-eksporten (Tripletex-importformat) på tilbudssiden - denne siden snakker
    direkte med API-et i sanntid.
</p>

<div class="tt-card">
    <h2>1. Test tilkobling</h2>
    <button type="button" class="save-button" @onclick="TestTilkobling" disabled="@_testerNa">
        @(_testerNa ? "Tester..." : "Test tilkobling")
    </button>

    @if (_tilkoblingResultat is not null)
    {
        @if (_tilkoblingResultat.Ok)
        {
            <p class="save-success">
                Tilkoblet! Firma: <strong>@_tilkoblingResultat.FirmaNavn</strong>
                @if (!string.IsNullOrWhiteSpace(_tilkoblingResultat.BrukerNavn))
                {
                    <text> - innlogget som @_tilkoblingResultat.BrukerNavn</text>
                }
            </p>
        }
        else
        {
            <p class="form-error">Feilet: @_tilkoblingResultat.Feilmelding</p>
        }
    }
</div>

<div class="tt-card">
    <h2>2. Søk kunder i Tripletex</h2>
    <p class="section-hint">Beviser at API-et faktisk kan lese ekte data - søk opp en kunde fra testkontoen.</p>
    <div class="tt-sok-rad">
        <input @bind="_kundeSok" @bind:event="oninput"
               @onkeydown="@(async e => { if (e.Key == "Enter") { await SokKunder(); } })"
               placeholder="Kundenavn..." />
        <button type="button" class="filter-button" @onclick="SokKunder" disabled="@_sokerNa">
            @(_sokerNa ? "Søker..." : "Søk")
        </button>
    </div>

    @if (_sokFeil is not null)
    {
        <p class="form-error">@_sokFeil</p>
    }

    @if (_kunder.Count > 0)
    {
        <ul class="tt-kunde-liste">
            @foreach (var k in _kunder)
            {
                <li>
                    <strong>@k.Navn</strong>
                    <span class="tt-kunde-meta">
                        @(k.CustomerNumber is not null ? $"Kundenr {k.CustomerNumber}" : "")
                        @(k.OrganizationNumber is not null ? $" · Orgnr {k.OrganizationNumber}" : "")
                        @(k.Email is not null ? $" · {k.Email}" : "")
                    </span>
                </li>
            }
        </ul>
    }
    else if (_harSokt)
    {
        <p class="list-empty">Ingen kunder funnet.</p>
    }
</div>

<div class="tt-card">
    <h2>3. Synkroniser kunder</h2>
    <p class="section-hint">
        Kjører den samme synkroniseringen som skjer automatisk hvert 15. minutt i
        bakgrunnen: nye portal-kunder uten Tripletex-kundenummer sendes til
        Tripletex, og kunder opprettet/endret direkte i Tripletex hentes inn (eller
        oppdateres) i portalen.
    </p>
    <button type="button" class="save-button" @onclick="SynkroniserKunder" disabled="@_synkroniserNa">
        @(_synkroniserNa ? "Synkroniserer..." : "Synkroniser nå")
    </button>

    @if (_syncResultat is not null)
    {
        <p class="save-success">
            @_syncResultat.PushetTilTripletex sendt til Tripletex ·
            @_syncResultat.HentetFraTripletex hentet inn ·
            @_syncResultat.Oppdatert oppdatert
        </p>
        @foreach (var f in _syncResultat.Feil)
        {
            <p class="form-error">@f</p>
        }
    }
</div>

@code {
    private bool _testerNa;
    private PortalItlock.Web.Services.TripletexService.TilkoblingResultat? _tilkoblingResultat;

    private string _kundeSok = "";
    private bool _sokerNa;
    private bool _harSokt;
    private string? _sokFeil;
    private List<PortalItlock.Web.Services.TripletexService.TripletexKunde> _kunder = [];

    private bool _synkroniserNa;
    private PortalItlock.Web.Services.TripletexSyncService.KundeSyncResultat? _syncResultat;

    private async Task SynkroniserKunder()
    {
        _synkroniserNa = true;
        _syncResultat = null;
        try
        {
            _syncResultat = await TripletexSync.SynkroniserKunderAsync();
        }
        finally
        {
            _synkroniserNa = false;
        }
    }

    private async Task TestTilkobling()
    {
        _testerNa = true;
        _tilkoblingResultat = null;
        try
        {
            _tilkoblingResultat = await Tripletex.TestTilkoblingAsync();
        }
        finally
        {
            _testerNa = false;
        }
    }

    private async Task SokKunder()
    {
        _sokerNa = true;
        _sokFeil = null;
        try
        {
            var (kunder, feil) = await Tripletex.SokKunderAsync(_kundeSok);
            _kunder = kunder;
            _sokFeil = feil;
            _harSokt = true;
        }
        finally
        {
            _sokerNa = false;
        }
    }
}
