@page "/driftmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]

<PageTitle>Drift - itlock</PageTitle>

<h1>Drift</h1>
<p class="section-hint">Kart, kalender og fravær.</p>

<div class="modul-grid">
    <a href="/kart" class="modul-card">
        <Icon Name="map" />
        <span class="modul-card-title">Kart</span>
        <span class="modul-card-desc">Se montørenes jobber geografisk for en valgt dag.</span>
    </a>
    <a href="/kalender" class="modul-card">
        <Icon Name="calendar" />
        <span class="modul-card-title">Kalender</span>
        <span class="modul-card-desc">Se planlagte arbeidsordre for alle montører i månedsvisning.</span>
    </a>
    <a href="/fravar" class="modul-card">
        <Icon Name="sun" />
        <span class="modul-card-title">Fravær</span>
        <span class="modul-card-desc">Søknader, godkjenning og fraværskalender per person.</span>
    </a>
</div>
