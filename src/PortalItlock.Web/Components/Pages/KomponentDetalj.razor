@page "/komponenter/vare/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>@(_component?.Navn ?? "Vare") - itlock</PageTitle>

<a class="back-link" href="/komponenter">&larr; Tilbake til komponentregister</a>

@if (_notFound)
{
    <p class="form-error">Fant ikke varen.</p>
}
else if (_component is not null)
{
    <h1>@_component.Navn</h1>
    <p class="vare-meta">
        @(_component.Produktkode ?? "Uten produktkode")
        @(string.IsNullOrWhiteSpace(_component.Produsent) ? "" : $" · {_component.Produsent}")
        · Netto @FormatPris(_component.PrisNetto) · Veiledende @FormatPris(_component.PrisVeiledende)
    </p>
    <p class="section-hint">Grunndata (navn, produktkode, priser mv.) redigeres fra Komponentregister via "Rediger". Her styres kun hvilke leverandører varen kan kjøpes fra.</p>

    <section class="leverandor-seksjon">
        <h2>Leverandører</h2>
        @if (_lenker.Count == 0)
        {
            <p class="list-empty">Ingen leverandører koblet til denne varen ennå.</p>
        }
        else
        {
            <table class="lenke-table">
                <thead>
                    <tr>
                        <th>Leverandør</th>
                        <th>Varenummer</th>
                        <th>Netto</th>
                        <th>Veiledende</th>
                        <th>Standard</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _lenker)
                    {
                        <tr @key="l.LeverandorId">
                            <td><a href="@($"/komponenter/leverandorer/{l.LeverandorId}")">@l.LeverandorNavn</a></td>
                            <td><input @bind="l.Varenummer" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisNetto" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisVeiledende" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td>
                                @if (l.ErStandard)
                                {
                                    <span class="standard-merke">Standard</span>
                                }
                                else
                                {
                                    <button type="button" class="cancel-button" @onclick="@(() => SettStandard(l))">Sett som standard</button>
                                }
                            </td>
                            <td><button type="button" class="remove-button" @onclick="@(() => FjernLenke(l))">Fjern</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="ny-lenke-form">
            <h3>Legg til leverandør</h3>
            <label>
                Leverandør
                <input list="leverandor-forslag" @bind="_nyLeverandorNavn" placeholder="Navn på leverandør" />
                <datalist id="leverandor-forslag">
                    @foreach (var navn in _alleLeverandorNavn)
                    {
                        <option value="@navn" />
                    }
                </datalist>
            </label>
            <label>
                Leverandørens varenummer
                <input @bind="_nyttVarenummer" />
            </label>
            <label>
                Netto
                <input type="number" step="0.01" @bind="_nyPrisNetto" />
            </label>
            <label>
                Veiledende
                <input type="number" step="0.01" @bind="_nyPrisVeiledende" />
            </label>
            <label class="checkbox-felt">
                <input type="checkbox" @bind="_nySomStandard" />
                Sett som standard for denne varen
            </label>
            <button type="button" class="save-button" @onclick="LeggTilLeverandor">Legg til</button>
        </div>
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="save-success">@_melding</p>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class LenkeRad
    {
        public int LeverandorId { get; set; }
        public string LeverandorNavn { get; set; } = "";
        public string? Varenummer { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public bool ErStandard { get; set; }
    }

    private Component? _component;
    private bool _notFound;
    private List<LenkeRad> _lenker = [];
    private List<string> _alleLeverandorNavn = [];

    private string _nyLeverandorNavn = "";
    private string _nyttVarenummer = "";
    private decimal? _nyPrisNetto;
    private decimal? _nyPrisVeiledende;
    private bool _nySomStandard;
    private string? _feil;
    private string? _melding;

    protected override async Task OnParametersSetAsync() => await LastAsync();

    private async Task LastAsync()
    {
        _component = await Db.Components.FirstOrDefaultAsync(c => c.Id == Id);
        _notFound = _component is null;
        if (_component is null)
        {
            return;
        }

        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.ComponentId == Id)
            .Include(cl => cl.Leverandor)
            .OrderBy(cl => cl.Leverandor!.Navn)
            .Select(cl => new LenkeRad
            {
                LeverandorId = cl.LeverandorId,
                LeverandorNavn = cl.Leverandor!.Navn,
                Varenummer = cl.Varenummer,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();

        _alleLeverandorNavn = await Db.Leverandorer.OrderBy(l => l.Navn).Select(l => l.Navn).ToListAsync();
    }

    private async Task LeggTilLeverandor()
    {
        _feil = null;
        _melding = null;

        if (string.IsNullOrWhiteSpace(_nyLeverandorNavn))
        {
            _feil = "Leverandørnavn må fylles ut.";
            return;
        }

        var leverandor = await LeverandorSync.FinnEllerOpprettAsync(Db, _nyLeverandorNavn);
        await Db.SaveChangesAsync();

        if (_lenker.Any(l => l.LeverandorId == leverandor.Id))
        {
            _feil = $"Varen er allerede koblet til \"{leverandor.Navn}\".";
            return;
        }

        Db.ComponentLeverandorer.Add(new ComponentLeverandor
        {
            ComponentId = Id,
            LeverandorId = leverandor.Id,
            Varenummer = string.IsNullOrWhiteSpace(_nyttVarenummer) ? null : _nyttVarenummer.Trim(),
            PrisNetto = _nyPrisNetto,
            PrisVeiledende = _nyPrisVeiledende,
            ErStandard = false
        });
        await Db.SaveChangesAsync();

        if (_nySomStandard)
        {
            await LeverandorSync.SettStandardAsync(Db, Id, leverandor.Id);
            await Db.SaveChangesAsync();
        }

        _nyLeverandorNavn = "";
        _nyttVarenummer = "";
        _nyPrisNetto = null;
        _nyPrisVeiledende = null;
        _nySomStandard = false;
        _melding = $"\"{leverandor.Navn}\" er lagt til.";
        await LastAsync();
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            await LeverandorSync.SettStandardAsync(Db, Id, rad.LeverandorId);
            await Db.SaveChangesAsync();
            _component = await Db.Components.FirstOrDefaultAsync(c => c.Id == Id);
        }
    }

    private async Task SettStandard(LenkeRad rad)
    {
        await LeverandorSync.SettStandardAsync(Db, Id, rad.LeverandorId);
        await Db.SaveChangesAsync();
        await LastAsync();
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        await LastAsync();
    }

    private static string FormatPris(decimal? verdi) =>
        verdi.HasValue ? verdi.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) + " kr" : "-";
}
