@page "/prosjekt/{Id:int}/lasplan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject LasplanPdfService PdfService
@inject LagretPdfService LagretPdfService
@inject TilbudSyncService TilbudSync
@inject VisningPreferanseService VisningPref

<PageTitle>Låsplan - @(_prosjekt?.Navn)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else if (_prosjekt is null)
{
    <p>Laster...</p>
}
else
{
    @* Låsplan LP1 (lasplan-forslag.html): som før, samlet i ett kort - infofelter
       som rad, tydelig låst/redigering, nøkler, matrise med faste overskrifter og
       kryss, legg til sylinder manuelt og lagrede PDF-er. Samme funksjoner som før. *@
    <div class="ls-kort @(_full ? "ls-full" : "")">
        <div class="ls-topp">
            <div>
                <a class="ls-tilbake" href="@($"/prosjekter/{Id}")">&larr; Tilbake til prosjektet</a>
                <h1>Låsplan – @_prosjekt.Navn</h1>
            </div>
            <div class="ls-handl">
                <button type="button" class="ls-kn" @onclick="SynkroniserSylindere">Synkroniser sylindere</button>
                <button type="button" class="ls-kn ls-kn-p" @onclick="GenererPdf"><Icon Name="file-text" />Last ned PDF</button>
                <button type="button" class="ls-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>
        </div>
        <p class="ls-hint">
            Sylindere hentes fra varer merket «Låsplan» på prosjektets tilbud <strong>som også er plassert på en dør</strong>
            (under Dører-fanen). Kryss av hvilke nøkler som åpner hvilke sylindere.
        </p>
        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <span class="ls-melding">@_syncMessage</span>
        }

        @if (_redigerInfo)
        {
            <div class="ls-info ls-info-rediger">
                <label><span class="ls-lbl">Låsplan systemnr.</span><input @bind="_prosjekt.LasplanSystemnr" @bind:event="oninput" /></label>
                <label><span class="ls-lbl">Systemeier</span><input value="@(_prosjekt.Kunde?.Navn)" disabled /></label>
                <label><span class="ls-lbl">Prosjektnummer</span><input @bind="_prosjekt.LasplanProsjektnummer" @bind:event="oninput" /></label>
                <label><span class="ls-lbl">Utarbeidet av / dato</span><input @bind="_prosjekt.LasplanUtarbeidetAv" @bind:event="oninput" placeholder="Navn, dd.mm.åååå" /></label>
            </div>
        }
        else
        {
            <div class="ls-info">
                <div><span class="ls-lbl">Låsplan systemnr.</span><b>@(string.IsNullOrWhiteSpace(_prosjekt.LasplanSystemnr) ? "–" : _prosjekt.LasplanSystemnr)</b></div>
                <div><span class="ls-lbl">Systemeier</span><b>@(_prosjekt.Kunde?.Navn ?? "–")</b></div>
                <div><span class="ls-lbl">Prosjektnummer</span><b>@(string.IsNullOrWhiteSpace(_prosjekt.LasplanProsjektnummer) ? "–" : _prosjekt.LasplanProsjektnummer)</b></div>
                <div><span class="ls-lbl">Utarbeidet av / dato</span><b>@(string.IsNullOrWhiteSpace(_prosjekt.LasplanUtarbeidetAv) ? "–" : _prosjekt.LasplanUtarbeidetAv)</b></div>
            </div>
        }

        <div class="ls-rad">
            <span class="ls-lasmerke @(_prosjekt.LasplanLast ? "last" : "apen")">@(_prosjekt.LasplanLast ? "🔒 Matrisen er låst" : "✏️ Redigering på")</span>
            <button type="button" class="ls-kn ls-kn-s" @onclick="ToggleLast">@(_prosjekt.LasplanLast ? "Aktiver redigering" : "Lås matrise")</button>
            <span class="ls-hoyre">
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="ls-melding">@_savedMessage</span>
                }
                @if (_redigerInfo)
                {
                    <button type="button" class="ls-kn ls-kn-p ls-kn-s" @onclick="LagreInfo">Lagre</button>
                }
                else
                {
                    <button type="button" class="ls-kn ls-kn-s" @onclick="@(() => { _redigerInfo = true; _savedMessage = null; })">Rediger info</button>
                }
            </span>
        </div>

        @if (_uplasserte.Count > 0)
        {
            <div class="ls-varsel">
                <span>⚠️</span>
                <span>
                    <b>@_uplasserte.Count vare(r)</b> er merket «Låsplan» på tilbudet, men ikke lagt til på noen dør ennå, så de vises ikke i matrisen:
                    @string.Join(", ", _uplasserte.Select(l => l.Component!.Navn)).
                    <span class="ls-mut">Legg dem til på riktig(e) dør(er) under Dører-fanen.</span>
                </span>
                <a class="ls-kn ls-kn-s" href="@($"/prosjekter/{Id}?fane=dorer")">Gå til Dører</a>
            </div>
        }

        <div class="ls-seksjon">
            <h4>Nøkler</h4>
            <div class="ls-rad">
                @foreach (var n in _nokler)
                {
                    <span @key="n.Id" class="ls-nokkel">
                        @n.Merking: @n.Navn (@n.Antall stk)
                        <button type="button" title="Fjern nøkkel" @onclick="@(() => FjernNokkel(n))">&times;</button>
                    </span>
                }
                @if (_nokler.Any(n => n.Merking is null || !n.Merking.StartsWith('K')))
                {
                    <button type="button" class="ls-kn ls-kn-s" @onclick="FiksNokkelmerking">Fiks merking (K1, K2, ...)</button>
                }
            </div>
            <div class="ls-rad">
                <input class="ls-inp ls-flex2" @bind="_nyNokkelNavn" @bind:event="oninput" placeholder="Nøkkelnavn, f.eks. Hovednøkkel" />
                <input class="ls-inp ls-flex1" @bind="_nyNokkelMateriale" @bind:event="oninput" placeholder="Materiale (valgfritt)" />
                <input class="ls-inp ls-antall" type="number" min="0" @bind="_nyNokkelAntall" placeholder="Antall" />
                <button type="button" class="ls-kn ls-kn-p ls-kn-s" @onclick="LeggTilNokkel" disabled="@string.IsNullOrWhiteSpace(_nyNokkelNavn)">Legg til nøkkel</button>
            </div>
        </div>

        @if (_rader.Count == 0)
        {
            <p class="list-empty">Ingen sylindere plassert på dører ennå. Kryss av "Låsplan" på riktige varer inne på tilbudet, og legg dem til på en dør under Dører-fanen.</p>
        }
        else
        {
            <div class="ls-mxwrap">
                <table class="ls-mx @(_prosjekt.LasplanLast ? "ls-mx-last" : "")">
                    <thead>
                        <tr>
                            <th class="ls-fast">Syl.mrk</th>
                            <th>Dør til</th>
                            <th>Dørnr.</th>
                            <th>Sylindertype</th>
                            <th>Antall</th>
                            @foreach (var n in _nokler)
                            {
                                <th @key="n.Id" class="ls-nk"><b>@n.Merking</b><small>@n.Navn</small></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rad in _rader)
                        {
                            <tr @key="rad.RadKey">
                                <td class="ls-fast"><b>@rad.Visningsnummer</b></td>
                                <td>@(rad.Dor?.DorTil ?? (string.IsNullOrWhiteSpace(rad.ReserveDorTil) ? "–" : rad.ReserveDorTil))</td>
                                <td class="@(rad.Dor is null ? "ls-mut" : "")">@(rad.Dor?.Dornummer ?? (string.IsNullOrWhiteSpace(rad.ReserveDornr) ? "Reserve" : rad.ReserveDornr))</td>
                                <td>
                                    <span class="ls-syl">
                                        @rad.Component.Navn
                                        <button type="button" class="ls-fjern" title="Fjern sylinder" @onclick="@(() => FjernRad(rad))">&times;</button>
                                    </span>
                                    @if (rad.ReserveId is not null)
                                    {
                                        <span class="ls-koble">
                                            <select @bind="rad.ValgtKoblingDorId">
                                                <option value="">Koble til dør...</option>
                                                @foreach (var d in _dorer)
                                                {
                                                    <option value="@d.Id">@d.Dornummer@(string.IsNullOrWhiteSpace(d.DorTil) ? "" : $" – {d.DorTil}")</option>
                                                }
                                            </select>
                                            <button type="button" class="ls-kn ls-kn-s" disabled="@(rad.ValgtKoblingDorId is null)" @onclick="@(() => KobleReserveTilDor(rad))">Koble</button>
                                        </span>
                                    }
                                </td>
                                <td>1</td>
                                @foreach (var n in _nokler)
                                {
                                    var krysset = ApnerDenne(rad, n);
                                    <td @key="n.Id" class="ls-x @(krysset ? "krysset" : "")" @onclick="@(() => ToggleKryss(rad, n))">
                                        @(krysset ? "X" : "")
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="ls-boks">
            <h3>Legg til sylinder manuelt</h3>
            <span class="ls-mut ls-liten">
                Bruk dette dersom en sylinder ikke ligger på tilbudet, eller du vil legge den til direkte uten å gå via Dører-fanen.
                Velg "Legg til ny" for en sylinder som skal leveres, men som ikke er montert på noen dør ennå.
            </span>
            <div class="ls-rad">
                <select class="ls-inp ls-velg" @bind="_valgtDorId">
                    <option value="">Velg dør...</option>
                    <option value="-1">Legg til ny</option>
                    @foreach (var d in _dorer)
                    {
                        <option value="@d.Id">@d.Dornummer@(string.IsNullOrWhiteSpace(d.DorTil) ? "" : $" – {d.DorTil}")</option>
                    }
                </select>
                <input class="ls-inp ls-antall" type="number" min="1" @bind="_manuellAntall" placeholder="Antall" />
                @if (_valgtDorId == -1)
                {
                    <input class="ls-inp ls-flex1" @bind="_manuellDornr" @bind:event="oninput" placeholder="Dørnr. (valgfritt)" />
                    <input class="ls-inp ls-flex1" @bind="_manuellDorTil" @bind:event="oninput" placeholder="Dør til (valgfritt)" />
                }
            </div>
            <div class="ls-sok">
                <input class="ls-inp" @bind="_komponentSok" @bind:event="oninput" @bind:after="SokSylinderKomponent" placeholder="Søk sylinder – navn, leverandør eller produktkode" />
                @if (_sokeResultater.Count > 0)
                {
                    <ul class="ls-treff">
                        @foreach (var r in _sokeResultater)
                        {
                            <li>
                                <button type="button" @onclick="@(() => LeggTilManuellSylinder(r))">
                                    <b>@r.Navn</b>
                                    <span class="ls-mut">@r.Leverandor</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (_komponentSok.Trim().Length >= 2)
                {
                    <span class="ls-mut ls-liten">Ingen treff.</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(_manuellMessage))
            {
                <span class="ls-melding">@_manuellMessage</span>
            }
        </div>

        <div class="ls-seksjon">
            <h4>Lagrede PDF-er</h4>
            <LagredePdfListe Pdfer="_lagredePdfer" />
        </div>

        <PdfPreviewModal Url="@_pdfUrl" Tittel="Låsplan" SaveMessage="@_pdfSavedMessage"
                          OnSave="LagreLasplanPdf" OnClose="@(() => _pdfUrl = null)" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Prosjekt? _prosjekt;
    private bool _notFound;
    private List<Nokkel> _nokler = [];
    private List<SylinderRad> _rader = [];
    private HashSet<(int NokkelId, int DorId, int ComponentId)> _krysser = [];
    private List<LasplanReserve> _reserver = [];
    private HashSet<(int NokkelId, int ReserveId)> _reserveKrysser = [];
    private string? _savedMessage;
    private string? _syncMessage;
    private string? _pdfUrl;
    private string? _pdfSavedMessage;
    private List<LagretPdf> _lagredePdfer = [];
    private List<TilbudLinje> _uplasserte = [];
    private List<Dor> _dorer = [];

    private string _nyNokkelNavn = "";
    private string _nyNokkelMateriale = "";
    private int _nyNokkelAntall = 1;

    private int? _valgtDorId;
    private int _manuellAntall = 1;
    private string _manuellDornr = "";
    private string _manuellDorTil = "";
    private string _komponentSok = "";
    private List<SearchResult> _sokeResultater = [];
    private string? _manuellMessage;

    private class SylinderRad
    {
        public required string Visningsnummer { get; set; }
        public int? DorId { get; set; }
        public required int ComponentId { get; set; }
        public Dor? Dor { get; set; }
        public required Component Component { get; set; }
        public int? ReserveId { get; set; }
        public string? ReserveDorTil { get; set; }
        public string? ReserveDornr { get; set; }
        public int? ValgtKoblingDorId { get; set; }

        public string RadKey => ReserveId is not null ? $"R{ReserveId}-{ComponentId}-{Visningsnummer}" : $"{DorId}-{ComponentId}-{Visningsnummer}";
    }

    private class SearchResult
    {
        public int Id { get; set; }
        public required string Navn { get; set; }
        public string? Leverandor { get; set; }
    }

    // Utvid-knappen øverst til høyre - lagres per bruker, som på tilbud og dørpakker.
    private bool _full;
    private bool _fullLastet;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("lasplan-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_fullLastet)
        {
            _fullLastet = true;
            _full = await VisningPref.HentAsync("lasplan-bredde", "normal") == "full";
        }

        _prosjekt = await Db.Prosjekter.Include(p => p.Kunde).FirstOrDefaultAsync(p => p.Id == Id);
        if (_prosjekt is null)
        {
            _notFound = true;
            return;
        }

        _lagredePdfer = await LagretPdfService.HentAsync("Lasplan", Id);

        await LastInnAsync();
    }

    private async Task LastInnAsync()
    {
        _nokler = await Db.Nokler.Where(n => n.ProsjektId == Id).OrderBy(n => n.Rekkefolge).ToListAsync();
        _dorer = await Db.Dorer.Where(d => d.ProsjektId == Id).OrderBy(d => d.Dornummer).ToListAsync();

        var dorKomponenter = await Db.DorKomponenter
            .Where(k => k.Dor!.ProsjektId == Id && k.Component!.ErSylinder)
            .Include(k => k.Dor)
            .Include(k => k.Component)
            .OrderBy(k => k.Dor!.Dornummer)
            .ToListAsync();

        var rader = new List<SylinderRad>();
        var nummer = 0;
        foreach (var dk in dorKomponenter)
        {
            nummer++;
            for (var i = 0; i < dk.Antall; i++)
            {
                rader.Add(new SylinderRad
                {
                    Visningsnummer = i == 0 ? nummer.ToString() : $"{nummer}.{i}",
                    DorId = dk.DorId,
                    ComponentId = dk.ComponentId,
                    Dor = dk.Dor!,
                    Component = dk.Component!
                });
            }
        }

        _reserver = await Db.LasplanReserver
            .Where(r => r.ProsjektId == Id)
            .Include(r => r.Component)
            .OrderBy(r => r.Id)
            .ToListAsync();

        foreach (var res in _reserver)
        {
            nummer++;
            for (var i = 0; i < res.Antall; i++)
            {
                rader.Add(new SylinderRad
                {
                    Visningsnummer = i == 0 ? nummer.ToString() : $"{nummer}.{i}",
                    ComponentId = res.ComponentId,
                    Component = res.Component!,
                    ReserveId = res.Id,
                    ReserveDorTil = res.DorTil,
                    ReserveDornr = res.Dornr
                });
            }
        }
        _rader = rader;

        var nokkelIder = _nokler.Select(n => n.Id).ToList();
        var krysser = await Db.NokkelSylindere.Where(ns => nokkelIder.Contains(ns.NokkelId)).ToListAsync();
        _krysser = krysser.Select(k => (k.NokkelId, k.DorId, k.ComponentId)).ToHashSet();

        var reserveIder = _reserver.Select(r => r.Id).ToList();
        var reserveKrysser = await Db.NokkelLasplanReserver.Where(nr => nokkelIder.Contains(nr.NokkelId) && reserveIder.Contains(nr.LasplanReserveId)).ToListAsync();
        _reserveKrysser = reserveKrysser.Select(k => (k.NokkelId, k.LasplanReserveId)).ToHashSet();

        var plasserteComponentIder = dorKomponenter.Select(dk => dk.ComponentId).ToHashSet();
        _uplasserte = await Db.TilbudLinjer
            .Where(l => l.Tilbud!.ProsjektId == Id && l.ComponentId != null && l.Component!.ErSylinder)
            .Include(l => l.Component)
            .ToListAsync();
        _uplasserte = _uplasserte
            .Where(l => !plasserteComponentIder.Contains(l.ComponentId!.Value))
            .DistinctBy(l => l.ComponentId)
            .ToList();
    }

    private async Task SynkroniserSylindere()
    {
        await LastInnAsync();
        _syncMessage = _rader.Count == 0
            ? "Fant ingen sylindere plassert på dører ennå."
            : $"{_rader.Count} sylinder(e) synkronisert.";
    }

    private async Task SokSylinderKomponent()
    {
        var term = _komponentSok.Trim();
        if (term.Length < 2)
        {
            _sokeResultater = [];
            return;
        }

        _sokeResultater = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor })
            .ToListAsync();
    }

    private async Task LeggTilManuellSylinder(SearchResult r)
    {
        if (_valgtDorId is null)
        {
            _manuellMessage = "Velg en dør (eller reserve/lager) først.";
            return;
        }

        var valgtComponent = await Db.Components.FindAsync(r.Id);
        if (valgtComponent is not null && !valgtComponent.ErSylinder)
        {
            valgtComponent.ErSylinder = true;
        }

        if (_valgtDorId == -1)
        {
            var eksisterendeReserve = await Db.LasplanReserver.FirstOrDefaultAsync(x => x.ProsjektId == Id && x.ComponentId == r.Id);
            if (eksisterendeReserve is not null)
            {
                eksisterendeReserve.Antall += _manuellAntall;
            }
            else
            {
                Db.LasplanReserver.Add(new LasplanReserve
                {
                    ProsjektId = Id,
                    ComponentId = r.Id,
                    Antall = _manuellAntall,
                    DorTil = string.IsNullOrWhiteSpace(_manuellDorTil) ? null : _manuellDorTil.Trim(),
                    Dornr = string.IsNullOrWhiteSpace(_manuellDornr) ? null : _manuellDornr.Trim()
                });
            }
        }
        else
        {
            var eksisterende = await Db.DorKomponenter.FindAsync(_valgtDorId.Value, r.Id);
            if (eksisterende is not null)
            {
                eksisterende.Antall += _manuellAntall;
            }
            else
            {
                Db.DorKomponenter.Add(new DorKomponent
                {
                    DorId = _valgtDorId.Value,
                    ComponentId = r.Id,
                    Antall = _manuellAntall,
                    Enhet = valgtComponent?.Enhet
                });
            }
        }

        await Db.SaveChangesAsync();
        if (_valgtDorId != -1)
        {
            await TilbudSync.SyncSylinderAsync(Id, r.Id);
        }
        await LastInnAsync();

        _komponentSok = "";
        _sokeResultater = [];
        _manuellDornr = "";
        _manuellDorTil = "";
        _manuellMessage = $"{r.Navn} lagt til.";
    }

    private async Task FjernReserve(SylinderRad rad)
    {
        if (rad.ReserveId is null)
        {
            return;
        }

        var reserve = await Db.LasplanReserver.FindAsync(rad.ReserveId.Value);
        if (reserve is not null)
        {
            Db.LasplanReserver.Remove(reserve);
            await Db.SaveChangesAsync();
        }

        await LastInnAsync();
    }

    private async Task FjernRad(SylinderRad rad)
    {
        if (rad.ReserveId is not null)
        {
            await FjernReserve(rad);
            return;
        }

        if (rad.DorId is null)
        {
            return;
        }

        var dk = await Db.DorKomponenter.FindAsync(rad.DorId.Value, rad.ComponentId);
        if (dk is not null)
        {
            Db.DorKomponenter.Remove(dk);
        }

        var krysser = await Db.NokkelSylindere.Where(ns => ns.DorId == rad.DorId.Value && ns.ComponentId == rad.ComponentId).ToListAsync();
        Db.NokkelSylindere.RemoveRange(krysser);

        await Db.SaveChangesAsync();
        await LastInnAsync();
    }

    private async Task KobleReserveTilDor(SylinderRad rad)
    {
        if (rad.ReserveId is null || rad.ValgtKoblingDorId is null)
        {
            return;
        }

        var reserve = await Db.LasplanReserver.FindAsync(rad.ReserveId.Value);
        if (reserve is null)
        {
            return;
        }

        var dorId = rad.ValgtKoblingDorId.Value;
        var eksisterende = await Db.DorKomponenter.FindAsync(dorId, reserve.ComponentId);
        if (eksisterende is not null)
        {
            eksisterende.Antall += reserve.Antall;
        }
        else
        {
            var component = await Db.Components.FindAsync(reserve.ComponentId);
            Db.DorKomponenter.Add(new DorKomponent
            {
                DorId = dorId,
                ComponentId = reserve.ComponentId,
                Antall = reserve.Antall,
                Enhet = component?.Enhet
            });
        }

        // Flytt nøkkelkryssene fra reserven over til den ekte døren.
        var reserveKrysser = await Db.NokkelLasplanReserver.Where(nr => nr.LasplanReserveId == reserve.Id).ToListAsync();
        foreach (var rk in reserveKrysser)
        {
            var finnesAllerede = await Db.NokkelSylindere.FindAsync(rk.NokkelId, dorId, reserve.ComponentId);
            if (finnesAllerede is null)
            {
                Db.NokkelSylindere.Add(new NokkelSylinder { NokkelId = rk.NokkelId, DorId = dorId, ComponentId = reserve.ComponentId });
            }
        }
        Db.NokkelLasplanReserver.RemoveRange(reserveKrysser);
        Db.LasplanReserver.Remove(reserve);

        await Db.SaveChangesAsync();
        await TilbudSync.SyncSylinderAsync(Id, reserve.ComponentId);
        await LastInnAsync();
    }

    private bool ApnerDenne(SylinderRad rad, Nokkel nokkel) => rad.ReserveId is not null
        ? _reserveKrysser.Contains((nokkel.Id, rad.ReserveId.Value))
        : _krysser.Contains((nokkel.Id, rad.DorId!.Value, rad.ComponentId));

    private async Task ToggleKryss(SylinderRad rad, Nokkel nokkel)
    {
        if (_prosjekt!.LasplanLast)
        {
            return;
        }

        if (rad.ReserveId is not null)
        {
            var reserveKey = (nokkel.Id, rad.ReserveId.Value);
            if (_reserveKrysser.Contains(reserveKey))
            {
                var eksisterendeKryss = await Db.NokkelLasplanReserver.FindAsync(nokkel.Id, rad.ReserveId.Value);
                if (eksisterendeKryss is not null)
                {
                    Db.NokkelLasplanReserver.Remove(eksisterendeKryss);
                }

                _reserveKrysser.Remove(reserveKey);
            }
            else
            {
                Db.NokkelLasplanReserver.Add(new NokkelLasplanReserve { NokkelId = nokkel.Id, LasplanReserveId = rad.ReserveId.Value });
                _reserveKrysser.Add(reserveKey);
            }

            await Db.SaveChangesAsync();
            return;
        }

        var key = (nokkel.Id, rad.DorId!.Value, rad.ComponentId);
        if (_krysser.Contains(key))
        {
            var eksisterende = await Db.NokkelSylindere.FindAsync(nokkel.Id, rad.DorId!.Value, rad.ComponentId);
            if (eksisterende is not null)
            {
                Db.NokkelSylindere.Remove(eksisterende);
            }

            _krysser.Remove(key);
        }
        else
        {
            Db.NokkelSylindere.Add(new NokkelSylinder { NokkelId = nokkel.Id, DorId = rad.DorId!.Value, ComponentId = rad.ComponentId });
            _krysser.Add(key);
        }

        await Db.SaveChangesAsync();
    }

    private async Task ToggleLast()
    {
        _prosjekt!.LasplanLast = !_prosjekt.LasplanLast;
        await Db.SaveChangesAsync();
    }

    // Infofeltene vises som tekst; «Rediger info» gjør dem redigerbare til man lagrer.
    private bool _redigerInfo;

    private async Task LagreInfo()
    {
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
        _redigerInfo = false;
    }

    private async Task LeggTilNokkel()
    {
        if (string.IsNullOrWhiteSpace(_nyNokkelNavn))
        {
            return;
        }

        var nokkel = new Nokkel
        {
            ProsjektId = Id,
            Navn = _nyNokkelNavn.Trim(),
            Materiale = string.IsNullOrWhiteSpace(_nyNokkelMateriale) ? null : _nyNokkelMateriale.Trim(),
            Antall = _nyNokkelAntall,
            Merking = $"K{_nokler.Count + 1}",
            Rekkefolge = _nokler.Count
        };

        Db.Nokler.Add(nokkel);
        await Db.SaveChangesAsync();

        _nokler.Add(nokkel);
        _nyNokkelNavn = "";
        _nyNokkelMateriale = "";
        _nyNokkelAntall = 1;
    }

    private async Task FiksNokkelmerking()
    {
        var sortert = _nokler.OrderBy(n => n.Rekkefolge).ToList();
        for (var i = 0; i < sortert.Count; i++)
        {
            sortert[i].Merking = $"K{i + 1}";
        }

        await Db.SaveChangesAsync();
    }

    private async Task FjernNokkel(Nokkel n)
    {
        Db.Nokler.Remove(n);
        await Db.SaveChangesAsync();
        _nokler.Remove(n);
        _krysser.RemoveWhere(k => k.NokkelId == n.Id);
        _reserveKrysser.RemoveWhere(k => k.NokkelId == n.Id);
    }

    private void GenererPdf()
    {
        _pdfSavedMessage = null;
        _pdfUrl = $"/prosjekt/{Id}/lasplan/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreLasplanPdf()
    {
        var bytes = await PdfService.GenerateAsync(Id);
        if (bytes is null || _prosjekt is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Lasplan", Id, $"Låsplan - {_prosjekt.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }
}
