    [JSInvokable]
    public async Task OnSymbolMoved(int symbolId, double x, double y)
    {
        var symbol = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (symbol is null)
        {
            return;
        }

        PushUndo();
        symbol.PosX = x;
        symbol.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public async Task OnSymbolsMoved(string flyttetJson)
    {
        var flyttet = JsonSerializer.Deserialize<List<FlyttetSymbol>>(flyttetJson) ?? [];
        if (flyttet.Count == 0)
        {
            return;
        }

        PushUndo();

        foreach (var f in flyttet)
        {
            var symbol = _symboler.FirstOrDefault(s => s.Id == f.Id);
            if (symbol is not null)
            {
                symbol.PosX = f.X;
                symbol.PosY = f.Y;
            }
        }

        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private sealed class FlyttetSymbol
    {
        public int Id { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
    }

    [JSInvokable]
    public async Task OnSymbolResized(int symbolId, double bredde, double hoyde, string? streker)
    {
        var symbol = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (symbol is null)
        {
            return;
        }

        PushUndo();
        symbol.Bredde = bredde;
        symbol.Hoyde = hoyde;
        OppdaterTilkobledeStreker(streker);
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public async Task OnSlettTastetrykk()
    {
        if (_valgteSymbolIds.Count > 1)
        {
            await SlettValgte();
        }
        else if (_selectedSymbol is not null)
        {
            await SlettSymbol();
        }
        else if (_valgtStrek is not null)
        {
            await SlettStrek(_valgtStrek);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnRubberBandValgt(string idsJson, bool shiftKey)
    {
        var ids = JsonSerializer.Deserialize<List<int>>(idsJson) ?? [];
        _valgtStrek = null;

        if (!shiftKey)
        {
            _valgteSymbolIds.Clear();
        }

        foreach (var id in ids)
        {
            _valgteSymbolIds.Add(id);
        }

        _selectedSymbol = _valgteSymbolIds.Count == 1
            ? _symboler.FirstOrDefault(s => s.Id == _valgteSymbolIds.First())
            : null;

        if (_valgteSymbolIds.Count == 1)
        {
            PushUndo();
        }

        StateHasChanged();
    }

    private async Task SendBakerst()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        var min = _symboler.Count > 0 ? _symboler.Min(s => s.ZIndex) : 0;
        _selectedSymbol.ZIndex = min - 1;
        await Db.SaveChangesAsync();
    }

    private async Task SendFremst()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        var max = _symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0;
        _selectedSymbol.ZIndex = max + 1;
        await Db.SaveChangesAsync();
    }

    private async Task ToggleErLaast()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        _selectedSymbol.ErLaast = !_selectedSymbol.ErLaast;
        await Db.SaveChangesAsync();
    }

    private async Task DupliserValgte()
    {
        if (_valgteSymbolIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        var nye = new List<KoblingsSymbol>();
        var nesteZIndex = (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0) + 1;

        foreach (var s in kilder)
        {
            var kopi = new KoblingsSymbol
            {
                KoblingsSkjemaId = s.KoblingsSkjemaId,
                ElementType = s.ElementType,
                Navn = s.Navn,
                SymbolBibliotekId = s.SymbolBibliotekId,
                KomponentNokkel = s.KomponentNokkel,
                Farge = s.Farge,
                Strokbredde = s.Strokbredde,
                Fylt = s.Fylt,
                Tekst = s.Tekst,
                FontStorrelse = s.FontStorrelse,
                PosX = s.PosX + 4,
                PosY = s.PosY + 4,
                Bredde = s.Bredde,
                Hoyde = s.Hoyde,
                ZIndex = nesteZIndex
            };
            Db.KoblingsSymboler.Add(kopi);
            nye.Add(kopi);
        }

        await Db.SaveChangesAsync();
        _symboler.AddRange(nye);
        _valgteSymbolIds.Clear();
        foreach (var n in nye)
        {
            _valgteSymbolIds.Add(n.Id);
        }
        _selectedSymbol = null;
    }

    private async Task SlettValgte()
    {
        if (_valgteSymbolIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        Db.KoblingsSymboler.RemoveRange(kilder);
        await Db.SaveChangesAsync();

        foreach (var s in kilder)
        {
            _symboler.Remove(s);
        }

        _valgteSymbolIds.Clear();
        _selectedSymbol = null;
    }

    private async Task LagreSymbol()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SlettSymbol()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        Db.KoblingsSymboler.Remove(_selectedSymbol);
        await Db.SaveChangesAsync();
        _symboler.Remove(_selectedSymbol);
        _valgteSymbolIds.Remove(_selectedSymbol.Id);
        _selectedSymbol = null;
    }

    private async Task Lagre()
    {
        if (_skjema is null)
        {
            return;
        }

        _skjema.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                // Fjerner den globale document-keydown-lytteren fra
                // enableKeyboardShortcuts FØR modulen disposes - uten dette
                // ble lytteren værende på document for alltid (én ny per
                // besøk på et koblingsskjema i samme økt), se CODE_REVIEW.md
                // 2026-10-08 (bekreftet minnelekkasje).
                if (_lerretKoblet)
                {
                    await _module.InvokeVoidAsync("disableKeyboardShortcuts", _canvasRef);
                    await _module.InvokeVoidAsync("disableEditorSnarveier", _canvasRef);
                }
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    // ---------- Kabel med ledere og kabeljournal ----------
    // Lerretet er 16:13, så lederne må regnes med det forholdet for å stå vinkelrett på kabelen.
    private const double LerretAspekt = 13.0 / 16.0;

    private static string Inv(double v) => Math.Round(v, 3).ToString(CultureInfo.InvariantCulture);

    private static string Pts(List<KoblingsStrekPunkt> punkter) =>
        string.Join(" ", punkter.Select(p => $"{Inv(p.X)},{Inv(p.Y)}"));

    private static string? TomTilNull(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static KoblingsKabel.Vifte? KabelVifte(KoblingsStrek s)
    {
        if (!s.ErKabel)
        {
            return null;
        }
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [];
        return KoblingsKabel.LagVifte(punkter, KoblingsKabel.Les(s.LedereJson), LerretAspekt);
    }

    private static string KabelEtikett(KoblingsStrek s) =>
        $"{s.Navn} · {(string.IsNullOrWhiteSpace(s.KabelType) ? KoblingsKabel.MalNavn(KoblingsKabel.Les(s.LedereJson)) : s.KabelType)}";

    private List<KoblingsStrek> Kabler() =>
        _streker.Where(s => s.ErKabel)
            .OrderBy(s => KabelNummer(s.Navn) ?? int.MaxValue).ThenBy(s => s.Id)
            .ToList();

    private static int? KabelNummer(string? navn) =>
        navn is { Length: > 1 } && (navn[0] == 'K' || navn[0] == 'k') && int.TryParse(navn[1..], out var n) ? n : null;

    private string NesteKabelNavn() =>
        $"K{_streker.Select(s => KabelNummer(s.Navn) ?? 0).DefaultIfEmpty(0).Max() + 1}";

    private void GjorKabel(KoblingsStrek s)
    {
        s.LedereJson ??= KoblingsKabel.Skriv(KoblingsKabel.MedAntall([], 4));
        s.Navn ??= NesteKabelNavn();
        s.Farge = KoblingsKabel.KabelFarge;
        s.Tykkelse = 6;
        s.Stiplet = false;
    }

    private Task GjorTilStrek(KoblingsStrek strek) => EndreStrek(strek, s =>
    {
        s.LedereJson = null;
        s.Farge = KoblingsKomponentKatalog.Kabling[3].Farge;
        s.Tykkelse = 2;
    });

    private async Task VelgFlerlederKabel()
    {
        if (_valgtStrek is not null && !_tegnStrekModus)
        {
            await EndreStrek(_valgtStrek, GjorKabel);
            return;
        }

        _nyStrekKabel = true;
        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }

    private Task EndreLedere(KoblingsStrek strek, Func<List<KoblingsLeder>, List<KoblingsLeder>> endre) =>
        EndreStrek(strek, s => s.LedereJson = KoblingsKabel.Skriv(endre(KoblingsKabel.Les(s.LedereJson))));

    private Task EndreLeder(KoblingsStrek strek, int idx, Action<KoblingsLeder> endre) =>
        EndreLedere(strek, ledere =>
        {
            if (idx >= 0 && idx < ledere.Count)
            {
                endre(ledere[idx]);
            }
            return ledere;
        });

    private Task SettAntallLedere(KoblingsStrek strek, int antall) =>
        EndreLedere(strek, ledere => KoblingsKabel.MedAntall(ledere, antall, KoblingsKabel.ErPar(ledere)));

    private Task SettKabelMal(KoblingsStrek strek, string? navn)
    {
        var mal = KoblingsKabel.Maler.FirstOrDefault(m => m.Navn == navn);
        return mal is null
            ? Task.CompletedTask
            : EndreLedere(strek, ledere => KoblingsKabel.MedAntall(ledere, mal.Antall, mal.Par));
    }

    private Task SettLederFarge(KoblingsStrek strek, int idx, string? verdi) =>
        EndreLeder(strek, idx, l =>
        {
            var stiplet = verdi?.StartsWith('~') == true;
            var navn = stiplet ? verdi![1..] : verdi;
            if (KoblingsKabel.Farger.Any(f => f.Navn == navn))
            {
                l.Farge = navn!;
                l.Stiplet = stiplet;
            }
        });

    // Valgt leder (negativ id fra KoblingsKabel.LederId), eller null.
    private int? _valgtLederId;

    private int ValgtJsStrekId() =>
        _valgtStrek is null ? 0
        : _valgtLederId is { } l && KoblingsKabel.LesLederId(l)?.StrekId == _valgtStrek.Id ? l
        : _valgtStrek.Id;

    // Lagrer veien til én leder etter at den er dratt. Første punkt er der lederen
    // forlater kabelen; det regnes ut på nytt hver gang og lagres ikke.
    private bool SettLederVei(int lederId, string punkterJson)
    {
        if (KoblingsKabel.LesLederId(lederId) is not { } l)
        {
            return false;
        }
        var strek = _streker.FirstOrDefault(s => s.Id == l.StrekId && s.ErKabel);
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (strek is null || punkter.Count < 2)
        {
            return false;
        }
        var ledere = KoblingsKabel.Les(strek.LedereJson);
        if (l.Indeks < 0 || l.Indeks >= ledere.Count)
        {
            return false;
        }
        var vei = punkter.Skip(1).ToList();
        if (l.ErStart)
        {
            ledere[l.Indeks].Start = vei;
        }
        else
        {
            ledere[l.Indeks].Slutt = vei;
        }
        strek.LedereJson = KoblingsKabel.Skriv(ledere);
        return true;
    }

    private Task NullstillLederVeier(KoblingsStrek strek) =>
        EndreLedere(strek, ledere =>
        {
            foreach (var l in ledere)
            {
                l.Start = null;
                l.Slutt = null;
            }
            return ledere;
        });

    // ---------- Arbeidsflate (forslag A) ----------
    private bool _visKomponentSkuff;
    private bool _visJournal;
    private bool _visInnstillinger;

    private async Task StartRedigering()
    {
        await ToggleRedigerModus();
        // Et tomt skjema åpner med komponentene fremme, så man vet hvor man starter.
        _visKomponentSkuff = _symboler.Count == 0;
        _visJournal = false;
        _visInnstillinger = false;
    }

    private async Task FerdigRedigering()
    {
        await Lagre();
        _visKomponentSkuff = false;
        _visJournal = false;
        _visInnstillinger = false;
        if (_redigerModus)
        {
            await ToggleRedigerModus();
        }
    }

    private async Task VelgVanligStrek()
    {
        _nyStrekKabel = false;
        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }
}
