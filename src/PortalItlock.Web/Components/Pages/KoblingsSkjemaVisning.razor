@page "/koblingsskjema/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject KoblingsSkjemaPdfService PdfService
@inject LagretPdfService LagretPdfService

<PageTitle>@(_skjema?.Navn is null ? "Koblingsskjema" : _skjema.Navn)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke koblingsskjemaet. Det kan være slettet.</p>
}
else if (_skjema is not null)
{
    @if (_skjema.Dor is not null)
    {
        <a class="back-link" href="@($"/dor/{_skjema.Dor.Id}")"><Icon Name="arrow-left" />Tilbake til dør @_skjema.Dor.Dornummer</a>
    }
    else
    {
        <a class="back-link" href="@($"/guide/kobling/{_skjema.KategoriId}")"><Icon Name="arrow-left" />Tilbake til @(_skjema.Kategori?.Navn ?? "kobling")</a>
    }
    <SideKort Nokkel="koblingsskjema">
    @if (!_redigerModus)
    {
        <h1 class="ks-tittel">@_skjema.Navn</h1>
    }

    @if (_skjema.Dor is not null)
    {
        <p class="kobling-prosjekt-lenke">
            Prinsippskisse for dør: <a href="@($"/dor/{_skjema.Dor.Id}")">@_skjema.Dor.Dornummer</a>
        </p>
    }

    @if (!_redigerModus)
    {
    <div class="ks-faner">
        <button type="button" class="ks-fane @(_fane == "rediger" ? "ks-fane-aktiv" : "")" @onclick='@(() => ByttFane("rediger"))'>Rediger koblingsskjema</button>
        <button type="button" class="ks-fane @(_fane == "pdf" ? "ks-fane-aktiv" : "")" @onclick="VisPdfFane">Forhåndsvisning PDF</button>
        <button type="button" class="ks-fane @(_fane == "lagrede" ? "ks-fane-aktiv" : "")" @onclick='@(() => ByttFane("lagrede"))'>Lagrede PDF-er</button>
    </div>
    }

    @if (_fane == "lagrede")
    {
        <div class="ks-fane-innhold">
            <LagredePdfListe Pdfer="_lagredePdfer" />
        </div>
    }
    else if (_fane == "pdf")
    {
        <div class="ks-fane-innhold">
            <p class="section-hint">Forhåndsvisningen åpnes i et eget vindu. Lukk den for å komme tilbake hit.</p>
            <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Åpne forhåndsvisning</button>
        </div>
    }
    else
    {

    <AuthorizeView Roles="Admin">
        @if (_redigerModus)
        {
            var skjemaT = _skjema!;
            <div class="ksa-topp">
                <input class="ksa-navn" value="@skjemaT.Navn" aria-label="Navn på skjemaet" title="Klikk for å endre navnet"
                       @onchange="@(e => LagreInnstilling(s => s.Navn = (string?)e.Value is { Length: > 0 } v ? v : s.Navn))" />
                <span class="ksa-status" title="Endringer lagres automatisk"><Icon Name="check" />Lagret</span>
                <span class="ksa-mellom"></span>
                <button type="button" class="ksa-ikon" title="Angre (Ctrl+Z)" disabled="@(_undoStack.Count == 0)" @onclick="Angre"><Icon Name="arrow-left" /></button>
                <button type="button" class="ksa-ikon" title="Gjør om (Ctrl+Y)" disabled="@(_redoStack.Count == 0)" @onclick="GjorOm"><Icon Name="arrow-right" /></button>
                <div class="ksa-zoom">
                    <button type="button" title="Zoom ut" disabled="@(_zoom <= MinZoom)" @onclick="ZoomUt"><Icon Name="minus" /></button>
                    <button type="button" class="ksa-zoom-verdi" title="Tilbake til 100 %" @onclick="NullstillZoom">@_zoom&nbsp;%</button>
                    <button type="button" title="Zoom inn" disabled="@(_zoom >= MaxZoom)" @onclick="ZoomInn"><Icon Name="plus" /></button>
                </div>
                <div class="ksa-innst-wrap">
                    <button type="button" class="ksa-ikon @(_visInnstillinger ? "pa" : "")" title="Skjemainnstillinger" @onclick="@(() => _visInnstillinger = !_visInnstillinger)"><Icon Name="settings" /></button>
                    @if (_visInnstillinger)
                    {
                        <div class="ksa-innst">
                            <div class="ksa-innst-hode"><b>Skjemainnstillinger</b><button type="button" class="ksa-ikon" title="Lukk" @onclick="@(() => _visInnstillinger = false)"><Icon Name="x" /></button></div>
                            <label class="ks-felt">
                                <span>Koble til prosjekt</span>
                                <select @bind="_valgtProsjektId" @bind:after="LagreProsjektKobling">
                                    <option value="">(ingen kobling)</option>
                                    @foreach (var p in _prosjekter)
                                    {
                                        <option value="@p.Id">@p.Navn</option>
                                    }
                                </select>
                            </label>
                            <label class="ks-felt">
                                <span>Beskrivelse</span>
                                <textarea rows="2" value="@skjemaT.Beskrivelse" @onchange="@(e => LagreInnstilling(s => s.Beskrivelse = (string?)e.Value))"></textarea>
                            </label>
                            <label class="ks-felt">
                                <span>Stil</span>
                                <select value="@skjemaT.Stil" @onchange="@(e => LagreInnstilling(s => s.Stil = (string?)e.Value ?? "Standard"))">
                                    @foreach (var stil in Stiler)
                                    {
                                        <option value="@stil">@stil</option>
                                    }
                                </select>
                            </label>
                            <div class="ks-bryter-liste">
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.VisRutenett" @onchange="@(e => LagreInnstilling(s => s.VisRutenett = (bool)e.Value!))" /><span>Vis rutenett</span></label>
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.SnapTilRutenett" @onchange="@(e => LagreInnstilling(s => s.SnapTilRutenett = (bool)e.Value!))" /><span>Fest til rutenett</span></label>
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.VisKomponentnavn" @onchange="@(e => LagreInnstilling(s => s.VisKomponentnavn = (bool)e.Value!))" /><span>Vis komponentnavn</span></label>
                            </div>
                            <div class="ksa-innst-knapper">
                                <button type="button" class="ks-knapp ks-knapp-hvit" disabled="@(_streker.Count == 0)" @onclick="RettOppAlleStreker"><Icon Name="grid" />Rett opp streker</button>
                                <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="DupliserSkjema"><Icon Name="box" />Dupliser skjema</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Forhåndsvis PDF</button>
                <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="FerdigRedigering"><Icon Name="check" />Ferdig</button>
            </div>
        }
        else
        {
            <div class="ks-verktoylinje">
                <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="StartRedigering"><Icon Name="edit" />Rediger</button>
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="saved-hint">@_savedMessage</span>
                }
            </div>
        }
    </AuthorizeView>

    <div class="kobling-layout @(_fullskjerm ? "kobling-layout-bred" : "") @(_redigerModus ? "ksa" : "")">
        @if (_redigerModus)
        {
            <div class="ksa-skinne" role="toolbar" aria-label="Verktøy">
                <button type="button" class="@(_visKomponentSkuff ? "pa" : "")" title="Komponenter" @onclick="@(() => { _visKomponentSkuff = !_visKomponentSkuff; _visLeggTilMeny = false; })"><Icon Name="grid-icon" /><span>Kompon.</span></button>
                <button type="button" class="@(!_tegnStrekModus ? "pa" : "")" title="Velg og flytt (V)" @onclick="VelgVerktoy"><Icon Name="grip" /><span>Velg</span></button>
                <button type="button" class="@(_tegnStrekModus && _nyStrekKabel ? "pa" : "")" title="Kabel med ledere" @onclick="VelgFlerlederKabel"><Icon Name="krets-sammenlop" /><span>Kabel</span></button>
                <button type="button" class="@(_tegnStrekModus && !_nyStrekKabel ? "pa" : "")" title="Strek (S)" @onclick="VelgVanligStrek"><Icon Name="minus" /><span>Strek</span></button>
                <button type="button" title="Tekst (T)" @onclick="@(() => LeggTilFigur(KoblingsElementType.Tekstboks))"><Icon Name="file-text" /><span>Tekst</span></button>
                <div class="ksa-figur-wrap">
                    <button type="button" class="@(_visLeggTilMeny ? "pa" : "")" title="Figurer og egne bilder" @onclick="@(() => { _visLeggTilMeny = !_visLeggTilMeny; _visKomponentSkuff = false; })"><Icon Name="plus" /><span>Mer</span></button>
                    @if (_visLeggTilMeny)
                    {
                        <div class="kobling-legg-til-panel ksa-mer">
                            <div class="kobling-mine-komponenter">
                                <span>Mine bilder</span>
                                @if (_bibliotek.Count > 0)
                                {
                                    <div class="kobling-bibliotek-grid">
                                        @foreach (var bb in _bibliotek)
                                        {
                                            <button type="button" class="kobling-bibliotek-item" title="@bb.Navn" @onclick="@(() => LeggTilFraBibliotek(bb))">
                                                <img src="@($"/koblingsbibliotek/{bb.Id}")" alt="@bb.Navn" />
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="kobling-bibliotek-tom">Ingen egne bilder lastet opp ennå.</p>
                                }
                                <label class="kobling-legg-til-bilde">
                                    Last opp nytt bilde
                                    <InputFile OnChange="OnSymbolFilValgt" accept="image/*" />
                                </label>
                            </div>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Rektangel))">Rektangel</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Sirkel))">Sirkel</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Linje))">Linje</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Pil))">Pil</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Punkt))">Punkter</button>
                        </div>
                    }
                </div>
                <span class="ksa-skille"></span>
                <button type="button" title="Slett valgte (Delete)" disabled="@(_valgteSymbolIds.Count == 0 && _selectedSymbol is null && _valgtStrek is null)" @onclick="SlettValgtFraVerktoylinje"><Icon Name="trash" /><span>Slett</span></button>
            </div>
            @if (_visKomponentSkuff)
            {
            <aside class="ks-palett ksa-skuff">
                <div class="ksa-skuff-hode"><b>Komponenter</b><button type="button" class="ksa-ikon" title="Lukk" @onclick="@(() => _visKomponentSkuff = false)"><Icon Name="x" /></button></div>
                <div class="ks-palett-sok">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk komponent" aria-label="Søk komponent"
                           @bind="_palettSok" @bind:event="oninput" />
                </div>

                @if (FiltrerteGrupper.Count == 0)
                {
                    <div class="ks-palett-seksjon">
                        <p class="ks-palett-tom">Ingen komponenter matcher søket.</p>
                    </div>
                }
                @foreach (var gruppe in FiltrerteGrupper)
                {
                    <div class="ks-palett-seksjon">
                        <h3 class="ks-palett-tittel">@gruppe.Tittel</h3>
                        <div class="ks-palett-grid">
                            @foreach (var k in gruppe.Komponenter)
                            {
                                <button type="button" class="ks-palett-item" title="@($"Dra inn eller klikk for å legge til {k.Navn}")"
                                        draggable="true" @ondragstart="@(() => _draKomponent = k)"
                                        @onclick="@(() => LeggTilKomponent(k))">
                                    @if (k.Bilde is not null)
                                    {
                                        <span class="ks-palett-ikon ks-palett-tegning"><img src="@k.Bilde" alt="" draggable="false" /></span>
                                    }
                                    else
                                    {
                                        <span class="ks-palett-ikon"><Icon Name="@k.Ikon" /></span>
                                    }
                                    <span class="ks-palett-navn">@k.Navn</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="ks-palett-seksjon">
                    <h3 class="ks-palett-tittel">Kabling</h3>
                    <ul class="ks-kabling-liste">
                        <li>
                            <button type="button"
                                    class="ks-kabling-item @(_nyStrekKabel ? "ks-kabling-item-aktiv" : "")"
                                    title="Tegn en kabel som deler seg i fargede ledere i hver ende" @onclick="VelgFlerlederKabel">
                                <svg width="26" height="10" aria-hidden="true">
                                    <line x1="9" y1="5" x2="25" y2="5" stroke="#1d1d1b" stroke-width="4" />
                                    <line x1="1" y1="2" x2="9" y2="5" stroke="#d62828" stroke-width="1.4" />
                                    <line x1="1" y1="5" x2="9" y2="5" stroke="#1f6fd1" stroke-width="1.4" />
                                    <line x1="1" y1="8" x2="9" y2="5" stroke="#1e9e4a" stroke-width="1.4" />
                                </svg>
                                <span>Kabel med ledere</span>
                            </button>
                        </li>
                        @foreach (var kabel in KoblingsKomponentKatalog.Kabling)
                        {
                            <li>
                                <button type="button"
                                        class="ks-kabling-item @(!_nyStrekKabel && _nyStrekFarge == kabel.Farge && _nyStrekStiplet == kabel.Stiplet ? "ks-kabling-item-aktiv" : "")"
                                        title="@($"Tegn {kabel.Navn}")" @onclick="@(() => VelgKabelType(kabel))">
                                    <svg width="26" height="10" aria-hidden="true">
                                        <line x1="1" y1="5" x2="25" y2="5" stroke="@kabel.Farge" stroke-width="2.5"
                                              stroke-dasharray="@(kabel.Stiplet ? "4,3" : null)" />
                                    </svg>
                                    <span>@kabel.Navn</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </aside>
            }
        }

        <div class="ks-lerret-kolonne">
            @if (!_redigerModus)
            {
            <div class="ks-lerret-verktoy">
                <div class="ks-zoom">
                    <button type="button" class="ks-ikonknapp" title="Zoom ut" disabled="@(_zoom <= MinZoom)" @onclick="ZoomUt"><Icon Name="minus" /></button>
                    <button type="button" class="ks-zoom-verdi" title="Tilbake til 100 %" @onclick="NullstillZoom">@_zoom&nbsp;%</button>
                    <button type="button" class="ks-ikonknapp" title="Zoom inn" disabled="@(_zoom >= MaxZoom)" @onclick="ZoomInn"><Icon Name="plus" /></button>
                </div>

                <button type="button" class="ks-ikonknapp @(_fullskjerm ? "ks-ikonknapp-aktiv" : "")"
                        title="@(_fullskjerm ? "Avslutt full bredde" : "Full bredde")" @onclick="@(() => _fullskjerm = !_fullskjerm)">
                    <Icon Name="@(_fullskjerm ? "minimize" : "maximize")" />
                </button>

                <div class="ks-nedtrekk-wrap">
                    <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="@(() => { _visRutenettMeny = !_visRutenettMeny; _visFlereValg = false; })">
                        <Icon Name="grid" />Rutenett<Icon Name="chevron-down" />
                    </button>
                    @if (_visRutenettMeny && _skjema is not null)
                    {
                        <div class="ks-nedtrekk-panel">
                            <label class="ks-bryter">
                                <input type="checkbox" checked="@_skjema.VisRutenett" @onchange="@(e => LagreInnstilling(s => s.VisRutenett = (bool)e.Value!))" />
                                <span>Vis rutenett</span>
                            </label>
                            <label class="ks-bryter">
                                <input type="checkbox" checked="@_skjema.SnapTilRutenett" @onchange="@(e => LagreInnstilling(s => s.SnapTilRutenett = (bool)e.Value!))" />
                                <span>Fest til rutenett</span>
                            </label>
                        </div>
                    }
                </div>

                <div class="ks-nedtrekk-wrap">
                    <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="@(() => { _visFlereValg = !_visFlereValg; _visRutenettMeny = false; })">
                        <Icon Name="more-vertical" />Flere valg
                    </button>
                    @if (_visFlereValg)
                    {
                        <div class="ks-nedtrekk-panel">
                            <button type="button" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Forhåndsvis PDF</button>
                            <button type="button" @onclick="DupliserSkjema"><Icon Name="box" />Dupliser skjema</button>
                            <button type="button" disabled="@(_valgteSymbolIds.Count == 0)" @onclick="DupliserValgte"><Icon Name="plus" />Dupliser valgte</button>
                            <button type="button" @onclick="AvbrytValg"><Icon Name="x" />Fjern markering</button>
                        </div>
                    }
                </div>

                <span class="ks-lerret-info">@_symboler.Count komponenter · @_streker.Count streker</span>
            </div>

            }

            @if (_redigerModus && (_tegnStrekModus || _valgtStrek is not null))
            {
                <p class="ksa-hint">
                    @if (_tegnStrekModus)
                    {
                        <span>Klikk der @(_nyStrekKabel ? "kabelen" : "streken") skal starte og svinge, klikk et blått punkt for å koble. Esc avslutter.</span>
                    }
                    else if (_valgtStrek is { ErKabel: true })
                    {
                        <span>Klikk en farget leder og dra den dit den skal kobles.</span>
                    }
                    else
                    {
                        <span>Dra knekkpunktene for å flytte svinger. Dobbeltklikk et knekkpunkt for å fjerne det.</span>
                    }
                </p>
            }

            <div class="kobling-canvas-wrap" @ref="_canvasWrapRef">
                <div class="kobling-canvas @(_redigerModus && !_tegnStrekModus ? "kobling-canvas-rediger" : "") @(_tegnStrekModus ? "ks-tegner" : "") @(_skjema?.VisRutenett == true ? "ks-rutenett" : "")"
                     style="width:@(_zoom.ToString(CultureInfo.InvariantCulture))%"
                     data-rediger="@(_redigerModus ? "1" : "0")"
                     @ondragover="@(() => { })" @ondragover:preventDefault="true"
                     @ondrop="DroppKomponent"
                     @ref="_canvasRef">
                    <svg class="kobling-strek-svg-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                        @foreach (var s in _streker)
                        {
                            var vifte = KabelVifte(s);
                            <g @key="s.Id">
                                @if (vifte is not null)
                                {
                                    @* Den tykke kabelen skjules i endene, der lederne tar over. *@
                                    <mask id="ks-km-@s.Id" maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
                                        <rect x="-10" y="-10" width="120" height="120" fill="#fff" />
                                        @foreach (var e in new[] { vifte.Start, vifte.Slutt })
                                        {
                                            <ellipse cx="@Inv(e.Senter.X)" cy="@Inv(e.Senter.Y)" rx="@Inv(e.Rx)" ry="@Inv(e.Ry)" fill="#000" />
                                        }
                                    </mask>
                                    <polyline data-strekid="@s.Id" points="@PunkterTilSvgPoints(s.PunkterJson)" fill="none"
                                              class="@(_valgtStrek?.Id == s.Id ? "ks-strek-valgt" : null)"
                                              stroke="@KoblingsKabel.KabelFarge" stroke-width="7"
                                              stroke-linejoin="round" stroke-linecap="round"
                                              mask="url(#ks-km-@s.Id)"
                                              vector-effect="non-scaling-stroke" />
                                    @foreach (var l in vifte.Ledere)
                                    {
                                        var pts = Pts(l.Punkter);
                                        var lederId = KoblingsKabel.LederId(s.Id, l.ErStart, l.Indeks);
                                        @if (l.Leder.Farge == "Hvit")
                                        {
                                            <polyline points="@pts" fill="none" stroke="#9a948c" stroke-width="3.6"
                                                      stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                                        }
                                        <polyline points="@pts" fill="none" stroke="@KoblingsKabel.Hex(l.Leder.Farge)" stroke-width="2.2"
                                                  data-strekid="@lederId" class="@(_valgtLederId == lederId ? "ks-strek-valgt" : null)"
                                                  stroke-linejoin="round" stroke-linecap="round"
                                                  stroke-dasharray="@(l.Leder.Stiplet ? "4,3" : null)"
                                                  vector-effect="non-scaling-stroke" />
                                    }
                                }
                                else
                                {
                                    <polyline data-strekid="@s.Id" points="@PunkterTilSvgPoints(s.PunkterJson)" fill="none"
                                              class="@(_valgtStrek?.Id == s.Id ? "ks-strek-valgt" : null)"
                                              stroke="@s.Farge" stroke-width="@s.Tykkelse"
                                              stroke-linejoin="round" stroke-linecap="round"
                                              stroke-dasharray="@(s.Stiplet ? "6,4" : null)"
                                              vector-effect="non-scaling-stroke" />
                                }
                            </g>
                        }
                    </svg>

                    @foreach (var s in _streker.Where(s => s.ErKabel && !string.IsNullOrWhiteSpace(s.Navn)))
                    {
                        var merke = KabelVifte(s)?.Merke;
                        if (merke is not null)
                        {
                            <div class="ks-kabel-merke" style="left:@Inv(merke.X)%; top:@Inv(merke.Y)%">@KabelEtikett(s)</div>
                        }
                    }

                    @foreach (var symbol in _symboler.OrderBy(s => s.ZIndex).ThenBy(s => s.Id))
                    {
                        <KoblingsSymbolElement @key="symbol.Id" Symbol="symbol"
                                                Selected="@(_valgteSymbolIds.Contains(symbol.Id))"
                                                VisNavn="@(_skjema?.VisKomponentnavn ?? true)"
                                                VisResizeHandle="@(_redigerModus && !_tegnStrekModus && !symbol.ErLaast)" />
                    }

                    @* Knekkpunkter, tilkoblingspunkter og hjelpelinjer - innholdet tegnes av koblingsskjema.js. *@
                    <svg class="ks-ui-lag" aria-hidden="true"></svg>

                </div>
            </div>

            @{
                var kabler = Kabler();
            }
            @if (_redigerModus && !_visJournal)
            {
                <button type="button" class="ksa-journal-knapp" @onclick="@(() => _visJournal = true)"><Icon Name="list" />Kabeljournal (@kabler.Count)</button>
            }
            @if (_redigerModus ? _visJournal : kabler.Count > 0)
            {
                <section class="ks-journal @(_redigerModus ? "ksa-ark" : "")">
                    @if (_redigerModus)
                    {
                        <button type="button" class="ksa-ikon ksa-ark-lukk" title="Lukk kabeljournalen" @onclick="@(() => _visJournal = false)"><Icon Name="x" /></button>
                    }
                    <div class="ks-journal-hode">
                        <h2>Kabeljournal</h2>
                        <span>Én rad = én leder. Les fra venstre: klemme → leder → hvor den skal.</span>
                    </div>
                    @if (kabler.Count == 0)
                    {
                        <p class="ks-journal-tom">Ingen kabler ennå. Velg <b>Kabel med ledere</b> under Kabling og tegn kabelen mellom to komponenter – lederne havner her automatisk.</p>
                    }
                    @foreach (var k in kabler)
                    {
                        var ledere = KoblingsKabel.Les(k.LedereJson);
                        <div class="ks-journal-kabel @(_valgtStrek?.Id == k.Id ? "valgt" : "")">
                            <div class="ks-journal-kabelnavn">
                                <b>@(string.IsNullOrWhiteSpace(k.Navn) ? "Kabel" : k.Navn)</b>
                                <span>@(string.IsNullOrWhiteSpace(k.KabelType) ? KoblingsKabel.MalNavn(ledere) : $"{k.KabelType} · {KoblingsKabel.MalNavn(ledere)}")</span>
                                @if (_redigerModus)
                                {
                                    <button type="button" class="ks-journal-velg" @onclick="@(() => VelgStrek(k))">@(_valgtStrek?.Id == k.Id ? "Valgt" : "Velg kabel")</button>
                                }
                            </div>
                            <div class="ks-journal-tabell-wrap">
                                <table class="ks-journal-tabell">
                                    <thead>
                                        <tr><th class="kl">Klemme</th><th>Funksjon</th><th>Leder</th><th>Kobles til</th><th>Merknad</th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < ledere.Count; i++)
                                        {
                                            var idx = i;
                                            var l = ledere[i];
                                            <tr>
                                                @if (_redigerModus)
                                                {
                                                    <td class="kl"><input value="@l.Klemme" placeholder="–" @onchange="@(e => EndreLeder(k, idx, x => x.Klemme = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td><input value="@l.Funksjon" placeholder="Funksjon" @onchange="@(e => EndreLeder(k, idx, x => x.Funksjon = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td class="ld"><span class="ks-leder-prikk @(l.Stiplet ? "stiplet" : "")" style="--f:@KoblingsKabel.Hex(l.Farge)"></span>@KoblingsKabel.LederTekst(l)</td>
                                                    <td><input value="@l.Til" placeholder="Hvor den skal" @onchange="@(e => EndreLeder(k, idx, x => x.Til = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td><input value="@l.Merknad" placeholder="" @onchange="@(e => EndreLeder(k, idx, x => x.Merknad = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                }
                                                else
                                                {
                                                    <td class="kl">@(string.IsNullOrWhiteSpace(l.Klemme) ? "–" : l.Klemme)</td>
                                                    <td>@l.Funksjon</td>
                                                    <td class="ld"><span class="ks-leder-prikk @(l.Stiplet ? "stiplet" : "")" style="--f:@KoblingsKabel.Hex(l.Farge)"></span>@KoblingsKabel.LederTekst(l)</td>
                                                    <td>@l.Til</td>
                                                    <td class="mk">@l.Merknad</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>

        @if (_redigerModus && (_valgteSymbolIds.Count > 1 || _valgtStrek is not null || _tegnStrekModus || _selectedSymbol is not null))
        {
            <div class="kobling-side-panel ksa-panel">
                @if (_valgteSymbolIds.Count > 1)
                {
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>@_valgteSymbolIds.Count valgt</h2>
                            <button type="button" class="cancel-button" @onclick="AvbrytValg">Lukk</button>
                        </div>
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="save-button" @onclick="DupliserValgte">Dupliser valgte</button>
                            <button type="button" class="delete-button" @onclick="SlettValgte">Slett valgte</button>
                        </div>
                    </div>
                }
                else if (_valgtStrek is { ErKabel: true })
                {
                    var kabelStrek = _valgtStrek;
                    var ledere = KoblingsKabel.Les(kabelStrek.LedereJson);
                    var malNavn = KoblingsKabel.MalNavn(ledere);
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>Kabel</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _valgtStrek = null)">Lukk</button>
                        </div>
                        <label>
                            Navn på tegningen
                            <input value="@kabelStrek.Navn" placeholder="f.eks. K1" @onchange="@(e => EndreStrek(kabelStrek, s => s.Navn = TomTilNull(e.Value?.ToString())))" />
                        </label>
                        <label>
                            Kabelbetegnelse
                            <input value="@kabelStrek.KabelType" placeholder="f.eks. 6 PAR 0,6 PT HF" @onchange="@(e => EndreStrek(kabelStrek, s => s.KabelType = TomTilNull(e.Value?.ToString())))" />
                        </label>
                        <label>
                            Antall ledere
                            <select value="@malNavn" @onchange="@(e => SettKabelMal(kabelStrek, e.Value?.ToString()))">
                                @if (!KoblingsKabel.Maler.Any(m => m.Navn == malNavn))
                                {
                                    <option value="@malNavn">@malNavn (egen)</option>
                                }
                                @foreach (var m in KoblingsKabel.Maler)
                                {
                                    <option value="@m.Navn">@m.Navn</option>
                                }
                            </select>
                        </label>
                        <div class="ks-antall">
                            <button type="button" title="Én leder mindre" disabled="@(ledere.Count <= 1)" @onclick="@(() => SettAntallLedere(kabelStrek, ledere.Count - 1))">−</button>
                            <span>@ledere.Count @(ledere.Count == 1 ? "leder" : "ledere")</span>
                            <button type="button" title="Én leder til" disabled="@(ledere.Count >= KoblingsKabel.MaksLedere)" @onclick="@(() => SettAntallLedere(kabelStrek, ledere.Count + 1))">+</button>
                        </div>
                        <div class="ks-ledere">
                            @for (var i = 0; i < ledere.Count; i++)
                            {
                                var idx = i;
                                var l = ledere[i];
                                <div class="ks-leder">
                                    <span class="ks-leder-nr" style="--f:@KoblingsKabel.Hex(l.Farge)">@(i + 1)</span>
                                    <select aria-label="@($"Farge leder {i + 1}")" value="@((l.Stiplet ? "~" : "") + l.Farge)"
                                            @onchange="@(e => SettLederFarge(kabelStrek, idx, e.Value?.ToString()))">
                                        @foreach (var f in KoblingsKabel.Farger)
                                        {
                                            <option value="@f.Navn">@f.Navn</option>
                                        }
                                        @foreach (var f in KoblingsKabel.Farger)
                                        {
                                            <option value="@("~" + f.Navn)">@f.Navn stiplet</option>
                                        }
                                    </select>
                                    <input aria-label="@($"Funksjon leder {i + 1}")" value="@l.Funksjon" placeholder="Funksjon"
                                           @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.Funksjon = e.Value?.ToString()?.Trim() ?? ""))" />
                                </div>
                            }
                        </div>
                        <p class="ks-panel-hint">Klikk en leder på tegningen og dra den dit den skal kobles. Klemme og hvor hver leder skal fyller du ut i kabeljournalen under skjemaet.</p>
                        @if (ledere.Any(l => l.Start is not null || l.Slutt is not null))
                        {
                            <button type="button" class="cancel-button" @onclick="@(() => NullstillLederVeier(kabelStrek))">Legg lederne tilbake i vifte</button>
                        }
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="cancel-button" @onclick="@(() => RettOppStrek(kabelStrek))">Rett opp</button>
                            <button type="button" class="cancel-button" @onclick="@(() => GjorTilStrek(kabelStrek))">Vanlig strek</button>
                            <button type="button" class="delete-button" @onclick="@(() => SlettStrek(kabelStrek))">Slett kabel</button>
                        </div>
                    </div>
                }
                else if (_valgtStrek is not null)
                {
                    var strek = _valgtStrek;
                    var antallSvinger = Math.Max(0, (JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(strek.PunkterJson)?.Count ?? 2) - 2);
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>Strek</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _valgtStrek = null)">Lukk</button>
                        </div>
                        <label>
                            Kabeltype
                            <select value="@KabelIndeks(strek)" @onchange="@(e => SettKabelPaStrek(strek, e.Value?.ToString()))">
                                <option value="">Egendefinert</option>
                                <option value="kabel">Kabel med ledere</option>
                                @for (var i = 0; i < KoblingsKomponentKatalog.Kabling.Count; i++)
                                {
                                    var kabel = KoblingsKomponentKatalog.Kabling[i];
                                    <option value="@i">@kabel.Navn</option>
                                }
                            </select>
                        </label>
                        <label>
                            Farge
                            <input type="color" value="@strek.Farge" @onchange="@(e => EndreStrek(strek, s => s.Farge = e.Value?.ToString() ?? s.Farge))" />
                        </label>
                        <label>
                            Tykkelse
                            <select value="@strek.Tykkelse" @onchange="@(e => EndreStrek(strek, s => s.Tykkelse = int.TryParse(e.Value?.ToString(), out var t) ? t : s.Tykkelse))">
                                <option value="1">Tynn</option>
                                <option value="2">Normal</option>
                                <option value="3">Tykk</option>
                                <option value="5">Ekstra tykk</option>
                            </select>
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" checked="@strek.Stiplet" @onchange="@(e => EndreStrek(strek, s => s.Stiplet = (bool)e.Value!))" /> Stiplet
                        </label>
                        <p class="ks-panel-hint">@antallSvinger @(antallSvinger == 1 ? "sving" : "svinger"). Dra knekkpunktene på lerretet for å flytte svingene.</p>
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="cancel-button" @onclick="@(() => RettOppStrek(strek))">Rett opp</button>
                            <button type="button" class="delete-button" @onclick="@(() => SlettStrek(strek))">Slett strek</button>
                        </div>
                    </div>
                }
                else if (_tegnStrekModus)
                {
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>@(_nyStrekKabel ? "Ny kabel" : "Ny strek")</h2>
                        </div>
                        <label>
                            Farge
                            <input type="color" @bind="_nyStrekFarge" @bind:after="StartStrekPaNytt" />
                        </label>
                        <label>
                            Tykkelse
                            <select @bind="_nyStrekTykkelse" @bind:after="StartStrekPaNytt">
                                <option value="1">Tynn</option>
                                <option value="2">Normal</option>
                                <option value="3">Tykk</option>
                                <option value="5">Ekstra tykk</option>
                            </select>
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_nyStrekStiplet" @bind:after="StartStrekPaNytt" /> Stiplet
                        </label>
                        <p class="ks-panel-hint">Velg kabeltype i paletten til venstre for riktig farge.</p>
                    </div>
                }
                else if (_selectedSymbol is not null)
                {
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>@_selectedSymbol.ElementType.ToString()</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _selectedSymbol = null)">Lukk</button>
                        </div>

                        @if (_selectedSymbol.ElementType == KoblingsElementType.Tekstboks)
                        {
                            <label>
                                Tekst
                                <textarea rows="2" @bind="_selectedSymbol.Tekst" @bind:event="oninput" @bind:after="LagreSymbol"></textarea>
                            </label>
                            <label>
                                Skriftstørrelse (px)
                                <input type="number" min="8" max="72" @bind="_selectedSymbol.FontStorrelse" @bind:after="LagreSymbol" />
                            </label>
                            <label>
                                Farge
                                <input type="color" @bind="_selectedSymbol.Farge" @bind:after="LagreSymbol" />
                            </label>
                        }
                        else
                        {
                            <label>
                                Navn
                                <input @bind="_selectedSymbol.Navn" @bind:event="oninput" @bind:after="LagreSymbol" />
                            </label>
                        }

                        @if (_selectedSymbol.ElementType is KoblingsElementType.Rektangel or KoblingsElementType.Sirkel or KoblingsElementType.Linje or KoblingsElementType.Pil)
                        {
                            <label>
                                Farge
                                <input type="color" @bind="_selectedSymbol.Farge" @bind:after="LagreSymbol" />
                            </label>
                            <label>
                                Strøkbredde
                                <input type="number" min="1" max="20" @bind="_selectedSymbol.Strokbredde" @bind:after="LagreSymbol" />
                            </label>
                            @if (_selectedSymbol.ElementType is KoblingsElementType.Rektangel or KoblingsElementType.Sirkel)
                            {
                                <label class="checkbox-row">
                                    <input type="checkbox" @bind="_selectedSymbol.Fylt" @bind:after="LagreSymbol" /> Fylt
                                </label>
                            }
                        }
                        else if (_selectedSymbol.ElementType == KoblingsElementType.Punkt)
                        {
                            <label>
                                Farge
                                <input type="color" @bind="_selectedSymbol.Farge" @bind:after="LagreSymbol" />
                            </label>
                        }

                        <label>
                            Bredde (%)
                            <input type="number" min="2" max="100" @bind="_selectedSymbol.Bredde" @bind:after="LagreSymbol" />
                        </label>
                        <label>
                            Høyde (%)
                            <input type="number" min="2" max="100" @bind="_selectedSymbol.Hoyde" @bind:after="LagreSymbol" />
                        </label>

                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="cancel-button" @onclick="SendBakerst">Send bakerst</button>
                            <button type="button" class="cancel-button" @onclick="SendFremst">Send fremst</button>
                            <button type="button" class="cancel-button" @onclick="ToggleErLaast">@(_selectedSymbol.ErLaast ? "Lås opp" : "Lås")</button>
                        </div>

                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="delete-button" @onclick="SlettSymbol">Slett</button>
                        </div>
                    </div>
                }

            </div>
        }
    </div>

    }

    </SideKort>
    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av koblingsskjema" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreKoblingsskjemaPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int Id { get; set; }

    private KoblingsSkjema? _skjema;
    private bool _notFound;
    private int? _loadedId;
    private string? _savedMessage;

    private List<KoblingsSymbol> _symboler = [];
    private List<KoblingsStrek> _streker = [];
    private List<KoblingsSymbolBibliotek> _bibliotek = [];
    private List<Prosjekt> _prosjekter = [];
    private string _valgtProsjektId = "";
    private KoblingsSymbol? _selectedSymbol;
    private KoblingsStrek? _valgtStrek;
    private KoblingsKomponent? _draKomponent;
    private readonly HashSet<int> _valgteSymbolIds = [];
    private string? _pdfPreviewUrl;
    private List<LagretPdf> _lagredePdfer = [];
    private string? _pdfSavedMessage;

    private sealed class KoblingsSnapshot
    {
        public required List<KoblingsSymbol> Symboler { get; init; }
        public required List<KoblingsStrek> Streker { get; init; }
    }

    private readonly List<KoblingsSnapshot> _undoStack = [];
    private readonly List<KoblingsSnapshot> _redoStack = [];
    private const int MaxUndoTrinn = 50;

    private bool _redigerModus;
    private bool _tegnStrekModus;
    private bool _visLeggTilMeny;

    // Fanene øverst: "rediger" (editoren), "pdf" (forhåndsvisning) og
    // "lagrede" (tidligere lagrede PDF-er).
    private string _fane = "rediger";
    private bool _lerretKoblet;

    private bool _visRutenettMeny;
    private bool _visFlereValg;
    private bool _fullskjerm;
    private string _palettSok = "";

    // Zoom i prosent av lerretsbredden. 100 % = lerretet fyller kolonnen,
    // altså akkurat slik det var før zoom ble innført.
    private const int MinZoom = 50;
    private const int MaxZoom = 300;
    private int _zoom = 100;

    private static readonly string[] Stiler = ["Standard", "Teknisk", "Minimal", "Presentasjon"];

    private List<KoblingsKomponentGruppe> FiltrerteGrupper =>
        string.IsNullOrWhiteSpace(_palettSok)
            ? KoblingsKomponentKatalog.Grupper
            : KoblingsKomponentKatalog.Grupper
                .Select(g => g with
                {
                    Komponenter = g.Komponenter
                        .Where(k => k.Navn.Contains(_palettSok.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList()
                })
                .Where(g => g.Komponenter.Count > 0)
                .ToList();
    private string _nyStrekFarge = "#835e41";
    private int _nyStrekTykkelse = 2;
    private bool _nyStrekStiplet;
    private bool _nyStrekKabel;

    private ElementReference _canvasRef;
    private ElementReference _canvasWrapRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<KoblingsSkjemaVisning>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _undoStack.Clear();
        _redoStack.Clear();
        _redigerModus = false;
        _tegnStrekModus = false;
        _visLeggTilMeny = false;
        _pdfPreviewUrl = null;
        _fane = "rediger";
        _visRutenettMeny = false;
        _visFlereValg = false;
        _fullskjerm = false;
        _palettSok = "";
        _zoom = 100;

        _skjema = await Db.KoblingsSkjemaer.Include(s => s.Prosjekt).Include(s => s.Dor).Include(s => s.Kategori).FirstOrDefaultAsync(s => s.Id == Id);
        if (_skjema is null)
        {
            _notFound = true;
            return;
        }

        _valgtProsjektId = _skjema.ProsjektId?.ToString() ?? "";
        _prosjekter = await Db.Prosjekter.OrderBy(p => p.Navn).ToListAsync();
        _lagredePdfer = await LagretPdfService.HentAsync("Koblingsskjema", Id);

        _symboler = await Db.KoblingsSymboler
            .Where(s => s.KoblingsSkjemaId == Id)
            .ToListAsync();

        _streker = await Db.KoblingsStreker
            .Where(s => s.KoblingsSkjemaId == Id)
            .ToListAsync();

        _bibliotek = await Db.KoblingsSymbolBibliotek
            .OrderBy(b => b.Navn)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/koblingsskjema.js?v=15");
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (_module is not null && _dotNetRef is not null && _skjema is not null && _fane == "rediger")
        {
            // Lerretet kobles til én gang per gang Rediger-fanen vises. Flagget
            // settes før første await, så en rendring midt i et fanebytte ikke
            // kobler til et lerret som er i ferd med å forsvinne.
            var kobleTil = !_lerretKoblet;
            _lerretKoblet = true;
            try
            {
                await _module.InvokeVoidAsync("attachSymbolMarkers", _canvasRef, _dotNetRef, !(_redigerModus && !_tegnStrekModus));

                if (kobleTil)
                {
                    await _module.InvokeVoidAsync("initZoomPan", _canvasWrapRef, _canvasRef);
                    await _module.InvokeVoidAsync("enableKeyboardShortcuts", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("enableRubberBandSelect", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("initStrekRedigering", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("enableEditorSnarveier", _canvasRef, _dotNetRef);
                }

                // Knekkpunktene til valgt strek tegnes av JS etter hver rendring.
                await _module.InvokeVoidAsync("oppdaterEditorUi", _canvasRef,
                    _redigerModus ? ValgtJsStrekId() : 0, _skjema.SnapTilRutenett);
            }
            catch (JSException) when (_fane != "rediger")
            {
                // Fanen ble byttet mens vi koblet til - lerretet finnes ikke lenger.
                _lerretKoblet = false;
            }
        }
    }

    private static string PunkterTilSvgPoints(string punkterJson)
    {
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        return string.Join(" ", punkter.Select(p => $"{p.X.ToString(CultureInfo.InvariantCulture)},{p.Y.ToString(CultureInfo.InvariantCulture)}"));
    }

    private static KoblingsStrekPunkt StrekMidtpunkt(string punkterJson)
    {
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (punkter.Count == 0)
        {
            return new KoblingsStrekPunkt();
        }

        var midtIndex = punkter.Count / 2;
        if (punkter.Count % 2 == 1)
        {
            return punkter[midtIndex];
        }

        var a = punkter[midtIndex - 1];
        var b = punkter[midtIndex];
        return new KoblingsStrekPunkt { X = (a.X + b.X) / 2, Y = (a.Y + b.Y) / 2 };
    }

    private void VisPdfForhandsvisning()
    {
        if (_skjema is null)
        {
            return;
        }

        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/koblingsskjema/{_skjema.Id}/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreKoblingsskjemaPdf()
    {
        if (_skjema is null)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(_skjema.Id);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Koblingsskjema", _skjema.Id, $"Koblingsskjema - {_skjema.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task LagreProsjektKobling()
    {
        if (_skjema is null)
        {
            return;
        }

        var prosjektId = int.TryParse(_valgtProsjektId, out var parsedId) ? parsedId : (int?)null;
        _skjema.ProsjektId = prosjektId;
        await Db.SaveChangesAsync();
        _skjema.Prosjekt = prosjektId is null ? null : _prosjekter.FirstOrDefault(p => p.Id == prosjektId);
        _savedMessage = "Lagret.";
    }

    private static List<KoblingsSymbol> KloneSymboler(List<KoblingsSymbol> kilde) =>
        kilde.Select(s => new KoblingsSymbol
        {
            Id = s.Id,
            KoblingsSkjemaId = s.KoblingsSkjemaId,
            ElementType = s.ElementType,
            Navn = s.Navn,
            SymbolBibliotekId = s.SymbolBibliotekId,
            KomponentNokkel = s.KomponentNokkel,
            Farge = s.Farge,
            Strokbredde = s.Strokbredde,
            Fylt = s.Fylt,
            Tekst = s.Tekst,
            FontStorrelse = s.FontStorrelse,
            PosX = s.PosX,
            PosY = s.PosY,
            Bredde = s.Bredde,
            Hoyde = s.Hoyde,
            ZIndex = s.ZIndex,
            ErLaast = s.ErLaast
        }).ToList();

    private static List<KoblingsStrek> KloneStreker(List<KoblingsStrek> kilde) =>
        kilde.Select(s => new KoblingsStrek
        {
            Id = s.Id,
            KoblingsSkjemaId = s.KoblingsSkjemaId,
            PunkterJson = s.PunkterJson,
            Farge = s.Farge,
            Tykkelse = s.Tykkelse,
            Stiplet = s.Stiplet,
            LedereJson = s.LedereJson,
            Navn = s.Navn,
            KabelType = s.KabelType
        }).ToList();

    private void PushUndo()
    {
        _undoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        if (_undoStack.Count > MaxUndoTrinn)
        {
            _undoStack.RemoveAt(0);
        }

        _redoStack.Clear();
    }

    private async Task ApplySnapshot(KoblingsSnapshot snapshot)
    {
        if (_skjema is null)
        {
            return;
        }

        Db.KoblingsSymboler.RemoveRange(_symboler);
        Db.KoblingsStreker.RemoveRange(_streker);
        await Db.SaveChangesAsync();

        var nyeSymboler = KloneSymboler(snapshot.Symboler);
        var nyeStreker = KloneStreker(snapshot.Streker);

        foreach (var s in nyeSymboler)
        {
            s.Id = 0;
        }

        foreach (var s in nyeStreker)
        {
            s.Id = 0;
        }

        Db.KoblingsSymboler.AddRange(nyeSymboler);
        Db.KoblingsStreker.AddRange(nyeStreker);
        await Db.SaveChangesAsync();

        _symboler = nyeSymboler;
        _streker = nyeStreker;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
    }

    private async Task Angre()
    {
        if (_undoStack.Count == 0)
        {
            return;
        }

        _redoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        var snapshot = _undoStack[^1];
        _undoStack.RemoveAt(_undoStack.Count - 1);
        await ApplySnapshot(snapshot);
    }

    private async Task GjorOm()
    {
        if (_redoStack.Count == 0)
        {
            return;
        }

        _undoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        var snapshot = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        await ApplySnapshot(snapshot);
    }

