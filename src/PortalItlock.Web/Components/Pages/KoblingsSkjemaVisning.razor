@page "/koblingsskjema/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider TilgangAuth
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject ITenantContext TenantCtx
@inject KoblingsUtklipp Utklipp
@inject NavigationManager Nav
@inject KoblingsSkjemaPdfService PdfService
@inject LagretPdfService LagretPdfService

<PageTitle>@(_skjema?.Navn is null ? "Koblingsskjema" : _skjema.Navn)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke koblingsskjemaet. Det kan være slettet.</p>
}
else if (_skjema is not null)
{
    @if (_skjema.Dor is not null)
    {
        <a class="back-link" href="@($"/dor/{_skjema.Dor.Id}")"><Icon Name="arrow-left" />Tilbake til dør @_skjema.Dor.Dornummer</a>
    }
    else
    {
        <a class="back-link" href="@($"/guide/kobling/{_skjema.KategoriId}")"><Icon Name="arrow-left" />Tilbake til @(_skjema.Kategori?.Navn ?? "kobling")</a>
    }
    <SideKort Nokkel="koblingsskjema">
    @if (!_redigerModus)
    {
        <h1 class="ks-tittel">@_skjema.Navn</h1>
    }

    @if (_skjema.Dor is not null)
    {
        <p class="kobling-prosjekt-lenke">
            Prinsippskisse for dør: <a href="@($"/dor/{_skjema.Dor.Id}")">@_skjema.Dor.Dornummer</a>
        </p>
    }

    @if (!_redigerModus)
    {
    <div class="ks-faner">
        <button type="button" class="ks-fane @(_fane == "rediger" ? "ks-fane-aktiv" : "")" @onclick='@(() => ByttFane("rediger"))'>Rediger koblingsskjema</button>
        <button type="button" class="ks-fane @(_fane == "pdf" ? "ks-fane-aktiv" : "")" @onclick="VisPdfFane">Forhåndsvisning PDF</button>
        <button type="button" class="ks-fane @(_fane == "lagrede" ? "ks-fane-aktiv" : "")" @onclick='@(() => ByttFane("lagrede"))'>Lagrede PDF-er</button>
    </div>
    }

    @if (_fane == "lagrede")
    {
        <div class="ks-fane-innhold">
            <LagredePdfListe Pdfer="_lagredePdfer" />
        </div>
    }
    else if (_fane == "pdf")
    {
        <div class="ks-fane-innhold">
            <p class="section-hint">Forhåndsvisningen åpnes i et eget vindu. Lukk den for å komme tilbake hit.</p>
            <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Åpne forhåndsvisning</button>
        </div>
    }
    else
    {

    <AuthorizeView Roles="Admin">
        @if (_redigerModus)
        {
            var skjemaT = _skjema!;
            <div class="ksa-topp">
                <input class="ksa-navn" value="@skjemaT.Navn" aria-label="Navn på skjemaet" title="Klikk for å endre navnet"
                       @onchange="@(e => LagreInnstilling(s => s.Navn = (string?)e.Value is { Length: > 0 } v ? v : s.Navn))" />
                <span class="ksa-status" title="Endringer lagres automatisk"><Icon Name="check" />Lagret</span>
                <span class="ksa-mellom"></span>
                <button type="button" class="ksa-ikon" title="Angre (Ctrl+Z)" disabled="@(_undoStack.Count == 0)" @onclick="Angre"><Icon Name="arrow-left" /></button>
                <button type="button" class="ksa-ikon" title="Gjør om (Ctrl+Y)" disabled="@(_redoStack.Count == 0)" @onclick="GjorOm"><Icon Name="arrow-right" /></button>
                <div class="ksa-zoom">
                    <button type="button" title="Zoom ut" disabled="@(_zoom <= MinZoom)" @onclick="ZoomUt"><Icon Name="minus" /></button>
                    <button type="button" class="ksa-zoom-verdi" title="Tilbake til 100 %" @onclick="NullstillZoom">@_zoom&nbsp;%</button>
                    <button type="button" title="Zoom inn" disabled="@(_zoom >= MaxZoom)" @onclick="ZoomInn"><Icon Name="plus" /></button>
                </div>
                <div class="ksa-innst-wrap">
                    <button type="button" class="ksa-ikon @(_visInnstillinger ? "pa" : "")" title="Skjemainnstillinger" @onclick="@(() => _visInnstillinger = !_visInnstillinger)"><Icon Name="settings" /></button>
                    @if (_visInnstillinger)
                    {
                        <div class="ksa-innst">
                            <div class="ksa-innst-hode"><b>Skjemainnstillinger</b><button type="button" class="ksa-ikon" title="Lukk" @onclick="@(() => _visInnstillinger = false)"><Icon Name="x" /></button></div>
                            <label class="ks-felt">
                                <span>Koble til prosjekt</span>
                                <select @bind="_valgtProsjektId" @bind:after="LagreProsjektKobling">
                                    <option value="">(ingen kobling)</option>
                                    @foreach (var p in _prosjekter)
                                    {
                                        <option value="@p.Id">@p.Navn</option>
                                    }
                                </select>
                            </label>
                            <label class="ks-felt">
                                <span>Beskrivelse</span>
                                <textarea rows="2" value="@skjemaT.Beskrivelse" @onchange="@(e => LagreInnstilling(s => s.Beskrivelse = (string?)e.Value))"></textarea>
                            </label>
                            <label class="ks-felt">
                                <span>Stil</span>
                                <select value="@skjemaT.Stil" @onchange="@(e => LagreInnstilling(s => s.Stil = (string?)e.Value ?? "Standard"))">
                                    @foreach (var stil in Stiler)
                                    {
                                        <option value="@stil">@stil</option>
                                    }
                                </select>
                            </label>
                            <div class="ks-bryter-liste">
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.VisRutenett" @onchange="@(e => LagreInnstilling(s => s.VisRutenett = (bool)e.Value!))" /><span>Vis rutenett</span></label>
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.SnapTilRutenett" @onchange="@(e => LagreInnstilling(s => s.SnapTilRutenett = (bool)e.Value!))" /><span>Fest til rutenett</span></label>
                                <label class="ks-bryter"><input type="checkbox" checked="@skjemaT.VisKomponentnavn" @onchange="@(e => LagreInnstilling(s => s.VisKomponentnavn = (bool)e.Value!))" /><span>Vis komponentnavn</span></label>
                            </div>
                            <div class="ksa-innst-knapper">
                                <button type="button" class="ks-knapp ks-knapp-hvit" disabled="@(_streker.Count == 0)" @onclick="RettOppAlleStreker"><Icon Name="grid" />Rett opp streker</button>
                                <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="DupliserSkjema"><Icon Name="box" />Dupliser skjema</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Forhåndsvis PDF</button>
                <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="FerdigRedigering"><Icon Name="check" />Ferdig</button>
            </div>
        }
        else
        {
            <div class="ks-verktoylinje">
                <button type="button" class="ks-knapp ks-knapp-primaer" @onclick="StartRedigering"><Icon Name="edit" />Rediger</button>
                @if (UtklippInnhold is { } kopi)
                {
                    <button type="button" class="ks-knapp ks-knapp-hvit" title="Ctrl + V" @onclick="LimInn"><Icon Name="box" />Lim inn kopiert (@kopi.Antall)</button>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="saved-hint">@_savedMessage</span>
                }
            </div>
        }
    </AuthorizeView>

    <div class="kobling-layout @(_fullskjerm ? "kobling-layout-bred" : "") @(_redigerModus ? "ksa" : "")">
        @if (_redigerModus)
        {
            <div class="ksa-skinne" role="toolbar" aria-label="Verktøy">
                <button type="button" class="@(_visKomponentSkuff ? "pa" : "")" title="Komponenter" @onclick="@(() => { _visKomponentSkuff = !_visKomponentSkuff; _visLeggTilMeny = false; })"><Icon Name="grid-icon" /><span>Kompon.</span></button>
                <button type="button" class="@(!_tegnStrekModus ? "pa" : "")" title="Velg og flytt (V)" @onclick="VelgVerktoy"><Icon Name="grip" /><span>Velg</span></button>
                <button type="button" class="@(_tegnStrekModus && _nyStrekKabel ? "pa" : "")" title="Kabel med ledere" @onclick="VelgFlerlederKabel"><Icon Name="krets-sammenlop" /><span>Kabel</span></button>
                <button type="button" class="@(_tegnStrekModus && !_nyStrekKabel ? "pa" : "")" title="Strek (S)" @onclick="VelgVanligStrek"><Icon Name="minus" /><span>Strek</span></button>
                <button type="button" title="Tekst (T) – skriv hva du vil og dra den dit du vil" @onclick="@(() => LeggTilFigur(KoblingsElementType.Tekstboks))"><Icon Name="file-text" /><span>Tekst</span></button>
                <button type="button" title="Sort prikk – dra den dit du vil" @onclick="@(() => LeggTilFigur(KoblingsElementType.Punkt))"><span class="ksa-prikk-ikon"></span><span>Prikk</span></button>
                <div class="ksa-figur-wrap">
                    <button type="button" class="@(_visLeggTilMeny ? "pa" : "")" title="Figurer og egne bilder" @onclick="@(() => { _visLeggTilMeny = !_visLeggTilMeny; _visKomponentSkuff = false; })"><Icon Name="plus" /><span>Mer</span></button>
                    @if (_visLeggTilMeny)
                    {
                        <div class="kobling-legg-til-panel ksa-mer">
                            <div class="kobling-mine-komponenter">
                                <span>Mine bilder</span>
                                @if (_bibliotek.Count > 0)
                                {
                                    <div class="kobling-bibliotek-grid">
                                        @foreach (var bb in _bibliotek)
                                        {
                                            <button type="button" class="kobling-bibliotek-item" title="@bb.Navn" @onclick="@(() => LeggTilFraBibliotek(bb))">
                                                <img src="@($"/koblingsbibliotek/{bb.Id}")" alt="@bb.Navn" />
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="kobling-bibliotek-tom">Ingen egne bilder lastet opp ennå.</p>
                                }
                                <label class="kobling-legg-til-bilde">
                                    Last opp nytt bilde
                                    <InputFile OnChange="OnSymbolFilValgt" accept="image/*" />
                                </label>
                            </div>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Rektangel))">Rektangel</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Sirkel))">Sirkel</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Linje))">Linje</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Pil))">Pil</button>
                            <button type="button" @onclick="@(() => LeggTilFigur(KoblingsElementType.Punkt))">Punkter</button>
                        </div>
                    }
                </div>
                <span class="ksa-skille"></span>
                <button type="button" class="@(_markerModus ? "pa" : "")" title="Marker: dra en boks rundt det du vil kopiere eller flytte (M)" @onclick="VekslMarker"><Icon Name="maximize" /><span>Marker</span></button>
                <button type="button" title="Kopier det som er markert (Ctrl + C)" disabled="@(_valgteSymbolIds.Count == 0 && _valgteStrekIds.Count == 0 && _selectedSymbol is null && _valgtStrek is null)" @onclick="KopierValgte"><Icon Name="file-text" /><span>Kopier</span></button>
                <button type="button" title="@(UtklippInnhold is { } ui ? $"Lim inn {ui.Antall} kopiert (Ctrl + V)" : "Marker og kopier noe først (Ctrl + C)")" disabled="@(UtklippInnhold is null)" @onclick="LimInn"><Icon Name="box" /><span>Lim inn</span></button>
                <button class="kun-leder" type="button" title="Slett valgte (Delete)" disabled="@(_valgteSymbolIds.Count == 0 && _valgteStrekIds.Count == 0 && _selectedSymbol is null && _valgtStrek is null)" @onclick="SlettValgtFraVerktoylinje"><Icon Name="trash" /><span>Slett</span></button>
            </div>
            @if (_visKomponentSkuff)
            {
            <aside class="ks-palett ksa-skuff">
                <div class="ksa-skuff-hode"><b>Komponenter</b><button type="button" class="ksa-ikon" title="Lukk" @onclick="@(() => _visKomponentSkuff = false)"><Icon Name="x" /></button></div>
                <div class="ks-palett-sok">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk komponent" aria-label="Søk komponent"
                           @bind="_palettSok" @bind:event="oninput" />
                </div>

                @if (FiltrerteGrupper.Count == 0)
                {
                    <div class="ks-palett-seksjon">
                        <p class="ks-palett-tom">Ingen komponenter matcher søket.</p>
                    </div>
                }
                @foreach (var gruppe in FiltrerteGrupper)
                {
                    <div class="ks-palett-seksjon">
                        <h3 class="ks-palett-tittel">@gruppe.Tittel</h3>
                        <div class="ks-palett-grid">
                            @foreach (var k in gruppe.Komponenter)
                            {
                                <button type="button" class="ks-palett-item" title="@($"Dra inn eller klikk for å legge til {k.Navn}")"
                                        draggable="true" @ondragstart="@(() => _draKomponent = k)"
                                        @onclick="@(() => LeggTilKomponent(k))">
                                    @if (k.Bilde is not null)
                                    {
                                        <span class="ks-palett-ikon ks-palett-tegning"><img src="@k.Bilde" alt="" draggable="false" /></span>
                                    }
                                    else
                                    {
                                        <span class="ks-palett-ikon"><Icon Name="@k.Ikon" /></span>
                                    }
                                    <span class="ks-palett-navn">@k.Navn</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="ks-palett-seksjon">
                    <h3 class="ks-palett-tittel">Kabling</h3>
                    <ul class="ks-kabling-liste">
                        <li>
                            <button type="button"
                                    class="ks-kabling-item @(_nyStrekKabel ? "ks-kabling-item-aktiv" : "")"
                                    title="Tegn en kabel som deler seg i fargede ledere i hver ende" @onclick="VelgFlerlederKabel">
                                <svg width="26" height="10" aria-hidden="true">
                                    <line x1="9" y1="5" x2="25" y2="5" stroke="#1d1d1b" stroke-width="4" />
                                    <line x1="1" y1="2" x2="9" y2="5" stroke="#d62828" stroke-width="1.4" />
                                    <line x1="1" y1="5" x2="9" y2="5" stroke="#1f6fd1" stroke-width="1.4" />
                                    <line x1="1" y1="8" x2="9" y2="5" stroke="#1e9e4a" stroke-width="1.4" />
                                </svg>
                                <span>Kabel med ledere</span>
                            </button>
                        </li>
                        @foreach (var kabel in KoblingsKomponentKatalog.Kabling)
                        {
                            <li>
                                <button type="button"
                                        class="ks-kabling-item @(!_nyStrekKabel && _nyStrekFarge == kabel.Farge && _nyStrekStiplet == kabel.Stiplet ? "ks-kabling-item-aktiv" : "")"
                                        title="@($"Tegn {kabel.Navn}")" @onclick="@(() => VelgKabelType(kabel))">
                                    <svg width="26" height="10" aria-hidden="true">
                                        <line x1="1" y1="5" x2="25" y2="5" stroke="@kabel.Farge" stroke-width="2.5"
                                              stroke-dasharray="@(kabel.Stiplet ? "4,3" : null)" />
                                    </svg>
                                    <span>@kabel.Navn</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </aside>
            }
        }

        <div class="ks-lerret-kolonne">
            @if (!_redigerModus)
            {
            <div class="ks-lerret-verktoy">
                <div class="ks-zoom">
                    <button type="button" class="ks-ikonknapp" title="Zoom ut" disabled="@(_zoom <= MinZoom)" @onclick="ZoomUt"><Icon Name="minus" /></button>
                    <button type="button" class="ks-zoom-verdi" title="Tilbake til 100 %" @onclick="NullstillZoom">@_zoom&nbsp;%</button>
                    <button type="button" class="ks-ikonknapp" title="Zoom inn" disabled="@(_zoom >= MaxZoom)" @onclick="ZoomInn"><Icon Name="plus" /></button>
                </div>

                <button type="button" class="ks-ikonknapp @(_fullskjerm ? "ks-ikonknapp-aktiv" : "")"
                        title="@(_fullskjerm ? "Avslutt full bredde" : "Full bredde")" @onclick="@(() => _fullskjerm = !_fullskjerm)">
                    <Icon Name="@(_fullskjerm ? "minimize" : "maximize")" />
                </button>

                <div class="ks-nedtrekk-wrap">
                    <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="@(() => { _visRutenettMeny = !_visRutenettMeny; _visFlereValg = false; })">
                        <Icon Name="grid" />Rutenett<Icon Name="chevron-down" />
                    </button>
                    @if (_visRutenettMeny && _skjema is not null)
                    {
                        <div class="ks-nedtrekk-panel">
                            <label class="ks-bryter">
                                <input type="checkbox" checked="@_skjema.VisRutenett" @onchange="@(e => LagreInnstilling(s => s.VisRutenett = (bool)e.Value!))" />
                                <span>Vis rutenett</span>
                            </label>
                            <label class="ks-bryter">
                                <input type="checkbox" checked="@_skjema.SnapTilRutenett" @onchange="@(e => LagreInnstilling(s => s.SnapTilRutenett = (bool)e.Value!))" />
                                <span>Fest til rutenett</span>
                            </label>
                        </div>
                    }
                </div>

                <div class="ks-nedtrekk-wrap">
                    <button type="button" class="ks-knapp ks-knapp-hvit" @onclick="@(() => { _visFlereValg = !_visFlereValg; _visRutenettMeny = false; })">
                        <Icon Name="more-vertical" />Flere valg
                    </button>
                    @if (_visFlereValg)
                    {
                        <div class="ks-nedtrekk-panel">
                            <button type="button" @onclick="VisPdfForhandsvisning"><Icon Name="eye" />Forhåndsvis PDF</button>
                            <button type="button" @onclick="DupliserSkjema"><Icon Name="box" />Dupliser skjema</button>
                            <button type="button" disabled="@(_valgteSymbolIds.Count == 0)" @onclick="DupliserValgte"><Icon Name="plus" />Dupliser valgte</button>
                            <button type="button" @onclick="AvbrytValg"><Icon Name="x" />Fjern markering</button>
                        </div>
                    }
                </div>

                <span class="ks-lerret-info">@_symboler.Count komponenter · @_streker.Count streker</span>
            </div>

            }

            @if (_redigerModus && (_tegnStrekModus || _valgtStrek is not null || _tegnerLederId is not null))
            {
                <p class="ksa-hint">
                    @if (_tegnerLederId is not null)
                    {
                        <span>Flytt musen for å forlenge lederen, klikk for å svinge, klikk et blått punkt for å koble. Esc stopper.</span>
                    }
                    else if (_tegnStrekModus)
                    {
                        <span>Klikk der @(_nyStrekKabel ? "kabelen" : "streken") skal starte og svinge, klikk et blått punkt for å koble. Esc avslutter.</span>
                    }
                    else if (_valgtStrek is { ErKabel: true })
                    {
                        <span>Klikk en farget leder for å forlenge den. Klikk for å svinge, Esc stopper.</span>
                    }
                    else
                    {
                        <span>Dra knekkpunktene for å flytte svinger. Dobbeltklikk et knekkpunkt for å fjerne det.</span>
                    }
                </p>
            }

            <div class="kobling-canvas-wrap" @ref="_canvasWrapRef">
                <div class="kobling-canvas @(_redigerModus && !_tegnStrekModus ? "kobling-canvas-rediger" : "") @(_tegnStrekModus ? "ks-tegner" : "") @(_skjema?.VisRutenett == true ? "ks-rutenett" : "") @(SkjulTekstVedZoom ? "ks-tekst-av" : "")"
                     style="width:@(_zoom.ToString(CultureInfo.InvariantCulture))%; --ks-skala:@(_skala.ToString(CultureInfo.InvariantCulture))"
                     data-rediger="@(_redigerModus ? "1" : "0")"
                     data-marker-modus="@(_markerModus && _redigerModus ? "1" : "0")"
                     data-harvalg="@(_valgteSymbolIds.Count + _valgteStrekIds.Count > 0 || _valgtStrek is not null ? "1" : "0")"
                     @ondragover="@(() => { })" @ondragover:preventDefault="true"
                     @ondrop="DroppKomponent"
                     @ref="_canvasRef">
                    <svg class="kobling-strek-svg-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                        @StrekLag(true)
                        @* Halvmåne der streker krysser, prikk der de er koblet. *@
                        @((MarkupString)KoblingsKryss.Svg(KoblingsKryss.Linjer(_streker, KabelVifte, p => System.Text.Json.JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(p) ?? []), LerretAspekt, breddeFaktor: LinjeSkala, pxPerProsent: _pxPerProsent / _skala))
                    </svg>

                    @foreach (var s in _streker.Where(s => s.ErKabel && !string.IsNullOrWhiteSpace(s.Navn) && !s.SkjulNavn))
                    {
                        var merke = KabelVifte(s)?.Merke;
                        if (merke is not null)
                        {
                            <div class="ks-kabel-merke" style="left:@Inv(merke.X)%; top:@Inv(merke.Y)%">@KabelEtikett(s)</div>
                        }
                    }

                    @foreach (var s in _streker.Where(s => !s.ErKabel && (s.TekstStart is not null || s.TekstSlutt is not null)))
                    {
                        @foreach (var t in KoblingsStrekTekst.For(s, JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [], LerretAspekt))
                        {
                            <div class="ks-strek-tekst @t.Klasse @(KoblingsStrekTekst.ErHvit(s.Farge) ? "ks-st-hvit" : "")" style="left:@Inv(t.X)%; top:@Inv(t.Y)%; color:@KoblingsStrekTekst.Farge(s)">@t.Tekst</div>
                        }
                    }

                    @foreach (var s in _streker.Where(KoblingsStrekTekst.HarLederTekst))
                    {
                        @foreach (var t in KoblingsStrekTekst.ForLedere(s, KabelVifte(s), LerretAspekt))
                        {
                            <div class="ks-strek-tekst @t.P.Klasse @(t.Hvit ? "ks-st-hvit" : "")" style="left:@Inv(t.P.X)%; top:@Inv(t.P.Y)%; color:@t.Farge">@t.P.Tekst</div>
                        }
                    }

                    @foreach (var symbol in _symboler.OrderBy(s => s.ZIndex).ThenBy(s => s.Id))
                    {
                        <KoblingsSymbolElement @key="symbol.Id" Symbol="symbol"
                                                Selected="@(_valgteSymbolIds.Contains(symbol.Id))"
                                                VisNavn="@(_skjema?.VisKomponentnavn ?? true)"
                                                VisResizeHandle="@(_redigerModus && !_tegnStrekModus && !symbol.ErLaast && _valgteSymbolIds.Contains(symbol.Id))"
                                                VisEgnePorter="_redigerModus" />
                    }

                    @* Kabler som skal vises helt inn til punktet: samme streker, klippet til
                       komponentene der det er slått på, og tegnet oppå dem. *@
                    @if (_symboler.Any(x => x.KablerOver))
                    {
                        <svg class="ks-strek-over" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                            <defs>
                                <clipPath id="ks-over-klipp" clipPathUnits="userSpaceOnUse">
                                    @foreach (var k in _symboler.Where(x => x.KablerOver))
                                    {
                                        <rect x="@Inv(k.PosX)" y="@Inv(k.PosY)" width="@Inv(k.Bredde)" height="@Inv(k.Hoyde)" />
                                    }
                                </clipPath>
                            </defs>
                            <g clip-path="url(#ks-over-klipp)">@StrekLag(false)</g>
                        </svg>
                    }

                    @if (_redigerModus && ValgRamme() is { } vr)
                    {
                        <div class="ks-valgramme" style="left:calc(@Inv(vr.X1)% - 10px); top:calc(@Inv(vr.Y1)% - 10px); width:calc(@Inv(vr.X2 - vr.X1)% + 20px); height:calc(@Inv(vr.Y2 - vr.Y1)% + 20px)"><span>@vr.Antall markert · Ctrl + C kopierer</span>
                            <div class="ks-valg-storrelse" title="Endre størrelse på det som er markert">
                                <button type="button" @onclick="@(() => SkalerValgte(1 / 1.1))" aria-label="Mindre">−</button>
                                <b>Størrelse</b>
                                <button type="button" @onclick="@(() => SkalerValgte(1.1))" aria-label="Større">+</button>
                            </div></div>
                    }

                    @* Knekkpunkter, tilkoblingspunkter og hjelpelinjer - innholdet tegnes av koblingsskjema.js. *@
                    <svg class="ks-ui-lag" aria-hidden="true"></svg>

                </div>
            </div>

            @{
                var kabler = Kabler();
            }
            @if (_redigerModus && !_visJournal)
            {
                <button type="button" class="ksa-journal-knapp" @onclick="@(() => _visJournal = true)"><Icon Name="list" />Kabeljournal (@kabler.Count)</button>
            }
            @if (_redigerModus ? _visJournal : kabler.Count > 0)
            {
                <section class="ks-journal @(_redigerModus ? "ksa-ark" : "")">
                    @if (_redigerModus)
                    {
                        <button type="button" class="ksa-ikon ksa-ark-lukk" title="Lukk kabeljournalen" @onclick="@(() => _visJournal = false)"><Icon Name="x" /></button>
                    }
                    <div class="ks-journal-hode">
                        <h2>Kabeljournal</h2>
                        <span>Én rad = én leder. Les fra venstre: klemme → leder → hvor den skal.</span>
                    </div>
                    @if (kabler.Count == 0)
                    {
                        <p class="ks-journal-tom">Ingen kabler ennå. Velg <b>Kabel med ledere</b> under Kabling og tegn kabelen mellom to komponenter – lederne havner her automatisk.</p>
                    }
                    @foreach (var k in kabler)
                    {
                        var ledere = KoblingsKabel.Les(k.LedereJson);
                        <div class="ks-journal-kabel @(_valgtStrek?.Id == k.Id ? "valgt" : "")">
                            <div class="ks-journal-kabelnavn">
                                <b>@(string.IsNullOrWhiteSpace(k.Navn) ? "Kabel" : k.Navn)</b>
                                <span>@(string.IsNullOrWhiteSpace(k.KabelType) ? KoblingsKabel.MalNavn(ledere) : $"{k.KabelType} · {KoblingsKabel.MalNavn(ledere)}")</span>
                                @if (_redigerModus)
                                {
                                    <button type="button" class="ks-journal-velg" @onclick="@(() => VelgStrek(k))">@(_valgtStrek?.Id == k.Id ? "Valgt" : "Velg kabel")</button>
                                }
                            </div>
                            <div class="ks-journal-tabell-wrap">
                                <table class="ks-journal-tabell">
                                    <thead>
                                        <tr><th class="kl">Klemme</th><th>Funksjon</th><th>Leder</th><th>Kobles til</th><th>Merknad</th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < ledere.Count; i++)
                                        {
                                            var idx = i;
                                            var l = ledere[i];
                                            <tr>
                                                @if (_redigerModus)
                                                {
                                                    <td class="kl"><input value="@l.Klemme" placeholder="–" @onchange="@(e => EndreLeder(k, idx, x => x.Klemme = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td><input value="@l.Funksjon" placeholder="Funksjon" @onchange="@(e => EndreLeder(k, idx, x => x.Funksjon = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td class="ld"><span class="ks-leder-prikk @(l.Stiplet ? "stiplet" : "")" style="--f:@KoblingsKabel.Hex(l.Farge)"></span>@KoblingsKabel.LederTekst(l)</td>
                                                    <td><input value="@l.Til" placeholder="Hvor den skal" @onchange="@(e => EndreLeder(k, idx, x => x.Til = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                    <td><input value="@l.Merknad" placeholder="" @onchange="@(e => EndreLeder(k, idx, x => x.Merknad = e.Value?.ToString()?.Trim() ?? ""))" /></td>
                                                }
                                                else
                                                {
                                                    <td class="kl">@(string.IsNullOrWhiteSpace(l.Klemme) ? "–" : l.Klemme)</td>
                                                    <td>@l.Funksjon</td>
                                                    <td class="ld"><span class="ks-leder-prikk @(l.Stiplet ? "stiplet" : "")" style="--f:@KoblingsKabel.Hex(l.Farge)"></span>@KoblingsKabel.LederTekst(l)</td>
                                                    <td>@l.Til</td>
                                                    <td class="mk">@l.Merknad</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>

        @if (_redigerModus && (_valgteSymbolIds.Count + _valgteStrekIds.Count > 1 || _valgtStrek is not null || _tegnStrekModus || (_selectedSymbol is not null && _visSymbolPanel)))
        {
            <div class="kobling-side-panel ksa-panel">
                @if (_valgteSymbolIds.Count + _valgteStrekIds.Count > 1)
                {
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>@(_valgteSymbolIds.Count + _valgteStrekIds.Count) valgt</h2>
                            <button type="button" class="cancel-button" @onclick="AvbrytValg">Lukk</button>
                        </div>
                        <p class="ks-panel-hint">@ValgtTekst()</p>
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="save-button" @onclick="KopierValgte" title="Ctrl + C">Kopier</button>
                            <button type="button" class="cancel-button" @onclick="DupliserValgte" title="Ctrl + D">Dupliser</button>
                            <button type="button" class="delete-button kun-leder" @onclick="SlettValgte">Slett valgte</button>
                        </div>
                        <p class="ks-panel-hint">Kopier, åpne et annet skjema og trykk Ctrl + V eller «Lim inn».</p>
                    </div>
                }
                else if (_valgtStrek is { ErKabel: true })
                {
                    var kabelStrek = _valgtStrek;
                    var ledere = KoblingsKabel.Les(kabelStrek.LedereJson);
                    var malNavn = KoblingsKabel.MalNavn(ledere);
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>Kabel</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _valgtStrek = null)">Lukk</button>
                        </div>
                        <label>
                            Navn på tegningen
                            <input value="@kabelStrek.Navn" placeholder="f.eks. K1" @onchange="@(e => EndreStrek(kabelStrek, s => s.Navn = TomTilNull(e.Value?.ToString())))" />
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" checked="@(!kabelStrek.SkjulNavn)" @onchange="@(e => EndreStrek(kabelStrek, s => s.SkjulNavn = !(bool)e.Value!))" /> Vis navnet på tegningen
                        </label>
                        @if (!kabelStrek.SkjulNavn)
                        {
                            <div class="ks-valg-rad" role="group" aria-label="Plassering av kabelnavnet">
                                <span>Navnet står</span>
                                <button type="button" class="@(kabelStrek.KabelMerkePlass == "start" ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.KabelMerkePlass = "start"))">Ved start</button>
                                <button type="button" class="@(kabelStrek.KabelMerkePlass is null ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.KabelMerkePlass = null))">Midt på</button>
                                <button type="button" class="@(kabelStrek.KabelMerkePlass == "slutt" ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.KabelMerkePlass = "slutt"))">Ved slutt</button>
                            </div>
                        }
                        <label>
                            Kabelbetegnelse
                            <input value="@kabelStrek.KabelType" placeholder="f.eks. 6 PAR 0,6 PT HF" @onchange="@(e => EndreStrek(kabelStrek, s => s.KabelType = TomTilNull(e.Value?.ToString())))" />
                        </label>
                        <label>
                            Antall ledere
                            <select value="@malNavn" @onchange="@(e => SettKabelMal(kabelStrek, e.Value?.ToString()))">
                                @if (!KoblingsKabel.Maler.Any(m => m.Navn == malNavn))
                                {
                                    <option value="@malNavn">@malNavn (egen)</option>
                                }
                                @foreach (var m in KoblingsKabel.Maler)
                                {
                                    <option value="@m.Navn">@m.Navn</option>
                                }
                            </select>
                        </label>
                        <div class="ks-antall">
                            <button type="button" title="Én leder mindre" disabled="@(ledere.Count <= 1)" @onclick="@(() => SettAntallLedere(kabelStrek, ledere.Count - 1))">−</button>
                            <span>@ledere.Count @(ledere.Count == 1 ? "leder" : "ledere")</span>
                            <button type="button" title="Én leder til" disabled="@(ledere.Count >= KoblingsKabel.MaksLedere)" @onclick="@(() => SettAntallLedere(kabelStrek, ledere.Count + 1))">+</button>
                        </div>
                        <div class="ks-avstand" role="group" aria-label="Avstand mellom ledere">
                            @{ var faktor = KoblingsKabel.AvstandFaktor(kabelStrek.LederAvstand); }
                            <span>Avstand mellom ledere <b>@Math.Round(faktor * 100) %</b></span>
                            <input type="range" min="@Inv(KoblingsKabel.MinFaktor * 100)" max="@Inv(KoblingsKabel.MaksFaktor * 100)" step="5"
                                   value="@Inv(Math.Round(faktor * 100))" aria-label="Avstand mellom ledere i prosent"
                                   @oninput="@(e => DraLederAvstand(kabelStrek, e.Value?.ToString()))"
                                   @onchange="@(e => SettLederAvstand(kabelStrek, e.Value?.ToString()))" />
                            <div>
                                @foreach (var (verdi, navn) in KoblingsKabel.Avstander)
                                {
                                    <button type="button" class="@(Math.Abs(faktor - verdi) < 0.001 ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.LederAvstand = KoblingsKabel.AvstandVerdi(verdi)))">@navn</button>
                                }
                            </div>
                        </div>
                        <div class="ks-avstand" role="group" aria-label="Lengde på ledere">
                            @{ var lengdeF = KoblingsKabel.LengdeFaktor(kabelStrek.LederLengde); }
                            <span>Lengde på ledere <b>@Math.Round(lengdeF * 100) %</b></span>
                            <input type="range" min="@Inv(KoblingsKabel.MinLengde * 100)" max="@Inv(KoblingsKabel.MaksLengde * 100)" step="5"
                                   value="@Inv(Math.Round(lengdeF * 100))" aria-label="Lengde på ledere i prosent"
                                   @oninput="@(e => DraLederLengde(kabelStrek, e.Value?.ToString()))"
                                   @onchange="@(e => SettLederLengde(kabelStrek, e.Value?.ToString()))" />
                            <div>
                                @foreach (var (verdi, navn) in KoblingsKabel.Lengder)
                                {
                                    <button type="button" class="@(Math.Abs(lengdeF - verdi) < 0.001 ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.LederLengde = KoblingsKabel.LengdeVerdi(verdi)))">@navn</button>
                                }
                            </div>
                        </div>
                        <div class="ks-ledere">
                            @for (var i = 0; i < ledere.Count; i++)
                            {
                                var idx = i;
                                var l = ledere[i];
                                <div class="ks-leder">
                                    <span class="ks-leder-nr" style="--f:@KoblingsKabel.Hex(l.Farge)">@(i + 1)</span>
                                    <select aria-label="@($"Farge leder {i + 1}")" value="@((l.Stiplet ? "~" : "") + l.Farge)"
                                            @onchange="@(e => SettLederFarge(kabelStrek, idx, e.Value?.ToString()))">
                                        @foreach (var f in KoblingsKabel.Farger)
                                        {
                                            <option value="@f.Navn">@f.Navn</option>
                                        }
                                        @foreach (var f in KoblingsKabel.Farger)
                                        {
                                            <option value="@("~" + f.Navn)">@f.Navn stiplet</option>
                                        }
                                    </select>
                                    <input aria-label="@($"Funksjon leder {i + 1}")" value="@l.Funksjon" placeholder="Funksjon"
                                           @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.Funksjon = e.Value?.ToString()?.Trim() ?? ""))" />
                                    <span class="ks-leder-lengde" title="Lengde ut av kabelen i hver ende (% av vanlig)">
                                        <input type="number" min="30" max="300" step="10" aria-label="@($"Lengde leder {i + 1} ved start")" placeholder="100"
                                               value="@(l.LengdeStart is double ls ? Math.Round(ls * 100) : null)"
                                               @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.LengdeStart = LesLengde(e.Value?.ToString())))" />
                                        <input type="number" min="30" max="300" step="10" aria-label="@($"Lengde leder {i + 1} ved slutt")" placeholder="100"
                                               value="@(l.LengdeSlutt is double lt ? Math.Round(lt * 100) : null)"
                                               @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.LengdeSlutt = LesLengde(e.Value?.ToString())))" />
                                    </span>
                                    <span class="ks-leder-tekst">
                                        <input aria-label="@($"Tekst ved start, leder {i + 1}")" value="@l.TekstStart" placeholder="Tekst start"
                                               @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.TekstStart = TomTilNull(e.Value?.ToString())))" />
                                        <input aria-label="@($"Tekst ved slutt, leder {i + 1}")" value="@l.TekstSlutt" placeholder="Tekst slutt"
                                               @onchange="@(e => EndreLeder(kabelStrek, idx, x => x.TekstSlutt = TomTilNull(e.Value?.ToString())))" />
                                    </span>
                                </div>
                            }
                        </div>
                        @if (ledere.Any(l => !string.IsNullOrWhiteSpace(l.TekstStart) || !string.IsNullOrWhiteSpace(l.TekstSlutt)))
                        {
                            <div class="ks-valg-rad" role="group" aria-label="Plassering av teksten på lederne">
                                <span>Tekst på lederne</span>
                                <button type="button" class="@(!kabelStrek.TekstVedEnden ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.TekstVedEnden = false))">Over lederen</button>
                                <button type="button" class="@(kabelStrek.TekstVedEnden ? "pa" : "")" @onclick="@(() => EndreStrek(kabelStrek, s => s.TekstVedEnden = true))">På enden</button>
                            </div>
                        }
                        <p class="ks-panel-hint">Under hver leder skriver du fri tekst ved start og slutt, f.eks. «+12V» eller «NO». Den står ved enden av lederen på tegningen.</p>
                        <p class="ks-panel-hint">Tallene etter funksjon er lengden på hver leder ut av kabelen ved start og slutt (100 = vanlig). Tomt = som de andre.</p>
                        <p class="ks-panel-hint">Klikk en leder på tegningen og klikk på et blått koblingspunkt – lederne legger seg ryddig av seg selv. Dra den sorte kabelen for å flytte hele kabelen. Klemme og hvor hver leder skal fyller du ut i kabeljournalen under skjemaet.</p>
                        @if (ledere.Any(l => l.Start is not null || l.Slutt is not null))
                        {
                            <div class="kobling-symbol-panel-actions">
                                <button type="button" class="cancel-button" @onclick="@(() => RyddLedere(kabelStrek))">Rydd lederne</button>
                                <button type="button" class="cancel-button" @onclick="@(() => NullstillLederVeier(kabelStrek))">Tilbake i vifte</button>
                            </div>
                        }
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="cancel-button" @onclick="@(() => RettOppStrek(kabelStrek))">Rett opp</button>
                            <button type="button" class="cancel-button" @onclick="@(() => GjorTilStrek(kabelStrek))">Vanlig strek</button>
                            <button type="button" class="delete-button kun-leder" @onclick="@(() => SlettStrek(kabelStrek))">Slett kabel</button>
                        </div>
                    </div>
                }
                else if (_valgtStrek is not null)
                {
                    var strek = _valgtStrek;
                    var antallSvinger = Math.Max(0, (JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(strek.PunkterJson)?.Count ?? 2) - 2);
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>Strek</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _valgtStrek = null)">Lukk</button>
                        </div>
                        <label>
                            Kabeltype
                            <select value="@KabelIndeks(strek)" @onchange="@(e => SettKabelPaStrek(strek, e.Value?.ToString()))">
                                <option value="">Egendefinert</option>
                                <option value="kabel">Kabel med ledere</option>
                                @for (var i = 0; i < KoblingsKomponentKatalog.Kabling.Count; i++)
                                {
                                    var kabel = KoblingsKomponentKatalog.Kabling[i];
                                    <option value="@i">@kabel.Navn</option>
                                }
                            </select>
                        </label>
                        <div class="ks-farger" role="group" aria-label="Farge">
                            <span>Farge</span>
                            <div>
                                @foreach (var (navn, hex) in VanligeFarger)
                                {
                                    <button type="button" title="@navn" aria-label="@navn" class="@(string.Equals(strek.Farge, hex, StringComparison.OrdinalIgnoreCase) ? "pa" : "")"
                                            style="--f:@hex" @onclick="@(() => EndreStrek(strek, s => s.Farge = hex))"></button>
                                }
                                <label class="ks-egen-farge" title="Egen farge – velg fritt">
                                    <input type="color" value="@strek.Farge" aria-label="Egen farge" @onchange="@(e => EndreStrek(strek, s => s.Farge = e.Value?.ToString() ?? s.Farge))" />
                                </label>
                            </div>
                        </div>
                        <label>
                            Tykkelse
                            <select value="@strek.Tykkelse" @onchange="@(e => EndreStrek(strek, s => s.Tykkelse = int.TryParse(e.Value?.ToString(), out var t) ? t : s.Tykkelse))">
                                <option value="1">Tynn</option>
                                <option value="2">Normal</option>
                                <option value="3">Tykk</option>
                                <option value="5">Ekstra tykk</option>
                            </select>
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" checked="@strek.Stiplet" @onchange="@(e => EndreStrek(strek, s => s.Stiplet = (bool)e.Value!))" /> Stiplet
                        </label>
                        <div class="ks-plassering">
                            <label>
                                Tekst ved start
                                <input value="@strek.TekstStart" placeholder="f.eks. +12V" @onchange="@(e => EndreStrek(strek, s => s.TekstStart = TomTilNull(e.Value?.ToString())))" />
                            </label>
                            <label>
                                Tekst ved slutt
                                <input value="@strek.TekstSlutt" placeholder="f.eks. NO" @onchange="@(e => EndreStrek(strek, s => s.TekstSlutt = TomTilNull(e.Value?.ToString())))" />
                            </label>
                        </div>
                        @if (strek.TekstStart is not null || strek.TekstSlutt is not null)
                        {
                            <div class="ks-valg-rad" role="group" aria-label="Plassering av merkingen">
                                <span>Merking</span>
                                <button type="button" class="@(!strek.TekstVedEnden ? "pa" : "")" @onclick="@(() => EndreStrek(strek, s => s.TekstVedEnden = false))">Over streken</button>
                                <button type="button" class="@(strek.TekstVedEnden ? "pa" : "")" @onclick="@(() => EndreStrek(strek, s => s.TekstVedEnden = true))">På enden</button>
                            </div>
                            <div class="ks-farger" role="group" aria-label="Farge på merkingen">
                                <span>Farge på merkingen</span>
                                <div>
                                    <button type="button" title="Som streken" aria-label="Som streken" class="ks-som-strek @(strek.TekstFarge is null ? "pa" : "")" style="--f:@strek.Farge" @onclick="@(() => EndreStrek(strek, s => s.TekstFarge = null))">=</button>
                                    @foreach (var (navn, hex) in VanligeFarger)
                                    {
                                        <button type="button" title="@navn" aria-label="@navn" class="@(string.Equals(strek.TekstFarge, hex, StringComparison.OrdinalIgnoreCase) ? "pa" : "")"
                                                style="--f:@hex" @onclick="@(() => EndreStrek(strek, s => s.TekstFarge = hex))"></button>
                                    }
                                    <label class="ks-egen-farge" title="Egen farge – velg fritt">
                                        <input type="color" value="@(strek.TekstFarge ?? strek.Farge)" aria-label="Egen farge på merkingen" @onchange="@(e => EndreStrek(strek, s => s.TekstFarge = e.Value?.ToString()))" />
                                    </label>
                                </div>
                            </div>
                        }
                        <p class="ks-panel-hint">Merkingen står ved enden streken er koblet til – over streken eller i forlengelsen av den. La feltet stå tomt for ingen merking.</p>
                        <p class="ks-panel-hint">@antallSvinger @(antallSvinger == 1 ? "sving" : "svinger"). Dra knekkpunktene på lerretet for å flytte svingene.</p>
                        <div class="kobling-symbol-panel-actions">
                            <button type="button" class="cancel-button" @onclick="@(() => RettOppStrek(strek))">Rett opp</button>
                            <button type="button" class="delete-button kun-leder" @onclick="@(() => SlettStrek(strek))">Slett strek</button>
                        </div>
                    </div>
                }
                else if (_tegnStrekModus)
                {
                    <div class="kobling-symbol-panel">
                        <div class="kobling-symbol-panel-header">
                            <h2>@(_nyStrekKabel ? "Ny kabel" : "Ny strek")</h2>
                        </div>
                        <div class="ks-farger" role="group" aria-label="Farge">
                            <span>Farge</span>
                            <div>
                                @foreach (var (navn, hex) in VanligeFarger)
                                {
                                    <button type="button" title="@navn" aria-label="@navn" class="@(string.Equals(_nyStrekFarge, hex, StringComparison.OrdinalIgnoreCase) ? "pa" : "")"
                                            style="--f:@hex" @onclick="@(async () => { _nyStrekFarge = hex; await StartStrekPaNytt(); })"></button>
                                }
                                <label class="ks-egen-farge" title="Egen farge – velg fritt">
                                    <input type="color" @bind="_nyStrekFarge" @bind:after="StartStrekPaNytt" aria-label="Egen farge" />
                                </label>
                            </div>
                        </div>
                        <label>
                            Tykkelse
                            <select @bind="_nyStrekTykkelse" @bind:after="StartStrekPaNytt">
                                <option value="1">Tynn</option>
                                <option value="2">Normal</option>
                                <option value="3">Tykk</option>
                                <option value="5">Ekstra tykk</option>
                            </select>
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="_nyStrekStiplet" @bind:after="StartStrekPaNytt" /> Stiplet
                        </label>
                        <p class="ks-panel-hint">Velg kabeltype i paletten til venstre for riktig farge.</p>
                    </div>
                }
                else if (_selectedSymbol is not null && _visSymbolPanel)
                {
                    var sym = _selectedSymbol;
                    <div class="kobling-symbol-panel ks-kompakt">
                        <div class="kobling-symbol-panel-header">
                            <h2>@(KoblingsKomponentKatalog.Finn(sym.KomponentNokkel)?.Navn ?? sym.ElementType switch { KoblingsElementType.Tekstboks => "Tekst", KoblingsElementType.Punkt => "Punkt", KoblingsElementType.Bilde => "Bilde", _ => "Figur" })</h2>
                            <button type="button" class="cancel-button" @onclick="@(() => _selectedSymbol = null)">Lukk</button>
                        </div>

                        @if (sym.ElementType == KoblingsElementType.Tekstboks)
                        {
                            <label>
                                Tekst
                                <textarea rows="2" @bind="sym.Tekst" @bind:event="oninput" @bind:after="LagreSymbol"></textarea>
                            </label>
                            <label>
                                Størrelse <b>@sym.FontStorrelse px</b>
                                <input type="range" min="6" max="48" step="1" @bind="sym.FontStorrelse" @bind:event="oninput" @bind:after="LagreSymbol" />
                            </label>
                            <label class="checkbox-row">
                                <input type="checkbox" checked="@sym.Fet" @onchange="@(async e => { sym.Fet = (bool)e.Value!; await LagreSymbol(); })" /> <b>Fet skrift</b>
                            </label>
                            <p class="ks-panel-hint">Dra i hjørnet for å gjøre boksen rundt teksten så liten du vil.</p>
                        }
                        else
                        {
                            <label>
                                Navn
                                <input @bind="sym.Navn" @bind:event="oninput" @bind:after="LagreSymbol" placeholder="Navn på tegningen" />
                            </label>
                            <label class="checkbox-row">
                                <input type="checkbox" checked="@(!sym.SkjulNavn)" @onchange="@(async e => { sym.SkjulNavn = !(bool)e.Value!; await LagreSymbol(); })" /> Vis navnet på tegningen
                            </label>
                            @if (!sym.SkjulNavn)
                            {
                                <div class="ks-valg-rad" role="group" aria-label="Hvor navnet står">
                                    <span>Navnet står</span>
                                    @foreach (var (verdi, tekst) in new (string?, string)[] { (null, "Over"), ("under", "Under"), ("venstre", "Venstre"), ("hoyre", "Høyre") })
                                    {
                                        <button type="button" class="@(sym.NavnPlass == verdi ? "pa" : "")" @onclick="@(async () => { sym.NavnPlass = verdi; await LagreSymbol(); })">@tekst</button>
                                    }
                                </div>
                            }
                            @if (sym.ElementType is KoblingsElementType.Komponent or KoblingsElementType.Bilde)
                            {
                                <label class="checkbox-row">
                                    <input type="checkbox" checked="@sym.KablerOver" @onchange="@(async e => { sym.KablerOver = (bool)e.Value!; await LagreSymbol(); })" /> Vis kablene helt inn til punktet
                                </label>
                            }
                        }

                        <div class="ks-hurtig">
                            <button type="button" @onclick="DupliserValgte" title="Ctrl + D"><Icon Name="box" />Dupliser</button>
                            <button type="button" @onclick="SendFremst"><Icon Name="layers" />Fremst</button>
                            <button type="button" class="ks-hurtig-slett kun-leder" @onclick="SlettSymbol" title="Delete / Backspace"><Icon Name="trash" />Slett</button>
                        </div>
                        <p class="ks-panel-hint">Dra for å flytte, piltaster flytter fint. Ctrl + C / Ctrl + V kopierer, Delete eller Backspace sletter.</p>

                        <details class="ks-mer">
                            <summary>Mer …</summary>
                            @if (sym.ElementType is not (KoblingsElementType.Tekstboks or KoblingsElementType.Punkt))
                            {
                                var egne = KoblingsPorter.Les(sym.PorterJson);
                                <div class="ks-porter">
                                    <b>Koblingspunkter</b>
                                    <span>@(egne.Count == 0 ? "Ingen punkter ennå. Legg til der kablene skal kobles inn." : $"{egne.Count} punkter. De vises bare når musen er over komponenten.")</span>
                                    @for (var i = 0; i < egne.Count; i++)
                                    {
                                        var idx = i;
                                        <span class="ks-port-rad"><i></i>Punkt @(idx + 1)<button type="button" title="Fjern punkt @(idx + 1)" @onclick="@(() => FjernPort(idx))">✕</button></span>
                                    }
                                    <button type="button" class="@(_plasserPort ? "ks-port-pa" : "cancel-button")" @onclick="VekslePortPlassering">
                                        @(_plasserPort ? "Ferdig" : "Legg til punkter")
                                    </button>
                                    @if (_plasserPort)
                                    {
                                        <small>Klikk på komponenten der kabelen skal kobles inn. Esc eller Ferdig avslutter.</small>
                                    }
                                </div>
                            }

                            @if (sym.ElementType is KoblingsElementType.Rektangel or KoblingsElementType.Sirkel or KoblingsElementType.Linje or KoblingsElementType.Pil or KoblingsElementType.Punkt or KoblingsElementType.Tekstboks)
                            {
                                <label>
                                    Farge
                                    <input type="color" @bind="sym.Farge" @bind:after="LagreSymbol" />
                                </label>
                            }
                            @if (sym.ElementType is KoblingsElementType.Rektangel or KoblingsElementType.Sirkel or KoblingsElementType.Linje or KoblingsElementType.Pil)
                            {
                                <label>
                                    Strøkbredde
                                    <input type="number" min="1" max="20" @bind="sym.Strokbredde" @bind:after="LagreSymbol" />
                                </label>
                                @if (sym.ElementType is KoblingsElementType.Rektangel or KoblingsElementType.Sirkel)
                                {
                                    <label class="checkbox-row">
                                        <input type="checkbox" @bind="sym.Fylt" @bind:after="LagreSymbol" /> Fylt
                                    </label>
                                }
                            }

                            <div class="ks-plassering">
                                <label>
                                    Bredde (%)
                                    <input type="number" min="2" max="100" @bind="sym.Bredde" @bind:after="LagreSymbol" />
                                </label>
                                <label>
                                    Høyde (%)
                                    <input type="number" min="2" max="100" @bind="sym.Hoyde" @bind:after="LagreSymbol" />
                                </label>
                            </div>

                            <div class="kobling-symbol-panel-actions">
                                <button type="button" class="cancel-button" @onclick="SendBakerst">Send bakerst</button>
                                <button type="button" class="cancel-button" @onclick="ToggleErLaast">@(sym.ErLaast ? "Lås opp" : "Lås")</button>
                            </div>
                        </details>
                    </div>
                }

            </div>
        }
    </div>

    }

    </SideKort>
    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av koblingsskjema" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreKoblingsskjemaPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@if (_utklippMelding is not null)
{
    <div class="ks-utklipp-melding" role="status"><Icon Name="check" />@_utklippMelding</div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Vanlige ledningsfarger øverst; fargehjulet til slutt er «egen farge».
    private static readonly (string Navn, string Hex)[] VanligeFarger =
    [
        ("Rød", "#d32f2f"), ("Sort", "#1d1f22"), ("Blå", "#1f5fbf"), ("Brun", "#7b4a26"), ("Grønn/gul", "#3a9a3a"),
        ("Hvit", "#f2f2f2"), ("Grå", "#8a9096"), ("Oransje", "#ef7d1a"), ("Gul", "#e8c51c"), ("Lilla", "#7a3fb0")
    ];

    private KoblingsSkjema? _skjema;
    private bool _notFound;
    private int? _loadedId;
    private string? _savedMessage;

    private List<KoblingsSymbol> _symboler = [];
    private List<KoblingsStrek> _streker = [];
    private List<KoblingsSymbolBibliotek> _bibliotek = [];
    private List<Prosjekt> _prosjekter = [];
    private string _valgtProsjektId = "";
    private KoblingsSymbol? _selectedSymbol;
    private KoblingsStrek? _valgtStrek;
    private KoblingsKomponent? _draKomponent;
    private readonly HashSet<int> _valgteSymbolIds = [];
    private readonly HashSet<int> _valgteStrekIds = [];
    private string? _pdfPreviewUrl;
    private List<LagretPdf> _lagredePdfer = [];
    private string? _pdfSavedMessage;

    private sealed class KoblingsSnapshot
    {
        public required List<KoblingsSymbol> Symboler { get; init; }
        public required List<KoblingsStrek> Streker { get; init; }
    }

    private readonly List<KoblingsSnapshot> _undoStack = [];
    private readonly List<KoblingsSnapshot> _redoStack = [];
    private const int MaxUndoTrinn = 50;

    private bool _redigerModus;
    private bool _tegnStrekModus;
    private bool _visLeggTilMeny;

    // Fanene øverst: "rediger" (editoren), "pdf" (forhåndsvisning) og
    // "lagrede" (tidligere lagrede PDF-er).
    private string _fane = "rediger";
    private bool _lerretKoblet;

    private bool _visRutenettMeny;
    private bool _visFlereValg;
    private bool _fullskjerm;
    private string _palettSok = "";

    // Zoom i prosent av lerretsbredden. 100 % = lerretet fyller kolonnen,
    // altså akkurat slik det var før zoom ble innført.
    private const int MinZoom = 15;
    private const int MaxZoom = 1200;
    private int _zoom = 100;

    private static readonly string[] Stiler = ["Standard", "Teknisk", "Minimal", "Presentasjon"];

    private List<KoblingsKomponentGruppe> FiltrerteGrupper =>
        string.IsNullOrWhiteSpace(_palettSok)
            ? KoblingsKomponentKatalog.Grupper
            : KoblingsKomponentKatalog.Grupper
                .Select(g => g with
                {
                    Komponenter = g.Komponenter
                        .Where(k => k.Navn.Contains(_palettSok.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList()
                })
                .Where(g => g.Komponenter.Count > 0)
                .ToList();
    private string _nyStrekFarge = "#835e41";
    private int _nyStrekTykkelse = 2;
    private bool _nyStrekStiplet;
    private bool _nyStrekKabel;

    private ElementReference _canvasRef;
    private ElementReference _canvasWrapRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<KoblingsSkjemaVisning>? _dotNetRef;

    // Piksler per prosent av lerretets bredde, så halvmåner og prikker holder
    // samme størrelse på skjermen når man zoomer.
    private double _pxPerProsent = KoblingsKryss.StandardPxPerProsent;

    // Skala for tekst, prikker og halvmåner: blir mindre når man zoomer ut
    // (lerretet er smalere enn 1200 px), men aldri større når man zoomer inn.
    private double _skala = 1;
    private const double ReferanseBredde = 1200;
    // Linjene blir tynnere når man zoomer ut, men aldri helt borte.
    private double LinjeSkala => Math.Max(0.4, _skala);
    // Så langt ute at teksten ville gått over hverandre: da skjules den.
    private bool SkjulTekstVedZoom => _skala < 0.55;

    // Musehjul / knip: JS har allerede satt bredden; vi tar vare på den så neste
    // rendring ikke setter lerretet tilbake til forrige zoom.
    [JSInvokable]
    public void OnZoomHjul(int zoom)
    {
        var ny = Math.Clamp(zoom, MinZoom, MaxZoom);
        if (ny != _zoom)
        {
            _zoom = ny;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnLerretBredde(double bredde)
    {
        var ny = bredde / 100;
        if (ny > 0 && Math.Abs(ny - _pxPerProsent) > _pxPerProsent * 0.03)
        {
            _pxPerProsent = ny;
            _skala = Math.Round(Math.Clamp(bredde / ReferanseBredde, 0.2, 1), 3);
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _valgteStrekIds.Clear();
        _undoStack.Clear();
        _redoStack.Clear();
        _redigerModus = false;
        _tegnStrekModus = false;
        _visLeggTilMeny = false;
        _pdfPreviewUrl = null;
        _fane = "rediger";
        _visRutenettMeny = false;
        _visFlereValg = false;
        _fullskjerm = false;
        _palettSok = "";
        _zoom = 100;

        _skjema = await Db.KoblingsSkjemaer.Include(s => s.Prosjekt).Include(s => s.Dor).Include(s => s.Kategori).FirstOrDefaultAsync(s => s.Id == Id);
        if (_skjema is null)
        {
            _notFound = true;
            return;
        }

        await HentUtklippNokkel();
        _valgtProsjektId = _skjema.ProsjektId?.ToString() ?? "";
        _prosjekter = await Db.Prosjekter.OrderBy(p => p.Navn).ToListAsync();
        _lagredePdfer = await LagretPdfService.HentAsync("Koblingsskjema", Id);

        _symboler = await Db.KoblingsSymboler
            .Where(s => s.KoblingsSkjemaId == Id)
            .ToListAsync();

        _streker = await Db.KoblingsStreker
            .Where(s => s.KoblingsSkjemaId == Id)
            .ToListAsync();

        // Eldre skjema: rammen rundt komponentene tilpasses bildet (og lagres).
        if (KoblingsTilpasning.TilpassSkjema(_symboler, _streker))
        {
            await LagreDb();
        }

        _bibliotek = await Db.KoblingsSymbolBibliotek
            .OrderBy(b => b.Navn)
            .ToListAsync();

        // «Rediger» fra ⋯-menyen i listen åpner skjemaet rett i redigering.
        if (RedigerQuery == 1 && AuthState is not null && ((await AuthState).User.IsInRole("Admin") || (await AuthState).User.IsInRole("Prosjektleder")))
        {
            _redigerModus = true;
            _visKomponentSkuff = _symboler.Count == 0;
        }
    }

    [SupplyParameterFromQuery(Name = "rediger")] public int? RedigerQuery { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/koblingsskjema.js?v=39");
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (_module is not null && _dotNetRef is not null && _skjema is not null && _fane == "rediger")
        {
            // Lerretet kobles til én gang per gang Rediger-fanen vises. Flagget
            // settes før første await, så en rendring midt i et fanebytte ikke
            // kobler til et lerret som er i ferd med å forsvinne.
            var kobleTil = !_lerretKoblet;
            _lerretKoblet = true;
            try
            {
                await _module.InvokeVoidAsync("attachSymbolMarkers", _canvasRef, _dotNetRef, !(_redigerModus && !_tegnStrekModus));

                if (kobleTil)
                {
                    await _module.InvokeVoidAsync("initZoomPan", _canvasWrapRef, _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("enableKeyboardShortcuts", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("enableRubberBandSelect", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("initStrekRedigering", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("enableEditorSnarveier", _canvasRef, _dotNetRef);
                    await _module.InvokeVoidAsync("observerLerretBredde", _canvasRef, _dotNetRef);
                }

                if (kobleTil)
                {
                    _sendtSkisse = null;
                }
                await OppdaterSkisse();

                // Knekkpunktene til valgt strek tegnes av JS etter hver rendring.
                await _module.InvokeVoidAsync("oppdaterEditorUi", _canvasRef,
                    _redigerModus ? ValgtJsStrekId() : 0, _skjema.SnapTilRutenett);
            }
            catch (JSException) when (_fane != "rediger")
            {
                // Fanen ble byttet mens vi koblet til - lerretet finnes ikke lenger.
                _lerretKoblet = false;
            }
        }
    }

    private static string PunkterTilSvgPoints(string punkterJson)
    {
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        return string.Join(" ", punkter.Select(p => $"{p.X.ToString(CultureInfo.InvariantCulture)},{p.Y.ToString(CultureInfo.InvariantCulture)}"));
    }

    private static KoblingsStrekPunkt StrekMidtpunkt(string punkterJson)
    {
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (punkter.Count == 0)
        {
            return new KoblingsStrekPunkt();
        }

        var midtIndex = punkter.Count / 2;
        if (punkter.Count % 2 == 1)
        {
            return punkter[midtIndex];
        }

        var a = punkter[midtIndex - 1];
        var b = punkter[midtIndex];
        return new KoblingsStrekPunkt { X = (a.X + b.X) / 2, Y = (a.Y + b.Y) / 2 };
    }

    private void VisPdfForhandsvisning()
    {
        if (_skjema is null)
        {
            return;
        }

        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/koblingsskjema/{_skjema.Id}/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreKoblingsskjemaPdf()
    {
        if (_skjema is null)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(_skjema.Id);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Koblingsskjema", _skjema.Id, $"Koblingsskjema - {_skjema.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task LagreProsjektKobling()
    {
        if (_skjema is null)
        {
            return;
        }

        var prosjektId = int.TryParse(_valgtProsjektId, out var parsedId) ? parsedId : (int?)null;
        _skjema.ProsjektId = prosjektId;
        await LagreDb();
        _skjema.Prosjekt = prosjektId is null ? null : _prosjekter.FirstOrDefault(p => p.Id == prosjektId);
        _savedMessage = "Lagret.";
    }

    private static List<KoblingsSymbol> KloneSymboler(List<KoblingsSymbol> kilde) =>
        kilde.Select(s => new KoblingsSymbol
        {
            Id = s.Id,
            KoblingsSkjemaId = s.KoblingsSkjemaId,
            ElementType = s.ElementType,
            Navn = s.Navn,
            SymbolBibliotekId = s.SymbolBibliotekId,
            KomponentNokkel = s.KomponentNokkel,
            Farge = s.Farge,
            Strokbredde = s.Strokbredde,
            Fylt = s.Fylt,
            Tekst = s.Tekst,
            FontStorrelse = s.FontStorrelse,
            PosX = s.PosX,
            PosY = s.PosY,
            Bredde = s.Bredde,
            Hoyde = s.Hoyde,
            ZIndex = s.ZIndex,
            ErLaast = s.ErLaast,
            PorterJson = s.PorterJson,
            SkjulNavn = s.SkjulNavn,
            Fet = s.Fet,
            KablerOver = s.KablerOver,
            NavnPlass = s.NavnPlass
        }).ToList();

    private static List<KoblingsStrek> KloneStreker(List<KoblingsStrek> kilde) =>
        kilde.Select(s => new KoblingsStrek
        {
            Id = s.Id,
            KoblingsSkjemaId = s.KoblingsSkjemaId,
            PunkterJson = s.PunkterJson,
            Farge = s.Farge,
            Tykkelse = s.Tykkelse,
            Stiplet = s.Stiplet,
            LedereJson = s.LedereJson,
            Navn = s.Navn,
            KabelType = s.KabelType,
            LederAvstand = s.LederAvstand,
            LederLengde = s.LederLengde,
            SkjulNavn = s.SkjulNavn,
            TekstStart = s.TekstStart,
            TekstSlutt = s.TekstSlutt,
            TekstVedEnden = s.TekstVedEnden,
            TekstFarge = s.TekstFarge,
            KabelMerkePlass = s.KabelMerkePlass
        }).ToList();

    private void PushUndo()
    {
        _undoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        if (_undoStack.Count > MaxUndoTrinn)
        {
            _undoStack.RemoveAt(0);
        }

        _redoStack.Clear();
    }

    private async Task ApplySnapshot(KoblingsSnapshot snapshot)
    {
        if (_skjema is null)
        {
            return;
        }

        Db.KoblingsSymboler.RemoveRange(_symboler);
        Db.KoblingsStreker.RemoveRange(_streker);
        await LagreDb();

        var nyeSymboler = KloneSymboler(snapshot.Symboler);
        var nyeStreker = KloneStreker(snapshot.Streker);

        foreach (var s in nyeSymboler)
        {
            s.Id = 0;
        }

        foreach (var s in nyeStreker)
        {
            s.Id = 0;
        }

        Db.KoblingsSymboler.AddRange(nyeSymboler);
        Db.KoblingsStreker.AddRange(nyeStreker);
        await LagreDb();

        _symboler = nyeSymboler;
        _streker = nyeStreker;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
    }

    private async Task Angre()
    {
        if (_undoStack.Count == 0)
        {
            return;
        }

        _redoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        var snapshot = _undoStack[^1];
        _undoStack.RemoveAt(_undoStack.Count - 1);
        await ApplySnapshot(snapshot);
    }

    private async Task GjorOm()
    {
        if (_redoStack.Count == 0)
        {
            return;
        }

        _undoStack.Add(new KoblingsSnapshot
        {
            Symboler = KloneSymboler(_symboler),
            Streker = KloneStreker(_streker)
        });

        var snapshot = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        await ApplySnapshot(snapshot);
    }

    // Strekene og kablene. medId = false i laget oppå komponentene (JS skal
    // bare finne strekene i hovedlaget).
    // Lengde i prosent fra feltet (tomt eller 100 = vanlig).
    private static double? LesLengde(string? tekst) =>
        double.TryParse(tekst, System.Globalization.NumberStyles.Float, CultureInfo.InvariantCulture, out var p) && p > 0 && Math.Abs(p - 100) > 0.5
            ? Math.Clamp(p / 100.0, KoblingsKabel.MinLengde, KoblingsKabel.MaksLengde)
            : null;

    private RenderFragment StrekLag(bool medId) => __builder =>
    {
        @foreach (var s in _streker)
        {
            var vifte = KabelVifte(s);
            var maskId = (medId ? "ks-km-" : "ks-kmo-") + s.Id;
            <g @key="s.Id">
                @if (vifte is not null)
                {
                    @* Den tykke kabelen skjules i endene, der lederne tar over. *@
                    <mask id="@maskId" maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
                        <rect x="-10" y="-10" width="120" height="120" fill="#fff" />
                        @foreach (var e in new[] { vifte.Start, vifte.Slutt })
                        {
                            <ellipse cx="@Inv(e.Senter.X)" cy="@Inv(e.Senter.Y)" rx="@Inv(e.Rx)" ry="@Inv(e.Ry)" fill="#000" />
                        }
                    </mask>
                    <polyline data-strekid="@(medId ? s.Id : null)" data-kabel="1" points="@PunkterTilSvgPoints(s.PunkterJson)" fill="none"
                              class="@(_valgtStrek?.Id == s.Id || _valgteStrekIds.Contains(s.Id) ? "ks-strek-valgt" : null)"
                              stroke="@KoblingsKabel.KabelFarge" stroke-width="@Inv(7 * LinjeSkala)"
                              stroke-linejoin="round" stroke-linecap="round"
                              mask="@($"url(#{maskId})")"
                              vector-effect="non-scaling-stroke" />
                    @foreach (var l in vifte.Ledere)
                    {
                        var pts = Pts(l.Punkter);
                        var lederId = KoblingsKabel.LederId(s.Id, l.ErStart, l.Indeks);
                        @if (l.Leder.Farge == "Hvit")
                        {
                            <polyline points="@pts" fill="none" stroke="#9a948c" stroke-width="@Inv(3.6 * LinjeSkala)"
                                      stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                        }
                        <polyline points="@pts" fill="none" stroke="@KoblingsKabel.Hex(l.Leder.Farge)" stroke-width="@Inv(2.2 * LinjeSkala)"
                                  data-strekid="@(medId ? lederId : null)" data-fast="@(l.Fri ? null : "1")" class="@(_valgtLederId == lederId ? "ks-strek-valgt" : null)"
                                  stroke-linejoin="round" stroke-linecap="round"
                                  stroke-dasharray="@(l.Leder.Stiplet ? "4,3" : null)"
                                  vector-effect="non-scaling-stroke" />
                    }
                }
                else
                {
                    @if (KoblingsStrekTekst.ErHvit(s.Farge))
                    {
                        <polyline points="@PunkterTilSvgPoints(s.PunkterJson)" fill="none" stroke="@KoblingsStrekTekst.HvitKant"
                                  stroke-width="@Inv(Math.Max(0.6, s.Tykkelse * LinjeSkala) + 1.6)" stroke-linejoin="round" stroke-linecap="round"
                                  vector-effect="non-scaling-stroke" />
                    }
                    <polyline data-strekid="@(medId ? s.Id : null)" points="@PunkterTilSvgPoints(s.PunkterJson)" fill="none"
                              class="@(_valgtStrek?.Id == s.Id || _valgteStrekIds.Contains(s.Id) ? "ks-strek-valgt" : null)"
                              stroke="@s.Farge" stroke-width="@Inv(Math.Max(0.6, s.Tykkelse * LinjeSkala))"
                              stroke-linejoin="round" stroke-linecap="round"
                              stroke-dasharray="@(s.Stiplet ? "6,4" : null)"
                              vector-effect="non-scaling-stroke" />
                }
            </g>
        }
    };

    private async Task DupliserSkjema()
    {
        if (_skjema is null)
        {
            return;
        }
        await _lagreLas.WaitAsync();
        KoblingsSkjema? ny;
        try
        {
            ny = await KoblingsSkjemaKopi.KopierAsync(Db, _skjema.Id);
        }
        finally
        {
            _lagreLas.Release();
        }
        if (ny is not null)
        {
            Nav.NavigateTo($"/koblingsskjema/{ny.Id}?rediger=1");
        }
    }

    private async Task ToggleRedigerModus()
    {
        if (_tegnStrekModus && _module is not null)
        {
            await _module.InvokeVoidAsync("stopStrekTegning");
        }

        _redigerModus = !_redigerModus;
        _tegnStrekModus = false;
        _visLeggTilMeny = false;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
    }

    private async Task ToggleTegnStrekModus()
    {
        _tegnStrekModus = !_tegnStrekModus;
        _selectedSymbol = null;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _visLeggTilMeny = false;

        if (_module is null)
        {
            return;
        }

        if (_tegnStrekModus)
        {
            await StartStrekPaNytt();
        }
        else
        {
            _nyStrekKabel = false;
            await _module.InvokeVoidAsync("stopStrekTegning");
        }
    }

    // Starter strektegningen på nytt med gjeldende farge/tykkelse/stiplet.
    private async Task StartStrekPaNytt()
    {
        if (_tegnStrekModus && _module is not null)
        {
            await _module.InvokeVoidAsync("startStrekTegning", _canvasRef, _dotNetRef,
                _nyStrekKabel ? KoblingsKabel.KabelFarge : _nyStrekFarge,
                _nyStrekKabel ? 6 : Math.Max(1, _nyStrekTykkelse),
                !_nyStrekKabel && _nyStrekStiplet);
        }
    }

    // Marker-verktøyet: neste boks kan dras hvor som helst på tegningen. Slås av
    // når boksen er dratt, så man er tilbake til vanlig redigering.
    private bool _markerModus;

    private async Task VekslMarker()
    {
        await VelgVerktoy();
        _markerModus = !_markerModus;
    }

    private async Task VelgVerktoy()
    {
        if (_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
    }

    // Hurtigtaster fra koblingsskjema.js (S, V, T, Esc, Ctrl+Z, Ctrl+Y).
    [JSInvokable]
    public async Task OnSnarvei(string kommando)
    {
        if (!_redigerModus)
        {
            // Ctrl + A når skjemaet bare vises: gå i Rediger og marker alt.
            if (kommando != "alle")
            {
                return;
            }
            await StartRedigering();
        }

        switch (kommando)
        {
            case "strek":
                await ToggleTegnStrekModus();
                break;
            case "velg":
                _markerModus = false;
                await VelgVerktoy();
                break;
            case "marker":
                await VekslMarker();
                break;
            case "tekst":
                await VelgVerktoy();
                await LeggTilFigur(KoblingsElementType.Tekstboks);
                break;
            case "angre":
                await Angre();
                break;
            case "gjorom":
                await GjorOm();
                break;
            case "avvelg":
                AvbrytValg();
                break;
            case "kopier":
                await KopierValgte();
                break;
            case "alle":
                MarkerAlle();
                break;
            case "lim":
                await LimInn(null, null);
                break;
            case "dupliser":
                if (_valgteSymbolIds.Count == 0 && _selectedSymbol is { } d)
                {
                    _valgteSymbolIds.Add(d.Id);
                }
                await DupliserValgte();
                break;
        }

        StateHasChanged();
    }

    private async Task DroppKomponent(DragEventArgs e)
    {
        var komponent = _draKomponent;
        _draKomponent = null;
        if (komponent is null || _module is null || !_redigerModus)
        {
            return;
        }

        var pos = await _module.InvokeAsync<KlikkPosisjon>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);
        await LeggTilKomponent(komponent, pos.X, pos.Y);
    }

    private sealed class KlikkPosisjon
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    private async Task OnSymbolFilValgt(InputFileChangeEventArgs e)
    {
        if (_skjema is null)
        {
            return;
        }

        var file = e.File;
        if (file.Size > 5_000_000)
        {
            _savedMessage = "Bildet er for stort (maks 5 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 5_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var navn = Path.GetFileNameWithoutExtension(file.Name);
        var bibliotekSymbol = new KoblingsSymbolBibliotek
        {
            Navn = navn,
            BildeData = buffer.ToArray(),
            BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType
        };

        Db.KoblingsSymbolBibliotek.Add(bibliotekSymbol);
        await LagreDb();
        _bibliotek.Add(bibliotekSymbol);

        PushUndo();
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = KoblingsElementType.Bilde,
            SymbolBibliotekId = bibliotekSymbol.Id,
            Navn = navn
        };

        Db.KoblingsSymboler.Add(symbol);
        await LagreDb();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
    }

    private async Task LeggTilFraBibliotek(KoblingsSymbolBibliotek b)
    {
        if (_skjema is null)
        {
            return;
        }
        _visKomponentSkuff = false;

        PushUndo();
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = KoblingsElementType.Bilde,
            SymbolBibliotekId = b.Id,
            Navn = b.Navn
        };

        Db.KoblingsSymboler.Add(symbol);
        await LagreDb();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
    }

    private async Task LeggTilFigur(KoblingsElementType type)
    {
        if (_skjema is null)
        {
            return;
        }

        PushUndo();
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = type,
            Tekst = type == KoblingsElementType.Tekstboks ? "Tekst" : null,
            // Tekst og prikk er sorte som standard; fargen kan endres under «Mer».
            Farge = type is KoblingsElementType.Tekstboks or KoblingsElementType.Punkt ? "#1d1f22" : "#835e41",
            PosX = 45,
            PosY = 45,
            Bredde = type switch { KoblingsElementType.Tekstboks => 6, KoblingsElementType.Punkt => 0.8, _ => 10 },
            Hoyde = type switch { KoblingsElementType.Tekstboks => 2.4, KoblingsElementType.Punkt => 0.8 * 16 / 13.0, _ => 10 },
            FontStorrelse = 13,
            ZIndex = (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0) + 1
        };

        Db.KoblingsSymboler.Add(symbol);
        await LagreDb();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
        // Velg den nye med en gang, så teksten kan skrives inn i panelet.
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _valgteSymbolIds.Add(symbol.Id);
        _selectedSymbol = symbol;
    }

    private async Task LeggTilKomponent(KoblingsKomponent komponent) => await LeggTilKomponent(komponent, null, null);

    // Uten posisjon (klikk i paletten) trappes plasseringen; med posisjon
    // (dratt inn på lerretet) havner midten av komponenten der den slippes.
    private async Task LeggTilKomponent(KoblingsKomponent komponent, double? midtX, double? midtY)
    {
        if (_skjema is null)
        {
            return;
        }
        _visKomponentSkuff = false;

        PushUndo();

        // Trapp posisjonen nedover/mot høyre for hver nye komponent, ellers
        // havner alt oppå hverandre midt på lerretet når man klikker flere
        // ganger i paletten.
        var trinn = _symboler.Count % 10;
        // Tegningene beholder formen sin: høyden regnes om fra lerretets 16:13-forhold.
        var storrelse = komponent.Bredde;
        var hoyde = Math.Round(komponent.Bredde * komponent.Forhold * 16 / 13, 1);
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = KoblingsElementType.Komponent,
            KomponentNokkel = komponent.Nokkel,
            Navn = komponent.UtenNavn ? null : komponent.Navn,
            PorterJson = komponent.Porter,
            // Legges akkurat der den slippes (ingen avrunding til rutenett).
            PosX = midtX is double x ? Math.Clamp(Math.Round(x - storrelse / 2, 2), 0, 100 - storrelse) : 20 + trinn * 5,
            PosY = midtY is double y ? Math.Clamp(Math.Round(y - hoyde / 2, 2), 0, 100 - hoyde) : Math.Min(20 + trinn * 5, 100 - hoyde),
            Bredde = storrelse,
            Hoyde = hoyde,
            // Klemmerekker legges oppå komponenten de slippes på.
            ZIndex = komponent.UtenNavn ? (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) + 1 : 1) : 0
        };

        Db.KoblingsSymboler.Add(symbol);
        await LagreDb();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _valgteSymbolIds.Add(symbol.Id);
        _selectedSymbol = symbol;
    }

    // Velger farge/stiplet for neste strek fra "Kabling"-forklaringen, og slår
    // på strektegning med én gang slik at montøren kan tegne rett etter klikket.
    private async Task VelgKabelType(KoblingsKabelType kabel)
    {
        _nyStrekKabel = false;
        _nyStrekFarge = kabel.Farge;
        _nyStrekStiplet = kabel.Stiplet;

        // Er en strek valgt, får den kabeltypen i stedet.
        if (_valgtStrek is not null && !_tegnStrekModus)
        {
            await EndreStrek(_valgtStrek, s =>
            {
                s.Farge = kabel.Farge;
                s.Stiplet = kabel.Stiplet;
            });
            return;
        }

        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }

    private string KabelIndeks(KoblingsStrek s)
    {
        var i = KoblingsKomponentKatalog.Kabling.FindIndex(k =>
            string.Equals(k.Farge, s.Farge, StringComparison.OrdinalIgnoreCase) && k.Stiplet == s.Stiplet);
        return i < 0 ? "" : i.ToString(CultureInfo.InvariantCulture);
    }

    private async Task SettKabelPaStrek(KoblingsStrek strek, string? verdi)
    {
        if (verdi == "kabel")
        {
            await EndreStrek(strek, GjorKabel);
            return;
        }
        if (!int.TryParse(verdi, out var i) || i < 0 || i >= KoblingsKomponentKatalog.Kabling.Count)
        {
            return;
        }

        var kabel = KoblingsKomponentKatalog.Kabling[i];
        await EndreStrek(strek, s =>
        {
            s.Farge = kabel.Farge;
            s.Stiplet = kabel.Stiplet;
        });
    }

    private async Task EndreStrek(KoblingsStrek strek, Action<KoblingsStrek> endre)
    {
        PushUndo();
        endre(strek);
        await LagreDb();
    }

    private void VelgStrek(KoblingsStrek s)
    {
        _valgtStrek = _valgtStrek?.Id == s.Id ? null : s;
        _selectedSymbol = null;
        _valgteSymbolIds.Clear();
        _valgteStrekIds.Clear();
    }

    // Trykk på en kabel mens skjemaet bare vises: gå i Rediger og velg den,
    // så den kan kopieres (Ctrl + C) og flyttes med en gang.
    [JSInvokable]
    public async Task OnStrekKlikkVisning(int strekId)
    {
        if (!_redigerModus)
        {
            await StartRedigering();
            _visKomponentSkuff = false;
        }
        OnStrekValgt(strekId);
    }

    [JSInvokable]
    public void OnStrekValgt(int strekId)
    {
        // En leder i en kabel: kabelen blir valgt, og lederen får håndtakene.
        var leder = KoblingsKabel.LesLederId(strekId);
        _valgtLederId = leder is null ? null : strekId;
        _valgtStrek = _streker.FirstOrDefault(s => s.Id == (leder?.StrekId ?? strekId));
        if (_valgtStrek is not null)
        {
            _selectedSymbol = null;
            _valgteSymbolIds.Clear();
            _valgteStrekIds.Clear();
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStrekFlyttet(int strekId, string punkterJson)
    {
        if (strekId < 0)
        {
            PushUndo();
            if (SettLederVei(strekId, punkterJson))
            {
                await LagreDb();
            }
            StateHasChanged();
            return;
        }

        var strek = _streker.FirstOrDefault(s => s.Id == strekId);
        if (strek is null)
        {
            return;
        }

        PushUndo();
        SettKabelPunkter(strek, punkterJson);
        await LagreDb();
        StateHasChanged();
    }

    // Ny vei for en kabel: ble hele kabelen flyttet, følger lederveiene med.
    private static void SettKabelPunkter(KoblingsStrek strek, string nyeJson)
    {
        if (strek.ErKabel)
        {
            var gammel = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(strek.PunkterJson) ?? [];
            var ny = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(nyeJson) ?? [];
            if (KoblingsKabel.RenFlytting(gammel, ny) is { } d)
            {
                strek.LedereJson = KoblingsKabel.Flytt(strek.LedereJson, d.Dx, d.Dy);
            }
        }
        strek.PunkterJson = nyeJson;
    }

    private async Task RettOppStrek(KoblingsStrek strek)
    {
        PushUndo();
        strek.PunkterJson = RettOppPunkter(strek.PunkterJson);
        await LagreDb();
    }

    private async Task RettOppAlleStreker()
    {
        if (_streker.Count == 0)
        {
            return;
        }

        PushUndo();
        foreach (var s in _streker)
        {
            s.PunkterJson = RettOppPunkter(s.PunkterJson);
        }

        await LagreDb();
        _savedMessage = "Alle streker er rettet opp.";
    }

    // Setter inn et hjørne i alle skrå strekbiter (vannrett først), og fjerner
    // doble punkter og punkter som ligger midt på en rett linje.
    private static string RettOppPunkter(string punkterJson)
    {
        const double eps = 0.05;
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        var med = new List<KoblingsStrekPunkt>();
        foreach (var p in punkter)
        {
            if (med.Count > 0)
            {
                var forrige = med[^1];
                if (Math.Abs(forrige.X - p.X) >= eps && Math.Abs(forrige.Y - p.Y) >= eps)
                {
                    med.Add(new KoblingsStrekPunkt { X = p.X, Y = forrige.Y });
                }
            }

            med.Add(new KoblingsStrekPunkt { X = p.X, Y = p.Y });
        }

        var renset = new List<KoblingsStrekPunkt>();
        foreach (var p in med)
        {
            if (renset.Count > 0 && Math.Abs(renset[^1].X - p.X) < eps && Math.Abs(renset[^1].Y - p.Y) < eps)
            {
                continue;
            }

            renset.Add(p);
        }

        for (var i = renset.Count - 2; i > 0; i--)
        {
            var a = renset[i - 1];
            var b = renset[i];
            var c = renset[i + 1];
            if ((Math.Abs(a.X - b.X) < eps && Math.Abs(b.X - c.X) < eps) || (Math.Abs(a.Y - b.Y) < eps && Math.Abs(b.Y - c.Y) < eps))
            {
                renset.RemoveAt(i);
            }
        }

        return renset.Count < 2 ? punkterJson : JsonSerializer.Serialize(renset);
    }

    // Lagrer nye strekpunkter for streker som fulgte med en flyttet komponent.
    private void OppdaterTilkobledeStreker(string? streker)
    {
        if (string.IsNullOrWhiteSpace(streker))
        {
            return;
        }

        var endringer = JsonSerializer.Deserialize<List<StrekEndring>>(streker) ?? [];
        foreach (var e in endringer)
        {
            if (e.Id < 0 && !string.IsNullOrWhiteSpace(e.PunkterJson))
            {
                SettLederVei(e.Id, e.PunkterJson, auto: null);
                continue;
            }
            var strek = _streker.FirstOrDefault(s => s.Id == e.Id);
            if (strek is not null && !string.IsNullOrWhiteSpace(e.PunkterJson))
            {
                SettKabelPunkter(strek, e.PunkterJson);
            }
        }
    }

    private sealed class StrekEndring
    {
        public int Id { get; set; }
        public string? PunkterJson { get; set; }
    }

    [JSInvokable]
    public async Task OnSymbolerFlyttet(string flyttetJson, string streker)
    {
        var flyttet = JsonSerializer.Deserialize<List<FlyttetSymbol>>(flyttetJson) ?? [];
        if (flyttet.Count == 0)
        {
            return;
        }

        PushUndo();
        foreach (var f in flyttet)
        {
            var symbol = _symboler.FirstOrDefault(s => s.Id == f.Id);
            if (symbol is not null)
            {
                symbol.PosX = f.X;
                symbol.PosY = f.Y;
            }
        }

        OppdaterTilkobledeStreker(streker);
        await LagreDb();
        StateHasChanged();
    }

    private Task VisPdfFane() => ByttFane("pdf");

    // Lerretet finnes bare på Rediger-fanen. Forlater vi den, kobles de globale
    // tastelytterne fra; kommer vi tilbake, kobles lerretet til på nytt i
    // OnAfterRenderAsync (ellers virket verken dra, zoom eller hurtigtaster).
    private async Task ByttFane(string fane)
    {
        if (_fane == fane)
        {
            return;
        }
        if (_fane == "rediger" && _lerretKoblet && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disableKeyboardShortcuts", _canvasRef);
                await _module.InvokeVoidAsync("disableEditorSnarveier", _canvasRef);
            }
            catch (JSDisconnectedException)
            {
            }
            _lerretKoblet = false;
        }
        _fane = fane;
    }

    private void ZoomInn() => _zoom = Math.Min(MaxZoom, _zoom < 100 ? _zoom + 15 : (int)Math.Round(_zoom * 1.25));

    private void ZoomUt() => _zoom = Math.Max(MinZoom, _zoom <= 100 ? _zoom - 15 : (int)Math.Round(_zoom / 1.25));

    private void NullstillZoom() => _zoom = 100;

    // Felles lagring for alle feltene i "Skjema-innstillinger" og
    // rutenett-nedtrekket, slik at valgene overlever at siden lukkes.
    private async Task LagreInnstilling(Action<KoblingsSkjema> endre)
    {
        if (_skjema is null)
        {
            return;
        }

        endre(_skjema);
        _skjema.OppdatertDato = DateTime.UtcNow;
        await LagreDb();
        _savedMessage = "Lagret.";
    }

    // "Slett" i verktøylinja: tar både flervalg og enkeltvalgt symbol.
    private async Task SlettValgtFraVerktoylinje()
    {
        if (_valgteSymbolIds.Count > 0)
        {
            await SlettValgte();
        }
        else if (_selectedSymbol is not null)
        {
            await SlettSymbol();
        }
        else if (_valgtStrek is not null)
        {
            await SlettStrek(_valgtStrek);
        }
    }

    [JSInvokable]
    public async Task OnStrekFerdig(string punkterJson)
    {
        if (_skjema is null)
        {
            return;
        }

        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (punkter.Count < 2)
        {
            return;
        }

        PushUndo();
        var strek = new KoblingsStrek
        {
            KoblingsSkjemaId = _skjema.Id,
            PunkterJson = punkterJson,
            Farge = _nyStrekFarge,
            Tykkelse = _nyStrekTykkelse,
            Stiplet = _nyStrekStiplet
        };
        if (_nyStrekKabel)
        {
            GjorKabel(strek);
        }

        Db.KoblingsStreker.Add(strek);
        await LagreDb();
        _streker.Add(strek);

        // En ny kabel velges med en gang, så lederne kan dras dit de skal.
        if (strek.ErKabel && _tegnStrekModus)
        {
            await ToggleTegnStrekModus();
            _valgtStrek = strek;
        }
        StateHasChanged();
    }

