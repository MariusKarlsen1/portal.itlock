    private static string Beskriv(KoblingsUtklipp.Innhold i)
    {
        var deler = new List<string>();
        if (i.Symboler.Count > 0) deler.Add($"{i.Symboler.Count} {(i.Symboler.Count == 1 ? "komponent" : "komponenter")}");
        var kabler = i.Streker.Count(s => s.ErKabel);
        if (kabler > 0) deler.Add($"{kabler} {(kabler == 1 ? "kabel" : "kabler")}");
        var streker = i.Streker.Count - kabler;
        if (streker > 0) deler.Add($"{streker} {(streker == 1 ? "strek" : "streker")}");
        return string.Join(", ", deler);
    }

    // Ctrl + A: alt på tegningen unntatt låste komponenter (f.eks. bakgrunnsbilde).
    private void MarkerAlle()
