        PushUndo();
        foreach (var s in _streker)
        {
            s.PunkterJson = RettOppPunkter(s.PunkterJson);
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Alle streker er rettet opp.";
    }

    // Setter inn et hjørne i alle skrå strekbiter (vannrett først), og fjerner
    // doble punkter og punkter som ligger midt på en rett linje.
    private static string RettOppPunkter(string punkterJson)
    {
        const double eps = 0.05;
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        var med = new List<KoblingsStrekPunkt>();
        foreach (var p in punkter)
        {
            if (med.Count > 0)
            {
                var forrige = med[^1];
                if (Math.Abs(forrige.X - p.X) >= eps && Math.Abs(forrige.Y - p.Y) >= eps)
                {
                    med.Add(new KoblingsStrekPunkt { X = p.X, Y = forrige.Y });
                }
            }

            med.Add(new KoblingsStrekPunkt { X = p.X, Y = p.Y });
        }

        var renset = new List<KoblingsStrekPunkt>();
        foreach (var p in med)
        {
            if (renset.Count > 0 && Math.Abs(renset[^1].X - p.X) < eps && Math.Abs(renset[^1].Y - p.Y) < eps)
            {
                continue;
            }

            renset.Add(p);
        }

        for (var i = renset.Count - 2; i > 0; i--)
        {
            var a = renset[i - 1];
            var b = renset[i];
            var c = renset[i + 1];
            if ((Math.Abs(a.X - b.X) < eps && Math.Abs(b.X - c.X) < eps) || (Math.Abs(a.Y - b.Y) < eps && Math.Abs(b.Y - c.Y) < eps))
            {
                renset.RemoveAt(i);
            }
        }

        return renset.Count < 2 ? punkterJson : JsonSerializer.Serialize(renset);
    }

    // Lagrer nye strekpunkter for streker som fulgte med en flyttet komponent.
    private void OppdaterTilkobledeStreker(string? streker)
    {
        if (string.IsNullOrWhiteSpace(streker))
        {
            return;
        }

        var endringer = JsonSerializer.Deserialize<List<StrekEndring>>(streker) ?? [];
        foreach (var e in endringer)
        {
            if (e.Id < 0 && !string.IsNullOrWhiteSpace(e.PunkterJson))
            {
                SettLederVei(e.Id, e.PunkterJson);
                continue;
            }
            var strek = _streker.FirstOrDefault(s => s.Id == e.Id);
            if (strek is not null && !string.IsNullOrWhiteSpace(e.PunkterJson))
            {
                strek.PunkterJson = e.PunkterJson;
            }
        }
    }

    private sealed class StrekEndring
    {
        public int Id { get; set; }
        public string? PunkterJson { get; set; }
    }

    [JSInvokable]
    public async Task OnSymbolerFlyttet(string flyttetJson, string streker)
    {
        var flyttet = JsonSerializer.Deserialize<List<FlyttetSymbol>>(flyttetJson) ?? [];
        if (flyttet.Count == 0)
        {
            return;
        }

        PushUndo();
        foreach (var f in flyttet)
        {
            var symbol = _symboler.FirstOrDefault(s => s.Id == f.Id);
            if (symbol is not null)
            {
                symbol.PosX = f.X;
                symbol.PosY = f.Y;
            }
        }

        OppdaterTilkobledeStreker(streker);
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private Task VisPdfFane() => ByttFane("pdf");

    // Lerretet finnes bare på Rediger-fanen. Forlater vi den, kobles de globale
    // tastelytterne fra; kommer vi tilbake, kobles lerretet til på nytt i
    // OnAfterRenderAsync (ellers virket verken dra, zoom eller hurtigtaster).
    private async Task ByttFane(string fane)
    {
        if (_fane == fane)
        {
            return;
        }
        if (_fane == "rediger" && _lerretKoblet && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disableKeyboardShortcuts", _canvasRef);
                await _module.InvokeVoidAsync("disableEditorSnarveier", _canvasRef);
            }
            catch (JSDisconnectedException)
            {
            }
            _lerretKoblet = false;
        }
        _fane = fane;
    }

