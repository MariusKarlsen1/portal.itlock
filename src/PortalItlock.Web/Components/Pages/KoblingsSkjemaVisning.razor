    [JSInvokable]
    public async Task OnSnarvei(string kommando)
    {
        if (!_redigerModus)
        {
            return;
        }

        switch (kommando)
        {
            case "strek":
                await ToggleTegnStrekModus();
                break;
            case "velg":
                await VelgVerktoy();
                break;
            case "tekst":
                await VelgVerktoy();
                await LeggTilFigur(KoblingsElementType.Tekstboks);
                break;
            case "angre":
                await Angre();
                break;
            case "gjorom":
                await GjorOm();
                break;
            case "avvelg":
                AvbrytValg();
                break;
        }

        StateHasChanged();
    }

