    [JSInvokable]
    public void OnSymbolClicked(int symbolId, bool shiftKey)
    {
        var valgt = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (valgt is null)
        {
            return;
        }

        if (shiftKey)
        {
            if (!_valgteSymbolIds.Add(symbolId))
            {
                _valgteSymbolIds.Remove(symbolId);
            }
        }
        else
        {
            _valgteSymbolIds.Clear();
            _valgteSymbolIds.Add(symbolId);
        }

        if (_valgteSymbolIds.Count == 1)
        {
            PushUndo();
            _selectedSymbol = valgt;
        }
        else
        {
            _selectedSymbol = null;
        }

        StateHasChanged();
    }

    private void AvbrytValg()
    {
        _valgteSymbolIds.Clear();
        _selectedSymbol = null;
    }

    [JSInvokable]
    public async Task OnSymbolMoved(int symbolId, double x, double y)
    {
        var symbol = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (symbol is null)
        {
            return;
        }

        PushUndo();
        symbol.PosX = x;
        symbol.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public async Task OnSymbolsMoved(string flyttetJson)
    {
        var flyttet = JsonSerializer.Deserialize<List<FlyttetSymbol>>(flyttetJson) ?? [];
        if (flyttet.Count == 0)
        {
            return;
        }

        PushUndo();

        foreach (var f in flyttet)
        {
            var symbol = _symboler.FirstOrDefault(s => s.Id == f.Id);
            if (symbol is not null)
            {
                symbol.PosX = f.X;
                symbol.PosY = f.Y;
            }
        }

        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private sealed class FlyttetSymbol
    {
        public int Id { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
    }

    [JSInvokable]
    public async Task OnSymbolResized(int symbolId, double bredde, double hoyde)
    {
        var symbol = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (symbol is null)
        {
            return;
        }

        PushUndo();
        symbol.Bredde = bredde;
        symbol.Hoyde = hoyde;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public async Task OnSlettTastetrykk()
    {
        if (_valgteSymbolIds.Count > 1)
        {
            await SlettValgte();
        }
        else if (_selectedSymbol is not null)
        {
            await SlettSymbol();
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnRubberBandValgt(string idsJson, bool shiftKey)
    {
        var ids = JsonSerializer.Deserialize<List<int>>(idsJson) ?? [];

        if (!shiftKey)
        {
            _valgteSymbolIds.Clear();
        }

        foreach (var id in ids)
        {
            _valgteSymbolIds.Add(id);
        }

        _selectedSymbol = _valgteSymbolIds.Count == 1
            ? _symboler.FirstOrDefault(s => s.Id == _valgteSymbolIds.First())
            : null;

        if (_valgteSymbolIds.Count == 1)
        {
            PushUndo();
        }

        StateHasChanged();
    }

    private async Task SendBakerst()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        var min = _symboler.Count > 0 ? _symboler.Min(s => s.ZIndex) : 0;
        _selectedSymbol.ZIndex = min - 1;
        await Db.SaveChangesAsync();
    }

    private async Task SendFremst()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        var max = _symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0;
        _selectedSymbol.ZIndex = max + 1;
        await Db.SaveChangesAsync();
    }

    private async Task ToggleErLaast()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        _selectedSymbol.ErLaast = !_selectedSymbol.ErLaast;
        await Db.SaveChangesAsync();
    }

    private async Task DupliserValgte()
    {
        if (_valgteSymbolIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        var nye = new List<KoblingsSymbol>();
        var nesteZIndex = (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0) + 1;

        foreach (var s in kilder)
        {
            var kopi = new KoblingsSymbol
            {
                KoblingsSkjemaId = s.KoblingsSkjemaId,
                ElementType = s.ElementType,
                Navn = s.Navn,
                SymbolBibliotekId = s.SymbolBibliotekId,
                Farge = s.Farge,
                Strokbredde = s.Strokbredde,
                Fylt = s.Fylt,
                Tekst = s.Tekst,
                FontStorrelse = s.FontStorrelse,
                PosX = s.PosX + 4,
                PosY = s.PosY + 4,
                Bredde = s.Bredde,
                Hoyde = s.Hoyde,
                ZIndex = nesteZIndex
            };
            Db.KoblingsSymboler.Add(kopi);
            nye.Add(kopi);
        }

        await Db.SaveChangesAsync();
        _symboler.AddRange(nye);
        _valgteSymbolIds.Clear();
        foreach (var n in nye)
        {
            _valgteSymbolIds.Add(n.Id);
        }
        _selectedSymbol = null;
    }

    private async Task SlettValgte()
    {
        if (_valgteSymbolIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        Db.KoblingsSymboler.RemoveRange(kilder);
        await Db.SaveChangesAsync();

        foreach (var s in kilder)
        {
            _symboler.Remove(s);
        }

        _valgteSymbolIds.Clear();
        _selectedSymbol = null;
    }

    private async Task LagreSymbol()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SlettSymbol()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        Db.KoblingsSymboler.Remove(_selectedSymbol);
        await Db.SaveChangesAsync();
        _symboler.Remove(_selectedSymbol);
        _valgteSymbolIds.Remove(_selectedSymbol.Id);
        _selectedSymbol = null;
    }

    private async Task Lagre()
    {
        if (_skjema is null)
        {
            return;
        }

        _skjema.OppdatertDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
