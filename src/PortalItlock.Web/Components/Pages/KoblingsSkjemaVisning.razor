    private async Task OnSymbolFilValgt(InputFileChangeEventArgs e)
    {
        if (_skjema is null)
        {
            return;
        }

        var file = e.File;
        if (file.Size > 5_000_000)
        {
            _savedMessage = "Bildet er for stort (maks 5 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 5_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var navn = Path.GetFileNameWithoutExtension(file.Name);
        var bibliotekSymbol = new KoblingsSymbolBibliotek
        {
            Navn = navn,
            BildeData = buffer.ToArray(),
            BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType
        };

        Db.KoblingsSymbolBibliotek.Add(bibliotekSymbol);
        await Db.SaveChangesAsync();
        _bibliotek.Add(bibliotekSymbol);

        PushUndo();
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = KoblingsElementType.Bilde,
            SymbolBibliotekId = bibliotekSymbol.Id,
            Navn = navn
        };

        Db.KoblingsSymboler.Add(symbol);
        await Db.SaveChangesAsync();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
    }

