    private async Task LeggTilKomponent(KoblingsKomponent komponent) => await LeggTilKomponent(komponent, null, null);

    // Uten posisjon (klikk i paletten) trappes plasseringen; med posisjon
    // (dratt inn på lerretet) havner midten av komponenten der den slippes.
    private async Task LeggTilKomponent(KoblingsKomponent komponent, double? midtX, double? midtY)
    {
        if (_skjema is null)
        {
            return;
        }

        PushUndo();

        // Trapp posisjonen nedover/mot høyre for hver nye komponent, ellers
        // havner alt oppå hverandre midt på lerretet når man klikker flere
        // ganger i paletten.
        var trinn = _symboler.Count % 10;
        // Tegningene beholder formen sin: høyden regnes om fra lerretets 16:13-forhold.
        var storrelse = komponent.Bredde;
        var hoyde = Math.Round(komponent.Bredde * komponent.Forhold * 16 / 13, 1);
        var symbol = new KoblingsSymbol
        {
            KoblingsSkjemaId = _skjema.Id,
            ElementType = KoblingsElementType.Komponent,
            KomponentNokkel = komponent.Nokkel,
            Navn = komponent.Navn,
            PosX = midtX is double x ? Math.Clamp(Math.Round((x - storrelse / 2) / 2) * 2, 0, 100 - storrelse) : 20 + trinn * 5,
            PosY = midtY is double y ? Math.Clamp(Math.Round((y - hoyde / 2) / 2) * 2, 0, 100 - hoyde) : Math.Min(20 + trinn * 5, 100 - hoyde),
            Bredde = storrelse,
            Hoyde = hoyde
        };

        Db.KoblingsSymboler.Add(symbol);
        await Db.SaveChangesAsync();
        _symboler.Add(symbol);
        _visLeggTilMeny = false;
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _valgteSymbolIds.Add(symbol.Id);
        _selectedSymbol = symbol;
    }

    // Velger farge/stiplet for neste strek fra "Kabling"-forklaringen, og slår
    // på strektegning med én gang slik at montøren kan tegne rett etter klikket.
    private async Task VelgKabelType(KoblingsKabelType kabel)
    {
        _nyStrekKabel = false;
        _nyStrekFarge = kabel.Farge;
        _nyStrekStiplet = kabel.Stiplet;

        // Er en strek valgt, får den kabeltypen i stedet.
        if (_valgtStrek is not null && !_tegnStrekModus)
        {
            await EndreStrek(_valgtStrek, s =>
            {
                s.Farge = kabel.Farge;
                s.Stiplet = kabel.Stiplet;
            });
            return;
        }

        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }

    private string KabelIndeks(KoblingsStrek s)
    {
        var i = KoblingsKomponentKatalog.Kabling.FindIndex(k =>
            string.Equals(k.Farge, s.Farge, StringComparison.OrdinalIgnoreCase) && k.Stiplet == s.Stiplet);
        return i < 0 ? "" : i.ToString(CultureInfo.InvariantCulture);
    }

    private async Task SettKabelPaStrek(KoblingsStrek strek, string? verdi)
    {
        if (verdi == "kabel")
        {
            await EndreStrek(strek, GjorKabel);
            return;
        }
        if (!int.TryParse(verdi, out var i) || i < 0 || i >= KoblingsKomponentKatalog.Kabling.Count)
        {
            return;
        }

        var kabel = KoblingsKomponentKatalog.Kabling[i];
        await EndreStrek(strek, s =>
        {
            s.Farge = kabel.Farge;
            s.Stiplet = kabel.Stiplet;
        });
    }

    private async Task EndreStrek(KoblingsStrek strek, Action<KoblingsStrek> endre)
    {
        PushUndo();
        endre(strek);
        await Db.SaveChangesAsync();
    }

