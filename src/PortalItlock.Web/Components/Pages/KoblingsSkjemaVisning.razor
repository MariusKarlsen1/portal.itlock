    [JSInvokable]
    public async Task OnStrekFerdig(string punkterJson)
    {
        if (_skjema is null)
        {
            return;
        }

        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (punkter.Count < 2)
        {
            return;
        }

        PushUndo();
        var strek = new KoblingsStrek
        {
            KoblingsSkjemaId = _skjema.Id,
            PunkterJson = punkterJson,
            Farge = _nyStrekFarge,
            Tykkelse = _nyStrekTykkelse,
            Stiplet = _nyStrekStiplet
        };

        Db.KoblingsStreker.Add(strek);
        await Db.SaveChangesAsync();
        _streker.Add(strek);
        StateHasChanged();

        if (_tegnStrekModus && _module is not null)
        {
            await _module.InvokeVoidAsync("startStrekTegning", _canvasRef, _dotNetRef, _nyStrekFarge, _nyStrekTykkelse);
        }
    }

