    // Ctrl + C / Ctrl + V: det som er markert (komponenter, kabler, streker og tekst)
    // legges på brukerens utklippstavle og kan limes inn her eller på et annet skjema.
    // På samme skjema legges kopien litt forskjøvet; på et annet skjema på samme sted.
    // Neste innliming forskyves videre fra den forrige.
    private string? _utklippNokkel;
    private KoblingsUtklipp.Innhold? _sistInnlimt;
    private int _innlimtGanger;

    private KoblingsUtklipp.Innhold? UtklippInnhold => _utklippNokkel is null ? null : Utklipp.Hent(_utklippNokkel);

    private string ValgtTekst()
    {
        var deler = new List<string>();
        if (_valgteSymbolIds.Count > 0)
        {
            deler.Add($"{_valgteSymbolIds.Count} {(_valgteSymbolIds.Count == 1 ? "komponent" : "komponenter")}");
        }
        var kabler = _streker.Count(s => _valgteStrekIds.Contains(s.Id) && s.ErKabel);
        var streker = _valgteStrekIds.Count - kabler;
        if (kabler > 0)
        {
            deler.Add($"{kabler} {(kabler == 1 ? "kabel" : "kabler")}");
        }
        if (streker > 0)
        {
            deler.Add($"{streker} {(streker == 1 ? "strek" : "streker")}");
        }
        return string.Join(", ", deler);
    }

    private async Task<string> HentUtklippNokkel()
    {
        if (_utklippNokkel is null)
        {
            var bruker = AuthState is null ? null : (await AuthState).User;
            _utklippNokkel = KoblingsUtklipp.Nokkel(TenantCtx.Current?.Id,
                bruker?.FindFirst("BrukerId")?.Value ?? bruker?.Identity?.Name);
        }
        return _utklippNokkel;
    }

