    public async Task OnStrekFerdig(string punkterJson)
    {
        if (_skjema is null)
        {
            return;
        }

        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (punkter.Count < 2)
        {
            return;
        }

        PushUndo();
        var strek = new KoblingsStrek
        {
            KoblingsSkjemaId = _skjema.Id,
            PunkterJson = punkterJson,
            Farge = _nyStrekFarge,
            Tykkelse = _nyStrekTykkelse,
            Stiplet = _nyStrekStiplet
        };
        if (_nyStrekKabel)
        {
            GjorKabel(strek);
        }

        Db.KoblingsStreker.Add(strek);
        await Db.SaveChangesAsync();
        _streker.Add(strek);

        // En ny kabel velges med en gang, så lederne kan dras dit de skal.
        if (strek.ErKabel && _tegnStrekModus)
        {
            await ToggleTegnStrekModus();
            _valgtStrek = strek;
        }
        StateHasChanged();
    }

