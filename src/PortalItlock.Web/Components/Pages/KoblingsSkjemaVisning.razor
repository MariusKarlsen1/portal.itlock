    public void OnStrekAvbrutt()
    {
    }

    private async Task SlettStrek(KoblingsStrek s)
    {
        PushUndo();
        Db.KoblingsStreker.Remove(s);
        await Db.SaveChangesAsync();
        _streker.Remove(s);
