    [JSInvokable]
    public async Task OnRubberBandValgt(string idsJson, bool shiftKey, double x1, double y1, double x2, double y2)
    {
        var ids = JsonSerializer.Deserialize<List<int>>(idsJson) ?? [];
        // Dratt en boks mens skjemaet bare vises: gå i Rediger, så det markerte kan kopieres og flyttes.
        if (!_redigerModus)
        {
            await StartRedigering();
        }
        _valgtStrek = null;
        _markerModus = false;
        _visSymbolPanel = false;

        if (!shiftKey)
        {
            _valgteSymbolIds.Clear();
            _valgteStrekIds.Clear();
        }

        foreach (var id in ids)
        {
            _valgteSymbolIds.Add(id);
        }

        // Streker og kabler som ligger helt inni boksen blir også markert.
        const double slakk = 0.5;
        foreach (var strek in _streker)
        {
            var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(strek.PunkterJson) ?? [];
            if (punkter.Count > 0 && punkter.All(p => p.X >= x1 - slakk && p.X <= x2 + slakk && p.Y >= y1 - slakk && p.Y <= y2 + slakk))
            {
                _valgteStrekIds.Add(strek.Id);
            }
        }

        _selectedSymbol = _valgteSymbolIds.Count == 1
            ? _symboler.FirstOrDefault(s => s.Id == _valgteSymbolIds.First())
            : null;

        if (_valgteSymbolIds.Count == 1)
        {
            PushUndo();
        }

        StateHasChanged();
    }

