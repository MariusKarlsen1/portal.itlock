    private async Task KopierValgte()
    {
        if (_skjema is null)
        {
            return;
        }
        var symboler = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        if (symboler.Count == 0 && _selectedSymbol is { } k)
        {
            symboler.Add(k);
        }
        var streker = _streker.Where(s => _valgteStrekIds.Contains(s.Id)).ToList();
        // Kabler og streker som går mellom de markerte komponentene, blir med,
        // så det limes inn ferdig koblet.
        foreach (var strek in StrekerMellom(symboler))
        {
            if (!streker.Contains(strek))
            {
                streker.Add(strek);
            }
        }
        if (symboler.Count == 0 && streker.Count == 0 && _valgtStrek is { } st)
        {
            streker.Add(st);
        }
        if (symboler.Count == 0 && streker.Count == 0)
        {
            return;
        }
        var innhold = new KoblingsUtklipp.Innhold(_skjema.Id, KloneSymboler(symboler), KloneStreker(streker));
        Utklipp.Sett(await HentUtklippNokkel(), innhold);
        _sistInnlimt = innhold;
        _innlimtGanger = 0;
        VisUtklippMelding($"Kopiert: {Beskriv(innhold)}. Gå til et annet skjema, trykk der du vil ha det, og trykk Ctrl + V.");
    }

    // Streker der begge endene ligger på eller ved en av komponentene.
    private List<KoblingsStrek> StrekerMellom(List<KoblingsSymbol> symboler)
    {
        if (symboler.Count == 0)
        {
            return [];
        }
        const double slakk = 1.5;
        bool Ved(KoblingsStrekPunkt p) => symboler.Any(s =>
            p.X >= s.PosX - slakk && p.X <= s.PosX + s.Bredde + slakk && p.Y >= s.PosY - slakk && p.Y <= s.PosY + s.Hoyde + slakk);
        return _streker.Where(st =>
        {
            var p = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(st.PunkterJson) ?? [];
            return p.Count >= 2 && Ved(p[0]) && Ved(p[^1]);
        }).ToList();
    }

    // Endre størrelse på alt som er markert (f.eks. rett etter innliming), rundt midten.
    private async Task SkalerValgte(double faktor)
    {
        var symboler = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id) && !s.ErLaast).ToList();
        var streker = _streker.Where(s => _valgteStrekIds.Contains(s.Id)).ToList();
        if ((symboler.Count == 0 && streker.Count == 0) || Grenser(symboler, streker) is not { } g)
        {
            return;
        }
        // Ikke mindre enn 2 % eller større enn hele tegningen.
        var bredde = g.X2 - g.X1;
        if (bredde * faktor < 2 || bredde * faktor > 100)
        {
            return;
        }
        PushUndo();
        var cx = (g.X1 + g.X2) / 2;
        var cy = (g.Y1 + g.Y2) / 2;
        foreach (var s in symboler)
        {
            s.PosX = Math.Round(cx + (s.PosX - cx) * faktor, 3);
            s.PosY = Math.Round(cy + (s.PosY - cy) * faktor, 3);
            s.Bredde = Math.Round(s.Bredde * faktor, 3);
            s.Hoyde = Math.Round(s.Hoyde * faktor, 3);
        }
        foreach (var st in streker)
        {
            var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(st.PunkterJson) ?? [];
            foreach (var p in punkter)
            {
                p.X = Math.Round(cx + (p.X - cx) * faktor, 3);
                p.Y = Math.Round(cy + (p.Y - cy) * faktor, 3);
            }
            st.PunkterJson = JsonSerializer.Serialize(punkter);
            // Lederveiene er punkter på lerretet, så de skaleres rundt samme midte.
            st.LedereJson = KoblingsKabel.Skaler(st.LedereJson, cx, cy, faktor);
        }
        await LagreDb();
        StateHasChanged();
    }

    private sealed record Ramme(double X1, double Y1, double X2, double Y2, int Antall);

    // Rammen rundt alt som er markert (vises når mer enn én ting er markert).
    private Ramme? ValgRamme()
    {
        var antall = _valgteSymbolIds.Count + _valgteStrekIds.Count;
        if (antall < 2)
        {
            return null;
        }
        var b = Grenser(_symboler.Where(s => _valgteSymbolIds.Contains(s.Id)), _streker.Where(s => _valgteStrekIds.Contains(s.Id)));
        return b is null ? null : new Ramme(b.Value.X1, b.Value.Y1, b.Value.X2, b.Value.Y2, antall);
    }

    private static (double X1, double Y1, double X2, double Y2)? Grenser(IEnumerable<KoblingsSymbol> symboler, IEnumerable<KoblingsStrek> streker)
    {
        double x1 = double.MaxValue, y1 = double.MaxValue, x2 = double.MinValue, y2 = double.MinValue;
        foreach (var s in symboler)
        {
            x1 = Math.Min(x1, s.PosX); y1 = Math.Min(y1, s.PosY);
            x2 = Math.Max(x2, s.PosX + s.Bredde); y2 = Math.Max(y2, s.PosY + s.Hoyde);
        }
        foreach (var s in streker)
        {
            foreach (var p in JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [])
            {
                x1 = Math.Min(x1, p.X); y1 = Math.Min(y1, p.Y);
                x2 = Math.Max(x2, p.X); y2 = Math.Max(y2, p.Y);
            }
        }
        return x1 > x2 ? null : (x1, y1, x2, y2);
    }

    // Skissen som følger musen etter Ctrl + C (sendes til koblingsskjema.js).
    private string? _sendtSkisse;

    private string? SkisseJson()
    {
        if (UtklippInnhold is not { Antall: > 0 } u || Grenser(u.Symboler, u.Streker) is not { } g)
        {
            return null;
        }
        static string F(double v) => Math.Round(v, 3).ToString(CultureInfo.InvariantCulture);
        var rekt = u.Symboler.Select(s => $"[{F(s.PosX - g.X1)},{F(s.PosY - g.Y1)},{F(s.Bredde)},{F(s.Hoyde)}]");
        var linjer = u.Streker.Select(s => "[" + string.Join(",", (JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [])
            .Select(p => $"{F(p.X - g.X1)},{F(p.Y - g.Y1)}")) + "]");
        return $"{{\"w\":{F(Math.Max(g.X2 - g.X1, 0.5))},\"h\":{F(Math.Max(g.Y2 - g.Y1, 0.5))},\"rekt\":[{string.Join(",", rekt)}],\"linjer\":[{string.Join(",", linjer)}]}}";
    }

    private async Task OppdaterSkisse()
    {
        if (_module is null || _fane != "rediger")
        {
            return;
        }
        var json = SkisseJson();
        if (json == _sendtSkisse)
        {
            return;
        }
        _sendtSkisse = json;
        try
        {
            await _module.InvokeVoidAsync("settSkisse", _canvasRef, json);
        }
        catch (JSException)
        {
            _sendtSkisse = null;
        }
    }

    [JSInvokable]
    public async Task OnLimInnVed(double? x, double? y)
    {
        await LimInn(x, y);
        StateHasChanged();
    }

    private Task LimInn() => LimInn(null, null);

    private async Task LimInn(double? midtX, double? midtY)
    {
        if (_skjema is null || Utklipp.Hent(await HentUtklippNokkel()) is not { Antall: > 0 } innhold)
        {
            VisUtklippMelding("Ingenting er kopiert ennå. Marker og trykk Ctrl + C først.");
            return;
        }
        // Står skjemaet bare til visning, går det i Rediger først.
        if (!_redigerModus)
        {
            await StartRedigering();
            _visKomponentSkuff = false;
        }
        if (!ReferenceEquals(innhold, _sistInnlimt))
        {
            _sistInnlimt = innhold;
            _innlimtGanger = 0;
        }
        _innlimtGanger++;
        var forskyv = (innhold.FraSkjemaId == _skjema.Id ? 4 : 0) + 4 * (_innlimtGanger - 1);
        double flyttX = forskyv, flyttY = forskyv;
        // Trykket man på tegningen (krysset) eller står musen over den: midten av det
        // kopierte havner der.
        if (midtX is { } mx && midtY is { } my && Grenser(innhold.Symboler, innhold.Streker) is { } g)
        {
            flyttX = Math.Clamp(mx, 0, 100) - (g.X1 + g.X2) / 2;
            flyttY = Math.Clamp(my, 0, 100) - (g.Y1 + g.Y2) / 2;
        }

        PushUndo();
        var nesteZIndex = (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0) + 1;
        var nyeSymboler = KloneSymboler(innhold.Symboler.ToList());
        foreach (var n in nyeSymboler)
        {
            n.Id = 0;
            n.KoblingsSkjemaId = _skjema.Id;
            n.PosX += flyttX;
            n.PosY += flyttY;
            n.ZIndex = nesteZIndex++;
            n.ErLaast = false;
        }
        var nyeStreker = KloneStreker(innhold.Streker.ToList());
        foreach (var n in nyeStreker)
        {
            n.Id = 0;
            n.KoblingsSkjemaId = _skjema.Id;
            if (flyttX != 0 || flyttY != 0)
            {
                var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(n.PunkterJson) ?? [];
                foreach (var p in punkter)
                {
                    p.X += flyttX;
                    p.Y += flyttY;
                }
                n.PunkterJson = JsonSerializer.Serialize(punkter);
                // Lederne følger kabelen, så den limes inn helt lik.
                n.LedereJson = KoblingsKabel.Flytt(n.LedereJson, flyttX, flyttY);
            }
        }
        Db.KoblingsSymboler.AddRange(nyeSymboler);
        Db.KoblingsStreker.AddRange(nyeStreker);
        await LagreDb();

        _symboler.AddRange(nyeSymboler);
        _streker.AddRange(nyeStreker);
        _valgtStrek = null;
        _valgteSymbolIds.Clear();
        _valgteStrekIds.Clear();
        foreach (var n in nyeSymboler)
        {
            _valgteSymbolIds.Add(n.Id);
        }
        foreach (var n in nyeStreker)
        {
            _valgteStrekIds.Add(n.Id);
        }
        _selectedSymbol = nyeSymboler.Count == 1 && nyeStreker.Count == 0 ? nyeSymboler[0] : null;
        VisUtklippMelding($"Limt inn: {Beskriv(innhold)}. Dra for å flytte, eller bruk piltastene.");
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("nullstillLimpunkt", _canvasRef); } catch (JSException) { }
        }
    }

    private async Task DupliserValgte()
    {
        if (_valgteSymbolIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        var nye = new List<KoblingsSymbol>();
        var nesteZIndex = (_symboler.Count > 0 ? _symboler.Max(s => s.ZIndex) : 0) + 1;

        foreach (var s in kilder)
        {
            var kopi = new KoblingsSymbol
            {
                KoblingsSkjemaId = s.KoblingsSkjemaId,
                ElementType = s.ElementType,
                Navn = s.Navn,
                SymbolBibliotekId = s.SymbolBibliotekId,
                KomponentNokkel = s.KomponentNokkel,
                Farge = s.Farge,
                Strokbredde = s.Strokbredde,
                Fylt = s.Fylt,
                Tekst = s.Tekst,
                FontStorrelse = s.FontStorrelse,
                PosX = s.PosX + 4,
                PosY = s.PosY + 4,
                Bredde = s.Bredde,
                Hoyde = s.Hoyde,
                ZIndex = nesteZIndex,
                PorterJson = s.PorterJson,
                SkjulNavn = s.SkjulNavn,
                Fet = s.Fet,
                KablerOver = s.KablerOver,
                NavnPlass = s.NavnPlass
            };
            Db.KoblingsSymboler.Add(kopi);
            nye.Add(kopi);
        }

        await LagreDb();
        _symboler.AddRange(nye);
        _valgteSymbolIds.Clear();
        foreach (var n in nye)
        {
            _valgteSymbolIds.Add(n.Id);
        }
        _selectedSymbol = nye.Count == 1 ? nye[0] : null;
    }

    private async Task SlettValgte()
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanSletteAsync(TilgangAuth))
        {
            return;
        }
        if (_valgteSymbolIds.Count == 0 && _valgteStrekIds.Count == 0)
        {
            return;
        }

        PushUndo();

        var kilder = _symboler.Where(s => _valgteSymbolIds.Contains(s.Id)).ToList();
        var streker = _streker.Where(s => _valgteStrekIds.Contains(s.Id)).ToList();
        Db.KoblingsSymboler.RemoveRange(kilder);
        Db.KoblingsStreker.RemoveRange(streker);
        await LagreDb();

        foreach (var s in kilder)
        {
            _symboler.Remove(s);
        }
        foreach (var s in streker)
        {
            _streker.Remove(s);
        }

        _valgteSymbolIds.Clear();
        _valgteStrekIds.Clear();
        _selectedSymbol = null;
    }

    // Alle lagringer går i kø: glideren for tekststørrelse, tekstfelt som lagrer
    // for hver bokstav og dra-og-slipp fra JS kan ellers starte to lagringer
    // samtidig på samme DbContext, og det krasjer siden («An unhandled error»).
    private readonly SemaphoreSlim _lagreLas = new(1, 1);

    private async Task LagreDb()
    {
        await _lagreLas.WaitAsync();
        try
        {
            // Siden man navigerer til (f.eks. skjemalista) kan bruke samme databasekobling
            // akkurat nå. Da venter vi litt og prøver igjen i stedet for å krasje.
            for (var forsok = 1; ; forsok++)
            {
                try
                {
                    await Db.SaveChangesAsync();
                    break;
                }
                catch (InvalidOperationException) when (forsok < 5)
                {
                    await Task.Delay(200);
                }
            }
        }
        finally
        {
            _lagreLas.Release();
        }
    }

    private async Task LagreSymbol()
    {
        if (_selectedSymbol is null)
        {
            return;
        }

        await LagreDb();
        _savedMessage = "Lagret.";
    }

    private async Task SlettSymbol()
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanSletteAsync(TilgangAuth))
        {
            return;
        }
        if (_selectedSymbol is null)
        {
            return;
        }

        PushUndo();
        Db.KoblingsSymboler.Remove(_selectedSymbol);
        await LagreDb();
        _symboler.Remove(_selectedSymbol);
        _valgteSymbolIds.Remove(_selectedSymbol.Id);
        _selectedSymbol = null;
    }

    private async Task Lagre()
    {
        if (_skjema is null)
        {
            return;
        }

        _skjema.OppdatertDato = DateTime.UtcNow;
        await LagreDb();
        _savedMessage = "Lagret.";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                // Fjerner den globale document-keydown-lytteren fra
                // enableKeyboardShortcuts FØR modulen disposes - uten dette
                // ble lytteren værende på document for alltid (én ny per
                // besøk på et koblingsskjema i samme økt), se CODE_REVIEW.md
                // 2026-10-08 (bekreftet minnelekkasje).
                // Lerretet kan allerede være fjernet her, så oppryddingen trenger det ikke.
                await _module.InvokeVoidAsync("ryddOpp");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
                // Siden er på vei bort - en feil i oppryddingen skal aldri krasje.
            }
            catch (TaskCanceledException)
            {
            }
        }
    }

    // ---------- Kabel med ledere og kabeljournal ----------
    // Lerretet er 16:13, så lederne må regnes med det forholdet for å stå vinkelrett på kabelen.
    private const double LerretAspekt = 13.0 / 16.0;

    private static string Inv(double v) => Math.Round(v, 3).ToString(CultureInfo.InvariantCulture);

    private static string Pts(List<KoblingsStrekPunkt> punkter) =>
        string.Join(" ", punkter.Select(p => $"{Inv(p.X)},{Inv(p.Y)}"));

    private static string? TomTilNull(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static KoblingsKabel.Vifte? KabelVifte(KoblingsStrek s)
    {
        if (!s.ErKabel)
        {
            return null;
        }
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [];
        return KoblingsKabel.LagVifte(punkter, KoblingsKabel.Les(s.LedereJson), LerretAspekt, s.LederAvstand, s.LederLengde, s.KabelMerkePlass);
    }

    private static string KabelEtikett(KoblingsStrek s) =>
        $"{s.Navn} · {(string.IsNullOrWhiteSpace(s.KabelType) ? KoblingsKabel.MalNavn(KoblingsKabel.Les(s.LedereJson)) : s.KabelType)}";

    private List<KoblingsStrek> Kabler() =>
        _streker.Where(s => s.ErKabel)
            .OrderBy(s => KabelNummer(s.Navn) ?? int.MaxValue).ThenBy(s => s.Id)
            .ToList();

    private static int? KabelNummer(string? navn) =>
        navn is { Length: > 1 } && (navn[0] == 'K' || navn[0] == 'k') && int.TryParse(navn[1..], out var n) ? n : null;

    private string NesteKabelNavn() =>
        $"K{_streker.Select(s => KabelNummer(s.Navn) ?? 0).DefaultIfEmpty(0).Max() + 1}";

    private void GjorKabel(KoblingsStrek s)
    {
        s.LedereJson ??= KoblingsKabel.Skriv(KoblingsKabel.MedAntall([], 4));
        s.Navn ??= NesteKabelNavn();
        s.Farge = KoblingsKabel.KabelFarge;
        s.Tykkelse = 6;
        s.Stiplet = false;
    }

    private Task GjorTilStrek(KoblingsStrek strek) => EndreStrek(strek, s =>
    {
        s.LedereJson = null;
        s.Farge = KoblingsKomponentKatalog.Kabling[3].Farge;
        s.Tykkelse = 2;
    });

    private async Task VelgFlerlederKabel()
    {
        if (_valgtStrek is not null && !_tegnStrekModus)
        {
            await EndreStrek(_valgtStrek, GjorKabel);
            return;
        }

        _nyStrekKabel = true;
        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }

    private Task EndreLedere(KoblingsStrek strek, Func<List<KoblingsLeder>, List<KoblingsLeder>> endre) =>
        EndreStrek(strek, s => s.LedereJson = KoblingsKabel.Skriv(endre(KoblingsKabel.Les(s.LedereJson))));

    private Task EndreLeder(KoblingsStrek strek, int idx, Action<KoblingsLeder> endre) =>
        EndreLedere(strek, ledere =>
        {
            if (idx >= 0 && idx < ledere.Count)
            {
                endre(ledere[idx]);
            }
            return ledere;
        });

    private Task SettAntallLedere(KoblingsStrek strek, int antall) =>
        EndreLedere(strek, ledere => KoblingsKabel.MedAntall(ledere, antall, KoblingsKabel.ErPar(ledere)));

    private Task SettKabelMal(KoblingsStrek strek, string? navn)
    {
        var mal = KoblingsKabel.Maler.FirstOrDefault(m => m.Navn == navn);
        return mal is null
            ? Task.CompletedTask
            : EndreLedere(strek, ledere => KoblingsKabel.MedAntall(ledere, mal.Antall, mal.Par));
    }

    private Task SettLederFarge(KoblingsStrek strek, int idx, string? verdi) =>
        EndreLeder(strek, idx, l =>
        {
            var stiplet = verdi?.StartsWith('~') == true;
            var navn = stiplet ? verdi![1..] : verdi;
            if (KoblingsKabel.Farger.Any(f => f.Navn == navn))
            {
                l.Farge = navn!;
                l.Stiplet = stiplet;
            }
        });

    // Valgt leder (negativ id fra KoblingsKabel.LederId), eller null.
    private int? _valgtLederId;

    private int ValgtJsStrekId() =>
        _valgtStrek is null ? 0
        : _valgtLederId is { } l && KoblingsKabel.LesLederId(l)?.StrekId == _valgtStrek.Id ? l
        : _valgtStrek.Id;

    // Lagrer veien til én leder etter at den er dratt. Første punkt er der lederen
    // forlater kabelen; det regnes ut på nytt hver gang og lagres ikke.
    // auto: true = koblet til et punkt (veien legges automatisk), false = egen vei
    // som montøren har tegnet, null = behold det lederen har i dag.
    private bool SettLederVei(int lederId, string punkterJson, bool? auto = false)
    {
        if (KoblingsKabel.LesLederId(lederId) is not { } l)
        {
            return false;
        }
        var strek = _streker.FirstOrDefault(s => s.Id == l.StrekId && s.ErKabel);
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        if (strek is null || punkter.Count < 2)
        {
            return false;
        }
        var ledere = KoblingsKabel.Les(strek.LedereJson);
        if (l.Indeks < 0 || l.Indeks >= ledere.Count)
        {
            return false;
        }
        var leder = ledere[l.Indeks];
        var erAuto = auto ?? (l.ErStart ? leder.StartAuto : leder.SluttAuto);
        List<KoblingsStrekPunkt> vei = erAuto ? [punkter[^1]] : punkter.Skip(1).ToList();
        if (l.ErStart)
        {
            leder.Start = vei;
            leder.StartAuto = erAuto;
        }
        else
        {
            leder.Slutt = vei;
            leder.SluttAuto = erAuto;
        }
        strek.LedereJson = KoblingsKabel.Skriv(ledere);
        return true;
    }

    private Task NullstillLederVeier(KoblingsStrek strek) =>
        EndreLedere(strek, ledere =>
        {
            foreach (var l in ledere)
            {
                l.Start = null;
                l.Slutt = null;
                l.StartAuto = false;
                l.SluttAuto = false;
            }
            return ledere;
        });

    // Alle ledere som er trukket et sted får automatisk, ryddig vei dit de slutter.
    private Task RyddLedere(KoblingsStrek strek) =>
        EndreLedere(strek, ledere =>
        {
            foreach (var l in ledere)
            {
                if (l.Start is { Count: > 0 } s)
                {
                    l.Start = [s[^1]];
                    l.StartAuto = true;
                }
                if (l.Slutt is { Count: > 0 } e)
                {
                    l.Slutt = [e[^1]];
                    l.SluttAuto = true;
                }
            }
            return ledere;
        });

    // Glidebryteren for avstand mellom ledere: tegningen følger med mens man drar,
    // og det lagres når man slipper.
    private bool _avstandDras;

    private static double? LesProsent(string? verdi) =>
        double.TryParse(verdi, NumberStyles.Float, CultureInfo.InvariantCulture, out var p) && double.IsFinite(p) ? p / 100 : null;

    private void DraLederAvstand(KoblingsStrek strek, string? verdi)
    {
        if (LesProsent(verdi) is not { } f)
        {
            return;
        }
        if (!_avstandDras)
        {
            PushUndo();
            _avstandDras = true;
        }
        strek.LederAvstand = KoblingsKabel.AvstandVerdi(f);
    }

    private void DraLederLengde(KoblingsStrek strek, string? verdi)
    {
        if (LesProsent(verdi) is not { } f)
        {
            return;
        }
        if (!_avstandDras)
        {
            PushUndo();
            _avstandDras = true;
        }
        strek.LederLengde = KoblingsKabel.LengdeVerdi(f);
    }

    private async Task SettLederLengde(KoblingsStrek strek, string? verdi)
    {
        if (LesProsent(verdi) is not { } f)
        {
            return;
        }
        if (!_avstandDras)
        {
            PushUndo();
        }
        _avstandDras = false;
        strek.LederLengde = KoblingsKabel.LengdeVerdi(f);
        await LagreDb();
    }

    private async Task SettLederAvstand(KoblingsStrek strek, string? verdi)
    {
        if (LesProsent(verdi) is not { } f)
        {
            return;
        }
        if (!_avstandDras)
        {
            PushUndo();
        }
        _avstandDras = false;
        strek.LederAvstand = KoblingsKabel.AvstandVerdi(f);
        await LagreDb();
    }

    // ---------- Arbeidsflate (forslag A) ----------
    private bool _visKomponentSkuff;
    private bool _visJournal;
    private bool _visInnstillinger;

    private async Task StartRedigering()
    {
        await ToggleRedigerModus();
        // Et tomt skjema åpner med komponentene fremme, så man vet hvor man starter.
        _visKomponentSkuff = _symboler.Count == 0;
        _visJournal = false;
        _visInnstillinger = false;
    }

    private async Task FerdigRedigering()
    {
        await Lagre();
        _visKomponentSkuff = false;
        _visJournal = false;
        _visInnstillinger = false;
        if (_redigerModus)
        {
            await ToggleRedigerModus();
        }
    }

    private async Task VelgVanligStrek()
    {
        _nyStrekKabel = false;
        if (!_tegnStrekModus)
        {
            await ToggleTegnStrekModus();
        }
        else
        {
            await StartStrekPaNytt();
        }
    }

    // ---------- Forlenge en leder (klikk på lederen, klikk for sving, Esc stopper) ----------
    private int? _tegnerLederId;

    [JSInvokable]
    public void OnLederTegningStart(int lederId)
    {
        _tegnerLederId = lederId;
        _selectedSymbol = null;
        _valgteSymbolIds.Clear();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnLederForlenget(int lederId, string punkterJson, bool tilPort)
    {
        _tegnerLederId = null;
        PushUndo();
        // Koblet til et punkt: lederne legger seg ryddig av seg selv.
        if (SettLederVei(lederId, punkterJson, tilPort))
        {
            await LagreDb();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnLederTegningSlutt()
    {
        _tegnerLederId = null;
        StateHasChanged();
    }
}

@code {
    // ---------- Egne koblingspunkter (blå punkter kablene kobles i) ----------
    private bool _plasserPort;

    private async Task VekslePortPlassering()
    {
        if (_module is null || _selectedSymbol is null)
        {
            return;
        }
        if (_plasserPort)
        {
            _plasserPort = false;
            try
            {
                await _module.InvokeVoidAsync("stoppPortPlassering");
            }
            catch (JSException)
            {
            }
            return;
        }
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            await _module.InvokeVoidAsync("startPortPlassering", _canvasRef, _dotNetRef, _selectedSymbol.Id);
            _plasserPort = true;
        }
        catch (JSException)
        {
            // Lerretet er ikke klart (f.eks. midt i et fanebytte) - prøv igjen.
        }
    }

    [JSInvokable]
    public async Task OnPortLagtTil(int symbolId, double x, double y)
    {
        var s = _symboler.FirstOrDefault(s => s.Id == symbolId);
        if (s is null)
        {
            return;
        }
        var porter = KoblingsPorter.Les(s.PorterJson);
        if (porter.Count >= KoblingsPorter.Maks)
        {
            return;
        }
        PushUndo();
        porter.Add((x, y));
        s.PorterJson = KoblingsPorter.Skriv(porter);
        await LagreDb();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPortPlasseringSlutt()
    {
        _plasserPort = false;
        StateHasChanged();
    }

    private async Task FjernPort(int idx)
    {
        if (_selectedSymbol is null)
        {
            return;
        }
        var porter = KoblingsPorter.Les(_selectedSymbol.PorterJson);
        if (idx < 0 || idx >= porter.Count)
        {
            return;
        }
        PushUndo();
        porter.RemoveAt(idx);
        _selectedSymbol.PorterJson = KoblingsPorter.Skriv(porter);
        await LagreDb();
    }
}
