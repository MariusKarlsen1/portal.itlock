    [JSInvokable]
    public void OnRubberBandValgt(string idsJson, bool shiftKey)
    {
        var ids = JsonSerializer.Deserialize<List<int>>(idsJson) ?? [];

        if (!shiftKey)
        {
            _valgteSymbolIds.Clear();
        }

        foreach (var id in ids)
        {
            _valgteSymbolIds.Add(id);
        }

        _selectedSymbol = _valgteSymbolIds.Count == 1
            ? _symboler.FirstOrDefault(s => s.Id == _valgteSymbolIds.First())
            : null;

        if (_valgteSymbolIds.Count == 1)
        {
            PushUndo();
        }

        StateHasChanged();
    }

