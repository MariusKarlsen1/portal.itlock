            Bredde = type switch { KoblingsElementType.Tekstboks => 15, KoblingsElementType.Punkt => 3, _ => 10 },
            Hoyde = type switch { KoblingsElementType.Tekstboks => 6, KoblingsElementType.Punkt => 3, _ => 10 }
        };

