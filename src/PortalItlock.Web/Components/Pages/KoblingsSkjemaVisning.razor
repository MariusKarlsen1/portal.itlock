    // Piltast med en strek valgt: flytter hele streken (0,1 % per trykk,
    // Shift = 2 %). Én angre-rad per runde med trykk.
    private DateTime _sistPil;

    [JSInvokable]
    public async Task OnPilStrek(double dx, double dy)
    {
        if (_valgtStrek is not { } strek)
        {
            return;
        }
        var punkter = System.Text.Json.JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(strek.PunkterJson) ?? [];
        if (punkter.Count == 0)
        {
            return;
        }
        if (DateTime.UtcNow - _sistPil > TimeSpan.FromSeconds(1.5))
        {
            PushUndo();
        }
        _sistPil = DateTime.UtcNow;
        // Hele streken flyttes likt, men ikke ut av lerretet.
        dx = Math.Clamp(dx, -punkter.Min(q => q.X), 100 - punkter.Max(q => q.X));
        dy = Math.Clamp(dy, -punkter.Min(q => q.Y), 100 - punkter.Max(q => q.Y));
        foreach (var q in punkter)
        {
            q.X = Math.Round(q.X + dx, 3);
            q.Y = Math.Round(q.Y + dy, 3);
        }
        strek.PunkterJson = System.Text.Json.JsonSerializer.Serialize(punkter);
        strek.LedereJson = KoblingsKabel.Flytt(strek.LedereJson, dx, dy);
        await LagreDb();
        StateHasChanged();
    }

