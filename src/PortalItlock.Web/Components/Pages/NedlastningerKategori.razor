@page "/guide/oppsett-adgangskontroll/{KategoriId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Oppsett adgangskontroll - @_tittel</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else
{
    @* F1 (oppsett-forslag): filene til venstre med annenhver grå og hvit rad, og
       valgt fil til høyre med knappene over. Som Kobling og Dørmiljø. *@
    <div class="nk-side @(_full ? "nk-full" : "")">
    <div class="nk-kort">
        <a class="back-link nk-tilbake" href="/guide/oppsett-adgangskontroll"><Icon Name="arrow-left" />Til oppsett adgangskontroll</a>

        <header class="nk-hode">
            <div class="nk-hode-tekst">
                <h1>@_tittel</h1>
                <p>@_undertekst · @(_filer.Count == 1 ? "1 fil" : $"{_filer.Count} filer")</p>
            </div>
            <AuthorizeView Roles="Admin">
                <button type="button" class="nk-knapp @(_redigerModus ? "nk-knapp-primaer" : "")" @onclick="ToggleRedigerModus"><Icon Name="@(_redigerModus ? "check" : "edit")" />@(_redigerModus ? "Ferdig" : "Rediger")</button>
            </AuthorizeView>
            <button type="button" class="nk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </header>

        @if (_filer.Count == 0)
        {
            <div class="nk-tom">
                <b>Ingen filer lastet opp ennå</b>
                @if (_redigerModus)
                {
                    <FilOpplastingssone Laster="_laster" Feilmelding="@_feilmelding" OnFilValgt="LastOppFil" />
                }
            </div>
        }
        else
        {
            <div class="nk-delt">
                <section class="nk-ramme">
                    <div class="nk-gra">Filer <small>@_filer.Count</small></div>
                    <label class="nk-sok">
                        <Icon Name="search" />
                        <input @bind="_sok" @bind:event="oninput" placeholder="Søk" aria-label="Søk etter fil" />
                    </label>
                    <div class="nk-rader">
                        @foreach (var f in _filtrerte)
                        {
                            <button type="button" @key="f.Id" class="@(f.Id == _valgtId ? "valgt" : "")" aria-current="@(f.Id == _valgtId ? "true" : "false")" @onclick="@(() => VelgFil(f.Id))">
                                <span class="nk-type">@TypeKort(f.ContentType)</span>
                                <span class="nk-rad-tekst">
                                    <b>@f.Navn</b>
                                    <small>@FormatStorrelse(f.StorrelseBytes)</small>
                                </span>
                            </button>
                        }
                    </div>
                    @if (_filtrerte.Count == 0)
                    {
                        <p class="nk-ingen">Ingen treff.</p>
                    }
                    @if (_redigerModus)
                    {
                        <div class="nk-opplasting">
                            <FilOpplastingssone Laster="_laster" Feilmelding="@_feilmelding" OnFilValgt="LastOppFil" Kompakt="true" />
                        </div>
                    }
                </section>

                <section class="nk-ramme">
                    @if (_valgt is null)
                    {
                        <div class="nk-gra">Fil</div>
                        <p class="nk-ingen">Velg en fil i listen.</p>
                    }
                    else
                    {
                        var type = TypeKort(_valgt.ContentType);
                        var adresse = $"/nedlastningsfil/{_valgt.Id}";
                        <div class="nk-gra">
                            <span class="nk-tittel">@_valgt.Navn</span>
                            <span class="nk-valg">
                                <a class="nk-knapp nk-knapp-liten" href="@adresse" download="@_valgt.Navn"><Icon Name="download" />Last ned</a>
                                @if (type == "PDF")
                                {
                                    <button type="button" class="nk-knapp nk-knapp-liten" onclick="var f=document.querySelector('.nk-fil');try{f.contentWindow.focus();f.contentWindow.print();}catch(e){window.open(f.src,'_blank');}"><Icon Name="printer" />Skriv ut</button>
                                }
                                else if (type == "BILDE")
                                {
                                    <a class="nk-knapp nk-knapp-liten" href="@adresse" target="_blank" rel="noopener"><Icon Name="printer" />Skriv ut</a>
                                }
                                <a class="nk-knapp nk-knapp-liten" href="@adresse" target="_blank" rel="noopener"><Icon Name="external-link" />Åpne i ny fane</a>
                            </span>
                        </div>
                        <div class="nk-meta">
                            <span>@type · @FormatStorrelse(_valgt.StorrelseBytes) · lastet opp @_valgt.OpprettetDato.ToString("dd.MM.yyyy")</span>
                            @if (_redigerModus)
                            {
                                <span class="nk-slett">
                                    @if (_slettId == _valgt.Id)
                                    {
                                        <span>Slette filen?</span>
                                        <button type="button" class="nk-knapp nk-knapp-liten nk-knapp-fare" @onclick="@(() => SlettFil(_valgt))">Ja, slett</button>
                                        <button type="button" class="nk-knapp nk-knapp-liten" @onclick="@(() => _slettId = null)">Avbryt</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="nk-slett-knapp" @onclick="@(() => _slettId = _valgt.Id)"><Icon Name="trash" />Slett</button>
                                    }
                                </span>
                            }
                        </div>
                        <div class="nk-tegning">
                            @if (type == "PDF")
                            {
                                <iframe @key="_valgt.Id" class="nk-fil" src="@($"{adresse}#toolbar=0&navpanes=0&view=Fit")" title="@_valgt.Navn"></iframe>
                            }
                            else if (type == "BILDE")
                            {
                                <img src="@adresse" alt="@_valgt.Navn" />
                            }
                            else
                            {
                                <p class="nk-ingen">Ingen forhåndsvisning for @type-filer. Last ned filen for å åpne den.</p>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </div>
    </div>
}

@code {
    [Parameter] public int KategoriId { get; set; }

    private bool _ugyldigKategori;
    private string _tittel = "";
    private string _undertekst = "";
    private bool _full;
    private List<FilVisning> _filer = [];
    private bool _redigerModus;
    private int? _slettId;
    private int? _valgtId;
    private string _sok = "";
    private bool _laster;
    private string? _feilmelding;
    private int? _loadetKategoriId;

    private List<FilVisning> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _filer
        : _filer.Where(f => f.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private FilVisning? _valgt => _filer.FirstOrDefault(f => f.Id == _valgtId);

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("oppsett-adgang-kategori-bredde", "normal") == "full";
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("oppsett-adgang-kategori-bredde", _full ? "full" : "normal");
    }

    private void VelgFil(int id)
    {
        _valgtId = id;
        _slettId = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetKategoriId == KategoriId)
        {
            return;
        }

        _loadetKategoriId = KategoriId;

        var kategori = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == KategoriId);
        if (kategori is null)
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _tittel = kategori.Navn;
        _undertekst = string.Join(" · ", new[] { string.IsNullOrWhiteSpace(kategori.Gruppe) ? "Andre" : kategori.Gruppe, kategori.Produsent }
            .Where(d => !string.IsNullOrWhiteSpace(d)));

        await LoadFilerAsync();
    }

    private async Task LoadFilerAsync()
    {
        _filer = await Db.NedlastningsFiler
            .Where(f => f.KategoriId == KategoriId)
            .OrderByDescending(f => f.OpprettetDato)
            .Select(f => new FilVisning(f.Id, f.Navn, f.ContentType, f.OpprettetDato, f.Data.Length))
            .ToListAsync();

        if (_valgtId is null || !_filer.Any(f => f.Id == _valgtId))
        {
            _valgtId = _filer.FirstOrDefault()?.Id;
        }
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task LastOppFil(IBrowserFile file)
    {
        if (_laster)
        {
            return;
        }

        _feilmelding = null;

        if (file.Size > 20_000_000)
        {
            _feilmelding = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        _laster = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var ny = new NedlastningsFil
            {
                KategoriId = KategoriId,
                Navn = file.Name,
                Filnavn = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Data = buffer.ToArray()
            };
            Db.NedlastningsFiler.Add(ny);
            await Db.SaveChangesAsync();

            await LoadFilerAsync();
            _valgtId = ny.Id;
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task SlettFil(FilVisning f)
    {
        await Db.NedlastningsFiler.Where(x => x.Id == f.Id).ExecuteDeleteAsync();
        _filer.Remove(f);
        _slettId = null;
        if (_valgtId == f.Id)
        {
            _valgtId = _filer.FirstOrDefault()?.Id;
        }
    }

    private static string FormatStorrelse(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / 1024.0 / 1024.0:0.#} MB";

    private static string TypeKort(string contentType) => contentType switch
    {
        "application/pdf" => "PDF",
        var ct when ct.Contains("wordprocessing") || ct.Contains("msword") => "DOCX",
        var ct when ct.Contains("spreadsheet") || ct.Contains("excel") => "XLSX",
        var ct when ct.StartsWith("image/") => "BILDE",
        _ => "FIL"
    };

    private record FilVisning(int Id, string Navn, string ContentType, DateTime OpprettetDato, long StorrelseBytes);
}
