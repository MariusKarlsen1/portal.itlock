@page "/guide/oppsett-adgangskontroll/{KategoriId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Oppsett adgangskontroll - @_tittel</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else
{
    <a class="back-link" href="/guide/oppsett-adgangskontroll"><Icon Name="arrow-left" />Tilbake til oppsett adgangskontroll</a>

    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="folder" /></span>
            <div>
                <h1>@_tittel</h1>
                <p class="section-hint">Velg en fil i listen for å se detaljer.</p>
            </div>
        </div>
        <AuthorizeView Roles="Admin">
            <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "knapp-ghost")" @onclick="ToggleRedigerModus">
                <Icon Name="edit" />
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        </AuthorizeView>
    </div>

    @if (_filer.Count == 0)
    {
        <p class="list-empty">Ingen filer lastet opp ennå.</p>
        @if (_redigerModus)
        {
            <FilOpplastingssone Laster="_laster" Feilmelding="_feilmelding" OnFilValgt="LastOppFil" />
        }
    }
    else
    {
        <div class="master-detail">
            <div class="master-panel">
                <div class="search-box">
                    <Icon Name="search" />
                    <input @bind="_sok" @bind:event="oninput" placeholder="Søk …" />
                </div>
                @foreach (var f in _filtrerte)
                {
                    <div @key="f.Id" class="master-row @(f.Id == _valgtId ? "master-row-valgt" : "")" @onclick="@(() => _valgtId = f.Id)">
                        <span class="fil-type">@TypeKort(f.ContentType)</span>
                        <div class="master-row-tekst">
                            <span class="master-row-navn">@f.Navn</span>
                            <span class="master-row-meta">@FormatStorrelse(f.StorrelseBytes)</span>
                        </div>
                    </div>
                }
                @if (_filtrerte.Count == 0)
                {
                    <p class="list-empty master-tomt-sok">Ingen treff.</p>
                }
                @if (_redigerModus)
                {
                    <div class="master-opplasting">
                        <FilOpplastingssone Laster="_laster" Feilmelding="_feilmelding" OnFilValgt="LastOppFil" Kompakt="true" />
                    </div>
                }
            </div>

            <div class="detail-panel">
                @if (_valgt is null)
                {
                    <div class="detail-tomt">
                        <Icon Name="file-text" />
                        <span>Velg en fil i listen</span>
                    </div>
                }
                else
                {
                    <div class="detail-innhold">
                        <div class="dok-forhandsvisning">
                            @if (TypeKort(_valgt.ContentType) == "PDF")
                            {
                                <iframe src="@($"/nedlastningsfil/{_valgt.Id}")" title="@_valgt.Navn"></iframe>
                            }
                            else if (TypeKort(_valgt.ContentType) == "BILDE")
                            {
                                <img src="@($"/nedlastningsfil/{_valgt.Id}")" alt="@_valgt.Navn" />
                            }
                            else
                            {
                                <div class="dok-ingen-forhandsvisning">
                                    <Icon Name="file-text" />
                                    <span>Ingen forhåndsvisning tilgjengelig for @TypeKort(_valgt.ContentType)-filer</span>
                                </div>
                            }
                        </div>
                        <div class="detail-tekst">
                            <div>
                                <h2>@_valgt.Navn</h2>
                                <p class="section-hint">@TypeKort(_valgt.ContentType) · @FormatStorrelse(_valgt.StorrelseBytes) · Lastet opp @_valgt.OpprettetDato.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div class="detail-knapperad">
                                <a class="knapp knapp-primaer" href="@($"/nedlastningsfil/{_valgt.Id}")" target="_blank">
                                    <Icon Name="maximize" />Åpne i ny fane
                                </a>
                                @if (_redigerModus)
                                {
                                    @if (_slettId == _valgt.Id)
                                    {
                                        <span class="detail-slett-confirm">
                                            <span>Slette denne filen?</span>
                                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettFil(_valgt))">Ja, slett</button>
                                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="knapp knapp-fare" @onclick="@(() => _slettId = _valgt.Id)">
                                            <Icon Name="x" />Slett
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public int KategoriId { get; set; }

    private bool _ugyldigKategori;
    private string _tittel = "";
    private List<FilVisning> _filer = [];
    private bool _redigerModus;
    private int? _slettId;
    private int? _valgtId;
    private string _sok = "";
    private bool _laster;
    private string? _feilmelding;
    private int? _loadetKategoriId;

    private List<FilVisning> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _filer
        : _filer.Where(f => f.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private FilVisning? _valgt => _filer.FirstOrDefault(f => f.Id == _valgtId);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetKategoriId == KategoriId)
        {
            return;
        }

        _loadetKategoriId = KategoriId;

        var kategori = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == KategoriId);
        if (kategori is null)
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _tittel = kategori.Navn;

        await LoadFilerAsync();
    }

    private async Task LoadFilerAsync()
    {
        _filer = await Db.NedlastningsFiler
            .Where(f => f.KategoriId == KategoriId)
            .OrderByDescending(f => f.OpprettetDato)
            .Select(f => new FilVisning(f.Id, f.Navn, f.ContentType, f.OpprettetDato, f.Data.Length))
            .ToListAsync();

        if (_valgtId is null || !_filer.Any(f => f.Id == _valgtId))
        {
            _valgtId = _filer.FirstOrDefault()?.Id;
        }
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task LastOppFil(IBrowserFile file)
    {
        if (_laster)
        {
            return;
        }

        _feilmelding = null;

        if (file.Size > 20_000_000)
        {
            _feilmelding = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        _laster = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var ny = new NedlastningsFil
            {
                KategoriId = KategoriId,
                Navn = file.Name,
                Filnavn = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Data = buffer.ToArray()
            };
            Db.NedlastningsFiler.Add(ny);
            await Db.SaveChangesAsync();

            await LoadFilerAsync();
            _valgtId = ny.Id;
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task SlettFil(FilVisning f)
    {
        await Db.NedlastningsFiler.Where(x => x.Id == f.Id).ExecuteDeleteAsync();
        _filer.Remove(f);
        _slettId = null;
        if (_valgtId == f.Id)
        {
            _valgtId = _filer.FirstOrDefault()?.Id;
        }
    }

    private static string FormatStorrelse(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / 1024.0 / 1024.0:0.#} MB";

    private static string TypeKort(string contentType) => contentType switch
    {
        "application/pdf" => "PDF",
        var ct when ct.Contains("wordprocessing") || ct.Contains("msword") => "DOCX",
        var ct when ct.Contains("spreadsheet") || ct.Contains("excel") => "XLSX",
        var ct when ct.StartsWith("image/") => "BILDE",
        _ => "FIL"
    };

    private record FilVisning(int Id, string Navn, string ContentType, DateTime OpprettetDato, long StorrelseBytes);
}
