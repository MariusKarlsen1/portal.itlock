@page "/om"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Full Kontroll — prosjektstyring for lås- og beslagsbransjen</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="om-root">

    <nav class="om-nav">
        <div class="om-nav-inner">
            <div class="om-logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A1D21" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <span class="om-head">Full Kontroll</span>
            </div>
            <div class="om-nav-links">
                <a href="#funksjoner" class="om-mono">// FUNKSJONER</a>
                <a href="#priser" class="om-mono">// PRISER</a>
            </div>
            <div class="om-nav-actions">
                <a href="/login">Logg inn</a>
                <a href="mailto:marius@itlock.no?subject=Demo%20av%20Full%20Kontroll" class="om-btn">Be om demo</a>
            </div>
        </div>
    </nav>

    <section class="om-hero">
        <div class="om-hero-inner">
            <div class="om-fig">
                <span class="om-fig-num om-mono">FIG. 01</span><span class="om-fig-dash">—</span><span class="om-fig-label om-mono">SPESIFIKASJON MED FARGEKODE</span>
            </div>
            <h1 class="om-hero-h1 om-head">Hver modul har sin egen farge. Alltid lett å finne igjen.</h1>
            <p class="om-hero-p">Et fargekodet system, akkurat som en teknisk tegning — slik at du kjenner igjen modulen før du i det hele tatt leser teksten.</p>
            <div class="om-hero-actions">
                <a href="mailto:marius@itlock.no?subject=Demo%20av%20Full%20Kontroll" class="om-btn">Be om demo</a>
                <a href="#funksjoner" class="om-btn-ghost">Se spesifikasjon →</a>
            </div>
        </div>
    </section>

    <section class="om-legend">
        <div class="om-legend-inner">
            <span class="om-legend-label om-mono">LEGEND —</span>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#C1703F"></span><span class="om-mono">KONTROLLTÅRN</span></div>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#2E7D8F"></span><span class="om-mono">TILBUD</span></div>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#5E7D3A"></span><span class="om-mono">TIMEREGISTRERING</span></div>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#7A5A9E"></span><span class="om-mono">PLANTEGNING</span></div>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#B8862E"></span><span class="om-mono">CE-DOKUMENTASJON</span></div>
            <div class="om-legend-item"><span class="om-legend-swatch" style="background:#3A5E8F"></span><span class="om-mono">FDV &amp; SERVICE</span></div>
        </div>
    </section>

    <section class="om-features" id="funksjoner">
        <h2 class="om-features-h2 om-head">Seks moduler, seks farger, ett system.</h2>

        <div class="om-grid">
            <div class="om-tile" style="--accent:#C1703F">
                <div class="om-tile-fig om-mono">01</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C1703F" stroke-width="1.8"><path d="M3 3v18h18" /><path d="M7 15l4-5 3 3 5-7" /></svg>
                <h3 class="om-head">Kontrolltårn</h3>
                <p>Sanntidsoversikt over alle aktive prosjekter.</p>
            </div>
            <div class="om-tile" style="--accent:#2E7D8F">
                <div class="om-tile-fig om-mono">02</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2E7D8F" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" /><path d="M14 2v6h6" /></svg>
                <h3 class="om-head">Tilbud</h3>
                <p>Dørlister og prislogikk i samme flyt.</p>
            </div>
            <div class="om-tile" style="--accent:#5E7D3A">
                <div class="om-tile-fig om-mono">03</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5E7D3A" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                <h3 class="om-head">Timeregistrering</h3>
                <p>Ført direkte fra byggeplassen.</p>
            </div>
            <div class="om-tile" style="--accent:#7A5A9E">
                <div class="om-tile-fig om-mono">04</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7A5A9E" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
                <h3 class="om-head">Plantegning</h3>
                <p>Dørlister knyttet direkte til tegning.</p>
            </div>
            <div class="om-tile" style="--accent:#B8862E">
                <div class="om-tile-fig om-mono">05</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B8862E" stroke-width="1.8"><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                <h3 class="om-head">CE-dokumentasjon</h3>
                <p>Alltid sporbart, alltid oppdatert.</p>
            </div>
            <div class="om-tile" style="--accent:#3A5E8F">
                <div class="om-tile-fig om-mono">06</div>
                <svg class="om-tile-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3A5E8F" stroke-width="1.8"><path d="M12 2 2 7l10 5 10-5-10-5Z" /><path d="M2 17l10 5 10-5" /></svg>
                <h3 class="om-head">FDV &amp; service</h3>
                <p>Oppfølging gjennom hele byggets levetid.</p>
            </div>
        </div>
    </section>

    <section class="om-cta" id="priser">
        <div class="om-cta-inner">
            <div class="om-fig" style="justify-content:center">
                <span class="om-fig-num om-mono">FIG. 03</span><span class="om-fig-dash">—</span><span class="om-fig-label om-mono">NESTE STEG</span>
            </div>
            <h2 class="om-cta-h2 om-head">Klar for å se det i praksis?</h2>
            <a href="mailto:marius@itlock.no?subject=Demo%20av%20Full%20Kontroll" class="om-btn">Be om demo</a>
        </div>
    </section>

    <footer class="om-footer">
        <div class="om-footer-inner">
            <span class="om-footer-brand om-head">Full Kontroll</span>
            <span class="om-footer-copy om-mono">© 2026 PROXIMA</span>
        </div>
    </footer>

</div>

<script>
    (function () {
        var elements = document.querySelectorAll('.om-reveal');
        if (!elements.length) {
            return;
        }
        if (!('IntersectionObserver' in window)) {
            elements.forEach(function (el) { el.classList.add('om-reveal-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('om-reveal-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        elements.forEach(function (el) { observer.observe(el); });
    })();
</script>
