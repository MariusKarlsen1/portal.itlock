@page "/befaringsmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Befaring - Full Kontroll</PageTitle>

<a class="back-link" href="/"><Icon Name="arrow-left" />Til hjem</a>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="eye" /></span>
    <div>
        <h1>Befaring</h1>
        <p class="section-hint">Sjekklister, oppslag og kalkulatorer til bruk under befaring.</p>
    </div>
</div>

<div class="modul-grid">
    <a href="/befaringsliste" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="check-circle" /></span>
        <span class="modul-card-title">Befaringsliste</span>
        <span class="modul-card-desc">Sjekkliste og notater fra befaring.</span>
    </a>
    <a href="/lasutskifting" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="tool" /></span>
        <span class="modul-card-title">Utskiftning av lås</span>
        <span class="modul-card-desc">Sjekkliste med mål på dør, karm og hengsling.</span>
    </a>
    <a href="/lasekasse-utskiftning" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="lock" /></span>
        <span class="modul-card-title">Utskiftning av låskasse</span>
        <span class="modul-card-desc">Søk opp gammel lås, se hva du trenger.</span>
    </a>
    <a href="/abc-kalkulator" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="settings" /></span>
        <span class="modul-card-title">ABC-kalkulator</span>
        <span class="modul-card-desc">Sylinderforlenger, skilt og skruer fra A/B/C-mål.</span>
    </a>
</div>
