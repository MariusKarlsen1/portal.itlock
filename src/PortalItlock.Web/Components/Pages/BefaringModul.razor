@page "/befaringsmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Befaring - itlock</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="eye" /></span>
    <div>
        <h1>Befaring</h1>
        <p class="section-hint">Sjekklister og notater til bruk under befaring.</p>
    </div>
</div>

<div class="modul-grid">
    <a href="/befaringsliste" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="check-circle" /></span>
        <span class="modul-card-title">Befaringsliste</span>
        <span class="modul-card-desc">Sjekkliste og notater fra befaring.</span>
    </a>
    <a href="/lasutskifting" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="tool" /></span>
        <span class="modul-card-title">Utskiftning av lås</span>
        <span class="modul-card-desc">Sjekkliste med mål på dør, karm og hengsling.</span>
    </a>
</div>
