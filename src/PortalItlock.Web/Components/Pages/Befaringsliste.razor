@page "/befaringsliste"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Befaringsliste</PageTitle>

<div class="befaring-header">
    <div class="befaring-header-tekst">
        <div class="befaring-header-tittel">
            <span class="befaring-header-ikon"><Icon Name="eye" /></span>
            <h1>Befaringsliste</h1>
        </div>
        <p>Oversikt over gjennomførte og planlagte befaringer.</p>
    </div>
    <a class="new-button" href="befaring/ny"><Icon Name="plus" />Ny befaring</a>
</div>

@if (_befaringer.Count == 0)
{
    <div class="befaring-tom">
        <Icon Name="eye" />
        <p>Ingen befaringer registrert ennå.</p>
        <a class="new-button" href="befaring/ny"><Icon Name="plus" />Registrer den første</a>
    </div>
}
else
{
    <div class="verktoy-rad">
        <div class="sok-boks">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" placeholder="Søk på navn, kunde eller sted..." />
        </div>
        <select class="sorter-select" @bind="_sortering">
            <option value="nyeste">Sorter: Nyeste først</option>
            <option value="dato">Sorter: Nærmeste dato</option>
            <option value="navn">Sorter: Navn (A-Å)</option>
        </select>
    </div>

    var alleTreff = FiltrertOgSortert();
    var antallPlanlagt = alleTreff.Count(b => Status(b) == BefaringStatus.Planlagt);
    var antallGjennomfort = alleTreff.Count(b => Status(b) == BefaringStatus.Gjennomfort);
    var antallIngen = alleTreff.Count(b => Status(b) == BefaringStatus.IkkeSatt);
    var synlige = _valgtFane switch
    {
        "planlagt" => alleTreff.Where(b => Status(b) == BefaringStatus.Planlagt).ToList(),
        "gjennomfort" => alleTreff.Where(b => Status(b) == BefaringStatus.Gjennomfort).ToList(),
        "ingen" => alleTreff.Where(b => Status(b) == BefaringStatus.IkkeSatt).ToList(),
        _ => alleTreff
    };

    <div class="faner">
        <button type="button" class="fane @(_valgtFane == "alle" ? "fane-aktiv" : "")" @onclick='@(() => _valgtFane = "alle")'>Alle (@alleTreff.Count)</button>
        <button type="button" class="fane @(_valgtFane == "planlagt" ? "fane-aktiv" : "")" @onclick='@(() => _valgtFane = "planlagt")'>Planlagt (@antallPlanlagt)</button>
        <button type="button" class="fane @(_valgtFane == "gjennomfort" ? "fane-aktiv" : "")" @onclick='@(() => _valgtFane = "gjennomfort")'>Gjennomført (@antallGjennomfort)</button>
        <button type="button" class="fane @(_valgtFane == "ingen" ? "fane-aktiv" : "")" @onclick='@(() => _valgtFane = "ingen")'>Ingen dato (@antallIngen)</button>
    </div>

    @if (synlige.Count == 0)
    {
        <p class="befaring-ingen-treff">Ingen befaringer i denne kategorien.</p>
    }
    else
    {
        <div class="befaring-liste">
            @foreach (var b in synlige)
            {
                var status = Status(b);
                <a @key="b.Id" class="befaring-rad" href="@($"befaring/{b.Id}")">
                    <span class="befaring-dott befaring-dott-@status.ToString().ToLowerInvariant()"></span>
                    <div class="befaring-rad-tekst">
                        <span class="befaring-rad-navn">@b.Navn</span>
                        <span class="befaring-rad-meta">@KundeOgSted(b)</span>
                    </div>
                    <span class="befaring-rad-dato">@(b.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")</span>
                    <span class="befaring-dorfelt-badge">@b.AntallDorfelt dørfelt</span>
                </a>
            }
        </div>
    }
}

@code {
    private enum BefaringStatus { IkkeSatt, Planlagt, Gjennomfort }

    private sealed class BefaringRow
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public DateTime? Dato { get; set; }
        public int AntallDorfelt { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private List<BefaringRow> _befaringer = [];
    private string _sok = "";
    private string _sortering = "nyeste";
    private string _valgtFane = "alle";

    protected override async Task OnInitializedAsync()
    {
        _befaringer = await Db.Befaringer
            .Include(b => b.Dorfelt)
            .OrderByDescending(b => b.OpprettetDato)
            .Select(b => new BefaringRow
            {
                Id = b.Id,
                Navn = b.Navn,
                Kundenavn = b.Kundenavn,
                Adresse = b.Adresse,
                Sted = b.Sted,
                Dato = b.Dato,
                AntallDorfelt = b.Dorfelt.Count,
                OpprettetDato = b.OpprettetDato
            })
            .ToListAsync();
    }

    private static BefaringStatus Status(BefaringRow b)
    {
        if (b.Dato is null) return BefaringStatus.IkkeSatt;
        return b.Dato.Value.Date < DateTime.Today ? BefaringStatus.Gjennomfort : BefaringStatus.Planlagt;
    }

    private static string KundeOgSted(BefaringRow b)
    {
        var deler = new[] { b.Kundenavn, b.Sted }.Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(" · ", deler);
    }

    private List<BefaringRow> FiltrertOgSortert()
    {
        var filtrert = string.IsNullOrWhiteSpace(_sok)
            ? _befaringer
            : _befaringer.Where(b => b.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                || (b.Kundenavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Sted?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Adresse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

        return _sortering switch
        {
            "dato" => filtrert.OrderBy(b => b.Dato ?? DateTime.MaxValue).ToList(),
            "navn" => filtrert.OrderBy(b => b.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
            _ => filtrert.OrderByDescending(b => b.OpprettetDato).ToList()
        };
    }
}
