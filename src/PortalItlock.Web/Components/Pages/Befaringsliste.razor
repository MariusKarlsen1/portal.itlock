@page "/befaringsliste"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Befaringsliste</PageTitle>

<div class="befaring-side @(_full ? "bf-full" : "")">
    <div class="befaring-header">
        <div class="befaring-header-tekst">
            <div class="befaring-header-tittel">
                <span class="befaring-header-ikon"><Icon Name="eye" /></span>
                <h1>Befaringsliste</h1>
            </div>
            <p>Full oversikt over planlagte og gjennomførte befaringer.</p>
        </div>
    </div>

    @* B2: samme oppbygging som arbeidsordrelisten. Søk øverst, status som
       filterknapper, og visning, filter og «Ny befaring» på samme linje. *@
    <div class="bf-kort">
        <div class="sok-boks">
            <Icon Name="search" />
            <input value="@_sok" @oninput="OnSokEndret" placeholder="Søk etter befaring, prosjekt, kunde eller ansvarlig" aria-label="Søk" />
        </div>

        <div class="bf-linje">
            <div class="bf-status">
                @foreach (var (id, navn, antall) in new[] { ("planlagt", "Planlagt", AntallPlanlagt), ("gjennomfort", "Gjennomført", AntallGjennomfort), ("avlyst", "Avlyst", AntallAvlyst) })
                {
                    <button type="button" class="bf-chip @(_valgtFane == id ? "aktiv" : "")" aria-pressed="@(_valgtFane == id ? "true" : "false")" @onclick="@(() => VelgFane(id))">@navn <small>@antall</small></button>
                }
            </div>

            <div class="bf-valg">
                <div class="bf-seg" role="group" aria-label="Visning">
                    <button type="button" class="@(_valgtVisning == "rutenett" ? "aktiv" : "")" aria-pressed="@(_valgtVisning == "rutenett" ? "true" : "false")" @onclick='@(() => VelgVisning("rutenett"))'><Icon Name="grid-icon" />Rutenett</button>
                    <button type="button" class="@(_valgtVisning == "liste" ? "aktiv" : "")" aria-pressed="@(_valgtVisning == "liste" ? "true" : "false")" @onclick='@(() => VelgVisning("liste"))'><Icon Name="list" />Liste</button>
                </div>

                <div class="befaring-filter-wrap">
                    <button type="button" class="bf-knapp @(AntallFiltre > 0 ? "aktiv" : "")" aria-expanded="@(_filterApen ? "true" : "false")" @onclick="@(() => _filterApen = !_filterApen)">
                        <Icon Name="filter" />Filtrer@(AntallFiltre > 0 ? $" ({AntallFiltre})" : "")
                    </button>
                    @if (_filterApen)
                    {
                        <div class="befaring-filter-meny">
                            <label class="bf-filterfelt">Kunde
                                <select @onchange="OnKundeEndret" aria-label="Kunde">
                                    <option value="" selected="@(_filterKunde is null)">Alle</option>
                                    @foreach (var k in _befaringer.Select(b => b.Kundenavn).Where(k => !string.IsNullOrWhiteSpace(k)).Distinct().Order())
                                    {
                                        <option value="@k" selected="@(_filterKunde == k)">@k</option>
                                    }
                                </select>
                            </label>
                            <label class="bf-filterfelt">Ansvarlig
                                <select @onchange="OnAnsvarligEndret" aria-label="Ansvarlig">
                                    <option value="" selected="@(_filterAnsvarlig is null)">Alle</option>
                                    @foreach (var n in _befaringer.Select(b => b.BefartAv).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().Order())
                                    {
                                        <option value="@n" selected="@(_filterAnsvarlig == n)">@n</option>
                                    }
                                </select>
                            </label>
                            <span class="bf-filtertittel">Sorter</span>
                            <button type="button" class="@(_sortering == "nyeste" ? "befaring-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("nyeste"))">Nyeste først</button>
                            <button type="button" class="@(_sortering == "dato" ? "befaring-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("dato"))">Nærmeste dato</button>
                            <button type="button" class="@(_sortering == "navn" ? "befaring-filter-valg-aktiv" : "")" @onclick="@(() => VelgSortering("navn"))">Navn (A-Å)</button>
                        </div>
                    }
                </div>

                <a class="new-button" href="befaring/ny"><Icon Name="plus" />Ny befaring</a>
                <button type="button" class="bf-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>
        </div>

    @{
        var synlige = _valgtFane switch
        {
            "planlagt" => FiltrertOgSortert(_befaringer.Where(b => b.Status == BefaringStatus.Planlagt)),
            "gjennomfort" => FiltrertOgSortert(_befaringer.Where(b => b.Status == BefaringStatus.Gjennomfort)),
            "avlyst" => FiltrertOgSortert(_befaringer.Where(b => b.Status == BefaringStatus.Avlyst)),
            _ => FiltrertOgSortert(_befaringer)
        };

        var visIllustrertTomtilstand = _befaringer.Count == 0 || (_valgtFane == "planlagt" && AntallPlanlagt == 0 && string.IsNullOrWhiteSpace(_sok));
    }

    @if (visIllustrertTomtilstand)
    {
        <div class="befaring-tom-kort">
            <div class="befaring-tom-tekst">
                <span class="befaring-tom-strek"></span>
                <h2>@(_befaringer.Count == 0 ? "Ingen befaringer registrert ennå" : "Ingen befaring planlagt")</h2>
                <p>
                    @if (_befaringer.Count == 0)
                    {
                        <text>Start med å registrere din første befaring for å holde oversikt over planlagte og gjennomførte befaringer. Du kan knytte befaringen til prosjekt, kunde og kontaktperson.</text>
                    }
                    else
                    {
                        <text>Det er ingen planlagte befaringer akkurat nå.</text>
                    }
                </p>
                <div class="befaring-tom-knapper">
                    <a class="new-button" href="befaring/ny"><Icon Name="plus" />@(_befaringer.Count == 0 ? "Registrer den første befaringen" : "Registrer en befaring")</a>
                </div>
            </div>
            <div class="befaring-tom-illustrasjon" aria-hidden="true">
                <svg viewBox="0 0 300 240" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="150" cy="140" rx="128" ry="86" fill="var(--itlock-accent)" opacity="0.07" />
                    <circle cx="60" cy="60" r="34" fill="var(--itlock-accent)" opacity="0.06" />
                    <path d="M20 205c40-14 220-14 260 0" stroke="var(--itlock-border)" stroke-width="2" stroke-dasharray="3 6" stroke-linecap="round" />

                    <g transform="translate(34 178)">
                        <circle cx="0" cy="8" r="13" fill="var(--itlock-accent)" opacity="0.14" />
                        <path d="M0 16V-6M0-6 7 2M0-6-7 2" stroke="var(--itlock-accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
                    </g>
                    <g transform="translate(258 190)">
                        <circle cx="0" cy="6" r="10" fill="var(--itlock-accent)" opacity="0.14" />
                        <path d="M0 12V-4M0-4 5 1M0-4-5 1" stroke="var(--itlock-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />
                    </g>

                    <circle cx="246" cy="40" r="3" fill="var(--itlock-accent)" opacity="0.3" />
                    <circle cx="70" cy="34" r="2.4" fill="var(--itlock-accent)" opacity="0.3" />
                    <circle cx="222" cy="150" r="2.6" fill="var(--itlock-accent)" opacity="0.3" />

                    <g transform="translate(96 40) rotate(-6)">
                        <rect x="0" y="0" width="108" height="140" rx="12" fill="#ffffff" stroke="var(--itlock-accent)" stroke-width="2.5" />
                        <rect x="32" y="-10" width="44" height="20" rx="6" fill="var(--itlock-accent)" />

                        <g transform="translate(18 42)">
                            <rect x="0" y="0" width="14" height="14" rx="4" fill="var(--itlock-accent)" />
                            <path d="M3 7l3 3 6-6" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <rect x="22" y="4.5" width="58" height="5" rx="2.5" fill="var(--itlock-border)" />
                        </g>
                        <g transform="translate(18 70)">
                            <rect x="0" y="0" width="14" height="14" rx="4" fill="var(--itlock-accent)" />
                            <path d="M3 7l3 3 6-6" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <rect x="22" y="4.5" width="58" height="5" rx="2.5" fill="var(--itlock-border)" />
                        </g>
                        <g transform="translate(18 98)">
                            <rect x="0" y="0" width="14" height="14" rx="4" fill="var(--itlock-accent)" />
                            <path d="M3 7l3 3 6-6" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <rect x="22" y="4.5" width="36" height="5" rx="2.5" fill="var(--itlock-border)" />
                        </g>
                    </g>

                    <g transform="translate(206 56)">
                        <circle cx="0" cy="0" r="26" fill="#ffffff" stroke="var(--itlock-accent)" stroke-width="2.5" />
                        <path d="M-13 0S-6.5-7 0-7 13 0 13 0 6.5 7 0 7-13 0-13 0Z" stroke="var(--itlock-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="0" cy="0" r="3.4" stroke="var(--itlock-accent)" stroke-width="1.8" />
                    </g>

                    <g transform="translate(54 150) rotate(40)">
                        <rect x="0" y="0" width="10" height="78" rx="4" fill="var(--itlock-accent)" />
                        <path d="M0 78 5 94 10 78Z" fill="var(--itlock-accent)" />
                        <rect x="0" y="0" width="10" height="14" rx="4" fill="#ffffff" opacity="0.5" />
                    </g>

                    <g transform="translate(238 118)">
                        <path d="M0 0C0-11 9-20 20-20s20 9 20 20c0 15-20 36-20 36S0 15 0 0Z" fill="var(--itlock-accent)" />
                        <circle cx="20" cy="0" r="8" fill="#ffffff" />
                    </g>
                </svg>
            </div>
        </div>
    }
    else
    {
        var totalSider = Math.Max(1, (int)Math.Ceiling(synlige.Count / (double)_sideStorrelse));
        if (_sideNummer > totalSider)
        {
            _sideNummer = totalSider;
        }
        var sideSynlig = synlige.Skip((_sideNummer - 1) * _sideStorrelse).Take(_sideStorrelse).ToList();
        var iFanen = _valgtFane switch { "planlagt" => AntallPlanlagt, "gjennomfort" => AntallGjennomfort, "avlyst" => AntallAvlyst, _ => _befaringer.Count };

        <p class="bf-antall">@synlige.Count av @iFanen @(iFanen == 1 ? "befaring" : "befaringer")</p>
        @if (synlige.Count == 0)
        {
            <p class="befaring-ingen-treff">Ingen befaringer i denne kategorien.</p>
        }
        else
        {
            @if (_valgtVisning == "rutenett")
            {
                <div class="befaring-rutenett">
                    @foreach (var b in sideSynlig)
                    {
                        <a @key="b.Id" class="befaring-kort" href="@($"befaring/{b.Id}")">
                            <div class="befaring-kort-topp">
                                <span class="befaring-status-pill befaring-status-pill-@b.Status.ToString().ToLowerInvariant()">@b.Status.Visningsnavn()</span>
                                <span class="befaring-dorfelt-badge">@b.AntallDorfelt dørfelt</span>
                            </div>
                            <span class="befaring-kort-navn">@b.Navn</span>
                            <span class="befaring-kort-meta">@KundeOgSted(b)</span>
                            <span class="befaring-kort-dato">@(b.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="befaring-tabell-wrap">
                    <table class="befaring-tabell">
                        <thead>
                            <tr>
                                <th class="befaring-tabell-check"><input type="checkbox" checked="@AlleValgtPaSiden(sideSynlig)" @onchange="@(e => VelgAlle(sideSynlig, (bool)e.Value!))" /></th>
                                <th>#</th>
                                <th>Tittel</th>
                                <th>Kunde</th>
                                <th>Lokasjon</th>
                                <th>Status</th>
                                <th>Befaringsdato</th>
                                <th>Ansvarlig</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in sideSynlig)
                            {
                                <tr @key="b.Id">
                                    <td class="befaring-tabell-check"><input type="checkbox" checked="@_valgteRader.Contains(b.Id)" @onchange="@(e => VelgRad(b.Id, (bool)e.Value!))" /></td>
                                    <td class="befaring-tabell-muted">#@b.Id</td>
                                    <td>
                                        <a class="befaring-tabell-tittel" href="@($"befaring/{b.Id}")">@b.Navn</a>
                                        @if (!string.IsNullOrWhiteSpace(b.Bygg))
                                        {
                                            <span class="befaring-tabell-undertekst">@b.Bygg</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(b.Kundenavn) ? "–" : b.Kundenavn)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(b.Sted))
                                        {
                                            <span class="befaring-tabell-ikontekst"><Icon Name="map-pin" />@b.Sted</span>
                                        }
                                        else
                                        {
                                            <text>–</text>
                                        }
                                    </td>
                                    <td><span class="befaring-status-pill befaring-status-pill-@b.Status.ToString().ToLowerInvariant()">@b.Status.Visningsnavn()</span></td>
                                    <td>
                                        @if (b.Dato is not null)
                                        {
                                            <b>@b.Dato.Value.ToString("dd.MM.yyyy")</b>
                                        }
                                        else
                                        {
                                            <text>–</text>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(b.BefartAv))
                                        {
                                            <span class="befaring-tabell-ansvarlig"><span class="bs-avatar">@Initialer(b.BefartAv)</span>@b.BefartAv</span>
                                        }
                                        else
                                        {
                                            <text>–</text>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="befaring-paginering">
                <label class="befaring-side-velger">
                    Vis
                    <select value="@_sideStorrelse" @onchange="OnSideStorrelseEndret">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select>
                    per side
                </label>
                <div class="befaring-side-knapper">
                    <span class="befaring-side-tekst">Side @_sideNummer av @totalSider</span>
                    <button type="button" class="befaring-side-knapp" disabled="@(_sideNummer <= 1)" @onclick="@(() => _sideNummer--)" title="Forrige side"><Icon Name="chevron-left" /></button>
                    <button type="button" class="befaring-side-knapp" disabled="@(_sideNummer >= totalSider)" @onclick="@(() => _sideNummer++)" title="Neste side"><Icon Name="arrow-right" /></button>
                </div>
            </div>
        }
    }
    </div>
</div>

@code {
    private sealed class BefaringRow
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Bygg { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public string? BefartAv { get; set; }
        public DateTime? Dato { get; set; }
        public int AntallDorfelt { get; set; }
        public DateTime OpprettetDato { get; set; }
        public BefaringStatus Status { get; set; }
    }

    private List<BefaringRow> _befaringer = [];
    private string _sok = "";
    private string _sortering = "nyeste";
    private string _valgtFane = "planlagt";
    private string _valgtVisning = "liste";

    private async Task VelgVisning(string visning)
    {
        _valgtVisning = visning;
        await VisningPref.SettAsync("befaringsliste", visning);
    }
    private bool _full;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("befaringsliste-bredde", _full ? "full" : "normal");
    }

    private bool _filterApen;
    private string? _filterKunde;
    private string? _filterAnsvarlig;
    private int AntallFiltre => (_filterKunde is null ? 0 : 1) + (_filterAnsvarlig is null ? 0 : 1);
    private int _sideStorrelse = 10;
    private int _sideNummer = 1;
    private readonly HashSet<int> _valgteRader = [];

    private int AntallPlanlagt => _befaringer.Count(b => b.Status == BefaringStatus.Planlagt);
    private int AntallGjennomfort => _befaringer.Count(b => b.Status == BefaringStatus.Gjennomfort);
    private int AntallAvlyst => _befaringer.Count(b => b.Status == BefaringStatus.Avlyst);

    protected override async Task OnInitializedAsync()
    {
        _valgtVisning = await VisningPref.HentAsync("befaringsliste", _valgtVisning);
        _full = await VisningPref.HentAsync("befaringsliste-bredde", "normal") == "full";

        _befaringer = await Db.Befaringer
            .Include(b => b.Dorfelt)
            .OrderByDescending(b => b.OpprettetDato)
            .Select(b => new BefaringRow
            {
                Id = b.Id,
                Navn = b.Navn,
                Kundenavn = b.Kundenavn,
                Bygg = b.Bygg,
                Adresse = b.Adresse,
                Sted = b.Sted,
                BefartAv = b.BefartAv,
                Dato = b.Dato,
                AntallDorfelt = b.Dorfelt.Count,
                OpprettetDato = b.OpprettetDato,
                Status = b.Status
            })
            .ToListAsync();
    }

    private void VelgFane(string fane)
    {
        _valgtFane = fane;
        _sideNummer = 1;
    }

    private void OnSokEndret(ChangeEventArgs e)
    {
        _sok = e.Value?.ToString() ?? "";
        _sideNummer = 1;
    }

    private void OnSideStorrelseEndret(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var storrelse))
        {
            _sideStorrelse = storrelse;
            _sideNummer = 1;
        }
    }

    private void OnKundeEndret(ChangeEventArgs e)
    {
        _filterKunde = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _sideNummer = 1;
    }

    private void OnAnsvarligEndret(ChangeEventArgs e)
    {
        _filterAnsvarlig = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _sideNummer = 1;
    }

    private void VelgSortering(string sortering)
    {
        _sortering = sortering;
        _filterApen = false;
        _sideNummer = 1;
    }

    private bool AlleValgtPaSiden(List<BefaringRow> side) => side.Count > 0 && side.All(b => _valgteRader.Contains(b.Id));

    private void VelgAlle(List<BefaringRow> side, bool valgt)
    {
        foreach (var b in side)
        {
            if (valgt)
            {
                _valgteRader.Add(b.Id);
            }
            else
            {
                _valgteRader.Remove(b.Id);
            }
        }
    }

    private void VelgRad(int id, bool valgt)
    {
        if (valgt)
        {
            _valgteRader.Add(id);
        }
        else
        {
            _valgteRader.Remove(id);
        }
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(deler.Select(d => char.ToUpperInvariant(d[0])));
    }

    private static string KundeOgSted(BefaringRow b)
    {
        var deler = new[] { b.Kundenavn, b.Sted }.Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(" · ", deler);
    }

    private List<BefaringRow> FiltrertOgSortert(IEnumerable<BefaringRow> kilde)
    {
        var filtrert = kilde
            .Where(b => _filterKunde is null || b.Kundenavn == _filterKunde)
            .Where(b => _filterAnsvarlig is null || b.BefartAv == _filterAnsvarlig);
        filtrert = string.IsNullOrWhiteSpace(_sok)
            ? filtrert
            : filtrert.Where(b => b.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                || (b.Kundenavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.BefartAv?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Bygg?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Sted?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Adresse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false));

        return _sortering switch
        {
            "dato" => filtrert.OrderBy(b => b.Dato ?? DateTime.MaxValue).ToList(),
            "navn" => filtrert.OrderBy(b => b.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
            _ => filtrert.OrderByDescending(b => b.OpprettetDato).ToList()
        };
    }
}
