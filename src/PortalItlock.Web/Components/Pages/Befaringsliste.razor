@page "/befaringsliste"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Befaringsliste</PageTitle>

<div class="befaring-header">
    <div class="befaring-header-tekst">
        <div class="befaring-header-tittel">
            <span class="befaring-header-ikon"><Icon Name="eye" /></span>
            <h1>Befaringsliste</h1>
        </div>
        <p>Oversikt over gjennomførte og planlagte befaringer.</p>
    </div>
    <a class="new-button" href="befaring/ny"><Icon Name="plus" />Ny befaring</a>
</div>

@if (_befaringer.Count == 0)
{
    <div class="befaring-tom">
        <Icon Name="eye" />
        <p>Ingen befaringer registrert ennå.</p>
        <a class="new-button" href="befaring/ny"><Icon Name="plus" />Registrer den første</a>
    </div>
}
else
{
    <div class="befaring-stats">
        <div class="befaring-stat">
            <span class="befaring-stat-tall">@_befaringer.Count</span>
            <span class="befaring-stat-etikett">Totalt</span>
        </div>
        <div class="befaring-stat">
            <span class="befaring-stat-tall befaring-stat-planlagt">@_befaringer.Count(b => Status(b) == BefaringStatus.Planlagt)</span>
            <span class="befaring-stat-etikett">Planlagt</span>
        </div>
        <div class="befaring-stat">
            <span class="befaring-stat-tall befaring-stat-gjennomfort">@_befaringer.Count(b => Status(b) == BefaringStatus.Gjennomfort)</span>
            <span class="befaring-stat-etikett">Gjennomført</span>
        </div>
    </div>

    <div class="befaring-grid">
        @foreach (var b in _befaringer)
        {
            var status = Status(b);
            <a class="befaring-kort befaring-kort-@status.ToString().ToLowerInvariant()" href="@($"befaring/{b.Id}")">
                <div class="befaring-kort-topp">
                    <span class="befaring-kort-navn">@b.Navn</span>
                    <span class="befaring-status-badge befaring-status-@status.ToString().ToLowerInvariant()">@StatusTekst(status)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(b.Kundenavn))
                {
                    <div class="befaring-kort-linje">
                        <Icon Name="users" />
                        <span>@b.Kundenavn</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(b.Sted) || !string.IsNullOrWhiteSpace(b.Adresse))
                {
                    <div class="befaring-kort-linje">
                        <Icon Name="map" />
                        <span>@string.Join(", ", new[] { b.Adresse, b.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)))</span>
                    </div>
                }
                <div class="befaring-kort-bunn">
                    <span class="befaring-kort-dato">
                        <Icon Name="calendar" />
                        @(b.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")
                    </span>
                    <span class="befaring-dorfelt-badge">@b.AntallDorfelt dørfelt</span>
                </div>
            </a>
        }
    </div>
}

@code {
    private enum BefaringStatus { IkkeSatt, Planlagt, Gjennomfort }

    private sealed class BefaringRow
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public DateTime? Dato { get; set; }
        public int AntallDorfelt { get; set; }
    }

    private List<BefaringRow> _befaringer = [];

    protected override async Task OnInitializedAsync()
    {
        _befaringer = await Db.Befaringer
            .Include(b => b.Dorfelt)
            .OrderByDescending(b => b.OpprettetDato)
            .Select(b => new BefaringRow
            {
                Id = b.Id,
                Navn = b.Navn,
                Kundenavn = b.Kundenavn,
                Adresse = b.Adresse,
                Sted = b.Sted,
                Dato = b.Dato,
                AntallDorfelt = b.Dorfelt.Count
            })
            .ToListAsync();
    }

    private static BefaringStatus Status(BefaringRow b)
    {
        if (b.Dato is null) return BefaringStatus.IkkeSatt;
        return b.Dato.Value.Date < DateTime.Today ? BefaringStatus.Gjennomfort : BefaringStatus.Planlagt;
    }

    private static string StatusTekst(BefaringStatus status) => status switch
    {
        BefaringStatus.Planlagt => "Planlagt",
        BefaringStatus.Gjennomfort => "Gjennomført",
        _ => "Ingen dato"
    };
}
