@page "/befaringsliste"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Befaringsliste</PageTitle>

<h1>Befaringsliste</h1>
<p>Oversikt over gjennomførte og planlagte befaringer. Trykk "Ny befaring" for å registrere en ny.</p>

<a class="new-button" href="befaring/ny">Ny befaring</a>

@if (_befaringer.Count == 0)
{
    <p class="list-empty">Ingen befaringer registrert ennå.</p>
}
else
{
    <ul class="befaring-list">
        @foreach (var b in _befaringer)
        {
            <li>
                <a class="befaring-row" href="@($"befaring/{b.Id}")">
                    <span class="befaring-navn">@b.Navn</span>
                    <span class="befaring-meta">
                        @if (!string.IsNullOrWhiteSpace(b.Kundenavn))
                        {
                            <text>@b.Kundenavn · </text>
                        }
                        @(b.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")
                        · @b.AntallDorfelt dørfelt
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private sealed class BefaringRow
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kundenavn { get; set; }
        public DateTime? Dato { get; set; }
        public int AntallDorfelt { get; set; }
    }

    private List<BefaringRow> _befaringer = [];

    protected override async Task OnInitializedAsync()
    {
        _befaringer = await Db.Befaringer
            .Include(b => b.Dorfelt)
            .OrderByDescending(b => b.OpprettetDato)
            .Select(b => new BefaringRow
            {
                Id = b.Id,
                Navn = b.Navn,
                Kundenavn = b.Kundenavn,
                Dato = b.Dato,
                AntallDorfelt = b.Dorfelt.Count
            })
            .ToListAsync();
    }
}
