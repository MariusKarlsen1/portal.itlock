@page "/befaringsliste"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Befaringsliste</PageTitle>

<div class="befaring-header">
    <div class="befaring-header-tekst">
        <div class="befaring-header-tittel">
            <span class="befaring-header-ikon"><Icon Name="eye" /></span>
            <h1>Befaringsliste</h1>
        </div>
        <p>Oversikt over gjennomførte og planlagte befaringer.</p>
    </div>
    <a class="new-button" href="befaring/ny"><Icon Name="plus" />Ny befaring</a>
</div>

@if (_befaringer.Count == 0)
{
    <div class="befaring-tom">
        <Icon Name="eye" />
        <p>Ingen befaringer registrert ennå.</p>
        <a class="new-button" href="befaring/ny"><Icon Name="plus" />Registrer den første</a>
    </div>
}
else
{
    <div class="verktoy-rad">
        <div class="sok-boks">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" placeholder="Søk på navn, kunde eller sted..." />
        </div>
        <select class="sorter-select" @bind="_sortering">
            <option value="nyeste">Sorter: Nyeste først</option>
            <option value="dato">Sorter: Nærmeste dato</option>
            <option value="navn">Sorter: Navn (A-Å)</option>
        </select>
    </div>

    @foreach (var gruppe in Grupper())
    {
        var synlige = Synlige(gruppe.Rader);
        if (synlige.Count == 0)
        {
            continue;
        }

        <div class="gruppe">
            <p class="gruppe-tittel">
                <span class="gruppe-dott gruppe-dott-@gruppe.Status.ToString().ToLowerInvariant()"></span>
                @gruppe.Tittel <span class="gruppe-teller">(@synlige.Count)</span>
            </p>
            <div class="befaring-grid">
                @foreach (var b in synlige)
                {
                    <a class="befaring-kort befaring-kort-@gruppe.Status.ToString().ToLowerInvariant()" href="@($"befaring/{b.Id}")">
                        <div class="befaring-kort-topp">
                            <span class="befaring-kort-navn">@b.Navn</span>
                            <span class="befaring-status-badge befaring-status-@gruppe.Status.ToString().ToLowerInvariant()">@StatusTekst(gruppe.Status)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(b.Kundenavn))
                        {
                            <div class="befaring-kort-linje">
                                <Icon Name="users" />
                                <span>@b.Kundenavn</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(b.Sted) || !string.IsNullOrWhiteSpace(b.Adresse))
                        {
                            <div class="befaring-kort-linje">
                                <Icon Name="map" />
                                <span>@string.Join(", ", new[] { b.Adresse, b.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)))</span>
                            </div>
                        }
                        <div class="befaring-kort-bunn">
                            <span class="befaring-kort-dato">
                                <Icon Name="calendar" />
                                @(b.Dato?.ToString("dd.MM.yyyy") ?? "Ingen dato")
                            </span>
                            <span class="befaring-dorfelt-badge">@b.AntallDorfelt dørfelt</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
}

@code {
    private enum BefaringStatus { IkkeSatt, Planlagt, Gjennomfort }

    private sealed class BefaringRow
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public DateTime? Dato { get; set; }
        public int AntallDorfelt { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record BefaringGruppe(BefaringStatus Status, string Tittel, List<BefaringRow> Rader);

    private List<BefaringRow> _befaringer = [];
    private string _sok = "";
    private string _sortering = "nyeste";

    protected override async Task OnInitializedAsync()
    {
        _befaringer = await Db.Befaringer
            .Include(b => b.Dorfelt)
            .OrderByDescending(b => b.OpprettetDato)
            .Select(b => new BefaringRow
            {
                Id = b.Id,
                Navn = b.Navn,
                Kundenavn = b.Kundenavn,
                Adresse = b.Adresse,
                Sted = b.Sted,
                Dato = b.Dato,
                AntallDorfelt = b.Dorfelt.Count,
                OpprettetDato = b.OpprettetDato
            })
            .ToListAsync();
    }

    private static BefaringStatus Status(BefaringRow b)
    {
        if (b.Dato is null) return BefaringStatus.IkkeSatt;
        return b.Dato.Value.Date < DateTime.Today ? BefaringStatus.Gjennomfort : BefaringStatus.Planlagt;
    }

    private static string StatusTekst(BefaringStatus status) => status switch
    {
        BefaringStatus.Planlagt => "Planlagt",
        BefaringStatus.Gjennomfort => "Gjennomført",
        _ => "Ingen dato"
    };

    private List<BefaringGruppe> Grupper() =>
    [
        new(BefaringStatus.Planlagt, "Planlagt", _befaringer.Where(b => Status(b) == BefaringStatus.Planlagt).ToList()),
        new(BefaringStatus.Gjennomfort, "Gjennomført", _befaringer.Where(b => Status(b) == BefaringStatus.Gjennomfort).ToList()),
        new(BefaringStatus.IkkeSatt, "Ingen dato", _befaringer.Where(b => Status(b) == BefaringStatus.IkkeSatt).ToList())
    ];

    private List<BefaringRow> Synlige(List<BefaringRow> rader)
    {
        var filtrert = string.IsNullOrWhiteSpace(_sok)
            ? rader
            : rader.Where(b => b.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                || (b.Kundenavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Sted?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                || (b.Adresse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

        return _sortering switch
        {
            "dato" => filtrert.OrderBy(b => b.Dato ?? DateTime.MaxValue).ToList(),
            "navn" => filtrert.OrderBy(b => b.Navn, StringComparer.OrdinalIgnoreCase).ToList(),
            _ => filtrert.OrderByDescending(b => b.OpprettetDato).ToList()
        };
    }
}
