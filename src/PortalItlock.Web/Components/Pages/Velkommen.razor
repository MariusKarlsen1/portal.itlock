@page "/velkommen"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@* Offentlig landingsside - portalens inngangsdør for de som ikke er logget
   inn ennå. Ligger på en EGEN rute, ikke på "/", slik at ingenting i selve
   portalen endres: "/" er fortsatt forsiden for innloggede.

   Siden er bevisst statisk rendret (ingen @rendermode) - den trenger ingen
   SignalR-krets, bare litt JS til innrulling, telling og temabryteren. *@

<PageTitle>Full Kontroll - portalen for låsmontasje, service og dokumentasjon</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="vk">

    @* Tynn linje helt øverst som fylles etter hvor langt man har rullet. *@
    <div class="vk-fremdrift" id="vk-fremdrift" aria-hidden="true"></div>

    <a class="vk-hopp" href="#innhold">Hopp til innholdet</a>

    <nav class="vk-nav" id="vk-nav">
        <a class="vk-logo" href="#topp">
            <span class="vk-logo-merke"><Icon Name="shield" /></span>
            <span class="vk-logo-tekst">Full Kontroll</span>
        </a>
        <div class="vk-nav-lenker">
            <a href="#slik">Slik fungerer det</a>
            <a href="#moduler">Moduler</a>
            <a href="#felt">I felt</a>
            <a href="#roller">For rollene</a>
            <a href="#sporsmal">Spørsmål</a>
        </div>
        <div class="vk-nav-handling">
            <button type="button" class="vk-tema" id="vk-tema" aria-label="Bytt mellom lyst og mørkt">
                <span class="vk-tema-sol"><Icon Name="sun" /></span>
                <span class="vk-tema-mane"><Icon Name="circle" /></span>
            </button>
            <a class="vk-knapp vk-knapp-primar" href="/login">Logg inn</a>
        </div>
    </nav>

    <header class="vk-hero" id="topp">
        <div class="vk-glod" aria-hidden="true"></div>

        <div class="vk-hero-tekst" id="innhold">
            <span class="vk-merkelapp vk-inn" style="--d:0s">For låsmontasje og dørautomatikk</span>
            <h1 class="vk-inn" style="--d:.06s">
                Full kontroll
                <span class="vk-h1-sub">fra tilbud til ferdig dokumentert dør</span>
            </h1>
            <p class="vk-lead vk-inn" style="--d:.12s">
                Prosjekter, arbeidsordre, dørpakker, CE-dokumentasjon, service og timer
                i én portal. Montøren ser dagens jobber, prosjektlederen ser fremdriften,
                og kunden ser sitt eget.
            </p>
            <div class="vk-cta vk-inn" style="--d:.18s">
                <a class="vk-knapp vk-knapp-primar vk-knapp-stor" href="/login">
                    Logg inn<Icon Name="arrow-right" />
                </a>
                <a class="vk-knapp vk-knapp-rolig vk-knapp-stor" href="#slik">Se hvordan det virker</a>
            </div>
            <p class="vk-hero-fot vk-inn" style="--d:.24s">
                Bygget for ett formål: at ingen dør blir glemt, og at dokumentasjonen er ferdig når jobben er ferdig.
            </p>
        </div>

        @* Forenklet gjengivelse av portalens egen forside - samme kort og
           kalenderrutenett, bare som ren pynt. *@
        <div class="vk-hero-figur vk-inn" style="--d:.3s" aria-hidden="true">
            <div class="vk-mock">
                <div class="vk-mock-topp">
                    <span class="vk-mock-prikk"></span>
                    <span class="vk-mock-prikk"></span>
                    <span class="vk-mock-prikk"></span>
                    <span class="vk-mock-tittel">Full Kontroll</span>
                </div>
                <div class="vk-mock-krop">
                    <div class="vk-mock-statrad">
                        <div class="vk-mock-stat"><span class="vk-mock-tall" data-tell="8">0</span><span class="vk-mock-lbl">Aktive prosjekter</span></div>
                        <div class="vk-mock-stat"><span class="vk-mock-tall" data-tell="12">0</span><span class="vk-mock-lbl">Åpne arbeidsordre</span></div>
                        <div class="vk-mock-stat"><span class="vk-mock-tall" data-tell="34">0</span><span class="vk-mock-lbl">Dører montert</span></div>
                    </div>
                    <div class="vk-mock-kal">
                        @for (var dag = 0; dag < 5; dag++)
                        {
                            var d = dag;
                            <div class="vk-mock-kol">
                                <span class="vk-mock-dag">@(new[] { "Man", "Tir", "Ons", "Tor", "Fre" }[d])</span>
                                @foreach (var blokk in MockBlokker(d))
                                {
                                    <span class="vk-mock-blokk vk-mock-blokk-@blokk.Farge"
                                          style="top:@(blokk.Topp)%;height:@(blokk.Hoyde)%;animation-delay:@(blokk.Forsinkelse)s"></span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    @* Stripen gli-ruller sakte. Innholdet ligger to ganger, slik at den kan
       gjentas uten hopp - se vk-marki i CSS. *@
    <section class="vk-stripe" aria-hidden="true">
        <div class="vk-marki">
            @for (var runde = 0; runde < 2; runde++)
            {
                <div class="vk-marki-spor">
                    @foreach (var ord in Stripeord)
                    {
                        <span class="vk-stripe-ord">@ord</span>
                        <span class="vk-stripe-skille"></span>
                    }
                </div>
            }
        </div>
    </section>

    <section class="vk-seksjon" id="slik">
        <div class="vk-seksjon-topp vk-rull">
            <span class="vk-merkelapp">Slik fungerer det</span>
            <h2>Fra tilbud til overlevering<br />uten å miste en dør på veien</h2>
            <p class="vk-seksjon-lead">
                Alt henger sammen. Tilbudet blir prosjekt, prosjektet blir arbeidsordre,
                arbeidsordren blir timer og dokumentasjon - uten at noe skrives inn to ganger.
            </p>
        </div>

        <div class="vk-steg">
            <span class="vk-steg-linje" aria-hidden="true"></span>
            @foreach (var steg in Stegene)
            {
                <article class="vk-steg-kort vk-rull">
                    <span class="vk-steg-nr">@steg.Nummer</span>
                    <span class="vk-steg-ikon"><Icon Name="@steg.Ikon" /></span>
                    <h3>@steg.Tittel</h3>
                    <p>@steg.Tekst</p>
                </article>
            }
        </div>
    </section>

    @* Historie-seksjon: ett konkret eksempel, med en liten figur som viser
       hva som faktisk skjer i modulen. *@
    <section class="vk-historie vk-rull">
        <div class="vk-historie-tekst">
            <span class="vk-merkelapp">Finn dørpakke</span>
            <h2>Dørpakken finner seg selv</h2>
            <p>
                Huk av kravene - brannklasse, rømning, adgangskontroll, lydkrav - og
                portalen finner dørpakkene som oppfyller alt. Du ser med en gang hvilke
                som treffer fullt, og hvilke som mangler ett krav.
            </p>
            <ul class="vk-punkter">
                <li><Icon Name="check" />Komponentene og prisene følger med pakken</li>
                <li><Icon Name="check" />Montasjetiden er lagt inn per komponent</li>
                <li><Icon Name="check" />Pakken kan legges rett på døren i prosjektet</li>
            </ul>
        </div>
        <div class="vk-historie-figur" aria-hidden="true">
            <div class="vk-figurkort vk-krav">
                @foreach (var krav in new[] { "Brannklasse EI30", "Rømningsvei", "Adgangskontroll", "Lydkrav 35 dB" })
                {
                    <span class="vk-krav-rad"><span class="vk-krav-boks"><Icon Name="check" /></span>@krav</span>
                }
                <div class="vk-krav-treff">
                    <span class="vk-krav-treff-topp"><Icon Name="box" />3 dørpakker oppfyller alle krav</span>
                    <span class="vk-krav-bar"><span style="width:100%"></span></span>
                    <span class="vk-krav-bar"><span style="width:100%"></span></span>
                    <span class="vk-krav-bar"><span style="width:76%"></span></span>
                </div>
            </div>
        </div>
    </section>

    <section class="vk-historie vk-historie-speil vk-rull">
        <div class="vk-historie-tekst">
            <span class="vk-merkelapp">CE-modul</span>
            <h2>Dokumentasjonen blir ferdig mens jobben gjøres</h2>
            <p>
                Dører med automatikk skal CE-merkes. Portalen samler målene, komponentene
                og vilkårene underveis, og sier fra hvilke punkter som mangler før
                sertifikatet kan signeres.
            </p>
            <ul class="vk-punkter">
                <li><Icon Name="check" />Vilkårene sjekkes mot grenseverdiene automatisk</li>
                <li><Icon Name="check" />Samlevisning på tvers av alle prosjekter</li>
                <li><Icon Name="check" />FDV og beslagsliste hentes fra de samme dataene</li>
            </ul>
        </div>
        <div class="vk-historie-figur" aria-hidden="true">
            <div class="vk-figurkort vk-ce">
                <div class="vk-ce-topp">
                    <span class="vk-ce-merke">CE</span>
                    <span>
                        <strong>Hovedinngang, dør 104</strong>
                        <small>Skyvedør med automatikk</small>
                    </span>
                </div>
                @foreach (var (navn, ok) in new[] { ("Åpningskraft målt", true), ("Klemsikring testet", true), ("Brukerveiledning levert", true), ("Risikovurdering signert", false) })
                {
                    <span class="vk-ce-rad @(ok ? "vk-ce-ok" : "vk-ce-venter")">
                        <Icon Name="@(ok ? "check-circle" : "clock")" />@navn
                    </span>
                }
                <span class="vk-ce-sum">3 av 4 vilkår oppfylt</span>
            </div>
        </div>
    </section>

    @* Montøren i felt - telefonfigur med dagens jobb og klokka som går. *@
    <section class="vk-historie vk-rull" id="felt">
        <div class="vk-historie-tekst">
            <span class="vk-merkelapp">Min dag</span>
            <h2>Montøren har dagen i lomma</h2>
            <p>
                Dagens jobber med adresse, varer å pakke og sjekkliste. Timene føres med
                start og stopp, bildene lastes opp fra felt, og jobben ferdigmeldes på stedet.
            </p>
            <ul class="vk-punkter">
                <li><Icon Name="check" />Veibeskrivelse og kart til neste jobb</li>
                <li><Icon Name="check" />Plukkliste over varene som skal med</li>
                <li><Icon Name="check" />Sjekkliste per dørtype, signert når den er gjort</li>
            </ul>
        </div>
        <div class="vk-historie-figur" aria-hidden="true">
            <div class="vk-telefon">
                <div class="vk-telefon-skjerm">
                    <span class="vk-telefon-tittel">Min dag</span>
                    <div class="vk-klokke">
                        <span class="vk-klokke-tall">02:14:08</span>
                        <span class="vk-klokke-lbl">Timer føres nå</span>
                        <span class="vk-klokke-puls"></span>
                    </div>
                    @foreach (var (tittel, under, farge) in new[] { ("Holmlia kompleks", "08:00 · 4 dører", "gronn"), ("Nærbø skole", "12:30 · Service", "gul") })
                    {
                        <span class="vk-telefon-rad">
                            <span class="vk-telefon-navn">
                                <strong>@tittel</strong>
                                <small>@under</small>
                            </span>
                            <span class="vk-telefon-pill vk-telefon-pill-@farge">Neste</span>
                        </span>
                    }
                    <span class="vk-telefon-knapp">Ferdigmeld jobben</span>
                </div>
            </div>
        </div>
    </section>

    <section class="vk-seksjon" id="moduler">
        <div class="vk-seksjon-topp vk-rull">
            <span class="vk-merkelapp">Moduler</span>
            <h2>Alt arbeidet på ett sted</h2>
            <p class="vk-seksjon-lead">
                Modulene henger sammen, men du slår bare på det organisasjonen trenger.
            </p>
        </div>

        <div class="vk-rutenett">
            @foreach (var m in Modulene)
            {
                <article class="vk-kort vk-rull">
                    <span class="vk-kort-ikon vk-kort-ikon-@m.Tint"><Icon Name="@m.Ikon" /></span>
                    <h3>@m.Tittel</h3>
                    <p>@m.Tekst</p>
                </article>
            }
        </div>
    </section>

    <section class="vk-seksjon vk-seksjon-tett" id="roller">
        <div class="vk-seksjon-topp vk-rull">
            <span class="vk-merkelapp">For rollene</span>
            <h2>Hver rolle ser akkurat sitt</h2>
            <p class="vk-seksjon-lead">
                Samme portal, fire ulike bilder. Ingen må lete seg gjennom noe de ikke bruker.
            </p>
        </div>

        <div class="vk-roller">
            @foreach (var r in Rollene)
            {
                <article class="vk-rolle vk-rull">
                    <span class="vk-rolle-ikon"><Icon Name="@r.Ikon" /></span>
                    <h3>@r.Tittel</h3>
                    <ul>
                        @foreach (var punkt in r.Punkter)
                        {
                            <li>@punkt</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </section>

    <section class="vk-historie vk-historie-speil vk-rull" id="kunde">
        <div class="vk-historie-tekst">
            <span class="vk-merkelapp">Kundeportal</span>
            <h2>Kunden slipper å ringe og spørre</h2>
            <p>
                Kunden logger inn og ser sine egne jobber, bilder fra montasjen,
                avvik som venter på godkjenning og tilvalg som kan bestilles.
                Alt de svarer på, havner rett i prosjektet.
            </p>
            <ul class="vk-punkter">
                <li><Icon Name="check" />Melder inn service selv, med bilder</li>
                <li><Icon Name="check" />Godkjenner avvik med signatur</li>
                <li><Icon Name="check" />Vaktmestere får egen tilgang til driftsmeldinger</li>
            </ul>
        </div>
        <div class="vk-historie-figur" aria-hidden="true">
            <div class="vk-telefon">
                <div class="vk-telefon-skjerm">
                    <span class="vk-telefon-tittel">Mine jobber</span>
                    @foreach (var (tittel, status, farge) in new[] { ("Service hovedinngang", "Ferdig", "gronn"), ("Dør 104 - automatikk", "Pågår", "gul"), ("Avvik: karm skadet", "Til godkjenning", "rod") })
                    {
                        <span class="vk-telefon-rad">
                            <span class="vk-telefon-navn"><strong>@tittel</strong></span>
                            <span class="vk-telefon-pill vk-telefon-pill-@farge">@status</span>
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="vk-seksjon vk-seksjon-tett" id="integrasjoner">
        <div class="vk-seksjon-topp vk-rull">
            <span class="vk-merkelapp">Henger sammen med resten</span>
            <h2>Portalen står ikke alene</h2>
        </div>

        <div class="vk-integrasjoner">
            @foreach (var i in Integrasjonene)
            {
                <article class="vk-integrasjon vk-rull">
                    <span class="vk-integrasjon-ikon"><Icon Name="@i.Ikon" /></span>
                    <span>
                        <strong>@i.Tittel</strong>
                        <small>@i.Tekst</small>
                    </span>
                </article>
            }
        </div>
    </section>

    @* Vanlige spørsmål. Bruker details/summary, så den virker uten JS og er
       tilgjengelig med tastatur av seg selv. *@
    <section class="vk-seksjon" id="sporsmal">
        <div class="vk-seksjon-topp vk-rull">
            <span class="vk-merkelapp">Spørsmål</span>
            <h2>Det folk spør om først</h2>
        </div>

        <div class="vk-faq vk-rull">
            @foreach (var f in Sporsmalene)
            {
                <details class="vk-faq-post">
                    <summary>
                        @f.Tittel
                        <span class="vk-faq-pil"><Icon Name="chevron-down" /></span>
                    </summary>
                    <p>@f.Svar</p>
                </details>
            }
        </div>
    </section>

    <section class="vk-avslutt vk-rull">
        <h2>Klar til å ta kontrollen?</h2>
        <p>Logg inn og fortsett der du var.</p>
        <a class="vk-knapp vk-knapp-primar vk-knapp-stor" href="/login">
            Logg inn<Icon Name="arrow-right" />
        </a>
    </section>

    <footer class="vk-fot">
        <span class="vk-logo">
            <span class="vk-logo-merke"><Icon Name="shield" /></span>
            <span class="vk-logo-tekst">Full Kontroll</span>
        </span>
        <span class="vk-fot-tekst">Laget av Marius Karlsen</span>
    </footer>
</div>

<script src="js/velkommen.js?v=2"></script>

@code {
    private sealed record Steg(string Nummer, string Ikon, string Tittel, string Tekst);
    private sealed record Modul(string Ikon, string Tint, string Tittel, string Tekst);
    private sealed record Rolle(string Ikon, string Tittel, string[] Punkter);
    private sealed record Integrasjon(string Ikon, string Tittel, string Tekst);
    private sealed record Sporsmal(string Tittel, string Svar);
    private sealed record MockBlokk(int Topp, int Hoyde, string Farge, double Forsinkelse);

    private static readonly string[] Stripeord =
    [
        "Prosjekter", "Arbeidsordre", "Dørpakker", "CE-dokumentasjon",
        "Serviceavtaler", "Timeføring", "Kundeportal", "Tickets", "Komponentregister"
    ];

    private static readonly Steg[] Stegene =
    [
        new("01", "receipt", "Tilbud og prosjekt",
            "Sett sammen tilbudet fra komponentregisteret, med montasjetid og dekningsgrad. Blir det solgt, er prosjektet allerede der."),
        new("02", "check-circle", "Arbeidsordre og montasje",
            "Montøren får jobben på Min dag med adresse, varer å pakke og sjekkliste. Timer føres på ordren, bilder lastes opp fra felt."),
        new("03", "shield", "Dokumentasjon og service",
            "CE, FDV og beslagsliste hentes fra de samme dataene. Serviceavtalen tar over når prosjektet er overlevert.")
    ];

    private static readonly Modul[] Modulene =
    [
        new("folder", "brun", "Prosjekter", "Dører, plantegninger og montasjestatus per prosjekt. Fremdrift du ser med én gang."),
        new("check-circle", "gronn", "Arbeidsordre", "Jobber med ansvarlig montør, varer, sjekkliste og timer samlet på ordren."),
        new("box", "bla", "Finn dørpakke", "Huk av krav og få de pakkene som faktisk oppfyller dem."),
        new("shield", "lilla", "CE-godkjenninger", "Sertifisering av dører med automatikk, med vilkår og gyldighet på tvers av prosjekter."),
        new("clock", "oransje", "Serviceavtaler", "Servicerunder, årshjul og historikk. Portalen sier fra når neste runde nærmer seg."),
        new("calendar", "turkis", "Kalender", "Én rad per montør, med uke- og månedsvisning. Dra en jobb til en ny dag."),
        new("tag", "rod", "Tickets", "Alle henvendelser og saker på ett sted, med frister og ansvarlig."),
        new("trend-up", "bla", "Kobling og dørmiljø", "Koblingsskjema og prinsippskisser til bruk mot elektro og på befaring."),
        new("box", "brun", "Komponenter og priser", "Komponentregister, prisimport fra leverandør, rabattgrupper og lagerstyring.")
    ];

    private static readonly Rolle[] Rollene =
    [
        new("users", "Administrator", ["Alt - oppsett, maler, komponenter og priser", "Brukere, kundetilganger og driftslisenser", "Rapporter og fakturaoversikt"]),
        new("folder", "Prosjektleder", ["Prosjekter, tilbud og arbeidsordre", "Kalender, tickets og serviceavtaler", "Godkjenner timer og fraværssøknader"]),
        new("tool", "Montør", ["Min dag med dagens jobber og adresser", "Befaring, låsutskiftning og ABC-kalkulator", "Fører egne timer og ferdigmelder jobben"]),
        new("home", "Kunde", ["Egne jobber med bilder fra montasjen", "Godkjenner avvik med signatur", "Melder inn service og svarer på tilvalg"])
    ];

    private static readonly Integrasjon[] Integrasjonene =
    [
        new("receipt", "Tripletex", "Ferdigmeldte arbeidsordre sendes over som ordre klar til fakturering, med varelinjer og timer."),
        new("mail", "E-post inn og ut", "Henvendelser til post-adressen havner i Forespørsler. Dokumentasjon sendes til kunden når jobben ferdigmeldes."),
        new("box", "Prisimport", "Last opp leverandørens prisliste og oppdater priser uten å røre det som ikke er med i filen."),
        new("users", "Flere organisasjoner", "Hver organisasjon har sin egen database og sine egne lisenser. Ingen data deles på tvers.")
    ];

    private static readonly Sporsmal[] Sporsmalene =
    [
        new("Må alle modulene brukes?",
            "Nei. Modulene slås på per organisasjon, og menyen viser bare det dere har. Begynner dere med prosjekter og arbeidsordre, er det helt greit - service, CE og tickets kan komme etterpå."),
        new("Hva ser en montør kontra en prosjektleder?",
            "Montøren ser Min dag, befaringsverktøyene, egne timer og jobbene sine - og kan ferdigmelde dem. Prosjektlederen ser prosjekter, tilbud, kalender og godkjenninger. Administratoren ser alt. Tilgangene håndheves på serveren, ikke bare i menyen."),
        new("Virker det på mobil ute i felt?",
            "Ja. Montørens visning er laget for telefon først: dagens jobber, plukkliste, sjekkliste, bilder og timer med start og stopp."),
        new("Hvor blir dokumentasjonen av?",
            "CE-sertifikater, FDV, beslagslister og sjekklister genereres fra de samme dataene som allerede ligger på døren og arbeidsordren, og lagres på prosjektet. Kunden kan få dem på e-post når jobben ferdigmeldes."),
        new("Hvordan fungerer lisensene?",
            "Dere har et antall brukerlisenser for ansatte og et antall kundetilganger for kundeportalen. Antallet styres sentralt, så dere kan utvide etter hvert som dere vokser.")
    ];

    // Pyntet kalenderrutenett i hero-figuren. Faste verdier - ingen data
    // hentes på en offentlig side.
    private static MockBlokk[] MockBlokker(int dag) => dag switch
    {
        0 => [new(8, 26, "brun", 0.35), new(46, 20, "gronn", 0.45)],
        1 => [new(14, 34, "bla", 0.5), new(60, 18, "oransje", 0.6)],
        2 => [new(6, 22, "gronn", 0.55), new(36, 30, "lilla", 0.65)],
        3 => [new(20, 40, "brun", 0.7)],
        _ => [new(10, 18, "turkis", 0.75), new(40, 26, "gronn", 0.85)]
    };
}
