@page "/prosjektmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Prosjekt - itlock</PageTitle>

<a class="back-link" href="/"><Icon Name="arrow-left" />Til hjem</a>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="folder" /></span>
    <div>
        <h1>Prosjekt</h1>
        <p class="section-hint">Prosjekter og arbeidsordre.</p>
    </div>
</div>

<div class="modul-grid">
    <a href="/prosjekter" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="folder" /></span>
        <span class="modul-card-title">Prosjekter</span>
        <span class="modul-card-desc">Prosjekter du er lagt til på.</span>
    </a>
    <a href="/arbeidsordre" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="receipt" /></span>
        <span class="modul-card-title">Arbeidsordre</span>
        <span class="modul-card-desc">Se arbeidsordre med info om jobben og ansvarlig montør.</span>
    </a>
    <a href="/ce-godkjenninger" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="check-circle" /></span>
        <span class="modul-card-title">CE-godkjenninger</span>
        <span class="modul-card-desc">CE-sertifiseringer for dører med automatikk, på tvers av prosjekter.</span>
    </a>
</div>
