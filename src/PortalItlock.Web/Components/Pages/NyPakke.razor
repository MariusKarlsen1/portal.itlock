@page "/ny-pakke"
@page "/rediger-pakke/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? "Rediger pakke" : "Ny pakke")</PageTitle>

@if (_notFound)
{
    <a class="back-link" href="/dorpakker"><Icon Name="arrow-left" />Til dørpakker</a>
    <p class="form-error">Fant ikke pakken. Den kan være slettet.</p>
}
else if (Id.HasValue)
{
    @* RK1 (rediger-pakke-kort-forslag.html): samme innhold og faner som før, men
       i dashbord-kortet med fliser. ✎ på en flis starter redigering av pakken,
       og lagre-linjen nederst lagrer eller forkaster. Utvid-knappen gir full bredde. *@
    <div class="rk @(_full ? "rk-full" : "")">
        <div class="pakke-brodsmule">
            <NavLink href="/dorpakker">Dørpakker</NavLink>
            <span>/</span>
            <span class="pakke-brodsmule-na">@_form.Navn</span>
        </div>

        <div class="rk-topp">
            <div class="rk-topp-v">
                <span class="pakke-header-ikon"><Icon Name="box" /></span>
                <div>
                    <h1>@_form.Navn</h1>
                    <p>@(string.IsNullOrWhiteSpace(_form.Beskrivelse) ? "Ingen beskrivelse lagt til ennå." : _form.Beskrivelse)</p>
                </div>
            </div>
            <div class="rk-topp-h">
                <a class="rk-knapp" href="@($"/dorpakke/{Id}/pdf")" target="_blank"><Icon Name="printer" />PDF</a>
                @if (!_redigerer)
                {
                    <button type="button" class="rk-knapp" @onclick="@(() => StartRedigering(null))"><Icon Name="edit" />Rediger</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="save-success">@_savedMessage</p>
        }

        <div class="rk-kort">
            <nav class="rk-faner">
                <button type="button" class="rk-fane @(_fane == "oversikt" ? "aktiv" : "")" @onclick="@(() => _fane = "oversikt")"><Icon Name="grid" />Oversikt</button>
                <button type="button" class="rk-fane @(_fane == "komponenter" ? "aktiv" : "")" @onclick="@(() => _fane = "komponenter")"><Icon Name="box" />Komponenter <em>@_components.Count</em></button>
                <button type="button" class="rk-fane @(_fane == "krav" ? "aktiv" : "")" @onclick="@(() => _fane = "krav")"><Icon Name="check-circle" />Krav og egenskaper <em>@_selectedValueIds.Count</em></button>
                <button type="button" class="rk-fane @(_fane == "dokumentasjon" ? "aktiv" : "")" @onclick="@(() => _fane = "dokumentasjon")"><Icon Name="file-text" />Dokumentasjon</button>
                <button type="button" class="rk-fane @(_fane == "historikk" ? "aktiv" : "")" @onclick="@(() => _fane = "historikk")"><Icon Name="clock" />Historikk</button>
                <button type="button" class="rk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </nav>

            <div class="rk-innhold">
                @if (_fane == "oversikt")
                {
                    @if (_redigerer)
                    {
                        <section class="rk-tile">
                            <div class="rk-tile-t"><h3>Om pakken</h3></div>
                            <div class="rk-skjema">
                                <label class="rk-felt"><span>Navn på pakke</span><input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Innerdør EI30 RC2" /></label>
                                <label class="rk-felt"><span>Beskrivelse (valgfritt)</span><textarea @bind="_form.Beskrivelse" rows="3"></textarea></label>
                                <label class="rk-felt"><span>Bruksområde (valgfritt, ett sted per linje)</span><textarea @bind="_form.Bruksomrade" rows="3" placeholder="F.eks.@Environment.NewLine Garasje@Environment.NewLine Sluse"></textarea></label>
                            </div>
                        </section>
                    }

                    <div class="rk-tiles rk-tiles-3">
                        <section class="rk-tile">
                            <div class="rk-tile-t"><h3>Bilde</h3></div>
                            <div class="rk-hovedbilde"><DoorFigur AntallFloyer="@FormAntallFloyer()" /></div>

                        </section>

                        <section class="rk-tile">
                            <div class="rk-tile-t">
                                <h3>Grunndata</h3>
                                <button type="button" class="rk-endre" @onclick="@(() => StartRedigering("krav"))"><Icon Name="edit" />Endre</button>
                            </div>
                            @if (FormGrunndata().Count == 0)
                            {
                                <p class="rk-dempet">Ingen krav valgt ennå.</p>
                            }
                            else
                            {
                                <div class="rk-grunndata">
                                    @foreach (var rad in FormGrunndata())
                                    {
                                        <div>
                                            <i><Icon Name="@rad.Ikon" /></i>
                                            <span>@rad.Label</span>
                                            <b>@rad.Verdi</b>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="rk-tile">
                            <div class="rk-tile-t">
                                <h3>Beskrivelse</h3>
                                @if (!_redigerer)
                                {
                                    <button type="button" class="rk-endre" @onclick="@(() => StartRedigering("oversikt"))"><Icon Name="edit" />Endre</button>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_form.Beskrivelse))
                            {
                                <p class="rk-tekst">@_form.Beskrivelse</p>
                            }
                            else
                            {
                                <p class="rk-dempet">Ingen beskrivelse lagt til ennå.</p>
                            }
                            <span class="rk-seksjon">Bruksområde</span>
                            @if (FormBruksomrader().Length == 0)
                            {
                                <p class="rk-dempet">Ingen bruksområder lagt til ennå.</p>
                            }
                            else
                            {
                                <ul class="rk-liste">
                                    @foreach (var sted in FormBruksomrader())
                                    {
                                        <li>@sted</li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>

                    <section class="rk-tile">
                        <div class="rk-tile-t"><h3>Snarveier</h3></div>
                        @if (!string.IsNullOrEmpty(_delMelding))
                        {
                            <p class="save-success">@_delMelding</p>
                        }
                        <div class="rk-snarveier">
                            <button type="button" @onclick="KopierDorpakke"><Icon Name="clipboard" />Kopier dørpakke</button>
                            <a href="@($"/dorpakke/{Id}/pdf")" target="_blank"><Icon Name="file-text" />Eksporter til PDF</a>
                            <button type="button" @onclick="DelDorpakke"><Icon Name="upload" />Del dørpakke</button>
                            @if (_confirmingDelete)
                            {
                                <span class="rk-slett">
                                    Skriv SLETT for å bekrefte.
                                    <input @bind="_slettBekreftelseTekst" @bind:event="oninput" placeholder="SLETT" class="kode-input" />
                                    <button type="button" class="farlig" disabled="@(_slettBekreftelseTekst != "SLETT")" @onclick="ConfirmDelete">Ja, slett</button>
                                    <button type="button" @onclick="@(() => { _confirmingDelete = false; _slettBekreftelseTekst = ""; })">Avbryt</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="farlig" @onclick="@(() => _confirmingDelete = true)"><Icon Name="trash" />Slett dørpakke</button>
                            }
                        </div>
                    </section>
                }
                else if (_fane == "komponenter")
                {
                    <section class="rk-tile rk-tile-tabell">
                        <div class="rk-tile-t">
                            <h3>Komponenter</h3>
                            @if (!_redigerer)
                            {
                                <button type="button" class="rk-endre" @onclick="@(() => StartRedigering("komponenter"))"><Icon Name="edit" />Endre</button>
                            }
                        </div>
                        @if (_components.Count == 0)
                        {
                            <p class="rk-dempet">Ingen komponenter lagt til ennå.</p>
                        }
                        else
                        {
                            <div class="rk-tabell">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Komponent</th>
                                            <th class="rk-skjul-m">Type</th>
                                            <th>Antall</th>
                                            <th>Levert av</th>
                                            <th class="n">Pris</th>
                                            @if (_redigerer)
                                            {
                                                <th></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in _components)
                                        {
                                            var komp = c;
                                            <tr>
                                                <td>
                                                    <b>@c.Navn</b>
                                                    @if (!string.IsNullOrWhiteSpace(c.Produsent))
                                                    {
                                                        <small>@c.Produsent</small>
                                                    }
                                                </td>
                                                <td class="rk-skjul-m rk-dempet-celle">@ComponentTypeName(c.ComponentTypeId)</td>
                                                <td>
                                                    @if (_redigerer)
                                                    {
                                                        <span class="rk-steg">
                                                            <button type="button" @onclick="@(() => komp.Antall = Math.Max(1, komp.Antall - 1))">−</button>
                                                            <span>@c.Antall</span>
                                                            <button type="button" @onclick="@(() => komp.Antall++)">+</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>@c.Antall @(c.Enhet ?? "stk")</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (_redigerer)
                                                    {
                                                        <span class="rk-lev" title="F = vi leverer og priser. Ld = leveres komplett av dørprodusent. Le = leveres komplett av elektro.">
                                                            <button type="button" class="@(c.LevertAv == LevertAv.F ? "pa" : "")" @onclick="@(() => komp.LevertAv = LevertAv.F)">Vi</button>
                                                            <button type="button" class="@(c.LevertAv == LevertAv.Ld ? "pa" : "")" @onclick="@(() => komp.LevertAv = LevertAv.Ld)">Dørprodusent</button>
                                                            <button type="button" class="@(c.LevertAv == LevertAv.Le ? "pa" : "")" @onclick="@(() => komp.LevertAv = LevertAv.Le)">Elektro</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="rk-dempet-celle">@LevertAvTekst(c.LevertAv)</span>
                                                    }
                                                </td>
                                                <td class="n">
                                                    @if (c.LevertAv != LevertAv.F)
                                                    {
                                                        <span class="rk-dempet-celle">ikke med</span>
                                                    }
                                                    else if (c.PrisNetto is decimal pris)
                                                    {
                                                        @Kr(pris * c.Antall)
                                                    }
                                                    else
                                                    {
                                                        <span class="rk-mangler">mangler pris</span>
                                                    }
                                                </td>
                                                @if (_redigerer)
                                                {
                                                    <td class="n"><button type="button" class="rk-fjern" title="Fjern" @onclick="@(() => _components.Remove(komp))">✕</button></td>
                                                }
                                            </tr>
                                        }
                                        <tr class="rk-sumrad">
                                            <td colspan="4">Sum – det vi leverer (netto)</td>
                                            <td class="n">@Kr(SumVi())</td>
                                            @if (_redigerer)
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (_redigerer)
                        {
                            <div class="rk-legg-til">
                                <label class="rk-sok">
                                    <Icon Name="plus" />
                                    <input @bind="_componentSearch" @bind:event="oninput" @bind:after="OnComponentSearchChanged" placeholder="Legg til komponent – søk på navn, leverandør eller produktkode" />
                                </label>
                                @if (_searchResults.Count > 0)
                                {
                                    <ul class="rk-treff">
                                        @foreach (var r in _searchResults)
                                        {
                                            <li>
                                                <button type="button" @onclick="@(() => AddFromSearch(r))">
                                                    <span><b>@r.Navn</b><small>@r.TypeName@(string.IsNullOrEmpty(r.Leverandor) ? "" : $" · {r.Leverandor}")@(string.IsNullOrEmpty(r.Produktkode) ? "" : $" · {r.Produktkode}")</small></span>
                                                    <em>＋ Legg til</em>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (_componentSearch.Trim().Length >= 2)
                                {
                                    <p class="rk-dempet">Ingen aktive komponenter matcher søket.</p>
                                }
                            </div>
                            <details class="rk-manuell">
                                <summary>Eller legg inn manuelt</summary>
                                <div class="rk-manuell-grid">
                                    <label class="rk-felt"><span>Komponenttype</span>
                                        <select @bind="_draft.ComponentTypeId">
                                            @foreach (var type in _componentTypes)
                                            {
                                                <option value="@type.Id">@type.Navn</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="rk-felt"><span>Navn</span><input @bind="_draft.Navn" placeholder="F.eks. Assa 431" /></label>
                                    <label class="rk-felt"><span>Produsent (valgfritt)</span><input @bind="_draft.Produsent" /></label>
                                    <label class="rk-felt"><span>Produktkode (valgfritt)</span><input @bind="_draft.Produktkode" /></label>
                                    <label class="rk-felt"><span>Antall</span><input type="number" min="1" @bind="_draft.Antall" /></label>
                                    <label class="rk-felt"><span>Enhet</span>
                                        <select @bind="_draft.Enhet">
                                            <option value="">Ikke satt</option>
                                            <option value="Stk">Stk</option>
                                            <option value="Sett">Sett</option>
                                            <option value="Par">Par</option>
                                            <option value="M">M</option>
                                        </select>
                                    </label>
                                    <label class="rk-felt"><span>Levert av</span>
                                        <select @bind="_draft.LevertAv">
                                            <option value="@LevertAv.F">Vi (F)</option>
                                            <option value="@LevertAv.Ld">Dørprodusent (Ld)</option>
                                            <option value="@LevertAv.Le">Elektro (Le)</option>
                                        </select>
                                    </label>
                                    <button type="button" class="rk-knapp primaer" @onclick="AddComponent">Legg til komponent</button>
                                </div>
                            </details>
                        }
                    </section>
                }
                else if (_fane == "krav")
                {
                    <div class="rk-tiles rk-tiles-2">
                        <section class="rk-tile">
                            <div class="rk-tile-t">
                                <h3>Krav pakken oppfyller</h3>
                                @if (!_redigerer)
                                {
                                    <button type="button" class="rk-endre" @onclick="@(() => StartRedigering("krav"))"><Icon Name="edit" />Endre</button>
                                }
                            </div>
                            @if (_redigerer)
                            {
                                <RequirementSelector Dimensions="_dimensions"
                                                      SelectedValueIds="_selectedValueIds"
                                                      SelectedValueIdsChanged="OnSelectionChanged" />
                            }
                            else if (_selectedValueIds.Count == 0)
                            {
                                <p class="rk-dempet">Ingen krav valgt ennå.</p>
                            }
                            else
                            {
                                <div class="rk-krav">
                                    @foreach (var dim in _dimensions)
                                    {
                                        var verdier = dim.Verdier.Where(v => _selectedValueIds.Contains(v.Id)).ToList();
                                        if (verdier.Count > 0)
                                        {
                                            <div>
                                                <span>@dim.Navn</span>
                                                <span class="rk-piller">
                                                    @foreach (var v in verdier)
                                                    {
                                                        <b><Icon Name="check" />@v.Verdi</b>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </section>

                        <section class="rk-tile">
                            <div class="rk-tile-t">
                                <h3>Dørfunksjoner</h3>
                                @if (!_redigerer)
                                {
                                    <button type="button" class="rk-endre" @onclick="@(() => StartRedigering("krav"))"><Icon Name="edit" />Endre</button>
                                }
                            </div>
                            <p class="rk-dempet">Følger med automatisk når pakken legges til på en dør.</p>
                            @if (_redigerer)
                            {
                                <div class="rk-funksjon-legg-til">
                                    <select @bind="_valgtFunksjonId">
                                        <option value="">Velg funksjon...</option>
                                        @foreach (var f in _ledigeFunksjoner)
                                        {
                                            <option value="@f.Id">@f.Navn</option>
                                        }
                                    </select>
                                    <button type="button" class="rk-knapp primaer" @onclick="LeggTilFunksjon" disabled="@(_valgtFunksjonId is null)">Legg til</button>
                                </div>
                            }
                            @if (_valgteFunksjoner.Count == 0)
                            {
                                <p class="rk-dempet">Ingen dørfunksjoner valgt.</p>
                            }
                            else
                            {
                                <div class="rk-brikker">
                                    @foreach (var f in _valgteFunksjoner)
                                    {
                                        var funksjon = f;
                                        <span @key="f.Id">
                                            @f.Navn
                                            @if (_redigerer)
                                            {
                                                <button type="button" title="Fjern" @onclick="@(() => FjernFunksjon(funksjon))">✕</button>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                }
                else if (_fane == "dokumentasjon")
                {
                    <section class="rk-tile">
                        <div class="rk-tile-t"><h3>Dokumentasjon</h3></div>
                        <p class="rk-dempet">Ingen dokumenter lastet opp for denne pakken ennå.</p>
                    </section>
                }
                else if (_fane == "historikk")
                {
                    <section class="rk-tile">
                        <div class="rk-tile-t"><h3>Historikk</h3></div>
                        <div class="rk-historikk">
                            <span class="rk-historikk-prikk"></span>
                            <span><b>Pakke opprettet</b><small>@_opprettetDato.ToString("dd.MM.yyyy")</small></span>
                        </div>
                    </section>
                }
            </div>
        </div>

        @if (_redigerer)
        {
            <div class="rk-lagrebar">
                <span><Icon Name="edit" /><b>Du redigerer pakken</b> – endringene lagres først når du trykker Lagre.</span>
                <span class="rk-lagrebar-knapper">
                    <button type="button" class="rk-knapp" @onclick="AvbrytRedigering">Avbryt</button>
                    <button type="button" class="rk-knapp primaer" @onclick="SavePackage"><Icon Name="check" />Lagre endringer</button>
                </span>
            </div>
        }
    </div>
}
else
{
    <div class="pakke-brodsmule">
        <NavLink href="/dorpakker">Dørpakker</NavLink>
        <span>/</span>
        <span class="pakke-brodsmule-na">@(Id.HasValue ? _form.Navn : "Ny pakke")</span>
    </div>

    <div class="pakke-header">
        <div class="pakke-header-venstre">
            <span class="pakke-header-ikon"><Icon Name="box" /></span>
            <div>
                <div class="pakke-header-navn-rad">
                    <h1>@(Id.HasValue ? _form.Navn : "Ny pakke")</h1>
                    @if (Id.HasValue)
                    {
                        <button type="button" class="knapp knapp-liten" @onclick="@(() => _redigerer = !_redigerer)">
                            <Icon Name="edit" />@(_redigerer ? "Avbryt redigering" : "Rediger")
                        </button>
                    }
                </div>
                <p class="section-hint">
                    @if (!Id.HasValue)
                    {
                        <text>Sett sammen en dørpakke manuelt: gi den et navn, huk av hvilke krav den oppfyller, og legg til komponentene den består av.</text>
                    }
                    else if (_redigerer)
                    {
                        <text>Endre navn, krav eller komponenter, og lagre endringene.</text>
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(_form.Beskrivelse) ? "Ingen beskrivelse lagt til ennå." : _form.Beskrivelse)
                    }
                </p>
            </div>
        </div>
        @if (Id.HasValue)
        {
            <button type="button" class="knapp knapp-primaer" disabled="@(!_redigerer)" @onclick="SavePackage">
                <Icon Name="check" />Lagre endringer
            </button>
        }
    </div>

    @if (Id.HasValue)
    {
        <div class="pakke-faner">
            <button type="button" class="pakke-fane @(_fane == "oversikt" ? "pakke-fane-aktiv" : "")" @onclick="@(() => _fane = "oversikt")">Oversikt</button>
            <button type="button" class="pakke-fane @(_fane == "komponenter" ? "pakke-fane-aktiv" : "")" @onclick="@(() => _fane = "komponenter")">Komponenter (@_components.Count)</button>
            <button type="button" class="pakke-fane @(_fane == "krav" ? "pakke-fane-aktiv" : "")" @onclick="@(() => _fane = "krav")">Krav og egenskaper</button>
            <button type="button" class="pakke-fane @(_fane == "dokumentasjon" ? "pakke-fane-aktiv" : "")" @onclick="@(() => _fane = "dokumentasjon")">Dokumentasjon</button>
            <button type="button" class="pakke-fane @(_fane == "historikk" ? "pakke-fane-aktiv" : "")" @onclick="@(() => _fane = "historikk")">Historikk</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="form-error">@_error</p>
    }
    @if (!string.IsNullOrEmpty(_savedMessage))
    {
        <p class="save-success">@_savedMessage</p>
    }

    @if (!Id.HasValue || _fane == "oversikt")
    {
        @if (_redigerer || !Id.HasValue)
        {
            <div class="kort pakke-kort-seksjon">
                <h2>Om pakken</h2>
                <label>
                    Navn på pakke
                    <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Innerdør EI30 RC2" />
                </label>
                <label>
                    Beskrivelse (valgfritt)
                    <textarea @bind="_form.Beskrivelse" rows="3"></textarea>
                </label>
                <label>
                    Bruksområde (valgfritt, ett sted per linje)
                    <textarea @bind="_form.Bruksomrade" rows="3" placeholder="F.eks.@Environment.NewLine Garasje@Environment.NewLine Sluse"></textarea>
                </label>
            </div>
        }
        else
        {
            <div class="pakke-oversikt-grid">
                <div class="kort pakke-galleri">
                    <div class="pakke-galleri-rad">
                        <div class="pakke-miniatyrer">
                            @for (var i = 0; i < 3; i++)
                            {
                                var idx = i;
                                <button type="button" class="pakke-miniatyr @(_valgtBildeIndex == idx ? "pakke-miniatyr-aktiv" : "")" @onclick="@(() => _valgtBildeIndex = idx)">
                                    <DoorFigur AntallFloyer="@FormAntallFloyer()" />
                                </button>
                            }
                        </div>
                        <div class="pakke-hovedbilde">
                            <DoorFigur AntallFloyer="@FormAntallFloyer()" />
                        </div>
                    </div>
                </div>

                <div class="kort pakke-grunndata-boks">
                    <h2>Grunndata</h2>
                    @if (FormGrunndata().Count == 0)
                    {
                        <p class="component-empty-hint">Ingen krav valgt ennå.</p>
                    }
                    else
                    {
                        <div class="pakke-grunndata">
                            @foreach (var rad in FormGrunndata())
                            {
                                <div class="pakke-grunndata-rad">
                                    <span class="pakke-grunndata-ikon"><Icon Name="@rad.Ikon" /></span>
                                    <span class="pakke-grunndata-label">@rad.Label</span>
                                    <span class="pakke-grunndata-pille">@rad.Verdi</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="kort pakke-sidepanel">
                    <h2>Beskrivelse</h2>
                    @if (!string.IsNullOrWhiteSpace(_form.Beskrivelse))
                    {
                        <p class="pakke-beskrivelse-visning">@_form.Beskrivelse</p>
                    }
                    else
                    {
                        <p class="component-empty-hint">Ingen beskrivelse lagt til ennå.</p>
                    }

                    <h2>Bruksområde</h2>
                    @if (FormBruksomrader().Length == 0)
                    {
                        <p class="component-empty-hint">Ingen bruksområder lagt til ennå.</p>
                    }
                    else
                    {
                        <ul class="pakke-bruksomrade-liste">
                            @foreach (var sted in FormBruksomrader())
                            {
                                <li>@sted</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="kort pakke-snarveier">
                <h2>Snarveier</h2>
                @if (!string.IsNullOrEmpty(_delMelding))
                {
                    <p class="save-success">@_delMelding</p>
                }
                <div class="pakke-snarveier-rad">
                    <button type="button" class="snarvei-knapp" @onclick="KopierDorpakke">
                        <Icon Name="box" />Kopier dørpakke
                    </button>
                    <a class="snarvei-knapp" href="@($"/dorpakke/{Id}/pdf")" target="_blank">
                        <Icon Name="file-text" />Eksporter til PDF
                    </a>
                    <button type="button" class="snarvei-knapp" @onclick="DelDorpakke">
                        <Icon Name="upload" />Del dørpakke
                    </button>
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Skriv SLETT for å bekrefte.
                            <input @bind="_slettBekreftelseTekst" @bind:event="oninput" placeholder="SLETT" class="kode-input" />
                            <button type="button" class="delete-confirm-button" disabled="@(_slettBekreftelseTekst != "SLETT")" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => { _confirmingDelete = false; _slettBekreftelseTekst = ""; })">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="snarvei-knapp snarvei-knapp-farlig" @onclick="@(() => _confirmingDelete = true)">
                            <Icon Name="trash" />Slett dørpakke
                        </button>
                    }
                </div>
            </div>
        }
    }

    @if (!Id.HasValue || _fane == "komponenter")
    {
        <div class="kort ny-pakke-komponenter">
            <h2>Komponenter</h2>

            @if (_redigerer || !Id.HasValue)
            {
                @if (_components.Count > 0)
                {
                    <div class="komponent-kort-table">
                        <table class="component-table">
                            <thead>
                                <tr>
                                    <th>Komponenttype</th>
                                    <th>Navn</th>
                                    <th>Produsent</th>
                                    <th>Antall</th>
                                    <th>Enhet</th>
                                    <th>Levert av</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _components)
                                {
                                    <tr>
                                        <td>@ComponentTypeName(c.ComponentTypeId)</td>
                                        <td>@c.Navn</td>
                                        <td>@c.Produsent</td>
                                        <td>
                                            <input type="number" min="1" class="antall-input" @bind="c.Antall" />
                                        </td>
                                        <td>@(c.Enhet ?? "Stk")</td>
                                        <td>
                                            <select @bind="c.LevertAv" title="F = vi leverer og priser. Ld = leveres komplett av dørprodusent. Le = leveres komplett av elektro.">
                                                <option value="@LevertAv.F">F</option>
                                                <option value="@LevertAv.Ld">Ld</option>
                                                <option value="@LevertAv.Le">Le</option>
                                            </select>
                                        </td>
                                        <td>
                                            <button type="button" class="remove-button" @onclick="@(() => _components.Remove(c))">
                                                Fjern
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="component-empty">Ingen komponenter lagt til ennå.</p>
                }

                <div class="component-search sok-wrap">
                    <label>
                        Søk i komponentregister (aktive varer)
                        <input @bind="_componentSearch" @bind:event="oninput" @bind:after="OnComponentSearchChanged"
                               placeholder="Søk på navn, leverandør eller produktkode" />
                    </label>
                    @if (_searchResults.Count > 0)
                    {
                        <ul class="search-results">
                            @foreach (var r in _searchResults)
                            {
                                <li>
                                    <button type="button" class="search-result" @onclick="@(() => AddFromSearch(r))">
                                        <span class="search-result-name">@r.Navn</span>
                                        <span class="search-result-meta">
                                            @r.TypeName
                                            @if (!string.IsNullOrEmpty(r.Leverandor))
                                            {
                                                <text> · @r.Leverandor</text>
                                            }
                                            @if (!string.IsNullOrEmpty(r.Produktkode))
                                            {
                                                <text> · @r.Produktkode</text>
                                            }
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else if (_componentSearch.Trim().Length >= 2)
                    {
                        <p class="search-empty">Ingen aktive komponenter matcher søket.</p>
                    }
                </div>

                <details class="component-manual">
                    <summary>Eller legg inn manuelt</summary>
                    <div class="component-add">
                        <label>
                            Komponenttype
                            <select @bind="_draft.ComponentTypeId">
                                @foreach (var type in _componentTypes)
                                {
                                    <option value="@type.Id">@type.Navn</option>
                                }
                            </select>
                        </label>
                        <label>
                            Navn
                            <input @bind="_draft.Navn" placeholder="F.eks. Assa 431" />
                        </label>
                        <label>
                            Produsent (valgfritt)
                            <input @bind="_draft.Produsent" />
                        </label>
                        <label>
                            Produktkode (valgfritt)
                            <input @bind="_draft.Produktkode" />
                        </label>
                        <label class="antall-field">
                            Antall
                            <input type="number" min="1" @bind="_draft.Antall" />
                        </label>
                        <label>
                            Enhet
                            <select @bind="_draft.Enhet">
                                <option value="">Ikke satt</option>
                                <option value="Stk">Stk</option>
                                <option value="Sett">Sett</option>
                                <option value="Par">Par</option>
                                <option value="M">M</option>
                            </select>
                        </label>
                        <label>
                            Levert av
                            <select @bind="_draft.LevertAv">
                                <option value="@LevertAv.F">F</option>
                                <option value="@LevertAv.Ld">Ld</option>
                                <option value="@LevertAv.Le">Le</option>
                            </select>
                        </label>
                        <button type="button" class="knapp knapp-primaer" @onclick="AddComponent">Legg til komponent</button>
                    </div>
                </details>
            }
            else if (_components.Count == 0)
            {
                <p class="component-empty">Ingen komponenter lagt til ennå.</p>
            }
            else
            {
                <div class="pakke-komponent-liste">
                    @foreach (var c in _components.OrderBy(c => c.Navn))
                    {
                        <div class="pakke-komponent-rad">
                            <span class="pakke-komponent-ikon"><Icon Name="box" /></span>
                            <span class="pakke-komponent-navn">@c.Navn</span>
                            <span class="pakke-komponent-type">@ComponentTypeName(c.ComponentTypeId)</span>
                            <span class="pakke-komponent-antall">@c.Antall</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!Id.HasValue || _fane == "krav")
    {
        <div class="kort ny-pakke-krav">
            <h2>Krav pakken oppfyller</h2>
            @if (_redigerer || !Id.HasValue)
            {
                <RequirementSelector Dimensions="_dimensions"
                                      SelectedValueIds="_selectedValueIds"
                                      SelectedValueIdsChanged="OnSelectionChanged" />
            }
            else if (_selectedValueIds.Count == 0)
            {
                <p class="component-empty-hint">Ingen krav valgt ennå.</p>
            }
            else
            {
                @foreach (var dim in _dimensions)
                {
                    var verdier = dim.Verdier.Where(v => _selectedValueIds.Contains(v.Id)).ToList();
                    if (verdier.Count > 0)
                    {
                        <div class="pakke-krav-dimensjon">
                            <span class="pakke-krav-dimensjon-navn">@dim.Navn</span>
                            <div class="pakke-krav-pille-rad">
                                @foreach (var v in verdier)
                                {
                                    <span class="pakke-krav-pille"><Icon Name="check" />@v.Verdi</span>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>

        @if (_redigerer || !Id.HasValue)
        {
            <div class="kort ny-pakke-funksjoner">
                <h2>Dørfunksjoner</h2>
                <p class="component-empty-hint">Dørfunksjonene som velges her følger med automatisk når pakken legges til på en dør.</p>
                <div class="funksjon-legg-til">
                    <select @bind="_valgtFunksjonId">
                        <option value="">Velg funksjon...</option>
                        @foreach (var f in _ledigeFunksjoner)
                        {
                            <option value="@f.Id">@f.Navn</option>
                        }
                    </select>
                    <button type="button" class="knapp knapp-primaer" @onclick="LeggTilFunksjon" disabled="@(_valgtFunksjonId is null)">Legg til</button>
                </div>
                @if (_valgteFunksjoner.Count > 0)
                {
                    <ul class="funksjon-chip-list">
                        @foreach (var f in _valgteFunksjoner)
                        {
                            <li @key="f.Id" class="funksjon-chip">
                                @f.Navn
                                <button type="button" @onclick="@(() => FjernFunksjon(f))">&times;</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        else if (_valgteFunksjoner.Count > 0)
        {
            <div class="kort ny-pakke-funksjoner">
                <h2>Dørfunksjoner</h2>
                <ul class="funksjon-chip-list funksjon-chip-list-visning">
                    @foreach (var f in _valgteFunksjoner)
                    {
                        <li @key="f.Id" class="funksjon-chip funksjon-chip-visning">@f.Navn</li>
                    }
                </ul>
            </div>
        }
    }

    @if (Id.HasValue && _fane == "dokumentasjon")
    {
        <div class="kort pakke-kort-seksjon">
            <h2>Dokumentasjon</h2>
            <p class="component-empty-hint">Ingen dokumenter lastet opp for denne pakken ennå.</p>
        </div>
    }

    @if (Id.HasValue && _fane == "historikk")
    {
        <div class="kort pakke-kort-seksjon">
            <h2>Historikk</h2>
            <div class="pakke-historikk-rad">
                <span class="pakke-historikk-ikon"><Icon Name="box" /></span>
                <span class="pakke-historikk-tekst">
                    <span class="pakke-historikk-tittel">Pakke opprettet</span>
                    <span class="pakke-historikk-sub">@_opprettetDato.ToString("dd.MM.yyyy")</span>
                </span>
            </div>
        </div>
    }

    @if (!Id.HasValue || _redigerer)
    {
        <div class="form-actions">
            <button type="button" class="knapp knapp-primaer" @onclick="SavePackage">
                @(Id.HasValue ? "Lagre endringer" : "Lagre pakke")
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private sealed class PackageFormModel
    {
        public string Navn { get; set; } = "";
        public string? Beskrivelse { get; set; }
        public string? Bruksomrade { get; set; }
    }

    private sealed class ComponentDraft
    {
        public int? ExistingComponentId { get; set; }
        public int ComponentTypeId { get; set; }
        public string Navn { get; set; } = "";
        public string? Produsent { get; set; }
        public string? Produktkode { get; set; }
        public int Antall { get; set; } = 1;
        public string? Enhet { get; set; }
        public LevertAv LevertAv { get; set; } = LevertAv.F;
        public decimal? PrisNetto { get; set; }
    }

    private sealed class SearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string TypeName { get; set; } = "";
        public int? ComponentTypeId { get; set; }
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
        public string? Enhet { get; set; }
        public decimal? PrisNetto { get; set; }
    }

    private readonly PackageFormModel _form = new();
    private ComponentDraft _draft = new();
    private List<RequirementDimension> _dimensions = [];
    private List<RequirementValue> _alleVerdier = [];
    private List<ComponentType> _componentTypes = [];
    private HashSet<int> _selectedValueIds = [];
    private List<ComponentDraft> _components = [];
    private string? _error;
    private string? _savedMessage;
    private bool _confirmingDelete;
    private string _slettBekreftelseTekst = "";
    private bool _notFound;
    private int? _loadedId;
    private string _componentSearch = "";
    private List<SearchResult> _searchResults = [];
    private List<DorFunksjon> _alleFunksjoner = [];
    private List<DorFunksjon> _valgteFunksjoner = [];
    private int? _valgtFunksjonId;
    private string _fane = "oversikt";
    private bool _redigerer;
    private DateTime _opprettetDato;
    private int _valgtBildeIndex;
    private string? _delMelding;

    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("pakke-bredde", "normal") == "full";
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("pakke-bredde", _full ? "full" : "normal");
    }

    // ✎ på en flis: start redigering og gå til fanen der det som skal endres ligger.
    private void StartRedigering(string? fane)
    {
        _redigerer = true;
        _savedMessage = null;
        if (fane is not null)
        {
            _fane = fane;
        }
    }

    // Forkaster endringene ved å laste pakken på nytt fra databasen.
    private async Task AvbrytRedigering()
    {
        _redigerer = false;
        _error = null;
        _componentSearch = "";
        _searchResults = [];
        if (Id.HasValue)
        {
            await LoadPackageAsync(Id.Value);
        }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    private decimal SumVi() => _components.Where(c => c.LevertAv == LevertAv.F).Sum(c => (c.PrisNetto ?? 0) * c.Antall);

    private static string LevertAvTekst(LevertAv levertAv) => levertAv switch
    {
        LevertAv.Ld => "Dørprodusent",
        LevertAv.Le => "Elektro",
        _ => "Vi leverer"
    };

    private List<DorFunksjon> _ledigeFunksjoner =>
        _alleFunksjoner.Where(f => _valgteFunksjoner.All(vf => vf.Id != f.Id)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_dimensions.Count == 0 || _componentTypes.Count == 0)
        {
            await LoadReferenceDataAsync();
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;
        _redigerer = false;
        _fane = "oversikt";
        _valgtBildeIndex = 0;
        _delMelding = null;

        if (Id.HasValue)
        {
            await LoadPackageAsync(Id.Value);
        }
        else
        {
            ResetForm();
        }
    }

    private async Task LoadReferenceDataAsync()
    {
        _dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _alleVerdier = _dimensions.SelectMany(d => d.Verdier).ToList();

        _componentTypes = await Db.ComponentTypes
            .OrderBy(t => t.Sortering).ThenBy(t => t.Navn)
            .ToListAsync();

        _alleFunksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .ToListAsync();
    }

    private async Task LoadPackageAsync(int id)
    {
        var package = await Db.Packages
            .Include(p => p.Krav)
            .Include(p => p.Komponenter)
                .ThenInclude(pc => pc.Component)
            .Include(p => p.DorFunksjoner)
            .FirstOrDefaultAsync(p => p.Id == id);

        if (package is null)
        {
            _notFound = true;
            return;
        }

        _form.Navn = package.Navn;
        _form.Beskrivelse = package.Beskrivelse;
        _form.Bruksomrade = package.Bruksomrade;
        _opprettetDato = package.OpprettetDato;
        _selectedValueIds = package.Krav.Select(k => k.RequirementValueId).ToHashSet();
        _valgteFunksjoner = package.DorFunksjoner.OrderBy(f => f.Navn).ToList();
        _components = package.Komponenter.Select(pc => new ComponentDraft
        {
            ExistingComponentId = pc.ComponentId,
            ComponentTypeId = pc.Component!.ComponentTypeId ?? 0,
            Navn = pc.Component.Navn,
            Produsent = pc.Component.Produsent,
            Produktkode = pc.Component.Produktkode,
            Enhet = pc.Component.Enhet,
            Antall = pc.Antall,
            LevertAv = pc.LevertAv ?? LevertAv.F,
            PrisNetto = pc.Component.PrisNetto
        }).ToList();
        _draft = new ComponentDraft { ComponentTypeId = _componentTypes.FirstOrDefault()?.Id ?? 0 };
    }

    private void ResetForm()
    {
        _form.Navn = "";
        _form.Beskrivelse = null;
        _form.Bruksomrade = null;
        _selectedValueIds = [];
        _components = [];
        _draft = new ComponentDraft { ComponentTypeId = _componentTypes.FirstOrDefault()?.Id ?? 0 };
        _componentSearch = "";
        _searchResults = [];
        _valgteFunksjoner = [];
        _valgtFunksjonId = null;
    }

    private void LeggTilFunksjon()
    {
        if (_valgtFunksjonId is null)
        {
            return;
        }

        var funksjon = _alleFunksjoner.FirstOrDefault(f => f.Id == _valgtFunksjonId);
        if (funksjon is not null && _valgteFunksjoner.All(f => f.Id != funksjon.Id))
        {
            _valgteFunksjoner.Add(funksjon);
        }

        _valgtFunksjonId = null;
    }

    private void FjernFunksjon(DorFunksjon funksjon)
    {
        _valgteFunksjoner.Remove(funksjon);
    }

    private Task OnSelectionChanged(HashSet<int> selected)
    {
        _selectedValueIds = selected;
        return Task.CompletedTask;
    }

    private List<GrunndataRad> FormGrunndata() =>
        PakkeVisningHjelper.Grunndata(new Package
        {
            Navn = _form.Navn,
            Krav = _selectedValueIds.Select(id => new PackageRequirement { RequirementValue = _alleVerdier.FirstOrDefault(v => v.Id == id) }).ToList()
        });

    private string? FormAntallFloyer() =>
        _selectedValueIds
            .Select(id => _alleVerdier.FirstOrDefault(v => v.Id == id))
            .FirstOrDefault(v => v?.RequirementDimensionId == 6)
            ?.Verdi;

    private string[] FormBruksomrader() =>
        (_form.Bruksomrade ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string ComponentTypeName(int id) =>
        id == 0 ? "Ikke satt" : _componentTypes.FirstOrDefault(t => t.Id == id)?.Navn ?? "?";

    private async Task OnComponentSearchChanged()
    {
        var term = _componentSearch.Trim();
        if (term.Length < 2)
        {
            _searchResults = [];
            return;
        }

        _searchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .Include(c => c.Type)
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult
            {
                Id = c.Id,
                Navn = c.Navn,
                TypeName = c.Type != null ? c.Type.Navn : "Ikke satt",
                ComponentTypeId = c.ComponentTypeId,
                Leverandor = c.Leverandor,
                Produktkode = c.Produktkode,
                Enhet = c.Enhet,
                PrisNetto = c.PrisNetto
            })
            .ToListAsync();
    }

    private void AddFromSearch(SearchResult r)
    {
        _components.Add(new ComponentDraft
        {
            ExistingComponentId = r.Id,
            ComponentTypeId = r.ComponentTypeId ?? 0,
            Navn = r.Navn,
            Produsent = r.Leverandor,
            Produktkode = r.Produktkode,
            Enhet = r.Enhet,
            Antall = 1,
            PrisNetto = r.PrisNetto
        });

        _componentSearch = "";
        _searchResults = [];
        _error = null;
    }

    private void AddComponent()
    {
        if (_draft.ComponentTypeId == 0 || string.IsNullOrWhiteSpace(_draft.Navn))
        {
            _error = "Velg komponenttype og skriv inn et navn før du legger til komponenten.";
            return;
        }

        _error = null;
        _components.Add(_draft);
        _draft = new ComponentDraft { ComponentTypeId = _draft.ComponentTypeId };
    }

    private async Task SavePackage()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Pakken må ha et navn.";
            return;
        }

        if (_components.Count == 0)
        {
            _error = "Legg til minst én komponent før du lagrer.";
            return;
        }

        _error = null;

        Package package;
        if (Id.HasValue)
        {
            package = await Db.Packages
                .Include(p => p.Krav)
                .Include(p => p.Komponenter)
                .Include(p => p.DorFunksjoner)
                .FirstAsync(p => p.Id == Id.Value);

            Db.PackageRequirements.RemoveRange(package.Krav);
            Db.PackageComponents.RemoveRange(package.Komponenter);
            package.Krav.Clear();
            package.Komponenter.Clear();
            package.DorFunksjoner.Clear();
        }
        else
        {
            package = new Package { Navn = "", ErManuell = true };
            Db.Packages.Add(package);
        }

        package.Navn = _form.Navn.Trim();
        package.Beskrivelse = string.IsNullOrWhiteSpace(_form.Beskrivelse) ? null : _form.Beskrivelse.Trim();
        package.Bruksomrade = string.IsNullOrWhiteSpace(_form.Bruksomrade) ? null : _form.Bruksomrade.Trim();

        foreach (var valueId in _selectedValueIds)
        {
            package.Krav.Add(new PackageRequirement { RequirementValueId = valueId });
        }

        // Ett samlet oppslag i stedet for ett DB-kall per valgt funksjon
        // (N+1-mønster, se CODE_REVIEW.md 2026-10-08). Where+Contains
        // garanterer ikke samme rekkefølge som _valgteFunksjoner, så vi
        // sorterer eksplisitt tilbake til valgt rekkefølge for å bevare
        // nøyaktig samme oppførsel som før.
        var funksjonIder = _valgteFunksjoner.Select(f => f.Id).ToList();
        var funksjonerPerId = (await Db.DorFunksjoner.Where(f => funksjonIder.Contains(f.Id)).ToListAsync())
            .ToDictionary(f => f.Id);
        foreach (var id in funksjonIder)
        {
            package.DorFunksjoner.Add(funksjonerPerId[id]);
        }

        foreach (var draft in _components)
        {
            Component component;

            if (draft.ExistingComponentId.HasValue)
            {
                component = await Db.Components.FirstAsync(c => c.Id == draft.ExistingComponentId.Value);
            }
            else
            {
                var navn = draft.Navn.Trim();

                var found = await Db.Components.FirstOrDefaultAsync(c =>
                    c.ComponentTypeId == draft.ComponentTypeId && c.Navn == navn);

                component = found ?? new Component
                {
                    ComponentTypeId = draft.ComponentTypeId,
                    Navn = navn,
                    Produsent = string.IsNullOrWhiteSpace(draft.Produsent) ? null : draft.Produsent.Trim(),
                    Produktkode = string.IsNullOrWhiteSpace(draft.Produktkode) ? null : draft.Produktkode.Trim(),
                    Enhet = string.IsNullOrWhiteSpace(draft.Enhet) ? null : draft.Enhet
                };

                if (found is null)
                {
                    Db.Components.Add(component);
                }
            }

            package.Komponenter.Add(new PackageComponent
            {
                Component = component,
                Antall = draft.Antall,
                LevertAv = draft.LevertAv
            });
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Pakken \"{package.Navn}\" er oppdatert.";
            _redigerer = false;
            _opprettetDato = package.OpprettetDato;
        }
        else
        {
            _savedMessage = $"Pakken \"{package.Navn}\" er lagret.";
            ResetForm();
            await LoadReferenceDataAsync();
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var package = await Db.Packages.FirstOrDefaultAsync(p => p.Id == Id.Value);
        if (package is not null)
        {
            Db.Packages.Remove(package);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/finn-dorpakke");
    }

    private async Task KopierDorpakke()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var original = await Db.Packages
            .Include(p => p.Krav)
            .Include(p => p.Komponenter)
            .Include(p => p.DorFunksjoner)
            .FirstAsync(p => p.Id == Id.Value);

        var kopi = new Package
        {
            Navn = $"{original.Navn} (kopi)",
            Beskrivelse = original.Beskrivelse,
            Bruksomrade = original.Bruksomrade,
            ErManuell = true
        };

        foreach (var k in original.Krav)
        {
            kopi.Krav.Add(new PackageRequirement { RequirementValueId = k.RequirementValueId });
        }

        foreach (var k in original.Komponenter)
        {
            kopi.Komponenter.Add(new PackageComponent { ComponentId = k.ComponentId, Antall = k.Antall, LevertAv = k.LevertAv });
        }

        foreach (var f in original.DorFunksjoner)
        {
            kopi.DorFunksjoner.Add(f);
        }

        Db.Packages.Add(kopi);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/rediger-pakke/{kopi.Id}");
    }

    private async Task DelDorpakke()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri);
        _delMelding = "Lenke kopiert til utklippstavlen.";
    }
}
