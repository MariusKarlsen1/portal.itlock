@page "/ny-pakke"
@page "/rediger-pakke/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Rediger pakke" : "Ny pakke")</PageTitle>

<h1>@(Id.HasValue ? "Rediger pakke" : "Ny pakke")</h1>
<p>
    @(Id.HasValue
        ? "Endre navn, krav eller komponenter, og lagre endringene."
        : "Sett sammen en dørpakke manuelt: gi den et navn, huk av hvilke krav den oppfyller, og legg til komponentene den består av.")
</p>

@if (_notFound)
{
    <p class="form-error">Fant ikke pakken. Den kan være slettet.</p>
}
else
{
    <div class="ny-pakke-layout">
        <div class="ny-pakke-info">
            <label>
                Navn på pakke
                <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Innerdør EI30 RC2" />
            </label>
            <label>
                Beskrivelse (valgfritt)
                <textarea @bind="_form.Beskrivelse" rows="3"></textarea>
            </label>
        </div>

        <div class="ny-pakke-krav">
            <h2>Krav pakken oppfyller</h2>
            <RequirementSelector Dimensions="_dimensions"
                                  SelectedValueIds="_selectedValueIds"
                                  SelectedValueIdsChanged="OnSelectionChanged" />
        </div>

        <div class="ny-pakke-komponenter">
            <h2>Komponenter</h2>

            @if (_components.Count > 0)
            {
                <table class="component-table">
                    <thead>
                        <tr>
                            <th>Komponenttype</th>
                            <th>Navn</th>
                            <th>Produsent</th>
                            <th>Antall</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _components)
                        {
                            <tr>
                                <td>@ComponentTypeName(c.ComponentTypeId)</td>
                                <td>@c.Navn</td>
                                <td>@c.Produsent</td>
                                <td>@c.Antall</td>
                                <td>
                                    <button type="button" class="remove-button" @onclick="@(() => _components.Remove(c))">
                                        Fjern
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="component-empty">Ingen komponenter lagt til ennå.</p>
            }

            <div class="component-add">
                <label>
                    Komponenttype
                    <select @bind="_draft.ComponentTypeId">
                        @foreach (var type in _componentTypes)
                        {
                            <option value="@type.Id">@type.Navn</option>
                        }
                    </select>
                </label>
                <label>
                    Navn
                    <input @bind="_draft.Navn" placeholder="F.eks. Assa 431" />
                </label>
                <label>
                    Produsent (valgfritt)
                    <input @bind="_draft.Produsent" />
                </label>
                <label>
                    Produktkode (valgfritt)
                    <input @bind="_draft.Produktkode" />
                </label>
                <label class="antall-field">
                    Antall
                    <input type="number" min="1" @bind="_draft.Antall" />
                </label>
                <button type="button" class="add-button" @onclick="AddComponent">Legg til komponent</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error">@_error</p>
        }

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="save-success">@_savedMessage</p>
        }

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="SavePackage">
                @(Id.HasValue ? "Lagre endringer" : "Lagre pakke")
            </button>

            @if (Id.HasValue)
            {
                @if (_confirmingDelete)
                {
                    <span class="delete-confirm">
                        Er du sikker?
                        <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                        <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    </span>
                }
                else
                {
                    <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">
                        Slett pakke
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private sealed class PackageFormModel
    {
        public string Navn { get; set; } = "";
        public string? Beskrivelse { get; set; }
    }

    private sealed class ComponentDraft
    {
        public int ComponentTypeId { get; set; }
        public string Navn { get; set; } = "";
        public string? Produsent { get; set; }
        public string? Produktkode { get; set; }
        public int Antall { get; set; } = 1;
    }

    private readonly PackageFormModel _form = new();
    private ComponentDraft _draft = new();
    private List<RequirementDimension> _dimensions = [];
    private List<ComponentType> _componentTypes = [];
    private HashSet<int> _selectedValueIds = [];
    private List<ComponentDraft> _components = [];
    private string? _error;
    private string? _savedMessage;
    private bool _confirmingDelete;
    private bool _notFound;
    private int? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (_dimensions.Count == 0 || _componentTypes.Count == 0)
        {
            await LoadReferenceDataAsync();
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;

        if (Id.HasValue)
        {
            await LoadPackageAsync(Id.Value);
        }
        else
        {
            ResetForm();
        }
    }

    private async Task LoadReferenceDataAsync()
    {
        _dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _componentTypes = await Db.ComponentTypes
            .OrderBy(t => t.Navn)
            .ToListAsync();
    }

    private async Task LoadPackageAsync(int id)
    {
        var package = await Db.Packages
            .Include(p => p.Krav)
            .Include(p => p.Komponenter)
                .ThenInclude(pc => pc.Component)
            .FirstOrDefaultAsync(p => p.Id == id);

        if (package is null)
        {
            _notFound = true;
            return;
        }

        _form.Navn = package.Navn;
        _form.Beskrivelse = package.Beskrivelse;
        _selectedValueIds = package.Krav.Select(k => k.RequirementValueId).ToHashSet();
        _components = package.Komponenter.Select(pc => new ComponentDraft
        {
            ComponentTypeId = pc.Component!.ComponentTypeId,
            Navn = pc.Component.Navn,
            Produsent = pc.Component.Produsent,
            Produktkode = pc.Component.Produktkode,
            Antall = pc.Antall
        }).ToList();
        _draft = new ComponentDraft { ComponentTypeId = _componentTypes.FirstOrDefault()?.Id ?? 0 };
    }

    private void ResetForm()
    {
        _form.Navn = "";
        _form.Beskrivelse = null;
        _selectedValueIds = [];
        _components = [];
        _draft = new ComponentDraft { ComponentTypeId = _componentTypes.FirstOrDefault()?.Id ?? 0 };
    }

    private Task OnSelectionChanged(HashSet<int> selected)
    {
        _selectedValueIds = selected;
        return Task.CompletedTask;
    }

    private string ComponentTypeName(int id) =>
        _componentTypes.FirstOrDefault(t => t.Id == id)?.Navn ?? "?";

    private void AddComponent()
    {
        if (_draft.ComponentTypeId == 0 || string.IsNullOrWhiteSpace(_draft.Navn))
        {
            _error = "Velg komponenttype og skriv inn et navn før du legger til komponenten.";
            return;
        }

        _error = null;
        _components.Add(_draft);
        _draft = new ComponentDraft { ComponentTypeId = _draft.ComponentTypeId };
    }

    private async Task SavePackage()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Pakken må ha et navn.";
            return;
        }

        if (_components.Count == 0)
        {
            _error = "Legg til minst én komponent før du lagrer.";
            return;
        }

        _error = null;

        Package package;
        if (Id.HasValue)
        {
            package = await Db.Packages
                .Include(p => p.Krav)
                .Include(p => p.Komponenter)
                .FirstAsync(p => p.Id == Id.Value);

            Db.PackageRequirements.RemoveRange(package.Krav);
            Db.PackageComponents.RemoveRange(package.Komponenter);
            package.Krav.Clear();
            package.Komponenter.Clear();
        }
        else
        {
            package = new Package { Navn = "", ErManuell = true };
            Db.Packages.Add(package);
        }

        package.Navn = _form.Navn.Trim();
        package.Beskrivelse = string.IsNullOrWhiteSpace(_form.Beskrivelse) ? null : _form.Beskrivelse.Trim();

        foreach (var valueId in _selectedValueIds)
        {
            package.Krav.Add(new PackageRequirement { RequirementValueId = valueId });
        }

        foreach (var draft in _components)
        {
            var navn = draft.Navn.Trim();

            var component = await Db.Components.FirstOrDefaultAsync(c =>
                c.ComponentTypeId == draft.ComponentTypeId && c.Navn == navn);

            if (component is null)
            {
                component = new Component
                {
                    ComponentTypeId = draft.ComponentTypeId,
                    Navn = navn,
                    Produsent = string.IsNullOrWhiteSpace(draft.Produsent) ? null : draft.Produsent.Trim(),
                    Produktkode = string.IsNullOrWhiteSpace(draft.Produktkode) ? null : draft.Produktkode.Trim()
                };
                Db.Components.Add(component);
            }

            package.Komponenter.Add(new PackageComponent
            {
                Component = component,
                Antall = draft.Antall
            });
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Pakken \"{package.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Pakken \"{package.Navn}\" er lagret.";
            ResetForm();
            await LoadReferenceDataAsync();
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var package = await Db.Packages.FirstOrDefaultAsync(p => p.Id == Id.Value);
        if (package is not null)
        {
            Db.Packages.Remove(package);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/finn-dorpakke");
    }
}
