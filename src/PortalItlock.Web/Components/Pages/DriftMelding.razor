@page "/drift/melding/{Id:int}"
@layout PortalItlock.Web.Components.Layout.DriftLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Driftslisens")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ITenantContext TenantCtx
@inject IJSRuntime JS

<PageTitle>Driftsmelding - Full Kontroll</PageTitle>

@if (_ikkeTilgang)
{
    <p class="dp-feil">Fant ikke meldingen, eller du har ikke tilgang til den.</p>
    <a class="dp-tilbake" href="/drift/meldinger"><Icon Name="arrow-left" />Meldinger</a>
}
else if (_s is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    var m = _s.Melding;

    @if (Ny)
    {
        <div class="dp-kvittering">
            <div class="dp-hake"><Icon Name="check" /></div>
            <h1>Takk, @DriftHelper.Fornavn(m.InnmeldtAvBruker?.Navn ?? "")!</h1>
            <p>Meldingen er sendt til @Firmanavn. Du ser her når noe skjer med den.</p>
        </div>
    }
    else
    {
        <a class="dp-tilbake" href="/drift/meldinger"><Icon Name="arrow-left" />Meldinger</a>
    }

    <div class="dp-to-kol">
        <div class="dp-kol">
            <div class="dp-kort dp-sak">
                <div class="dp-sak-t">
                    <div>
                        <b>Dør @m.Dor?.Dornummer – @(m.Kategori ?? m.Tittel ?? "Driftsmelding")</b>
                        <small>@m.Dor?.Prosjekt?.Navn · meldt @DriftHelper.Siden(m.OpprettetDato)@(m.InnmeldtAvBruker is null ? "" : $" av {m.InnmeldtAvBruker.Navn}")</small>
                    </div>
                    <span class="dp-tag dp-t-@_s.Farge">@_s.Navn</span>
                </div>

                <div class="dp-steg">
                    <div class="dp-st ferdig">
                        <span class="dp-p"><Icon Name="check" /></span>
                        <div><b>Sendt</b><small>@DriftHelper.Dag(m.OpprettetDato)</small></div>
                    </div>
                    <div class="dp-st @Klasse(DriftHelper.Steg.Lest)">
                        <span class="dp-p">@if (_s.Steg >= DriftHelper.Steg.Lest) {<Icon Name="check" />}</span>
                        <div><b>Mottatt av @Firmanavn</b><small>@(m.LestDato is { } l ? DriftHelper.Dag(l) : _s.Steg >= DriftHelper.Steg.Lest ? "Lest" : "Venter på at vi åpner den")</small></div>
                    </div>
                    <div class="dp-st @Klasse(DriftHelper.Steg.UnderArbeid)">
                        <span class="dp-p">@if (_s.Steg == DriftHelper.Steg.Lost) {<Icon Name="check" />}</span>
                        <div><b>@(_s.Planlagt is not null ? "Montør planlagt" : "Under arbeid")</b><small>@(_s.Steg >= DriftHelper.Steg.UnderArbeid && _s.Planlagt is { } p ? $"{(_s.Montor is null ? "Montør" : _s.Montor)} kommer {DriftHelper.Dag(p)}" : _s.Steg >= DriftHelper.Steg.UnderArbeid ? "Vi jobber med saken" : "Du får beskjed her")</small></div>
                    </div>
                    <div class="dp-st @(_s.Steg == DriftHelper.Steg.Lost ? "ferdig" : "")">
                        <span class="dp-p">@if (_s.Steg == DriftHelper.Steg.Lost) {<Icon Name="check" />}</span>
                        <div><b>Løst</b><small>@(_s.LostDato is { } d ? DriftHelper.Dag(d) : "Du ser det her når saken er ferdig")</small></div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_s.Ticket?.Sluttoppsummering) && _s.Steg == DriftHelper.Steg.Lost)
                {
                    <div class="dp-svar">
                        <div class="dp-svar-t"><i>@Initialer(_s.Montor ?? Firmanavn)</i>Hva vi gjorde</div>
                        @_s.Ticket!.Sluttoppsummering
                    </div>
                }

                @foreach (var h in _svar)
                {
                    <div class="dp-svar" @key="h.Id">
                        <div class="dp-svar-t"><i>@Initialer(h.UtfortAvBruker?.Navn ?? Firmanavn)</i>@(h.UtfortAvBruker?.Navn ?? Firmanavn)<span>· @DriftHelper.Siden(h.Tidspunkt)</span></div>
                        @h.Beskrivelse
                    </div>
                }
            </div>
        </div>

        <div class="dp-kol">
            <div class="dp-kort dp-sak">
                <div class="dp-sak-t">
                    <b style="font-size:1rem">Det du meldte inn</b>
                    @if (m.Haster)
                    {
                        <span class="dp-tag dp-t-rod"><Icon Name="alert-triangle" />Haster</span>
                    }
                </div>
                <p class="dp-sitat">@m.Tekst</p>
                @if (m.Media.Count > 0)
                {
                    <div class="dp-media">
                        @foreach (var media in m.Media)
                        {
                            @if (media.ContentType.StartsWith("video/"))
                            {
                                <video controls src="@($"/driftsmeldingmedia/{media.Id}/fil")"></video>
                            }
                            else
                            {
                                <a href="@($"/driftsmeldingmedia/{media.Id}/fil")" target="_blank">
                                    <img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="@media.Filnavn" />
                                </a>
                            }
                        }
                    </div>
                }
                <a class="dp-knapp" href="@($"/drift/dor/{m.DorId}")"><Icon Name="door" />Gå til døren</a>
            </div>
            @if (Ny)
            {
                <a class="dp-knapp" href="/drift"><Icon Name="home" />Til forsiden</a>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "ny")] public int? NyParam { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private DriftHelper.MeldingStatus? _s;
    private List<TicketHendelse> _svar = [];
    private bool _ikkeTilgang;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Kvitteringen skal vises fra toppen, ikke der innmeldingsskjemaet var rullet til.
        if (firstRender && Ny)
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private bool Ny => NyParam == 1;
    private string Firmanavn => TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn ?? "oss";

    // Steget som er ferdig får hake, steget vi venter på får en rød prikk.
    private string Klasse(DriftHelper.Steg steg) => steg switch
    {
        DriftHelper.Steg.Lest => _s!.Steg >= DriftHelper.Steg.Lest ? "ferdig" : "na",
        _ => _s!.Steg == DriftHelper.Steg.Lost ? "ferdig" : _s.Steg >= DriftHelper.Steg.Lest ? "na" : ""
    };

    private static string Initialer(string navn) => string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            _ikkeTilgang = true;
            return;
        }

        var bygg = DriftHelper.MineBygg(Db, brukerId);
        var treff = await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger
            .Include(m => m.Media)
            .Where(m => m.Id == Id && bygg.Any(p => p.Id == m.Dor!.ProsjektId)));

        _s = treff.FirstOrDefault();
        if (_s is null)
        {
            _ikkeTilgang = true;
            return;
        }

        // Det firmaet har skrevet på ticketen og merket som synlig for kunden.
        if (_s.Ticket is { } t)
        {
            _svar = await Db.TicketHendelser
                .Include(h => h.UtfortAvBruker)
                .AsNoTracking()
                .Where(h => h.TicketId == t.Id && h.ErKundeSynlig)
                .OrderBy(h => h.Tidspunkt)
                .ToListAsync();
        }
    }
}
