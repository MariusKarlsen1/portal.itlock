@page "/prosjekt/{Id:int}/produktsammendrag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProduktsammendragPdfService PdfService
@inject LagretPdfService LagretPdfService
@inject VisningPreferanseService VisningPref

<PageTitle>Produktsammendrag - @(_prosjekt?.Navn)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet. Det kan være slettet.</p>
}
else if (_prosjekt is null)
{
    <p>Laster...</p>
}
else
{
    @* Produktsammendrag Y1 (produktsammendrag-forslag.html): som plukklisten R6 – nøkkeltall,
       søk og levering-chips, grå/hvit tabell sortert på beslagstype, totalt-rad og bunnlinje
       med lagrede PDF-er. *@
    var sum = _rader.Sum(r => r.Antall);
    var visRader = _rader.Where(VisRad).ToList();
    <div class="ps-kort @(_full ? "ps-full" : "")">
        <div class="ps-topp">
            <div>
                <a class="ps-tilbake" href="@($"/prosjekter/{Id}")">&larr; Tilbake til prosjektet</a>
                <h1>Produktsammendrag – @_prosjekt.Navn</h1>
            </div>
            <div class="ps-handl">
                <a class="ps-kn" href="@($"/prosjekt/{Id}/plukkliste")"><Icon Name="list" />Plukkliste</a>
                <a class="ps-kn" href="@($"/prosjekter/{Id}?fane=beslagsliste")"><Icon Name="box" />Beslagsliste</a>
                @if (_rader.Count > 0)
                {
                    <button type="button" class="ps-kn ps-kn-p" @onclick="GenererPdf"><Icon Name="file-text" />Last ned PDF</button>
                }
                <button type="button" class="ps-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>
        </div>
        <p class="ps-hint">Alt beslag som er lagt på prosjektets dører, summert på tvers av dørene.</p>

        @if (_byggetrinnListe.Count > 1)
        {
            <div class="ps-rad">
                <span class="ps-lbl">Byggetrinn</span>
                <button type="button" class="ps-chip @(_valgteByggetrinn.Count == 0 ? "pa" : "")" @onclick="VelgAlleByggetrinn">Alle</button>
                @foreach (var b in _byggetrinnListe)
                {
                    <button type="button" class="ps-chip @(_valgteByggetrinn.Contains(b) ? "pa" : "")" @onclick="@(() => ToggleByggetrinn(b))">@b</button>
                }
            </div>
        }

        @if (_rader.Count == 0)
        {
            <p class="list-empty">Ingen beslag registrert på prosjektets dører ennå.</p>
        }
        else
        {
            var varer = _rader.Select(r => r.Component.Id).Distinct().Count();
            var typer = _rader.Select(r => r.Component.Type?.Navn ?? "").Distinct().Count();
            <div class="ps-tall">
                <div><span>Varer</span><b>@varer</b><small>@typer @(typer == 1 ? "beslagstype" : "beslagstyper")</small></div>
                <div><span>Totalt</span><b>@sum stk</b><small>på @_antallDorer @(_antallDorer == 1 ? "dør" : "dører")</small></div>
                <div><span>Snitt per dør</span><b>@(_antallDorer == 0 ? "0" : ((double)sum / _antallDorer).ToString("0.0")) stk</b><small>@varer ulike varer</small></div>
                <div>
                    <span>Levering</span>
                    <b>@LevSum(LevertAv.F) <small class="ps-inl">fra oss</small></b>
                    <small>@LevSum(LevertAv.Ld) dørprodusent · @LevSum(LevertAv.Le) elektro</small>
                    <i class="ps-bar">
                        @foreach (var (lev, _, farge) in Leveringer)
                        {
                            <i style="width:@((sum == 0 ? 0 : 100.0 * LevSum(lev) / sum).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@farge"></i>
                        }
                    </i>
                </div>
            </div>

            <div class="ps-rad">
                <input class="ps-sok" type="search" @bind="_sok" @bind:event="oninput" placeholder="Søk vare, varenr eller type …" aria-label="Søk" />
                <button type="button" class="ps-chip @(_levFilter is null ? "pa" : "")" @onclick="@(() => _levFilter = null)">Alle <em>@_rader.Count</em></button>
                @foreach (var (lev, tekst, farge) in Leveringer)
                {
                    <button type="button" class="ps-chip @(_levFilter == lev ? "pa" : "")" @onclick="@(() => _levFilter = lev)"><i class="ps-prikk" style="background:@farge"></i>@tekst <em>@_rader.Count(r => r.LevertAv == lev)</em></button>
                }
            </div>

            <div class="ps-tabwrap">
                <table class="ps-tab">
                    <thead>
                        <tr>
                            <th>Vare</th>
                            <th>Beslagstype</th>
                            <th>Overflate</th>
                            <th>Levering</th>
                            <th class="ps-h">Antall</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rad in visRader)
                        {
                            <tr>
                                <td><b>@rad.Component.Navn</b>@if (!string.IsNullOrWhiteSpace(rad.Component.Produktkode)) {<small>@rad.Component.Produktkode</small>}</td>
                                <td>@(rad.Component.Type?.Navn ?? "–")</td>
                                <td class="ps-mut">@(string.IsNullOrWhiteSpace(rad.Component.Overflate) ? "–" : rad.Component.Overflate)</td>
                                <td><span class="ps-lev ps-lev-@rad.LevertAv">@LeveringTekst(rad.LevertAv)</span></td>
                                <td class="ps-h ps-n">@rad.Antall @((rad.Component.Enhet ?? "stk").ToLowerInvariant())</td>
                            </tr>
                        }
                        @if (visRader.Count == 0)
                        {
                            <tr><td colspan="5" class="ps-mut">Ingen treff.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="ps-sumrad">
                            <td colspan="4">Totalt</td>
                            <td class="ps-h">@visRader.Sum(r => r.Antall) stk</td>
                        </tr>
                    </tfoot>
                </table>
                <div class="ps-fot">
                    <span><b>@varer</b> varer</span>
                    <span><b>@sum</b> stk</span>
                    <span><b>@_antallDorer</b> dører</span>
                    <span class="ps-hoyre">
                        Lagrede PDF-er:
                        @if (_lagredePdfer.Count == 0)
                        {
                            <text>ingen ennå – trykk «Last ned PDF»</text>
                        }
                        else
                        {
                            <b>@string.Join(" · ", _lagredePdfer.OrderByDescending(p => p.OpprettetDato).Take(3).Select(p => p.OpprettetDato.ToString("dd.MM.yyyy")))</b>
                            <button type="button" class="ps-lenke" @onclick="@(() => _visAlleLagrede = !_visAlleLagrede)">@(_visAlleLagrede ? "Skjul" : "Vis alle")</button>
                        }
                    </span>
                </div>
            </div>

            @if (_visAlleLagrede && _lagredePdfer.Count > 0)
            {
                <LagredePdfListe Pdfer="_lagredePdfer" TillatSammenligning="true" Versjonsvisning="true" Tittel="Produktsammendrag" />
            }

            <PdfPreviewModal Url="@_pdfUrl" Tittel="Produktsammendrag" SaveMessage="@_pdfSavedMessage"
                              OnSave="LagreProduktsammendragPdf" OnClose="@(() => _pdfUrl = null)" />
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Prosjekt? _prosjekt;
    private bool _notFound;
    private List<SammendragRad> _rader = [];
    private string? _pdfUrl;
    private string? _pdfSavedMessage;
    private List<LagretPdf> _lagredePdfer = [];
    private List<string> _byggetrinnListe = [];
    private HashSet<string> _valgteByggetrinn = [];
    private int _antallDorer;

    private string _sok = "";
    private LevertAv? _levFilter;
    private bool _visAlleLagrede;

    private static readonly (LevertAv Lev, string Tekst, string Farge)[] Leveringer =
    [
        (LevertAv.F, "Fra oss", "#2b7a4b"), (LevertAv.Ld, "Dørprodusent", "#1F4E8C"), (LevertAv.Le, "Elektro", "#C9861A")
    ];

    private int LevSum(LevertAv lev) => _rader.Where(r => r.LevertAv == lev).Sum(r => r.Antall);

    private bool VisRad(SammendragRad r)
    {
        if (_levFilter is { } lev && r.LevertAv != lev)
        {
            return false;
        }

        var sok = _sok.Trim();
        return sok.Length == 0
            || r.Component.Navn.Contains(sok, StringComparison.OrdinalIgnoreCase)
            || (r.Component.Produktkode ?? "").Contains(sok, StringComparison.OrdinalIgnoreCase)
            || (r.Component.Type?.Navn ?? "").Contains(sok, StringComparison.OrdinalIgnoreCase);
    }

    private static string LeveringTekst(LevertAv levertAv) => levertAv switch
    {
        LevertAv.Ld => "Dørprodusent",
        LevertAv.Le => "Elektro",
        _ => "Fra oss"
    };

    private string? ByggetrinnParam => _valgteByggetrinn.Count == 0 ? null : string.Join(",", _valgteByggetrinn);

    private void GenererPdf()
    {
        _pdfSavedMessage = null;
        var byggetrinn = ByggetrinnParam is null ? "" : $"&byggetrinn={Uri.EscapeDataString(ByggetrinnParam)}";
        _pdfUrl = $"/prosjekt/{Id}/produktsammendrag/pdf?v={DateTime.UtcNow.Ticks}{byggetrinn}";
    }

    private async Task LagreProduktsammendragPdf()
    {
        var bytes = await PdfService.GenerateAsync(Id, ByggetrinnParam);
        if (bytes is null || _prosjekt is null)
        {
            return;
        }

        var etikett = _valgteByggetrinn.Count == 0 ? "" : $" ({string.Join(", ", _valgteByggetrinn)})";
        var pdf = await LagretPdfService.LagreAsync(
            "Produktsammendrag", Id, $"Produktsammendrag - {_prosjekt.Navn}{etikett} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private class SammendragRad
    {
        public required Component Component { get; set; }
        public LevertAv LevertAv { get; set; }
        public int Antall { get; set; }
    }

    // Utvid-knappen øverst til høyre - lagres per bruker, som på tilbud og dørpakker.
    private bool _full;
    private bool _fullLastet;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("produktsammendrag-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_fullLastet)
        {
            _fullLastet = true;
            _full = await VisningPref.HentAsync("produktsammendrag-bredde", "normal") == "full";
        }

        _prosjekt = await Db.Prosjekter.FindAsync(Id);
        if (_prosjekt is null)
        {
            _notFound = true;
            return;
        }

        _lagredePdfer = await LagretPdfService.HentAsync("Produktsammendrag", Id);

        var byggetrinn = await Db.Plantegninger
            .Where(p => p.ProsjektId == Id && p.Byggetrinn != null && p.Byggetrinn != "")
            .Select(p => p.Byggetrinn!)
            .Distinct()
            .ToListAsync();
        _byggetrinnListe = ByggetrinnHelper.Sorter(byggetrinn).ToList();

        await LastRader();
    }

    private async Task VelgAlleByggetrinn()
    {
        _valgteByggetrinn.Clear();
        await LastRader();
    }

    private async Task ToggleByggetrinn(string byggetrinn)
    {
        if (!_valgteByggetrinn.Remove(byggetrinn))
        {
            _valgteByggetrinn.Add(byggetrinn);
        }

        await LastRader();
    }

    private async Task LastRader()
    {
        var komponenter = await Db.DorKomponenter
            .Where(k => k.Dor!.ProsjektId == Id && k.ComponentId != 0
                && (_valgteByggetrinn.Count == 0 || (k.Dor!.Plantegning != null && _valgteByggetrinn.Contains(k.Dor!.Plantegning!.Byggetrinn!))))
            .Include(k => k.Component).ThenInclude(c => c!.Type)
            .ToListAsync();

        _antallDorer = komponenter.Select(k => k.DorId).Distinct().Count();

        _rader = komponenter
            .Where(k => k.Component is not null)
            .GroupBy(k => new { k.ComponentId, k.LevertAv })
            .Select(g => new SammendragRad
            {
                Component = g.First().Component!,
                LevertAv = g.Key.LevertAv,
                Antall = g.Sum(x => x.Antall)
            })
            .OrderBy(r => r.Component.Type?.Navn)
            .ThenBy(r => r.Component.Navn)
            .ToList();
    }
}
