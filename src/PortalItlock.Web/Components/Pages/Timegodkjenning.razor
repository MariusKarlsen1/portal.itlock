    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..1].ToUpper(Kultur),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpper(Kultur)
        };
    }

    private static string Farge(int id) => Paletten[Math.Abs(id) % Paletten.Length];
    private static string FormatTimer(decimal value) => value.ToString("N1", Kultur) + " t";
    private static string FormatKort(decimal value) => value.ToString("0.#", Kultur) + " t";
    private static string FormatKl(TimeSpan t) => t.ToString(@"hh\:mm");
    private static bool ErHelg(DateTime d) => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private static int Arbeidsdager(DateTime fra, DateTime til)
    {
        var antall = 0;
        for (var d = fra.Date; d <= til.Date; d = d.AddDays(1))
        {
            if (!ErHelg(d))
            {
                antall++;
            }
        }

        return Math.Max(antall, 1);
    }

