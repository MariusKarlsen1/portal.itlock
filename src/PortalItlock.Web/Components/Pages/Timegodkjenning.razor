    private async Task LastTimelisterAsync()
    {
        var ventende = await Db.Timeregistreringer
            .Where(t => t.Status == TimeregistreringStatus.Venter)
            .Select(t => new { t.MontorId, t.Dato })
            .ToListAsync();
        var nokler = ventende
            .Select(v => (v.MontorId, Ar: ISOWeek.GetYear(v.Dato), Uke: ISOWeek.GetWeekOfYear(v.Dato)))
            .ToHashSet();

        if (nokler.Count == 0)
        {
            _timelister = [];
            _apenNokkel = null;
            _apenDato = null;
            return;
        }

        var fra = nokler.Min(n => ISOWeek.ToDateTime(n.Ar, n.Uke, DayOfWeek.Monday));
        var til = nokler.Max(n => ISOWeek.ToDateTime(n.Ar, n.Uke, DayOfWeek.Monday)).AddDays(7);

        var regs = await Db.Timeregistreringer
            .Include(t => t.Arbeidsordre)
            .Where(t => t.Dato >= fra && t.Dato < til)
            .ToListAsync();
        var fravar = await Db.FravarSoknader
            .Where(f => f.Status != FravarStatus.Avslatt && f.FraDato.Date < til && f.TilDato.Date >= fra)
            .ToListAsync();

        _timelister = regs
            .GroupBy(r => (r.MontorId, Ar: ISOWeek.GetYear(r.Dato), Uke: ISOWeek.GetWeekOfYear(r.Dato)))
            .Where(g => nokler.Contains(g.Key))
            .Select(g =>
            {
                var mandag = ISOWeek.ToDateTime(g.Key.Ar, g.Key.Uke, DayOfWeek.Monday);
                var ukeRegs = g.OrderBy(r => r.Dato).ThenBy(r => r.Start).ToList();
                var ukeFravar = fravar
                    .Where(f => f.BrukerId == g.Key.MontorId && f.FraDato.Date <= mandag.AddDays(6) && f.TilDato.Date >= mandag)
                    .ToList();
                var navn = _montorer.FirstOrDefault(m => m.Id == g.Key.MontorId)?.Navn ?? "-";
                return new Timeliste($"{g.Key.MontorId}-{g.Key.Ar}-{g.Key.Uke}", g.Key.MontorId, navn, g.Key.Ar, g.Key.Uke, mandag,
                    ukeRegs, ukeFravar, UkeMerknader(ukeRegs, mandag));
            })
            .OrderByDescending(t => t.Mandag).ThenBy(t => t.Navn)
            .ToList();

        if (_timelister.All(t => t.Nokkel != _apenNokkel))
        {
            _apenNokkel = null;
            _apenDato = null;
        }
    }

    private string OvertidTekst()
    {
        var perMontor = _ukeRegs
            .Where(r => r.Type is TimeregistreringType.Overtid50 or TimeregistreringType.Overtid100)
            .GroupBy(r => r.MontorId)
            .Select(g => (Navn: _montorer.FirstOrDefault(m => m.Id == g.Key)?.Navn.Split(' ')[0] ?? "-", Timer: g.Sum(r => r.TotalTimer)))
            .OrderByDescending(x => x.Timer)
            .Take(2)
            .ToList();
        return perMontor.Count == 0 ? "ingen overtid" : string.Join(" · ", perMontor.Select(x => $"{x.Navn} {FormatTimer(x.Timer)}"));
    }

    private void VelgDag(int montorId, DateTime dag)
    {
        _valgtMontorId = montorId;
        _valgtDato = dag.Date;
    }

    private async Task ForrigeUke() => await GaTilDato(Mandag.AddDays(-7));
    private async Task NesteUke() => await GaTilDato(Mandag.AddDays(7));
    private async Task GaTilDenneUken() => await GaTilDato(DateTime.Today);
    private async Task GaTilUke(int ar, int uke) => await GaTilDato(ISOWeek.ToDateTime(ar, uke, DayOfWeek.Monday));

    private async Task GaTilDato(DateTime dato)
    {
        _valgtAr = ISOWeek.GetYear(dato);
        _valgtUke = ISOWeek.GetWeekOfYear(dato);
        _valgtMontorId = null;
        _valgtDato = null;
        await LastKoAsync();
    }

    private async Task LastKoAsync()
    {
        var mandag = Mandag;
        var sondag = mandag.AddDays(6);

        _totalVenterTimer = await Db.Timeregistreringer.CountAsync(t => t.Status == TimeregistreringStatus.Venter);
        _totalVenterFravar = await Db.FravarSoknader.CountAsync(f => f.Status == FravarStatus.Venter);

        await LastTimelisterAsync();

        var ukeQuery = Db.Timeregistreringer
            .Include(t => t.Arbeidsordre)
            .Where(t => t.Dato >= mandag && t.Dato <= sondag);
        if (_montorId.HasValue)
        {
            ukeQuery = ukeQuery.Where(t => t.MontorId == _montorId.Value);
        }

        _ukeRegs = (await ukeQuery.ToListAsync()).OrderBy(t => t.Dato).ThenBy(t => t.Start).ToList();

        _ukeFravar = await Db.FravarSoknader
            .Where(f => f.Status != FravarStatus.Avslatt && f.FraDato.Date <= sondag && f.TilDato.Date >= mandag)
            .ToListAsync();

        // Timer som venter i andre uker - vises som snarveier i verktøylinjen.
        var venterDatoer = await Db.Timeregistreringer
            .Where(t => t.Status == TimeregistreringStatus.Venter && (t.Dato < mandag || t.Dato > sondag)
                && (!_montorId.HasValue || t.MontorId == _montorId.Value))
            .Select(t => t.Dato)
            .ToListAsync();
        _venterAndreUker = venterDatoer
            .GroupBy(d => (Ar: ISOWeek.GetYear(d), Uke: ISOWeek.GetWeekOfYear(d)))
            .Select(g => new VentendeUke(g.Key.Ar, g.Key.Uke, g.Count()))
            .OrderByDescending(u => u.Ar).ThenByDescending(u => u.Uke)
            .ToList();

        // Velg første dag som venter, så boksen ikke er tom.
        if (_valgtMontorId is null || _valgtDato is null || _valgtDato < mandag || _valgtDato > sondag)
        {
            var forste = _ukeRegs.Where(r => r.Status == TimeregistreringStatus.Venter).OrderBy(r => r.Dato).FirstOrDefault()
                ?? _ukeRegs.FirstOrDefault();
            _valgtMontorId = forste?.MontorId;
            _valgtDato = forste?.Dato.Date;
        }

        // Fravær-fanen: alle søknader som venter (ikke bare denne uka - de går ofte over flere uker).
        _koFravar = await Db.FravarSoknader
            .Include(f => f.Bruker)
            .Where(f => f.Status == FravarStatus.Venter)
            .OrderBy(f => f.FraDato).ThenBy(f => f.Bruker!.Navn)
            .ToListAsync();

        if (_valgtFravarId is not null && !_koFravar.Any(f => f.Id == _valgtFravarId))
        {
            VelgFravar(null);
        }

        if (_koFravar.Count > 0)
        {
            var fra = _koFravar.Min(f => f.FraDato.Date);
            var til = _koFravar.Max(f => f.TilDato.Date);
            _andreFravar = await Db.FravarSoknader
                .Include(f => f.Bruker)
                .Where(f => f.Status != FravarStatus.Avslatt && f.FraDato.Date <= til && f.TilDato.Date >= fra)
                .ToListAsync();

            var fraDag = fra;
            var etterSiste = til.AddDays(1);
            _fravarTimer = (await Db.Timeregistreringer
                    .Where(t => t.Status != TimeregistreringStatus.Avslatt && t.Dato >= fraDag && t.Dato < etterSiste)
                    .Select(t => new { t.MontorId, t.Dato })
                    .ToListAsync())
                .Select(t => (t.MontorId, t.Dato))
                .ToList();
        }
        else
        {
            _andreFravar = [];
            _fravarTimer = [];
        }

        _soknader = _koFravar.Select(f => new Soknadsrad(f, SoknadMerknader(f))).ToList();

        _behandlede = await Db.FravarSoknader
            .Include(f => f.Bruker)
            .Where(f => f.Status != FravarStatus.Venter)
            .OrderByDescending(f => f.BehandletDato).ThenByDescending(f => f.Id)
            .Take(30)
            .ToListAsync();
    }

    private async Task Behandle(int id, TimeregistreringStatus status) => await BehandleFlere([id], status);

    private async Task BehandleFlere(List<int> ider, TimeregistreringStatus status)
    {
        if (!KanGodkjenne || ider.Count == 0)
        {
            return;
        }

        // Bare det som fortsatt venter, i tilfelle noen andre har behandlet timene imens.
        var regs = await Db.Timeregistreringer.Where(t => ider.Contains(t.Id) && t.Status == TimeregistreringStatus.Venter).ToListAsync();
        foreach (var reg in regs)
        {
            reg.Status = status;
            reg.BehandletDato = DateTime.Now;
            reg.BehandletAvBrukerId = _naverendeBrukerId;
        }

        await Db.SaveChangesAsync();
        await LastKoAsync();
        await LoadOversiktAsync();
    }

    // ---------- Fravær-fanen ----------
    private List<Soknadsrad> VisteSoknader => _soknader
        .Where(x => _fravarFilter != "merknad" || !x.Klar)
        .Where(x => TrefferFravarSok(x.Soknad))
        .ToList();

    private List<FravarSoknad> VisteBehandlede => _behandlede.Where(TrefferFravarSok).ToList();

    private bool TrefferFravarSok(FravarSoknad f) => string.IsNullOrWhiteSpace(_fravarSok)
        || (f.Bruker?.Navn ?? "").Contains(_fravarSok.Trim(), StringComparison.OrdinalIgnoreCase);

    private void VelgFravarFilter(string filter)
    {
        _fravarFilter = filter;
        _bekreftAlleFravar = false;
    }

    private void LukkBekreftFravar() => _bekreftAlleFravar = false;

    private void VekslSoknad(int id) => VelgFravar(_valgtFravarId == id ? null : id);

    private async Task GodkjennSoknad(int id)
    {
        VelgFravar(id);
        await LagreFravar();
    }

    private async Task GodkjennAlleKlareFravar()
    {
        var ider = VisteSoknader.Where(x => x.Klar).Select(x => x.Soknad.Id).ToList();
        _bekreftAlleFravar = false;
        foreach (var id in ider)
        {
            await GodkjennSoknad(id);
        }
    }

    private static string Fornavn(string? navn) => string.IsNullOrWhiteSpace(navn) ? "montøren" : navn.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];

    private static string PeriodeKort(FravarSoknad f) => f.FraDato.Date == f.TilDato.Date ? KortDag(f.FraDato.Date) : Periode(f);

    private static string DagerTekst(FravarSoknad f)
    {
        var dager = Arbeidsdager(f.FraDato, f.TilDato);
        return dager == 1 ? "1 dag" : $"{dager} arbeidsdager";
    }

    private static bool Overlapper(FravarSoknad a, FravarSoknad b) => a.FraDato.Date <= b.TilDato.Date && a.TilDato.Date >= b.FraDato.Date;

    // Det som bør sjekkes før søknaden godkjennes. Uten merknader er den Klar.
    private List<Merknad> SoknadMerknader(FravarSoknad s)
    {
        var liste = new List<Merknad>();
        var fornavn = Fornavn(s.Bruker?.Navn);
        var egne = _andreFravar.Where(a => a.Id != s.Id && a.BrukerId == s.BrukerId && Overlapper(a, s)).ToList();

        if (egne.Any(a => a.Type == s.Type))
        {
            liste.Add(new("Søkt to ganger", $"{s.Type.Visningsnavn()} {Periode(s)} er søkt to ganger. Avslå den ene."));
        }

        if (egne.FirstOrDefault(a => a.Type != s.Type) is { } annen)
        {
            liste.Add(new("To søknader samme dag", $"{fornavn} har også søkt {annen.Type.Visningsnavn().ToLower(Kultur)} {Periode(annen)}."));
        }

        // Fravær deler av dagen kan fint ha timer samme dag.
        if (s.HeleDagen)
        {
            var dager = _fravarTimer
                .Where(t => t.MontorId == s.BrukerId && t.Dato.Date >= s.FraDato.Date && t.Dato.Date <= s.TilDato.Date)
                .Select(t => t.Dato.Date)
                .Distinct()
                .OrderBy(d => d)
                .ToList();
            if (dager.Count > 0)
            {
                liste.Add(new("Timer ført samme dag", $"{fornavn} har ført timer {string.Join(", ", dager.Select(d => d.ToString("d.M", Kultur)))}."));
            }
        }

        var andre = AndreBorte(s);
        if (andre.Count > 0)
        {
            liste.Add(new("Andre borte samtidig", "Borte samtidig: " + string.Join(", ", andre.Select(a => $"{Fornavn(a.Bruker?.Navn)} {Periode(a)}{(a.Status == FravarStatus.Venter ? " (søkt)" : "")}")) + "."));
        }

        return liste;
    }

    private void VelgFravar(int? id)
    {
        _valgtFravarId = id;
        _avslagsBegrunnelse = "";
        NullstillDagValg();
    }

    // Alle arbeidsdager i søknaden starter som godkjent.
    private void NullstillDagValg()
    {
        _dagValg = [];
        if (_valgtFravar is not { } s)
        {
            return;
        }

        for (var d = s.FraDato.Date; d <= s.TilDato.Date; d = d.AddDays(1))
        {
            if (!ErHelg(d) || s.FraDato.Date == s.TilDato.Date)
            {
                _dagValg[d] = true;
            }
        }

        if (_dagValg.Count == 0)
        {
            _dagValg[s.FraDato.Date] = true;
        }
    }

    private void AvslaAlleDager()
    {
        foreach (var d in _dagValg.Keys.ToList())
        {
            _dagValg[d] = false;
        }
    }

    // Månedene søknaden går over (maks fire, så lange søknader ikke sprenger siden).
    private static List<DateTime> Maneder(FravarSoknad s)
    {
        var liste = new List<DateTime>();
        for (var m = new DateTime(s.FraDato.Year, s.FraDato.Month, 1); m <= s.TilDato.Date && liste.Count < 4; m = m.AddMonths(1))
        {
            liste.Add(m);
        }

        return liste;
    }

    // Andre som er borte (godkjent eller søkt) i samme periode.
    private List<FravarSoknad> AndreBorte(FravarSoknad s) => _andreFravar
        .Where(a => a.Id != s.Id && a.BrukerId != s.BrukerId && a.FraDato.Date <= s.TilDato.Date && a.TilDato.Date >= s.FraDato.Date)
        .OrderBy(a => a.FraDato)
        .ToList();

    // Lagrer valget for søknaden. Godkjennes noen dager og avslås andre, deles
    // søknaden opp i sammenhengende perioder - én søknad per periode, med
    // riktig status - slik at resten av portalen (fravær, kalender, varsler)
    // fortsatt bare ser vanlige søknader. Helgedager følger dagen før.
    private async Task LagreFravar()
    {
        if (!KanGodkjenne || _valgtFravar is not { } valgt)
        {
            return;
        }

        var soknad = await Db.FravarSoknader.FirstOrDefaultAsync(f => f.Id == valgt.Id);
        if (soknad is null || soknad.Status != FravarStatus.Venter)
        {
            return;
        }

        var melding = string.IsNullOrWhiteSpace(_avslagsBegrunnelse) ? null : _avslagsBegrunnelse.Trim();

        var perioder = new List<(DateTime Fra, DateTime Til, bool Godkjent)>();
        bool? forrige = null;
        for (var d = soknad.FraDato.Date; d <= soknad.TilDato.Date; d = d.AddDays(1))
        {
            var godkjent = _dagValg.TryGetValue(d, out var v) ? v : forrige ?? _dagValg.Values.FirstOrDefault(true);
            if (perioder.Count > 0 && perioder[^1].Godkjent == godkjent)
            {
                perioder[^1] = (perioder[^1].Fra, d, godkjent);
            }
            else
            {
                perioder.Add((d, d, godkjent));
            }

            forrige = godkjent;
        }

        // Originalens datoer leses før den første perioden skriver over dem.
        var opprinneligFra = soknad.FraDato;
        var opprinneligTil = soknad.TilDato;
        var nå = DateTime.Now;
        for (var i = 0; i < perioder.Count; i++)
        {
            var (fra, til, godkjent) = perioder[i];
            var mål = i == 0 ? soknad : new FravarSoknad
            {
                BrukerId = soknad.BrukerId,
                Type = soknad.Type,
                Kommentar = soknad.Kommentar,
                TilOppfolgingHosBrukerId = soknad.TilOppfolgingHosBrukerId,
                HeleDagen = soknad.HeleDagen,
                StartTid = soknad.StartTid,
                SluttTid = soknad.SluttTid,
                OpprettetDato = soknad.OpprettetDato
            };

            mål.FraDato = i == 0 ? opprinneligFra : fra.Date.Add(opprinneligFra.TimeOfDay);
            mål.TilDato = i == perioder.Count - 1 ? opprinneligTil : til.Date.Add(opprinneligTil.TimeOfDay);

            mål.Status = godkjent ? FravarStatus.Godkjent : FravarStatus.Avslatt;
            mål.BehandletDato = nå;
            mål.BehandletAvBrukerId = _naverendeBrukerId;
            mål.AvslagsBegrunnelse = godkjent ? null : melding;

            if (i > 0)
            {
                Db.FravarSoknader.Add(mål);
            }
        }

        await Db.SaveChangesAsync();

        VelgFravar(null);
        await LastKoAsync();
    }

    // ---------- Oversikt-fanen ----------
    private string PeriodeTekst => _periode == "egen"
        ? $"{_fraDato.ToString("d.M", Kultur)}–{_tilDato.ToString("d.M.yyyy", Kultur)}"
        : Stor(_fraDato.ToString("MMMM yyyy", Kultur));

    private async Task ForrigeMaaned() => await GaTilMaaned(new DateTime(_fraDato.Year, _fraDato.Month, 1).AddMonths(-1));
    private async Task NesteMaaned() => await GaTilMaaned(new DateTime(_fraDato.Year, _fraDato.Month, 1).AddMonths(1));

    private async Task GaTilMaaned(DateTime forsteDag)
    {
        _periode = "mnd";
        _fraDato = forsteDag;
        _tilDato = forsteDag.AddMonths(1).AddDays(-1);
        await LoadOversiktAsync();
    }

    private async Task VekslEgenPeriode()
    {
        if (_periode == "egen")
        {
            await GaTilMaaned(new DateTime(_fraDato.Year, _fraDato.Month, 1));
        }
        else
        {
            _periode = "egen";
        }
    }

    private void VekslMontor(int montorId)
    {
        _apenMontorId = _apenMontorId == montorId ? null : montorId;
        _visRegistreringer = false;
    }

    private static string FordelingTekst(MontorSum m, int antall)
    {
        var deler = new List<string> { $"{antall} {(antall == 1 ? "registrering" : "registreringer")}", $"normal {FormatKort(m.Normal)}" };
        if (m.Overtid50 > 0) deler.Add($"50 % {FormatKort(m.Overtid50)}");
        if (m.Overtid100 > 0) deler.Add($"100 % {FormatKort(m.Overtid100)}");
        if (m.Avspasering > 0) deler.Add($"avspasering {FormatKort(m.Avspasering)}");
        return string.Join(" · ", deler);
    }

    private async Task OnFraDatoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dato))
        {
            _fraDato = dato;
            _periode = "egen";
            await LoadOversiktAsync();
        }
    }

    private async Task OnTilDatoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dato))
        {
            _tilDato = dato;
            _periode = "egen";
            await LoadOversiktAsync();
        }
    }

    private async Task LoadOversiktAsync()
    {
        // Avslåtte timer er ikke arbeid som skal lønnes, og telles ikke med her.
        _oversiktRegistreringer = (await TimeoversiktService.HentRegistreringerAsync(_fraDato, _tilDato, _oversiktMontorId))
            .Where(t => t.Status != TimeregistreringStatus.Avslatt)
            .ToList();

        _sammendrag = _oversiktRegistreringer
            .GroupBy(t => t.MontorId)
            .Select(g => new MontorSum
            {
                MontorId = g.Key,
                MontorNavn = g.First().Montor?.Navn ?? "-",
                Normal = g.Where(t => t.Type == TimeregistreringType.NormalArbeidstid).Sum(t => t.TotalTimer),
                Overtid50 = g.Where(t => t.Type == TimeregistreringType.Overtid50).Sum(t => t.TotalTimer),
                Overtid100 = g.Where(t => t.Type == TimeregistreringType.Overtid100).Sum(t => t.TotalTimer),
                Avspasering = g.Where(t => t.Type == TimeregistreringType.Avspasering).Sum(t => t.TotalTimer),
                Godkjent = g.Where(t => t.Status == TimeregistreringStatus.Godkjent).Sum(t => t.TotalTimer),
                Venter = g.Where(t => t.Status == TimeregistreringStatus.Venter).Sum(t => t.TotalTimer),
                Km = g.Sum(t => t.Kilometer)
            })
            .OrderBy(m => m.MontorNavn)
            .ToList();

        if (_sammendrag.All(m => m.MontorId != _apenMontorId))
        {
            _apenMontorId = null;
            _visRegistreringer = false;
        }
    }
}
