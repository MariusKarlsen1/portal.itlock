    private FravarSoknad? DagFravar(int montorId, DateTime dag) => FravarPa(_ukeFravar, montorId, dag);

    private static FravarSoknad? FravarPa(IEnumerable<FravarSoknad> fravar, int montorId, DateTime dag) => fravar
        .Where(f => f.BrukerId == montorId && dag.Date >= f.FraDato.Date && dag.Date <= f.TilDato.Date)
        .OrderBy(f => f.Status == FravarStatus.Godkjent ? 0 : 1)
        .FirstOrDefault();

    private string CelleStatus(int montorId, DateTime dag) => CelleStatus(DagRegs(montorId, dag), DagFravar(montorId, dag));

    private static string CelleStatus(List<Models.Timeregistrering> regs, FravarSoknad? fravar)
    {
        if (regs.Count == 0)
        {
            return fravar is { } f ? (f.Status == FravarStatus.Godkjent ? "fravar" : "fravar-sokt") : "tom";
        }

        if (regs.Any(r => r.Status == TimeregistreringStatus.Venter))
        {
            return "venter";
        }

        return regs.All(r => r.Status == TimeregistreringStatus.Avslatt) ? "avslatt" : "godkjent";
    }

    private List<string> Merknader(int montorId, DateTime dag) => DagMerknader(DagRegs(montorId, dag), dag);

    // Det som gjør at en dag bør sjekkes. Avslåtte registreringer teller ikke:
    // de er allerede tatt stilling til.
    private static List<string> DagMerknader(IEnumerable<Models.Timeregistrering> alle, DateTime dag)
    {
        var liste = new List<string>();
        var regs = alle.Where(r => r.Status != TimeregistreringStatus.Avslatt).ToList();
        if (regs.Count == 0)
        {
            return liste;
        }

        if (Overlapper(regs))
        {
            liste.Add("dobbelt");
        }

        if (regs.Sum(r => r.TotalTimer) > 10)
        {
            liste.Add("lang");
        }

        if (ErHelg(dag))
        {
            liste.Add("helg");
        }

        if (regs.Any(r => r.Type is TimeregistreringType.Overtid50 or TimeregistreringType.Overtid100))
        {
            liste.Add("overtid");
        }

        return liste;
    }

    // To registreringer som går over samme tid samme dag er som regel samme jobb ført to ganger.
    private static bool Overlapper(IEnumerable<Models.Timeregistrering> regs)
    {
        var sortert = regs.Where(r => r.Slutt > r.Start).OrderBy(r => r.Start).ToList();
        var sisteSlutt = TimeSpan.MinValue;
        foreach (var r in sortert)
        {
            if (r.Start < sisteSlutt)
            {
                return true;
            }

            sisteSlutt = r.Slutt > sisteSlutt ? r.Slutt : sisteSlutt;
        }

        return false;
    }

    private static string DagNavn(DateTime dag) => dag.ToString("dddd", Kultur);

    private static string KortDag(DateTime dag)
    {
        var navn = dag.ToString("ddd", Kultur).TrimEnd('.');
        return $"{Stor(navn)} {dag.ToString("d.M", Kultur)}";
    }

    private static List<Merknad> UkeMerknader(List<Models.Timeregistrering> regs, DateTime mandag)
    {
        var liste = new List<Merknad>();
        foreach (var dag in Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)))
        {
            var dagRegs = regs.Where(r => r.Dato.Date == dag).ToList();
            var navn = DagNavn(dag);
            var dato = dag.ToString("d.M", Kultur);
            foreach (var kode in DagMerknader(dagRegs, dag))
            {
                liste.Add(kode switch
                {
                    "dobbelt" => new Merknad($"Mulig dobbeltført {navn}", $"{Stor(navn)} {dato}: to registreringer overlapper i tid."),
                    "lang" => new Merknad($"Lang dag {navn}", $"{Stor(navn)} {dato}: {FormatKort(dagRegs.Where(r => r.Status != TimeregistreringStatus.Avslatt).Sum(r => r.TotalTimer))}, over 10 timer. Sjekk at det er avtalt og at pausen er riktig."),
                    "helg" => new Merknad($"Ført på {navn}", $"{Stor(navn)} {dato}: helgejobb. Sjekk at riktig overtidssats er brukt."),
                    _ => new Merknad($"Overtid {navn}", $"{Stor(navn)} {dato}: inneholder overtid.")
                });
            }
        }

        return liste;
    }

    private static string Stor(string tekst) => tekst.Length == 0 ? tekst : char.ToUpper(tekst[0], Kultur) + tekst[1..];

    // Forklaringen i boksen: hva som er spesielt med dagen, med vanlige ord.
    private static List<Forklaringslinje> Forklaring(List<Models.Timeregistrering> regs, FravarSoknad? fravar, DateTime dag)
    {
        var linjer = new List<Forklaringslinje>();

        if (fravar is not null)
        {
            linjer.Add(new("bla", fravar.Type.Visningsnavn(), fravar.Status == FravarStatus.Godkjent
                ? $"– godkjent fravær {Periode(fravar)}."
                : $"– søkt {Periode(fravar)}, behandles i Fravær-fanen."));
        }

        if (regs.Count == 0)
        {
            if (fravar is null)
            {
                linjer.Add(new("mut", "Ingen timer", ErHelg(dag) ? "registrert – helg." : "registrert denne dagen."));
            }

            return linjer;
        }

        var timer = regs.Sum(r => r.TotalTimer);
        var ot50 = regs.Where(r => r.Type == TimeregistreringType.Overtid50).Sum(r => r.TotalTimer);
        var ot100 = regs.Where(r => r.Type == TimeregistreringType.Overtid100).Sum(r => r.TotalTimer);

        if (Overlapper(regs.Where(r => r.Status != TimeregistreringStatus.Avslatt)))
        {
            linjer.Add(new("rod", "Mulig dobbeltført", "– to registreringer overlapper i tid. Sjekk at samme jobb ikke er ført to ganger."));
        }

        if (timer > 10)
        {
            linjer.Add(new("rod", $"Over 10 timer ({FormatTimer(timer)})", "– en lang dag. Sjekk at det er avtalt og at pausen er riktig."));
        }

        if (ot50 + ot100 > 0)
        {
            var deler = new List<string>();
            if (ot50 > 0) deler.Add($"{FormatTimer(ot50)} med 50 %");
            if (ot100 > 0) deler.Add($"{FormatTimer(ot100)} med 100 %");
            linjer.Add(new("gul", "Overtid:", string.Join(" og ", deler) + "."));
        }

        if (ErHelg(dag))
        {
            linjer.Add(new("lilla", "Helgejobb", "– sjekk at riktig overtidssats er brukt."));
        }

        if (regs.Any(r => !r.Fakturerbar))
        {
            linjer.Add(new("bla", "Ikke fakturerbar", "– noen av timene faktureres ikke kunden."));
        }

        if (regs.Any(r => r.Status == TimeregistreringStatus.Avslatt))
        {
            linjer.Add(new("rod", "Avslått", "– noen av registreringene er avslått tidligere."));
        }

        if (linjer.Count == 0)
        {
            linjer.Add(new("gronn", "Ser normalt ut", "– innenfor normal arbeidstid og ført på arbeidsordre."));
        }

        return linjer;
    }

