@page "/timegodkjenning"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject TimeoversiktService TimeoversiktService

<PageTitle>Timegodkjenning</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="check-circle" /></span>
    <div>
        <h1>Timegodkjenning</h1>
        <p class="section-hint">Timer montørene registrerer samles her til godkjenning. Bruk Oversikt-fanen for sammendrag og lønnseksport.</p>
    </div>
</div>

<div class="fane-rad">
    <span class="fane @(_aktivFane == "godkjenning" ? "fane-aktiv" : "")" @onclick='@(() => _aktivFane = "godkjenning")'>
        Timegodkjenning<span class="fane-badge">@_totalVenterCount</span>
    </span>
    <span class="fane @(_aktivFane == "oversikt" ? "fane-aktiv" : "")" @onclick='@(() => _aktivFane = "oversikt")'>
        Oversikt
    </span>
</div>

@if (_aktivFane == "godkjenning")
{
    <div class="filter-rad">
        <select class="filter-select" @bind="_montorId" @bind:after="LastKoAsync">
            <option value="">Alle montører</option>
            @foreach (var m in _montorer)
            {
                <option value="@m.Id">@m.Navn</option>
            }
        </select>

        <div class="uke-nav">
            <button type="button" class="uke-knapp" @onclick="ForrigeUke" title="Forrige uke">&larr;</button>
            <span class="uke-tekst">@(_visAlleUker ? "Alle uker" : $"Uke {_valgtUke}, {_valgtAr}")</span>
            <button type="button" class="uke-knapp" @onclick="NesteUke" title="Neste uke">&rarr;</button>
        </div>

        <button type="button" class="btn-liten @(_visAlleUker ? "btn-liten-aktiv" : "")" @onclick="ToggleAlleUker">Vis alle uker</button>
        @if (!_visAlleUker)
        {
            <button type="button" class="btn-liten" @onclick="GaTilDenneUken">Denne uken</button>
        }
    </div>

    <div class="godkjenning-layout">
        <div class="kort ko-liste">
            @if (_ko.Count == 0)
            {
                <p class="tom-liste">Ingen timer venter på godkjenning i denne perioden.</p>
            }
            else
            {
                @foreach (var r in _ko)
                {
                    <div @key="r.Id" class="ko-rad @(r.Id == _valgtId ? "ko-rad-aktiv" : "")" @onclick="@(() => _valgtId = r.Id)">
                        <span class="ko-avatar">@Initialer(r.Montor?.Navn)</span>
                        <div class="ko-info">
                            <span class="ko-navn">@(r.Montor?.Navn ?? "-")</span>
                            <span class="ko-detalj">@r.Dato.ToString("ddd dd.MM", Kultur) &middot; @(r.Arbeidsordre?.Tittel ?? r.Type.Visningsnavn())</span>
                        </div>
                        <span class="ko-timer">@FormatTimer(r.TotalTimer)</span>
                    </div>
                }
            }
        </div>

        <div class="hoved">
            @if (_valgt is null)
            {
                <div class="kort detalj-kort">
                    <p class="tom-liste">Velg en registrering i køen for å se detaljer.</p>
                </div>
            }
            else
            {
                <div class="kort detalj-kort">
                    <div class="detalj-header">
                        <span class="detalj-avatar">@Initialer(_valgt.Montor?.Navn)</span>
                        <div>
                            <div class="detalj-navn">@(_valgt.Montor?.Navn ?? "-")</div>
                            <div class="detalj-sub">@_valgt.Dato.ToString("dddd dd.MM.yyyy", Kultur)</div>
                        </div>
                    </div>

                    <div class="felt-grid">
                        <div class="felt"><span class="felt-label">Type</span><span class="felt-verdi">@_valgt.Type.Visningsnavn()</span></div>
                        <div class="felt"><span class="felt-label">Timer</span><span class="felt-verdi">@FormatTimer(_valgt.TotalTimer) (@FormatKl(_valgt.Start)&ndash;@FormatKl(_valgt.Slutt), @_valgt.PauseMinutter min pause)</span></div>
                        <div class="felt"><span class="felt-label">Arbeidsordre</span><span class="felt-verdi">@if (_valgt.Arbeidsordre is not null){<a href="@($"/arbeidsordre/{_valgt.ArbeidsordreId}")">@_valgt.Arbeidsordre.Tittel</a>}else{<text>&ndash;</text>}</span></div>
                        <div class="felt"><span class="felt-label">Kjørt</span><span class="felt-verdi">@(_valgt.Kilometer > 0 ? $"{_valgt.Kilometer:N0} km" : "–")</span></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_valgt.Kommentar))
                    {
                        <div class="felt">
                            <span class="felt-label">Kommentar</span>
                            <div class="kommentar-boks">@_valgt.Kommentar</div>
                        </div>
                    }

                    <div class="knapp-rad">
                        <button type="button" class="knapp btn-godkjenn" @onclick="@(() => Behandle(_valgt.Id, TimeregistreringStatus.Godkjent))">Godkjenn</button>
                        <button type="button" class="knapp btn-avsla" @onclick="@(() => Behandle(_valgt.Id, TimeregistreringStatus.Avslatt))">Avslå</button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <section class="filter-section">
        <div class="field-grid">
            <label>
                Fra dato
                <input type="date" value="@_fraDato.ToString("yyyy-MM-dd")" @onchange="@(e => OnFraDatoChanged(e))" />
            </label>
            <label>
                Til dato
                <input type="date" value="@_tilDato.ToString("yyyy-MM-dd")" @onchange="@(e => OnTilDatoChanged(e))" />
            </label>
            <label>
                Montør
                <select @bind="_oversiktMontorId" @bind:after="LoadOversiktAsync">
                    <option value="">Alle montører</option>
                    @foreach (var m in _montorer)
                    {
                        <option value="@m.Id">@m.Navn</option>
                    }
                </select>
            </label>
        </div>

        <div class="form-actions">
            <a class="add-button" href="@CsvUrl" target="_blank">Eksporter CSV</a>
            <button type="button" class="add-button" @onclick="@(() => _pdfPreviewUrl = PdfUrl)">Eksporter PDF</button>
        </div>
        <p class="eksport-hint">Kun godkjente timer tas med i eksport. @_antallVenterOversikt time@(_antallVenterOversikt == 1 ? "" : "r") venter fortsatt på godkjenning i perioden.</p>
    </section>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av timeoversikt" OnClose="@(() => _pdfPreviewUrl = null)" />

    <section class="oversikt-section">
        <h2>Sammendrag</h2>

        @if (_sammendrag.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert i perioden.</p>
        }
        else
        {
            <table class="sum-table">
                <thead>
                    <tr>
                        <th>Montør</th>
                        <th>Normal</th>
                        <th>50% overtid</th>
                        <th>100% overtid</th>
                        <th>Avspasering</th>
                        <th>Totalt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _sammendrag)
                    {
                        <tr>
                            <td>@m.MontorNavn</td>
                            <td>@FormatTimer(m.Normal)</td>
                            <td>@FormatTimer(m.Overtid50)</td>
                            <td>@FormatTimer(m.Overtid100)</td>
                            <td>@FormatTimer(m.Avspasering)</td>
                            <td class="sum-total">@FormatTimer(m.Totalt)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Totalt alle</td>
                        <td colspan="4"></td>
                        <td class="sum-total">@FormatTimer(_sammendrag.Sum(m => m.Totalt))</td>
                    </tr>
                </tfoot>
            </table>
        }
    </section>

    <section class="oversikt-section">
        <h2>Detaljer</h2>

        @if (_oversiktRegistreringer.Count == 0)
        {
            <p class="list-empty">Ingen registreringer i perioden.</p>
        }
        else
        {
            <table class="detalj-table">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th>Montør</th>
                        <th>Type</th>
                        <th>Timer</th>
                        <th>Arbeidsordre</th>
                        <th>Kommentar</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _oversiktRegistreringer)
                    {
                        <tr @key="t.Id">
                            <td>@t.Dato.ToString("dd.MM.yyyy")</td>
                            <td>@t.Montor?.Navn</td>
                            <td>@t.Type.Visningsnavn()</td>
                            <td class="sum-total">@FormatTimer(t.TotalTimer)</td>
                            <td>@t.Arbeidsordre?.Tittel</td>
                            <td>@t.Kommentar</td>
                            <td>@t.Status.Visningsnavn()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class MontorSum
    {
        public string MontorNavn { get; set; } = "";
        public decimal Normal { get; set; }
        public decimal Overtid50 { get; set; }
        public decimal Overtid100 { get; set; }
        public decimal Avspasering { get; set; }
        public decimal Totalt => Normal + Overtid50 + Overtid100 + Avspasering;
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _aktivFane = "godkjenning";
    private List<MontorOption> _montorer = [];

    // Timegodkjenning-fane
    private int? _montorId;
    private int _valgtUke;
    private int _valgtAr;
    private bool _visAlleUker;
    private List<Models.Timeregistrering> _ko = [];
    private int? _valgtId;
    private int _totalVenterCount;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private Models.Timeregistrering? _valgt => _ko.FirstOrDefault(r => r.Id == _valgtId);

    // Oversikt-fane
    private DateTime _fraDato = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _tilDato = new(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
    private int? _oversiktMontorId;
    private List<Models.Timeregistrering> _oversiktRegistreringer = [];
    private List<MontorSum> _sammendrag = [];
    private string? _pdfPreviewUrl;
    private int _antallVenterOversikt;

    private string CsvUrl => $"/timeoversikt/eksport-csv?fra={_fraDato:yyyy-MM-dd}&til={_tilDato:yyyy-MM-dd}" +
        (_oversiktMontorId.HasValue ? $"&montorId={_oversiktMontorId}" : "");

    private string PdfUrl => $"/timeoversikt/eksport-pdf?fra={_fraDato:yyyy-MM-dd}&til={_tilDato:yyyy-MM-dd}" +
        (_oversiktMontorId.HasValue ? $"&montorId={_oversiktMontorId}" : "");

    protected override async Task OnInitializedAsync()
    {
        var i = ISOWeek.GetWeekOfYear(DateTime.Today);
        var a = ISOWeek.GetYear(DateTime.Today);
        _valgtUke = i;
        _valgtAr = a;

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _montorer = await Db.Brukere
            .OrderBy(m => m.Navn)
            .Select(m => new MontorOption { Id = m.Id, Navn = m.Navn })
            .ToListAsync();

        await LastKoAsync();
        await LoadOversiktAsync();
    }

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..1].ToUpper(Kultur),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpper(Kultur)
        };
    }

    private static string FormatTimer(decimal value) => value.ToString("N1", Kultur) + " t";
    private static string FormatKl(TimeSpan t) => t.ToString(@"hh\:mm");

    private async Task ForrigeUke()
    {
        var dato = ISOWeek.ToDateTime(_valgtAr, _valgtUke, DayOfWeek.Monday).AddDays(-7);
        _valgtAr = ISOWeek.GetYear(dato);
        _valgtUke = ISOWeek.GetWeekOfYear(dato);
        _visAlleUker = false;
        await LastKoAsync();
    }

    private async Task NesteUke()
    {
        var dato = ISOWeek.ToDateTime(_valgtAr, _valgtUke, DayOfWeek.Monday).AddDays(7);
        _valgtAr = ISOWeek.GetYear(dato);
        _valgtUke = ISOWeek.GetWeekOfYear(dato);
        _visAlleUker = false;
        await LastKoAsync();
    }

    private async Task GaTilDenneUken()
    {
        _valgtAr = ISOWeek.GetYear(DateTime.Today);
        _valgtUke = ISOWeek.GetWeekOfYear(DateTime.Today);
        _visAlleUker = false;
        await LastKoAsync();
    }

    private async Task ToggleAlleUker()
    {
        _visAlleUker = !_visAlleUker;
        await LastKoAsync();
    }

    private async Task LastKoAsync()
    {
        var query = Db.Timeregistreringer
            .Include(t => t.Montor)
            .Include(t => t.Arbeidsordre)
            .Where(t => t.Status == TimeregistreringStatus.Venter)
            .AsQueryable();

        _totalVenterCount = await query.CountAsync();

        if (_montorId.HasValue)
        {
            query = query.Where(t => t.MontorId == _montorId.Value);
        }

        if (!_visAlleUker)
        {
            var mandag = ISOWeek.ToDateTime(_valgtAr, _valgtUke, DayOfWeek.Monday);
            var sondag = mandag.AddDays(6);
            query = query.Where(t => t.Dato >= mandag.Date && t.Dato <= sondag.Date);
        }

        _ko = await query
            .OrderBy(t => t.Dato).ThenBy(t => t.Montor!.Navn)
            .ToListAsync();

        if (_valgtId is null || !_ko.Any(r => r.Id == _valgtId))
        {
            _valgtId = _ko.FirstOrDefault()?.Id;
        }
    }

    private async Task Behandle(int id, TimeregistreringStatus status)
    {
        var reg = await Db.Timeregistreringer.FirstOrDefaultAsync(t => t.Id == id);
        if (reg is null)
        {
            return;
        }

        reg.Status = status;
        reg.BehandletDato = DateTime.Now;
        reg.BehandletAvBrukerId = _naverendeBrukerId;
        await Db.SaveChangesAsync();

        await LastKoAsync();
        await LoadOversiktAsync();
    }

    private async Task OnFraDatoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dato))
        {
            _fraDato = dato;
            await LoadOversiktAsync();
        }
    }

    private async Task OnTilDatoChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dato))
        {
            _tilDato = dato;
            await LoadOversiktAsync();
        }
    }

    private async Task LoadOversiktAsync()
    {
        _oversiktRegistreringer = await TimeoversiktService.HentRegistreringerAsync(_fraDato, _tilDato, _oversiktMontorId);
        _antallVenterOversikt = _oversiktRegistreringer.Count(t => t.Status == TimeregistreringStatus.Venter);

        _sammendrag = _oversiktRegistreringer
            .GroupBy(t => t.Montor?.Navn ?? "-")
            .Select(g => new MontorSum
            {
                MontorNavn = g.Key,
                Normal = g.Where(t => t.Type == TimeregistreringType.NormalArbeidstid).Sum(t => t.TotalTimer),
                Overtid50 = g.Where(t => t.Type == TimeregistreringType.Overtid50).Sum(t => t.TotalTimer),
                Overtid100 = g.Where(t => t.Type == TimeregistreringType.Overtid100).Sum(t => t.TotalTimer),
                Avspasering = g.Where(t => t.Type == TimeregistreringType.Avspasering).Sum(t => t.TotalTimer)
            })
            .OrderBy(m => m.MontorNavn)
            .ToList();
    }
}
