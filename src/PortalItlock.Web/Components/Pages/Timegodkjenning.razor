@page "/timegodkjenning"
@rendermode InteractiveServer
@* Prosjektledere godkjenner timene og fraværssøknadene til montørene sine,
   så siden er ikke lenger forbeholdt administratorer. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject TimeoversiktService TimeoversiktService
@inject VisningPreferanseService VisningPref

<PageTitle>Godkjenninger</PageTitle>
<KreverModulVakt Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer" />

@* Godkjenninger (godkjenninger-valgt.html, med kort): ett kort med fanene
   Timer (alle timelister som venter, med uka som åpnes på raden, og ukearket
   under Godkjent), Fravær (alle søknader, med kalender og melding på raden: søknader
   med kalender der hver dag kan godkjennes/avslås, og melding til montøren) og
   Oversikt (periode, lønnseksport, grafer, sammendrag og detaljer). *@
<div class="tg-kort @(_full ? "tg-full" : "")">
    <button type="button" class="tg-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>

    <div class="tg-topp">
        <div>
            <h1><span class="tg-hik"><Icon Name="check-circle" /></span>Godkjenninger</h1>
            <p>Timer og fraværssøknader samles her til godkjenning. Oversikt-fanen gir sammendrag og lønnseksport.</p>
        </div>
    </div>

    <div class="tg-faner">
        <button type="button" class="@(_aktivFane == "timer" ? "aktiv" : "")" @onclick='@(() => _aktivFane = "timer")'>
            <Icon Name="clock" />Timer
            @if (_timelister.Count > 0)
            {
                <i class="tg-teller">@_timelister.Count</i>
            }
        </button>
        <button type="button" class="@(_aktivFane == "fravar" ? "aktiv" : "")" @onclick='@(() => _aktivFane = "fravar")'>
            <Icon Name="sun" />Fravær
            @if (_totalVenterFravar > 0)
            {
                <i class="tg-teller tg-teller-bla">@_totalVenterFravar</i>
            }
        </button>
        <button type="button" class="@(_aktivFane == "oversikt" ? "aktiv" : "")" @onclick='@(() => _aktivFane = "oversikt")'>
            <Icon Name="file-text" />Oversikt
        </button>
    </div>

    @if (_aktivFane == "timer")
    {
        <div class="tg-ko-verktoy">
            @if (_koFilter != "godkjent")
            {
                <label class="tg-sokefelt">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk etter montør" aria-label="Søk etter montør" @bind="_koSok" @bind:event="oninput" @bind:after="LukkBekreft" />
                </label>
            }
            <div class="tg-valg">
                <button type="button" class="@(_koFilter == "venter" ? "aktiv" : "")" @onclick='@(() => VelgFilter("venter"))'>Venter <i>@_timelister.Count</i></button>
                <button type="button" class="@(_koFilter == "merknad" ? "aktiv" : "")" @onclick='@(() => VelgFilter("merknad"))'>Merknad <i>@_timelister.Count(t => !t.Klar)</i></button>
                <button type="button" class="@(_koFilter == "godkjent" ? "aktiv" : "")" @onclick='@(() => VelgFilter("godkjent"))'>Godkjent</button>
            </div>
        </div>

        @if (_koFilter != "godkjent")
        {
            var rader = VisteTimelister;
            var klare = rader.Where(t => t.Klar).ToList();
            var antallUker = rader.Select(t => t.Mandag).Distinct().Count();
            var nr = 0;
            <div class="tg-ok">
                <div class="tg-okt">
                    <span class="tg-okt-tittel">
                        @(_koFilter == "merknad" ? "Timelister med merknad" : "Timelister som venter")
                        @if (rader.Count > 0)
                        {
                            <small>@rader.Count @(rader.Count == 1 ? "timeliste" : "timelister") i @antallUker @(antallUker == 1 ? "uke" : "uker")</small>
                        }
                    </span>
                    @if (KanGodkjenne && klare.Count > 0)
                    {
                        @if (_bekreftAlle)
                        {
                            <span class="tg-bekreft">
                                <span>Godkjenne @klare.Count @(klare.Count == 1 ? "timeliste" : "timelister"), @FormatKort(klare.Sum(t => t.VenterTimer))?</span>
                                <button type="button" class="tg-kn" @onclick="LukkBekreft">Avbryt</button>
                                <button type="button" class="tg-kn tg-kn-g" @onclick="GodkjennAlleKlare"><Icon Name="check" />Ja, godkjenn</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => _bekreftAlle = true)"><Icon Name="check" />Godkjenn alle klare (@klare.Count)</button>
                        }
                    }
                </div>

                @if (rader.Count == 0)
                {
                    <p class="tg-ok-tom">@(_koFilter == "merknad" ? "Ingen timelister har merknad." : !string.IsNullOrWhiteSpace(_koSok) ? "Fant ingen montør med det navnet." : "Ingen timelister venter på godkjenning.")</p>
                }
                else
                {
                    <table class="tg-ko">
                        <thead>
                            <tr>
                                <th>Montør</th>
                                <th>Uke</th>
                                <th>Timer</th>
                                <th>Vurdering</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rad in rader)
                            {
                                var apen = _apenNokkel == rad.Nokkel;
                                var sone = nr++ % 2 == 1;
                                <tr class="tg-rad @(sone ? "tg-sone" : "") @(apen ? "tg-rad-apen" : "")" @key="rad.Nokkel" @onclick="@(() => VekslRad(rad))">
                                    <td data-felt="montor">
                                        <span class="tg-montor">
                                            <span class="tg-av" style="background:@Farge(rad.MontorId)">@Initialer(rad.Navn)</span>
                                            <b>@rad.Navn</b>
                                        </span>
                                    </td>
                                    <td data-felt="andre"><b>Uke @rad.Uke</b> <span class="tg-mut">@rad.Mandag.ToString("d.M", Kultur)–@rad.Mandag.AddDays(6).ToString("d.M", Kultur)</span></td>
                                    <td data-felt="tredje">
                                        <b>@FormatKort(rad.Timer)</b>
                                        @if (rad.VenterTimer != rad.Timer)
                                        {
                                            <small class="tg-mut">@FormatKort(rad.VenterTimer) venter</small>
                                        }
                                    </td>
                                    <td data-felt="vurdering">
                                        @if (rad.Klar)
                                        {
                                            <span class="tg-vurd tg-vurd-klar">Klar</span>
                                        }
                                        else
                                        {
                                            <span class="tg-vurd tg-vurd-merknad"><Icon Name="alert-triangle" />@rad.Merknader[0].Kort@(rad.Merknader.Count > 1 ? $" +{rad.Merknader.Count - 1}" : "")</span>
                                        }
                                    </td>
                                    <td class="tg-rad-knapper" data-felt="knapper" @onclick:stopPropagation="true">
                                        <button type="button" class="tg-kn" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VekslRad(rad))">@(apen ? "Lukk" : "Se")</button>
                                        @if (KanGodkjenne && rad.Klar && !apen)
                                        {
                                            <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => BehandleFlere(rad.VenterIder, TimeregistreringStatus.Godkjent))"><Icon Name="check" />Godkjenn</button>
                                        }
                                    </td>
                                </tr>
                                @if (apen)
                                {
                                    <tr class="tg-detalj" @key="@(rad.Nokkel + "-detalj")">
                                        <td colspan="5">
                                            @if (rad.Merknader.Count > 0)
                                            {
                                                <div class="tg-note">
                                                    <Icon Name="alert-triangle" />
                                                    <span>
                                                        @foreach (var mk in rad.Merknader)
                                                        {
                                                            <span>@mk.Tekst</span>
                                                        }
                                                    </span>
                                                </div>
                                            }

                                            <div class="tg-dg">
                                                @foreach (var dag in rad.Dager)
                                                {
                                                    var dagensRegs = rad.RegsPa(dag);
                                                    var dagensFravar = FravarPa(rad.Fravar, rad.MontorId, dag);
                                                    var dagTimer = dagensRegs.Where(r => r.Status != TimeregistreringStatus.Avslatt).Sum(r => r.TotalTimer);
                                                    <button type="button" class="tg-dgk tg-dgk-@CelleStatus(dagensRegs, dagensFravar) @(dagTimer > 10 ? "tg-dgk-lang" : "") @(_apenDato == dag ? "tg-dgk-valgt" : "")"
                                                            aria-pressed="@(_apenDato == dag ? "true" : "false")" @onclick="@(() => VekslDag(dag))">
                                                        <small>@KortDag(dag)</small>
                                                        @if (dagensRegs.Count > 0)
                                                        {
                                                            <b>@dagensRegs.Sum(r => r.TotalTimer).ToString("0.#", Kultur)</b>
                                                        }
                                                        else if (dagensFravar is not null)
                                                        {
                                                            <b class="tg-dgk-tekst">@dagensFravar.Type.Visningsnavn()</b>
                                                        }
                                                        else
                                                        {
                                                            <b>–</b>
                                                        }
                                                        @if (dagensRegs.Count > 0 && dagensFravar is not null)
                                                        {
                                                            <small>+ @dagensFravar.Type.Visningsnavn()</small>
                                                        }
                                                    </button>
                                                }
                                            </div>

                                            @if (_apenDato is DateTime apenDag && rad.Dager.Contains(apenDag))
                                            {
                                                var dagRegs = rad.RegsPa(apenDag);
                                                var dagFravar = FravarPa(rad.Fravar, rad.MontorId, apenDag);
                                                var dagVenterIder = dagRegs.Where(r => r.Status == TimeregistreringStatus.Venter).Select(r => r.Id).ToList();
                                                <div class="tg-dagdetalj">
                                                    <div class="tg-dagdetalj-hode">@apenDag.ToString("dddd d. MMMM", Kultur)</div>
                                                    <div class="tg-forklaring">
                                                        @foreach (var linje in Forklaring(dagRegs, dagFravar, apenDag))
                                                        {
                                                            <span class="tg-forklaring-@linje.Farge"><b>@linje.Tittel</b> @linje.Tekst</span>
                                                        }
                                                    </div>
                                                    @RegListe(dagRegs)
                                                    @if (KanGodkjenne && dagVenterIder.Count > 0 && dagVenterIder.Count < rad.VenterIder.Count)
                                                    {
                                                        <div class="tg-reg-knapper">
                                                            <button type="button" class="tg-kn tg-kn-s tg-kn-g" @onclick="@(() => BehandleFlere(dagVenterIder, TimeregistreringStatus.Godkjent))">✓ Godkjenn dag</button>
                                                            <button type="button" class="tg-kn tg-kn-s tg-kn-rod" @onclick="@(() => BehandleFlere(dagVenterIder, TimeregistreringStatus.Avslatt))">✕ Avslå dag</button>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <div class="tg-fot">
                                                <span>@rad.VenterIder.Count @(rad.VenterIder.Count == 1 ? "registrering venter" : "registreringer venter")@(_apenDato is null ? " · trykk på en dag for å se hva som er ført" : "")</span>
                                                @if (KanGodkjenne)
                                                {
                                                    <button type="button" class="tg-kn tg-kn-rod" @onclick="@(() => BehandleFlere(rad.VenterIder, TimeregistreringStatus.Avslatt))"><Icon Name="x" />Avslå</button>
                                                    <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => BehandleFlere(rad.VenterIder, TimeregistreringStatus.Godkjent))"><Icon Name="check" />Godkjenn</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
            var montorRader = UkeMontorer;
            var overtid = _ukeRegs.Where(r => r.Type is TimeregistreringType.Overtid50 or TimeregistreringType.Overtid100).Sum(r => r.TotalTimer);
            var merknadsdager = montorRader.Sum(m => UkeDager.Count(d => Merknader(m.Id, d).Count > 0));
            <div class="tg-kpi">
                <div class="tg-kpi-hoved">
                    <span class="tg-lbl">Timelister som venter</span>
                    <b>@montorRader.Count(m => _ukeRegs.Any(r => r.MontorId == m.Id && r.Status == TimeregistreringStatus.Venter)) av @montorRader.Count</b>
                    <small>montører i uke @_valgtUke</small>
                </div>
                <div class="tg-kpi-gul">
                    <span class="tg-lbl">Overtid i uka</span>
                    <b>@FormatTimer(overtid)</b>
                    <small>@(OvertidTekst())</small>
                </div>
                <div class="@(merknadsdager > 0 ? "tg-kpi-rod" : "")">
                    <span class="tg-lbl">Merknader</span>
                    <b>@merknadsdager</b>
                    <small>dager som bør sjekkes</small>
                </div>
                <div>
                    <span class="tg-lbl">Timer uke @_valgtUke</span>
                    <b>@FormatTimer(_ukeRegs.Sum(r => r.TotalTimer))</b>
                    <small>@_totalVenterTimer venter totalt</small>
                </div>
            </div>

            <div class="tg-verktoy">
                <div class="tg-ukenav">
                    <button type="button" class="tg-ik" @onclick="ForrigeUke" title="Forrige uke">&lsaquo;</button>
                    <span class="tg-velg-tekst">Uke @_valgtUke · @Mandag.ToString("d.", Kultur)–@Mandag.AddDays(6).ToString("d. MMM", Kultur)</span>
                    <button type="button" class="tg-ik" @onclick="NesteUke" title="Neste uke">&rsaquo;</button>
                </div>
                <select class="tg-velg" @bind="_montorId" @bind:after="LastKoAsync">
                    <option value="">Alle montører</option>
                    @foreach (var m in _montorer)
                    {
                        <option value="@m.Id">@m.Navn</option>
                    }
                </select>
                @if (!ErDenneUken)
                {
                    <button type="button" class="tg-kn tg-kn-s" @onclick="GaTilDenneUken">Denne uken</button>
                }
                @foreach (var u in _venterAndreUker.Take(4))
                {
                    <button type="button" class="tg-chip" title="Timer som venter i en annen uke" @onclick="@(() => GaTilUke(u.Ar, u.Uke))">Uke @u.Uke <i>@u.Antall venter</i></button>
                }
            </div>

            @if (montorRader.Count == 0)
            {
                <p class="list-empty">Ingen timer eller fravær registrert i uke @_valgtUke.</p>
            }
            else
            {
                <div class="tg-timer">
                    <div class="tg-ark">
                        <div class="tg-ark-rad tg-ark-hode">
                            <span>Montør</span>
                            @foreach (var d in UkeDager)
                            {
                                <span class="tg-midt @(d == DateTime.Today ? "tg-idag" : "")">@d.ToString("ddd d.M", Kultur)</span>
                            }
                            <span class="tg-midt">Sum</span>
                        </div>
                        @foreach (var m in montorRader)
                        {
                            var venter = _ukeRegs.Any(r => r.MontorId == m.Id && r.Status == TimeregistreringStatus.Venter);
                            var harMerknad = UkeDager.Any(d => Merknader(m.Id, d).Count > 0);
                            <div class="tg-ark-rad" @key="m.Id">
                                <span class="tg-montor">
                                    <span class="tg-av" style="background:@Farge(m.Id)">@Initialer(m.Navn)</span>
                                    <span>
                                        <b>@m.Navn</b>
                                        <small>@(!_ukeRegs.Any(r => r.MontorId == m.Id) ? "fravær" : !venter ? "✓ godkjent" : harMerknad ? "⚠ merknad" : "klar")</small>
                                    </span>
                                </span>
                                @foreach (var d in UkeDager)
                                {
                                    var dag = d;
                                    var timer = DagTimer(m.Id, dag);
                                    var ot = DagOvertid(m.Id, dag);
                                    var fravar = DagFravar(m.Id, dag);
                                    var valgt = _valgtMontorId == m.Id && _valgtDato == dag;
                                    <span class="tg-celle-wrap">
                                        <button type="button" class="tg-celle tg-celle-@CelleStatus(m.Id, dag) @(timer > 10 ? "tg-celle-lang" : "") @(valgt ? "tg-celle-valgt" : "")"
                                                title="@($"{m.Navn} {dag:dd.MM}")" @onclick="@(() => VelgDag(m.Id, dag))">
                                            @if (timer > 0)
                                            {
                                                @timer.ToString("0.#", Kultur)
                                            }
                                            else if (fravar is not null)
                                            {
                                                <span title="@fravar.Type.Visningsnavn()">☀</span>
                                            }
                                            else
                                            {
                                                <span class="tg-mut">·</span>
                                            }
                                            @if (ot > 0)
                                            {
                                                <small>+@ot.ToString("0.#", Kultur)</small>
                                            }
                                        </button>
                                    </span>
                                }
                                <b class="tg-midt">@_ukeRegs.Where(r => r.MontorId == m.Id).Sum(r => r.TotalTimer).ToString("0.#", Kultur)</b>
                            </div>
                        }
                    </div>

                    <div class="tg-dagboks">
                        @if (_valgtMontorId is int vm && _valgtDato is DateTime vd)
                        {
                            var montor = montorRader.FirstOrDefault(x => x.Id == vm);
                            var regs = DagRegs(vm, vd);
                            var fravar = DagFravar(vm, vd);
                            <div class="tg-dag-hode">
                                <span class="tg-av tg-av-stor" style="background:@Farge(vm)">@Initialer(montor?.Navn)</span>
                                <span>
                                    <b>@(montor?.Navn ?? "-")</b>
                                    <small>@vd.ToString("dddd d. MMMM", Kultur) · @(regs.Count > 0 ? FormatTimer(regs.Sum(r => r.TotalTimer)) : fravar?.Type.Visningsnavn() ?? "ingen timer")</small>
                                </span>
                            </div>
                            <div class="tg-dag-nav">
                                <button type="button" class="tg-kn tg-kn-s" disabled="@(vd <= Mandag)" @onclick="@(() => VelgDag(vm, vd.AddDays(-1)))">&lsaquo; @vd.AddDays(-1).ToString("ddd", Kultur)</button>
                                <button type="button" class="tg-kn tg-kn-s" disabled="@(vd >= Mandag.AddDays(6))" @onclick="@(() => VelgDag(vm, vd.AddDays(1)))">@vd.AddDays(1).ToString("ddd", Kultur) &rsaquo;</button>
                            </div>

                            <div class="tg-forklaring">
                                @foreach (var f in Forklaring(regs, fravar, vd))
                                {
                                    <span class="tg-forklaring-@f.Farge"><b>@f.Tittel</b> @f.Tekst</span>
                                }
                            </div>

                            @RegListe(regs)

                            @if (KanGodkjenne)
                            {
                                var dagVenter = regs.Where(r => r.Status == TimeregistreringStatus.Venter).Select(r => r.Id).ToList();
                                var ukeVenter = _ukeRegs.Where(r => r.MontorId == vm && r.Status == TimeregistreringStatus.Venter).Select(r => r.Id).ToList();
                                @if (dagVenter.Count > 0)
                                {
                                    <div class="tg-dag-knapper">
                                        <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => BehandleFlere(dagVenter, TimeregistreringStatus.Godkjent))">✓ Godkjenn dag</button>
                                        <button type="button" class="tg-kn tg-kn-rod" @onclick="@(() => BehandleFlere(dagVenter, TimeregistreringStatus.Avslatt))">✕ Avslå dag</button>
                                    </div>
                                }
                                @if (ukeVenter.Count > dagVenter.Count)
                                {
                                    <button type="button" class="tg-kn tg-kn-s" @onclick="@(() => BehandleFlere(ukeVenter, TimeregistreringStatus.Godkjent))">✓ Godkjenn hele uka til @(montor?.Navn.Split(' ')[0]) (@ukeVenter.Count)</button>
                                }
                            }
                        }
                        else
                        {
                            <p class="tg-mut">Trykk på en dag i arket for å se registreringene og godkjenne.</p>
                        }
                    </div>
                </div>
                <p class="tg-hint">Gul = venter · grønn = godkjent · rød = avslått · blå = fravær · rød ramme = over 10 timer · +1,5 = timer ført som overtid</p>
            }
        }
    }
    else if (_aktivFane == "fravar")
    {
        <div class="tg-ko-verktoy">
            <label class="tg-sokefelt">
                <Icon Name="search" />
                <input type="search" placeholder="Søk etter montør" aria-label="Søk etter montør" @bind="_fravarSok" @bind:event="oninput" @bind:after="LukkBekreftFravar" />
            </label>
            <div class="tg-valg">
                <button type="button" class="@(_fravarFilter == "venter" ? "aktiv" : "")" @onclick='@(() => VelgFravarFilter("venter"))'>Venter <i>@_soknader.Count</i></button>
                <button type="button" class="@(_fravarFilter == "merknad" ? "aktiv" : "")" @onclick='@(() => VelgFravarFilter("merknad"))'>Merknad <i>@_soknader.Count(x => !x.Klar)</i></button>
                <button type="button" class="@(_fravarFilter == "behandlet" ? "aktiv" : "")" @onclick='@(() => VelgFravarFilter("behandlet"))'>Behandlet</button>
            </div>
        </div>

        @if (_fravarFilter == "behandlet")
        {
            var behandlede = VisteBehandlede;
            var nr = 0;
            <div class="tg-ok">
                <div class="tg-okt">
                    <span class="tg-okt-tittel">Behandlede søknader<small>de siste @_behandlede.Count</small></span>
                </div>
                @if (behandlede.Count == 0)
                {
                    <p class="tg-ok-tom">@(string.IsNullOrWhiteSpace(_fravarSok) ? "Ingen søknader er behandlet ennå." : "Fant ingen montør med det navnet.")</p>
                }
                else
                {
                    <table class="tg-ko">
                        <thead>
                            <tr>
                                <th>Montør</th>
                                <th>Type</th>
                                <th>Periode</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in behandlede)
                            {
                                var sone = nr++ % 2 == 1;
                                <tr class="tg-rad tg-rad-rolig @(sone ? "tg-sone" : "")" @key="f.Id">
                                    <td data-felt="montor">
                                        <span class="tg-montor">
                                            <span class="tg-av" style="background:@Farge(f.BrukerId)">@Initialer(f.Bruker?.Navn)</span>
                                            <b>@(f.Bruker?.Navn ?? "-")</b>
                                        </span>
                                    </td>
                                    <td data-felt="andre"><span class="tg-type @(f.Type == FravarType.Ferie ? "" : "tg-type-annen")">@f.Type.Visningsnavn()</span></td>
                                    <td data-felt="tredje">
                                        <b>@PeriodeKort(f)</b>
                                        <small class="tg-mut">@DagerTekst(f)</small>
                                    </td>
                                    <td data-felt="vurdering">
                                        <span class="tg-pill tg-pill-@(f.Status == FravarStatus.Godkjent ? "godkjent" : "avslatt")">@f.Status.Visningsnavn()</span>
                                        @if (f.BehandletDato is DateTime behandlet)
                                        {
                                            <small class="tg-mut">@behandlet.ToString("d.M.yyyy", Kultur)</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(f.AvslagsBegrunnelse))
                                        {
                                            <small class="tg-mut">@f.AvslagsBegrunnelse</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
            var rader = VisteSoknader;
            var klare = rader.Where(x => x.Klar).ToList();
            var antallMontorer = rader.Select(x => x.Soknad.BrukerId).Distinct().Count();
            var nr = 0;
            <div class="tg-ok">
                <div class="tg-okt">
                    <span class="tg-okt-tittel">
                        @(_fravarFilter == "merknad" ? "Søknader med merknad" : "Søknader som venter")
                        @if (rader.Count > 0)
                        {
                            <small>@rader.Count @(rader.Count == 1 ? "søknad" : "søknader") fra @antallMontorer @(antallMontorer == 1 ? "montør" : "montører")</small>
                        }
                    </span>
                    @if (KanGodkjenne && klare.Count > 0)
                    {
                        @if (_bekreftAlleFravar)
                        {
                            <span class="tg-bekreft">
                                <span>Godkjenne @klare.Count @(klare.Count == 1 ? "søknad" : "søknader")?</span>
                                <button type="button" class="tg-kn" @onclick="LukkBekreftFravar">Avbryt</button>
                                <button type="button" class="tg-kn tg-kn-g" @onclick="GodkjennAlleKlareFravar"><Icon Name="check" />Ja, godkjenn</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => _bekreftAlleFravar = true)"><Icon Name="check" />Godkjenn alle klare (@klare.Count)</button>
                        }
                    }
                </div>

                @if (rader.Count == 0)
                {
                    <p class="tg-ok-tom">@(!string.IsNullOrWhiteSpace(_fravarSok) ? "Fant ingen montør med det navnet." : _fravarFilter == "merknad" ? "Ingen søknader har merknad." : "Ingen fraværssøknader venter på godkjenning.")</p>
                }
                else
                {
                    <table class="tg-ko">
                        <thead>
                            <tr>
                                <th>Montør</th>
                                <th>Type</th>
                                <th>Periode</th>
                                <th>Vurdering</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rad in rader)
                            {
                                var s = rad.Soknad;
                                var apen = _valgtFravarId == s.Id;
                                var sone = nr++ % 2 == 1;
                                <tr class="tg-rad @(sone ? "tg-sone" : "") @(apen ? "tg-rad-apen" : "")" @key="s.Id" @onclick="@(() => VekslSoknad(s.Id))">
                                    <td data-felt="montor">
                                        <span class="tg-montor">
                                            <span class="tg-av" style="background:@Farge(s.BrukerId)">@Initialer(s.Bruker?.Navn)</span>
                                            <b>@(s.Bruker?.Navn ?? "-")</b>
                                        </span>
                                    </td>
                                    <td data-felt="andre"><span class="tg-type @(s.Type == FravarType.Ferie ? "" : "tg-type-annen")">@s.Type.Visningsnavn()</span></td>
                                    <td data-felt="tredje">
                                        <b>@PeriodeKort(s)</b>
                                        <small class="tg-mut tg-klipp">@DagerTekst(s)@(string.IsNullOrWhiteSpace(s.Kommentar) ? "" : $" · {s.Kommentar}")</small>
                                    </td>
                                    <td data-felt="vurdering">
                                        @if (rad.Klar)
                                        {
                                            <span class="tg-vurd tg-vurd-klar">Klar</span>
                                        }
                                        else
                                        {
                                            <span class="tg-vurd tg-vurd-merknad"><Icon Name="alert-triangle" />@rad.Merknader[0].Kort@(rad.Merknader.Count > 1 ? $" +{rad.Merknader.Count - 1}" : "")</span>
                                        }
                                    </td>
                                    <td class="tg-rad-knapper" data-felt="knapper" @onclick:stopPropagation="true">
                                        <button type="button" class="tg-kn" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VekslSoknad(s.Id))">@(apen ? "Lukk" : "Se")</button>
                                        @if (KanGodkjenne && rad.Klar && !apen)
                                        {
                                            <button type="button" class="tg-kn tg-kn-g" @onclick="@(() => GodkjennSoknad(s.Id))"><Icon Name="check" />Godkjenn</button>
                                        }
                                    </td>
                                </tr>
                                @if (apen)
                                {
                                    var andre = AndreBorte(s);
                                    var fornavn = Fornavn(s.Bruker?.Navn);
                                    var antallGodkjent = _dagValg.Count(x => x.Value);
                                    var antallAvslatt = _dagValg.Count(x => !x.Value);
                                    <tr class="tg-detalj" @key="@($"{s.Id}-detalj")">
                                        <td colspan="5">
                                            @if (rad.Merknader.Count > 0)
                                            {
                                                <div class="tg-note">
                                                    <Icon Name="alert-triangle" />
                                                    <span>
                                                        @foreach (var mk in rad.Merknader)
                                                        {
                                                            <span>@mk.Tekst</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="tg-gnote">
                                                    <Icon Name="check" />
                                                    <span>Ingen andre er borte disse dagene@(s.HeleDagen ? $", og {fornavn} har ikke ført timer da." : ".")</span>
                                                </div>
                                            }

                                            <div class="tg-kalrad">
                                            <div class="tg-kalendere">
                                                @foreach (var mnd in Maneder(s))
                                                {
                                                    <div class="tg-kal">
                                                        <b>@mnd.ToString("MMMM yyyy", Kultur)</b>
                                                        <div class="tg-kal-grid">
                                                            @foreach (var u in new[] { "M", "T", "O", "T", "F", "L", "S" })
                                                            {
                                                                <span class="tg-kal-ukedag">@u</span>
                                                            }
                                                            @for (var i = 0; i < ((int)mnd.DayOfWeek + 6) % 7; i++)
                                                            {
                                                                <span></span>
                                                            }
                                                            @for (var dag = mnd; dag.Month == mnd.Month; dag = dag.AddDays(1))
                                                            {
                                                                var d = dag;
                                                                var iPerioden = d >= s.FraDato.Date && d <= s.TilDato.Date;
                                                                var harValg = _dagValg.TryGetValue(d, out var godkjent);
                                                                var annen = andre.Any(a => d >= a.FraDato.Date && d <= a.TilDato.Date);
                                                                var klasse = harValg ? (godkjent ? "tg-kal-godkjent" : "tg-kal-avslatt") : iPerioden ? "tg-kal-periode" : ErHelg(d) ? "tg-kal-helg" : "";
                                                                @if (harValg && KanGodkjenne && _dagValg.Count > 1)
                                                                {
                                                                    <button type="button" class="tg-kal-dag @klasse" title="@(godkjent ? "Godkjent - trykk for å avslå" : "Avslått - trykk for å godkjenne")" @onclick="@(() => _dagValg[d] = !_dagValg[d])">
                                                                        @d.Day
                                                                        @if (annen) { <i class="tg-kal-annen"></i> }
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="tg-kal-dag @klasse">
                                                                        @d.Day
                                                                        @if (annen) { <i class="tg-kal-annen"></i> }
                                                                    </span>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                                <div class="tg-kalside">
                                                    @if (KanGodkjenne && _dagValg.Count > 1)
                                                    {
                                                        <div class="tg-kal-forklaring">
                                                            <span><i class="tg-prikk tg-prikk-gronn"></i>Godkjent (@antallGodkjent)</span>
                                                            <span><i class="tg-prikk tg-prikk-rod"></i>Avslått (@antallAvslatt)</span>
                                                        </div>
                                                        <span class="tg-mut">Trykk på en dag for å avslå bare den.</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(s.Kommentar))
                                                    {
                                                        <span class="tg-kommentar">💬 «@s.Kommentar»</span>
                                                    }
                                                    <span class="tg-mut">Sendt @s.OpprettetDato.ToString("d.M.yyyy", Kultur)@(s.HeleDagen ? "" : $" · {s.StartTid:HH:mm}–{s.SluttTid:HH:mm}")</span>
                                                </div>
                                            </div>

                                            @if (KanGodkjenne)
                                            {
                                                <label class="tg-melding">
                                                    <span class="tg-lbl">Melding til @fornavn@(antallAvslatt > 0 ? "" : " (valgfritt)")</span>
                                                    <textarea rows="2" @bind="_avslagsBegrunnelse" @bind:event="oninput" placeholder="@(antallAvslatt > 0 ? "Forklar hvorfor - f.eks. at noen andre også er borte da" : "Vises for montøren hvis noe avslås")"></textarea>
                                                </label>
                                            }

                                            <div class="tg-fot">
                                                <span>@DagerTekst(s)</span>
                                                @if (KanGodkjenne)
                                                {
                                                    @if (antallAvslatt == 0)
                                                    {
                                                        <button type="button" class="tg-kn tg-kn-rod" @onclick="AvslaAlleDager"><Icon Name="x" />Avslå</button>
                                                        <button type="button" class="tg-kn tg-kn-g" @onclick="LagreFravar"><Icon Name="check" />Godkjenn@(_dagValg.Count > 1 ? $" alle {_dagValg.Count} dager" : "")</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="tg-kn" @onclick="NullstillDagValg">Nullstill</button>
                                                        @if (antallGodkjent == 0)
                                                        {
                                                            <button type="button" class="tg-kn tg-kn-rod" @onclick="LagreFravar"><Icon Name="x" />Avslå søknaden</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="tg-kn tg-kn-g" @onclick="LagreFravar"><Icon Name="check" />Lagre: @antallGodkjent godkjent, @antallAvslatt avslått</button>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
    else
    {
        var ovRader = _sammendrag;
        var ovNr = 0;
        <div class="tg-verktoy">
            <div class="tg-ukenav">
                <button type="button" class="tg-ik" @onclick="ForrigeMaaned" title="Forrige måned">&lsaquo;</button>
                <span class="tg-velg-tekst tg-maaned">@PeriodeTekst</span>
                <button type="button" class="tg-ik" @onclick="NesteMaaned" title="Neste måned">&rsaquo;</button>
            </div>
            <select class="tg-velg" @bind="_oversiktMontorId" @bind:after="LoadOversiktAsync">
                <option value="">Alle montører</option>
                @foreach (var m in _montorer)
                {
                    <option value="@m.Id">@m.Navn</option>
                }
            </select>
            <button type="button" class="tg-kn @(_periode == "egen" ? "tg-kn-valgt" : "")" aria-pressed="@(_periode == "egen" ? "true" : "false")" @onclick="VekslEgenPeriode">Egen periode</button>
            @if (_periode == "egen")
            {
                <input type="date" class="tg-velg" value="@_fraDato.ToString("yyyy-MM-dd")" @onchange="OnFraDatoChanged" title="Fra dato" aria-label="Fra dato" />
                <span class="tg-mut">–</span>
                <input type="date" class="tg-velg" value="@_tilDato.ToString("yyyy-MM-dd")" @onchange="OnTilDatoChanged" title="Til dato" aria-label="Til dato" />
            }
            <div class="tg-verktoy-hoyre">
                <a class="tg-kn" href="@CsvUrl" target="_blank"><Icon Name="download" />CSV</a>
                <button type="button" class="tg-kn tg-kn-p" @onclick="@(() => _pdfPreviewUrl = PdfUrl)"><Icon Name="file-text" />Lønnsgrunnlag PDF</button>
            </div>
        </div>

        <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av timeoversikt" OnClose="@(() => _pdfPreviewUrl = null)" />

        @if (VenterTimerPerioden > 0)
        {
            <div class="tg-vr">
                <Icon Name="alert-triangle" />
                <span>@FormatKort(VenterTimerPerioden) venter på godkjenning. Bare godkjente timer tas med i eksporten.</span>
                <button type="button" class="tg-kn" @onclick='@(() => _aktivFane = "timer")'>Gå til Timer</button>
            </div>
        }

        <div class="tg-stripe">
            <div>
                <span>Timer i perioden</span>
                <b>@FormatKort(TotaltTimerPerioden)</b>
                <small>@ovRader.Count @(ovRader.Count == 1 ? "montør" : "montører")</small>
            </div>
            <div>
                <span>Godkjent</span>
                <b class="tg-stripe-gronn">@FormatKort(GodkjentTimerPerioden)</b>
                <small>@(TotaltTimerPerioden == 0 ? "–" : $"{Math.Round(GodkjentTimerPerioden * 100 / TotaltTimerPerioden)} %") av timene</small>
            </div>
            <div>
                <span>Venter</span>
                <b class="@(VenterTimerPerioden > 0 ? "tg-stripe-gul" : "")">@FormatKort(VenterTimerPerioden)</b>
                <small>@(VenterTimerPerioden > 0 ? "må godkjennes før lønn" : "ingenting venter")</small>
            </div>
            <div>
                <span>Kjørt</span>
                <b>@_oversiktRegistreringer.Sum(t => t.Kilometer).ToString("N0", Kultur) km</b>
                <small>til kilometergodtgjørelse</small>
            </div>
        </div>

        <div class="tg-ok">
            <div class="tg-okt">
                <span class="tg-okt-tittel">Per montør<small>trykk på en montør for å se ukene</small></span>
            </div>

            @if (ovRader.Count == 0)
            {
                <p class="tg-ok-tom">Ingen timer registrert i perioden.</p>
            }
            else
            {
                <table class="tg-ko">
                    <thead>
                        <tr>
                            <th>Montør</th>
                            <th class="tg-n">Timer</th>
                            <th class="tg-n">Venter</th>
                            <th class="tg-n">Overtid</th>
                            <th class="tg-n">Kjørt</th>
                            <th>Godkjent</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in ovRader)
                        {
                            var apen = _apenMontorId == m.MontorId;
                            var sone = ovNr++ % 2 == 1;
                            var andel = m.Totalt == 0 ? 0 : (int)Math.Round(m.Godkjent * 100 / m.Totalt);
                            <tr class="tg-rad @(sone ? "tg-sone" : "") @(apen ? "tg-rad-apen" : "")" @key="m.MontorId" @onclick="@(() => VekslMontor(m.MontorId))">
                                <td data-felt="montor">
                                    <span class="tg-montor">
                                        <span class="tg-av" style="background:@Farge(m.MontorId)">@Initialer(m.MontorNavn)</span>
                                        <b>@m.MontorNavn</b>
                                    </span>
                                </td>
                                <td class="tg-n" data-felt="andre"><b>@FormatKort(m.Totalt)</b></td>
                                <td class="tg-n @(m.Venter > 0 ? "tg-venter-tall" : "tg-mut")" data-felt="tredje">@FormatKort(m.Venter)<span class="tg-kun-smal"> venter</span></td>
                                <td class="tg-n @(m.Overtid > 0 ? "" : "tg-mut")" data-felt="skjul">@(m.Overtid > 0 ? FormatKort(m.Overtid) : "–")</td>
                                <td class="tg-n" data-felt="skjul">@m.Km.ToString("N0", Kultur) km</td>
                                <td data-felt="vurdering">
                                    <span class="tg-bar"><u><i style="width:@andel%"></i></u><b>@andel %</b></span>
                                </td>
                                <td class="tg-rad-knapper" data-felt="knapper" @onclick:stopPropagation="true">
                                    <button type="button" class="tg-kn" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VekslMontor(m.MontorId))">@(apen ? "Lukk" : "Se")</button>
                                </td>
                            </tr>
                            @if (apen)
                            {
                                var montorRegs = _oversiktRegistreringer.Where(t => t.MontorId == m.MontorId).ToList();
                                <tr class="tg-detalj" @key="@($"{m.MontorId}-detalj")">
                                    <td colspan="7">
                                        <table class="tg-ut">
                                            <thead>
                                                <tr>
                                                    <th>Uke</th>
                                                    <th class="tg-n">Timer</th>
                                                    <th class="tg-n">Kjørt</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in montorRegs.GroupBy(t => (Ar: ISOWeek.GetYear(t.Dato), Uke: ISOWeek.GetWeekOfYear(t.Dato))).OrderBy(g => g.Key.Ar).ThenBy(g => g.Key.Uke))
                                                {
                                                    var mandag = ISOWeek.ToDateTime(u.Key.Ar, u.Key.Uke, DayOfWeek.Monday);
                                                    var ukeVenter = u.Where(t => t.Status == TimeregistreringStatus.Venter).Sum(t => t.TotalTimer);
                                                    <tr>
                                                        <td><b>Uke @u.Key.Uke</b> <span class="tg-mut">@mandag.ToString("d.M", Kultur)–@mandag.AddDays(6).ToString("d.M", Kultur)</span></td>
                                                        <td class="tg-n"><b>@FormatKort(u.Sum(t => t.TotalTimer))</b></td>
                                                        <td class="tg-n">@u.Sum(t => t.Kilometer).ToString("N0", Kultur) km</td>
                                                        <td>
                                                            @if (ukeVenter > 0)
                                                            {
                                                                <span class="tg-vurd tg-vurd-merknad">@FormatKort(ukeVenter) venter</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="tg-vurd tg-vurd-klar">Godkjent</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                        @if (_visRegistreringer)
                                        {
                                            <table class="tg-ut tg-ut-regs">
                                                <thead>
                                                    <tr>
                                                        <th>Dato</th>
                                                        <th>Arbeidsordre</th>
                                                        <th>Type</th>
                                                        <th class="tg-n">Timer</th>
                                                        <th>Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var t in montorRegs)
                                                    {
                                                        <tr @key="t.Id">
                                                            <td>@t.Dato.ToString("dd.MM.yyyy")</td>
                                                            <td>@t.Arbeidsordre?.Tittel</td>
                                                            <td>@t.Type.Visningsnavn()</td>
                                                            <td class="tg-n"><b>@FormatKort(t.TotalTimer)</b></td>
                                                            <td><span class="tg-pill tg-pill-@StatusCss(t.Status)">@t.Status.Visningsnavn()</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }

                                        <div class="tg-fot">
                                            <span>@FordelingTekst(m, montorRegs.Count)</span>
                                            <button type="button" class="tg-kn" @onclick="@(() => _visRegistreringer = !_visRegistreringer)">@(_visRegistreringer ? "Skjul registreringene" : "Se alle registreringer")</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Totalt</td>
                            <td class="tg-n">@FormatKort(TotaltTimerPerioden)</td>
                            <td class="tg-n">@FormatKort(VenterTimerPerioden)</td>
                            <td class="tg-n">@(OvertidTimerPerioden > 0 ? FormatKort(OvertidTimerPerioden) : "–")</td>
                            <td class="tg-n">@_oversiktRegistreringer.Sum(t => t.Kilometer).ToString("N0", Kultur) km</td>
                            <td>
                                <span class="tg-bar"><u><i style="width:@(TotaltTimerPerioden == 0 ? 0 : (int)Math.Round(GodkjentTimerPerioden * 100 / TotaltTimerPerioden))%"></i></u><b>@(TotaltTimerPerioden == 0 ? 0 : (int)Math.Round(GodkjentTimerPerioden * 100 / TotaltTimerPerioden)) %</b></span>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    }
</div>

@code {
    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class MontorSum
    {
        public int MontorId { get; set; }
        public string MontorNavn { get; set; } = "";
        public decimal Normal { get; set; }
        public decimal Overtid50 { get; set; }
        public decimal Overtid100 { get; set; }
        public decimal Avspasering { get; set; }
        public decimal Godkjent { get; set; }
        public decimal Venter { get; set; }
        public decimal Km { get; set; }
        public decimal Overtid => Overtid50 + Overtid100;
        public decimal Totalt => Normal + Overtid50 + Overtid100 + Avspasering;
    }

    private sealed record Forklaringslinje(string Farge, string Tittel, string Tekst);
    private sealed record VentendeUke(int Ar, int Uke, int Antall);
    private sealed record Merknad(string Kort, string Tekst);

    private sealed record Soknadsrad(FravarSoknad Soknad, List<Merknad> Merknader)
    {
        public bool Klar => Merknader.Count == 0;
    }

    // Én montør sin uke: alle registreringene i uka, også de som alt er behandlet,
    // så dagrutene viser hele uka selv om bare én dag venter.
    private sealed record Timeliste(string Nokkel, int MontorId, string Navn, int Ar, int Uke, DateTime Mandag,
        List<Models.Timeregistrering> Regs, List<FravarSoknad> Fravar, List<Merknad> Merknader)
    {
        public bool Klar => Merknader.Count == 0;
        public IEnumerable<DateTime> Dager => Enumerable.Range(0, 7).Select(i => Mandag.AddDays(i));
        public decimal Timer => Regs.Where(r => r.Status != TimeregistreringStatus.Avslatt).Sum(r => r.TotalTimer);
        public decimal VenterTimer => Regs.Where(r => r.Status == TimeregistreringStatus.Venter).Sum(r => r.TotalTimer);
        public List<int> VenterIder => Regs.Where(r => r.Status == TimeregistreringStatus.Venter).Select(r => r.Id).ToList();
        public List<Models.Timeregistrering> RegsPa(DateTime dag) => Regs.Where(r => r.Dato.Date == dag.Date).OrderBy(r => r.Start).ToList();
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Paletten = ["#835e41", "#2054a3", "#2b7a4b", "#7a2b96", "#a1690a", "#b5502d", "#3a6fb5"];

    [SupplyParameterFromQuery(Name = "fane")] private string? FaneFraQuery { get; set; }

    private string _aktivFane = "timer";
    private bool _full;
