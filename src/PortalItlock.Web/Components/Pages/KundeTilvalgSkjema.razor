@page "/kunde/tilvalg/{Id:int}"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>@(_tilvalg?.Tittel ?? "Tilvalg")</PageTitle>

@if (_ikkeFunnet)
{
    <p class="dp-feil">Fant ikke tilvalget, eller det tilhører ikke deg.</p>
    <a class="dp-tilbake" href="/kunde"><Icon Name="arrow-left" />Tilbake</a>
}
else if (_tilvalg is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    <a class="dp-tilbake" href="/kunde"><Icon Name="arrow-left" />Hjem</a>
    <div class="dp-hei">
        <h1>@_tilvalg.Tittel</h1>
        <p>@_tilvalg.Prosjekt?.Navn</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_tilvalg.Beskrivelse))
    {
        <div class="dp-kort dp-rapport"><p>@_tilvalg.Beskrivelse</p></div>
    }

    @if (_tilvalg.Status == TilvalgStatus.Besvart)
    {
        <div class="dp-kort dp-kvittering" style="padding:1.2rem 1rem">
            <div class="dp-hake"><Icon Name="check" /></div>
            <h1 style="font-size:1.3rem">Valgene dine er sendt</h1>
            <p>Du sendte inn @_tilvalg.BesvartDato?.ToString("dd.MM.yyyy 'kl.' HH:mm"). Totalsum: <b>@(_tilvalg.SumTotal?.ToString("N2")) kr eks. mva</b></p>
        </div>

        <div class="tilvalg-alternativ-liste">
            @foreach (var alt in _tilvalg.Alternativer.OrderBy(a => a.Rekkefolge))
            {
                <div @key="alt.Id" class="tilvalg-alternativ-kort @(alt.ValgtAntall > 0 ? "tilvalg-alternativ-valgt" : "")">
                    @if (alt.BildeData is not null)
                    {
                        <img src="@($"/tilvalgalternativ/{alt.Id}/bilde")" alt="@alt.Navn" />
                    }
                    <div class="tilvalg-alternativ-tekst">
                        <strong>@alt.Navn</strong>
                        @if (!string.IsNullOrWhiteSpace(alt.Utforelse))
                        {
                            <span>@alt.Utforelse</span>
                        }
                        <span>@alt.Pris.ToString("N2") kr/stk</span>
                        @if (alt.ValgtAntall > 0)
                        {
                            <span class="dp-tag dp-t-gronn"><Icon Name="check" />Valgt: @alt.ValgtAntall stk</span>
                        }
                        else
                        {
                            <span class="tilvalg-ikke-valgt">Ikke valgt</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_tilvalg.KundeOnskeTekst) || _tilvalg.KundeOnskeBildeData is not null)
        {
            <div class="dp-kort dp-rapport">
                <h3>Ditt eget ønske</h3>
                @if (!string.IsNullOrWhiteSpace(_tilvalg.KundeOnskeTekst))
                {
                    <p>@_tilvalg.KundeOnskeTekst</p>
                }
                @if (_tilvalg.KundeOnskeBildeData is not null)
                {
                    <img src="@($"/tilvalg/{_tilvalg.Id}/kundebilde")" alt="Referansebilde" class="tilvalg-eget-onske-bilde" />
                }
            </div>
        }
    }
    else
    {
        <div class="dp-seksjon-t"><h2>Velg det du vil ha</h2><span>@_valg.Count alternativer</span></div>
        <div class="tilvalg-alternativ-liste">
            @foreach (var v in _valg)
            {
                <div @key="v.AlternativId" class="tilvalg-alternativ-kort @(v.Valgt ? "tilvalg-alternativ-valgt" : "")">
                    @if (v.HarBilde)
                    {
                        <img src="@($"/tilvalgalternativ/{v.AlternativId}/bilde")" alt="@v.Navn" />
                    }
                    <div class="tilvalg-alternativ-tekst">
                        <strong>@v.Navn</strong>
                        @if (!string.IsNullOrWhiteSpace(v.Utforelse))
                        {
                            <span>@v.Utforelse</span>
                        }
                        <span>@v.Pris.ToString("N2") kr/stk</span>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="v.Valgt" @bind:after="OppdaterSum" />
                            Jeg vil ha denne
                        </label>
                        @if (v.Valgt)
                        {
                            <label class="tilvalg-antall-felt">
                                Antall
                                <input type="number" min="1" @bind="v.Antall" @bind:event="oninput" @bind:after="OppdaterSum" />
                            </label>
                            <span class="tilvalg-linjesum">@((v.Pris * Math.Max(1, v.Antall)).ToString("N2")) kr</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="dp-to-kol">
            <div class="dp-kol">
                <div class="dp-kort dp-skjema">
                    <h2 style="margin:0;font-size:1.05rem;font-weight:600">Har du et eget ønske?</h2>
                    <p style="margin:0;color:var(--dp-dempet);font-size:.88rem">Skriv en beskrivelse og/eller last opp et referansebilde, i tillegg til alternativene over.</p>
                    <textarea class="dp-tekstfelt" rows="3" @bind="_onskeTekst" @bind:event="oninput" placeholder="Beskriv ønsket ditt her..."></textarea>
                    <div class="dp-filer">
                        @if (_onskeBildeData is not null)
                        {
                            <div class="dp-fil"><img src="@($"data:{_onskeBildeContentType};base64,{Convert.ToBase64String(_onskeBildeData)}")" alt="Referansebilde" /><button type="button" title="Fjern" @onclick="@(() => { _onskeBildeData = null; _onskeBildeContentType = null; })">&times;</button></div>
                        }
                        <label class="dp-fil-ny"><Icon Name="camera" />Referansebilde<InputFile OnChange="LastOppOnskeBilde" accept="image/*" /></label>
                    </div>
                </div>
            </div>

            <div class="dp-kol">
                <div class="dp-kort dp-prisboks">
                    <div class="dp-ln dp-sum"><span>Sum så langt</span><span>@_sum.ToString("N2") kr</span></div>
                    <small style="color:var(--dp-dempet)">Eks. mva</small>
                </div>
                <div class="dp-kort dp-skjema">
                    <h2 style="margin:0;font-size:1.05rem;font-weight:600">Send inn</h2>
                    <p style="margin:0;color:var(--dp-dempet);font-size:.88rem">Signer under for å bekrefte valgene dine og sende dem til oss.</p>
                    <span class="dp-lbl">Fullt navn</span>
                    <input class="dp-felt" @bind="_signertAvNavn" @bind:event="oninput" placeholder="Fullt navn" />
                    <span class="dp-lbl">Signer med fingeren eller musen</span>
                    <div class="dp-signatur"><canvas id="sig-canvas-tilvalg" width="500" height="180"></canvas></div>
                    @if (!string.IsNullOrEmpty(_feil))
                    {
                        <p class="dp-feil">@_feil</p>
                    }
                    <div class="dp-send-rad dp-knapperad">
                        <button type="button" class="dp-send dp-send-sekundar" @onclick="RensSignatur">Tøm</button>
                        <button type="button" class="dp-send" style="background:var(--dp-gronn)" @onclick="SendInn"><Icon Name="send" />Send inn</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class AlternativValg
    {
        public int AlternativId { get; set; }
        public required string Navn { get; set; }
        public string? Utforelse { get; set; }
        public decimal Pris { get; set; }
        public bool HarBilde { get; set; }
        public bool Valgt { get; set; }
        public int Antall { get; set; } = 1;
    }

    private Tilvalg? _tilvalg;
    private bool _ikkeFunnet;
    private List<AlternativValg> _valg = [];
    private decimal _sum;
    private string _signertAvNavn = "";
    private string? _feil;
    private bool _canvasInitialisert;
    private string _onskeTekst = "";
    private byte[]? _onskeBildeData;
    private string? _onskeBildeContentType;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            _ikkeFunnet = true;
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Kunde).FirstOrDefaultAsync(b => b.Id == brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeFunnet = true;
            return;
        }

        var tilvalg = await Db.Tilvalg
            .Include(t => t.Prosjekt)
            .Include(t => t.Alternativer)
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (tilvalg?.Prosjekt?.KundeId != bruker.KundeId || tilvalg.Status == TilvalgStatus.Utkast)
        {
            _ikkeFunnet = true;
            return;
        }

        _tilvalg = tilvalg;
        _signertAvNavn = bruker.Kunde?.Navn ?? "";

        if (_valg.Count == 0)
        {
            _valg = tilvalg.Alternativer.OrderBy(a => a.Rekkefolge).Select(a => new AlternativValg
            {
                AlternativId = a.Id,
                Navn = a.Navn,
                Utforelse = a.Utforelse,
                Pris = a.Pris,
                HarBilde = a.BildeData is not null
            }).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_canvasInitialisert && _tilvalg is not null && _tilvalg.Status == TilvalgStatus.Publisert)
        {
            await JS.InvokeVoidAsync("signatur.init", "sig-canvas-tilvalg");
            _canvasInitialisert = true;
        }
    }

    private void OppdaterSum()
    {
        _sum = _valg.Where(v => v.Valgt).Sum(v => v.Pris * Math.Max(1, v.Antall));
    }

    private async Task RensSignatur()
    {
        await JS.InvokeVoidAsync("signatur.clear", "sig-canvas-tilvalg");
    }

    private async Task LastOppOnskeBilde(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > 10_000_000)
        {
            _feil = $"\"{file.Name}\" er for stort (maks 10 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _onskeBildeData = buffer.ToArray();
        _onskeBildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
        _feil = null;
    }

    private async Task SendInn()
    {
        _feil = null;

        if (string.IsNullOrWhiteSpace(_signertAvNavn))
        {
            _feil = "Skriv inn fullt navn.";
            return;
        }

        if (!_valg.Any(v => v.Valgt && v.Antall > 0))
        {
            _feil = "Velg minst ett alternativ.";
            return;
        }

        var tom = await JS.InvokeAsync<bool>("signatur.isEmpty", "sig-canvas-tilvalg");
        if (tom)
        {
            _feil = "Signer i feltet før du sender inn.";
            return;
        }

        var base64 = await JS.InvokeAsync<string>("signatur.getPngBase64", "sig-canvas-tilvalg");

        decimal sum = 0;
        foreach (var alt in _tilvalg!.Alternativer)
        {
            var valg = _valg.FirstOrDefault(v => v.AlternativId == alt.Id);
            var antall = valg is { Valgt: true } ? Math.Max(1, valg.Antall) : 0;
            alt.ValgtAntall = antall;
            sum += alt.Pris * antall;
        }

        _tilvalg.Signatur = Convert.FromBase64String(base64);
        _tilvalg.SignertAvNavn = _signertAvNavn.Trim();
        _tilvalg.SumTotal = sum;
        _tilvalg.KundeOnskeTekst = string.IsNullOrWhiteSpace(_onskeTekst) ? null : _onskeTekst.Trim();
        _tilvalg.KundeOnskeBildeData = _onskeBildeData;
        _tilvalg.KundeOnskeBildeContentType = _onskeBildeContentType;
        _tilvalg.Status = TilvalgStatus.Besvart;
        _tilvalg.BesvartDato = DateTime.Now;
        _tilvalg.LestAvAnsatt = false;
        await Db.SaveChangesAsync();
    }
}
