                                <td>@k.Kontrollert.ToString("dd.MM.yyyy")<small>@k.KontrollertAv</small></td>
                                <td><span class="ek-chip @(k.Arsak == EtterkalkyleArsak.IngenAvvik ? "ek-chip-gronn" : "ek-chip-gul")">@k.Arsak.Visningsnavn()</span></td>
                                <td class="n">@k.FaktiskTimer.ToString("0.#", Kultur) / @k.BudsjettTimer.ToString("0.#", Kultur)<small>@Avvik(k.FaktiskTimer, k.BudsjettTimer)</small></td>
                                <td class="n">@Kr(k.FaktiskKost)<small>@Avvik(k.FaktiskKost, k.BudsjettKost)</small></td>
                                <td class="n"><b class="@(k.FaktiskDekningsgrad < k.BudsjettDekningsgrad ? "ek-rod" : "ek-gronn")">@DG(k.FaktiskDekningsgrad)</b><small>tilbudt @DG(k.BudsjettDekningsgrad)</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private RenderFragment LaerdomVisning() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Lærdom</h2><p>Varer der de kontrollerte prosjektene har brukt merkbart mer eller mindre tid enn beregnet (minst 15 % avvik, i minst to prosjekter). Juster montasjetiden, så treffer neste tilbud bedre.</p></span>
        </div>
        @if (_laerdom.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="sparkle" /><span>@(_kontrollerte.Count < 2 ? "Lærdom vises når minst to prosjekter er kontrollert." : "Ingen varer skiller seg ut - tilbudene treffer godt på montasjetid.")</span></div>
        }
        else
        {
            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Vare</th><th class="n">Prosjekter</th><th class="n">Faktisk mot beregnet</th><th class="n">Montasjetid nå</th><th class="n">Forslag</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in _laerdom)
