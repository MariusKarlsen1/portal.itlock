@page "/prosjektokonomi"
@page "/prosjektokonomi/{Fane}"
@page "/etterkalkyle"
@page "/etterkalkyle/{Fane}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProsjektOkonomiService OkonomiSvc
@inject ProsjektOppfolgingService OppfolgingSvc
@inject VisningPreferanseService VisningPref
@inject NavigationManager Nav

<PageTitle>Prosjektøkonomi</PageTitle>
<KreverModulVakt Modul="@PortalItlock.Web.Models.TilleggsModuler.Okonomi" />

@* Prosjektøkonomi har to faner:
   - Pågående: prosjekter som er registrert eller under arbeid, med budsjett
     fra godkjente tilbud mot timer og varer brukt hittil. Oppdateres av seg
     selv mens siden er åpen.
   - Etterkalkyle: overleverte prosjekter til gjennomgang, de kontrollerte,
     og lærdom for neste tilbud.
   /etterkalkyle er den gamle adressen og virker fortsatt. *@
<div class="ek-side @(_full ? "ek-full" : "")">
    <header class="ek-header">
        <span class="ek-header-ikon"><Icon Name="trend-up" /></span>
        <div>
            <h1>Prosjektøkonomi</h1>
            <p>Følg økonomien mens prosjektene pågår, og gå gjennom etterkalkylen når de er overlevert</p>
        </div>
    </header>

    @if (!_klar)
    {
        <p class="ek-tom">Laster …</p>
    }
    else
    {
        <div class="ek-kort">
            <nav class="ek-meny" aria-label="Prosjektøkonomi">
                <a class="ek-meny-rad @(HovedFane == "pagaende" ? "aktiv" : "")" href="/prosjektokonomi" @onclick="@(() => { if (HovedFane == "pagaende") _apenProsjekt = null; })">
                    <Icon Name="bar-chart" /><span class="ek-meny-tekst">Pågående<small>@_pagaende.Count prosjekter</small></span>
                    @if (_folgMed.Count > 0)
                    {
                        <small class="ek-meny-tall @(_folgMed.Any(f => f.Status == ProsjektOkonomiService.OkonomiStatus.OverBudsjett) ? "" : "ek-meny-tall-gul")" title="Med gult eller rødt varsel">@_folgMed.Count</small>
                    }
                </a>
                <a class="ek-meny-rad @(HovedFane == "etterkalkyle" ? "aktiv" : "")" href="/prosjektokonomi/etterkalkyle" @onclick="@(() => { if (Visning == "etterkalkyle") _apenProsjekt = null; })">
                    <Icon Name="clipboard" /><span class="ek-meny-tekst">Etterkalkyle<small>@_tilGjennomgang.Count til gjennomgang</small></span>
                    @if (_tilGjennomgang.Count > 0)
                    {
                        <small class="ek-meny-tall ek-meny-tall-gul" title="Venter på gjennomgang">@_tilGjennomgang.Count</small>
                    }
                </a>
                <span class="ek-meny-bunn">
                    @if (_erAdmin)
                    {
                        <a class="ek-meny-rad ek-meny-liten @(HovedFane == "innstillinger" ? "aktiv" : "")" href="/prosjektokonomi/innstillinger"><Icon Name="settings" />Innstillinger</a>
                    }
                    <button type="button" class="ek-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
                </span>
            </nav>

            <div class="ek-innhold">
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <p class="ek-melding">@_melding</p>
                }

                @if (_apenProsjekt is { } p)
                {
                    @Detalj(p)
                }
                else
                {
                    @switch (Visning)
                    {
                        case "etterkalkyle":
                            @Gjennomgang()
                            break;
                        case "kontrollert":
                            @Kontrollerte()
                            break;
                        case "laerdom":
                            @LaerdomVisning()
                            break;
                        case "innstillinger":
                            @Innstillinger()
                            break;
                        default:
                            @Pagaende()
                            break;
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Fane { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private static readonly string[] Visninger = ["pagaende", "etterkalkyle", "kontrollert", "laerdom", "innstillinger"];

    // Hva som vises. Gamle adresser: «folg» = Pågående med filteret «Følg med»,
    // «gjennomgang» og /etterkalkyle uten fane = Etterkalkyle.
    private string Visning => Fane switch
    {
        "folg" => "pagaende",
        "gjennomgang" => "etterkalkyle",
        { } f when Visninger.Contains(f) => f,
        _ => new Uri(Nav.Uri).AbsolutePath.StartsWith("/etterkalkyle", StringComparison.OrdinalIgnoreCase) ? "etterkalkyle" : "pagaende"
    };

    private string HovedFane => Visning switch
    {
        "etterkalkyle" or "kontrollert" or "laerdom" => "etterkalkyle",
        "innstillinger" => "innstillinger",
        _ => "pagaende"
    };

    private bool _klar;
    private bool _full;
    private bool _erAdmin;
    private string? _brukerNavn;
    private string? _melding;

    private List<Prosjekt> _tilGjennomgang = [];
    private Dictionary<int, ProsjektOkonomiService.Okonomi> _okonomi = [];
    private List<(Prosjekt Prosjekt, ProsjektOkonomiService.Okonomi? O)> _pagaende = [];
    private Dictionary<int, ProsjektOppfolgingService.Oppfolging> _oppfolging = [];
    private bool _bareVarsel;
    private string _filter = "alle";
    private int? _brukerId;
    private DateTime _lastet;
    private List<ProsjektOkonomiService.Okonomi> _folgMed = [];
    private List<ProsjektEtterkalkyle> _kontrollerte = [];
    private List<ProsjektOkonomiService.Laerdom> _laerdom = [];
    private OkonomiInnstillinger? _inn;

    private Prosjekt? _apenProsjekt;
    private ProsjektEtterkalkyle? _apenKontroll;
    private ProsjektOkonomiService.Okonomi? _apenOkonomi;
    private EtterkalkyleArsak _arsak = EtterkalkyleArsak.IngenAvvik;
    private string _kommentar = "";
    private string? _gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre;

    // Svarene fra etterkalkylen i økonomiarket, i samme rekkefølge som der.
    private static IEnumerable<(string Sporsmal, string Svar)> EvalueringSvar(ProsjektEtterkalkyle k) =>
        new[]
        {
            ("Hva gikk bra?", k.GikkBra),
            ("Hva gikk dårlig?", k.GikkDarlig),
            ("Hva må vi forbedre?", k.Forbedre),
            ("Forsinkelser, egne forhold", k.ForsinkelseEgne),
            ("Forsinkelser, andre", k.ForsinkelseAndre)
        }.Where(x => !string.IsNullOrWhiteSpace(x.Item2)).Select(x => (x.Item1, x.Item2!));

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _erAdmin = state.User.IsInRole("Admin");
            _brukerNavn = state.User.Identity?.Name;
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var id))
            {
                _brukerId = id;
                _brukerNavn = (await Db.Brukere.AsNoTracking().FirstOrDefaultAsync(b => b.Id == id))?.Navn ?? _brukerNavn;
            }
        }

        _bareVarsel = Fane == "folg";
        _filter = _bareVarsel ? "folg" : "alle";
        _full = await VisningPref.HentAsync("etterkalkyle-bredde", "normal") == "full";
        await LastAsync();

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("prosjekt", out var pid) && int.TryParse(pid, out var prosjektId))
        {
            await ApneIntern(prosjektId);
            if (query.ContainsKey("overlevert") && _apenProsjekt is { } apen)
            {
                _melding = $"{apen.Navn} er satt som overlevert. Her er hvordan det gikk.";
            }
        }

        _klar = true;
    }

    // ---------- Live: tallene regnes ut på nytt hvert halve minutt ----------
    // All databasebruk på siden går gjennom _laas, så oppdateringen i
    // bakgrunnen aldri bruker databasen samtidig med et klikk.
    private const int OppdaterSekunder = 30;
    private readonly SemaphoreSlim _laas = new(1, 1);
    private System.Threading.Timer? _tikk;
    private bool _oppdaterer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _tikk = new System.Threading.Timer(_ => _ = InvokeAsync(OppdaterIBakgrunnen), null,
                TimeSpan.FromSeconds(OppdaterSekunder), TimeSpan.FromSeconds(OppdaterSekunder));
        }
    }

    private async Task OppdaterIBakgrunnen()
    {
        // Ikke mens innstillinger fylles ut, og hopp over hvis noe annet pågår.
        if (!_klar || Visning == "innstillinger" || !await _laas.WaitAsync(0))
        {
            return;
        }

        try
        {
            _oppdaterer = true;
            await LastAsync();
            if (_apenProsjekt is { } p)
            {
                _apenOkonomi = await OkonomiSvc.BeregnAsync(p.Id);
            }
        }
        catch (ObjectDisposedException)
        {
            return;
        }
        finally
        {
            _oppdaterer = false;
            _laas.Release();
        }

        StateHasChanged();
    }

    private async Task Kjor(Func<Task> arbeid)
    {
        await _laas.WaitAsync();
        try
        {
            await arbeid();
        }
        finally
        {
            _laas.Release();
        }
    }

    private Task OppdaterAsync() => Kjor(OppdaterIntern);
    private Task ApneAsync(int prosjektId) => Kjor(() => ApneIntern(prosjektId));
    private Task Kontroller() => Kjor(KontrollerIntern);
    private Task LagreInnstillinger() => Kjor(LagreInnstillingerIntern);
    private Task JusterMontasjetid(ProsjektOkonomiService.Laerdom l) => Kjor(() => JusterMontasjetidIntern(l));

    public void Dispose()
    {
        _tikk?.Dispose();
        _tikk = null;
    }

    private async Task LastAsync()
    {
        _tilGjennomgang = await OkonomiSvc.TilGjennomgangAsync();
        _kontrollerte = await Db.ProsjektEtterkalkyler.AsNoTracking().Include(k => k.Prosjekt!).ThenInclude(p => p.Kunde)
            .Where(k => !k.ErUtkast)
            .OrderByDescending(k => k.Kontrollert).ToListAsync();
        // Til gjennomgang: slik gikk det, med det som gikk dårligst øverst.
        _etterkalkyler = _tilGjennomgang.Count == 0 ? [] : await OppfolgingSvc.EtterkalkyleFlereAsync(_tilGjennomgang.Select(p => p.Id).ToList());
        _utkast = (await Db.ProsjektEtterkalkyler.AsNoTracking().Where(k => k.ErUtkast).Select(k => k.ProsjektId).ToListAsync()).ToHashSet();
        _tilGjennomgang = _tilGjennomgang
            .OrderBy(p => _etterkalkyler.TryGetValue(p.Id, out var e) ? e.DgPoeng : 999)
            .ThenBy(p => p.OverlevertDato)
            .ToList();
        // Pågående: alle som er registrert eller under arbeid, også de som
        // mangler godkjent tilbud, så de ikke glemmes.
        var prosjekter = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder)
            .Where(p => p.Status == ProsjektStatus.Registrert || p.Status == ProsjektStatus.UnderArbeid)
            .ToListAsync();
        _oppfolging = prosjekter.Count == 0 ? [] : await OppfolgingSvc.HentFlereAsync(prosjekter.Select(p => p.Id).ToList());
        var gjennomgang = _tilGjennomgang.Select(p => p.Id).Where(id => !_oppfolging.ContainsKey(id) && !_etterkalkyler.ContainsKey(id)).ToList();
        _okonomi = gjennomgang.Count == 0 ? [] : await OkonomiSvc.BeregnFlereAsync(gjennomgang);
        foreach (var (id, e) in _etterkalkyler)
        {
            _okonomi[id] = e.O;
        }

        foreach (var (id, f) in _oppfolging)
        {
            if (f.O is { } ok)
            {
                _okonomi[id] = ok;
            }
        }

        _pagaende = prosjekter
            .Select(p => (p, _okonomi.GetValueOrDefault(p.Id) is { Tilbud.Count: > 0 } o ? o : null))
            .OrderBy(x => Rekkefolge(x.Item2))
            .ThenByDescending(x => x.Item2 is { BudsjettKost: > 0 } o ? o.PrognoseKost / o.BudsjettKost : 0)
            .ThenBy(x => x.p.Navn)
            .ToList();
        _folgMed = _pagaende.Where(x => ErVarsel(x.O)).Select(x => x.O!).ToList();
        _lastet = DateTime.Now;
        _laerdom = await OkonomiSvc.LaerdomAsync();
        _inn = await OkonomiSvc.InnstillingerAsync();
        await LastTimekostAsync();
    }

    private static bool ErVarsel(ProsjektOkonomiService.Okonomi? o) =>
        o?.Status is ProsjektOkonomiService.OkonomiStatus.FolgMed or ProsjektOkonomiService.OkonomiStatus.OverBudsjett;

    private static int Rekkefolge(ProsjektOkonomiService.Okonomi? o) => o is not { Inntekt: > 0 } ? 3 : o.Status switch
    {
        ProsjektOkonomiService.OkonomiStatus.OverBudsjett => 0,
        ProsjektOkonomiService.OkonomiStatus.FolgMed => 1,
        ProsjektOkonomiService.OkonomiStatus.IRute => 2,
        _ => 3
    };

    private static string Pst(decimal v) => Math.Clamp(v * 100, 0, 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";
    private static string Pst100(decimal v) => Math.Round(v * 100).ToString("0", Kultur) + " %";

    private async Task OppdaterIntern()
    {
        await LastAsync();
        _melding = null;
    }

    private Task VekslFull() => Kjor(VekslFullIntern);

    private async Task VekslFullIntern()
    {
        _full = !_full;
        await VisningPref.SettAsync("etterkalkyle-bredde", _full ? "full" : "normal");
    }

    private async Task ApneIntern(int prosjektId)
    {
        _apenOkonomi = await OkonomiSvc.BeregnAsync(prosjektId);
        _apenProsjekt = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder).FirstOrDefaultAsync(p => p.Id == prosjektId);
        // Et utkast er ikke signert; feltene fylles fra det, og ellers med forslag.
        var lagret = await Db.ProsjektEtterkalkyler.AsNoTracking().FirstOrDefaultAsync(k => k.ProsjektId == prosjektId);
        _apenKontroll = lagret is { ErUtkast: false } ? lagret : null;
        _apenUtkast = lagret is { ErUtkast: true };
        var ek = _apenProsjekt?.Status == ProsjektStatus.Overlevert && lagret is null ? await OppfolgingSvc.EtterkalkyleAsync(prosjektId) : null;
        _arsak = lagret?.Arsak ?? ek?.ForeslattArsak ?? EtterkalkyleArsak.IngenAvvik;
        _arsakForeslatt = lagret is null && ek is not null;
        _kommentar = lagret?.Kommentar ?? "";
        _gikkBra = lagret?.GikkBra;
        _gikkDarlig = lagret?.GikkDarlig;
        _forbedre = lagret?.Forbedre;
        _forsinkelseEgne = lagret?.ForsinkelseEgne;
        _forsinkelseAndre = lagret?.ForsinkelseAndre ?? ek?.ForslagForsinkelseAndre;
        _melding = null;
    }

    private bool _apenUtkast;
    private bool _arsakForeslatt;
    private Dictionary<int, ProsjektOppfolgingService.Etterkalkyle> _etterkalkyler = [];
    private HashSet<int> _utkast = [];

    // Gjennomgangen i tre trinn: se tallene, årsak og lærdom, signer.
    private int GjennomgangTrinn => string.IsNullOrWhiteSpace(_kommentar) && string.IsNullOrWhiteSpace(_gikkBra) && string.IsNullOrWhiteSpace(_gikkDarlig) && string.IsNullOrWhiteSpace(_forbedre) ? 2 : 3;

    private Task LagreUtkast() => Kjor(async () =>
    {
        if (_apenProsjekt is not { } p)
        {
            return;
        }

        await OkonomiSvc.LagreUtkastAsync(p.Id, _arsak, _kommentar, _brukerNavn,
            new ProsjektOkonomiService.Evaluering(_gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre));
        _apenUtkast = true;
        _utkast.Add(p.Id);
        _melding = "Utkastet er lagret. Prosjektet står fortsatt under Til gjennomgang.";
    });

    // Prosjektet er satt som overlevert under Pågående: vis etterkalkylen med en
    // gang. Siden kan bli laget på nytt når adressen endres, så prosjektet sendes
    // med i adressen og åpnes derfra.
    private void VedOverlevert(int prosjektId) =>
        Nav.NavigateTo($"/prosjektokonomi/etterkalkyle?prosjekt={prosjektId}&overlevert=1", forceLoad: true);

    private Task EtterkalkyleEndret() => Kjor(async () =>
    {
        await LastAsync();
        if (_apenProsjekt is { } p)
        {
            _apenOkonomi = await OkonomiSvc.BeregnAsync(p.Id);
        }
    });

    private async Task KontrollerIntern()
    {
        if (_apenProsjekt is not { } p)
        {
            return;
        }

        if (_arsak != EtterkalkyleArsak.IngenAvvik && string.IsNullOrWhiteSpace(_kommentar))
        {
            _melding = "Skriv en kort kommentar om hva som skjedde.";
            return;
        }

        await OkonomiSvc.KontrollerAsync(p.Id, _arsak, _kommentar, _brukerNavn,
            new ProsjektOkonomiService.Evaluering(_gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre));
        _apenProsjekt = null;
        await LastAsync();
        _melding = $"{p.Navn} er kontrollert og lagt i arkivet.";
    }

    private async Task LagreInnstillingerIntern()
    {
        if (_inn is null)
        {
            return;
        }

        var inn = await Db.OkonomiInnstillinger.FirstAsync(i => i.Id == _inn.Id);
        inn.InternTimekost = _inn.InternTimekost is > 0 ? _inn.InternTimekost : null;
        inn.GulProsentOverBudsjett = Math.Clamp(_inn.GulProsentOverBudsjett, 0, 100);
        inn.GulTimerBruktProsent = Math.Clamp(_inn.GulTimerBruktProsent, 1, 100);
        inn.GulFremdriftProsent = Math.Clamp(_inn.GulFremdriftProsent, 1, 100);
        await Db.SaveChangesAsync();
        await LastAsync();
        _melding = "Innstillingene er lagret. Status på prosjektene er regnet ut på nytt.";
    }

    private async Task JusterMontasjetidIntern(ProsjektOkonomiService.Laerdom l)
    {
        if (l.ForslagMinutter is not { } nye)
        {
            return;
        }

        var c = await Db.Components.FirstAsync(x => x.Id == l.ComponentId);
        c.MontasjeMinutterProsjekt = nye;
        await Db.SaveChangesAsync();
        _laerdom.Remove(l);
        _melding = $"Montasjetiden for {l.Navn} er satt til {nye} minutter. Nye tilbud bruker den nye tiden.";
    }

    // ---------- Hjelpere ----------
    private static string Kr(decimal v) => v.ToString("#,##0", Kultur) + " kr";
    private static string DG(decimal? v) => v is { } d ? (d * 100).ToString("0.#", Kultur) + " %" : "–";

    private static string Avvik(decimal v, decimal mot)
    {
        if (mot <= 0) return "–";
        var p = (v / mot - 1) * 100;
        return (p > 0 ? "+" : "") + p.ToString("0", Kultur) + " %";
    }

    private static string Klasse(ProsjektOkonomiService.OkonomiStatus s) => s switch
    {
        ProsjektOkonomiService.OkonomiStatus.OverBudsjett => "rod",
        ProsjektOkonomiService.OkonomiStatus.FolgMed => "gul",
        ProsjektOkonomiService.OkonomiStatus.IRute => "gronn",
        _ => "n"
    };

    // ======================================================================
    // Undermenyen i fanen Etterkalkyle.
    private RenderFragment EtterkalkyleMeny() => @<nav class="ek-undermeny" aria-label="Etterkalkyle">
        <a class="@(Visning == "etterkalkyle" ? "aktiv" : "")" href="/prosjektokonomi/etterkalkyle">Til gjennomgang<small>@_tilGjennomgang.Count</small></a>
        <a class="@(Visning == "kontrollert" ? "aktiv" : "")" href="/prosjektokonomi/kontrollert">Kontrollert<small>@_kontrollerte.Count</small></a>
        <a class="@(Visning == "laerdom" ? "aktiv" : "")" href="/prosjektokonomi/laerdom">Lærdom<small>@_laerdom.Count</small></a>
    </nav>;

    private static string DomKlasse(ProsjektOppfolgingService.Dom d) => d switch
    {
        ProsjektOppfolgingService.Dom.Bedre => "ek-chip-gronn",
        ProsjektOppfolgingService.Dom.Darligere => "ek-chip-rod",
        _ => "ek-chip-gronn"
    };

    private static string Fortegn(decimal v) => Math.Abs(v) < 1 ? "0" : (v > 0 ? "+" : "−") + Math.Abs(v).ToString("#,##0", Kultur);

    private RenderFragment Gjennomgang() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Til gjennomgang</h2><p>Prosjekter som er satt som overlevert havner her. Lista viser med en gang hvordan det gikk mot kalkylen, med det som gikk dårligst øverst. Åpne prosjektet for å se hvor avviket kom fra, skriv årsak og lærdom, og signer.</p></span>
        </div>
        @if (_tilGjennomgang.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="check-circle" /><span>Ingen prosjekter venter på gjennomgang.</span></div>
        }
        else
        {
            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Prosjekt</th><th>Overlevert</th><th class="n">Resultat mot kalkyle</th><th class="n">Dekningsgrad</th><th>Største avvik</th><th>Slik gikk det</th></tr></thead>
                    <tbody>
                        @foreach (var x in _tilGjennomgang)
                        {
                            var p = x;
                            var e = _etterkalkyler.GetValueOrDefault(p.Id);
                            <tr class="ek-klikkrad" @onclick="@(() => ApneAsync(p.Id))">
                                <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(_utkast.Contains(p.Id) ? " · utkast lagret" : "")</small></td>
                                <td>@(p.OverlevertDato?.ToString("dd.MM.yyyy") ?? "–")<small>@(e?.DagerOverFrist is { } dager ? dager > 0 ? $"{dager} dager over fristen" : dager == 0 ? "på fristen" : $"{-dager} dager før fristen" : "")</small></td>
                                @if (e is null)
                                {
                                    <td colspan="3"><small>Ingen godkjent kalkyle å sammenligne med.</small></td>
                                    <td><span class="ek-chip">Mangler kalkyle</span></td>
                                }
                                else
                                {
                                    var (avvikTekst, avvikNiva) = e.StorsteAvvik;
                                    <td class="n"><b class="@(e.ResultatAvvik < -0.5m ? "ek-rod" : "ek-gronn")">@Fortegn(e.ResultatAvvik)</b><small>kalkulert @Kr(e.KalkResultat)</small></td>
                                    <td class="n"><b class="@(e.DgPoeng <= -3 ? "ek-rod" : e.DgPoeng >= 2 ? "ek-gronn" : "")">@DG(e.FaktiskDG)</b><small>kalkulert @DG(e.KalkDG)</small></td>
                                    <td><span class="ek-chip @NivaKlasse(avvikNiva)">@avvikTekst</span>@if (e.VarerAnslatt) {<small>varer anslått</small>}</td>
                                    <td><span class="ek-chip @DomKlasse(e.Dom)">@e.DomTekst</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    // Filtrene over lista. «folg» er den gamle adressen /prosjektokonomi/folg.
    private bool IFilter(Prosjekt p, ProsjektOkonomiService.Okonomi? o)
    {
        var f = _oppfolging.GetValueOrDefault(p.Id);
        return _filter switch
        {
            "trenger" => f?.NesteStegNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod,
            "akonto" => f?.KlarAkonto is not null,
            "over" => o?.Status == ProsjektOkonomiService.OkonomiStatus.OverBudsjett,
            "mine" => p.ProsjektlederId == _brukerId && _brukerId is not null,
            "folg" => ErVarsel(o),
            _ => true
        };
    }

    private static string NivaKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gronn => "ek-chip-gronn",
        ProsjektOppfolgingService.Niva.Gul => "ek-chip-gul",
        ProsjektOppfolgingService.Niva.Rod => "ek-chip-rod",
        _ => ""
    };

    private RenderFragment FilterKnapp(string id, string tekst, int antall) => @<button type="button" class="ek-arsak @(_filter == id ? "aktiv" : "")" @onclick="@(() => _filter = id)">@tekst (@antall)</button>;

    private RenderFragment Pagaende() => @<div class="ek-fane">
        <div class="ek-fane-topp">
            <span><h2>Pågående prosjekter</h2><p>Prosjekter som er registrert eller under arbeid. Øverst er totalen, og hver rad sier hva som er neste steg. Trykk på et prosjekt for oversikt, fremdriftsplan, budsjett og fakturering. Når prosjektet overleveres, flyttes det til Etterkalkyle.</p></span>
            <span class="ek-knapper">
                <span class="ek-oppdatert"><i class="ek-live"></i>Live · oppdatert @_lastet.ToString("HH:mm:ss")</span>
                <button type="button" class="ek-knapp" @onclick="OppdaterAsync">Oppdater tallene</button>
            </span>
        </div>
        @{
            var alle = _oppfolging.Values.ToList();
            var medTall = alle.Where(f => f.O is { Inntekt: > 0 }).ToList();
            var inntekt = medTall.Sum(f => f.O!.Inntekt);
            var prognoseDg = inntekt > 0 ? (inntekt - medTall.Sum(f => f.O!.PrognoseKost)) / inntekt : (decimal?)null;
            var tilbudtDg = inntekt > 0 ? (inntekt - medTall.Sum(f => f.O!.BudsjettKost)) / inntekt : (decimal?)null;
            var klart = alle.Where(f => f.UtfortIkkeFakturert > 0).ToList();
            var oppgaver = alle.Sum(f => f.AapneOppgaver.Count);
            var sene = alle.Sum(f => f.AapneOppgaver.Count(x => x.Forsinket));
            var liste = _pagaende.Where(x => IFilter(x.Prosjekt, x.O)).ToList();
        }
        <div class="ek-kpi ek-kpi-5">
            <div><span>Ordrereserve</span><b>@Kr(alle.Sum(f => f.Gjenstar))</b><small>Gjenstår å fakturere</small></div>
            <div class="@(klart.Count > 0 ? "ek-kpi-gul" : "")"><span>Utført, ikke fakturert</span><b>@Kr(klart.Sum(f => f.UtfortIkkeFakturert))</b><small>@klart.Count @(klart.Count == 1 ? "prosjekt" : "prosjekter")</small></div>
            <div><span>Fakturert denne måneden</span><b>@Kr(alle.Sum(f => f.FakturertDenneMaaned))</b><small>Akontoer og arbeidsordre</small></div>
            <div><span>Dekningsgrad</span><b class="@(prognoseDg < tilbudtDg - 0.02m ? "ek-rod" : "ek-gronn")">@DG(prognoseDg)</b><small>Prognose · tilbudt @DG(tilbudtDg)</small></div>
            <div class="@(sene > 0 ? "ek-kpi-rod" : "")"><span>Oppgaver denne uken</span><b>@oppgaver</b><small>@(sene > 0 ? $"{sene} forsinket" : "Fra fremdriftsplanene")</small></div>
        </div>
        <div class="ek-filter">
            @FilterKnapp("alle", "Alle", _pagaende.Count)
            @FilterKnapp("trenger", "Trenger oppfølging", _pagaende.Count(x => _oppfolging.GetValueOrDefault(x.Prosjekt.Id)?.NesteStegNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod))
            @FilterKnapp("akonto", "Klar for akonto", alle.Count(f => f.KlarAkonto is not null))
            @FilterKnapp("over", "Over budsjett", _pagaende.Count(x => x.O?.Status == ProsjektOkonomiService.OkonomiStatus.OverBudsjett))
            @if (_brukerId is not null)
            {
                @FilterKnapp("mine", "Mine prosjekter", _pagaende.Count(x => x.Prosjekt.ProsjektlederId == _brukerId))
            }
        </div>
        @if (liste.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="check-circle" /><span>@(_filter == "alle" ? "Ingen prosjekter er registrert eller under arbeid." : "Ingen prosjekter i dette filteret.")</span></div>
        }
        else
        {
            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Prosjekt</th><th>Utført / tid brukt</th><th class="n">Prosjektsum</th><th>Fakturert</th><th class="n">Dekningsgrad</th><th>Neste steg</th></tr></thead>
                    <tbody>
                        @foreach (var (p, o) in liste)
                        {
                            var id = p.Id;
                            var f = _oppfolging.GetValueOrDefault(p.Id);
                            <tr class="ek-klikkrad" @onclick="@(() => ApneAsync(id))">
                                <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · PL {pl.Navn}" : "") · @(p.Status?.Visningsnavn() ?? "Aktiv")</small></td>
                                @if (o is { Inntekt: > 0 } && f is not null)
                                {
                                    <td class="ek-fremdrift"><span class="ek-minibar"><i style="width:@Pst(o.Fremdrift)"></i></span><small>@Pst100(o.Fremdrift) utført@(f.Tidsandel is { } tid ? $" · {Pst100(tid)} av tiden" : "")</small></td>
                                    <td class="n">@Kr(f.Prosjektsum)</td>
                                    <td class="ek-fremdrift"><span class="ek-minibar ek-minibar-aks"><i style="width:@Pst(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0)"></i></span><small>@Pst100(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0) · @Kr(f.Fakturert)</small></td>
                                    <td class="n"><b class="@(o.Status == ProsjektOkonomiService.OkonomiStatus.OverBudsjett || o.PrognoseDekningsgrad < o.BudsjettDekningsgrad - 0.02m ? "ek-rod" : "")">@DG(o.PrognoseDekningsgrad)</b><small>tilbudt @DG(o.BudsjettDekningsgrad)</small></td>
                                    <td><span class="ek-chip @NivaKlasse(f.NesteStegNiva)">@f.NesteSteg</span></td>
                                }
                                else
                                {
                                    <td colspan="4"><small>@(o is null ? "Budsjettet låses når et tilbud på prosjektet settes til Godkjent." : "Det godkjente tilbudet har ingen beløp. Legg inn linjer i tilbudet, så følges økonomien opp.")</small></td>
                                    <td><span class="ek-chip">@(o is null ? "Mangler godkjent tilbud" : "Tilbud uten beløp")</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private RenderFragment Kontrollerte() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Kontrollert</h2><p>Gjennomgåtte prosjekter, med tallene slik de var da de ble kontrollert.</p></span>
        </div>
        @if (_kontrollerte.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="clipboard" /><span>Ingen prosjekter er kontrollert ennå.</span></div>
        }
        else
        {
            <div class="ek-kpi">
                <div><span>Kontrollerte prosjekter</span><b>@_kontrollerte.Count</b></div>
                <div><span>Tilbudt totalt</span><b>@Kr(_kontrollerte.Sum(k => k.Inntekt))</b></div>
                <div><span>Snitt dekningsgrad</span><b>@DG(_kontrollerte.Sum(k => k.Inntekt) > 0 ? (_kontrollerte.Sum(k => k.Inntekt) - _kontrollerte.Sum(k => k.FaktiskKost)) / _kontrollerte.Sum(k => k.Inntekt) : null)</b><small>tilbudt @DG(_kontrollerte.Sum(k => k.Inntekt) > 0 ? (_kontrollerte.Sum(k => k.Inntekt) - _kontrollerte.Sum(k => k.BudsjettKost)) / _kontrollerte.Sum(k => k.Inntekt) : null)</small></div>
                <div><span>Timer mot budsjett</span><b>@Avvik(_kontrollerte.Sum(k => k.FaktiskTimer), _kontrollerte.Sum(k => k.BudsjettTimer))</b></div>
