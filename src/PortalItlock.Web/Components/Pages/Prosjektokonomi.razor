@page "/prosjektokonomi"
@page "/prosjektokonomi/{Fane}"
@page "/etterkalkyle"
@page "/etterkalkyle/{Fane}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProsjektOkonomiService OkonomiSvc
@inject ProsjektOppfolgingService OppfolgingSvc
@inject VisningPreferanseService VisningPref
@inject NavigationManager Nav

<PageTitle>Prosjektøkonomi</PageTitle>
<KreverModulVakt Modul="@PortalItlock.Web.Models.TilleggsModuler.Okonomi" />

@* Prosjektøkonomi har to faner:
   - Pågående: prosjekter som er registrert eller under arbeid, med budsjett
     fra godkjente tilbud mot timer og varer brukt hittil. Oppdateres av seg
     selv mens siden er åpen.
   - Etterkalkyle: overleverte prosjekter til gjennomgang, de kontrollerte,
     og lærdom for neste tilbud.
   /etterkalkyle er den gamle adressen og virker fortsatt. *@
<div class="ek-side @(_full ? "ek-full" : "")">
    <header class="ek-header">
        <span class="ek-header-ikon"><Icon Name="trend-up" /></span>
        <div>
            <h1>Prosjektøkonomi</h1>
            <p>Følg økonomien mens prosjektene pågår, og gå gjennom etterkalkylen når de er overlevert</p>
        </div>
    </header>

    @if (!_klar)
    {
        <p class="ek-tom">Laster …</p>
    }
    else
    {
        <div class="ek-kort">
            <nav class="ek-meny" aria-label="Prosjektøkonomi">
                <a class="ek-meny-rad @(HovedFane == "pagaende" ? "aktiv" : "")" href="/prosjektokonomi" @onclick="@(() => { if (HovedFane == "pagaende") _apenProsjekt = null; })">
                    <Icon Name="bar-chart" /><span class="ek-meny-tekst">Pågående<small>@_pagaende.Count prosjekter</small></span>
                    @if (_folgMed.Count > 0)
                    {
                        <small class="ek-meny-tall @(_folgMed.Any(f => f.FortjenesteIgjen < 0) ? "" : "ek-meny-tall-gul")" title="Med gult eller rødt varsel">@_folgMed.Count</small>
                    }
                </a>
                <a class="ek-meny-rad @(HovedFane == "etterkalkyle" ? "aktiv" : "")" href="/prosjektokonomi/etterkalkyle" @onclick="@(() => { if (Visning == "etterkalkyle") _apenProsjekt = null; })">
                    <Icon Name="clipboard" /><span class="ek-meny-tekst">Etterkalkyle<small>@_tilGjennomgang.Count til gjennomgang</small></span>
                    @if (_tilGjennomgang.Count > 0)
                    {
                        <small class="ek-meny-tall ek-meny-tall-gul" title="Venter på gjennomgang">@_tilGjennomgang.Count</small>
                    }
                </a>
                <span class="ek-meny-bunn">
                    @if (_erAdmin)
                    {
                        <a class="ek-meny-rad ek-meny-liten @(HovedFane == "innstillinger" ? "aktiv" : "")" href="/prosjektokonomi/innstillinger"><Icon Name="settings" />Innstillinger</a>
                    }
                    <button type="button" class="ek-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
                </span>
            </nav>

            <div class="ek-innhold">
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <p class="ek-melding">@_melding</p>
                }

                @if (_apenProsjekt is { } p)
                {
                    @Detalj(p)
                }
                else
                {
                    @switch (Visning)
                    {
                        case "etterkalkyle":
                            @Gjennomgang()
                            break;
                        case "kontrollert":
                            @Kontrollerte()
                            break;
                        case "laerdom":
                            @LaerdomVisning()
                            break;
                        case "innstillinger":
                            @Innstillinger()
                            break;
                        default:
                            @Pagaende()
                            break;
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Fane { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private static readonly string[] Visninger = ["pagaende", "etterkalkyle", "kontrollert", "laerdom", "innstillinger"];

    // Hva som vises. Gamle adresser: «folg» = Pågående med filteret «Følg med»,
    // «gjennomgang» og /etterkalkyle uten fane = Etterkalkyle.
    private string Visning => Fane switch
    {
        "folg" => "pagaende",
        "gjennomgang" => "etterkalkyle",
        { } f when Visninger.Contains(f) => f,
        _ => new Uri(Nav.Uri).AbsolutePath.StartsWith("/etterkalkyle", StringComparison.OrdinalIgnoreCase) ? "etterkalkyle" : "pagaende"
    };

    private string HovedFane => Visning switch
    {
        "etterkalkyle" or "kontrollert" or "laerdom" => "etterkalkyle",
        "innstillinger" => "innstillinger",
        _ => "pagaende"
    };

    private bool _klar;
    private bool _full;
    private bool _erAdmin;
    private string? _brukerNavn;
    private string? _melding;

    private List<Prosjekt> _tilGjennomgang = [];
    private Dictionary<int, ProsjektOkonomiService.Okonomi> _okonomi = [];
    private List<(Prosjekt Prosjekt, ProsjektOkonomiService.Okonomi? O)> _pagaende = [];
    private Dictionary<int, ProsjektOppfolgingService.Oppfolging> _oppfolging = [];
    private bool _bareVarsel;
    private string _filter = "alle";
    private string _sok = "";
    private string _sorter = "kritisk";
    private int? _brukerId;
    private DateTime _lastet;
    private List<ProsjektOkonomiService.Okonomi> _folgMed = [];
    private List<ProsjektEtterkalkyle> _kontrollerte = [];
    private List<ProsjektOkonomiService.Laerdom> _laerdom = [];
    private OkonomiInnstillinger? _inn;

    private Prosjekt? _apenProsjekt;
    private ProsjektEtterkalkyle? _apenKontroll;
    private ProsjektOkonomiService.Okonomi? _apenOkonomi;
    private EtterkalkyleArsak _arsak = EtterkalkyleArsak.IngenAvvik;
    private string _kommentar = "";
    private string? _gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre;

    // Svarene fra etterkalkylen i økonomiarket, i samme rekkefølge som der.
    private static IEnumerable<(string Sporsmal, string Svar)> EvalueringSvar(ProsjektEtterkalkyle k) =>
        new[]
        {
            ("Hva gikk bra?", k.GikkBra),
            ("Hva gikk dårlig?", k.GikkDarlig),
            ("Hva må vi forbedre?", k.Forbedre),
            ("Forsinkelser, egne forhold", k.ForsinkelseEgne),
            ("Forsinkelser, andre", k.ForsinkelseAndre)
        }.Where(x => !string.IsNullOrWhiteSpace(x.Item2)).Select(x => (x.Item1, x.Item2!));

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _erAdmin = state.User.IsInRole("Admin");
            _brukerNavn = state.User.Identity?.Name;
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var id))
            {
                _brukerId = id;
                _brukerNavn = (await Db.Brukere.AsNoTracking().FirstOrDefaultAsync(b => b.Id == id))?.Navn ?? _brukerNavn;
            }
        }

        _bareVarsel = Fane == "folg";
        _filter = _bareVarsel ? "taper" : "alle";
        _full = await VisningPref.HentAsync("etterkalkyle-bredde", "normal") == "full";
        await LastAsync();

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("prosjekt", out var pid) && int.TryParse(pid, out var prosjektId))
        {
            await ApneIntern(prosjektId);
            if (query.ContainsKey("overlevert") && _apenProsjekt is { } apen)
            {
                _melding = $"{apen.Navn} er satt som overlevert. Her er hvordan det gikk.";
            }
        }

        _klar = true;
    }

    // ---------- Live: tallene regnes ut på nytt hvert halve minutt ----------
    // All databasebruk på siden går gjennom _laas, så oppdateringen i
    // bakgrunnen aldri bruker databasen samtidig med et klikk.
    private const int OppdaterSekunder = 30;
    private readonly SemaphoreSlim _laas = new(1, 1);
    private System.Threading.Timer? _tikk;
    private bool _oppdaterer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _tikk = new System.Threading.Timer(_ => _ = InvokeAsync(OppdaterIBakgrunnen), null,
                TimeSpan.FromSeconds(OppdaterSekunder), TimeSpan.FromSeconds(OppdaterSekunder));
        }
    }

    private async Task OppdaterIBakgrunnen()
    {
        // Ikke mens innstillinger fylles ut, og hopp over hvis noe annet pågår.
        if (!_klar || Visning == "innstillinger" || !await _laas.WaitAsync(0))
        {
            return;
        }

        try
        {
            _oppdaterer = true;
            await LastAsync();
            if (_apenProsjekt is { } p)
            {
                _apenOkonomi = await OkonomiSvc.BeregnAsync(p.Id);
            }
        }
        catch (ObjectDisposedException)
        {
            return;
        }
        finally
        {
            _oppdaterer = false;
            _laas.Release();
        }

        StateHasChanged();
    }

    private async Task Kjor(Func<Task> arbeid)
    {
        await _laas.WaitAsync();
        try
        {
            await arbeid();
        }
        finally
        {
            _laas.Release();
        }
    }

    private Task OppdaterAsync() => Kjor(OppdaterIntern);
    private Task ApneAsync(int prosjektId) => Kjor(() => ApneIntern(prosjektId));
    private Task Kontroller() => Kjor(KontrollerIntern);
    private Task LagreInnstillinger() => Kjor(LagreInnstillingerIntern);
    private Task JusterMontasjetid(ProsjektOkonomiService.Laerdom l) => Kjor(() => JusterMontasjetidIntern(l));

    public void Dispose()
    {
        _tikk?.Dispose();
        _tikk = null;
    }

    private async Task LastAsync()
    {
        _tilGjennomgang = await OkonomiSvc.TilGjennomgangAsync();
        _kontrollerte = await Db.ProsjektEtterkalkyler.AsNoTracking().Include(k => k.Prosjekt!).ThenInclude(p => p.Kunde).Include(k => k.Prosjekt!).ThenInclude(p => p.Prosjektleder)
            .Where(k => !k.ErUtkast)
            .OrderByDescending(k => k.Kontrollert).ToListAsync();
        // Til gjennomgang: slik gikk det, med det som gikk dårligst øverst.
        _etterkalkyler = _tilGjennomgang.Count == 0 ? [] : await OppfolgingSvc.EtterkalkyleFlereAsync(_tilGjennomgang.Select(p => p.Id).ToList());
        _utkast = (await Db.ProsjektEtterkalkyler.AsNoTracking().Where(k => k.ErUtkast).Select(k => k.ProsjektId).ToListAsync()).ToHashSet();
        _tilGjennomgang = _tilGjennomgang
            .OrderBy(p => _etterkalkyler.TryGetValue(p.Id, out var e) ? e.DgPoeng : 999)
            .ThenBy(p => p.OverlevertDato)
            .ToList();
        // Pågående: alle som er registrert eller under arbeid, også de som
        // mangler godkjent tilbud, så de ikke glemmes.
        var prosjekter = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder)
            .Where(p => p.Status == ProsjektStatus.Registrert || p.Status == ProsjektStatus.UnderArbeid)
            .ToListAsync();
        _oppfolging = prosjekter.Count == 0 ? [] : await OppfolgingSvc.HentFlereAsync(prosjekter.Select(p => p.Id).ToList());
        var gjennomgang = _tilGjennomgang.Select(p => p.Id).Where(id => !_oppfolging.ContainsKey(id) && !_etterkalkyler.ContainsKey(id)).ToList();
        _okonomi = gjennomgang.Count == 0 ? [] : await OkonomiSvc.BeregnFlereAsync(gjennomgang);
        foreach (var (id, e) in _etterkalkyler)
        {
            _okonomi[id] = e.O;
        }

        foreach (var (id, f) in _oppfolging)
        {
            if (f.O is { } ok)
            {
                _okonomi[id] = ok;
            }
        }

        _pagaende = prosjekter
            .Select(p => (p, _okonomi.GetValueOrDefault(p.Id) is { Tilbud.Count: > 0 } o ? o : null))
            .OrderBy(x => x.p.Navn)
            .ToList();
        _folgMed = _pagaende.Where(x => ErVarsel(x.O)).Select(x => x.O!).ToList();
        _lastet = DateTime.Now;
        _laerdom = await OkonomiSvc.LaerdomAsync();
        _inn = await OkonomiSvc.InnstillingerAsync();
        await LastTimekostAsync();
    }

    // Varsel i menyen: prosjekter som taper fortjeneste (faktisk brukt mot tilbudt).
    private static bool ErVarsel(ProsjektOkonomiService.Okonomi? o) => o?.TaperFortjeneste == true;

    private static string Pst(decimal v) => Math.Clamp(v * 100, 0, 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";
    private static string Pst100(decimal v) => Math.Round(v * 100).ToString("0", Kultur) + " %";

    private async Task OppdaterIntern()
    {
        await LastAsync();
        _melding = null;
    }

    private Task VekslFull() => Kjor(VekslFullIntern);

    private async Task VekslFullIntern()
    {
        _full = !_full;
        await VisningPref.SettAsync("etterkalkyle-bredde", _full ? "full" : "normal");
    }

    private async Task ApneIntern(int prosjektId)
    {
        _apenOkonomi = await OkonomiSvc.BeregnAsync(prosjektId);
        _apenProsjekt = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder).FirstOrDefaultAsync(p => p.Id == prosjektId);
        // Et utkast er ikke signert; feltene fylles fra det, og ellers med forslag.
        var lagret = await Db.ProsjektEtterkalkyler.AsNoTracking().FirstOrDefaultAsync(k => k.ProsjektId == prosjektId);
        _apenKontroll = lagret is { ErUtkast: false } ? lagret : null;
        _apenUtkast = lagret is { ErUtkast: true };
        _apenEtterkalkyle = _apenProsjekt?.Status == ProsjektStatus.Overlevert ? await OppfolgingSvc.EtterkalkyleAsync(prosjektId) : null;
        var ek = lagret is null ? _apenEtterkalkyle : null;
        _arsak = lagret?.Arsak ?? ek?.ForeslattArsak ?? EtterkalkyleArsak.IngenAvvik;
        _arsakForeslatt = lagret is null && ek is not null;
        _kommentar = lagret?.Kommentar ?? "";
        _gikkBra = lagret?.GikkBra;
        _gikkDarlig = lagret?.GikkDarlig;
        _forbedre = lagret?.Forbedre;
        _forsinkelseEgne = lagret?.ForsinkelseEgne;
        _forsinkelseAndre = lagret?.ForsinkelseAndre ?? ek?.ForslagForsinkelseAndre;
        _melding = null;
    }

    private bool _apenUtkast;
    private bool _arsakForeslatt;
    private ProsjektOppfolgingService.Etterkalkyle? _apenEtterkalkyle;
    private Dictionary<int, ProsjektOppfolgingService.Etterkalkyle> _etterkalkyler = [];
    private HashSet<int> _utkast = [];

    // Gjennomgangen i tre trinn: se tallene, årsak og lærdom, signer.
    private int GjennomgangTrinn => string.IsNullOrWhiteSpace(_kommentar) && string.IsNullOrWhiteSpace(_gikkBra) && string.IsNullOrWhiteSpace(_gikkDarlig) && string.IsNullOrWhiteSpace(_forbedre) ? 2 : 3;

    private Task LagreUtkast() => Kjor(async () =>
    {
        if (_apenProsjekt is not { } p)
        {
            return;
        }

        await OkonomiSvc.LagreUtkastAsync(p.Id, _arsak, _kommentar, _brukerNavn,
            new ProsjektOkonomiService.Evaluering(_gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre));
        _apenUtkast = true;
        _utkast.Add(p.Id);
        _melding = "Utkastet er lagret. Prosjektet står fortsatt under Til gjennomgang.";
    });

    // Prosjektet er satt som overlevert under Pågående: vis etterkalkylen med en
    // gang. Siden kan bli laget på nytt når adressen endres, så prosjektet sendes
    // med i adressen og åpnes derfra.
    private void VedOverlevert(int prosjektId) =>
        Nav.NavigateTo($"/prosjektokonomi/etterkalkyle?prosjekt={prosjektId}&overlevert=1", forceLoad: true);

    private Task EtterkalkyleEndret() => Kjor(async () =>
    {
        await LastAsync();
        if (_apenProsjekt is { } p)
        {
            _apenOkonomi = await OkonomiSvc.BeregnAsync(p.Id);
            _apenEtterkalkyle = p.Status == ProsjektStatus.Overlevert ? await OppfolgingSvc.EtterkalkyleAsync(p.Id) : null;
        }
    });

    // Prosjekter uten godkjent kalkyle kan avsluttes uten etterkalkyle.
    private Task AvsluttUtenKalkyle(Prosjekt p) => Kjor(async () =>
    {
        await OkonomiSvc.KontrollerAsync(p.Id, EtterkalkyleArsak.Annet, "Avsluttet uten etterkalkyle: ingen godkjent kalkyle å sammenligne med.", _brukerNavn);
        await LastAsync();
        _melding = $"{p.Navn} er avsluttet uten etterkalkyle og lagt under Kontrollert.";
    });

    private async Task KontrollerIntern()
    {
        if (_apenProsjekt is not { } p)
        {
            return;
        }

        if (_arsak != EtterkalkyleArsak.IngenAvvik && string.IsNullOrWhiteSpace(_kommentar))
        {
            _melding = "Skriv en kort kommentar om hva som skjedde.";
            return;
        }

        await OkonomiSvc.KontrollerAsync(p.Id, _arsak, _kommentar, _brukerNavn,
            new ProsjektOkonomiService.Evaluering(_gikkBra, _gikkDarlig, _forbedre, _forsinkelseEgne, _forsinkelseAndre));
        _apenProsjekt = null;
        await LastAsync();
        _melding = $"{p.Navn} er kontrollert og lagt i arkivet.";
    }

    private async Task LagreInnstillingerIntern()
    {
        if (_inn is null)
        {
            return;
        }

        var inn = await Db.OkonomiInnstillinger.FirstAsync(i => i.Id == _inn.Id);
        inn.InternTimekost = _inn.InternTimekost is > 0 ? _inn.InternTimekost : null;
        inn.GulProsentOverBudsjett = Math.Clamp(_inn.GulProsentOverBudsjett, 0, 100);
        inn.GulTimerBruktProsent = Math.Clamp(_inn.GulTimerBruktProsent, 1, 100);
        inn.GulFremdriftProsent = Math.Clamp(_inn.GulFremdriftProsent, 1, 100);
        await Db.SaveChangesAsync();
        await LastAsync();
        _melding = "Innstillingene er lagret. Status på prosjektene er regnet ut på nytt.";
    }

    private async Task JusterMontasjetidIntern(ProsjektOkonomiService.Laerdom l)
    {
        if (l.ForslagMinutter is not { } nye)
        {
            return;
        }

        var c = await Db.Components.FirstAsync(x => x.Id == l.ComponentId);
        c.MontasjeMinutterProsjekt = nye;
        await Db.SaveChangesAsync();
        _laerdom.Remove(l);
        _melding = $"Montasjetiden for {l.Navn} er satt til {nye} minutter. Nye tilbud bruker den nye tiden.";
    }

    // ---------- Hjelpere ----------
    private static string Kr(decimal v) => v.ToString("#,##0", Kultur) + " kr";
    private static string DG(decimal? v) => v is { } d ? (d * 100).ToString("0.#", Kultur) + " %" : "–";

    private static string Avvik(decimal v, decimal mot)
    {
        if (mot <= 0) return "–";
        var p = (v / mot - 1) * 100;
        return (p > 0 ? "+" : "") + p.ToString("0", Kultur) + " %";
    }

    private static string Klasse(ProsjektOkonomiService.OkonomiStatus s) => s switch
    {
        ProsjektOkonomiService.OkonomiStatus.OverBudsjett => "rod",
        ProsjektOkonomiService.OkonomiStatus.FolgMed => "gul",
        ProsjektOkonomiService.OkonomiStatus.IRute => "gronn",
        _ => "n"
    };

    // ======================================================================
    // Undermenyen i fanen Etterkalkyle.
    private RenderFragment EtterkalkyleMeny() => @<nav class="ek-undermeny" aria-label="Etterkalkyle">
        <a class="@(Visning == "etterkalkyle" ? "aktiv" : "")" href="/prosjektokonomi/etterkalkyle">Til gjennomgang<small>@_tilGjennomgang.Count</small></a>
        <a class="@(Visning == "kontrollert" ? "aktiv" : "")" href="/prosjektokonomi/kontrollert">Kontrollert<small>@_kontrollerte.Count</small></a>
        <a class="@(Visning == "laerdom" ? "aktiv" : "")" href="/prosjektokonomi/laerdom">Lærdom<small>@_laerdom.Count</small></a>
    </nav>;

    private static string Fortegn(decimal v) => Math.Abs(v) < 1 ? "0" : (v > 0 ? "+" : "−") + Math.Abs(v).ToString("#,##0", Kultur);

    private string _ekSok = "";
    private string _ekFilter = "alle";
    private string _ekSorter = "verst";
    private bool _visMangler;
    private bool _visUtenKalkyle;

    private static string DomOrd(ProsjektOppfolgingService.Etterkalkyle e) => e.ManglerData ? "Mangler data" : e.DomTekst;

    private static string DomKlasse(ProsjektOppfolgingService.Etterkalkyle e) => e.ManglerData ? "ek-chip-gul" : e.Dom switch
    {
        ProsjektOppfolgingService.Dom.Bedre => "ek-chip-gronn",
        ProsjektOppfolgingService.Dom.Darligere => "ek-chip-rod",
        _ => ""
    };

    private static string FristTekst(ProsjektOppfolgingService.Etterkalkyle? e) =>
        e?.DagerOverFrist is { } dager ? dager > 0 ? $"{dager} dager over fristen" : dager == 0 ? "på fristen" : $"{-dager} dager før fristen" : "";

    private bool EkFilter(Prosjekt p, ProsjektOppfolgingService.Etterkalkyle e) => _ekFilter switch
    {
        "darligere" => e.Dom == ProsjektOppfolgingService.Dom.Darligere,
        "bedre" => e.Dom == ProsjektOppfolgingService.Dom.Bedre,
        "mine" => _brukerId is not null && p.ProsjektlederId == _brukerId,
        _ => true
    };

    private bool EkSok(Prosjekt p) =>
        string.IsNullOrWhiteSpace(_ekSok)
        || $"{p.Navn} {p.Kunde?.Navn} {p.Prosjektleder?.Navn}".Contains(_ekSok.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private RenderFragment EkFilterKnapp(string id, string tekst, int antall) => @<button type="button" class="ek-arsak @(_ekFilter == id ? "aktiv" : "")" aria-pressed="@(_ekFilter == id ? "true" : "false")" @onclick="@(() => _ekFilter = id)">@tekst <small>@antall</small></button>;

    private RenderFragment Gjennomgang() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Til gjennomgang</h2><p>Overleverte prosjekter, med hvordan det gikk mot kalkylen. Åpne et prosjekt for å se hvor avviket kom fra, sjekke at tallene er komplette, skrive årsak og signere.</p></span>
        </div>
        @if (_tilGjennomgang.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="check-circle" /><span>Ingen prosjekter venter på gjennomgang.</span></div>
        }
        else
        {
            var medKalkyle = _tilGjennomgang.Where(p => _etterkalkyler.ContainsKey(p.Id)).Select(p => (Prosjekt: p, E: _etterkalkyler[p.Id])).ToList();
            var klare = medKalkyle.Where(x => !x.E.ManglerData).ToList();
            var mangler = medKalkyle.Where(x => x.E.ManglerData).ToList();
            var utenKalkyle = _tilGjennomgang.Where(p => !_etterkalkyler.ContainsKey(p.Id)).ToList();
            var resultatAvvik = klare.Sum(x => x.E.ResultatAvvik);
            var traff = klare.Count(x => x.E.Dom != ProsjektOppfolgingService.Dom.Darligere);
            var eldst = klare.Select(x => x.Prosjekt.OverlevertDato).Where(d => d is not null).Min();
            IEnumerable<(Prosjekt Prosjekt, ProsjektOppfolgingService.Etterkalkyle E)> rader = klare.Where(x => EkFilter(x.Prosjekt, x.E) && EkSok(x.Prosjekt));
            rader = _ekSorter switch
            {
                "eldst" => rader.OrderBy(x => x.Prosjekt.OverlevertDato ?? DateTime.MaxValue),
                "navn" => rader.OrderBy(x => x.Prosjekt.Navn),
                _ => rader.OrderBy(x => x.E.DgPoeng).ThenBy(x => x.Prosjekt.OverlevertDato)
            };
            var liste = rader.ToList();

            <div class="ek-kpi ek-kpi-ny">
                <div class="ek-kpi-hoved">
                    <span><Icon Name="trend-up" />Resultat mot kalkyle</span>
                    <b class="@(resultatAvvik < -0.5m ? "ek-rod" : resultatAvvik > 0.5m ? "ek-gronn" : "")">@Fortegn(resultatAvvik) kr</b>
                    <small>faktisk @Kr(klare.Sum(x => x.E.FaktiskResultat)) · kalkulert @Kr(klare.Sum(x => x.E.KalkResultat))</small>
                </div>
                <div>
                    <span><Icon Name="check-circle" />Traff kalkylen</span>
                    <b>@traff av @klare.Count</b>
                    <small>@(klare.Count > 0 ? $"{Math.Round(traff * 100m / klare.Count):0} % lik eller bedre enn kalkulert" : "ingen å vurdere ennå")</small>
                </div>
                <div>
                    <span><Icon Name="clipboard" />Klare til gjennomgang</span>
                    <b>@klare.Count</b>
                    <small>@(eldst is { } d ? $"eldste overlevert {d:dd.MM.yyyy}" : "–")</small>
                </div>
                <button type="button" class="@(mangler.Count > 0 ? "ek-kpi-gul" : "")" @onclick="@(() => _visMangler = true)">
                    <span><Icon Name="alert-triangle" />Mangler data</span>
                    <b>@mangler.Count</b>
                    <small>kan ikke vurderes før timer eller varer er registrert</small>
                </button>
            </div>

            <div class="ek-verktoy">
                <label class="ek-sok"><Icon Name="search" /><input type="search" placeholder="Søk prosjekt, kunde eller prosjektleder" aria-label="Søk" @bind="_ekSok" @bind:event="oninput" /></label>
                <div class="ek-filter">
                    @EkFilterKnapp("alle", "Alle", klare.Count)
                    @EkFilterKnapp("darligere", "Dårligere enn kalkulert", klare.Count(x => x.E.Dom == ProsjektOppfolgingService.Dom.Darligere))
                    @EkFilterKnapp("bedre", "Bedre enn kalkulert", klare.Count(x => x.E.Dom == ProsjektOppfolgingService.Dom.Bedre))
                    @if (_brukerId is not null)
                    {
                        @EkFilterKnapp("mine", "Mine prosjekter", klare.Count(x => x.Prosjekt.ProsjektlederId == _brukerId))
                    }
                </div>
                <select class="ek-sorter" aria-label="Sorter" @bind="_ekSorter">
                    <option value="verst">Dårligst først</option>
                    <option value="eldst">Eldst overlevert først</option>
                    <option value="navn">Navn</option>
                </select>
            </div>

            <div class="ek-gruppe-topp"><h3>Klar til gjennomgang</h3><small>@liste.Count</small></div>
            @if (liste.Count == 0)
            {
                <div class="ek-tomboks"><Icon Name="check-circle" /><span>@(klare.Count == 0 ? "Ingen prosjekter med komplette tall venter på gjennomgang." : "Ingen prosjekter passer søket eller filteret.")</span>
                    @if (klare.Count > 0)
                    {
                        <button type="button" class="ek-knapp" @onclick="@(() => { _ekFilter = "alle"; _ekSok = ""; })">Vis alle</button>
                    }
                </div>
            }
            else
            {
                <div class="ek-tabellramme">
                    <table class="ek-tabell ek-kortliste ek-gjennomgang">
                        <thead><tr><th>Prosjekt</th><th>Slik gikk det</th><th class="n">Resultat mot kalkyle</th><th class="n">Dekningsgrad</th><th>Største avvik</th><th>Overlevert</th></tr></thead>
                        <tbody>
                            @foreach (var (p, e) in liste)
                            {
                                var id = p.Id;
                                var (avvikTekst, avvikNiva) = e.StorsteAvvik;
                                var bredde = Math.Min(50m, Math.Abs(e.DgPoeng) * 4).ToString("0.#", CultureInfo.InvariantCulture);
                                <tr class="ek-klikkrad" tabindex="0" @onclick="@(() => ApneAsync(id))" @onkeydown="@(ev => ev.Key == "Enter" ? ApneAsync(id) : Task.CompletedTask)">
                                    <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · {pl.Navn}" : "")@(_utkast.Contains(p.Id) ? " · utkast lagret" : "")</small></td>
                                    <td data-label="Slik gikk det"><span class="ek-chip @DomKlasse(e)">@DomOrd(e)</span></td>
                                    <td class="n" data-label="Resultat mot kalkyle"><b class="@(e.ResultatAvvik < -0.5m ? "ek-rod" : e.ResultatAvvik > 0.5m ? "ek-gronn" : "")">@Fortegn(e.ResultatAvvik) kr</b><small>faktisk @Kr(e.FaktiskResultat)</small></td>
                                    <td class="n" data-label="Dekningsgrad"><b>@DG(e.FaktiskDG)</b><small>kalkulert @DG(e.KalkDG)</small><span class="ek-avvikbar"><em></em><i class="@(e.DgPoeng < 0 ? "ek-avvikbar-ned" : "ek-avvikbar-opp")" style="width:@(bredde)%"></i></span></td>
                                    <td data-label="Største avvik"><span class="ek-chip @NivaKlasse(avvikNiva)">@avvikTekst</span></td>
                                    <td data-label="Overlevert">@(p.OverlevertDato?.ToString("dd.MM.yyyy") ?? "–")<small class="@(e.DagerOverFrist > 0 ? "ek-rod" : "")">@FristTekst(e)</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (mangler.Count > 0)
            {
                <button type="button" class="ek-gruppe-topp ek-gruppe-knapp" aria-expanded="@(_visMangler ? "true" : "false")" @onclick="@(() => _visMangler = !_visMangler)">
                    <Icon Name="@(_visMangler ? "chevron-down" : "chevron-right")" /><h3>Mangler data – kan ikke vurderes ennå</h3><small>@mangler.Count</small>
                </button>
                @if (_visMangler)
                {
                    <div class="ek-tabellramme">
                        <table class="ek-tabell ek-kortliste">
                            <tbody>
                                @foreach (var (p, e) in mangler.Where(x => EkSok(x.Prosjekt)))
                                {
                                    var id = p.Id;
                                    <tr>
                                        <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · {pl.Navn}" : "")</small></td>
                                        <td data-label="Mangler">@foreach (var m in e.Mangler.Where(m => m.Kode is "timer" or "varer")) {<span class="ek-chip ek-chip-gul ek-chip-mellom">@m.Tittel</span>}</td>
                                        <td data-label="Overlevert">@(p.OverlevertDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                        <td class="n"><button type="button" class="ek-knapp ek-knapp-s" @onclick="@(() => ApneAsync(id))">Rett opp</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (utenKalkyle.Count > 0)
            {
                <button type="button" class="ek-gruppe-topp ek-gruppe-knapp" aria-expanded="@(_visUtenKalkyle ? "true" : "false")" @onclick="@(() => _visUtenKalkyle = !_visUtenKalkyle)">
                    <Icon Name="@(_visUtenKalkyle ? "chevron-down" : "chevron-right")" /><h3>Mangler kalkyle</h3><small>@utenKalkyle.Count</small>
                </button>
                @if (_visUtenKalkyle)
                {
                    <div class="ek-tabellramme">
                        <table class="ek-tabell ek-kortliste">
                            <tbody>
                                @foreach (var x in utenKalkyle.Where(EkSok))
                                {
                                    var p = x;
                                    <tr>
                                        <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · {pl.Navn}" : "")</small></td>
                                        <td><small>Ingen godkjent kalkyle å sammenligne med. Godkjenn tilbudet på prosjektet, eller avslutt uten etterkalkyle.</small></td>
                                        <td data-label="Overlevert">@(p.OverlevertDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                        <td class="n ek-knapper"><button type="button" class="ek-knapp ek-knapp-s" @onclick="@(() => ApneAsync(p.Id))">Åpne</button><button type="button" class="ek-knapp ek-knapp-s" @onclick="@(() => AvsluttUtenKalkyle(p))">Avslutt uten kalkyle</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    </div>;

    // Filtrene over lista. «folg» er den gamle adressen /prosjektokonomi/folg
    // (varselbjella), og viser de som taper fortjeneste.
    private bool IFilter(Prosjekt p, ProsjektOkonomiService.Okonomi? o)
    {
        var f = _oppfolging.GetValueOrDefault(p.Id);
        return _filter switch
        {
            "trenger" => f?.NesteStegNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod,
            "fakturer" => f is not null && (f.KlarAkonto is not null || f.UtfortIkkeFakturert > 0),
            "taper" or "folg" or "over" => f?.FortjenesteNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod,
            "akonto" => f?.KlarAkonto is not null,
            "mine" => p.ProsjektlederId == _brukerId && _brukerId is not null,
            _ => true
        };
    }

    private bool ISok(Prosjekt p) =>
        string.IsNullOrWhiteSpace(_sok)
        || $"{p.Navn} {p.Kunde?.Navn} {p.Prosjektleder?.Navn}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase);

    // Sorteringen. «Mest kritisk» setter dem som taper mest av fortjenesten øverst.
    private IEnumerable<(Prosjekt Prosjekt, ProsjektOkonomiService.Okonomi? O)> Sorter(IEnumerable<(Prosjekt Prosjekt, ProsjektOkonomiService.Okonomi? O)> liste)
    {
        ProsjektOppfolgingService.Oppfolging? F((Prosjekt Prosjekt, ProsjektOkonomiService.Okonomi? O) x) => x.O is null ? null : _oppfolging.GetValueOrDefault(x.Prosjekt.Id);
        static int Rang(ProsjektOppfolgingService.Oppfolging? f) => f?.FortjenesteNiva switch
        {
            ProsjektOppfolgingService.Niva.Rod => 0,
            ProsjektOppfolgingService.Niva.Gul => 1,
            ProsjektOppfolgingService.Niva.Gronn => 2,
            _ => 3
        };
        static decimal Andel(ProsjektOppfolgingService.Oppfolging? f) => f is { TilbudtFortjeneste: > 0 } ? f.FortjenesteIgjen / f.TilbudtFortjeneste : 1;

        return _sorter switch
        {
            "fakturer" => liste.OrderByDescending(x => F(x)?.UtfortIkkeFakturert ?? -1).ThenBy(x => x.Prosjekt.Navn),
            "fortjeneste" => liste.OrderByDescending(x => F(x)?.FortjenesteIgjen ?? decimal.MinValue).ThenBy(x => x.Prosjekt.Navn),
            "navn" => liste.OrderBy(x => x.Prosjekt.Navn),
            _ => liste.OrderBy(x => Rang(F(x))).ThenBy(x => Andel(F(x))).ThenByDescending(x => F(x)?.UtfortIkkeFakturert ?? 0).ThenBy(x => x.Prosjekt.Navn)
        };
    }

    private static string NivaKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gronn => "ek-chip-gronn",
        ProsjektOppfolgingService.Niva.Gul => "ek-chip-gul",
        ProsjektOppfolgingService.Niva.Rod => "ek-chip-rod",
        _ => ""
    };

    private static string NivaOrd(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gronn => "I rute",
        ProsjektOppfolgingService.Niva.Gul => "Følg med",
        ProsjektOppfolgingService.Niva.Rod => "Taper fortjeneste",
        _ => "–"
    };

    private static string MalerKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gul => "ek-maler-gul",
        ProsjektOppfolgingService.Niva.Rod => "ek-maler-rod",
        _ => ""
    };

    private static string MalerBredde(decimal igjen, decimal tilbudt) =>
        Math.Clamp(tilbudt > 0 ? igjen / tilbudt * 100 : 0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private RenderFragment FilterKnapp(string id, string tekst, int antall) => @<button type="button" class="ek-arsak @(_filter == id ? "aktiv" : "")" aria-pressed="@(_filter == id ? "true" : "false")" @onclick="@(() => _filter = id)">@tekst <small>@antall</small></button>;

    private RenderFragment Pagaende() => @<div class="ek-fane">
        <div class="ek-fane-topp">
            <span><h2>Pågående prosjekter</h2><p>Tjener vi penger på prosjektene, og hva må gjøres nå? Tallene er bare faktisk brukt mot det som er tilbudt. Trykk på et prosjekt for detaljer, fremdriftsplan og fakturering.</p></span>
            <span class="ek-knapper">
                <span class="ek-oppdatert"><i class="ek-live"></i>Live · oppdatert @_lastet.ToString("HH:mm:ss")</span>
                <button type="button" class="ek-knapp" @onclick="OppdaterAsync">Oppdater tallene</button>
            </span>
        </div>
        @{
            var alle = _oppfolging.Values.ToList();
            var medTall = alle.Where(f => f.O is { Inntekt: > 0 }).ToList();
            var igjen = medTall.Sum(f => f.FortjenesteIgjen);
            var tilbudt = medTall.Sum(f => f.TilbudtFortjeneste);
            var klart = alle.Where(f => f.UtfortIkkeFakturert > 0).ToList();
            var taper = medTall.Where(f => f.FortjenesteNiva == ProsjektOppfolgingService.Niva.Rod).ToList();
            var liste = Sorter(_pagaende.Where(x => IFilter(x.Prosjekt, x.O) && ISok(x.Prosjekt))).ToList();
            var totalNiva = tilbudt > 0 && tilbudt - igjen > tilbudt * 0.25m || igjen < 0 ? ProsjektOppfolgingService.Niva.Rod : tilbudt > 0 && tilbudt - igjen > tilbudt * 0.05m ? ProsjektOppfolgingService.Niva.Gul : ProsjektOppfolgingService.Niva.Gronn;
        }
        <div class="ek-kpi ek-kpi-ny">
            <div class="ek-kpi-hoved">
                <span><Icon Name="trend-up" />Fortjeneste igjen</span>
                <b class="@(igjen < 0 ? "ek-rod" : "")">@Kr(igjen)</b>
                <span class="ek-maler"><i class="@MalerKlasse(totalNiva)" style="width:@MalerBredde(igjen, tilbudt)"></i></span>
                <small>av @Kr(tilbudt) i tilbudene</small>
            </div>
            <button type="button" class="@(klart.Count > 0 ? "ek-kpi-gul" : "")" @onclick="@(() => { _filter = "fakturer"; _sorter = "fakturer"; })">
                <span><Icon Name="file-text" />Utført, ikke fakturert</span>
                <b>@Kr(klart.Sum(f => f.UtfortIkkeFakturert))</b>
                <small>@klart.Count @(klart.Count == 1 ? "prosjekt" : "prosjekter") · vis</small>
            </button>
            <div>
                <span><Icon Name="bar-chart" />Ordrereserve</span>
                <b>@Kr(alle.Sum(f => f.Gjenstar))</b>
                <small>Gjenstår å fakturere · denne måneden fakturert @Kr(alle.Sum(f => f.FakturertDenneMaaned))</small>
            </div>
            <button type="button" class="@(taper.Count > 0 ? "ek-kpi-rod" : "")" @onclick="@(() => { _filter = "taper"; _sorter = "kritisk"; })">
                <span><Icon Name="alert-triangle" />Taper fortjeneste</span>
                <b>@taper.Count</b>
                <small>@(taper.Count == 1 ? "prosjekt" : "prosjekter") · vis</small>
            </button>
        </div>
        <div class="ek-verktoy">
            <label class="ek-sok"><Icon Name="search" /><input type="search" placeholder="Søk prosjekt, kunde eller prosjektleder" aria-label="Søk" @bind="_sok" @bind:event="oninput" /></label>
            <div class="ek-filter">
                @FilterKnapp("alle", "Alle", _pagaende.Count)
                @FilterKnapp("trenger", "Trenger handling", _pagaende.Count(x => _oppfolging.GetValueOrDefault(x.Prosjekt.Id)?.NesteStegNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod))
                @FilterKnapp("fakturer", "Kan faktureres", klart.Count)
                @FilterKnapp("taper", "Taper fortjeneste", medTall.Count(f => f.FortjenesteNiva is ProsjektOppfolgingService.Niva.Gul or ProsjektOppfolgingService.Niva.Rod))
                @if (_brukerId is not null)
                {
                    @FilterKnapp("mine", "Mine prosjekter", _pagaende.Count(x => x.Prosjekt.ProsjektlederId == _brukerId))
                }
            </div>
            <select class="ek-sorter" aria-label="Sorter" @bind="_sorter">
                <option value="kritisk">Mest kritisk først</option>
                <option value="fakturer">Mest å fakturere</option>
                <option value="fortjeneste">Størst fortjeneste igjen</option>
                <option value="navn">Navn</option>
            </select>
        </div>
        @if (liste.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="check-circle" /><span>@(_pagaende.Count == 0 ? "Ingen prosjekter er registrert eller under arbeid." : "Ingen prosjekter passer søket eller filteret.")</span>
                @if (_pagaende.Count > 0)
                {
                    <button type="button" class="ek-knapp" @onclick="@(() => { _filter = "alle"; _sok = ""; })">Vis alle</button>
                }
            </div>
        }
        else
        {
            <div class="ek-tabellramme">
                <table class="ek-tabell ek-kortliste ek-pagaende">
                    <thead><tr><th>Prosjekt</th><th>Status</th><th>Fortjeneste igjen</th><th>Utført / fakturert</th><th>Neste steg</th></tr></thead>
                    <tbody>
                        @foreach (var (p, o) in liste)
                        {
                            var id = p.Id;
                            var f = _oppfolging.GetValueOrDefault(p.Id);
                            <tr class="ek-klikkrad" tabindex="0" @onclick="@(() => ApneAsync(id))" @onkeydown="@(e => e.Key == "Enter" ? ApneAsync(id) : Task.CompletedTask)">
                                <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · PL {pl.Navn}" : "") · @(p.Status?.Visningsnavn() ?? "Aktiv")</small></td>
                                @if (o is { Inntekt: > 0 } && f is not null)
                                {
                                    <td data-label="Status"><span class="ek-chip @NivaKlasse(f.FortjenesteNiva)">@NivaOrd(f.FortjenesteNiva)</span><small>@(f.FortjenesteArsak ?? "Innenfor tilbudet så langt")</small></td>
                                    <td class="ek-fremdrift" data-label="Fortjeneste igjen"><b class="@(f.FortjenesteIgjen < 0 ? "ek-rod" : "")">@Kr(f.FortjenesteIgjen)</b><span class="ek-maler ek-maler-liten"><i class="@MalerKlasse(f.FortjenesteNiva)" style="width:@MalerBredde(f.FortjenesteIgjen, f.TilbudtFortjeneste)"></i></span><small>av @Kr(f.TilbudtFortjeneste)</small></td>
                                    <td class="ek-fremdrift" data-label="Utført / fakturert"><small class="ek-svart">@Pst100(f.Fremdrift) utført · @Pst100(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0) fakturert</small><span class="ek-minibar ek-minibar-aks ek-minibar-mal"><i style="width:@Pst(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0)"></i><em style="left:@Pst(f.Fremdrift)"></em></span>@if (f.ForsinkedeAktiviteter > 0) {<small class="ek-rod">@f.ForsinkedeAktiviteter forsinket i planen</small>}</td>
                                    <td data-label="Neste steg"><span class="ek-chip @NivaKlasse(f.NesteStegNiva)">@f.NesteSteg</span></td>
                                }
                                else
                                {
                                    <td colspan="3"><small>@(o is null ? "Budsjettet låses når et tilbud på prosjektet settes til Godkjent." : "Det godkjente tilbudet har ingen beløp. Legg inn linjer i tilbudet, så følges økonomien opp.")</small></td>
                                    <td><span class="ek-chip">@(o is null ? "Mangler godkjent tilbud" : "Tilbud uten beløp")</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    // Resultat mot kalkyle for et kontrollert prosjekt: (faktisk DG − kalkulert DG) × inntekt.
    private static decimal AvvikKr(ProsjektEtterkalkyle k) => ((k.FaktiskDekningsgrad ?? 0) - (k.BudsjettDekningsgrad ?? 0)) * k.Inntekt;

    // Traff kalkylen: ikke mer enn 3 poeng dårligere dekningsgrad, som «Slik gikk det».
    private static bool Traff(ProsjektEtterkalkyle k) => ((k.FaktiskDekningsgrad ?? 0) - (k.BudsjettDekningsgrad ?? 0)) * 100 > -3 && k.Inntekt - k.FaktiskKost >= 0;

    private static readonly string[] Maaneder = ["jan", "feb", "mar", "apr", "mai", "jun", "jul", "aug", "sep", "okt", "nov", "des"];

    private RenderFragment Gruppetabell(string tittel, string kolonne, IEnumerable<IGrouping<string, ProsjektEtterkalkyle>> grupper) => @<section class="ek-boks">
        <h3>@tittel</h3>
        <div class="ek-tabellramme">
            <table class="ek-tabell">
                <thead><tr><th>@kolonne</th><th class="n">Antall</th><th class="n">DG kalk. → faktisk</th><th class="n">Mot kalkyle</th><th class="n">Traff</th></tr></thead>
                <tbody>
                    @foreach (var g in grupper.OrderBy(g => g.Sum(AvvikKr)))
                    {
                        var inntekt = g.Sum(k => k.Inntekt);
                        var kalk = inntekt > 0 ? (inntekt - g.Sum(k => k.BudsjettKost)) / inntekt : (decimal?)null;
                        var fakt = inntekt > 0 ? (inntekt - g.Sum(k => k.FaktiskKost)) / inntekt : (decimal?)null;
                        var avvik = g.Sum(AvvikKr);
                        <tr>
                            <td><b>@g.Key</b></td>
                            <td class="n">@g.Count()</td>
                            <td class="n">@DG(kalk) → <b class="@((fakt - kalk) * 100 <= -3 ? "ek-rod" : (fakt - kalk) * 100 >= 2 ? "ek-gronn" : "")">@DG(fakt)</b></td>
                            <td class="n @(avvik < -0.5m ? "ek-rod" : avvik > 0.5m ? "ek-gronn" : "")">@Fortegn(avvik)</td>
                            <td class="n">@Math.Round(g.Count(Traff) * 100m / g.Count()) %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment Kontrollerte() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Kontrollert</h2><p>Gjennomgåtte prosjekter, med tallene slik de var da de ble kontrollert. Over lista ser du hvordan kalkylene treffer over tid, per prosjektleder og per jobbtype.</p></span>
        </div>
        @if (_kontrollerte.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="clipboard" /><span>Ingen prosjekter er kontrollert ennå.</span></div>
        }
        else
        {
            var medTall = _kontrollerte.Where(k => k.Inntekt > 0).ToList();
            var inntekt = medTall.Sum(k => k.Inntekt);
            var avvikSum = medTall.Sum(AvvikKr);
            var traff = medTall.Count(Traff);
            var forste = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-5);
            var maaneder = Enumerable.Range(0, 6).Select(i => forste.AddMonths(i))
                .Select(m => (Mnd: m, Avvik: medTall.Where(k => k.Kontrollert >= m && k.Kontrollert < m.AddMonths(1)).Sum(AvvikKr), Antall: medTall.Count(k => k.Kontrollert >= m && k.Kontrollert < m.AddMonths(1))))
                .ToList();
            var maks = Math.Max(1, maaneder.Max(m => Math.Abs(m.Avvik)));
            var arsaker = _kontrollerte.GroupBy(k => k.Arsak).Select(g => (Arsak: g.Key, Antall: g.Count())).OrderByDescending(x => x.Antall).ToList();
            <div class="ek-kpi ek-kpi-ny">
                <div><span><Icon Name="clipboard" />Kontrollerte prosjekter</span><b>@_kontrollerte.Count</b><small>@(medTall.Count < _kontrollerte.Count ? $"{_kontrollerte.Count - medTall.Count} uten kalkyle" : "alle med kalkyle")</small></div>
                <div class="ek-kpi-hoved"><span><Icon Name="trend-up" />Resultat mot kalkyle</span><b class="@(avvikSum < -0.5m ? "ek-rod" : avvikSum > 0.5m ? "ek-gronn" : "")">@Fortegn(avvikSum) kr</b><small>samlet for de kontrollerte prosjektene</small></div>
                <div><span><Icon Name="check-circle" />Traff kalkylen</span><b>@(medTall.Count > 0 ? $"{Math.Round(traff * 100m / medTall.Count):0} %" : "–")</b><small>@traff av @medTall.Count lik eller bedre</small></div>
                <div><span><Icon Name="bar-chart" />Dekningsgrad</span><b>@DG(inntekt > 0 ? (inntekt - medTall.Sum(k => k.FaktiskKost)) / inntekt : null)</b><small>kalkulert @DG(inntekt > 0 ? (inntekt - medTall.Sum(k => k.BudsjettKost)) / inntekt : null)</small></div>
            </div>

            @if (medTall.Count > 0)
            {
                <div class="ek-to">
                    <section class="ek-boks">
                        <h3>Resultat mot kalkyle per måned</h3>
                        <div class="ek-stolper" role="img" aria-label="Resultat mot kalkyle per måned, siste seks måneder">
                            @foreach (var m in maaneder)
                            {
                                <div class="ek-stolpe">
                                    <em>@(m.Antall > 0 ? (m.Avvik >= 0 ? "+" : "−") + Math.Abs(Math.Round(m.Avvik / 1000)).ToString("0", Kultur) + "k" : "")</em>
                                    <i class="@(m.Avvik < 0 ? "ned" : "opp")" style="height:@(Math.Max(m.Antall > 0 ? 4 : 0, Math.Abs(m.Avvik) / maks * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i>
                                    <small>@Maaneder[m.Mnd.Month - 1]</small>
                                </div>
                            }
                        </div>
                        <p class="ek-fot">Rødt: tapte mot kalkylen. Grønt: tjente mer enn kalkulert. Etter måneden prosjektet ble kontrollert.</p>
                    </section>
                    <section class="ek-boks">
                        <h3>Årsaker som går igjen</h3>
                        <div class="ek-arsakliste">
                            @foreach (var a in arsaker)
                            {
                                <div><span>@a.Arsak.Visningsnavn()</span><span class="ek-arsakbar"><i class="@(a.Arsak == EtterkalkyleArsak.IngenAvvik ? "ok" : "")" style="width:@((a.Antall * 100m / _kontrollerte.Count).ToString("0.#", CultureInfo.InvariantCulture))%"></i></span><b>@a.Antall</b></div>
                            }
                        </div>
                    </section>
                </div>
                <div class="ek-to">
                    @Gruppetabell("Per prosjektleder", "Prosjektleder", medTall.GroupBy(k => k.Prosjekt?.Prosjektleder?.Navn ?? "Ingen prosjektleder"))
                    @Gruppetabell("Per jobbtype", "Jobbtype", medTall.GroupBy(k => k.Prosjekt?.Type.Visningsnavn() ?? "Annet"))
                </div>
            }

            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Prosjekt</th><th>Kontrollert</th><th>Årsak</th><th class="n">Timer</th><th class="n">Kost</th><th class="n">Dekningsgrad</th></tr></thead>
                    <tbody>
                        @foreach (var x in _kontrollerte)
                        {
                            var k = x;
                            <tr class="ek-klikkrad" @onclick="@(() => ApneAsync(k.ProsjektId))">
                                <td><b>@k.Prosjekt?.Navn</b><small>@k.Prosjekt?.Kunde?.Navn@(k.Prosjekt?.Prosjektleder is { } pl ? $" · {pl.Navn}" : "")</small></td>
                                <td>@k.Kontrollert.ToString("dd.MM.yyyy")<small>@k.KontrollertAv</small></td>
                                <td><span class="ek-chip @(k.Arsak == EtterkalkyleArsak.IngenAvvik ? "ek-chip-gronn" : "ek-chip-gul")">@k.Arsak.Visningsnavn()</span></td>
                                <td class="n">@k.FaktiskTimer.ToString("0.#", Kultur) / @k.BudsjettTimer.ToString("0.#", Kultur)<small>@Avvik(k.FaktiskTimer, k.BudsjettTimer)</small></td>
                                <td class="n">@Kr(k.FaktiskKost)<small>@Avvik(k.FaktiskKost, k.BudsjettKost)</small></td>
                                <td class="n"><b class="@(k.FaktiskDekningsgrad < k.BudsjettDekningsgrad ? "ek-rod" : "ek-gronn")">@DG(k.FaktiskDekningsgrad)</b><small>kalkulert @DG(k.BudsjettDekningsgrad)</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>;

    private RenderFragment LaerdomVisning() => @<div class="ek-fane">
        @EtterkalkyleMeny()
        <div class="ek-fane-topp">
            <span><h2>Lærdom</h2><p>Varer der de kontrollerte prosjektene har brukt merkbart mer eller mindre tid enn beregnet (minst 15 % avvik, i minst to prosjekter). Juster montasjetiden, så treffer neste tilbud bedre.</p></span>
        </div>
        @if (_laerdom.Count == 0)
        {
            <div class="ek-tomboks"><Icon Name="sparkle" /><span>@(_kontrollerte.Count < 2 ? "Lærdom vises når minst to prosjekter er kontrollert." : "Ingen varer skiller seg ut - tilbudene treffer godt på montasjetid.")</span></div>
        }
        else
        {
            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Vare</th><th class="n">Prosjekter</th><th class="n">Faktisk mot beregnet</th><th class="n">Montasjetid nå</th><th class="n">Forslag</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in _laerdom)
                        {
                            var l = x;
                            <tr>
                                <td><b>@l.Navn</b></td>
                                <td class="n">@l.Prosjekter</td>
                                <td class="n"><b class="@(l.Forhold > 1 ? "ek-rod" : "ek-gronn")">@((l.Forhold > 1 ? "+" : "") + ((l.Forhold - 1) * 100).ToString("0", Kultur)) %</b></td>
                                <td class="n">@(l.NaMinutter?.ToString() ?? "–") min</td>
                                <td class="n">@(l.ForslagMinutter?.ToString() ?? "–") min</td>
                                <td class="n">@if (l.ForslagMinutter is not null) {<button type="button" class="ek-knapp ek-knapp-s" @onclick="@(() => JusterMontasjetid(l))">Juster</button>}</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="ek-fot">Anslag: timene føres per arbeidsordre, ikke per vare, så avviket fordeles på varene etter hvor mye av montasjetiden de sto for.</p>
            </div>
        }
    </div>;

    private RenderFragment Innstillinger() => @<div class="ek-fane">
        <div class="ek-fane-topp">
            <span><h2>Innstillinger</h2><p>Gjelder Prosjektøkonomi, fanen «Økonomi» i prosjektene og varslene.</p></span>
        </div>
        @if (_inn is { } inn)
        {
            <div class="ek-skjema">
                <label class="ek-felt">Intern timekost (kr per time)
                    <input type="number" min="0" step="1" @bind="inn.InternTimekost" placeholder="Bruker tilbudets montasje-innpris" />
                    <small>Lønn og sosiale kostnader per time. Tom = tilbudets montasje-innpris brukes.</small>
                </label>
                <label class="ek-felt">Gult varsel: prognose over budsjett med
                    <span class="ek-med-enhet"><input type="number" min="0" max="100" @bind="inn.GulProsentOverBudsjett" /> %</span>
                </label>
                <label class="ek-felt">Gult varsel: timer brukt minst
                    <span class="ek-med-enhet"><input type="number" min="1" max="100" @bind="inn.GulTimerBruktProsent" /> %</span>
                </label>
                <label class="ek-felt">… før fremdriften har nådd
                    <span class="ek-med-enhet"><input type="number" min="1" max="100" @bind="inn.GulFremdriftProsent" /> %</span>
                </label>
                <p class="ek-hint">Rødt varsel gis alltid når faktisk kost har passert budsjettet.</p>
                <span><button type="button" class="ek-knapp ek-knapp-p" @onclick="LagreInnstillinger"><Icon Name="check" />Lagre</button></span>
            </div>
        }

        <section class="ek-timekost">
            <h3>Timekost per ansatt</h3>
            <p class="ek-hint">Timekost = (årslønn × (1 + sosiale kostnader) + overhead) / fakturerbare timer i året. Timene til en ansatt med timekost regnes med den. Ellers brukes den felles timekosten over. Lagres når du går ut av feltet.</p>
            <div class="ek-tabellramme">
                <table class="ek-tabell">
                    <thead><tr><th>Ansatt</th><th class="n">Årslønn</th><th class="n">Sosiale %</th><th class="n">Overhead</th><th class="n">Fakturerbare timer</th><th class="n">Timekost</th></tr></thead>
                    <tbody>
                        @foreach (var (b, t) in _timekost)
                        {
                            var bid = b.Id;
                            <tr>
                                <td><b>@b.Navn</b><small>@(b.Stilling ?? b.Rolle.ToString())</small></td>
                                <td class="n"><input class="ek-tal" inputmode="decimal" value="@(t?.Arslonn.ToString("0", CultureInfo.InvariantCulture))" placeholder="0" @onchange="@(e => LagreTimekost(bid, x => x.Arslonn = LesTall(e) ?? 0))" aria-label="Årslønn" /></td>
                                <td class="n"><input class="ek-tal ek-tal-smal" inputmode="decimal" value="@((t?.SosialeProsent ?? 35).ToString("0.#", CultureInfo.InvariantCulture))" @onchange="@(e => LagreTimekost(bid, x => x.SosialeProsent = LesTall(e) ?? 35))" aria-label="Sosiale kostnader i prosent" /></td>
                                <td class="n"><input class="ek-tal" inputmode="decimal" value="@(t?.Overhead.ToString("0", CultureInfo.InvariantCulture))" placeholder="0" @onchange="@(e => LagreTimekost(bid, x => x.Overhead = LesTall(e) ?? 0))" aria-label="Overhead" /></td>
                                <td class="n"><input class="ek-tal ek-tal-smal" inputmode="decimal" value="@((t?.FakturerbareTimer ?? 1600).ToString("0", CultureInfo.InvariantCulture))" @onchange="@(e => LagreTimekost(bid, x => x.FakturerbareTimer = LesTall(e) ?? 1600))" aria-label="Fakturerbare timer i året" /></td>
                                <td class="n"><b>@(t is { Timekost: > 0 } ? Kr(t.Timekost) : "–")</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>;

    private List<(Bruker Bruker, AnsattTimekost? Timekost)> _timekost = [];

    private static decimal? LesTall(ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;

    private async Task LastTimekostAsync()
    {
        var brukere = await Db.Brukere.AsNoTracking()
            .Where(b => b.Aktiv && b.SlettetDato == null && b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
            .OrderBy(b => b.Navn).ToListAsync();
        var kost = await Db.AnsattTimekost.AsNoTracking().ToDictionaryAsync(t => t.BrukerId);
        _timekost = brukere.Select(b => (b, kost.GetValueOrDefault(b.Id))).ToList();
    }

    private Task LagreTimekost(int brukerId, Action<AnsattTimekost> endring) => Kjor(async () =>
    {
        var t = await Db.AnsattTimekost.FirstOrDefaultAsync(x => x.BrukerId == brukerId);
        if (t is null)
        {
            t = new AnsattTimekost { BrukerId = brukerId };
            Db.AnsattTimekost.Add(t);
        }

        endring(t);
        await Db.SaveChangesAsync();
        await LastTimekostAsync();
    });

    private RenderFragment Detalj(Prosjekt p) => @<div class="ek-fane">
        @{
            var erEtterkalkyle = p.Status == ProsjektStatus.Overlevert || _apenKontroll is not null;
            var o = _apenOkonomi;
        }
        <div class="ek-fane-topp">
            <span>
                <button type="button" class="ek-tilbake" @onclick="@(() => _apenProsjekt = null)"><Icon Name="arrow-left" />@(HovedFane == "etterkalkyle" ? "Til etterkalkylene" : "Til pågående prosjekter")</button>
                <h2>@p.Navn</h2>
                <p>@(p.Kunde?.Navn ?? "Ingen kunde")@(p.Prosjektleder is { } pl ? $" · prosjektleder {pl.Navn}" : "") · @(p.Status?.Visningsnavn() ?? "Aktiv")@(p.OverlevertDato is { } d ? $" {d:dd.MM.yyyy}" : "")</p>
            </span>
            <span class="ek-knapper">
                @if (!erEtterkalkyle)
                {
                    <span class="ek-oppdatert"><i class="ek-live"></i>Live · oppdatert @_lastet.ToString("HH:mm:ss")</span>
                }
                <a class="ek-knapp" href="@($"/prosjekter/{p.Id}")"><Icon Name="folder" />Åpne prosjektet</a>
                @if (erEtterkalkyle)
                {
                    <a class="ek-knapp" href="@($"/prosjekt/{p.Id}/etterkalkyle/pdf")" target="_blank"><Icon Name="file-text" />PDF</a>
                }
            </span>
        </div>

        @if (erEtterkalkyle)
        {
            <div class="ek-etter">
                <div class="ek-etter-hoved">
                    <EtterkalkyleVisning ProsjektId="@p.Id" Kjor="@Kjor" Oppdatert="@_lastet" Endret="@EtterkalkyleEndret" />
                    <details class="ek-grunnlag">
                        <summary>Per arbeidsordre og grunnlag</summary>
                        <ProsjektOkonomiPanel ProsjektId="@p.Id" Data="@o" Etterkalkyle="@(o is { Inntekt: > 0 })" UtenNokkeltall="true" />
                    </details>
                </div>
                <div class="ek-etter-side">
                    @Signering(p)
                </div>
            </div>
        }
        else
        {
            <ProsjektOppfolgingVisning ProsjektId="@p.Id" Kjor="@Kjor" Oppdatert="@_lastet" BrukerNavn="@_brukerNavn" Overlevert="@VedOverlevert" />
        }
    </div>;

    // Gjennomgangen: rett opp tallene, velg årsak og skriv kort hva som skjedde,
    // og signer. Lærdommen er valgfri og ligger sammenfoldet.
    private RenderFragment Signering(Prosjekt p) => @<section class="ek-signering @(_apenKontroll is not null ? "ek-signert" : "")">
        @if (_apenKontroll is { } k)
        {
            <div class="ek-signert-topp">
                <span class="ek-signert-ikon"><Icon Name="check" /></span>
                <div><b>Kontrollert @k.Kontrollert.ToString("dd.MM.yyyy") av @(k.KontrollertAv ?? "–")</b><span>@k.Arsak.Visningsnavn()@(string.IsNullOrWhiteSpace(k.Kommentar) ? "" : $" - {k.Kommentar}")</span></div>
            </div>
            <p class="ek-hint">Tallene til venstre er regnet ut på nytt nå. Tallene som ble lagret ved kontroll: tilbudt @Kr(k.Inntekt), kost @Kr(k.FaktiskKost) (budsjett @Kr(k.BudsjettKost)), dekningsgrad @DG(k.FaktiskDekningsgrad).</p>
            @if (EvalueringSvar(k).Any())
            {
                <dl class="ek-evaluering">
                    @foreach (var (sporsmal, svar) in EvalueringSvar(k))
                    {
                        <div><dt>@sporsmal</dt><dd>@svar</dd></div>
                    }
                </dl>
            }
        }
        else
        {
            var mangler = _apenEtterkalkyle?.ManglerData == true;
            var trengerKommentar = _arsak != EtterkalkyleArsak.IngenAvvik;
            var trinn = mangler ? 1 : trengerKommentar && string.IsNullOrWhiteSpace(_kommentar) ? 2 : 3;
            var aapenLaerdom = !string.IsNullOrWhiteSpace(_gikkBra) || !string.IsNullOrWhiteSpace(_gikkDarlig) || !string.IsNullOrWhiteSpace(_forbedre) || !string.IsNullOrWhiteSpace(_forsinkelseEgne) || !string.IsNullOrWhiteSpace(_forsinkelseAndre);
            <div class="ek-gjennomgang-topp">
                <h3>Gjennomgang</h3>
            </div>
            <ol class="ek-trinn" aria-label="Trinn i gjennomgangen">
                <li class="@(trinn == 1 ? "na" : "ferdig")">1 Rett opp tallene</li>
                <li class="@(trinn == 2 ? "na" : trinn > 2 ? "ferdig" : "")">2 Årsak</li>
                <li class="@(trinn == 3 ? "na" : "")">3 Signer</li>
            </ol>
            @if (mangler)
            {
                <p class="ek-advarsel">Timer eller varer mangler. Rett opp under «Er tallene komplette?» først. Du kan signere likevel, men da lagres et resultat som ikke stemmer.</p>
            }
            <div class="ek-felt-gruppe">
                <p class="ek-hint">Hva var hovedårsaken?@(_arsakForeslatt ? " Portalen har foreslått en ut fra det største avviket." : "")@(_apenUtkast ? " Utkastet ditt er hentet fram." : "")</p>
                <div class="ek-arsaker">
                    @foreach (var a in Enum.GetValues<EtterkalkyleArsak>())
                    {
                        var arsak = a;
                        <button type="button" class="ek-arsak @(_arsak == arsak ? "aktiv" : "")" aria-pressed="@(_arsak == arsak ? "true" : "false")" @onclick="@(() => { _arsak = arsak; _arsakForeslatt = false; })">@arsak.Visningsnavn()</button>
                    }
                </div>
            </div>
            <label class="ek-felt">Kort om hva som skjedde @(trengerKommentar ? "(må fylles ut)" : "(valgfritt)")
                <textarea rows="3" @bind="_kommentar" @bind:event="oninput" placeholder="@(trengerKommentar ? "For eksempel: kunden ba om to ekstra dører underveis uten endringsmelding." : "Valgfritt")"></textarea>
            </label>
            @if (trengerKommentar && string.IsNullOrWhiteSpace(_kommentar) && _apenEtterkalkyle is { } ek)
            {
                <button type="button" class="ek-lenke" @onclick="@(() => _kommentar = ek.Forklaring)">Bruk forslag til tekst</button>
            }
            <details class="ek-laerdom" open="@aapenLaerdom">
                <summary>Lærdom til neste gang (valgfritt)</summary>
                <div class="ek-sporsmal">
                    <label class="ek-felt">Hva gikk bra?<textarea rows="2" @bind="_gikkBra" @bind:event="oninput"></textarea></label>
                    <label class="ek-felt">Hva gikk dårlig?<textarea rows="2" @bind="_gikkDarlig" @bind:event="oninput"></textarea></label>
                    <label class="ek-felt">Hva må vi forbedre?<textarea rows="2" @bind="_forbedre" @bind:event="oninput"></textarea>@if (_laerdom.Count > 0) {<small class="ek-forslag">Se <a href="/prosjektokonomi/laerdom">Lærdom</a> for varer der montasjetiden bør justeres.</small>}</label>
                    <label class="ek-felt">Forsinkelser, egne forhold<textarea rows="2" @bind="_forsinkelseEgne" placeholder="Dager og årsak"></textarea></label>
                    <label class="ek-felt">Forsinkelser, andre<textarea rows="2" @bind="_forsinkelseAndre" placeholder="Dager og årsak"></textarea>@if (!string.IsNullOrEmpty(_forsinkelseAndre) && !_apenUtkast) {<small class="ek-forslag">Hentet fra fristforlengelsene på endringene</small>}</label>
                </div>
            </details>
            <span class="ek-knapper ek-knapper-hoyre">
                <button type="button" class="ek-knapp" @onclick="LagreUtkast">Lagre utkast</button>
                <button type="button" class="ek-knapp ek-knapp-ok" @onclick="Kontroller"><Icon Name="check" />Signer som kontrollert</button>
            </span>
        }
    </section>;
}
