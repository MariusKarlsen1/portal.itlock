                    <h3>Gjennomgang</h3>
                    <ol class="ek-trinn" aria-label="Trinn i gjennomgangen">
                        <li class="ferdig">1 Se tallene</li>
                        <li class="@(trinn == 2 ? "na" : "ferdig")">2 Årsak og lærdom</li>
                        <li class="@(trinn == 3 ? "na" : "")">3 Signer</li>
                    </ol>
                </div>
                <div class="ek-felt-gruppe">
                    <p class="ek-hint">Hva var hovedårsaken? @(_arsakForeslatt ? "Portalen har foreslått en ut fra det største avviket." : "")@(_apenUtkast ? " Utkastet ditt er hentet fram." : "")</p>
                    <div class="ek-arsaker">
                        @foreach (var a in Enum.GetValues<EtterkalkyleArsak>())
                        {
                            var arsak = a;
                            <button type="button" class="ek-arsak @(_arsak == arsak ? "aktiv" : "")" aria-pressed="@(_arsak == arsak ? "true" : "false")" @onclick="@(() => { _arsak = arsak; _arsakForeslatt = false; })">@arsak.Visningsnavn()</button>
                        }
                    </div>
                </div>
                <label class="ek-felt">Kommentar @(_arsak != EtterkalkyleArsak.IngenAvvik ? "(må fylles ut)" : "")
                    <textarea rows="2" @bind="_kommentar" @bind:event="oninput" placeholder="Kort om årsaken til avviket"></textarea>
                </label>
                <div class="ek-sporsmal">
                    <label class="ek-felt">Hva gikk bra?<textarea rows="2" @bind="_gikkBra" @bind:event="oninput"></textarea></label>
                    <label class="ek-felt">Hva gikk dårlig?<textarea rows="2" @bind="_gikkDarlig" @bind:event="oninput"></textarea></label>
                    <label class="ek-felt">Hva må vi forbedre?<textarea rows="2" @bind="_forbedre" @bind:event="oninput"></textarea>@if (_laerdom.Count > 0) {<small class="ek-forslag">Se <a href="/prosjektokonomi/laerdom">Lærdom</a> for varer der montasjetiden bør justeres.</small>}</label>
                    <label class="ek-felt">Forsinkelser, egne forhold<textarea rows="2" @bind="_forsinkelseEgne" placeholder="Dager og årsak"></textarea></label>
                    <label class="ek-felt">Forsinkelser, andre<textarea rows="2" @bind="_forsinkelseAndre" placeholder="Dager og årsak"></textarea>@if (!string.IsNullOrEmpty(_forsinkelseAndre) && !_apenUtkast) {<small class="ek-forslag">Hentet fra fristforlengelsene på endringene</small>}</label>
                </div>
                <span class="ek-knapper ek-knapper-hoyre">
                    <button type="button" class="ek-knapp" @onclick="LagreUtkast">Lagre utkast</button>
                    <button type="button" class="ek-knapp ek-knapp-ok" @onclick="Kontroller"><Icon Name="check" />Signer som kontrollert</button>
                </span>
            }
        </section>
        }
    </div>;
}
