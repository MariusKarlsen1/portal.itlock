@page "/plattform"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject TenantStatistikkService Statistikk
@inject TenantProvisioningService Provisioning
@inject NavigationManager Nav

<PageTitle>Oversikt - Plattform</PageTitle>

<div class="pfo-root">

    <div class="pfo-topp">
        <div>
            <div class="pfo-eyebrow">Administrasjonsportal</div>
            <h1 class="pfo-h1">@Hilsen, @_fornavn!</h1>
            <p class="pfo-subtitle">Her får du oversikt over alle organisasjoner, brukere og aktivitet i Full Kontroll.</p>
        </div>
        <div class="pfo-dato">
            <Icon Name="calendar" />
            @_datoTekst
        </div>
    </div>

    <div class="pfo-kpi-grid">
        <div class="pfo-card pfo-kpi">
            <div class="pfo-kpi-topp">
                <span class="pfo-eyebrow">Totalt antall organisasjoner</span>
                <span class="pfo-kpi-ikon"><Icon Name="building" /></span>
            </div>
            <div class="pfo-kpi-verdi">@_tenants.Count</div>
            @if (_nyeDenneManeden > 0)
            {
                <div class="pfo-kpi-trend pfo-kpi-trend-opp">↑ +@_nyeDenneManeden denne måneden</div>
            }
            else
            {
                <div class="pfo-kpi-sub">Siden lansering</div>
            }
        </div>
        <div class="pfo-card pfo-kpi">
            <div class="pfo-kpi-topp">
                <span class="pfo-eyebrow">Totalt antall brukere</span>
                <span class="pfo-kpi-ikon"><Icon Name="users" /></span>
            </div>
            <div class="pfo-kpi-verdi">@_totaltBrukere</div>
            <div class="pfo-kpi-sub">På tvers av alle organisasjoner</div>
        </div>
        <div class="pfo-card pfo-kpi">
            <div class="pfo-kpi-topp">
                <span class="pfo-eyebrow">Månedlig omsetning</span>
                <span class="pfo-kpi-ikon"><Icon Name="file-text" /></span>
            </div>
            <div class="pfo-kpi-verdi">@_totalManedligInntekt.ToString("N0") kr</div>
            <div class="pfo-kpi-sub">Aktiverte lisenser hos aktive organisasjoner</div>
        </div>
        <div class="pfo-card pfo-kpi">
            <div class="pfo-kpi-topp">
                <span class="pfo-eyebrow">Utestående betalinger</span>
                <span class="pfo-kpi-ikon"><Icon Name="credit-card" /></span>
            </div>
            <div class="pfo-kpi-verdi">0 kr</div>
            <div class="pfo-kpi-sub">Fakturering er ikke tatt i bruk ennå</div>
        </div>
    </div>

    <section class="pfo-card pfo-opprett-kort">
        <div class="pfo-kort-header-rad">
            <div class="pfo-kort-header">
                <div class="pfo-kort-header-ikon"><Icon Name="plus" /></div>
                <div>
                    <h2 class="pfo-h2">Opprett ny organisasjon</h2>
                    <p class="pfo-hint">Lisenspriser er felles for alle organisasjoner, og styrer "Månedlig omsetning" over.</p>
                </div>
            </div>
        </div>

        <div class="pfo-pris-rad">
            @foreach (var type in Enum.GetValues<LisensType>())
            {
                var pris = _lisensPriser.First(p => p.Type == type);
                <label class="pfo-form-label">
                    @type.Visningsnavn() (kr/mnd)
                    <input class="pfo-input" type="number" min="0" step="1" @bind="pris.KrPerManed" @bind:after="@(() => LagrePris(pris))" />
                </label>
            }
        </div>
        @if (!string.IsNullOrEmpty(_prisMelding))
        {
            <p class="pfo-suksessmelding">@_prisMelding</p>
        }

        @if (!_visOpprettSkjema)
        {
            <button type="button" class="pfo-btn-primary" @onclick="@(() => _visOpprettSkjema = true)">
                <Icon Name="plus" /> Opprett organisasjon
            </button>
        }
        else
        {
            <p class="pfo-hint">
                De logger inn på samme adresse som alle andre (<code>@_delLoginAdresse</code>) - systemet finner riktig
                organisasjon ut fra e-posten som logger inn.
            </p>
            <div class="pfo-form-grid">
                <label class="pfo-form-label">Firmanavn<input class="pfo-input" @bind="_navn" placeholder="F.eks. Eksempel Lås AS" /></label>
                <label class="pfo-form-label">Navn på første admin-bruker<input class="pfo-input" @bind="_adminNavn" placeholder="F.eks. Ola Nordmann" /></label>
                <label class="pfo-form-label">E-post til første admin-bruker<input class="pfo-input" @bind="_adminEpost" placeholder="ola@eksempellas.no" /></label>
            </div>
            <div class="pfo-knapperad">
                <button type="button" class="pfo-btn-primary" @onclick="OpprettOrganisasjon" disabled="@_oppretter">
                    <Icon Name="plus" /> @(_oppretter ? "Oppretter..." : "Opprett organisasjon")
                </button>
                <button type="button" class="pfo-btn-ghost" @onclick="@(() => _visOpprettSkjema = false)">Avbryt</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_feilmelding))
        {
            <p class="pfo-feilmelding">@_feilmelding</p>
        }
        @if (!string.IsNullOrEmpty(_suksessmelding))
        {
            <p class="pfo-suksessmelding">@_suksessmelding</p>
        }
    </section>

    <div class="pfo-graf-rad">
        <section class="pfo-card pfo-graf-kort">
            <div class="pfo-kort-header-rad">
                <div class="pfo-kort-header">
                    <div class="pfo-kort-header-ikon"><Icon Name="bar-chart" /></div>
                    <div>
                        <h2 class="pfo-h2">Omsetning</h2>
                        <p class="pfo-hint">Anslått beløp siste 12 måneder</p>
                    </div>
                </div>
                <span class="pfo-periode-valg">Siste 12 måneder <Icon Name="chevron-down" /></span>
            </div>
            <div class="pfo-stolpediagram">
                @foreach (var punkt in _omsetningHistorikk)
                {
                    var hoyde = _omsetningMaks <= 0 ? 4 : Math.Max(4, (double)(punkt.Belop / _omsetningMaks) * 100);
                    <div class="pfo-stolpe-kol" title="@($"{punkt.Mnd}: {punkt.Belop:N0} kr")">
                        <div class="pfo-stolpe @(punkt.ErNa ? "pfo-stolpe-na" : "")" style="height: @(hoyde.ToString(CultureInfo.InvariantCulture))%"></div>
                        <span class="pfo-stolpe-label">@punkt.Mnd</span>
                    </div>
                }
            </div>
        </section>

        <section class="pfo-card pfo-donut-kort">
            <div class="pfo-kort-header-rad">
                <div class="pfo-kort-header">
                    <div class="pfo-kort-header-ikon"><Icon Name="building" /></div>
                    <div>
                        <h2 class="pfo-h2">Organisasjoner</h2>
                        <p class="pfo-hint">Status på organisasjoner</p>
                    </div>
                </div>
            </div>
            <div class="pfo-donut-wrap">
                <div class="pfo-donut" style="background: @DonutGradient">
                    <div class="pfo-donut-hull">
                        <span class="pfo-donut-tall">@_tenants.Count</span>
                        <span class="pfo-donut-label">Totalt</span>
                    </div>
                </div>
                <div class="pfo-donut-legend">
                    <div class="pfo-legend-rad"><span class="pfo-legend-prikk" style="background:#8A5A34"></span>Aktive<strong>@_antallAktiv</strong></div>
                    <div class="pfo-legend-rad"><span class="pfo-legend-prikk" style="background:#D9A441"></span>Suspendert<strong>@_antallSuspendert</strong></div>
                    <div class="pfo-legend-rad"><span class="pfo-legend-prikk" style="background:#C9C2B2"></span>Avsluttet<strong>@_antallOppsagt</strong></div>
                </div>
            </div>
        </section>
    </div>

    <div class="pfo-bunn-rad">
        <section class="pfo-card pfo-siste-org">
            <div class="pfo-liste-header">
                <div>
                    <h2 class="pfo-h2">Siste organisasjoner</h2>
                    <p class="pfo-hint">De nyeste organisasjonene som er opprettet i plattformen.</p>
                </div>
            </div>

            @if (_tenants.Count == 0)
            {
                <p class="pfo-tom">Ingen organisasjoner opprettet ennå.</p>
            }
            else
            {
                <div class="pfo-tabell-hode">
                    <div>Navn</div>
                    <div>Domene</div>
                    <div>Brukere</div>
                    <div>Månedlig beløp</div>
                    <div>Status</div>
                    <div>Opprettet</div>
                </div>
                @foreach (var t in _tenants.OrderByDescending(t => t.OpprettetDato).Take(6))
                {
                    var (bg, ink) = AvatarFarge(t.Id);
                    <button type="button" class="pfo-tabell-rad" @key="t.Id" @onclick="@(() => Nav.NavigateTo($"/plattform/organisasjoner/{t.Id}"))">
                        <div class="pfo-rad-navn-felt">
                            <div class="pfo-avatar" style="background:@bg; color:@ink;">@Initialer(t.Navn)</div>
                            @t.Navn
                        </div>
                        <div class="pfo-rad-domene">@(t.Subdomene ?? "-")</div>
                        <div>@BrukereFor(t.Id)</div>
                        <div>@ManedligBelop(t.Id).ToString("N0") kr</div>
                        <div><span class="pfo-badge pfo-badge-@StatusKlasse(t.Status)"><span class="pfo-dot"></span>@t.Status</span></div>
                        <div class="pfo-rad-dato">@t.OpprettetDato.ToString("dd.MM.yyyy")</div>
                    </button>
                }
            }
        </section>

        <div class="pfo-hoyre-kol">
            <section class="pfo-card">
                <div class="pfo-liste-header">
                    <h2 class="pfo-h2">Fakturaer som krever oppfølging</h2>
                </div>
                <p class="pfo-tom">Fakturering er ikke tatt i bruk ennå - ingenting å følge opp her.</p>
            </section>

            <section class="pfo-card">
                <div class="pfo-liste-header">
                    <h2 class="pfo-h2">Siste aktivitet</h2>
                </div>
                @if (_sisteAktivitet.Count == 0)
                {
                    <p class="pfo-tom">Ingen aktivitet registrert ennå.</p>
                }
                else
                {
                    <div class="pfo-aktivitet-liste">
                        @foreach (var hendelse in _sisteAktivitet)
                        {
                            <div class="pfo-aktivitet-rad">
                                <span class="pfo-aktivitet-ikon"><Icon Name="@hendelse.Ikon" /></span>
                                <span class="pfo-aktivitet-tekst">
                                    <span class="pfo-aktivitet-tittel">@hendelse.Tittel</span>
                                    <span class="pfo-aktivitet-sub">@hendelse.Undertekst</span>
                                </span>
                                <span class="pfo-aktivitet-tid">@RelativTid(hendelse.Tidspunkt)</span>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private List<Tenant> _tenants = [];
    private List<TenantLisens> _alleLisenser = [];
    private List<LisensPris> _lisensPriser = [];
    private Dictionary<int, int> _brukereForTenant = [];

    private string _fornavn = "der";
    private string _datoTekst = "";
    private int _nyeDenneManeden;
    private int _totaltBrukere;
    private decimal _totalManedligInntekt;
    private int _antallAktiv;
    private int _antallSuspendert;
    private int _antallOppsagt;
    private List<(string Mnd, decimal Belop, bool ErNa)> _omsetningHistorikk = [];
    private decimal _omsetningMaks;
    private List<AktivitetHendelse> _sisteAktivitet = [];

    private string? _prisMelding;
    private bool _visOpprettSkjema;
    private string _navn = "";
    private string _adminNavn = "";
    private string _adminEpost = "";
    private bool _oppretter;
    private string? _feilmelding;
    private string? _suksessmelding;

    private string _delLoginAdresse => $"{new Uri(Nav.Uri).GetLeftPart(UriPartial.Authority)}/login";

    private static readonly (string Bg, string Ink)[] AvatarPalett =
    [
        ("#F1E7DA", "#8A5A34"),
        ("#E3EEE6", "#3C6E55"),
        ("#E5E8F1", "#4B5A8A"),
        ("#F1E3DD", "#8A4334"),
        ("#EAE8F4", "#5A4B8A")
    ];

    private string Hilsen => DateTime.Now.Hour switch
    {
        >= 5 and < 11 => "God morgen",
        >= 11 and < 18 => "God dag",
        _ => "God kveld"
    };

    private string DonutGradient
    {
        get
        {
            var total = _tenants.Count;
            if (total == 0)
            {
                return "#ECE7DD";
            }

            var aktivPct = _antallAktiv * 100.0 / total;
            var suspPct = _antallSuspendert * 100.0 / total;

            var g1 = aktivPct.ToString("0.##", CultureInfo.InvariantCulture);
            var g2 = (aktivPct + suspPct).ToString("0.##", CultureInfo.InvariantCulture);

            return $"conic-gradient(#8A5A34 0% {g1}%, #D9A441 {g1}% {g2}%, #C9C2B2 {g2}% 100%)";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var navn = state.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            if (!string.IsNullOrWhiteSpace(navn))
            {
                _fornavn = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;
            }
        }

        var now = DateTime.Now;
        var ukenummer = ISOWeek.GetWeekOfYear(now);
        var datoFormatert = now.ToString("dddd d. MMMM yyyy", Nb);
        var medStorForbokstav = char.ToUpper(datoFormatert[0], Nb) + datoFormatert[1..];
        _datoTekst = $"{medStorForbokstav} · Uke {ukenummer}";

        await LastDataAsync();
    }

    private async Task LastDataAsync()
    {
        _tenants = await PlatformDb.Tenants.OrderBy(t => t.OpprettetDato).ToListAsync();
        _alleLisenser = await PlatformDb.TenantLisenser.ToListAsync();
        _lisensPriser = await PlatformDb.LisensPriser.ToListAsync();

        _nyeDenneManeden = _tenants.Count(t => t.OpprettetDato.Year == DateTime.Now.Year && t.OpprettetDato.Month == DateTime.Now.Month);
        _antallAktiv = _tenants.Count(t => t.Status == TenantStatus.Aktiv);
        _antallSuspendert = _tenants.Count(t => t.Status == TenantStatus.Suspendert);
        _antallOppsagt = _tenants.Count(t => t.Status == TenantStatus.Oppsagt);

        _brukereForTenant = _tenants.ToDictionary(t => t.Id, t => Statistikk.Hent(t.ConnectionString).Brukere);
        _totaltBrukere = _brukereForTenant.Values.Sum();

        _totalManedligInntekt = _tenants.Where(t => t.Status == TenantStatus.Aktiv).Sum(t => ManedligBelop(t.Id));

        BeregnOmsetningHistorikk();
        BeregnSisteAktivitet();
    }

    // Anslår hvordan omsetningen har utviklet seg siste 12 måneder, basert på
    // når hver aktive organisasjon faktisk ble opprettet og deres NÅVÆRENDE
    // lisensoppsett (vi logger ikke historiske lisensendringer per måned) -
    // en ekte, utledet trend basert på reelle opprettelsesdatoer, ikke
    // oppdiktede tall.
    private void BeregnOmsetningHistorikk()
    {
        var liste = new List<(string Mnd, decimal Belop, bool ErNa)>();
        var naManed = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

        for (var i = 11; i >= 0; i--)
        {
            var maned = naManed.AddMonths(-i);
            var sluttAvManed = maned.AddMonths(1).AddDays(-1);
            var belop = _tenants
                .Where(t => t.Status == TenantStatus.Aktiv && t.OpprettetDato <= sluttAvManed)
                .Sum(t => ManedligBelop(t.Id));
            liste.Add((maned.ToString("MMM", Nb), belop, maned == naManed));
        }

        _omsetningHistorikk = liste;
        _omsetningMaks = liste.Count == 0 ? 0 : liste.Max(p => p.Belop);
    }

    private void BeregnSisteAktivitet()
    {
        var hendelser = new List<AktivitetHendelse>();

        foreach (var t in _tenants)
        {
            hendelser.Add(new AktivitetHendelse("building", "Ny organisasjon opprettet", t.Navn, t.OpprettetDato));
            if (t.SistOppdatert.HasValue)
            {
                hendelser.Add(new AktivitetHendelse("edit", "Organisasjon oppdatert", t.Navn, t.SistOppdatert.Value));
            }
        }

        foreach (var l in _alleLisenser)
        {
            var tenant = _tenants.FirstOrDefault(t => t.Id == l.TenantId);
            if (tenant is not null)
            {
                hendelser.Add(new AktivitetHendelse("credit-card", $"{l.Type.Visningsnavn()} oppdatert", tenant.Navn, l.SistEndret));
            }
        }

        _sisteAktivitet = hendelser.OrderByDescending(h => h.Tidspunkt).Take(6).ToList();
    }

    private decimal PrisFor(LisensType type) => _lisensPriser.FirstOrDefault(p => p.Type == type)?.KrPerManed ?? 0;

    private decimal ManedligBelop(int tenantId) =>
        _alleLisenser.Where(l => l.TenantId == tenantId).Sum(l => l.AntallTildelt * PrisFor(l.Type));

    private int BrukereFor(int tenantId) => _brukereForTenant.GetValueOrDefault(tenantId);

    private async Task LagrePris(LisensPris pris)
    {
        await PlatformDb.SaveChangesAsync();
        _prisMelding = $"{pris.Type.Visningsnavn()} satt til {pris.KrPerManed:N0} kr/mnd.";
        _totalManedligInntekt = _tenants.Where(t => t.Status == TenantStatus.Aktiv).Sum(t => ManedligBelop(t.Id));
        BeregnOmsetningHistorikk();
    }

    private async Task OpprettOrganisasjon()
    {
        _feilmelding = null;
        _suksessmelding = null;
        _oppretter = true;
        StateHasChanged();
        try
        {
            var (ok, feil) = await Provisioning.OpprettKundeAsync(_navn, null, _adminNavn, _adminEpost);
            if (ok)
            {
                _suksessmelding = $"Organisasjonen \"{_navn}\" er opprettet med admin-bruker {_adminEpost}. " +
                    "Be dem bruke \"Sett passord første gang\" på innloggingssiden.";
                _navn = "";
                _adminNavn = "";
                _adminEpost = "";
                _visOpprettSkjema = false;
                await LastDataAsync();
            }
            else
            {
                _feilmelding = feil;
            }
        }
        finally
        {
            _oppretter = false;
        }
    }

    private static string StatusKlasse(TenantStatus status) => status switch
    {
        TenantStatus.Aktiv => "aktiv",
        TenantStatus.Suspendert => "suspendert",
        _ => "oppsagt"
    };

    private static string Initialer(string navn)
    {
        var ord = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (ord.Length == 0) { return "?"; }
        if (ord.Length == 1) { return ord[0].Length >= 2 ? ord[0][..2].ToUpperInvariant() : ord[0].ToUpperInvariant(); }
        return $"{ord[0][0]}{ord[^1][0]}".ToUpperInvariant();
    }

    private static (string Bg, string Ink) AvatarFarge(int tenantId) => AvatarPalett[Math.Abs(tenantId) % AvatarPalett.Length];

    private static string RelativTid(DateTime tidspunkt)
    {
        var diff = DateTime.Now - tidspunkt;
        if (diff.TotalMinutes < 1) { return "Nå nettopp"; }
        if (diff.TotalMinutes < 60) { return $"{(int)diff.TotalMinutes} min siden"; }
        if (diff.TotalHours < 24) { return $"{(int)diff.TotalHours} t siden"; }
        if (diff.TotalDays < 2) { return $"I går, {tidspunkt:HH:mm}"; }
        if (diff.TotalDays < 7) { return $"{(int)diff.TotalDays} dager siden"; }
        return tidspunkt.ToString("dd.MM.yyyy");
    }

    private record AktivitetHendelse(string Ikon, string Tittel, string Undertekst, DateTime Tidspunkt);
}
