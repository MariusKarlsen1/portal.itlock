@page "/plattform"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject TenantStatistikkService Statistikk
@inject OrganisasjonStatusService StatusSvc
@inject PlattformOppsettService Oppsett
@inject NavigationManager Nav

<PageTitle>Oversikt - Plattform</PageTitle>

@* Forsiden i adminportalen: hva kundene betaler, hva som trenger deg, og om
   backup, e-post og Tripletex er i orden. *@
<div class="pa-side">
    <div class="pa-topp">
        <div>
            <div class="pa-eyebrow">Administrasjonsportal</div>
            <h1 class="pa-h1">@Hilsen, @_fornavn!</h1>
            <p class="pa-hint">Her har du oversikt over alle organisasjoner, abonnement og drift.</p>
        </div>
        <span class="pa-dato">@_datoTekst</span>
        <a class="pa-knapp pa-knapp-p" href="/plattform/ny">+ Ny organisasjon</a>
    </div>

    @if (_status is null)
    {
        <p class="pa-hint">Henter oversikten …</p>
    }
    else
    {
        var kunder = _status.ToList();
        <div class="pa-kpi pa-kpi4">
            <div><span>Per måned</span><b>@Kr(_perManed)</b><small>@_antallAktive aktive kunder · @Kr(_perManed * 12) per år</small></div>
            <div><span>Organisasjoner</span><b>@kunder.Count</b><small class="@(_nyeDenneManed > 0 ? "pa-ok-tekst" : "")">@(_nyeDenneManed > 0 ? $"↑ {_nyeDenneManed} nye denne måneden" : "ingen nye denne måneden")</small></div>
            <div><span>Brukere</span><b>@_totaltBrukere</b><small>@_lisenserTildelt lisenser tildelt</small></div>
            <div><span>Utestående</span><b class="@(_antallForfalt > 0 ? "pa-rod-tekst" : "")">@Kr(_utestaende)</b><small>inkl. mva · @(_antallForfalt > 0 ? $"{_antallForfalt} forfalt" : "ingen forfalte")</small></div>
        </div>

        <div class="pa-rad2">
            <section class="pa-kort">
                <div class="pa-kort-topp"><h2 class="pa-h2">Omsetning</h2><span class="pa-chip">Siste 12 måneder</span></div>
                <div class="pa-stolper" role="img" aria-label="@string.Join(", ", _historikk.Select(h => $"{h.Mnd} {Kr(h.Belop)}"))">
                    @foreach (var h in _historikk)
                    {
                        var hoyde = _historikkMaks <= 0 ? 2 : Math.Max(2, (double)(h.Belop / _historikkMaks) * 100);
                        <div class="@(h.ErNa ? "na" : "")" style="height:@(hoyde.ToString(CultureInfo.InvariantCulture))%" title="@($"{h.Mnd}: {Kr(h.Belop)}")"></div>
                    }
                </div>
                <div class="pa-akse">
                    @foreach (var h in _historikk)
                    {
                        <span>@h.Mnd</span>
                    }
                </div>
            </section>

            <section class="pa-kort">
                <div class="pa-kort-topp"><h2 class="pa-h2">Organisasjoner</h2></div>
                <div class="pa-donut-rad">
                    <div class="pa-donut" style="background:@DonutGradient" role="img" aria-label="@string.Join(", ", _fordeling.Select(f => $"{f.Navn} {f.Antall}"))"><span>@kunder.Count</span></div>
                    <div class="pa-legend">
                        @foreach (var f in _fordeling)
                        {
                            <div><span class="pa-prikk" style="background:@f.Farge"></span>@f.Navn<b>@f.Antall</b></div>
                        }
                    </div>
                </div>
            </section>
        </div>

        <div class="pa-rad2">
            <section class="pa-kort">
                <div class="pa-kort-topp"><h2 class="pa-h2">Siste organisasjoner</h2><a class="pa-knapp pa-knapp-s" href="/plattform/organisasjoner">Se alle</a></div>
                @if (kunder.Count == 0)
                {
                    <p class="pa-hint">Ingen organisasjoner ennå. <a href="/plattform/ny">Opprett den første.</a></p>
                }
                else
                {
                    <div class="pa-tabellramme">
                        <table class="pa-tabell">
                            <thead><tr><th>Navn</th><th>Pakke</th><th class="pa-n">Brukere</th><th class="pa-n">Per måned</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var s in kunder.OrderByDescending(s => s.Tenant.OpprettetDato).Take(8))
                                {
                                    var id = s.Tenant.Id;
                                    var (tekst, klasse) = StatusChip(s);
                                    <tr class="pa-klikkrad" @onclick="@(() => Nav.NavigateTo($"/plattform/organisasjoner/{id}"))">
                                        <td><span class="pa-avatar">@Initialer(s.Tenant.Navn)</span><span class="pa-navncelle"><b>@s.Tenant.Navn</b><small>@(s.EpostAdresse ?? "")</small></span></td>
                                        <td>@(s.Pakke ?? "–")</td>
                                        <td class="pa-n">@_brukere.GetValueOrDefault(id)</td>
                                        <td class="pa-n">@Kr(s.PerManed)</td>
                                        <td><span class="pa-chip @klasse">@tekst</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <div class="pa-kolonne">
                <section class="pa-kort">
                    <div class="pa-kort-topp"><h2 class="pa-h2">Trenger deg</h2>@if (_oppfolging.Count > 0) {<span class="pa-chip pa-chip-gul">@_oppfolging.Count</span>}</div>
                    @if (_oppfolging.Count == 0)
                    {
                        <p class="pa-hint">Ingenting å følge opp nå.</p>
                    }
                    else
                    {
                        <div class="pa-liste">
                            @foreach (var o in _oppfolging)
                            {
                                var mal = o;
                                <button type="button" @onclick="@(() => Nav.NavigateTo($"/plattform/organisasjoner/{mal.TenantId}"))">
                                    <span class="pa-prikk @(mal.Rod ? "pa-rod" : "pa-gul")"></span>
                                    <span class="pa-liste-tekst">@mal.Tittel<small>@mal.Tekst</small></span>
                                </button>
                            }
                        </div>
                    }
                </section>

                <section class="pa-kort">
                    <div class="pa-kort-topp"><h2 class="pa-h2">Drift</h2><a class="pa-knapp pa-knapp-s" href="/plattform/innstillinger">Innstillinger</a></div>
                    <div class="pa-liste">
                        @foreach (var d in _drift)
                        {
                            <div>
                                <span class="pa-prikk @d.Klasse"></span>
                                <span class="pa-liste-tekst">@d.Tittel<small>@d.Tekst</small></span>
                                <span class="pa-chip @(d.Klasse == "pa-ok" ? "pa-chip-ok" : d.Klasse == "pa-rod" ? "pa-chip-rod" : "pa-chip-gul")">@d.Merke</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="pa-kort">
                    <div class="pa-kort-topp"><h2 class="pa-h2">Siste aktivitet</h2></div>
                    @if (_hendelser.Count == 0)
                    {
                        <p class="pa-hint">Ingen hendelser ennå.</p>
                    }
                    else
                    {
                        <div class="pa-liste">
                            @foreach (var h in _hendelser)
                            {
                                <div><span class="pa-liste-tekst">@h.Tekst<small>@h.Organisasjon · @RelativTid(h.Tidspunkt)</small></span></div>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    }
</div>


@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private List<OrganisasjonStatusService.Status>? _status;
    private List<Tenant> _tenants = [];
    private decimal _perManed;
    private decimal _utestaende;
    private int _antallForfalt;
    private int _antallAktive;
    private int _antallProve;
    private int _antallPause;
    private int _lisenserTildelt;
    private int _totaltBrukere;
    private string _fornavn = "der";
    private string _datoTekst = "";
    private List<(string Mnd, decimal Belop, bool ErNa)> _historikk = [];
    private decimal _historikkMaks;

    private readonly Dictionary<int, int> _brukere = [];
    private int _nyeDenneManed;
    private sealed record Fordeling(string Navn, int Antall, string Farge);
    private List<Fordeling> _fordeling = [];

    private sealed record Oppfolging(int TenantId, string Tittel, string Tekst, string Ikon, bool Rod);
    private List<Oppfolging> _oppfolging = [];

    private sealed record Drift(string Tittel, string Tekst, string Klasse, string Merke);
    private List<Drift> _drift = [];

    private sealed record Hendelse(string Tekst, string Organisasjon, DateTime Tidspunkt);
    private List<Hendelse> _hendelser = [];

    private string Hilsen => DateTime.Now.Hour switch
    {
        >= 5 and < 11 => "God morgen",
        >= 11 and < 18 => "God dag",
        _ => "God kveld"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var navn = (await AuthStateTask).User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            if (!string.IsNullOrWhiteSpace(navn))
            {
                _fornavn = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;
            }
        }

        var na = DateTime.Now;
        var dato = na.ToString("dddd d. MMMM yyyy", Nb);
        _datoTekst = $"{char.ToUpper(dato[0], Nb)}{dato[1..]} · uke {ISOWeek.GetWeekOfYear(na)}";

        _status = await StatusSvc.AlleAsync();
        _tenants = _status.Select(s => s.Tenant).ToList();
        var kunder = _status.ToList();
        _perManed = kunder.Where(s => s.Tenant.Status == TenantStatus.Aktiv).Sum(s => s.PerManed);
        _antallAktive = kunder.Count(s => s.Tenant.Status == TenantStatus.Aktiv);
        _antallProve = kunder.Count(s => s.ProveperiodeTil is { } p && p.Date >= DateTime.Today);
        _antallPause = kunder.Count(s => s.Tenant.Status == TenantStatus.Suspendert);
        _lisenserTildelt = kunder.Sum(s => LisensTypeExtensions.Aktive.Sum(t => s.Lisenser.GetValueOrDefault(t)));

        foreach (var t in _tenants)
        {
            var antall = (await Statistikk.HentAsync(t.ConnectionString)).Brukere;
            _brukere[t.Id] = antall;
            _totaltBrukere += antall;
        }

        var forsteIManed = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        _nyeDenneManed = kunder.Count(s => s.Tenant.OpprettetDato >= forsteIManed);
        var prove = kunder.Count(s => s.Tenant.Status == TenantStatus.Aktiv && ErProve(s));
        _fordeling =
        [
            new("Aktive", kunder.Count(s => s.Tenant.Status == TenantStatus.Aktiv) - prove, "#8A5A34"),
            new("Prøve", prove, "#D9A441"),
            new("Pause", _antallPause, "#7FA38B"),
            new("Oppsagt", kunder.Count(s => s.Tenant.Status == TenantStatus.Oppsagt), "#C9C2B2"),
        ];

        BeregnHistorikk(kunder);
        await LastOppfolgingAsync();
        await LastDriftAsync(kunder);
        await LastHendelserAsync();
    }

    // Anslag: dagens pris per måned for kunder som fantes den måneden.
    private void BeregnHistorikk(List<OrganisasjonStatusService.Status> kunder)
    {
        var naManed = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        _historikk = Enumerable.Range(0, 12).Select(i =>
        {
            var maned = naManed.AddMonths(i - 11);
            var slutt = maned.AddMonths(1).AddDays(-1);
            var belop = kunder.Where(s => s.Tenant.Status == TenantStatus.Aktiv && s.Tenant.OpprettetDato <= slutt).Sum(s => s.PerManed);
            return (maned.ToString("MMM", Nb), belop, maned == naManed);
        }).ToList();
        _historikkMaks = _historikk.Count == 0 ? 0 : _historikk.Max(h => h.Belop);
    }

    private async Task LastDriftAsync(List<OrganisasjonStatusService.Status> kunder)
    {
        var inn = await Oppsett.HentAsync();
        var aktive = _status!.Where(s => s.Tenant.Status != TenantStatus.Oppsagt).ToList();
        var backupOk = aktive.Count(s => s.Backup == OrganisasjonStatusService.Tilstand.Ok);
        var backupFeil = aktive.Count(s => s.Backup == OrganisasjonStatusService.Tilstand.Feil);
        var resend = !string.IsNullOrWhiteSpace(await Oppsett.ResendNokkelAsync());
        var plattformTx = await Oppsett.PlattformTripletexAsync();
        var kundeTx = kunder.Count(s => s.Tripletex == OrganisasjonStatusService.Tilstand.Ok);

        _drift =
        [
            new("Backup", $"{backupOk} av {aktive.Count} organisasjoner har kopi fra siste døgn", backupFeil > 0 ? "pa-rod" : backupOk == aktive.Count ? "pa-ok" : "pa-gul", backupFeil > 0 ? $"{backupFeil} feilet" : backupOk == aktive.Count ? "OK" : "Venter"),
            new("E-post", resend ? (inn.EpostPerOrganisasjon ? "Sender fra organisasjonenes egne adresser" : "Sender fra standardavsenderen") : "Mangler Resend-nøkkel", resend ? "pa-ok" : "pa-rod", resend ? "OK" : "Mangler"),
            new("Tripletex for fakturering", plattformTx is null ? "Ikke koblet" : plattformTx.FraServeroppsett ? "Nøkler fra serveroppsettet" : $"Koblet{(inn.TripletexFirma is { } f ? $" til {f}" : "")}", plattformTx is null ? "pa-rod" : plattformTx.FraServeroppsett ? "pa-gul" : "pa-ok", plattformTx is null ? "Mangler" : plattformTx.FraServeroppsett ? "Flytt inn" : "OK"),
            new("Tripletex hos kundene", $"{kundeTx} av {kunder.Count} koblet", kundeTx == kunder.Count ? "pa-ok" : "pa-gul", kundeTx == kunder.Count ? "OK" : $"{kunder.Count - kundeTx} mangler"),
        ];
    }

    private async Task LastHendelserAsync()
    {
        var navn = _tenants.ToDictionary(t => t.Id, t => t.Navn);
        var siste = await PlatformDb.TenantHendelser.AsNoTracking()
            .OrderByDescending(h => h.Tidspunkt).Take(8).ToListAsync();
        _hendelser = siste.Select(h => new Hendelse(h.Tekst, navn.GetValueOrDefault(h.TenantId, "Plattform"), h.Tidspunkt)).ToList();
    }

    private async Task LastOppfolgingAsync()
    {
        var navn = _tenants.ToDictionary(t => t.Id, t => t.Navn);
        var fakturaer = await PlatformDb.PlattformFakturaer.AsNoTracking()
            .Where(f => f.Status == PlattformFakturaStatus.Fakturert || f.Status == PlattformFakturaStatus.Utkast)
            .ToListAsync();
        _utestaende = fakturaer.Where(f => f.Status == PlattformFakturaStatus.Fakturert).Sum(f => f.Utestaende ?? 0);
        _antallForfalt = fakturaer.Count(f => f.ErForfalt);

        var liste = new List<Oppfolging>();
        foreach (var s in _status!.Where(s => s.Backup == OrganisasjonStatusService.Tilstand.Feil))
        {
            liste.Add(new(s.Tenant.Id, $"{s.Tenant.Navn}: backup feilet", s.BackupTekst ?? "", "server", true));
        }

        foreach (var f in fakturaer.Where(f => f.ErForfalt).OrderBy(f => f.Forfall))
        {
            liste.Add(new(f.TenantId, $"{navn.GetValueOrDefault(f.TenantId)}: faktura forfalt", $"{(f.Utestaende ?? f.BelopEksMva):N0} kr, forfalt {f.Forfall:dd.MM.yyyy}", "receipt", true));
        }

        foreach (var f in fakturaer.Where(f => f.Status == PlattformFakturaStatus.Utkast).OrderBy(f => f.PeriodeFra))
        {
            liste.Add(new(f.TenantId, $"{navn.GetValueOrDefault(f.TenantId)}: fakturautkast venter", $"{AbonnementService.PeriodeTekst(f.PeriodeFra, f.PeriodeTil)}, {f.BelopEksMva:N0} kr", "receipt", false));
        }

        var grense = DateTime.Today.AddDays(3);
        var notater = await PlatformDb.TenantNotater.AsNoTracking()
            .Where(n => !n.Utfort && n.Oppfolging != null && n.Oppfolging <= grense)
            .OrderBy(n => n.Oppfolging).ToListAsync();
        foreach (var n in notater)
        {
            liste.Add(new(n.TenantId, $"{navn.GetValueOrDefault(n.TenantId)}: følg opp {n.Oppfolging:dd.MM}", n.Tekst, "calendar", n.Oppfolging!.Value.Date < DateTime.Today));
        }

        foreach (var s in _status!.Where(s => s.ProveperiodeTil is { } p && p.Date >= DateTime.Today && p.Date <= DateTime.Today.AddDays(7)))
        {
            liste.Add(new(s.Tenant.Id, $"{s.Tenant.Navn}: prøveperioden slutter", $"Til {s.ProveperiodeTil:dd.MM.yyyy}", "calendar", false));
        }

        foreach (var s in _status!.Where(s => s.Tenant.Status != TenantStatus.Oppsagt && s.Backup == OrganisasjonStatusService.Tilstand.Mangler && s.Tenant.OpprettetDato < DateTime.Now.AddDays(-1)))
        {
            liste.Add(new(s.Tenant.Id, $"{s.Tenant.Navn}: ingen ny backup", s.BackupTekst ?? "", "server", false));
        }

        _oppfolging = liste.Where(o => navn.ContainsKey(o.TenantId)).OrderByDescending(o => o.Rod).Take(10).ToList();
    }

    private static string Kr(decimal v) => v.ToString("#,##0", Nb) + " kr";

    private static bool ErProve(OrganisasjonStatusService.Status s) => s.ProveperiodeTil is { } p && p.Date >= DateTime.Today;

    private string DonutGradient
    {
        get
        {
            var sum = _fordeling.Sum(f => f.Antall);
            if (sum == 0) { return "#ECE7DD"; }
            var deler = new List<string>();
            double fra = 0;
            foreach (var f in _fordeling.Where(f => f.Antall > 0))
            {
                var til = fra + 100.0 * f.Antall / sum;
                deler.Add($"{f.Farge} {fra.ToString("0.##", CultureInfo.InvariantCulture)}% {til.ToString("0.##", CultureInfo.InvariantCulture)}%");
                fra = til;
            }
            return $"conic-gradient({string.Join(", ", deler)})";
        }
    }

    private static (string Tekst, string Klasse) StatusChip(OrganisasjonStatusService.Status s) => s.Tenant.Status switch
    {
        TenantStatus.Oppsagt => ("Oppsagt", ""),
        TenantStatus.Suspendert => ("Pause", "pa-chip-gul"),
        _ when s.Faktura == OrganisasjonStatusService.Tilstand.Feil => ("Forfalt", "pa-chip-rod"),
        _ when ErProve(s) => ($"Prøve til {s.ProveperiodeTil:dd.MM}", "pa-chip-gul"),
        _ => ("Aktiv", "pa-chip-ok")
    };

    private static string Initialer(string navn)
    {
        var ord = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(o => o is not ("AS" or "ASA" or "DA" or "ANS")).ToList();
        return ord.Count switch
        {
            0 => "?",
            1 => ord[0][..Math.Min(2, ord[0].Length)].ToUpperInvariant(),
            _ => $"{char.ToUpperInvariant(ord[0][0])}{char.ToUpperInvariant(ord[1][0])}"
        };
    }

    private static string RelativTid(DateTime tidspunkt)
    {
        var diff = DateTime.Now - tidspunkt;
        if (diff.TotalMinutes < 1) { return "nå nettopp"; }
        if (diff.TotalMinutes < 60) { return $"{(int)diff.TotalMinutes} min siden"; }
        if (diff.TotalHours < 24) { return $"{(int)diff.TotalHours} t siden"; }
        if (diff.TotalDays < 2) { return $"i går {tidspunkt:HH:mm}"; }
        return tidspunkt.ToString("dd.MM.yyyy");
    }
}
