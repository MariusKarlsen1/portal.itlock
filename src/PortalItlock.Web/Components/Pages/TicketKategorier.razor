@page "/ticket-kategorier"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Ticket-kategorier</PageTitle>

<a class="back-link" href="/tickets">&larr; Tilbake til tickets</a>
<h1>Ticket-kategorier</h1>
<p class="section-hint">Faste verdier for Board, Type og Subtype på tickets, slik at alle bruker samme skrivemåte i stedet for fritekst.</p>

<div class="kategori-grupper">
    @foreach (var gruppe in Enum.GetValues<TicketKategoriGruppe>())
    {
        var liste = _kategorier.Where(k => k.Gruppe == gruppe).ToList();
        <div @key="gruppe" class="kategori-gruppe">
            <h2>@GruppeNavn(gruppe)</h2>

            @if (liste.Count == 0)
            {
                <p class="list-empty">Ingen verdier lagt til ennå.</p>
            }
            else
            {
                <ul class="kategori-liste">
                    @foreach (var k in liste)
                    {
                        <li @key="k.Id">
                            <span>@k.Navn</span>
                            <button type="button" class="remove-button" @onclick="@(() => SlettKategori(k))">Slett</button>
                        </li>
                    }
                </ul>
            }

            <div class="kategori-ny">
                <input @bind="_nyeVerdier[gruppe]" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettKategori(gruppe); } })"
                       placeholder="Ny verdi" />
                <button type="button" class="add-button" @onclick="@(() => OpprettKategori(gruppe))" disabled="@string.IsNullOrWhiteSpace(_nyeVerdier[gruppe])">Legg til</button>
            </div>
        </div>
    }
</div>

@code {
    private List<TicketKategori> _kategorier = [];
    private readonly Dictionary<TicketKategoriGruppe, string> _nyeVerdier =
        Enum.GetValues<TicketKategoriGruppe>().ToDictionary(g => g, _ => "");

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _kategorier = await Db.TicketKategorier
            .OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn)
            .ToListAsync();
    }

    private static string GruppeNavn(TicketKategoriGruppe gruppe) => gruppe switch
    {
        TicketKategoriGruppe.Board => "Board",
        TicketKategoriGruppe.Type => "Type",
        TicketKategoriGruppe.Subtype => "Subtype",
        _ => gruppe.ToString()
    };

    private async Task OpprettKategori(TicketKategoriGruppe gruppe)
    {
        var navn = _nyeVerdier[gruppe].Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var eksisterende = _kategorier.Where(k => k.Gruppe == gruppe).ToList();
        if (eksisterende.Any(k => string.Equals(k.Navn, navn, StringComparison.OrdinalIgnoreCase)))
        {
            _nyeVerdier[gruppe] = "";
            return;
        }

        var nesteRekkefolge = eksisterende.Count == 0 ? 1 : eksisterende.Max(k => k.Rekkefolge) + 1;
        Db.TicketKategorier.Add(new TicketKategori { Navn = navn, Gruppe = gruppe, Rekkefolge = nesteRekkefolge });
        await Db.SaveChangesAsync();

        _nyeVerdier[gruppe] = "";
        await LoadAsync();
    }

    private async Task SlettKategori(TicketKategori k)
    {
        Db.TicketKategorier.Remove(k);
        await Db.SaveChangesAsync();
        _kategorier.Remove(k);
    }
}
