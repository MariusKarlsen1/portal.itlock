@page "/kunde/jobb/{Id:int}"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>@(_ordre?.Tittel ?? "Jobb") - Full Kontroll</PageTitle>

<a class="dp-tilbake" href="/kunde/jobber"><Icon Name="arrow-left" />Mine jobber</a>

@if (_notFound)
{
    <p class="dp-feil">Fant ikke jobben.</p>
}
else if (_ordre is not null)
{
    var ferdig = KundeportalHelper.ErFerdig(_ordre);

    <div class="dp-to-kol">
        <div class="dp-kol">
            <div class="dp-kort dp-besok">
                <div class="dp-besok-topp">
                    @if ((ferdig ? _ordre.FullfortDato ?? _ordre.PlanlagtDato : _ordre.PlanlagtDato) is { } dato)
                    {
                        <span class="dp-kal"><small>@KundeportalHelper.Ukedag(dato)</small><b>@dato.Day</b></span>
                    }
                    <span>
                        <b style="font-size:1.2rem">@_ordre.Tittel</b>
                        <span>@Tidspunkt@(string.IsNullOrWhiteSpace(_ordre.Adresse) ? "" : $" · {_ordre.Adresse}")</span>
                    </span>
                    @if (ferdig)
                    {
                        <span class="dp-tag dp-t-gronn" style="margin-left:auto"><Icon Name="check" />Ferdig</span>
                    }
                </div>
                @if (!ferdig && _ordre.AnsvarligMontor is { } montor)
                {
                    <div class="dp-montor"><i>@KundeportalHelper.Initialer(montor.Navn)</i><span><b>@montor.Navn</b><small>kommer på besøk</small></span></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_ordre.Beskrivelse))
            {
                <div class="dp-kort dp-rapport">
                    <span class="dp-lbl" style="margin:0">Om jobben</span>
                    <p>@_ordre.Beskrivelse</p>
                </div>
            }

            @if (ferdig)
            {
                <div class="dp-kort dp-rapport">
                    <h3>Rapport fra jobben</h3>
                    @if (!string.IsNullOrWhiteSpace(_ordre.UtfortArbeid))
                    {
                        <span class="dp-lbl">Utført arbeid</span>
                        <p>@_ordre.UtfortArbeid</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_ordre.Anbefalinger))
                    {
                        <span class="dp-lbl">Anbefalinger</span>
                        <p>@_ordre.Anbefalinger</p>
                    }
                    @if (string.IsNullOrWhiteSpace(_ordre.UtfortArbeid) && string.IsNullOrWhiteSpace(_ordre.Anbefalinger))
                    {
                        <p style="color:var(--dp-dempet)">Jobben er utført.</p>
                    }
                    @if (_fullforingsBilder.Count > 0)
                    {
                        <span class="dp-lbl">Bilder</span>
                        <div class="dp-media">
                            @foreach (var m in _fullforingsBilder)
                            {
                                <a href="@($"/arbeidsordremedia/{m.Id}")" target="_blank" @key="m.Id">
                                    <img src="@($"/arbeidsordremedia/{m.Id}")" alt="Bilde fra jobben" />
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (!ferdig)
        {
            <div class="dp-kol">
                <div class="dp-kort dp-skjema">
                    <h2 style="margin:0;font-size:1.1rem;font-weight:600">Info før vi kommer</h2>
                    <p style="margin:0;color:var(--dp-dempet);font-size:.88rem">Skriv gjerne hvor nøkkelen ligger, hva som er galt eller adkomst – og legg ved bilder. Da er montøren bedre forberedt.</p>

                    <span class="dp-lbl">Informasjon</span>
                    <textarea class="dp-tekstfelt" rows="4" @bind="_ordre.KundeInfoForJobb" @bind:event="oninput" placeholder="F.eks. hvor nøkkelen ligger, hva som er galt, adkomst..."></textarea>

                    <span class="dp-lbl">Bilder</span>
                    <div class="dp-filer">
                        @foreach (var m in _kundeBilder)
                        {
                            <div class="dp-fil" @key="m.Id">
                                <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                                <button type="button" title="Slett bildet" @onclick="@(() => SlettBilde(m))">&times;</button>
                            </div>
                        }
                        <label class="dp-fil-ny">
                            <Icon Name="camera" />
                            @(_lasterOpp ? "Laster opp..." : "Legg til bilde")
                            <InputFile OnChange="LastOppBilder" accept="image/*" multiple />
                        </label>
                    </div>
                    @if (!string.IsNullOrEmpty(_bildeFeil))
                    {
                        <p class="dp-feil">@_bildeFeil</p>
                    }

                    <div class="dp-send-rad">
                        <button type="button" class="dp-send" style="background:var(--dp-brun)" @onclick="LagreInfo">
                            <Icon Name="check" />@(_lagretMelding ?? "Lagre info")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Arbeidsordre? _ordre;
    private bool _notFound;
    private List<ArbeidsordreMedia> _kundeBilder = [];
    private List<ArbeidsordreMedia> _fullforingsBilder = [];
    private string? _bildeFeil;
    private string? _lagretMelding;
    private bool _lasterOpp;

    private string Tidspunkt
    {
        get
        {
            var o = _ordre!;
            if (KundeportalHelper.ErFerdig(o))
            {
                return (o.FullfortDato ?? o.PlanlagtDato) is { } f ? $"Utført {f:dd.MM.yyyy}" : "Utført";
            }
            if (o.PlanlagtDato is not { } fra)
            {
                return "Dato ikke satt ennå";
            }
            var dag = fra.ToString("dddd d. MMMM", new System.Globalization.CultureInfo("nb-NO"));
            dag = char.ToUpper(dag[0]) + dag[1..];
            return fra.TimeOfDay == TimeSpan.Zero ? dag
                : o.PlanlagtSlutt is { } til ? $"{dag} kl. {fra:HH:mm}–{til:HH:mm}"
                : $"{dag} kl. {fra:HH:mm}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            _notFound = true;
            return;
        }

        var bruker = await Db.Brukere.FindAsync(brukerId);
        if (bruker?.KundeId is not int kundeId)
        {
            _notFound = true;
            return;
        }

        _ordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .FirstOrDefaultAsync(a => a.Id == Id);

        if (_ordre is null || !KundeportalHelper.HorerTilKunde(_ordre, kundeId))
        {
            _notFound = true;
            _ordre = null;
            return;
        }

        // Uten selve bildene - de vises via URL (se ArbeidsordreSkjema).
        var media = await Db.ArbeidsordreMedia.Where(m => m.ArbeidsordreId == Id).OrderByDescending(m => m.OpprettetDato)
            .Select(m => new ArbeidsordreMedia { Id = m.Id, ArbeidsordreId = m.ArbeidsordreId, Data = Array.Empty<byte>(), ContentType = m.ContentType, Filnavn = m.Filnavn, OpprettetDato = m.OpprettetDato, LastetOppAvKunde = m.LastetOppAvKunde })
            .ToListAsync();
        _kundeBilder = media.Where(m => m.LastetOppAvKunde).ToList();
        _fullforingsBilder = media.Where(m => !m.LastetOppAvKunde).ToList();
    }

    private async Task LagreInfo()
    {
        await Db.SaveChangesAsync();
        _lagretMelding = "Lagret ✓";
    }

    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        _bildeFeil = null;
        _lasterOpp = true;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var media = new ArbeidsordreMedia
            {
                ArbeidsordreId = Id,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name,
                LastetOppAvKunde = true
            };
            Db.ArbeidsordreMedia.Add(media);
            await Db.SaveChangesAsync();

            _kundeBilder.Insert(0, media);
        }

        _lasterOpp = false;
    }

    private async Task SlettBilde(ArbeidsordreMedia media)
    {
        var entitet = await Db.ArbeidsordreMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.ArbeidsordreMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _kundeBilder.Remove(media);
    }
}
