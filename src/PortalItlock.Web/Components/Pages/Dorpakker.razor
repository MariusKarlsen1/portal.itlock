@page "/dorpakker"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Dørpakker</PageTitle>

@* DP1 (dorpakker-forslag.html): tabell til venstre, valgt pakke i panelet til
   høyre (som Brukere B7). Filter på type dør som knapper, og ⋯-meny med
   Rediger/Dupliser/Slett i stedet for egen redigeringsmodus. *@
<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="box" /></span>
        <div>
            <h1>Dørpakker</h1>
            <p class="section-hint">Ferdige pakker med krav og komponenter som kravvelgeren foreslår. Åpne en pakke for å endre krav og komponenter.</p>
        </div>
    </div>
    <div class="dp-verktoy">
        <label class="dp-sok">
            <Icon Name="search" />
            <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk navn, krav eller komponent …" />
        </label>
        <a class="dp-knapp primaer" href="/ny-pakke"><Icon Name="plus" />Ny dørpakke</a>
    </div>
</div>

@if (_typeDorVerdier.Count > 0)
{
    <div class="dp-chips">
        <button type="button" class="dp-chip @(_filterTypeId is null ? "pa" : "")" @onclick="@(() => _filterTypeId = null)">Alle <small>@_alle.Count</small></button>
        @foreach (var verdi in _typeDorVerdier)
        {
            var id = verdi.Id;
            var antall = _alle.Count(p => p.Krav.Any(k => k.RequirementValueId == id));
            <button type="button" class="dp-chip @(_filterTypeId == id ? "pa" : "")" @onclick="@(() => _filterTypeId = _filterTypeId == id ? null : id)">@verdi.Verdi <small>@antall</small></button>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="dp-ok">@_melding</p>
}

<div class="dp-oppsett">
    <div class="dp-tabell">
        @if (_filtrert.Count == 0)
        {
            <p class="dp-tom">@(_alle.Count == 0 ? "Ingen dørpakker ennå. Lag den første med «Ny dørpakke»." : "Ingen dørpakker passer søket.")</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Dørpakke</th>
                        <th class="n dp-skjul-m">Komponenter</th>
                        <th class="n">Pris</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _filtrert)
                    {
                        var id = p.Id;
                        <tr @key="p.Id" class="@(_valgtId == id ? "valgt" : "")" @onclick="@(() => Velg(id))">
                            <td>
                                <span class="dp-pakke">
                                    <span class="dp-figur"><DoorFigur AntallFloyer="@PakkeVisningHjelper.AntallFloyerVerdi(p)" /></span>
                                    <span class="dp-pakke-tekst">
                                        <b>@p.Navn</b>
                                        @if (!string.IsNullOrWhiteSpace(p.Beskrivelse))
                                        {
                                            <small>@p.Beskrivelse</small>
                                        }
                                        @{
                                            var piller = PakkeVisningHjelper.TopPiller(p, 4);
                                        }
                                        @if (piller.Count > 0)
                                        {
                                            <span class="dp-tagger">
                                                @foreach (var pille in piller)
                                                {
                                                    <span class="dp-tag">@pille</span>
                                                }
                                            </span>
                                        }
                                    </span>
                                </span>
                            </td>
                            <td class="n dp-skjul-m">@p.Komponenter.Count</td>
                            <td class="n dp-pris">@Kr(Sum(p))</td>
                            <td class="n dp-meny-celle" @onclick:stopPropagation="true">
                                <button type="button" class="dp-mer" title="Flere valg" @onclick="@(() => { _menyId = _menyId == id ? null : id; _bekreftSlett = false; })"><Icon Name="more-horizontal" /></button>
                                @if (_menyId == id)
                                {
                                    <span class="dp-meny-bakgrunn" @onclick="@(() => _menyId = null)"></span>
                                    <span class="dp-meny">
                                        <a href="@($"/rediger-pakke/{id}")"><Icon Name="edit" />Rediger pakke</a>
                                        <button type="button" @onclick="@(() => Dupliser(id))"><Icon Name="clipboard" />Dupliser</button>
                                        <span class="dp-skille"></span>
                                        @if (_bekreftSlett)
                                        {
                                            <button type="button" class="farlig" @onclick="@(() => SlettPakke(id))"><Icon Name="trash" />Ja, slett «@p.Navn»</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="farlig" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett …</button>
                                        }
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <aside class="dp-panel">
        @if (_valgt is null)
        {
            <div class="dp-panel-tom">
                <Icon Name="box" />
                <p>Velg en pakke i listen for å se krav og komponenter.</p>
            </div>
        }
        else
        {
            <div class="dp-panel-topp">
                <span class="dp-figur stor"><DoorFigur AntallFloyer="@PakkeVisningHjelper.AntallFloyerVerdi(_valgt)" /></span>
                <div>
                    <h2>@_valgt.Navn</h2>
                    @if (!string.IsNullOrWhiteSpace(_valgt.Beskrivelse))
                    {
                        <p>@_valgt.Beskrivelse</p>
                    }
                </div>
            </div>

            var grunndata = PakkeVisningHjelper.Grunndata(_valgt);
            <span class="dp-seksjon">Krav</span>
            @if (grunndata.Count == 0)
            {
                <p class="dp-dempet">Ingen krav satt.</p>
            }
            else
            {
                <div class="dp-kv">
                    @foreach (var rad in grunndata)
                    {
                        <span>@rad.Label</span>
                        <b>@rad.Verdi</b>
                    }
                </div>
            }

            <span class="dp-seksjon">Komponenter (@_valgt.Komponenter.Count)</span>
            @if (_valgt.Komponenter.Count == 0)
            {
                <p class="dp-dempet">Ingen komponenter lagt til ennå.</p>
            }
            else
            {
                <div class="dp-klist">
                    @foreach (var k in _valgt.Komponenter.OrderBy(k => k.Component?.Navn))
                    {
                        <div>
                            <span class="dp-ant">@k.Antall×</span>
                            <span class="dp-knavn">@k.Component?.Navn</span>
                            <span class="dp-kpris">@(k.Component?.PrisNetto is decimal pris ? Kr(pris * k.Antall) : "–")</span>
                        </div>
                    }
                </div>
                <div class="dp-sum">
                    <span>Sum komponenter (netto)</span>
                    <b>@Kr(Sum(_valgt))</b>
                </div>
                var utenPris = _valgt.Komponenter.Count(k => k.Component?.PrisNetto is null);
                @if (utenPris > 0)
                {
                    <p class="dp-dempet">@utenPris @(utenPris == 1 ? "komponent mangler" : "komponenter mangler") pris og er ikke med i summen.</p>
                }
            }

            <div class="dp-panel-knapper">
                <button type="button" class="dp-lenke" @onclick="@(() => Dupliser(_valgt.Id))"><Icon Name="clipboard" />Dupliser</button>
                <a class="dp-knapp primaer" href="@($"/rediger-pakke/{_valgt.Id}")"><Icon Name="edit" />Rediger pakke</a>
            </div>
        }
    </aside>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private List<Package> _alle = [];
    private string _search = "";
    private int? _valgtId;
    private int? _menyId;
    private bool _bekreftSlett;
    private string? _melding;
    private List<RequirementValue> _typeDorVerdier = [];
    private int? _filterTypeId;

    private Package? _valgt => _alle.FirstOrDefault(p => p.Id == _valgtId);

    private List<Package> _filtrert
    {
        get
        {
            var resultat = _alle.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                resultat = resultat.Where(p =>
                    p.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (p.Beskrivelse?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Krav.Any(k => k.RequirementValue?.Verdi.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Komponenter.Any(k => k.Component is not null && k.Component.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            if (_filterTypeId is int typeId)
            {
                resultat = resultat.Where(p => p.Krav.Any(k => k.RequirementValueId == typeId));
            }

            return resultat.ToList();
        }
    }

    private static decimal Sum(Package p) => p.Komponenter.Sum(k => (k.Component?.PrisNetto ?? 0) * k.Antall);

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        var typeDor = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .FirstOrDefaultAsync(d => d.Navn == "Type dør");
        _typeDorVerdier = typeDor?.Verdier.ToList() ?? [];

        _valgtId = _alle.FirstOrDefault()?.Id;
    }

    private async Task LoadAsync()
    {
        _alle = await Db.Packages
            .Include(p => p.Krav).ThenInclude(k => k.RequirementValue).ThenInclude(v => v!.Dimensjon)
            .Include(p => p.Komponenter).ThenInclude(k => k.Component)
            .OrderBy(p => p.Navn)
            .ToListAsync();
    }

    private void Velg(int id)
    {
        _valgtId = id;
        _menyId = null;
    }

    private async Task Dupliser(int id)
    {
        _menyId = null;
        var kilde = await Db.Packages
            .AsNoTracking()
            .Include(p => p.Krav)
            .Include(p => p.Komponenter)
            .Include(p => p.DorFunksjoner)
            .FirstOrDefaultAsync(p => p.Id == id);
        if (kilde is null)
        {
            return;
        }

        var funksjonIder = kilde.DorFunksjoner.Select(f => f.Id).ToList();
        var kopi = new Package
        {
            Navn = $"{kilde.Navn} (kopi)",
            Beskrivelse = kilde.Beskrivelse,
            Bruksomrade = kilde.Bruksomrade,
            ErManuell = kilde.ErManuell,
            OpprettetAv = kilde.OpprettetAv,
            Krav = kilde.Krav.Select(k => new PackageRequirement { RequirementValueId = k.RequirementValueId }).ToList(),
            Komponenter = kilde.Komponenter.Select(k => new PackageComponent { ComponentId = k.ComponentId, Antall = k.Antall, LevertAv = k.LevertAv }).ToList(),
            DorFunksjoner = await Db.DorFunksjoner.Where(f => funksjonIder.Contains(f.Id)).ToListAsync()
        };
        Db.Packages.Add(kopi);
        await Db.SaveChangesAsync();

        await LoadAsync();
        _valgtId = kopi.Id;
        _melding = $"«{kopi.Navn}» er laget. Åpne den med «Rediger pakke» for å gi den nytt navn.";
    }

    private async Task SlettPakke(int id)
    {
        var eksisterende = await Db.Packages.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            var navn = eksisterende.Navn;
            Db.Packages.Remove(eksisterende);
            await Db.SaveChangesAsync();
            _melding = $"«{navn}» er slettet.";
        }

        _alle.RemoveAll(p => p.Id == id);
        _menyId = null;
        _bekreftSlett = false;
        if (_valgtId == id)
        {
            _valgtId = _filtrert.FirstOrDefault()?.Id;
        }
    }
}
