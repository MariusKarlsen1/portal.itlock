@page "/dorpakker"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Dørpakker</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="box" /></span>
        <div>
            <h1>Dørpakker</h1>
            <p class="section-hint">Oversikt over dørpakker satt sammen for kravvelgeren. Åpne en pakke for å redigere krav og komponenter.</p>
        </div>
    </div>
</div>

<div class="verktoy-rad">
    <div class="sok-boks">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på navn, beskrivelse eller komponent" />
    </div>
    <div class="knapp-rad">
        <div class="visning-bryter">
            <button type="button" class="visning-knapp @(_visning == "liste" ? "visning-aktiv" : "")" title="Listevisning" @onclick="@(() => _visning = "liste")">
                <Icon Name="grip" />
            </button>
            <button type="button" class="visning-knapp @(_visning == "splitt" ? "visning-aktiv" : "")" title="Detaljvisning" @onclick="VisSplitt">
                <Icon Name="maximize" />
            </button>
        </div>
        <a class="knapp knapp-primaer" href="/ny-pakke"><Icon Name="plus" />Ny pakke</a>
        @if (_visning == "liste")
        {
            <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "")" @onclick="ToggleRedigerModus">
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        }
    </div>
</div>

@if (_visning == "splitt")
{
    <div class="dp-splitt">
        <div class="dp-splitt-liste">
            @if (_filtrert.Count == 0)
            {
                <p class="list-empty">Ingen dørpakker funnet.</p>
            }
            else
            {
                @foreach (var p in _filtrert)
                {
                    <button type="button" class="dp-splitt-kort @(_valgtId == p.Id ? "dp-splitt-kort-aktiv" : "")" @key="p.Id" @onclick="@(() => _valgtId = p.Id)">
                        <div class="dp-splitt-kort-topp">
                            <span class="dp-splitt-kort-navn">@p.Navn</span>
                            <span class="pakke-komp-badge">@p.Komponenter.Count komponent@(p.Komponenter.Count == 1 ? "" : "er")</span>
                        </div>
                        @{
                            var piller = TopPiller(p);
                        }
                        @if (piller.Count > 0)
                        {
                            <div class="dp-splitt-pille-rad">
                                @foreach (var pille in piller)
                                {
                                    <span class="dp-splitt-pille">@pille</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Beskrivelse))
                        {
                            <p class="dp-splitt-kort-besk">@p.Beskrivelse</p>
                        }
                    </button>
                }
            }
        </div>

        <div class="dp-splitt-detalj">
            @if (_valgt is null)
            {
                <div class="dp-splitt-tom">
                    <Icon Name="box" />
                    <p>Velg en pakke i listen for å se detaljer.</p>
                </div>
            }
            else
            {
                <div class="dp-splitt-detalj-topp">
                    <h2>@_valgt.Navn</h2>
                    <a class="knapp knapp-primaer" href="@($"/rediger-pakke/{_valgt.Id}")"><Icon Name="edit" />Rediger</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(_valgt.Beskrivelse))
                {
                    <p class="dp-splitt-besk">@_valgt.Beskrivelse</p>
                }

                <div class="dp-grunndata">
                    @foreach (var rad in Grunndata(_valgt))
                    {
                        <div class="dp-grunndata-rad">
                            <span class="dp-grunndata-ikon"><Icon Name="@rad.Ikon" /></span>
                            <span class="dp-grunndata-label">@rad.Label</span>
                            <span class="dp-grunndata-pille">@rad.Verdi</span>
                        </div>
                    }
                </div>

                <h3 class="dp-komponenter-tittel">Komponenter (@_valgt.Komponenter.Count)</h3>
                @if (_valgt.Komponenter.Count == 0)
                {
                    <p class="list-empty">Ingen komponenter lagt til ennå.</p>
                }
                else
                {
                    <div class="dp-komponent-liste">
                        @foreach (var k in _valgt.Komponenter.OrderBy(k => k.Component?.Navn))
                        {
                            <div class="dp-komponent-rad">
                                <span class="dp-komponent-ikon"><Icon Name="box" /></span>
                                <span class="dp-komponent-navn">@k.Component?.Navn</span>
                                <span class="dp-komponent-antall">@k.Antall</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}
else if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen dørpakker funnet.</p>
}
else
{
    <div class="pakke-liste">
        @foreach (var p in _filtrert)
        {
            <div class="pakke-item" @key="p.Id">
                <a class="pakke-kort" href="@($"/rediger-pakke/{p.Id}")">
                    <span class="pakke-ikon"><Icon Name="box" /></span>
                    <div class="pakke-tekst">
                        <span class="pakke-navn">@p.Navn</span>
                        @if (!string.IsNullOrWhiteSpace(p.Beskrivelse))
                        {
                            <span class="pakke-meta">@p.Beskrivelse</span>
                        }
                    </div>
                    <span class="pakke-komp-badge">@p.Komponenter.Count komponent@(p.Komponenter.Count == 1 ? "" : "er")</span>
                </a>
                @if (_redigerModus)
                {
                    @if (_slettId == p.Id)
                    {
                        <span class="pakke-slett-confirm">
                            Slette "@p.Navn"?
                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettPakke(p.Id))">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="pakke-slett-button" title="Slett pakke" @onclick="@(() => _slettId = p.Id)">&times;</button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private List<Package> _alle = [];
    private string _search = "";
    private bool _redigerModus;
    private int? _slettId;
    private string _visning = "liste";
    private int? _valgtId;

    private Package? _valgt => _alle.FirstOrDefault(p => p.Id == _valgtId);

    private List<Package> _filtrert
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
            {
                return _alle;
            }

            var s = _search.Trim();
            return _alle.Where(p =>
                p.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (p.Beskrivelse?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                p.Komponenter.Any(k => k.Component is not null && k.Component.Navn.Contains(s, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _alle = await Db.Packages
            .Include(p => p.Krav).ThenInclude(k => k.RequirementValue).ThenInclude(v => v!.Dimensjon)
            .Include(p => p.Komponenter).ThenInclude(k => k.Component)
            .OrderBy(p => p.Navn)
            .ToListAsync();
    }

    private void VisSplitt()
    {
        _visning = "splitt";
        _redigerModus = false;
        _slettId = null;
        _valgtId ??= _filtrert.FirstOrDefault()?.Id;
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task SlettPakke(int id)
    {
        var eksisterende = await Db.Packages.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            Db.Packages.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        _alle.RemoveAll(p => p.Id == id);
        _slettId = null;
        if (_valgtId == id)
        {
            _valgtId = null;
        }
    }

    // Viser de 3 viktigste kravene pakken oppfyller som små piller i kortet,
    // i samme rekkefølge som dimensjonene selv er definert i (Rekkefolge),
    // slik at det alltid er "Type dør"/"Hvilke bruk"-aktige krav øverst
    // fremfor en tilfeldig rekkefølge.
    private static List<string> TopPiller(Package p) =>
        p.Krav
            .Where(k => k.RequirementValue is not null)
            .OrderBy(k => k.RequirementValue!.Dimensjon?.Rekkefolge ?? 99)
            .Select(k => k.RequirementValue!.Verdi)
            .Take(3)
            .ToList();

    private sealed record GrunndataRad(string Ikon, string Label, string Verdi);

    // "Grunndata"-boksen i detaljvisningen er en ren visning av pakkens
    // EKSISTERENDE krav (RequirementDimension/-Value, samme data som
    // kravvelgeren på /finn-dorpakke bruker) - ingen nye felter, bare en
    // annen fremstilling: én rad per dimensjon i stedet for avkrysningsbokser.
    // "FG" vises som "FG-godkjenning" og dimensjonen "Lukkefunksjon" vises
    // som et utledet "Automatikk: Ja/Nei" (Ja når valgt verdi inneholder
    // "Automatikk"), for å matche det oppgitte designet.
    private static List<GrunndataRad> Grunndata(Package p)
    {
        string? VerdiFor(int dimensjonId) =>
            p.Krav.FirstOrDefault(k => k.RequirementValue?.RequirementDimensionId == dimensjonId)?.RequirementValue?.Verdi;

        var rader = new List<GrunndataRad>();

        if (VerdiFor(1) is { } typeDor) { rader.Add(new("box", "Type dør", typeDor)); }
        if (VerdiFor(2) is { } hvilkeBruk) { rader.Add(new("lock", "Hvilke bruk", hvilkeBruk)); }
        if (VerdiFor(3) is { } fg) { rader.Add(new("shield", "FG-godkjenning", fg)); }
        if (VerdiFor(4) is { } risikoklasse) { rader.Add(new("alert", "Risikoklasse", risikoklasse)); }

        var lukkefunksjon = VerdiFor(5);
        if (lukkefunksjon is not null)
        {
            var erAutomatikk = lukkefunksjon.Contains("Automatikk", StringComparison.OrdinalIgnoreCase);
            rader.Add(new("toggle-right", "Automatikk", erAutomatikk ? "Ja" : "Nei"));
        }

        if (VerdiFor(6) is { } antallFloyer) { rader.Add(new("maximize", "Antall fløyer", antallFloyer)); }
        if (VerdiFor(7) is { } typeBeslag) { rader.Add(new("tool", "Type beslag", typeBeslag)); }
        if (VerdiFor(8) is { } tilbakeromning) { rader.Add(new("arrow-left", "Tilbakerømning", tilbakeromning)); }
        if (VerdiFor(9) is { } postsonesylinder) { rader.Add(new("mail", "Postsonesylinder", postsonesylinder)); }

        return rader;
    }
}
