@page "/dorpakker"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Dørpakker</PageTitle>

@* DP14 (dorpakker-dp7-forslag.html): type dør og bruksområde som avkrysning i
   menyen inni kortet, pakkene i midten og valgt pakke i panelet til høyre.
   Kortet fyller vinduet, og hver kolonne ruller for seg. *@
<div class="dp @(_full ? "dp-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="box" /></span>
            <div>
                <h1>Dørpakker</h1>
                <p class="section-hint">Ferdige pakker med krav og komponenter som kravvelgeren foreslår. Filtrer på type dør og bruksområde i menyen.</p>
            </div>
        </div>
        <a class="dp-knapp primaer" href="/ny-pakke"><Icon Name="plus" />Ny dørpakke</a>
    </div>

    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="dp-ok">@_melding</p>
    }

    <div class="dp-kort">
        <nav class="dp-meny">
            <div class="dp-meny-rull">
                @if (_typeDorVerdier.Count > 0)
                {
                    <span class="dp-gt">Type dør</span>
                    @foreach (var verdi in _typeDorVerdier)
                    {
                        var id = verdi.Id;
                        var valgt = _typeFilter.Contains(id);
                        <button type="button" class="dp-mi @(valgt ? "pa" : "")" @onclick="@(() => VekslType(id))">
                            <span class="dp-sjekk">@if (valgt) {<Icon Name="check" />}</span>
                            <span class="dp-mi-navn">@verdi.Verdi</span>
                            <small>@_alle.Count(p => p.Krav.Any(k => k.RequirementValueId == id))</small>
                        </button>
                    }
                }

                @if (_bruksomrader.Count > 0)
                {
                    <span class="dp-gt">Bruksområde</span>
                    @foreach (var sted in _bruksomrader)
                    {
                        var s = sted;
                        var valgt = _bruksFilter.Contains(s);
                        <button type="button" class="dp-mi @(valgt ? "pa" : "")" @onclick="@(() => VekslBruk(s))">
                            <span class="dp-sjekk">@if (valgt) {<Icon Name="check" />}</span>
                            <span class="dp-mi-navn">@s</span>
                            <small>@_alle.Count(p => Bruksomrader(p).Contains(s, StringComparer.OrdinalIgnoreCase))</small>
                        </button>
                    }
                }
            </div>
            <a class="dp-mi dp-mi-lenke" href="/kravdimensjoner"><Icon Name="settings" /><span class="dp-mi-navn">Krav og dimensjoner</span></a>
        </nav>

        <section class="dp-midt">
            <div class="dp-verktoy">
                <label class="dp-sok">
                    <Icon Name="search" />
                    <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk navn, krav eller komponent …" />
                </label>
                <button type="button" class="dp-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            @if (_typeFilter.Count > 0 || _bruksFilter.Count > 0)
            {
                <div class="dp-aktive">
                    @foreach (var verdi in _typeDorVerdier.Where(v => _typeFilter.Contains(v.Id)))
                    {
                        var id = verdi.Id;
                        <span>@verdi.Verdi<button type="button" title="Fjern filter" @onclick="@(() => VekslType(id))">✕</button></span>
                    }
                    @foreach (var sted in _bruksFilter.Order())
                    {
                        var s = sted;
                        <span>@s<button type="button" title="Fjern filter" @onclick="@(() => VekslBruk(s))">✕</button></span>
                    }
                    <button type="button" class="dp-lenke" @onclick="NullstillFilter">Nullstill</button>
                </div>
            }

            <div class="dp-liste">
                @foreach (var p in _filtrert)
                {
                    var id = p.Id;
                    <div @key="p.Id" class="dp-rad @(_valgtId == id ? "valgt" : "")" @onclick="@(() => Velg(id))">
                        <span class="dp-figur"><DoorFigur AntallFloyer="@PakkeVisningHjelper.AntallFloyerVerdi(p)" /></span>
                        <span class="dp-rad-tekst">
                            <b>@p.Navn</b>
                            @{
                                var piller = PakkeVisningHjelper.TopPiller(p, 3);
                            }
                            @if (piller.Count > 0)
                            {
                                <span class="dp-tagger">
                                    @foreach (var pille in piller)
                                    {
                                        <span class="dp-tag">@pille</span>
                                    }
                                </span>
                            }
                        </span>
                        <span class="dp-pris">@Kr(Sum(p))</span>
                    </div>
                }
                @if (_filtrert.Count == 0)
                {
                    <p class="dp-tom">@(_alle.Count == 0 ? "Ingen dørpakker ennå. Lag den første med «Ny dørpakke»." : "Ingen dørpakker passer søket eller filtrene.")</p>
                }
            </div>
            <div class="dp-bunnlinje">@_filtrert.Count av @_alle.Count @(_alle.Count == 1 ? "pakke" : "pakker")</div>
        </section>

        <aside class="dp-panel">
            @if (_valgt is null)
            {
                <div class="dp-panel-tom">
                    <Icon Name="box" />
                    <p>Velg en pakke i listen for å se krav og komponenter.</p>
                </div>
            }
            else
            {
                <div class="dp-panel-rull">
                    <div class="dp-panel-topp">
                        <span class="dp-figur stor"><DoorFigur AntallFloyer="@PakkeVisningHjelper.AntallFloyerVerdi(_valgt)" /></span>
                        <div>
                            <h2>@_valgt.Navn</h2>
                            @if (!string.IsNullOrWhiteSpace(_valgt.Beskrivelse))
                            {
                                <p>@_valgt.Beskrivelse</p>
                            }
                        </div>
                    </div>

                    @{
                        var steder = Bruksomrader(_valgt);
                    }
                    @if (steder.Count > 0)
                    {
                        <div class="dp-tagger">
                            @foreach (var sted in steder)
                            {
                                <span class="dp-tag">@sted</span>
                            }
                        </div>
                    }

                    @{
                        var grunndata = PakkeVisningHjelper.Grunndata(_valgt);
                    }
                    <span class="dp-seksjon">Krav</span>
                    @if (grunndata.Count == 0)
                    {
                        <p class="dp-dempet">Ingen krav satt.</p>
                    }
                    else
                    {
                        <div class="dp-kv">
                            @foreach (var rad in grunndata)
                            {
                                <span>@rad.Label</span>
                                <b>@rad.Verdi</b>
                            }
                        </div>
                    }

                    <span class="dp-seksjon">Komponenter (@_valgt.Komponenter.Count)</span>
                    @if (_valgt.Komponenter.Count == 0)
                    {
                        <p class="dp-dempet">Ingen komponenter lagt til ennå.</p>
                    }
                    else
                    {
                        <div class="dp-klist">
                            @foreach (var k in _valgt.Komponenter.OrderBy(k => k.Component?.Navn))
                            {
                                <div>
                                    <span class="dp-ant">@k.Antall×</span>
                                    <span class="dp-knavn">@k.Component?.Navn</span>
                                    <span class="dp-kpris">@(k.Component?.PrisNetto is decimal pris ? Kr(pris * k.Antall) : "–")</span>
                                </div>
                            }
                        </div>
                        <div class="dp-sum">
                            <span>Sum komponenter (netto)</span>
                            <b>@Kr(Sum(_valgt))</b>
                        </div>
                        var utenPris = _valgt.Komponenter.Count(k => k.Component?.PrisNetto is null);
                        @if (utenPris > 0)
                        {
                            <p class="dp-dempet">@utenPris @(utenPris == 1 ? "komponent mangler" : "komponenter mangler") pris og er ikke med i summen.</p>
                        }
                    }
                </div>

                <div class="dp-panel-knapper">
                    @if (_bekreftSlett)
                    {
                        <span class="dp-dempet">Slette «@_valgt.Navn»?</span>
                        <span class="dp-knapperad">
                            <button type="button" class="dp-knapp fare" @onclick="@(() => SlettPakke(_valgt.Id))">Ja, slett</button>
                            <button type="button" class="dp-knapp" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <span class="dp-knapperad">
                            <button type="button" class="dp-lenke" @onclick="@(() => Dupliser(_valgt.Id))"><Icon Name="clipboard" />Dupliser</button>
                            <button type="button" class="dp-lenke fare" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett</button>
                        </span>
                        <a class="dp-knapp primaer" href="@($"/rediger-pakke/{_valgt.Id}")"><Icon Name="edit" />Rediger pakke</a>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private List<Package> _alle = [];
    private string _search = "";
    private int? _valgtId;
    private bool _bekreftSlett;
    private bool _full;
    private string? _melding;
    private List<RequirementValue> _typeDorVerdier = [];
    private List<string> _bruksomrader = [];
    private readonly HashSet<int> _typeFilter = [];
    private readonly HashSet<string> _bruksFilter = new(StringComparer.OrdinalIgnoreCase);

    private Package? _valgt => _alle.FirstOrDefault(p => p.Id == _valgtId);

    // Bruksområde er fritekst med ett sted per linje (se Rediger pakke).
    private static List<string> Bruksomrader(Package p) =>
        string.IsNullOrWhiteSpace(p.Bruksomrade)
            ? []
            : p.Bruksomrade.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

    private List<Package> _filtrert
    {
        get
        {
            var resultat = _alle.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                resultat = resultat.Where(p =>
                    p.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (p.Beskrivelse?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Bruksomrade?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Krav.Any(k => k.RequirementValue?.Verdi.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Komponenter.Any(k => k.Component is not null && k.Component.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            // Innen samme gruppe er det "eller", mellom gruppene "og".
            if (_typeFilter.Count > 0)
            {
                resultat = resultat.Where(p => p.Krav.Any(k => _typeFilter.Contains(k.RequirementValueId)));
            }

            if (_bruksFilter.Count > 0)
            {
                resultat = resultat.Where(p => Bruksomrader(p).Any(_bruksFilter.Contains));
            }

            return resultat.ToList();
        }
    }

    private static decimal Sum(Package p) => p.Komponenter.Sum(k => (k.Component?.PrisNetto ?? 0) * k.Antall);

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("dorpakker-bredde", "normal") == "full";
        await LoadAsync();

        var typeDor = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .FirstOrDefaultAsync(d => d.Navn == "Type dør");
        _typeDorVerdier = typeDor?.Verdier.ToList() ?? [];

        _valgtId = _alle.FirstOrDefault()?.Id;
    }

    private async Task LoadAsync()
    {
        _alle = await Db.Packages
            .Include(p => p.Krav).ThenInclude(k => k.RequirementValue).ThenInclude(v => v!.Dimensjon)
            .Include(p => p.Komponenter).ThenInclude(k => k.Component)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        _bruksomrader = _alle
            .SelectMany(Bruksomrader)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.Create(Kultur, true))
            .ToList();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dorpakker-bredde", _full ? "full" : "normal");
    }

    private void VekslType(int id)
    {
        if (!_typeFilter.Remove(id))
        {
            _typeFilter.Add(id);
        }

        VelgFørsteHvisSkjult();
    }

    private void VekslBruk(string sted)
    {
        if (!_bruksFilter.Remove(sted))
        {
            _bruksFilter.Add(sted);
        }

        VelgFørsteHvisSkjult();
    }

    private void NullstillFilter()
    {
        _typeFilter.Clear();
        _bruksFilter.Clear();
    }

    // Holder panelet i takt med lista når filteret skjuler valgt pakke.
    private void VelgFørsteHvisSkjult()
    {
        var liste = _filtrert;
        if (liste.All(p => p.Id != _valgtId))
        {
            _valgtId = liste.FirstOrDefault()?.Id;
        }

        _bekreftSlett = false;
    }

    private void Velg(int id)
    {
        _valgtId = id;
        _bekreftSlett = false;
    }

    private async Task Dupliser(int id)
    {
        var kilde = await Db.Packages
            .AsNoTracking()
            .Include(p => p.Krav)
            .Include(p => p.Komponenter)
            .Include(p => p.DorFunksjoner)
            .FirstOrDefaultAsync(p => p.Id == id);
        if (kilde is null)
        {
            return;
        }

        var funksjonIder = kilde.DorFunksjoner.Select(f => f.Id).ToList();
        var kopi = new Package
        {
            Navn = $"{kilde.Navn} (kopi)",
            Beskrivelse = kilde.Beskrivelse,
            Bruksomrade = kilde.Bruksomrade,
            ErManuell = kilde.ErManuell,
            OpprettetAv = kilde.OpprettetAv,
            Krav = kilde.Krav.Select(k => new PackageRequirement { RequirementValueId = k.RequirementValueId }).ToList(),
            Komponenter = kilde.Komponenter.Select(k => new PackageComponent { ComponentId = k.ComponentId, Antall = k.Antall, LevertAv = k.LevertAv }).ToList(),
            DorFunksjoner = await Db.DorFunksjoner.Where(f => funksjonIder.Contains(f.Id)).ToListAsync()
        };
        Db.Packages.Add(kopi);
        await Db.SaveChangesAsync();

        await LoadAsync();
        _valgtId = kopi.Id;
        _melding = $"«{kopi.Navn}» er laget. Åpne den med «Rediger pakke» for å gi den nytt navn.";
    }

    private async Task SlettPakke(int id)
    {
        var eksisterende = await Db.Packages.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            var navn = eksisterende.Navn;
            Db.Packages.Remove(eksisterende);
            await Db.SaveChangesAsync();
            _melding = $"«{navn}» er slettet.";
        }

        _alle.RemoveAll(p => p.Id == id);
        _bekreftSlett = false;
        if (_valgtId == id)
        {
            _valgtId = _filtrert.FirstOrDefault()?.Id;
        }
    }
}
