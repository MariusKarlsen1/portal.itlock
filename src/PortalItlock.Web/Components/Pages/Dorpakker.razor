@page "/dorpakker"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VisningPreferanseService VisningPref

<PageTitle>Dørpakker</PageTitle>

@* O1 (Prototype dørpakker oversikt.html): samme liste som Prosjekter. Søk og
   filtre øverst, én rad per pakke, og klikk på raden åpner pakken. *@
<div class="dp @(_full ? "dp-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="box" /></span>
            <div>
                <h1>Dørpakker</h1>
                <p class="section-hint">Ferdige pakker med krav og komponenter som kravvelgeren foreslår.</p>
            </div>
        </div>
        <div class="dp-topp-knapper">
            <a class="dp-knapp" href="/kravdimensjoner"><Icon Name="settings" />Krav og dimensjoner</a>
            <a class="dp-knapp primaer" href="/ny-pakke"><Icon Name="plus" />Ny dørpakke</a>
        </div>
    </div>

    <div class="dp-kort">
        <div class="dp-verktoy">
            <label class="dp-sok">
                <Icon Name="search" />
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk navn, krav eller komponent …" />
            </label>
            @if (_typeDorVerdier.Count > 0)
            {
                <select class="dp-valg" @bind="_typeFilter" title="Type dør">
                    <option value="0">Type dør: Alle</option>
                    @foreach (var verdi in _typeDorVerdier)
                    {
                        <option value="@verdi.Id">@verdi.Verdi (@_alle.Count(p => p.Krav.Any(k => k.RequirementValueId == verdi.Id)))</option>
                    }
                </select>
            }
            @if (_bruksomrader.Count > 0)
            {
                <select class="dp-valg" @bind="_bruksFilter" title="Bruksområde">
                    <option value="">Bruksområde: Alle</option>
                    @foreach (var sted in _bruksomrader)
                    {
                        <option value="@sted">@sted</option>
                    }
                </select>
            }
            <select class="dp-valg dp-hoyre" @bind="_sortering" title="Sortering">
                <option value="navn">Sorter: Navn</option>
                <option value="pris">Sorter: Pris</option>
                <option value="nyest">Sorter: Nyeste først</option>
            </select>
            <button type="button" class="dp-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>
        </div>

        <div class="dp-antall">
            @_filtrert.Count av @_alle.Count @(_alle.Count == 1 ? "pakke" : "pakker")
            @if (_typeFilter != 0 || !string.IsNullOrEmpty(_bruksFilter) || !string.IsNullOrWhiteSpace(_search))
            {
                <button type="button" class="dp-lenke" @onclick="NullstillFilter">Nullstill</button>
            }
        </div>

        @if (_filtrert.Count == 0)
        {
            <p class="dp-tom">@(_alle.Count == 0 ? "Ingen dørpakker ennå. Lag den første med «Ny dørpakke»." : "Ingen dørpakker passer søket eller filtrene.")</p>
        }
        else
        {
            <div class="dp-tabell">
                <table>
                    <thead>
                        <tr>
                            <th>Navn</th>
                            <th class="dp-skjul-m">Bruksområde</th>
                            <th class="dp-skjul-m">Krav</th>
                            <th class="n dp-skjul-m">Komponenter</th>
                            <th class="n">Netto</th>
                            <th class="dp-skjul-m">Opprettet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _filtrert)
                        {
                            var id = p.Id;
                            var steder = Bruksomrader(p);
                            var piller = PakkeVisningHjelper.TopPiller(p, 3);
                            <tr @key="p.Id" @onclick="@(() => Nav.NavigateTo($"/rediger-pakke/{id}"))">
                                <td>
                                    <a class="dp-navn" href="@($"/rediger-pakke/{id}")" @onclick:stopPropagation="true">
                                        <span class="dp-figur"><DoorFigur AntallFloyer="@PakkeVisningHjelper.AntallFloyerVerdi(p)" /></span>
                                        <b>@p.Navn</b>
                                    </a>
                                </td>
                                <td class="dp-skjul-m">
                                    @if (steder.Count == 0)
                                    {
                                        <span class="dp-dempet">–</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", steder)
                                    }
                                </td>
                                <td class="dp-skjul-m">
                                    @if (piller.Count == 0)
                                    {
                                        <span class="dp-dempet">Ingen krav</span>
                                    }
                                    else
                                    {
                                        <span class="dp-tagger">
                                            @foreach (var pille in piller)
                                            {
                                                <span class="dp-tag">@pille</span>
                                            }
                                        </span>
                                    }
                                </td>
                                <td class="n dp-skjul-m">@p.Komponenter.Count</td>
                                <td class="n"><b>@Kr(Sum(p))</b></td>
                                <td class="dp-skjul-m dp-dempet">@p.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private List<Package> _alle = [];
    private string _search = "";
    private bool _full;
    private List<RequirementValue> _typeDorVerdier = [];
    private List<string> _bruksomrader = [];
    private int _typeFilter;
    private string _bruksFilter = "";
    private string _sortering = "navn";

    // Bruksområde er fritekst med ett sted per linje (se Rediger pakke).
    private static List<string> Bruksomrader(Package p) =>
        string.IsNullOrWhiteSpace(p.Bruksomrade)
            ? []
            : p.Bruksomrade.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

    private List<Package> _filtrert
    {
        get
        {
            var resultat = _alle.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                resultat = resultat.Where(p =>
                    p.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (p.Beskrivelse?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Bruksomrade?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Krav.Any(k => k.RequirementValue?.Verdi.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Komponenter.Any(k => k.Component is not null && k.Component.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            if (_typeFilter != 0)
            {
                resultat = resultat.Where(p => p.Krav.Any(k => k.RequirementValueId == _typeFilter));
            }

            if (!string.IsNullOrEmpty(_bruksFilter))
            {
                resultat = resultat.Where(p => Bruksomrader(p).Contains(_bruksFilter, StringComparer.OrdinalIgnoreCase));
            }

            resultat = _sortering switch
            {
                "pris" => resultat.OrderByDescending(Sum),
                "nyest" => resultat.OrderByDescending(p => p.OpprettetDato),
                _ => resultat.OrderBy(p => p.Navn, StringComparer.Create(Kultur, true))
            };

            return resultat.ToList();
        }
    }

    private static decimal Sum(Package p) =>
        p.Komponenter.Where(k => (k.LevertAv ?? LevertAv.F) == LevertAv.F).Sum(k => (k.Component?.PrisNetto ?? 0) * k.Antall);

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("dorpakker-bredde", "normal") == "full";

        _alle = await Db.Packages
            .AsNoTracking()
            .Include(p => p.Krav).ThenInclude(k => k.RequirementValue).ThenInclude(v => v!.Dimensjon)
            .Include(p => p.Komponenter).ThenInclude(k => k.Component)
            .AsSplitQuery()
            .ToListAsync();

        _bruksomrader = _alle
            .SelectMany(Bruksomrader)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.Create(Kultur, true))
            .ToList();

        var typeDor = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .FirstOrDefaultAsync(d => d.Navn == "Type dør");
        _typeDorVerdier = typeDor?.Verdier.ToList() ?? [];
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dorpakker-bredde", _full ? "full" : "normal");
    }

    private void NullstillFilter()
    {
        _search = "";
        _typeFilter = 0;
        _bruksFilter = "";
    }
}
