@page "/dorpakker"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Dørpakker</PageTitle>

<h1>Dørpakker</h1>
<p>Oversikt over dørpakker satt sammen for kravvelgeren. Åpne en pakke for å redigere krav og komponenter.</p>

<a class="add-button" href="/ny-pakke">Ny pakke</a>
<button type="button" class="@(_redigerModus ? "edit-button-active" : "filter-button")" @onclick="ToggleRedigerModus">
    @(_redigerModus ? "Ferdig" : "Rediger")
</button>

<input class="search-input" @bind="_search" @bind:event="oninput" placeholder="Søk på navn" />

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen dørpakker funnet.</p>
}
else
{
    <ul class="pakke-list">
        @foreach (var p in _filtrert)
        {
            <li class="pakke-item" @key="p.Id">
                <a class="pakke-row" href="@($"/rediger-pakke/{p.Id}")">
                    <span class="pakke-navn">@p.Navn</span>
                    <span class="pakke-meta">
                        @p.AntallKomponenter komponent@(p.AntallKomponenter == 1 ? "" : "er")
                        @if (!string.IsNullOrWhiteSpace(p.Beskrivelse))
                        {
                            <text> · @p.Beskrivelse</text>
                        }
                    </span>
                </a>
                @if (_redigerModus)
                {
                    @if (_slettId == p.Id)
                    {
                        <span class="pakke-slett-confirm">
                            Slette "@p.Navn"?
                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettPakke(p.Id))">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="pakke-slett-button" title="Slett pakke" @onclick="@(() => _slettId = p.Id)">&times;</button>
                    }
                }
            </li>
        }
    </ul>
}

@code {
    private sealed class PakkeRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Beskrivelse { get; set; }
        public int AntallKomponenter { get; set; }
    }

    private List<PakkeRad> _alle = [];
    private string _search = "";
    private bool _redigerModus;
    private int? _slettId;

    private List<PakkeRad> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _alle
        : _alle.Where(p => p.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _alle = await Db.Packages
            .OrderBy(p => p.Navn)
            .Select(p => new PakkeRad
            {
                Id = p.Id,
                Navn = p.Navn,
                Beskrivelse = p.Beskrivelse,
                AntallKomponenter = p.Komponenter.Count
            })
            .ToListAsync();
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task SlettPakke(int id)
    {
        var eksisterende = await Db.Packages.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            Db.Packages.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        _alle.RemoveAll(p => p.Id == id);
        _slettId = null;
    }
}
