@page "/brukere"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Brukere</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="users" /></span>
        <div>
            <h1>Brukere</h1>
            <p class="section-hint">Alle som skal ha tilgang til portalen legges inn her med e-post og rolle. De setter selv passord første gang via "Sett passord" på innloggingssiden. Kundetilganger opprettes under "Kundetilganger", ikke her.</p>
        </div>
    </div>
</div>

@if (_brukere.Count == 0)
{
    <p class="list-empty">Ingen brukere opprettet ennå.</p>
}
else
{
    <div class="stat-rad">
        <div class="stat-chip"><b>@_brukere.Count</b><span>Totalt</span></div>
        @foreach (var rolle in StabRoller)
        {
            <div class="stat-chip"><b>@_brukere.Count(b => b.Rolle == rolle)</b><span>@rolle.Visningsnavn()</span></div>
        }
    </div>

    <div class="filter-rad">
        <button type="button" class="filter-chip @(_rolleFilter is null ? "aktiv" : "")" @onclick="@(() => _rolleFilter = null)">Alle (@_brukere.Count)</button>
        @foreach (var rolle in StabRoller)
        {
            <button type="button" class="filter-chip @(_rolleFilter == rolle ? "aktiv" : "")" @onclick="@(() => _rolleFilter = rolle)">@rolle.Visningsnavn() (@_brukere.Count(b => b.Rolle == rolle))</button>
        }
    </div>

    <div class="bruker-liste">
        @foreach (var b in Synlige)
        {
            <div @key="b.Id" class="bruker-rad" style="--rolle-farge: @RolleFarge(b.Rolle)">
                <span class="avatar">@Initialer(b.Navn)</span>
                <div class="rad-info">
                    <div>
                        <input class="navn-input" @bind="b.Navn" @bind:event="oninput" />
                        <input class="epost-input" @bind="b.Epost" @bind:event="oninput" />
                    </div>
                    <input class="stilling-input" @bind="b.Stilling" @bind:event="oninput" placeholder="Stilling (valgfritt)" />
                </div>
                <div class="rolle-dot-rad">
                    <span class="rolle-dot"></span>
                    <select class="rolle-select" @bind="b.Rolle">
                        @foreach (var rolle in StabRoller)
                        {
                            <option value="@rolle">@rolle.Visningsnavn()</option>
                        }
                    </select>
                </div>
                <div class="kvote-mini">Ferie <input type="number" min="0" @bind="b.FerieKvote" /></div>
                @if (b.HarPassord)
                {
                    <span class="passord-ikon satt" title="Passord satt"><Icon Name="check-circle" /></span>
                }
                else
                {
                    <span class="passord-ikon ikke-satt" title="Passord ikke satt"><Icon Name="alert" /></span>
                }
                <div class="rad-actions">
                    <button type="button" class="ikon-btn" title="Lagre" @onclick="@(() => Lagre(b))"><Icon Name="check" /></button>
                    @if (b.HarPassord)
                    {
                        <button type="button" class="ikon-btn" title="Nullstill passord" @onclick="@(() => NullstillPassord(b))"><Icon Name="lock" /></button>
                    }
                    <button type="button" class="ikon-btn farlig" title="Slett" @onclick="@(() => SlettBruker(b))"><Icon Name="trash" /></button>
                </div>
            </div>
        }
    </div>
}

<div class="kort new-bruker">
    <h2>Ny bruker</h2>
    <div class="new-bruker-form">
        <input @bind="_nyNavn" @bind:event="oninput" placeholder="Navn" />
        <input @bind="_nyEpost" @bind:event="oninput" placeholder="E-post" />
        <input @bind="_nyStilling" @bind:event="oninput" placeholder="Stilling (valgfritt)" />
        <select @bind="_nyRolle">
            @foreach (var rolle in StabRoller)
            {
                <option value="@rolle">@rolle.Visningsnavn()</option>
            }
        </select>
        <button type="button" class="knapp-primaer" @onclick="OpprettBruker"><Icon Name="plus" />Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }
</div>

@code {
    private static readonly BrukerRolle[] StabRoller = [BrukerRolle.Admin, BrukerRolle.Prosjektleder, BrukerRolle.Montor];

    private sealed class BrukerRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public string? Stilling { get; set; }
        public BrukerRolle Rolle { get; set; }
        public bool HarPassord { get; set; }
        public int FerieKvote { get; set; }
    }

    private List<BrukerRad> _brukere = [];
    private string _nyNavn = "";
    private string _nyEpost = "";
    private string _nyStilling = "";
    private BrukerRolle _nyRolle = BrukerRolle.Montor;
    private string? _melding;
    private string? _feil;
    private BrukerRolle? _rolleFilter;

    private IEnumerable<BrukerRad> Synlige => _rolleFilter is null ? _brukere : _brukere.Where(b => b.Rolle == _rolleFilter);

    private static string RolleFarge(BrukerRolle rolle) => rolle switch
    {
        BrukerRolle.Admin => "#b5502d",
        BrukerRolle.Prosjektleder => "#2054a3",
        _ => "#2b7a4b"
    };

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _brukere = await Db.Brukere
            .Where(b => b.Rolle != BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .Select(b => new BrukerRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                Stilling = b.Stilling,
                Rolle = b.Rolle,
                HarPassord = b.PasswordHash != null,
                FerieKvote = b.FerieKvote
            })
            .ToListAsync();
    }

    private async Task OpprettBruker()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        if (await Db.Brukere.AnyAsync(b => b.Epost.ToLower() == epost.ToLower()))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        Db.Brukere.Add(new Bruker
        {
            Navn = navn,
            Epost = epost,
            Stilling = string.IsNullOrWhiteSpace(_nyStilling) ? null : _nyStilling.Trim(),
            Rolle = _nyRolle
        });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _nyStilling = "";
        _nyRolle = BrukerRolle.Montor;
        _feil = null;
        _melding = $"Brukeren \"{navn}\" er opprettet. De kan nå sette passord via \"Sett passord\" på innloggingssiden.";
        await LoadAsync();
    }

    private async Task Lagre(BrukerRad rad)
    {
        var navn = rad.Navn.Trim();
        var epost = rad.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.Stilling = string.IsNullOrWhiteSpace(rad.Stilling) ? null : rad.Stilling.Trim();
        bruker.Rolle = rad.Rolle;
        bruker.FerieKvote = Math.Max(0, rad.FerieKvote);
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
    }

    private async Task NullstillPassord(BrukerRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{rad.Navn}\". De kan sette nytt via \"Sett passord\" på innloggingssiden.";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettBruker(BrukerRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);

        try
        {
            await Db.SaveChangesAsync();
            _melding = $"\"{rad.Navn}\" er slettet.";
            _feil = null;
            await LoadAsync();
        }
        catch (DbUpdateException)
        {
            Db.Entry(bruker).State = EntityState.Unchanged;
            _feil = $"\"{rad.Navn}\" har registrerte timer eller arbeidsordre og kan ikke slettes.";
        }
    }
}
