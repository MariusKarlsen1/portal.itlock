@page "/brukere"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PlatformDbContext PlatformDb
@inject ITenantContext TenantCtx
@inject TenantOppslagService Oppslag

@inject VisningPreferanseService VisningPref

<PageTitle>Brukere</PageTitle>

@* BR1 (brukere-kort-forslag.html): rollene i en meny inni kortet, brukerne til
   høyre med redigering rett i lista som før, og «Ny bruker» og lisensene nederst
   i menyen. Kortet fyller vinduet og ruller inni seg. *@
<div class="br @(_full ? "br-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="users" /></span>
            <div>
                <h1>Brukere</h1>
                <p class="section-hint">Alle som skal ha tilgang til portalen. De setter selv passord første gang via "Sett passord" på innloggingssiden. Kundetilganger opprettes under "Kundetilganger".</p>
            </div>
        </div>
    </div>

    <div class="br-kort">
        <nav class="br-meny">
            <span class="br-gt">Vis</span>
            <div class="br-rolleliste">
                <button type="button" class="@(_rolleFilter is null ? "pa" : "")" @onclick="@(() => VelgRolle(null))">
                    <span>Alle brukere</span><small>@_brukere.Count</small>
                </button>
                @foreach (var rolle in StabRoller)
                {
                    var r = rolle;
                    <button type="button" class="@(_rolleFilter == r ? "pa" : "")" @onclick="@(() => VelgRolle(r))">
                        <span class="avatar-prikk avatar-@RolleKlasse(r)"></span>
                        <span>@RolleFlertall(r)</span><small>@_brukere.Count(b => b.Rolle == r)</small>
                    </button>
                }
            </div>
            <div class="br-meny-bunn">
                @if (_lisensTildelt > 0)
                {
                    <div class="lisens @(_lisensBrukt >= _lisensTildelt ? "lisens-full" : "")">
                        <span><b>@_lisensBrukt av @_lisensTildelt</b> lisenser – @(Math.Max(0, _lisensTildelt - _lisensBrukt)) ledige</span>
                        <span class="lisens-bar"><i style="width:@(Math.Min(100, _lisensBrukt * 100 / _lisensTildelt))%"></i></span>
                        @if (_lisensBrukt >= _lisensTildelt)
                        {
                            <small>Dere har nådd grensen – ta kontakt med Itlock for å få aktivert flere.</small>
                        }
                    </div>
                }
                <button type="button" class="knapp-primaer opprett" @onclick="VisNyBruker"><Icon Name="plus" />Ny bruker</button>
            </div>
        </nav>

        <section class="br-innhold">
            <div class="br-verktoy">
                <label class="bruker-sok">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk …" aria-label="Søk i brukere" @bind="_sok" @bind:event="oninput" />
                </label>
                <button type="button" class="br-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_melding))
            {
                <p class="save-success br-melding">@_melding</p>
            }
            @if (!string.IsNullOrEmpty(_feil) && !_visNy)
            {
                <p class="form-error br-melding">@_feil</p>
            }

            <div class="br-rull">
                @if (_visNy)
                {
                    <div class="br-ny">
                        <b>Ny bruker</b>
                        <div class="br-ny-felt">
                            <label class="felt">
                                <span>Navn</span>
                                <input @bind="_nyNavn" @bind:event="oninput" placeholder="Fornavn Etternavn" />
                            </label>
                            <label class="felt">
                                <span>E-post</span>
                                <input @bind="_nyEpost" @bind:event="oninput" placeholder="navn@firma.no" />
                            </label>
                            <label class="felt">
                                <span>Stilling (valgfritt)</span>
                                <input @bind="_nyStilling" @bind:event="oninput" placeholder="F.eks. Låssmed" />
                            </label>
                            <label class="felt">
                                <span>Rolle</span>
                                <select @bind="_nyRolle">
                                    @foreach (var rolle in StabRoller)
                                    {
                                        <option value="@rolle">@rolle.Visningsnavn()</option>
                                    }
                                </select>
                            </label>
                        </div>
                        @if (!string.IsNullOrEmpty(_feil))
                        {
                            <p class="form-error">@_feil</p>
                        }
                        <div class="rediger-knapper">
                            <button type="button" class="knapp-sekundaer" @onclick="@(() => { _visNy = false; _feil = null; })">Avbryt</button>
                            <button type="button" class="knapp-primaer" @onclick="OpprettBruker"><Icon Name="plus" />Opprett bruker</button>
                        </div>
                    </div>
                }

                <div class="bruker-liste">
                    @if (_brukere.Count == 0)
                    {
                        <p class="list-empty">Ingen brukere opprettet ennå.</p>
                    }
                    else if (!Synlige.Any())
                    {
                        <p class="list-empty">Ingen brukere passer søket.</p>
                    }
                    @foreach (var b in Synlige)
                    {
                        var apen = _apenId == b.Id;
                        <div @key="b.Id" class="bruker-rad @(apen ? "apen" : "")">
                            <button type="button" class="bruker-rad-topp" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VelgRad(b))">
                                <span class="avatar avatar-@RolleKlasse(b.Rolle)">@Initialer(b.Navn)</span>
                                <span class="rad-info">
                                    <b>@b.Navn</b>
                                    @if (b.HarPassord)
                                    {
                                        <small>@(string.IsNullOrWhiteSpace(b.Stilling) ? b.Epost : $"{b.Stilling} · {b.Epost}")</small>
                                    }
                                    else
                                    {
                                        <small><span class="venter">Venter på passord</span></small>
                                    }
                                </span>
                                <span class="rolle-merke rolle-@RolleKlasse(b.Rolle)">@b.Rolle.Visningsnavn()</span>
                                <span class="mer-knapp" title="@(apen ? "Lukk" : "Rediger")"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                            </button>

                            @if (apen)
                            {
                                <div class="rediger">
                                    <label class="felt">
                                        <span>Navn</span>
                                        <input @bind="b.Navn" @bind:event="oninput" />
                                    </label>
                                    <label class="felt">
                                        <span>E-post</span>
                                        <input @bind="b.Epost" @bind:event="oninput" />
                                    </label>
                                    <label class="felt">
                                        <span>Stilling</span>
                                        <input @bind="b.Stilling" @bind:event="oninput" placeholder="Valgfritt" />
                                    </label>
                                    <label class="felt">
                                        <span>Rolle</span>
                                        <select @bind="b.Rolle">
                                            @foreach (var rolle in StabRoller)
                                            {
                                                <option value="@rolle">@rolle.Visningsnavn()</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="felt">
                                        <span>Feriedager per år</span>
                                        <input type="number" min="0" @bind="b.FerieKvote" />
                                    </label>
                                    <div class="rediger-bunn">
                                        <span class="rediger-lenker">
                                            @if (b.HarPassord)
                                            {
                                                <button type="button" class="lenke-knapp" @onclick="@(() => NullstillPassord(b))"><Icon Name="lock" />Nullstill passord</button>
                                            }
                                            <button type="button" class="lenke-knapp farlig" @onclick="@(() => SlettBruker(b))"><Icon Name="trash" />Slett bruker</button>
                                        </span>
                                        <span class="rediger-knapper">
                                            <button type="button" class="knapp-sekundaer" @onclick="Avbryt">Avbryt</button>
                                            <button type="button" class="knapp-primaer" @onclick="@(() => Lagre(b))"><Icon Name="check" />Lagre</button>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="br-bunn">@Synlige.Count() @(Synlige.Count() == 1 ? "bruker" : "brukere")@(_rolleFilter is not null || !string.IsNullOrWhiteSpace(_sok) ? $" av {_brukere.Count}" : "")</div>
        </section>
    </div>
</div>

@code {
    private static readonly BrukerRolle[] StabRoller = [BrukerRolle.Admin, BrukerRolle.Prosjektleder, BrukerRolle.Montor];

    private sealed class BrukerRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public string? Stilling { get; set; }
        public BrukerRolle Rolle { get; set; }
        public bool HarPassord { get; set; }
        public int FerieKvote { get; set; }
    }

    private List<BrukerRad> _brukere = [];
    private string _nyNavn = "";
    private string _nyEpost = "";
    private string _nyStilling = "";
    private BrukerRolle _nyRolle = BrukerRolle.Montor;
    private string? _melding;
    private string? _feil;
    private string _sok = "";
    private int? _apenId;
    private int _lisensTildelt;
    private int _lisensBrukt;

    private BrukerRolle? _rolleFilter;
    private bool _visNy;
    private bool _full;

    private IEnumerable<BrukerRad> Synlige => (_rolleFilter is null ? _brukere : _brukere.Where(b => b.Rolle == _rolleFilter)) is var liste && string.IsNullOrWhiteSpace(_sok)
        ? liste
        : liste.Where(b => b.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
                           || b.Epost.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
                           || (b.Stilling?.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private static string RolleFlertall(BrukerRolle rolle) => rolle switch
    {
        BrukerRolle.Admin => "Admin",
        BrukerRolle.Prosjektleder => "Prosjektledere",
        BrukerRolle.Montor => "Montører",
        _ => rolle.Visningsnavn()
    };

    private async Task VelgRolle(BrukerRolle? rolle)
    {
        if (_apenId is not null)
        {
            await Avbryt();
        }

        _rolleFilter = rolle;
    }

    private void VisNyBruker()
    {
        _visNy = true;
        _feil = null;
        _melding = null;
        _nyRolle = _rolleFilter ?? BrukerRolle.Montor;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("brukere-bredde", _full ? "full" : "normal");
    }

    private static string RolleKlasse(BrukerRolle rolle) => rolle switch
    {
        BrukerRolle.Admin => "admin",
        BrukerRolle.Prosjektleder => "pl",
        _ => "montor"
    };

    // Klikk på en rad åpner redigering; klikk igjen (eller Avbryt) lukker og
    // henter de lagrede verdiene på nytt, så ulagrede endringer forkastes.
    private async Task VelgRad(BrukerRad rad)
    {
        if (_apenId == rad.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await LoadAsync();
        }

        _apenId = rad.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await LoadAsync();
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("brukere-bredde", "normal") == "full";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _brukere = await Db.Brukere
            .Where(b => b.Rolle != BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .Select(b => new BrukerRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                Stilling = b.Stilling,
                Rolle = b.Rolle,
                HarPassord = b.PasswordHash != null,
                FerieKvote = b.FerieKvote
            })
            .ToListAsync();

        _lisensBrukt = _brukere.Count;
        var tenantId = TenantCtx.Current?.Id;
        _lisensTildelt = tenantId is null
            ? 0
            : await PlatformDb.TenantLisenser
                .Where(l => l.TenantId == tenantId && l.Type == LisensType.Brukere)
                .Select(l => l.AntallTildelt)
                .FirstOrDefaultAsync();
    }

    private async Task OpprettBruker()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        if (await Oppslag.FinnTenantForEpostAsync(epost) is not null)
        {
            _feil = "Denne e-posten er allerede registrert hos en annen organisasjon.";
            return;
        }

        if (_lisensTildelt > 0 && _lisensBrukt >= _lisensTildelt)
        {
            _feil = $"Dere har brukt opp alle {_lisensTildelt} brukerlisensene deres. Ta kontakt med Itlock for å få aktivert flere før dere kan opprette nye brukere.";
            return;
        }

        Db.Brukere.Add(new Bruker
        {
            Navn = navn,
            Epost = epost,
            Stilling = string.IsNullOrWhiteSpace(_nyStilling) ? null : _nyStilling.Trim(),
            Rolle = _nyRolle
        });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _visNy = false;
        _nyEpost = "";
        _nyStilling = "";
        _nyRolle = BrukerRolle.Montor;
        _feil = null;
        _melding = $"Brukeren \"{navn}\" er opprettet. De kan nå sette passord via \"Sett passord\" på innloggingssiden.";
        await LoadAsync();
    }

    private async Task Lagre(BrukerRad rad)
    {
        var navn = rad.Navn.Trim();
        var epost = rad.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.Stilling = string.IsNullOrWhiteSpace(rad.Stilling) ? null : rad.Stilling.Trim();
        bruker.Rolle = rad.Rolle;
        bruker.FerieKvote = Math.Max(0, rad.FerieKvote);
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
        _apenId = null;
        await LoadAsync();
    }

    private async Task NullstillPassord(BrukerRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{rad.Navn}\". De kan sette nytt via \"Sett passord\" på innloggingssiden.";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettBruker(BrukerRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);

        try
        {
            await Db.SaveChangesAsync();
            _melding = $"\"{rad.Navn}\" er slettet.";
            _feil = null;
            _apenId = null;
            await LoadAsync();
        }
        catch (DbUpdateException)
        {
            Db.Entry(bruker).State = EntityState.Unchanged;
            _feil = $"\"{rad.Navn}\" har registrerte timer eller arbeidsordre og kan ikke slettes.";
        }
    }
}
