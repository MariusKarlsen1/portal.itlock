@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject ProtectedLocalStorage LokalLagring
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VaerService VaerSvc
@inject PortalItlock.Web.Services.ITenantContext TenantCtx
@inject PortalItlock.Web.Services.GeocodingService Geokoding
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Hjem</PageTitle>

@* Layout 3 på forsiden (HjemLayout.Fjord, vises fra Home.razor). Banner med bilde og hilsen,
   Hurtigvalg, Mine moduler, Mine oppgaver, Kunngjøringer, "Forespørsler, drift
   og ferdigmeldt" og Snarveier. Bygger på fullkontroll-hjem-mine-data.html.
   Brukeren velger layout i Tilpass meny (TopBar). *@
<div class="fh-side">
    <div class="fh-banner">

        @* Topplinje oppå bildet: søk, moduler, varsler og brukeren. *@
        <div class="fh-topp">
            <div class="fh-sok" @onclick:stopPropagation="true">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" @onkeydown="SokTast" placeholder="Søk etter prosjekter, kunder, dokumenter, moduler eller annet…" />
                <kbd>Ctrl + K</kbd>
                @if (SokTreff.Count > 0)
                {
                    <div class="fh-sok-treff">
                        @foreach (var l in SokTreff)
                        {
                            <a href="@($"/{l.Href}?fra=hjem")"><span class="fh-ikb fh-ikb-s"><Icon Name="@l.IconNavn" /></span><span><b>@l.Tittel</b><small>@l.Beskrivelse</small></span></a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="fh-hilsen">
            <small>VELKOMMEN TIL FULL KONTROLL</small>
            <h1>@Hilsen</h1>
            <p>Her finner du alt du trenger i din arbeidshverdag – samlet på ett sted.</p>
        </div>

        @* Dato, stedet organisasjonen holder til og været der nå (MET / yr). *@
        <div class="fh-vaer">
            <span class="fh-vaer-dato">@IdagMedAr</span>
            <span class="fh-vaer-sted">@Sted</span>
            @if (_vaer is { } v)
            {
                <div class="fh-vaer-rad">
                    @((MarkupString)VaerIkon(v.Ikon))
                    <span><b>@v.Temperatur °C</b><em>@v.Beskrivelse</em></span>
                </div>
            }
        </div>
    </div>

    <div class="fh-innhold">
        @* Hurtigvalg *@
        <section class="fh-kort fh-hurtigkort">
            <div class="fh-kh">
                <h2><Icon Name="trend-up" />Hurtigvalg</h2>
                <button type="button" class="fh-tilpass" @onclick="@(() => _tilpasser = !_tilpasser)"><Icon Name="settings" />@(_tilpasser ? "Ferdig" : "Tilpass hurtigvalg")</button>
            </div>
            @if (_tilpasser)
            {
                <p class="fh-tom" style="margin-bottom:10px">Trykk på stjernen for å legge til eller fjerne hurtigvalg. De første åtte vises på forsiden.</p>
                <div class="fh-tilpassgrid">
                    @foreach (var lenke in BladLenker.GroupBy(l => l.Href).Select(g => g.First()))
                    {
                        var valgt = _hurtigvalg.Contains(lenke.Href);
                        <button type="button" class="fh-tilpassvalg @(valgt ? "valgt" : "")" @onclick="@(() => VekslHurtigvalg(lenke.Href))">
                            <span class="fh-stjerne">@(valgt ? "★" : "☆")</span>
                            <span class="fh-ikb fh-ikb-s"><Icon Name="@lenke.IconNavn" /></span>
                            <span>@lenke.Tittel</span>
                        </button>
                    }
                </div>
            }
            else if (!_hurtigvalgLastet)
            {
                <div class="fh-hurtig">
                    @for (var i = 0; i < 8; i++)
                    {
                        <span class="fh-flis fh-flis-tom"></span>
                    }
                </div>
            }
            else if (Hurtigvalg.Count == 0)
            {
                <p class="fh-tom">Ingen hurtigvalg valgt ennå – trykk «Tilpass hurtigvalg» for å legge til moduler her.</p>
            }
            else
            {
                <div class="fh-hurtig">
                    @foreach (var (lenke, i) in Hurtigvalg.Take(8).Select((l, i) => (l, i)))
                    {
                        var (bg, ikbg) = Toner[i % Toner.Length];
                        var teller = TellerFor(lenke.Href);
                        <a class="fh-flis" href="@($"/{lenke.Href}?fra=hjem")" style="background:@bg">
                            <span class="fh-ikb" style="background:@ikbg"><Icon Name="@lenke.IconNavn" /></span>
                            @if (teller > 0)
                            {
                                <i class="fh-teller">@teller</i>
                            }
                            <span>@lenke.Tittel</span>
                        </a>
                    }
                </div>
            }
        </section>

        @* Ett rutenett: moduler | oppgaver | kart øverst, forespørsler +
           snarveier | kunngjøringer | (kart) under. Kartet spenner over begge
           radene; på smalere skjermer flytter det ned under resten (se CSS). *@
        <div class="fh-rutenett">
                @* Mine moduler *@
                <section class="fh-kort fh-a-mod" id="fh-moduler">
                    <div class="fh-kh">
                        <h2><Icon Name="box" />Mine moduler</h2>
                    </div>
                    @* Samme kategorier som "Alle moduler" i Layout 2 - hvilke som
                       vises styres av tilgangen (PortalModulRegister.KategorierFor). *@
                    <div class="fh-moduler fh-kategorier">
                        @foreach (var k in Kategorier)
                        {
                            var teller = TellerForKategori(k);
                            <button type="button" class="fh-modul fh-kategori" @onclick="@(() => VelgKategori(k.Nokkel))">
                                <span class="fh-ikb fh-ikb-teller">
                                    <Icon Name="@IkonForKategori(k.Nokkel)" />
                                    @if (teller > 0)
                                    {
                                        <i class="fh-teller">@teller</i>
                                    }
                                </span>
                                <span class="fh-modul-tekst">
                                    <b>@k.Tittel</b>
                                    <small>@k.Beskrivelse</small>
                                </span>
                                <span class="fh-pil">›</span>
                            </button>
                        }
                    </div>
                </section>

                <div class="fh-to fh-a-bunn">
                    @* Forespørsler, drift og ferdigmeldt *@
                    <section class="fh-kort">
                        <div class="fh-kh">
                            <h2 class="fh-h2-liten"><Icon Name="mail" />Forespørsler, drift og ferdigmeldt</h2>
                            <a class="fh-lenke fh-lenke-bla" href="/foresporsler">Se alle →</a>
                        </div>
                        @if (_hendelser.Count == 0)
                        {
                            <p class="fh-tom">Ingen nye forespørsler, driftsmeldinger eller ferdigmeldte jobber.</p>
                        }
                        else
                        {
                            <div class="fh-liste">
                                @foreach (var h in _hendelser.Take(3))
                                {
                                    <a class="fh-hendelse" href="@h.Href">
                                        <span class="fh-ikb fh-ikb-s" style="background:@h.Bakgrunn;color:@h.Farge"><Icon Name="@h.Ikon" /></span>
                                        <span class="fh-hendelse-tekst">
                                            <b>@h.Tittel</b>
                                            <small>@h.Undertekst · @h.Tid</small>
                                        </span>
                                        <span class="fh-merke" style="background:@h.Bakgrunn;color:@h.Farge">@h.Merke</span>
                                    </a>
                                }
                            </div>
                        }
                    </section>

                    @* Snarveier *@
                    <section class="fh-kort">
                        <div class="fh-kh">
                            <h2><Icon Name="trend-up" />Snarveier til viktige ressurser</h2>
                        </div>
                        <div class="fh-snarveier">
                            @foreach (var (navn, url, logo) in Snarveier)
                            {
                                <a class="fh-snarvei" href="@url" target="_blank" rel="noopener">
                                    <span class="fh-ikb fh-ikb-s fh-logo"><img src="@($"/img/snarveier/{logo}")" alt="" /></span>
                                    <span>@navn</span>
                                </a>
                            }
                        </div>
                    </section>
                </div>

                @* Mine oppgaver *@
                <section class="fh-kort fh-a-opp">
                    <div class="fh-kh">
                        <h2><span class="fh-sjekkboks"><Icon Name="check-circle" /></span>Mine oppgaver</h2>
                        <a class="fh-lenke fh-lenke-bla" href="/todo">Se alle →</a>
                    </div>
                    @if (_oppgaver.Count == 0)
                    {
                        <p class="fh-tom">Ingen åpne oppgaver. Legg til i <a href="/todo">To-do liste</a>.</p>
                    }
                    else
                    {
                        <div class="fh-oppgaver">
                            @foreach (var o in _oppgaver)
                            {
                                <a class="fh-oppgave" href="/todo">
                                    <span class="fh-sirkel"></span>
                                    <span class="fh-oppgave-tekst">@o.Tittel</span>
                                    @if (o.Frist is { } frist)
                                    {
                                        <span class="fh-frist @(frist.Date <= DateTime.Today ? "fh-frist-rod" : "")">@FristTekst(frist)</span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </section>

                @* Kunngjøringer *@
                <section class="fh-kort fh-a-kun">
                    <div class="fh-kh">
                        <h2><Icon Name="bell" />Kunngjøringer</h2>
                        <a class="fh-lenke fh-lenke-bla" href="/kunngjoringer">Se alle →</a>
                    </div>
                    @if (_kunngjoringer.Count == 0)
                    {
                        <p class="fh-tom">Ingen kunngjøringer ennå.</p>
                    }
                    else
                    {
                        <div class="fh-nyheter">
                            @foreach (var k in _kunngjoringer)
                            {
                                <a class="fh-nyhet" href="@($"/kunngjoring/{k.Id}")">
                                    @if (k.HarBilde)
                                    {
                                        <img src="@($"/kunngjoringbilde/{k.Id}")" alt="" />
                                    }
                                    else
                                    {
                                        <span class="fh-nyhet-bilde"><Icon Name="bell" /></span>
                                    }
                                    <span>
                                        <b>@k.Tittel</b>
                                        <small>@k.Dato.ToString("d. MMM yyyy", Kultur)</small>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </section>

                @* Kartet - samme punkter og flater som i Layout 2. *@
                <section class="fh-kort fh-a-kart">
                    <div class="fh-kh">
                        <h2><Icon Name="map" />Aktivitet på kart</h2>
                        <span class="fh-kartflater">
                            <button type="button" class="@(_kartFlate == "kart" ? "aktiv" : "")" @onclick="@(() => ByttKartflate("kart"))">Kart</button>
                            <button type="button" class="@(_kartFlate == "satellitt" ? "aktiv" : "")" @onclick="@(() => ByttKartflate("satellitt"))">Satellitt</button>
                        </span>
                    </div>
                    <div class="fh-kartramme"><div id="fh-kart" class="fh-kart"></div></div>
                    <div class="fh-kartlegende">
                        <span><i style="background:#9A4E24"></i>Service</span>
                        <span><i style="background:#0b66e6"></i>Prosjekt</span>
                        <span><i style="background:#0c9c5c"></i>Arbeidsordre</span>
                    </div>
                </section>
        </div>
    </div>
</div>

@* Modulvinduet - samme innhold og lenker som i Layout 2, så "tilbake" fra en
   modul (?fra=hjem&rolle=...&hub=...) åpner det samme vinduet igjen. *@
@if (_valgtKategori is not null && Kategorier.FirstOrDefault(k => k.Nokkel == _valgtKategori) is { } valgtKat)
{
    var hub = _valgtHub;
    var harHubber = hub is null && valgtKat.Grupper.SelectMany(g => g.Lenker).Any(l => l.Undermoduler is { Count: > 0 });

    <div class="fh-modal-bakteppe" @onclick="LukkKategori">
        <div class="fh-modal @(harHubber ? "fh-modal-bred" : "")" @onclick:stopPropagation="true">
            <div class="fh-modal-topp">
                @if (hub is not null)
                {
                    <button type="button" class="fh-modal-rund" @onclick="@(() => _valgtHub = null)" aria-label="Tilbake"><Icon Name="arrow-left" /></button>
                    <span class="fh-ikb"><Icon Name="@hub.IconNavn" /></span>
                    <span class="fh-modal-tittel"><b>@hub.Tittel</b><small>@hub.Beskrivelse</small></span>
                }
                else
                {
                    <span class="fh-ikb"><Icon Name="@IkonForKategori(valgtKat.Nokkel)" /></span>
                    <span class="fh-modal-tittel"><b>@valgtKat.Tittel</b><small>@valgtKat.Beskrivelse</small></span>
                }
                <button type="button" class="fh-modal-rund" @onclick="LukkKategori" aria-label="Lukk"><Icon Name="x" /></button>
            </div>
            <div class="fh-modal-innhold">
                @if (hub is not null)
                {
                    <div class="fh-modal-lenker">
                        @foreach (var l in hub.Undermoduler ?? [])
                        {
                            @ModalLenke(l, $"{l.Href}?fra=hjem&rolle={valgtKat.Nokkel}&hub={hub.Href}")
                        }
                    </div>
                }
                else
                {
                    @foreach (var gruppe in valgtKat.Grupper)
                    {
                        var vanlige = gruppe.Lenker.Where(l => l.Undermoduler is null or { Count: 0 }).ToList();
                        var hubber = gruppe.Lenker.Where(l => l.Undermoduler is { Count: > 0 }).ToList();

                        @if (vanlige.Count > 0)
                        {
                            <h3 class="fh-modal-gruppe">@gruppe.Navn</h3>
                            <div class="fh-modal-lenker">
                                @foreach (var l in vanlige)
                                {
                                    @ModalLenke(l, $"{l.Href}?fra=hjem&rolle={valgtKat.Nokkel}")
                                }
                            </div>
                        }

                        @foreach (var h in hubber)
                        {
                            <h3 class="fh-modal-gruppe"><Icon Name="@h.IconNavn" />@h.Tittel</h3>
                            <div class="fh-modal-lenker">
                                @foreach (var l in h.Undermoduler!)
                                {
                                    @ModalLenke(l, $"{l.Href}?fra=hjem&rolle={valgtKat.Nokkel}&hub={h.Href}")
                                }
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed record Hendelse(string Href, string Tittel, string Undertekst, string Ikon, string Farge, string Bakgrunn, string Merke, string Tid, DateTime Sortering);
    private sealed record OppgaveRad(string Tittel, DateTime? Frist);
    private sealed record KunngjoringRad(int Id, string Tittel, DateTime Dato, bool HarBilde);

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    // Lyse toner til hurtigvalgene (flis, ikonfirkant) - som i forslaget.
    private static readonly (string, string)[] Toner =
    [
        ("#fbf6ef", "#efe2d2"), ("#f7f7f1", "#e5eadc"), ("#fbf3f1", "#efdcd6"), ("#fbf6ef", "#f0e1cf"),
        ("#fcf2f1", "#f3d9d6"), ("#fdf7ec", "#f4e5c6"), ("#f6f6f3", "#e6e4dd"), ("#f8f7f4", "#e8e5df")
    ];


    // Eksterne snarveier (åpnes i ny fane), med leverandørens egen logo fra
    // wwwroot/img/snarveier. Lenkene går til de faste innloggingssidene.
    private static readonly (string Navn, string Url, string Logo)[] Snarveier =
    [
        ("Tripletex", "https://tripletex.no/execute/login", "tripletex.png"),
        ("dormakaba", "https://portal-dormakaba.onelogin.com/", "dormakaba.png"),
        ("Steplock", "https://steplock.com/NO/no/login", "steplock.ico"),
        ("ASSA ABLOY", "https://www.assaabloy.com/no", "assaabloy.png"),
        ("iLOQ", "https://partners.iloq.com/login", "iloq.png"),
        ("SALTO", "https://partners.saltowecosystem.com/English/", "salto.png"),
        ("Larry", "https://commissioning.saltoks.com/", "larry.webp"),
        ("Carl Ras", "https://www.carl-ras.dk/", "carlras.png")
    ];

    private const string HurtigvalgNokkel = "itlock-hurtigvalg";
    private static readonly string[] StandardHurtigvalg =
        ["kalender", "arbeidsordre", "prosjekter", "kunder", "guide/kobling", "dormiljo", "timeregistrering"];

    private BrukerRolle? _rolle;
    private Bruker? _bruker;
    private string _sok = "";
    private bool _tilpasser;

    // Stjernemerking av hurtigvalg - lagres i nettleseren, samme nøkkel som Layout 2.
    private async Task VekslHurtigvalg(string href)
    {
        if (!_hurtigvalg.Remove(href))
        {
            _hurtigvalg.Add(href);
        }

        try
        {
            await LokalLagring.SetAsync(HurtigvalgNokkel, _hurtigvalg);
        }
        catch (Exception)
        {
            // Nettleserlagring kan være avslått - valget gjelder da bare denne økten.
        }
    }
    private PortalItlock.Web.Services.VaerService.Vaer? _vaer;

    // Stedet organisasjonen holder til (fra organisasjonsoppsettet), ellers Oslo.
    private string Sted => string.IsNullOrWhiteSpace(TenantCtx.Current?.Sted)
        ? "Oslo"
        : System.Globalization.CultureInfo.GetCultureInfo("nb-NO").TextInfo.ToTitleCase(TenantCtx.Current!.Sted!.Trim().ToLowerInvariant());

    private static string IdagMedAr
    {
        get
        {
            var tekst = DateTime.Today.ToString("dddd d. MMMM yyyy", Kultur);
            return char.ToUpper(tekst[0], Kultur) + tekst[1..];
        }
    }

    // Værikonene i samme stil som forslaget (sol, sol og sky, sky, regn, snø, torden).
    private static string VaerIkon(string ikon)
    {
        const string sky = "<path d=\"M14 44h26a9 9 0 0 0 0-18 12 12 0 0 0-22.5 3A8 8 0 0 0 14 44z\" fill=\"#fff\" stroke=\"#4a8ad6\" stroke-width=\"2.4\" stroke-linejoin=\"round\"/>";
        const string sol = "<g stroke=\"#f2b33a\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M36 4v4M48 9l-3 3M52 20h-4M24 9l3 3\"/></g><circle cx=\"36\" cy=\"20\" r=\"7.5\" fill=\"#f6c143\"/>";
        var innhold = ikon switch
        {
            "sol" => "<g stroke=\"#f2b33a\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M28 4v6M28 46v6M4 28h6M46 28h6M11 11l4 4M41 41l4 4M11 45l4-4M41 15l4-4\"/></g><circle cx=\"28\" cy=\"28\" r=\"11\" fill=\"#f6c143\"/>",
            "sky" => sky,
            "regn" => sky + "<g stroke=\"#4a8ad6\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M20 48l-2 5M28 48l-2 5M36 48l-2 5\"/></g>",
            "sno" => sky + "<g fill=\"#4a8ad6\"><circle cx=\"20\" cy=\"51\" r=\"1.8\"/><circle cx=\"28\" cy=\"53\" r=\"1.8\"/><circle cx=\"36\" cy=\"51\" r=\"1.8\"/></g>",
            "torden" => sky + "<path d=\"M28 44l-4 7h5l-3 6 8-9h-5l3-4z\" fill=\"#f2b33a\"/>",
            _ => sol + sky
        };
        return $"<svg width=\"58\" height=\"52\" viewBox=\"0 0 56 56\">{innhold}</svg>";
    }

    // Søk i modulene brukeren har tilgang til.
    private List<Lenke> SokTreff => string.IsNullOrWhiteSpace(_sok)
        ? []
        : BladLenker.GroupBy(l => l.Href).Select(g => g.First())
            .Where(l => l.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase) || l.Beskrivelse.Contains(_sok, StringComparison.OrdinalIgnoreCase))
            .Take(6)
            .ToList();

    private void SokTast(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && SokTreff.FirstOrDefault() is { } forste)
        {
            Nav.NavigateTo($"/{forste.Href}?fra=hjem");
        }
        else if (e.Key == "Escape")
        {
            _sok = "";
        }
    }
    private List<string> _hurtigvalg = [];
    private bool _hurtigvalgLastet;
    private int _dagensJobber;
    private int _klarTilFakturering;
    private int _nyeForesporsler;
    private int _timerVenter;
    private int _apneTickets;
    private int _serviceVarsel;
    private List<Hendelse> _hendelser = [];
    private List<OppgaveRad> _oppgaver = [];
    private List<KunngjoringRad> _kunngjoringer = [];

    private List<Lenke> BladLenker => PortalModulRegister.BladLenkerFor(_rolle);

    private List<Lenke> Hurtigvalg => _hurtigvalg
        .Select(href => BladLenker.FirstOrDefault(l => l.Href == href))
        .Where(l => l is not null)
        .Select(l => l!)
        .ToList();

    // "Mine moduler": kategoriene brukeren har tilgang til (6 for admin), som i Layout 2.
    private List<Rolle> Kategorier => PortalModulRegister.KategorierFor(_rolle);

    private string? _valgtKategori;
    private Lenke? _valgtHub;

    private void VelgKategori(string nokkel)
    {
        _valgtKategori = nokkel;
        _valgtHub = null;
    }

    private void LukkKategori()
    {
        _valgtKategori = null;
        _valgtHub = null;
    }

    // Tilbakepilen fra en modul sender brukeren til "/?fra=hjem&rolle=...&hub=...";
    // da åpnes samme vindu igjen, akkurat som i Layout 2.
    private void GjenopprettKategoriFraUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("rolle", out var rolleParam) || Kategorier.FirstOrDefault(k => k.Nokkel == rolleParam) is not { } kategori)
        {
            return;
        }

        _valgtKategori = kategori.Nokkel;
        if (query.TryGetValue("hub", out var hubParam))
        {
            _valgtHub = kategori.Grupper
                .SelectMany(g => g.Lenker)
                .FirstOrDefault(l => l.Undermoduler is not null && l.Href == hubParam);
        }
    }

    private static string IkonForKategori(string nokkel) => nokkel switch
    {
        "prosjekt" => "folder",
        "montorverktoy" => "tool",
        "teknisk" => "trend-up",
        "personell" => "users",
        "driftkunde" => "clock",
        "administrasjon" => "settings",
        _ => "box",
    };

    // Summen av det som venter i modulene i kategorien.
    private int TellerForKategori(Rolle k) => k.Grupper
        .SelectMany(g => g.Lenker)
        .SelectMany(l => new[] { l }.Concat(l.Undermoduler ?? []))
        .Select(l => l.Href)
        .Distinct()
        .Sum(TellerFor);

    private RenderFragment ModalLenke(Lenke l, string href) =>
        @<a class="fh-modal-lenke" href="@href">
            <span class="fh-ikb"><Icon Name="@l.IconNavn" /></span>
            <span class="fh-modul-tekst"><b>@l.Tittel</b><small>@l.Beskrivelse</small></span>
            <span class="fh-pil">›</span>
        </a>;

    private string Hilsen
    {
        get
        {
            var fornavn = _bruker?.Navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
            var time = DateTime.Now.Hour;
            var hilsen = time is >= 5 and < 10 ? "God morgen" : time is >= 10 and < 17 ? "God dag" : "God kveld";
            return string.IsNullOrWhiteSpace(fornavn) ? $"{hilsen}!" : $"{hilsen}, {fornavn}!";
        }
    }

    // Én setning om det viktigste i dag.
    private string HilsenSetning
    {
        get
        {
            var deler = new List<string>();
            deler.Add(_dagensJobber == 0 ? "ingen jobber planlagt i dag" : $"<b>{_dagensJobber} {(_dagensJobber == 1 ? "jobb" : "jobber")} i dag</b>");
            if (_klarTilFakturering > 0)
            {
                deler.Add($"<b>{_klarTilFakturering} {(_klarTilFakturering == 1 ? "ordre" : "ordrer")}</b> klare til fakturering");
            }

            if (_nyeForesporsler > 0)
            {
                deler.Add($"<b>{_nyeForesporsler} {(_nyeForesporsler == 1 ? "ny forespørsel" : "nye forespørsler")}</b>");
            }

            var tekst = deler.Count == 1 ? deler[0] : string.Join(", ", deler.Take(deler.Count - 1)) + " og " + deler[^1];
            return "Du har " + tekst + ".";
        }
    }

    private static string Idag
    {
        get
        {
            var tekst = DateTime.Today.ToString("dddd d. MMMM", Kultur);
            return char.ToUpper(tekst[0], Kultur) + tekst[1..];
        }
    }

    // Tall som vises på flis/modul når noe venter.
    private int TellerFor(string href) => href switch
    {
        "foresporsler" => _nyeForesporsler,
        "timegodkjenning" => _timerVenter,
        "tickets" => _apneTickets,
        "service" => _serviceVarsel,
        _ => 0
    };

    private static string FristTekst(DateTime frist)
    {
        var dager = (frist.Date - DateTime.Today).Days;
        return dager < 0 ? "Forfalt" : dager == 0 ? "Frist i dag" : dager == 1 ? "Frist i morgen" : frist.ToString("d. MMM", Kultur);
    }

    private static string RelativTid(DateTime t)
    {
        var diff = DateTime.Now - t;
        if (diff.TotalMinutes < 60) return $"{Math.Max(1, (int)diff.TotalMinutes)} min siden";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} t siden";
        if (diff.TotalDays < 2) return "i går";
        return t.ToString("d. MMM", Kultur);
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            _rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : null;
            GjenopprettKategoriFraUrl();
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var bid))
            {
                _bruker = await Db.Brukere.FindAsync(bid);
            }
        }

        // "Tilpass" fra Tilpass meny lander her med tilpassingen slått på.
        _tilpasser = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).TryGetValue("tilpassHurtigvalg", out var tv) && tv == "1";

        var idag = DateTime.Today;
        var dagens = Db.Arbeidsordre.Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date == idag);
        if (_rolle == BrukerRolle.Montor && _bruker is not null)
        {
            dagens = dagens.Where(a => a.AnsvarligMontorId == _bruker.Id);
        }

        _dagensJobber = await dagens.CountAsync();
        _klarTilFakturering = await Db.Arbeidsordre.CountAsync(a => a.Status == ArbeidsordreStatus.Ferdig);
        _nyeForesporsler = await Db.Foresporsler.CountAsync(f => !f.Lest);
        _timerVenter = await Db.Timeregistreringer.CountAsync(t => t.Status == TimeregistreringStatus.Venter);
        _apneTickets = await Db.Tickets.CountAsync(t => t.Status == TicketStatus.Ny);

        // Serviceavtaler med neste service innen 14 dager.
        var serviceIder = await Db.Prosjekter.Where(p => p.Status == ProsjektStatus.Serviceavtale).Select(p => p.Id).ToListAsync();
        if (serviceIder.Count > 0)
        {
            var runder = await Db.Servicerunder.Where(r => serviceIder.Contains(r.ProsjektId)).ToListAsync();
            var terskel = idag.AddDays(14);
            _serviceVarsel = serviceIder.Count(pid => runder.Where(r => r.ProsjektId == pid).OrderByDescending(r => r.Dato)
                .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato is { } neste && neste.Date <= terskel);
        }

        // Forespørsler, drift og ferdigmeldt - nyeste først (samme kilder som dagens forside).
        var foresporsler = await Db.Foresporsler.Where(f => !f.Lest).OrderByDescending(f => f.MottattDato).Take(3).ToListAsync();
        var drift = await Db.Driftsmeldinger.Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .Where(m => !m.LestAvAnsatt).OrderByDescending(m => m.OpprettetDato).Take(3).ToListAsync();
        var ferdigQuery = Db.Arbeidsordre.AsNoTracking().Include(a => a.Prosjekt).Include(a => a.FullfortAvBruker)
            .Where(a => a.Status == ArbeidsordreStatus.Ferdig && a.FullfortDato != null);
        if (_rolle == BrukerRolle.Montor && _bruker is not null)
        {
            ferdigQuery = ferdigQuery.Where(a => a.AnsvarligMontorId == _bruker.Id);
        }

        var ferdig = await ferdigQuery.OrderByDescending(a => a.FullfortDato).Take(3).ToListAsync();

        _hendelser = foresporsler
            .Select(f => new Hendelse($"/foresporsler?id={f.Id}", f.Emne, string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn!, "mail", "#2f5f9e", "#e7eef8", "Ny", RelativTid(f.MottattDato), f.MottattDato))
            .Concat(drift.Select(m => new Hendelse($"/driftsmelding/{m.Id}", string.IsNullOrWhiteSpace(m.Tittel) ? $"Dør {m.Dor?.Dornummer}" : m.Tittel!, m.Dor?.Prosjekt?.Navn ?? "Driftsmelding", "tool", "#a8691a", "#fbefdc", "Drift", RelativTid(m.OpprettetDato), m.OpprettetDato)))
            .Concat(ferdig.Select(a => new Hendelse($"/arbeidsordre/{a.Id}", a.Tittel, string.Join(" · ", new[] { "Ferdigmeldt", a.FullfortAvBruker?.Navn }.Where(s => !string.IsNullOrWhiteSpace(s))), "check-circle", "#2e7d4f", "#e5f2ea", "Ferdig", RelativTid(a.FullfortDato!.Value), a.FullfortDato!.Value)))
            .OrderByDescending(h => h.Sortering)
            .ToList();

        // Mine oppgaver fra To-do liste: med frist først.
        if (_bruker is not null)
        {
            _oppgaver = (await Db.ToDoOppgaver.Where(o => o.BrukerId == _bruker.Id && !o.Fullfort).ToListAsync())
                .OrderBy(o => o.Frist ?? DateTime.MaxValue).ThenByDescending(o => o.OpprettetDato)
                .Take(6)
                .Select(o => new OppgaveRad(o.Tittel, o.Frist))
                .ToList();
        }

        _vaer = await VaerSvc.HentAsync(Sted);

        _kunngjoringer = await Db.Kunngjoringer
            .Where(k => k.Type == InnleggType.Kunngjoring)
            .OrderByDescending(k => k.Festet).ThenByDescending(k => k.OpprettetDato)
            .Take(3)
            .Select(k => new KunngjoringRad(k.Id, k.Tittel, k.OpprettetDato, k.BildeData != null))
            .ToListAsync();

        await LastInnKartAsync();
    }

    // ---------- Kartet (samme punkter som i Layout 2, se Home.razor) ----------

    private static readonly ArbeidsordreStatus[] ApneOrdreStatuser =
        [ArbeidsordreStatus.Ny, ArbeidsordreStatus.Klar, ArbeidsordreStatus.Pagaende];

    private readonly CancellationTokenSource _disposedCts = new();
    private List<object> _kartPunkter = [];
    private bool _kartInitialisert;
    private bool _kartLastet;
    private int _kartPunkterVedForrigeRender;
    private string _kartFlate = "kart";

    private async Task LastInnKartAsync()
    {
        var serviceProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .ToListAsync();
        var aktiveProsjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.UnderArbeid)
            .ToListAsync();
        var planlagteOrdre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Where(a => ApneOrdreStatuser.Contains(a.Status) && a.PlanlagtDato != null)
            .ToListAsync();

        // Viser med en gang det som har lagret posisjon; manglende adresser
        // slås opp i bakgrunnen, så forsiden aldri venter på geokodingen.
        SettKartPunkter(serviceProsjekter, aktiveProsjekter, planlagteOrdre);
        _kartLastet = true;
        _ = GeokodIBakgrunnenAsync(serviceProsjekter, aktiveProsjekter, planlagteOrdre, _disposedCts.Token);
    }

    private async Task GeokodIBakgrunnenAsync(List<Prosjekt> service, List<Prosjekt> aktive, List<Arbeidsordre> ordre, CancellationToken ct)
    {
        var endret = false;
        var forste = true;

        foreach (var p in service.Concat(aktive).Where(p => p.Latitude is null && !string.IsNullOrWhiteSpace(p.Adresse)))
        {
            if (ct.IsCancellationRequested)
            {
                break;
            }

            // Nominatim tillater maks én forespørsel i sekundet.
            if (!forste)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromMilliseconds(1100), ct);
                }
                catch (TaskCanceledException)
                {
                    break;
                }
            }
            forste = false;

            (double Latitude, double Longitude)? treff;
            try
            {
                treff = await Geokoding.GeocodeAsync(p.Adresse!, p.Postnr, p.Sted);
            }
            catch
            {
                continue;
            }

            if (treff is null || ct.IsCancellationRequested)
            {
                continue;
            }

            p.Latitude = treff.Value.Latitude;
            p.Longitude = treff.Value.Longitude;
            endret = true;

            SettKartPunkter(service, aktive, ordre);
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                break;
            }
        }

        if (endret && !ct.IsCancellationRequested)
        {
            try
            {
                await Db.SaveChangesAsync();
            }
            catch
            {
                // Best-effort - siden kan være forlatt underveis.
            }
        }
    }

    private void SettKartPunkter(List<Prosjekt> service, List<Prosjekt> aktive, List<Arbeidsordre> ordre)
    {
        var punkter = new List<object>();

        punkter.AddRange(service
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"service-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#9A4E24",
                pin = true,
                rikPopup = true,
                statusTekst = "Serviceavtale",
                statusBg = "#F3E9DC",
                href = $"/serviceavtaler/{p.Id}"
            }));

        punkter.AddRange(aktive
            .Where(p => p.Latitude is not null && p.Longitude is not null)
            .Select(p => (object)new
            {
                id = $"prosjekt-{p.Id}",
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = ProsjektSted(p),
                farge = "#0b66e6",
                pin = true,
                rikPopup = true,
                statusTekst = p.Status?.Visningsnavn(),
                statusBg = "#dbe7f7",
                href = $"/prosjekter/{p.Id}"
            }));

        punkter.AddRange(ordre
            .Where(a => (a.Latitude ?? a.Prosjekt?.Latitude) is not null && (a.Longitude ?? a.Prosjekt?.Longitude) is not null)
            .Select(a => (object)new
            {
                id = $"ao-{a.Id}",
                lat = a.Latitude ?? a.Prosjekt!.Latitude!.Value,
                lng = a.Longitude ?? a.Prosjekt!.Longitude!.Value,
                tittel = a.Tittel,
                undertekst = a.Prosjekt?.Navn ?? "",
                farge = "#0c9c5c",
                pin = true,
                rikPopup = true,
                statusTekst = a.Status.Visningsnavn(),
                statusBg = "#d3ecdb",
                href = $"/arbeidsordre/{a.Id}"
            }));

        _kartPunkter = punkter;
    }

    private static string ProsjektSted(Prosjekt p) => string.IsNullOrWhiteSpace(p.Sted) ? "Flere lokasjoner" : p.Sted;

    private async Task ByttKartflate(string flate)
    {
        if (_kartFlate == flate)
        {
            return;
        }

        _kartFlate = flate;
        if (_kartInitialisert)
        {
            await JS.InvokeVoidAsync("kart.settBakgrunn", flate);
        }
    }

    private async Task OppdaterKartAsync()
    {
        try
        {
            // Vent til punktene er hentet - ellers zoomer kartet aldri inn på dem.
            if (!_kartLastet)
            {
                return;
            }

            if (!_kartInitialisert)
            {
                // Liten klyngeradius som i Layout 2, så punktene vises med en gang.
                await JS.InvokeVoidAsync("kart.init", "fh-kart", _kartPunkter, null,
                    new { klyngeRadius = 14, sluttKlyngeZoom = 10 });
                _kartInitialisert = true;
                _kartPunkterVedForrigeRender = _kartPunkter.Count;
            }
            else if (_kartPunkter.Count != _kartPunkterVedForrigeRender)
            {
                await JS.InvokeVoidAsync("kart.oppdaterPunkter", _kartPunkter);
                _kartPunkterVedForrigeRender = _kartPunkter.Count;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        _disposedCts.Cancel();
        _disposedCts.Dispose();
    }

    // Hurtigvalgene ligger i nettleseren (samme nøkkel som dagens forside), så de
    // kan først leses etter første render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await OppdaterKartAsync();

        if (!firstRender)
        {
            return;
        }

        try
        {
            var lagret = await LokalLagring.GetAsync<List<string>>(HurtigvalgNokkel);
            _hurtigvalg = lagret is { Success: true, Value: { } verdier } ? verdier : StandardHurtigvalgForBruker();
        }
        catch (Exception)
        {
            _hurtigvalg = StandardHurtigvalgForBruker();
        }

        _hurtigvalgLastet = true;
        StateHasChanged();
    }

    private List<string> StandardHurtigvalgForBruker() => StandardHurtigvalg.Where(h => BladLenker.Any(l => l.Href == h)).ToList();
}
