@page "/komponentprismodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Komponenter og priser - Full Kontroll</PageTitle>

<a class="back-link" href="/"><Icon Name="arrow-left" />Til hjem</a>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="box" /></span>
    <div>
        <h1>Komponenter og priser</h1>
        <p class="section-hint">Komponentregister, prisimport, rabattgrupper og lagerstyring.</p>
    </div>
</div>

<div class="modul-grid">
    <a href="/komponenter" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="tool" /></span>
        <span class="modul-card-title">Komponentregister</span>
        <span class="modul-card-desc">Søk, prissett og administrer komponenter og leverandører.</span>
    </a>
    <a href="/komponenter/prisimport" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="receipt" /></span>
        <span class="modul-card-title">Prisimport</span>
        <span class="modul-card-desc">Oppdater prisene fra leverandørens prisliste, eller importer nye varer.</span>
    </a>
    <a href="/komponenter/leverandorer" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="users" /></span>
        <span class="modul-card-title">Leverandører</span>
        <span class="modul-card-desc">Søk opp leverandører, se hvilke varer de leverer, og sett varenummer/pris/standard pr. leverandør.</span>
    </a>
    <a href="/priskoder" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="clock" /></span>
        <span class="modul-card-title">Priskoder</span>
        <span class="modul-card-desc">Arbeid, kjøring, småmateriell og tillegg med kode, kostpris og salgspris. Brukes som linjer i tilbudet.</span>
    </a>
    <a href="/rabattgrupper" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="tag" /></span>
        <span class="modul-card-title">Rabattgrupper</span>
        <span class="modul-card-desc">Faste rabattavtaler per leverandør/produktserie, brukes til å beregne nettopris automatisk.</span>
    </a>
    <a href="/produktgrupper" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="folder" /></span>
        <span class="modul-card-title">Produktgrupper</span>
        <span class="modul-card-desc">Opprett produktgrupper og legg til varer i dem. Brukes til å sette kunderabatt per gruppe.</span>
    </a>
    @* Lagerstyring er tatt ut av Administrasjon 2026-10-19. Siden lever på
       /lager (lenkes fra varselet om lav beholdning). *@
</div>
