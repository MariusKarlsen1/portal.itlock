@page "/produktgrupper"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Produktgrupper</PageTitle>

<h1>Produktgrupper</h1>
<p>Grupper varer i komponentregisteret på tvers av leverandør, slik at kunder kan gis en fast rabatt per produktgruppe under kundekortets "Rabatter"-fane. Koble en komponent til riktig produktgruppe under Komponentregister.</p>

@if (_produktgrupper.Count == 0)
{
    <p class="list-empty">Ingen produktgrupper opprettet ennå.</p>
}
else
{
    <table class="rabatt-table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Antall varer</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _produktgrupper)
            {
                <tr @key="p.Id">
                    <td><input @bind="p.Navn" /></td>
                    <td>@p.Komponenter.Count</td>
                    <td class="rabatt-actions">
                        <a class="cancel-button" href="@($"/produktgrupper/{p.Id}")">Åpne</a>
                        <button type="button" class="save-button" @onclick="@(() => Lagre(p))">Lagre</button>
                        <button type="button" class="remove-button" disabled="@(p.Komponenter.Count > 0)" title="@(p.Komponenter.Count > 0 ? "Kan ikke slette - i bruk på varer" : null)" @onclick="@(() => Slett(p))">Slett</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="ny-rabattgruppe">
    <h2>Ny produktgruppe</h2>
    <div class="ny-rabattgruppe-form">
        <input @bind="_nyNavn" placeholder="Navn, f.eks. Låser" />
        <button type="button" class="add-button" @onclick="Opprett">Opprett</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="save-success">@_melding</p>
}
@if (!string.IsNullOrEmpty(_feil))
{
    <p class="form-error">@_feil</p>
}

@code {
    private List<Produktgruppe> _produktgrupper = [];
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _produktgrupper = await Db.Produktgrupper
            .Include(p => p.Komponenter)
            .OrderBy(p => p.Navn)
            .ToListAsync();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        Db.Produktgrupper.Add(new Produktgruppe { Navn = _nyNavn.Trim() });
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"Produktgruppen \"{_nyNavn}\" er opprettet.";
        _nyNavn = "";
        await LastAsync();
    }

    private async Task Lagre(Produktgruppe p)
    {
        var entitet = await Db.Produktgrupper.FirstOrDefaultAsync(x => x.Id == p.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Navn = p.Navn.Trim();
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"\"{p.Navn}\" er lagret.";
    }

    private async Task Slett(Produktgruppe p)
    {
        if (p.Komponenter.Count > 0)
        {
            return;
        }

        var entitet = await Db.Produktgrupper.FirstOrDefaultAsync(x => x.Id == p.Id);
        if (entitet is null)
        {
            return;
        }

        Db.Produktgrupper.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"\"{p.Navn}\" er slettet.";
        _feil = null;
        await LastAsync();
    }
}
