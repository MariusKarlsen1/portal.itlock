@page "/produktgrupper"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Produktgrupper</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="folder" /></span>
        <div>
            <h1>Produktgrupper</h1>
            <p class="section-hint">Grupper varer i komponentregisteret på tvers av leverandør, slik at kunder kan gis en fast rabatt per produktgruppe under kundekortets "Rabatter"-fane. Koble en komponent til riktig produktgruppe under Komponentregister.</p>
        </div>
    </div>
</div>

<div class="verktoy-rad">
    <div class="sok-boks">
        <Icon Name="search" />
        <input @bind="_sok" @bind:event="oninput" placeholder="Søk produktgruppe..." />
    </div>
    <span class="stat-chip"><span class="dot"></span>@_produktgrupper.Count produktgrupper</span>
</div>

@if (_produktgrupper.Count == 0)
{
    <p class="list-empty">Ingen produktgrupper opprettet ennå.</p>
}
else if (_synlige.Count == 0)
{
    <p class="list-empty">Ingen treff.</p>
}
else
{
    <div class="gruppe-liste">
        @foreach (var p in _synlige)
        {
            <div class="gruppe-rad" @key="p.Gruppe.Id">
                <span class="gruppe-ikon"><Icon Name="folder" /></span>
                <input class="gruppe-navn-input" @bind="p.Gruppe.Navn" />
                <span class="vare-badge">@p.AntallVarer vare@(p.AntallVarer == 1 ? "" : "r")</span>
                <div class="gruppe-actions">
                    <a class="knapp knapp-primaer" href="@($"/produktgrupper/{p.Gruppe.Id}")">Åpne</a>
                    <button type="button" class="ikon-btn" title="Lagre" @onclick="@(() => Lagre(p.Gruppe))"><Icon Name="check" /></button>
                    <button type="button" class="ikon-btn slett" title="@(p.AntallVarer > 0 ? "Kan ikke slette - i bruk på varer" : "Slett")" disabled="@(p.AntallVarer > 0)" @onclick="@(() => Slett(p))"><Icon Name="trash" /></button>
                </div>
            </div>
        }
    </div>
}

<div class="kort ny-gruppe">
    <h2>Ny produktgruppe</h2>
    <div class="ny-gruppe-form">
        <input @bind="_nyNavn" placeholder="Navn, f.eks. Låser" />
        <button type="button" class="knapp knapp-primaer" @onclick="Opprett">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }
</div>

@code {
    private sealed class ProduktgruppeRad
    {
        public required Produktgruppe Gruppe { get; set; }
        public int AntallVarer { get; set; }
    }

    private List<ProduktgruppeRad> _produktgrupper = [];
    private string _sok = "";
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;

    private List<ProduktgruppeRad> _synlige => string.IsNullOrWhiteSpace(_sok)
        ? _produktgrupper
        : _produktgrupper.Where(p => p.Gruppe.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    // Teller varer per gruppe med en korrelert underspørring i stedet for å
    // laste inn hele komponent-radene via Include (som noen produktgrupper
    // har tusenvis av) - bare for å telle dem. Gjorde siden merkbart treg å
    // navigere til.
    private async Task LastAsync()
    {
        _produktgrupper = await Db.Produktgrupper
            .OrderBy(p => p.Navn)
            .Select(p => new ProduktgruppeRad { Gruppe = p, AntallVarer = p.Komponenter.Count })
            .ToListAsync();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        Db.Produktgrupper.Add(new Produktgruppe { Navn = _nyNavn.Trim() });
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"Produktgruppen \"{_nyNavn}\" er opprettet.";
        _nyNavn = "";
        await LastAsync();
    }

    private async Task Lagre(Produktgruppe p)
    {
        var entitet = await Db.Produktgrupper.FirstOrDefaultAsync(x => x.Id == p.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Navn = p.Navn.Trim();
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"\"{p.Navn}\" er lagret.";
    }

    private async Task Slett(ProduktgruppeRad rad)
    {
        if (rad.AntallVarer > 0)
        {
            return;
        }

        var entitet = await Db.Produktgrupper.FirstOrDefaultAsync(x => x.Id == rad.Gruppe.Id);
        if (entitet is null)
        {
            return;
        }

        Db.Produktgrupper.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Gruppe.Navn}\" er slettet.";
        _feil = null;
        await LastAsync();
    }
}
