@page "/tilbakestill-passord"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Tilbakestill passord - itlock</PageTitle>

<div class="login-card">
    <h1>Velg nytt passord</h1>

    @if (Feil is not null)
    {
        <p class="login-error">@Feil</p>
    }

    @if (FeilKode == "ugyldig-token")
    {
        <a class="sett-passord-tilbake" href="/glemt-passord">Be om ny lenke</a>
    }
    else
    {
        <form method="post" action="/account/tilbakestill-passord">
            <input type="hidden" name="token" value="@Token" />
            <label>
                Nytt passord (minst 8 tegn)
                <input type="password" name="passord" required minlength="8" autofocus />
            </label>
            <label>
                Bekreft passord
                <input type="password" name="bekreft" required minlength="8" />
            </label>
            <button type="submit">Sett passord</button>
        </form>
    }

    <a class="sett-passord-tilbake" href="/login">Tilbake til innlogging</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? FeilKode { get; set; }

    private string? Feil => FeilKode switch
    {
        "ugyldig-token" => "Lenken er ugyldig eller har gått ut på dato. Be om en ny under \"Glemt passord\".",
        "ugyldig-passord" => "Passordet må være minst 8 tegn, og de to feltene må være like.",
        _ => null
    };
}
