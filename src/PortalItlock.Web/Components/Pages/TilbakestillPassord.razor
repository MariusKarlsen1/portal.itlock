@page "/tilbakestill-passord"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Velg passord - Full Kontroll</PageTitle>

<InnloggingRamme Scene="nokkel" Steg="3" Tittel="@(Ugyldig ? "Lenken har gått ut." : "Velg ditt passord.")"
                 Ingress="@(Ugyldig ? "Lenker for passord gjelder i 1 time. Be om en ny, så er du i gang igjen på et øyeblikk." : "Siste steg. Velg et passord du husker – jo lengre, jo sterkere nøkkel.")"
                 Utlopt="Ugyldig">
    @if (Ugyldig)
    {
        <h2>Lenken virker ikke lenger</h2>
        <p class="li-ingress">Lenken er ugyldig, allerede brukt eller har gått ut på dato.</p>
        <a class="li-knapp li-primar" href="/glemt-passord">Be om ny lenke <span class="li-pil">→</span></a>
        <div class="li-lenker">
            <a class="li-tilbake" href="/login">← Tilbake til innlogging</a>
        </div>
    }
    else
    {
        <h2>Velg passord</h2>
        <p class="li-ingress">Minst 8 tegn. Når passordet er lagret, logger du inn med det.</p>

        @if (FeilKode == "ugyldig-passord")
        {
            <p class="li-melding li-feil">Passordet må være minst 8 tegn, og de to feltene må være like.</p>
        }

        <form method="post" action="/account/tilbakestill-passord">
            <input type="hidden" name="token" value="@Token" />
            <div class="li-felt">
                <label for="liPassord1">Nytt passord</label>
                <input id="liPassord1" type="password" name="passord" autocomplete="new-password" placeholder="Minst 8 tegn" required minlength="8" autofocus />
                <button type="button" class="li-oye" data-for="liPassord1" aria-label="Vis passord">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
                <div class="li-styrke" id="liStyrke" data-n="0"><i></i><i></i><i></i><i></i></div>
                <small class="li-hjelp" id="liStyrkeTekst">Minst 8 tegn. Tips: en kort setning er lett å huske.</small>
            </div>
            <div class="li-felt">
                <label for="liPassord2">Gjenta passordet</label>
                <input id="liPassord2" type="password" name="bekreft" autocomplete="new-password" placeholder="Skriv det én gang til" required minlength="8" />
                <button type="button" class="li-oye" data-for="liPassord2" aria-label="Vis passord">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
                <small class="li-hjelp" id="liLik"></small>
            </div>
            <button class="li-knapp li-primar" type="submit">Lagre passord <span class="li-pil">→</span></button>
        </form>

        <div class="li-lenker">
            <a class="li-tilbake" href="/login">← Tilbake til innlogging</a>
        </div>
    }
</InnloggingRamme>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? FeilKode { get; set; }

    private bool Ugyldig => FeilKode == "ugyldig-token";
}
