@page "/login"
@layout LoginLayout
@using PortalItlock.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - itlock</PageTitle>

<div class="login-card">
    <div class="login-legend-strip">
        <span style="background:#C1703F"></span>
        <span style="background:#2E7D8F"></span>
        <span style="background:#5E7D3A"></span>
        <span style="background:#7A5A9E"></span>
        <span style="background:#B8862E"></span>
        <span style="background:#3A5E8F"></span>
    </div>

    <div class="login-card-body">
        <div class="login-fig">FIG. 00 — PÅLOGGING</div>
        <h1>Logg inn</h1>
        <p class="login-hint">Fortsett til prosjektene dine.</p>

        @if (Feil == "1")
        {
            <p class="login-error">Feil e-post eller passord.</p>
        }
        @if (ForMange == "1")
        {
            <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
        }
        @if (Satt == "1")
        {
            <p class="login-success">Passord satt. Du kan nå logge inn.</p>
        }

        <form method="post" action="/account/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label>
                E-POST
                <input type="email" name="username" autocomplete="username" value="@Epost" required autofocus />
            </label>
            <label>
                PASSORD
                <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <div class="login-link-row">
                <a href="/glemt-passord">Glemt passord?</a>
            </div>
            <button type="submit">Logg inn</button>
        </form>

        <script>
            (function () {
                // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
                // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
                // mobil slik at serveren faller tilbake til "/", som i sin tur
                // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
                if (window.matchMedia('(max-width: 640.98px)').matches) {
                    var felt = document.querySelector('input[name="returnUrl"]');
                    if (felt) {
                        felt.value = '';
                    }
                }
            })();
        </script>

        <div class="login-divider"><span>ELLER</span></div>

        <a class="login-finn-min-side" href="/finn-min-side">
            Finn min side
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>

        <div class="login-foot-links">
            <a href="/sett-passord">Sett passord første gang</a>
            <a href="/kunde">For kunden</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
