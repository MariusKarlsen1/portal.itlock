@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">

<div class="login-page-wrap">
    <div class="login-hero-section">
        <div class="login-photo">
            <img src="login-hero.png" alt="" class="login-photo-img" draggable="false" />
            <div class="login-hero-text-scrim"></div>
            <div class="login-hero-water-shimmer"></div>
            <div class="login-hero-cloud login-hero-cloud-1"></div>
            <div class="login-hero-cloud login-hero-cloud-2"></div>
            <div class="login-hero-steam">
                <span></span><span></span><span></span>
            </div>

            <div class="login-hero-headline-block">
                <div class="login-hero-eyebrow">Én plattform. Full Kontroll.</div>
                <h1 class="login-hero-headline">Digital styring<br /><span class="login-hero-headline-accent">av hele bygget.</span></h1>
                <p class="login-hero-sub">Prosjekter, dører, dokumentasjon og oppgaver – samlet på ett sted. For en mer effektiv, sikker og oversiktlig hverdag.</p>
                <div class="login-hero-feature-row">
                    <div class="login-hero-feature">
                        <span class="login-hero-feature-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span>
                        <span class="login-hero-feature-title">Full oversikt</span>
                    </div>
                    <div class="login-hero-feature">
                        <span class="login-hero-feature-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21v-2a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v2" /><circle cx="9" cy="7" r="3.2" /><path d="M16.5 11c1.8.4 3 1.7 3 4v0" /><circle cx="17.5" cy="6.5" r="2.4" /></svg></span>
                        <span class="login-hero-feature-title">Enkel admin</span>
                    </div>
                    <div class="login-hero-feature">
                        <span class="login-hero-feature-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 4 5v6c0 5 3.4 8.6 8 11 4.6-2.4 8-6 8-11V5z" /><path d="m9 12 2 2 4-4" /></svg></span>
                        <span class="login-hero-feature-title">Sikker dokumentasjon</span>
                    </div>
                </div>
            </div>

            <a href="#" class="login-hero-nav-btn login-hero-nav-hjem login-hero-nav-active" aria-label="Hjem"></a>
            <a href="#moduler" class="login-hero-nav-btn login-hero-nav-funksjoner" aria-label="Funksjoner"></a>
            <a href="#montor" class="login-hero-nav-btn login-hero-nav-bransjer" aria-label="Bransjer"></a>
            <a href="/om-full-kontroll" class="login-hero-nav-btn login-hero-nav-omoss" aria-label="Om oss"></a>
            <a href="/kontakt" class="login-hero-nav-btn login-hero-nav-kontakt" aria-label="Kontakt"></a>

            <button type="button" class="login-hero-search-btn" aria-label="Søk"></button>

            <button type="button" class="login-hero-login-btn" onclick="document.querySelector('.login-page-wrap').classList.toggle('login-open')" aria-label="Logg inn"></button>

            <a href="#moduler" class="login-hero-card login-hero-card-prosjekter" aria-label="Prosjekter"></a>
            <a href="#moduler" class="login-hero-card login-hero-card-dokumentasjon" aria-label="Dokumentasjon"></a>
            <a href="#moduler" class="login-hero-card login-hero-card-kunder" aria-label="Kunder"></a>
        </div>
    </div>

    <section id="moduler" class="login-moduler-section login-reveal">
        <span id="montor" class="login-anchor-montor"></span>
        <img src="login-moduler-montor.png" alt="" class="login-moduler-img" draggable="false" />
    </section>

    <div class="login-panel-backdrop" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')"></div>

    <div class="login-panel">
        <button type="button" class="login-panel-close" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')" aria-label="Lukk innlogging">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
        <div class="login-card">
            <div class="login-card-top">
                <span class="login-wordmark">Full Kontroll</span>
                <h1>Velkommen tilbake</h1>
                <p class="login-hint">Logg inn for å få tilgang til din konto</p>
            </div>

            @if (Feil == "1")
            {
                <p class="login-error">Feil e-post eller passord.</p>
            }
            @if (ForMange == "1")
            {
                <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="login-success">Passord satt. Du kan nå logge inn.</p>
            }

            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>
                    <span class="login-field-label">E-postadresse</span>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus />
                    </div>
                </label>
                <label>
                    <div class="login-field-label-row">
                        <span class="login-field-label">Passord</span>
                        <a href="/glemt-passord">Glemt passord?</a>
                    </div>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <input type="password" name="password" autocomplete="current-password" placeholder="Skriv inn passord" required />
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="login-field-eye"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </div>
                </label>
                <button type="submit" class="login-submit">
                    Logg inn
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>

            <script>
                (function () {
                    // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
                    // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
                    // mobil slik at serveren faller tilbake til "/", som i sin tur
                    // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
                    if (window.matchMedia('(max-width: 640.98px)').matches) {
                        var felt = document.querySelector('input[name="returnUrl"]');
                        if (felt) {
                            felt.value = '';
                        }
                    }
                })();
            </script>

            <div class="login-foot-links">
                <a href="/finn-min-side">Finn min side</a>
                <a href="/sett-passord">Sett passord første gang</a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var elements = document.querySelectorAll('.login-reveal');
        if (!elements.length) {
            return;
        }
        if (!('IntersectionObserver' in window)) {
            elements.forEach(function (el) { el.classList.add('login-reveal-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('login-reveal-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        elements.forEach(function (el) { observer.observe(el); });
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
