@page "/login"
@layout LoginLayout
@using PortalItlock.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - itlock</PageTitle>

<div class="login-card">
    <img src="itlock-full-kontroll-logo.png" alt="Itlock Full Kontroll" class="login-logo" />
    <h1>Logg inn</h1>

    @if (Feil == "1")
    {
        <p class="login-error">Feil e-post eller passord.</p>
    }
    @if (Satt == "1")
    {
        <p class="login-success">Passord satt. Du kan nå logge inn.</p>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label>
            E-post
            <input type="email" name="username" required autofocus />
        </label>
        <label>
            Passord
            <input type="password" name="password" required />
        </label>
        <button type="submit">Logg inn</button>
    </form>

    <a class="login-sett-passord" href="/sett-passord">Sett passord første gang</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }
}
