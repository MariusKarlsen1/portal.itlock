@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&display=swap" rel="stylesheet">

@* Samme utseende som plattform-innloggingen (PlattformLoggInn.razor), men
   for vanlige brukere - uten «Administrasjonsportal». Feltene beholder
   id-ene liEpost/liPassord. *@
<div class="pi-root">
    <div class="pi-kort">
        <div class="pi-venstre">
                <svg class="pi-vm" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke-width="1.3"><rect x="2.5" y="2.5" width="12.5" height="12.5" rx="3.5" stroke="#7FA6F0" /><rect x="17" y="2.5" width="12.5" height="12.5" rx="3.5" stroke="#5B8DEF" /><rect x="2.5" y="17" width="12.5" height="12.5" rx="3.5" stroke="#5B8DEF" /><rect x="17" y="17" width="12.5" height="12.5" rx="3.5" stroke="#7FA6F0" /></g></svg>
            <div>
                <div class="pi-merke">
                    <FkLogo BareMerke="true" Klasse="pi-merke-fk" />
                    <span class="pi-merke-tekst">
                        <strong>Full Kontroll</strong>
                        <span>Designet for låssmedbedrifter</span>
                    </span>
                </div>
                <div class="pi-strek"></div>
                <h1>Velkommen</h1>
                <p>Logg inn for å se dagens jobber, prosjekter og alt som har kommet inn.</p>
            </div>
            <div>
                <div class="pi-strek"></div>
                <span class="pi-copyright">Opphavsrett © Full Kontroll @DateTime.Now.Year</span>
            </div>
        </div>

        <div class="pi-hoyre">
            @if (Tofaktor == "1")
            {
                var reserve = Reserve == "1";
                @* Steg 2: koden fra autentiseringsappen (se /account/tofaktor). *@
                <h2 class="pi-tittel">@(reserve ? "Bruk en reservekode" : "Skriv inn koden")</h2>
                <p class="pi-tofaktor-tekst">@(reserve
                    ? "Skriv inn en av reservekodene du lagret da du slo på tofaktor. Hver kode virker én gang."
                    : "Åpne autentiseringsappen på telefonen og skriv inn den 6-sifrede koden for Full Kontroll.")</p>
                @if (Feil == "1")
                {
                    <p class="pi-feil">@(reserve ? "Reservekoden stemmer ikke, eller er brukt før." : "Koden stemmer ikke. Prøv koden som står i appen nå.")</p>
                }
                <form method="post" action="/account/tofaktor" class="pi-form">
                    <input type="hidden" name="modus" value="@(reserve ? "reserve" : "app")" />
                    <label class="pi-felt">
                        @(reserve ? "Reservekode" : "Kode fra appen")
                        <span class="pi-input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                            @if (reserve)
                            {
                                <input id="liKode" name="kode" autocomplete="off" required autofocus placeholder="F.eks. 4F7K-29QD" class="pi-kode-felt" />
                            }
                            else
                            {
                                <input id="liKode" name="kode" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" autocomplete="one-time-code" required autofocus placeholder="123 456" class="pi-kode-felt" />
                            }
                        </span>
                    </label>
                    <label class="pi-husk"><input type="checkbox" name="husk" value="on" checked /> Husk denne enheten i 30 dager</label>
                    <button type="submit" class="pi-knapp">Logg inn →</button>
                </form>
                <a class="pi-sett-passord" href="@(reserve ? "/login?tofaktor=1" : "/login?tofaktor=1&reserve=1")">@(reserve ? "Bruk koden fra appen" : "Har ikke telefonen? Bruk en reservekode")</a>
                <a class="pi-for-kunden" href="/login">← Avbryt og logg inn på nytt</a>
                <p class="pi-tofaktor-hint">Mistet både telefonen og reservekodene? Be en administrator om å tilbakestille tofaktor for deg.</p>
            }
            else
            {
            <h2 class="pi-tittel">Logg inn</h2>
            @if (TofaktorUtlopt == "1")
            {
                <p class="pi-feil">Det tok for lang tid å skrive inn koden. Logg inn på nytt.</p>
            }
            @if (TofaktorForMange == "1")
            {
                <p class="pi-feil">For mange feil koder. Logg inn på nytt.</p>
            }
            @if (Utlogget == "1")
            {
                <p class="pi-feil">Du er logget ut fordi brukeren din er deaktivert eller slettet.</p>
            }
            @if (Stengt == "1")
            {
                <p class="pi-feil">Tilgangen til organisasjonen er stengt. Kontakt Full Kontroll for å åpne den igjen.</p>
            }
            @if (Feil == "1")
            {
                <p class="pi-feil">Feil e-post eller passord. Prøv igjen.</p>
            }
            @if (ForMange == "1")
            {
                <p class="pi-feil">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="pi-suksess">Passordet er lagret. Logg inn med det nye passordet ditt.</p>
            }

            <form method="post" action="/account/login" class="pi-form">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label class="pi-felt">
                    E-postadresse
                    <span class="pi-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input id="liEpost" type="email" name="username" autocomplete="username" value="@Epost" required autofocus placeholder="din@epost.no" />
                    </span>
                </label>
                <label class="pi-felt">
                    Passord
                    <span class="pi-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <input id="liPassord" type="password" name="password" autocomplete="current-password" required />
                        <button type="button" class="pi-vis-passord" title="Vis/skjul passord" onclick="const i=document.getElementById('liPassord'); i.type = i.type==='password' ? 'text' : 'password';">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </span>
                </label>
                <div class="pi-mellomrad">
                    <label class="pi-husk-meg"><input type="checkbox" name="huskMeg" value="on" /><span>Husk meg</span></label>
                    <a href="/glemt-passord">Glemt passord?</a>
                </div>
                <button type="submit" class="pi-knapp">Logg inn →</button>
            </form>

            <a class="pi-sett-passord" href="/sett-passord">Sett passord første gang</a>
            <a class="pi-for-kunden" href="/">← Tilbake til forsiden</a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }

    [SupplyParameterFromQuery(Name = "stengt")]
    public string? Stengt { get; set; }

    [SupplyParameterFromQuery(Name = "utlogget")]
    public string? Utlogget { get; set; }

    [SupplyParameterFromQuery(Name = "tofaktor")]
    public string? Tofaktor { get; set; }

    [SupplyParameterFromQuery(Name = "reserve")]
    public string? Reserve { get; set; }

    [SupplyParameterFromQuery(Name = "tofaktorUtlopt")]
    public string? TofaktorUtlopt { get; set; }

    [SupplyParameterFromQuery(Name = "tofaktorForMange")]
    public string? TofaktorForMange { get; set; }
}
