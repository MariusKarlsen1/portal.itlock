@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">

<div class="li-side li-papir" id="liSide">
    <div class="li-venstre">
        <a class="li-merke li-inn" href="/">
            <svg role="img" aria-label="Full Kontroll" viewBox="0 0 232 40" class="li-logo"><rect x="0" y="20" width="8" height="16" rx="2" fill="#c98a4b" /><rect x="12" y="12" width="8" height="24" rx="2" fill="#a86a3a" /><rect x="24" y="4" width="8" height="32" rx="2" fill="#7a4f33" /><text x="42" y="30" font-family="DM Sans, Arial, sans-serif" font-size="25" font-weight="700" fill="currentColor" letter-spacing="-0.5">Full Kontroll</text></svg>
            <small>Portalen for låssmed og adgangskontroll</small>
        </a>
        <div class="li-hilsen">
            <h1 class="li-inn li-d1" id="liHilsen">God dag.</h1>
            <p class="li-inn li-d2">Logg inn for å se dagens jobber, prosjekter og alt som har kommet inn.</p>
            <div class="li-punkter li-inn li-d3"><span>Prosjekter</span><span>Tilbud</span><span>Arbeidsordre</span><span>FDV</span><span>Timer</span></div>
        </div>
        <div class="li-bunn">Full Kontroll © @DateTime.Now.Year</div>
    </div>

    <div class="li-hoyre">
        <div class="li-verktoy">
            <button type="button" id="liTema" title="Bytt mellom lys og mørk modus" aria-label="Bytt tema">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            </button>
        </div>

        <div class="li-skjema li-inn li-d1">
            <h2>Logg inn</h2>

            @if (Feil == "1")
            {
                <p class="li-melding li-feil">Feil e-post eller passord. Prøv igjen.</p>
            }
            @if (ForMange == "1")
            {
                <p class="li-melding li-feil">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="li-melding li-ok">Passord satt. Du kan nå logge inn.</p>
            }

            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <div class="li-felt">
                    <label for="liEpost">E-postadresse</label>
                    <input id="liEpost" type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus />
                </div>
                <div class="li-felt">
                    <label for="liPassord">Passord</label>
                    <input id="liPassord" type="password" name="password" autocomplete="current-password" placeholder="••••••••" required />
                    <button type="button" class="li-oye" id="liOye" aria-label="Vis passord">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                <div class="li-rad">
                    <span></span>
                    <a href="/glemt-passord">Glemt passord?</a>
                </div>
                <button class="li-knapp li-primar" type="submit">Logg inn</button>
            </form>

            <div class="li-eller">eller</div>
            <a class="li-knapp li-sekundar" href="/sett-passord">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4" /><path d="m10.8 12.2 8.2-8.2M17 6l2 2M15 8l2 2" /></svg>
                Sett passord første gang
            </a>
            <div class="li-lenker">
                <div>Har du fått en invitasjon? <a href="/sett-passord">Aktiver kontoen her</a></div>
                <a class="li-tilbake" href="/">← Tilbake til forsiden</a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Hilsen etter tid på døgnet
        var t = new Date().getHours();
        var h = document.getElementById('liHilsen');
        if (h) h.textContent = t < 5 ? 'God natt.' : t < 10 ? 'God morgen.' : t < 17 ? 'God dag.' : 'God kveld.';

        // Vis/skjul passord
        var oye = document.getElementById('liOye');
        if (oye) oye.onclick = function () { var p = document.getElementById('liPassord'); p.type = p.type === 'password' ? 'text' : 'password'; };

        // Lys/mørk modus (huskes i nettleseren)
        var side = document.getElementById('liSide');
        try { if (localStorage.getItem('fk-login-tema') === 'mork') side.classList.add('li-mork'); } catch (e) { }
        var tema = document.getElementById('liTema');
        if (tema) tema.onclick = function () { var m = side.classList.toggle('li-mork'); try { localStorage.setItem('fk-login-tema', m ? 'mork' : 'lys'); } catch (e) { } };

        // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
        // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
        // mobil slik at serveren faller tilbake til "/", som i sin tur
        // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
        if (window.matchMedia('(max-width: 640.98px)').matches) {
            var felt = document.querySelector('input[name="returnUrl"]');
            if (felt) felt.value = '';
        }
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
