@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

@* Samme utseende som plattform-innloggingen (PlattformLoggInn.razor), men
   for vanlige brukere - uten «Administrasjonsportal». Feltene beholder
   id-ene liEpost/liPassord. *@
<div class="pi-root">
    <div class="pi-kort">
        <div class="pi-venstre">
            <div>
                <div class="pi-merke">
                    <svg class="pi-merke-svg" viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor" />
                        <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor" />
                        <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor" />
                    </svg>
                    <span class="pi-merke-tekst">
                        <strong>Full Kontroll</strong>
                        <span>Låssmed og adgangskontroll</span>
                    </span>
                </div>
                <div class="pi-strek"></div>
                <h1>Velkommen</h1>
                <p>Logg inn for å se dagens jobber, prosjekter og alt som har kommet inn.</p>
            </div>
            <div>
                <div class="pi-strek"></div>
                <span class="pi-copyright">Opphavsrett © Full Kontroll @DateTime.Now.Year</span>
            </div>
        </div>

        <div class="pi-hoyre">
            @if (Stengt == "1")
            {
                <p class="pi-feil">Tilgangen til organisasjonen er stengt. Kontakt Full Kontroll for å åpne den igjen.</p>
            }
            @if (Feil == "1")
            {
                <p class="pi-feil">Feil e-post eller passord. Prøv igjen.</p>
            }
            @if (ForMange == "1")
            {
                <p class="pi-feil">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="pi-suksess">Passordet er lagret. Logg inn med det nye passordet ditt.</p>
            }

            <form method="post" action="/account/login" class="pi-form">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label class="pi-felt">
                    E-postadresse
                    <span class="pi-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input id="liEpost" type="email" name="username" autocomplete="username" value="@Epost" required autofocus placeholder="din@epost.no" />
                    </span>
                </label>
                <label class="pi-felt">
                    Passord
                    <span class="pi-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <input id="liPassord" type="password" name="password" autocomplete="current-password" required />
                        <button type="button" class="pi-vis-passord" title="Vis/skjul passord" onclick="const i=document.getElementById('liPassord'); i.type = i.type==='password' ? 'text' : 'password';">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </span>
                </label>
                <div class="pi-mellomrad">
                    <span></span>
                    <a href="/glemt-passord">Glemt passord?</a>
                </div>
                <button type="submit" class="pi-knapp">Logg inn →</button>
            </form>

            <a class="pi-sett-passord" href="/sett-passord">Sett passord første gang</a>
            <a class="pi-for-kunden" href="/">← Tilbake til forsiden</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }

    [SupplyParameterFromQuery(Name = "stengt")]
    public string? Stengt { get; set; }
}
