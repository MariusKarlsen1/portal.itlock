@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="login-page-wrap">
    <div class="login-split">
        <div class="login-split-hero">
            <img src="login-hero-v3.png" alt="" class="login-split-hero-img" draggable="false" />

            <div class="login-split-shadow"></div>

            <div class="login-split-brand" aria-hidden="true">Full Kontroll</div>

            <div class="login-split-headline">
                <span class="login-split-eyebrow">Én plattform. Full Kontroll.</span>
                <h1>Digital styring av hele bygget.</h1>
            </div>
        </div>

        <div class="login-split-card">
            <div class="login-split-card-inner">
                <div class="login-split-card-top">
                    <span class="login-split-logo">Full Kontroll</span>
                    <h2>Velkommen tilbake</h2>
                    <p class="login-split-hint">Logg inn for å få tilgang til din konto</p>
                </div>

                @if (Feil == "1")
                {
                    <p class="login-error">Feil e-post eller passord.</p>
                }
                @if (ForMange == "1")
                {
                    <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
                }
                @if (Satt == "1")
                {
                    <p class="login-success">Passord satt. Du kan nå logge inn.</p>
                }

                <form method="post" action="/account/login">
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <label>
                        <span class="login-split-field-label">E-postadresse</span>
                        <input type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus class="login-split-input" />
                    </label>
                    <label>
                        <div class="login-split-field-label-row">
                            <span class="login-split-field-label">Passord</span>
                            <a href="/glemt-passord">Glemt passord?</a>
                        </div>
                        <div class="login-split-password">
                            <input type="password" name="password" autocomplete="current-password" placeholder="Skriv inn passord" required class="login-split-input" />
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="login-split-eye"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </div>
                    </label>
                    <button type="submit" class="login-split-submit">
                        Logg inn
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </form>

                <script>
                    (function () {
                        // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
                        // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
                        // mobil slik at serveren faller tilbake til "/", som i sin tur
                        // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
                        if (window.matchMedia('(max-width: 640.98px)').matches) {
                            var felt = document.querySelector('input[name="returnUrl"]');
                            if (felt) {
                                felt.value = '';
                            }
                        }
                    })();
                </script>

                <div class="login-split-foot">
                    <a href="/finn-min-side">Finn min side</a>
                    <a href="/sett-passord">Sett passord første gang</a>
                </div>
            </div>
        </div>
    </div>

    <section id="moduler" class="login-features-section">
        <span id="montor" class="login-anchor-montor"></span>

        <div class="login-features-intro login-reveal">
            <span class="login-features-eyebrow">Alt i ett system</span>
            <h2 class="login-features-title">Full oversikt over <span class="login-features-accent">hele virksomheten</span></h2>
            <p class="login-features-sub">Fra første anbud til ferdig dokumentasjon – Full Kontroll samler dører, prosjekter, arbeidsordre og produktdata på ett sted, uten dobbeltregistrering.</p>
        </div>

        <div class="login-feature-row login-reveal">
            <div class="login-feature-mock">
                <div class="login-feature-mock-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#835e41" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    Dører
                </div>
                <div class="login-mock-row">
                    <div><div class="login-mock-row-name">Der 101</div><div class="login-mock-row-sub">Plan 2, Nord</div></div>
                    <span class="login-mock-badge login-mock-badge-green">Ferdig</span>
                </div>
                <div class="login-mock-row">
                    <div><div class="login-mock-row-name">Der 102</div><div class="login-mock-row-sub">Plan 2, Nord</div></div>
                    <span class="login-mock-badge login-mock-badge-orange">Pågår</span>
                </div>
                <div class="login-mock-row">
                    <div><div class="login-mock-row-name">Der 103</div><div class="login-mock-row-sub">Plan 3, Sør</div></div>
                    <span class="login-mock-badge login-mock-badge-grey">Planlagt</span>
                </div>
            </div>
            <div class="login-feature-copy">
                <span class="login-feature-eyebrow">Moduler</span>
                <h3>Alle moduler i ett system</h3>
                <p>Dører, dokumentasjon, arbeidsordre og produkter er synkronisert i sanntid. Oppdater ett sted, og alle som jobber på prosjektet ser det umiddelbart.</p>
            </div>
        </div>

        <div class="login-feature-row login-feature-row-reverse login-reveal">
            <div class="login-feature-mock">
                <div class="login-feature-mock-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#835e41" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                    Arbeidsordre
                </div>
                <div class="login-mock-row"><div class="login-mock-row-name">Montering</div><div class="login-mock-bar"><div class="login-mock-bar-fill" style="width:90%"></div></div></div>
                <div class="login-mock-row"><div class="login-mock-row-name">Tilkobling</div><div class="login-mock-bar"><div class="login-mock-bar-fill" style="width:70%"></div></div></div>
                <div class="login-mock-row"><div class="login-mock-row-name">Testing</div><div class="login-mock-bar"><div class="login-mock-bar-fill" style="width:35%"></div></div></div>
            </div>
            <div class="login-feature-copy">
                <span class="login-feature-eyebrow">I felt</span>
                <h3>Montørene har alt på mobil</h3>
                <p>Sjekklister, dørstatus og oppgaver klare der montøren er. Avvik meldes direkte fra stedet, og ansvarlig varsles med det samme.</p>
            </div>
        </div>

        <div class="login-feature-row login-reveal">
            <div class="login-feature-mock">
                <div class="login-feature-mock-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#835e41" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>
                    Dokumentasjon
                </div>
                <div class="login-mock-row"><div class="login-mock-row-name">Samsvarserklæring</div><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#8a857a" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></div>
                <div class="login-mock-row"><div class="login-mock-row-name">Billeddokumentasjon</div><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#8a857a" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></div>
                <div class="login-mock-row"><div class="login-mock-row-name">FDV-dokumentasjon</div><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#8a857a" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></div>
            </div>
            <div class="login-feature-copy">
                <span class="login-feature-eyebrow">Dokumentasjon</span>
                <h3>Sporbart fra første dag</h3>
                <p>Samsvarserklæring, FDV og historikk samlet per anlegg. Full logg på hva som er gjort, av hvem, og når.</p>
            </div>
        </div>
    </section>
</div>

<script>
    (function () {
        var elements = document.querySelectorAll('.login-reveal');
        if (!elements.length) {
            return;
        }
        if (!('IntersectionObserver' in window)) {
            elements.forEach(function (el) { el.classList.add('login-reveal-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('login-reveal-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        elements.forEach(function (el) { observer.observe(el); });
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
