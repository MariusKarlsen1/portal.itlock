@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">

<div class="login-page-wrap">
    <div class="login-hero-section">
        <div class="login-photo">
            <img src="login-hero.png" alt="" class="login-photo-img" draggable="false" />
            <button type="button" class="login-hero-hotspot" onclick="document.querySelector('.login-page-wrap').classList.toggle('login-open')" aria-label="Logg inn"></button>
        </div>
    </div>

    <section id="moduler" class="login-showcase login-reveal">
        <div class="login-side-chips login-side-chips-left">
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></div>
                <div>
                    <div class="login-chip-title">Alle moduler i ett system</div>
                    <div class="login-chip-sub">Dører, prosjekter og produkter</div>
                </div>
            </div>
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg></div>
                <div>
                    <div class="login-chip-title">Sanntids status</div>
                    <div class="login-chip-sub">Alltid oppdatert prosjektbilde</div>
                </div>
            </div>
        </div>
        <img src="om-moduler.png" alt="" class="login-showcase-bg" draggable="false" />
        <div class="login-side-chips login-side-chips-right">
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg></div>
                <div>
                    <div class="login-chip-title">Søk og finn raskt</div>
                    <div class="login-chip-sub">Alt tilgjengelig med ett søk</div>
                </div>
            </div>
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12h4l3 8 4-16 3 8h4" /></svg></div>
                <div>
                    <div class="login-chip-title">Historikk og sporing</div>
                    <div class="login-chip-sub">Full logg på hvert anlegg</div>
                </div>
            </div>
        </div>
    </section>

    <section id="montor" class="login-worker login-reveal">
        <div class="login-side-chips login-side-chips-left">
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M11 18h2" /></svg></div>
                <div>
                    <div class="login-chip-title">Alt på mobil for montørene</div>
                    <div class="login-chip-sub">Oppgaver klare ute i felt</div>
                </div>
            </div>
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></div>
                <div>
                    <div class="login-chip-title">Sjekklister i felt</div>
                    <div class="login-chip-sub">Kvittér direkte på stedet</div>
                </div>
            </div>
        </div>
        <img src="login-worker.png" alt="" class="login-worker-bg" draggable="false" />
        <div class="login-side-chips login-side-chips-right">
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4m0 4h.01" /><path d="M10.3 3.9 2.5 18a1.5 1.5 0 0 0 1.3 2.2h16.4a1.5 1.5 0 0 0 1.3-2.2L13.7 3.9a1.5 1.5 0 0 0-2.6 0Z" /></svg></div>
                <div>
                    <div class="login-chip-title">Avvik meldes direkte</div>
                    <div class="login-chip-sub">Varsling rett til ansvarlig</div>
                </div>
            </div>
            <div class="login-chip">
                <div class="login-chip-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-2.6-6.3" /><path d="M21 3v6h-6" /></svg></div>
                <div>
                    <div class="login-chip-title">Oppdatert i sanntid</div>
                    <div class="login-chip-sub">Alle ser status umiddelbart</div>
                </div>
            </div>
        </div>
    </section>

    <div class="login-panel-backdrop" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')"></div>

    <div class="login-panel">
        <button type="button" class="login-panel-close" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')" aria-label="Lukk innlogging">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
        <div class="login-card">
            <div class="login-card-top">
                <span class="login-wordmark">Full Kontroll</span>
                <h1>Velkommen tilbake</h1>
                <p class="login-hint">Logg inn for å få tilgang til din konto</p>
            </div>

            @if (Feil == "1")
            {
                <p class="login-error">Feil e-post eller passord.</p>
            }
            @if (ForMange == "1")
            {
                <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="login-success">Passord satt. Du kan nå logge inn.</p>
            }

            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>
                    <span class="login-field-label">E-postadresse</span>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus />
                    </div>
                </label>
                <label>
                    <div class="login-field-label-row">
                        <span class="login-field-label">Passord</span>
                        <a href="/glemt-passord">Glemt passord?</a>
                    </div>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <input type="password" name="password" autocomplete="current-password" placeholder="Skriv inn passord" required />
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="login-field-eye"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </div>
                </label>
                <button type="submit" class="login-submit">
                    Logg inn
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>

            <script>
                (function () {
                    // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
                    // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
                    // mobil slik at serveren faller tilbake til "/", som i sin tur
                    // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
                    if (window.matchMedia('(max-width: 640.98px)').matches) {
                        var felt = document.querySelector('input[name="returnUrl"]');
                        if (felt) {
                            felt.value = '';
                        }
                    }
                })();
            </script>

            <div class="login-foot-links">
                <a href="/finn-min-side">Finn min side</a>
                <a href="/sett-passord">Sett passord første gang</a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var elements = document.querySelectorAll('.login-reveal');
        if (!elements.length) {
            return;
        }
        if (!('IntersectionObserver' in window)) {
            elements.forEach(function (el) { el.classList.add('login-reveal-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('login-reveal-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        elements.forEach(function (el) { observer.observe(el); });
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
