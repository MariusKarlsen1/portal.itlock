@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<InnloggingRamme Scene="dor" Ingress="Logg inn for å se dagens jobber, prosjekter og alt som har kommet inn." Feil="@(Feil == "1")">
    <h2>Logg inn</h2>

    @if (Feil == "1")
    {
        <p class="li-melding li-feil">Feil e-post eller passord. Prøv igjen.</p>
    }
    @if (ForMange == "1")
    {
        <p class="li-melding li-feil">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
    }
    @if (Satt == "1")
    {
        <p class="li-melding li-ok">Passordet er lagret. Logg inn med det nye passordet ditt.</p>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="li-felt">
            <label for="liEpost">E-postadresse</label>
            <input id="liEpost" type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus />
        </div>
        <div class="li-felt">
            <label for="liPassord">Passord</label>
            <input id="liPassord" type="password" name="password" autocomplete="current-password" placeholder="••••••••" required />
            <button type="button" class="li-oye" data-for="liPassord" aria-label="Vis passord">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
            </button>
        </div>
        <div class="li-rad">
            <span></span>
            <a href="/glemt-passord">Glemt passord?</a>
        </div>
        <button class="li-knapp li-primar" type="submit">Logg inn <span class="li-pil">→</span></button>
    </form>

    <div class="li-eller">eller</div>
    <a class="li-knapp li-sekundar" href="/sett-passord">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4" /><path d="m10.8 12.2 8.2-8.2M17 6l2 2M15 8l2 2" /></svg>
        Sett passord første gang
    </a>
    <div class="li-lenker">
        <div>Har du fått en invitasjon? <a href="/sett-passord">Aktiver kontoen her</a></div>
        <a class="li-tilbake" href="/">← Tilbake til forsiden</a>
    </div>
</InnloggingRamme>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
