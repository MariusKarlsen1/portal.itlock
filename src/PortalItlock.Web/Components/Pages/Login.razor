@page "/login"
@layout LoginLayout
@using PortalItlock.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - itlock</PageTitle>

<div class="login-card">
    <img src="itlock-logo.svg" alt="itlock" class="login-logo" />
    <h1>Logg inn</h1>

    @if (Feil == "1")
    {
        <p class="login-error">Feil brukernavn eller passord.</p>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label>
            E-post
            <input type="email" name="username" required autofocus />
        </label>
        <label>
            Passord
            <input type="password" name="password" required />
        </label>
        <button type="submit">Logg inn</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }
}
