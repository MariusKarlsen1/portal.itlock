@page "/login"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Logg inn - Full Kontroll</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">

<div class="login-page-wrap">
    <div class="login-topbar">
        <div class="login-topbar-brand"><img src="fullkontroll-logo-mark.png" alt="" class="login-topbar-logo" />Full Kontroll</div>
        <div class="login-topbar-links">
            <a href="/" class="login-topbar-link login-topbar-link-active">Hjem</a>
            <a href="/om#funksjoner" class="login-topbar-link">Løsninger</a>
            <a href="/om" class="login-topbar-link">Om oss</a>
            <a href="mailto:marius@itlock.no" class="login-topbar-link">Kontakt</a>
        </div>
        <button type="button" class="login-toggle-btn" onclick="document.querySelector('.login-page-wrap').classList.toggle('login-open')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-7 8-7s8 3 8 7" /></svg>
            Innlogging
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
    </div>

    <div class="login-static-wrap">
        <img src="fullkontroll-static-page.png" alt="Full Kontroll" class="login-static-page" draggable="false" />
        <button type="button" class="login-static-hotspot login-static-hotspot-primary" onclick="return false;">Se hvordan det fungerer</button>
        <button type="button" class="login-static-hotspot login-static-hotspot-ghost" onclick="return false;">Kontakt oss</button>
        <button type="button" class="login-static-hotspot login-static-hotspot-utforsk" onclick="return false;">Utforsk løsningene</button>
    </div>

    <div class="login-panel-backdrop" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')"></div>

    <div class="login-panel">
        <button type="button" class="login-panel-close" onclick="document.querySelector('.login-page-wrap').classList.remove('login-open')" aria-label="Lukk innlogging">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
        <div class="login-card">
            <div class="login-card-top">
                <span class="login-wordmark">Full Kontroll</span>
                <h1>Velkommen tilbake</h1>
                <p class="login-hint">Logg inn for å få tilgang til din konto</p>
            </div>

            @if (Feil == "1")
            {
                <p class="login-error">Feil e-post eller passord.</p>
            }
            @if (ForMange == "1")
            {
                <p class="login-error">For mange innloggingsforsøk. Vent noen minutter og prøv igjen.</p>
            }
            @if (Satt == "1")
            {
                <p class="login-success">Passord satt. Du kan nå logge inn.</p>
            }

            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>
                    <span class="login-field-label">E-postadresse</span>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input type="email" name="username" autocomplete="username" value="@Epost" placeholder="din@epost.no" required autofocus />
                    </div>
                </label>
                <label>
                    <div class="login-field-label-row">
                        <span class="login-field-label">Passord</span>
                        <a href="/glemt-passord">Glemt passord?</a>
                    </div>
                    <div class="login-field">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <input type="password" name="password" autocomplete="current-password" placeholder="Skriv inn passord" required />
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="login-field-eye"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </div>
                </label>
                <button type="submit" class="login-submit">
                    Logg inn
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </form>

            <script>
                (function () {
                    // Mobilvisning skal alltid starte på Oppgaver, uansett hvilken side
                    // man ev. ble sendt til /login fra (returnUrl). Tømmer feltet på
                    // mobil slik at serveren faller tilbake til "/", som i sin tur
                    // sender videre til /min-dag (se den blokkerende sjekken i App.razor).
                    if (window.matchMedia('(max-width: 640.98px)').matches) {
                        var felt = document.querySelector('input[name="returnUrl"]');
                        if (felt) {
                            felt.value = '';
                        }
                    }
                })();
            </script>

            <div class="login-foot-links">
                <a href="/finn-min-side">Finn min side</a>
                <a href="/sett-passord">Sett passord første gang</a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var elements = document.querySelectorAll('.login-reveal');
        if (!elements.length) {
            return;
        }
        if (!('IntersectionObserver' in window)) {
            elements.forEach(function (el) { el.classList.add('login-reveal-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('login-reveal-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });
        elements.forEach(function (el) { observer.observe(el); });
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "feil")]
    public string? Feil { get; set; }

    [SupplyParameterFromQuery(Name = "satt")]
    public string? Satt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }

    [SupplyParameterFromQuery(Name = "epost")]
    public string? Epost { get; set; }
}
