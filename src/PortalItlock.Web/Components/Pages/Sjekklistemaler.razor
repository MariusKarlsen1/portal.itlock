@page "/sjekklistemaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Sjekklistemaler</PageTitle>

@* SM1 (sjekklistemaler-forslag.html): dashbord-kort med malene i en meny inni,
   som Kravdimensjoner og Dørfunksjoner. Punktene er nummerert og kan flyttes
   med ▲▼ eller dras; alle endringer lagres fra lagre-linjen nederst. *@
<div class="sm @(_full ? "sm-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="check-circle" /></span>
            <div>
                <h1>Sjekklistemaler</h1>
                <p class="section-hint">Sjekklister per dørtype som montøren fyller ut på arbeidsordren. Punktene vises i rekkefølgen under.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="sm-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="sm-kort">
        <nav class="sm-meny">
            <label class="sm-sok">
                <Icon Name="search" />
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Finn mal eller punkt" />
            </label>
            <div class="sm-liste">
                @foreach (var mal in _filtrert)
                {
                    var id = mal.Id;
                    <button type="button" @key="mal.Id" class="@(mal.Id == _valgtId ? "pa" : "")" @onclick="@(() => Velg(id))">
                        <span class="sm-meny-ikon"><Icon Name="check-circle" /></span>
                        <span class="sm-navn">@(string.IsNullOrWhiteSpace(mal.Dortype) ? "(Uten dørtype)" : mal.Dortype)@(mal.Endret ? " •" : "")</span>
                        <small>@mal.Punkter.Count(p => !p.Slettet)</small>
                    </button>
                }
                @if (_filtrert.Count == 0)
                {
                    <p class="sm-dempet">@(_maler.Count == 0 ? "Ingen sjekklistemaler ennå." : "Ingen treff.")</p>
                }
            </div>
            <div class="sm-ny">
                <input @bind="_nyDortype" @bind:event="oninput" placeholder="＋ Ny sjekklistemal"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettMal(); } })" />
                @if (!string.IsNullOrWhiteSpace(_nyDortype))
                {
                    <button type="button" class="sm-knapp primaer" @onclick="OpprettMal">Opprett</button>
                }
            </div>
        </nav>

        <section class="sm-innhold">
            <button type="button" class="sm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>

            @if (_valgt is { } valgt)
            {
                var punkter = valgt.Punkter.Where(p => !p.Slettet).ToList();
                <div class="sm-topp">
                    <span class="sm-stort-ikon"><Icon Name="check-circle" /></span>
                    <div>
                        <h2>@(string.IsNullOrWhiteSpace(valgt.Dortype) ? "(Uten dørtype)" : valgt.Dortype)</h2>
                        <p>@punkter.Count @(punkter.Count == 1 ? "punkt" : "punkter")</p>
                    </div>
                    <span class="sm-topp-knapper">
                        <button type="button" class="sm-knapp" @onclick="@(() => DupliserMal(valgt))"><Icon Name="clipboard" />Dupliser</button>
                    </span>
                </div>

                <label class="sm-felt">
                    <span>Dørtype</span>
                    <input @bind="valgt.Dortype" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" placeholder="F.eks. Ytterdør" />
                </label>

                <span class="sm-seksjon">Punkter</span>
                <div class="sm-punkter">
                    @for (var i = 0; i < punkter.Count; i++)
                    {
                        var punkt = punkter[i];
                        var indeks = i;
                        <div @key="punkt" class="sm-punkt @(_dragPunkt == punkt ? "drar" : "")"
                             draggable="true"
                             @ondragstart="@(() => _dragPunkt = punkt)"
                             @ondragover="@(() => { })" @ondragover:preventDefault
                             @ondrop="@(() => Slipp(valgt, punkt))"
                             @ondragend="@(() => _dragPunkt = null)">
                            <span class="sm-grep" title="Dra for å endre rekkefølge">⠿</span>
                            <span class="sm-nr">@(indeks + 1)</span>
                            <input @bind="punkt.Tekst" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" />
                            <span class="sm-pil">
                                <button type="button" title="Flytt opp" disabled="@(indeks == 0)" @onclick="@(() => Flytt(valgt, punkt, -1))">▲</button>
                                <button type="button" title="Flytt ned" disabled="@(indeks == punkter.Count - 1)" @onclick="@(() => Flytt(valgt, punkt, 1))">▼</button>
                                <button type="button" class="sm-fjern" title="Fjern punkt" @onclick="@(() => FjernPunkt(valgt, punkt))"><Icon Name="x" /></button>
                            </span>
                        </div>
                    }
                    <div class="sm-punkt sm-punkt-ny">
                        <span></span>
                        <span class="sm-nr ny"><Icon Name="plus" /></span>
                        <input @bind="valgt.NyttPunkt" @bind:event="oninput" placeholder="Nytt punkt – trykk Enter"
                               @onkeydown="@(e => { if (e.Key == "Enter") { LeggTilPunkt(valgt); } })" />
                        @if (!string.IsNullOrWhiteSpace(valgt.NyttPunkt))
                        {
                            <button type="button" class="sm-knapp" @onclick="@(() => LeggTilPunkt(valgt))">Legg til</button>
                        }
                    </div>
                </div>

                <div class="sm-bunn">
                    @if (_bekreftSlett)
                    {
                        <span class="sm-dempet">Slette malen «@valgt.Dortype» med alle punktene?</span>
                        <button type="button" class="sm-knapp fare" @onclick="@(() => SlettMal(valgt))">Ja, slett</button>
                        <button type="button" class="sm-knapp" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                    }
                    else
                    {
                        <button type="button" class="sm-lenke" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett mal</button>
                    }
                </div>
            }
            else
            {
                <p class="sm-dempet">Velg en mal i menyen, eller lag en ny nederst i menyen.</p>
            }
        </section>
    </div>

    @if (_maler.Any(m => m.Endret))
    {
        var antall = _maler.Count(m => m.Endret);
        <div class="sm-lagrebar">
            <span><Icon Name="edit" /><b>Endringer i @antall @(antall == 1 ? "mal" : "maler")</b> er ikke lagret</span>
            <span class="sm-lagrebar-knapper">
                <button type="button" class="sm-knapp" @onclick="Forkast">Forkast</button>
                <button type="button" class="sm-knapp primaer" @onclick="LagreAlle"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class PunktDraft
    {
        public int Id { get; set; }
        public string Tekst { get; set; } = "";
        public bool Slettet { get; set; }
    }

    private sealed class MalDraft
    {
        public int Id { get; set; }
        public string Dortype { get; set; } = "";
        public List<PunktDraft> Punkter { get; set; } = [];
        public string NyttPunkt { get; set; } = "";
        public bool Endret { get; set; }
    }

    private List<MalDraft> _maler = [];
    private string _search = "";
    private string _nyDortype = "";
    private string? _melding;
    private string? _feil;
    private int? _valgtId;
    private bool _bekreftSlett;
    private bool _full;
    private PunktDraft? _dragPunkt;

    private MalDraft? _valgt => _maler.FirstOrDefault(m => m.Id == _valgtId);

    private List<MalDraft> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _maler
        : _maler.Where(m => m.Dortype.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || m.Punkter.Any(p => !p.Slettet && p.Tekst.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("sjekklistemaler-bredde", "normal") == "full";
        await LoadAsync();
        _valgtId = _maler.FirstOrDefault()?.Id;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("sjekklistemaler-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        var maler = await Db.SjekklisteMaler
            .Include(m => m.Punkter)
            .OrderBy(m => m.Dortype)
            .ToListAsync();

        _maler = maler.Select(m => new MalDraft
        {
            Id = m.Id,
            Dortype = m.Dortype,
            Punkter = m.Punkter.OrderBy(p => p.Rekkefolge).Select(p => new PunktDraft { Id = p.Id, Tekst = p.Tekst }).ToList()
        }).ToList();

        if (_valgtId is not null && _maler.All(m => m.Id != _valgtId))
        {
            _valgtId = _maler.FirstOrDefault()?.Id;
        }
    }

    private void Velg(int id)
    {
        _valgtId = id;
        _bekreftSlett = false;
        _feil = null;
    }

    private void LeggTilPunkt(MalDraft mal)
    {
        var tekst = mal.NyttPunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        mal.Punkter.Add(new PunktDraft { Tekst = tekst });
        mal.NyttPunkt = "";
        mal.Endret = true;
    }

    private void FjernPunkt(MalDraft mal, PunktDraft punkt)
    {
        if (punkt.Id == 0)
        {
            mal.Punkter.Remove(punkt);
        }
        else
        {
            punkt.Slettet = true;
        }

        mal.Endret = true;
    }

    private void Flytt(MalDraft mal, PunktDraft punkt, int retning)
    {
        var synlige = mal.Punkter.Where(p => !p.Slettet).ToList();
        var i = synlige.IndexOf(punkt);
        var j = i + retning;
        if (i < 0 || j < 0 || j >= synlige.Count)
        {
            return;
        }

        var a = mal.Punkter.IndexOf(synlige[i]);
        var b = mal.Punkter.IndexOf(synlige[j]);
        (mal.Punkter[a], mal.Punkter[b]) = (mal.Punkter[b], mal.Punkter[a]);
        mal.Endret = true;
    }

    private void Slipp(MalDraft mal, PunktDraft mal_punkt)
    {
        if (_dragPunkt is null || _dragPunkt == mal_punkt || !mal.Punkter.Contains(_dragPunkt))
        {
            _dragPunkt = null;
            return;
        }

        mal.Punkter.Remove(_dragPunkt);
        mal.Punkter.Insert(mal.Punkter.IndexOf(mal_punkt), _dragPunkt);
        _dragPunkt = null;
        mal.Endret = true;
    }

    private async Task Forkast()
    {
        _feil = null;
        _melding = null;
        await LoadAsync();
    }

    private async Task LagreAlle()
    {
        _feil = null;
        var endrede = _maler.Where(m => m.Endret).ToList();
        if (endrede.Any(m => string.IsNullOrWhiteSpace(m.Dortype)))
        {
            _feil = "Alle maler må ha en dørtype.";
            return;
        }

        if (endrede.Any(m => m.Punkter.Any(p => !p.Slettet && string.IsNullOrWhiteSpace(p.Tekst))))
        {
            _feil = "Punkter kan ikke stå tomme – skriv inn tekst eller fjern punktet.";
            return;
        }

        foreach (var draft in endrede)
        {
            var mal = await Db.SjekklisteMaler.Include(m => m.Punkter).FirstOrDefaultAsync(m => m.Id == draft.Id);
            if (mal is null)
            {
                continue;
            }

            mal.Dortype = draft.Dortype.Trim();
            var rekkefolge = 1;
            foreach (var p in draft.Punkter)
            {
                var entitet = p.Id == 0 ? null : mal.Punkter.FirstOrDefault(x => x.Id == p.Id);
                if (p.Slettet)
                {
                    if (entitet is not null)
                    {
                        Db.SjekklistePunkter.Remove(entitet);
                    }

                    continue;
                }

                if (entitet is null)
                {
                    mal.Punkter.Add(new SjekklistePunkt { Tekst = p.Tekst.Trim(), Rekkefolge = rekkefolge++ });
                }
                else
                {
                    entitet.Tekst = p.Tekst.Trim();
                    entitet.Rekkefolge = rekkefolge++;
                }
            }
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
        _melding = endrede.Count == 1 ? $"«{endrede[0].Dortype.Trim()}» er lagret." : $"{endrede.Count} maler er lagret.";
    }

    private async Task OpprettMal()
    {
        var dortype = _nyDortype.Trim();
        if (dortype.Length == 0)
        {
            return;
        }

        var nyMal = new SjekklisteMal { Dortype = dortype };
        Db.SjekklisteMaler.Add(nyMal);
        await Db.SaveChangesAsync();

        _nyDortype = "";
        _search = "";
        _feil = null;
        _melding = $"«{dortype}» er opprettet. Legg til punktene under.";
        await LastPaNyttBeholdEndringer();
        Velg(nyMal.Id);
    }

    private async Task DupliserMal(MalDraft mal)
    {
        var kopi = new SjekklisteMal { Dortype = $"{mal.Dortype.Trim()} (kopi)" };
        var rekkefolge = 1;
        foreach (var punkt in mal.Punkter.Where(p => !p.Slettet && !string.IsNullOrWhiteSpace(p.Tekst)))
        {
            kopi.Punkter.Add(new SjekklistePunkt { Tekst = punkt.Tekst.Trim(), Rekkefolge = rekkefolge++ });
        }

        Db.SjekklisteMaler.Add(kopi);
        await Db.SaveChangesAsync();

        _melding = $"«{kopi.Dortype}» er laget.";
        _feil = null;
        await LastPaNyttBeholdEndringer();
        Velg(kopi.Id);
    }

    private async Task SlettMal(MalDraft mal)
    {
        _bekreftSlett = false;
        var entitet = await Db.SjekklisteMaler.FirstOrDefaultAsync(m => m.Id == mal.Id);
        if (entitet is not null)
        {
            Db.SjekklisteMaler.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _melding = $"«{mal.Dortype}» er slettet.";
        _feil = null;
        _valgtId = null;
        await LastPaNyttBeholdEndringer();
        _valgtId = _maler.FirstOrDefault()?.Id;
    }

    // Laster listen på nytt uten å miste ulagrede endringer i andre maler.
    private async Task LastPaNyttBeholdEndringer()
    {
        var ulagret = _maler.Where(m => m.Endret).ToList();
        await LoadAsync();
        foreach (var m in ulagret)
        {
            var i = _maler.FindIndex(x => x.Id == m.Id);
            if (i >= 0)
            {
                _maler[i] = m;
            }
        }
    }
}
