@page "/rapporter/fakturaer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using PortalItlock.Web.Services
@inject TripletexService Tripletex

<PageTitle>Fakturaoversikt - Proxima</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="receipt" /></span>
    <div>
        <h1>Fakturaoversikt</h1>
        <p class="section-hint">
            Fakturaer sendt fra Tripletex for valgt periode, hentet direkte derfra -
            selve faktureringen skjer fortsatt manuelt inne i Tripletex, denne siden
            viser bare oversikten.
        </p>
    </div>
</div>

<div class="kort filter-kort">
    <label class="felt">
        <span class="felt-label">Fra</span>
        <input type="date" @bind="_fraDato" />
    </label>
    <label class="felt">
        <span class="felt-label">Til</span>
        <input type="date" @bind="_tilDato" />
    </label>
    <button type="button" class="knapp-primaer" @onclick="HentRapport" disabled="@_lasterNa">
        @(_lasterNa ? "Henter..." : "Vis fakturaer")
    </button>
</div>

@if (_feil is not null)
{
    <p class="form-error">@_feil</p>
}

@if (_harHentet)
{
    @if (_fakturaer.Count == 0)
    {
        <p class="list-empty">Ingen fakturaer i denne perioden.</p>
    }
    else
    {
        <div class="stat-rad">
            <div class="kort stat-kort">
                <span class="stat-label">Totalt fakturert</span>
                <span class="stat-verdi">@_fakturaer.Sum(f => f.Belop).ToString("N0", Kultur) kr</span>
            </div>
            <div class="kort stat-kort">
                <span class="stat-label">Utestående</span>
                <span class="stat-verdi stat-verdi-varsel">@_fakturaer.Sum(f => f.Utestaende).ToString("N0", Kultur) kr</span>
            </div>
            <div class="kort stat-kort">
                <span class="stat-label">Antall fakturaer</span>
                <span class="stat-verdi">@_fakturaer.Count</span>
            </div>
        </div>

        <div class="kort tabell-kort">
            <table class="rapport-table">
                <thead>
                    <tr>
                        <th>Fakturanr</th>
                        <th>Dato</th>
                        <th>Forfall</th>
                        <th>Kunde</th>
                        <th>Ordre</th>
                        <th class="tall-cell">Beløp</th>
                        <th class="tall-cell">Utestående</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _fakturaer)
                    {
                        <tr>
                            <td>@(f.Nummer?.ToString() ?? "-")</td>
                            <td>@(f.Dato?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(f.Forfallsdato?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(f.KundeNavn ?? "-")</td>
                            <td>@(f.OrdreNummer ?? "-")</td>
                            <td class="tall-cell">@f.Belop.ToString("N0", Kultur) kr</td>
                            <td class="tall-cell">@f.Utestaende.ToString("N0", Kultur) kr</td>
                            <td><span class="status-pille @StatusCss(f)">@StatusTekst(f)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private DateTime _fraDato = new(DateTime.Today.Year, 1, 1);
    private DateTime _tilDato = DateTime.Today;
    private bool _lasterNa;
    private bool _harHentet;
    private string? _feil;

    private List<TripletexService.TripletexFaktura> _fakturaer = [];

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _lasterNa = true;
        _feil = null;
        try
        {
            var (fakturaer, feil) = await Tripletex.HentFakturaerAsync(_fraDato, _tilDato);
            if (feil is not null)
            {
                _feil = feil;
                _fakturaer = [];
            }
            else
            {
                _fakturaer = fakturaer.OrderByDescending(f => f.Dato).ToList();
            }
            _harHentet = true;
        }
        finally
        {
            _lasterNa = false;
        }
    }

    private static string StatusTekst(TripletexService.TripletexFaktura f) => f.ErKreditnota
        ? "Kreditnota"
        : f.Utestaende <= 0 ? "Betalt" : "Ikke betalt";

    private static string StatusCss(TripletexService.TripletexFaktura f) => f.ErKreditnota
        ? "status-kreditnota"
        : f.Utestaende <= 0 ? "status-betalt" : "status-ikke-betalt";
}
