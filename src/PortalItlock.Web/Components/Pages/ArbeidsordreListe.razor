@page "/arbeidsordre"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje

<PageTitle>Arbeidsordre</PageTitle>

<div class="side-tittel ordre-header">
    <div class="ordre-header-tittel">
        <span class="ordre-header-ikon"><Icon Name="file-text" /></span>
        <h1>Arbeidsordre</h1>
    </div>
    <p class="ordre-intro">Opprett arbeidsordre med info om jobben og ansvarlig montør. Montører registrerer timer under Timeregistrering.</p>
</div>

<div class="ordre-toolbar">
    <label class="sok-felt ordre-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på tittel eller prosjekt" />
    </label>
    <div class="ordre-toolbar-knapper">
        <button type="button" class="add-button mobil-ny-ordre-skjul" @onclick="NyArbeidsordre"><Icon Name="plus" />Ny arbeidsordre</button>
        <AuthorizeView Roles="Admin,Prosjektleder">
            <a class="filter-button mobil-ny-ordre-skjul" href="/arbeidsordre/fakturert"><Icon Name="receipt" />Fakturerte ordre</a>
        </AuthorizeView>
        @if (!Verktoylinje.ErMobilvisning)
        {
            <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
                <Icon Name="filter" />Filtrer@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
            </button>
        }
    </div>
</div>

<AuthorizeView Roles="Admin,Prosjektleder">
    <div class="ordre-admin-lenker">
        <a class="back-link" href="/arbeidsordre/ferdigmeldte"><Icon Name="check-circle" />Ferdigmeldte prosjekter</a>
        <a class="back-link" href="/arbeidsordre/oversikt"><Icon Name="trend-up" />Faktureringsoversikt</a>
    </div>
</AuthorizeView>

@if (_visFilter)
{
    <div class="dor-velger-panel">
        <div class="dor-velger-header">
            <strong>Filtrer på status</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
        </div>
        <ul class="funksjon-chip-list">
            @foreach (var s in Enum.GetValues<ArbeidsordreStatus>().Where(s => s != ArbeidsordreStatus.Fakturert))
            {
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_valgteStatusFilter.Contains(s)" @onchange="@(() => ToggleStatusFilter(s))" />
                        @s.Visningsnavn()
                    </label>
                </li>
            }
        </ul>
        <label class="filter-option montor-filter">
            Ansvarlig montør
            <select value="@(_montorFilter?.ToString() ?? "")" @onchange="@(e => { _montorFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                <option value="">Alle</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
        </label>
        @if (AntallAktiveFiltre > 0)
        {
            <button type="button" class="cancel-button" @onclick="@(() => { _valgteStatusFilter.Clear(); _montorFilter = null; Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
        }
    </div>
}

@if (!Verktoylinje.ErMobilvisning && _rader.Count > 0)
{
    <div class="ordre-stats">
        <div class="ordre-stat">
            <span class="ordre-stat-tall">@_rader.Count</span>
            <span class="ordre-stat-etikett">Totalt</span>
        </div>
        <div class="ordre-stat">
            <span class="ordre-stat-tall ordre-stat-blaa">@_rader.Count(r => r.Status == ArbeidsordreStatus.Ny)</span>
            <span class="ordre-stat-etikett">Ny</span>
        </div>
        <div class="ordre-stat">
            <span class="ordre-stat-tall ordre-stat-gul">@_rader.Count(r => r.Status == ArbeidsordreStatus.Pagaende)</span>
            <span class="ordre-stat-etikett">Pågående</span>
        </div>
        <div class="ordre-stat">
            <span class="ordre-stat-tall ordre-stat-gronn">@_rader.Count(r => r.Status == ArbeidsordreStatus.Ferdig)</span>
            <span class="ordre-stat-etikett">Ferdig</span>
        </div>
    </div>
}

@if (_rader.Count > 0)
{
    <p class="result-count">@_filtrert.Count av @_rader.Count arbeidsordre</p>
}

@if (_rader.Count == 0)
{
    <p class="list-empty mobil-tom-tekst-skjul">@(_naverendeRolle == BrukerRolle.Montor ? "Ingen arbeidsordre tildelt deg ennå." : "Ingen arbeidsordre opprettet ennå.")</p>
    <div class="mobil-ordre-tom">
        <svg class="mobil-tom-figur" viewBox="0 0 120 100" width="120" height="100" xmlns="http://www.w3.org/2000/svg">
            <rect x="14" y="42" width="92" height="46" rx="6" fill="#ffffff" stroke="#835e41" stroke-width="3" />
            <path d="M40 42 V30 Q40 22 48 22 H72 Q80 22 80 30 V42" fill="none" stroke="#835e41" stroke-width="3" />
            <rect x="14" y="58" width="92" height="12" fill="#f4f0e9" />
            <circle cx="60" cy="64" r="7" fill="#ffffff" stroke="#835e41" stroke-width="3" />
            <line x1="60" y1="60" x2="60" y2="68" stroke="#835e41" stroke-width="2" stroke-linecap="round" />
            <line x1="56" y1="64" x2="64" y2="64" stroke="#835e41" stroke-width="2" stroke-linecap="round" />
        </svg>
        <h2>Ingen arbeidsordre</h2>
        <p>@(_naverendeRolle == BrukerRolle.Montor ? "Du har ingen arbeidsordre tildelt ennå." : "Nye arbeidsordre dukker opp her når de opprettes.")</p>
    </div>
}
else if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen arbeidsordre funnet.</p>
}
else
{
    <div class="ordre-grid">
        @foreach (var r in _filtrert)
        {
            <a @key="r.Id" class="ordre-kort ordre-kort-@r.Status.PillFarge()" href="@($"/arbeidsordre/{r.Id}")">
                <div class="ordre-kort-topp">
                    <span class="ordre-kort-tittel">@r.Tittel</span>
                    <StatusPill Tekst="@r.Status.Visningsnavn()" Ikon="@r.Status.PillIkon()" Farge="@r.Status.PillFarge()" />
                </div>
                <div class="ordre-kort-linje">
                    <Icon Name="folder" />
                    <span>@(r.ProsjektNavn ?? "Ikke satt prosjekt")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                {
                    <div class="ordre-kort-linje">
                        <Icon Name="tool" />
                        <span>@r.AnsvarligMontorNavn</span>
                    </div>
                }
                <div class="ordre-kort-bunn">
                    <span class="ordre-timer-badge"><Icon Name="clock" />@r.SumTimer.ToString("N1", Kultur) t</span>
                </div>
            </a>
        }
    </div>

    <ul class="mobil-ordre-liste">
        @foreach (var r in _filtrert)
        {
            <li @key="r.Id" class="mobil-ordre-kort mobil-kant-@r.Status.PillFarge()">
                <a href="@($"/arbeidsordre/{r.Id}")">
                    <div class="mobil-ordre-topp">
                        <span class="mobil-ordre-tittel">@r.Tittel</span>
                        <StatusPill Tekst="@r.Status.Visningsnavn()" Ikon="@r.Status.PillIkon()" Farge="@r.Status.PillFarge()" />
                    </div>
                    <div class="mobil-ordre-meta">
                        @(r.ProsjektNavn ?? "Ikke satt prosjekt") &middot; @r.SumTimer.ToString("N1", Kultur) t
                        @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                        {
                            <text> &middot; @r.AnsvarligMontorNavn</text>
                        }
                    </div>
                </a>
            </li>
        }
    </ul>
}

@code {
    private sealed class ArbeidsordreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public decimal SumTimer { get; set; }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private List<ArbeidsordreRad> _rader = [];
    private List<Bruker> _alleBrukere = [];
    private string _search = "";
    private HashSet<ArbeidsordreStatus> _valgteStatusFilter = [];
    private int? _montorFilter;
    private bool _visFilter;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private int AntallAktiveFiltre => _valgteStatusFilter.Count + (_montorFilter.HasValue ? 1 : 0);

    private List<ArbeidsordreRad> _filtrert => _rader
        .Where(r => string.IsNullOrWhiteSpace(_search) ||
                r.Tittel.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (r.ProsjektNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(r => _valgteStatusFilter.Count == 0 || _valgteStatusFilter.Contains(r.Status))
        .Where(r => _montorFilter is null || r.AnsvarligMontorId == _montorFilter)
        .ToList();

    private void ToggleStatusFilter(ArbeidsordreStatus status)
    {
        if (!_valgteStatusFilter.Add(status))
        {
            _valgteStatusFilter.Remove(status);
        }
        Verktoylinje.VarsleEndring();
    }

    protected override async Task OnInitializedAsync()
    {
        // Mobilvisning avgjøres sentralt av MainLayout (se kommentar der) og
        // leses herfra via Verktoylinje.ErMobilvisning - unngår at hver side
        // må gjøre sin egen (langsommere) deteksjon ved hver navigasjon.
        Verktoylinje.Endret += OnVerktoylinjeEndret;

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        IQueryable<Arbeidsordre> query = Db.Arbeidsordre.Where(a => a.Status != ArbeidsordreStatus.Fakturert);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            query = query.Where(a => a.AnsvarligMontorId == _naverendeBrukerId);
        }

        var ordre = await query
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _rader = ordre.Select(a => new ArbeidsordreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNavn = a.Prosjekt?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            AnsvarligMontorId = a.AnsvarligMontorId,
            Status = a.Status,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer)
        }).ToList();

        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();

        Verktoylinje.RegistrerFilter(
            () => { _visFilter = !_visFilter; StateHasChanged(); },
            () => AntallAktiveFiltre > 0);
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        Verktoylinje.AvregistrerFilter();
    }

    private async Task NyArbeidsordre()
    {
        var ordre = new Arbeidsordre { Tittel = "Ny arbeidsordre" };
        Db.Arbeidsordre.Add(ordre);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/arbeidsordre/{ordre.Id}");
    }
}
