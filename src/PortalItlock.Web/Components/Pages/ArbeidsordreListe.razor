@page "/arbeidsordre"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject PortalItlock.Web.Services.GeocodingService Geokoding
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref
@inject IJSRuntime JS

<PageTitle>Arbeidsordre</PageTitle>

<div class="arbeidsordre-side">

    <div class="side-tittel ordre-header">
        <div class="ordre-header-tittel">
            <span class="ordre-header-ikon"><Icon Name="file-text" /></span>
            <h1>Arbeidsordre</h1>
        </div>
        <p class="ordre-intro">@(_visning switch
        {
            "kanban" => "Opprett, tildel og følg opp arbeidsordre. Dra og slipp mellom status.",
            "kart" => "Se alle arbeidsordre på kartet. Klikk på markører for å se detaljer.",
            _ => "Full oversikt over alle arbeidsordre med mulighet for sortering og filtrering."
        })</p>
    </div>

    <div class="ordre-toolbar">
        <label class="sok-felt ordre-sok">
            <Icon Name="search" />
            <input @bind="_search" @bind:event="oninput" placeholder="Søk etter arbeidsordre, prosjekt, kunde eller montør..." />
        </label>
        <div class="ordre-toolbar-knapper">
            <div class="ao-viewtoggle mobil-ny-ordre-skjul">
                <button type="button" class="@(_visning == "kanban" ? "aktiv" : "")" @onclick="@(() => VelgVisning("kanban"))"><Icon Name="box" />Kanban</button>
                <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick="@(() => VelgVisning("liste"))"><Icon Name="file-text" />Liste</button>
                <button type="button" class="@(_visning == "kart" ? "aktiv" : "")" @onclick="VelgKartvisning"><Icon Name="map" />Kart</button>
            </div>
            <button type="button" class="add-button mobil-ny-ordre-skjul" @onclick="NyArbeidsordre"><Icon Name="plus" />Ny arbeidsordre</button>
            <AuthorizeView Roles="Admin,Prosjektleder">
                <a class="filter-button mobil-ny-ordre-skjul" href="/arbeidsordre/fakturert"><Icon Name="receipt" />Fakturerte ordre</a>
            </AuthorizeView>
            @if (!Verktoylinje.ErMobilvisning)
            {
                <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
                    <Icon Name="filter" />Filter@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
                </button>
            }
        </div>
    </div>

    <AuthorizeView Roles="Admin,Prosjektleder">
        <div class="ordre-admin-lenker">
            <a class="back-link" href="/arbeidsordre/ferdigmeldte"><Icon Name="check-circle" />Ferdigmeldte prosjekter</a>
            <a class="back-link" href="/arbeidsordre/oversikt"><Icon Name="trend-up" />Faktureringsoversikt</a>
        </div>
    </AuthorizeView>

    @if (_visFilter)
    {
        <div class="dor-velger-panel">
            <div class="dor-velger-header">
                <strong>Filtrer</strong>
                <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
            </div>
            <ul class="funksjon-chip-list">
                @foreach (var s in Enum.GetValues<ArbeidsordreStatus>().Where(s => s != ArbeidsordreStatus.Fakturert))
                {
                    <li>
                        <label class="filter-option">
                            <input type="checkbox" checked="@_valgteStatusFilter.Contains(s)" @onchange="@(() => ToggleStatusFilter(s))" />
                            @s.Visningsnavn()
                        </label>
                    </li>
                }
            </ul>
            <label class="filter-option montor-filter">
                Ansvarlig montør
                <select value="@(_montorFilter?.ToString() ?? "")" @onchange="@(e => { _montorFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                    <option value="">Alle</option>
                    @foreach (var b in _alleBrukere)
                    {
                        <option value="@b.Id">@b.Navn</option>
                    }
                </select>
            </label>
            @if (AntallAktiveFiltre > 0)
            {
                <button type="button" class="cancel-button" @onclick="@(() => { _valgteStatusFilter.Clear(); _montorFilter = null; Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
            }
        </div>
    }

    @if (!Verktoylinje.ErMobilvisning && _rader.Count > 0 && _visning == "kart")
    {
        <div class="ao-pillrow">
            <button type="button" class="ao-pill ao-pill-aktiv @(_kartStatusFilter == "alle" ? "valgt" : "")" @onclick='@(() => _kartStatusFilter = "alle")'>Alle <span>(@_filtrert.Count)</span></button>
            @foreach (var s in TavleStatuser)
            {
                <button type="button" class="ao-pill ao-pill-@KolonneFarge(s) @(_kartStatusFilter == s ? "valgt" : "")" @onclick="@(() => _kartStatusFilter = s)">
                    <span class="ao-pill-prikk"></span>@s
                </button>
            }
            <select class="ao-filter-select" value="@(_montorRadFilter?.ToString() ?? "")" @onchange="@(e => { _montorRadFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); })">
                <option value="">Montør</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
            <select class="ao-filter-select" value="@(_prosjektFilter?.ToString() ?? "")" @onchange="@(e => { _prosjektFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); })">
                <option value="">Prosjekt</option>
                @foreach (var p in _alleProsjekter)
                {
                    <option value="@p.Id">@p.Navn</option>
                }
            </select>
        </div>
    }

    @if (!Verktoylinje.ErMobilvisning && _rader.Count > 0 && _visning != "kart")
    {
        @if (_visning == "liste")
        {
            <div class="ao-statrow">
                <button type="button" class="ao-statcard @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
                    <span class="ao-statcard-ic ao-ic-noytral"><Icon Name="file-text" /></span>
                    <span><span class="ao-statcard-num">@AntallApne</span><span class="ao-statcard-lbl">Alle åpne</span></span>
                </button>
                <button type="button" class="ao-statcard @(_hurtigfilter == "forfalt" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("forfalt"))'>
                    <span class="ao-statcard-ic ao-ic-rod"><Icon Name="clock" /></span>
                    <span><span class="ao-statcard-num">@AntallForfalt</span><span class="ao-statcard-lbl">Forfalt</span></span>
                </button>
                <button type="button" class="ao-statcard @(_hurtigfilter == "utenmontor" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("utenmontor"))'>
                    <span class="ao-statcard-ic ao-ic-lilla"><Icon Name="users" /></span>
                    <span><span class="ao-statcard-num">@AntallUtenMontor</span><span class="ao-statcard-lbl">Uten montør</span></span>
                </button>
                <button type="button" class="ao-statcard @(_hurtigfilter == "fullfortuke" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("fullfortuke"))'>
                    <span class="ao-statcard-ic ao-ic-gronn"><Icon Name="check-circle" /></span>
                    <span><span class="ao-statcard-num">@AntallFullfortUke</span><span class="ao-statcard-lbl">Fullført denne uken</span></span>
                </button>
            </div>
        }

        <div class="ao-filterrow">
            <select class="ao-filter-select" value="@(_prosjektFilter?.ToString() ?? "")" @onchange="@(e => { _prosjektFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); _side = 1; })">
                <option value="">Prosjekt</option>
                @foreach (var p in _alleProsjekter)
                {
                    <option value="@p.Id">@p.Navn</option>
                }
            </select>
            <select class="ao-filter-select" value="@(_kundeFilter?.ToString() ?? "")" @onchange="@(e => { _kundeFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); _side = 1; })">
                <option value="">Kunde</option>
                @foreach (var k in _alleKunder)
                {
                    <option value="@k.Id">@k.Navn</option>
                }
            </select>
            <select class="ao-filter-select" value="@(_montorRadFilter?.ToString() ?? "")" @onchange="@(e => { _montorRadFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); _side = 1; })">
                <option value="">Montør</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
            @if (_visning == "liste")
            {
                <select class="ao-filter-select" value="@(_statusFilterListe?.ToString() ?? "")" @onchange="@(e => { _statusFilterListe = string.IsNullOrEmpty(e.Value as string) ? null : Enum.Parse<ArbeidsordreStatus>((string)e.Value!); _side = 1; })">
                    <option value="">Status</option>
                    @foreach (var s in Enum.GetValues<ArbeidsordreStatus>().Where(s => s != ArbeidsordreStatus.Fakturert))
                    {
                        <option value="@s">@s.Visningsnavn()</option>
                    }
                </select>
            }
            <select class="ao-filter-select" value="@(_prioritetFilter?.ToString() ?? "")" @onchange="@(e => { _prioritetFilter = string.IsNullOrEmpty(e.Value as string) ? null : Enum.Parse<ArbeidsordrePrioritet>((string)e.Value!); _side = 1; })">
                <option value="">Prioritet</option>
                @foreach (var p in Enum.GetValues<ArbeidsordrePrioritet>())
                {
                    <option value="@p">@p.Visningsnavn()</option>
                }
            </select>
            <select class="ao-filter-select" value="@_datoFilter" @onchange="@(e => { _datoFilter = (string)e.Value!; _side = 1; })">
                <option value="alle">Dato</option>
                <option value="denneuken">Denne uken</option>
                <option value="dennemaneden">Denne måneden</option>
                <option value="forfalt">Forfalt</option>
            </select>
            @if (HarRadFiltre)
            {
                <button type="button" class="ao-filter-nullstill" @onclick="NullstillRadFiltre"><Icon Name="x" />Nullstill</button>
            }
        </div>
    }

    @if (_rader.Count > 0 && _visning == "liste")
    {
        <p class="result-count">@_filtrert.Count av @_rader.Count arbeidsordre</p>
    }

    @if (_rader.Count == 0)
    {
        <p class="list-empty mobil-tom-tekst-skjul">@(_naverendeRolle == BrukerRolle.Montor ? "Ingen arbeidsordre tildelt deg ennå." : "Ingen arbeidsordre opprettet ennå.")</p>
        <div class="mobil-ordre-tom">
            <svg class="mobil-tom-figur" viewBox="0 0 120 100" width="120" height="100" xmlns="http://www.w3.org/2000/svg">
                <rect x="14" y="42" width="92" height="46" rx="6" fill="#ffffff" stroke="#835e41" stroke-width="3" />
                <path d="M40 42 V30 Q40 22 48 22 H72 Q80 22 80 30 V42" fill="none" stroke="#835e41" stroke-width="3" />
                <rect x="14" y="58" width="92" height="12" fill="#f4f0e9" />
                <circle cx="60" cy="64" r="7" fill="#ffffff" stroke="#835e41" stroke-width="3" />
                <line x1="60" y1="60" x2="60" y2="68" stroke="#835e41" stroke-width="2" stroke-linecap="round" />
                <line x1="56" y1="64" x2="64" y2="64" stroke="#835e41" stroke-width="2" stroke-linecap="round" />
            </svg>
            <h2>Ingen arbeidsordre</h2>
            <p>@(_naverendeRolle == BrukerRolle.Montor ? "Du har ingen arbeidsordre tildelt ennå." : "Nye arbeidsordre dukker opp her når de opprettes.")</p>
        </div>
    }
    else if (_filtrert.Count == 0)
    {
        <p class="list-empty">Ingen arbeidsordre funnet.</p>
    }
    else
    {
        @if (!Verktoylinje.ErMobilvisning && _visning == "kanban")
        {
            <div class="ordre-tavle ao-tavle-4">
                @foreach (var status in TavleStatuser)
                {
                    var ordreIKolonne = OrdreForStatus(status);
                    var kolonneFarge = KolonneFarge(status);
                    <div class="kolonne kolonne-@kolonneFarge"
                         @ondragover:preventDefault="@(status != "Forfalt")"
                         @ondrop="@(() => SlippPaKolonne(status))" @ondrop:preventDefault="true">
                        <div class="kolonne-header-wrap">
                            <div class="kolonne-header">
                                <span>@status</span>
                                <span class="kolonne-antall">@ordreIKolonne.Count</span>
                            </div>
                            <span class="kolonne-sum">@ordreIKolonne.Sum(r => r.SumTimer).ToString("N1", Kultur) t logget</span>
                        </div>
                        <div class="kort-stabel">
                            @if (ordreIKolonne.Count == 0)
                            {
                                <div class="kolonne-tom">
                                    <Icon Name="check-circle" />
                                    <span>Ingen her akkurat nå</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var r in ordreIKolonne)
                                {
                                    <a @key="r.Id" class="ordre-kort ordre-kort-@kolonneFarge"
                                       href="@($"/arbeidsordre/{r.Id}")"
                                       draggable="@(status != "Forfalt" ? "true" : "false")"
                                       @ondragstart="@(() => _dratOrdreId = r.Id)">
                                        <span class="ordre-kort-topp">
                                            <span class="ordre-kort-tittel">@r.Tittel</span>
                                            <StatusPill Tekst="@r.Prioritet.Visningsnavn()" Ikon="@r.Prioritet.PillIkon()" Farge="@r.Prioritet.PillFarge()" />
                                        </span>
                                        <span class="ordre-kort-linje">
                                            <Icon Name="folder" />
                                            <span>@(r.ProsjektNavn ?? "Ikke satt prosjekt")</span>
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(r.KundeNavn))
                                        {
                                            <span class="ordre-kort-linje">
                                                <Icon Name="users" />
                                                <span>@r.KundeNavn</span>
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                                        {
                                            <span class="ordre-montor-rad">
                                                <span class="ordre-avatar" style="background:@MontorFarge(r.AnsvarligMontorNavn)">@MontorInitialer(r.AnsvarligMontorNavn)</span>
                                                <span class="ordre-montor-navn">@r.AnsvarligMontorNavn</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ordre-montor-tom">Ikke tildelt montør</span>
                                        }
                                        <div class="ordre-kort-bunn">
                                            @{ var datoTekst = DatoBadgeTekst(r); }
                                            @if (datoTekst is not null)
                                            {
                                                <span class="ordre-dato-badge @(ErForfalt(r) ? "ordre-dato-badge-forfalt" : "")">
                                                    <Icon Name="calendar" />@datoTekst
                                                </span>
                                            }
                                            <span class="ordre-timer-badge"><Icon Name="clock" />@r.SumTimer.ToString("N1", Kultur) t</span>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                        @if (status == "Ferdig" && ordreIKolonne.Count > 0)
                        {
                            <p class="kolonne-fotnote">Fakturer en ferdig ordre for å flytte den til <a href="/arbeidsordre/fakturert">Fakturerte ordre</a></p>
                        }
                        <button type="button" class="kolonne-legg-til" @onclick="NyArbeidsordre"><Icon Name="plus" />Legg til</button>
                    </div>
                }
            </div>
        }

        @if (!Verktoylinje.ErMobilvisning && _visning == "liste")
        {
            <div class="ao-tablewrap">
                <table class="ao-table">
                    <thead>
                        <tr class="ao-thr">
                            <th class="ao-th-sjekk"><input type="checkbox" /></th>
                            <th>#</th>
                            <th>Tittel</th>
                            <th>Prosjekt</th>
                            <th>Kunde</th>
                            <th>Montør</th>
                            <th>Status</th>
                            <th>Frist</th>
                            <th>Timer</th>
                            <th>Prioritet</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _sidevisning)
                        {
                            <tr @key="r.Id" class="ao-tr" @onclick="@(() => Nav.NavigateTo($"/arbeidsordre/{r.Id}"))">
                                <td class="ao-th-sjekk" @onclick:stopPropagation="true"><input type="checkbox" /></td>
                                <td class="ao-td-id">#@r.Id</td>
                                <td class="ao-td-tittel">@r.Tittel</td>
                                <td>@(r.ProsjektNavn ?? "-")</td>
                                <td>@(r.KundeNavn ?? "-")</td>
                                <td>@(r.AnsvarligMontorNavn ?? "-")</td>
                                <td><StatusPill Tekst="@r.Status.Visningsnavn()" Ikon="@r.Status.PillIkon()" Farge="@r.Status.PillFarge()" /></td>
                                <td class="@(ErForfalt(r) ? "ao-td-forfalt" : "")">@(r.PlanlagtDato?.ToString("d. MMM", Kultur) ?? "-")</td>
                                <td>@r.SumTimer.ToString("N1", Kultur)</td>
                                <td><StatusPill Tekst="@r.Prioritet.Visningsnavn()" Ikon="@r.Prioritet.PillIkon()" Farge="@r.Prioritet.PillFarge()" /></td>
                                <td class="ao-td-meny" @onclick:stopPropagation="true"><a href="@($"/arbeidsordre/{r.Id}")" class="ao-meny-knapp">⋯</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ao-pagerad">
                <span class="ao-pagerad-tekst">Viser @(((_side - 1) * _sideStorrelse) + 1)-@(Math.Min(_side * _sideStorrelse, _filtrert.Count)) av @_filtrert.Count</span>
                <div class="ao-pager">
                    <button type="button" disabled="@(_side <= 1)" @onclick="@(() => _side--)"><Icon Name="chevron-down" /></button>
                    @for (var i = 1; i <= AntallSider; i++)
                    {
                        var side = i;
                        <button type="button" class="@(side == _side ? "aktiv" : "")" @onclick="@(() => _side = side)">@side</button>
                    }
                    <button type="button" disabled="@(_side >= AntallSider)" @onclick="@(() => _side++)"><Icon Name="chevron-down" /></button>
                </div>
                <select class="ao-filter-select ao-sidestorrelse" value="@_sideStorrelse" @onchange="@(e => { _sideStorrelse = int.Parse((string)e.Value!); _side = 1; })">
                    <option value="10">Vis 10</option>
                    <option value="25">Vis 25</option>
                    <option value="50">Vis 50</option>
                </select>
            </div>
        }

        @if (!Verktoylinje.ErMobilvisning && _visning == "kart")
        {
            <div class="ao-kartside">
                <div class="ao-kartliste">
                    @if (_kartFiltrert.Count == 0)
                    {
                        <p class="list-empty">Ingen arbeidsordre funnet.</p>
                    }
                    else
                    {
                        @foreach (var r in _kartFiltrert)
                        {
                            <button type="button" @key="r.Id" class="ao-kartkort ao-kartkort-@KolonneFargeForRad(r)" @onclick="@(() => FremhevPaKart(r.Id))">
                                <span class="ao-kartkort-tittel">@r.Tittel</span>
                                <span class="ao-kartkort-adresse">@(KartAdresse(r) ?? r.ProsjektNavn ?? "Ingen adresse")</span>
                                <StatusPill Tekst="@(ErForfalt(r) ? "Forfalt" : r.Status.Visningsnavn())" Ikon="@(ErForfalt(r) ? "clock" : r.Status.PillIkon())" Farge="@(ErForfalt(r) ? "rod" : r.Status.PillFarge())" />
                            </button>
                        }
                    }
                </div>
                <div class="ao-kartwrap">
                    <div id="ao-kart" class="ao-kart"></div>
                </div>
            </div>
        }

        <ul class="mobil-ordre-liste">
            @foreach (var r in _filtrert)
            {
                <li @key="r.Id" class="mobil-ordre-kort mobil-kant-@r.Status.PillFarge()">
                    <a href="@($"/arbeidsordre/{r.Id}")">
                        <div class="mobil-ordre-topp">
                            <span class="mobil-ordre-tittel">@r.Tittel</span>
                            <StatusPill Tekst="@r.Status.Visningsnavn()" Ikon="@r.Status.PillIkon()" Farge="@r.Status.PillFarge()" />
                        </div>
                        <div class="mobil-ordre-meta">
                            @(r.ProsjektNavn ?? "Ikke satt prosjekt") &middot; @r.SumTimer.ToString("N1", Kultur) t
                            @if (!string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn))
                            {
                                <text> &middot; @r.AnsvarligMontorNavn</text>
                            }
                        </div>
                    </a>
                </li>
            }
        </ul>
    }

</div>

@code {
    private sealed class ArbeidsordreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public int? ProsjektId { get; set; }
        public string? ProsjektNavn { get; set; }
        public int? KundeId { get; set; }
        public string? KundeNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public ArbeidsordrePrioritet Prioritet { get; set; }
        public decimal SumTimer { get; set; }
        public DateTime OpprettetDato { get; set; }
        public DateTime? PlanlagtDato { get; set; }
        public DateTime? FullfortDato { get; set; }

        // Brukes kun av kartvisningen - Arbeidsordre sin egen adresse har
        // forrang, med Prosjekt sin som fallback (samme mønster som
        // KundeNavn over), siden mange ordre ikke har adresse satt direkte.
        public string? Adresse { get; set; }
        public string? Postnr { get; set; }
        public string? Sted { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    // Tavlen viser fire kolonner: Ny, Pågående, Ferdig og Forfalt (ikke en
    // ekte status - en beregnet tilstand som plukkes ut av Ny/Pågående når
    // fristen er passert, se OrdreForStatus). Status Klar regnes med i
    // "Ny"-kolonnen - egen kolonne holdes ikke for den, siden den brukes
    // sjelden. Fakturert har sin egen side/liste under "Fakturerte ordre".
    private static readonly string[] TavleStatuser = ["Ny", "Pågående", "Ferdig", "Forfalt"];

    private static readonly string[] MontorPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<ArbeidsordreRad> _rader = [];
    private List<Bruker> _alleBrukere = [];
    private List<Prosjekt> _alleProsjekter = [];
    private List<Kunde> _alleKunder = [];
    private string _search = "";
    private HashSet<ArbeidsordreStatus> _valgteStatusFilter = [];
    private int? _montorFilter;
    private bool _visFilter;
    private string _hurtigfilter = "alle";
    private string _visning = "kanban";
    private string _kartStatusFilter = "alle";
    private bool _kartLastet;
    private bool _kartInitialisert;
    private string? _sisteKartSignatur;

    // Rad-nivå filtre (den nye filterraden - Prosjekt/Kunde/Montør/Status/
    // Prioritet/Dato - delt mellom begge visningene, i tillegg til det
    // eldre filterpanelet over).
    private int? _prosjektFilter;
    private int? _kundeFilter;
    private int? _montorRadFilter;
    private ArbeidsordreStatus? _statusFilterListe;
    private ArbeidsordrePrioritet? _prioritetFilter;
    private string _datoFilter = "alle";
    private int _side = 1;
    private int _sideStorrelse = 10;
    private int? _dratOrdreId;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private int AntallAktiveFiltre => _valgteStatusFilter.Count + (_montorFilter.HasValue ? 1 : 0);

    private bool HarRadFiltre => _prosjektFilter.HasValue || _kundeFilter.HasValue || _montorRadFilter.HasValue
        || _statusFilterListe.HasValue || _prioritetFilter.HasValue || _datoFilter != "alle";

    private void NullstillRadFiltre()
    {
        _prosjektFilter = null;
        _kundeFilter = null;
        _montorRadFilter = null;
        _statusFilterListe = null;
        _prioritetFilter = null;
        _datoFilter = "alle";
        _side = 1;
    }

    private List<ArbeidsordreRad> _basisFiltrert => _rader
        .Where(r => string.IsNullOrWhiteSpace(_search) ||
                r.Tittel.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (r.ProsjektNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.KundeNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.AnsvarligMontorNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(r => _valgteStatusFilter.Count == 0 || _valgteStatusFilter.Contains(r.Status))
        .Where(r => _montorFilter is null || r.AnsvarligMontorId == _montorFilter)
        .Where(r => _prosjektFilter is null || r.ProsjektId == _prosjektFilter)
        .Where(r => _kundeFilter is null || r.KundeId == _kundeFilter)
        .Where(r => _montorRadFilter is null || r.AnsvarligMontorId == _montorRadFilter)
        .Where(r => _statusFilterListe is null || r.Status == _statusFilterListe)
        .Where(r => _prioritetFilter is null || r.Prioritet == _prioritetFilter)
        .Where(r => _datoFilter switch
        {
            "forfalt" => ErForfalt(r),
            "denneuken" => r.PlanlagtDato.HasValue && r.PlanlagtDato.Value.Date >= FinnForrigeMandag(DateTime.Today) && r.PlanlagtDato.Value.Date < FinnForrigeMandag(DateTime.Today).AddDays(7),
            "dennemaneden" => r.PlanlagtDato.HasValue && r.PlanlagtDato.Value.Year == DateTime.Today.Year && r.PlanlagtDato.Value.Month == DateTime.Today.Month,
            _ => true
        })
        .ToList();

    private List<ArbeidsordreRad> _filtrert => _basisFiltrert
        .Where(r => _hurtigfilter switch
        {
            "forfalt" => ErForfalt(r),
            "utenmontor" => r.AnsvarligMontorId is null && r.Status != ArbeidsordreStatus.Ferdig,
            "fullfortuke" => r.Status == ArbeidsordreStatus.Ferdig && r.FullfortDato.HasValue && r.FullfortDato.Value.Date >= DateTime.Today.AddDays(-6),
            _ => true
        })
        .ToList();

    private List<ArbeidsordreRad> _sidevisning => _filtrert
        .Skip((_side - 1) * _sideStorrelse)
        .Take(_sideStorrelse)
        .ToList();

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(_filtrert.Count / (double)_sideStorrelse));

    private List<ArbeidsordreRad> _kartFiltrert => _filtrert
        .Where(r => _kartStatusFilter switch
        {
            "Ny" => !ErForfalt(r) && (r.Status == ArbeidsordreStatus.Ny || r.Status == ArbeidsordreStatus.Klar),
            "Pågående" => !ErForfalt(r) && r.Status == ArbeidsordreStatus.Pagaende,
            "Ferdig" => r.Status == ArbeidsordreStatus.Ferdig,
            "Forfalt" => ErForfalt(r),
            _ => true
        })
        .ToList();

    private static string? KartAdresse(ArbeidsordreRad r) =>
        string.IsNullOrWhiteSpace(r.Adresse) ? null : $"{r.Adresse}{(string.IsNullOrWhiteSpace(r.Sted) ? "" : $", {r.Sted}")}";

    private static string KolonneFargeForRad(ArbeidsordreRad r) => r switch
    {
        _ when ErForfalt(r) => "rod",
        { Status: ArbeidsordreStatus.Ferdig } => "gronn",
        { Status: ArbeidsordreStatus.Pagaende } => "gul",
        _ => "blaa"
    };

    private static string HexForFarge(string farge) => farge switch
    {
        "blaa" => "#0b66e6",
        "gul" => "#fd7a17",
        "gronn" => "#0c9c5c",
        "rod" => "#d13a3a",
        _ => "#835e41"
    };

    private static string HexBgForFarge(string farge) => farge switch
    {
        "blaa" => "#dbe7f7",
        "gul" => "#fde7d3",
        "gronn" => "#d3ecdb",
        "rod" => "#f9dcdc",
        _ => "#eee7df"
    };

    private async Task FremhevPaKart(int id) => await JS.InvokeVoidAsync("kart.fremhev", id);

    private List<object> KartPunkter() => _kartFiltrert
        .Where(r => r.Latitude is not null && r.Longitude is not null)
        .Select(r =>
        {
            var farge = KolonneFargeForRad(r);
            return (object)new
            {
                id = r.Id,
                lat = r.Latitude!.Value,
                lng = r.Longitude!.Value,
                tittel = r.Tittel,
                undertekst = KartAdresse(r) ?? r.ProsjektNavn ?? "",
                undertekst2 = string.IsNullOrWhiteSpace(r.AnsvarligMontorNavn) ? null : r.AnsvarligMontorNavn,
                farge = HexForFarge(farge),
                pin = true,
                rikPopup = true,
                statusTekst = ErForfalt(r) ? "Forfalt" : r.Status.Visningsnavn(),
                statusBg = HexBgForFarge(farge),
                datoTekst = DatoBadgeTekst(r),
                timerTekst = r.SumTimer > 0 ? $"{r.SumTimer.ToString("N1", Kultur)} t" : null,
                href = $"/arbeidsordre/{r.Id}"
            };
        })
        .ToList();

    // Henter adresse (egen eller arvet fra Prosjekt) og geokoder de som
    // mangler lagret posisjon - kun kjørt første gang kartvisningen åpnes,
    // for å ikke belaste Kanban/liste-brukere med dette unødig.
    private async Task LastInnKartData()
    {
        if (_kartLastet)
        {
            return;
        }
        _kartLastet = true;

        var ider = _rader.Select(r => r.Id).ToList();
        var ordre = await Db.Arbeidsordre
            .Where(a => ider.Contains(a.Id))
            .Include(a => a.Prosjekt)
            .ToListAsync();

        var endret = false;
        foreach (var rad in _rader)
        {
            var a = ordre.FirstOrDefault(o => o.Id == rad.Id);
            if (a is null)
            {
                continue;
            }

            var harEgenAdresse = !string.IsNullOrWhiteSpace(a.Adresse);
            rad.Adresse = harEgenAdresse ? a.Adresse : a.Prosjekt?.Adresse;
            rad.Postnr = harEgenAdresse ? a.Postnr : a.Prosjekt?.Postnr;
            rad.Sted = harEgenAdresse ? a.Sted : a.Prosjekt?.Sted;
            rad.Latitude = a.Latitude ?? a.Prosjekt?.Latitude;
            rad.Longitude = a.Longitude ?? a.Prosjekt?.Longitude;

            if (rad.Latitude is null && !string.IsNullOrWhiteSpace(rad.Adresse))
            {
                var treff = await Geokoding.GeocodeAsync(rad.Adresse!, rad.Postnr, rad.Sted);
                if (treff is not null)
                {
                    rad.Latitude = treff.Value.Latitude;
                    rad.Longitude = treff.Value.Longitude;
                    a.Latitude = treff.Value.Latitude;
                    a.Longitude = treff.Value.Longitude;
                    endret = true;
                }
            }
        }

        if (endret)
        {
            await Db.SaveChangesAsync();
        }
    }

    private async Task VelgKartvisning()
    {
        _visning = "kart";
        await VisningPref.SettAsync("arbeidsordre", "kart");
        await LastInnKartData();
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("arbeidsordre", visning);
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek + 6) % 7;
        return dato.AddDays(-diff).Date;
    }

    private int AntallApne => _basisFiltrert.Count(r => r.Status != ArbeidsordreStatus.Ferdig);
    private int AntallForfalt => _basisFiltrert.Count(ErForfalt);
    private int AntallUtenMontor => _basisFiltrert.Count(r => r.AnsvarligMontorId is null && r.Status != ArbeidsordreStatus.Ferdig);
    private int AntallFullfortUke => _basisFiltrert.Count(r => r.Status == ArbeidsordreStatus.Ferdig && r.FullfortDato.HasValue && r.FullfortDato.Value.Date >= DateTime.Today.AddDays(-6));

    private static bool ErForfalt(ArbeidsordreRad r) =>
        r.Status != ArbeidsordreStatus.Ferdig && r.PlanlagtDato.HasValue && r.PlanlagtDato.Value.Date < DateTime.Today;

    private List<ArbeidsordreRad> OrdreForStatus(string status)
    {
        IEnumerable<ArbeidsordreRad> rader = status switch
        {
            "Ny" => _filtrert.Where(r => !ErForfalt(r) && (r.Status == ArbeidsordreStatus.Ny || r.Status == ArbeidsordreStatus.Klar)),
            "Pågående" => _filtrert.Where(r => !ErForfalt(r) && r.Status == ArbeidsordreStatus.Pagaende),
            "Ferdig" => _filtrert.Where(r => r.Status == ArbeidsordreStatus.Ferdig),
            "Forfalt" => _filtrert.Where(ErForfalt),
            _ => []
        };

        return status == "Ferdig"
            ? rader.OrderByDescending(r => r.FullfortDato).ToList()
            : rader.OrderBy(r => r.PlanlagtDato ?? DateTime.MaxValue).ToList();
    }

    private static string? DatoBadgeTekst(ArbeidsordreRad r)
    {
        if (r.Status == ArbeidsordreStatus.Ferdig)
        {
            return r.FullfortDato.HasValue ? $"Ferdig {r.FullfortDato.Value.ToString("d. MMM", Kultur)}" : null;
        }

        if (!r.PlanlagtDato.HasValue)
        {
            return null;
        }

        var prefiks = ErForfalt(r) ? "Forfalt" : "Frist";
        return $"{prefiks} {r.PlanlagtDato.Value.ToString("d. MMM", Kultur)}";
    }

    private static string KolonneFarge(string status) => status switch
    {
        "Ny" => "blaa",
        "Pågående" => "gul",
        "Ferdig" => "gronn",
        "Forfalt" => "rod",
        _ => "noytral"
    };

    private static string MontorFarge(string navn) => MontorPaletten[Math.Abs(navn.GetHashCode()) % MontorPaletten.Length];

    private static string MontorInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    private void ToggleStatusFilter(ArbeidsordreStatus status)
    {
        if (!_valgteStatusFilter.Add(status))
        {
            _valgteStatusFilter.Remove(status);
        }
        Verktoylinje.VarsleEndring();
    }

    // Drar et kort fra en kolonne til en annen i Kanban-tavlen - oppdaterer
    // den virkelige Status-verdien i databasen direkte (Forfalt er ikke en
    // egen status, og godtar derfor ingen slipp - se draggable/ondragover
    // over). "Ny"-kolonnen setter status til Ny (ikke Klar, selv om den
    // kolonnen også viser Klar-ordre - Klar settes kun manuelt i dag).
    private async Task SlippPaKolonne(string kolonne)
    {
        if (_dratOrdreId is not { } id || kolonne == "Forfalt")
        {
            return;
        }

        var nyStatus = kolonne switch
        {
            "Ny" => ArbeidsordreStatus.Ny,
            "Pågående" => ArbeidsordreStatus.Pagaende,
            "Ferdig" => ArbeidsordreStatus.Ferdig,
            _ => (ArbeidsordreStatus?)null
        };

        if (nyStatus is null)
        {
            return;
        }

        var rad = _rader.FirstOrDefault(r => r.Id == id);
        if (rad is null || rad.Status == nyStatus)
        {
            _dratOrdreId = null;
            return;
        }

        var ordre = await Db.Arbeidsordre.FindAsync(id);
        if (ordre is not null)
        {
            ordre.Status = nyStatus.Value;
            if (nyStatus == ArbeidsordreStatus.Ferdig)
            {
                ordre.FullfortDato = DateTime.UtcNow;
            }
            await Db.SaveChangesAsync();
            rad.Status = nyStatus.Value;
            rad.FullfortDato = ordre.FullfortDato;
        }

        _dratOrdreId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        // Mobilvisning avgjøres sentralt av MainLayout (se kommentar der) og
        // leses herfra via Verktoylinje.ErMobilvisning - unngår at hver side
        // må gjøre sin egen (langsommere) deteksjon ved hver navigasjon.
        Verktoylinje.Endret += OnVerktoylinjeEndret;
        _visning = await VisningPref.HentAsync("arbeidsordre", _visning);

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        IQueryable<Arbeidsordre> query = Db.Arbeidsordre.Where(a => a.Status != ArbeidsordreStatus.Fakturert);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            query = query.Where(a => a.AnsvarligMontorId == _naverendeBrukerId);
        }

        var ordre = await query
            .Include(a => a.Prosjekt)
            .ThenInclude(p => p!.Kunde)
            .Include(a => a.Kunde)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _rader = ordre.Select(a => new ArbeidsordreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektId = a.ProsjektId,
            ProsjektNavn = a.Prosjekt?.Navn,
            KundeId = a.KundeId ?? a.Prosjekt?.KundeId,
            KundeNavn = a.Kunde?.Navn ?? a.Prosjekt?.Kunde?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            AnsvarligMontorId = a.AnsvarligMontorId,
            Status = a.Status,
            Prioritet = a.Prioritet,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer),
            OpprettetDato = a.OpprettetDato,
            PlanlagtDato = a.PlanlagtDato,
            FullfortDato = a.FullfortDato
        }).ToList();

        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();
        _alleProsjekter = await Db.Prosjekter.OrderBy(p => p.Navn).ToListAsync();
        _alleKunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();

        Verktoylinje.RegistrerFilter(
            () => { _visFilter = !_visFilter; StateHasChanged(); },
            () => AntallAktiveFiltre > 0);

        if (_visning == "kart")
        {
            await LastInnKartData();
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        Verktoylinje.AvregistrerFilter();
    }

    private async Task NyArbeidsordre()
    {
        var ordre = new Arbeidsordre { Tittel = "Ny arbeidsordre" };
        Db.Arbeidsordre.Add(ordre);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/arbeidsordre/{ordre.Id}");
    }

    // Tegner/oppdaterer kartet kun når kartvisningen faktisk er aktiv, og kun
    // når det synlige punktsettet (filter/søk) faktisk har endret seg siden
    // sist - samme mønster som Serviceavtaler.razor/Home.razor sine kart.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Verktoylinje.ErMobilvisning || _visning != "kart" || !_kartLastet)
        {
            return;
        }

        var punkter = KartPunkter();
        var signatur = string.Join("|", punkter.Select(p => p!.ToString()));

        if (!_kartInitialisert)
        {
            await JS.InvokeVoidAsync("kart.init", "ao-kart", punkter);
            _kartInitialisert = true;
            _sisteKartSignatur = signatur;
        }
        else if (signatur != _sisteKartSignatur)
        {
            await JS.InvokeVoidAsync("kart.setPunkter", punkter);
            _sisteKartSignatur = signatur;
        }
    }
}
