@page "/arbeidsordre"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Arbeidsordre</PageTitle>

<h1>Arbeidsordre</h1>
<p>Opprett arbeidsordre med info om jobben og ansvarlig montør. Montører registrerer timer på arbeidsordren under Timeregistrering.</p>

<button type="button" class="add-button" @onclick="NyArbeidsordre">Ny arbeidsordre</button>
<AuthorizeView Roles="Admin,Prosjektleder">
    <a class="back-link" href="/arbeidsordre/ferdigmeldte">Se ferdigmeldte prosjekter &rarr;</a>
    <a class="back-link" href="/arbeidsordre/fakturert">Se fakturerte ordre &rarr;</a>
    <a class="back-link" href="/arbeidsordre/oversikt">Se faktureringsoversikt &rarr;</a>
</AuthorizeView>

@if (_naverendeRolle == BrukerRolle.Montor)
{
    <label class="lav-toggle">
        <input type="checkbox" @bind="_kunMineOppdrag" /> Vis kun mine oppdrag
    </label>
}

@if (_radervisning.Count == 0)
{
    <p class="list-empty">@(_kunMineOppdrag ? "Ingen arbeidsordre tildelt deg ennå." : "Ingen arbeidsordre opprettet ennå.")</p>
}
else
{
    <table class="ordre-table">
        <thead>
            <tr>
                <th>Tittel</th>
                <th>Prosjekt</th>
                <th>Ansvarlig montør</th>
                <th>Status</th>
                <th>Timer</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _radervisning)
            {
                <tr @key="r.Id">
                    <td>@r.Tittel</td>
                    <td>@(r.ProsjektNavn ?? "-")</td>
                    <td>@(r.AnsvarligMontorNavn ?? "-")</td>
                    <td><span class="status-badge @StatusClass(r.Status)">@r.Status.Visningsnavn()</span></td>
                    <td class="timer-cell">@r.SumTimer.ToString("N1", Kultur) t</td>
                    <td><a class="edit-link" href="@($"/arbeidsordre/{r.Id}")">Åpne</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private sealed class ArbeidsordreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? ProsjektNavn { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public decimal SumTimer { get; set; }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private List<ArbeidsordreRad> _rader = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;
    private bool _kunMineOppdrag;

    private List<ArbeidsordreRad> _radervisning => _kunMineOppdrag
        ? _rader.Where(r => r.AnsvarligMontorId == _naverendeBrukerId).ToList()
        : _rader;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        _kunMineOppdrag = _naverendeRolle == BrukerRolle.Montor;

        var ordre = await Db.Arbeidsordre
            .Where(a => a.Status != ArbeidsordreStatus.Fakturert)
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Timeregistreringer)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _rader = ordre.Select(a => new ArbeidsordreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            ProsjektNavn = a.Prosjekt?.Navn,
            AnsvarligMontorNavn = a.AnsvarligMontor?.Navn,
            AnsvarligMontorId = a.AnsvarligMontorId,
            Status = a.Status,
            SumTimer = a.Timeregistreringer.Sum(t => t.TotalTimer)
        }).ToList();
    }

    private async Task NyArbeidsordre()
    {
        var ordre = new Arbeidsordre { Tittel = "Ny arbeidsordre" };
        Db.Arbeidsordre.Add(ordre);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/arbeidsordre/{ordre.Id}");
    }

    private static string StatusClass(ArbeidsordreStatus status) => status switch
    {
        ArbeidsordreStatus.Fakturert => "status-badge-fakturert",
        ArbeidsordreStatus.Ferdig => "status-badge-ferdig",
        ArbeidsordreStatus.Pagaende => "status-badge-pagaende",
        ArbeidsordreStatus.Klar => "status-badge-klar",
        _ => "status-badge-ny"
    };
}
