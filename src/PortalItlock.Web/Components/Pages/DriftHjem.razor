@page "/drift"
@layout PortalItlock.Web.Components.Layout.DriftLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Driftslisens")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Driftsportal - Full Kontroll</PageTitle>

@if (_ikkeAktiv)
{
    <p class="dp-feil">Tilgangen din er deaktivert. Ta kontakt med oss for å få den aktivert igjen.</p>
}
else if (_bruker is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    <div class="dp-tittelrad">
        <div class="dp-hei">
            <small>@Dato</small>
            <h1>@Hilsen, @DriftHelper.Fornavn(_bruker.Navn)</h1>
            <p>
                @_bygg.Count bygg · @_bygg.Sum(b => b.AntallDorer) dører
                @if (AntallApne > 0)
                {
                    <text> · </text><b style="color:var(--dp-rust)">@AntallApne @(AntallApne == 1 ? "åpen melding" : "åpne meldinger")</b>
                }
            </p>
        </div>
    </div>

    <a class="dp-meldknapp dp-kun-mobil" href="/drift/meld">
        <span class="dp-ik"><Icon Name="camera" /></span>
        <span><b>Meld inn en feil</b><small>Skann QR på døren eller velg dør</small></span>
        <Icon Name="arrow-right" />
    </a>

    <div class="dp-kpi">
        <div class="@(AntallApne > 0 ? "dp-varsel" : "")"><small>Åpne meldinger</small><b>@AntallApne</b></div>
        <div><small>Løst siste 30 dager</small><b>@LostSiste30</b></div>
        <div><small>Snitt tid til løst</small><b>@SnittTilLost</b></div>
        <div><small>Dører i mine bygg</small><b>@_bygg.Sum(b => b.AntallDorer)</b></div>
    </div>

    @if (_bygg.Count == 0)
    {
        <div class="dp-kort dp-tom">Du har ikke fått tilgang til noen bygg ennå. Ta kontakt med oss.</div>
    }
    else
    {
        <div class="dp-to-kol">
            <div class="dp-kol">
                <div class="dp-seksjon-t"><h2>Mine bygg</h2><span>@_bygg.Count</span></div>
                <div class="dp-bygg-grid">
                    @foreach (var b in _bygg)
                    {
                        <a class="dp-bygg" href="@($"/drift/prosjekt/{b.Id}")" @key="b.Id">
                            <div class="dp-bygg-bilde">
                                @if (b.PlantegningId is int pid)
                                {
                                    <img src="@($"/plantegningbilde/{pid}")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 310 96" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                                        <g fill="currentColor" style="color:color-mix(in srgb, var(--dp-brun) 30%, transparent)"><rect x="150" y="22" width="70" height="74" /><rect x="226" y="36" width="60" height="60" /><rect x="96" y="40" width="48" height="56" /></g>
                                    </svg>
                                }
                                @if (!string.IsNullOrWhiteSpace(b.Adresse))
                                {
                                    <span class="dp-tag dp-t-hvit"><Icon Name="map-pin" />@b.Adresse</span>
                                }
                            </div>
                            <div class="dp-bygg-info">
                                <div><b>@b.Navn</b><small>@b.AntallDorer dører@(b.AntallPlantegninger switch { 0 => "", 1 => " · 1 plantegning", var n => $" · {n} plantegninger" })</small></div>
                                <Icon Name="chevron-right" />
                            </div>
                            <div class="dp-bygg-tags">
                                @if (b.Apne > 0)
                                {
                                    <span class="dp-tag dp-t-rod">@b.Apne @(b.Apne == 1 ? "åpen melding" : "åpne meldinger")</span>
                                }
                                else
                                {
                                    <span class="dp-tag dp-t-gronn"><Icon Name="check" />Alt i orden</span>
                                }
                            </div>
                        </a>
                    }
                </div>
            </div>

            <div class="dp-kol">
                <div class="dp-seksjon-t"><h2>Meldinger</h2><a href="/drift/meldinger">Se alle</a></div>
                @if (_meldinger.Count == 0)
                {
                    <div class="dp-kort dp-tom">Ingen meldinger ennå. Når noe er galt med en dør, trykker du på «Meld inn en feil».</div>
                }
                else
                {
                    <div class="dp-meldinger">
                        @foreach (var s in _meldinger.OrderByDescending(m => m.ErApen).ThenByDescending(m => m.Melding.OpprettetDato).Take(6))
                        {
                            <DriftMeldingRad Status="s" @key="s.Melding.Id" />
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed record Bygg(int Id, string Navn, string? Adresse, int AntallDorer, int AntallPlantegninger, int? PlantegningId, int Apne);

    private static readonly System.Globalization.CultureInfo NorskKultur = new("nb-NO");

    private static string Dato
    {
        get
        {
            var tekst = DateTime.Today.ToString("dddd d. MMMM", NorskKultur);
            return char.ToUpper(tekst[0]) + tekst[1..];
        }
    }

    private Bruker? _bruker;
    private bool _ikkeAktiv;
    private List<Bygg> _bygg = [];
    private List<DriftHelper.MeldingStatus> _meldinger = [];

    private int AntallApne => _meldinger.Count(m => m.ErApen);
    private int LostSiste30 => _meldinger.Count(m => m.LostDato is { } d && d >= DateTime.Now.AddDays(-30));

    private string SnittTilLost
    {
        get
        {
            var tider = _meldinger.Where(m => m.LostDato.HasValue).Select(m => (m.LostDato!.Value - m.Melding.OpprettetDato).TotalDays).ToList();
            if (tider.Count == 0) return "–";
            var snitt = tider.Average();
            return snitt < 1 ? $"{Math.Max(1, Math.Round(snitt * 24))} t" : $"{snitt:0.#} d";
        }
    }

    private static string Hilsen => DateTime.Now.Hour >= 18 ? "God kveld" : DateTime.Now.Hour >= 10 ? "Hei" : "God morgen";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser en admin portalen via "Vis som Driftslisens", leses byggene
        // til den vaktmesteren som forhåndsvises - ellers til brukeren selv.
        // Se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bruker = await Db.Brukere.AsNoTracking().FirstOrDefaultAsync(b => b.Id == brukerId);
        if (bruker is null)
        {
            return;
        }

        if (!bruker.Aktiv)
        {
            _ikkeAktiv = true;
            return;
        }

        _bruker = bruker;

        var bygg = DriftHelper.MineBygg(Db, brukerId);
        _meldinger = await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => bygg.Any(p => p.Id == m.Dor!.ProsjektId)));

        var apnePerBygg = _meldinger.Where(m => m.ErApen).GroupBy(m => m.Melding.Dor!.ProsjektId).ToDictionary(g => g.Key, g => g.Count());

        var rader = await bygg
            .OrderBy(p => p.Navn)
            .Select(p => new
            {
                p.Id,
                p.Navn,
                p.Adresse,
                Dorer = Db.Dorer.Count(d => d.ProsjektId == p.Id),
                Plantegninger = Db.Plantegninger.Count(t => t.ProsjektId == p.Id),
                // Kun bildefiler kan vises som bakgrunn på kortet.
                PlantegningId = Db.Plantegninger.Where(t => t.ProsjektId == p.Id && t.ContentType.StartsWith("image/")).OrderBy(t => t.Navn).Select(t => (int?)t.Id).FirstOrDefault()
            })
            .ToListAsync();

        _bygg = rader.Select(r => new Bygg(r.Id, r.Navn, r.Adresse, r.Dorer, r.Plantegninger, r.PlantegningId, apnePerBygg.GetValueOrDefault(r.Id))).ToList();
    }
}
