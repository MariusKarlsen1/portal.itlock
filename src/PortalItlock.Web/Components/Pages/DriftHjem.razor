@page "/drift"
@layout PortalItlock.Web.Components.Layout.DriftLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Driftslisens")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Driftsmeldinger - itlock</PageTitle>

@if (_ikkeAktiv)
{
    <p class="form-error">Tilgangen din er deaktivert. Ta kontakt med itlock for å få den aktivert igjen.</p>
}
else if (_bruker is null)
{
    <p>Laster...</p>
}
else
{
    <h1>Hei, @_bruker.Navn</h1>
    <p class="section-hint">Velg et prosjekt for å se plantegning og dører, og registrere driftsmeldinger.</p>

    @if (_prosjekter.Count == 0)
    {
        <p class="list-empty">Du har ikke fått tilgang til noen prosjekter ennå. Ta kontakt med itlock.</p>
    }
    else
    {
        <ul class="drift-prosjekt-liste">
            @foreach (var p in _prosjekter)
            {
                <li @key="p.Id">
                    <a class="drift-prosjekt-kort" href="@($"/drift/prosjekt/{p.Id}")">
                        <span class="drift-prosjekt-navn">@p.Navn</span>
                        @if (!string.IsNullOrWhiteSpace(p.Adresse))
                        {
                            <span class="drift-prosjekt-adresse">@p.Adresse</span>
                        }
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Bruker? _bruker;
    private bool _ikkeAktiv;
    private List<Prosjekt> _prosjekter = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is null || !int.TryParse(brukerClaim, out var brukerId))
        {
            return;
        }

        var bruker = await Db.Brukere
            .Include(b => b.Prosjekter)
            .FirstOrDefaultAsync(b => b.Id == brukerId);

        if (bruker is null)
        {
            return;
        }

        if (!bruker.Aktiv)
        {
            _ikkeAktiv = true;
            return;
        }

        _bruker = bruker;
        _prosjekter = bruker.Prosjekter.OrderBy(p => p.Navn).ToList();
    }
}
