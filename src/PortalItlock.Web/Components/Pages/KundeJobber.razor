@page "/kunde/jobber"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Mine jobber - Full Kontroll</PageTitle>

<div class="dp-hei">
    <h1>Mine jobber</h1>
    <p>Legg inn info og bilder før vi kommer. Ferdige jobber viser rapporten fra montøren.</p>
</div>

@if (_ikkeKoblet)
{
    <p class="dp-feil">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med oss.</p>
}
else
{
    <div class="dp-segment" style="max-width:420px">
        <button type="button" class="@(_visKommende ? "aktiv" : "")" @onclick="@(() => _visKommende = true)">Kommende<em hidden="@(_kommende.Count == 0)">@_kommende.Count</em></button>
        <button type="button" class="@(!_visKommende ? "aktiv" : "")" @onclick="@(() => _visKommende = false)">Ferdige</button>
    </div>

    var liste = _visKommende ? _kommende : _tidligere;
    @if (_lastet && liste.Count == 0)
    {
        <div class="dp-kort dp-tom">@(_visKommende ? "Ingen kommende jobber planlagt." : "Ingen ferdige jobber ennå.")</div>
    }
    else
    {
        <div class="dp-bygg-grid">
            @foreach (var j in liste)
            {
                <a class="dp-kort dp-besok" href="@($"/kunde/jobb/{j.Id}")" style="text-decoration:none;color:inherit" @key="j.Id">
                    <div class="dp-besok-topp">
                        @if ((_visKommende ? j.PlanlagtDato : j.FullfortDato ?? j.PlanlagtDato) is { } dato)
                        {
                            <span class="dp-kal"><small>@KundeportalHelper.Ukedag(dato)</small><b>@dato.Day</b></span>
                        }
                        else
                        {
                            <span class="dp-kal"><small>Dato</small><b>–</b></span>
                        }
                        <span>
                            <b>@j.Tittel</b>
                            <span>@Undertekst(j)</span>
                        </span>
                    </div>
                    @if (_visKommende && j.Status == ArbeidsordreStatus.Ferdig)
                    {
                        <div class="dp-montor"><span class="dp-tag dp-t-gronn"><Icon Name="check" />Utført</span><small style="margin-left:auto">Rapporten kommer snart</small></div>
                    }
                    else if (_visKommende && j.AnsvarligMontor is { } m)
                    {
                        <div class="dp-montor"><i>@KundeportalHelper.Initialer(m.Navn)</i><span><b>@m.Navn</b><small>kommer på besøk</small></span></div>
                    }
                    @if (_visKommende && j.Status != ArbeidsordreStatus.Ferdig)
                    {
                        <div class="dp-info-felt" style="margin-top:.6rem">
                            <Icon Name="help-circle" />
                            <span>@(string.IsNullOrWhiteSpace(j.KundeInfoForJobb) ? "Legg inn info før vi kommer →" : $"Info lagt inn: «{Kort(j.KundeInfoForJobb)}»")</span>
                        </div>
                    }
                    else if (!_visKommende)
                    {
                        <div class="dp-montor"><span class="dp-tag dp-t-gronn"><Icon Name="check" />Ferdig</span><span style="margin-left:auto;color:var(--dp-brun);font-weight:600">Se rapport →</span></div>
                    }
                </a>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _ikkeKoblet;
    private bool _lastet;
    private bool _visKommende = true;
    private List<Arbeidsordre> _kommende = [];
    private List<Arbeidsordre> _tidligere = [];

    private static string Kort(string tekst) => tekst.Length > 50 ? tekst[..50].TrimEnd() + "…" : tekst;

    private string Undertekst(Arbeidsordre j)
    {
        var deler = new List<string>();
        if (j.PlanlagtDato is { } fra)
        {
            deler.Add(fra.TimeOfDay == TimeSpan.Zero ? fra.ToString("dd.MM.yyyy")
                : j.PlanlagtSlutt is { } til ? $"{fra:dd.MM} kl. {fra:HH:mm}–{til:HH:mm}" : $"{fra:dd.MM} kl. {fra:HH:mm}");
        }
        else
        {
            deler.Add("Dato ikke satt ennå");
        }
        if (!string.IsNullOrWhiteSpace(j.Adresse))
        {
            deler.Add(j.Adresse);
        }
        else if (j.Prosjekt is not null)
        {
            deler.Add(j.Prosjekt.Navn);
        }
        return string.Join(" · ", deler);
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(brukerId);
        if (bruker?.KundeId is not int kundeId)
        {
            _ikkeKoblet = true;
            return;
        }

        var jobber = await KundeportalHelper.Jobber(Db, kundeId)
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .AsNoTracking()
            .ToListAsync();

        _kommende = jobber.Where(a => !KundeportalHelper.ErFerdig(a))
            .OrderBy(a => a.PlanlagtDato ?? DateTime.MaxValue)
            .ToList();
        _tidligere = jobber.Where(KundeportalHelper.ErFerdig)
            .OrderByDescending(a => a.FullfortDato ?? a.FakturertDato ?? a.PlanlagtDato)
            .ToList();
        _lastet = true;
    }
}
