@page "/kunde/jobber"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Mine jobber - itlock</PageTitle>

<a class="back-link" href="/kunde">&larr; Tilbake</a>
<h1>Mine jobber</h1>

@if (_ikkeKoblet)
{
    <p class="form-error">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med itlock.</p>
}
else
{
    <p class="section-hint">Kommende jobber kan du legge inn informasjon og bilder på før vi kommer. Fullførte jobber viser rapporten vi har sendt deg.</p>

    <h2>Kommende</h2>
    @if (_kommende.Count == 0)
    {
        <p class="list-empty">Ingen kommende jobber planlagt.</p>
    }
    else
    {
        <div class="jobb-liste">
            @foreach (var j in _kommende)
            {
                <a @key="j.Id" class="jobb-kort" href="@($"/kunde/jobb/{j.Id}")">
                    <strong>@j.Tittel</strong>
                    <span class="jobb-dato">@(j.PlanlagtDato.HasValue ? j.PlanlagtDato.Value.ToString("dd.MM.yyyy") : "Dato ikke satt ennå")</span>
                </a>
            }
        </div>
    }

    <h2>Tidligere jobber</h2>
    @if (_tidligere.Count == 0)
    {
        <p class="list-empty">Ingen fullførte jobber ennå.</p>
    }
    else
    {
        <div class="jobb-liste">
            @foreach (var j in _tidligere)
            {
                <a @key="j.Id" class="jobb-kort" href="@($"/kunde/jobb/{j.Id}")">
                    <strong>@j.Tittel</strong>
                    <span class="jobb-dato">@(j.FakturertDato.HasValue ? j.FakturertDato.Value.ToString("dd.MM.yyyy") : j.PlanlagtDato?.ToString("dd.MM.yyyy"))</span>
                </a>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _ikkeKoblet;
    private List<Arbeidsordre> _kommende = [];
    private List<Arbeidsordre> _tidligere = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is null || !int.TryParse(brukerClaim, out var brukerId))
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeKoblet = true;
            return;
        }

        var jobber = await Db.Arbeidsordre
            .Where(a => a.Prosjekt != null && a.Prosjekt.KundeId == bruker.KundeId)
            .OrderBy(a => a.PlanlagtDato)
            .ToListAsync();

        _kommende = jobber.Where(a => a.Status != ArbeidsordreStatus.Fakturert).ToList();
        _tidligere = jobber.Where(a => a.Status == ArbeidsordreStatus.Fakturert)
            .OrderByDescending(a => a.FakturertDato)
            .ToList();
    }
}
