@using System.Globalization
@using PortalItlock.Web.Models

<div class="kobling-symbol-marker @(Selected ? "kobling-symbol-marker-selected" : "") @(Symbol.ErLaast ? "kobling-symbol-marker-laast" : "")"
     style="left:@(Symbol.PosX.ToString(CultureInfo.InvariantCulture))%; top:@(Symbol.PosY.ToString(CultureInfo.InvariantCulture))%; width:@(Symbol.Bredde.ToString(CultureInfo.InvariantCulture))%; height:@(Symbol.Hoyde.ToString(CultureInfo.InvariantCulture))%;"
     data-symbolid="@Symbol.Id"
     data-elementtype="@Symbol.ElementType"
     data-laast="@(Symbol.ErLaast ? "true" : "false")"
     data-x="@(SenterX(Symbol).ToString(CultureInfo.InvariantCulture))"
     data-y="@(SenterY(Symbol).ToString(CultureInfo.InvariantCulture))">
    @if (Symbol.ElementType == KoblingsElementType.Bilde && Symbol.SymbolBibliotekId.HasValue)
    {
        <img src="@($"/koblingsbibliotek/{Symbol.SymbolBibliotekId}")" alt="@Symbol.Navn" class="kobling-symbol-bilde" />
    }
    else if (Symbol.ElementType == KoblingsElementType.Rektangel)
    {
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="kobling-figur-svg">
            <rect x="4" y="4" width="92" height="92" fill="@(Symbol.Fylt ? Symbol.Farge : "none")" stroke="@Symbol.Farge" stroke-width="@Symbol.Strokbredde" vector-effect="non-scaling-stroke" />
        </svg>
    }
    else if (Symbol.ElementType == KoblingsElementType.Sirkel)
    {
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="kobling-figur-svg">
            <ellipse cx="50" cy="50" rx="46" ry="46" fill="@(Symbol.Fylt ? Symbol.Farge : "none")" stroke="@Symbol.Farge" stroke-width="@Symbol.Strokbredde" vector-effect="non-scaling-stroke" />
        </svg>
    }
    else if (Symbol.ElementType == KoblingsElementType.Linje)
    {
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="kobling-figur-svg">
            <line x1="2" y1="2" x2="98" y2="98" stroke="@Symbol.Farge" stroke-width="@Symbol.Strokbredde" vector-effect="non-scaling-stroke" />
        </svg>
    }
    else if (Symbol.ElementType == KoblingsElementType.Pil)
    {
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="kobling-figur-svg">
            <defs>
                <marker id="@($"kobling-pil-{Symbol.Id}")" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
                    <path d="M0,0 L8,4 L0,8 Z" fill="@Symbol.Farge" />
                </marker>
            </defs>
            <line x1="2" y1="2" x2="92" y2="92" stroke="@Symbol.Farge" stroke-width="@Symbol.Strokbredde"
                  marker-end="@($"url(#kobling-pil-{Symbol.Id})")" vector-effect="non-scaling-stroke" />
        </svg>
    }
    else if (Symbol.ElementType == KoblingsElementType.Tekstboks)
    {
        <div class="kobling-tekstboks" style="font-size:@(Symbol.FontStorrelse)px; color:@Symbol.Farge;">@Symbol.Tekst</div>
    }
    else if (Symbol.ElementType == KoblingsElementType.Punkt)
    {
        <div class="kobling-punkt-figur" style="background:@Symbol.Farge;"></div>
    }

    @if (!string.IsNullOrWhiteSpace(Symbol.Navn) && Symbol.ElementType != KoblingsElementType.Tekstboks)
    {
        <span class="kobling-symbol-label">@Symbol.Navn</span>
    }

    @if (VisResizeHandle)
    {
        <div class="kobling-resize-handle"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public KoblingsSymbol Symbol { get; set; } = null!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool VisResizeHandle { get; set; }

    private static double SenterX(KoblingsSymbol s) => s.PosX + s.Bredde / 2;
    private static double SenterY(KoblingsSymbol s) => s.PosY + s.Hoyde / 2;
}
