    [JSInvokable]
    public async Task OnStrekkodeSkannet(string ean)
    {
        var tilbudLinje = _tilbudVarer.FirstOrDefault(l => !l.Plukket && l.Component != null && l.Component.Gtin == ean);
        if (tilbudLinje is not null)
        {
            tilbudLinje.Plukket = true;
            await LagreTilbudLinjePlukket(tilbudLinje);
            _skannerTreffMelding = $"✓ {tilbudLinje.Navn} markert som plukket.";
            _skannerFeil = null;
            StateHasChanged();
            return;
        }

        var vare = _ordre?.Varer.FirstOrDefault(v => v.LagtTilAvBrukerId is null && !v.Plukket && v.Component != null && v.Component.Gtin == ean);
        if (vare is not null)
        {
            vare.Plukket = true;
            await LagreVarePlukket(vare);
            _skannerTreffMelding = $"✓ {vare.Navn} markert som plukket.";
            _skannerFeil = null;
            StateHasChanged();
            return;
        }

        _skannerTreffMelding = null;
        _skannerFeil = $"Fant ingen vare med strekkode {ean} i listen.";
        StateHasChanged();
    }

