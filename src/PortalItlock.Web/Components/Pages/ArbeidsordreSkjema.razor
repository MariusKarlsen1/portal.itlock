    private async Task SjekkDobbeltbooking()
    {
        _dobbeltbookingVarsel = null;
        if (_ordre is null || !_ordre.AnsvarligMontorId.HasValue || !_planlagtDato.HasValue)
        {
            return;
        }

        var dagStart = _planlagtDato.Value.ToDateTime(TimeOnly.MinValue);
        var dagSlutt = dagStart.AddDays(1);

        var konflikter = await Db.Arbeidsordre
            .Where(a => a.Id != _ordre.Id
                && a.AnsvarligMontorId == _ordre.AnsvarligMontorId
                && a.PlanlagtDato != null
                && a.PlanlagtDato >= dagStart && a.PlanlagtDato < dagSlutt
                && a.Status != ArbeidsordreStatus.Fakturert)
            .Select(a => a.Tittel)
            .ToListAsync();

        if (konflikter.Count > 0)
        {
            var montorNavn = _montorer.FirstOrDefault(m => m.Id == _ordre.AnsvarligMontorId)?.Navn ?? "Montøren";
            _dobbeltbookingVarsel = $"OBS: {montorNavn} er allerede satt opp samme dag på: {string.Join(", ", konflikter)}.";
        }
    }

    private async Task SokVarer()
    {
        var term = _vareSok.Trim();
        if (term.Length < 2)
        {
            _vareSokResultater = [];
            return;
        }

        _vareSokResultater = await Db.Components
            .Where(c => c.Aktiv && (EF.Functions.Like(c.Navn, $"%{term}%") || EF.Functions.Like(c.Produktkode, $"%{term}%")))
            .OrderBy(c => c.Navn)
            .Take(15)
            .ToListAsync();
    }

    // ---------- Varer fra bilen ----------
    // Har brukeren en bil i lagermodulen, tas varer som ligger i bilen derfra
    // når de legges på arbeidsordren: de trekkes fra bilen og føres som
    // forbruk på prosjektet med en gang, så ingenting registreres to ganger.
    private int? _bilId;
    private string? _bilNavn;
    private Dictionary<int, int> _iBilen = [];
    private string? _bilMelding;

    private async Task LastBilAsync()
    {
        _bilId = null;
        _bilNavn = null;
        _iBilen = [];
        if (_naverendeBrukerId is not { } bruker || !await Tilleggsmoduler.HarAsync(TilleggsModuler.Lager))
        {
            return;
        }

        var bil = await Db.Lagre.AsNoTracking()
            .FirstOrDefaultAsync(l => l.Aktiv && l.Type == LagerType.Bil && l.AnsvarligBrukerId == bruker);
        if (bil is null)
        {
            return;
        }

        _bilId = bil.Id;
        _bilNavn = bil.Navn;
        _iBilen = (await LagerSvc.BeholdningAsync(lagerId: bil.Id))
            .Where(b => b.Antall > 0)
            .ToDictionary(b => b.ComponentId, b => b.Antall);
    }

    private int IBilen(Component c) => c.ILagerstyring ? _iBilen.GetValueOrDefault(c.Id) : 0;

    private RenderFragment BilHint() => @<text>
        @if (!string.IsNullOrEmpty(_bilMelding))
        {
            <p class="ao-bil-melding" role="status">@_bilMelding</p>
        }
    </text>;

    private async Task LeggTilVare(Component c)
    {
        if (!KanEndreOrdre)
        {
            return;
        }

        if (_bilId is { } bil && IBilen(c) > 0)
        {
            var fraBil = await PlukkSvc.BruktAsync(c.Id, bil, 1, _ordre!.ProsjektId, _ordre.Id, null, _naverendeBrukerId, _naverendeBruker?.Navn);
            if (fraBil is not null)
            {
                fraBil.LagtTilAvBruker = _naverendeBruker;
                if (!_ordre.Varer.Contains(fraBil))
                {
                    _ordre.Varer.Add(fraBil);
                }
            }

            _iBilen[c.Id] = IBilen(c) - 1;
            _bilMelding = $"{c.Navn} er tatt fra {_bilNavn} og ført på prosjektet. {_iBilen[c.Id]} igjen i bilen.";
            _vareSok = "";
            _vareSokResultater = [];
            return;
        }

        _bilMelding = null;
        var erMontorTillegg = _naverendeBruker?.Rolle == BrukerRolle.Montor;
        _ordre!.Varer.Add(new ArbeidsordreVare
        {
            ArbeidsordreId = _ordre.Id,
            ComponentId = c.Id,
            Navn = c.Navn,
            Antall = 1,
            Kostpris = c.PrisNetto ?? 0,
            Utpris = c.PrisVeiledende ?? c.PrisNetto ?? 0,
            LagtTilAvBrukerId = erMontorTillegg ? _naverendeBrukerId : null,
            LagtTilAvBruker = erMontorTillegg ? _naverendeBruker : null,
            LagtTilDato = erMontorTillegg ? DateTime.Now : null
        });
        _vareSok = "";
        _vareSokResultater = [];
        await Db.SaveChangesAsync();
        await SikreVarerAsync();
        if (_harLager && _res.ContainsKey(c.Id))
        {
            _bilMelding = _res.GetValueOrDefault(c.Id).Venter > 0
                ? $"{c.Navn} er ikke på lager og må bestilles. Den står i innkjøpsforslaget under Lager."
                : $"{c.Navn} er satt av fra lageret.";
        }
    }

    private async Task LagreVare(ArbeidsordreVare v)
    {
        // Tatt fra bilen: endret antall trekkes fra eller legges tilbake i bilen.
        if (v.FraLagerId is not null && KanEndreOrdre)
        {
            v.Antall = Math.Max(1, v.Antall);
            var for_ = Db.Entry(v).Property(x => x.Antall).OriginalValue;
            if (for_ != v.Antall)
            {
                await PlukkSvc.EndreBruktAsync(v.Id, for_, v.Antall, _naverendeBrukerId, _naverendeBruker?.Navn);
                if (v.ComponentId is { } cid)
                {
                    _iBilen[cid] = _iBilen.GetValueOrDefault(cid) - (v.Antall - for_);
                }
            }
        }

        await AutoLagre();
        await SikreVarerAsync();
    }

    private async Task LagreVarePlukket(ArbeidsordreVare v)
    {
        if (!KanEndreOrdre)
        {
            return;
        }

        v.PlukketDato = v.Plukket ? DateTime.Now : null;
        v.PlukketAvBrukerId = v.Plukket ? _naverendeBrukerId : null;
        await Db.SaveChangesAsync();
        if (v.Plukket)
        {
            await SikreVarerAsync();
        }
    }

