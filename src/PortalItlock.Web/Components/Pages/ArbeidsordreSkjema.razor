    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _ferdigmeldtMelding = null;
        _visKart = false;
        _kartInitialisert = false;
        _kartFeil = null;

        _ordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Prosjektleder)
            .Include(a => a.Varer).ThenInclude(v => v.LagtTilAvBruker)
            .Include(a => a.FullfortAvBruker)
            .FirstOrDefaultAsync(a => a.Id == Id);
        _notFound = _ordre is null;

        if (_ordre is null)
        {
            return;
        }

        _opprinneligMontorId = _ordre.AnsvarligMontorId;
        _planlagtDato = _ordre.PlanlagtDato.HasValue ? DateOnly.FromDateTime(_ordre.PlanlagtDato.Value) : null;
        _fraKlokkeslett = _ordre.PlanlagtDato.HasValue ? TimeOnly.FromDateTime(_ordre.PlanlagtDato.Value) : null;
        _tilKlokkeslett = _ordre.PlanlagtSlutt.HasValue ? TimeOnly.FromDateTime(_ordre.PlanlagtSlutt.Value) : null;

        _tilbudTittel = _ordre.TilbudId.HasValue
            ? (await Db.Tilbud.FirstOrDefaultAsync(t => t.Id == _ordre.TilbudId))?.Tittel
            : null;

        _tilbudVarer = _ordre.TilbudId.HasValue
            ? await Db.TilbudLinjer
                .Where(l => l.TilbudId == _ordre.TilbudId.Value && (l.ErGruppering || l.LevertAv == LevertAv.F))
                .OrderBy(l => l.Rekkefolge)
                .ToListAsync()
            : [];

        await LastTicketAsync();

        _prosjekter = await Db.Prosjekter
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        _montorer = await Db.Brukere
            .OrderBy(m => m.Navn)
            .Select(m => new MontorOption { Id = m.Id, Navn = m.Navn })
            .ToListAsync();

        await SjekkDobbeltbooking();

        var registreringer = await Db.Timeregistreringer
            .Where(t => t.ArbeidsordreId == Id)
            .Include(t => t.Montor)
            .OrderByDescending(t => t.Dato)
            .ToListAsync();

        _registreringer = registreringer.Select(t => new RegistreringRad
        {
            Id = t.Id,
            Dato = t.Dato,
            MontorNavn = t.Montor?.Navn ?? "-",
            Type = t.Type,
            Timer = t.TotalTimer,
            Kommentar = t.Kommentar,
            Kilometer = t.Kilometer
        }).ToList();

        _sumTimer = _registreringer.Sum(r => r.Timer);

        _maler = await Db.SjekklisteMaler.OrderBy(m => m.Dortype).ToListAsync();
        _sjekkpunkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .Include(p => p.FullfortAvBruker)
            .ToListAsync();
        _lagredeSjekklistePdfer = await Db.SjekklistePdfer
            .Where(p => p.ArbeidsordreId == Id)
            .ToListAsync();
        _lagredeRapportPdfer = await LagretPdfService.HentAsync("ArbeidsordreRapport", Id);
        _valgtMalId = null;

        var alleBilder = await Db.ArbeidsordreMedia.Where(m => m.ArbeidsordreId == Id).OrderByDescending(m => m.OpprettetDato).ToListAsync();
        _media = alleBilder.Where(m => !m.LastetOppAvKunde).ToList();
        _kundeBilder = alleBilder.Where(m => m.LastetOppAvKunde).ToList();
        _bildeFeil = null;
        _pdfPreviewUrl = null;
    }

    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        _bildeFeil = null;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var media = new ArbeidsordreMedia
            {
                ArbeidsordreId = Id,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name
            };
            Db.ArbeidsordreMedia.Add(media);
            await Db.SaveChangesAsync();

            _media.Insert(0, media);
        }
    }

    private async Task SlettMedia(ArbeidsordreMedia media)
    {
        var entitet = await Db.ArbeidsordreMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.ArbeidsordreMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _media.Remove(media);
    }

    private async Task AutoLagre() => await Db.SaveChangesAsync();

    private async Task SjekkDobbeltbooking()
    {
        _dobbeltbookingVarsel = null;
        if (_ordre is null || !_ordre.AnsvarligMontorId.HasValue || !_planlagtDato.HasValue)
        {
            return;
        }

        var dagStart = _planlagtDato.Value.ToDateTime(TimeOnly.MinValue);
        var dagSlutt = dagStart.AddDays(1);

        var konflikter = await Db.Arbeidsordre
            .Where(a => a.Id != _ordre.Id
                && a.AnsvarligMontorId == _ordre.AnsvarligMontorId
                && a.PlanlagtDato != null
                && a.PlanlagtDato >= dagStart && a.PlanlagtDato < dagSlutt
                && a.Status != ArbeidsordreStatus.Fakturert)
            .Select(a => a.Tittel)
            .ToListAsync();

        if (konflikter.Count > 0)
        {
            var montorNavn = _montorer.FirstOrDefault(m => m.Id == _ordre.AnsvarligMontorId)?.Navn ?? "Montøren";
            _dobbeltbookingVarsel = $"OBS: {montorNavn} er allerede satt opp samme dag på: {string.Join(", ", konflikter)}.";
        }
    }

    private async Task SokVarer()
    {
        var term = _vareSok.Trim();
        if (term.Length < 2)
        {
            _vareSokResultater = [];
            return;
        }

        _vareSokResultater = await Db.Components
            .Where(c => c.Aktiv && (EF.Functions.Like(c.Navn, $"%{term}%") || EF.Functions.Like(c.Produktkode, $"%{term}%")))
            .OrderBy(c => c.Navn)
            .Take(15)
            .ToListAsync();
    }

    private async Task LeggTilVare(Component c)
    {
        var erMontorTillegg = _naverendeBruker?.Rolle == BrukerRolle.Montor;
        _ordre!.Varer.Add(new ArbeidsordreVare
        {
            ArbeidsordreId = _ordre.Id,
            ComponentId = c.Id,
            Navn = c.Navn,
            Antall = 1,
            Kostpris = c.PrisNetto ?? 0,
            Utpris = c.PrisVeiledende ?? c.PrisNetto ?? 0,
            LagtTilAvBrukerId = erMontorTillegg ? _naverendeBrukerId : null,
            LagtTilAvBruker = erMontorTillegg ? _naverendeBruker : null,
            LagtTilDato = erMontorTillegg ? DateTime.Now : null
        });
        _vareSok = "";
        _vareSokResultater = [];
        await Db.SaveChangesAsync();
    }

    private async Task LagreVare(ArbeidsordreVare v) => await Db.SaveChangesAsync();

    private async Task FjernVare(ArbeidsordreVare v)
    {
        Db.ArbeidsordreVarer.Remove(v);
        _ordre!.Varer.Remove(v);
        await Db.SaveChangesAsync();
    }

    private async Task LastTicketAsync()
    {
        _knyttetTicket = await Db.Tickets.FirstOrDefaultAsync(t => t.ArbeidsordreId == Id);
        _ledigeTickets = _knyttetTicket is null
            ? await Db.Tickets.Where(t => t.ArbeidsordreId == null && t.Status != TicketStatus.Lukket)
                .OrderByDescending(t => t.OpprettetDato)
                .ToListAsync()
            : [];
    }

    private async Task KnyttTicket()
    {
        if (_valgtTicketId is null)
        {
            return;
        }

        var ticket = await Db.Tickets.FirstOrDefaultAsync(t => t.Id == _valgtTicketId.Value);
        if (ticket is null)
        {
            return;
        }

        ticket.ArbeidsordreId = _ordre!.Id;
        Db.TicketHendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = $"Knyttet til arbeidsordre: {_ordre.Tittel}",
            UtfortAvBrukerId = _naverendeBrukerId
        });
        await Db.SaveChangesAsync();
        _valgtTicketId = null;
        await LastTicketAsync();
    }

    private async Task OpprettOgKnyttTicket()
    {
        var ticket = new Ticket
        {
            Tittel = _ordre!.Tittel,
            KundeId = _ordre.Prosjekt?.KundeId,
            ProsjektId = _ordre.ProsjektId,
            ArbeidsordreId = _ordre.Id
        };
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Db.TicketHendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = "Ticket opprettet fra arbeidsordre.",
            UtfortAvBrukerId = _naverendeBrukerId
        });
        await Db.SaveChangesAsync();
        await LastTicketAsync();
    }

    private async Task Lagre()
    {
        if (_planlagtDato.HasValue)
        {
            _ordre!.PlanlagtDato = _planlagtDato.Value.ToDateTime(_fraKlokkeslett ?? TimeOnly.MinValue);
            _ordre.PlanlagtSlutt = _tilKlokkeslett.HasValue
                ? _planlagtDato.Value.ToDateTime(_tilKlokkeslett.Value)
                : null;
        }
        else
        {
            _ordre!.PlanlagtDato = null;
            _ordre.PlanlagtSlutt = null;
        }

        await Db.SaveChangesAsync();

        if (_ordre.AnsvarligMontorId.HasValue && _ordre.AnsvarligMontorId != _opprinneligMontorId)
        {
            await VarsleMontor(_ordre.AnsvarligMontorId.Value);
        }
        _opprinneligMontorId = _ordre.AnsvarligMontorId;

        _savedMessage = "Lagret.";
    }

    private async Task VarsleMontor(int montorId)
    {
        var montor = await Db.Brukere.FindAsync(montorId);
        if (montor is null || string.IsNullOrWhiteSpace(montor.Epost))
        {
            return;
        }

        var stedTekst = string.IsNullOrWhiteSpace(_ordre!.Sted) ? "" : $" - {_ordre.Sted}";
        var datoTekst = _ordre.PlanlagtDato.HasValue ? _ordre.PlanlagtDato.Value.ToString("dd.MM.yyyy HH:mm") : "ikke satt";

        var html = $"<p>Hei {montor.Navn},</p>"
            + $"<p>Du er tildelt en arbeidsordre: <strong>{System.Net.WebUtility.HtmlEncode(_ordre.Tittel)}</strong>{System.Net.WebUtility.HtmlEncode(stedTekst)}</p>"
            + $"<p><strong>Planlagt dato:</strong> {datoTekst}</p>"
            + "<p>Se den i portalen for detaljer.</p>";

        await Epost.SendAsync(montor.Epost, $"Ny arbeidsordre tildelt - {_ordre.Tittel}", html);
    }

    private void VisRapportForhandsvisning()
    {
        _rapportPdfSavedMessage = null;
        _pdfPreviewUrl = $"/arbeidsordre/{Id}/rapport/pdf";
    }

    private async Task LagreRapportPdf()
    {
        var bytes = await ArbeidsordrePdfService.GenerateAsync(Id);
        if (bytes is null || _ordre is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "ArbeidsordreRapport", Id, $"Rapport - {_ordre.Tittel} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredeRapportPdfer.Add(pdf);
        _rapportPdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task Ferdigmeld()
    {
        _ordre!.Status = ArbeidsordreStatus.Ferdig;
        _ordre.FullfortAvBrukerId = _naverendeBrukerId;
        _ordre.FullfortAvBruker = _naverendeBruker;
        _ordre.FullfortDato = DateTime.Now;
        await Db.SaveChangesAsync();
        _ferdigmeldtMelding = "Ordren er ferdigmeldt og klar for fakturering.";

        var kundeEpost = _ordre.Prosjekt?.Kunde?.Epost;
        if (!string.IsNullOrWhiteSpace(kundeEpost))
        {
            var utfortHtml = string.IsNullOrWhiteSpace(_ordre.UtfortArbeid) ? "" : "<p><strong>Utført arbeid:</strong> " + System.Net.WebUtility.HtmlEncode(_ordre.UtfortArbeid).Replace("\n", "<br>") + "</p>";
            var anbefalingerHtml = string.IsNullOrWhiteSpace(_ordre.Anbefalinger) ? "" : "<p><strong>Anbefalinger:</strong> " + System.Net.WebUtility.HtmlEncode(_ordre.Anbefalinger).Replace("\n", "<br>") + "</p>";
            var html = "<p>Hei " + (_ordre.Prosjekt?.Kunde?.Navn ?? "") + ",</p>"
                + "<p>Her er dokumentasjon fra jobben \"" + System.Net.WebUtility.HtmlEncode(_ordre.Tittel) + "\":</p>"
                + utfortHtml + anbefalingerHtml
                + "<p>Mvh itlock AS</p>";

            var vedlegg = _media.Select(m => (m.Filnavn, m.Data));
            var ok = await Epost.SendAsync(kundeEpost, $"Dokumentasjon - {_ordre.Tittel}", html, vedlegg);
            if (ok)
            {
                _ordre.DokumentasjonEpostSendtDato = DateTime.Now;
                await Db.SaveChangesAsync();
                _ferdigmeldtMelding = "Ordren er ferdigmeldt og klar for fakturering. Dokumentasjon sendt til kunden.";
            }
        }
    }

    private async Task MarkerFakturert()
    {
        _ordre!.Status = ArbeidsordreStatus.Fakturert;
        _ordre.FakturertDato = DateTime.Now;
        await Db.SaveChangesAsync();
        _ferdigmeldtMelding = "Ordren er markert som fakturert.";
    }

    private async Task BrukMal()
    {
        if (_valgtMalId is null)
        {
            return;
        }

        var punkter = await Db.SjekklistePunkter
            .Where(p => p.SjekklisteMalId == _valgtMalId)
            .OrderBy(p => p.Rekkefolge)
            .ToListAsync();

        foreach (var punkt in punkter)
        {
            Db.ArbeidsordreSjekkpunkter.Add(new ArbeidsordreSjekkpunkt
            {
                ArbeidsordreId = Id,
                Tekst = punkt.Tekst,
                Rekkefolge = punkt.Rekkefolge
            });
        }

        await Db.SaveChangesAsync();
        _sjekkpunkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .Include(p => p.FullfortAvBruker)
            .ToListAsync();
    }

    private async Task LagreSjekkpunkt(ArbeidsordreSjekkpunkt punkt)
    {
        var entitet = await Db.ArbeidsordreSjekkpunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Fullfort = punkt.Fullfort;
        entitet.FullfortDato = punkt.Fullfort ? DateTime.Now : null;
        entitet.FullfortAvBrukerId = punkt.Fullfort ? _naverendeBrukerId : null;
        await Db.SaveChangesAsync();

        punkt.FullfortDato = entitet.FullfortDato;
        punkt.FullfortAvBruker = punkt.Fullfort ? _naverendeBruker : null;

        await OppdaterKartFargeAsync();
    }

    private async Task FjernSjekkliste()
    {
        var punkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .ToListAsync();

        Db.ArbeidsordreSjekkpunkter.RemoveRange(punkter);
        await Db.SaveChangesAsync();
        _sjekkpunkter = [];

        await OppdaterKartFargeAsync();
    }

    private void VisSjekklistePdfForhandsvisning()
    {
        _sjekklistePdfSavedMessage = null;
        _sjekklistePdfPreviewUrl = $"/arbeidsordre/{Id}/sjekkliste/pdf";
    }

    private async Task LagreSjekklistePdf()
    {
        var bytes = await SjekklistePdfService.GenerateAsync(Id);
        if (bytes is null || _ordre is null)
        {
            return;
        }

        var pdf = new SjekklistePdf
        {
            ArbeidsordreId = Id,
            Navn = $"Sjekkliste - {_ordre.Tittel} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf",
            Data = bytes
        };

        Db.SjekklistePdfer.Add(pdf);
        await Db.SaveChangesAsync();

        _lagredeSjekklistePdfer.Add(pdf);
        _sjekklistePdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task OppdaterKartFargeAsync()
    {
        if (!_visKart || !_kartInitialisert)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("kart.oppdaterPunkter", new List<object> { LagKartPunkt() });
        }
        catch (JSException)
        {
            // Ikke kritisk - kartet oppdateres uansett neste gang siden fylles ut på nytt.
        }
    }

    private object LagKartPunkt()
    {
        var (farge, statusTekst) = SjekklisteStatusHelper.Beregn(_sjekkpunkter);
        return new
        {
            lat = _ordre!.Latitude!.Value,
            lng = _ordre.Longitude!.Value,
            tittel = _ordre.Tittel,
            undertekst = _ordre.Adresse,
            status = statusTekst,
            farge
        };
    }

    private async Task VisKart()
    {
        _kartFeil = null;

        if (string.IsNullOrWhiteSpace(_ordre!.Adresse))
        {
            _kartFeil = "Fyll inn adresse først.";
            return;
        }

        if (_ordre.Latitude is null || _ordre.Longitude is null)
        {
            var treff = await Geokoding.GeocodeAsync(_ordre.Adresse, _ordre.Postnr, _ordre.Sted);
            if (treff is null)
            {
                _kartFeil = "Fant ikke posisjon for denne adressen.";
                return;
            }

            _ordre.Latitude = treff.Value.Latitude;
            _ordre.Longitude = treff.Value.Longitude;
            await Db.SaveChangesAsync();
        }

        _visKart = true;
        _kartInitialisert = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _erMobilvisning = await JS.InvokeAsync<bool>("erMobilvisning");
            StateHasChanged();
        }

        if (_visKart && !_kartInitialisert && _ordre?.Latitude is not null && _ordre.Longitude is not null)
        {
            await JS.InvokeVoidAsync("kart.init", "ordre-kart-visning", new[] { LagKartPunkt() });
            _kartInitialisert = true;
        }
    }

    private async Task SlettOrdre()
    {
        Db.Arbeidsordre.Remove(_ordre!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/arbeidsordre");
    }
