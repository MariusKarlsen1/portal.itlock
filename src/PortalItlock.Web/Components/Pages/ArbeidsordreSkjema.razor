@page "/arbeidsordre/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject GeocodingService Geokoding
@inject IJSRuntime JS
@inject EmailService Epost
@inject SjekklistePdfService SjekklistePdfService
@inject ArbeidsordrePdfService ArbeidsordrePdfService
@inject LagretPdfService LagretPdfService
@inject TripletexSyncService TripletexSync
@inject TripletexService Tripletex
@inject TilleggsmodulService Tilleggsmoduler
@inject PlukkService PlukkSvc
@inject ReservasjonService ResSvc
@inject LagerService LagerSvc

<PageTitle>@(_ordre?.Tittel ?? "Arbeidsordre")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke arbeidsordren. Den kan være slettet.</p>
}
else if (_ordre is not null)
{
    <a class="back-link" href="/arbeidsordre">← Tilbake til arbeidsordre</a>

    <div class="ordre-header-rad">
        <h1 class="ordre-tittel-h1">@_ordre.Tittel</h1>
        <StatusPill Tekst="@_ordre.Status.Visningsnavn()" Ikon="@_ordre.Status.PillIkon()" Farge="@_ordre.Status.PillFarge()" />
        <span class="ordre-etikett">@(_ordre.Type?.Visningsnavn() ?? "Type ikke satt")</span>
    </div>

    <div class="ordre-kort">

    <div class="mobil-ordre-faner">
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "oversikt" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "oversikt")"><Icon Name="grid" />Oversikt</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "dorbeslag" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "dorbeslag")"><Icon Name="box" />Dørbeslag @if (VarerTotalt > 0) {<span class="fane-teller @(VarerPlukket == VarerTotalt ? "ok" : "")">@VarerPlukket/@VarerTotalt</span>}</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "servicepunkter" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "servicepunkter")"><Icon Name="check-circle" />Sjekkliste @if (_sjekkpunkter.Count > 0) {<span class="fane-teller @(SjekkFerdig == _sjekkpunkter.Count ? "ok" : "")">@SjekkFerdig/@_sjekkpunkter.Count</span>}</button>
        @if (_harTimer)
        {
            <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "timefoering" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "timefoering")"><Icon Name="clock" />Timeføring @if (_sumTimer > 0) {<span class="fane-teller">@_sumTimer.ToString("0.#", Kultur) t</span>}</button>
        }
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "kunde" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "kunde")"><Icon Name="users" />Kunde @if (HarKundeInfo) {<span class="fane-teller varsel">info</span>}</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "sluttrapport" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "sluttrapport")"><Icon Name="dokument-linjer" />Sluttrapport</button>
        <button type="button" class="mobil-ordre-fane-knapp fane-hoyre @(_mobilFaneOrdre == "detaljer" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "detaljer")"><Icon Name="settings" />Detaljer</button>
    </div>

    <div class="ordre-kort-body">
    <div class="ordre-kort-layout">
    <div class="ordre-kort-hoved">

    @* ===== Oversikt: jobben, fremdrift og beskjed fra kunden ===== *@
    <div class="@FaneKlasse("oversikt")">
        <section class="ao-blokk">
            <div class="ao-blokk-t"><h3>Jobben</h3>
                @if (KanEndreOrdre)
                {
                    <button type="button" class="ao-lenke" @onclick="@(() => _mobilFaneOrdre = "detaljer")">Endre</button>
                }
            </div>
            <div class="ao-fakta">
                <div class="ao-fakta-rad">
                    <span class="ao-fakta-ik"><Icon Name="calendar" /></span>
                    <span>
                        <b>@(_ordre.PlanlagtDato is { } pd ? Stor(pd.ToString("dddd d. MMM", Kultur)) : "Ikke planlagt")@TidTekst</b>
                        <small>@(_ordre.EstimerteTimer is > 0 ? $"Estimert {_ordre.EstimerteTimer.Value.ToString("0.#", Kultur)} t" : "Ikke estimert")@(string.IsNullOrWhiteSpace(_ordre.Hentehylle) ? "" : $" · Hentehylle {_ordre.Hentehylle}")</small>
                    </span>
                    <span></span>
                </div>
                <div class="ao-fakta-rad">
                    <span class="ao-fakta-ik"><Icon Name="map-pin" /></span>
                    <span>
                        <b>@(string.IsNullOrWhiteSpace(AdresseTekst) ? "Ingen adresse" : AdresseTekst)</b>
                        @if (_ordre.Prosjekt is not null || _ordre.TilbudId.HasValue || _knyttetTicket is not null)
                        {
                            <small class="ao-koblinger">
                                @if (_ordre.Prosjekt is not null)
                                {
                                    <a href="@($"/prosjekter/{_ordre.ProsjektId}")">Prosjekt @_ordre.Prosjekt.Navn</a>
                                }
                                @if (_ordre.TilbudId.HasValue)
                                {
                                    <a href="@($"/tilbud/{_ordre.TilbudId}")">Tilbud @_tilbudTittel</a>
                                }
                                @if (_knyttetTicket is not null)
                                {
                                    <a href="@($"/ticket/{_knyttetTicket.Id}")">Ticket #@_knyttetTicket.Id</a>
                                }
                            </small>
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(AdresseTekst))
                    {
                        <a class="ao-rund" href="@($"https://www.google.com/maps/dir/?api=1&destination={Uri.EscapeDataString(AdresseTekst)}")" target="_blank" rel="noopener" title="Veibeskrivelse" aria-label="Veibeskrivelse"><Icon Name="map" /></a>
                    }
                    else
                    {
                        <span></span>
                    }
                </div>
                <div class="ao-fakta-rad">
                    <span class="ao-fakta-ik"><Icon Name="users" /></span>
                    <span>
                        <b>@(KontaktNavn ?? _ordre.Kunde?.Navn ?? _ordre.Prosjekt?.Kunde?.Navn ?? "Ingen kunde")</b>
                        <small>@string.Join(" · ", new[] { KontaktNavn is null ? null : _ordre.Kunde?.Navn ?? _ordre.Prosjekt?.Kunde?.Navn, KontaktTelefon }.Where(s => !string.IsNullOrWhiteSpace(s)))</small>
                    </span>
                    <span class="ao-runde">
                        @if (KontaktTelefon is not null)
                        {
                            <a class="ao-rund" href="@($"tel:{KontaktTelefon.Replace(" ", "")}")" title="Ring @KontaktTelefon" aria-label="Ring"><Icon Name="phone" /></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_ordre.Kunde?.Epost))
                        {
                            <a class="ao-rund" href="@($"mailto:{_ordre.Kunde.Epost}")" title="Send e-post" aria-label="Send e-post"><Icon Name="mail" /></a>
                        }
                    </span>
                </div>
                <div class="ao-fakta-rad">
                    <span class="ao-av">@Initialer(MontorNavn)</span>
                    <span>
                        <b>@(MontorNavn ?? "Ikke tildelt montør")</b>
                        <small>Montør@(_ordre.Prosjekt?.Prosjektleder is { } pl ? $" · prosjektleder {pl.Navn}" : "")</small>
                    </span>
                    <span></span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_dobbeltbookingVarsel))
            {
                <p class="dobbeltbooking-varsel ao-varsel">@_dobbeltbookingVarsel</p>
            }
        </section>

        <section class="ao-blokk">
            <div class="ao-blokk-t"><h3>Fremdrift</h3></div>
            <div class="ao-steg">
                @FremdriftRad("Dørbeslag plukket", VarerPlukket, VarerTotalt, $"{VarerPlukket} av {VarerTotalt}", VarerTotalt == 0 ? "Ingen dørbeslag" : null, "dorbeslag")
                @FremdriftRad("Sjekkliste", SjekkFerdig, _sjekkpunkter.Count, $"{SjekkFerdig} av {_sjekkpunkter.Count}", _sjekkpunkter.Count == 0 ? "Ingen sjekkliste" : null, "servicepunkter")
                @if (_harTimer)
                {
                    var est = _ordre.EstimerteTimer ?? 0;
                    @FremdriftRad("Timer ført", _sumTimer, est > 0 ? est : (_sumTimer > 0 ? _sumTimer : 1),
                        est > 0 ? $"{_sumTimer.ToString("0.#", Kultur)} av {est.ToString("0.#", Kultur)} t" : $"{_sumTimer.ToString("0.#", Kultur)} t",
                        _sumTimer == 0 ? "Ingen timer ennå" : null, "timefoering")
                }
                @{ var skrevet = !string.IsNullOrWhiteSpace(_ordre.UtfortArbeid); }
                @FremdriftRad("Sluttrapport og bilder", skrevet ? 1 : 0, 1,
                    skrevet ? $"Skrevet · {_media.Count} {(_media.Count == 1 ? "bilde" : "bilder")}" : "Ikke skrevet", null, "sluttrapport")
            </div>
        </section>

        @if (HarKundeInfo)
        {
            <section class="ao-blokk ao-fra-kunde">
                <div class="ao-blokk-t"><h3>Fra kunden</h3>
                    <button type="button" class="ao-lenke" @onclick="@(() => _mobilFaneOrdre = "kunde")">Kunde →</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb))
                {
                    <p class="ao-kundeinfo">@_ordre.KundeInfoForJobb</p>
                }
                @if (_kundeBilder.Count > 0)
                {
                    <div class="ao-bilder">
                        @foreach (var m in _kundeBilder.Take(4))
                        {
                            <img @key="m.Id" src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                        }
                    </div>
                }
            </section>
        }

        @* Mobil: sidepanelet er skjult, så hovedknappene ligger nederst i oversikten. *@
        <div class="ao-mobil-knapper">
            @if (KanFerdigmelde && _ordre.Status is not (ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert))
            {
                <button type="button" class="ao-mknapp ao-mknapp-gronn" @onclick="@(() => { _mobilFaneOrdre = "sluttrapport"; VisFerdigmeldValg(); })"><Icon Name="check-circle" />Ferdigmeld</button>
            }
            @if (_harTimer)
            {
                <a class="ao-mknapp" href="@($"/timeregistrering?arbeidsordreId={_ordre.Id}")"><Icon Name="clock" />Timer</a>
            }
        </div>
    </div>

    <div class="@FaneKlasse("dorbeslag")">
    @Varestatus()
    @if (_tilbudVarer.Count > 0)
    {
        <section class="ordre-section">
            <div class="ordre-section-tittelrad">
                <h2>Varer å pakke</h2>
                <button type="button" class="add-button skann-knapp" @onclick="ApneSkanner"><Icon Name="camera" />Skann strekkode</button>
            </div>
            <ul class="varer-liste">
                @foreach (var l in _tilbudVarer)
                {
                    @if (l.ErGruppering)
                    {
                        <li @key="l.Id" class="varer-gruppering">
                            <strong>@l.Navn</strong>
                            @if (!string.IsNullOrWhiteSpace(l.Beskrivelse))
                            {
                                <span>@l.Beskrivelse</span>
                            }
                        </li>
                    }
                    else
                    {
                        <li @key="l.Id" class="varer-rad @(l.Plukket ? "varer-rad-plukket" : "")">
                            <span class="varer-rad-venstre">
                                <input type="checkbox" class="varer-plukket-checkbox" @bind="l.Plukket" @bind:after="@(() => LagreTilbudLinjePlukket(l))" />
                                <span class="varer-rad-navn">@l.Navn</span>@StatusChip(l.ComponentId, l.Antall, l.Plukket)
                            </span>
                            <span class="varer-antall">@l.Antall @(l.Enhet ?? "stk")</span>
                        </li>
                    }
                }
            </ul>
        </section>

        @if (_erMobilvisning)
        {
            var tilbudByttetVarer = _ordre.Varer.Where(v => v.LagtTilAvBrukerId is not null).ToList();
            <section class="ordre-section">
                <div class="montor-tillegg-varsel">
                    <h3>Lagt til i tillegg</h3>

                    <div class="component-search">
                        @BilHint()
                        <label>
                            Søk etter vare
                            <input @bind="_vareSok" @bind:event="oninput" @bind:after="SokVarer" placeholder="Navn eller artikkelnr..." />
                        </label>
                        @if (_vareSokResultater.Count > 0)
                        {
                            <ul class="search-results">
                                @foreach (var c in _vareSokResultater)
                                {
                                    <li>
                                        <button type="button" class="search-result" @onclick="@(() => LeggTilVare(c))">
                                            <span class="search-result-name">@c.Navn</span>
                                            <span class="search-result-meta">@c.Leverandor</span>@SokStatus(c)
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (tilbudByttetVarer.Count == 0)
                    {
                        <p class="list-empty">Ingen varer lagt til her ennå.</p>
                    }
                    else
                    {
                        <table class="varer-table">
                            <thead>
                                <tr>
                                    <th>Vare</th>
                                    <th>Antall</th>
                                    <th>Lagt til av</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in tilbudByttetVarer)
                                {
                                    <tr @key="v.Id">
                                        <td>@v.Navn@if (v.FraLagerId is not null) {<span class="ao-frabil">fra bilen</span>} else {@StatusChip(v.ComponentId, v.Antall, v.Plukket)}</td>
                                        <td><input type="number" min="1" class="antall-input" @bind="v.Antall" @bind:after="@(() => LagreVare(v))" /></td>
                                        <td>@(v.LagtTilAvBruker?.Navn ?? "Ukjent") @(v.LagtTilDato.HasValue ? $"- {v.LagtTilDato.Value:dd.MM.yyyy HH:mm}" : "")</td>
                                        <td><button type="button" class="remove-button" @onclick="@(() => FjernVare(v))">Fjern</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>
        }
    }

    @if (!_ordre.TilbudId.HasValue)
    {
        <section class="ordre-section">
            <div class="ordre-section-tittelrad">
                <h2>Varer å pakke</h2>
                <button type="button" class="add-button skann-knapp" @onclick="ApneSkanner"><Icon Name="camera" />Skann strekkode</button>
            </div>

            @if (!_erMobilvisning)
            {
                <div class="component-search">
                    @BilHint()
                    <label>
                        Søk etter vare
                        <input @bind="_vareSok" @bind:event="oninput" @bind:after="SokVarer" placeholder="Navn eller artikkelnr..." />
                    </label>
                    @if (_vareSokResultater.Count > 0)
                    {
                        <ul class="search-results">
                            @foreach (var c in _vareSokResultater)
                            {
                                <li>
                                    <button type="button" class="search-result" @onclick="@(() => LeggTilVare(c))">
                                        <span class="search-result-name">@c.Navn</span>
                                        <span class="search-result-meta">@c.Leverandor</span>@SokStatus(c)
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            @{ var planlagteVarer = _ordre.Varer.Where(v => v.LagtTilAvBrukerId is null).ToList(); }
            @if (planlagteVarer.Count == 0)
            {
                <p class="list-empty">Ingen varer lagt til ennå.</p>
            }
            else if (_erMobilvisning)
            {
                <ul class="varer-liste">
                    @foreach (var v in planlagteVarer)
                    {
                        <li @key="v.Id" class="varer-rad @(v.Plukket ? "varer-rad-plukket" : "")">
                            <span class="varer-rad-venstre">
                                <input type="checkbox" class="varer-plukket-checkbox" @bind="v.Plukket" @bind:after="@(() => LagreVarePlukket(v))" />
                                <span class="varer-rad-navn">@v.Navn</span>@StatusChip(v.ComponentId, v.Antall, v.Plukket || v.FraLagerId is not null)
                            </span>
                            <span class="varer-antall">@v.Antall stk</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <table class="varer-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Vare</th>
                            <th>Antall</th>
                            @if (ErAdminEllerPl)
                            {
                                <th>Utpris</th>
                                <th>Kostpris</th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in planlagteVarer)
                        {
                            <tr @key="v.Id" class="@(v.Plukket ? "varer-rad-plukket" : "")">
                                <td><input type="checkbox" class="varer-plukket-checkbox" @bind="v.Plukket" @bind:after="@(() => LagreVarePlukket(v))" /></td>
                                <td class="varer-rad-navn">@v.Navn@StatusChip(v.ComponentId, v.Antall, v.Plukket)</td>
                                <td><input type="number" min="1" class="antall-input" @bind="v.Antall" @bind:after="@(() => LagreVare(v))" /></td>
                                @if (ErAdminEllerPl)
                                {
                                    <td><input type="number" step="0.01" class="pris-input" @bind="v.Utpris" @bind:after="@(() => LagreVare(v))" /></td>
                                    <td><input type="number" step="0.01" class="pris-input" @bind="v.Kostpris" @bind:after="@(() => LagreVare(v))" /></td>
                                }
                                <td><button type="button" class="remove-button" @onclick="@(() => FjernVare(v))">Fjern</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @{ var byttetVarer = _ordre.Varer.Where(v => v.LagtTilAvBrukerId is not null).ToList(); }
            @if (_erMobilvisning || byttetVarer.Count > 0)
            {
                <div class="montor-tillegg-varsel">
                    <h3>Lagt til i tillegg</h3>

                    @if (_erMobilvisning)
                    {
                        <div class="component-search">
                            @BilHint()
                            <label>
                                Søk etter vare
                                <input @bind="_vareSok" @bind:event="oninput" @bind:after="SokVarer" placeholder="Navn eller artikkelnr..." />
                            </label>
                            @if (_vareSokResultater.Count > 0)
                            {
                                <ul class="search-results">
                                    @foreach (var c in _vareSokResultater)
                                    {
                                        <li>
                                            <button type="button" class="search-result" @onclick="@(() => LeggTilVare(c))">
                                                <span class="search-result-name">@c.Navn</span>
                                                <span class="search-result-meta">@c.Leverandor</span>@SokStatus(c)
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    @if (byttetVarer.Count == 0)
                    {
                        <p class="list-empty">Ingen varer lagt til her ennå.</p>
                    }
                    else
                    {
                        <table class="varer-table">
                            <thead>
                                <tr>
                                    <th>Vare</th>
                                    <th>Antall</th>
                                    <th>Lagt til av</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in byttetVarer)
                                {
                                    <tr @key="v.Id">
                                        <td>@v.Navn@if (v.FraLagerId is not null) {<span class="ao-frabil">fra bilen</span>} else {@StatusChip(v.ComponentId, v.Antall, v.Plukket)}</td>
                                        <td><input type="number" min="1" class="antall-input" @bind="v.Antall" @bind:after="@(() => LagreVare(v))" /></td>
                                        <td>@(v.LagtTilAvBruker?.Navn ?? "Ukjent") @(v.LagtTilDato.HasValue ? $"- {v.LagtTilDato.Value:dd.MM.yyyy HH:mm}" : "")</td>
                                        <td><button type="button" class="remove-button" @onclick="@(() => FjernVare(v))">Fjern</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </section>
    }

    @if (!_harTimer)
    {
        @if (VisKjoringOgTillegg) { @KjoringOgTillegg() }
    }
    </div>

    <div class="@FaneKlasse("detaljer")">
    @if (ErAdminEllerPl)
    {
        <section class="ordre-section">
            <h2>Ticket</h2>
            @if (_knyttetTicket is not null)
            {
                <p class="tilbud-link">Knyttet til ticket: <a href="@($"/ticket/{_knyttetTicket.Id}")">#@_knyttetTicket.Id - @_knyttetTicket.Tittel</a> (@_knyttetTicket.Status.Visningsnavn())</p>
            }
            else
            {
                <div class="ticket-knytt-rad">
                    <select @bind="_valgtTicketId">
                        <option value="">Velg ledig ticket...</option>
                        @foreach (var t in _ledigeTickets)
                        {
                            <option value="@t.Id">#@t.Id - @t.Tittel</option>
                        }
                    </select>
                    <button type="button" class="cancel-button" @onclick="KnyttTicket" disabled="@(_valgtTicketId is null)">Knytt ticket</button>
                    <button type="button" class="add-button" @onclick="OpprettOgKnyttTicket">Opprett ny ticket</button>
                </div>
            }
        </section>
    }

    <section class="ordre-section">
        <div class="field-grid">
            <label class="span-2 mobil-las-felt">
                Tittel
                <input @bind="_ordre.Tittel" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
            <label class="span-2 mobil-las-felt">
                Beskrivelse
                <textarea rows="3" @bind="_ordre.Beskrivelse" @bind:after="AutoLagre" placeholder="Info om jobben" disabled="@_erMobilvisning"></textarea>
            </label>
            <label class="mobil-las-felt">
                Prosjekt
                <select @bind="_ordre.ProsjektId" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var p in _prosjekter)
                    {
                        <option value="@p.Id">@p.Navn</option>
                    }
                </select>
            </label>
            <label class="mobil-las-felt">
                Kunde
                @if (_ordre.TilbudId.HasValue)
                {
                    <input value="@(_ordre.Kunde?.Navn ?? "Ikke satt")" disabled title="Hentes automatisk fra tilbudet" />
                }
                else
                {
                    <select @bind="_ordre.KundeId" disabled="@_erMobilvisning">
                        <option value="">Ikke satt</option>
                        @foreach (var k in _kunder)
                        {
                            <option value="@k.Id">@k.Navn</option>
                        }
                    </select>
                }
            </label>
            <label>
                Referanse
                <input value="@(_ordre.Prosjekt?.Prosjektleder?.Navn ?? "Ikke satt")" disabled />
            </label>
            <label class="mobil-las-felt">
                Ansvarlig montør
                <select @bind="_ordre.AnsvarligMontorId" @bind:after="SjekkDobbeltbooking" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var m in _montorer)
                    {
                        <option value="@m.Id">@m.Navn</option>
                    }
                </select>
            </label>
            <label class="mobil-las-felt">
                Type
                <select @bind="_ordre.Type" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var t in Enum.GetValues<ArbeidsordreType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Status
                <select @bind="_ordre.Status">
                    @foreach (var s in Enum.GetValues<ArbeidsordreStatus>())
                    {
                        <option value="@s">@s.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label class="mobil-las-felt">
                Planlagt dato
                <input type="date" @bind="_planlagtDato" @bind:after="SjekkDobbeltbooking" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Fra klokkeslett
                <input type="time" @bind="_fraKlokkeslett" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Til klokkeslett
                <input type="time" @bind="_tilKlokkeslett" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Estimert timer
                <input type="number" step="0.5" min="0" @bind="_ordre.EstimerteTimer" @bind:after="AutoLagre" disabled="@_erMobilvisning" />
            </label>
            <label class="span-2 mobil-las-felt">
                Hentehylle
                <input @bind="_ordre.Hentehylle" @bind:event="oninput" placeholder="F.eks. hylle 4B - varer til henting" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Adresse
                <input @bind="_ordre.Adresse" @bind:event="oninput" placeholder="F.eks. Gartnerveien 2" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Postnr
                <input @bind="_ordre.Postnr" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Sted
                <input @bind="_ordre.Sted" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
        </div>

        @if (!string.IsNullOrEmpty(_dobbeltbookingVarsel))
        {
            <p class="dobbeltbooking-varsel">@_dobbeltbookingVarsel</p>
        }

        <div class="form-actions">
            @* "Registrer timer" blir stående for alle - det er det ene en
               montør skal kunne gjøre her. Lagre forsvinner for dem. *@
            @if (KanEndreOrdre)
            {
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            }
            @if (_harTimer)
            {
                <a class="add-button" href="@($"/timeregistrering?arbeidsordreId={_ordre.Id}")">Registrer timer</a>
            }
            <button type="button" class="cancel-button" @onclick="VisKart">Vis på kart</button>
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_kartFeil))
        {
            <p class="form-error">@_kartFeil</p>
        }

        @if (_visKart)
        {
            <div id="ordre-kart-visning" class="ordre-kart-container"></div>
        }
    </section>

    @* Slett ligger i en egen faresone nederst i Detaljer. *@
    @if (KanEndreOrdre)
    {
        <section class="ordre-section ao-faresone mobil-slett-skjul">
            <div><b>Slett arbeidsordre</b><small>Sletter også registrerte timer på arbeidsordren.</small></div>
            @if (_confirmingDelete)
            {
                <span class="delete-confirm">
                    Er du sikker?
                    <button type="button" class="delete-confirm-button" @onclick="SlettOrdre">Ja, slett</button>
                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                </span>
            }
            else
            {
                <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett arbeidsordre</button>
            }
        </section>
    }
    </div>

    @if (_harTimer)
    {
    <div class="@FaneKlasse("timefoering")">
    <section class="ordre-section">
        <h2>
            Registrerte timer <span class="sum-timer">(@_sumTimer.ToString("N1", Kultur) t totalt)</span>
            <StatusPill Tekst="@_ordre.Status.Visningsnavn()" Ikon="@_ordre.Status.PillIkon()" Farge="@_ordre.Status.PillFarge()" />
        </h2>

        @if (_registreringer.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert på denne arbeidsordren ennå.</p>
        }
        else
        {
            <table class="reg-table">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th>Montør</th>
                        <th>Type</th>
                        <th>Timer</th>
                        @if (ArbeidKoder().Count > 0)
                        {
                            <th>Kode</th>
                        }
                        <th>Kommentar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _registreringer)
                    {
                        <tr @key="r.Id">
                            <td>@r.Dato.ToString("dd.MM.yyyy")</td>
                            <td>@r.MontorNavn</td>
                            <td>@r.Type.Visningsnavn()</td>
                            <td class="timer-cell">@r.Timer.ToString("N1", Kultur) t</td>
                            @if (ArbeidKoder().Count > 0)
                            {
                                <td>
                                    @if (ErAdminEllerPl && ArbeidKoder().Count > 1)
                                    {
                                        <select class="aok-timekode" value="@(r.PrisKodeId is { } pk && pk != ArbeidsordreOkonomiBeregner.Montasjekode(_prisKoder)?.Id ? pk.ToString() : "0")" @onchange="@(e => SettTimeKode(r, e))" aria-label="Kode for timene">
                                            <option value="0">@KodeTekst(null)</option>
                                            @foreach (var k in ArbeidKoder().Where(k => k.Id != ArbeidsordreOkonomiBeregner.Montasjekode(_prisKoder)?.Id))
                                            {
                                                <option value="@k.Id">@k.Kode @k.Navn</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @KodeTekst(r.PrisKodeId)
                                    }
                                </td>
                            }
                            <td>@r.Kommentar</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    @if (VisKjoringOgTillegg) { @KjoringOgTillegg() }
    </div>
    }

    <div class="@FaneKlasse("servicepunkter")">
    <section class="ordre-section">
        <h2>Sjekkliste @if (_sjekkpunkter.Count > 0) { <span class="sum-timer">(@_sjekkpunkter.Count(p => p.Fullfort)/@_sjekkpunkter.Count fullført)</span> }</h2>

        @if (_sjekkpunkter.Count == 0)
        {
            @if (_maler.Count == 0)
            {
                <p class="list-empty">Ingen sjekklistemaler er opprettet. Legg til under Sjekklistemaler i admin.</p>
            }
            else
            {
                <div class="sjekkliste-velg">
                    <select @bind="_valgtMalId">
                        <option value="">Velg dørtype...</option>
                        @foreach (var m in _maler)
                        {
                            <option value="@m.Id">@m.Dortype</option>
                        }
                    </select>
                    <button type="button" class="add-button" @onclick="BrukMal" disabled="@(_valgtMalId is null)">Bruk sjekkliste</button>
                </div>
            }
        }
        else
        {
            <ol class="sjekkpunkt-list">
                @foreach (var p in _sjekkpunkter.OrderBy(p => p.Rekkefolge))
                {
                    <li @key="p.Id">
                        <label>
                            <input type="checkbox" @bind="p.Fullfort" @bind:after="@(() => LagreSjekkpunkt(p))" />
                            <span class="@(p.Fullfort ? "sjekkpunkt-fullfort" : "")">@p.Tekst</span>
                        </label>
                        @if (p.Fullfort && p.FullfortDato.HasValue)
                        {
                            <span class="sjekkpunkt-meta">
                                @p.FullfortDato.Value.ToString("dd.MM.yyyy HH:mm") @(p.FullfortAvBruker is not null ? $"({p.FullfortAvBruker.Initialer})" : "")
                            </span>
                        }
                    </li>
                }
            </ol>
            <div class="form-actions">
                <button type="button" class="add-button" @onclick="VisSjekklistePdfForhandsvisning">Lagre som PDF</button>
                <button type="button" class="remove-button" @onclick="FjernSjekkliste">Fjern sjekkliste</button>
            </div>

            @if (_lagredeSjekklistePdfer.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var pdf in _lagredeSjekklistePdfer.OrderByDescending(p => p.OpprettetDato))
                    {
                        <li @key="pdf.Id" class="vedlegg-item">
                            <a href="@($"/sjekklistepdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                            <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                        </li>
                    }
                </ul>
            }

            <PdfPreviewModal Url="@_sjekklistePdfPreviewUrl" Tittel="Forhåndsvisning av sjekkliste" SaveMessage="@_sjekklistePdfSavedMessage"
                              OnSave="LagreSjekklistePdf" OnClose="@(() => _sjekklistePdfPreviewUrl = null)" />
        }
    </section>
    </div>

    <div class="@FaneKlasse("kunde")">
    <section class="ordre-section">
        <h2>Kunde</h2>
        <div class="field-grid">
            <label>
                Ordrenr
                <input value="@($"#{_ordre.Id}")" disabled />
            </label>
            <label>
                Adresse
                <input value="@(string.Join(", ", new[] { _ordre.Adresse, _ordre.Postnr, _ordre.Sted }.Where(s => !string.IsNullOrWhiteSpace(s))))" disabled />
            </label>
            <label>
                Kontaktperson
                <input value="@(_ordre.Prosjekt?.Kontaktperson ?? "Ikke satt")" disabled />
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb) || _kundeBilder.Count > 0)
    {
        <section class="ordre-section">
            <h2>Info fra kunde</h2>
            @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb))
            {
                <p>@_ordre.KundeInfoForJobb</p>
            }
            @if (_kundeBilder.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _kundeBilder)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                        </div>
                    }
                </div>
            }
        </section>
    }
    </div>

    <div class="@FaneKlasse("sluttrapport")">
    <section class="ordre-section">
        <h2>Sluttrapport</h2>
        <div class="field-grid">
            @* Sluttrapporten hører til ferdigmeldingen, ikke til redigering av
               selve ordren - montøren som lukker jobben må kunne skrive hva
               som ble gjort, ellers går dokumentasjonen til kunden ut tom. *@
            <label class="span-2">
                Hva er gjort
                <textarea rows="4" @bind="_ordre.UtfortArbeid" @bind:after="LagreSluttrapport" placeholder="Beskriv hva som ble utført på jobben"></textarea>
            </label>
            <label class="span-2">
                Hva var galt / anbefalinger (valgfritt)
                <textarea rows="3" @bind="_ordre.Anbefalinger" @bind:after="LagreSluttrapport" placeholder="Eventuelle avvik, feil eller anbefalinger"></textarea>
            </label>
        </div>

        <div class="bilder-seksjon">
            <h3>Bilder</h3>
            <InputFile OnChange="LastOppBilder" accept="image/*" multiple />
            @if (!string.IsNullOrEmpty(_bildeFeil))
            {
                <p class="form-error">@_bildeFeil</p>
            }
            @if (_media.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _media)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                            <button type="button" class="remove-button" @onclick="@(() => SlettMedia(m))">Slett</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="form-actions">
            @if (KanEndreOrdre)
            {
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                <button type="button" class="add-button" @onclick="VisRapportForhandsvisning">Generer rapport</button>
            }
            @if (_ordre.Status == ArbeidsordreStatus.Fakturert)
            {
                <span class="save-success">
                    Fakturert @(_ordre.FakturertDato?.ToString("dd.MM.yyyy"))
                    @(_ordre.DokumentasjonEpostSendtDato.HasValue ? " - dokumentasjon sendt til kunde" : "")
                </span>
            }
            else if (_ordre.Status == ArbeidsordreStatus.Ferdig)
            {
                <span class="save-success">
                    Ferdigmeldt - klar for fakturering
                    @(_ordre.DokumentasjonEpostSendtDato.HasValue ? " - dokumentasjon sendt til kunde" : "")
                </span>
                @if (KanEndreOrdre)
                {
                    <button type="button" class="fakturert-button" @onclick="MarkerFakturert">Fakturert</button>
                }
            }
            else if (KanFerdigmelde)
            {
                <button type="button" class="ferdigmeld-button" @onclick="VisFerdigmeldValg">Ferdigmeld</button>
            }
            @if (!string.IsNullOrEmpty(_ferdigmeldtMelding))
            {
                <span class="save-success">@_ferdigmeldtMelding</span>
            }
        </div>

        @if (_visFerdigmeldModal)
        {
            <div class="ferdigmeld-modal-overlay" @onclick="@(() => _visFerdigmeldModal = false)">
                <div class="ferdigmeld-modal" @onclick:stopPropagation="true">
                    <h3>Overføring til Tripletex</h3>
                    <p class="section-hint">Velg hvordan arbeidsordren skal overføres til Tripletex som ordre klar for fakturering.</p>

                    <label class="ferdigmeld-valg">
                        <input type="radio" name="overforingstype" checked="@(_valgtOverforingsType == TripletexOverforingsType.AlleLinjer)"
                               @onchange="@(() => _valgtOverforingsType = TripletexOverforingsType.AlleLinjer)" />
                        <span>Overfør alle ordrelinjer<br /><small>Alle varer, montasje og timer som egne linjer.</small></span>
                    </label>
                    <label class="ferdigmeld-valg">
                        <input type="radio" name="overforingstype" checked="@(_valgtOverforingsType == TripletexOverforingsType.KunSum)"
                               @onchange="@(() => _valgtOverforingsType = TripletexOverforingsType.KunSum)" />
                        <span>Overfør bare sum<br /><small>Én linje med prosjektnavn og totalsum.</small></span>
                    </label>
                    <label class="ferdigmeld-valg">
                        <input type="radio" name="overforingstype" checked="@(_valgtOverforingsType == TripletexOverforingsType.Akonto)"
                               @onchange="@(() => _valgtOverforingsType = TripletexOverforingsType.Akonto)" />
                        <span>Akonto<br /><small>Manuelt beløp og kommentar.</small></span>
                    </label>

                    @if (_valgtOverforingsType == TripletexOverforingsType.Akonto)
                    {
                        <div class="ferdigmeld-akonto-felt">
                            <label>
                                Beløp (eks. mva)
                                <input type="number" step="0.01" @bind="_akontoBelop" />
                            </label>
                            <label>
                                Kommentar
                                <input @bind="_akontoKommentar" placeholder="F.eks. Akonto nr. 1" />
                            </label>
                        </div>
                    }

                    <div class="ferdigmeld-modal-actions">
                        <button type="button" class="cancel-button" @onclick="@(() => _visFerdigmeldModal = false)">Avbryt</button>
                        <button type="button" class="save-button" @onclick="BekreftFerdigmeld">Bekreft og ferdigmeld</button>
                    </div>
                </div>
            </div>
        }

        @if (_ordre.FullfortAvBruker is not null)
        {
            <p class="fullfort-av-tekst">
                Fullført av @_ordre.FullfortAvBruker.Navn@(_ordre.FullfortDato.HasValue ? $" - {_ordre.FullfortDato.Value:dd.MM.yyyy HH:mm}" : "")
            </p>
        }

        @if (_ordre.TripletexOrdreId is not null)
        {
            <p class="fullfort-av-tekst">
                Sendt til Tripletex som ordre #@_ordre.TripletexOrdreNummer@(_ordre.TripletexOrdreSendtDato.HasValue ? $" - {_ordre.TripletexOrdreSendtDato.Value:dd.MM.yyyy HH:mm}" : "")
            </p>
        }
        else if (!string.IsNullOrWhiteSpace(_ordre.TripletexOrdreFeil))
        {
            <p class="form-error">
                Ikke sendt til Tripletex: @_ordre.TripletexOrdreFeil
                <button type="button" class="cancel-button" @onclick="VisTripletexRetry">Prøv på nytt</button>
            </p>
        }
    </section>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av arbeidsordrerapport" SaveMessage="@_rapportPdfSavedMessage"
                      OnSave="LagreRapportPdf" OnClose="@(() => _pdfPreviewUrl = null)" />

    <section class="ordre-section">
        <h2>Lagrede rapport-PDF-er</h2>
        <LagredePdfListe Pdfer="_lagredeRapportPdfer" />
    </section>

    </div>

    </div>

    @if (_visSkannerModal)
    {
        <div class="skann-modal-overlay" @onclick="LukkSkanner">
            <div class="skann-modal" @onclick:stopPropagation="true">
                <h3>Skann strekkode</h3>
                <p class="section-hint">Rett kameraet mot EAN-koden på varen for å hake den av som plukket.</p>
                <video @ref="_skannerVideoRef" class="skann-video" muted playsinline></video>
                <p class="skann-status @(_skannerTreffMelding is not null ? "skann-status-treff" : "")">
                    @(_skannerTreffMelding ?? _skannerFeil ?? "Venter på strekkode...")
                </p>
                <div class="skann-modal-actions">
                    <button type="button" class="cancel-button" @onclick="LukkSkanner">Lukk</button>
                </div>
            </div>
        </div>
    }

    <aside class="ordre-kort-sido">
        <div class="ao-side-blokk">
            <h2>Handlinger</h2>
            @if (KanFerdigmelde && _ordre.Status is not (ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert))
            {
                <button type="button" class="ordre-sido-knapp ordre-sido-knapp-gronn" @onclick="@(() => { _mobilFaneOrdre = "sluttrapport"; VisFerdigmeldValg(); })"><Icon Name="check-circle" />Ferdigmeld</button>
            }
            @if (_harTimer)
            {
                <a class="ordre-sido-knapp ordre-sido-knapp-lys" href="@($"/timeregistrering?arbeidsordreId={_ordre.Id}")"><Icon Name="clock" />Registrer timer</a>
            }
            <details class="ao-mer">
                <summary class="ordre-sido-knapp ordre-sido-knapp-lys"><Icon Name="more-horizontal" />Mer</summary>
                <div class="ao-mer-liste">
                    @if (KanEndreOrdre)
                    {
                        <button type="button" @onclick="Lagre"><Icon Name="check" />Lagre</button>
                        <button type="button" @onclick="@(() => { _mobilFaneOrdre = "sluttrapport"; VisRapportForhandsvisning(); })"><Icon Name="file-text" />Generer rapport</button>
                    }
                    <button type="button" @onclick="@(async () => { _mobilFaneOrdre = "detaljer"; await VisKart(); })"><Icon Name="map" />Vis på kart</button>
                    <button type="button" @onclick="@(() => _mobilFaneOrdre = "sluttrapport")"><Icon Name="arrow-right" />Gå til sluttrapport</button>
                </div>
            </details>
        </div>

        @if (SisteAktivitet.Count > 0)
        {
            <div class="ao-side-blokk">
                <h2>Siste</h2>
                <div class="ao-siste">
                    @foreach (var a in SisteAktivitet.Take(4))
                    {
                        <div><span>@a.Tittel</span><time>@a.Tid</time></div>
                    }
                </div>
            </div>
        }
    </aside>
    </div>
    </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class RegistreringRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string MontorNavn { get; set; } = "";
        public TimeregistreringType Type { get; set; }
        public decimal Timer { get; set; }
        public string? Kommentar { get; set; }
        public int? PrisKodeId { get; set; }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Arbeidsordre? _ordre;
    private string _mobilFaneOrdre = "oversikt";
    private string FaneKlasse(string fane) => _mobilFaneOrdre == fane ? "mobil-ordre-fane-vis" : "mobil-ordre-fane-skjul";

    // ---------- Oversikt-fanen, tellere og sidepanel ----------

    private sealed record Aktivitet(DateTime Tidspunkt, string Tittel, string Undertekst, string Ikon, string Farge, string Tid);

    // Varene som skal plukkes: fra tilbudet, eller lagt inn på ordren (uten tilbud).
    private int VarerTotalt => _ordre is null ? 0 : _ordre.TilbudId.HasValue
        ? _tilbudVarer.Count(l => !l.ErGruppering)
        : _ordre.Varer.Count(v => v.LagtTilAvBrukerId is null);

    private int VarerPlukket => _ordre is null ? 0 : _ordre.TilbudId.HasValue
        ? _tilbudVarer.Count(l => !l.ErGruppering && l.Plukket)
        : _ordre.Varer.Count(v => v.LagtTilAvBrukerId is null && v.Plukket);

    private int SjekkFerdig => _sjekkpunkter.Count(p => p.Fullfort);
    private bool HarKundeInfo => !string.IsNullOrWhiteSpace(_ordre?.KundeInfoForJobb) || _kundeBilder.Count > 0;

    private static int Prosent(decimal del, decimal total) => total <= 0 ? 0 : (int)Math.Min(100, Math.Round(del / total * 100));

    private string? KontaktNavn => _ordre?.Prosjekt?.Kontaktperson is { Length: > 0 } p ? p
        : _ordre?.Kunde?.Kontaktperson is { Length: > 0 } k ? k : null;

    private string? KontaktTelefon => _ordre?.Kunde?.Telefon is { Length: > 0 } t ? t : null;

    private string AdresseTekst => _ordre is null ? "" : string.Join(", ", new[]
    {
        _ordre.Adresse,
        string.Join(" ", new[] { _ordre.Postnr, _ordre.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)))
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private string TidTekst => _fraKlokkeslett is { } fra
        ? $" · {fra:HH\\:mm}" + (_tilKlokkeslett is { } til ? $"–{til:HH\\:mm}" : "")
        : "";

    private static string Initialer(string? navn) => string.IsNullOrWhiteSpace(navn) ? "?"
        : string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    // Siste hendelser satt sammen fra timer, sjekkliste og varer lagt til i felt.
    private List<Aktivitet> SisteAktivitet
    {
        get
        {
            var liste = new List<Aktivitet>();
            foreach (var p in _sjekkpunkter.Where(p => p.Fullfort && p.FullfortDato.HasValue))
            {
                liste.Add(new(p.FullfortDato!.Value, "Sjekkpunkt fullført", $"«{p.Tekst}»{(p.FullfortAvBruker is null ? "" : $" · {p.FullfortAvBruker.Initialer}")}", "check", "gronn", Naar(p.FullfortDato.Value)));
            }
            foreach (var r in _registreringer.Where(_ => _harTimer))
            {
                liste.Add(new(r.Dato, $"{r.Timer.ToString("0.#", Kultur)} t registrert", $"{r.MontorNavn} · {r.Type.Visningsnavn()}", "clock", "bla", r.Dato.ToString("dd.MM")));
            }
            foreach (var v in _ordre!.Varer.Where(v => v.LagtTilAvBrukerId is not null && v.LagtTilDato.HasValue))
            {
                liste.Add(new(v.LagtTilDato!.Value, "Vare lagt til i felt", $"{v.Navn}{(v.LagtTilAvBruker is null ? "" : $" · {v.LagtTilAvBruker.Navn}")}", "box", "brun", Naar(v.LagtTilDato.Value)));
            }
            if (_ordre.FullfortDato is { } fd)
            {
                liste.Add(new(fd, "Ferdigmeldt", _ordre.FullfortAvBruker?.Navn ?? "", "check-circle", "gronn", Naar(fd)));
            }
            return liste.OrderByDescending(a => a.Tidspunkt).Take(6).ToList();
        }
    }

