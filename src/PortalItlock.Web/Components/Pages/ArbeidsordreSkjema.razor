    private static string Initialer(string? navn) => string.IsNullOrWhiteSpace(navn) ? "?"
        : string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    // Hva bør gjøres nå - vises øverst i Oversikt med en knapp rett dit.
    private Steg NesteSteg
    {
        get
        {
            if (_ordre!.Status == ArbeidsordreStatus.Fakturert)
            {
                return new("Jobben er fakturert", $"Fakturert {_ordre.FakturertDato:dd.MM.yyyy}", "check-circle", null, "");
            }
            if (_ordre.Status == ArbeidsordreStatus.Ferdig)
            {
                return new("Jobben er ferdigmeldt", "Klar for fakturering", "check-circle", "sluttrapport", "Se sluttrapport");
            }
            var nestePunkt = _sjekkpunkter.OrderBy(p => p.Rekkefolge).FirstOrDefault(p => !p.Fullfort);
            if (nestePunkt is not null)
            {
                return new($"Neste i sjekklisten: {nestePunkt.Tekst}", $"{_sjekkpunkter.Count - SjekkFerdig} av {_sjekkpunkter.Count} punkter gjenstår", "check-circle", "servicepunkter", "Gå til sjekkliste");
            }
            if (VarerPlukket < VarerTotalt)
            {
                return new("Plukk dørbeslagene", $"{VarerTotalt - VarerPlukket} av {VarerTotalt} er ikke plukket ennå", "box", "dorbeslag", "Gå til dørbeslag");
            }
            if (string.IsNullOrWhiteSpace(_ordre.UtfortArbeid))
            {
                return new("Skriv sluttrapporten", "Beskriv hva som er gjort og legg ved bilder", "dokument-linjer", "sluttrapport", "Skriv rapport");
            }
            return new("Alt er klart – ferdigmeld jobben", "Sluttrapporten er skrevet", "check-circle", "sluttrapport", "Ferdigmeld");
        }
    }

