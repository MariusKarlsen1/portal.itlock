    // Siste hendelser satt sammen fra timer, sjekkliste og varer lagt til i felt.
    private List<Aktivitet> SisteAktivitet
    {
        get
        {
            var liste = new List<Aktivitet>();
            foreach (var p in _sjekkpunkter.Where(p => p.Fullfort && p.FullfortDato.HasValue))
            {
                liste.Add(new(p.FullfortDato!.Value, "Sjekkpunkt fullført", $"«{p.Tekst}»{(p.FullfortAvBruker is null ? "" : $" · {p.FullfortAvBruker.Initialer}")}", "check", "gronn", Naar(p.FullfortDato.Value)));
            }
            foreach (var r in _registreringer)
            {
                liste.Add(new(r.Dato, $"{r.Timer.ToString("0.#", Kultur)} t registrert", $"{r.MontorNavn} · {r.Type.Visningsnavn()}", "clock", "bla", r.Dato.ToString("dd.MM")));
            }
            foreach (var v in _ordre!.Varer.Where(v => v.LagtTilAvBrukerId is not null && v.LagtTilDato.HasValue))
            {
                liste.Add(new(v.LagtTilDato!.Value, "Vare lagt til i felt", $"{v.Navn}{(v.LagtTilAvBruker is null ? "" : $" · {v.LagtTilAvBruker.Navn}")}", "box", "brun", Naar(v.LagtTilDato.Value)));
            }
            if (_ordre.FullfortDato is { } fd)
            {
                liste.Add(new(fd, "Ferdigmeldt", _ordre.FullfortAvBruker?.Navn ?? "", "check-circle", "gronn", Naar(fd)));
            }
            return liste.OrderByDescending(a => a.Tidspunkt).Take(6).ToList();
        }
    }

    private static string Naar(DateTime t) =>
        t.Date == DateTime.Today ? $"i dag {t:HH:mm}"
        : t.Date == DateTime.Today.AddDays(-1) ? $"i går {t:HH:mm}"
        : t.ToString("dd.MM");
