                            <option value="@k.Id">@k.Kode @k.Navn (@k.Enhet.Navn())</option>
                        }
                    </select>
                    <input type="number" min="0" step="any" inputmode="decimal" @bind="_nyKodeAntall" placeholder="Antall" aria-label="Antall" />
                    <button type="button" class="aok-legg-til" disabled="@(_nyKodeId == 0 || _nyKodeAntall <= 0)" @onclick="LeggTilKode"><Icon Name="plus" />Legg til</button>
                </div>
            }
        </section>;

    private async Task LastKoderAsync()
    {
        _prisKoder = await Db.PrisKoder.AsNoTracking().OrderBy(k => k.Rekkefolge).ThenBy(k => k.Kode).ToListAsync();
        _aoKoder = await Db.ArbeidsordreKodeLinjer.Where(l => l.ArbeidsordreId == Id).OrderBy(l => l.LagtTilDato).ToListAsync();
    }

    // Det montøren kan føre her: kjøring og tillegg med antall (km, stk,
    // dag). Timer føres i timeføringen, prosentlinjene regnes ut av seg selv.
    private List<PrisKode> TilleggKoder() => _prisKoder
        .Where(k => k.Aktiv && k.Type != PrisKodeType.Arbeid && !k.Enhet.ErProsent() && k.Enhet != PrisKodeEnhet.Time)
        .ToList();

    // Arbeidskodene timene kan føres på. Velges bare når det er flere.
    private List<PrisKode> ArbeidKoder() => _prisKoder
