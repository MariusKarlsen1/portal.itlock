@page "/arbeidsordre/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject GeocodingService Geokoding
@inject IJSRuntime JS
@inject EmailService Epost

<PageTitle>@(_ordre?.Tittel ?? "Arbeidsordre")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke arbeidsordren. Den kan være slettet.</p>
}
else if (_ordre is not null)
{
    <a class="back-link" href="/arbeidsordre">← Tilbake til arbeidsordre</a>
    <h1>@_ordre.Tittel</h1>
    @if (_ordre.TilbudId.HasValue)
    {
        <p class="tilbud-link">Opprettet fra tilbud: <a href="@($"/tilbud/{_ordre.TilbudId}")">@_tilbudTittel</a></p>
    }

    <section class="ordre-section">
        <div class="field-grid">
            <label class="span-2">
                Tittel
                <input @bind="_ordre.Tittel" @bind:event="oninput" />
            </label>
            <label class="span-2">
                Beskrivelse
                <textarea rows="3" @bind="_ordre.Beskrivelse" placeholder="Info om jobben"></textarea>
            </label>
            <label>
                Prosjekt
                <select @bind="_ordre.ProsjektId">
                    <option value="">Ikke satt</option>
                    @foreach (var p in _prosjekter)
                    {
                        <option value="@p.Id">@p.Navn</option>
                    }
                </select>
            </label>
            <label>
                Ansvarlig montør
                <select @bind="_ordre.AnsvarligMontorId">
                    <option value="">Ikke satt</option>
                    @foreach (var m in _montorer)
                    {
                        <option value="@m.Id">@m.Navn</option>
                    }
                </select>
            </label>
            <label>
                Status
                <select @bind="_ordre.Status">
                    @foreach (var s in Enum.GetValues<ArbeidsordreStatus>())
                    {
                        <option value="@s">@s.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Planlagt dato
                <input type="date" @bind="_planlagtDato" />
            </label>
            <label>
                Fra klokkeslett
                <input type="time" @bind="_fraKlokkeslett" />
            </label>
            <label>
                Til klokkeslett
                <input type="time" @bind="_tilKlokkeslett" />
            </label>
            <label>
                Adresse
                <input @bind="_ordre.Adresse" @bind:event="oninput" placeholder="F.eks. Gartnerveien 2" />
            </label>
            <label>
                Postnr
                <input @bind="_ordre.Postnr" @bind:event="oninput" />
            </label>
            <label>
                Sted
                <input @bind="_ordre.Sted" @bind:event="oninput" />
            </label>
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            <a class="add-button" href="@($"/timeregistrering?arbeidsordreId={_ordre.Id}")">Registrer timer</a>
            <button type="button" class="cancel-button" @onclick="VisKart">Vis på kart</button>
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_kartFeil))
        {
            <p class="form-error">@_kartFeil</p>
        }

        @if (_visKart)
        {
            <div id="ordre-kart-visning" class="ordre-kart-container"></div>
        }
    </section>

    <section class="ordre-section">
        <h2>Registrerte timer <span class="sum-timer">(@_sumTimer.ToString("N1", Kultur) t totalt)</span></h2>

        @if (_registreringer.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert på denne arbeidsordren ennå.</p>
        }
        else
        {
            <table class="reg-table">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th>Montør</th>
                        <th>Type</th>
                        <th>Timer</th>
                        <th>Km</th>
                        <th>Kommentar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _registreringer)
                    {
                        <tr @key="r.Id">
                            <td>@r.Dato.ToString("dd.MM.yyyy")</td>
                            <td>@r.MontorNavn</td>
                            <td>@r.Type.Visningsnavn()</td>
                            <td class="timer-cell">@r.Timer.ToString("N1", Kultur) t</td>
                            <td>@(r.Kilometer > 0 ? r.Kilometer.ToString("N0", Kultur) : "")</td>
                            <td>@r.Kommentar</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="ordre-section">
        <h2>Sjekkliste @if (_sjekkpunkter.Count > 0) { <span class="sum-timer">(@_sjekkpunkter.Count(p => p.Fullfort)/@_sjekkpunkter.Count fullført)</span> }</h2>

        @if (_sjekkpunkter.Count == 0)
        {
            @if (_maler.Count == 0)
            {
                <p class="list-empty">Ingen sjekklistemaler er opprettet. Legg til under Sjekklistemaler i admin.</p>
            }
            else
            {
                <div class="sjekkliste-velg">
                    <select @bind="_valgtMalId">
                        <option value="">Velg dørtype...</option>
                        @foreach (var m in _maler)
                        {
                            <option value="@m.Id">@m.Dortype</option>
                        }
                    </select>
                    <button type="button" class="add-button" @onclick="BrukMal" disabled="@(_valgtMalId is null)">Bruk sjekkliste</button>
                </div>
            }
        }
        else
        {
            <ol class="sjekkpunkt-list">
                @foreach (var p in _sjekkpunkter.OrderBy(p => p.Rekkefolge))
                {
                    <li @key="p.Id">
                        <label>
                            <input type="checkbox" @bind="p.Fullfort" @bind:after="@(() => LagreSjekkpunkt(p))" />
                            <span class="@(p.Fullfort ? "sjekkpunkt-fullfort" : "")">@p.Tekst</span>
                        </label>
                        @if (p.Fullfort && p.FullfortDato.HasValue)
                        {
                            <span class="sjekkpunkt-meta">
                                @p.FullfortDato.Value.ToString("dd.MM.yyyy HH:mm") @(p.FullfortAvBruker is not null ? $"({p.FullfortAvBruker.Initialer})" : "")
                            </span>
                        }
                    </li>
                }
            </ol>
            <button type="button" class="remove-button" @onclick="FjernSjekkliste">Fjern sjekkliste</button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb) || _kundeBilder.Count > 0)
    {
        <section class="ordre-section">
            <h2>Info fra kunde</h2>
            @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb))
            {
                <p>@_ordre.KundeInfoForJobb</p>
            }
            @if (_kundeBilder.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _kundeBilder)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                        </div>
                    }
                </div>
            }
        </section>
    }

    <section class="ordre-section">
        <h2>Sluttrapport</h2>
        <div class="field-grid">
            <label class="span-2">
                Hva er gjort
                <textarea rows="4" @bind="_ordre.UtfortArbeid" placeholder="Beskriv hva som ble utført på jobben"></textarea>
            </label>
            <label class="span-2">
                Hva var galt / anbefalinger (valgfritt)
                <textarea rows="3" @bind="_ordre.Anbefalinger" placeholder="Eventuelle avvik, feil eller anbefalinger"></textarea>
            </label>
        </div>

        <div class="bilder-seksjon">
            <h3>Bilder</h3>
            <InputFile OnChange="LastOppBilder" accept="image/*" multiple />
            @if (!string.IsNullOrEmpty(_bildeFeil))
            {
                <p class="form-error">@_bildeFeil</p>
            }
            @if (_media.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _media)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                            <button type="button" class="remove-button" @onclick="@(() => SlettMedia(m))">Slett</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            <button type="button" class="add-button" @onclick="@(() => _pdfPreviewUrl = $"/arbeidsordre/{Id}/rapport/pdf")">Generer rapport</button>
            @if (_ordre.Status == ArbeidsordreStatus.Fakturert)
            {
                <span class="save-success">
                    Ferdigmeldt og fakturert @(_ordre.FakturertDato?.ToString("dd.MM.yyyy"))
                    @(_ordre.DokumentasjonEpostSendtDato.HasValue ? " - dokumentasjon sendt til kunde" : "")
                </span>
            }
            else
            {
                <button type="button" class="ferdigmeld-button" @onclick="Ferdigmeld">Ferdigmeld</button>
            }
            @if (!string.IsNullOrEmpty(_ferdigmeldtMelding))
            {
                <span class="save-success">@_ferdigmeldtMelding</span>
            }
        </div>
    </section>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av arbeidsordrerapport" OnClose="@(() => _pdfPreviewUrl = null)" />

    <section class="ordre-section">
        @if (_confirmingDelete)
        {
            <span class="delete-confirm">
                Er du sikker? Dette sletter også registrerte timer på arbeidsordren.
                <button type="button" class="delete-confirm-button" @onclick="SlettOrdre">Ja, slett</button>
                <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
            </span>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett arbeidsordre</button>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class RegistreringRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string MontorNavn { get; set; } = "";
        public TimeregistreringType Type { get; set; }
        public decimal Timer { get; set; }
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Arbeidsordre? _ordre;
    private DateOnly? _planlagtDato;
    private TimeOnly? _fraKlokkeslett;
    private TimeOnly? _tilKlokkeslett;
    private bool _notFound;
    private bool _confirmingDelete;
    private string? _savedMessage;
    private List<ProsjektOption> _prosjekter = [];
    private List<MontorOption> _montorer = [];
    private List<RegistreringRad> _registreringer = [];
    private decimal _sumTimer;
    private int? _loadedId;
    private string? _tilbudTittel;
    private List<SjekklisteMal> _maler = [];
    private List<ArbeidsordreSjekkpunkt> _sjekkpunkter = [];
    private int? _valgtMalId;
    private bool _visKart;
    private bool _kartInitialisert;
    private string? _kartFeil;
    private List<ArbeidsordreMedia> _media = [];
    private List<ArbeidsordreMedia> _kundeBilder = [];
    private string? _bildeFeil;
    private string? _pdfPreviewUrl;
    private string? _ferdigmeldtMelding;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _ferdigmeldtMelding = null;
        _visKart = false;
        _kartInitialisert = false;
        _kartFeil = null;

        _ordre = await Db.Arbeidsordre
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .FirstOrDefaultAsync(a => a.Id == Id);
        _notFound = _ordre is null;

        if (_ordre is null)
        {
            return;
        }

        _planlagtDato = _ordre.PlanlagtDato.HasValue ? DateOnly.FromDateTime(_ordre.PlanlagtDato.Value) : null;
        _fraKlokkeslett = _ordre.PlanlagtDato.HasValue ? TimeOnly.FromDateTime(_ordre.PlanlagtDato.Value) : null;
        _tilKlokkeslett = _ordre.PlanlagtSlutt.HasValue ? TimeOnly.FromDateTime(_ordre.PlanlagtSlutt.Value) : null;

        _tilbudTittel = _ordre.TilbudId.HasValue
            ? (await Db.Tilbud.FirstOrDefaultAsync(t => t.Id == _ordre.TilbudId))?.Tittel
            : null;

        _prosjekter = await Db.Prosjekter
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        _montorer = await Db.Brukere
            .OrderBy(m => m.Navn)
            .Select(m => new MontorOption { Id = m.Id, Navn = m.Navn })
            .ToListAsync();

        var registreringer = await Db.Timeregistreringer
            .Where(t => t.ArbeidsordreId == Id)
            .Include(t => t.Montor)
            .OrderByDescending(t => t.Dato)
            .ToListAsync();

        _registreringer = registreringer.Select(t => new RegistreringRad
        {
            Id = t.Id,
            Dato = t.Dato,
            MontorNavn = t.Montor?.Navn ?? "-",
            Type = t.Type,
            Timer = t.TotalTimer,
            Kommentar = t.Kommentar,
            Kilometer = t.Kilometer
        }).ToList();

        _sumTimer = _registreringer.Sum(r => r.Timer);

        _maler = await Db.SjekklisteMaler.OrderBy(m => m.Dortype).ToListAsync();
        _sjekkpunkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .Include(p => p.FullfortAvBruker)
            .ToListAsync();
        _valgtMalId = null;

        var alleBilder = await Db.ArbeidsordreMedia.Where(m => m.ArbeidsordreId == Id).OrderByDescending(m => m.OpprettetDato).ToListAsync();
        _media = alleBilder.Where(m => !m.LastetOppAvKunde).ToList();
        _kundeBilder = alleBilder.Where(m => m.LastetOppAvKunde).ToList();
        _bildeFeil = null;
        _pdfPreviewUrl = null;
    }

    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        _bildeFeil = null;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var media = new ArbeidsordreMedia
            {
                ArbeidsordreId = Id,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name
            };
            Db.ArbeidsordreMedia.Add(media);
            await Db.SaveChangesAsync();

            _media.Insert(0, media);
        }
    }

    private async Task SlettMedia(ArbeidsordreMedia media)
    {
        var entitet = await Db.ArbeidsordreMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.ArbeidsordreMedia.Remove(entitet);
        await Db.SaveChangesAsync();
        _media.Remove(media);
    }

    private async Task Lagre()
    {
        if (_planlagtDato.HasValue)
        {
            _ordre!.PlanlagtDato = _planlagtDato.Value.ToDateTime(_fraKlokkeslett ?? TimeOnly.MinValue);
            _ordre.PlanlagtSlutt = _tilKlokkeslett.HasValue
                ? _planlagtDato.Value.ToDateTime(_tilKlokkeslett.Value)
                : null;
        }
        else
        {
            _ordre!.PlanlagtDato = null;
            _ordre.PlanlagtSlutt = null;
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task Ferdigmeld()
    {
        _ordre!.Status = ArbeidsordreStatus.Fakturert;
        _ordre.FakturertDato = DateTime.Now;
        await Db.SaveChangesAsync();
        _ferdigmeldtMelding = "Ordren er ferdigmeldt og fakturert.";

        var kundeEpost = _ordre.Prosjekt?.Kunde?.Epost;
        if (!string.IsNullOrWhiteSpace(kundeEpost))
        {
            var utfortHtml = string.IsNullOrWhiteSpace(_ordre.UtfortArbeid) ? "" : "<p><strong>Utført arbeid:</strong> " + System.Net.WebUtility.HtmlEncode(_ordre.UtfortArbeid).Replace("\n", "<br>") + "</p>";
            var anbefalingerHtml = string.IsNullOrWhiteSpace(_ordre.Anbefalinger) ? "" : "<p><strong>Anbefalinger:</strong> " + System.Net.WebUtility.HtmlEncode(_ordre.Anbefalinger).Replace("\n", "<br>") + "</p>";
            var html = "<p>Hei " + (_ordre.Prosjekt?.Kunde?.Navn ?? "") + ",</p>"
                + "<p>Her er dokumentasjon fra jobben \"" + System.Net.WebUtility.HtmlEncode(_ordre.Tittel) + "\":</p>"
                + utfortHtml + anbefalingerHtml
                + "<p>Mvh itlock AS</p>";

            var vedlegg = _media.Select(m => (m.Filnavn, m.Data));
            var ok = await Epost.SendAsync(kundeEpost, $"Dokumentasjon - {_ordre.Tittel}", html, vedlegg);
            if (ok)
            {
                _ordre.DokumentasjonEpostSendtDato = DateTime.Now;
                await Db.SaveChangesAsync();
                _ferdigmeldtMelding = "Ordren er ferdigmeldt og fakturert. Dokumentasjon sendt til kunden.";
            }
        }
    }

    private async Task BrukMal()
    {
        if (_valgtMalId is null)
        {
            return;
        }

        var punkter = await Db.SjekklistePunkter
            .Where(p => p.SjekklisteMalId == _valgtMalId)
            .OrderBy(p => p.Rekkefolge)
            .ToListAsync();

        foreach (var punkt in punkter)
        {
            Db.ArbeidsordreSjekkpunkter.Add(new ArbeidsordreSjekkpunkt
            {
                ArbeidsordreId = Id,
                Tekst = punkt.Tekst,
                Rekkefolge = punkt.Rekkefolge
            });
        }

        await Db.SaveChangesAsync();
        _sjekkpunkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .Include(p => p.FullfortAvBruker)
            .ToListAsync();
    }

    private async Task LagreSjekkpunkt(ArbeidsordreSjekkpunkt punkt)
    {
        var entitet = await Db.ArbeidsordreSjekkpunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Fullfort = punkt.Fullfort;
        entitet.FullfortDato = punkt.Fullfort ? DateTime.Now : null;
        entitet.FullfortAvBrukerId = punkt.Fullfort ? _naverendeBrukerId : null;
        await Db.SaveChangesAsync();

        punkt.FullfortDato = entitet.FullfortDato;
        punkt.FullfortAvBruker = punkt.Fullfort ? _naverendeBruker : null;

        await OppdaterKartFargeAsync();
    }

    private async Task FjernSjekkliste()
    {
        var punkter = await Db.ArbeidsordreSjekkpunkter
            .Where(p => p.ArbeidsordreId == Id)
            .ToListAsync();

        Db.ArbeidsordreSjekkpunkter.RemoveRange(punkter);
        await Db.SaveChangesAsync();
        _sjekkpunkter = [];

        await OppdaterKartFargeAsync();
    }

    private async Task OppdaterKartFargeAsync()
    {
        if (!_visKart || !_kartInitialisert)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("kart.oppdaterPunkter", new List<object> { LagKartPunkt() });
        }
        catch (JSException)
        {
            // Ikke kritisk - kartet oppdateres uansett neste gang siden fylles ut på nytt.
        }
    }

    private object LagKartPunkt()
    {
        var (farge, statusTekst) = SjekklisteStatusHelper.Beregn(_sjekkpunkter);
        return new
        {
            lat = _ordre!.Latitude!.Value,
            lng = _ordre.Longitude!.Value,
            tittel = _ordre.Tittel,
            undertekst = _ordre.Adresse,
            status = statusTekst,
            farge
        };
    }

    private async Task VisKart()
    {
        _kartFeil = null;

        if (string.IsNullOrWhiteSpace(_ordre!.Adresse))
        {
            _kartFeil = "Fyll inn adresse først.";
            return;
        }

        if (_ordre.Latitude is null || _ordre.Longitude is null)
        {
            var treff = await Geokoding.GeocodeAsync(_ordre.Adresse, _ordre.Postnr, _ordre.Sted);
            if (treff is null)
            {
                _kartFeil = "Fant ikke posisjon for denne adressen.";
                return;
            }

            _ordre.Latitude = treff.Value.Latitude;
            _ordre.Longitude = treff.Value.Longitude;
            await Db.SaveChangesAsync();
        }

        _visKart = true;
        _kartInitialisert = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_visKart && !_kartInitialisert && _ordre?.Latitude is not null && _ordre.Longitude is not null)
        {
            await JS.InvokeVoidAsync("kart.init", "ordre-kart-visning", new[] { LagKartPunkt() });
            _kartInitialisert = true;
        }
    }

    private async Task SlettOrdre()
    {
        Db.Arbeidsordre.Remove(_ordre!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/arbeidsordre");
    }
}
