        <span class="ao-steg-navn">@navn</span>
        <span class="ao-steg-tall @(ok ? "ok" : tomTekst is not null ? "tom" : "")">@(tomTekst ?? tall)</span>
        <span class="ao-steg-pil"><Icon Name="chevron-right" /></span>
    </button>;

    // ---------- Varestatus (lager) ----------
    // Med lagermodulen settes det arbeidsordren trenger av på hovedlageret
    // med en gang (tilbudets varer og varer lagt til), og hver vare viser om
    // den er på lager, i bilen, bestilt eller må bestilles. Ingenting bestilles
    // automatisk - det som mangler havner i innkjøpsforslaget under Lager.

    private bool _harLager;
    private Dictionary<int, (int Satt, int Venter)> _res = [];
    private Dictionary<int, (int Nummer, DateTime? Dato)> _bestilt = [];
    private Dictionary<int, string> _hylle = [];
    private Dictionary<int, int> _ledig = [];

    private static readonly InnkjopStatus[] AapneInnkjop =
        [InnkjopStatus.Sendt, InnkjopStatus.Bekreftet, InnkjopStatus.Avvik, InnkjopStatus.DelvisMottatt];

    private async Task SikreVarerAsync()
    {
        _harLager = await Tilleggsmoduler.HarAsync(TilleggsModuler.Lager);
        if (!_harLager || _ordre is null)
        {
            return;
        }

        // Først forbruket for det som er plukket, så reservasjonene - ellers
        // ville det plukkede blitt frigitt i stedet for trukket fra lageret.
        await PlukkSvc.SynkForbrukAsync(Id);
        await ResSvc.SikreArbeidsordreAsync(Id, _naverendeBruker?.Navn);

        _res = (await Db.LagerReservasjoner.AsNoTracking().Where(r => r.ArbeidsordreId == Id)
                .Select(r => new { r.ComponentId, r.Antall, r.Venter }).ToListAsync())
            .GroupBy(r => r.ComponentId)
            .ToDictionary(g => g.Key, g => (g.Sum(r => r.Antall), g.Sum(r => r.Venter)));
        _ledig = await ResSvc.LedigAsync();

        var venter = _res.Where(r => r.Value.Venter > 0).Select(r => r.Key).ToList();
        _bestilt = venter.Count == 0 ? [] : (await Db.InnkjopsordreLinjer.AsNoTracking()
                .Where(l => venter.Contains(l.ComponentId) && l.Antall > l.Mottatt && AapneInnkjop.Contains(l.Innkjopsordre!.Status))
                .Select(l => new { l.ComponentId, l.Innkjopsordre!.Nummer, Dato = l.Innkjopsordre.BekreftetDato ?? l.Innkjopsordre.OnsketLevering })
                .ToListAsync())
            .GroupBy(l => l.ComponentId)
            .ToDictionary(g => g.Key, g => { var l = g.OrderBy(x => x.Dato ?? DateTime.MaxValue).First(); return (l.Nummer, l.Dato); });

        var satt = _res.Keys.ToList();
        _hylle = satt.Count == 0 ? [] : (await Db.VareLagerplasser.AsNoTracking()
                .Where(p => satt.Contains(p.ComponentId) && p.Hylle != null && p.Hylle != "" && p.Lager!.Type == LagerType.Hovedlager)
                .Select(p => new { p.ComponentId, p.Hylle }).ToListAsync())
            .GroupBy(p => p.ComponentId)
            .ToDictionary(g => g.Key, g => g.First().Hylle!);
    }

    private sealed record Vstatus(string Tekst, string Klasse);

    // Status for en vare på ordren. Plukkede varer og varer uten lagerdata
    // får ingen merkelapp.
    private Vstatus? VareStatus(int? componentId, bool plukket)
    {
        if (!_harLager || plukket || componentId is not { } cid || !_res.TryGetValue(cid, out var r))
        {
            return null;
        }

        if (r.Venter == 0)
        {
            return new(_hylle.TryGetValue(cid, out var h) ? $"Lager · {h}" : "På lager", "lager");
        }

        var foran = r.Satt > 0 ? $"{r.Venter} " : "";
        if (_iBilen.GetValueOrDefault(cid) >= r.Venter)
        {
            return new($"{foran}I bilen".Trim(), "bil");
        }

        if (_bestilt.TryGetValue(cid, out var b))
        {
            return new($"{foran}Bestilt IO-{b.Nummer}{(b.Dato is { } d ? $" · {d:dd.MM}" : "")}", "bestilt");
        }

        return new($"{foran}Må bestilles", "bestill");
    }

    private RenderFragment StatusChip(int? componentId, int antall, bool plukket) => __builder =>
    {
        if (VareStatus(componentId, plukket) is { } s)
        {
            <span class="ao-vchip ao-vchip-@s.Klasse">@s.Tekst</span>
        }
    };

    // Øverst på Dørbeslag: hvor mange varer som er på lager, i bilen og må bestilles.
    private RenderFragment Varestatus() => __builder =>
    {
        if (!_harLager || _ordre is null)
        {
            return;
        }

        var linjer = _tilbudVarer.Where(l => !l.ErGruppering).Select(l => VareStatus(l.ComponentId, l.Plukket))
            .Concat(_ordre.Varer.Where(v => v.FraLagerId is null).Select(v => VareStatus(v.ComponentId, v.Plukket)))
            .Where(s => s is not null).Select(s => s!).ToList();
        if (linjer.Count == 0)
        {
            return;
        }

        var lager = linjer.Count(s => s.Klasse == "lager");
        var bil = linjer.Count(s => s.Klasse == "bil");
        var bestilt = linjer.Count(s => s.Klasse == "bestilt");
        var bestill = linjer.Count(s => s.Klasse == "bestill");
        <section class="ao-varestatus">
            <h3>Varestatus</h3>
            <div class="ao-varestatus-tall">
                @if (lager > 0) { <span class="ao-vchip ao-vchip-lager">@lager på lager</span> }
                @if (bil > 0) { <span class="ao-vchip ao-vchip-bil">@bil i bilen</span> }
                @if (bestilt > 0) { <span class="ao-vchip ao-vchip-bestilt">@bestilt bestilt</span> }
                @if (bestill > 0) { <span class="ao-vchip ao-vchip-bestill">@bestill må bestilles</span> }
            </div>
            @if (bestill > 0 && ErAdminEllerPl)
            {
                <a class="ao-varestatus-knapp" href="/lager/innkjop"><Icon Name="receipt" />Bestill det som mangler</a>
            }
        </section>
    };

    // I søket: hvor varen finnes, og hva som skjer når den legges til.
    private RenderFragment SokStatus(Component c) => __builder =>
    {
        var bil = IBilen(c);
        if (!_harLager)
        {
            if (bil > 0)
            {
                <span class="ao-ibil">I bilen: @bil</span>
            }
            return;
        }

        if (bil > 0)
        {
            <span class="ao-vchip ao-vchip-bil">I bilen: @bil</span><span class="ao-sok-handling">Ta fra bilen</span>
        }
        else if (_ledig.GetValueOrDefault(c.Id) is var ledig && ledig > 0)
        {
            <span class="ao-vchip ao-vchip-lager">På lager: @ledig</span><span class="ao-sok-handling">Hent fra lager</span>
        }
        else
        {
            <span class="ao-vchip ao-vchip-bestill">Ikke på lager</span><span class="ao-sok-handling">Må bestilles</span>
        }
    };
}
