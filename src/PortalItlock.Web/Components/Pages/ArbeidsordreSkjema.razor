@page "/arbeidsordre/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject GeocodingService Geokoding
@inject IJSRuntime JS
@inject EmailService Epost
@inject SjekklistePdfService SjekklistePdfService
@inject ArbeidsordrePdfService ArbeidsordrePdfService
@inject LagretPdfService LagretPdfService

<PageTitle>@(_ordre?.Tittel ?? "Arbeidsordre")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke arbeidsordren. Den kan være slettet.</p>
}
else if (_ordre is not null)
{
    <a class="back-link" href="/arbeidsordre">← Tilbake til arbeidsordre</a>
    <h1 class="ordre-tittel-h1">@_ordre.Tittel</h1>
    @if (_ordre.TilbudId.HasValue)
    {
        <p class="tilbud-link">Opprettet fra tilbud: <a href="@($"/tilbud/{_ordre.TilbudId}")">@_tilbudTittel</a></p>
    }

    <div class="mobil-ordre-faner">
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "detaljer" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "detaljer")">Detaljer</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "servicepunkter" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "servicepunkter")">Servicepunkter</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "kunde" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "kunde")">Kunde</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "dorbeslag" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "dorbeslag")">Dørbeslag</button>
        <button type="button" class="mobil-ordre-fane-knapp @(_mobilFaneOrdre == "timefoering" ? "aktiv" : "")" @onclick="@(() => _mobilFaneOrdre = "timefoering")">Timeføring</button>
    </div>

    <div class="@FaneKlasse("dorbeslag")">
    @if (_tilbudVarer.Count > 0)
    {
        <section class="ordre-section">
            <h2>Varer å pakke</h2>
            <ul class="varer-liste">
                @foreach (var l in _tilbudVarer)
                {
                    @if (l.ErGruppering)
                    {
                        <li @key="l.Id" class="varer-gruppering">
                            <strong>@l.Navn</strong>
                            @if (!string.IsNullOrWhiteSpace(l.Beskrivelse))
                            {
                                <span>@l.Beskrivelse</span>
                            }
                        </li>
                    }
                    else
                    {
                        <li @key="l.Id" class="varer-rad">
                            <span>@l.Navn</span>
                            <span class="varer-antall">@l.Antall @(l.Enhet ?? "stk")</span>
                        </li>
                    }
                }
            </ul>
        </section>
    }

    @if (!_ordre.TilbudId.HasValue)
    {
        <section class="ordre-section">
            <h2>Varer å pakke</h2>
            <p class="section-hint">Denne arbeidsordren er ikke koblet til et tilbud - søk opp varene som skal med her.</p>
            <div class="component-search">
                <label>
                    Søk i komponentregisteret
                    <input @bind="_vareSok" @bind:event="oninput" @bind:after="SokVarer" placeholder="Navn eller artikkelnr..." />
                </label>
                @if (_vareSokResultater.Count > 0)
                {
                    <ul class="search-results">
                        @foreach (var c in _vareSokResultater)
                        {
                            <li>
                                <button type="button" class="search-result" @onclick="@(() => LeggTilVare(c))">
                                    <span class="search-result-name">@c.Navn</span>
                                    <span class="search-result-meta">@c.Leverandor</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (_ordre.Varer.Count(v => v.LagtTilAvBrukerId is null) == 0)
            {
                <p class="list-empty">Ingen varer lagt til ennå.</p>
            }
            else
            {
                <table class="varer-table">
                    <thead>
                        <tr>
                            <th>Vare</th>
                            <th>Antall</th>
                            @if (ErAdminEllerPl)
                            {
                                <th>Utpris</th>
                                <th>Kostpris</th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _ordre.Varer.Where(v => v.LagtTilAvBrukerId is null))
                        {
                            <tr @key="v.Id">
                                <td>@v.Navn</td>
                                <td><input type="number" min="1" class="antall-input" @bind="v.Antall" @bind:after="@(() => LagreVare(v))" /></td>
                                @if (ErAdminEllerPl)
                                {
                                    <td><input type="number" step="0.01" class="pris-input" @bind="v.Utpris" @bind:after="@(() => LagreVare(v))" /></td>
                                    <td><input type="number" step="0.01" class="pris-input" @bind="v.Kostpris" @bind:after="@(() => LagreVare(v))" /></td>
                                }
                                <td><button type="button" class="remove-button" @onclick="@(() => FjernVare(v))">Fjern</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_ordre.Varer.Any(v => v.LagtTilAvBrukerId is not null))
            {
                <div class="montor-tillegg-varsel">
                    <h3>Lagt til av montør</h3>
                    <p class="section-hint">Disse varene er lagt til i felt, utenom det opprinnelige beslaget på ordren.</p>
                    <table class="varer-table">
                        <thead>
                            <tr>
                                <th>Vare</th>
                                <th>Antall</th>
                                <th>Lagt til av</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in _ordre.Varer.Where(v => v.LagtTilAvBrukerId is not null))
                            {
                                <tr @key="v.Id">
                                    <td>@v.Navn</td>
                                    <td><input type="number" min="1" class="antall-input" @bind="v.Antall" @bind:after="@(() => LagreVare(v))" /></td>
                                    <td>@(v.LagtTilAvBruker?.Navn ?? "Ukjent") @(v.LagtTilDato.HasValue ? $"- {v.LagtTilDato.Value:dd.MM.yyyy HH:mm}" : "")</td>
                                    <td><button type="button" class="remove-button" @onclick="@(() => FjernVare(v))">Fjern</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (ErAdminEllerPl)
        {
            <section class="ordre-section">
                <h2>Montasjepris (uten tilbud)</h2>
                <p class="section-hint">Brukes til å beregne totalsum og DG ved fakturering, siden det ikke finnes et tilbud å hente det fra.</p>
                <div class="field-grid">
                    <label>
                        Timepris utfaktureres
                        <input type="number" step="0.01" @bind="_ordre.Timepris" @bind:after="AutoLagre" />
                    </label>
                    <label>
                        Kostpris pr. time
                        <input type="number" step="0.01" @bind="_ordre.KostprisTime" @bind:after="AutoLagre" />
                    </label>
                </div>
            </section>
        }
    }
    </div>

    <div class="@FaneKlasse("detaljer")">
    @if (ErAdminEllerPl)
    {
        <section class="ordre-section">
            <h2>Ticket</h2>
            @if (_knyttetTicket is not null)
            {
                <p class="tilbud-link">Knyttet til ticket: <a href="@($"/ticket/{_knyttetTicket.Id}")">#@_knyttetTicket.Id - @_knyttetTicket.Tittel</a> (@_knyttetTicket.Status.Visningsnavn())</p>
            }
            else
            {
                <div class="ticket-knytt-rad">
                    <select @bind="_valgtTicketId">
                        <option value="">Velg ledig ticket...</option>
                        @foreach (var t in _ledigeTickets)
                        {
                            <option value="@t.Id">#@t.Id - @t.Tittel</option>
                        }
                    </select>
                    <button type="button" class="cancel-button" @onclick="KnyttTicket" disabled="@(_valgtTicketId is null)">Knytt ticket</button>
                    <button type="button" class="add-button" @onclick="OpprettOgKnyttTicket">Opprett ny ticket</button>
                </div>
            }
        </section>
    }

    <section class="ordre-section">
        <div class="field-grid">
            <label class="span-2 mobil-las-felt">
                Tittel
                <input @bind="_ordre.Tittel" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
            <label class="span-2 mobil-las-felt">
                Beskrivelse
                <textarea rows="3" @bind="_ordre.Beskrivelse" @bind:after="AutoLagre" placeholder="Info om jobben" disabled="@_erMobilvisning"></textarea>
            </label>
            <label class="mobil-las-felt">
                Prosjekt
                <select @bind="_ordre.ProsjektId" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var p in _prosjekter)
                    {
                        <option value="@p.Id">@p.Navn</option>
                    }
                </select>
            </label>
            <label>
                Referanse
                <input value="@(_ordre.Prosjekt?.Prosjektleder?.Navn ?? "Ikke satt")" disabled />
            </label>
            <label class="mobil-las-felt">
                Ansvarlig montør
                <select @bind="_ordre.AnsvarligMontorId" @bind:after="SjekkDobbeltbooking" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var m in _montorer)
                    {
                        <option value="@m.Id">@m.Navn</option>
                    }
                </select>
            </label>
            <label class="mobil-las-felt">
                Type
                <select @bind="_ordre.Type" disabled="@_erMobilvisning">
                    <option value="">Ikke satt</option>
                    @foreach (var t in Enum.GetValues<ArbeidsordreType>())
                    {
                        <option value="@t">@t.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Status
                <select @bind="_ordre.Status">
                    @foreach (var s in Enum.GetValues<ArbeidsordreStatus>())
                    {
                        <option value="@s">@s.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label class="mobil-las-felt">
                Planlagt dato
                <input type="date" @bind="_planlagtDato" @bind:after="SjekkDobbeltbooking" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Fra klokkeslett
                <input type="time" @bind="_fraKlokkeslett" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Til klokkeslett
                <input type="time" @bind="_tilKlokkeslett" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Estimert timer
                <input type="number" step="0.5" min="0" @bind="_ordre.EstimerteTimer" @bind:after="AutoLagre" disabled="@_erMobilvisning" />
            </label>
            <label class="span-2 mobil-las-felt">
                Hentehylle
                <input @bind="_ordre.Hentehylle" @bind:event="oninput" placeholder="F.eks. hylle 4B - varer til henting" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Adresse
                <input @bind="_ordre.Adresse" @bind:event="oninput" placeholder="F.eks. Gartnerveien 2" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Postnr
                <input @bind="_ordre.Postnr" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
            <label class="mobil-las-felt">
                Sted
                <input @bind="_ordre.Sted" @bind:event="oninput" disabled="@_erMobilvisning" />
            </label>
        </div>

        @if (!string.IsNullOrEmpty(_dobbeltbookingVarsel))
        {
            <p class="dobbeltbooking-varsel">@_dobbeltbookingVarsel</p>
        }

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            <a class="add-button" href="@($"/timeregistrering?arbeidsordreId={_ordre.Id}")">Registrer timer</a>
            <button type="button" class="cancel-button" @onclick="VisKart">Vis på kart</button>
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_kartFeil))
        {
            <p class="form-error">@_kartFeil</p>
        }

        @if (_visKart)
        {
            <div id="ordre-kart-visning" class="ordre-kart-container"></div>
        }
    </section>
    </div>

    <div class="@FaneKlasse("timefoering")">
    <section class="ordre-section">
        <h2>
            Registrerte timer <span class="sum-timer">(@_sumTimer.ToString("N1", Kultur) t totalt)</span>
            <StatusPill Tekst="@_ordre.Status.Visningsnavn()" Ikon="@_ordre.Status.PillIkon()" Farge="@_ordre.Status.PillFarge()" />
        </h2>

        @if (_registreringer.Count == 0)
        {
            <p class="list-empty">Ingen timer registrert på denne arbeidsordren ennå.</p>
        }
        else
        {
            <table class="reg-table">
                <thead>
                    <tr>
                        <th>Dato</th>
                        <th>Montør</th>
                        <th>Type</th>
                        <th>Timer</th>
                        <th>Km</th>
                        <th>Kommentar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _registreringer)
                    {
                        <tr @key="r.Id">
                            <td>@r.Dato.ToString("dd.MM.yyyy")</td>
                            <td>@r.MontorNavn</td>
                            <td>@r.Type.Visningsnavn()</td>
                            <td class="timer-cell">@r.Timer.ToString("N1", Kultur) t</td>
                            <td>@(r.Kilometer > 0 ? r.Kilometer.ToString("N0", Kultur) : "")</td>
                            <td>@r.Kommentar</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    </div>

    <div class="@FaneKlasse("servicepunkter")">
    <section class="ordre-section">
        <h2>Sjekkliste @if (_sjekkpunkter.Count > 0) { <span class="sum-timer">(@_sjekkpunkter.Count(p => p.Fullfort)/@_sjekkpunkter.Count fullført)</span> }</h2>

        @if (_sjekkpunkter.Count == 0)
        {
            @if (_maler.Count == 0)
            {
                <p class="list-empty">Ingen sjekklistemaler er opprettet. Legg til under Sjekklistemaler i admin.</p>
            }
            else
            {
                <div class="sjekkliste-velg">
                    <select @bind="_valgtMalId">
                        <option value="">Velg dørtype...</option>
                        @foreach (var m in _maler)
                        {
                            <option value="@m.Id">@m.Dortype</option>
                        }
                    </select>
                    <button type="button" class="add-button" @onclick="BrukMal" disabled="@(_valgtMalId is null)">Bruk sjekkliste</button>
                </div>
            }
        }
        else
        {
            <ol class="sjekkpunkt-list">
                @foreach (var p in _sjekkpunkter.OrderBy(p => p.Rekkefolge))
                {
                    <li @key="p.Id">
                        <label>
                            <input type="checkbox" @bind="p.Fullfort" @bind:after="@(() => LagreSjekkpunkt(p))" />
                            <span class="@(p.Fullfort ? "sjekkpunkt-fullfort" : "")">@p.Tekst</span>
                        </label>
                        @if (p.Fullfort && p.FullfortDato.HasValue)
                        {
                            <span class="sjekkpunkt-meta">
                                @p.FullfortDato.Value.ToString("dd.MM.yyyy HH:mm") @(p.FullfortAvBruker is not null ? $"({p.FullfortAvBruker.Initialer})" : "")
                            </span>
                        }
                    </li>
                }
            </ol>
            <div class="form-actions">
                <button type="button" class="add-button" @onclick="VisSjekklistePdfForhandsvisning">Lagre som PDF</button>
                <button type="button" class="remove-button" @onclick="FjernSjekkliste">Fjern sjekkliste</button>
            </div>

            @if (_lagredeSjekklistePdfer.Count > 0)
            {
                <ul class="vedlegg-list">
                    @foreach (var pdf in _lagredeSjekklistePdfer.OrderByDescending(p => p.OpprettetDato))
                    {
                        <li @key="pdf.Id" class="vedlegg-item">
                            <a href="@($"/sjekklistepdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                            <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                        </li>
                    }
                </ul>
            }

            <PdfPreviewModal Url="@_sjekklistePdfPreviewUrl" Tittel="Forhåndsvisning av sjekkliste" SaveMessage="@_sjekklistePdfSavedMessage"
                              OnSave="LagreSjekklistePdf" OnClose="@(() => _sjekklistePdfPreviewUrl = null)" />
        }
    </section>
    </div>

    <div class="@FaneKlasse("kunde")">
    <section class="ordre-section">
        <h2>Kunde</h2>
        <div class="field-grid">
            <label>
                Ordrenr
                <input value="@($"#{_ordre.Id}")" disabled />
            </label>
            <label>
                Adresse
                <input value="@(string.Join(", ", new[] { _ordre.Adresse, _ordre.Postnr, _ordre.Sted }.Where(s => !string.IsNullOrWhiteSpace(s))))" disabled />
            </label>
            <label>
                Kontaktperson
                <input value="@(_ordre.Prosjekt?.Kontaktperson ?? "Ikke satt")" disabled />
            </label>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb) || _kundeBilder.Count > 0)
    {
        <section class="ordre-section">
            <h2>Info fra kunde</h2>
            @if (!string.IsNullOrWhiteSpace(_ordre.KundeInfoForJobb))
            {
                <p>@_ordre.KundeInfoForJobb</p>
            }
            @if (_kundeBilder.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _kundeBilder)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                        </div>
                    }
                </div>
            }
        </section>
    }
    </div>

    <div class="@FaneKlasse("detaljer")">
    <section class="ordre-section">
        <h2>Sluttrapport</h2>
        <div class="field-grid">
            <label class="span-2">
                Hva er gjort
                <textarea rows="4" @bind="_ordre.UtfortArbeid" @bind:after="AutoLagre" placeholder="Beskriv hva som ble utført på jobben"></textarea>
            </label>
            <label class="span-2">
                Hva var galt / anbefalinger (valgfritt)
                <textarea rows="3" @bind="_ordre.Anbefalinger" @bind:after="AutoLagre" placeholder="Eventuelle avvik, feil eller anbefalinger"></textarea>
            </label>
        </div>

        <div class="bilder-seksjon">
            <h3>Bilder</h3>
            <InputFile OnChange="LastOppBilder" accept="image/*" multiple />
            @if (!string.IsNullOrEmpty(_bildeFeil))
            {
                <p class="form-error">@_bildeFeil</p>
            }
            @if (_media.Count > 0)
            {
                <div class="media-grid">
                    @foreach (var m in _media)
                    {
                        <div @key="m.Id" class="media-item">
                            <img src="@($"/arbeidsordremedia/{m.Id}")" alt="@m.Filnavn" />
                            <button type="button" class="remove-button" @onclick="@(() => SlettMedia(m))">Slett</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            <button type="button" class="add-button" @onclick="VisRapportForhandsvisning">Generer rapport</button>
            @if (_ordre.Status == ArbeidsordreStatus.Fakturert)
            {
                <span class="save-success">
                    Fakturert @(_ordre.FakturertDato?.ToString("dd.MM.yyyy"))
                    @(_ordre.DokumentasjonEpostSendtDato.HasValue ? " - dokumentasjon sendt til kunde" : "")
                </span>
            }
            else if (_ordre.Status == ArbeidsordreStatus.Ferdig)
            {
                <span class="save-success">
                    Ferdigmeldt - klar for fakturering
                    @(_ordre.DokumentasjonEpostSendtDato.HasValue ? " - dokumentasjon sendt til kunde" : "")
                </span>
                <button type="button" class="fakturert-button" @onclick="MarkerFakturert">Fakturert</button>
            }
            else
            {
                <button type="button" class="ferdigmeld-button" @onclick="Ferdigmeld">Ferdigmeld</button>
            }
            @if (!string.IsNullOrEmpty(_ferdigmeldtMelding))
            {
                <span class="save-success">@_ferdigmeldtMelding</span>
            }
        </div>

        @if (_ordre.FullfortAvBruker is not null)
        {
            <p class="fullfort-av-tekst">
                Fullført av @_ordre.FullfortAvBruker.Navn@(_ordre.FullfortDato.HasValue ? $" - {_ordre.FullfortDato.Value:dd.MM.yyyy HH:mm}" : "")
            </p>
        }
    </section>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av arbeidsordrerapport" SaveMessage="@_rapportPdfSavedMessage"
                      OnSave="LagreRapportPdf" OnClose="@(() => _pdfPreviewUrl = null)" />

    <section class="ordre-section">
        <h2>Lagrede rapport-PDF-er</h2>
        <LagredePdfListe Pdfer="_lagredeRapportPdfer" />
    </section>

    <section class="ordre-section mobil-slett-skjul">
        @if (_confirmingDelete)
        {
            <span class="delete-confirm">
                Er du sikker? Dette sletter også registrerte timer på arbeidsordren.
                <button type="button" class="delete-confirm-button" @onclick="SlettOrdre">Ja, slett</button>
                <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
            </span>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett arbeidsordre</button>
        }
    </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class RegistreringRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string MontorNavn { get; set; } = "";
        public TimeregistreringType Type { get; set; }
        public decimal Timer { get; set; }
        public string? Kommentar { get; set; }
        public decimal Kilometer { get; set; }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private Arbeidsordre? _ordre;
