@page "/foresporsler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Forespørsler</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="mail" /></span>
        <div>
            <h1>Forespørsler</h1>
            <p class="section-hint">
                E-poster sendt til post&#64;itlock.no havner her automatisk via Resend, med tekst og vedlegg. Trykk på en
                forespørsel for å se hele innholdet og opprette ticket.
            </p>
        </div>
    </div>
    @if (_uleste > 0)
    {
        <span class="ulest-pill">@_uleste ulest@(_uleste == 1 ? "" : "e")</span>
    }
</div>

@if (_foresporsler.Count == 0)
{
    <p class="list-empty">Ingen forespørsler mottatt ennå.</p>
}
else
{
    <label class="sok-rad">
        <Icon Name="search" />
        <input @bind="_sok" @bind:event="oninput" placeholder="Søk i avsender eller emne …" />
    </label>

    @if (VisteForesporsler.Count == 0)
    {
        <p class="list-empty">Ingen forespørsler matcher søket.</p>
    }
    else
    {
        <ul class="foresporsel-liste">
            @foreach (var f in VisteForesporsler)
            {
                <li @key="f.Id">
                    <a class="foresporsel-rad @(f.Lest ? "" : "ulest")" href="@($"/foresporsel/{f.Id}")">
                        <span class="foresporsel-avatar">@Initialer(f)</span>
                        <span class="foresporsel-tekst">
                            <span class="foresporsel-topprad">
                                <span class="foresporsel-fra">@(string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn)</span>
                                @if (!f.Lest)
                                {
                                    <span class="ny-prikk"></span>
                                }
                            </span>
                            <span class="foresporsel-emne">@f.Emne</span>
                        </span>
                        <span class="foresporsel-hoyre">
                            <span class="foresporsel-dato">@f.MottattDato.ToString("dd.MM.yyyy HH:mm")</span>
                            @if (f.Media.Count > 0)
                            {
                                <span class="vedlegg-tag"><Icon Name="file-text" />@f.Media.Count vedlegg</span>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    private List<Foresporsel> _foresporsler = [];
    private string _sok = "";

    protected override async Task OnInitializedAsync()
    {
        _foresporsler = await Db.Foresporsler
            .Include(f => f.Media)
            .OrderByDescending(f => f.MottattDato)
            .ToListAsync();
    }

    private int _uleste => _foresporsler.Count(f => !f.Lest);

    private List<Foresporsel> VisteForesporsler
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_sok))
            {
                return _foresporsler;
            }

            var sok = _sok.Trim();
            return _foresporsler.Where(f =>
                (f.FraNavn is not null && f.FraNavn.Contains(sok, StringComparison.OrdinalIgnoreCase)) ||
                f.FraEpost.Contains(sok, StringComparison.OrdinalIgnoreCase) ||
                f.Emne.Contains(sok, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private static string Initialer(Foresporsel f)
    {
        if (!string.IsNullOrWhiteSpace(f.FraNavn))
        {
            var deler = f.FraNavn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return deler.Length >= 2
                ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
                : f.FraNavn.Length >= 2 ? f.FraNavn[..2].ToUpperInvariant() : f.FraNavn.ToUpperInvariant();
        }

        var lokalDel = f.FraEpost.Split('@')[0];
        return lokalDel.Length >= 2 ? lokalDel[..2].ToUpperInvariant() : lokalDel.ToUpperInvariant();
    }
}
