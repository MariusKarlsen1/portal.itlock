    // ---------- E-posten som HTML (logo i signatur, lenker, formatering) ----------

    private readonly Dictionary<int, string?> _htmlCache = [];
    private readonly HashSet<int> _htmlForsokt = [];

    // E-poster som kom inn før HTML ble lagret: hent HTML og innebygde bilder fra
    // Resend én gang og lagre dem, så de vises likt som i e-postprogrammet.
    private async Task HentHtmlOmMangler(Foresporsel f)
    {
        if (f.Kanal != ForesporselKanal.Epost || f.InnholdHtml is not null || !_htmlForsokt.Add(f.Id))
        {
            return;
        }

        var html = ResendInboundParser.HentHtml(f.RawJson);
        var emailId = ResendInboundParser.Tolk(f.RawJson).EmailId;
        var full = string.IsNullOrEmpty(emailId) ? null : await ResendKlient.HentFullInnholdAsync(emailId);
        html = full?.Html ?? html;
        if (html is null)
        {
            return;
        }

        f.InnholdHtml = html;
        if (full is not null)
        {
            var eksisterende = await Db.ForesporselMedia.Where(m => m.ForesporselId == f.Id).ToListAsync();
            foreach (var v in full.Vedlegg.Where(v => v.ContentId is not null))
            {
                var treff = eksisterende.FirstOrDefault(m => m.ContentId is null && m.Filnavn == v.Filnavn);
                if (treff is not null)
                {
                    treff.ContentId = v.ContentId;
                    treff.ErInline = v.ErInline;
                }
                else
                {
                    Db.ForesporselMedia.Add(new ForesporselMedia
                    {
                        ForesporselId = f.Id,
                        Filnavn = v.Filnavn,
                        ContentType = v.ContentType,
                        Data = v.Data,
                        ContentId = v.ContentId,
                        ErInline = v.ErInline
                    });
                }
            }
        }

        await Db.SaveChangesAsync();
        _htmlCache.Remove(f.Id);
        await LastDataAsync();
    }

    // Bygger dokumentet til sandkasse-iframen: innebygde bilder (cid:) blir data-URI-er,
    // lenker åpnes i ny fane, og meta/base/skript fra e-posten fjernes.
    private string? EpostHtml(Foresporsel f)
    {
        if (string.IsNullOrWhiteSpace(f.InnholdHtml))
        {
            return null;
        }

        if (_htmlCache.TryGetValue(f.Id, out var ferdig))
        {
            return ferdig;
        }

        const System.Text.RegularExpressions.RegexOptions valg =
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline;
        var html = f.InnholdHtml;
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<script\b.*?</script\s*>", "", valg);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<(meta|base)\b[^>]*>", "", valg);

        if (html.Contains("cid:", StringComparison.OrdinalIgnoreCase))
        {
            var inline = Db.ForesporselMedia.AsNoTracking()
                .Where(m => m.ForesporselId == f.Id && m.ContentId != null)
                .Select(m => new { m.ContentId, m.ContentType, m.Data })
                .ToList();
            foreach (var m in inline)
            {
                var type = m.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && !m.ContentType.Contains("svg", StringComparison.OrdinalIgnoreCase)
                    ? m.ContentType
                    : "image/png";
                html = System.Text.RegularExpressions.Regex.Replace(html,
                    "cid:" + System.Text.RegularExpressions.Regex.Escape(m.ContentId!),
                    $"data:{type};base64,{Convert.ToBase64String(m.Data)}",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            }
        }

        var dokument = "<!doctype html><html><head><meta charset=\"utf-8\"><base target=\"_blank\">"
            + "<style>html,body{margin:0;padding:0;background:transparent}body{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;font-size:14.5px;line-height:1.55;color:#2f2721;overflow-wrap:anywhere}img{max-width:100%;height:auto}table{max-width:100%}a{color:#835e41}</style>"
            + "</head><body>" + html + "</body></html>";
        _htmlCache[f.Id] = dokument;
        return dokument;
    }

    private async Task Forrige()
    {
        var liste = VisteForesporsler;
        var idx = liste.FindIndex(f => f.Id == _valgt?.Id);
        if (idx > 0)
        {
            await Velg(liste[idx - 1]);
        }
    }

    private async Task Neste()
    {
        var liste = VisteForesporsler;
        var idx = liste.FindIndex(f => f.Id == _valgt?.Id);
        if (idx >= 0 && idx < liste.Count - 1)
        {
            await Velg(liste[idx + 1]);
        }
    }

    private async Task<Ticket> SikreTicket()
    {
        if (_valgt is null)
        {
            throw new InvalidOperationException("Ingen forespørsel valgt.");
        }

        if (_ticketPerForesporsel.TryGetValue(_valgt.Id, out var eksisterende))
        {
            return eksisterende;
        }

        var kunde = KundeFor(_valgt);
        var ticket = new Ticket
        {
            Tittel = _valgt.Emne,
            KundeId = kunde?.Id,
            Kontaktperson = _valgt.FraNavn,
            ForesporselId = _valgt.Id
        };
        ticket.Hendelser.Add(new TicketHendelse
        {
            Beskrivelse = "Opprettet fra forespørsel.",
            UtfortAvBrukerId = _naverendeBrukerId,
            UtfortAvBruker = _naverendeBruker
        });

        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        ticket.Kunde = kunde;
        _ticketPerForesporsel[_valgt.Id] = ticket;
        return ticket;
    }

    private async Task SendSvar()
    {
        if (_valgt is null || string.IsNullOrWhiteSpace(_svarTekst))
        {
            return;
        }

        var ticket = await SikreTicket();
        var kanSendeEpost = _valgt.Kanal == ForesporselKanal.Epost && _valgt.FraEpost.Contains('@');
        var html = $"<p>{System.Net.WebUtility.HtmlEncode(_svarTekst).Replace("\n", "<br>")}</p>";
        var sendt = kanSendeEpost && await Epost.SendAsync(_valgt.FraEpost, "Re: " + _valgt.Emne, html);

        ticket.Hendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = sendt
                ? $"Svar sendt til {_valgt.FraEpost}."
                : kanSendeEpost ? $"Klarte ikke å sende e-post til {_valgt.FraEpost}." : "Svar registrert (ingen e-postadresse å sende til).",
            UtfortAvBrukerId = _naverendeBrukerId,
            UtfortAvBruker = _naverendeBruker
        });

        if (ticket.Status == TicketStatus.Ny)
        {
            ticket.Status = TicketStatus.UnderBehandling;
            ticket.Hendelser.Add(new TicketHendelse
            {
                TicketId = ticket.Id,
                Beskrivelse = "Status endret fra Ny til Under behandling.",
                UtfortAvBrukerId = _naverendeBrukerId,
                UtfortAvBruker = _naverendeBruker
            });
        }

        await Db.SaveChangesAsync();
        _svarSendtOk = sendt || !kanSendeEpost;
        _svarTekst = "";
        _visSvarBoks = false;
        await LastDataAsync();
    }

    private async Task Tildel(ChangeEventArgs e)
    {
        if (_valgt is null)
        {
            return;
        }

        var ticket = await SikreTicket();
        var val = e.Value?.ToString();
        var nyId = string.IsNullOrEmpty(val) ? (int?)null : int.Parse(val);
        if (nyId == ticket.AnsvarligBrukerId)
        {
            return;
        }

        ticket.AnsvarligBrukerId = nyId;
        var navn = nyId is int bid ? _brukere.FirstOrDefault(b => b.Id == bid)?.Navn ?? "ukjent" : null;
        ticket.Hendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = nyId is null ? "Tildeling fjernet." : $"Tildelt til {navn}.",
            UtfortAvBrukerId = _naverendeBrukerId,
            UtfortAvBruker = _naverendeBruker
        });

        await Db.SaveChangesAsync();
        await LastDataAsync();
    }

    private async Task EndreStatus(ChangeEventArgs e)
    {
        if (_valgt is null || !Enum.TryParse<TicketStatus>(e.Value?.ToString(), out var ny))
        {
            return;
        }

        var ticket = await SikreTicket();
        if (ny == ticket.Status)
        {
            return;
        }

        var gammel = ticket.Status;
        ticket.Status = ny;

        if (ny == TicketStatus.Lukket)
        {
            ticket.LukketDato = DateTime.Now;
            ticket.GodkjentAvBrukerId = _naverendeBrukerId;
        }
        else if (gammel == TicketStatus.Lukket)
        {
            ticket.LukketDato = null;
            ticket.GodkjentAvBrukerId = null;
        }

        ticket.Hendelser.Add(new TicketHendelse
        {
            TicketId = ticket.Id,
            Beskrivelse = $"Status endret fra {gammel.Visningsnavn()} til {ny.Visningsnavn()}.",
            UtfortAvBrukerId = _naverendeBrukerId,
            UtfortAvBruker = _naverendeBruker
        });

        await Db.SaveChangesAsync();
        await LastDataAsync();
    }

