@page "/foresporsler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject EmailService Epost
@inject ResendReceivingClient ResendKlient

@inject VisningPreferanseService VisningPref
<PageTitle>Forespørsler</PageTitle>

@* OL2 (foresporsler-outlook-forslag.html): som Outlook på nett - verktøylinje øverst,
   lista med mappe-velger («Innboks ▾») og lesepanelet til høyre, alt i ett kort som
   fyller vinduet. ☰-knappen viser mappene som en egen kolonne til venstre (huskes). *@
<div class="fp-side @(_full ? "fp-full" : "")">

    <div class="fp-topbar">
        <span class="fp-topbar-ikon"><Icon Name="mail" /></span>
        <div class="fp-topbar-tekst">
            <h1>Forespørsler</h1>
            <p>Omhandler henvendelser mottatt på e-post, kundeportal eller manuelt.</p>
        </div>
    </div>

    <div class="ol-kort">
        <div class="ol-ribbon">
            <button type="button" class="ol-mappeknapp @(_visMapper ? "pa" : "")" title="@(_visMapper ? "Skjul mapper" : "Vis mapper")" @onclick="VekslMapper">☰</button>
            <button type="button" class="ol-ny" @onclick="ApneNyForesporsel"><Icon Name="plus" />Ny forespørsel</button>
            @if (_mappe != "serviceoppdrag")
            {
                <span class="ol-skille"></span>
                @if (_bekreftSlett)
                {
                    <button type="button" class="ol-ri ol-ri-fare" disabled="@(_valgt is null)" @onclick="SlettForesporsel"><Icon Name="trash" />Bekreft sletting</button>
                    <button type="button" class="ol-ri" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                }
                else
                {
                    <button type="button" class="ol-ri" disabled="@(_valgt is null)" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett</button>
                }
                <button type="button" class="ol-ri" disabled="@(_valgt is null)" @onclick="ApneSvar"><Icon Name="send" />Svar</button>
                <button type="button" class="ol-ri" disabled="@(_valgt is null)" @onclick="MerkLestUlest"><Icon Name="mail" />@(_valgt?.Lest == false ? "Merk som lest" : "Merk som ulest")</button>
                <span class="ol-skille"></span>
                @if (_valgt is not null)
                {
                    var t = TicketFor(_valgt);
                    <label class="ol-ri-select" title="Tildel">
                        <Icon Name="users" />
                        <select value="@(t?.AnsvarligBrukerId)" @onchange="Tildel">
                            <option value="">Tildel …</option>
                            @foreach (var b in _brukere)
                            {
                                <option value="@b.Id">@b.Navn</option>
                            }
                        </select>
                    </label>
                    <label class="ol-ri-select" title="Status">
                        <Icon Name="toggle-right" />
                        <select value="@(t?.Status ?? TicketStatus.Ny)" @onchange="EndreStatus">
                            @foreach (var s in TicketStatusExtensions.Rekkefolge)
                            {
                                <option value="@s">@s.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    @if (t is not null)
                    {
                        <button type="button" class="ol-ri" @onclick="ApneTicket"><Icon Name="tag" />Ticket #@t.Id</button>
                    }
                    else
                    {
                        <button type="button" class="ol-ri" @onclick="OpprettEllerApneTicket"><Icon Name="tag" />Opprett ticket</button>
                    }
                }
            }
            <button type="button" class="ol-ikon ol-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>

        <div class="ol-grid @(_visMapper ? "med-mapper" : "") @(_mappe == "serviceoppdrag" ? "ol-service" : "")">
            @if (_visMapper)
            {
                <nav class="ol-mapper">
                    <div class="ol-mapper-tittel">Forespørsler</div>
                    @foreach (var m in Mapper)
                    {
                        var key = m.Key;
                        var ulest = _foresporsler.Count(f => !f.Lest && IMappe(f, key));
                        <button type="button" class="ol-mi @(_mappe == key ? "pa" : "")" @onclick="@(() => VelgMappe(key))">
                            <span class="ol-mi-ikon">@if (m.Farge is not null) {<i style="background:@m.Farge"></i>} else {<Icon Name="@m.Ikon" />}</span>
                            <span class="ol-mi-navn">@m.Navn</span>
                            @if (ulest > 0) {<b>@ulest</b>}
                        </button>
                    }
                    <div class="ol-mapper-tittel">Fra kunder</div>
                    <button type="button" class="ol-mi @(_mappe == "serviceoppdrag" ? "pa" : "")" @onclick='@(() => VelgMappe("serviceoppdrag"))'>
                        <span class="ol-mi-ikon"><Icon Name="bell" /></span>
                        <span class="ol-mi-navn">Serviceoppdrag fra kunder</span>
                        @if (_antallApneServiceoppdrag > 0) {<b>@_antallApneServiceoppdrag</b>}
                    </button>
                </nav>
            }

            @if (_mappe == "serviceoppdrag")
            {
                <div class="ol-service-innhold">
                    <div class="ol-lhode">
                        @MappeVelger()
                    </div>
                    <div class="ol-rull ol-service-rull">
                        <Serviceoppdrag />
                    </div>
                </div>
            }
            else
            {
                <section class="ol-liste">
                    <div class="ol-lhode">
                        @MappeVelger()
                        <button type="button" class="ol-ikon @(_visFiltre ? "pa" : "")" title="Filtrer" @onclick="@(() => _visFiltre = !_visFiltre)"><Icon Name="filter" /></button>
                    </div>
                    <label class="ol-sok">
                        <Icon Name="search" />
                        <input @bind="_sok" @bind:event="oninput" placeholder="Søk i forespørsler …" />
                    </label>
                    @if (_visFiltre)
                    {
                        <div class="ol-filtre">
                            <select @bind="_kanalFilter">
                                <option value="">Alle kanaler</option>
                                @foreach (var k in Enum.GetValues<ForesporselKanal>())
                                {
                                    <option value="@k">@k.Visningsnavn()</option>
                                }
                            </select>
                            <select @bind="_kundeFilterRaw">
                                <option value="">Alle kunder</option>
                                @foreach (var k in RelevanteKunder)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                            <select @bind="_ansvarligFilterRaw">
                                <option value="">Alle ansvarlige</option>
                                @foreach (var b in _brukere)
                                {
                                    <option value="@b.Id">@b.Navn</option>
                                }
                            </select>
                            <select @bind="_sortering">
                                <option value="nyeste">Nyeste først</option>
                                <option value="eldste">Eldste først</option>
                            </select>
                        </div>
                    }
                    <div class="ol-rull">
                        @if (_foresporsler.Count == 0)
                        {
                            <p class="fp-tom">Ingen forespørsler mottatt ennå.</p>
                        }
                        else if (VisteForesporsler.Count == 0)
                        {
                            <p class="fp-tom">Ingen forespørsler her.</p>
                        }
                        else
                        {
                            var gruppe = "";
                            @foreach (var f in VisteForesporsler)
                            {
                                var g = DagGruppe(f.MottattDato);
                                if (g != gruppe)
                                {
                                    gruppe = g;
                                    <div class="ol-grp">@g</div>
                                }
                                var status = StatusFor(f);
                                <button type="button" class="ol-rad @(f.Id == _valgt?.Id ? "pa" : "") @(f.Lest ? "" : "ulest")" @key="f.Id" @onclick="@(() => Velg(f))">
                                    <span class="ol-av" style="background:@AvatarFarge(f)">@Initialer(f)</span>
                                    <span class="ol-rad-m">
                                        <span class="ol-fra">@(string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn)</span>
                                        <span class="ol-emne">@f.Emne</span>
                                        <span class="ol-forh">@Forhand(f)</span>
                                    </span>
                                    <span class="ol-rad-r">
                                        <span>@KortTid(f.MottattDato)</span>
                                        <span class="ol-rad-ik"><Icon Name="@f.Kanal.Ikon()" />@if (_vedleggForForesporsel.ContainsKey(f.Id)) {<Icon Name="link-ikon" />}</span>
                                        @if (status != TicketStatus.Ny)
                                        {
                                            <span class="ol-kat"><i style="background:@StatusFarge(status)"></i>@status.Visningsnavn()</span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </div>
                </section>

                <section class="ol-lese">
                    @if (_valgt is null)
                    {
                        <div class="fp-tomvisning">
                            <Icon Name="mail" />
                            <p>Velg en forespørsel i listen for å lese den.</p>
                        </div>
                    }
                    else
                    {
                        var status = StatusFor(_valgt);
                        var ticket = TicketFor(_valgt);
                        var liste = VisteForesporsler;
                        var idx = liste.FindIndex(f => f.Id == _valgt.Id);
                        <div class="ol-rull ol-lese-innhold">
                            <div class="ol-lese-topp">
                                <h2>@_valgt.Emne</h2>
                                <div class="fp-detalj-nav">
                                    <button type="button" disabled="@(idx <= 0)" @onclick="Forrige" title="Forrige"><Icon Name="arrow-left" /></button>
                                    <button type="button" disabled="@(idx < 0 || idx >= liste.Count - 1)" @onclick="Neste" title="Neste" style="transform:scaleX(-1);"><Icon Name="arrow-left" /></button>
                                </div>
                            </div>
                            <div class="ol-kategorier">
                                <span class="ol-kat"><i style="background:@StatusFarge(status)"></i>@status.Visningsnavn()</span>
                                <span class="ol-kat"><Icon Name="@_valgt.Kanal.Ikon()" />@_valgt.Kanal.Visningsnavn()</span>
                                <span class="ol-kat">#@_valgt.Id</span>
                            </div>
                            <div class="ol-sak">
                                <span>Kunde <b>@(KundeFor(_valgt)?.Navn ?? "-")</b></span>
                                <span>Ansvarlig <b>@(ticket?.AnsvarligBruker?.Navn ?? "Ikke tildelt")</b></span>
                                <span>Prosjekt <b>@(ticket?.Prosjekt?.Navn ?? "-")</b></span>
                                <span>Prioritet <b>@(ticket?.Prioritet.Visningsnavn() ?? "-")</b></span>
                                <span>Frist <b>@(ticket?.SlaFrist?.ToString("dd.MM.yyyy") ?? "-")</b></span>
                            </div>

                            <nav class="ol-lese-faner">
                                <button type="button" class="@(_aktivFane == "oversikt" ? "pa" : "")" @onclick='@(() => _aktivFane = "oversikt")'>Melding</button>
                                <button type="button" class="@(_aktivFane == "vedlegg" ? "pa" : "")" @onclick='@(() => _aktivFane = "vedlegg")'>Vedlegg <small>@VedleggForValgt.Count</small></button>
                                <button type="button" class="@(_aktivFane == "notater" ? "pa" : "")" @onclick='@(() => _aktivFane = "notater")'>Interne notater <small>@_valgt.Notater.Count</small></button>
                                <button type="button" class="@(_aktivFane == "aktivitet" ? "pa" : "")" @onclick='@(() => _aktivFane = "aktivitet")'>Aktivitet</button>
                            </nav>

                            @if (_aktivFane == "oversikt")
                            {
                                <div class="ol-melding">
                                    <div class="ol-mhode">
                                        <span class="ol-av ol-av-stor" style="background:@AvatarFarge(_valgt)">@Initialer(_valgt)</span>
                                        <span class="ol-mhode-m">
                                            <b>@(string.IsNullOrWhiteSpace(_valgt.FraNavn) ? _valgt.FraEpost : _valgt.FraNavn)</b>
                                            <small>@_valgt.FraEpost</small>
                                        </span>
                                        <span class="ol-mhode-tid">@_valgt.MottattDato.ToString("ddd dd.MM.yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))</span>
                                        <button type="button" class="ol-ikon" title="Svar" @onclick="ApneSvar"><Icon Name="send" /></button>
                                    </div>
                                    @if (EpostHtml(_valgt) is { } html)
                                    {
                                        @* E-posten slik den ble sendt (logo i signaturen, lenker, formatering).
                                           Sandkasse uten allow-scripts: ingen skript fra e-posten kan kjøre. *@
                                        <iframe class="ol-epost-ramme" title="E-post" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
                                                srcdoc="@html" onload="this.style.height=(this.contentDocument.documentElement.scrollHeight+8)+'px'"></iframe>
                                    }
                                    else if (string.IsNullOrWhiteSpace(_valgt.Innhold))
                                    {
                                        <p class="fp-tom">Ingen tekst registrert.</p>
                                    }
                                    else
                                    {
                                        <p class="fp-innhold-tekst">@_valgt.Innhold</p>
                                    }
                                    @if (VedleggForValgt.Count > 0)
                                    {
                                        <ul class="fp-vedlegg-liste">
                                            @foreach (var m in VedleggForValgt)
                                            {
                                                <li>
                                                    <a class="fp-vedlegg-chip" href="@($"/foresporselmedia/{m.Id}/fil")" target="_blank">
                                                        <span class="fp-vedlegg-chip-ikon"><Icon Name="file-text" /></span>
                                                        <span class="fp-vedlegg-chip-navn">@m.Filnavn</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                @if (_visSvarBoks)
                                {
                                    <div class="ol-svar">
                                        <div class="ol-svar-til">Til: <b>@(string.IsNullOrWhiteSpace(_valgt.FraNavn) ? _valgt.FraEpost : _valgt.FraNavn)</b> &lt;@_valgt.FraEpost&gt; · SV: @_valgt.Emne</div>
                                        <textarea rows="5" @bind="_svarTekst" @bind:event="oninput" placeholder="Skriv svaret ditt …"></textarea>
                                        <div class="ol-svar-bar">
                                            <button type="button" class="fp-knapp" @onclick="@(() => _visSvarBoks = false)">Forkast</button>
                                            <button type="button" class="fp-knapp fp-knapp-primaer" @onclick="SendSvar" disabled="@string.IsNullOrWhiteSpace(_svarTekst)"><Icon Name="send" />Send</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="ol-svarknapper">
                                        <button type="button" @onclick="ApneSvar"><Icon Name="send" />Svar</button>
                                    </div>
                                }
                                @if (_svarSendtOk is bool ok)
                                {
                                    <p class="@(ok ? "fp-svar-ok" : "fp-svar-feil")">@(ok ? "Svar sendt." : "Svar lagret, men e-post kunne ikke sendes.")</p>
                                }
                            }
                            else if (_aktivFane == "vedlegg")
                            {
                                @if (VedleggForValgt.Count == 0)
                                {
                                    <p class="fp-tom">Ingen vedlegg.</p>
                                }
                                else
                                {
                                    <ul class="fp-vedlegg-liste">
                                        @foreach (var m in VedleggForValgt)
                                        {
                                            <li>
                                                <a class="fp-vedlegg-chip" href="@($"/foresporselmedia/{m.Id}/fil")" target="_blank">
                                                    <span class="fp-vedlegg-chip-ikon"><Icon Name="file-text" /></span>
                                                    <span class="fp-vedlegg-chip-navn">@m.Filnavn</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            else if (_aktivFane == "notater")
                            {
                                <div class="fp-notat-input">
                                    <textarea rows="2" @bind="_nyttNotat" @bind:event="oninput" placeholder="Legg til internt notat..."></textarea>
                                    <button type="button" class="fp-knapp fp-knapp-primaer" @onclick="LeggTilNotat" disabled="@string.IsNullOrWhiteSpace(_nyttNotat)">Legg til</button>
                                </div>
                                @if (_valgt.Notater.Count == 0)
                                {
                                    <p class="fp-tom">Ingen interne notater ennå.</p>
                                }
                                else
                                {
                                    <ul class="fp-notat-liste">
                                        @foreach (var n in _valgt.Notater.OrderByDescending(n => n.OpprettetDato))
                                        {
                                            <li class="fp-notat-rad" @key="n.Id">
                                                <span class="fp-notat-tidspunkt">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                                                <span class="fp-notat-tekst">@n.Tekst @if (n.OpprettetAvBruker is not null) { <text> (@n.OpprettetAvBruker.Navn)</text> }</span>
                                                <button type="button" class="fp-notat-slett" @onclick="@(() => SlettNotat(n))" title="Slett notat"><Icon Name="trash" /></button>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            else if (_aktivFane == "aktivitet")
                            {
                                var aktivitet = AktivitetFor(_valgt);
                                @if (aktivitet.Count == 0)
                                {
                                    <p class="fp-tom">Ingen aktivitet registrert.</p>
                                }
                                else
                                {
                                    <ul class="fp-aktivitet-liste">
                                        @foreach (var a in aktivitet)
                                        {
                                            <li class="fp-aktivitet-rad">
                                                <span class="fp-aktivitet-tidspunkt">@a.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</span>
                                                <span class="fp-aktivitet-tekst">@a.Tekst@(a.UtfortAv is not null ? $" ({a.UtfortAv})" : "")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

@if (_visNyForesporselSkjema)
{
    <div class="fp-modal-overlay" @onclick="@(() => _visNyForesporselSkjema = false)">
        <div class="fp-modal" @onclick:stopPropagation="true">
            <h2>Ny forespørsel</h2>
            <p class="fp-section-hint">Registrer en henvendelse som kom inn på telefon, skjema eller på annet vis.</p>

            <label class="fp-felt">
                Kanal
                <select @bind="_nyDraft.Kanal">
                    @foreach (var k in Enum.GetValues<ForesporselKanal>())
                    {
                        <option value="@k">@k.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label class="fp-felt">Navn <input @bind="_nyDraft.FraNavn" @bind:event="oninput" placeholder="Kontaktperson" /></label>
            <label class="fp-felt">E-post / telefon <input @bind="_nyDraft.FraKontakt" @bind:event="oninput" placeholder="ola@eksempel.no eller 900 12 345" /></label>
            <label class="fp-felt">Emne <input @bind="_nyDraft.Emne" @bind:event="oninput" placeholder="Kort beskrivelse" /></label>
            <label class="fp-felt">Innhold <textarea rows="4" @bind="_nyDraft.Innhold" @bind:event="oninput" placeholder="Hva gjelder henvendelsen?"></textarea></label>

            @if (_nyFeil is not null)
            {
                <p class="fp-svar-feil">@_nyFeil</p>
            }

            <div class="fp-svar-actions">
                <button type="button" class="fp-knapp fp-knapp-primaer" @onclick="LagreNyForesporsel">Opprett forespørsel</button>
                <button type="button" class="fp-knapp" @onclick="@(() => _visNyForesporselSkjema = false)">Avbryt</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "fane")] public string? Fane { get; set; }

    // Hovedfane: forespørsler eller serviceoppdrag som kunder har meldt inn.
    private string _hovedfane = "foresporsler";
    private int _antallApneServiceoppdrag;

    private List<Foresporsel> _foresporsler = [];
    private Dictionary<int, Ticket> _ticketPerForesporsel = [];
    private Dictionary<string, Kunde> _kundeByEpost = [];
    private Dictionary<int, List<VedleggRad>> _vedleggForForesporsel = [];
    private sealed record VedleggRad(int Id, string Filnavn);
    private List<VedleggRad> VedleggForValgt => _valgt is null ? [] : _vedleggForForesporsel.GetValueOrDefault(_valgt.Id, []);
    private List<Kunde> _kunder = [];
    private List<Bruker> _brukere = [];

    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;

    private Foresporsel? _valgt;
    private string _aktivFane = "oversikt";
    private bool _visMeny;
    private bool _visRaadata;
    private bool _visSvarBoks;
    private string _svarTekst = "";
    private bool? _svarSendtOk;
    private string _nyttNotat = "";

    private string _sok = "";
    private string _kanalFilter = "";
    private int? _kundeFilter;
    private int? _ansvarligFilter;
    private string _sortering = "nyeste";

    private string _kundeFilterRaw
    {
        get => _kundeFilter?.ToString() ?? "";
        set => _kundeFilter = int.TryParse(value, out var v) ? v : null;
    }

    private string _ansvarligFilterRaw
    {
        get => _ansvarligFilter?.ToString() ?? "";
        set => _ansvarligFilter = int.TryParse(value, out var v) ? v : null;
    }

    private bool _visNyForesporselSkjema;
    private string? _nyFeil;

    private sealed class NyForesporselDraft
    {
        public ForesporselKanal Kanal { get; set; } = ForesporselKanal.Telefon;
        public string FraNavn { get; set; } = "";
        public string FraKontakt { get; set; } = "";
        public string Emne { get; set; } = "";
        public string Innhold { get; set; } = "";
    }

    private NyForesporselDraft _nyDraft = new();

    private sealed class AktivitetRad
    {
        public DateTime Tidspunkt { get; set; }
        public string Tekst { get; set; } = "";
        public string? UtfortAv { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        await LastDataAsync();

        _hovedfane = Fane == "serviceoppdrag" ? "serviceoppdrag" : "foresporsler";
        if (_hovedfane == "serviceoppdrag")
        {
            _mappe = "serviceoppdrag";
        }
        _visMapper = await VisningPref.HentAsync("foresporsler-mapper", "skjul") == "vis";
        _full = await VisningPref.HentAsync("foresporsler-bredde", "normal") == "full";
        _antallApneServiceoppdrag = await Db.Servicehenvendelser.CountAsync(h =>
            h.Status != ServicehenvendelseStatus.Fullfort && h.Status != ServicehenvendelseStatus.Avslatt);

        if (Id.HasValue)
        {
            var treff = _foresporsler.FirstOrDefault(f => f.Id == Id.Value);
            if (treff is not null)
            {
                _valgt = treff;
            }
        }

        if (_valgt is not null)
        {
            await HentHtmlOmMangler(_valgt);
        }
    }

    private async Task LastDataAsync()
    {
        var valgtId = _valgt?.Id;

        _foresporsler = await Db.Foresporsler
            .Include(f => f.Notater).ThenInclude(n => n.OpprettetAvBruker)
            .OrderByDescending(f => f.MottattDato)
            .ToListAsync();

        // Vedleggslisten viser kun Id/Filnavn (selve nedlastingen skjer via
        // /foresporselmedia/{id}/fil, uten å gå via C#) - henter derfor KUN
        // disse to feltene i stedet for full byte[] Data for samtlige
        // vedlegg på ALLE forespørsler ved hver sideinnlasting/handling, slik
        // det tidligere .Include(f => f.Media) gjorde. Se CODE_REVIEW.md 2026-10-08.
        _vedleggForForesporsel = (await Db.ForesporselMedia
                .AsNoTracking()
                .Where(m => !m.ErInline)
                .Select(m => new { m.ForesporselId, m.Id, m.Filnavn })
                .ToListAsync())
            .GroupBy(m => m.ForesporselId)
            .ToDictionary(g => g.Key, g => g.Select(m => new VedleggRad(m.Id, m.Filnavn)).ToList());

        var tickets = await Db.Tickets
            .Include(t => t.Kunde)
            .Include(t => t.Prosjekt)
            .Include(t => t.AnsvarligBruker)
            .Include(t => t.Hendelser).ThenInclude(h => h.UtfortAvBruker)
            .Where(t => t.ForesporselId != null)
            .ToListAsync();

        // Ingen DB-begrensning hindrer flere tickets fra å peke på samme forespørsel
        // (f.eks. via manuell kobling) - velger den nyeste per forespørsel for visning.
        _ticketPerForesporsel = tickets
            .GroupBy(t => t.ForesporselId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(t => t.OpprettetDato).First());

        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        _kundeByEpost = _kunder
            .Where(k => !string.IsNullOrWhiteSpace(k.Epost))
            .GroupBy(k => k.Epost!.Trim().ToLowerInvariant())
            .ToDictionary(g => g.Key, g => g.First());

        _brukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();

        _valgt = (valgtId.HasValue ? _foresporsler.FirstOrDefault(f => f.Id == valgtId) : null) ?? VisteForesporsler.FirstOrDefault();
    }

    private Ticket? TicketFor(Foresporsel f) => _ticketPerForesporsel.GetValueOrDefault(f.Id);
    private TicketStatus StatusFor(Foresporsel f) => TicketFor(f)?.Status ?? TicketStatus.Ny;

    private Kunde? KundeFor(Foresporsel f)
    {
        var ticket = TicketFor(f);
        if (ticket?.Kunde is not null)
        {
            return ticket.Kunde;
        }

        return _kundeByEpost.TryGetValue(f.FraEpost.Trim().ToLowerInvariant(), out var k) ? k : null;
    }

    private List<Kunde> RelevanteKunder => _kunder.Where(k => _foresporsler.Any(f => KundeFor(f)?.Id == k.Id)).ToList();

    private List<Foresporsel> VisteForesporsler
    {
        get
        {
            IEnumerable<Foresporsel> q = _foresporsler;

            if (!string.IsNullOrWhiteSpace(_sok))
            {
                var s = _sok.Trim();
                q = q.Where(f =>
                    f.Emne.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (f.FraNavn is not null && f.FraNavn.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    f.FraEpost.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    f.Innhold.Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(_kanalFilter) && Enum.TryParse<ForesporselKanal>(_kanalFilter, out var kanal))
            {
                q = q.Where(f => f.Kanal == kanal);
            }

            if (_kundeFilter is int kid)
            {
                q = q.Where(f => KundeFor(f)?.Id == kid);
            }

            if (_ansvarligFilter is int aid)
            {
                q = q.Where(f => TicketFor(f)?.AnsvarligBrukerId == aid);
            }

            var mappe = _mappe;
            q = q.Where(f => IMappe(f, mappe));

            q = _sortering == "eldste" ? q.OrderBy(f => f.MottattDato) : q.OrderByDescending(f => f.MottattDato);

            return q.ToList();
        }
    }

