@page "/foresporsler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Forespørsler</PageTitle>

<h1>Forespørsler</h1>
<p class="section-hint">
    E-poster sendt til post&#64;itlock.no havner her automatisk via Resend, med tekst og vedlegg. Trykk på en
    forespørsel for å se hele innholdet og opprette ticket.
</p>

@if (_foresporsler.Count == 0)
{
    <p class="list-empty">Ingen forespørsler mottatt ennå.</p>
}
else
{
    <div class="foresporsel-header">
        <span>Fra</span>
        <span>Emne</span>
        <span>Dato</span>
    </div>
    <ul class="foresporsel-liste">
        @foreach (var f in _foresporsler)
        {
            <li @key="f.Id">
                <a class="foresporsel-rad @(f.Lest ? "" : "foresporsel-ulest")" href="@($"/foresporsel/{f.Id}")">
                    <span class="foresporsel-fra">@(string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn)</span>
                    <span class="foresporsel-emne">@f.Emne</span>
                    <span class="foresporsel-dato">@f.MottattDato.ToString("dd.MM.yyyy HH:mm")</span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<Foresporsel> _foresporsler = [];

    protected override async Task OnInitializedAsync()
    {
        _foresporsler = await Db.Foresporsler.OrderByDescending(f => f.MottattDato).ToListAsync();
    }
}
