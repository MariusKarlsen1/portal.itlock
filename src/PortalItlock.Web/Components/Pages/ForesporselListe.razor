    private static string DagGruppe(DateTime d) =>
        d.Date == DateTime.Today ? "I dag"
        : d.Date == DateTime.Today.AddDays(-1) ? "I går"
        : d.Date > DateTime.Today.AddDays(-7) ? "Tidligere denne uken"
        : d.Year == DateTime.Today.Year ? d.ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))
        : d.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"));

    private static string KortTid(DateTime d) =>
        d.Date == DateTime.Today ? d.ToString("HH:mm")
        : d.Date > DateTime.Today.AddDays(-7) ? d.ToString("ddd HH:mm", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))
        : d.ToString("dd.MM.yyyy");

    private static string Forhand(Foresporsel f)
    {
        var t = string.Join(' ', (f.Innhold ?? "").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return t.Length > 110 ? t[..110] + "…" : t;
    }

    private static string StatusFarge(TicketStatus s) =>
        StatusFaner.FirstOrDefault(x => x.Status == s).Farge ?? "#9b9189";

    private static readonly (TicketStatus Status, string Tekst, string Farge)[] StatusFaner =
    [
        (TicketStatus.Ny, "Nye", "#2457c5"),
        (TicketStatus.UnderBehandling, "Under behandling", "#c9902f"),
        (TicketStatus.VenterGodkjenning, "Venter godkjenning", "#8a6ad0"),
        (TicketStatus.Lukket, "Ferdig", "#2e7d4f"),
    ];

    private static readonly string[] _avatarPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private static string AvatarFarge(Foresporsel f)
    {
        var navn = string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn;
        return _avatarPaletten[Math.Abs(navn.GetHashCode()) % _avatarPaletten.Length];
    }

    private static string Initialer(Foresporsel f)
    {
        var navn = string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : f.FraNavn;
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private List<AktivitetRad> AktivitetFor(Foresporsel f)
    {
        var liste = new List<AktivitetRad>
        {
            new() { Tidspunkt = f.MottattDato, Tekst = $"Forespørsel mottatt via {f.Kanal.Visningsnavn()}." }
        };

        var ticket = TicketFor(f);
        if (ticket is not null)
        {
            liste.Add(new AktivitetRad { Tidspunkt = ticket.OpprettetDato, Tekst = $"Ticket #{ticket.Id} opprettet." });
            foreach (var h in ticket.Hendelser)
            {
                liste.Add(new AktivitetRad { Tidspunkt = h.Tidspunkt, Tekst = h.Beskrivelse, UtfortAv = h.UtfortAvBruker?.Navn });
            }
        }

        return liste.OrderByDescending(a => a.Tidspunkt).ToList();
    }

    private async Task Velg(Foresporsel f)
    {
        _valgt = f;
        _bekreftSlett = false;
        _aktivFane = "oversikt";
        _visSvarBoks = false;
        _visMeny = false;
        _visRaadata = false;
