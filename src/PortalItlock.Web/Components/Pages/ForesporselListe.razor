    private void ApneNyForesporsel()
    {
        _nyDraft = new NyForesporselDraft();
        _nyFeil = null;
        _visNyForesporselSkjema = true;
    }

    private async Task LagreNyForesporsel()
    {
        if (string.IsNullOrWhiteSpace(_nyDraft.Emne) || string.IsNullOrWhiteSpace(_nyDraft.FraKontakt))
        {
            _nyFeil = "Fyll ut minst e-post/telefon og emne.";
            return;
        }

        var ny = new Foresporsel
        {
            Kanal = _nyDraft.Kanal,
            FraNavn = string.IsNullOrWhiteSpace(_nyDraft.FraNavn) ? null : _nyDraft.FraNavn.Trim(),
            FraEpost = _nyDraft.FraKontakt.Trim(),
            Emne = _nyDraft.Emne.Trim(),
            Innhold = _nyDraft.Innhold.Trim(),
            MottattDato = DateTime.Now,
            Lest = true
        };

        Db.Foresporsler.Add(ny);
        await Db.SaveChangesAsync();

        _visNyForesporselSkjema = false;
        await LastDataAsync();
        _valgt = _foresporsler.FirstOrDefault(f => f.Id == ny.Id);
    }
