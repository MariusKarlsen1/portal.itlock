@page "/foresporsler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Forespørsler</PageTitle>

<h1>Forespørsler</h1>
<p class="section-hint">
    E-poster sendt til post&#64;itlock.no havner her automatisk via Resend. Avsender og emne fanges opp automatisk, men
    Resend sender ikke selve e-post-teksten videre - åpne e-posten direkte i din vanlige e-post for å lese og svare på
    hele meldingen.
</p>

@if (_foresporsler.Count == 0)
{
    <p class="list-empty">Ingen forespørsler mottatt ennå.</p>
}
else
{
    <ul class="foresporsel-liste">
        @foreach (var f in _foresporsler)
        {
            <li @key="f.Id" class="foresporsel-rad @(f.Lest ? "" : "foresporsel-ulest")">
                <div class="foresporsel-header">
                    <strong>@(string.IsNullOrWhiteSpace(f.FraNavn) ? f.FraEpost : $"{f.FraNavn} <{f.FraEpost}>")</strong>
                    <span class="foresporsel-dato">@f.MottattDato.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div class="foresporsel-emne">@f.Emne</div>
                @if (!string.IsNullOrWhiteSpace(f.Innhold))
                {
                    <p class="foresporsel-tekst">@f.Innhold</p>
                }
                <div class="foresporsel-actions">
                    <a class="cancel-button" href="@($"mailto:{f.FraEpost}?subject={Uri.EscapeDataString("Re: " + f.Emne)}")">Svar i e-post</a>
                    @if (!f.Lest)
                    {
                        <button type="button" class="add-button" @onclick="@(() => MarkerSomLest(f))">Merk som lest</button>
                    }
                    <button type="button" class="cancel-button" @onclick="@(() => ToggleRaadata(f.Id))">
                        @(_visRaadata.Contains(f.Id) ? "Skjul rådata" : "Vis rådata")
                    </button>
                    <button type="button" class="remove-button" @onclick="@(() => SlettForesporsel(f))">Slett</button>
                </div>
                @if (_visRaadata.Contains(f.Id))
                {
                    <pre class="foresporsel-raadata">@f.RawJson</pre>
                }
            </li>
        }
    </ul>
}

@code {
    private List<Foresporsel> _foresporsler = [];
    private readonly HashSet<int> _visRaadata = [];

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _foresporsler = await Db.Foresporsler.OrderByDescending(f => f.MottattDato).ToListAsync();
    }

    private void ToggleRaadata(int id)
    {
        if (!_visRaadata.Add(id))
        {
            _visRaadata.Remove(id);
        }
    }

    private async Task MarkerSomLest(Foresporsel f)
    {
        f.Lest = true;
        await Db.SaveChangesAsync();
    }

    private async Task SlettForesporsel(Foresporsel f)
    {
        Db.Foresporsler.Remove(f);
        await Db.SaveChangesAsync();
        _foresporsler.Remove(f);
    }
}
