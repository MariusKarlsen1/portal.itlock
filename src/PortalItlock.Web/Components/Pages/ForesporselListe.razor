    private bool IMappe(Foresporsel f, string key) => key switch
    {
        "mine" => _naverendeBrukerId is int meg && TicketFor(f)?.AnsvarligBrukerId == meg,
        "ny" => StatusFor(f) == TicketStatus.Ny,
        "beh" => StatusFor(f) == TicketStatus.UnderBehandling,
        "god" => StatusFor(f) == TicketStatus.VenterGodkjenning,
        "ferdig" => StatusFor(f) == TicketStatus.Lukket,
        _ => true
    };

    private string MappeNavn => _mappe == "serviceoppdrag"
        ? "Serviceoppdrag fra kunder"
        : Mapper.FirstOrDefault(m => m.Key == _mappe)?.Navn ?? "Innboks";

    private void VelgMappe(string key)
    {
        _mappe = key;
        _visMappeMeny = false;
        _bekreftSlett = false;
        if (key != "serviceoppdrag" && (_valgt is null || !IMappe(_valgt, key)))
        {
            _valgt = VisteForesporsler.FirstOrDefault();
        }
    }

