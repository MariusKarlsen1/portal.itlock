@page "/plantegning/{Id:int}/utstyr"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject PlanUtstyrPdfService PdfService
@inject LagretPdfService LagretPdfService

<PageTitle>@(_plantegning?.Navn is null ? "Utstyr og kabeltrekk" : $"{_plantegning.Navn} - Utstyr og kabeltrekk")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke plantegningen. Den kan være slettet.</p>
}
else if (_plantegning is not null)
{
    <a class="back-link" href="@($"/plantegning/{_plantegning.Id}")">&larr; Tilbake til dørplantegningen</a>

    <h1>@_plantegning.Navn</h1>
    <p class="plan-subtitle">Plassering av utstyr og kabeltrekk - for elektriker</p>

    <div class="plan-toolbar">
        <div class="utstyr-toolbar-item">
            <button type="button" class="@(_utstyrPlacingType.HasValue ? "edit-button-active" : "add-button")" @onclick="ToggleUtstyrVelger">
                @(_utstyrPlacingType.HasValue ? $"Legger til: {_utstyrPlacingType.Value.Visningsnavn()}" : "Legg til utstyr")
            </button>

            @if (_visUtstyrVelger)
            {
                <div class="utstyr-velger-panel">
                    @foreach (var type in UtstyrTyper)
                    {
                        <button type="button" class="utstyr-velger-item" @onclick="@(() => VelgUtstyrType(type))">
                            <span class="utstyr-badge" style="color:@type.Farge()" title="@type.Kode()">
                                <svg viewBox="0 0 24 24" class="utstyr-ikon">@((MarkupString)type.IkonSvg())</svg>
                            </span>
                            @type.Visningsnavn()
                        </button>
                    }
                </div>
            }
        </div>

        <button type="button" class="@(_forbindelseModus ? "edit-button-active" : "add-button")" @onclick="ToggleForbindelseModus">
            @(_forbindelseModus ? "Avslutt kobling" : "Lag forbindelse")
        </button>

        <button type="button" class="@(_redigerPosisjon ? "edit-button-active" : "add-button")" @onclick="TogglePosisjonRediger">
            @(_redigerPosisjon ? "Lås posisjoner" : "Rediger posisjoner")
        </button>

        <button type="button" class="add-button" @onclick="VisPdfForhandsvisning">Generer PDF til elektriker</button>

        <button type="button" class="save-button" @onclick="LagreAlt">Lagre</button>

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="saved-hint">@_savedMessage</span>
        }
    </div>

    <div class="status-sticky">
        @if (_utstyrPlacingType.HasValue)
        {
            <p class="placing-hint">
                Legger til: <strong>@_utstyrPlacingType.Value.Visningsnavn()</strong> - klikk på tegningen for å legge til flere.
                <button type="button" class="cancel-button" @onclick="AvbrytUtstyrPlassering">Avbryt plassering</button>
            </p>
        }
        else if (_forbindelseModus)
        {
            <p class="placing-hint">
                @if (_forbindelseFraId is null)
                {
                    <text>Klikk på det første komponentet du vil koble sammen.</text>
                }
                else if (_forbindelseTilId is null)
                {
                    <text>Klikk på komponent nummer to.</text>
                }
            </p>
        }
        else if (_redigerPosisjon)
        {
            <p class="placing-hint">Du kan nå dra utstyret til ny posisjon.</p>
        }
        else
        {
            <p class="placing-hint">Rull med musehjulet for å zoome. Trykk og hold venstre museknapp på tegningen for å dra deg rundt.</p>
        }

        @if (_forbindelseFraId.HasValue && _forbindelseTilId.HasValue)
        {
            <div class="kabeltype-panel">
                <strong>Velg kabeltype</strong>
            <select @bind="_nyForbindelseType">
                @foreach (var kt in Enum.GetValues<KabelType>())
                {
                    <option value="@kt">@kt.Visningsnavn()</option>
                }
            </select>
                <button type="button" class="save-button" @onclick="LagForbindelse">Lag forbindelse</button>
                <button type="button" class="cancel-button" @onclick="AvbrytForbindelseValg">Avbryt</button>
            </div>
        }
    </div>

    <div class="utstyr-legend">
        @foreach (var type in UtstyrTyper)
        {
            <span class="utstyr-legend-item">
                <span class="utstyr-badge utstyr-badge-small" style="color:@type.Farge()" title="@type.Kode()">
                    <svg viewBox="0 0 24 24" class="utstyr-ikon">@((MarkupString)type.IkonSvg())</svg>
                </span>
                @type.Visningsnavn() <span class="utstyr-legend-kode">(@type.Kode())</span>
            </span>
        }
    </div>

    <div class="kabel-legend">
        @foreach (var kt in Enum.GetValues<KabelType>())
        {
            <span class="kabel-legend-item">
                <svg width="28" height="10" class="kabel-legend-strek">
                    <line x1="1" y1="5" x2="27" y2="5" stroke="@kt.Farge()" stroke-width="2.5" stroke-dasharray="@kt.StrekMonster()" />
                </svg>
                @kt.Visningsnavn()
            </span>
        }
    </div>

    <div class="plan-layout">
        <div class="plan-canvas-wrap" @ref="_canvasWrapRef">
            <div class="plan-canvas @(_redigerPosisjon ? "plan-canvas-rediger" : "")"
                 @ref="_canvasRef"
                 @onclick="OnCanvasClick">
                <img src="@($"/plantegningbilde/{_plantegning.Id}")" alt="@_plantegning.Navn" class="plan-image" />

                <svg class="kabel-svg-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                    @foreach (var f in _forbindelser)
                    {
                        @if (f.FraUtstyr is not null && f.TilUtstyr is not null)
                        {
                            <line x1="@f.FraUtstyr.PosX.ToString(CultureInfo.InvariantCulture)" y1="@f.FraUtstyr.PosY.ToString(CultureInfo.InvariantCulture)"
                                  x2="@f.TilUtstyr.PosX.ToString(CultureInfo.InvariantCulture)" y2="@f.TilUtstyr.PosY.ToString(CultureInfo.InvariantCulture)"
                                  stroke="@f.Type.Farge()" stroke-width="2" stroke-dasharray="@f.Type.StrekMonster()"
                                  vector-effect="non-scaling-stroke" />
                        }
                    }
                </svg>

                @foreach (var u in _utstyr)
                {
                    <div @key="u.Id" class="utstyr-marker @UtstyrMarkerClass(u)"
                         style="left:@(u.PosX.ToString(CultureInfo.InvariantCulture))%; top:@(u.PosY.ToString(CultureInfo.InvariantCulture))%;"
                         data-utstyrid="@u.Id">
                        <span class="utstyr-badge" style="color:@u.Type.Farge()" title="@u.Type.Visningsnavn()">
                            <svg viewBox="0 0 24 24" class="utstyr-ikon">@((MarkupString)u.Type.IkonSvg())</svg>
                        </span>
                        <span class="utstyr-marker-label">@u.Type.Kode()</span>
                    </div>
                }
            </div>
        </div>

        @if (_selectedUtstyr is not null)
        {
            <div class="utstyr-panel">
                <div class="utstyr-panel-header">
                    <h2>
                        <span class="utstyr-badge" style="color:@_selectedUtstyr.Type.Farge()">
                            <svg viewBox="0 0 24 24" class="utstyr-ikon">@((MarkupString)_selectedUtstyr.Type.IkonSvg())</svg>
                        </span>
                        @_selectedUtstyr.Type.Visningsnavn()
                    </h2>
                    <button type="button" class="cancel-button" @onclick="@(() => _selectedUtstyr = null)">Lukk</button>
                </div>
                <label class="utstyr-notat-label">
                    Notat
                    <textarea rows="3" @bind="_selectedUtstyr.Notat"></textarea>
                </label>
                <div class="utstyr-panel-actions">
                    <button type="button" class="save-button" @onclick="LagreUtstyr">Lagre</button>
                    <button type="button" class="delete-button" @onclick="SlettUtstyr">Slett</button>
                </div>

                <div class="utstyr-forbindelser">
                    <strong>Forbindelser</strong>
                    @{ var koblinger = ForbindelserFor(_selectedUtstyr).ToList(); }
                    @if (koblinger.Count == 0)
                    {
                        <p class="list-empty">Ingen forbindelser ennå.</p>
                    }
                    else
                    {
                        <ul class="forbindelse-list">
                            @foreach (var f in koblinger)
                            {
                                var motpart = Motpart(f, _selectedUtstyr.Id);
                                <li @key="f.Id" class="forbindelse-item">
                                    <svg width="22" height="10" class="kabel-legend-strek">
                                        <line x1="1" y1="5" x2="21" y2="5" stroke="@f.Type.Farge()" stroke-width="2.5" stroke-dasharray="@f.Type.StrekMonster()" />
                                    </svg>
                                    <span>@f.Type.Visningsnavn() &rarr; @(motpart?.Type.Visningsnavn() ?? "?") (@motpart?.Type.Kode())</span>
                                    <button type="button" class="remove-button" @onclick="@(() => SlettForbindelse(f))">Slett</button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>

    <h2>Lagrede PDF-er</h2>
    <LagredePdfListe Pdfer="_lagredePdfer" />

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av utstyr og kabeltrekk" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreUtstyrPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Plantegning? _plantegning;
    private bool _notFound;
    private int? _loadedId;
    private string? _savedMessage;
    private bool _redigerPosisjon;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private List<LagretPdf> _lagredePdfer = [];

    private static readonly PlanUtstyrType[] UtstyrTyper =
    [
        PlanUtstyrType.Kortleser,
        PlanUtstyrType.Kac,
        PlanUtstyrType.Apneknapp,
        PlanUtstyrType.Sentral,
        PlanUtstyrType.Stikkontakt,
        PlanUtstyrType.Ups,
        PlanUtstyrType.Datapunkt,
        PlanUtstyrType.Pir,
        PlanUtstyrType.Alarmpanel,
        PlanUtstyrType.Hovedsentral,
        PlanUtstyrType.Kamera,
        PlanUtstyrType.Dorautomatikk,
        PlanUtstyrType.Sirene,
        PlanUtstyrType.Albuebryter,
        PlanUtstyrType.Nokkelbryter,
        PlanUtstyrType.Grensesnittboks,
        PlanUtstyrType.Iq,
        PlanUtstyrType.Node,
        PlanUtstyrType.Gateway,
        PlanUtstyrType.Hub,
        PlanUtstyrType.Porttelefon
    ];

    private List<PlanUtstyr> _utstyr = [];
    private List<PlanForbindelse> _forbindelser = [];
    private PlanUtstyr? _selectedUtstyr;
    private bool _visUtstyrVelger;
    private PlanUtstyrType? _utstyrPlacingType;

    private bool _forbindelseModus;
    private int? _forbindelseFraId;
    private int? _forbindelseTilId;
    private KabelType _nyForbindelseType = KabelType.CatKabel;

    private ElementReference _canvasRef;
    private ElementReference _canvasWrapRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlantegningUtstyr>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedUtstyr = null;
        _visUtstyrVelger = false;
        _utstyrPlacingType = null;
        _forbindelseModus = false;
        _forbindelseFraId = null;
        _forbindelseTilId = null;

        _plantegning = await Db.Plantegninger.FirstOrDefaultAsync(p => p.Id == Id);

        if (_plantegning is null)
        {
            _notFound = true;
            return;
        }

        _utstyr = await Db.PlanUtstyr
            .Where(u => u.PlantegningId == Id)
            .ToListAsync();

        var utstyrIds = _utstyr.Select(u => u.Id).ToList();

        _forbindelser = await Db.PlanForbindelser
            .Include(f => f.FraUtstyr)
            .Include(f => f.TilUtstyr)
            .Where(f => utstyrIds.Contains(f.FraUtstyrId))
            .ToListAsync();

        _lagredePdfer = await LagretPdfService.HentAsync("PlanUtstyr", Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plantegning.js?v=4");
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (_module is not null && _dotNetRef is not null && _plantegning is not null)
        {
            await _module.InvokeVoidAsync("attachUtstyrMarkers", _canvasRef, _dotNetRef, !_redigerPosisjon);

            if (firstRender)
            {
                await _module.InvokeVoidAsync("initSaveShortcut", _dotNetRef);
                await _module.InvokeVoidAsync("initZoomPan", _canvasWrapRef, _canvasRef, _dotNetRef);
            }
        }
    }

    private string UtstyrMarkerClass(PlanUtstyr u)
    {
        if (_selectedUtstyr?.Id == u.Id || _forbindelseFraId == u.Id)
        {
            return "utstyr-marker-selected";
        }
        return "";
    }

    private IEnumerable<PlanForbindelse> ForbindelserFor(PlanUtstyr u) =>
        _forbindelser.Where(f => f.FraUtstyrId == u.Id || f.TilUtstyrId == u.Id);

    private PlanUtstyr? Motpart(PlanForbindelse f, int selvId) =>
        f.FraUtstyrId == selvId ? f.TilUtstyr : f.FraUtstyr;

    [JSInvokable]
    public async Task SaveNow()
    {
        await LagreAlt();
    }

    private async Task LagreAlt()
    {
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
        _redigerPosisjon = false;
        StateHasChanged();
    }

    private void TogglePosisjonRediger()
    {
        _redigerPosisjon = !_redigerPosisjon;
    }

    private void VisPdfForhandsvisning()
    {
        if (_plantegning is null)
        {
            return;
        }

        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/plantegning/{_plantegning.Id}/utstyr/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreUtstyrPdf()
    {
        if (_plantegning is null)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(_plantegning.Id);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "PlanUtstyr", _plantegning.Id, $"Utstyr og kabeltrekk - {_plantegning.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    [JSInvokable]
    public void OnCanvasRightClicked(double x, double y)
    {
        // Høyreklikk brukes ikke på denne siden - reservert for fremtidig bruk.
    }

    private async Task ToggleUtstyrVelger()
    {
        if (_utstyrPlacingType.HasValue)
        {
            await AvbrytUtstyrPlassering();
            return;
        }

        _forbindelseModus = false;
        _forbindelseFraId = null;
        _forbindelseTilId = null;
        _visUtstyrVelger = !_visUtstyrVelger;
    }

    private async Task VelgUtstyrType(PlanUtstyrType type)
    {
        _selectedUtstyr = null;
        _utstyrPlacingType = type;
        _visUtstyrVelger = false;
        await SettPlasseringsModus(true);
    }

    private async Task AvbrytUtstyrPlassering()
    {
        _utstyrPlacingType = null;
        _visUtstyrVelger = false;
        await SettPlasseringsModus(false);
    }

    private async Task SettPlasseringsModus(bool plasserer)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setUtstyrPlacing", _canvasRef, plasserer);
        }
    }

    private async Task ToggleForbindelseModus()
    {
        _forbindelseModus = !_forbindelseModus;
        _forbindelseFraId = null;
        _forbindelseTilId = null;

        if (_forbindelseModus)
        {
            _utstyrPlacingType = null;
            _visUtstyrVelger = false;
            _selectedUtstyr = null;
            await SettPlasseringsModus(false);
        }
    }

    private void AvbrytForbindelseValg()
    {
        _forbindelseFraId = null;
        _forbindelseTilId = null;
    }

    private async Task LagForbindelse()
    {
        if (_forbindelseFraId is null || _forbindelseTilId is null)
        {
            return;
        }

        var forbindelse = new PlanForbindelse
        {
            FraUtstyrId = _forbindelseFraId.Value,
            TilUtstyrId = _forbindelseTilId.Value,
            Type = _nyForbindelseType
        };

        Db.PlanForbindelser.Add(forbindelse);
        await Db.SaveChangesAsync();

        forbindelse.FraUtstyr = _utstyr.FirstOrDefault(u => u.Id == forbindelse.FraUtstyrId);
        forbindelse.TilUtstyr = _utstyr.FirstOrDefault(u => u.Id == forbindelse.TilUtstyrId);
        _forbindelser.Add(forbindelse);

        _forbindelseFraId = null;
        _forbindelseTilId = null;
    }

    private async Task SlettForbindelse(PlanForbindelse f)
    {
        Db.PlanForbindelser.Remove(f);
        await Db.SaveChangesAsync();
        _forbindelser.Remove(f);
    }

    private async Task OnCanvasClick(MouseEventArgs e)
    {
        if (_plantegning is null || _module is null || !_utstyrPlacingType.HasValue)
        {
            return;
        }

        var pos = await _module.InvokeAsync<PosResult>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);
        var utstyr = new PlanUtstyr
        {
            PlantegningId = _plantegning.Id,
            Type = _utstyrPlacingType.Value,
            PosX = pos.X,
            PosY = pos.Y
        };
        Db.PlanUtstyr.Add(utstyr);
        await Db.SaveChangesAsync();
        _utstyr.Add(utstyr);
    }

    [JSInvokable]
    public async Task OnUtstyrMoved(int utstyrId, double x, double y)
    {
        var utstyr = _utstyr.FirstOrDefault(u => u.Id == utstyrId);
        if (utstyr is null)
        {
            return;
        }

        utstyr.PosX = x;
        utstyr.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public void OnUtstyrClicked(int utstyrId)
    {
        if (_forbindelseModus)
        {
            if (_forbindelseFraId is null)
            {
                _forbindelseFraId = utstyrId;
            }
            else if (_forbindelseFraId == utstyrId)
            {
                _forbindelseFraId = null;
            }
            else
            {
                _forbindelseTilId = utstyrId;
            }

            StateHasChanged();
            return;
        }

        var valgt = _utstyr.FirstOrDefault(u => u.Id == utstyrId);
        if (valgt is null)
        {
            return;
        }

        _selectedUtstyr = valgt;
        StateHasChanged();
    }

    private async Task LagreUtstyr()
    {
        if (_selectedUtstyr is null)
        {
            return;
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SlettUtstyr()
    {
        if (_selectedUtstyr is null)
        {
            return;
        }

        var relaterte = ForbindelserFor(_selectedUtstyr).ToList();
        foreach (var f in relaterte)
        {
            Db.PlanForbindelser.Remove(f);
            _forbindelser.Remove(f);
        }

        Db.PlanUtstyr.Remove(_selectedUtstyr);
        await Db.SaveChangesAsync();
        _utstyr.Remove(_selectedUtstyr);
        _selectedUtstyr = null;
    }

    private sealed class PosResult
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
