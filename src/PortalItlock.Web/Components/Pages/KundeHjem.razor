@page "/kunde"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>For kunden - Full Kontroll</PageTitle>

@if (_ikkeAktiv)
{
    <p class="dp-feil">Tilgangen din er deaktivert. Ta kontakt med oss for å få den aktivert igjen.</p>
}
else if (_ikkeKoblet)
{
    <p class="dp-feil">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med oss.</p>
}
else if (_kunde is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    <div class="dp-hei">
        <small>@_kunde.Navn</small>
        <h1>Hei, @DriftHelper.Fornavn(_brukerNavn)</h1>
        <p>@(string.IsNullOrWhiteSpace(_kunde.Adresse) ? "Her ser du jobber, saker og det som venter på deg." : $"{_kunde.Adresse}{(string.IsNullOrWhiteSpace(_kunde.Sted) ? "" : $", {_kunde.Sted}")}")</p>
    </div>

    <a class="dp-meldknapp dp-kun-mobil" href="/kunde/ny">
        <span class="dp-ik"><Icon Name="plus" /></span>
        <span><b>Ny henvendelse</b><small>Meld inn noe som skal fikses eller byttes</small></span>
        <Icon Name="arrow-right" />
    </a>

    <div class="dp-kpi">
        <div class="@(AntallVenter > 0 ? "dp-varsel" : "")"><small>Venter på deg</small><b>@AntallVenter</b></div>
        <div><small>Neste besøk</small><b style="font-size:1.15rem;margin-top:.35rem">@(_nesteBesok?.PlanlagtDato is { } nb ? $"{KundeportalHelper.Ukedag(nb)} {nb:dd.MM}{(nb.TimeOfDay == TimeSpan.Zero ? "" : $" kl. {nb:HH:mm}")}" : "Ikke planlagt")</b></div>
        <div><small>Åpne saker</small><b>@_apneSaker</b></div>
        <div><small>Jobber i år</small><b>@_jobberIAr</b></div>
    </div>

    <div class="dp-to-kol">
        <div class="dp-kol">
            @if (AntallVenter > 0)
            {
                <div class="dp-seksjon-t"><h2>Venter på svar fra deg</h2><span>@AntallVenter</span></div>
                @foreach (var a in _avvikTilGodkjenning)
                {
                    <div class="dp-venter" @key="a.Id">
                        <div class="dp-venter-topp">
                            <span class="dp-ik"><Icon Name="alert-triangle" /></span>
                            <span><b>Avvik på dør @a.Dor?.Dornummer</b><small>@Kort(a.Beskrivelse) · @a.Dor?.Prosjekt?.Navn</small></span>
                            @if (a.Pris.HasValue)
                            {
                                <span class="dp-pris">@a.Pris.Value.ToString("N0") kr</span>
                            }
                        </div>
                        <div class="dp-venter-knapper">
                            <a class="dp-knapp dp-knapp-g" href="@($"/kunde/avvik/{a.Id}")"><Icon Name="check" />Se og godkjenn</a>
                        </div>
                    </div>
                }
                @foreach (var t in _tilvalgVenter)
                {
                    <div class="dp-venter dp-venter-bla" @key="t.Id">
                        <div class="dp-venter-topp">
                            <span class="dp-ik"><Icon Name="list" /></span>
                            <span><b>Velg: @t.Tittel</b><small>@t.Prosjekt?.Navn</small></span>
                        </div>
                        <div class="dp-venter-knapper">
                            <a class="dp-knapp dp-knapp-b" href="@($"/kunde/tilvalg/{t.Id}")">Se og velg</a>
                        </div>
                    </div>
                }
            }

            <div class="dp-seksjon-t"><h2>Mine henvendelser</h2><a href="/kunde/ny">+ Ny</a></div>
            @if (_henvendelser.Count == 0)
            {
                <div class="dp-kort dp-tom">Ingen henvendelser sendt inn ennå. Trykk «Ny henvendelse» når noe skal fikses.</div>
            }
            else
            {
                <div class="dp-meldinger">
                    @foreach (var h in _henvendelser.Take(_visAlleHenvendelser ? 100 : 5))
                    {
                        <div class="dp-melding dp-bryt" style="grid-template-columns:38px minmax(0,1fr)" @key="h.Id">
                            <span class="dp-ik dp-t-@KundeportalHelper.Farge(h.Status)"><Icon Name="@KundeportalHelper.Ikon(h.Status)" /></span>
                            <span>
                                <b>@h.Dortype@(string.IsNullOrWhiteSpace(h.Beskrivelse) ? "" : $" – {Kort(h.Beskrivelse)}")</b>
                                <small>Sendt @h.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(h.OnsketTidspunkt) ? "" : $" · ønsket {h.OnsketTidspunkt}")@(h.Haster ? " · Haster" : "")</small>
                                <span class="dp-tag dp-t-@KundeportalHelper.Farge(h.Status)">@KundeportalHelper.Navn(h.Status)@(h.AntattLeveringsdato.HasValue ? $" – antatt {h.AntattLeveringsdato.Value:dd.MM}" : "")</span>
                                @if (!string.IsNullOrWhiteSpace(h.SvarFraItlock))
                                {
                                    <span class="dp-svar" style="display:block;margin-top:.5rem"><span class="dp-svar-t">Svar fra oss</span>@h.SvarFraItlock</span>
                                }
                                @if (_bildeIder.TryGetValue(h.Id, out var bilder) && bilder.Count > 0)
                                {
                                    <span class="dp-media" style="margin-top:.5rem;grid-template-columns:repeat(auto-fill,minmax(64px,1fr))">
                                        @foreach (var bildeId in bilder)
                                        {
                                            <img @key="bildeId" src="@($"/servicehenvendelse/bilde/{bildeId}")" alt="Bilde" />
                                        }
                                    </span>
                                }
                            </span>
                        </div>
                    }
                </div>
                @if (_henvendelser.Count > 5 && !_visAlleHenvendelser)
                {
                    <button type="button" class="dp-knapp" @onclick="@(() => _visAlleHenvendelser = true)">Vis alle @_henvendelser.Count</button>
                }
            }
        </div>

        <div class="dp-kol">
            <div class="dp-seksjon-t"><h2>Neste besøk</h2><a href="/kunde/jobber">Alle jobber</a></div>
            @if (_nesteBesok is null)
            {
                <div class="dp-kort dp-tom">Ingen besøk planlagt akkurat nå.</div>
            }
            else
            {
                <div class="dp-kort dp-besok">
                    <a class="dp-besok-topp" href="@($"/kunde/jobb/{_nesteBesok.Id}")">
                        @if (_nesteBesok.PlanlagtDato is { } dato)
                        {
                            <span class="dp-kal"><small>@KundeportalHelper.Ukedag(dato)</small><b>@dato.Day</b></span>
                        }
                        <span>
                            <b>@_nesteBesok.Tittel</b>
                            <span>@Tidsrom(_nesteBesok)@(string.IsNullOrWhiteSpace(_nesteBesok.Adresse) ? "" : $" · {_nesteBesok.Adresse}")</span>
                        </span>
                    </a>
                    @if (_nesteBesok.AnsvarligMontor is { } montor)
                    {
                        <div class="dp-montor"><i>@KundeportalHelper.Initialer(montor.Navn)</i><span><b>@montor.Navn</b><small>kommer på besøk</small></span></div>
                    }
                    <a class="dp-info-felt" href="@($"/kunde/jobb/{_nesteBesok.Id}")">
                        <Icon Name="help-circle" />
                        @if (string.IsNullOrWhiteSpace(_nesteBesok.KundeInfoForJobb))
                        {
                            <span><b>Info før vi kommer:</b> Legg inn hvor nøkkelen ligger, adkomst eller bilder →</span>
                        }
                        else
                        {
                            <span><b>Info før vi kommer:</b> «@Kort(_nesteBesok.KundeInfoForJobb)» <u>Endre</u></span>
                        }
                    </a>
                </div>
            }

            @if (_sisteRapport is not null)
            {
                <div class="dp-seksjon-t"><h2>Siste rapport</h2><a href="@($"/kunde/jobb/{_sisteRapport.Id}")">Åpne</a></div>
                <a class="dp-kort dp-rapport" href="@($"/kunde/jobb/{_sisteRapport.Id}")" style="text-decoration:none;color:inherit">
                    <h3>@_sisteRapport.Tittel · @((_sisteRapport.FullfortDato ?? _sisteRapport.PlanlagtDato)?.ToString("dd.MM.yyyy"))</h3>
                    <p>@Kort(RikTekst.TilTekst(_sisteRapport.UtfortArbeid), 220)</p>
                </a>
            }

            <div class="dp-seksjon-t"><h2>Mine saker</h2><a href="/kunde/saker">Se alle</a></div>
            @if (_saker.Count == 0)
            {
                <div class="dp-kort dp-tom">Ingen saker registrert.</div>
            }
            else
            {
                <div class="dp-meldinger">
                    @foreach (var s in _saker.Take(3))
                    {
                        <a class="dp-melding" href="@($"/kunde/sak/{s.Id}")" @key="s.Id">
                            <span class="dp-ik dp-t-@KundeportalHelper.Farge(s.Status)"><Icon Name="mail" /></span>
                            <span><b>@s.Tittel</b><small>Sak #@s.Id · @s.OpprettetDato.ToString("dd.MM.yyyy")</small><span class="dp-tag dp-t-@KundeportalHelper.Farge(s.Status)">@KundeportalHelper.Navn(s.Status)</span></span>
                            <Icon Name="chevron-right" />
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Kunde? _kunde;
    private string _brukerNavn = "";
    private bool _ikkeKoblet;
    private bool _ikkeAktiv;
    private List<Servicehenvendelse> _henvendelser = [];
    private Dictionary<int, List<int>> _bildeIder = [];
    private List<Avvik> _avvikTilGodkjenning = [];
    private List<Tilvalg> _tilvalgVenter = [];
    private List<Ticket> _saker = [];
    private Arbeidsordre? _nesteBesok;
    private Arbeidsordre? _sisteRapport;
    private int _apneSaker;
    private int _jobberIAr;
    private bool _visAlleHenvendelser;

    private int AntallVenter => _avvikTilGodkjenning.Count + _tilvalgVenter.Count;

    private static string Kort(string? tekst, int maks = 60)
    {
        if (string.IsNullOrWhiteSpace(tekst)) return "";
        var t = tekst.Trim().ReplaceLineEndings(" ");
        return t.Length > maks ? t[..maks].TrimEnd() + "…" : t;
    }

    private static string Tidsrom(Arbeidsordre a) =>
        a.PlanlagtDato is not { } fra ? "Dato ikke satt"
        : fra.TimeOfDay == TimeSpan.Zero ? fra.ToString("dd.MM.yyyy")
        : a.PlanlagtSlutt is { } til ? $"Kl. {fra:HH:mm}–{til:HH:mm}"
        : $"Kl. {fra:HH:mm}";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser en admin portalen via "Vis som Kunde", leses innholdet til den
        // kunden som forhåndsvises - ellers til brukeren selv.
        // Se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Kunde).FirstOrDefaultAsync(b => b.Id == brukerId);
        if (bruker?.Kunde is null)
        {
            _ikkeKoblet = true;
            return;
        }

        if (!bruker.Aktiv)
        {
            _ikkeAktiv = true;
            return;
        }

        _kunde = bruker.Kunde;
        _brukerNavn = bruker.Navn;
        _henvendelser = await Db.Servicehenvendelser
            .Where(h => h.KundeId == _kunde.Id)
            .OrderByDescending(h => h.OpprettetDato)
            .ToListAsync();

        var henvendelseIder = _henvendelser.Select(h => h.Id).ToList();
        var bilder = await Db.ServicehenvendelseBilder
            .Where(b => henvendelseIder.Contains(b.ServicehenvendelseId))
            .Select(b => new { b.Id, b.ServicehenvendelseId })
            .ToListAsync();
        _bildeIder = bilder
            .GroupBy(b => b.ServicehenvendelseId)
            .ToDictionary(g => g.Key, g => g.Select(b => b.Id).ToList());

        _avvikTilGodkjenning = await Db.Avvik
            .Include(a => a.Dor).ThenInclude(d => d!.Prosjekt)
            .Where(a => a.Status == AvvikStatus.SendtTilKunde && a.Dor!.Prosjekt!.KundeId == _kunde.Id)
            .OrderBy(a => a.SendtTilKundeDato)
            .ToListAsync();

        _tilvalgVenter = await Db.Tilvalg
            .Include(t => t.Prosjekt)
            .Where(t => t.Status == TilvalgStatus.Publisert && t.Prosjekt!.KundeId == _kunde.Id)
            .OrderByDescending(t => t.PublisertDato)
            .ToListAsync();

        _saker = await Db.Tickets
            .Where(t => t.KundeId == _kunde.Id)
            .OrderBy(t => t.Status == TicketStatus.Lukket).ThenByDescending(t => t.OpprettetDato)
            .ToListAsync();
        _apneSaker = _saker.Count(s => s.Status != TicketStatus.Lukket);

        var jobber = await KundeportalHelper.Jobber(Db, _kunde.Id)
            .Include(a => a.AnsvarligMontor)
            .AsNoTracking()
            .ToListAsync();

        _nesteBesok = jobber
            .Where(a => !KundeportalHelper.ErFerdig(a) && a.PlanlagtDato is { } d && d.Date >= DateTime.Today)
            .OrderBy(a => a.PlanlagtDato)
            .FirstOrDefault();

        _sisteRapport = jobber
            .Where(a => KundeportalHelper.ErFerdig(a) && !string.IsNullOrWhiteSpace(a.UtfortArbeid))
            .OrderByDescending(a => a.FullfortDato ?? a.PlanlagtDato)
            .FirstOrDefault();

        _jobberIAr = jobber.Count(a => KundeportalHelper.ErFerdig(a) && (a.FullfortDato ?? a.PlanlagtDato)?.Year == DateTime.Today.Year);
    }
}
