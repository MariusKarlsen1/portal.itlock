@page "/servicemodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]

<PageTitle>Service modul - itlock</PageTitle>

<div class="modul-header">
    <div class="modul-header-tittel">
        <span class="modul-header-ikon"><Icon Name="clock" /></span>
        <h1>Service modul</h1>
    </div>
    <p class="section-hint">Alt som gjelder service samlet på ett sted: serviceavtaler, serviceoppdrag og tilbud service.</p>
</div>

<div class="modul-grid">
    <a href="/service" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="clock" /></span>
        <span class="modul-card-title">Serviceavtaler</span>
        <span class="modul-card-desc">Serviceavtaler og serviceoppdrag samlet, med servicehistorikk og rapporter.</span>
    </a>
    <a href="/tilbud-service" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="receipt" /></span>
        <span class="modul-card-title">Tilbud service</span>
        <span class="modul-card-desc">Opprett og se tilbud for serviceavtaler, med estimater fra arbeidsordre-minuttene.</span>
    </a>
</div>
