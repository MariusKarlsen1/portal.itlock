@page "/ressursplanlegger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Ressursplanlegger</PageTitle>

<h1>Ressursplanlegger</h1>
<p class="section-hint">
    Sett av ansatte på dager fremover - uavhengig av om det finnes en arbeidsordre ennå. Dobbeltklikk på en dag for
    å legge til en etikett med klokkeslett, eller dra en etikett til en annen dag/ansatt/klokkeslett for å flytte
    den. Etikettene vises også i den ansattes egen kalender.
</p>

<div class="kalender-verktoylinje">
    <div class="kalender-nav">
        <button type="button" class="cancel-button" @onclick="ForrigeUke">&larr;</button>
        <span class="kalender-manednavn">@UkeTekst()</span>
        <button type="button" class="cancel-button" @onclick="NesteUke">&rarr;</button>
    </div>
    <button type="button" class="cancel-button" @onclick="GaTilIDag">I dag</button>
</div>

@if (_redigeringDato is not null)
{
    <div class="ressurs-modal-overlay">
        <div class="ressurs-modal boks-panel">
            <h2>@(_redigeringId is null ? "Ny etikett" : "Rediger etikett") - @_redigeringDato.Value.ToString("dd.MM.yyyy")</h2>
            <div class="field-grid">
                <label class="span-2">
                    Tittel
                    <input type="text" @bind="_formTittel" placeholder="F.eks. Befaring hos kunde A" />
                </label>
                <label>
                    Ansatt
                    <select @bind="_formAnsattId">
                        <option value="">Velg ansatt...</option>
                        @foreach (var a in _ansatte)
                        {
                            <option value="@a.Id">@a.Navn</option>
                        }
                    </select>
                </label>
                <label>
                    Fra
                    <input type="time" @bind="_formFra" />
                </label>
                <label>
                    Til
                    <input type="time" @bind="_formTil" />
                </label>
                <label class="span-2">
                    Beskrivelse
                    <textarea rows="3" @bind="_formInfo" placeholder="Mer detaljert beskrivelse - vises først når etiketten åpnes"></textarea>
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_feilmelding))
            {
                <p class="form-error">@_feilmelding</p>
            }
            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (_redigeringId is not null)
                {
                    <button type="button" class="remove-button" @onclick="Slett">Slett</button>
                }
                <button type="button" class="cancel-button" @onclick="AvbrytRedigering">Avbryt</button>
            </div>
        </div>
    </div>
}

@if (_laster)
{
    <p class="list-empty">Laster...</p>
}
else
{
    <div class="ressurs-kalender">
        <div class="kalender-ukedager">
            @foreach (var dag in _dager)
            {
                var helligdag = NorskHelligdag.Navn(dag.Dato);
                var erRod = helligdag is not null || NorskHelligdag.ErSondag(dag.Dato);
                <div class="kalender-ukedag @(erRod ? "kalender-ukedag-rod" : "") @(dag.Dato == DateTime.Today ? "kalender-ukedag-idag" : "")">
                    <span class="ukedag-navn">@dag.Dato.ToString("ddd", Kultur)</span>
                    <span class="ukedag-dato">@dag.Dato.ToString("dd.MM")</span>
                    @if (helligdag is not null)
                    {
                        <span class="ukedag-helligdag">@helligdag</span>
                    }
                </div>
            }
            <div class="kalender-ukedag kalender-ukedag-medlemmer">
                <span class="ukedag-navn">Medlemmer</span>
            </div>
        </div>

        <div class="ressurs-tidsgrid">
            <div class="dager-rad">
                @foreach (var dag in _dager)
                {
                    var helligdag = NorskHelligdag.Navn(dag.Dato);
                    var erRod = helligdag is not null || NorskHelligdag.ErSondag(dag.Dato);
                    <div id="@DagKolonneId(dag.Dato)" class="ressurs-dag-kolonne @(dag.Dato == DateTime.Today ? "ressurs-dag-idag" : "") @(erRod ? "ressurs-dag-rod" : "")"
                         style="height: @PxTekst(RutenettHoydePx); background-image: @BandDelelinjerBakgrunn();"
                         @ondblclick="@(() => StartNy(dag.Dato))"
                         @ondragover="@(() => { })" @ondragover:preventDefault="true"
                         @ondrop="@(e => SlippBoks(dag.Dato, e))">
                        @foreach (var boks in dag.Boxer)
                        {
                            var breddeProsent = 100.0 / boks.BaneAntall;
                            var venstreProsent = breddeProsent * boks.BaneIndex;
                            <button type="button" class="ressurs-boks" draggable="true" style="--montor-farge: @FargeForAnsatt(boks.AnsattId); top: @PxTekst(boks.TopPx); height: @PxTekst(boks.HoydePx); left: calc(@ProsentTekst(venstreProsent) + 2px); width: calc(@ProsentTekst(breddeProsent) - 4px);" @onclick="@(() => StartRediger(boks))" @ondragstart="@(() => _draggingBoksId = boks.Id)">
                                <span class="ressurs-boks-tittel">@boks.Tittel</span>
                                <span class="ressurs-boks-tid">@boks.Fra.ToString(@"hh\:mm")&ndash;@boks.Til.ToString(@"hh\:mm")</span>
                            </button>
                        }
                    </div>
                }

                <div class="ressurs-medlemmer-kolonne" style="height: @PxTekst(RutenettHoydePx)">
                    @foreach (var a in _ansatte)
                    {
                        <div class="medlem-band" style="height: @PxTekst(AnsattBandHoydePx(a.Id)); border-left-color: @FargeForAnsatt(a.Id); background: color-mix(in srgb, @FargeForAnsatt(a.Id) 16%, var(--itlock-surface));">
                            @a.Navn
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private sealed class AnsattOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class BoksRad
    {
        public int Id { get; set; }
        public int AnsattId { get; set; }
        public string Tittel { get; set; } = "";
        public string Info { get; set; } = "";
        public TimeSpan Fra { get; set; }
        public TimeSpan Til { get; set; }

        // Sidestilling for overlappende etiketter (f.eks. to montører booket samme klokkeslett):
        // BaneIndex/BaneAntall gjør at de vises ved siden av hverandre i dagkolonnen i stedet
        // for oppå hverandre.
        public int BaneIndex { get; set; }
        public int BaneAntall { get; set; } = 1;

        // Beregnet posisjon innenfor dagkolonnen (settes av PlasserKlynger i LastAsync).
        public double TopPx { get; set; }
        public double HoydePx { get; set; }
    }

    private sealed class DagRad
    {
        public required DateTime Dato { get; set; }
        public List<BoksRad> Boxer { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Ukedagnavn = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];

    private const double TimeHoydePx = 56;
    private const double MinBoksHoydePx = 34;
    private const double BoksPaddingPx = 2;
    private const double BoksMellomromPx = 3;
    private const double _rutenettStart = 7;
    private const double _rutenettSlutt = 15;
    private static double RutenettHoydePxStandard => (_rutenettSlutt - _rutenettStart) * TimeHoydePx;

    // Høyden på hver enkelt ansatts rad (i samme rekkefølge som _ansatte). Er normalt
    // RutenettHoydePxStandard delt på antall ansatte, men utvides automatisk (i LastAsync) - per
    // ansatt, uavhengig av de andre - hvis vedkommende har så mange etiketter på én dag at de
    // ellers ikke ville fått plass med lesbar tittel og klokkeslett.
    private List<double> _bandHoyder = [];
    private double RutenettHoydePx => _bandHoyder.Sum();

    private static string PxTekst(double verdi) => verdi.ToString("0.##", CultureInfo.InvariantCulture) + "px";
    private static string ProsentTekst(double verdi) => verdi.ToString("0.###", CultureInfo.InvariantCulture) + "%";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private DateTime _visningsUke = FinnMandag(DateTime.Today);
    private List<AnsattOption> _ansatte = [];
    private Dictionary<int, string> _fargekart = [];
    private List<DagRad> _dager = [];
    private bool _laster = true;

    private DateTime? _redigeringDato;
    private int? _redigeringId;
    private string _formTittel = "";
    private int? _formAnsattId;
    private TimeOnly? _formFra = new(7, 0);
    private TimeOnly? _formTil = new(15, 0);
    private string _formInfo = "";
    private string? _feilmelding;
    private int? _draggingBoksId;

    private string UkeTekst()
    {
        var slutt = _visningsUke.AddDays(6);
        var uke = ISOWeek.GetWeekOfYear(_visningsUke);
        return $"Uke {uke} ({_visningsUke:dd.MM}–{slutt:dd.MM.yyyy})";
    }

    private string FargeForAnsatt(int ansattId) => _fargekart.GetValueOrDefault(ansattId, "#6b6b63");

    private int AnsattBaandIndex(int ansattId)
    {
        var index = _ansatte.FindIndex(a => a.Id == ansattId);
        return index < 0 ? 0 : index;
    }

    private double AnsattBandHoydePx(int ansattId)
    {
        var index = AnsattBaandIndex(ansattId);
        return index < _bandHoyder.Count ? _bandHoyder[index] : RutenettHoydePxStandard / Math.Max(_ansatte.Count, 1);
    }

    private double AnsattBandTopPx(int ansattId)
    {
        var index = AnsattBaandIndex(ansattId);
        var sum = 0.0;
        for (var i = 0; i < index && i < _bandHoyder.Count; i++)
        {
            sum += _bandHoyder[i];
        }

        return sum;
    }

    private static string DagKolonneId(DateTime dato) => $"ressurs-dagkolonne-{dato:yyyyMMdd}";

    // Bygger en CSS-gradient med skillelinjer ved grensene mellom hver ansatts rad (radene kan ha
    // ulik høyde), slik at det ser ut som horisontale streker som går hele veien over dagkolonnen.
    private string BandDelelinjerBakgrunn()
    {
        if (_bandHoyder.Count <= 1)
        {
            return "none";
        }

        var deler = new List<string>();
        var cum = 0.0;
        for (var i = 0; i < _bandHoyder.Count - 1; i++)
        {
            cum += _bandHoyder[i];
            deler.Add($"transparent {PxTekst(cum)}");
            deler.Add($"var(--itlock-border) {PxTekst(cum)}");
            deler.Add($"var(--itlock-border) {PxTekst(cum + 1)}");
            deler.Add($"transparent {PxTekst(cum + 1)}");
        }

        return $"linear-gradient(to bottom, transparent, {string.Join(", ", deler)})";
    }

    // Naturlig (proporsjonal) høyde i piksler for et tidsrom, gitt en tilgjengelig høyde å
    // fordele 07:00-15:00 over.
    private static double NaturligHoyde(double timer, double tilgjengeligHoydePx) =>
        timer / (_rutenettSlutt - _rutenettStart) * tilgjengeligHoydePx;

    // Sjekker om klyngene (tidsrommene til hver "gruppe" av etiketter) får plass til minstehøyde
    // innenfor en rad på gitt bandHoydePx, ved å låne plass fra ledig tid mellom klyngene. Det
    // reserveres alltid et lite fast mellomrom mellom hver klynge, slik at nabo-etiketter aldri
    // henger sammen visuelt selv om de ligger inntil hverandre i tid.
    private static bool KlyngerPasserInnenfor(List<(double Fra, double Til)> spenn, double bandHoydePx)
    {
        var tilgjengelig = bandHoydePx - 2 * BoksPaddingPx - (spenn.Count - 1) * BoksMellomromPx;
        if (tilgjengelig <= 0)
        {
            return false;
        }

        double sumNaturlig = 0, sumMangler = 0;
        foreach (var (fra, til) in spenn)
        {
            var naturlig = NaturligHoyde(til - fra, tilgjengelig);
            sumNaturlig += naturlig;
            sumMangler += Math.Max(0, MinBoksHoydePx - naturlig);
        }

        var ledigTid = tilgjengelig - sumNaturlig;
        return sumMangler <= ledigTid + 0.01;
    }

    // Finner minste radhøyde (>= standardhøyden) der alle klynger i uken får plass til
    // minstehøyde. Vokser med binærsøk siden "får plass"-sjekken er monoton i radhøyde.
    private static double FinnBandHoyde(double standardHoyde, List<List<(double Fra, double Til)>> alleSpenn)
    {
        bool AllePasser(double bandHoydePx) => alleSpenn.All(spenn => KlyngerPasserInnenfor(spenn, bandHoydePx));

        if (AllePasser(standardHoyde))
        {
            return standardHoyde;
        }

        var lo = standardHoyde;
        var hi = standardHoyde;
        for (var i = 0; i < 50 && !AllePasser(hi); i++)
        {
            hi *= 2;
        }

        for (var i = 0; i < 40; i++)
        {
            var mid = (lo + hi) / 2;
            if (AllePasser(mid)) hi = mid; else lo = mid;
        }

        return hi;
    }

    // Plasserer klyngene til én ansatt på én dag sekvensielt innenfor radens høyde: hver klynge
    // får minst MinBoksHoydePx, og eventuell ledig tid mellom klyngene krympes proporsjonalt for
    // å gi plass. Etiketter i samme klynge (tidsoverlapp) deler klyngens plass proporsjonalt.
    private static void PlasserKlynger(List<List<BoksRad>> klynger, double bandTopPx, double bandHoydePx)
    {
        if (klynger.Count == 0)
        {
            return;
        }

        var tilgjengelig = bandHoydePx - 2 * BoksPaddingPx - (klynger.Count - 1) * BoksMellomromPx;

        var spenn = klynger.Select(k => (Fra: k.Min(b => b.Fra.TotalHours), Til: k.Max(b => b.Til.TotalHours))).ToList();
        var naturligHoyder = spenn.Select(s => NaturligHoyde(s.Til - s.Fra, tilgjengelig)).ToList();
        var krevdHoyder = naturligHoyder.Select(n => Math.Max(n, MinBoksHoydePx)).ToList();

        var mellomromTimer = new List<double> { spenn[0].Fra - _rutenettStart };
        for (var i = 0; i < spenn.Count - 1; i++)
        {
            mellomromTimer.Add(spenn[i + 1].Fra - spenn[i].Til);
        }
        mellomromTimer.Add(_rutenettSlutt - spenn[^1].Til);

        var mellomromPx = mellomromTimer.Select(t => NaturligHoyde(Math.Max(t, 0), tilgjengelig)).ToList();
        var sumMellomromPx = mellomromPx.Sum();
        var sumEkstraBehov = naturligHoyder.Zip(krevdHoyder, (n, k) => k - n).Sum();
        var krympefaktor = sumMellomromPx > 0.01 ? Math.Clamp((sumMellomromPx - sumEkstraBehov) / sumMellomromPx, 0, 1) : 0;

        var pos = bandTopPx + BoksPaddingPx + mellomromPx[0] * krympefaktor;
        for (var i = 0; i < klynger.Count; i++)
        {
            var top = pos;
            var hoyde = krevdHoyder[i];
            var (kFra, kTil) = spenn[i];
            var kVarighet = kTil - kFra;

            foreach (var boks in klynger[i])
            {
                if (kVarighet <= 0.001)
                {
                    boks.TopPx = top;
                    boks.HoydePx = hoyde;
                }
                else
                {
                    var fraProsent = (boks.Fra.TotalHours - kFra) / kVarighet;
                    var tilProsent = (boks.Til.TotalHours - kFra) / kVarighet;
                    boks.TopPx = top + fraProsent * hoyde;
                    boks.HoydePx = Math.Max((tilProsent - fraProsent) * hoyde, 4);
                }
            }

            pos += hoyde;
            if (i < klynger.Count - 1)
            {
                pos += BoksMellomromPx + mellomromPx[i + 1] * krympefaktor;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }
        }

        _ansatte = await Db.Brukere
            .Where(b => b.Aktiv)
            .OrderBy(a => a.Navn)
            .Select(a => new AnsattOption { Id = a.Id, Navn = a.Navn })
            .ToListAsync();
        _fargekart = AnsattFarge.Bygg(_ansatte.Select(a => a.Id));

        await LastAsync();
    }

    private async Task ForrigeUke()
    {
        _visningsUke = _visningsUke.AddDays(-7);
        await LastAsync();
    }

    private async Task NesteUke()
    {
        _visningsUke = _visningsUke.AddDays(7);
        await LastAsync();
    }

    private async Task GaTilIDag()
    {
        _visningsUke = FinnMandag(DateTime.Today);
        await LastAsync();
    }

    private void StartNy(DateTime dato)
    {
        _redigeringDato = dato;
        _redigeringId = null;
        _formTittel = "";
        _formAnsattId = null;
        _formFra = new TimeOnly(7, 0);
        _formTil = new TimeOnly(15, 0);
        _formInfo = "";
        _feilmelding = null;
    }

    private void StartRediger(BoksRad boks)
    {
        _redigeringDato = _dager.First(d => d.Boxer.Contains(boks)).Dato;
        _redigeringId = boks.Id;
        _formTittel = boks.Tittel;
        _formAnsattId = boks.AnsattId;
        _formFra = TimeOnly.FromTimeSpan(boks.Fra);
        _formTil = TimeOnly.FromTimeSpan(boks.Til);
        _formInfo = boks.Info;
        _feilmelding = null;
    }

    private void AvbrytRedigering()
    {
        _redigeringDato = null;
        _redigeringId = null;
        _formTittel = "";
        _formAnsattId = null;
        _formInfo = "";
        _feilmelding = null;
    }

    private async Task Lagre()
    {
        if (_redigeringDato is null || string.IsNullOrWhiteSpace(_formTittel) || _formAnsattId is null || _formFra is null || _formTil is null)
        {
            _feilmelding = "Fyll ut tittel, ansatt og fra/til-klokkeslett.";
            return;
        }

        if (_formTil.Value <= _formFra.Value)
        {
            _feilmelding = "Til-klokkeslett må være etter fra-klokkeslett.";
            return;
        }

        if (_redigeringId is null)
        {
            Db.Ressursplaner.Add(new Ressursplan
            {
                Dato = _redigeringDato.Value,
                MontorId = _formAnsattId.Value,
                Tittel = _formTittel.Trim(),
                Info = _formInfo.Trim(),
                Fra = _formFra.Value.ToTimeSpan(),
                Til = _formTil.Value.ToTimeSpan(),
                OpprettetAvBrukerId = _naverendeBrukerId
            });
        }
        else
        {
            var eksisterende = await Db.Ressursplaner.FindAsync(_redigeringId.Value);
            if (eksisterende is not null)
            {
                eksisterende.MontorId = _formAnsattId.Value;
                eksisterende.Tittel = _formTittel.Trim();
                eksisterende.Info = _formInfo.Trim();
                eksisterende.Fra = _formFra.Value.ToTimeSpan();
                eksisterende.Til = _formTil.Value.ToTimeSpan();
            }
        }

        await Db.SaveChangesAsync();
        AvbrytRedigering();
        await LastAsync();
    }

    private async Task Slett()
    {
        if (_redigeringId is null)
        {
            return;
        }

        var eksisterende = await Db.Ressursplaner.FindAsync(_redigeringId.Value);
        if (eksisterende is not null)
        {
            Db.Ressursplaner.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        AvbrytRedigering();
        await LastAsync();
    }

    // Flytter den dragede etiketten til dagen/ansatten/klokkeslettet den slippes på. Klokkeslettet
    // regnes ut fra museposisjonen (via JS for nøyaktig Y relativt til dagkolonnen), avrundet til
    // nærmeste kvarter, og varigheten på etiketten beholdes.
    private async Task SlippBoks(DateTime dato, DragEventArgs e)
    {
        if (_draggingBoksId is null)
        {
            return;
        }

        var boksId = _draggingBoksId.Value;
        _draggingBoksId = null;

        var eksisterende = await Db.Ressursplaner.FindAsync(boksId);
        if (eksisterende is null)
        {
            return;
        }

        var relativY = await JS.InvokeAsync<double>("ressursplanlegger.relativY", DagKolonneId(dato), e.ClientY);
        var ansattId = FinnAnsattForY(relativY);
        if (ansattId is null)
        {
            return;
        }

        var bandTopPx = AnsattBandTopPx(ansattId.Value);
        var bandHoydePx = AnsattBandHoydePx(ansattId.Value);
        var tilgjengelig = bandHoydePx - 2 * BoksPaddingPx;
        var brokAvBand = tilgjengelig > 0 ? Math.Clamp((relativY - bandTopPx - BoksPaddingPx) / tilgjengelig, 0, 1) : 0;
        var klokkeTimer = _rutenettStart + brokAvBand * (_rutenettSlutt - _rutenettStart);
        klokkeTimer = Math.Round(klokkeTimer * 4, MidpointRounding.AwayFromZero) / 4;

        var varighetTimer = (eksisterende.Til - eksisterende.Fra).TotalHours;
        var nyFraTimer = Math.Clamp(klokkeTimer, _rutenettStart, _rutenettSlutt - varighetTimer);

        eksisterende.Dato = dato;
        eksisterende.MontorId = ansattId.Value;
        eksisterende.Fra = TimeSpan.FromHours(nyFraTimer);
        eksisterende.Til = TimeSpan.FromHours(nyFraTimer + varighetTimer);

        await Db.SaveChangesAsync();
        await LastAsync();
    }

    private int? FinnAnsattForY(double y)
    {
        var cum = 0.0;
        for (var i = 0; i < _ansatte.Count && i < _bandHoyder.Count; i++)
        {
            cum += _bandHoyder[i];
            if (y <= cum)
            {
                return _ansatte[i].Id;
            }
        }

        return _ansatte.Count > 0 ? _ansatte[^1].Id : null;
    }

    private async Task LastAsync()
    {
        _laster = true;

        var forsteIUke = _visningsUke;
        var sisteIUke = _visningsUke.AddDays(6);

        var boxer = await Db.Ressursplaner
            .Where(r => r.Dato >= forsteIUke && r.Dato <= sisteIUke)
            .ToListAsync();

        var boxerPerDag = boxer
            .GroupBy(r => r.Dato.Date)
            .ToDictionary(g => g.Key, g => g
                .Select(r => new BoksRad { Id = r.Id, AnsattId = r.MontorId, Tittel = r.Tittel, Info = r.Info, Fra = r.Fra, Til = r.Til })
                .OrderBy(b => b.Fra)
                .ToList());

        // Klynger (tidsoverlappende etiketter) per (dag, ansatt) - brukes både til sidestilling
        // ved tidsoverlapp (TildelBaner) og til å regne ut nødvendig radhøyde og plassering.
        var klyngerPerDagOgAnsatt = boxerPerDag.ToDictionary(
            dagPar => dagPar.Key,
            dagPar => dagPar.Value
                .GroupBy(b => b.AnsattId)
                .ToDictionary(g => g.Key, g => TildelBaner(g.ToList())));

        var standardBandHoyde = RutenettHoydePxStandard / Math.Max(_ansatte.Count, 1);
        _bandHoyder = _ansatte
            .Select(a =>
            {
                var spennForAnsatt = klyngerPerDagOgAnsatt.Values
                    .Select(perAnsatt => perAnsatt.GetValueOrDefault(a.Id))
                    .Where(klynger => klynger is { Count: > 0 })
                    .Select(klynger => klynger!.Select(k => (Fra: k.Min(b => b.Fra.TotalHours), Til: k.Max(b => b.Til.TotalHours))).ToList())
                    .ToList();
                return FinnBandHoyde(standardBandHoyde, spennForAnsatt);
            })
            .ToList();

        foreach (var perAnsatt in klyngerPerDagOgAnsatt.Values)
        {
            foreach (var (ansattId, klynger) in perAnsatt)
            {
                PlasserKlynger(klynger, AnsattBandTopPx(ansattId), AnsattBandHoydePx(ansattId));
            }
        }

        var dager = new List<DagRad>();
        for (var dato = forsteIUke; dato <= sisteIUke; dato = dato.AddDays(1))
        {
            dager.Add(new DagRad
            {
                Dato = dato,
                Boxer = boxerPerDag.GetValueOrDefault(dato, [])
            });
        }

        _dager = dager;
        _laster = false;
    }

    // Grupperer etiketter som overlapper i tid til klynger, og gir hver etikett en bane
    // (BaneIndex/BaneAntall) slik at overlappende etiketter (f.eks. to montører samtidig)
    // vises ved siden av hverandre i stedet for oppå hverandre. Returnerer klyngene slik at
    // de også kan brukes til å regne ut nødvendig radhøyde og plassering.
    private static List<List<BoksRad>> TildelBaner(List<BoksRad> boxerSortertEtterFra)
    {
        var klynger = new List<List<BoksRad>>();
        List<BoksRad>? gjeldendeKlynge = null;
        var klyngeSluttMaks = TimeSpan.Zero;

        foreach (var boks in boxerSortertEtterFra)
        {
            if (gjeldendeKlynge is null || boks.Fra >= klyngeSluttMaks)
            {
                gjeldendeKlynge = [];
                klynger.Add(gjeldendeKlynge);
                klyngeSluttMaks = boks.Til;
            }
            else if (boks.Til > klyngeSluttMaks)
            {
                klyngeSluttMaks = boks.Til;
            }

            gjeldendeKlynge.Add(boks);
        }

        foreach (var klynge in klynger)
        {
            var baneSluttider = new List<TimeSpan>();
            foreach (var boks in klynge)
            {
                var baneIndex = baneSluttider.FindIndex(slutt => slutt <= boks.Fra);
                if (baneIndex == -1)
                {
                    baneSluttider.Add(boks.Til);
                    baneIndex = baneSluttider.Count - 1;
                }
                else
                {
                    baneSluttider[baneIndex] = boks.Til;
                }

                boks.BaneIndex = baneIndex;
            }

            foreach (var boks in klynge)
            {
                boks.BaneAntall = baneSluttider.Count;
            }
        }

        return klynger;
    }

    private static DateTime FinnMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }
}
