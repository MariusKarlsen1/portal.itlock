@page "/ressursplanlegger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Ressursplanlegger</PageTitle>

<h1>Ressursplanlegger</h1>
<p class="section-hint">
    Sett av ansatte på dager fremover - uavhengig av om det finnes en arbeidsordre ennå. Dobbeltklikk på en dag for
    å legge til en etikett med klokkeslett. Etikettene vises også i den ansattes egen kalender.
</p>

<div class="kalender-verktoylinje">
    <div class="kalender-nav">
        <button type="button" class="cancel-button" @onclick="ForrigeUke">&larr;</button>
        <span class="kalender-manednavn">@UkeTekst()</span>
        <button type="button" class="cancel-button" @onclick="NesteUke">&rarr;</button>
    </div>
    <button type="button" class="cancel-button" @onclick="GaTilIDag">I dag</button>
</div>

@if (_redigeringDato is not null)
{
    <div class="ressurs-modal-overlay">
        <div class="ressurs-modal boks-panel">
            <h2>@(_redigeringId is null ? "Ny etikett" : "Rediger etikett") - @_redigeringDato.Value.ToString("dd.MM.yyyy")</h2>
            <div class="field-grid">
                <label class="span-2">
                    Tittel
                    <input type="text" @bind="_formTittel" placeholder="F.eks. Befaring hos kunde A" />
                </label>
                <label>
                    Ansatt
                    <select @bind="_formAnsattId">
                        <option value="">Velg ansatt...</option>
                        @foreach (var a in _ansatte)
                        {
                            <option value="@a.Id">@a.Navn</option>
                        }
                    </select>
                </label>
                <label>
                    Fra
                    <input type="time" @bind="_formFra" />
                </label>
                <label>
                    Til
                    <input type="time" @bind="_formTil" />
                </label>
                <label class="span-2">
                    Beskrivelse
                    <textarea rows="3" @bind="_formInfo" placeholder="Mer detaljert beskrivelse - vises først når etiketten åpnes"></textarea>
                </label>
            </div>
            @if (!string.IsNullOrEmpty(_feilmelding))
            {
                <p class="form-error">@_feilmelding</p>
            }
            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (_redigeringId is not null)
                {
                    <button type="button" class="remove-button" @onclick="Slett">Slett</button>
                }
                <button type="button" class="cancel-button" @onclick="AvbrytRedigering">Avbryt</button>
            </div>
        </div>
    </div>
}

@if (_laster)
{
    <p class="list-empty">Laster...</p>
}
else
{
    <div class="ressurs-layout">
        <div class="ressurs-kalender">
            <div class="kalender-ukedager">
                @foreach (var dagnavn in Ukedagnavn)
                {
                    <div class="kalender-ukedag">@dagnavn</div>
                }
            </div>

            <div class="kalender-grid kalender-grid-uke">
                @foreach (var dag in _dager)
                {
                    var helligdag = NorskHelligdag.Navn(dag.Dato);
                    <div class="kalender-dag kalender-dag-uke @(dag.Dato == DateTime.Today ? "kalender-dag-idag" : "") @(helligdag is not null || NorskHelligdag.ErSondag(dag.Dato) ? "kalender-dag-rod" : "")"
                         @ondblclick="@(() => StartNy(dag.Dato))">
                        <span class="kalender-dagnummer">@dag.Dato.ToString("ddd dd.MM", Kultur)</span>
                        @if (helligdag is not null)
                        {
                            <span class="kalender-helligdag">@helligdag</span>
                        }
                        @foreach (var boks in dag.Boxer.OrderBy(b => b.Fra))
                        {
                            <button type="button" class="ressurs-boks" style="--montor-farge: @FargeForAnsatt(boks.AnsattId)" @onclick="@(() => StartRediger(boks))">
                                <span class="ressurs-boks-tittel">@boks.Tittel</span>
                                <span class="ressurs-boks-tid">@boks.Fra.ToString(@"hh\:mm")&ndash;@boks.Til.ToString(@"hh\:mm")</span>
                                <span class="ressurs-boks-montor">@boks.AnsattNavn</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="ressurs-medlemmer">
            <h2>Medlemmer</h2>
            <ul class="medlem-liste">
                @foreach (var a in _ansatte)
                {
                    <li>
                        <span class="medlem-farge" style="background: @FargeForAnsatt(a.Id)"></span>
                        @a.Navn
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private sealed class AnsattOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class BoksRad
    {
        public int Id { get; set; }
        public int AnsattId { get; set; }
        public string AnsattNavn { get; set; } = "";
        public string Tittel { get; set; } = "";
        public string Info { get; set; } = "";
        public TimeSpan Fra { get; set; }
        public TimeSpan Til { get; set; }
    }

    private sealed class DagRad
    {
        public required DateTime Dato { get; set; }
        public List<BoksRad> Boxer { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Ukedagnavn = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private DateTime _visningsUke = FinnMandag(DateTime.Today);
    private List<AnsattOption> _ansatte = [];
    private Dictionary<int, string> _fargekart = [];
    private List<DagRad> _dager = [];
    private bool _laster = true;

    private DateTime? _redigeringDato;
    private int? _redigeringId;
    private string _formTittel = "";
    private int? _formAnsattId;
    private TimeOnly? _formFra = new(7, 0);
    private TimeOnly? _formTil = new(15, 0);
    private string _formInfo = "";
    private string? _feilmelding;

    private string UkeTekst()
    {
        var slutt = _visningsUke.AddDays(6);
        var uke = ISOWeek.GetWeekOfYear(_visningsUke);
        return $"Uke {uke} ({_visningsUke:dd.MM}–{slutt:dd.MM.yyyy})";
    }

    private string FargeForAnsatt(int ansattId) => _fargekart.GetValueOrDefault(ansattId, "#6b6b63");

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }
        }

        _ansatte = await Db.Brukere
            .Where(b => b.Aktiv)
            .OrderBy(a => a.Navn)
            .Select(a => new AnsattOption { Id = a.Id, Navn = a.Navn })
            .ToListAsync();
        _fargekart = AnsattFarge.Bygg(_ansatte.Select(a => a.Id));

        await LastAsync();
    }

    private async Task ForrigeUke()
    {
        _visningsUke = _visningsUke.AddDays(-7);
        await LastAsync();
    }

    private async Task NesteUke()
    {
        _visningsUke = _visningsUke.AddDays(7);
        await LastAsync();
    }

    private async Task GaTilIDag()
    {
        _visningsUke = FinnMandag(DateTime.Today);
        await LastAsync();
    }

    private void StartNy(DateTime dato)
    {
        _redigeringDato = dato;
        _redigeringId = null;
        _formTittel = "";
        _formAnsattId = null;
        _formFra = new TimeOnly(7, 0);
        _formTil = new TimeOnly(15, 0);
        _formInfo = "";
        _feilmelding = null;
    }

    private void StartRediger(BoksRad boks)
    {
        _redigeringDato = _dager.First(d => d.Boxer.Contains(boks)).Dato;
        _redigeringId = boks.Id;
        _formTittel = boks.Tittel;
        _formAnsattId = boks.AnsattId;
        _formFra = TimeOnly.FromTimeSpan(boks.Fra);
        _formTil = TimeOnly.FromTimeSpan(boks.Til);
        _formInfo = boks.Info;
        _feilmelding = null;
    }

    private void AvbrytRedigering()
    {
        _redigeringDato = null;
        _redigeringId = null;
        _formTittel = "";
        _formAnsattId = null;
        _formInfo = "";
        _feilmelding = null;
    }

    private async Task Lagre()
    {
        if (_redigeringDato is null || string.IsNullOrWhiteSpace(_formTittel) || _formAnsattId is null || _formFra is null || _formTil is null)
        {
            _feilmelding = "Fyll ut tittel, ansatt og fra/til-klokkeslett.";
            return;
        }

        if (_formTil.Value <= _formFra.Value)
        {
            _feilmelding = "Til-klokkeslett må være etter fra-klokkeslett.";
            return;
        }

        if (_redigeringId is null)
        {
            Db.Ressursplaner.Add(new Ressursplan
            {
                Dato = _redigeringDato.Value,
                MontorId = _formAnsattId.Value,
                Tittel = _formTittel.Trim(),
                Info = _formInfo.Trim(),
                Fra = _formFra.Value.ToTimeSpan(),
                Til = _formTil.Value.ToTimeSpan(),
                OpprettetAvBrukerId = _naverendeBrukerId
            });
        }
        else
        {
            var eksisterende = await Db.Ressursplaner.FindAsync(_redigeringId.Value);
            if (eksisterende is not null)
            {
                eksisterende.MontorId = _formAnsattId.Value;
                eksisterende.Tittel = _formTittel.Trim();
                eksisterende.Info = _formInfo.Trim();
                eksisterende.Fra = _formFra.Value.ToTimeSpan();
                eksisterende.Til = _formTil.Value.ToTimeSpan();
            }
        }

        await Db.SaveChangesAsync();
        AvbrytRedigering();
        await LastAsync();
    }

    private async Task Slett()
    {
        if (_redigeringId is null)
        {
            return;
        }

        var eksisterende = await Db.Ressursplaner.FindAsync(_redigeringId.Value);
        if (eksisterende is not null)
        {
            Db.Ressursplaner.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        AvbrytRedigering();
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _laster = true;

        var forsteIUke = _visningsUke;
        var sisteIUke = _visningsUke.AddDays(6);

        var boxer = await Db.Ressursplaner
            .Include(r => r.Montor)
            .Where(r => r.Dato >= forsteIUke && r.Dato <= sisteIUke)
            .ToListAsync();

        var boxerPerDag = boxer
            .GroupBy(r => r.Dato.Date)
            .ToDictionary(g => g.Key, g => g
                .Select(r => new BoksRad { Id = r.Id, AnsattId = r.MontorId, AnsattNavn = r.Montor?.Navn ?? "?", Tittel = r.Tittel, Info = r.Info, Fra = r.Fra, Til = r.Til })
                .ToList());

        var dager = new List<DagRad>();
        for (var dato = forsteIUke; dato <= sisteIUke; dato = dato.AddDays(1))
        {
            dager.Add(new DagRad
            {
                Dato = dato,
                Boxer = boxerPerDag.GetValueOrDefault(dato, [])
            });
        }

        _dager = dager;
        _laster = false;
    }

    private static DateTime FinnMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }
}
