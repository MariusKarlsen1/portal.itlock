    // ======================================================================
    // Innlesing av ordrebekreftelser og pakksedler (DokumentTolkService)
    // ======================================================================
    private bool _leser;
    private Dictionary<int, Component> _ordreVarer = [];
    private DokumentTolkService.TolketDokument? _obInnlest;
    private int? _obInnlestOrdreId;
    private List<DokumentTolkService.Kobling> _obKoblinger = [];
    private (byte[] Data, string Navn, string Type)? _obInnlestFil;

    // Pakkseddel og avkryssing i varemottaket.
    private Dictionary<int, int> _pakkseddel = [];
    private HashSet<int> _kontrollert = [];
    private List<DokumentTolkService.TolketLinje> _pakkseddelEkstra = [];
    private string? _pakkseddelInfo;

    private List<Innkjopsordre> ObKandidater => _ordrer
        .Where(o => o.Status is InnkjopStatus.Sendt or InnkjopStatus.Avvik or InnkjopStatus.Bekreftet or InnkjopStatus.DelvisMottatt).ToList();

    private async Task LastOrdreVarerAsync()
    {
        var ider = _ordrer.SelectMany(o => o.Linjer).Select(l => l.ComponentId).Distinct().ToList();
        _ordreVarer = await Db.Components.AsNoTracking().Where(c => ider.Contains(c.Id))
            .Select(c => new Component { Id = c.Id, Navn = c.Navn, Gtin = c.Gtin, Produktkode = c.Produktkode })
            .ToDictionaryAsync(c => c.Id);
    }

    private async Task<(byte[] Data, string Navn, string Type)?> LesFilAsync(InputFileChangeEventArgs e)
    {
        const long maks = 15 * 1024 * 1024;
        if (e.File.Size > maks)
        {
            _melding = "Filen er større enn 15 MB.";
            return null;
        }

        using var ms = new MemoryStream();
        await e.File.OpenReadStream(maks).CopyToAsync(ms);
        var type = string.IsNullOrWhiteSpace(e.File.ContentType)
            ? (e.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "application/pdf" : "application/octet-stream")
            : e.File.ContentType;
        return (ms.ToArray(), e.File.Name, type);
    }

    private async Task LagreFilAsync(Innkjopsordre o, (byte[] Data, string Navn, string Type) fil, string type)
    {
        var rad = new InnkjopsordreFil { InnkjopsordreId = o.Id, Filnavn = fil.Navn, ContentType = fil.Type, Data = fil.Data, Type = type };
        Db.InnkjopsordreFiler.Add(rad);
        if (type == DokumentTolkService.Ordrebekreftelse)
        {
            o.ObFilnavn = fil.Navn;
        }

        await Db.SaveChangesAsync();
        Db.Entry(rad).State = EntityState.Detached;
    }

    // Fyller bekreftet antall/pris/levering fra dokumentet inn på ordren.
    private static int FyllInnBekreftelse(Innkjopsordre o, DokumentTolkService.TolketDokument d, List<DokumentTolkService.Kobling> koblinger)
    {
        if (d.LeverandorOrdrenr is { } nr)
        {
            o.LeverandorOrdrenr = nr;
        }

        var fylt = 0;
        foreach (var k in koblinger.Where(k => k.Linje is not null))
        {
            var l = k.Linje!;
            l.BekreftetAntall = k.Dokument.Antall ?? l.Antall;
            l.BekreftetPris = k.Dokument.Enhetspris ?? l.Pris;
            l.BekreftetLevering = k.Dokument.Leveringsdato ?? d.Leveringsdato ?? l.BekreftetLevering;
            fylt++;
        }

        return fylt;
    }

    // --- Fra listen: last inn en bekreftelse, finn bestillingen selv ---
    private async Task LesInnOb(InputFileChangeEventArgs e)
    {
        if (await LesFilAsync(e) is not { } fil)
        {
            return;
        }

        _leser = true;
        _obInnlest = null;
        StateHasChanged();
        var kandidater = ObKandidater;
        var d = await TolkSvc.TolkAsync(fil.Data, fil.Type, fil.Navn, DokumentTolkService.Ordrebekreftelse, kandidater, _ordreVarer);
        _leser = false;
        if (d.Linjer.Count == 0)
        {
            _melding = d.Feil ?? "Fant ingen varelinjer i dokumentet.";
            return;
        }

        _obInnlest = d;
        _obInnlestFil = fil;
        var ordre = DokumentTolkService.FinnOrdre(d, fil.Navn, kandidater, _ordreVarer);
        VelgInnlestOrdre(ordre?.Id);
    }

    private void VelgInnlestOrdre(int? id)
    {
        _obInnlestOrdreId = id;
        _obKoblinger = id is { } i && _ordrer.FirstOrDefault(o => o.Id == i) is { } ordre && _obInnlest is { } d
            ? DokumentTolkService.Koble(ordre, d, _ordreVarer)
            : [];
    }

    private async Task RegistrerInnlest()
    {
        if (_obInnlest is not { } d || _obInnlestFil is not { } fil || _ordrer.FirstOrDefault(o => o.Id == _obInnlestOrdreId) is not { } o)
        {
            return;
        }

        await LagreFilAsync(o, fil, DokumentTolkService.Ordrebekreftelse);
        var fylt = FyllInnBekreftelse(o, d, _obKoblinger);
        var avvik = await InnkjopSvc.RegistrerBekreftelseAsync(o, _brukerNavn);
        _obInnlest = null;
        _obInnlestFil = null;
        await LastAsync();
        ApneOrdre(o.Id, "ob");
        _melding = $"Ordrebekreftelsen er lest inn på {o.Visningsnummer} ({fylt} av {o.Linjer.Count} linjer). "
            + (avvik ? "Den har avvik - se over og godkjenn." : "Alt stemmer med bestillingen, og ordren er bekreftet.");
    }

    // --- Inne på én ordre: last opp og fyll ut feltene ---
    private async Task LastOppOb(Innkjopsordre o, InputFileChangeEventArgs e)
    {
        if (await LesFilAsync(e) is not { } fil)
        {
            return;
        }

        await LagreFilAsync(o, fil, DokumentTolkService.Ordrebekreftelse);
        _leser = true;
        StateHasChanged();
        var d = await TolkSvc.TolkAsync(fil.Data, fil.Type, fil.Navn, DokumentTolkService.Ordrebekreftelse, [o], _ordreVarer);
        _leser = false;
        if (d.Linjer.Count == 0)
        {
            _melding = $"{fil.Navn} er lagt ved. " + (d.Feil ?? "Fant ingen varelinjer å fylle inn.");
            return;
        }

        var koblinger = DokumentTolkService.Koble(o, d, _ordreVarer);
        var fylt = FyllInnBekreftelse(o, d, koblinger);
        var ukjente = koblinger.Count(k => k.Linje is null);
        _melding = $"{fil.Navn} er lest inn: {fylt} av {o.Linjer.Count} linjer er fylt ut"
            + (ukjente > 0 ? $", {ukjente} linjer i bekreftelsen fant vi ikke på bestillingen" : "")
            + ". Se over og trykk «Lagre bekreftelse»." + (d.Simulert ? " (Simulert innlesing i demo.)" : "");
    }

    // --- Varemottak: les inn pakkseddelen og huk av ---
    private async Task LesInnPakkseddel(Innkjopsordre o, InputFileChangeEventArgs e)
    {
        if (await LesFilAsync(e) is not { } fil)
        {
            return;
        }

        await LagreFilAsync(o, fil, DokumentTolkService.Pakkseddel);
        _leser = true;
        StateHasChanged();
        var d = await TolkSvc.TolkAsync(fil.Data, fil.Type, fil.Navn, DokumentTolkService.Pakkseddel, [o], _ordreVarer);
        _leser = false;
        if (d.Linjer.Count == 0)
        {
            _melding = $"{fil.Navn} er lagt ved. " + (d.Feil ?? "Fant ingen varelinjer på pakkseddelen.");
            return;
        }

        var koblinger = DokumentTolkService.Koble(o, d, _ordreVarer);
        _pakkseddel.Clear();
        _kontrollert.Clear();
        foreach (var l in o.Linjer.Where(l => l.Rest > 0))
        {
            var antall = koblinger.Where(k => k.Linje?.Id == l.Id).Sum(k => k.Dokument.Antall ?? 0);
            _pakkseddel[l.Id] = antall;
            _mottak[l.Id] = Math.Clamp(antall, 0, l.Rest);
        }

        _pakkseddelEkstra = koblinger.Where(k => k.Linje is null).Select(k => k.Dokument).ToList();
        _pakkseddelInfo = $"Pakkseddel {d.Dokumentnummer ?? fil.Navn}" + (d.Simulert ? " (simulert innlesing i demo)" : "");
        _mottakNotat = d.Dokumentnummer is { } nr ? $"Pakkseddel {nr}" : _mottakNotat;
        _melding = $"Pakkseddelen er lest inn. Antallene er fylt ut fra den - tell opp og huk av hver linje som stemmer.";
    }

    private void Huk(InnkjopsordreLinje l)
    {
        if (!_kontrollert.Remove(l.Id))
        {
            _kontrollert.Add(l.Id);
        }
    }

    private void SkannMottak(Innkjopsordre o, KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_skann))
        {
            return;
        }

        var kode = _skann.Trim();
        _skann = "";
        static string N(string? s) => string.IsNullOrWhiteSpace(s) ? "" : new string(s.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();
        var treff = o.Linjer.Where(l => l.Rest > 0).FirstOrDefault(l => N(l.Varenummer) == N(kode)
            || (_ordreVarer.GetValueOrDefault(l.ComponentId) is { } c && (N(c.Gtin) == N(kode) || N(c.Produktkode) == N(kode))));
        if (treff is null)
        {
            _skannSvar = $"«{kode}» står ikke på denne bestillingen.";
            return;
        }

        if (_kontrollert.Add(treff.Id))
        {
            _mottak[treff.Id] = 1;
        }
        else
        {
            _mottak[treff.Id] = Math.Min(treff.Rest, MottakAntall(treff) + 1);
        }

        _skannSvar = $"✓ {treff.Navn}: {MottakAntall(treff)} av {treff.Rest}";
    }

    private void NullstillMottak()
    {
        _mottak.Clear();
        _kontrollert.Clear();
        _pakkseddel.Clear();
        _pakkseddelEkstra = [];
        _pakkseddelInfo = null;
        _skannSvar = null;
    }

