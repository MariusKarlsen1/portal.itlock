            </div>

            var plukket = _reservasjoner.Where(r => r.Plukket > 0 && r.PlukketLagerId != null).GroupBy(r => r.PlukketLagerId!.Value).ToList();
            @if (plukket.Count > 0)
            {
                <section class="lg-boks">
                    <div class="lg-boks-topp"><h3>Plukket - ute i biler og prosjektlager</h3></div>
                    @foreach (var g in plukket)
                    {
                        <div class="lg-lagerrad">
                            <span class="lg-lagerikon lg-type-@(_lagre.FirstOrDefault(l => l.Id == g.Key)?.Type.ToString().ToLowerInvariant())"><Icon Name="map-pin" /></span>
                            <span class="lg-lagerrad-tekst"><b>@LagerNavn(g.Key)</b><small>@string.Join(" · ", g.GroupBy(KildeNavn).Select(k => $"{k.Key}: {k.Sum(r => r.Plukket)} stk"))</small></span>
                            <b class="lg-tall">@Kr(g.Sum(r => r.Plukket * KostForBehov(r.ComponentId)))</b>
                        </div>
                    }
                </section>
            }
        }
    </div>;

    private RenderFragment PlukkDetalj(ReservasjonService.Behovskilde b) => @<div class="lg-fane">
        @{
            var linjer = KlarForPlukk(b.Kilde)
                .OrderBy(r => Hylle(r.ComponentId, r.LagerId) ?? "~").ThenBy(r => VareNavn(r.ComponentId)).ToList();
            var valgt = linjer.Sum(PlukkAntall);
        }
        <div class="lg-fane-topp">
            <span>
                <button type="button" class="lg-lenkeknapp lg-tilbake" @onclick="@(() => _plukkKilde = null)"><Icon Name="arrow-left" />Alle plukklister</button>
                <h2>Plukkliste – @b.Navn</h2>
                <p>@(b.Undertekst ?? "Prosjekt")@(b.Montasje is { } m ? $" · montasje {m:dd.MM.yyyy}" : "")</p>
            </span>
            <span class="lg-knapper">
                <button type="button" class="lg-knapp lg-knapp-s" @onclick="@(() => SettAllePlukk(b, true))">Alt plukket</button>
                <button type="button" class="lg-knapp lg-knapp-s" @onclick="@(() => SettAllePlukk(b, false))">Nullstill</button>
