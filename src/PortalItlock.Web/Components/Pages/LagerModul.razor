                <select class="lg-velg lg-hoyre" value="@(_obInnlestOrdreId ?? 0)" @onchange="@(e => VelgInnlestOrdre(int.TryParse(e.Value?.ToString(), out var i) && i > 0 ? i : null))" aria-label="Bestilling">
                    <option value="0">Velg bestilling …</option>
                    @foreach (var k in ObKandidater)
