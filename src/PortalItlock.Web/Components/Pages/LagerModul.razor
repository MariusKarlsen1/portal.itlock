                        {
                            <button type="button" class="lg-lenkeknapp" @onclick="@(() => ApneOverfor(null, lager.Id))">Overfør til bil</button>
                        }
                        <button type="button" class="lg-lenkeknapp lg-lenkeknapp-fare" @onclick="@(() => DeaktiverLager(lager))">Legg bort</button>
