        </div>

        @{
            var vareReservasjoner = _reservasjoner.Where(r => r.ComponentId == c.Id).ToList();
        }
        @if (vareReservasjoner.Count > 0)
        {
            <div class="lg-bestillinger">
                @foreach (var x in vareReservasjoner)
                {
                    var r = x;
                    var nokkel = r.ProsjektId is { } p ? $"p{p}" : $"a{r.ArbeidsordreId}";
                    <button type="button" class="lg-lagerrad lg-klikk lg-radknapp" @onclick="@(() => ApneKilde(nokkel))">
                        <span class="lg-lagerrad-tekst"><b>@KildeNavn(r)</b><small>@(r.Antall > 0 ? $"{r.Antall} reservert" : "")@(r.Antall > 0 && r.Venter > 0 ? " · " : "")@(r.Venter > 0 ? $"{r.Venter} venter på innkjøp" : "")</small></span>
                        <span class="lg-chip @(r.Venter > 0 ? "lg-chip-gul" : "lg-chip-lilla")">@(r.Venter > 0 ? "Venter" : "Reservert")</span>
                    </button>
                }
            </div>
        }

        @{
            var aapneLinjer = ApneOrdrer.Concat(_ordrer.Where(o => o.Status == InnkjopStatus.Utkast))
                .SelectMany(o => o.Linjer.Where(l => l.ComponentId == c.Id && l.Rest > 0).Select(l => (Ordre: o, Linje: l))).ToList();
        }
        @if (aapneLinjer.Count > 0)
        {
            <div class="lg-bestillinger">
                @foreach (var (ordre, linje) in aapneLinjer)
                {
                    var ordreId = ordre.Id;
                    <button type="button" class="lg-lagerrad lg-klikk lg-radknapp" @onclick="@(() => ApneOrdre(ordreId, "innkjop"))">
                        <span class="lg-lagerrad-tekst"><b>@ordre.Visningsnummer · @linje.Rest stk</b><small>@ordre.LeverandorNavn@((linje.BekreftetLevering ?? ordre.OnsketLevering) is { } d ? $" · levering {d:dd.MM}" : "")</small></span>
                        @StatusChip(ordre.Status)
                    </button>
                }
            </div>
        }

        <div class="lg-handlinger">
            <button type="button" class="lg-knapp lg-knapp-s @(_handling == "inn" ? "aktiv" : "")" @onclick="@(() => StartHandling("inn", c))"><Icon Name="plus" />Tilgang</button>
            <button type="button" class="lg-knapp lg-knapp-s @(_handling == "ut" ? "aktiv" : "")" @onclick="@(() => StartHandling("ut", c))"><Icon Name="minus" />Uttak</button>
            @if (AktiveLagre.Count() > 1)
            {
                <button type="button" class="lg-knapp lg-knapp-s @(_handling == "flytt" ? "aktiv" : "")" @onclick="@(() => StartHandling("flytt", c))"><Icon Name="arrow-right" />Flytt</button>
            }
            <button type="button" class="lg-knapp lg-knapp-s" title="Legg varen i en bestilling til leverandøren" @onclick="@(() => BestillVare(c))"><Icon Name="receipt" />Bestill</button>
        </div>

        @if (_handling is not null)
        {
            <div class="lg-handling">
                <label class="lg-felt">@(_handling == "flytt" ? "Fra lager" : "Lager")
                    <select @bind="_hLager">
                        @foreach (var l in AktiveLagre)
                        {
                            <option value="@l.Id">@l.Navn (@Antall(c.Id, l.Id))</option>
                        }
                    </select>
                </label>
                @if (_handling == "flytt")
                {
                    <label class="lg-felt">Til lager
                        <select @bind="_hTilLager">
                            @foreach (var l in AktiveLagre.Where(l => l.Id != _hLager))
                            {
                                <option value="@l.Id">@l.Navn</option>
                            }
                        </select>
                    </label>
                }
                <label class="lg-felt lg-felt-smal">Antall<input type="number" min="1" @bind="_hAntall" /></label>
                @if (_handling == "inn")
                {
                    <label class="lg-felt lg-felt-smal">Innpris per stk<input type="number" min="0" step="0.01" @bind="_hKost" /></label>
                }
                <label class="lg-felt lg-felt-bred">Notat<input @bind="_hNotat" placeholder="@(_handling == "ut" ? "F.eks. ødelagt, svinn …" : "Valgfritt")" /></label>
