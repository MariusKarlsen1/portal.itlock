        </div>

        <div class="lg-mottak">
            <label class="lg-sok lg-skann"><Icon Name="qr" /><input @bind="_skann" @bind:event="oninput" @onkeydown="@(e => Skann(b, e))" placeholder="Skann strekkode eller skriv varenummer og trykk Enter" /></label>
            @if (_skannSvar is not null)
            {
                <p class="lg-hint">@_skannSvar</p>
            }

            <div class="lg-mottak-liste">
                @foreach (var x in linjer)
                {
                    var r = x;
                    var maks = r.Antall - r.Plukket;
                    var antall = PlukkAntall(r);
                    var vare = _behovVarer.GetValueOrDefault(r.ComponentId);
                    <div class="lg-mottak-rad @(antall < maks ? "lg-mottak-mangler" : "")">
                        <span class="lg-hyllemerke">@(Hylle(r.ComponentId, r.LagerId) ?? "–")</span>
                        <span class="lg-lagerrad-tekst">
                            <b>@VareNavn(r.ComponentId)</b>
                            <small>@(vare?.Produktkode ?? "–")@(string.IsNullOrWhiteSpace(vare?.Gtin) ? "" : $" · EAN {vare.Gtin}") · @maks reservert@(r.Plukket > 0 ? $" ({r.Plukket} plukket før)" : "")</small>
                        </span>
                        <span class="lg-teller">
                            <button type="button" @onclick="@(() => SettPlukk(r, antall - 1))" disabled="@(antall <= 0)" aria-label="Én mindre">−</button>
                            <input type="number" min="0" max="@maks" value="@antall" @onchange="@(e => SettPlukk(r, int.TryParse(e.Value?.ToString(), out var a) ? a : 0))" aria-label="Antall plukket" />
                            <button type="button" @onclick="@(() => SettPlukk(r, antall + 1))" disabled="@(antall >= maks)" aria-label="Én til">+</button>
                        </span>
                    </div>
                }
            </div>

            <label class="lg-felt">Leveres til
                <select @bind="_plukkTil">
                    @foreach (var l in AktiveLagre.Where(l => l.Type != LagerType.Hovedlager))
