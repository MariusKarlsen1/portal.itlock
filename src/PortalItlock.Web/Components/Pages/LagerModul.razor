                        @if (lager.Type == LagerType.Bil)
                        {
                            <button type="button" class="lg-lenkeknapp" @onclick="@(() => ApnePafyll(lager.Id))">Påfyll@(_pafyllTall.GetValueOrDefault(lager.Id) > 0 ? $" ({_pafyllTall[lager.Id]})" : "")</button>
