            </div>
        }

        <div class="lg-boks-topp lg-boks-topp-smal"><h3>Per lager</h3></div>
        <table class="lg-tabell lg-tabell-smal">
            <thead><tr><th>Lager</th><th>Hylle</th><th class="n">Antall</th></tr></thead>
            <tbody>
                @foreach (var l in AktiveLagre)
                {
                    var lagerId = l.Id;
                    <tr>
                        <td>@l.Navn</td>
                        <td><input class="lg-hylle" value="@Hylle(c.Id, lagerId)" placeholder="–" @onchange="@(e => LagreHylle(c.Id, lagerId, e.Value?.ToString()))" aria-label="Hylle på @l.Navn" /></td>
                        <td class="n"><b>@Antall(c.Id, lagerId)</b></td>
                    </tr>
                }
            </tbody>
        </table>

        <label class="lg-felt lg-felt-smal">Minimumsbeholdning
            <input type="number" min="0" @bind="c.Minimumsbeholdning" @bind:after="@(() => LagreMinimum(c))" placeholder="Ingen" />
        </label>

        <div class="lg-boks-topp lg-boks-topp-smal"><h3>Historikk</h3></div>
        @BevegelseTabell(_sisteBevegelser.Where(b => b.ComponentId == c.Id).Take(15), visVare: false)

        <button type="button" class="lg-lenkeknapp" @onclick="@(() => Avlagerfor(c))">Ta varen ut av lagerstyring</button>
    </aside>;

    // ======================================================================
    // Lagre og biler
    // ======================================================================
    private bool _visNyttLager;
    private string _nyttNavn = "";
    private LagerType _nyType = LagerType.Bil;
    private int? _nyAnsvarlig;
    private int? _nyttProsjekt;

    private async Task OpprettLager()
    {
        var navn = _nyttNavn.Trim();
        if (string.IsNullOrEmpty(navn))
        {
            navn = _nyType switch
            {
                LagerType.Bil => "Bil – " + (_montorer.FirstOrDefault(m => m.Id == _nyAnsvarlig)?.Navn ?? "ny"),
                LagerType.Prosjektlager => "Prosjektlager – " + (_prosjekter.FirstOrDefault(p => p.Id == _nyttProsjekt)?.Navn ?? "nytt"),
                _ => "Nytt lager"
            };
        }

        Db.Lagre.Add(new Lager { Navn = navn, Type = _nyType, AnsvarligBrukerId = _nyType == LagerType.Bil ? _nyAnsvarlig : null, ProsjektId = _nyType == LagerType.Prosjektlager ? _nyttProsjekt : null });
        await Db.SaveChangesAsync();
        _visNyttLager = false;
        _nyttNavn = "";
        _nyAnsvarlig = null;
        _nyttProsjekt = null;
        await LastAsync();
        _melding = $"{navn} er opprettet.";
    }

    private async Task DeaktiverLager(Lager l)
    {
        if (_varer.Any(c => Antall(c.Id, l.Id) != 0))
        {
            _melding = $"{l.Navn} har fortsatt varer. Flytt dem til et annet lager først.";
            return;
        }

        if (l.Type == LagerType.Hovedlager && _lagre.Count(x => x.Aktiv && x.Type == LagerType.Hovedlager) <= 1)
        {
            _melding = "Det må finnes minst ett hovedlager.";
            return;
        }

        l.Aktiv = false;
        await Db.SaveChangesAsync();
        await LastAsync();
        _melding = $"{l.Navn} er lagt bort.";
    }

    private async Task GiNyttNavn(Lager l, string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return;
        }

        l.Navn = navn.Trim();
        await Db.SaveChangesAsync();
    }

    private void VisVarerPa(int lagerId)
    {
        _filterLager = lagerId;
        Nav.NavigateTo("/lager/varer");
    }

    private RenderFragment Lagre() => @<div class="lg-fane">
