            <div><b class="@(Ledig(c.Id) <= 0 ? "lg-rod" : "lg-gronn")">@Ledig(c.Id)</b><span>Ledig (hovedlager)</span></div>
            <div><b class="@(Bestilt(c.Id) > 0 ? "lg-bla" : "")">@Bestilt(c.Id)</b><span>Bestilt</span></div>
