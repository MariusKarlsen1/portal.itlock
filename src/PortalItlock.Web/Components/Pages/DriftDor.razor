@page "/drift/dor/{Id:int}"
@layout PortalItlock.Web.Components.Layout.DriftLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Driftslisens")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject EmailService Epost
@inject NavigationManager Nav

<PageTitle>@(_dor?.Dornummer ?? "Dør") - Full Kontroll</PageTitle>

@if (_ikkeTilgang)
{
    <p class="dp-feil">Du har ikke tilgang til denne døren.</p>
    <a class="dp-tilbake" href="/drift"><Icon Name="arrow-left" />Tilbake</a>
}
else if (_dor is null)
{
    <p class="dp-tom">Laster...</p>
}
else
{
    <a class="dp-tilbake" href="@($"/drift/prosjekt/{_dor.ProsjektId}")"><Icon Name="arrow-left" />@_dor.Prosjekt?.Navn</a>

    <div class="dp-to-kol">
        <div class="dp-kol">
            <div class="dp-kort dp-dor-hero">
                <div class="dp-linje">
                    <span class="dp-nr">@(string.IsNullOrWhiteSpace(_dor.Romnr) ? _dor.Dornummer : _dor.Romnr)</span>
                    <div>
                        <h1>@(string.IsNullOrWhiteSpace(_dor.DorTil) ? $"Dør {_dor.Dornummer}" : _dor.DorTil)</h1>
                        <small>@Plassering</small>
                    </div>
                </div>
                @if (Fakta.Count > 0)
                {
                    <div class="dp-fakta">
                        @foreach (var (navn, verdi) in Fakta)
                        {
                            <div><small>@navn</small><b>@verdi</b></div>
                        }
                    </div>
                }
            </div>

            <div class="dp-kort dp-skjema">
                <h2 style="margin:0 0 .2rem;font-size:1.1rem;font-weight:600">Meld inn en feil</h2>

                <span class="dp-lbl">Hva gjelder det?</span>
                <div class="dp-kategorier">
                    @foreach (var k in DriftHelper.Kategorier)
                    {
                        <button type="button" class="@(_kategori == k.Navn ? "aktiv" : "")" @onclick="@(() => VelgKategori(k.Navn))" @key="k.Navn">
                            <Icon Name="@k.Ikon" />@k.Navn
                        </button>
                    }
                </div>

                <span class="dp-lbl">Beskriv kort</span>
                <textarea class="dp-tekstfelt" rows="4" @bind="_nyTekst" @bind:event="oninput" placeholder="Hva skjer med døren? F.eks. «Går ikke i lås når den slås igjen»"></textarea>

                <span class="dp-lbl">Bilde eller video</span>
                <div class="dp-filer">
                    @foreach (var f in _valgteFiler)
                    {
                        <div class="dp-fil" @key="f">
                            @if (f.Forhandsvisning is not null)
                            {
                                <img src="@f.Forhandsvisning" alt="@f.Filnavn" />
                            }
                            else
                            {
                                <span><Icon Name="@(f.ContentType.StartsWith("video/") ? "play" : "file-text")" /><br />@f.Filnavn</span>
                            }
                            <button type="button" title="Fjern" @onclick="@(() => _valgteFiler.Remove(f))">&times;</button>
                        </div>
                    }
                    <label class="dp-fil-ny">
                        <Icon Name="camera" />
                        @(_lasterFil ? "Laster..." : "Ta bilde / velg")
                        <InputFile OnChange="OnFilesSelected" multiple accept="image/*,video/*" />
                    </label>
                </div>

                <label class="dp-haster @(_haster ? "pa" : "")">
                    <span><b>Haster</b><small>Døren står åpen, er til fare eller stenger rømningsvei</small></span>
                    <input type="checkbox" @bind="_haster" />
                    <span class="dp-bryter"></span>
                </label>

                @if (!string.IsNullOrEmpty(_feil))
                {
                    <p class="dp-feil">@_feil</p>
                }

                <div class="dp-send-rad">
                    <button type="button" class="dp-send" @onclick="SendInn" disabled="@(_sender || _lasterFil)">
                        <Icon Name="send" />@(_sender ? "Sender..." : "Send melding")
                    </button>
                </div>
            </div>
        </div>

        <div class="dp-kol">
            <div class="dp-seksjon-t"><h2>Tidligere på denne døren</h2><span>@_meldinger.Count</span></div>
            @if (_meldinger.Count == 0)
            {
                <div class="dp-kort dp-tom">Ingen meldinger på denne døren ennå.</div>
            }
            else
            {
                <div class="dp-meldinger">
                    @foreach (var s in _meldinger)
                    {
                        <DriftMeldingRad Status="s" VisBygg="false" @key="s.Melding.Id" />
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class ValgtFil
    {
        public required string Filnavn { get; set; }
        public required string ContentType { get; set; }
        public required byte[] Data { get; set; }
        public string? Forhandsvisning { get; set; }
    }

    private Dor? _dor;
    private bool _ikkeTilgang;
    private int? _brukerId;
    private List<DriftHelper.MeldingStatus> _meldinger = [];
    private string? _kategori;
    private string _nyTekst = "";
    private bool _haster;
    private List<ValgtFil> _valgteFiler = [];
    private string? _feil;
    private bool _sender;
    private bool _lasterFil;

    private string Plassering => string.Join(" · ", new[]
    {
        int.TryParse(_dor?.Etasje, out var etg) ? $"{etg}. etasje" : _dor?.Etasje,
        string.IsNullOrWhiteSpace(_dor?.Romnr) ? null : $"Rom {_dor.Romnr}",
        _dor?.Sone,
        $"Dør {_dor?.Dornummer}"
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private List<(string Navn, string Verdi)> Fakta => new (string Navn, string? Verdi)[]
    {
        ("Dørtype", _dor?.Dortype),
        ("Brann", _dor?.Brann),
        ("Slagretning", _dor?.Slagretning)
    }.Where(f => !string.IsNullOrWhiteSpace(f.Verdi)).Select(f => (f.Navn, f.Verdi!)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            _ikkeTilgang = true;
            return;
        }

        _brukerId = brukerId;

        var dor = await Db.Dorer.Include(d => d.Prosjekt).FirstOrDefaultAsync(d => d.Id == Id);
        if (dor is null || !await DriftHelper.HarTilgangTilBygg(Db, brukerId, dor.ProsjektId))
        {
            _ikkeTilgang = true;
            return;
        }

        _dor = dor;
        _meldinger = await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.DorId == Id));
    }

    private void VelgKategori(string kategori) => _kategori = _kategori == kategori ? null : kategori;

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _feil = null;
        _lasterFil = true;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 50_000_000)
            {
                _feil = $"\"{file.Name}\" er for stort (maks 50 MB).";
                continue;
            }

            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            // Liten forhåndsvisning av bilder, så vaktmesteren ser hva som legges ved.
            string? forhandsvisning = null;
            if (contentType.StartsWith("image/"))
            {
                try
                {
                    var liten = await file.RequestImageFileAsync("image/jpeg", 240, 240);
                    using var lite = new MemoryStream();
                    await using (var s = liten.OpenReadStream(maxAllowedSize: 5_000_000))
                    {
                        await s.CopyToAsync(lite);
                    }
                    forhandsvisning = $"data:image/jpeg;base64,{Convert.ToBase64String(lite.ToArray())}";
                }
                catch
                {
                    // Formater nettleseren ikke kan skalere (f.eks. HEIC) vises bare med filnavn.
                }
            }

            _valgteFiler.Add(new ValgtFil
            {
                Filnavn = file.Name,
                ContentType = contentType,
                Data = buffer.ToArray(),
                Forhandsvisning = forhandsvisning
            });
        }

        _lasterFil = false;
    }

    private async Task SendInn()
    {
        _feil = null;

        if (string.IsNullOrWhiteSpace(_nyTekst) && _kategori is null)
        {
            _feil = "Velg hva det gjelder, eller skriv en kort beskrivelse.";
            return;
        }

        _sender = true;

        var melding = new Driftsmelding
        {
            DorId = Id,
            Kategori = _kategori,
            Haster = _haster,
            Tekst = string.IsNullOrWhiteSpace(_nyTekst) ? _kategori! : _nyTekst.Trim(),
            InnmeldtAvBrukerId = _brukerId
        };

        foreach (var fil in _valgteFiler)
        {
            melding.Media.Add(new DriftsmeldingMedia
            {
                Filnavn = fil.Filnavn,
                ContentType = fil.ContentType,
                Data = fil.Data
            });
        }

        Db.Driftsmeldinger.Add(melding);
        await Db.SaveChangesAsync();

        await VarsleAnsatte(melding);

        Nav.NavigateTo($"/drift/melding/{melding.Id}?ny=1");
    }

    private async Task VarsleAnsatte(Driftsmelding melding)
    {
        var mottakerEposter = await Db.Brukere
            .Where(b => (b.Rolle == BrukerRolle.Admin || b.Rolle == BrukerRolle.Prosjektleder) && b.Aktiv)
            .Select(b => b.Epost)
            .ToListAsync();

        var innmelder = _brukerId.HasValue ? await Db.Brukere.FindAsync(_brukerId.Value) : null;

        var html = $"<p>Ny driftsmelding på <strong>Dør {_dor?.Dornummer}</strong> - {_dor?.Prosjekt?.Navn}:</p>"
            + (melding.Haster ? "<p><strong style=\"color:#b23b22\">HASTER</strong> - døren står åpen, er til fare eller stenger rømningsvei.</p>" : "")
            + (melding.Kategori is null ? "" : $"<p>Gjelder: <strong>{System.Net.WebUtility.HtmlEncode(melding.Kategori)}</strong></p>")
            + $"<p>{System.Net.WebUtility.HtmlEncode(melding.Tekst).Replace("\n", "<br>")}</p>"
            + $"<p>Meldt inn av {innmelder?.Navn ?? "ukjent"}.</p>"
            + "<p>Se den i portalen under Driftsmeldinger.</p>";

        var emne = $"{(melding.Haster ? "HASTER: " : "")}Ny driftsmelding - Dør {_dor?.Dornummer}";
        foreach (var mottakerEpost in mottakerEposter)
        {
            await Epost.SendAsync(mottakerEpost, emne, html);
        }
    }
}
