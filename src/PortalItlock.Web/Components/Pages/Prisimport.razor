@page "/komponenter/prisimport"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PrisimportService PrisimportSvc

<PageTitle>Prisimport</PageTitle>

<a class="back-link" href="/komponenter">← Tilbake til komponentregisteret</a>
<h1>Prisimport</h1>
<p class="section-hint">
    Last opp en prisliste (Excel) fra en leverandør. Varer som allerede finnes (matchet på produktkode og leverandør) får oppdatert pris. Nye produktkoder legges til som nye varer.
    Hvis en eksisterende vare har en <a href="/rabattgrupper">rabattgruppe</a> satt, beregnes nettopris automatisk fra veiledende pris i filen og rabattgruppens prosent - da trenger du ikke en egen netto-kolonne for de varene.
</p>

@if (_steg == 1)
{
    <div class="import-hero">
        <div class="import-card import-upload-card">
            <h2>Velg importfil</h2>
            <label class="import-dropzone @(string.IsNullOrWhiteSpace(_leverandor) ? "import-dropzone-disabled" : "")">
                <InputFile OnChange="LastOppFil" accept=".xlsx" disabled="@string.IsNullOrWhiteSpace(_leverandor)" class="import-dropzone-input" />
                <div class="import-dropzone-content">
                    <span class="import-dropzone-ikon">📄</span>
                    <p><strong>Klikk for å velge fil</strong> eller dra og slipp den her</p>
                    <p class="import-dropzone-hint">Excel-fil (.xlsx)</p>
                </div>
            </label>
            <label class="import-leverandor-felt">
                Leverandør
                <input @bind="_leverandor" @bind:event="oninput" placeholder="F.eks. ASSA ABLOY" />
            </label>
            <p class="section-hint">Alle rader i filen regnes som fra denne leverandøren. Skriv inn leverandør før du velger fil.</p>

            @if (!string.IsNullOrEmpty(_feil))
            {
                <p class="form-error">@_feil</p>
            }
        </div>

        <div class="import-card import-komigang-card">
            <h2>Kom i gang</h2>
            <ol>
                <li>Skriv inn hvilken leverandør prislisten kommer fra.</li>
                <li>Velg eller dra inn Excel-filen med prislisten.</li>
                <li>Match kolonnene i filen mot feltene i portalen - vi foreslår automatisk ut fra overskriftene.</li>
                <li>Se gjennom forhåndsvisningen og trykk Start import.</li>
            </ol>
        </div>
    </div>

    @if (_historikk.Count > 0)
    {
        <div class="import-card import-historikk-card">
            <h2>Tidligere importer</h2>
            <table class="import-historikk-table">
                <thead>
                    <tr>
                        <th>Fil</th>
                        <th>Leverandør</th>
                        <th>Dato</th>
                        <th>Av</th>
                        <th>Status</th>
                        <th>Resultat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in _historikk)
                    {
                        <tr @key="h.Id">
                            <td>@h.Filnavn</td>
                            <td>@h.Leverandor</td>
                            <td>@h.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(h.OpprettetAvBruker?.Navn ?? "-")</td>
                            <td><span class="import-status-badge @(h.Status == "Fullført" ? "import-status-badge-ok" : h.Status == "Avbrutt" ? "import-status-badge-uendret" : "import-status-badge-pagar")">@h.Status</span></td>
                            <td>@(h.AntallNye is not null ? $"{h.AntallNye} nye, {h.AntallOppdatert} oppdatert" : "-")</td>
                            <td><button type="button" class="cancel-button" @onclick="@(() => SlettHistorikk(h))">Slett</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_steg == 2)
{
    <div class="import-card import-info-card">
        <h2>@_filnavn</h2>
        <p class="section-hint">Fant @_rader.Count rad(er) og @_kolonner.Count kolonne(r) i filen.</p>
    </div>

    <div class="import-card import-mapping-card">
        <h2>Match kolonner</h2>
        <p class="section-hint">Vi har forsøkt å matche kolonnene i filen automatisk ut fra overskriftene - kontroller at de stemmer, og rett opp med nedtrekksmenyene der det trengs. Produktkode er obligatorisk.</p>

        <table class="mapping-table">
            <thead>
                <tr>
                    <th>Felt i portalen</th>
                    <th>Kolonne i filen</th>
                    <th>Eksempel fra første rad</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Produktkode <span class="krevd">*</span></td>
                    <td>
                        <select @bind="_produktkodeKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_produktkodeKolIndeks is not null && _produktkodeKolIndeks == _autoForslag.Produktkode)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_produktkodeKolIndeks)</td>
                </tr>
                <tr>
                    <td>Navn</td>
                    <td>
                        <select @bind="_navnKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_navnKolIndeks is not null && _navnKolIndeks == _autoForslag.Navn)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_navnKolIndeks)</td>
                </tr>
                <tr>
                    <td>Enhet</td>
                    <td>
                        <select @bind="_enhetKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_enhetKolIndeks is not null && _enhetKolIndeks == _autoForslag.Enhet)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_enhetKolIndeks)</td>
                </tr>
                <tr>
                    <td>Pris netto</td>
                    <td>
                        <select @bind="_prisNettoKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_prisNettoKolIndeks is not null && _prisNettoKolIndeks == _autoForslag.PrisNetto)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_prisNettoKolIndeks)</td>
                </tr>
                <tr>
                    <td>Pris veiledende</td>
                    <td>
                        <select @bind="_prisVeiledendeKolIndeks">
                            <option value="">Ikke i bruk</option>
                            @foreach (var k in _kolonner)
                            {
                                <option value="@k.Indeks">@k.Overskrift</option>
                            }
                        </select>
                        @if (_prisVeiledendeKolIndeks is not null && _prisVeiledendeKolIndeks == _autoForslag.PrisVeiledende)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </td>
                    <td class="mapping-eksempel">@Eksempel(_prisVeiledendeKolIndeks)</td>
                </tr>
            </tbody>
        </table>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="VisForhandsvisning" disabled="@(_produktkodeKolIndeks is null)">Neste</button>
            <button type="button" class="cancel-button" @onclick="AvbrytImport">Avbryt</button>
            @if (!string.IsNullOrEmpty(_feil))
            {
                <span class="form-error">@_feil</span>
            }
        </div>
    </div>
}
else if (_steg == 3)
{
    <div class="import-card">
        <h2>Validering</h2>
        <p class="section-hint">Kontroller resultatet under før du starter importen. Rader med feil er markert i rødt og importeres ikke.</p>
        <div class="import-oppsummering">
            <span class="import-oppsummering-tall import-oppsummering-ok">@_forhandsvisning.Count(r => r.Feil is null && r.ErNyVare) nye</span>
            <span class="import-oppsummering-tall import-oppsummering-ok">@_forhandsvisning.Count(r => r.Feil is null && !r.ErNyVare) oppdateres</span>
            <span class="import-oppsummering-tall import-oppsummering-feil">@_forhandsvisning.Count(r => r.Feil is not null) ikke importert</span>
        </div>

        <table class="import-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Rad</th>
                    <th>Produktkode</th>
                    <th>Navn</th>
                    <th>Enhet</th>
                    <th>Pris netto</th>
                    <th>Pris veiledende</th>
                    <th>Rabattgruppe</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _forhandsvisning)
                {
                    <tr @key="r.RadNummer" class="@(r.Feil is not null ? "import-rad-feil" : "import-rad-ok")">
                        <td><input type="checkbox" @bind="r.Inkluder" disabled="@(r.Feil is not null)" /></td>
                        <td>@r.RadNummer</td>
                        <td>@r.Produktkode</td>
                        <td>@(r.ErNyVare ? r.Navn : r.EksisterendeNavn)</td>
                        <td>@r.Enhet</td>
                        <td>
                            @(r.PrisNetto?.ToString("N2", Kultur))
                            @if (r.NettoErBeregnet)
                            {
                                <span class="import-beregnet" title="Beregnet fra veiledende pris og rabattgruppe">(beregnet)</span>
                            }
                        </td>
                        <td>@(r.PrisVeiledende?.ToString("N2", Kultur))</td>
                        <td>@r.RabattgruppeKode</td>
                        <td>
                            @if (r.Feil is not null)
                            {
                                <span class="import-status-badge import-status-badge-feil">@r.Feil</span>
                            }
                            else if (r.ErNyVare)
                            {
                                <span class="import-status-badge import-status-badge-ok">Ny vare</span>
                            }
                            else
                            {
                                <span class="import-status-badge import-status-badge-ok">Oppdaterer</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Importer">Start import (@_forhandsvisning.Count(r => r.Inkluder && r.Feil is null) vare(r))</button>
            <button type="button" class="cancel-button" @onclick="@(() => _steg = 2)">Tilbake</button>
        </div>
    </div>
}
else if (_steg == 4)
{
    <div class="import-card">
        <h2>Ferdig</h2>
        <p class="save-success">@_oppdatertAntall pris(er) oppdatert. @_nyeAntall ny(e) vare(r) lagt til.</p>
        <button type="button" class="save-button" @onclick="NyImport">Ny import</button>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private int _steg = 1;
    private string _leverandor = "";
    private string? _feil;
    private string? _filnavn;

    private List<PrisimportService.ArkKolonne> _kolonner = [];
    private List<string[]> _rader = [];
    private string[]? _radeksempel;

    private int? _produktkodeKolIndeks;
    private int? _navnKolIndeks;
    private int? _enhetKolIndeks;
    private int? _prisNettoKolIndeks;
    private int? _prisVeiledendeKolIndeks;
    private PrisimportService.KolonneForslag _autoForslag = new();

    private string? Eksempel(int? kolIndeks) =>
        kolIndeks is not null && _radeksempel is not null && kolIndeks.Value < _radeksempel.Length
            ? _radeksempel[kolIndeks.Value]
            : null;

    private List<PrisimportService.ImportRad> _forhandsvisning = [];
    private int _oppdatertAntall;
    private int _nyeAntall;

    private List<Importhistorikk> _historikk = [];
    private Importhistorikk? _gjeldendeHistorikk;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        await LastHistorikkAsync();
    }

    private async Task LastHistorikkAsync()
    {
        _historikk = await Db.Importhistorikk
            .Include(h => h.OpprettetAvBruker)
            .Where(h => h.Kilde == "Prisimport")
            .OrderByDescending(h => h.OpprettetDato)
            .Take(15)
            .ToListAsync();
    }

    private async Task SlettHistorikk(Importhistorikk h)
    {
        Db.Importhistorikk.Remove(h);
        await Db.SaveChangesAsync();
        _historikk.Remove(h);
    }

    private async Task LastOppFil(InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;

        if (file.Size > 20_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        buffer.Position = 0;

        try
        {
            (_kolonner, _rader) = PrisimportSvc.LesFil(buffer);
        }
        catch (Exception ex)
        {
            _feil = $"Klarte ikke å lese filen: {ex.Message}";
            return;
        }

        if (_kolonner.Count == 0)
        {
            _feil = "Fant ingen data i filen.";
            return;
        }

        _filnavn = file.Name;
        _radeksempel = _rader.Count > 0 ? _rader[0] : null;

        _autoForslag = PrisimportService.AutoMatchKolonner(_kolonner);
        _produktkodeKolIndeks = _autoForslag.Produktkode;
        _navnKolIndeks = _autoForslag.Navn;
        _enhetKolIndeks = _autoForslag.Enhet;
        _prisNettoKolIndeks = _autoForslag.PrisNetto;
        _prisVeiledendeKolIndeks = _autoForslag.PrisVeiledende;

        _gjeldendeHistorikk = new Importhistorikk
        {
            Kilde = "Prisimport",
            Filnavn = _filnavn,
            Leverandor = _leverandor,
            OpprettetAvBrukerId = _naverendeBrukerId,
            Status = "Pågår"
        };
        Db.Importhistorikk.Add(_gjeldendeHistorikk);
        await Db.SaveChangesAsync();
        await LastHistorikkAsync();

        _steg = 2;
    }

    private async Task VisForhandsvisning()
    {
        if (_produktkodeKolIndeks is null)
        {
            return;
        }

        _forhandsvisning = await PrisimportSvc.ForhandsvisAsync(
            _rader, _leverandor,
            _produktkodeKolIndeks.Value, _navnKolIndeks, _enhetKolIndeks, _prisNettoKolIndeks, _prisVeiledendeKolIndeks);

        if (_forhandsvisning.Count == 0)
        {
            _feil = "Fant ingen gyldige rader å importere.";
            return;
        }

        _feil = null;
        _steg = 3;
    }

    private async Task Importer()
    {
        (_oppdatertAntall, _nyeAntall) = await PrisimportSvc.ImporterAsync(_forhandsvisning, _leverandor);

        if (_gjeldendeHistorikk is not null)
        {
            _gjeldendeHistorikk.Status = "Fullført";
            _gjeldendeHistorikk.AntallRader = _forhandsvisning.Count;
            _gjeldendeHistorikk.AntallNye = _nyeAntall;
            _gjeldendeHistorikk.AntallOppdatert = _oppdatertAntall;
            await Db.SaveChangesAsync();
            await LastHistorikkAsync();
        }

        _steg = 4;
    }

    private async Task AvbrytImport()
    {
        if (_gjeldendeHistorikk is not null)
        {
            _gjeldendeHistorikk.Status = "Avbrutt";
            await Db.SaveChangesAsync();
            await LastHistorikkAsync();
        }

        NyImport();
    }

    private void NyImport()
    {
        _steg = 1;
        _leverandor = "";
        _feil = null;
        _filnavn = null;
        _kolonner = [];
        _rader = [];
        _radeksempel = null;
        _produktkodeKolIndeks = null;
        _navnKolIndeks = null;
        _enhetKolIndeks = null;
        _prisNettoKolIndeks = null;
        _prisVeiledendeKolIndeks = null;
        _autoForslag = new();
        _forhandsvisning = [];
        _gjeldendeHistorikk = null;
    }
}
