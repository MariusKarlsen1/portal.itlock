@page "/komponenter/prisimport"
@page "/komponenter/oppdater-priser"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PrisimportService PrisimportSvc
@inject PrisoppdateringService PrisoppdateringSvc
@inject VisningPreferanseService VisningPref

<PageTitle>Prisimport</PageTitle>

@* PI2 (prisimport-forslag.html): leverandørene i en meny inni kortet, og for valgt
   leverandør fanene Prisoppdatering (bare prisene endres, matchet på leverandørens
   varenummer), Importer varer (nye varer og varedata) og Historikk. *@
<div class="pi @(_full ? "pi-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="upload" /></span>
            <div>
                <h1>Prisimport</h1>
                <p class="section-hint">Velg leverandør. Oppdater prisene fra årets prisliste, eller importer nye varer fra en vareliste.</p>
            </div>
        </div>
        <a class="pi-knapp" href="/komponenter"><Icon Name="arrow-left" />Komponentregister</a>
    </div>

    <div class="pi-kort">
        <nav class="pi-meny">
            <label class="pi-minisok">
                <Icon Name="search" />
                <input type="search" @bind="_levSok" @bind:event="oninput" placeholder="Finn leverandør" />
            </label>
            <div class="pi-levliste">
                @foreach (var l in _leverandorer.Where(l => string.IsNullOrWhiteSpace(_levSok) || l.Navn.Contains(_levSok.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    var id = l.Id;
                    <button type="button" @key="l.Id" class="@(_valgtLevId == id ? "pa" : "")" @onclick="@(() => VelgLeverandor(id))">
                        <span class="pi-avatar">@Initialer(l.Navn)</span>
                        <span class="pi-levnavn">
                            <span>@l.Navn</span>
                            <small class="@(ErGammel(l) ? "pi-gammel" : "")">@(l.SistOppdatert is { } d ? $"Priser {d:dd.MM.yyyy}" : "Ingen prisliste ennå")</small>
                        </span>
                    </button>
                }
                @if (_leverandorer.Count == 0)
                {
                    <p class="pi-dempet">Ingen leverandører ennå. Legg til en under.</p>
                }
            </div>
            <div class="pi-ny-lev">
                <input @bind="_nyLevNavn" @bind:event="oninput" placeholder="＋ Ny leverandør"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettLeverandor(); } })" />
                @if (!string.IsNullOrWhiteSpace(_nyLevNavn))
                {
                    <button type="button" class="pi-knapp primaer" @onclick="OpprettLeverandor">Legg til</button>
                }
            </div>
        </nav>

        <section class="pi-innhold">
            <button type="button" class="pi-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>

            @if (Valgt is not { } lev)
            {
                <p class="pi-dempet">Velg en leverandør i menyen.</p>
            }
            else
            {
                <div class="pi-levhode">
                    <span class="pi-avatar stor">@Initialer(lev.Navn)</span>
                    <div>
                        <h2>@lev.Navn</h2>
                        <p>
                            @lev.AntallVarer.ToString("N0", Kultur) @(lev.AntallVarer == 1 ? "vare" : "varer")
                            · @(lev.SistOppdatert is { } d ? $"priser sist oppdatert {d:dd.MM.yyyy}" : "ingen prisliste lastet opp ennå")
                            @if (ErGammel(lev))
                            {
                                <b class="pi-gammel"> · over ett år siden</b>
                            }
                        </p>
                    </div>
                </div>

                <div class="pi-faner">
                    <button type="button" class="@(_fane == "pris" ? "pa" : "")" @onclick="@(() => _fane = "pris")"><Icon Name="trend-up" />Prisoppdatering</button>
                    <button type="button" class="@(_fane == "import" ? "pa" : "")" @onclick="@(() => _fane = "import")"><Icon Name="upload" />Importer varer</button>
                    <button type="button" class="@(_fane == "hist" ? "pa" : "")" @onclick="@(() => _fane = "hist")"><Icon Name="clock" />Historikk</button>
                </div>

                @if (_fane == "pris")
                {
                    @if (_planlagt.Count > 0 && _pSteg == 1)
                    {
                        <div class="pi-planlagt">
                            @foreach (var p in _planlagt)
                            {
                                var dato = p.Dato;
                                <div>
                                    <span class="pi-status plan"></span>
                                    <span><b>@p.Antall.ToString("N0", Kultur) @(p.Antall == 1 ? "vare" : "varer")</b> får ny pris fra <b>@p.Dato.ToString("dd.MM.yyyy")</b></span>
                                    @if (_avbryterPlanDato == dato)
                                    {
                                        <span class="pi-knapperad">
                                            <span class="pi-dempet">Avbryte prisendringen?</span>
                                            <button type="button" class="pi-knapp fare" @onclick="@(() => AvbrytPlanlagt(dato))">Ja, avbryt</button>
                                            <button type="button" class="pi-knapp" @onclick="@(() => _avbryterPlanDato = null)">Nei</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="pi-lenke" @onclick="@(() => _avbryterPlanDato = dato)">Avbryt</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @StegLinje(_pSteg)

                    @if (_pSteg == 1)
                    {
                        <div class="pi-rad">
                            <div class="pi-stabel">
                                <label class="pi-felt pi-dato">
                                    <span>Gjelder fra</span>
                                    <input type="date" @bind="_pDato" />
                                </label>
                                <label class="pi-slipp">
                                    <InputFile OnChange="LastOppPrisliste" accept=".xlsx" />
                                    <Icon Name="upload" />
                                    <b>Slipp @lev.Navn sin prisliste her, eller klikk for å velge</b>
                                    <small>Excel (.xlsx)@(_pHarHusket ? " · kolonnene fra forrige gang brukes" : "")</small>
                                </label>
                                @if (!string.IsNullOrEmpty(_pFeil))
                                {
                                    <p class="form-error">@_pFeil</p>
                                }
                            </div>
                            <div class="pi-boks">
                                <b>Slik fungerer prisoppdatering</b>
                                <ol>
                                    <li>Last opp årets prisliste fra @lev.Navn.</li>
                                    <li>Varenummeret i filen sjekkes mot @lev.Navn sitt varenummer på varene (produktkode og GTIN/EAN brukes som reserve).</li>
                                    <li>Der prisen er forskjellig endres <b>bare prisen</b> - netto og veiledende. Navn og andre felt røres ikke.</li>
                                    <li>Varer som ikke finnes lages ikke. Bruk Importer varer for det.</li>
                                </ol>
                            </div>
                        </div>
                    }
                    else if (_pSteg == 2)
                    {
                        <p class="pi-dempet"><b>@_pFilnavn</b> · @_pRader.Count.ToString("N0", Kultur) rader. Velg hvilke kolonner i filen som er varenummer og priser.</p>
                        <div class="pi-tabell-ramme">
                            <table class="pi-tabell">
                                <thead><tr><th>Felt</th><th>Kolonne i filen</th><th>Eksempel fra første rad</th></tr></thead>
                                <tbody>
                                    @foreach (var rad in PrisMapping())
                                    {
                                        <tr>
                                            <td><b>@rad.Label</b>@if (rad.Krevd) {<span class="pi-krevd"> *</span>}</td>
                                            <td>
                                                <select class="pi-select" value="@(rad.Get()?.ToString() ?? "")" @onchange="@(e => rad.Set(ParseIndeks(e.Value)))">
                                                    <option value="">Ikke i bruk</option>
                                                    @foreach (var k in _pKolonner)
                                                    {
                                                        <option value="@k.Indeks">@k.Overskrift</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="pi-dempet">@Eksempel(_pEksempel, rad.Get())</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="pi-dempet">Har filen bare veiledende pris, regnes netto ut fra varens rabattgruppe.</p>
                        @if (!string.IsNullOrEmpty(_pFeil))
                        {
                            <p class="form-error">@_pFeil</p>
                        }
                        <div class="pi-lagrebar">
                            <span>@(_pHarHusket ? "Kolonnene er husket fra forrige prisoppdatering" : "Kolonnene er gjettet ut fra overskriftene - sjekk at de stemmer")</span>
                            <span class="pi-lagrebar-knapper">
                                <button type="button" class="pi-knapp" @onclick="AvbrytPrisoppdatering">Avbryt</button>
                                <button type="button" class="pi-knapp primaer" disabled="@_pBusy" @onclick="ForhandsvisPriser">@(_pBusy ? "Sjekker priser ..." : "Neste")</button>
                            </span>
                        </div>
                    }
                    else if (_pSteg == 3)
                    {
                        var endret = _pRaderVist.Count(r => r.Feil is null && r.ErEndret);
                        var uendret = _pRaderVist.Count(r => r.Feil is null && !r.ErEndret);
                        var ikke = _pRaderVist.Count(r => r.Feil is not null);
                        var filtrert = PFiltrert().ToList();
                        <p class="pi-dempet"><b>@_pFilnavn</b> · gjelder fra <b>@_pDato.ToString("dd.MM.yyyy")</b>@(_pDato.Date > DateTime.Today ? " (planlegges)" : " (endres med en gang)")</p>
                        <div class="pi-filter">
                            <button type="button" class="@(_pFilter == "endret" ? "pa" : "")" @onclick="@(() => SettPFilter("endret"))">Ny pris <small>@endret.ToString("N0", Kultur)</small></button>
                            <button type="button" class="@(_pFilter == "lik" ? "pa" : "")" @onclick="@(() => SettPFilter("lik"))">Uendret <small>@uendret.ToString("N0", Kultur)</small></button>
                            <button type="button" class="@(_pFilter == "ikke" ? "pa" : "")" @onclick="@(() => SettPFilter("ikke"))">Ikke funnet <small>@ikke.ToString("N0", Kultur)</small></button>
                        </div>
                        @if (_pFilter == "ikke" && ikke > 0)
                        {
                            <p class="pi-boks">Disse varenumrene finnes ikke på noen vare fra @lev.Navn. De endres ikke her - bruk <b>Importer varer</b> om de skal legges inn.</p>
                        }
                        <div class="pi-tabell-ramme">
                            <div class="pi-tabell-scroll">
                                <table class="pi-tabell">
                                    <thead>
                                        <tr>
                                            @if (_pFilter == "endret")
                                            {
                                                <th class="pi-cb"><input type="checkbox" checked="@filtrert.All(r => r.Inkluder)" @onchange="@(e => VelgAllePriser((bool)e.Value!))" /></th>
                                            }
                                            <th>Vare</th>
                                            <th>Varenr</th>
                                            <th class="pi-n">Netto</th>
                                            <th class="pi-n">Veiledende</th>
                                            <th class="pi-n">Endring</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in filtrert.Take(_pVis))
                                        {
                                            <tr @key="r.RadNummer" class="@(r.Inkluder || _pFilter != "endret" ? "" : "pi-av")">
                                                @if (_pFilter == "endret")
                                                {
                                                    <td class="pi-cb"><input type="checkbox" @bind="r.Inkluder" /></td>
                                                }
                                                <td>@(r.ComponentNavn ?? "–")</td>
                                                <td><span class="pi-kode">@(r.Varenummer ?? r.Gtin)</span></td>
                                                <td class="pi-n">
                                                    @if (r.Feil is null && r.NyPrisNetto != r.GammelPrisNetto)
                                                    {
                                                        <span class="pi-gml">@Kr(r.GammelPrisNetto)</span>
                                                    }
                                                    @Kr(r.NyPrisNetto)@(r.NettoErBeregnet ? "*" : "")
                                                </td>
                                                <td class="pi-n">
                                                    @if (r.Feil is null && r.NyPrisVeiledende != r.GammelPrisVeiledende)
                                                    {
                                                        <span class="pi-gml">@Kr(r.GammelPrisVeiledende)</span>
                                                    }
                                                    @Kr(r.NyPrisVeiledende)
                                                </td>
                                                <td class="pi-n">
                                                    @if (r.ErEndret && r.EndringProsent is { } p)
                                                    {
                                                        <span class="pi-pst @(p > 0 ? "opp" : "ned")">@(p > 0 ? "+" : "")@p.ToString("0.0", Kultur) %</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        @if (filtrert.Count == 0)
                                        {
                                            <tr><td colspan="6" class="pi-tom">Ingen varer her.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (filtrert.Count > _pVis)
                            {
                                <div class="pi-flere">
                                    <span>Viser @_pVis.ToString("N0", Kultur) av @filtrert.Count.ToString("N0", Kultur)</span>
                                    <button type="button" class="pi-knapp" @onclick="@(() => _pVis += 200)">Vis flere</button>
                                </div>
                            }
                        </div>
                        @if (_pRaderVist.Any(r => r.NettoErBeregnet))
                        {
                            <p class="pi-dempet">* Netto regnet ut fra veiledende pris og varens rabattgruppe.</p>
                        }
                        @if (!string.IsNullOrEmpty(_pFeil))
                        {
                            <p class="form-error">@_pFeil</p>
                        }
                        var antallValgt = _pRaderVist.Count(r => r.Inkluder && r.Feil is null && r.ErEndret);
                        <div class="pi-lagrebar">
                            <span><b>@antallValgt.ToString("N0", Kultur) @(antallValgt == 1 ? "vare" : "varer")</b> får ny pris @(_pDato.Date > DateTime.Today ? $"fra {_pDato:dd.MM.yyyy}" : "nå") · bare prisen endres</span>
                            <span class="pi-lagrebar-knapper">
                                <button type="button" class="pi-knapp" disabled="@_pBusy" @onclick="@(() => _pSteg = 2)">Tilbake</button>
                                <button type="button" class="pi-knapp primaer" disabled="@(_pBusy || antallValgt == 0)" @onclick="OppdaterPriser"><Icon Name="check" />@(_pBusy ? "Oppdaterer ..." : "Oppdater priser")</button>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="pi-ferdig">
                            <b><Icon Name="check" />Ferdig</b>
                            <span>
                                @if (_pResultat.Planlagt > 0)
                                {
                                    <text>@_pResultat.Planlagt.ToString("N0", Kultur) @(_pResultat.Planlagt == 1 ? "vare" : "varer") får ny pris fra @_pDato.ToString("dd.MM.yyyy"). Endringen tas i bruk automatisk den dagen.</text>
                                }
                                else
                                {
                                    <text>@_pResultat.Naa.ToString("N0", Kultur) @(_pResultat.Naa == 1 ? "vare" : "varer") har fått ny pris. Navn og andre felt er ikke endret, og endringene ligger i prishistorikken.</text>
                                }
                            </span>
                            <button type="button" class="pi-knapp" @onclick="NullstillPris">Ny prisoppdatering</button>
                        </div>
                    }
                }
                else if (_fane == "import")
                {
                    @StegLinje(_iSteg)

                    @if (_iSteg == 1)
                    {
                        <div class="pi-rad">
                            <div class="pi-stabel">
                                <label class="pi-slipp">
                                    <InputFile OnChange="LastOppVareliste" accept=".xlsx" />
                                    <Icon Name="upload" />
                                    <b>Slipp varelisten fra @lev.Navn her, eller klikk for å velge</b>
                                    <small>Excel (.xlsx)</small>
                                </label>
                                @if (!string.IsNullOrEmpty(_iFeil))
                                {
                                    <p class="form-error">@_iFeil</p>
                                }
                            </div>
                            <div class="pi-boks">
                                <b>Slik fungerer import av varer</b>
                                <ol>
                                    <li>Last opp varelisten fra @lev.Navn.</li>
                                    <li>Velg hvilke kolonner som er varenummer, navn, priser, type osv.</li>
                                    <li>Nye varenummer blir nye varer (inaktive til du har sjekket dem). Varer som finnes får oppdatert data fra filen.</li>
                                    <li>Har varen en <a href="/rabattgrupper">rabattgruppe</a>, regnes netto ut fra veiledende pris.</li>
                                </ol>
                            </div>
                        </div>
                    }
                    else if (_iSteg == 2)
                    {
                        <p class="pi-dempet"><b>@_iFilnavn</b> · @_iRader.Count.ToString("N0", Kultur) rader og @_iKolonner.Count kolonner. Artikkelnr er obligatorisk.</p>
                        <div class="pi-tabell-ramme">
                            <table class="pi-tabell">
                                <thead><tr><th>Felt i portalen</th><th>Kolonne i filen</th><th>Eksempel fra første rad</th></tr></thead>
                                <tbody>
                                    @foreach (var rad in ImportMapping())
                                    {
                                        <tr>
                                            <td><b>@rad.Label</b>@if (rad.Krevd) {<span class="pi-krevd"> *</span>}</td>
                                            <td>
                                                <select class="pi-select" value="@(rad.Get()?.ToString() ?? "")" @onchange="@(e => rad.Set(ParseIndeks(e.Value)))">
                                                    <option value="">Ikke i bruk</option>
                                                    @foreach (var k in _iKolonner)
                                                    {
                                                        <option value="@k.Indeks">@k.Overskrift</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="pi-dempet">@Eksempel(_iEksempel, rad.Get())</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!string.IsNullOrEmpty(_iFeil))
                        {
                            <p class="form-error">@_iFeil</p>
                        }
                        <div class="pi-lagrebar">
                            <span>@(_iHarHusket ? "Kolonnene er husket fra forrige import" : "Kolonnene er gjettet ut fra overskriftene - sjekk at de stemmer")</span>
                            <span class="pi-lagrebar-knapper">
                                <button type="button" class="pi-knapp" @onclick="AvbrytImport">Avbryt</button>
                                <button type="button" class="pi-knapp primaer" disabled="@_iBusy" @onclick="ForhandsvisImport">@(_iBusy ? "Lager kontroll ..." : "Neste")</button>
                            </span>
                        </div>
                    }
                    else if (_iSteg == 3)
                    {
                        <p class="pi-dempet">
                            <b>@_iForhandsvisning.Count(r => r.Feil is null && r.ErNyVare).ToString("N0", Kultur)</b> nye ·
                            <b>@_iForhandsvisning.Count(r => r.Feil is null && !r.ErNyVare).ToString("N0", Kultur)</b> oppdateres ·
                            <b>@_iForhandsvisning.Count(r => r.Feil is not null).ToString("N0", Kultur)</b> med feil (importeres ikke)
                        </p>
                        <div class="pi-tabell-ramme">
                            <div class="pi-tabell-scroll">
                                <table class="pi-tabell">
                                    <thead>
                                        <tr>
                                            <th class="pi-cb"></th>
                                            <th>Artikkelnr</th>
                                            <th>Navn</th>
                                            <th>Enhet</th>
                                            <th class="pi-n">Netto</th>
                                            <th class="pi-n">Veiledende</th>
                                            <th>Rabattgr.</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _iForhandsvisning.Take(_iVis))
                                        {
                                            <tr @key="r.RadNummer" class="@(r.Feil is not null ? "pi-av" : "")">
                                                <td class="pi-cb"><input type="checkbox" @bind="r.Inkluder" disabled="@(r.Feil is not null)" /></td>
                                                <td><span class="pi-kode">@r.Produktkode</span></td>
                                                <td>@(r.ErNyVare ? r.Navn : r.EksisterendeNavn)</td>
                                                <td>@r.Enhet</td>
                                                <td class="pi-n">@Kr(r.PrisNetto)@(r.NettoErBeregnet ? "*" : "")</td>
                                                <td class="pi-n">@Kr(r.PrisVeiledende)</td>
                                                <td>@r.RabattgruppeKode</td>
                                                <td>
                                                    @if (r.Feil is not null)
                                                    {
                                                        <span class="pi-st feil">@r.Feil</span>
                                                    }
                                                    else if (r.ErNyVare)
                                                    {
                                                        <span class="pi-st plan">Ny vare</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pi-st ok">Oppdateres</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_iForhandsvisning.Count > _iVis)
                            {
                                <div class="pi-flere">
                                    <span>Viser @_iVis.ToString("N0", Kultur) av @_iForhandsvisning.Count.ToString("N0", Kultur)</span>
                                    <button type="button" class="pi-knapp" @onclick="@(() => _iVis += 200)">Vis flere</button>
                                </div>
                            }
                        </div>
                        @if (_iForhandsvisning.Any(r => r.NettoErBeregnet))
                        {
                            <p class="pi-dempet">* Netto regnet ut fra veiledende pris og rabattgruppen.</p>
                        }
                        @if (!string.IsNullOrEmpty(_iFeil))
                        {
                            <p class="form-error">@_iFeil</p>
                        }
                        var antallImport = _iForhandsvisning.Count(r => r.Inkluder && r.Feil is null);
                        <div class="pi-lagrebar">
                            <span><b>@antallImport.ToString("N0", Kultur) @(antallImport == 1 ? "vare" : "varer")</b> importeres fra @lev.Navn</span>
                            <span class="pi-lagrebar-knapper">
                                <button type="button" class="pi-knapp" disabled="@_iBusy" @onclick="@(() => _iSteg = 2)">Tilbake</button>
                                <button type="button" class="pi-knapp primaer" disabled="@(_iBusy || antallImport == 0)" @onclick="Importer"><Icon Name="check" />@(_iBusy ? "Importerer ..." : "Importer")</button>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="pi-ferdig">
                            <b><Icon Name="check" />Ferdig</b>
                            <span>@_iNye.ToString("N0", Kultur) @(_iNye == 1 ? "ny vare" : "nye varer") lagt til (inaktive til du har sjekket dem) og @_iOppdatert.ToString("N0", Kultur) oppdatert.</span>
                            <button type="button" class="pi-knapp" @onclick="NullstillImport">Ny import</button>
                        </div>
                    }
                }
                else
                {
                    <div class="pi-tabell-ramme">
                        <table class="pi-tabell">
                            <thead>
                                <tr><th>Dato</th><th>Type</th><th>Fil</th><th>Resultat</th><th>Av</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _historikk)
                                {
                                    <tr @key="h.Id">
                                        <td class="pi-nowrap">@h.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@(h.Kilde == "Oppdater priser" ? "Prisoppdatering" : "Importer varer")</td>
                                        <td>@h.Filnavn</td>
                                        <td>@HistorikkResultat(h)</td>
                                        <td>@(h.OpprettetAvBruker?.Navn ?? "-")</td>
                                        <td><span class="pi-st @(h.Status == "Fullført" ? "ok" : h.Status == "Feilet" ? "feil" : "")">@h.Status</span></td>
                                        <td class="pi-n">
                                            @if (_slettendeHistorikkId == h.Id)
                                            {
                                                <span class="pi-knapperad">
                                                    <button type="button" class="pi-knapp fare" @onclick="@(() => SlettHistorikk(h))">Slett</button>
                                                    <button type="button" class="pi-knapp" @onclick="@(() => _slettendeHistorikkId = null)">Avbryt</button>
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" class="pi-ikon" title="Slett fra historikken" @onclick="@(() => _slettendeHistorikkId = h.Id)"><Icon Name="trash" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (_historikk.Count == 0)
                                {
                                    <tr><td colspan="7" class="pi-tom">Ingen importer eller prisoppdateringer for @lev.Navn ennå.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private const string KildePris = "Oppdater priser";
    private const string KildeImport = "Prisimport";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [SupplyParameterFromQuery(Name = "fane")] public string? FaneParam { get; set; }
    [SupplyParameterFromQuery(Name = "lev")] public int? LevParam { get; set; }

    private sealed record LevInfo(int Id, string Navn, int AntallVarer, DateTime? SistOppdatert);
    private sealed record PlanGruppe(DateTime Dato, int Antall);

    private int? _brukerId;
    private bool _full;
    private string _fane = "pris";
    private List<LevInfo> _leverandorer = [];
    private int? _valgtLevId;
    private string _levSok = "";
    private string _nyLevNavn = "";
    private List<PlanGruppe> _planlagt = [];
    private DateTime? _avbryterPlanDato;
    private List<Importhistorikk> _historikk = [];
    private int? _slettendeHistorikkId;

    private LevInfo? Valgt => _leverandorer.FirstOrDefault(l => l.Id == _valgtLevId);

    // ---------- Prisoppdatering ----------
    private int _pSteg = 1;
    private DateTime _pDato = DateTime.Today;
    private string? _pFilnavn;
    private string? _pFeil;
    private bool _pBusy;
    private bool _pHarHusket;
    private List<PrisimportService.ArkKolonne> _pKolonner = [];
    private List<string[]> _pRader = [];
    private string[]? _pEksempel;
    private PrisimportService.KolonneForslag _pValgt = new();
    private List<PrisoppdateringService.OppdateringRad> _pRaderVist = [];
    private string _pFilter = "endret";
    private int _pVis = 200;
    private (int Naa, int Planlagt) _pResultat;
    private Importhistorikk? _pHistorikk;

    // ---------- Importer varer ----------
    private int _iSteg = 1;
    private string? _iFilnavn;
    private string? _iFeil;
    private bool _iBusy;
    private bool _iHarHusket;
    private List<PrisimportService.ArkKolonne> _iKolonner = [];
    private List<string[]> _iRader = [];
    private string[]? _iEksempel;
    private PrisimportService.KolonneForslag _iValgt = new();
    private List<PrisimportService.ImportRad> _iForhandsvisning = [];
    private int _iVis = 200;
    private int _iNye;
    private int _iOppdatert;
    private Importhistorikk? _iHistorikk;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var bid))
            {
                _brukerId = bid;
            }
        }

        _full = await VisningPref.HentAsync("prisimport-bredde", "normal") == "full";
        // /komponenter/oppdater-priser (gammel adresse) og standard åpner Prisoppdatering.
        _fane = FaneParam is "import" or "hist" ? FaneParam : "pris";

        await LastLeverandorerAsync();
        var start = LevParam is int lp && _leverandorer.Any(l => l.Id == lp) ? lp : _leverandorer.FirstOrDefault()?.Id;
        if (start is int s)
        {
            await VelgLeverandor(s);
        }
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("prisimport-bredde", _full ? "full" : "normal");
    }

    private async Task LastLeverandorerAsync()
    {
        var lev = await Db.Leverandorer
            .OrderBy(l => l.Navn)
            .Select(l => new { l.Id, l.Navn })
            .ToListAsync();
        var antall = await Db.ComponentLeverandorer
            .GroupBy(l => l.LeverandorId)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);

        // Sist oppdaterte prisliste per leverandør (importhistorikken lagrer navnet).
        var sist = (await Db.Importhistorikk
                .Where(h => h.Status == "Fullført" && h.Leverandor != null && (h.Kilde == KildePris || h.Kilde == KildeImport))
                .Select(h => new { h.Leverandor, h.OpprettetDato })
                .ToListAsync())
            .GroupBy(h => h.Leverandor!.Trim().ToLowerInvariant())
            .ToDictionary(g => g.Key, g => g.Max(h => h.OpprettetDato));

        _leverandorer = lev
            .Select(l => new LevInfo(l.Id, l.Navn, antall.GetValueOrDefault(l.Id), sist.TryGetValue(l.Navn.Trim().ToLowerInvariant(), out var d) ? d : null))
            .ToList();
    }

    private static bool ErGammel(LevInfo l) => l.AntallVarer > 0 && (l.SistOppdatert is null || l.SistOppdatert < DateTime.Today.AddYears(-1));

    private static string Initialer(string navn) =>
        string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    private async Task VelgLeverandor(int id)
    {
        if (_valgtLevId == id)
        {
            return;
        }

        await MarkerAvbruttAsync();
        _valgtLevId = id;
        NullstillPris();
        NullstillImport();
        _pHarHusket = await HentMappingAsync(KildePris) is not null;
        await LastPlanlagtOgHistorikkAsync();
    }

    private async Task LastPlanlagtOgHistorikkAsync()
    {
        if (Valgt is not { } lev)
        {
            _planlagt = [];
            _historikk = [];
            return;
        }

        var navn = lev.Navn.ToLower();
        _planlagt = (await Db.PlanlagtePrisendringer
                .Where(p => !p.Utfort && (p.LeverandorId == lev.Id || (p.LeverandorId == null && p.Kilde != null && p.Kilde.ToLower() == navn)))
                .Select(p => p.GjelderFraDato)
                .ToListAsync())
            .GroupBy(d => d.Date)
            .OrderBy(g => g.Key)
            .Select(g => new PlanGruppe(g.Key, g.Count()))
            .ToList();

        _historikk = await Db.Importhistorikk
            .Include(h => h.OpprettetAvBruker)
            .Where(h => (h.Kilde == KildePris || h.Kilde == KildeImport) && h.Leverandor != null && h.Leverandor.ToLower() == navn)
            .OrderByDescending(h => h.OpprettetDato)
            .Take(50)
            .ToListAsync();
    }

    private async Task OpprettLeverandor()
    {
        var navn = _nyLevNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var lev = await LeverandorSync.FinnEllerOpprettAsync(Db, navn);
        await Db.SaveChangesAsync();
        _nyLevNavn = "";
        _levSok = "";
        await LastLeverandorerAsync();
        await VelgLeverandor(lev.Id);
        _fane = "import";
    }

    private async Task AvbrytPlanlagt(DateTime dato)
    {
        if (Valgt is not { } lev)
        {
            return;
        }

        var navn = lev.Navn.ToLower();
        var fra = dato.Date;
        var til = fra.AddDays(1);
        await Db.PlanlagtePrisendringer
            .Where(p => !p.Utfort && p.GjelderFraDato >= fra && p.GjelderFraDato < til
                && (p.LeverandorId == lev.Id || (p.LeverandorId == null && p.Kilde != null && p.Kilde.ToLower() == navn)))
            .ExecuteDeleteAsync();
        _avbryterPlanDato = null;
        await LastPlanlagtOgHistorikkAsync();
    }

    private async Task SlettHistorikk(Importhistorikk h)
    {
        // Rader som peker på denne som "opprinnelig import" mister bare koblingen.
        await Db.Importhistorikk.Where(x => x.OpprinneligImportId == h.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(x => x.OpprinneligImportId, (int?)null));
        Db.Importhistorikk.Remove(h);
        await Db.SaveChangesAsync();
        _slettendeHistorikkId = null;
        await LastPlanlagtOgHistorikkAsync();
    }

    private static string HistorikkResultat(Importhistorikk h) => h.Status != "Fullført"
        ? "-"
        : h.Kilde == KildePris
            ? $"{h.AntallOppdatert ?? 0:N0} nye priser av {h.AntallRader ?? 0:N0} rader"
            : $"{h.AntallNye ?? 0:N0} nye, {h.AntallOppdatert ?? 0:N0} oppdatert";

    // ---------- felles ----------
    private static readonly string[] StegNavn = ["Fil", "Kolonner", "Kontroll", "Ferdig"];

    private static RenderFragment StegLinje(int steg) => @<div class="pi-steg">
        @for (var i = 0; i < StegNavn.Length; i++)
        {
            var nr = i + 1;
            @if (i > 0)
            {
                <b></b>
            }
            <span class="@(nr < steg ? "ferdig" : nr == steg ? "pa" : "")"><i>@(nr < steg ? "✓" : nr.ToString())</i>@StegNavn[i]</span>
        }
    </div>;

    private static string Kr(decimal? v) => v?.ToString("N2", Kultur) ?? "–";

    private static string? Eksempel(string[]? rad, int? indeks) =>
        indeks is int i && rad is not null && i < rad.Length ? rad[i] : null;

    private static int? ParseIndeks(object? value) =>
        int.TryParse(value?.ToString(), out var i) ? i : null;

    private static string FullFeilmelding(Exception ex)
    {
        var meldinger = new List<string>();
        for (var e = ex; e is not null; e = e.InnerException)
        {
            meldinger.Add(e.Message);
        }

        return string.Join(" → ", meldinger);
    }

    private sealed class MappingRad
    {
        public required string Label { get; init; }
        public bool Krevd { get; init; }
        public required Func<int?> Get { get; init; }
        public required Action<int?> Set { get; init; }
    }

    private async Task<(List<PrisimportService.ArkKolonne>, List<string[]>, string)?> LesFilAsync(InputFileChangeEventArgs e, Action<string> feil)
    {
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            feil($"«{file.Name}» er for stor (maks 20 MB).");
            return null;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        buffer.Position = 0;
        try
        {
            var (kolonner, rader) = PrisimportSvc.LesFil(buffer);
            if (kolonner.Count == 0)
            {
                feil("Fant ingen data i filen.");
                return null;
            }

            return (kolonner, rader, file.Name);
        }
        catch (Exception ex)
        {
            feil($"Klarte ikke å lese filen: {ex.Message}");
            return null;
        }
    }

    // Kolonnevalgene fra forrige fullførte kjøring for samme leverandør.
    private async Task<PrisimportService.KolonneForslag?> HentMappingAsync(string kilde)
    {
        if (Valgt is not { } lev)
        {
            return null;
        }

        var navn = lev.Navn.Trim().ToLower();
        var json = await Db.Importhistorikk
            .Where(h => h.Kilde == kilde && h.Status == "Fullført" && h.Leverandor != null && h.Leverandor.ToLower() == navn && h.MappingJson != null)
            .OrderByDescending(h => h.OpprettetDato)
            .Select(h => h.MappingJson)
            .FirstOrDefaultAsync();
        if (json is null)
        {
            return null;
        }

        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<PrisimportService.KolonneForslag>(json);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private static bool Gyldig(int? indeks, int antall) => indeks is null || (indeks >= 0 && indeks < antall);

    private async Task<Importhistorikk> StartHistorikkAsync(string kilde, string filnavn)
    {
        var tidligere = await Db.Importhistorikk
            .Where(h => h.Kilde == kilde && h.Filnavn == filnavn)
            .OrderByDescending(h => h.OpprettetDato)
            .FirstOrDefaultAsync();
        var h = new Importhistorikk
        {
            Kilde = kilde,
            Filnavn = filnavn,
            Leverandor = Valgt?.Navn,
            OpprettetAvBrukerId = _brukerId,
            Status = "Pågår",
            OpprinneligImportId = tidligere is null ? null : (tidligere.OpprinneligImportId ?? tidligere.Id)
        };
        Db.Importhistorikk.Add(h);
        await Db.SaveChangesAsync();
        return h;
    }

    private async Task SettStatusAsync(Importhistorikk? h, string status)
    {
        if (h is null)
        {
            return;
        }

        try
        {
            h.Status = status;
            await Db.SaveChangesAsync();
        }
        catch
        {
            // Feilmeldingen fra selve jobben vises uansett.
        }
    }

    private async Task MarkerAvbruttAsync()
    {
        if (_pHistorikk is { Status: "Pågår" })
        {
            await SettStatusAsync(_pHistorikk, "Avbrutt");
        }

        if (_iHistorikk is { Status: "Pågår" })
        {
            await SettStatusAsync(_iHistorikk, "Avbrutt");
        }
    }

    // ---------- Prisoppdatering ----------
    private List<MappingRad> PrisMapping() =>
    [
        new() { Label = "Varenummer", Krevd = true, Get = () => _pValgt.Produktkode, Set = v => _pValgt.Produktkode = v },
        new() { Label = "GTIN/EAN (reserve)", Get = () => _pValgt.Gtin, Set = v => _pValgt.Gtin = v },
        new() { Label = "Pris netto", Get = () => _pValgt.PrisNetto, Set = v => _pValgt.PrisNetto = v },
        new() { Label = "Pris veiledende", Get = () => _pValgt.PrisVeiledende, Set = v => _pValgt.PrisVeiledende = v },
    ];

    private IEnumerable<PrisoppdateringService.OppdateringRad> PFiltrert() => _pFilter switch
    {
        "lik" => _pRaderVist.Where(r => r.Feil is null && !r.ErEndret),
        "ikke" => _pRaderVist.Where(r => r.Feil is not null),
        _ => _pRaderVist.Where(r => r.Feil is null && r.ErEndret).OrderByDescending(r => Math.Abs(r.EndringProsent ?? 0))
    };

    private void SettPFilter(string filter)
    {
        _pFilter = filter;
        _pVis = 200;
    }

    private void VelgAllePriser(bool valgt)
    {
        foreach (var r in _pRaderVist.Where(r => r.Feil is null && r.ErEndret))
        {
            r.Inkluder = valgt;
        }
    }

    private async Task LastOppPrisliste(InputFileChangeEventArgs e)
    {
        _pFeil = null;
        if (await LesFilAsync(e, f => _pFeil = f) is not { } fil)
        {
            return;
        }

        var (kolonner, rader, filnavn) = fil;

        _pKolonner = kolonner;
        _pRader = rader;
        _pFilnavn = filnavn;
        _pEksempel = rader.FirstOrDefault();

        var auto = PrisimportService.AutoMatchKolonner(kolonner);
        var husket = await HentMappingAsync(KildePris);
        _pHarHusket = husket is not null && husket.Produktkode is not null
            && new[] { husket.Produktkode, husket.Gtin, husket.PrisNetto, husket.PrisVeiledende }.All(i => Gyldig(i, kolonner.Count));
        _pValgt = _pHarHusket
            ? new PrisimportService.KolonneForslag { Produktkode = husket!.Produktkode, Gtin = husket.Gtin, PrisNetto = husket.PrisNetto, PrisVeiledende = husket.PrisVeiledende }
            : new PrisimportService.KolonneForslag { Produktkode = auto.Produktkode, Gtin = auto.Gtin, PrisNetto = auto.PrisNetto, PrisVeiledende = auto.PrisVeiledende };

        _pHistorikk = await StartHistorikkAsync(KildePris, filnavn);
        _pSteg = 2;
    }

    private async Task ForhandsvisPriser()
    {
        if (Valgt is not { } lev)
        {
            return;
        }

        if (_pValgt.Produktkode is null && _pValgt.Gtin is null)
        {
            _pFeil = "Velg hvilken kolonne som er varenummer (eller GTIN/EAN).";
            return;
        }

        if (_pValgt.PrisNetto is null && _pValgt.PrisVeiledende is null)
        {
            _pFeil = "Velg minst én priskolonne.";
            return;
        }

        _pFeil = null;
        _pBusy = true;
        try
        {
            _pRaderVist = await PrisoppdateringSvc.ForhandsvisAsync(_pRader, lev.Id, _pValgt.Produktkode, _pValgt.Gtin, _pValgt.PrisNetto, _pValgt.PrisVeiledende);
            if (_pRaderVist.Count == 0)
            {
                _pFeil = "Fant ingen rader med varenummer i filen.";
                return;
            }

            _pFilter = _pRaderVist.Any(r => r.ErEndret) ? "endret" : _pRaderVist.Any(r => r.Feil is null) ? "lik" : "ikke";
            _pVis = 200;
            _pSteg = 3;
        }
        catch (Exception ex)
        {
            _pFeil = $"Klarte ikke å sjekke prisene: {FullFeilmelding(ex)}";
            await SettStatusAsync(_pHistorikk, "Feilet");
        }
        finally
        {
            _pBusy = false;
        }
    }

    private async Task OppdaterPriser()
    {
        if (Valgt is not { } lev)
        {
            return;
        }

        _pFeil = null;
        _pBusy = true;
        try
        {
            _pResultat = await PrisoppdateringSvc.OppdaterAsync(_pRaderVist, _pDato, lev.Id, lev.Navn);
            if (_pHistorikk is not null)
            {
                _pHistorikk.Status = "Fullført";
                _pHistorikk.AntallRader = _pRaderVist.Count;
                _pHistorikk.AntallOppdatert = _pResultat.Naa + _pResultat.Planlagt;
                _pHistorikk.MappingJson = System.Text.Json.JsonSerializer.Serialize(_pValgt);
                await Db.SaveChangesAsync();
            }

            _pSteg = 4;
            await LastLeverandorerAsync();
            await LastPlanlagtOgHistorikkAsync();
        }
        catch (Exception ex)
        {
            _pFeil = $"Prisoppdateringen feilet: {FullFeilmelding(ex)}. Du kan trygt prøve igjen.";
            await SettStatusAsync(_pHistorikk, "Feilet");
        }
        finally
        {
            _pBusy = false;
        }
    }

    private async Task AvbrytPrisoppdatering()
    {
        await SettStatusAsync(_pHistorikk, "Avbrutt");
        NullstillPris();
        await LastPlanlagtOgHistorikkAsync();
    }

    private void NullstillPris()
    {
        _pSteg = 1;
        _pFeil = null;
        _pFilnavn = null;
        _pKolonner = [];
        _pRader = [];
        _pEksempel = null;
        _pValgt = new();
        _pRaderVist = [];
        _pHistorikk = null;
        _pDato = DateTime.Today;
    }

    // ---------- Importer varer ----------
    private List<MappingRad> ImportMapping() =>
    [
        new() { Label = "Artikkelnr", Krevd = true, Get = () => _iValgt.Produktkode, Set = v => _iValgt.Produktkode = v },
        new() { Label = "GTIN/EAN", Get = () => _iValgt.Gtin, Set = v => _iValgt.Gtin = v },
        new() { Label = "Varenavn 1", Get = () => _iValgt.Navn, Set = v => _iValgt.Navn = v },
        new() { Label = "Varenavn 2", Get = () => _iValgt.Navn2, Set = v => _iValgt.Navn2 = v },
        new() { Label = "Beskrivelse", Get = () => _iValgt.Beskrivelse, Set = v => _iValgt.Beskrivelse = v },
        new() { Label = "Varegruppe", Get = () => _iValgt.Varegruppe, Set = v => _iValgt.Varegruppe = v },
        new() { Label = "Overflate", Get = () => _iValgt.Overflate, Set = v => _iValgt.Overflate = v },
        new() { Label = "Konsept", Get = () => _iValgt.Konsept, Set = v => _iValgt.Konsept = v },
        new() { Label = "Komponenttype", Get = () => _iValgt.Komponenttype, Set = v => _iValgt.Komponenttype = v },
        new() { Label = "Produktgruppe", Get = () => _iValgt.Produktgruppe, Set = v => _iValgt.Produktgruppe = v },
        new() { Label = "Enhet (1 = Stk, 2 = Par, 3 = M, 4 = Sett)", Get = () => _iValgt.Enhet, Set = v => _iValgt.Enhet = v },
        new() { Label = "Pris netto", Get = () => _iValgt.PrisNetto, Set = v => _iValgt.PrisNetto = v },
        new() { Label = "Pris veiledende", Get = () => _iValgt.PrisVeiledende, Set = v => _iValgt.PrisVeiledende = v },
        new() { Label = "Rabattgruppe", Get = () => _iValgt.Rabattgruppe, Set = v => _iValgt.Rabattgruppe = v },
        new() { Label = "Lager (J/N)", Get = () => _iValgt.Lager, Set = v => _iValgt.Lager = v },
        new() { Label = "Aktiv/Inaktiv (A/I)", Get = () => _iValgt.Inaktiv, Set = v => _iValgt.Inaktiv = v },
    ];

    private async Task LastOppVareliste(InputFileChangeEventArgs e)
    {
        _iFeil = null;
        if (await LesFilAsync(e, f => _iFeil = f) is not { } fil)
        {
            return;
        }

        var (kolonner, rader, filnavn) = fil;

        _iKolonner = kolonner;
        _iRader = rader;
        _iFilnavn = filnavn;
        _iEksempel = rader.FirstOrDefault();

        var husket = await HentMappingAsync(KildeImport);
        _iHarHusket = husket is not null && husket.Produktkode is not null && Gyldig(husket.Produktkode, kolonner.Count)
            && new[] { husket.Gtin, husket.Navn, husket.Navn2, husket.Beskrivelse, husket.Varegruppe, husket.Overflate, husket.Konsept, husket.Enhet, husket.PrisNetto, husket.PrisVeiledende, husket.Lager, husket.Inaktiv, husket.Rabattgruppe, husket.Komponenttype, husket.Produktgruppe }
                .All(i => Gyldig(i, kolonner.Count));
        _iValgt = _iHarHusket ? husket! : PrisimportService.AutoMatchKolonner(kolonner);

        _iHistorikk = await StartHistorikkAsync(KildeImport, filnavn);
        _iSteg = 2;
    }

    private async Task ForhandsvisImport()
    {
        if (Valgt is not { } lev)
        {
            return;
        }

        if (_iValgt.Produktkode is null)
        {
            _iFeil = "Velg hvilken kolonne som er Artikkelnr - den brukes til å finne varene som finnes fra før.";
            return;
        }

        _iFeil = null;
        _iBusy = true;
        try
        {
            _iForhandsvisning = await PrisimportSvc.ForhandsvisAsync(_iRader, lev.Navn, _iValgt);
            if (_iForhandsvisning.Count == 0)
            {
                _iFeil = "Fant ingen gyldige rader å importere.";
                return;
            }

            _iVis = 200;
            _iSteg = 3;
        }
        catch (Exception ex)
        {
            _iFeil = $"Klarte ikke å lage kontrollen: {FullFeilmelding(ex)}";
            await SettStatusAsync(_iHistorikk, "Feilet");
        }
        finally
        {
            _iBusy = false;
        }
    }

    private async Task Importer()
    {
        if (Valgt is not { } lev)
        {
            return;
        }

        _iFeil = null;
        _iBusy = true;
        try
        {
            (_iOppdatert, _iNye) = await PrisimportSvc.ImporterAsync(_iForhandsvisning, lev.Navn);
            if (_iHistorikk is not null)
            {
                _iHistorikk.Status = "Fullført";
                _iHistorikk.AntallRader = _iForhandsvisning.Count;
                _iHistorikk.AntallNye = _iNye;
                _iHistorikk.AntallOppdatert = _iOppdatert;
                _iHistorikk.MappingJson = System.Text.Json.JsonSerializer.Serialize(_iValgt);
                await Db.SaveChangesAsync();
            }

            _iSteg = 4;
            await LastLeverandorerAsync();
            await LastPlanlagtOgHistorikkAsync();
        }
        catch (Exception ex)
        {
            // Importen kan trygt kjøres på nytt - varer som ble lagret før feilen dupliseres ikke.
            _iFeil = $"Importen feilet: {FullFeilmelding(ex)}. Du kan trygt prøve igjen.";
            await SettStatusAsync(_iHistorikk, "Feilet");
        }
        finally
        {
            _iBusy = false;
        }
    }

    private async Task AvbrytImport()
    {
        await SettStatusAsync(_iHistorikk, "Avbrutt");
        NullstillImport();
        await LastPlanlagtOgHistorikkAsync();
    }

    private void NullstillImport()
    {
        _iSteg = 1;
        _iFeil = null;
        _iFilnavn = null;
        _iKolonner = [];
        _iRader = [];
        _iEksempel = null;
        _iValgt = new();
        _iForhandsvisning = [];
        _iHistorikk = null;
    }
}
