@page "/komponenter/prisimport"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PrisimportService PrisimportSvc

<PageTitle>Prisimport</PageTitle>

<a class="back-link" href="/komponenter">← Tilbake til komponentregisteret</a>
<h1>Prisimport</h1>
<p class="section-hint">
    Last opp en prisliste (Excel) fra en leverandør. Varer som allerede finnes (matchet på produktkode og leverandør) får oppdatert pris. Nye produktkoder legges til som nye varer.
    Hvis en eksisterende vare har en <a href="/rabattgrupper">rabattgruppe</a> satt, beregnes nettopris automatisk fra veiledende pris i filen og rabattgruppens prosent - da trenger du ikke en egen netto-kolonne for de varene.
</p>

@if (_steg == 1)
{
    <div class="import-hero">
        <div class="import-card import-upload-card">
            <h2>Velg importfil</h2>
            <label class="import-dropzone">
                <InputFile OnChange="LastOppFil" accept=".xlsx" class="import-dropzone-input" />
                <div class="import-dropzone-content">
                    <span class="import-dropzone-ikon">📄</span>
                    <p><strong>Klikk for å velge fil</strong> eller dra og slipp den her</p>
                    <p class="import-dropzone-hint">Excel-fil (.xlsx)</p>
                </div>
            </label>
            <label class="import-leverandor-felt">
                Leverandør
                <input @bind="_leverandor" @bind:event="oninput" placeholder="F.eks. ASSA ABLOY" />
            </label>
            <p class="section-hint">Alle rader i filen regnes som fra denne leverandøren. Du kan fylle den ut før eller etter du velger fil - den må bare være fylt ut før du går videre til forhåndsvisning.</p>

            @if (!string.IsNullOrEmpty(_feil))
            {
                <p class="form-error">@_feil</p>
            }
        </div>

        <div class="import-card import-komigang-card">
            <h2>Kom i gang</h2>
            <ol>
                <li>Velg eller dra inn Excel-filen med prislisten.</li>
                <li>Skriv inn hvilken leverandør prislisten kommer fra.</li>
                <li>Match kolonnene i filen mot feltene i portalen - vi foreslår automatisk ut fra overskriftene.</li>
                <li>Se gjennom forhåndsvisningen og trykk Start import.</li>
            </ol>
        </div>
    </div>

    @if (_historikkRader.Count > 0)
    {
        <div class="import-card import-historikk-card">
            <h2>Tidligere importer</h2>
            <table class="import-historikk-table">
                <thead>
                    <tr>
                        <th>Fil</th>
                        <th>Leverandør</th>
                        <th>Dato</th>
                        <th>Av</th>
                        <th>Status</th>
                        <th>Resultat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rad in _historikkRader)
                    {
                        var h = rad.Item;
                        <tr @key="h.Id" class="@(rad.ErOppdatering ? "historikk-rad-oppdatering" : "")">
                            <td>@(rad.ErOppdatering ? "↳ " : "")@h.Filnavn</td>
                            <td>@h.Leverandor</td>
                            <td>@h.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(h.OpprettetAvBruker?.Navn ?? "-")</td>
                            <td><span class="import-status-badge @(h.Status == "Fullført" ? "import-status-badge-ok" : h.Status == "Avbrutt" ? "import-status-badge-uendret" : h.Status == "Feilet" ? "import-status-badge-feil" : "import-status-badge-pagar")">@(rad.ErOppdatering && h.Status == "Fullført" ? "Oppdatering" : h.Status)</span></td>
                            <td>@(h.AntallNye is not null ? $"{h.AntallNye} nye, {h.AntallOppdatert} oppdatert" : "-")</td>
                            <td class="historikk-actions">
                                @if (!string.IsNullOrWhiteSpace(h.Leverandor))
                                {
                                    <button type="button" class="cancel-button" title="Fyller inn leverandør og gjenbruker kolonnevalgene fra denne importen når du velger fil på nytt" @onclick="@(() => ApneTidligereImport(h))">Åpne</button>
                                }
                                @if (_slettendeHistorikkId == h.Id)
                                {
                                    <span class="fjern-bekreft">
                                        Er du sikker?
                                        <button type="button" class="remove-button" @onclick="@(() => SlettHistorikk(h))">Ja</button>
                                        <button type="button" class="cancel-button" @onclick="@(() => _slettendeHistorikkId = null)">Avbryt</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="cancel-button" @onclick="@(() => _slettendeHistorikkId = h.Id)">Slett</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <ul class="mobil-historikk-liste">
                @foreach (var rad in _historikkRader)
                {
                    var h = rad.Item;
                    <li @key="h.Id" class="mobil-historikk-kort @(rad.ErOppdatering ? "mobil-historikk-kort-oppdatering" : "")">
                        <div class="mobil-historikk-topp">
                            <span class="mobil-historikk-fil">@(rad.ErOppdatering ? "↳ " : "")@h.Filnavn</span>
                            <span class="import-status-badge @(h.Status == "Fullført" ? "import-status-badge-ok" : h.Status == "Avbrutt" ? "import-status-badge-uendret" : h.Status == "Feilet" ? "import-status-badge-feil" : "import-status-badge-pagar")">@(rad.ErOppdatering && h.Status == "Fullført" ? "Oppdatering" : h.Status)</span>
                        </div>
                        <div class="mobil-historikk-meta">
                            @h.Leverandor &middot; @h.OpprettetDato.ToString("dd.MM.yyyy HH:mm") &middot; @(h.OpprettetAvBruker?.Navn ?? "-")
                        </div>
                        @if (h.AntallNye is not null)
                        {
                            <div class="mobil-historikk-meta">@h.AntallNye nye, @h.AntallOppdatert oppdatert</div>
                        }
                        <div class="mobil-historikk-knapper">
                            @if (!string.IsNullOrWhiteSpace(h.Leverandor))
                            {
                                <button type="button" class="cancel-button" @onclick="@(() => ApneTidligereImport(h))">Åpne</button>
                            }
                            @if (_slettendeHistorikkId == h.Id)
                            {
                                <span class="fjern-bekreft">
                                    Er du sikker?
                                    <button type="button" class="remove-button" @onclick="@(() => SlettHistorikk(h))">Ja</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _slettendeHistorikkId = null)">Avbryt</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="cancel-button" @onclick="@(() => _slettendeHistorikkId = h.Id)">Slett</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
}
else if (_steg == 2)
{
    <div class="import-card import-info-card">
        <h2>@_filnavn</h2>
        <p class="section-hint">Fant @_rader.Count rad(er) og @_kolonner.Count kolonne(r) i filen.</p>
    </div>

    <div class="import-card import-mapping-card">
        <h2>Match kolonner</h2>
        <p class="section-hint">Vi har forsøkt å matche kolonnene i filen automatisk ut fra overskriftene - kontroller at de stemmer, og rett opp med nedtrekksmenyene der det trengs. Artikkelnr er obligatorisk.</p>

        <label class="import-leverandor-felt">
            Leverandør
            <input @bind="_leverandor" @bind:event="oninput" placeholder="F.eks. ASSA ABLOY" />
        </label>

        <table class="mapping-table">
            <thead>
                <tr>
                    <th>Felt i portalen</th>
                    <th>Kolonne i filen</th>
                    <th>Eksempel fra første rad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rad in MappingRader())
                {
                    <tr>
                        <td>
                            @rad.Label
                            @if (rad.Krevd)
                            {
                                <span class="krevd">*</span>
                            }
                        </td>
                        <td>
                            <select value="@(rad.Get()?.ToString() ?? "")" @onchange="@(e => rad.Set(ParseIndeks(e.Value)))">
                                <option value="">Ikke i bruk</option>
                                @foreach (var k in _kolonner)
                                {
                                    <option value="@k.Indeks">@k.Overskrift</option>
                                }
                            </select>
                            @if (rad.Get() is not null && rad.Get() == rad.AutoIndeks)
                            {
                                <span class="mapping-auto-badge">Auto-matchet</span>
                            }
                        </td>
                        <td class="mapping-eksempel">@Eksempel(rad.Get())</td>
                    </tr>
                }
            </tbody>
        </table>

        <ul class="mobil-mapping-liste">
            @foreach (var rad in MappingRader())
            {
                <li class="mobil-mapping-rad">
                    <div class="mobil-mapping-label">
                        @rad.Label
                        @if (rad.Krevd)
                        {
                            <span class="krevd">*</span>
                        }
                        @if (rad.Get() is not null && rad.Get() == rad.AutoIndeks)
                        {
                            <span class="mapping-auto-badge">Auto-matchet</span>
                        }
                    </div>
                    <select value="@(rad.Get()?.ToString() ?? "")" @onchange="@(e => rad.Set(ParseIndeks(e.Value)))">
                        <option value="">Ikke i bruk</option>
                        @foreach (var k in _kolonner)
                        {
                            <option value="@k.Indeks">@k.Overskrift</option>
                        }
                    </select>
                    @if (Eksempel(rad.Get()) is { } eksempel)
                    {
                        <span class="mobil-mapping-eksempel">Eksempel: @eksempel</span>
                    }
                </li>
            }
        </ul>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="VisForhandsvisning" disabled="@_forhandsviser">@(_forhandsviser ? "Lager forhåndsvisning, vennligst vent..." : "Neste")</button>
            <button type="button" class="cancel-button" @onclick="AvbrytImport">Avbryt</button>
            @if (!string.IsNullOrEmpty(_feil))
            {
                <span class="form-error">@_feil</span>
            }
        </div>
    </div>
}
else if (_steg == 3)
{
    <div class="import-card">
        <h2>Validering</h2>
        <p class="section-hint">Kontroller resultatet under før du starter importen. Rader med feil er markert i rødt og importeres ikke.</p>
        <div class="import-oppsummering">
            <span class="import-oppsummering-tall import-oppsummering-ok">@_forhandsvisning.Count(r => r.Feil is null && r.ErNyVare) nye</span>
            <span class="import-oppsummering-tall import-oppsummering-ok">@_forhandsvisning.Count(r => r.Feil is null && !r.ErNyVare) oppdateres</span>
            <span class="import-oppsummering-tall import-oppsummering-feil">@_forhandsvisning.Count(r => r.Feil is not null) ikke importert</span>
        </div>

        <table class="import-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Rad</th>
                    <th>Artikkelnr</th>
                    <th>Navn</th>
                    <th>Enhet</th>
                    <th>Pris netto</th>
                    <th>Pris veiledende</th>
                    <th>Rabattgruppe</th>
                    <th>Lager</th>
                    <th>Inaktiv</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _forhandsvisning)
                {
                    <tr @key="r.RadNummer" class="@(r.Feil is not null ? "import-rad-feil" : "import-rad-ok")">
                        <td><input type="checkbox" @bind="r.Inkluder" disabled="@(r.Feil is not null)" /></td>
                        <td>@r.RadNummer</td>
                        <td>@r.Produktkode</td>
                        <td>@(r.ErNyVare ? r.Navn : r.EksisterendeNavn)</td>
                        <td>@r.Enhet</td>
                        <td>
                            @(r.PrisNetto?.ToString("N2", Kultur))
                            @if (r.NettoErBeregnet)
                            {
                                <span class="import-beregnet" title="Beregnet fra veiledende pris og rabattgruppe">(beregnet)</span>
                            }
                        </td>
                        <td>@(r.PrisVeiledende?.ToString("N2", Kultur))</td>
                        <td>@r.RabattgruppeKode</td>
                        <td>@(r.LagervareVerdi is true ? "Ja" : r.LagervareVerdi is false ? "Nei" : "")</td>
                        <td>@(r.AktivVerdi is true ? "Aktiv" : r.AktivVerdi is false ? "Inaktiv" : "")</td>
                        <td>
                            @if (r.Feil is not null)
                            {
                                <span class="import-status-badge import-status-badge-feil">@r.Feil</span>
                            }
                            else if (r.ErNyVare)
                            {
                                <span class="import-status-badge import-status-badge-ok">Ny vare</span>
                            }
                            else
                            {
                                <span class="import-status-badge import-status-badge-ok">Oppdaterer</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <ul class="mobil-import-liste">
            @foreach (var r in _forhandsvisning)
            {
                <li @key="r.RadNummer" class="mobil-import-kort @(r.Feil is not null ? "mobil-import-kort-feil" : "")">
                    <div class="mobil-import-topp">
                        <input type="checkbox" @bind="r.Inkluder" disabled="@(r.Feil is not null)" />
                        <span class="mobil-import-artikkel">@r.Produktkode</span>
                        @if (r.Feil is not null)
                        {
                            <span class="import-status-badge import-status-badge-feil">@r.Feil</span>
                        }
                        else if (r.ErNyVare)
                        {
                            <span class="import-status-badge import-status-badge-ok">Ny vare</span>
                        }
                        else
                        {
                            <span class="import-status-badge import-status-badge-ok">Oppdaterer</span>
                        }
                    </div>
                    <div class="mobil-import-navn">@(r.ErNyVare ? r.Navn : r.EksisterendeNavn)</div>
                    <div class="mobil-import-meta">
                        Rad @r.RadNummer &middot; @r.Enhet
                        @if (!string.IsNullOrWhiteSpace(r.RabattgruppeKode))
                        {
                            <text> &middot; Rabattgruppe @r.RabattgruppeKode</text>
                        }
                    </div>
                    <div class="mobil-import-priser">
                        <span>Netto: @(r.PrisNetto?.ToString("N2", Kultur) ?? "-")@(r.NettoErBeregnet ? " (beregnet)" : "")</span>
                        <span>Veiledende: @(r.PrisVeiledende?.ToString("N2", Kultur) ?? "-")</span>
                    </div>
                    @if (r.LagervareVerdi is not null || r.AktivVerdi is not null)
                    {
                        <div class="mobil-import-meta">
                            @if (r.LagervareVerdi is not null)
                            {
                                <text>Lager: @(r.LagervareVerdi is true ? "Ja" : "Nei")</text>
                            }
                            @if (r.AktivVerdi is not null)
                            {
                                <text> &middot; @(r.AktivVerdi is true ? "Aktiv" : "Inaktiv")</text>
                            }
                        </div>
                    }
                </li>
            }
        </ul>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Importer" disabled="@_importerer">
                @(_importerer ? "Importerer, vennligst vent..." : $"Start import ({_forhandsvisning.Count(r => r.Inkluder && r.Feil is null)} vare(r))")
            </button>
            <button type="button" class="cancel-button" @onclick="@(() => _steg = 2)" disabled="@_importerer">Tilbake</button>
            @if (!string.IsNullOrEmpty(_feil))
            {
                <span class="form-error">@_feil</span>
            }
        </div>
    </div>
}
else if (_steg == 4)
{
    <div class="import-card">
        <h2>Ferdig</h2>
        <p class="save-success">@_oppdatertAntall pris(er) oppdatert. @_nyeAntall ny(e) vare(r) lagt til.</p>
        <button type="button" class="save-button" @onclick="NyImport">Ny import</button>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private int _steg = 1;
    private string _leverandor = "";
    private string? _feil;
    private string? _filnavn;

    private List<PrisimportService.ArkKolonne> _kolonner = [];
    private List<string[]> _rader = [];
    private string[]? _radeksempel;

    private PrisimportService.KolonneForslag _valgt = new();
    private PrisimportService.KolonneForslag _autoForslag = new();

    private string? Eksempel(int? kolIndeks) =>
        kolIndeks is not null && _radeksempel is not null && kolIndeks.Value < _radeksempel.Length
            ? _radeksempel[kolIndeks.Value]
            : null;

    private static int? ParseIndeks(object? value)
    {
        var s = value?.ToString();
        return string.IsNullOrEmpty(s) ? null : int.Parse(s);
    }

    private sealed class MappingRad
    {
        public required string Label { get; init; }
        public bool Krevd { get; init; }
        public required Func<int?> Get { get; init; }
        public required Action<int?> Set { get; init; }
        public int? AutoIndeks { get; init; }
    }

    private List<MappingRad> MappingRader() =>
    [
        new() { Label = "Artikkelnr", Krevd = true, Get = () => _valgt.Produktkode, Set = v => _valgt.Produktkode = v, AutoIndeks = _autoForslag.Produktkode },
        new() { Label = "GTIN/EAN", Get = () => _valgt.Gtin, Set = v => _valgt.Gtin = v, AutoIndeks = _autoForslag.Gtin },
        new() { Label = "Varenavn 1", Get = () => _valgt.Navn, Set = v => _valgt.Navn = v, AutoIndeks = _autoForslag.Navn },
        new() { Label = "Varenavn 2", Get = () => _valgt.Navn2, Set = v => _valgt.Navn2 = v, AutoIndeks = _autoForslag.Navn2 },
        new() { Label = "Beskrivelse", Get = () => _valgt.Beskrivelse, Set = v => _valgt.Beskrivelse = v, AutoIndeks = _autoForslag.Beskrivelse },
        new() { Label = "Varegruppe", Get = () => _valgt.Varegruppe, Set = v => _valgt.Varegruppe = v, AutoIndeks = _autoForslag.Varegruppe },
        new() { Label = "Overflate", Get = () => _valgt.Overflate, Set = v => _valgt.Overflate = v, AutoIndeks = _autoForslag.Overflate },
        new() { Label = "Konsept", Get = () => _valgt.Konsept, Set = v => _valgt.Konsept = v, AutoIndeks = _autoForslag.Konsept },
        new() { Label = "Komponenttype", Get = () => _valgt.Komponenttype, Set = v => _valgt.Komponenttype = v, AutoIndeks = _autoForslag.Komponenttype },
        new() { Label = "Produktgruppe", Get = () => _valgt.Produktgruppe, Set = v => _valgt.Produktgruppe = v, AutoIndeks = _autoForslag.Produktgruppe },
        new() { Label = "Enhet (1 = Stk, 2 = Par, 3 = M, 4 = Sett)", Get = () => _valgt.Enhet, Set = v => _valgt.Enhet = v, AutoIndeks = _autoForslag.Enhet },
        new() { Label = "Pris netto", Get = () => _valgt.PrisNetto, Set = v => _valgt.PrisNetto = v, AutoIndeks = _autoForslag.PrisNetto },
        new() { Label = "Pris veiledende", Get = () => _valgt.PrisVeiledende, Set = v => _valgt.PrisVeiledende = v, AutoIndeks = _autoForslag.PrisVeiledende },
        new() { Label = "Rabattgruppe", Get = () => _valgt.Rabattgruppe, Set = v => _valgt.Rabattgruppe = v, AutoIndeks = _autoForslag.Rabattgruppe },
        new() { Label = "Lager (J = lagervare, N = ikke lagervare)", Get = () => _valgt.Lager, Set = v => _valgt.Lager = v, AutoIndeks = _autoForslag.Lager },
        new() { Label = "Aktiv/Inaktiv (A = aktiv, I = inaktiv)", Get = () => _valgt.Inaktiv, Set = v => _valgt.Inaktiv = v, AutoIndeks = _autoForslag.Inaktiv },
    ];

    private List<PrisimportService.ImportRad> _forhandsvisning = [];
    private int _oppdatertAntall;
    private int _nyeAntall;
    private bool _importerer;
    private bool _forhandsviser;

    private sealed record HistorikkRad(Importhistorikk Item, bool ErOppdatering);

    private List<HistorikkRad> _historikkRader = [];
    private Importhistorikk? _gjeldendeHistorikk;
    private int? _slettendeHistorikkId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        await LastHistorikkAsync();
    }

    private async Task LastHistorikkAsync()
    {
        // Grupperer i minnet: alle rader med samme "rot" (satt i LastOppFil
        // når filnavnet matcher en tidligere import) havner i samme gruppe,
        // vist som rot-raden pluss dens "Oppdatering"-rader under. Grupperes
        // etter siste aktivitet i gruppen, ikke bare rotens egen dato, slik
        // at en fersk oppdatering av en gammel fil fortsatt dukker øverst.
        var alle = await Db.Importhistorikk
            .Include(h => h.OpprettetAvBruker)
            .Where(h => h.Kilde == "Prisimport")
            .OrderByDescending(h => h.OpprettetDato)
            .Take(100)
            .ToListAsync();

        var grupper = alle
            .GroupBy(h => h.OpprinneligImportId ?? h.Id)
            .Select(g =>
            {
                var sortert = g.OrderByDescending(h => h.OpprettetDato).ToList();
                var rot = sortert.FirstOrDefault(h => h.Id == g.Key) ?? sortert[^1];
                var oppdateringer = sortert.Where(h => h.Id != rot.Id).ToList();
                return (Rot: rot, Oppdateringer: oppdateringer, SisteAktivitet: sortert[0].OpprettetDato);
            })
            .OrderByDescending(gr => gr.SisteAktivitet)
            .Take(15)
            .ToList();

        _historikkRader = grupper
            .SelectMany(gr => new[] { new HistorikkRad(gr.Rot, false) }
                .Concat(gr.Oppdateringer.Select(o => new HistorikkRad(o, true))))
            .ToList();
    }

    private async Task SlettHistorikk(Importhistorikk h)
    {
        Db.Importhistorikk.Remove(h);
        await Db.SaveChangesAsync();
        _slettendeHistorikkId = null;
        await LastHistorikkAsync();
    }

    private async Task<PrisimportService.KolonneForslag?> HentTidligereMappingAsync(string leverandor)
    {
        var trimmet = leverandor.Trim();
        var forrige = await Db.Importhistorikk
            .Where(h => h.Kilde == "Prisimport" && h.Status == "Fullført"
                && h.Leverandor != null && h.Leverandor.ToLower() == trimmet.ToLower()
                && h.MappingJson != null)
            .OrderByDescending(h => h.OpprettetDato)
            .FirstOrDefaultAsync();

        if (forrige?.MappingJson is null)
        {
            return null;
        }

        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<PrisimportService.KolonneForslag>(forrige.MappingJson);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private void ApneTidligereImport(Importhistorikk h)
    {
        _leverandor = h.Leverandor ?? "";
        _feil = null;
    }

    private async Task LastOppFil(InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;

        if (file.Size > 20_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        buffer.Position = 0;

        try
        {
            (_kolonner, _rader) = PrisimportSvc.LesFil(buffer);
        }
        catch (Exception ex)
        {
            _feil = $"Klarte ikke å lese filen: {ex.Message}";
            return;
        }

        if (_kolonner.Count == 0)
        {
            _feil = "Fant ingen data i filen.";
            return;
        }

        _filnavn = file.Name;
        _radeksempel = _rader.Count > 0 ? _rader[0] : null;

        _autoForslag = PrisimportService.AutoMatchKolonner(_kolonner);

        // Gjenbruker feltvalgene fra forrige fullførte import for SAMME
        // leverandør, hvis det finnes en - i stedet for kun å gjette ut fra
        // kolonneoverskriftene hver gang. Felt som sto som "Ikke i bruk" sist
        // (verdi null) forblir null her også, så ingenting blir rørt som ikke
        // uttrykkelig var valgt.
        var tidligereMapping = string.IsNullOrWhiteSpace(_leverandor) ? null : await HentTidligereMappingAsync(_leverandor);
        _valgt = tidligereMapping ?? PrisimportService.AutoMatchKolonner(_kolonner);

        // Er filnavnet helt likt en tidligere import, kobles denne kjøringen
        // automatisk som en "Oppdatering" under den opprinnelige i
        // historikken (se LastHistorikkAsync), i stedet for som en ny,
        // løsrevet rad.
        var tidligereMedSammeFil = await Db.Importhistorikk
            .Where(h => h.Kilde == "Prisimport" && h.Filnavn == _filnavn)
            .OrderByDescending(h => h.OpprettetDato)
            .FirstOrDefaultAsync();

        _gjeldendeHistorikk = new Importhistorikk
        {
            Kilde = "Prisimport",
            Filnavn = _filnavn,
            Leverandor = _leverandor,
            OpprettetAvBrukerId = _naverendeBrukerId,
            Status = "Pågår",
            OpprinneligImportId = tidligereMedSammeFil is null ? null : (tidligereMedSammeFil.OpprinneligImportId ?? tidligereMedSammeFil.Id)
        };
        Db.Importhistorikk.Add(_gjeldendeHistorikk);
        await Db.SaveChangesAsync();
        await LastHistorikkAsync();

        _steg = 2;
    }

    private async Task VisForhandsvisning()
    {
        if (_valgt.Produktkode is null)
        {
            _feil = "Du må velge hvilken kolonne som er Artikkelnr - den brukes til å matche mot eksisterende varer, og må derfor alltid være satt (kan ikke stå som \"Ikke i bruk\").";
            return;
        }

        if (string.IsNullOrWhiteSpace(_leverandor))
        {
            _feil = "Skriv inn hvilken leverandør prislisten kommer fra før du går videre.";
            return;
        }

        _forhandsviser = true;
        try
        {
            if (_gjeldendeHistorikk is not null)
            {
                _gjeldendeHistorikk.Leverandor = _leverandor;
                await Db.SaveChangesAsync();
            }

            _forhandsvisning = await PrisimportSvc.ForhandsvisAsync(_rader, _leverandor, _valgt);

            if (_forhandsvisning.Count == 0)
            {
                _feil = "Fant ingen gyldige rader å importere.";
                return;
            }

            _feil = null;
            _steg = 3;
        }
        catch (Exception ex)
        {
            // Fanges her av samme grunn som i Importer() - en ufanget
            // exception her drepte tidligere hele Blazor-kretsen med ingen
            // forklaring, og historikkraden ble stående som "Pågår" for alltid
            // siden Importer() aldri ble nådd.
            _feil = $"Klarte ikke å lage forhåndsvisning: {ex.Message}. Prøv gjerne på nytt.";
            // I egen try/catch - om DENNE lagringen også feiler (f.eks. samme
            // underliggende DB-problem som utløste feilen over), skal ikke
            // det i tillegg drepe kretsen og skjule _feil-meldingen over.
            try
            {
                if (_gjeldendeHistorikk is not null)
                {
                    _gjeldendeHistorikk.Status = "Feilet";
                    await Db.SaveChangesAsync();
                    await LastHistorikkAsync();
                }
            }
            catch
            {
                // Ignorerer - hovedfeilmeldingen over er allerede satt og vises uansett.
            }
        }
        finally
        {
            _forhandsviser = false;
        }
    }

    private async Task Importer()
    {
        _feil = null;
        _importerer = true;
        try
        {
            (_oppdatertAntall, _nyeAntall) = await PrisimportSvc.ImporterAsync(_forhandsvisning, _leverandor);

            if (_gjeldendeHistorikk is not null)
            {
                _gjeldendeHistorikk.Status = "Fullført";
                _gjeldendeHistorikk.AntallRader = _forhandsvisning.Count;
                _gjeldendeHistorikk.AntallNye = _nyeAntall;
                _gjeldendeHistorikk.AntallOppdatert = _oppdatertAntall;
                // Lagrer nøyaktig de feltvalgene som ble brukt - lar en senere
                // import for samme leverandør starte fra disse i stedet for kun
                // gjetting ut fra kolonneoverskrifter (se LastOppFil).
                _gjeldendeHistorikk.MappingJson = System.Text.Json.JsonSerializer.Serialize(_valgt);
                await Db.SaveChangesAsync();
                await LastHistorikkAsync();
            }

            _steg = 4;
        }
        catch (Exception ex)
        {
            // Fanges her i stedet for å la den sprette videre opp til Blazor
            // sin globale feilhåndtering - en ufanget exception i en
            // event-handler dreper hele kretsen (den kjente "An unhandled
            // error has occurred"-boksen), og da svarer ALLE knapper på siden
            // med ingenting til siden reloades. Import kan trygt kjøres på
            // nytt (se oppdaterings-logikken i ImporterAsync), så bruker
            // beholdes på steg 3 og kan bare prøve igjen.
            _feil = $"Importen feilet: {ex.Message}. Du kan trygt trykke Start import på nytt - varer som allerede ble lagret før feilen oppstod blir ikke duplisert.";
            // I egen try/catch - se samme resonnement i VisForhandsvisning().
            try
            {
                if (_gjeldendeHistorikk is not null)
                {
                    _gjeldendeHistorikk.Status = "Feilet";
                    await Db.SaveChangesAsync();
                    await LastHistorikkAsync();
                }
            }
            catch
            {
                // Ignorerer - hovedfeilmeldingen over er allerede satt og vises uansett.
            }
        }
        finally
        {
            _importerer = false;
        }
    }

    private async Task AvbrytImport()
    {
        if (_gjeldendeHistorikk is not null)
        {
            _gjeldendeHistorikk.Status = "Avbrutt";
            await Db.SaveChangesAsync();
            await LastHistorikkAsync();
        }

        NyImport();
    }

    private void NyImport()
    {
        _steg = 1;
        _leverandor = "";
        _feil = null;
        _filnavn = null;
        _kolonner = [];
        _rader = [];
        _radeksempel = null;
        _valgt = new();
        _autoForslag = new();
        _forhandsvisning = [];
        _gjeldendeHistorikk = null;
    }
}
