@page "/service-prisregler"
@page "/service-sjekklister"
@page "/serviceavtale-oppsett"
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Oppsett for serviceavtaler</PageTitle>

@* Prisregler for serviceavtaler (Prototype serviceavtaler komplett.html, fane
   "Kategorier og prisregler"): reglene i grå meny til venstre sortert etter
   prioritet, valgt regel til høyre med betingelser, pris og test mot dørene på
   alle serviceavtaler. Endringer vises med en gang i testen og lagres fra
   lagre-linjen. Regelmotoren ligger i ServiceRegelMotor. *@
<div class="spr @(_full ? "spr-full" : "")">
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="spr-ok">@_melding</p>
    }

    <div class="spr-kort">
        <div class="spr-topp">
            <span class="spr-ikon"><Icon Name="tag" /></span>
            <div class="spr-tittel">
                <div class="spr-smule"><NavLink href="/oppsettmodul">Oppsett</NavLink> / Serviceavtaler</div>
                <h1>Oppsett for serviceavtaler</h1>
            </div>
            <div class="spr-knapper">
                <button type="button" class="spr-knapp primaer" @onclick="NyRegel"><Icon Name="plus" />Ny regel</button>
                <button type="button" class="spr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="@(() => _full = !_full)">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>
        </div>

        <div class="spr-info">
            <span>Versjon <b>@(_versjoner.FirstOrDefault()?.Versjon.ToString() ?? "–")</b></span>
            <span>Aktive regler <b>@_regler.Count(r => r.Aktiv)</b></span>
            <span>Dører på serviceavtaler <b>@_dorer.Count</b></span>
            <span>Konflikter <b style="@(Konflikter.Count > 0 ? "color:#B42318" : "")">@Konflikter.Count</b></span>
            <span>Ikke kategorisert <b>@IkkeKategorisert.Count</b></span>
            <span>Brukes når prismodellen på avtalen er «Kategorier etter regler». Avtaleprisen endres ikke før den godkjennes på avtalen.</span>
        </div>

        <div class="spr-kropp">
            <nav class="spr-meny">
                <button type="button" class="spr-fane @(_visning is "tabell" or "regel" ? "pa" : "")" @onclick="@(() => _visning = "tabell")"><Icon Name="tag" /><span>Prisregler</span><em>@_regler.Count</em></button>
                <button type="button" class="spr-fane @(_visning == "ikke" ? "pa" : "")" @onclick="@(() => _visning = "ikke")"><Icon Name="alert" /><span>Ikke kategorisert</span><em>@IkkeKategorisert.Count</em></button>
                <button type="button" class="spr-fane @(_visning == "typer" ? "pa" : "")" @onclick="@(() => _visning = "typer")"><Icon Name="settings" /><span>Komponenttyper</span></button>
                <button type="button" class="spr-fane @(_visning == "punkter" ? "pa" : "")" @onclick="@(() => _visning = "punkter")"><Icon Name="check-circle" /><span>Sjekklister</span><em>@_punkter.Count</em></button>
                <button type="button" class="spr-fane @(_visning == "versjoner" ? "pa" : "")" @onclick="@(() => { _visning = "versjoner"; _valgtVersjon ??= _versjoner.FirstOrDefault(); })"><Icon Name="clock" /><span>Versjoner</span><em>@_versjoner.Count</em></button>
            </nav>

            <div class="spr-innhold">
                @if (Konflikter.Count > 0)
                {
                    <div class="spr-fare">
                        <div>
                            <b>@Konflikter.Count @(Konflikter.Count == 1 ? "dør treffer" : "dører treffer") to regler med samme prioritet</b>
                            <span>@string.Join(" · ", Konflikter.Take(6).Select(k => $"{k.Dor.Dornummer}: {string.Join(" / ", k.Konflikt.Select(x => x.Navn))}")). Den første regelen brukes til konflikten er løst – ingen dør prises dobbelt.</span>
                        </div>
                    </div>
                }

                @if (_visning == "tabell")
                {
                    @* PR1 (Prototype sjekklister og prisregler.html): én rad per regel. «Døren har»
                       = beslagene døren må ha. Øverste regel som passer vinner, så kombinasjonene
                       (f.eks. automatikk + sluttstykke) legges over enkeltbeslagene. *@
                    var rekke = Rekkefolge;
                    <p class="spr-dempet">Regelen passer når døren har <b>alle</b> beslagene i raden. Øverste regel som passer vinner – legg kombinasjonene øverst og enkeltbeslag under. Prisen er per dør per runde.</p>
                    <div class="spr-boks">
                        <div class="spr-tabell">
                            <table class="spr-pr1">
                                <thead><tr><th style="width:76px">Rekke</th><th style="width:190px">Kategori</th><th>Døren har</th><th style="text-align:right;width:120px">Pris per runde</th><th style="text-align:right;width:90px">Minutter</th><th style="text-align:right;width:60px">Dører</th><th style="width:76px"></th></tr></thead>
                                <tbody>
                                    @for (var i = 0; i < rekke.Count; i++)
                                    {
                                        var r = rekke[i];
                                        var idx = i;
                                        var reserve = ErReserve(r);
                                        var har = r.Betingelser.Where(b => !b.ErIkke).OrderBy(b => b.Rekkefolge).ToList();
                                        <tr @key="r" class="@(r.Aktiv ? "" : "spr-av")">
                                            <td class="spr-rekke">
                                                <b>@(i + 1)</b>
                                                @if (!reserve)
                                                {
                                                    <button type="button" class="spr-pil" title="Flytt opp" disabled="@(idx == 0)" @onclick="@(() => Flytt(r, -1))">↑</button>
                                                    <button type="button" class="spr-pil" title="Flytt ned" disabled="@(idx >= rekke.Count - 1 || ErReserve(rekke[idx + 1]))" @onclick="@(() => Flytt(r, 1))">↓</button>
                                                }
                                            </td>
                                            <td><input class="spr-in" value="@r.Navn" @onchange="@(e => { r.Navn = e.Value?.ToString()?.Trim() is { Length: > 0 } v ? v : r.Navn; Endret(); })" /></td>
                                            <td>
                                                @if (reserve)
                                                {
                                                    <span class="spr-hjelp">Alle andre dører</span>
                                                }
                                                else
                                                {
                                                    @for (var j = 0; j < har.Count; j++)
                                                    {
                                                        @if (j > 0) {<span class="spr-pluss">@(r.KreverAlle ? "+" : "eller")</span>}
                                                        <span class="spr-har">@(har[j].Felt == ServiceRegelFelt.Funksjon ? $"funksjon «{har[j].Verdi}»" : har[j].Verdi)</span>
                                                    }
                                                    @foreach (var b in r.Betingelser.Where(b => b.ErIkke))
                                                    {
                                                        <span class="spr-har ikke">ikke @b.Verdi</span>
                                                    }
                                                    <button type="button" class="spr-knapp liten" @onclick="@(() => _harRegel = r)">Endre</button>
                                                }
                                            </td>
                                            <td style="text-align:right"><input class="spr-in tall" inputmode="decimal" value="@r.Pris.ToString("0.##", Kultur)" @onchange="@(e => { if (LesTall(e.Value) is { } v) { r.Pris = v; Endret(); } })" /></td>
                                            <td style="text-align:right"><input class="spr-in tall" type="number" min="0" value="@r.Minutter" @onchange="@(e => { if (int.TryParse(e.Value?.ToString(), out var m) && m >= 0) { r.Minutter = m; Endret(); } })" /></td>
                                            <td style="text-align:right">@AntallMedKategori(r)</td>
                                            <td style="text-align:right;white-space:nowrap">
                                                <button type="button" class="spr-fjern" title="Avansert – alle innstillinger for regelen" @onclick="@(() => Velg(r))"><Icon Name="settings" /></button>
                                                @if (!reserve)
                                                {
                                                    <button type="button" class="spr-fjern" title="Slett regelen" @onclick="@(() => SlettRegel(r))"><Icon Name="x" /></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="spr-ny"><td></td><td colspan="6"><button type="button" class="spr-knapp primaer liten" @onclick="NyKombinasjon"><Icon Name="plus" />Ny regel</button></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    var test = TestDor();
                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Test en dør</h3><small>Trykk på beslagene en dør har</small></div>
                        <div class="spr-test">
                            <div class="spr-chips">
                                @foreach (var t in ServiceRegelMotor.Servicetyper)
                                {
                                    <button type="button" class="spr-chip @(_testTyper.Contains(t) ? "pa" : "")" @onclick="@(() => { if (!_testTyper.Remove(t)) { _testTyper.Add(t); } })">@t</button>
                                }
                            </div>
                            <div class="spr-test-res">
                                @if (test is null)
                                {
                                    <span>Ingen regel passer – døren får ingen pris.</span>
                                }
                                else
                                {
                                    <span>Treffer regel @(rekke.IndexOf(test) + 1)</span><span class="spr-har">@test.Navn</span><span class="spr-sp"></span><b>@Kr(test.Pris)</b><span>per runde · @test.Minutter min</span>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_visning == "punkter")
                {
                    @* T5 «Sjekklister per komponenttype»: punktene legges inn én gang per
                       servicetype, med krav/standard og fotokrav. Hver dør får punktene for
                       typene den har (også dører fra befaringen som bare har typer). Til høyre
                       vises sjekklisten en valgt dør får. *@
                    var typeKart = PunktTypeKart;
                    var valgtListe = _punkter.Where(x => x.DorId == null && x.Servicetype == _punktType).OrderBy(x => x.Rekkefolge).ToList();
                    <p class="spr-dempet">Kontrollpunktene legges inn én gang per komponenttype. Hver dør i en servicerunde får punktene for typene den har, og like punkter slås sammen. Endringer gjelder nye runder – runder som er startet, beholder punktene de fikk.</p>
                    <div class="spr-pk">
                        <div class="spr-boks spr-pk-typer">
                            @foreach (var type in ServiceRegelMotor.Servicetyper.Append(ServicerundeMotor.Generelt))
                            {
                                var n = _punkter.Count(x => x.DorId == null && x.Servicetype == type);
                                <button type="button" class="@(type == _punktType ? "pa" : "")" @onclick="@(() => _punktType = type)">@type<em>@n</em></button>
                            }
                        </div>
                        <div class="spr-boks">
                            <div class="spr-boks-t">
                                <h3>@_punktType</h3>
                                <small>@(_punktType == ServicerundeMotor.Generelt ? "Brukes på dører uten komponenttyper" : $"Brukes på {_dorer.Count(d => ServiceRegelMotor.TyperPaDor(d, typeKart).Contains(_punktType))} dører på avtalene")</small>
                            </div>
                            <div class="spr-pk-tab">
                                <div class="spr-pk-h"><span>Kontrollpunkt</span><span>Krav / standard</span><span>Foto</span><span></span></div>
                                @foreach (var k in valgtListe)
                                {
                                    <div class="spr-pk-rad" @key="k">
                                        <input value="@k.Tekst" @onchange="@(e => { if (!string.IsNullOrWhiteSpace(e.Value?.ToString())) { k.Tekst = e.Value!.ToString()!.Trim(); k.EndretDato = DateTime.Now; Endret(); } })" />
                                        <input value="@k.Standard" placeholder="F.eks. NS-EN 16005" @onchange="@(e => { k.Standard = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim(); k.EndretDato = DateTime.Now; Endret(); })" />
                                        <label title="Montøren skal ta bilde ved dette punktet"><input type="checkbox" checked="@k.KreverFoto" @onchange="@(e => { k.KreverFoto = e.Value is true; k.EndretDato = DateTime.Now; Endret(); })" /></label>
                                        <button type="button" class="spr-fjern" title="Fjern punktet" @onclick="@(() => FjernPunkt(k))"><Icon Name="x" /></button>
                                    </div>
                                }
                                <div class="spr-pk-rad">
                                    <input style="border-style:dashed" @key="@($"ny{_punktType}{_nyKey}")" placeholder="Nytt punkt – trykk Enter" @onchange="@(e => LeggTilPunkt(_punktType, e.Value?.ToString()))" />
                                </div>
                            </div>
                            @{ var tillegg = _punkter.Where(x => x.DorId != null).ToList(); }
                            @if (tillegg.Count > 0)
                            {
                                <div class="spr-pk-till">
                                    <b>Faste tillegg på enkeltdører</b>
                                    <small>Lagt til fra servicerunden («Fast på døren»). Gjelder bare den døren.</small>
                                    @foreach (var k in tillegg)
                                    {
                                        var dor = _dorer.FirstOrDefault(d => d.Id == k.DorId);
                                        <div class="spr-pk-trad" @key="k">
                                            <span class="spr-pk-dor">@(dor is null ? "Dør" : $"Dør {dor.Dornummer}")</span>
                                            <span>@k.Tekst@if (dor is not null) {<small> · @_prosjektNavn.GetValueOrDefault(dor.ProsjektId)</small>}</span>
                                            <button type="button" class="spr-fjern" title="Fjern tillegget" @onclick="@(() => FjernPunkt(k))"><Icon Name="x" /></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="spr-boks spr-pk-forh">
                            <div class="spr-boks-t"><h3>Slik blir sjekklisten på døren</h3></div>
                            <div class="spr-pk-forh-inn">
                                <select @bind="_forhDorId">
                                    <option value="">Velg dør …</option>
                                    @foreach (var d in _dorer.Take(400))
                                    {
                                        <option value="@d.Id">@d.Dornummer · @_prosjektNavn.GetValueOrDefault(d.ProsjektId)</option>
                                    }
                                </select>
                                @if (_dorer.FirstOrDefault(d => d.Id == _forhDorId) is { } fd)
                                {
                                    var typer = ServiceRegelMotor.TyperPaDor(fd, typeKart);
                                    <small>Typer: @(typer.Count == 0 ? "ingen (Generelt)" : string.Join(", ", ServiceRegelMotor.Servicetyper.Where(typer.Contains)))</small>
                                    @foreach (var pk in ServicerundeMotor.PunkterForDor(typer, _punkter, fd.Id))
                                    {
                                        <div class="spr-pk-p">
                                            <span>☐</span>
                                            <span>@pk.Tekst<small>@pk.Kilde@if (!string.IsNullOrWhiteSpace(pk.Standard)) {<em>@pk.Standard</em>}@if (pk.KreverFoto) {<em class="foto">Foto</em>}</small></span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <small>Velg en dør for å se punktene den får i neste runde.</small>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_visning == "versjoner")
                {
                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Versjoner av prisreglene</h3><small>Hver lagring blir en ny versjon. Godkjente avtaler beholder versjonen de ble godkjent med.</small></div>
                        <div class="spr-tabell">
                            <table>
                                <thead><tr><th>Versjon</th><th>Lagret</th><th>Av</th><th style="text-align:right">Regler</th><th style="text-align:right">Avtaler godkjent</th></tr></thead>
                                <tbody>
                                    @foreach (var v in _versjoner)
                                    {
                                        <tr @key="v.Id" style="cursor:pointer;@(_valgtVersjon == v ? "background:#EEF3FB" : "")" @onclick="@(() => _valgtVersjon = v)">
                                            <td><b>v@(v.Versjon)</b>@if (v == _versjoner.First()) { <span class="spr-pill gronn" style="margin-left:8px">Gjeldende</span> }</td>
                                            <td>@v.Dato.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@(v.AvNavn ?? "–")</td>
                                            <td style="text-align:right">@v.AntallRegler</td>
                                            <td style="text-align:right">@_avtalerPerVersjon.GetValueOrDefault(v.Versjon)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @if (_valgtVersjon is { } vv)
                    {
                        <div class="spr-boks">
                            <div class="spr-boks-t"><h3>Innhold i v@(vv.Versjon)</h3><small>Skrivebeskyttet kopi</small></div>
                            <div class="spr-tabell">
                                <table>
                                    <thead><tr><th>Prioritet</th><th>Kategori</th><th>Betingelser</th><th style="text-align:right">Pris</th><th style="text-align:right">Min</th></tr></thead>
                                    <tbody>
                                        @foreach (var r in ServiceRegelMotor.LesVersjon(vv.Innhold).OrderBy(r => r.Prioritet))
                                        {
                                            <tr>
                                                <td>@r.Prioritet</td>
                                                <td><b>@r.Navn</b>@if (!r.Aktiv) { <span class="spr-pill gra" style="margin-left:6px">Av</span> }</td>
                                                <td class="spr-hjelp">@(r.Betingelser.Count == 0 ? "Alle andre dører" : string.Join(r.KreverAlle ? " og " : " eller ", r.Betingelser.Where(b => !b.ErIkke).Select(b => b.Verdi)) + (r.Betingelser.Any(b => b.ErIkke) ? ", ikke " + string.Join(" / ", r.Betingelser.Where(b => b.ErIkke).Select(b => b.Verdi)) : ""))</td>
                                                <td style="text-align:right">@Kr(r.Pris)</td>
                                                <td style="text-align:right">@r.Minutter</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else if (_visning == "typer")
                {
                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Komponenttyper og servicetype</h3><small>Reglene ser på servicetypen – ikke produktnavnet</small></div>
                        <div class="spr-tabell">
                            <table>
                                <thead><tr><th>Komponenttype</th><th>Servicetype</th><th style="text-align:right">Varer</th></tr></thead>
                                <tbody>
                                    @foreach (var t in _typer)
                                    {
                                        var auto = ServiceRegelMotor.StandardServicetype(t.Navn);
                                        <tr @key="t.Id">
                                            <td>@t.Navn</td>
                                            <td>
                                                <select class="spr-verdi" value="@(t.Servicetype ?? "")" @onchange="@(e => SettServicetype(t, e.Value?.ToString()))">
                                                    <option value="">@(auto is null ? "Ingen" : $"Automatisk: {auto}")</option>
                                                    @foreach (var s in ServiceRegelMotor.Servicetyper)
                                                    {
                                                        <option value="@s">@s</option>
                                                    }
                                                </select>
                                            </td>
                                            <td style="text-align:right">@(_varerPerType.GetValueOrDefault(t.Id))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <p class="spr-dempet">«Sluttstykke 1» og lignende kan ikke utledes fra navnet. Sett servicetypen her hvis alle varene i typen er elektriske.</p>
                }
                else if (_visning == "ikke")
                {
                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Ikke kategorisert</h3><small>Ingen aktiv regel treffer – dørene får ingen pris før en regel dekker dem</small></div>
                        @if (IkkeKategorisert.Count == 0)
                        {
                            <p class="spr-dempet" style="padding:14px 16px">Alle dørene har kategori.</p>
                        }
                        else
                        {
                            <div class="spr-tabell">
                                <table>
                                    <thead><tr><th>Avtale</th><th>Dør</th><th>Servicetyper på døren</th></tr></thead>
                                    <tbody>
                                        @foreach (var k in IkkeKategorisert)
                                        {
                                            <tr><td>@ProsjektNavn(k.Dor.ProsjektId)</td><td><b>@k.Dor.Dornummer</b> @k.Dor.DorTil</td><td class="spr-hjelp">@(k.Resultat.Typer.Count == 0 ? "Ingen komponenter med servicetype" : string.Join(", ", k.Resultat.Typer))</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
                else if (_valgt is { } r)
                {
                    <button type="button" class="spr-knapp liten" style="justify-self:start" @onclick="@(() => _visning = "tabell")">&larr; Alle prisregler</button>
                    <div class="spr-klar">@Klartekst(r)</div>

                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Regel</h3><small>Navnet blir kategorien på prising og i tilbudet</small></div>
                        <div class="spr-skjema">
                            <label class="spr-felt s2">Navn<input value="@r.Navn" @onchange="@(e => { r.Navn = e.Value?.ToString()?.Trim() is { Length: > 0 } v ? v : r.Navn; Endret(); })" /></label>
                            <label class="spr-felt">Prioritet (1 = først)<input type="number" min="1" value="@r.Prioritet" @onchange="@(e => { if (int.TryParse(e.Value?.ToString(), out var p) && p > 0) { r.Prioritet = p; Endret(); } })" /></label>
                            <label class="spr-felt">Pris per dør per runde (kr)<input inputmode="decimal" value="@r.Pris.ToString("0.##", Kultur)" @onchange="@(e => { if (LesTall(e.Value) is { } v) { r.Pris = v; Endret(); } })" /></label>
                            <label class="spr-felt">Estimert tid per dør (min)<input type="number" min="0" value="@r.Minutter" @onchange="@(e => { if (int.TryParse(e.Value?.ToString(), out var m) && m >= 0) { r.Minutter = m; Endret(); } })" /></label>
                            <label class="spr-felt">Aktiv<span style="height:36px;display:flex;align-items:center"><button type="button" class="spr-bryter @(r.Aktiv ? "pa" : "")" title="Slå regelen av eller på" @onclick="@(() => { r.Aktiv = !r.Aktiv; Endret(); })"></button></span></label>
                            <label class="spr-felt s2">Tekst under kategorien i tilbudet (valgfritt)<input value="@r.Undertekst" placeholder="F.eks. inkl. resertifisering av CE" @onchange="@(e => { r.Undertekst = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim(); Endret(); })" /></label>
                        </div>
                    </div>

                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Når døren oppfyller</h3><small>@(r.Betingelser.Count == 0 ? "Ingen betingelser – regelen treffer alle dører som ikke traff en regel før" : "")</small></div>
                        <div class="spr-betg">
                            @{ var forsteHar = true; }
                            @foreach (var b in r.Betingelser.OrderBy(b => b.ErIkke).ThenBy(b => b.Rekkefolge).ToList())
                            {
                                var etikett = b.ErIkke ? "OG IKKE" : forsteHar ? "" : (r.KreverAlle ? "OG" : "ELLER");
                                if (!b.ErIkke) { forsteHar = false; }
                                <div class="spr-betg-rad" @key="b">
                                    <span class="spr-og @(b.ErIkke ? "r" : "") @(etikett == "" ? "skjult" : "")">@(etikett == "" ? "–" : etikett)</span>
                                    <select value="@b.Felt" @onchange="@(e => { b.Felt = e.Value?.ToString() ?? ServiceRegelFelt.Servicetype; if (b.Felt == ServiceRegelFelt.Servicetype && !ServiceRegelMotor.Servicetyper.Contains(b.Verdi)) { b.Verdi = ServiceRegelMotor.Servicetyper[0]; } Endret(); })">
                                        <option value="@ServiceRegelFelt.Servicetype">Komponenttype</option>
                                        <option value="@ServiceRegelFelt.Funksjon">Dørfunksjon inneholder</option>
                                    </select>
                                    <select value="@(b.ErIkke ? "ikke" : "har")" @onchange="@(e => { b.ErIkke = e.Value?.ToString() == "ikke"; Endret(); })">
                                        <option value="har">Er</option>
                                        <option value="ikke">Er ikke</option>
                                    </select>
                                    @if (b.Felt == ServiceRegelFelt.Funksjon)
                                    {
                                        <input value="@b.Verdi" placeholder="f.eks. rømning" @onchange="@(e => { if (!string.IsNullOrWhiteSpace(e.Value?.ToString())) { b.Verdi = e.Value!.ToString()!.Trim(); Endret(); } })" />
                                    }
                                    else
                                    {
                                        <select value="@b.Verdi" @onchange="@(e => { b.Verdi = e.Value?.ToString() ?? b.Verdi; Endret(); })">
                                            @foreach (var s in ServiceRegelMotor.Servicetyper)
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                    }
                                    <button type="button" class="spr-fjern" title="Fjern betingelsen" @onclick="@(() => FjernBetingelse(r, b))"><Icon Name="x" /></button>
                                </div>
                            }
                            <div class="spr-betg-rad" style="margin-top:4px">
                                <button type="button" class="spr-knapp" @onclick="@(() => LeggTilBetingelse(r, false))"><Icon Name="plus" />Legg til betingelse</button>
                                <button type="button" class="spr-knapp" @onclick="@(() => LeggTilBetingelse(r, true))"><Icon Name="plus" />Legg til ekskludering</button>
                                <span style="margin-left:auto" class="spr-hjelp">Betingelsene kobles med</span>
                                <span class="spr-seg">
                                    <button type="button" class="@(r.KreverAlle ? "pa" : "")" @onclick="@(() => { r.KreverAlle = true; Endret(); })">OG</button>
                                    <button type="button" class="@(!r.KreverAlle ? "pa" : "")" @onclick="@(() => { r.KreverAlle = false; Endret(); })">ELLER</button>
                                </span>
                            </div>
                        </div>
                    </div>

                    var treff = Alle.Where(x => x.Resultat.Treff.Contains(r)).Select(x => (x.Dor, Res: x.Resultat)).ToList();
                    <div class="spr-boks">
                        <div class="spr-boks-t"><h3>Test regel</h3><small>@treff.Count @(treff.Count == 1 ? "dør treffer" : "dører treffer") · @treff.Count(x => x.Res.Regel == r) får denne kategorien</small></div>
                        @if (treff.Count == 0)
                        {
                            <p class="spr-dempet" style="padding:14px 16px">Ingen dører på serviceavtalene treffer regelen.</p>
                        }
                        else
                        {
                            <div class="spr-tabell">
                                <table>
                                    <thead><tr><th>Avtale</th><th>Dør</th><th>Servicetyper</th><th>Får kategori</th></tr></thead>
                                    <tbody>
                                        @foreach (var x in treff.Take(60))
                                        {
                                            <tr>
                                                <td>@ProsjektNavn(x.Dor.ProsjektId)</td>
                                                <td><b>@x.Dor.Dornummer</b> @x.Dor.DorTil</td>
                                                <td class="spr-hjelp">@foreach (var t in x.Res.Typer) { <span class="@(r.Betingelser.Any(b => !b.ErIkke && b.Felt == ServiceRegelFelt.Servicetype && b.Verdi.Equals(t, StringComparison.OrdinalIgnoreCase)) ? "spr-uthev" : "")">@t </span> }</td>
                                                <td>
                                                    @if (x.Res.HarKonflikt && x.Res.Konflikt.Contains(r))
                                                    {
                                                        <span class="spr-pill rod">Konflikt</span>
                                                    }
                                                    else if (x.Res.Regel == r)
                                                    {
                                                        <span class="spr-pill gronn">Denne regelen</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="spr-hjelp">@x.Res.Kategori</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="spr-fare">
                        <div><b>Slett regelen</b><span>Avtaler som har godkjent pris beholder prisen. Dørene får ny kategori ved neste beregning.</span></div>
                        <button type="button" class="spr-knapp fare" @onclick="@(() => SlettRegel(r))"><Icon Name="trash" />Slett</button>
                    </div>
                }
                else
                {
                    <p class="spr-dempet">Velg en regel i menyen.</p>
                }
            </div>
        </div>
    </div>

    @if (_harRegel is { } hr)
    {
        var valgt = hr.Betingelser.Where(b => !b.ErIkke && b.Felt == ServiceRegelFelt.Servicetype).Select(b => b.Verdi).ToHashSet(StringComparer.OrdinalIgnoreCase);
        <div class="spr-bak" @onclick="@(() => _harRegel = null)">
            <div class="spr-dlg" @onclick:stopPropagation="true">
                <div class="spr-dlg-h"><b>Døren har – @hr.Navn</b><button type="button" class="spr-x" @onclick="@(() => _harRegel = null)">×</button></div>
                <div class="spr-dlg-b">
                    <span class="spr-hjelp">Kryss av beslagene døren må ha for å få denne regelen.</span>
                    <div class="spr-chips">
                        @foreach (var t in ServiceRegelMotor.Servicetyper)
                        {
                            <button type="button" class="spr-chip @(valgt.Contains(t) ? "pa" : "")" @onclick="@(() => VekslHar(hr, t))">@(valgt.Contains(t) ? "✓ " : "")@t</button>
                        }
                    </div>
                    <div class="spr-dlg-valg">
                        <span>Døren må ha</span>
                        <span class="spr-seg">
                            <button type="button" class="@(hr.KreverAlle ? "pa" : "")" @onclick="@(() => { hr.KreverAlle = true; Endret(); })">Alle</button>
                            <button type="button" class="@(!hr.KreverAlle ? "pa" : "")" @onclick="@(() => { hr.KreverAlle = false; Endret(); })">Minst én</button>
                        </span>
                    </div>
                    <div class="spr-dlg-sum">@(valgt.Count == 0 ? "Ingen beslag valgt" : string.Join(hr.KreverAlle ? " + " : " eller ", ServiceRegelMotor.Servicetyper.Where(valgt.Contains)))</div>
                    @if (hr.Betingelser.Any(b => b.Felt == ServiceRegelFelt.Funksjon || b.ErIkke))
                    {
                        <span class="spr-hjelp">Regelen har også dørfunksjon eller unntak – de endres under «Avansert».</span>
                    }
                </div>
                <div class="spr-dlg-f"><button type="button" class="spr-knapp primaer" @onclick="@(() => _harRegel = null)">Ferdig</button></div>
            </div>
        </div>
    }

    @if (_endret)
    {
        <div class="spr-lagrebar">
            <span><Icon Name="edit" /><b>Ulagrede endringer</b> – testen viser allerede resultatet</span>
            <span class="spr-knapperad">
                <button type="button" class="spr-knapp" @onclick="Angre">Angre</button>
                <button type="button" class="spr-knapp primaer" @onclick="Lagre"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private List<ServicePrisRegel> _regler = [];
    private List<ComponentType> _typer = [];
    private List<Dor> _dorer = [];
    private Dictionary<int, string> _prosjektNavn = [];
    private Dictionary<int, int> _varerPerType = [];
    private ServicePrisRegel? _valgt;
    private string _visning = "tabell";
    private bool _endret, _full;
    private string? _melding;
    private List<ServicePrisRegelVersjon> _versjoner = [];
    private List<ServiceKontrollpunkt> _punkter = [];
    private int _nyKey;
    private string _punktType = ServiceRegelMotor.Servicetyper[0];
    private int? _forhDorId;
    private Dictionary<int, string?> PunktTypeKart => _typer.ToDictionary(t => t.Id, ServiceRegelMotor.Servicetype);

    private void LeggTilPunkt(string type, string? tekst)
    {
        if (string.IsNullOrWhiteSpace(tekst)) return;
        var k = new ServiceKontrollpunkt { Servicetype = type, Tekst = tekst.Trim(), EndretDato = DateTime.Now, Rekkefolge = (_punkter.Where(x => x.DorId == null && x.Servicetype == type).Select(x => (int?)x.Rekkefolge).Max() ?? -1) + 1 };
        Db.ServiceKontrollpunkter.Add(k);
        _punkter.Add(k);
        _nyKey++;
        Endret();
    }

    private void FjernPunkt(ServiceKontrollpunkt k)
    {
        _punkter.Remove(k);
        if (k.Id != 0) Db.ServiceKontrollpunkter.Remove(k);
        else Db.Entry(k).State = Microsoft.EntityFrameworkCore.EntityState.Detached;
        Endret();
    }
    private ServicePrisRegelVersjon? _valgtVersjon;
    private Dictionary<int, int> _avtalerPerVersjon = [];
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private sealed record DorResultat(Dor Dor, ServiceRegelMotor.Resultat Resultat);

    protected override async Task OnInitializedAsync()
    {
        if (Nav.Uri.Contains("/service-sjekklister", StringComparison.OrdinalIgnoreCase))
        {
            _visning = "punkter";
        }
        await Last();
    }

    private async Task Last()
    {
        Db.ChangeTracker.Clear();
        await ServiceRegelMotor.SikreStandardregler(Db);
        _regler = await Db.ServicePrisRegler.Include(r => r.Betingelser).OrderBy(r => r.Prioritet).ThenBy(r => r.Id).ToListAsync();
        _typer = await Db.ComponentTypes.OrderBy(t => t.Sortering).ThenBy(t => t.Navn).ToListAsync();
        _varerPerType = await Db.Components.Where(c => c.ComponentTypeId != null).GroupBy(c => c.ComponentTypeId!.Value).Select(g => new { g.Key, N = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.N);
        var prosjekter = await Db.Prosjekter.AsNoTracking().Where(p => (p.Status == ProsjektStatus.Serviceavtale || p.HarServiceavtale)).Select(p => new { p.Id, p.Navn }).ToListAsync();
        _prosjektNavn = prosjekter.ToDictionary(p => p.Id, p => p.Navn);
        var ider = prosjekter.Select(p => p.Id).ToList();
        _dorer = await Db.Dorer.AsNoTracking().Where(d => ider.Contains(d.ProsjektId))
            .Include(d => d.Komponenter).ThenInclude(k => k.Component)
            .Include(d => d.Funksjoner)
            .OrderBy(d => d.ProsjektId).ThenBy(d => d.Dornummer).ToListAsync();
        await ServicerundeMotor.SikreKontrollpunkter(Db);
        _punkter = await Db.ServiceKontrollpunkter.OrderBy(k => k.Servicetype).ThenBy(k => k.Rekkefolge).ToListAsync();
        _versjoner = await Db.ServicePrisRegelVersjoner.AsNoTracking().OrderByDescending(v => v.Versjon).ToListAsync();
        _valgtVersjon = _valgtVersjon is null ? null : _versjoner.FirstOrDefault(v => v.Id == _valgtVersjon.Id);
        _avtalerPerVersjon = await Db.Prosjekter.Where(p => p.ServiceGodkjentRegelversjon != null).GroupBy(p => p.ServiceGodkjentRegelversjon!.Value).Select(g => new { g.Key, N = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.N);
        _valgt = _valgt is null ? _regler.FirstOrDefault() : _regler.FirstOrDefault(r => r.Id == _valgt.Id) ?? _regler.FirstOrDefault();
        _endret = false;
        _alle = null;
        _typeKart = null;
    }

    private Dictionary<int, string?>? _typeKart;
    private List<DorResultat>? _alle;
    private Dictionary<int, string?> TypeKart => _typeKart ??= _typer.ToDictionary(t => t.Id, ServiceRegelMotor.Servicetype);

    private ServiceRegelMotor.Resultat Klassifiser(Dor d) => ServiceRegelMotor.Klassifiser(d, _regler, TypeKart);

    private List<DorResultat> Alle => _alle ??= _dorer.Select(d => new DorResultat(d, Klassifiser(d))).ToList();
    private List<(Dor Dor, IReadOnlyList<ServicePrisRegel> Konflikt)> Konflikter => Alle.Where(x => x.Resultat.HarKonflikt).Select(x => (x.Dor, x.Resultat.Konflikt)).ToList();
    private List<DorResultat> IkkeKategorisert => Alle.Where(x => x.Resultat.Regel is null).ToList();
    private int AntallMedKategori(ServicePrisRegel r) => Alle.Count(x => x.Resultat.Regel == r);

    private string ProsjektNavn(int id) => _prosjektNavn.GetValueOrDefault(id) ?? "";
    private static string Kr(decimal v) => "kr " + v.ToString("#,##0", Kultur);
    private static decimal? LesTall(object? v) => decimal.TryParse(v?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d >= 0 ? d : null;

    private string Klartekst(ServicePrisRegel r)
    {
        static string Beskriv(ServicePrisRegelBetingelse b) => b.Felt == ServiceRegelFelt.Funksjon ? $"dørfunksjon «{b.Verdi}»" : b.Verdi;
        var har = r.Betingelser.Where(b => !b.ErIkke).Select(Beskriv).ToList();
        var ikke = r.Betingelser.Where(b => b.ErIkke).Select(Beskriv).ToList();
        var start = har.Count == 0 ? "Alle dører som ikke traff en regel før" : $"Dører som har {string.Join(r.KreverAlle ? " og " : " eller ", har)}";
        var unntak = ikke.Count == 0 ? "" : $", men ikke {string.Join(" eller ", ikke)}";
        return $"{start}{unntak}, blir «{r.Navn}» og koster {Kr(r.Pris)} per dør per runde.{(r.Aktiv ? "" : " Regelen er slått av.")}";
    }

    // ---- PR1: tabellen ----
    private ServicePrisRegel? _harRegel;
    private readonly HashSet<string> _testTyper = new(StringComparer.OrdinalIgnoreCase) { "Dørautomatikk", "Elektrisk sluttstykke" };

    private static bool ErReserve(ServicePrisRegel r) => !r.Betingelser.Any(b => !b.ErIkke);

    // Reglene i den rekkefølgen de prøves; reserveregelen («alle andre dører») sist.
    private List<ServicePrisRegel> Rekkefolge => _regler
        .OrderBy(r => ErReserve(r)).ThenBy(r => r.Prioritet).ThenBy(r => r.Id).ToList();

    private void Nummerer(List<ServicePrisRegel> liste)
    {
        var n = 1;
        foreach (var r in liste)
        {
            r.Prioritet = ErReserve(r) ? 99 : n++;
        }
    }

    private void Flytt(ServicePrisRegel r, int retning)
    {
        var liste = Rekkefolge;
        var i = liste.IndexOf(r);
        var j = i + retning;
        if (i < 0 || j < 0 || j >= liste.Count || ErReserve(liste[j]))
        {
            return;
        }
        (liste[i], liste[j]) = (liste[j], liste[i]);
        Nummerer(liste);
        Endret();
    }

    private void VekslHar(ServicePrisRegel r, string type)
    {
        var b = r.Betingelser.FirstOrDefault(x => !x.ErIkke && x.Felt == ServiceRegelFelt.Servicetype && x.Verdi.Equals(type, StringComparison.OrdinalIgnoreCase));
        if (b is null)
        {
            r.Betingelser.Add(new ServicePrisRegelBetingelse { Felt = ServiceRegelFelt.Servicetype, Verdi = type, Rekkefolge = r.Betingelser.Count });
        }
        else
        {
            FjernBetingelse(r, b);
        }
        Endret();
    }

    private void NyKombinasjon()
    {
        var r = new ServicePrisRegel { Navn = "Ny regel", KreverAlle = true, Pris = 0, Minutter = 10 };
        Db.ServicePrisRegler.Add(r);
        _regler.Add(r);
        // Nye regler legges øverst, så en ny kombinasjon vinner over enkeltbeslagene.
        var liste = Rekkefolge;
        liste.Remove(r);
        liste.Insert(0, r);
        Nummerer(liste);
        Endret();
        _harRegel = r;
    }

    // «Test en dør»: samme regler som motoren, men bare beslagstypene som er krysset av.
    private ServicePrisRegel? TestDor() => Rekkefolge.Where(r => r.Aktiv)
        .FirstOrDefault(r => ServiceRegelMotor.Treffer(r, _testTyper, []));

    private void Velg(ServicePrisRegel r)
    {
        _valgt = r;
        _visning = "regel";
    }

    private void Endret()
    {
        _alle = null;
        _typeKart = null;
        _endret = true;
        _melding = null;
    }

    private void NyRegel()
    {
        var r = new ServicePrisRegel { Navn = "Ny regel", Prioritet = Math.Max(1, (_regler.Where(x => x.Betingelser.Count > 0).Select(x => (int?)x.Prioritet).Max() ?? 0) + 1), Pris = 0, Minutter = 10, Betingelser = [new() { Verdi = ServiceRegelMotor.Servicetyper[0] }] };
        Db.ServicePrisRegler.Add(r);
        _regler.Add(r);
        Velg(r);
        Endret();
    }

    private void LeggTilBetingelse(ServicePrisRegel r, bool ekskludering)
    {
        r.Betingelser.Add(new ServicePrisRegelBetingelse { Verdi = ServiceRegelMotor.Servicetyper[ekskludering ? 2 : 0], ErIkke = ekskludering, Rekkefolge = r.Betingelser.Count });
        Endret();
    }

    private void FjernBetingelse(ServicePrisRegel r, ServicePrisRegelBetingelse b)
    {
        r.Betingelser.Remove(b);
        if (b.Id != 0)
        {
            Db.ServicePrisRegelBetingelser.Remove(b);
        }
        Endret();
    }

    private void SettServicetype(ComponentType t, string? verdi)
    {
        t.Servicetype = string.IsNullOrWhiteSpace(verdi) ? null : verdi;
        Endret();
    }

    private async Task SlettRegel(ServicePrisRegel r)
    {
        if (r.Id != 0)
        {
            Db.ServicePrisRegler.Remove(r);
            await Db.SaveChangesAsync();
            await ServiceRegelMotor.LagreVersjon(Db, await Brukernavn());
        }
        _valgt = null;
        await Last();
        _melding = $"«{r.Navn}» er slettet.";
    }

    private async Task Lagre()
    {
        foreach (var r in _regler.Where(r => r.Id != 0))
        {
            r.EndretDato = DateTime.Now;
        }
        await Db.SaveChangesAsync();
        var versjon = await ServiceRegelMotor.LagreVersjon(Db, await Brukernavn());
        await Last();
        _melding = $"Prisreglene er lagret som versjon {versjon}. Avtaler med godkjent pris beholder versjonen de ble godkjent med.";
    }

    private async Task<string?> Brukernavn() => AuthStateTask is null ? null : (await AuthStateTask).User.Identity?.Name;

    private async Task Angre()
    {
        await Last();
        _melding = null;
    }
}
