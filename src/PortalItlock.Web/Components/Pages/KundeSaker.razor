@page "/kunde/saker"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Mine saker - Full Kontroll</PageTitle>

<div class="dp-tittelrad">
    <div class="dp-hei">
        <h1>Mine saker</h1>
        <p>Status på sakene dine hos oss.</p>
    </div>
    <a class="dp-knapp dp-knapp-p dp-kun-pc" href="/kunde/ny"><Icon Name="plus" />Ny henvendelse</a>
</div>

@if (_ikkeKoblet)
{
    <p class="dp-feil">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med oss.</p>
}
else
{
    <div class="dp-segment" style="max-width:420px">
        <button type="button" class="@(_filter == "apne" ? "aktiv" : "")" @onclick="@(() => _filter = "apne")">Åpne<em hidden="@(Apne == 0)">@Apne</em></button>
        <button type="button" class="@(_filter == "lost" ? "aktiv" : "")" @onclick="@(() => _filter = "lost")">Løst</button>
        <button type="button" class="@(_filter == "alle" ? "aktiv" : "")" @onclick="@(() => _filter = "alle")">Alle</button>
    </div>

    @if (_lastet && Utvalg.Count == 0)
    {
        <div class="dp-kort dp-tom">@(_filter == "apne" ? "Ingen åpne saker." : "Ingen saker her ennå.")</div>
    }
    else
    {
        <div class="dp-meldinger">
            @foreach (var s in Utvalg)
            {
                <a class="dp-melding" href="@($"/kunde/sak/{s.Id}")" @key="s.Id">
                    <span class="dp-ik dp-t-@KundeportalHelper.Farge(s.Status)"><Icon Name="@(s.Status == TicketStatus.Lukket ? "check" : "mail")" /></span>
                    <span>
                        <b>@s.Tittel</b>
                        <small>Sak #@s.Id · opprettet @s.OpprettetDato.ToString("dd.MM.yyyy")</small>
                        <span class="dp-tag dp-t-@KundeportalHelper.Farge(s.Status)">@KundeportalHelper.Navn(s.Status)</span>
                    </span>
                    <Icon Name="chevron-right" />
                </a>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _ikkeKoblet;
    private bool _lastet;
    private string _filter = "apne";
    private List<Ticket> _saker = [];

    private int Apne => _saker.Count(s => s.Status != TicketStatus.Lukket);

    private List<Ticket> Utvalg => _filter switch
    {
        "apne" => _saker.Where(s => s.Status != TicketStatus.Lukket).ToList(),
        "lost" => _saker.Where(s => s.Status == TicketStatus.Lukket).ToList(),
        _ => _saker
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeKoblet = true;
            return;
        }

        _saker = await Db.Tickets
            .Where(t => t.KundeId == bruker.KundeId)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();

        if (Apne == 0 && _saker.Count > 0)
        {
            _filter = "alle";
        }
        _lastet = true;
    }
}
