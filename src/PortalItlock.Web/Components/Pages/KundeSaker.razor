@page "/kunde/saker"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Mine saker - itlock</PageTitle>

<a class="back-link" href="/kunde">&larr; Tilbake</a>
<h1>Mine saker</h1>

@if (_ikkeKoblet)
{
    <p class="form-error">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med itlock.</p>
}
else
{
    <p class="section-hint">Her ser du status på sakene dine hos itlock.</p>

    @if (_saker.Count == 0)
    {
        <p class="list-empty">Ingen saker registrert ennå.</p>
    }
    else
    {
        <div class="sak-liste">
            @foreach (var s in _saker)
            {
                <a @key="s.Id" class="sak-kort" href="@($"/kunde/sak/{s.Id}")">
                    <div class="sak-header">
                        <strong>@s.Tittel</strong>
                        <span class="sak-status sak-status-@s.Status">@s.Status.Visningsnavn()</span>
                    </div>
                    <span class="sak-dato">Opprettet @s.OpprettetDato.ToString("dd.MM.yyyy")</span>
                </a>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _ikkeKoblet;
    private List<Ticket> _saker = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is null || !int.TryParse(brukerClaim, out var brukerId))
        {
            return;
        }

        var bruker = await Db.Brukere.FindAsync(brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeKoblet = true;
            return;
        }

        _saker = await Db.Tickets
            .Where(t => t.KundeId == bruker.KundeId)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();
    }
}
