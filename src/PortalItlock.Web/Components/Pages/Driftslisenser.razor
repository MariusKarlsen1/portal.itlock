@page "/driftslisenser"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Driftslisenser</PageTitle>

@* DL7 (driftslisenser-kunde-forslag.html): kundene i en meny inni kortet, og
   vaktmesterne/driftslisensene hos valgt kunde til høyre med av/på-bryter og
   prosjektene som brikker. Klikk en lisens for å velge hvilke av kundens
   prosjekter den skal se. Kunden utledes fra prosjektene lisensen har tilgang
   til - det lagres ingen kunde på selve brukeren. *@
<div class="dl @(_full ? "dl-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="lock" /></span>
            <div>
                <h1>Driftslisenser</h1>
                <p class="section-hint">
                    Vaktmestere og driftspersonell hos kundene, med egen innlogging og tilgang til kun de prosjektene du velger.
                    De ser plantegning og dører der, og kan sende inn driftsmeldinger med bilder, video og tekst - ingenting annet i portalen.
                </p>
            </div>
        </div>
    </div>

    <div class="dl-kort">
        <nav class="dl-meny">
            <label class="dl-minisok">
                <Icon Name="search" />
                <input type="search" placeholder="Finn kunde eller vaktmester" aria-label="Søk i driftslisenser" @bind="_sok" @bind:event="oninput" />
            </label>
            <div class="dl-kundeliste">
                @foreach (var k in MenyKunder)
                {
                    var id = k.Id;
                    var lisenser = LisenserFor(id);
                    <button type="button" @key="k.Id" class="@(Valgt == id ? "pa" : "")" @onclick="@(() => VelgKunde(id))">
                        <span class="dl-kundeikon">@(id == UtenProsjekter ? "–" : Initialer(k.Navn))</span>
                        <span class="dl-kundenavn">
                            <span>@k.Navn</span>
                            <small>@(lisenser.Count == 0 ? "Ingen vaktmestere ennå" : lisenser.All(l => l.Aktiv) ? $"{lisenser.Count} {(lisenser.Count == 1 ? "vaktmester" : "vaktmestere")}" : $"{lisenser.Count(l => l.Aktiv)} av {lisenser.Count} aktive")</small>
                        </span>
                    </button>
                }
                @if (MenyKunder.Count == 0)
                {
                    <p class="dl-dempet">@(string.IsNullOrWhiteSpace(_sok) ? "Ingen kunder med prosjekter ennå." : "Ingen treff.")</p>
                }
            </div>
            <div class="dl-meny-bunn">
                <span class="dl-tall"><b>@_antallAktive aktive</b> · @_antallInaktive inaktive driftslisenser</span>
            </div>
        </nav>

        <section class="dl-innhold">
            <div class="dl-hode">
                @if (Valgt is int kid)
                {
                    <span class="dl-kundeikon stor">@(kid == UtenProsjekter ? "–" : Initialer(KundeNavn(kid)))</span>
                    <div class="dl-hode-tekst">
                        <b>@KundeNavn(kid)</b>
                        <small>
                            @VisteLisenser.Count @(VisteLisenser.Count == 1 ? "vaktmester" : "vaktmestere")
                            @if (kid != UtenProsjekter)
                            {
                                <text> · @ProsjekterFor(kid).Count @(ProsjekterFor(kid).Count == 1 ? "prosjekt" : "prosjekter")</text>
                            }
                        </small>
                    </div>
                    @if (kid != UtenProsjekter)
                    {
                        <button type="button" class="knapp-primaer" @onclick="@(() => VisNy(kid))"><Icon Name="plus" />Ny vaktmester</button>
                    }
                }
                <button type="button" class="dl-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_melding))
            {
                <p class="save-success dl-melding">@_melding</p>
            }
            @if (!string.IsNullOrEmpty(_feil) && !_visNy)
            {
                <p class="form-error dl-melding">@_feil</p>
            }

            <div class="dl-rull">
                @if (_visNy && Valgt is int nyKunde && nyKunde != UtenProsjekter)
                {
                    var prosjekter = ProsjekterFor(nyKunde);
                    <div class="dl-ny">
                        <b>Ny vaktmester hos @KundeNavn(nyKunde)</b>
                        <div class="dl-ny-felt">
                            <label class="felt">
                                <span>Navn</span>
                                <input @bind="_nyNavn" @bind:event="oninput" placeholder="Vaktmester eller driftspersonell" />
                            </label>
                            <label class="felt">
                                <span>E-post</span>
                                <input @bind="_nyEpost" @bind:event="oninput" placeholder="navn@firma.no" />
                            </label>
                        </div>
                        @ProsjektValg(prosjekter, _nyeProsjekter)
                        <p class="ny-hint">Personen setter passord via "Sett passord første gang" på innloggingssiden.</p>
                        @if (!string.IsNullOrEmpty(_feil))
                        {
                            <p class="form-error">@_feil</p>
                        }
                        <div class="rediger-knapper">
                            <button type="button" class="knapp-sekundaer" @onclick="@(() => { _visNy = false; _feil = null; })">Avbryt</button>
                            <button type="button" class="knapp-primaer" @onclick="OpprettLisens" disabled="@(string.IsNullOrWhiteSpace(_nyNavn) || string.IsNullOrWhiteSpace(_nyEpost))"><Icon Name="plus" />Opprett</button>
                        </div>
                    </div>
                }

                <div class="bruker-liste">
                    @if (Valgt is null)
                    {
                        <p class="list-empty">Velg en kunde i menyen.</p>
                    }
                    else if (VisteLisenser.Count == 0 && !_visNy)
                    {
                        <p class="list-empty">Ingen vaktmestere hos @KundeNavn(Valgt.Value) ennå. Trykk «Ny vaktmester» for å gi den første tilgang.</p>
                    }
                    @foreach (var l in VisteLisenser)
                    {
                        var apen = _apenId == l.Id;
                        var kundensProsjekter = Valgt is int vk && vk != UtenProsjekter ? ProsjekterFor(vk) : [];
                        var valgteHer = kundensProsjekter.Where(p => l.ValgteProsjektIder.Contains(p.Id)).ToList();
                        <div @key="l.Id" class="bruker-rad @(apen ? "apen" : "") @(l.Aktiv ? "" : "inaktiv")">
                            <div class="dl-rad-topp">
                                <button type="button" class="bruker-rad-topp" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VelgRad(l))">
                                    <span class="avatar">@Initialer(l.Navn)</span>
                                    <span class="rad-info">
                                        <b>@l.Navn</b>
                                        @if (Valgt == UtenProsjekter)
                                        {
                                            <small>@l.Epost</small>
                                        }
                                        else
                                        {
                                            <span class="dl-prosjekter">
                                                @if (valgteHer.Count > 0 && valgteHer.Count == kundensProsjekter.Count)
                                                {
                                                    <span>Alle prosjekter</span>
                                                }
                                                else
                                                {
                                                    @foreach (var p in valgteHer)
                                                    {
                                                        <span>@p.Navn</span>
                                                    }
                                                }
                                            </span>
                                        }
                                    </span>
                                    @if (!l.Aktiv)
                                    {
                                        <span class="status status-inaktiv">Sperret</span>
                                    }
                                    else if (!l.HarPassord)
                                    {
                                        <span class="status status-venter">Venter på passord</span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <span class="mer-knapp" title="@(apen ? "Lukk" : "Rediger")"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                                </button>
                                <label class="dl-bryter" title="@(l.Aktiv ? "Aktiv – slå av for å sperre" : "Sperret – slå på for å åpne")">
                                    <input type="checkbox" checked="@l.Aktiv" @onchange="@(e => SettAktiv(l, (bool)e.Value!))" disabled="@apen" />
                                    <i></i>
                                </label>
                            </div>

                            @if (apen)
                            {
                                <div class="rediger">
                                    <label class="felt">
                                        <span>Navn</span>
                                        <input @bind="l.Navn" @bind:event="oninput" />
                                    </label>
                                    <label class="felt">
                                        <span>E-post</span>
                                        <input @bind="l.Epost" @bind:event="oninput" />
                                    </label>
                                    <div class="felt">
                                        <span>Tilgang</span>
                                        <label class="bryter">
                                            <input type="checkbox" @bind="l.Aktiv" />
                                            <i></i>
                                            @(l.Aktiv ? "Aktiv" : "Inaktiv – kan ikke logge inn")
                                        </label>
                                    </div>
                                    <div class="felt dl-prosjektfelt">
                                        @if (Valgt == UtenProsjekter)
                                        {
                                            <span>Gi tilgang til prosjekter hos en kunde ved å velge kunden i menyen og legge til vaktmesteren der, eller kryss av prosjekter under.</span>
                                            @ProsjektValg(_prosjekter, l.ValgteProsjektIder)
                                        }
                                        else
                                        {
                                            @ProsjektValg(kundensProsjekter, l.ValgteProsjektIder)
                                        }
                                    </div>
                                    <div class="rediger-bunn">
                                        <span class="rediger-lenker">
                                            @if (l.HarPassord)
                                            {
                                                <button type="button" class="lenke-knapp" @onclick="@(() => NullstillPassord(l))"><Icon Name="lock" />Nullstill passord</button>
                                            }
                                            <button type="button" class="lenke-knapp farlig" @onclick="@(() => SlettLisens(l))"><Icon Name="trash" />Slett lisens</button>
                                        </span>
                                        <span class="rediger-knapper">
                                            <button type="button" class="knapp-sekundaer" @onclick="Avbryt">Avbryt</button>
                                            <button type="button" class="knapp-primaer" @onclick="@(() => Lagre(l))"><Icon Name="check" />Lagre</button>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private sealed class LisensRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public bool Aktiv { get; set; }
        public bool HarPassord { get; set; }
        public HashSet<int> ValgteProsjektIder { get; set; } = [];
        public int AntallProsjekter => ValgteProsjektIder.Count;
    }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public int? KundeId { get; set; }
    }

    private List<LisensRad> _lisenser = [];
    private List<ProsjektOption> _prosjekter = [];
    private int _antallAktive;
    private int _antallInaktive;
    private int? _apenId;
    private string _sok = "";
    private string _nyNavn = "";
    private string _nyEpost = "";
    private string? _melding;
    private string? _feil;

    // DL7: kundene i menyen. Kunden til en lisens er kunden(e) til prosjektene den
    // har tilgang til. Lisenser uten prosjekter og prosjekter uten kunde får egne
    // punkter nederst i menyen, så ingenting forsvinner.
    private const int UtenProsjekter = -1;
    private const int UtenKunde = -2;

    private sealed record MenyKunde(int Id, string Navn);

    private Dictionary<int, string> _kundeNavn = [];
    private int? _valgtKundeId;
    private bool _visNy;
    private bool _full;
    private HashSet<int> _nyeProsjekter = [];

    private string KundeNavn(int id) => id switch
    {
        UtenProsjekter => "Uten prosjekter",
        UtenKunde => "Prosjekter uten kunde",
        _ => _kundeNavn.GetValueOrDefault(id, "Ukjent kunde")
    };

    private List<ProsjektOption> ProsjekterFor(int kundeId) => kundeId == UtenKunde
        ? _prosjekter.Where(p => p.KundeId is null).ToList()
        : _prosjekter.Where(p => p.KundeId == kundeId).ToList();

    private List<LisensRad> LisenserFor(int kundeId)
    {
        if (kundeId == UtenProsjekter)
        {
            return _lisenser.Where(l => l.ValgteProsjektIder.Count == 0).ToList();
        }

        var ider = ProsjekterFor(kundeId).Select(p => p.Id).ToHashSet();
        return _lisenser.Where(l => l.ValgteProsjektIder.Overlaps(ider)).ToList();
    }

    private List<MenyKunde> MenyKunder
    {
        get
        {
            var liste = _prosjekter
                .Where(p => p.KundeId is not null)
                .Select(p => p.KundeId!.Value)
                .Distinct()
                .Select(id => new MenyKunde(id, KundeNavn(id)))
                // Kundene som har vaktmestere først, så resten alfabetisk.
                .OrderBy(k => LisenserFor(k.Id).Count == 0)
                .ThenBy(k => k.Navn, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("nb-NO"), true))
                .ToList();
            if (_prosjekter.Any(p => p.KundeId is null))
            {
                liste.Add(new MenyKunde(UtenKunde, KundeNavn(UtenKunde)));
            }

            if (_lisenser.Any(l => l.ValgteProsjektIder.Count == 0))
            {
                liste.Add(new MenyKunde(UtenProsjekter, KundeNavn(UtenProsjekter)));
            }

            var s = _sok.Trim();
            return s.Length == 0
                ? liste
                : liste.Where(k => k.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || LisenserFor(k.Id).Any(l => l.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) || l.Epost.Contains(s, StringComparison.OrdinalIgnoreCase)))
                  .ToList();
        }
    }

    // Valgt kunde, ellers den første kunden som har vaktmestere.
    private int? Valgt
    {
        get
        {
            var meny = MenyKunder;
            if (_valgtKundeId is int id && meny.Any(k => k.Id == id))
            {
                return id;
            }

            return (meny.FirstOrDefault(k => LisenserFor(k.Id).Count > 0) ?? meny.FirstOrDefault())?.Id;
        }
    }

    private List<LisensRad> VisteLisenser => Valgt is int id ? LisenserFor(id) : [];

    private RenderFragment ProsjektValg(List<ProsjektOption> prosjekter, HashSet<int> valgte) => __builder =>
    {
        var antall = prosjekter.Count(p => valgte.Contains(p.Id));
        var alle = prosjekter.Count > 0 && antall == prosjekter.Count;
        <div class="dl-alle">
            <span>Prosjekter (@antall av @prosjekter.Count)</span>
            @if (prosjekter.Count > 0)
            {
                <button type="button" class="lenke-knapp" @onclick="@(() => VelgAlleProsjekter(prosjekter, valgte, !alle))">@(alle ? "Fjern alle" : "Velg alle")</button>
            }
        </div>
        @if (prosjekter.Count == 0)
        {
            <p class="list-empty">Ingen prosjekter hos kunden.</p>
        }
        else
        {
            <div class="dl-sjekkliste">
                @foreach (var p in prosjekter)
                {
                    var pid = p.Id;
                    var valgt = valgte.Contains(pid);
                    <label class="@(valgt ? "pa" : "")">
                        <input type="checkbox" checked="@valgt" @onchange="@(() => { if (!valgte.Add(pid)) valgte.Remove(pid); })" />
                        <Icon Name="folder" />@p.Navn
                    </label>
                }
            </div>
        }
    };

    private static void VelgAlleProsjekter(List<ProsjektOption> prosjekter, HashSet<int> valgte, bool velg)
    {
        foreach (var p in prosjekter)
        {
            if (velg)
            {
                valgte.Add(p.Id);
            }
            else
            {
                valgte.Remove(p.Id);
            }
        }
    }

    private async Task VelgKunde(int id)
    {
        if (_apenId is not null)
        {
            await Avbryt();
        }

        _valgtKundeId = id;
        _visNy = false;
        _melding = null;
        _feil = null;
    }

    private void VisNy(int kundeId)
    {
        _visNy = true;
        _nyNavn = "";
        _nyEpost = "";
        _nyeProsjekter = ProsjekterFor(kundeId).Select(p => p.Id).ToHashSet();
        _melding = null;
        _feil = null;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("driftslisenser-bredde", _full ? "full" : "normal");
    }

    // Av/på-bryteren på raden lagrer med en gang.
    private async Task SettAktiv(LisensRad rad, bool aktiv)
    {
        await Db.Brukere.Where(b => b.Id == rad.Id).ExecuteUpdateAsync(s => s.SetProperty(b => b.Aktiv, aktiv));
        rad.Aktiv = aktiv;
        _antallAktive = _lisenser.Count(l => l.Aktiv);
        _antallInaktive = _lisenser.Count - _antallAktive;
        _feil = null;
        _melding = aktiv ? $"«{rad.Navn}» kan logge inn igjen." : $"«{rad.Navn}» er sperret og kan ikke logge inn.";
    }

    private IEnumerable<LisensRad> Synlige => string.IsNullOrWhiteSpace(_sok)
        ? _lisenser
        : _lisenser.Where(l => l.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
                            || l.Epost.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string Initialer(string? navn)
    {
        var deler = (navn ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    // Klikk på en rad åpner redigering; klikk igjen (eller Avbryt) lukker og
    // henter de lagrede verdiene på nytt, så ulagrede endringer forkastes.
    private async Task VelgRad(LisensRad rad)
    {
        if (_apenId == rad.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await LoadAsync();
        }

        _apenId = rad.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("driftslisenser-bredde", "normal") == "full";
        _kundeNavn = await Db.Kunder.Select(k => new { k.Id, k.Navn }).ToDictionaryAsync(k => k.Id, k => k.Navn);
        _prosjekter = await Db.Prosjekter
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn, KundeId = p.KundeId })
            .ToListAsync();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lisenser = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Driftslisens)
            .Include(b => b.Prosjekter)
            .OrderBy(b => b.Navn)
            .Select(b => new LisensRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                Aktiv = b.Aktiv,
                HarPassord = b.PasswordHash != null,
                ValgteProsjektIder = b.Prosjekter.Select(p => p.Id).ToHashSet()
            })
            .ToListAsync();

        _antallAktive = _lisenser.Count(l => l.Aktiv);
        _antallInaktive = _lisenser.Count - _antallAktive;
    }

    private async Task OpprettLisens()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        var ny = new Bruker { Navn = navn, Epost = epost, Rolle = BrukerRolle.Driftslisens, Aktiv = true };
        // Prosjektene hos kunden som er krysset av i skjemaet.
        foreach (var p in await Db.Prosjekter.Where(p => _nyeProsjekter.Contains(p.Id)).ToListAsync())
        {
            ny.Prosjekter.Add(p);
        }

        Db.Brukere.Add(ny);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _feil = null;
        _visNy = false;
        _melding = $"«{navn}» er opprettet med tilgang til {ny.Prosjekter.Count} {(ny.Prosjekter.Count == 1 ? "prosjekt" : "prosjekter")}. Personen setter passord via «Sett passord første gang» på innloggingssiden.";
        await LoadAsync();
    }

    private void ToggleProsjekt(LisensRad l, int prosjektId)
    {
        if (!l.ValgteProsjektIder.Add(prosjektId))
        {
            l.ValgteProsjektIder.Remove(prosjektId);
        }
    }

    private async Task Lagre(LisensRad l)
    {
        var navn = l.Navn.Trim();
        var epost = l.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Prosjekter).FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.Aktiv = l.Aktiv;

        var gjeldende = bruker.Prosjekter.Select(p => p.Id).ToHashSet();
        var skalFjerne = gjeldende.Except(l.ValgteProsjektIder).ToList();
        var skalLeggeTil = l.ValgteProsjektIder.Except(gjeldende).ToList();

        foreach (var id in skalFjerne)
        {
            var p = bruker.Prosjekter.First(p => p.Id == id);
            bruker.Prosjekter.Remove(p);
        }

        foreach (var id in skalLeggeTil)
        {
            var p = await Db.Prosjekter.FindAsync(id);
            if (p is not null)
            {
                bruker.Prosjekter.Add(p);
            }
        }

        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
        _apenId = null;
        await LoadAsync();
    }

    private async Task NullstillPassord(LisensRad l)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{l.Navn}\".";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettLisens(LisensRad l)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);
        await Db.SaveChangesAsync();
        _melding = $"\"{l.Navn}\" er slettet.";
        _apenId = null;
        _feil = null;
        await LoadAsync();
    }
}
