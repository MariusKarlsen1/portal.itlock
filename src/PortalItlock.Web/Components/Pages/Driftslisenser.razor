@page "/driftslisenser"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Driftslisenser</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Driftslisenser</h1>
            <p class="section-hint">
                Gi vaktmestere eller driftspersonell en egen innlogging med tilgang til kun de prosjektene du velger.
                De ser plantegning og dører der, og kan sende inn driftsmeldinger med bilder, video og tekst - ingenting annet i portalen.
            </p>
        </div>
    </div>
    <label class="bruker-sok">
        <Icon Name="search" />
        <input type="search" placeholder="Søk …" aria-label="Søk i driftslisenser" @bind="_sok" @bind:event="oninput" />
    </label>
</div>

<div class="bruker-oppsett">
    <div class="bruker-liste">
        @if (_lisenser.Count == 0)
        {
            <p class="list-empty">Ingen driftslisenser opprettet ennå.</p>
        }
        else if (!Synlige.Any())
        {
            <p class="list-empty">Ingen driftslisenser passer søket.</p>
        }
        @foreach (var l in Synlige)
        {
            var apen = _apenId == l.Id;
            <div @key="l.Id" class="bruker-rad @(apen ? "apen" : "") @(l.Aktiv ? "" : "inaktiv")">
                <button type="button" class="bruker-rad-topp" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VelgRad(l))">
                    <span class="avatar">@Initialer(l.Navn)</span>
                    <span class="rad-info">
                        <b>@l.Navn</b>
                        <small>@l.AntallProsjekter prosjekt@(l.AntallProsjekter == 1 ? "" : "er") · @l.Epost</small>
                    </span>
                    @if (!l.Aktiv)
                    {
                        <span class="status status-inaktiv">Inaktiv</span>
                    }
                    else if (!l.HarPassord)
                    {
                        <span class="status status-venter">Venter på passord</span>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="mer-knapp" title="@(apen ? "Lukk" : "Rediger")"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                </button>

                @if (apen)
                {
                    <div class="rediger">
                        <label class="felt">
                            <span>Navn</span>
                            <input @bind="l.Navn" @bind:event="oninput" />
                        </label>
                        <label class="felt">
                            <span>E-post</span>
                            <input @bind="l.Epost" @bind:event="oninput" />
                        </label>
                        <div class="felt">
                            <span>Tilgang</span>
                            <label class="bryter">
                                <input type="checkbox" @bind="l.Aktiv" />
                                <i></i>
                                @(l.Aktiv ? "Aktiv" : "Inaktiv – kan ikke logge inn")
                            </label>
                        </div>
                        <div class="felt prosjekter">
                            <span>Prosjekter denne lisensen har tilgang til</span>
                            @if (_prosjekter.Count == 0)
                            {
                                <p class="list-empty">Ingen prosjekter opprettet ennå.</p>
                            }
                            else
                            {
                                <ul class="prosjekt-chip-list">
                                    @foreach (var p in _prosjekter)
                                    {
                                        <li>
                                            <label class="prosjekt-chip @(l.ValgteProsjektIder.Contains(p.Id) ? "valgt" : "")">
                                                <input type="checkbox" checked="@l.ValgteProsjektIder.Contains(p.Id)" @onchange="@(() => ToggleProsjekt(l, p.Id))" />
                                                @p.Navn
                                            </label>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="rediger-bunn">
                            <span class="rediger-lenker">
                                @if (l.HarPassord)
                                {
                                    <button type="button" class="lenke-knapp" @onclick="@(() => NullstillPassord(l))"><Icon Name="lock" />Nullstill passord</button>
                                }
                                <button type="button" class="lenke-knapp farlig" @onclick="@(() => SlettLisens(l))"><Icon Name="trash" />Slett lisens</button>
                            </span>
                            <span class="rediger-knapper">
                                <button type="button" class="knapp-sekundaer" @onclick="Avbryt">Avbryt</button>
                                <button type="button" class="knapp-primaer" @onclick="@(() => Lagre(l))"><Icon Name="check" />Lagre</button>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <aside class="ny-bruker">
        <h2>Ny driftslisens</h2>
        @if (_lisenser.Count > 0)
        {
            <div class="lisens">
                <span><b>@_antallAktive aktive</b> · @_antallInaktive inaktive</span>
            </div>
        }
        <label class="felt">
            <span>Navn</span>
            <input @bind="_nyNavn" @bind:event="oninput" placeholder="Vaktmester eller driftspersonell" />
        </label>
        <label class="felt">
            <span>E-post</span>
            <input @bind="_nyEpost" @bind:event="oninput" placeholder="navn@firma.no" />
        </label>
        <button type="button" class="knapp-primaer opprett" @onclick="OpprettLisens" disabled="@(string.IsNullOrWhiteSpace(_nyNavn) || string.IsNullOrWhiteSpace(_nyEpost))"><Icon Name="plus" />Opprett lisens</button>
        <p class="ny-hint">Etter at lisensen er opprettet, velger du hvilke prosjekter den skal ha tilgang til. Personen setter passord via "Sett passord første gang" på innloggingssiden.</p>
        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="save-success">@_melding</p>
        }
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
    </aside>
</div>

@code {
    private sealed class LisensRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public bool Aktiv { get; set; }
        public bool HarPassord { get; set; }
        public HashSet<int> ValgteProsjektIder { get; set; } = [];
        public int AntallProsjekter => ValgteProsjektIder.Count;
    }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<LisensRad> _lisenser = [];
    private List<ProsjektOption> _prosjekter = [];
    private int _antallAktive;
    private int _antallInaktive;
    private int? _apenId;
    private string _sok = "";
    private string _nyNavn = "";
    private string _nyEpost = "";
    private string? _melding;
    private string? _feil;

    private IEnumerable<LisensRad> Synlige => string.IsNullOrWhiteSpace(_sok)
        ? _lisenser
        : _lisenser.Where(l => l.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
                            || l.Epost.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string Initialer(string? navn)
    {
        var deler = (navn ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    // Klikk på en rad åpner redigering; klikk igjen (eller Avbryt) lukker og
    // henter de lagrede verdiene på nytt, så ulagrede endringer forkastes.
    private async Task VelgRad(LisensRad rad)
    {
        if (_apenId == rad.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await LoadAsync();
        }

        _apenId = rad.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _prosjekter = await Db.Prosjekter
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _lisenser = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Driftslisens)
            .Include(b => b.Prosjekter)
            .OrderBy(b => b.Navn)
            .Select(b => new LisensRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                Aktiv = b.Aktiv,
                HarPassord = b.PasswordHash != null,
                ValgteProsjektIder = b.Prosjekter.Select(p => p.Id).ToHashSet()
            })
            .ToListAsync();

        _antallAktive = _lisenser.Count(l => l.Aktiv);
        _antallInaktive = _lisenser.Count - _antallAktive;
    }

    private async Task OpprettLisens()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        var ny = new Bruker { Navn = navn, Epost = epost, Rolle = BrukerRolle.Driftslisens, Aktiv = true };
        Db.Brukere.Add(ny);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _feil = null;
        _melding = $"Driftslisensen \"{navn}\" er opprettet. Velg prosjektene den skal ha tilgang til i lista, så kan personen sette passord via \"Sett passord første gang\" på innloggingssiden.";
        await LoadAsync();
        // Åpne den nye lisensen med en gang, så prosjektene kan velges.
        _apenId = ny.Id;
    }

    private void ToggleProsjekt(LisensRad l, int prosjektId)
    {
        if (!l.ValgteProsjektIder.Add(prosjektId))
        {
            l.ValgteProsjektIder.Remove(prosjektId);
        }
    }

    private async Task Lagre(LisensRad l)
    {
        var navn = l.Navn.Trim();
        var epost = l.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0)
        {
            _feil = "Navn og e-post må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Prosjekter).FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.Aktiv = l.Aktiv;

        var gjeldende = bruker.Prosjekter.Select(p => p.Id).ToHashSet();
        var skalFjerne = gjeldende.Except(l.ValgteProsjektIder).ToList();
        var skalLeggeTil = l.ValgteProsjektIder.Except(gjeldende).ToList();

        foreach (var id in skalFjerne)
        {
            var p = bruker.Prosjekter.First(p => p.Id == id);
            bruker.Prosjekter.Remove(p);
        }

        foreach (var id in skalLeggeTil)
        {
            var p = await Db.Prosjekter.FindAsync(id);
            if (p is not null)
            {
                bruker.Prosjekter.Add(p);
            }
        }

        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
        _apenId = null;
        await LoadAsync();
    }

    private async Task NullstillPassord(LisensRad l)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{l.Navn}\".";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettLisens(LisensRad l)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == l.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);
        await Db.SaveChangesAsync();
        _melding = $"\"{l.Navn}\" er slettet.";
        _apenId = null;
        _feil = null;
        await LoadAsync();
    }
}
