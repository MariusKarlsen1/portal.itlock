@page "/arx-kalkulator"
@rendermode InteractiveServer
@* Nettopriser er forhandlerpriser, så montører ser ikke siden. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@using PortalItlock.Web.Components.Kalkulator
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>ARX-kalkulator</PageTitle>

@* ARX-kalkulatoren som veiviser (forslag 2, «Ett spørsmål»). Regnestykket
   ligger i ArxPrisberegner. Prisene hentes fra komponentregisteret på
   artikkelnummeret (Produktkode), netto og veiledende. *@
<KalkulatorVeiviser Tittel="ARX-kalkulator" Undertittel="Hardware, programvare og lisenser"
                    Steg="StegNavn" @bind-Aktivt="_steg" Sporsmal="@Sporsmal[_steg]" Forklaring="@Forklaring[_steg]"
                    BunnTekst="@BunnTekst" VisMerknad="@(Mangler.Count > 0)" TilbudTekst="@(_kopiert ? "Kopiert" : "Legg til i tilbud")" OnLeggTilTilbud="Kopier">
    <Merknad>
        <span><b>@Mangler.Count @(Mangler.Count == 1 ? "artikkel mangler" : "artikler mangler") i komponentregisteret</b> og regnes som 0 kr: @string.Join(", ", Mangler). <a href="/komponenter">Gå til komponentregisteret</a></span>
    </Merknad>
    <Tall>
        <div class="kv-tall"><small>Kost (netto)</small><b>@Kr(SumNetto) kr</b></div>
        <div class="kv-tall tot"><small>Bruttopris (veiledende)</small><b>@Kr(SumVeil) kr</b></div>
    </Tall>
    <ChildContent>
        @switch (_steg)
        {
            case 0:
                <div class="stor-teller">
                    <button type="button" @onclick="@(() => SettDorer(_v.Dorer - 1))" aria-label="Færre dører">−</button>
                    <input type="number" min="1" value="@_v.Dorer" aria-label="Antall dører" @oninput="@(e => SettDorer(Tall(e, 1)))" />
                    <button type="button" @onclick="@(() => SettDorer(_v.Dorer + 1))" aria-label="Flere dører">+</button>
                </div>
                <p class="kv-sentrert">Antall kablede dører med kortleser. Sentral, dørsentraler og lisenser regnes ut fra dette.</p>
                break;

            case 1:
                <div>
                    <div class="felt-t"><b>Kortleser</b><small>mA ved 24 V</small></div>
                    <div class="liste-valg">
                        @foreach (var (k, l) in ArxPrisberegner.Lesere)
                        {
                            <button type="button" class="lv @(_v.Leser == k ? "aktiv" : "")" @onclick="@(() => _v.Leser = k)">
                                <i></i><span><b>@l.Navn</b><small>@l.Tekst</small></span><span class="h">@l.HvileMa–@l.MaksMa mA</span>
                            </button>
                        }
                    </div>
                </div>
                <div>
                    <div class="felt-t"><b>Leser på én eller begge sider</b></div>
                    <div class="liste-valg">
                        <button type="button" class="lv @(!_v.BeggeSider ? "aktiv" : "")" @onclick="@(() => _v.BeggeSider = false)"><i></i><span><b>Leser på ene siden</b><small>Fri passering fra den andre siden</small></span><span class="h">1 per dør</span></button>
                        <button type="button" class="lv @(_v.BeggeSider ? "aktiv" : "")" @onclick="@(() => _v.BeggeSider = true)"><i></i><span><b>Leser på begge sider</b><small>Inn- og utlesing, anti-passback, sluse</small></span><span class="h">2 per dør</span></button>
                    </div>
                </div>
                break;

            case 2:
                <div class="liste-valg">
                    <button type="button" class="lv @(_v.Knapp == "" ? "aktiv" : "")" @onclick="@(() => _v.Knapp = "")"><i></i><span><b>Ingen åpneknapp</b><small>Fri utgang med vrider eller leser innvendig</small></span></button>
                    @foreach (var (k, kn) in ArxPrisberegner.Knapper)
                    {
                        <button type="button" class="lv @(_v.Knapp == k ? "aktiv" : "")" @onclick="@(() => _v.Knapp = k)"><i></i><span><b>@kn.Navn</b><small>@kn.Tekst</small></span><span class="h">@(kn.Hvile == kn.Maks ? $"{kn.Maks} mA" : $"{kn.Hvile}–{kn.Maks} mA")</span></button>
                    }
                </div>
                break;

            case 3:
                @if (ArxPrisberegner.Lesere[_v.Leser].HarLasSelv)
                {
                    <div class="hint">@ArxPrisberegner.Lesere[_v.Leser].Navn har lås og dørsentral innebygd. Ingen egne låser trengs.</div>
                }
                else
                {
                    <div>
                        <div class="felt-t"><b>Låser og nødåpnere som får strøm fra sentralen</b><small>mA ved 24 V · hvile / ved åpning</small></div>
                        <div class="liste-valg">
                            @foreach (var t in ArxPrisberegner.LasTyper)
                            {
                                var n = _v.LasAntall(t.Nokkel);
                                <div class="lasrad @(n > 0 ? "aktiv" : "")">
                                    <div>
                                        <b>@t.Navn</b><small>@t.Kilde</small>
                                        @if (t.EgneVerdier)
                                        {
                                            <div class="rad" style="justify-content:flex-start;margin-top:6px;font-size:12px">
                                                Hvile <input class="inp" type="number" min="0" value="@_v.EgenLasHvile" @oninput="@(e => _v.EgenLasHvile = Tall(e))" />
                                                Åpning <input class="inp" type="number" min="0" value="@_v.EgenLasMaks" @oninput="@(e => _v.EgenLasMaks = Tall(e))" /> mA
                                            </div>
                                        }
                                    </div>
                                    <span class="h">@(t.EgneVerdier ? "" : $"{t.HvileMa} / {t.MaksMa} mA")</span>
                                    <div class="stepper">
                                        <button type="button" @onclick="@(() => SettLas(t.Nokkel, n - 1))">−</button>
                                        <input type="number" min="0" value="@n" @oninput="@(e => SettLas(t.Nokkel, Tall(e)))" />
                                        <button type="button" @onclick="@(() => SettLas(t.Nokkel, n + 1))">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    var laser = ArxPrisberegner.LasTyper.Sum(t => _v.LasAntall(t.Nokkel));
                    <div class="sumlinje">
                        @if (laser == 0)
                        {
                            <span>Ingen låser på sentralens strøm. Låsene har egen strømforsyning.</span>
                        }
                        else
                        {
                            <span>@laser @(laser == 1 ? "lås" : "låser") på @_v.Dorer @(_v.Dorer == 1 ? "dør" : "dører")</span>
                            <b>@Kr(LasHvile) mA i hvile · @Kr(LasMaks) mA hvis alle åpner samtidig</b>
                        }
                    </div>
                }
                break;

            case 4:
                <div class="liste-valg">
                    @foreach (var (k, s) in ArxPrisberegner.Sentraler)
                    {
                        var forLiten = _v.Dorer > s.Maks;
                        <button type="button" class="lv @(R.Sentral == k ? "aktiv" : "")" disabled="@forLiten" @onclick="@(() => _v.Sentral = k == R.Anbefalt ? ArxSentral.Auto : k)">
                            <i></i><span><b>@s.Navn @if (k == R.Anbefalt) {<em class="merke">Anbefalt</em>}</b><small>@s.Tekst</small></span>
                            <span class="h">@(forLiten ? "For få plasser" : $"Maks {s.Maks} dører")</span>
                        </button>
                    }
                </div>
                break;

            case 5:
                <div class="liste-valg">
                    @foreach (var t in new[] { 1, 4, 12, 24, 30 })
                    {
                        var ah = R.Enheter.FirstOrDefault(e => e.Type != "poe") is { } e1 ? e1.HvileMa / 1000m * t / _v.Aldring : 0;
                        <button type="button" class="lv @(_v.Timer == t ? "aktiv" : "")" @onclick="@(() => _v.Timer = t)">
                            <i></i><span><b>@t @(t == 1 ? "time" : "timer")</b><small>@TimeTekst(t)</small></span><span class="h">@(ah > 0 ? $"{ah:0.0} Ah" : "")</span>
                        </button>
                    }
                </div>
                <p class="kv-sentrert">Sjekk krav for alarmgraden (EN 50131-6 / FG). Ah til høyre gjelder ditt anlegg.</p>
                break;

            case 6:
                @if (R.Sentral == ArxSentral.Ip9101)
                {
                    <div>
                        <div class="felt-t"><b>Strøm til 9101 IV2</b></div>
                        <div class="liste-valg">
                            <button type="button" class="lv @(_v.Strom9101 == ArxStrom9101.Batteribackup ? "aktiv" : "")" @onclick="@(() => _v.Strom9101 = ArxStrom9101.Batteribackup)"><i></i><span><b>Egen batteribackup <em class="merke">Anbefalt</em></b><small>3PS, 5PS eller 10PS etter batteribehov og last. Døren virker ved strømbrudd</small></span></button>
                            <button type="button" class="lv @(_v.Strom9101 == ArxStrom9101.PoE ? "aktiv" : "")" @onclick="@(() => _v.Strom9101 = ArxStrom9101.PoE)"><i></i><span><b>PoE fra nettverkssvitsj</b><small>Uten batteri. Krever UPS på kundens svitsj. Maks 1 A ut</small></span></button>
                        </div>
                    </div>
                }
                else if (R.Sentral == ArxSentral.Voco9016)
                {
                    <div>
                        <div class="felt-t"><b>Strømforsyning til 9016V</b><small>9016V har ikke batteri selv</small></div>
                        <div class="liste-valg">
                            <button type="button" class="lv @(_v.Psc == ArxPsc.Auto ? "aktiv" : "")" @onclick="@(() => _v.Psc = ArxPsc.Auto)"><i></i><span><b>Velg etter batteribehov <em class="merke">Anbefalt</em></b><small>10PSC M II eller 10PSC L, med batteriskap ved behov</small></span></button>
                            <button type="button" class="lv @(_v.Psc == ArxPsc.MII ? "aktiv" : "")" @onclick="@(() => _v.Psc = ArxPsc.MII)"><i></i><span><b>10PSC M II</b><small>24 V 10 A, plass til 2 × 20 Ah</small></span><span class="h">S55299310264</span></button>
                            <button type="button" class="lv @(_v.Psc == ArxPsc.L ? "aktiv" : "")" @onclick="@(() => _v.Psc = ArxPsc.L)"><i></i><span><b>10PSC L</b><small>24 V 10 A, plass til 2 × 45 Ah. For lang driftstid eller store anlegg</small></span><span class="h">S55299310165</span></button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hint">Strømforsyning er bygd inn i ARX Power. Bare batteriene legges til, og de velges etter driftstiden.</div>
                }
                <div>
                    <div class="felt-t"><b>Batteri</b><small>For @_v.Timer @(_v.Timer == 1 ? "time" : "timer") på batteri</small></div>
                    <div class="liste-valg">
                        @foreach (var e in R.Enheter)
                        {
                            <div class="lv @(e.ForLite || !e.LastOk ? "" : "aktiv")" style="cursor:default">
                                <i></i><span><b>@e.Navn</b><small>@Kr(e.HvileMa) mA i hvile × @_v.Timer t ÷ @_v.Aldring.ToString("0.0#", Kultur) = @e.BehovAh.ToString("0.0", Kultur) Ah · maks last @((e.MaksMa / 1000m).ToString("0.00", Kultur)) A av @e.LastA.ToString("0.#", Kultur) A</small></span>
                                <span class="h">@(e.ForLite ? "For lite" : e.Batteri)</span>
                            </div>
                        }
                    </div>
                </div>
                @foreach (var a in R.Advarsler)
                {
                    <div class="hint @(a.Feil ? "feil" : "")">@a.Tekst</div>
                }
                <p class="kv-sentrert">Alt som får strøm fra sentralen summeres. Hvilestrøm × driftstid ÷ @_v.Aldring.ToString("0.0#", Kultur) gir batteribehovet, og den minste løsningen som har nok Ah og tåler maks strøm velges.</p>
                break;

            case 7:
                <div class="liste-valg">
                    <button type="button" class="lv @(!_v.Utvidelse ? "aktiv" : "")" @onclick="@(() => _v.Utvidelse = false)"><i></i><span><b>Nytt anlegg</b><small>Grunnpakke med server og klient tas med</small></span></button>
                    <button type="button" class="lv @(_v.Utvidelse ? "aktiv" : "")" @onclick="@(() => _v.Utvidelse = true)"><i></i><span><b>Utvidelse av eksisterende anlegg</b><small>Bare dørlisenser for de nye dørene</small></span></button>
                </div>
                @if (!_v.Utvidelse)
                {
                    <div>
                        <div class="felt-t"><b>Grunnpakke</b><small>Én per anlegg</small></div>
                        <div class="liste-valg">
                            @foreach (var (kode, navn, bekreftet) in ArxPrisberegner.Grunnpakker)
                            {
                                <button type="button" class="lv @(_v.Grunnpakke == kode ? "aktiv" : "")" @onclick="@(() => _v.Grunnpakke = kode)"><i></i><span><b>@navn @if (!bekreftet) {<em class="merke gul">Bekreft navn</em>}</b><small>@kode</small></span><span class="h">@Kr(Pris(kode, false)) kr</span></button>
                            }
                        </div>
                    </div>
                }
                <div class="rad"><div class="t">Ekstra klientlisenser<small>Flere PC-er som administrerer ARX</small></div><input class="inp" type="number" min="0" value="@_v.Klienter" @oninput="@(e => _v.Klienter = Tall(e))" /></div>
                break;

            case 8:
                <div class="liste-valg">
                    <button type="button" class="lv @(!_v.Tilleggsfunksjoner ? "aktiv" : "")" @onclick="@(() => { _v.Tilleggsfunksjoner = false; _v.Moduler.Clear(); _v.MobileAccess = false; })"><i></i><span><b>Nei</b><small>Ingen tilleggsmoduler eller Mobile Access</small></span></button>
                    <button type="button" class="lv @(_v.Tilleggsfunksjoner ? "aktiv" : "")" @onclick="@(() => _v.Tilleggsfunksjoner = true)"><i></i><span><b>Ja</b><small>Velg moduler og Mobile Access</small></span></button>
                </div>
                @if (_v.Tilleggsfunksjoner)
                {
                    <div>
                        <div class="felt-t"><b>Tilleggsmoduler</b><small>@(_v.Moduler.Count == 0 ? "Ingen valgt" : $"{_v.Moduler.Count} valgt")</small></div>
                        <div class="liste-valg to">
                            @foreach (var m in ArxPrisberegner.Moduler)
                            {
                                <button type="button" class="lv multi @(_v.Moduler.Contains(m.Kode) ? "aktiv" : "")" @onclick="@(() => { if (!_v.Moduler.Remove(m.Kode)) _v.Moduler.Add(m.Kode); })"><i></i><span><b>@m.Navn</b><small>@m.Kode</small></span><span class="h">@Kr(Pris(m.Kode, false)) kr</span></button>
                            }
                        </div>
                    </div>
                    <div class="liste-valg">
                        <button type="button" class="lv multi @(_v.MobileAccess ? "aktiv" : "")" @onclick="@(() => _v.MobileAccess = !_v.MobileAccess)"><i></i><span><b>Mobile Access</b><small>Mobilnøkkel i ARX Mobil (BLE-lesere)</small></span><span class="h">@Kr(Pris("S5590490996", false)) kr</span></button>
                    </div>
                }
                break;

            case 9:
                <div class="liste-valg">
                    <button type="button" class="lv @(!_v.Alarm ? "aktiv" : "")" @onclick="@(() => _v.Alarm = false)"><i></i><span><b>Bare adgangskontroll</b><small>Ingen innbruddsalarm</small></span></button>
                    <button type="button" class="lv @(_v.Alarm ? "aktiv" : "")" @onclick="@(() => _v.Alarm = true)"><i></i><span><b>Med ARX Alarm</b><small>Innbruddsalarm i samme system, DAC630 får SIO6-4</small></span></button>
                </div>
                @if (_v.Alarm)
                {
                    <div class="liste-valg">
                        <button type="button" class="lv @(_v.Alarmgrad == 2 ? "aktiv" : "")" @onclick="@(() => _v.Alarmgrad = 2)"><i></i><span><b>Alarmgrad 2</b><small>Alarmoverføring direkte fra sentralen</small></span></button>
                        <button type="button" class="lv @(_v.Alarmgrad == 3 ? "aktiv" : "")" @onclick="@(() => _v.Alarmgrad = 3)"><i></i><span><b>Alarmgrad 3</b><small>Krever MIO6-6 per sentral. Ikke 9101</small></span></button>
                    </div>
                    <div class="rad"><div class="t">Innganger per dør<small>Magnetkontakt + mikrobryter = 2</small></div><input class="inp" type="number" min="0" value="@_v.InngangerPerDor" @oninput="@(e => _v.InngangerPerDor = Tall(e))" /></div>
                    <div class="rad"><div class="t">Ekstra innganger<small>Detektorer, vinduer</small></div><input class="inp" type="number" min="0" value="@_v.EkstraInnganger" @oninput="@(e => _v.EkstraInnganger = Tall(e))" /></div>
                    <div class="rad"><div class="t">Betjeningspaneler<small>Pando Display GO</small></div><input class="inp" type="number" min="0" value="@_v.Paneler" @oninput="@(e => _v.Paneler = Tall(e))" /></div>
                    <div class="liste-valg">
                        <button type="button" class="lv @(!_v.Communicator ? "aktiv" : "")" @onclick="@(() => _v.Communicator = false)"><i></i><span><b>Alarmoverføring via sentralen</b><small>Ethernet og AddSecure, opptil alarmgrad 2</small></span></button>
                        <button type="button" class="lv @(_v.Communicator ? "aktiv" : "")" @onclick="@(() => _v.Communicator = true)"><i></i><span><b>Med ARX Communicator</b><small>Alarmsender med IP og mobilnett, doble overføringsveier</small></span></button>
                    </div>
                }
                break;

            case 10:
                <div class="rad"><div class="t">DESFire-brikker<small>Kort eller brikker til brukerne</small></div><input class="inp" type="number" min="0" value="@_v.Brikker" @oninput="@(e => _v.Brikker = Tall(e))" /></div>
                break;

            default:
                <div class="hint">@Oppsummering</div>
                @foreach (var a in R.Advarsler)
                {
                    <div class="hint @(a.Feil ? "feil" : "")">@a.Tekst</div>
                }
                <div class="prisboks">
                    <div><small>Kost (netto)</small><b>@Kr(SumNetto) kr</b><span>Hardware @Kr(HwNetto) · lisenser @Kr(SumNetto - HwNetto)</span></div>
                    <div class="vei"><small>Bruttopris (veiledende)</small><b>@Kr(SumVeil) kr</b><span>Inkl. mva @Kr(SumVeil * 1.25m) kr</span></div>
                    <div class="db"><small>Fortjeneste ved veiledende</small><b>@Kr(SumVeil - SumNetto) kr</b><span>@(SumVeil > 0 ? Math.Round((SumVeil - SumNetto) / SumVeil * 100) : 0) % dekningsgrad</span></div>
                </div>
                @foreach (var e in R.Enheter)
                {
                    <div class="enhet">
                        <div class="enhet-h"><div><b>@e.Navn</b><small>@e.Dorer @(e.Dorer == 1 ? "dør" : "dører")@(e.Dac > 0 ? $" via {e.Dac} DAC630" : "") · @(e.Plasser - e.Dorer) ledige plasser</small></div><span class="pill @(e.ForLite ? "feil" : "")">@e.Batteri</span></div>
                        <table class="stab">
                            @foreach (var r in e.Rader)
                            {
                                <tr><td>@r.Navn</td><td class="n">@Kr(r.HvileMa) mA</td><td class="n">@Kr(r.MaksMa) mA</td></tr>
                            }
                            <tr class="s"><td>Sum hvile / maks</td><td class="n">@Kr(e.HvileMa) mA</td><td class="n">@Kr(e.MaksMa) mA</td></tr>
                        </table>
                    </div>
                }
                <table class="plist">
                    <thead><tr><th>Produkt</th><th>Art.nr</th><th class="n">Ant.</th><th class="n">Kostpris netto</th><th class="n">Veiledende brutto</th></tr></thead>
                    <tbody>
                        @foreach (var g in R.Linjer.GroupBy(x => x.Gruppe))
                        {
                            <tr class="grp"><td colspan="3">@g.Key</td><td class="n">@Kr(g.Sum(x => x.Antall * Pris(x.Kode, false)))</td><td class="n">@Kr(g.Sum(x => x.Antall * Pris(x.Kode, true)))</td></tr>
                            @foreach (var x in g)
                            {
                                <tr>
                                    <td>@NavnFor(x)@if (!_artikler.ContainsKey(x.Kode)) {<span class="mangler"> · mangler i komponentregisteret</span>}@if (!string.IsNullOrEmpty(x.Hvorfor)) {<div class="hvorfor">@x.Hvorfor</div>}</td>
                                    <td class="art">@x.Kode</td>
                                    <td class="n">@x.Antall</td>
                                    <td class="n">@Kr(x.Antall * Pris(x.Kode, false))@if (x.Antall > 1) {<small class="stk">@Kr(Pris(x.Kode, false)) stk</small>}</td>
                                    <td class="n"><b>@Kr(x.Antall * Pris(x.Kode, true))</b>@if (x.Antall > 1) {<small class="stk">@Kr(Pris(x.Kode, true)) stk</small>}</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot><tr><td colspan="3">Totalt eks. mva</td><td class="n">@Kr(SumNetto)</td><td class="n">@Kr(SumVeil)</td></tr></tfoot>
                </table>
                break;
        }
    </ChildContent>
</KalkulatorVeiviser>

@code {
    private sealed record Artikkel(string Navn, decimal Netto, decimal Veiledende);

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] StegNavn = ["Antall dører", "Kortleser", "Åpneknapp", "El-lås", "Sentral", "Driftstid", "Strømforsyning", "Programvare", "Tilleggsmoduler", "Alarm", "Kort", "Resultat"];
    private static readonly string[] Sporsmal =
    [
        "Hvor mange dører skal ha adgangskontroll?", "Hvilken kortleser skal sitte på dørene?", "Skal dørene ha åpneknapp?",
        "Hvilke låser får strøm fra sentralen?", "Hvilken sentral skal dørene kobles til?", "Hvor lenge skal anlegget gå på batteri ved strømbrudd?",
        "Strømforsyning og batteri", "Er det et nytt anlegg, og hvilken grunnpakke skal kunden ha?", "Trenger kunden noen tilleggsfunksjoner?",
        "Skal anlegget også ha innbruddsalarm?", "Hvor mange kort eller brikker skal leveres?", "Dette trengs"
    ];
    private static readonly string?[] Forklaring = [null, null, null, "Låsene er ikke med i produktlisten, bare i strøm og batteri.", null, null, null, null, null, null, null, null];

    private readonly ArxValg _v = new();
    private Dictionary<string, Artikkel> _artikler = [];
    private int _steg;
    private bool _kopiert;

    protected override async Task OnInitializedAsync()
    {
        var koder = ArxPrisberegner.AlleKoder().Select(k => k.ToUpperInvariant()).ToList();
        var komponenter = await Db.Components
            .Where(c => c.Produktkode != null && koder.Contains(c.Produktkode.Trim().ToUpper()))
            .Select(c => new { c.Produktkode, c.Navn, c.PrisNetto, c.PrisVeiledende, c.Aktiv })
            .ToListAsync();

        // Finnes artikkelnummeret flere ganger, gjelder det aktive.
        _artikler = komponenter
            .GroupBy(c => c.Produktkode!.Trim().ToUpperInvariant())
            .ToDictionary(g => g.Key, g =>
            {
                var c = g.OrderByDescending(x => x.Aktiv).First();
                return new Artikkel(c.Navn, c.PrisNetto ?? 0, c.PrisVeiledende ?? 0);
            });
    }

    private ArxResultat R => ArxPrisberegner.Beregn(_v);

    private decimal Pris(string kode, bool veiledende) =>
        _artikler.TryGetValue(kode.ToUpperInvariant(), out var a) ? (veiledende ? a.Veiledende : a.Netto) : 0;

    private string NavnFor(ArxLinje x) =>
        x.Kode.StartsWith("S559") && x.Gruppe == "Lisenser" ? x.Navn
        : _artikler.TryGetValue(x.Kode.ToUpperInvariant(), out var a) ? a.Navn : x.Navn;

    private List<string> Mangler => R.Linjer.Select(l => l.Kode).Distinct().Where(k => !_artikler.ContainsKey(k.ToUpperInvariant())).ToList();

    private decimal SumNetto => R.Linjer.Sum(x => x.Antall * Pris(x.Kode, false));
    private decimal SumVeil => R.Linjer.Sum(x => x.Antall * Pris(x.Kode, true));
    private decimal HwNetto => R.Linjer.Where(x => x.Gruppe is not ("Programvare" or "Lisenser")).Sum(x => x.Antall * Pris(x.Kode, false));

    private decimal LasHvile => ArxPrisberegner.LasTyper.Sum(t => _v.LasAntall(t.Nokkel) * (t.EgneVerdier ? _v.EgenLasHvile : t.HvileMa));
    private decimal LasMaks => ArxPrisberegner.LasTyper.Sum(t => _v.LasAntall(t.Nokkel) * (t.EgneVerdier ? _v.EgenLasMaks : t.MaksMa));

    private string BunnTekst
    {
        get
        {
            var sentral = ArxPrisberegner.Sentraler[R.Sentral].Navn;
            return $"{_v.Dorer} {(_v.Dorer == 1 ? "dør" : "dører")} · {ArxPrisberegner.Lesere[_v.Leser].Navn} · {sentral}";
        }
    }

    private string Oppsummering
    {
        get
        {
            var r = R;
            var sn = r.Enheter.Count > 1 ? $"{r.Enheter.Count} × {ArxPrisberegner.Sentraler[r.Sentral].Navn}" : ArxPrisberegner.Sentraler[r.Sentral].Navn;
            var batt = string.Join(", ", r.Enheter.Select(e => e.Batteri).Distinct());
            return $"{_v.Dorer} {(_v.Dorer == 1 ? "dør" : "dører")} med {ArxPrisberegner.Lesere[_v.Leser].Navn} på {sn}. Batteri: {batt} for {_v.Timer} timer. {r.DekketeDorlisenser} dørlisenser"
                + (_v.Utvidelse ? ", utvidelse av eksisterende anlegg." : $", {ArxPrisberegner.Grunnpakker.First(p => p.Kode == _v.Grunnpakke).Navn}.");
        }
    }

    private static string TimeTekst(int t) => t switch { 1 => "Kort strømbrudd", 4 => "Noen timer", 12 => "En natt", 24 => "Ett døgn", _ => "Over ett døgn" };

    private void SettDorer(int n)
    {
        _v.Dorer = Math.Clamp(n, 1, 400);
        if (_v.Sentral != ArxSentral.Auto && _v.Dorer > ArxPrisberegner.Sentraler[_v.Sentral].Maks) _v.Sentral = ArxSentral.Auto;
    }

    private void SettLas(string nokkel, int n) => _v.Laser[nokkel] = Math.Max(0, n);

    private static int Tall(ChangeEventArgs e, int min = 0) =>
        int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, min, 9999) : min;

    private static string Kr(decimal v) => v.ToString("N0", Kultur);

    // Til tilbudet er koblet på: kopier produktlisten så den kan limes inn.
    private async Task Kopier()
    {
        var linjer = new List<string> { "ARX (netto / veiledende, eks mva)" };
        linjer.AddRange(R.Linjer.Select(x => $"{x.Antall} x {x.Kode} {NavnFor(x)}: {Kr(x.Antall * Pris(x.Kode, false))} / {Kr(x.Antall * Pris(x.Kode, true))} kr"));
        linjer.Add($"Totalt: {Kr(SumNetto)} / {Kr(SumVeil)} kr");
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join('\n', linjer));
        _kopiert = true;
        StateHasChanged();
        await Task.Delay(1500);
        _kopiert = false;
    }
}
