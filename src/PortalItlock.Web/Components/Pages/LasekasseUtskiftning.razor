@page "/lasekasse-utskiftning"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services

<PageTitle>Utskiftning av gammel låskasse</PageTitle>

<div class="utskiftning-header">
    <span class="utskiftning-header-ikon"><Icon Name="lock" /></span>
    <div>
        <h1>Utskiftning av gammel låskasse</h1>
        <p>Finn riktig utskiftning</p>
    </div>
</div>

<label class="sok-felt">
    <Icon Name="search" />
    <input @bind="_sok" @bind:event="oninput" placeholder="F.eks. 1341, S22, 5012..." autofocus />
</label>

@if (string.IsNullOrWhiteSpace(_sok))
{
    <div class="hjelp-boks">
        <svg class="hjelp-tegning" viewBox="-40 -6 320 406" role="img" aria-label="Låskasse sett fra siden – låsnummeret står på stolpen av låskassen">
            <defs>
                <marker id="hjelp-pil" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M1 1.5 L9 5 L1 8.5" fill="none" stroke="#835e41" stroke-width="1.6" />
                </marker>
            </defs>
            <g fill="#fff" stroke="#8f857c" stroke-width="1.4" stroke-linejoin="round">
                <path d="M96 80 H206 L220 94 V310 H96 Z" />
                <path d="M150 82 H204 L216 96 V140 L204 152 H156 L146 140 V88 Z" fill="#faf8f5" stroke-width="1" />
                <circle cx="180" cy="118" r="14" />
                <rect x="175" y="113" width="10" height="10" fill="#efe9e2" />
                <circle cx="180" cy="280" r="6" fill="#efe9e2" />
                <rect x="178" y="280" width="4" height="11" rx="1" fill="#efe9e2" />
                <path d="M80 160 H67 L62 168 V186 H80 Z" fill="#f4efe9" />
                <rect x="66" y="200" width="14" height="22" rx="1.5" fill="#f4efe9" />
                <rect x="80" y="20" width="16" height="360" rx="8" />
                <ellipse cx="88" cy="36" rx="3" ry="5" fill="#efe9e2" />
                <ellipse cx="88" cy="364" rx="3" ry="5" fill="#efe9e2" />
                <rect x="100" y="88" width="12" height="26" rx="1.5" fill="#f6f1ea" stroke-width="1" />
            </g>
            <g font-family="system-ui, sans-serif" font-size="12" fill="#835e41">
                <circle cx="106" cy="101" r="9" fill="none" stroke="#835e41" stroke-width="1.4" />
                <path d="M97 101 H44" stroke="#835e41" stroke-width="1.2" fill="none" />
                <text x="40" y="97" text-anchor="end" font-weight="600">Låsnummer</text>
                <text x="40" y="111" text-anchor="end" fill="#9b9189" font-size="11">står her</text>
            </g>
            @if (_visMal)
            {
                <g font-family="system-ui, sans-serif" font-size="12" fill="#835e41">
                    <path d="M80 18 V2 M180 100 V2" stroke="#835e41" stroke-width=".8" stroke-dasharray="3 3" fill="none" />
                    <path d="M83 8 H177" stroke="#835e41" stroke-width="1.3" fill="none" marker-start="url(#hjelp-pil)" marker-end="url(#hjelp-pil)" />
                    <rect x="104" y="0" width="52" height="15" fill="#fff" />
                    <text x="130" y="12" text-anchor="middle" font-weight="600">Backset</text>
                    <path d="M196 118 H262 M188 280 H262" stroke="#835e41" stroke-width=".8" stroke-dasharray="3 3" fill="none" />
                    <path d="M254 121 V277" stroke="#835e41" stroke-width="1.3" fill="none" marker-start="url(#hjelp-pil)" marker-end="url(#hjelp-pil)" />
                    <text x="262" y="196" font-weight="600">c/c</text>
                    <path d="M60 173 H40 M64 211 H40" stroke="#835e41" stroke-width="1.2" fill="none" />
                    <text x="36" y="177" text-anchor="end" font-weight="600">Falle</text>
                    <text x="36" y="215" text-anchor="end" font-weight="600">Reile</text>
                </g>
            }
        </svg>
        <div class="hjelp-tekst">
            <h2>Slik finner du riktig erstatning</h2>
            <ol>
                <li>Åpne døra og se på <strong>stolpen av låskassen</strong>.</li>
                <li>Skriv inn <strong>nummeret</strong> som står stemplet der.</li>
                <li>Får du flere treff? Les merknaden i svaret.</li>
            </ol>
            <button type="button" class="hjelp-mer" @onclick="@(() => _visMal = !_visMal)">
                @(_visMal ? "Skjul mål og deler ↑" : "Vis mål og deler ↓")
            </button>
            @if (_visMal)
            {
                <dl class="hjelp-forklaring">
                    <dt>Backset</dt>
                    <dd>Fra forkanten av forstykket inn til midten av vriderhullet.</dd>
                    <dt>c/c</dt>
                    <dd>Fra midten av vriderhullet til midten av sylinderhullet. Er den ulik, trengs utskiftningsskilt.</dd>
                    <dt>Falle og reile</dt>
                    <dd>Må treffe sluttstykket etter byttet.</dd>
                </dl>
            }
        </div>
    </div>
}
else if (_treff.Count == 0)
{
    <div class="utskiftning-tom">
        <Icon Name="alert" />
        <p>Ingen treff på "@_sok". Sjekk at nummeret er riktig, eller prøv færre tegn.</p>
    </div>
}
else
{
    <p class="result-count">@_treff.Count treff</p>
    <div class="treff-liste">
        @foreach (var rad in _treff)
        {
            <div class="treff-kort treff-kort-@KategoriKlasse(rad.Kategori)">
                <div class="treff-header">
                    <span class="treff-du-har">Du har: <strong>@rad.DuHarLas</strong></span>
                    <span class="treff-kategori treff-kategori-@KategoriKlasse(rad.Kategori)">@rad.Kategori</span>
                </div>
                <div class="treff-grid">
                    <div>
                        <span class="info-label">Låskasse</span>
                        <span class="treff-verdi">@(rad.Laskasse ?? "-")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(rad.Utskiftningsskilt))
                    {
                        <div>
                            <span class="info-label">Utskiftningsskilt</span>
                            <span class="treff-verdi">@rad.Utskiftningsskilt</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(rad.Sylinder))
                    {
                        <div>
                            <span class="info-label">Sylinder</span>
                            <span class="treff-verdi">@rad.Sylinder</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(rad.Annet))
                    {
                        <div>
                            <span class="info-label">Annet</span>
                            <span class="treff-verdi">@rad.Annet</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(rad.Alternativt))
                    {
                        <div>
                            <span class="info-label">Alternativt</span>
                            <span class="treff-verdi">@rad.Alternativt</span>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(rad.Merknad))
                {
                    <p class="treff-merknad">@rad.Merknad</p>
                }
                @{ var kategoriMerknad = LasOvergangData.MerknadForKategori(rad.Kategori); }
                @if (!string.IsNullOrWhiteSpace(kategoriMerknad))
                {
                    <p class="treff-merknad">@kategoriMerknad</p>
                }
            </div>
        }
    </div>
}

@code {
    private string _sok = "";
    private bool _visMal;

    private List<LasOvergangRad> _treff => LasOvergangData.Sok(_sok);

    private static string KategoriKlasse(string kategori) => kategori switch
    {
        "Trio" => "trio",
        "Ving" => "ving",
        "Mellomdørlåser" => "mellomdorlaser",
        "TrioVing låser" => "trioving",
        "TrioVing smalprofil" or "TrioVing smalprofil (modullås)" => "smalprofil",
        _ => "annet"
    };
}
