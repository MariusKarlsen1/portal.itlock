@page "/lasekasse-utskiftning"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject VisningPreferanseService VisningPref

<PageTitle>Utskiftning av låskasse</PageTitle>

@* M1 (laskasse-forslag): tabell fra gammel til ny lås, med annenhver grå og
   hvit rad. Er kortet smalt, skjules kolonnene og raden foldes ut i stedet. *@
<div class="lk-side @(_full ? "lk-full" : "")">
    <header class="lk-hode">
        <span class="lk-hode-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Utskiftning av låskasse</h1>
            <p>Finn riktig erstatning for en gammel lås</p>
        </div>
    </header>

    <div class="lk-kort">
        <div class="lk-topplinje">
            <label class="lk-sok">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" @bind:after="SokEndret" placeholder="Skriv låsnummeret, f.eks. 1341, S22 eller 5012" aria-label="Låsnummer" autofocus />
            </label>
            <button type="button" class="lk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>

        @if (string.IsNullOrWhiteSpace(_sok))
        {
            <div class="lk-start">
                <section class="lk-ramme">
                    <div class="lk-gra">Slik finner du riktig erstatning</div>
                    <div class="lk-hjelp">
                    <svg class="lk-tegning" viewBox="-40 -6 320 406" role="img" aria-label="Låskasse sett fra siden – låsnummeret står på stolpen av låskassen">
                    <defs>
                        <marker id="hjelp-pil" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M1 1.5 L9 5 L1 8.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </marker>
                    </defs>
                    <g fill="#fff" stroke="#6B7687" stroke-width="1.4" stroke-linejoin="round">
                        <path d="M96 80 H206 L220 94 V310 H96 Z" />
                        <path d="M150 82 H204 L216 96 V140 L204 152 H156 L146 140 V88 Z" fill="#EEF1F5" stroke-width="1" />
                        <circle cx="180" cy="118" r="14" />
                        <rect x="175" y="113" width="10" height="10" fill="#EEF1F5" />
                        <circle cx="180" cy="280" r="6" fill="#EEF1F5" />
                        <rect x="178" y="280" width="4" height="11" rx="1" fill="#EEF1F5" />
                        <path d="M80 160 H67 L62 168 V186 H80 Z" fill="#EEF1F5" />
                        <rect x="66" y="200" width="14" height="22" rx="1.5" fill="#EEF1F5" />
                        <rect x="80" y="20" width="16" height="360" rx="8" />
                        <ellipse cx="88" cy="36" rx="3" ry="5" fill="#EEF1F5" />
                        <ellipse cx="88" cy="364" rx="3" ry="5" fill="#EEF1F5" />
                        <rect x="100" y="88" width="12" height="26" rx="1.5" fill="#EEF1F5" stroke-width="1" />
                    </g>
                    <g font-family="system-ui, sans-serif" font-size="12" fill="currentColor">
                        <circle cx="106" cy="101" r="9" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <path d="M97 101 H44" stroke="currentColor" stroke-width="1.2" fill="none" />
                        <text x="40" y="97" text-anchor="end" font-weight="600">Låsnummer</text>
                        <text x="40" y="111" text-anchor="end" opacity="0.75" font-size="11">står her</text>
                    </g>
                        <g font-family="system-ui, sans-serif" font-size="12" fill="currentColor">
                            <path d="M80 18 V2 M180 100 V2" stroke="currentColor" stroke-width=".8" stroke-dasharray="3 3" fill="none" />
                            <path d="M83 8 H177" stroke="currentColor" stroke-width="1.3" fill="none" marker-start="url(#hjelp-pil)" marker-end="url(#hjelp-pil)" />
                            <rect x="104" y="0" width="52" height="15" fill="#fff" />
                            <text x="130" y="12" text-anchor="middle" font-weight="600">Backset</text>
                            <path d="M196 118 H262 M188 280 H262" stroke="currentColor" stroke-width=".8" stroke-dasharray="3 3" fill="none" />
                            <path d="M254 121 V277" stroke="currentColor" stroke-width="1.3" fill="none" marker-start="url(#hjelp-pil)" marker-end="url(#hjelp-pil)" />
                            <text x="262" y="196" font-weight="600">c/c</text>
                            <path d="M60 173 H40 M64 211 H40" stroke="currentColor" stroke-width="1.2" fill="none" />
                            <text x="36" y="177" text-anchor="end" font-weight="600">Falle</text>
                            <text x="36" y="215" text-anchor="end" font-weight="600">Reile</text>
                        </g>
                </svg>
                        <ol>
                            <li>Åpne døra og se på <strong>stolpen av låskassen</strong>.</li>
                            <li>Skriv inn <strong>nummeret</strong> som står stemplet der.</li>
                            <li>Får du flere treff? Les merknaden i svaret.</li>
                        </ol>
                    </div>
                </section>
                <section class="lk-ramme">
                    <div class="lk-gra">Mål og deler</div>
                    <dl class="lk-mal">
                        <div><dt>Backset</dt><dd>Fra forkanten av forstykket inn til midten av vriderhullet.</dd></div>
                        <div><dt>c/c</dt><dd>Fra midten av vriderhullet til midten av sylinderhullet. Er den ulik, trengs utskiftningsskilt.</dd></div>
                        <div><dt>Falle og regel</dt><dd>Må treffe sluttstykket etter byttet.</dd></div>
                    </dl>
                </section>
            </div>
        }
        else if (_treff.Count == 0)
        {
            <div class="lk-tom">
                <Icon Name="alert" />
                <p>Ingen treff på "@_sok". Sjekk at nummeret er riktig, eller prøv færre tegn.</p>
            </div>
        }
        else
        {
            var typer = _treff.GroupBy(r => r.Kategori).Select(g => (Navn: g.Key, Antall: g.Count())).ToList();
            var valgtType = typer.Any(t => t.Navn == _type) ? _type : null;
            var synlige = valgtType is null ? _treff : _treff.Where(r => r.Kategori == valgtType).ToList();

            @if (typer.Count > 1)
            {
                <div class="lk-valg">
                    <button type="button" class="@(valgtType is null ? "aktiv" : "")" @onclick="@(() => VelgType(null))">Alle <em>@_treff.Count</em></button>
                    @foreach (var t in typer)
                    {
                        <button type="button" class="@(valgtType == t.Navn ? "aktiv" : "")" @onclick="@(() => VelgType(t.Navn))">@t.Navn <em>@t.Antall</em></button>
                    }
                </div>
            }
            else
            {
                <p class="lk-antall">@(_treff.Count == 1 ? "1 treff" : $"{_treff.Count} treff")</p>
            }

            <div class="lk-ramme">
                <table class="lk-tabell">
                    <thead>
                        <tr>
                            <th class="lk-har">Du har</th>
                            <th class="lk-bred lk-pil"></th>
                            <th>Ny låskasse</th>
                            <th class="lk-bred">Skilt</th>
                            <th class="lk-bred">Sylinder</th>
                            <th class="lk-bred">Merknad</th>
                            <th class="lk-smal"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rad in synlige)
                        {
                            var apen = ReferenceEquals(_apenRad, rad);
                            <tr class="@(apen ? "lk-apen" : "")" @onclick="@(() => VekslRad(rad))">
                                <td class="lk-har"><b>@rad.DuHarLas</b><small>@rad.Kategori</small></td>
                                <td class="lk-bred lk-pil"><Icon Name="chevron-right" /></td>
                                <td><span class="lk-ny">@Verdi(rad.Laskasse)</span></td>
                                <td class="lk-bred">@Verdi(rad.Utskiftningsskilt)</td>
                                <td class="lk-bred">@Verdi(rad.Sylinder)</td>
                                <td class="lk-bred lk-merknad">@Merknad(rad)</td>
                                <td class="lk-smal lk-veksle">
                                    <button type="button" aria-expanded="@(apen ? "true" : "false")" aria-label="@(apen ? "Skjul detaljer" : "Vis detaljer")"><Icon Name="chevron-down" /></button>
                                </td>
                            </tr>
                            @if (apen)
                            {
                                <tr class="lk-detalj">
                                    <td colspan="7">
                                        <dl>
                                            <div><dt>Skilt</dt><dd>@Verdi(rad.Utskiftningsskilt)</dd></div>
                                            <div><dt>Sylinder</dt><dd>@Verdi(rad.Sylinder)</dd></div>
                                            <div><dt>Merknad</dt><dd>@Merknad(rad)</dd></div>
                                        </dl>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var merknad in synlige.Select(r => LasOvergangData.MerknadForKategori(r.Kategori)).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct())
            {
                <p class="lk-fotnote">@merknad</p>
            }
        }
    </div>
</div>

@code {
    private string _sok = "";
    private string? _type;
    private LasOvergangRad? _apenRad;
    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("lasekasse-bredde", "normal") == "full";
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("lasekasse-bredde", _full ? "full" : "normal");
    }

    private List<LasOvergangRad> _treff => LasOvergangData.Sok(_sok);

    private void SokEndret()
    {
        _apenRad = null;
    }

    private void VelgType(string? type)
    {
        _type = type;
        _apenRad = null;
    }

    private void VekslRad(LasOvergangRad rad) => _apenRad = ReferenceEquals(_apenRad, rad) ? null : rad;

    private static string Verdi(string? verdi) => string.IsNullOrWhiteSpace(verdi) || verdi == "-" ? "–" : verdi;

    // Annet, alternativt og merknaden på raden, samlet i én kolonne.
    private static string Merknad(LasOvergangRad rad)
    {
        var alternativt = string.IsNullOrWhiteSpace(rad.Alternativt)
            ? null
            : "Alternativt: " + System.Text.RegularExpressions.Regex.Replace(rad.Alternativt, @",\s*", ", ");
        var deler = new[] { rad.Annet, alternativt, rad.Merknad }.Where(d => !string.IsNullOrWhiteSpace(d)).ToList();
        return deler.Count == 0 ? "–" : string.Join(" · ", deler);
    }
}
