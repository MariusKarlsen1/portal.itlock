@page "/guidermodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Guider - itlock</PageTitle>

<h1>Guider</h1>
<p class="section-hint">Guider til bruk i felt og i prosjektering.</p>

<div class="modul-grid">
    <a href="/guide/kobling" class="modul-card">
        <Icon Name="trend-up" />
        <span class="modul-card-title">Kobling</span>
        <span class="modul-card-desc">Guide for kobling.</span>
    </a>
    <a href="/dormiljo" class="modul-card">
        <Icon Name="box" />
        <span class="modul-card-title">Dørmiljø</span>
        <span class="modul-card-desc">Tegninger til bruk på befaring og i prosjektering.</span>
    </a>
    <a href="/guide/oppsett-adgangskontroll" class="modul-card">
        <Icon Name="bell" />
        <span class="modul-card-title">Oppsett adgangskontroll</span>
        <span class="modul-card-desc">Guide for oppsett av adgangskontroll.</span>
    </a>
</div>
