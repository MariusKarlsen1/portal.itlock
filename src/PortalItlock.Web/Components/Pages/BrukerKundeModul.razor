@page "/brukerkundemodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Brukere og kunder - itlock</PageTitle>

<a class="back-link" href="/"><Icon Name="arrow-left" />Til hjem</a>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="users" /></span>
    <div>
        <h1>Brukere og kunder</h1>
        <p class="section-hint">Brukere, kunder, kundeoppfølging og fravær.</p>
    </div>
</div>

<div class="modul-grid">
    <a href="/brukere" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="users" /></span>
        <span class="modul-card-title">Brukere</span>
        <span class="modul-card-desc">Opprett brukere med e-post, stilling og tilgang til portalen.</span>
    </a>
    <a href="/kunder" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="folder" /></span>
        <span class="modul-card-title">Kunder</span>
        <span class="modul-card-desc">Opprett og vedlikehold kunderegisteret.</span>
    </a>
    <a href="/kundeoppfolging" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="clock" /></span>
        <span class="modul-card-title">Kundeoppfølging</span>
        <span class="modul-card-desc">Kunder som bør følges opp, med logg og påminnelser.</span>
    </a>
    <a href="/kundetilganger" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="bell" /></span>
        <span class="modul-card-title">Kundetilganger</span>
        <span class="modul-card-desc">Administrer innlogging til kundeportalen.</span>
    </a>
    <a href="/fravar" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="sun" /></span>
        <span class="modul-card-title">Fravær</span>
        <span class="modul-card-desc">Søknader, godkjenning og fraværskalender per person.</span>
    </a>
    <a href="/driftslisenser" class="modul-card">
        <span class="modul-card-ikon"><Icon Name="tool" /></span>
        <span class="modul-card-title">Driftslisenser</span>
        <span class="modul-card-desc">Gi vaktmestere tilgang til å registrere driftsmeldinger på utvalgte prosjekter.</span>
    </a>
</div>
