@page "/ai-assistent"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using PortalItlock.Web.Services
@inject AiAssistentService AiSvc
@inject IJSRuntime JS

<PageTitle>AI-assistent</PageTitle>

<h1><Icon Name="sparkle" /> AI-assistent</h1>
<p class="ai-sub">Spør om prosjekter, dører eller tickets - assistenten slår opp i portalens data og svarer. Den kan ikke gjøre endringer.</p>

<div class="ai-chat-wrap">
    <div class="ai-meldinger" id="ai-meldinger">
        @if (_historikk.Count == 0)
        {
            <div class="ai-tom-tilstand">
                <p>Noen eksempler du kan spørre om:</p>
                <ul>
                    <li>"Hvor mange dører gjenstår på prosjekt Storefjell?"</li>
                    <li>"Vis meg åpne tickets med høy prioritet"</li>
                    <li>"Hvordan går det overordnet akkurat nå?"</li>
                </ul>
            </div>
        }
        @foreach (var m in _historikk)
        {
            <div class="ai-boble ai-boble-@m.Rolle">
                <span class="ai-boble-avsender">@(m.Rolle == "user" ? "Deg" : "AI")</span>
                <div class="ai-boble-tekst">@m.Tekst</div>
            </div>
        }
        @if (_venter)
        {
            <div class="ai-boble ai-boble-assistant">
                <span class="ai-boble-avsender">AI</span>
                <div class="ai-boble-tekst ai-tenker">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }
    </div>

    <div class="ai-input-rad">
        <textarea class="ai-input" rows="2" placeholder="Skriv et spørsmål..." @bind="_inputTekst" @bind:event="oninput"
                  @onkeydown="OnKeyDown" disabled="@_venter"></textarea>
        <button type="button" class="ai-send-button" @onclick="SendMelding" disabled="@(_venter || string.IsNullOrWhiteSpace(_inputTekst))">Send</button>
    </div>
</div>

@code {
    private readonly List<AiMelding> _historikk = [];
    private string _inputTekst = "";
    private bool _venter;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMelding();
        }
    }

    private async Task SendMelding()
    {
        var tekst = _inputTekst.Trim();
        if (string.IsNullOrWhiteSpace(tekst) || _venter)
        {
            return;
        }

        var forrigeHistorikk = _historikk.ToList();
        _historikk.Add(new AiMelding("user", tekst));
        _inputTekst = "";
        _venter = true;
        StateHasChanged();
        await ScrollTilBunn();

        var svar = await AiSvc.SvarAsync(forrigeHistorikk, tekst);

        _historikk.Add(new AiMelding("assistant", svar));
        _venter = false;
        StateHasChanged();
        await ScrollTilBunn();
    }

    private async Task ScrollTilBunn()
    {
        try
        {
            await JS.InvokeVoidAsync("aiassistent.scrollTilBunn", "ai-meldinger");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
