@page "/ai-assistent"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject AiAssistentService AiSvc
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>AI-assistent</PageTitle>

@* A3: tom samtale = stor startside med ett skrivefelt og ferdige forslag.
   Fra første melding blir det vanlig chat. Alle endringer AI foreslår må
   fortsatt bekreftes før noe lagres (se ai-handling-kort). *@
<div class="ai-chat-wrap @(ErTom ? "ai-tom" : "")">
    @if (ErTom)
    {
        <div class="ai-start">
            <span class="ai-gnist ai-gnist-stor"><Icon Name="sparkle" /></span>
            <h1 class="ai-start-tittel">Hva kan jeg hjelpe deg med@(string.IsNullOrWhiteSpace(_brukerFornavn) ? "" : $", {_brukerFornavn}")?</h1>
            <p class="ai-start-under">Spør om prosjekter, dører og tickets – eller be meg gjøre en endring. Du bekrefter alltid før noe lagres.</p>

            <div class="ai-skrivefelt ai-skrivefelt-stor">
                <textarea class="ai-input" rows="2" placeholder="F.eks. «Hvor mange dører gjenstår på prosjektene?»" @ref="_inputRef"
                          @bind="_inputTekst" @bind:event="oninput" @onkeydown="OnKeyDown"></textarea>
                <button type="button" class="ai-send-button" title="Send" @onclick="SendMelding" disabled="@string.IsNullOrWhiteSpace(_inputTekst)"><Icon Name="send" /></button>
            </div>

            <div class="ai-forslag">
                @foreach (var (tittel, ikon, forslag, sendDirekte) in Forslag)
                {
                    <div class="ai-forslag-gruppe">
                        <b><Icon Name="@ikon" />@tittel</b>
                        @foreach (var f in forslag)
                        {
                            <button type="button" class="ai-forslag-knapp" @onclick="@(() => VelgForslag(f, sendDirekte))">@f</button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="ai-chat-topp">
            <h1><span class="ai-gnist"><Icon Name="sparkle" /></span>AI-assistent</h1>
            <button type="button" class="ai-ny-samtale" @onclick="NySamtale" disabled="@(_venter || _utforerHandling)"><Icon Name="plus" /> Ny samtale</button>
        </div>

        <div class="ai-meldinger" id="ai-meldinger">
            @foreach (var m in _historikk)
            {
                <div class="ai-boble ai-boble-@m.Rolle">
                    @if (m.Rolle == "user")
                    {
                        <span class="ai-avatar">@_brukerInitialer</span>
                    }
                    else
                    {
                        <span class="ai-gnist ai-gnist-liten"><Icon Name="sparkle" /></span>
                    }
                    <div class="ai-boble-tekst">@m.Tekst</div>
                </div>
            }
            @if (_venter)
            {
                <div class="ai-boble ai-boble-assistant">
                    <span class="ai-gnist ai-gnist-liten"><Icon Name="sparkle" /></span>
                    <div class="ai-boble-tekst ai-tenker">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
            @if (_pendingHandling is not null)
            {
                <div class="ai-boble ai-boble-assistant">
                    <span class="ai-gnist ai-gnist-liten"><Icon Name="sparkle" /></span>
                    <div class="ai-handling-kort">
                        <span class="ai-handling-tittel">Foreslått endring <i>Venter på deg</i></span>
                        <p class="ai-handling-beskrivelse">@_pendingHandling.Beskrivelse</p>
                        <div class="ai-handling-knapper">
                            <button type="button" class="ai-bekreft-button" @onclick="BekreftHandling" disabled="@_utforerHandling"><Icon Name="check" /> Bekreft</button>
                            <button type="button" class="ai-avbryt-button" @onclick="AvbrytHandling" disabled="@_utforerHandling">Avbryt</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="ai-bunn">
            <div class="ai-skrivefelt">
                <textarea class="ai-input" rows="1" placeholder="Skriv et spørsmål …" @ref="_inputRef" @bind="_inputTekst" @bind:event="oninput"
                          @onkeydown="OnKeyDown" disabled="@(_venter || _pendingHandling is not null)"></textarea>
                <button type="button" class="ai-send-button" title="Send" @onclick="SendMelding" disabled="@(_venter || _pendingHandling is not null || string.IsNullOrWhiteSpace(_inputTekst))"><Icon Name="send" /></button>
            </div>
            <p class="ai-hint">Enter sender · Shift+Enter gir ny linje · Endringer gjøres først når du trykker Bekreft</p>
        </div>
    }
</div>

@code {
    private readonly List<AiMelding> _historikk = [];
    private string _inputTekst = "";
    private bool _venter;
    private AiForeslattHandling? _pendingHandling;
    private bool _utforerHandling;
    private string? _brukerFornavn;
    private string _brukerInitialer = "";
    private ElementReference _inputRef;

    private bool ErTom => _historikk.Count == 0 && !_venter && _pendingHandling is null;

    // Forslagene på startsiden. "Finn" og "Lær" sendes med en gang; "Endre"
    // legges i skrivefeltet så man selv fyller inn hvilket prosjekt, dør osv.
    private static readonly (string Tittel, string Ikon, string[] Forslag, bool SendDirekte)[] Forslag =
    [
        ("Finn", "search", ["Vis nye tickets", "Hvor mange dører gjenstår på prosjektene?", "Hvilke prosjekter er under arbeid nå?"], true),
        ("Endre", "edit", ["Opprett en ticket på prosjektet ", "Sett en dør til ferdig på prosjektet ", "Endre prisen på komponenten "], false),
        ("Lær", "help-circle", ["Hvordan lager jeg et tilbud?", "Hvordan godkjenner jeg timer?", "Hvordan setter jeg opp en serviceavtale?"], true),
    ];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                var navn = await Db.Brukere.Where(b => b.Id == bid).Select(b => b.Navn).FirstOrDefaultAsync();
                var deler = navn?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? [];
                _brukerFornavn = deler.FirstOrDefault();
                _brukerInitialer = string.Concat(deler.Take(2).Select(d => char.ToUpperInvariant(d[0])));
            }
        }
    }

    private async Task VelgForslag(string tekst, bool sendDirekte)
    {
        _inputTekst = tekst;
        if (sendDirekte)
        {
            await SendMelding();
            return;
        }

        try
        {
            await _inputRef.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void NySamtale()
    {
        if (_venter || _utforerHandling)
        {
            return;
        }

        _historikk.Clear();
        _pendingHandling = null;
        _inputTekst = "";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMelding();
        }
    }

    private async Task SendMelding()
    {
        var tekst = _inputTekst.Trim();
        if (string.IsNullOrWhiteSpace(tekst) || _venter || _pendingHandling is not null)
        {
            return;
        }

        var forrigeHistorikk = _historikk.ToList();
        _historikk.Add(new AiMelding("user", tekst));
        _inputTekst = "";
        _venter = true;
        StateHasChanged();
        await ScrollTilBunn();

        var svar = await AiSvc.SvarAsync(forrigeHistorikk, tekst);

        if (!string.IsNullOrWhiteSpace(svar.Tekst))
        {
            _historikk.Add(new AiMelding("assistant", svar.Tekst));
        }
        _pendingHandling = svar.ForeslattHandling;
        _venter = false;
        StateHasChanged();
        await ScrollTilBunn();
    }

    private async Task BekreftHandling()
    {
        if (_pendingHandling is null || _utforerHandling)
        {
            return;
        }

        _utforerHandling = true;
        StateHasChanged();

        var resultat = await AiSvc.UtforHandlingAsync(_pendingHandling.VerktoyNavn, _pendingHandling.Input);
        _historikk.Add(new AiMelding("assistant", resultat));

        _pendingHandling = null;
        _utforerHandling = false;
        StateHasChanged();
        await ScrollTilBunn();
    }

    private async Task AvbrytHandling()
    {
        if (_pendingHandling is null)
        {
            return;
        }

        _historikk.Add(new AiMelding("assistant", "❌ Avbrutt - ingenting ble endret."));
        _pendingHandling = null;
        StateHasChanged();
        await ScrollTilBunn();
    }

    private async Task ScrollTilBunn()
    {
        try
        {
            await JS.InvokeVoidAsync("aiassistent.scrollTilBunn", "ai-meldinger");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
