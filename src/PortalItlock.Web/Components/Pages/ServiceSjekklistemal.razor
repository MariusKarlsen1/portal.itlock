@page "/service-sjekklistemal"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Sjekkliste for servicerunder</PageTitle>

<h1>Sjekkliste for servicerunder</h1>
<p>Denne sjekklisten legges automatisk til hver gang en ny servicerunde registreres i Serviceavtaler-modulen, slik at punktene kan hukes av på stedet eller årlig.</p>

@if (_punkter.Count == 0)
{
    <p class="list-empty">Ingen punkter lagt til ennå.</p>
}
else
{
    <ol class="punkt-list">
        @foreach (var punkt in _punkter.OrderBy(p => p.Rekkefolge))
        {
            <li @key="punkt.Id">
                <input @bind="punkt.Tekst" @bind:event="oninput" />
                <button type="button" class="remove-button" @onclick="@(() => SlettPunkt(punkt))">Fjern</button>
            </li>
        }
    </ol>
    <button type="button" class="save-button" @onclick="LagreAlle">Lagre</button>
}

<div class="ny-mal">
    <h2>Nytt punkt</h2>
    <div class="ny-mal-form">
        <input @bind="_nyttPunktTekst" @bind:event="oninput"
               @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilPunkt(); } })"
               placeholder="Nytt sjekkpunkt" />
        <button type="button" class="add-button" @onclick="LeggTilPunkt">Legg til punkt</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="save-success">@_melding</p>
}

@code {
    private List<ServicerundeSjekklistepunkt> _punkter = [];
    private string _nyttPunktTekst = "";
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _punkter = await Db.ServicerundeSjekklistepunkter.OrderBy(p => p.Rekkefolge).ToListAsync();
    }

    private async Task LeggTilPunkt()
    {
        var tekst = _nyttPunktTekst.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        var nesteRekkefolge = _punkter.Count == 0 ? 1 : _punkter.Max(p => p.Rekkefolge) + 1;
        Db.ServicerundeSjekklistepunkter.Add(new ServicerundeSjekklistepunkt { Tekst = tekst, Rekkefolge = nesteRekkefolge });
        await Db.SaveChangesAsync();

        _nyttPunktTekst = "";
        _melding = "Punkt lagt til.";
        await LoadAsync();
    }

    private async Task SlettPunkt(ServicerundeSjekklistepunkt punkt)
    {
        var entitet = await Db.ServicerundeSjekklistepunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
        if (entitet is null)
        {
            return;
        }

        Db.ServicerundeSjekklistepunkter.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = "Punkt fjernet.";
        await LoadAsync();
    }

    private async Task LagreAlle()
    {
        foreach (var punkt in _punkter)
        {
            var entitet = await Db.ServicerundeSjekklistepunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
            if (entitet is not null)
            {
                entitet.Tekst = punkt.Tekst;
            }
        }

        await Db.SaveChangesAsync();
        _melding = "Sjekklisten er lagret.";
    }
}
