@page "/service-sjekklistemal"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Sjekklister for servicerunder</PageTitle>

@* S1 (Prototype sjekklistemaler.html): ett kort som kundekortet med grå
   infolinje og sjekklistene i grå meny til venstre med søk og blå strek. Til høyre
   står navnet, punktene i en tabell man skriver rett i (▲▼ eller dra),
   og slett i egen boks. Endringer lagres fra lagre-linjen nederst.
   Serviceavtalen velger liste (ServiceavtaleDetalj.razor); uten valg brukes standardlisten. *@
<div class="sm @(_full ? "sm-full" : "")">
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="sm-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="sm-kort">
        <div class="sm-topp">
            <span class="sm-ikon"><Icon Name="check-circle" /></span>
            <div class="sm-tittel">
                <div class="sm-smule"><NavLink href="/oppsettmodul">Oppsett</NavLink> / Service</div>
                <h1>Sjekklister for servicerunder</h1>
            </div>
            <div class="sm-knapper">
                @if (_valgt is { } aktiv)
                {
                    @if (!aktiv.ErStandard)
                    {
                        <button type="button" class="sm-knapp" @onclick="@(() => GjorTilStandard(aktiv))"><Icon Name="star" />Gjør til standard</button>
                    }
                    <button type="button" class="sm-knapp" @onclick="@(() => DupliserListe(aktiv))"><Icon Name="clipboard" />Dupliser</button>
                }
                <button type="button" class="sm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>
        </div>

        <div class="sm-info">
            <span><b>@_lister.Count</b> @(_lister.Count == 1 ? "sjekkliste" : "sjekklister")</span>
            <span><b>@_lister.Sum(m => m.Punkter.Count(p => !p.Slettet))</b> punkter</span>
            <span>Serviceavtalen velger liste – uten valg brukes standardlisten. Punktene legges på hver ny servicerunde</span>
        </div>

        <div class="sm-kropp">
            <nav class="sm-meny">
                <label class="sm-sok">
                    <Icon Name="search" />
                    <input type="search" @bind="_search" @bind:event="oninput" placeholder="Finn liste eller punkt" />
                </label>
                <div class="sm-liste">
                    @foreach (var element in _filtrert)
                    {
                        var id = element.Id;
                        <button type="button" @key="element.Id" class="sm-fane @(element.Id == _valgtId ? "pa" : "")" @onclick="@(() => Velg(id))">
                            <Icon Name="check-circle" />
                            <span>@(string.IsNullOrWhiteSpace(element.Navn) ? "(Uten navn)" : element.Navn)@(element.Endret ? " •" : "")@if (element.ErStandard)
                                {
                                    <small class="sm-std-tekst">Standard</small>
                                }</span>
                            <em>@element.Punkter.Count(p => !p.Slettet)</em>
                        </button>
                    }
                    @if (_filtrert.Count == 0)
                    {
                        <p class="sm-dempet">@(_lister.Count == 0 ? "Ingen sjekklister ennå." : "Ingen treff.")</p>
                    }
                </div>
                <div class="sm-ny">
                    <input @bind="_nyNavn" @bind:event="oninput" placeholder="＋ Ny sjekkliste"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettListe(); } })" />
                    @if (!string.IsNullOrWhiteSpace(_nyNavn))
                    {
                        <button type="button" class="sm-knapp primaer" @onclick="OpprettListe">Opprett</button>
                    }
                </div>
            </nav>

            <div class="sm-innhold">
                @if (_valgt is { } valgt)
                {
                    var punkter = valgt.Punkter.Where(p => !p.Slettet).ToList();

                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>Sjekkliste</h3>@if (valgt.ErStandard)
                            {
                                <span class="sm-std">Standard</span>
                                <small>brukes på avtaler som ikke har valgt en annen liste</small>
                            }</div>
                        <div class="sm-skjema">
                            <label class="sm-felt s2">
                                <span>Navn på sjekklisten</span>
                                <input @bind="valgt.Navn" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" placeholder="F.eks. Automatikkdører" />
                            </label>
                        </div>
                    </section>

                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>Punkter</h3><small>@punkter.Count</small></div>
                        <div class="sm-tabell">
                            <table>
                                <thead>
                                    <tr>
                                        <th class="sm-smal"></th>
                                        <th class="sm-smal">Nr.</th>
                                        <th>Punkt</th>
                                        <th class="sm-smal"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < punkter.Count; i++)
                                    {
                                        var punkt = punkter[i];
                                        var indeks = i;
                                        <tr @key="punkt" class="@(_dragPunkt == punkt ? "drar" : "")"
                                            draggable="true"
                                            @ondragstart="@(() => _dragPunkt = punkt)"
                                            @ondragover="@(() => { })" @ondragover:preventDefault
                                            @ondrop="@(() => Slipp(valgt, punkt))"
                                            @ondragend="@(() => _dragPunkt = null)">
                                            <td class="sm-smal">
                                                <span class="sm-pil" title="Flytt, eller dra raden">
                                                    <button type="button" title="Flytt opp" disabled="@(indeks == 0)" @onclick="@(() => Flytt(valgt, punkt, -1))">▲</button>
                                                    <button type="button" title="Flytt ned" disabled="@(indeks == punkter.Count - 1)" @onclick="@(() => Flytt(valgt, punkt, 1))">▼</button>
                                                </span>
                                            </td>
                                            <td class="sm-smal"><span class="sm-nr">@(indeks + 1)</span></td>
                                            <td><input class="sm-verdi" @bind="punkt.Tekst" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" /></td>
                                            <td class="sm-smal">
                                                <button type="button" class="sm-fjern" title="Fjern punkt" @onclick="@(() => FjernPunkt(valgt, punkt))"><Icon Name="x" /></button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="sm-nyrad">
                                        <td class="sm-smal"></td>
                                        <td class="sm-smal"><span class="sm-nr ny">+</span></td>
                                        <td><input class="sm-verdi" @bind="valgt.NyttPunkt" @bind:event="oninput" placeholder="Nytt punkt – trykk Enter"
                                                   @onkeydown="@(e => { if (e.Key == "Enter") { LeggTilPunkt(valgt); } })" /></td>
                                        <td class="sm-smal">
                                            @if (!string.IsNullOrWhiteSpace(valgt.NyttPunkt))
                                            {
                                                <button type="button" class="sm-knapp" @onclick="@(() => LeggTilPunkt(valgt))">Legg til</button>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <div class="sm-fare">
                        <div>
                            <b>Slett sjekkliste</b>
                            <span>@(valgt.ErStandard ? "Standardlisten kan ikke slettes – gjør en annen liste til standard først." : "Avtaler som bruker den, får standardlisten i stedet.")</span>
                        </div>
                        @if (valgt.ErStandard)
                        {
                            <button type="button" class="sm-knapp fare" disabled><Icon Name="trash" />Slett</button>
                        }
                        else if (_bekreftSlett)
                        {
                            <span class="sm-knapperad">
                                <button type="button" class="sm-knapp fare" @onclick="@(() => SlettListe(valgt))">Ja, slett</button>
                                <button type="button" class="sm-knapp" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="sm-knapp fare" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett</button>
                        }
                    </div>
                }
                else
                {
                    <p class="sm-dempet">Velg en sjekkliste i menyen, eller lag en ny nederst i menyen.</p>
                }
            </div>
        </div>
    </div>

    @if (_lister.Any(m => m.Endret))
    {
        var antall = _lister.Count(m => m.Endret);
        <div class="sm-lagrebar">
            <span><Icon Name="edit" /><b>Endringer i @antall @(antall == 1 ? "sjekkliste" : "sjekklister")</b> er ikke lagret</span>
            <span class="sm-knapperad">
                <button type="button" class="sm-knapp" @onclick="Forkast">Forkast</button>
                <button type="button" class="sm-knapp primaer" @onclick="LagreAlle"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class PunktDraft
    {
        public int Id { get; set; }
        public string Tekst { get; set; } = "";
        public bool Slettet { get; set; }
    }

    private sealed class ListeDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public bool ErStandard { get; set; }
        public List<PunktDraft> Punkter { get; set; } = [];
        public string NyttPunkt { get; set; } = "";
        public bool Endret { get; set; }
    }

    private List<ListeDraft> _lister = [];
    private string _search = "";
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;
    private int? _valgtId;
    private bool _bekreftSlett;
    private bool _full;
    private PunktDraft? _dragPunkt;

    private ListeDraft? _valgt => _lister.FirstOrDefault(l => l.Id == _valgtId);

    private List<ListeDraft> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _lister
        : _lister.Where(l => l.Navn.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || l.Punkter.Any(p => !p.Slettet && p.Tekst.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("service-sjekkliste-bredde", "normal") == "full";
        await LoadAsync();
        _valgtId = _lister.FirstOrDefault()?.Id;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("service-sjekkliste-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        var lister = await Db.ServiceSjekklister
            .Include(l => l.Punkter)
            .ToListAsync();

        _lister = lister
            .OrderByDescending(l => l.ErStandard).ThenBy(l => l.Navn)
            .Select(l => new ListeDraft
            {
                Id = l.Id,
                Navn = l.Navn,
                ErStandard = l.ErStandard,
                Punkter = l.Punkter.OrderBy(p => p.Rekkefolge).Select(p => new PunktDraft { Id = p.Id, Tekst = p.Tekst }).ToList()
            }).ToList();

        if (_valgtId is not null && _lister.All(l => l.Id != _valgtId))
        {
            _valgtId = _lister.FirstOrDefault()?.Id;
        }
    }

    private void Velg(int id)
    {
        _valgtId = id;
        _bekreftSlett = false;
        _feil = null;
    }

    private void LeggTilPunkt(ListeDraft liste)
    {
        var tekst = liste.NyttPunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        liste.Punkter.Add(new PunktDraft { Tekst = tekst });
        liste.NyttPunkt = "";
        liste.Endret = true;
    }

    private void FjernPunkt(ListeDraft liste, PunktDraft punkt)
    {
        if (punkt.Id == 0)
        {
            liste.Punkter.Remove(punkt);
        }
        else
        {
            punkt.Slettet = true;
        }

        liste.Endret = true;
    }

    private void Flytt(ListeDraft liste, PunktDraft punkt, int retning)
    {
        var synlige = liste.Punkter.Where(p => !p.Slettet).ToList();
        var i = synlige.IndexOf(punkt);
        var j = i + retning;
        if (i < 0 || j < 0 || j >= synlige.Count)
        {
            return;
        }

        var a = liste.Punkter.IndexOf(synlige[i]);
        var b = liste.Punkter.IndexOf(synlige[j]);
        (liste.Punkter[a], liste.Punkter[b]) = (liste.Punkter[b], liste.Punkter[a]);
        liste.Endret = true;
    }

    private void Slipp(ListeDraft liste, PunktDraft mal)
    {
        if (_dragPunkt is null || _dragPunkt == mal || !liste.Punkter.Contains(_dragPunkt))
        {
            _dragPunkt = null;
            return;
        }

        liste.Punkter.Remove(_dragPunkt);
        liste.Punkter.Insert(liste.Punkter.IndexOf(mal), _dragPunkt);
        _dragPunkt = null;
        liste.Endret = true;
    }

    private async Task Forkast()
    {
        _feil = null;
        _melding = null;
        await LoadAsync();
    }

    private async Task LagreAlle()
    {
        _feil = null;
        var endrede = _lister.Where(l => l.Endret).ToList();
        if (endrede.Any(l => string.IsNullOrWhiteSpace(l.Navn)))
        {
            _feil = "Alle sjekklister må ha et navn.";
            return;
        }

        if (endrede.Any(l => l.Punkter.Any(p => !p.Slettet && string.IsNullOrWhiteSpace(p.Tekst))))
        {
            _feil = "Punkter kan ikke stå tomme – skriv inn tekst eller fjern punktet.";
            return;
        }

        foreach (var draft in endrede)
        {
            var liste = await Db.ServiceSjekklister.Include(l => l.Punkter).FirstOrDefaultAsync(l => l.Id == draft.Id);
            if (liste is null)
            {
                continue;
            }

            liste.Navn = draft.Navn.Trim();
            var rekkefolge = 1;
            foreach (var p in draft.Punkter)
            {
                var entitet = p.Id == 0 ? null : liste.Punkter.FirstOrDefault(x => x.Id == p.Id);
                if (p.Slettet)
                {
                    if (entitet is not null)
                    {
                        Db.ServicerundeSjekklistepunkter.Remove(entitet);
                    }

                    continue;
                }

                if (entitet is null)
                {
                    liste.Punkter.Add(new ServicerundeSjekklistepunkt { Tekst = p.Tekst.Trim(), Rekkefolge = rekkefolge++ });
                }
                else
                {
                    entitet.Tekst = p.Tekst.Trim();
                    entitet.Rekkefolge = rekkefolge++;
                }
            }
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
        _melding = endrede.Count == 1 ? $"«{endrede[0].Navn.Trim()}» er lagret." : $"{endrede.Count} sjekklister er lagret.";
    }

    // Lagres med en gang - uavhengig av lagre-linjen.
    private async Task GjorTilStandard(ListeDraft liste)
    {
        var alle = await Db.ServiceSjekklister.ToListAsync();
        foreach (var l in alle)
        {
            l.ErStandard = l.Id == liste.Id;
        }

        await Db.SaveChangesAsync();
        foreach (var l in _lister)
        {
            l.ErStandard = l.Id == liste.Id;
        }

        _melding = $"«{liste.Navn.Trim()}» er nå standardlisten.";
    }

    private async Task OpprettListe()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        // Den første listen blir automatisk standard.
        var ny = new ServiceSjekkliste { Navn = navn, ErStandard = !await Db.ServiceSjekklister.AnyAsync() };
        Db.ServiceSjekklister.Add(ny);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _search = "";
        _feil = null;
        _melding = $"«{navn}» er opprettet. Legg til punktene under.";
        await LastPaNyttBeholdEndringer();
        Velg(ny.Id);
    }

    private async Task DupliserListe(ListeDraft liste)
    {
        var kopi = new ServiceSjekkliste { Navn = $"{liste.Navn.Trim()} (kopi)" };
        var rekkefolge = 1;
        foreach (var punkt in liste.Punkter.Where(p => !p.Slettet && !string.IsNullOrWhiteSpace(p.Tekst)))
        {
            kopi.Punkter.Add(new ServicerundeSjekklistepunkt { Tekst = punkt.Tekst.Trim(), Rekkefolge = rekkefolge++ });
        }

        Db.ServiceSjekklister.Add(kopi);
        await Db.SaveChangesAsync();

        _melding = $"«{kopi.Navn}» er laget.";
        _feil = null;
        await LastPaNyttBeholdEndringer();
        Velg(kopi.Id);
    }

    private async Task SlettListe(ListeDraft liste)
    {
        _bekreftSlett = false;
        var entitet = await Db.ServiceSjekklister.FirstOrDefaultAsync(l => l.Id == liste.Id);
        if (entitet is null || entitet.ErStandard)
        {
            return;
        }

        // Avtaler som brukte listen, går tilbake til standardlisten.
        await Db.Prosjekter.Where(p => p.ServiceSjekklisteId == liste.Id)
            .ExecuteUpdateAsync(x => x.SetProperty(p => p.ServiceSjekklisteId, (int?)null));
        Db.ServiceSjekklister.Remove(entitet);
        await Db.SaveChangesAsync();

        _melding = $"«{liste.Navn}» er slettet.";
        _feil = null;
        _valgtId = null;
        await LastPaNyttBeholdEndringer();
        _valgtId = _lister.FirstOrDefault()?.Id;
    }

    // Laster listen på nytt uten å miste ulagrede endringer i andre lister.
    private async Task LastPaNyttBeholdEndringer()
    {
        var ulagret = _lister.Where(l => l.Endret).ToList();
        await LoadAsync();
        foreach (var l in ulagret)
        {
            var i = _lister.FindIndex(x => x.Id == l.Id);
            if (i >= 0)
            {
                _lister[i] = l;
            }
        }
    }
}
