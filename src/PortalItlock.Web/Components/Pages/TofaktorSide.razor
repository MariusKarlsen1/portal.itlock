@page "/tofaktor"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Tofaktor-innlogging</PageTitle>

@* Tofaktor med autentiseringsapp (forslag tofaktor-2fa.html). Hemmeligheten lages
   her, men lagres først når brukeren har skrevet en riktig kode fra appen, så
   ingen låser seg ute ved å skanne feil. Reservekodene vises bare én gang. *@
<div class="tf">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="shield" /></span>
            <div>
                <h1>Tofaktor-innlogging</h1>
                <p class="section-hint">En kode fra appen på telefonen i tillegg til passordet. Gratis, og koden virker også uten nett.</p>
            </div>
        </div>
    </div>

    <TofaktorOppsett Krav="Krav" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "krav")] public int? Krav { get; set; }
}
