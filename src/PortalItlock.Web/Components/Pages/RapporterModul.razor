@page "/rapportermodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject TripletexService Tripletex

<PageTitle>Rapporter - Full Kontroll</PageTitle>

<RapportRamme Tittel="Rapporter" Undertittel="Nøkkeltall for perioden. Klikk på en rapport for å se detaljer." Ikon="bar-chart"
              Tilbake="" UtenKort="true" VisSkrivUt="false">
    <Handlinger>
        <div class="rm-seg">
            <button type="button" class="@(!_iFjor ? "pa" : "")" @onclick="@(() => VelgAr(false))">Hittil i år</button>
            <button type="button" class="@(_iFjor ? "pa" : "")" @onclick="@(() => VelgAr(true))">@(DateTime.Today.Year - 1)</button>
        </div>
    </Handlinger>
    <ChildContent>
        <div class="rm-gruppe">Salg og kunder</div>
        <div class="rm-grid">
            <a href="/rapporter/kunde" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="users" /></span><b>Kunde</b></span>
                <p>Topp 20 kunder etter omsetning, fordelt på kundetype.</p>
                <span class="rm-kilde portal">Fra portalen</span>
                <span class="rm-tall">
                    <span><small>Største kunde</small><b>@(_toppKunde is null ? "–" : RapportPeriode.Kr(_toppKunde.Value.Sum))</b></span>
                    <small class="rm-hoyre">@(_toppKunde?.Navn ?? "")</small>
                </span>
            </a>
            <a href="/rapporter/produkt" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="box" /></span><b>Produkt</b></span>
                <p>Hvilke varer som selger mest, og hvor mye som er arbeid.</p>
                <span class="rm-kilde portal">Fra portalen</span>
                <span class="rm-tall">
                    <span><small>Mest solgte vare</small><b class="rm-tekst">@(_toppVare?.Navn ?? "–")</b></span>
                    <small class="rm-hoyre">@(_toppVare is null ? "" : $"{RapportPeriode.Tall(_toppVare.Value.Antall)} stk")</small>
                </span>
            </a>
            <a href="/rapporter/salg-per-kunde" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="users" /></span><b>Salg per kunde</b></span>
                <p>Det som faktisk er fakturert per kunde.</p>
                <span class="rm-kilde tt">Fra Tripletex</span>
                <span class="rm-tall">
                    <span><small>Fakturert</small><b>@(_fakturert is null ? (_ttFeil ? "–" : "…") : RapportPeriode.Kr(_fakturert.Value))</b></span>
                </span>
            </a>
        </div>

        <div class="rm-gruppe">Økonomi</div>
        <div class="rm-grid">
            <a href="/rapporter/resultat" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="file-text" /></span><b>Resultatrapport</b></span>
                <p>Omsetning per inntektskonto, med utvikling per måned.</p>
                <span class="rm-kilde portal">Fra portalen</span>
                <span class="rm-tall">
                    <span><small>Omsetning</small><b>@RapportPeriode.Kr(_omsetning)</b></span>
                    <RapportDelta Naa="_omsetning" For="_omsetningFor" />
                </span>
            </a>
            <a href="/rapporter/fakturaer" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="receipt" /></span><b>Fakturaoversikt</b></span>
                <p>Fakturaer, hva som er betalt og hva som er forfalt.</p>
                <span class="rm-kilde tt">Fra Tripletex</span>
                <span class="rm-tall">
                    <span><small>Forfalt</small><b class="@(_forfalt > 0 ? "rm-rod" : "")">@(_fakturert is null ? (_ttFeil ? "–" : "…") : RapportPeriode.Kr(_forfalt))</b></span>
                    <small class="rm-hoyre">@(_fakturert is null ? "" : $"{_antallForfalt} {(_antallForfalt == 1 ? "faktura" : "fakturaer")}")</small>
                </span>
            </a>
        </div>

        <div class="rm-gruppe">Oppfølging</div>
        <div class="rm-grid">
            <a href="/rapporter/tilbudsreserve" class="rm-kort">
                <span class="rm-t"><span class="rm-ik"><Icon Name="send" /></span><b>Tilbudsreserve</b></span>
                <p>Sendte tilbud som venter på svar fra kunden.</p>
                <span class="rm-kilde portal">Fra portalen</span>
                <span class="rm-tall">
                    <span><small>Venter på svar</small><b>@RapportPeriode.Kr(_reserve)</b></span>
                    <small class="rm-hoyre">@_antallReserve tilbud</small>
                </span>
            </a>
        </div>

        <div class="rm-gruppe">Oppsett</div>
        <div class="rm-grid">
            <a href="/rapporter/kontoplan" class="rm-kort rm-lav">
                <span class="rm-t"><span class="rm-ik"><Icon Name="settings" /></span><b>Kontoplan</b></span>
                <p>Inntektskontoene som settes på varer og brukes i resultatrapporten.</p>
                <span class="rm-tall">
                    <span><small>Kontoer</small><b>@_antallKontoer</b></span>
                    <small class="rm-hoyre @(_utenKonto > 0 ? "rm-gul" : "")">@(_utenKonto > 0 ? $"{_utenKonto} solgte varer uten konto" : "alle solgte varer har konto")</small>
                </span>
            </a>
        </div>
    </ChildContent>
</RapportRamme>

@code {
    private bool _iFjor;
    private (string Navn, decimal Sum)? _toppKunde;
    private (string Navn, decimal Antall)? _toppVare;
    private decimal _omsetning;
    private decimal? _omsetningFor;
    private decimal _reserve;
    private int _antallReserve;
    private int _antallKontoer;
    private int _utenKonto;
    private decimal? _fakturert;
    private decimal _forfalt;
    private int _antallForfalt;
    private bool _ttFeil;

    private (DateTime Fra, DateTime Til) Periode => _iFjor
        ? (new DateTime(DateTime.Today.Year - 1, 1, 1), new DateTime(DateTime.Today.Year - 1, 12, 31))
        : (new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        _antallKontoer = await Db.Inntektskontoer.CountAsync();
        var reserve = await Db.Tilbud
            .Where(t => t.SendtDato != null && t.Status == EndringsmeldingStatus.SendtTilKunde)
            .Select(t => t.SendtSum ?? 0)
            .ToListAsync();
        _reserve = reserve.Sum();
        _antallReserve = reserve.Count;
        await LastPortalAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Tripletex hentes etter at siden er vist, så den ikke venter på API-et.
        if (firstRender)
        {
            await LastTripletexAsync();
            StateHasChanged();
        }
    }

    private async Task VelgAr(bool iFjor)
    {
        _iFjor = iFjor;
        _fakturert = null;
        await LastPortalAsync();
        await LastTripletexAsync();
    }

    private async Task LastPortalAsync()
    {
        var (fra, til) = Periode;
        var ordrer = await RapportData.HentAsync(Db, fra, til);
        var linjer = ordrer.SelectMany(o => o.Linjer).ToList();

        _omsetning = ordrer.Sum(o => o.Sum);
        _omsetningFor = (await RapportData.HentAsync(Db, fra.AddYears(-1), til.AddYears(-1))).Sum(o => o.Sum);

        var kunde = ordrer.Where(o => o.Kunde is not null)
            .GroupBy(o => o.Kunde!.Id)
            .Select(g => (Navn: g.First().Kunde!.Navn, Sum: g.Sum(o => o.Sum)))
            .OrderByDescending(x => x.Sum)
            .FirstOrDefault();
        _toppKunde = kunde.Navn is null ? null : kunde;

        var vare = linjer.Where(l => l.ComponentId is not null)
            .GroupBy(l => l.Navn)
            .Select(g => (Navn: g.Key, Antall: g.Sum(l => l.Antall)))
            .OrderByDescending(x => x.Antall)
            .FirstOrDefault();
        _toppVare = vare.Navn is null ? null : vare;

        _utenKonto = linjer.Where(l => l.KontoNummer is null && l.ComponentId is not null)
            .Select(l => l.ComponentId).Distinct().Count();
    }

    private async Task LastTripletexAsync()
    {
        var (fra, til) = Periode;
        try
        {
            var (fakturaer, feil) = await Tripletex.HentFakturaerAsync(fra, til);
            if (feil is not null)
            {
                _ttFeil = true;
                return;
            }

            _ttFeil = false;
            _fakturert = fakturaer.Sum(f => f.ErKreditnota ? -Math.Abs(f.Belop) : f.Belop);
            var forfalte = fakturaer
                .Where(f => !f.ErKreditnota && f.Utestaende > 0 && f.Forfallsdato is DateTime d && d.Date < DateTime.Today)
                .ToList();
            _forfalt = forfalte.Sum(f => f.Utestaende);
            _antallForfalt = forfalte.Count;
        }
        catch (Exception)
        {
            _ttFeil = true;
        }
    }
}
