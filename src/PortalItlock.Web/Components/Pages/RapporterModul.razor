@page "/rapportermodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Rapporter - itlock</PageTitle>

<h1>Rapporter</h1>
<p class="section-hint">
    Salgsrapporter hentet direkte fra Tripletex - viser det som faktisk er
    fakturert der, gruppert på kunde, vare eller inntektskonto.
</p>

<div class="modul-grid">
    <a href="/rapporter/kunde" class="modul-card">
        <Icon Name="users" />
        <span class="modul-card-title">Kunde</span>
        <span class="modul-card-desc">Topp 20 kunder etter omsetning, for valgt periode.</span>
    </a>
    <a href="/rapporter/produkt" class="modul-card">
        <Icon Name="box" />
        <span class="modul-card-title">Produkt</span>
        <span class="modul-card-desc">Salg pr. vare, med mulighet for å filtrere på periode og kunde.</span>
    </a>
    <a href="/rapporter/resultat" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Resultatrapport</span>
        <span class="modul-card-desc">Omsetning pr. inntektskonto for valgt periode.</span>
    </a>
</div>
