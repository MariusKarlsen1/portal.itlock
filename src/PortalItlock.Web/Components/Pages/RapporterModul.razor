@page "/rapportermodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Rapporter - itlock</PageTitle>

<h1>Rapporter</h1>
<p class="section-hint">
    Kunde, Produkt og Resultatrapport beregnes fra portalens egne data -
    ferdigmeldte arbeidsordre - uavhengig av om ordren i tillegg er
    fakturert i Tripletex. Fakturaoversikt og Salg per kunde viser derimot
    det som faktisk ER fakturert, og hentes direkte fra Tripletex, siden det
    kun finnes der.
</p>

<div class="modul-grid">
    <a href="/rapporter/kunde" class="modul-card">
        <Icon Name="users" />
        <span class="modul-card-title">Kunde</span>
        <span class="modul-card-desc">Topp 20 kunder etter omsetning, for valgt periode (portalens egne data).</span>
    </a>
    <a href="/rapporter/produkt" class="modul-card">
        <Icon Name="box" />
        <span class="modul-card-title">Produkt</span>
        <span class="modul-card-desc">Salg pr. vare, med mulighet for å filtrere på periode og kunde.</span>
    </a>
    <a href="/rapporter/resultat" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Resultatrapport</span>
        <span class="modul-card-desc">Omsetning pr. inntektskonto for valgt periode.</span>
    </a>
    <a href="/rapporter/kontoplan" class="modul-card">
        <Icon Name="settings" />
        <span class="modul-card-title">Kontoplan</span>
        <span class="modul-card-desc">Opprett og vedlikehold inntektskontoene som kan settes på varer.</span>
    </a>
    <a href="/rapporter/fakturaer" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Fakturaoversikt</span>
        <span class="modul-card-desc">Fakturaer sendt fra Tripletex, hentet direkte derfra.</span>
    </a>
    <a href="/rapporter/salg-per-kunde" class="modul-card">
        <Icon Name="users" />
        <span class="modul-card-title">Salg per kunde</span>
        <span class="modul-card-desc">Faktisk fakturert salg pr. kunde, hentet direkte fra Tripletex.</span>
    </a>
    <a href="/rapporter/tilbudsreserve" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Tilbudsreserve</span>
        <span class="modul-card-desc">Alle tilbud sendt til kunde, med dato og sum, og total tilbudsreserve som fortsatt venter på svar.</span>
    </a>
</div>
