@page "/prosjekter/avslatte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Avslåtte prosjekter</PageTitle>

<a class="tilbake-link" href="/prosjekter"><Icon Name="arrow-left" />Tilbake til prosjekter</a>

<div class="avslatt-header">
    <div class="avslatt-header-tittel">
        <span class="avslatt-header-ikon"><Icon Name="x" /></span>
        <h1>Avslåtte prosjekter</h1>
    </div>
    <p>Arkiv over prosjekter der tilbudet ble avslått &ndash; søkbart og sorterbart.</p>
</div>

@if (_rader.Count > 0)
{
    <div class="nokkeltall">
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Totalt avslått</span>
            <span class="nokkel-verdi stor">@_rader.Count</span>
            <span class="nokkel-under">prosjekter</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Opprettet i år</span>
            <span class="nokkel-verdi">@AntallIAr</span>
            <span class="nokkel-under">av @_rader.Count totalt</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Snitt dører pr. prosjekt</span>
            <span class="nokkel-verdi">@SnittDorer.ToString("N1", Kultur)</span>
            <span class="nokkel-under">@_rader.Sum(r => r.AntallDorer) dører totalt</span>
        </div>
    </div>
}

<label class="sok-felt">
    <Icon Name="search" />
    <input @bind="_sok" @bind:event="oninput" placeholder="Søk på navn, kunde eller adresse..." />
</label>

@if (_rader.Count > 0)
{
    <p class="result-count">@_filtrerte.Count av @_rader.Count avslåtte prosjekter</p>
}

@if (_filtrerte.Count == 0)
{
    <p class="list-empty">Ingen avslåtte prosjekter funnet.</p>
}
else
{
    <div class="tabell-kort">
        <table class="avslatt-table">
            <thead>
                <tr>
                    <th @onclick='@(() => SorterPa("Navn"))'>Navn@(SortPil("Navn"))</th>
                    <th @onclick='@(() => SorterPa("Kunde"))'>Kunde / adresse@(SortPil("Kunde"))</th>
                    <th @onclick='@(() => SorterPa("Prosjektleder"))'>Prosjektleder@(SortPil("Prosjektleder"))</th>
                    <th @onclick='@(() => SorterPa("Dorer"))' class="tall-kolonne">Dører@(SortPil("Dorer"))</th>
                    <th @onclick='@(() => SorterPa("Dato"))'>Opprettet@(SortPil("Dato"))</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _filtrerte)
                {
                    <tr @key="r.Id">
                        <td>@r.Navn</td>
                        <td>
                            <span class="kunde-rad">
                                <span class="kunde-navn">@(r.KundeNavn ?? "-")</span>
                                @if (!string.IsNullOrWhiteSpace(r.Adresse))
                                {
                                    <span class="adresse-tekst">@r.Adresse</span>
                                }
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(r.ProsjektlederNavn))
                            {
                                <span class="pl-rad">
                                    <span class="avatar" style="background:@PersonFarge(r.ProsjektlederNavn)">@PersonInitialer(r.ProsjektlederNavn)</span>
                                    @r.ProsjektlederNavn
                                </span>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td class="tall-kolonne dorer-cell">@r.AntallDorer</td>
                        <td>@r.OpprettetDato.ToString("dd.MM.yyyy")</td>
                        <td><a class="edit-link" href="@($"/prosjekter/{r.Id}")">Åpne</a></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3">Sum &ndash; @_filtrerte.Count avslåtte prosjekter (filtrert)</td>
                    <td class="tall-kolonne">@_filtrerte.Sum(r => r.AntallDorer)</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public string? Adresse { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int AntallDorer { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<ProsjektRad> _rader = [];
    private string _sok = "";
    private string _sortFelt = "Dato";
    private bool _sortSynkende = true;

    private int AntallIAr { get; set; }
    private decimal SnittDorer { get; set; }

    private List<ProsjektRad> _filtrerte
    {
        get
        {
            var rader = string.IsNullOrWhiteSpace(_sok)
                ? _rader.AsEnumerable()
                : _rader.Where(r =>
                    r.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase) ||
                    (r.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Adresse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false));

            IEnumerable<ProsjektRad> sortert = _sortFelt switch
            {
                "Navn" => rader.OrderBy(r => r.Navn, StringComparer.OrdinalIgnoreCase),
                "Kunde" => rader.OrderBy(r => r.KundeNavn, StringComparer.OrdinalIgnoreCase),
                "Prosjektleder" => rader.OrderBy(r => r.ProsjektlederNavn, StringComparer.OrdinalIgnoreCase),
                "Dorer" => rader.OrderBy(r => r.AntallDorer),
                _ => rader.OrderBy(r => r.OpprettetDato)
            };

            return (_sortSynkende ? sortert.Reverse() : sortert).ToList();
        }
    }

    private void SorterPa(string felt)
    {
        if (_sortFelt == felt)
        {
            _sortSynkende = !_sortSynkende;
        }
        else
        {
            _sortFelt = felt;
            _sortSynkende = felt is "Dato" or "Dorer";
        }
    }

    private string SortPil(string felt) => _sortFelt != felt ? "" : (_sortSynkende ? " ↓" : " ↑");

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.TilbudAvslatt)
            .Include(p => p.Kunde)
            .Include(p => p.Prosjektleder)
            .Include(p => p.Dorer)
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _rader = prosjekter.Select(p => new ProsjektRad
        {
            Id = p.Id,
            Navn = p.Navn,
            KundeNavn = p.Kunde?.Navn,
            Adresse = p.Adresse,
            ProsjektlederNavn = p.Prosjektleder?.Navn,
            AntallDorer = p.Dorer.Count,
            OpprettetDato = p.OpprettetDato
        }).ToList();

        var inneverendeAr = DateTime.Today.Year;
        AntallIAr = _rader.Count(r => r.OpprettetDato.Year == inneverendeAr);
        SnittDorer = _rader.Count > 0 ? (decimal)_rader.Sum(r => r.AntallDorer) / _rader.Count : 0;
    }
}
