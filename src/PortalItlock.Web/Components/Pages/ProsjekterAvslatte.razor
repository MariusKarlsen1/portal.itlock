@page "/prosjekter/avslatte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Avslåtte prosjekter</PageTitle>

<a class="tilbake-link" href="/prosjekter"><Icon Name="arrow-left" />Tilbake til prosjekter</a>

<div class="avslatt-header">
    <div class="avslatt-header-tittel">
        <span class="avslatt-header-ikon"><Icon Name="x" /></span>
        <h1>Avslåtte prosjekter</h1>
    </div>
    <p>Arkiv over prosjekter der tilbudet ble avslått &ndash; søkbart, med oversikt over volum pr. år.</p>
</div>

@if (_rader.Count > 0)
{
    <div class="oversikt-boks">
        <svg viewBox="0 0 120 120" width="110" height="110" class="donut" style="transform:rotate(-90deg);">
            <circle cx="60" cy="60" r="45" fill="none" stroke="var(--itlock-border)" stroke-width="16" />
            @foreach (var g in ArGrupper)
            {
                <circle cx="60" cy="60" r="45" fill="none" stroke="@g.Farge" stroke-width="16"
                        stroke-dasharray="@(FormaterTall(g.Buelengde)) 282.6" stroke-dashoffset="@FormaterTall(-g.Offset)" />
            }
        </svg>
        <div class="donut-total">
            <div class="donut-tall">@_rader.Count</div>
            <div class="donut-etikett">Totalt avslått</div>
        </div>
        <div class="ar-legend">
            @foreach (var g in ArGrupper)
            {
                <button type="button" class="legend-rad @(_valgtAr == g.Ar ? "legend-valgt" : "")" @onclick="@(() => VelgAr(g.Ar))">
                    <span class="legend-dott" style="background:@g.Farge"></span>
                    @g.Ar <span class="legend-antall">&middot; @g.Antall</span>
                </button>
            }
            @if (_valgtAr.HasValue)
            {
                <button type="button" class="legend-rad legend-nullstill" @onclick="@(() => VelgAr(null))">Vis alle år</button>
            }
        </div>
    </div>
}

<label class="sok-felt">
    <Icon Name="search" />
    <input @bind="_sok" @bind:event="oninput" placeholder="Søk på navn, kunde eller adresse..." />
</label>

@if (_rader.Count > 0)
{
    <p class="result-count">@Synlige.Count av @_rader.Count avslåtte prosjekter</p>
}

@if (Synlige.Count == 0)
{
    <p class="list-empty">Ingen avslåtte prosjekter funnet.</p>
}
else
{
    <div class="arkiv-kort-grid">
        @foreach (var r in Synlige)
        {
            <a @key="r.Id" class="arkiv-kort" href="@($"/prosjekter/{r.Id}")">
                <span class="dato-badge">@r.OpprettetDato.ToString("dd.MM.yyyy")</span>
                <span class="arkiv-kort-navn">@r.Navn</span>
                <span class="arkiv-kort-meta">@(r.KundeNavn ?? "Ingen kunde satt")@(string.IsNullOrWhiteSpace(r.Adresse) ? "" : $" · {r.Adresse}")</span>
                @if (!string.IsNullOrWhiteSpace(r.ProsjektlederNavn))
                {
                    <span class="pl-rad">
                        <span class="avatar" style="background:@PersonFarge(r.ProsjektlederNavn)">@PersonInitialer(r.ProsjektlederNavn)</span>
                        @r.ProsjektlederNavn
                    </span>
                }
                else
                {
                    <span class="arkiv-kort-ingen-pl">Ingen prosjektleder satt</span>
                }
                <span class="arkiv-kort-dorer">@r.AntallDorer dør@(r.AntallDorer == 1 ? "" : "er")</span>
            </a>
        }
    </div>
}

@code {
    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public string? Adresse { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int AntallDorer { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record ArGruppe(int Ar, int Antall, double Buelengde, double Offset, string Farge);

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<ProsjektRad> _rader = [];
    private string _sok = "";
    private int? _valgtAr;

    private List<ProsjektRad> _sokTreff => string.IsNullOrWhiteSpace(_sok)
        ? _rader
        : _rader.Where(r =>
            r.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase) ||
            (r.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.Adresse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    private List<ProsjektRad> Synlige => (_valgtAr.HasValue
            ? _sokTreff.Where(r => r.OpprettetDato.Year == _valgtAr.Value)
            : _sokTreff)
        .OrderByDescending(r => r.OpprettetDato)
        .ToList();

    // Sekvensiell, ett-farget skala (lysest->mørkest = eldst->nyest) siden
    // året er en rangert størrelse, ikke separate kategorier.
    private List<ArGruppe> ArGrupper
    {
        get
        {
            var ar = _rader
                .GroupBy(r => r.OpprettetDato.Year)
                .OrderByDescending(g => g.Key)
                .ToList();

            var total = Math.Max(_rader.Count, 1);
            var antallAr = Math.Max(ar.Count, 1);
            double cum = 0;
            var resultat = new List<ArGruppe>();

            for (var i = 0; i < ar.Count; i++)
            {
                var antall = ar[i].Count();
                var buelengde = 282.6 * antall / total;
                var lysMix = antallAr <= 1 ? 1.0 : 1.0 - (i / (double)(antallAr - 1)) * 0.6;
                resultat.Add(new ArGruppe(ar[i].Key, antall, buelengde, cum, RodTone(lysMix)));
                cum += buelengde;
            }

            return resultat;
        }
    }

    private static string RodTone(double t)
    {
        var mix = 1 - t;
        var r = (int)Math.Round(163 + (255 - 163) * mix * 0.55);
        var g = (int)Math.Round(32 + (255 - 32) * mix * 0.55);
        var b = (int)Math.Round(32 + (255 - 32) * mix * 0.55);
        return $"rgb({r},{g},{b})";
    }

    private static string FormaterTall(double verdi) => verdi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void VelgAr(int? ar) => _valgtAr = _valgtAr == ar ? null : ar;

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.TilbudAvslatt)
            .Include(p => p.Kunde)
            .Include(p => p.Prosjektleder)
            .Include(p => p.Dorer)
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _rader = prosjekter.Select(p => new ProsjektRad
        {
            Id = p.Id,
            Navn = p.Navn,
            KundeNavn = p.Kunde?.Navn,
            Adresse = p.Adresse,
            ProsjektlederNavn = p.Prosjektleder?.Navn,
            AntallDorer = p.Dorer.Count,
            OpprettetDato = p.OpprettetDato
        }).ToList();
    }
}
