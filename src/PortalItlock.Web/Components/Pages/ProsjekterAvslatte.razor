@page "/prosjekter/avslatte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Avslåtte prosjekter</PageTitle>

@* O1 + T1 (ferdigstilte-v2-forslag.html), likt som ferdigstilte prosjekter: samme innhold som før, samlet i ett kort
   med utvid-knapp, faner som segmentknapp, tallene i én ramme og tidslinjen med
   antall og sum per måned, sortering og 10/15/20 per side. *@
<div class="avslatte-side fs-kort fs-avslatt @(_full ? "fs-full" : "")">
    <button type="button" class="fs-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>

    <div class="fs-topp">
        <div>
            <a class="fs-tilbake" href="/prosjekter">&larr; Tilbake til prosjekter</a>
            <h1>Avslåtte prosjekter</h1>
            <p>Arkiv over prosjekter der tilbudet ble avslått &ndash; søkbart, med oversikt over volum per år.</p>
        </div>
        @if (_rader.Count > 0)
        {
            <div class="fs-handl">
                <select class="fs-velg" title="Velg år" value="@(_valgtAr?.ToString() ?? "alle")" @onchange="@(e => { _valgtAr = (string)e.Value! == "alle" ? null : int.Parse((string)e.Value!); _side = 1; })">
                    <option value="alle">Alle år</option>
                    @foreach (var ar in AlleAr)
                    {
                        <option value="@ar">@ar</option>
                    }
                </select>
            </div>
        }
    </div>

    @if (_rader.Count > 0)
    {
        <div class="fs-faner">
            <button type="button" class="@(_fane == "oversikt" ? "aktiv" : "")" @onclick='@(() => _fane = "oversikt")'><Icon Name="trend-up" />Oversikt</button>
            <button type="button" class="@(_fane == "tidslinje" ? "aktiv" : "")" @onclick='@(() => _fane = "tidslinje")'><Icon Name="clock" />Tidslinje</button>
        </div>
    }

    @if (_rader.Count == 0)
    {
        <p class="list-empty">Ingen avslåtte prosjekter funnet.</p>
    }
    else if (_fane == "oversikt")
    {
        <div class="fs-kpi">
            <div class="fs-kpi-hoved">
                <span class="fs-lbl">Avslått@(_valgtAr.HasValue ? $" i {_valgtAr}" : "")</span>
                <b>@FiltrertAr.Count prosjekt@(FiltrertAr.Count == 1 ? "" : "er")</b>
                @if (_valgtAr.HasValue)
                {
                    <small class="@DeltaKlasse(FiltrertAr.Count, ForrigeArRader.Count)">@DeltaTekst(FiltrertAr.Count, ForrigeArRader.Count)</small>
                }
            </div>
            <div>
                <span class="fs-lbl">Dører</span>
                <b>@FiltrertAr.Sum(r => r.AntallDorer)</b>
                @if (_valgtAr.HasValue)
                {
                    <small class="@DeltaKlasse(FiltrertAr.Sum(r => r.AntallDorer), ForrigeArRader.Sum(r => r.AntallDorer))">@DeltaTekst(FiltrertAr.Sum(r => r.AntallDorer), ForrigeArRader.Sum(r => r.AntallDorer))</small>
                }
            </div>
            <div>
                <span class="fs-lbl">Kunder</span>
                <b>@AntallKunder(FiltrertAr)</b>
                @if (_valgtAr.HasValue)
                {
                    <small class="@DeltaKlasse(AntallKunder(FiltrertAr), AntallKunder(ForrigeArRader))">@DeltaTekst(AntallKunder(FiltrertAr), AntallKunder(ForrigeArRader))</small>
                }
            </div>
            <div>
                <span class="fs-lbl">Tapt verdi</span>
                <b>@FiltrertAr.Sum(r => r.Verdi).ToString("N0", Kultur) kr</b>
                @if (_valgtAr.HasValue)
                {
                    <small class="@DeltaKlasse(FiltrertAr.Sum(r => r.Verdi), ForrigeArRader.Sum(r => r.Verdi))">@ProsentDeltaTekst(FiltrertAr.Sum(r => r.Verdi), ForrigeArRader.Sum(r => r.Verdi))</small>
                }
            </div>
        </div>

        <div class="fs-g2">
            <div class="fs-panel">
                <h3>Avslått per @(_valgtAr.HasValue ? "måned" : "år")<small>@(_valgtAr?.ToString() ?? "alle år")</small></h3>
                <div class="fs-graf">
                    @foreach (var b in AntallBarer)
                    {
                        <div class="fs-graf-kol">
                            <div class="fs-graf-spor"><i class="@(b.Fremhevet ? "fremhevet" : "")" style="height:@FormaterTall(b.Prosent)%"></i></div>
                            <span>@b.Etikett</span>
                        </div>
                    }
                </div>
            </div>
            <div class="fs-panel">
                <h3>Prosjekttype</h3>
                @Smultring(TypeGrupper, 104)
            </div>
        </div>

        <div class="fs-g3">
            <div class="fs-panel">
                <h3>Topp kunder</h3>
                <ol class="fs-rang">
                    @foreach (var k in ToppKunder)
                    {
                        <li>
                            <span class="fs-rang-nr">@k.Rang</span>
                            <span class="fs-rang-navn">@k.Navn</span>
                            <span class="fs-rang-antall">@k.Antall prosjekt@(k.Antall == 1 ? "" : "er")</span>
                        </li>
                    }
                    @if (ToppKunder.Count == 0)
                    {
                        <li class="fs-tom">Ingen data</li>
                    }
                </ol>
            </div>
            <div class="fs-panel">
                <h3>Geografisk fordeling</h3>
                @Smultring(GeoGrupper, 88)
            </div>
            <div class="fs-panel">
                <h3>Snitt tapt verdi<small>tapt verdi per @(_valgtAr.HasValue ? "måned" : "år")</small></h3>
                <div class="fs-verdi">
                    <b>@GjennomsnittTapt.ToString("N0", Kultur) kr</b>
                    <span class="fs-merke fs-ned">per prosjekt</span>
                </div>
                <div class="fs-graf fs-graf-lite">
                    @foreach (var b in VerdiBarer)
                    {
                        <div class="fs-graf-kol">
                            <div class="fs-graf-spor"><i style="height:@FormaterTall(b.Prosent)%"></i></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (_fane == "tidslinje")
    {
        <div class="fs-verktoy">
            <span class="fs-antall">@TidslinjeSortert.Count prosjekt@(TidslinjeSortert.Count == 1 ? "" : "er")@(_valgtAr.HasValue ? $" i {_valgtAr}" : "")</span>
            <select class="fs-velg" title="Sortering" value="@_sortering" @onchange="@(e => { _sortering = (string)e.Value!; _side = 1; })">
                <option value="nyeste">Nyeste først</option>
                <option value="eldste">Eldste først</option>
            </select>
            <select class="fs-velg" title="Antall prosjekter per side" value="@_perSide" @onchange="@(e => { _perSide = int.Parse((string)e.Value!); _side = 1; })">
                <option value="10">10 per side</option>
                <option value="15">15 per side</option>
                <option value="20">20 per side</option>
            </select>
        </div>

        <div class="fs-tl">
            @foreach (var argruppe in TidslinjeSide)
            {
                <div class="fs-tl-ar">@argruppe.Ar</div>
                @foreach (var maned in argruppe.Maneder)
                {
                    var (antall, sum) = ManedSum(maned.Ar, maned.Mnd);
                    <div class="fs-tl-maned">
                        <div class="fs-tl-mnavn">
                            @maned.Navn
                            <small>@antall prosjekt@(antall == 1 ? "" : "er") · @sum.ToString("N0", Kultur) kr</small>
                        </div>
                        <div>
                            @foreach (var r in maned.Rader)
                            {
                                <div class="fs-tl-rad">
                                    <span class="fs-tl-prikk"><Icon Name="x" /></span>
                                    <div class="fs-tl-kort">
                                        <span class="fs-tl-dato">@(Dato(r)?.ToString("d. MMM yyyy", Kultur))</span>
                                        <a class="fs-tl-info" href="@($"/prosjekter/{r.Id}")">
                                            <span class="fs-tl-type" style="background:color-mix(in srgb, @r.Type.Farge() 14%, #fff);color:@r.Type.Farge()" title="@r.Type.Visningsnavn()"><Icon Name="building" /></span>
                                            <span class="fs-tl-tekst">
                                                <b>@r.Navn</b>
                                                <small>@(string.Join(" · ", new[] { r.Sted, r.KundeNavn }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } s ? s : "Ikke satt")</small>
                                            </span>
                                        </a>
                                        <span class="fs-tl-merke"><Icon Name="file-text" />@r.AntallDorer dør@(r.AntallDorer == 1 ? "" : "er")</span>
                                        <span class="fs-tl-merke"><Icon Name="users" />@r.AntallMontorer montør@(r.AntallMontorer == 1 ? "" : "er")</span>
                                        <span class="fs-tl-verdi">@r.Verdi.ToString("N0", Kultur) kr</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        @Sidevelger()
    }
</div>

@code {
    private const bool HoyereErBra = false;
    private const string BreddeNokkel = "avslatte-bredde";
    private static DateTime? Dato(ProsjektRad r) => r.OpprettetDato;

    // ---------- Kort (O1/T1): utvid-knapp, tidslinje med sortering og sider ----------
    private sealed record TlManed(int Ar, int Mnd, string Navn, List<ProsjektRad> Rader);
    private sealed record TlAr(int Ar, List<TlManed> Maneder);

    private bool _full;
    private string _sortering = "nyeste";
    private int _perSide = 10;
    private int _side = 1;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync(BreddeNokkel, _full ? "full" : "normal");
    }

    private static int AntallKunder(List<ProsjektRad> rader) => rader.Select(r => r.KundeId).Where(k => k.HasValue).Distinct().Count();

    // Grønn når utviklingen er bra, rød når den ikke er det (HoyereErBra settes per side).
    private static string DeltaKlasse(decimal na, decimal forrige) =>
        na == forrige ? "fs-noytral" : (na > forrige) == HoyereErBra ? "fs-opp" : "fs-ned";

    private List<ProsjektRad> TidslinjeSortert
    {
        get
        {
            var medDato = FiltrertAr.Where(r => Dato(r).HasValue);
            return (_sortering == "eldste" ? medDato.OrderBy(r => Dato(r)) : medDato.OrderByDescending(r => Dato(r))).ToList();
        }
    }

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(TidslinjeSortert.Count / (double)_perSide));
    private int GjeldendeSide => Math.Clamp(_side, 1, AntallSider);

    // Prosjektene på valgt side, gruppert på år og måned i samme rekkefølge som sorteringen.
    private List<TlAr> TidslinjeSide
    {
        get
        {
            var side = TidslinjeSortert.Skip((GjeldendeSide - 1) * _perSide).Take(_perSide).ToList();
            var resultat = new List<TlAr>();
            foreach (var r in side)
            {
                var d = Dato(r)!.Value;
                var ar = resultat.LastOrDefault();
                if (ar is null || ar.Ar != d.Year)
                {
                    ar = new TlAr(d.Year, []);
                    resultat.Add(ar);
                }
                var maned = ar.Maneder.LastOrDefault();
                if (maned is null || maned.Mnd != d.Month)
                {
                    maned = new TlManed(d.Year, d.Month, ManedNavnFull[d.Month - 1], []);
                    ar.Maneder.Add(maned);
                }
                maned.Rader.Add(r);
            }
            return resultat;
        }
    }

    // Antall og sum for hele måneden (ikke bare prosjektene på siden).
    private (int Antall, decimal Sum) ManedSum(int ar, int mnd)
    {
        var rader = FiltrertAr.Where(r => Dato(r) is { } d && d.Year == ar && d.Month == mnd).ToList();
        return (rader.Count, rader.Sum(r => r.Verdi));
    }

    private RenderFragment Sidevelger() =>
        @<div class="fs-sider">
            <span>Viser @(TidslinjeSortert.Count == 0 ? 0 : (GjeldendeSide - 1) * _perSide + 1)–@Math.Min(GjeldendeSide * _perSide, TidslinjeSortert.Count) av @TidslinjeSortert.Count</span>
            @if (AntallSider > 1)
            {
                <div class="fs-sideknapper">
                    <button type="button" disabled="@(GjeldendeSide == 1)" @onclick="@(() => _side = GjeldendeSide - 1)">&lsaquo;</button>
                    @for (var i = 1; i <= AntallSider; i++)
                    {
                        var nr = i;
                        <button type="button" class="@(nr == GjeldendeSide ? "aktiv" : "")" @onclick="@(() => _side = nr)">@nr</button>
                    }
                    <button type="button" disabled="@(GjeldendeSide == AntallSider)" @onclick="@(() => _side = GjeldendeSide + 1)">&rsaquo;</button>
                </div>
            }
        </div>;

    private RenderFragment Smultring(List<NavngittGruppe> grupper, int storrelse) =>
        @<div class="fs-smultring">
            <svg viewBox="0 0 120 120" width="@storrelse" height="@storrelse">
                <circle cx="60" cy="60" r="45" fill="none" stroke="#efe8dc" stroke-width="16" />
                @foreach (var g in grupper)
                {
                    <circle cx="60" cy="60" r="45" fill="none" stroke="@g.Farge" stroke-width="16" transform="rotate(-90 60 60)"
                            stroke-dasharray="@(FormaterTall(g.Buelengde)) 282.6" stroke-dashoffset="@FormaterTall(-g.Offset)" />
                }
                <text x="60" y="58" text-anchor="middle" font-size="22" font-weight="600" fill="#292927">@FiltrertAr.Count</text>
                <text x="60" y="75" text-anchor="middle" font-size="9.5" fill="#8a857c">prosjekter</text>
            </svg>
            <ul class="fs-leg">
                @foreach (var g in grupper)
                {
                    <li><i style="background:@g.Farge"></i><span>@g.Navn</span><b>@g.Antall</b></li>
                }
            </ul>
        </div>;

    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public int? KundeId { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int AntallDorer { get; set; }
        public int AntallMontorer { get; set; }
        public decimal Verdi { get; set; }
        public ProsjektType Type { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record NavngittGruppe(string Navn, int Antall, double Buelengde, double Offset, string Farge);
    private sealed record Bar(string Etikett, double Prosent, bool Fremhevet);
    private sealed record KundeRang(int Rang, string Navn, int Antall);

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] ManedNavn = ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Des"];
    private static readonly string[] ManedNavnFull =
        ["Januar", "Februar", "Mars", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Desember"];

    private List<ProsjektRad> _rader = [];
    private int? _valgtAr;
    private string _fane = "oversikt";

    private List<int> AlleAr => _rader
        .Select(r => r.OpprettetDato.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();

    private List<ProsjektRad> FiltrertAr => _valgtAr.HasValue
        ? _rader.Where(r => r.OpprettetDato.Year == _valgtAr).ToList()
        : _rader;

    private List<ProsjektRad> ForrigeArRader => _valgtAr.HasValue
        ? _rader.Where(r => r.OpprettetDato.Year == _valgtAr - 1).ToList()
        : [];

    private decimal GjennomsnittTapt => FiltrertAr.Count == 0 ? 0 : FiltrertAr.Sum(r => r.Verdi) / FiltrertAr.Count;

    private static string DeltaTekst(int na, int forrige)
    {
        var diff = na - forrige;
        return diff switch
        {
            0 => "Uendret fra i fjor",
            > 0 => $"+{diff} fra i fjor",
            _ => $"{diff} fra i fjor"
        };
    }

    private static string ProsentDeltaTekst(decimal na, decimal forrige)
    {
        if (forrige <= 0)
        {
            return na > 0 ? "Nytt fra i fjor" : "Uendret fra i fjor";
        }

        var prosent = Math.Round((na - forrige) / forrige * 100, 0);
        return prosent switch
        {
            0 => "Uendret fra i fjor",
            > 0 => $"+{prosent}% fra i fjor",
            _ => $"{prosent}% fra i fjor"
        };
    }

    private List<Bar> AntallBarer
    {
        get
        {
            if (_valgtAr.HasValue)
            {
                var perManed = FiltrertAr
                    .GroupBy(r => r.OpprettetDato.Month)
                    .ToDictionary(g => g.Key, g => g.Count());
                var maks = Math.Max(perManed.Values.DefaultIfEmpty(0).Max(), 1);

                return Enumerable.Range(1, 12)
                    .Select(m =>
                    {
                        var antall = perManed.GetValueOrDefault(m, 0);
                        return new Bar(ManedNavn[m - 1], 100.0 * antall / maks, antall == maks && antall > 0);
                    })
                    .ToList();
            }

            var perAr = _rader
                .GroupBy(r => r.OpprettetDato.Year)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.Count());
            var maksAr = Math.Max(perAr.Values.DefaultIfEmpty(0).Max(), 1);

            return perAr
                .Select(kv => new Bar(kv.Key.ToString(), 100.0 * kv.Value / maksAr, kv.Value == maksAr))
                .ToList();
        }
    }

    private List<Bar> VerdiBarer
    {
        get
        {
            if (_valgtAr.HasValue)
            {
                var perManed = FiltrertAr
                    .GroupBy(r => r.OpprettetDato.Month)
                    .ToDictionary(g => g.Key, g => g.Sum(r => r.Verdi));
                var maks = Math.Max(perManed.Values.DefaultIfEmpty(0).Max(), 1);

                return Enumerable.Range(1, 12)
                    .Select(m => new Bar("", (double)(100m * perManed.GetValueOrDefault(m, 0) / maks), false))
                    .ToList();
            }

            var perAr = _rader
                .GroupBy(r => r.OpprettetDato.Year)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.Sum(r => r.Verdi));
            var maksAr = Math.Max(perAr.Values.DefaultIfEmpty(0).Max(), 1);

            return perAr
                .Select(kv => new Bar("", (double)(100m * kv.Value / maksAr), false))
                .ToList();
        }
    }

    private List<NavngittGruppe> TypeGrupper
    {
        get
        {
            var grupper = FiltrertAr
                .GroupBy(r => r.Type)
                .OrderByDescending(g => g.Count())
                .ToList();

            var total = Math.Max(FiltrertAr.Count, 1);
            double cum = 0;
            var resultat = new List<NavngittGruppe>();

            foreach (var g in grupper)
            {
                var antall = g.Count();
                var buelengde = 282.6 * antall / total;
                resultat.Add(new NavngittGruppe(g.Key.Visningsnavn(), antall, buelengde, cum, g.Key.Farge()));
                cum += buelengde;
            }

            return resultat;
        }
    }

    private static readonly string[] GeoPaletten = ["#a32020", "#c24d4d", "#d87979", "#e5a3a3", "#f0c9c9", "#9a958c"];

    private List<NavngittGruppe> GeoGrupper
    {
        get
        {
            var grupper = FiltrertAr
                .GroupBy(r => string.IsNullOrWhiteSpace(r.Sted) ? "Ukjent" : r.Sted)
                .OrderByDescending(g => g.Count())
                .ToList();

            var topp = grupper.Take(5).ToList();
            var restAntall = grupper.Skip(5).Sum(g => g.Count());

            var total = Math.Max(FiltrertAr.Count, 1);
            double cum = 0;
            var resultat = new List<NavngittGruppe>();
            var i = 0;

            foreach (var g in topp)
            {
                var antall = g.Count();
                var buelengde = 282.6 * antall / total;
                resultat.Add(new NavngittGruppe(g.Key, antall, buelengde, cum, GeoPaletten[Math.Min(i, GeoPaletten.Length - 1)]));
                cum += buelengde;
                i++;
            }

            if (restAntall > 0)
            {
                var buelengde = 282.6 * restAntall / total;
                resultat.Add(new NavngittGruppe("Andre", restAntall, buelengde, cum, GeoPaletten[^1]));
            }

            return resultat;
        }
    }

    private List<KundeRang> ToppKunder => FiltrertAr
        .Where(r => !string.IsNullOrWhiteSpace(r.KundeNavn))
        .GroupBy(r => r.KundeNavn)
        .Select(g => new { Navn = g.Key!, Antall = g.Count() })
        .OrderByDescending(x => x.Antall)
        .Take(5)
        .Select((x, i) => new KundeRang(i + 1, x.Navn, x.Antall))
        .ToList();

    private static string FormaterTall(double verdi) => verdi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync(BreddeNokkel, "normal") == "full";
        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.TilbudAvslatt)
            .Include(p => p.Kunde)
            .Include(p => p.Prosjektleder)
            .Include(p => p.Dorer)
            .Include(p => p.Arbeidsordre)
            .Include(p => p.Tilbud).ThenInclude(t => t.Linjer)
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _rader = prosjekter.Select(p => new ProsjektRad
        {
            Id = p.Id,
            Navn = p.Navn,
            KundeNavn = p.Kunde?.Navn,
            KundeId = p.KundeId,
            Adresse = p.Adresse,
            Sted = p.Sted,
            ProsjektlederNavn = p.Prosjektleder?.Navn,
            AntallDorer = p.Dorer.Count,
            AntallMontorer = p.Arbeidsordre.Select(a => a.AnsvarligMontorId).Where(id => id.HasValue).Distinct().Count(),
            Verdi = p.Tilbud
                .Where(t => t.Status == EndringsmeldingStatus.Avslatt)
                .Sum(t => t.SendtSum ?? TilbudBeregningHelper.BeregnTotaltUtenMva(t)),
            Type = p.Type,
            OpprettetDato = p.OpprettetDato
        }).ToList();

        _valgtAr = AlleAr.FirstOrDefault();
        if (_valgtAr == 0)
        {
            _valgtAr = null;
        }
    }
}
