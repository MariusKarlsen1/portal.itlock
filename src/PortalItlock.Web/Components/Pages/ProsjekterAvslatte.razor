@page "/prosjekter/avslatte"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Avslåtte prosjekter</PageTitle>

<div class="avslatte-side">

<a class="tilbake-link" href="/prosjekter"><Icon Name="arrow-left" />Tilbake til prosjekter</a>

<div class="avslatt-topbar">
    <div class="avslatt-header">
        <div class="avslatt-header-tittel">
            <span class="avslatt-header-ikon"><Icon Name="x" /></span>
            <h1>Avslåtte prosjekter</h1>
        </div>
        <p>Arkiv over prosjekter der tilbudet ble avslått &ndash; søkbart, med oversikt over volum pr. år.</p>
    </div>
    @if (_rader.Count > 0)
    {
        <div class="avslatt-topbar-actions">
            <select class="ar-velger" value="@(_valgtAr?.ToString() ?? "alle")" @onchange="@(e => _valgtAr = (string)e.Value! == "alle" ? null : int.Parse((string)e.Value!))">
                <option value="alle">Alle år</option>
                @foreach (var ar in AlleAr)
                {
                    <option value="@ar">@ar</option>
                }
            </select>
        </div>
    }
</div>

@if (_rader.Count > 0)
{
    <div class="avslatt-tabs">
        <button type="button" class="@(_fane == "oversikt" ? "aktiv" : "")" @onclick='@(() => _fane = "oversikt")'><Icon Name="trend-up" />Oversikt</button>
        <button type="button" class="@(_fane == "tidslinje" ? "aktiv" : "")" @onclick='@(() => _fane = "tidslinje")'><Icon Name="clock" />Tidslinje</button>
    </div>
}

@if (_rader.Count == 0)
{
    <p class="list-empty">Ingen avslåtte prosjekter funnet.</p>
}
else if (_fane == "oversikt")
{
    <div class="fo-statrow">
        <div class="fo-statcard">
            <span class="fo-statcard-ic fo-ic-rod"><Icon Name="x" /></span>
            <div>
                <div class="fo-statcard-num">@FiltrertAr.Count</div>
                <div class="fo-statcard-lbl">Totalt avslått</div>
                @if (_valgtAr.HasValue)
                {
                    <div class="fo-statcard-delta fo-delta-rod">@DeltaTekst(FiltrertAr.Count, ForrigeArRader.Count)</div>
                }
            </div>
        </div>
        <div class="fo-statcard">
            <span class="fo-statcard-ic fo-ic-aksent"><Icon Name="file-text" /></span>
            <div>
                <div class="fo-statcard-num">@FiltrertAr.Sum(r => r.AntallDorer)</div>
                <div class="fo-statcard-lbl">Totalt dører</div>
                @if (_valgtAr.HasValue)
                {
                    <div class="fo-statcard-delta fo-delta-rod">@DeltaTekst(FiltrertAr.Sum(r => r.AntallDorer), ForrigeArRader.Sum(r => r.AntallDorer))</div>
                }
            </div>
        </div>
        <div class="fo-statcard">
            <span class="fo-statcard-ic fo-ic-gul"><Icon Name="users" /></span>
            <div>
                <div class="fo-statcard-num">@FiltrertAr.Select(r => r.KundeId).Where(k => k.HasValue).Distinct().Count()</div>
                <div class="fo-statcard-lbl">Kunder</div>
                @if (_valgtAr.HasValue)
                {
                    <div class="fo-statcard-delta fo-delta-rod">@DeltaTekst(FiltrertAr.Select(r => r.KundeId).Where(k => k.HasValue).Distinct().Count(), ForrigeArRader.Select(r => r.KundeId).Where(k => k.HasValue).Distinct().Count())</div>
                }
            </div>
        </div>
        <div class="fo-statcard">
            <span class="fo-statcard-ic fo-ic-rod"><Icon Name="trend-up" /></span>
            <div>
                <div class="fo-statcard-num">@FiltrertAr.Sum(r => r.Verdi).ToString("N0", Kultur) kr</div>
                <div class="fo-statcard-lbl">Tapt verdi</div>
                @if (_valgtAr.HasValue)
                {
                    <div class="fo-statcard-delta fo-delta-rod">@ProsentDeltaTekst(FiltrertAr.Sum(r => r.Verdi), ForrigeArRader.Sum(r => r.Verdi))</div>
                }
            </div>
        </div>
    </div>

    <div class="fo-grid2">
        <div class="fo-panel">
            <h3>Avslåtte prosjekter per @(_valgtAr.HasValue ? $"måned – {_valgtAr}" : "år")</h3>
            <div class="fo-barchart">
                @foreach (var b in AntallBarer)
                {
                    <div class="fo-bar-kol">
                        <div class="fo-bar-track"><div class="fo-bar-fyll fo-bar-fyll-rod @(b.Fremhevet ? "fo-bar-fyll-aktiv" : "")" style="height:@(b.Prosent)%"></div></div>
                        <span class="fo-bar-etikett">@b.Etikett</span>
                    </div>
                }
            </div>
        </div>
        <div class="fo-panel">
            <h3>Prosjekttype</h3>
            <div class="fo-donutrad">
                <svg viewBox="0 0 120 120" width="100" height="100" class="donut" style="transform:rotate(-90deg);">
                    <circle cx="60" cy="60" r="45" fill="none" stroke="var(--itlock-border)" stroke-width="16" />
                    @foreach (var g in TypeGrupper)
                    {
                        <circle cx="60" cy="60" r="45" fill="none" stroke="@g.Farge" stroke-width="16"
                                stroke-dasharray="@(FormaterTall(g.Buelengde)) 282.6" stroke-dashoffset="@FormaterTall(-g.Offset)" />
                    }
                    <text x="60" y="56" text-anchor="middle" font-size="22" font-weight="700" fill="var(--itlock-ink)" transform="rotate(90 60 60)">@FiltrertAr.Count</text>
                    <text x="60" y="76" text-anchor="middle" font-size="10" fill="var(--itlock-ink-muted)" transform="rotate(90 60 60)">Totalt</text>
                </svg>
                <ul class="fo-legend">
                    @foreach (var g in TypeGrupper)
                    {
                        <li><span class="fo-legend-dott" style="background:@g.Farge"></span>@g.Navn<span class="fo-legend-antall">@g.Antall</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="fo-grid3">
        <div class="fo-panel">
            <h3>Topp kunder</h3>
            <ol class="fo-rangliste">
                @foreach (var k in ToppKunder)
                {
                    <li>
                        <span class="fo-rang">@k.Rang</span>
                        <span class="fo-rang-navn">@k.Navn</span>
                        <span class="fo-rang-antall">@k.Antall prosjekt@(k.Antall == 1 ? "" : "er")</span>
                    </li>
                }
                @if (ToppKunder.Count == 0)
                {
                    <li class="fo-tom">Ingen data</li>
                }
            </ol>
        </div>
        <div class="fo-panel">
            <h3>Geografisk fordeling</h3>
            <div class="fo-donutrad">
                <ul class="fo-legend fo-legend-smal">
                    @foreach (var g in GeoGrupper)
                    {
                        <li><span class="fo-legend-dott" style="background:@g.Farge"></span>@g.Navn<span class="fo-legend-antall">@g.Antall</span></li>
                    }
                </ul>
                <svg viewBox="0 0 120 120" width="80" height="80" class="donut" style="transform:rotate(-90deg);">
                    <circle cx="60" cy="60" r="45" fill="none" stroke="var(--itlock-border)" stroke-width="16" />
                    @foreach (var g in GeoGrupper)
                    {
                        <circle cx="60" cy="60" r="45" fill="none" stroke="@g.Farge" stroke-width="16"
                                stroke-dasharray="@(FormaterTall(g.Buelengde)) 282.6" stroke-dashoffset="@FormaterTall(-g.Offset)" />
                    }
                    <text x="60" y="56" text-anchor="middle" font-size="18" font-weight="700" fill="var(--itlock-ink)" transform="rotate(90 60 60)">@FiltrertAr.Count</text>
                    <text x="60" y="74" text-anchor="middle" font-size="9" fill="var(--itlock-ink-muted)" transform="rotate(90 60 60)">Totalt</text>
                </svg>
            </div>
        </div>
        <div class="fo-panel">
            <h3>Snitt tapt verdi</h3>
            <div class="fo-verdi-topp">
                <span class="fo-verdi-tall">@GjennomsnittTapt.ToString("N0", Kultur) kr</span>
                <span class="fo-verdi-badge fo-verdi-badge-rod">pr. prosjekt</span>
            </div>
            <div class="fo-barchart fo-barchart-lite">
                @foreach (var b in VerdiBarer)
                {
                    <div class="fo-bar-kol">
                        <div class="fo-bar-track"><div class="fo-bar-fyll fo-bar-fyll-rod" style="height:@(b.Prosent)%"></div></div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (_fane == "tidslinje")
{
    <div class="tl-wrap">
        @foreach (var argruppe in TidslinjeGrupper)
        {
            <div class="tl-ar">@argruppe.Ar</div>
            @foreach (var manedgruppe in argruppe.Maneder)
            {
                <div class="tl-manedrad">
                    <div class="tl-manednavn">@manedgruppe.Navn</div>
                    <div class="tl-rader">
                        @foreach (var r in manedgruppe.Rader)
                        {
                            <div class="tl-rad">
                                <div class="tl-linje">
                                    <span class="tl-prikk tl-prikk-rod"><Icon Name="x" /></span>
                                </div>
                                <div class="tl-kort">
                                    <span class="tl-dato">@r.OpprettetDato.ToString("d. MMM yyyy", Kultur)</span>
                                    <span class="tl-ikon"><Icon Name="building" /></span>
                                    <a class="tl-info" href="@($"/prosjekter/{r.Id}")">
                                        <span class="tl-navn">@r.Navn</span>
                                        <span class="tl-sted">@(r.Sted ?? r.KundeNavn ?? "Ikke satt")</span>
                                    </a>
                                    <span class="tl-badge"><Icon Name="file-text" />@r.AntallDorer dør@(r.AntallDorer == 1 ? "" : "er")</span>
                                    <span class="tl-badge"><Icon Name="users" />@r.AntallMontorer montør@(r.AntallMontorer == 1 ? "" : "er")</span>
                                    <span class="tl-verdi tl-verdi-rod">@r.Verdi.ToString("N0", Kultur) kr</span>
                                    <a class="tl-doklink" href="@($"/prosjekter/{r.Id}")" title="Åpne prosjekt"><Icon Name="file-text" /></a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

</div>

@code {
    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public int? KundeId { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int AntallDorer { get; set; }
        public int AntallMontorer { get; set; }
        public decimal Verdi { get; set; }
        public ProsjektType Type { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record NavngittGruppe(string Navn, int Antall, double Buelengde, double Offset, string Farge);
    private sealed record Bar(string Etikett, double Prosent, bool Fremhevet);
    private sealed record KundeRang(int Rang, string Navn, int Antall);
    private sealed record TidslinjeManed(string Navn, List<ProsjektRad> Rader);
    private sealed record TidslinjeAr(int Ar, List<TidslinjeManed> Maneder);

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] ManedNavn = ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Des"];
    private static readonly string[] ManedNavnFull =
        ["Januar", "Februar", "Mars", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Desember"];

    private List<ProsjektRad> _rader = [];
    private int? _valgtAr;
    private string _fane = "oversikt";

    private List<int> AlleAr => _rader
        .Select(r => r.OpprettetDato.Year)
        .Distinct()
        .OrderByDescending(a => a)
        .ToList();

    private List<ProsjektRad> FiltrertAr => _valgtAr.HasValue
        ? _rader.Where(r => r.OpprettetDato.Year == _valgtAr).ToList()
        : _rader;

    private List<ProsjektRad> ForrigeArRader => _valgtAr.HasValue
        ? _rader.Where(r => r.OpprettetDato.Year == _valgtAr - 1).ToList()
        : [];

    private decimal GjennomsnittTapt => FiltrertAr.Count == 0 ? 0 : FiltrertAr.Sum(r => r.Verdi) / FiltrertAr.Count;

    private static string DeltaTekst(int na, int forrige)
    {
        var diff = na - forrige;
        return diff switch
        {
            0 => "Uendret fra i fjor",
            > 0 => $"+{diff} fra i fjor",
            _ => $"{diff} fra i fjor"
        };
    }

    private static string ProsentDeltaTekst(decimal na, decimal forrige)
    {
        if (forrige <= 0)
        {
            return na > 0 ? "Nytt fra i fjor" : "Uendret fra i fjor";
        }

        var prosent = Math.Round((na - forrige) / forrige * 100, 0);
        return prosent switch
        {
            0 => "Uendret fra i fjor",
            > 0 => $"+{prosent}% fra i fjor",
            _ => $"{prosent}% fra i fjor"
        };
    }

    private List<Bar> AntallBarer
    {
        get
        {
            if (_valgtAr.HasValue)
            {
                var perManed = FiltrertAr
                    .GroupBy(r => r.OpprettetDato.Month)
                    .ToDictionary(g => g.Key, g => g.Count());
                var maks = Math.Max(perManed.Values.DefaultIfEmpty(0).Max(), 1);

                return Enumerable.Range(1, 12)
                    .Select(m =>
                    {
                        var antall = perManed.GetValueOrDefault(m, 0);
                        return new Bar(ManedNavn[m - 1], 100.0 * antall / maks, antall == maks && antall > 0);
                    })
                    .ToList();
            }

            var perAr = _rader
                .GroupBy(r => r.OpprettetDato.Year)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.Count());
            var maksAr = Math.Max(perAr.Values.DefaultIfEmpty(0).Max(), 1);

            return perAr
                .Select(kv => new Bar(kv.Key.ToString(), 100.0 * kv.Value / maksAr, kv.Value == maksAr))
                .ToList();
        }
    }

    private List<Bar> VerdiBarer
    {
        get
        {
            if (_valgtAr.HasValue)
            {
                var perManed = FiltrertAr
                    .GroupBy(r => r.OpprettetDato.Month)
                    .ToDictionary(g => g.Key, g => g.Sum(r => r.Verdi));
                var maks = Math.Max(perManed.Values.DefaultIfEmpty(0).Max(), 1);

                return Enumerable.Range(1, 12)
                    .Select(m => new Bar("", (double)(100m * perManed.GetValueOrDefault(m, 0) / maks), false))
                    .ToList();
            }

            var perAr = _rader
                .GroupBy(r => r.OpprettetDato.Year)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.Sum(r => r.Verdi));
            var maksAr = Math.Max(perAr.Values.DefaultIfEmpty(0).Max(), 1);

            return perAr
                .Select(kv => new Bar("", (double)(100m * kv.Value / maksAr), false))
                .ToList();
        }
    }

    private List<NavngittGruppe> TypeGrupper
    {
        get
        {
            var grupper = FiltrertAr
                .GroupBy(r => r.Type)
                .OrderByDescending(g => g.Count())
                .ToList();

            var total = Math.Max(FiltrertAr.Count, 1);
            double cum = 0;
            var resultat = new List<NavngittGruppe>();

            foreach (var g in grupper)
            {
                var antall = g.Count();
                var buelengde = 282.6 * antall / total;
                resultat.Add(new NavngittGruppe(g.Key.Visningsnavn(), antall, buelengde, cum, g.Key.Farge()));
                cum += buelengde;
            }

            return resultat;
        }
    }

    private static readonly string[] GeoPaletten = ["#a32020", "#c24d4d", "#d87979", "#e5a3a3", "#f0c9c9", "#9a958c"];

    private List<NavngittGruppe> GeoGrupper
    {
        get
        {
            var grupper = FiltrertAr
                .GroupBy(r => string.IsNullOrWhiteSpace(r.Sted) ? "Ukjent" : r.Sted)
                .OrderByDescending(g => g.Count())
                .ToList();

            var topp = grupper.Take(5).ToList();
            var restAntall = grupper.Skip(5).Sum(g => g.Count());

            var total = Math.Max(FiltrertAr.Count, 1);
            double cum = 0;
            var resultat = new List<NavngittGruppe>();
            var i = 0;

            foreach (var g in topp)
            {
                var antall = g.Count();
                var buelengde = 282.6 * antall / total;
                resultat.Add(new NavngittGruppe(g.Key, antall, buelengde, cum, GeoPaletten[Math.Min(i, GeoPaletten.Length - 1)]));
                cum += buelengde;
                i++;
            }

            if (restAntall > 0)
            {
                var buelengde = 282.6 * restAntall / total;
                resultat.Add(new NavngittGruppe("Andre", restAntall, buelengde, cum, GeoPaletten[^1]));
            }

            return resultat;
        }
    }

    private List<KundeRang> ToppKunder => FiltrertAr
        .Where(r => !string.IsNullOrWhiteSpace(r.KundeNavn))
        .GroupBy(r => r.KundeNavn)
        .Select(g => new { Navn = g.Key!, Antall = g.Count() })
        .OrderByDescending(x => x.Antall)
        .Take(5)
        .Select((x, i) => new KundeRang(i + 1, x.Navn, x.Antall))
        .ToList();

    private List<TidslinjeAr> TidslinjeGrupper => FiltrertAr
        .GroupBy(r => r.OpprettetDato.Year)
        .OrderByDescending(g => g.Key)
        .Select(gAr => new TidslinjeAr(
            gAr.Key,
            gAr.GroupBy(r => r.OpprettetDato.Month)
                .OrderByDescending(g => g.Key)
                .Select(gManed => new TidslinjeManed(
                    ManedNavnFull[gManed.Key - 1],
                    gManed.OrderByDescending(r => r.OpprettetDato).ToList()))
                .ToList()))
        .ToList();

    private static string FormaterTall(double verdi) => verdi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.TilbudAvslatt)
            .Include(p => p.Kunde)
            .Include(p => p.Prosjektleder)
            .Include(p => p.Dorer)
            .Include(p => p.Arbeidsordre)
            .Include(p => p.Tilbud).ThenInclude(t => t.Linjer)
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _rader = prosjekter.Select(p => new ProsjektRad
        {
            Id = p.Id,
            Navn = p.Navn,
            KundeNavn = p.Kunde?.Navn,
            KundeId = p.KundeId,
            Adresse = p.Adresse,
            Sted = p.Sted,
            ProsjektlederNavn = p.Prosjektleder?.Navn,
            AntallDorer = p.Dorer.Count,
            AntallMontorer = p.Arbeidsordre.Select(a => a.AnsvarligMontorId).Where(id => id.HasValue).Distinct().Count(),
            Verdi = p.Tilbud
                .Where(t => t.Status == EndringsmeldingStatus.Avslatt)
                .Sum(t => t.SendtSum ?? TilbudBeregningHelper.BeregnTotaltUtenMva(t)),
            Type = p.Type,
            OpprettetDato = p.OpprettetDato
        }).ToList();

        _valgtAr = AlleAr.FirstOrDefault();
        if (_valgtAr == 0)
        {
            _valgtAr = null;
        }
    }
}
