@page "/prosjekter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje

<PageTitle>Prosjekter</PageTitle>

<h1 class="side-tittel">Prosjekter</h1>
<p class="prosjekt-intro">Oversikt over prosjekter: dører, plantegninger og montasjestatus. Søk på navn, kunde eller adresse.</p>

@if (Verktoylinje.ErMobilvisning)
{
    <div class="mobil-prosjekt-faner">
        <button type="button" class="mobil-prosjekt-fane @(_prosjektFane == "prosjekter" ? "aktiv" : "")" @onclick="@(() => _prosjektFane = "prosjekter")">Prosjekter</button>
        <button type="button" class="mobil-prosjekt-fane @(_prosjektFane == "serviceavtaler" ? "aktiv" : "")" @onclick="@(() => _prosjektFane = "serviceavtaler")">Serviceavtaler</button>
    </div>
}

@if (_prosjektFane == "serviceavtaler")
{
    @if (_visFilter)
    {
        <div class="dor-velger-panel">
            <div class="dor-velger-header">
                <strong>Filtrer serviceavtaler</strong>
                <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
            </div>
            <ul class="funksjon-chip-list">
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("forfalt")" @onchange="@(() => ToggleServiceFilter("forfalt"))" />
                        Forfalt
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("naermer")" @onchange="@(() => ToggleServiceFilter("naermer"))" />
                        Nærmer seg
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("kommende")" @onchange="@(() => ToggleServiceFilter("kommende"))" />
                        Planlagt/kommende
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("utfort")" @onchange="@(() => ToggleServiceFilter("utfort"))" />
                        Utført
                    </label>
                </li>
            </ul>
            @if (_serviceFilterValgt.Count > 0)
            {
                <button type="button" class="cancel-button" @onclick="@(() => { _serviceFilterValgt.Clear(); Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
            }
        </div>
    }

    @if (_serviceavtaler.Count == 0)
    {
        <p class="list-empty">Ingen serviceavtaler funnet.</p>
    }
    else if (FiltrerteServiceavtaler.Count == 0)
    {
        <p class="list-empty">Ingen serviceavtaler passer filteret.</p>
    }
    else
    {
        <ul class="prosjekt-list">
            @foreach (var a in FiltrerteServiceavtaler)
            {
                <li class="prosjekt-item mobil-kant-@a.Farge">
                    <a class="prosjekt-row" href="@($"serviceavtaler/{a.Id}")">
                        <span class="prosjekt-navn">@a.Navn</span>
                        @if (a.ErForfalt)
                        {
                            <span class="avtale-badge avtale-badge-forfalt">Service forfalt</span>
                        }
                        else if (a.ErSnartForfalt)
                        {
                            <span class="avtale-badge avtale-badge-snart">Nærmer seg forfall</span>
                        }
                        else if (a.NesteDato.HasValue)
                        {
                            <span class="avtale-badge avtale-badge-kommende">Neste service @a.NesteDato.Value.ToString("dd.MM.yyyy")</span>
                        }
                        else if (a.ErUtfort)
                        {
                            <span class="avtale-badge avtale-badge-utfort">Utført</span>
                        }
                        <span class="prosjekt-meta">
                            @(string.IsNullOrWhiteSpace(a.KundeNavn) ? "Ingen kunde satt" : a.KundeNavn)
                            @if (a.SisteUtfortDato.HasValue)
                            {
                                <text> · Sist service: @a.SisteUtfortDato.Value.ToString("dd.MM.yyyy")</text>
                            }
                            else
                            {
                                <text> · Ingen servicerunder registrert ennå</text>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
}
@if (_prosjektFane != "serviceavtaler")
{
@if (_naverendeRolle != BrukerRolle.Montor)
{
    <a class="new-button prosjekt-admin-knapp" href="prosjekter/ny">Nytt prosjekt</a>
}
@if (!Verktoylinje.ErMobilvisning)
{
    <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
        Filtrer@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
    </button>
}
@if (_naverendeRolle != BrukerRolle.Montor)
{
    <button type="button" class="@(_redigerModus ? "edit-button-active" : "filter-button") prosjekt-admin-knapp" @onclick="ToggleRedigerModus">
        @(_redigerModus ? "Ferdig" : "Rediger")
    </button>
}

@if (_visFilter)
{
    <div class="dor-velger-panel">
        <div class="dor-velger-header">
            <strong>Filtrer på status</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
        </div>
        <ul class="funksjon-chip-list">
            @foreach (var s in Enum.GetValues<ProsjektStatus>().Where(s => s != ProsjektStatus.Serviceavtale))
            {
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_valgteStatusFilter.Contains(s)" @onchange="@(() => ToggleStatusFilter(s))" />
                        @s.Visningsnavn()
                    </label>
                </li>
            }
        </ul>
        <label class="filter-option prosjektleder-filter">
            Prosjektleder
            <select value="@(_prosjektlederFilter?.ToString() ?? "")" @onchange="@(e => { _prosjektlederFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                <option value="">Alle</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
        </label>
        <label class="filter-option montor-filter">
            Ansvarlig montør
            <select value="@(_montorFilter?.ToString() ?? "")" @onchange="@(e => { _montorFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                <option value="">Alle</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
        </label>
        @if (AntallAktiveFiltre > 0)
        {
            <button type="button" class="cancel-button" @onclick="@(() => { _valgteStatusFilter.Clear(); _prosjektlederFilter = null; _montorFilter = null; Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
        }
    </div>
}

<input class="search-input"
       @bind="_search"
       @bind:event="oninput"
       placeholder="Søk på navn, kunde eller adresse" />

<p class="result-count">@_filtrert.Count av @_alle.Count prosjekter</p>

@if (_alle.Count == 0)
{
    <p class="list-empty mobil-tom-tekst-skjul">Ingen prosjekter opprettet ennå.</p>
    <div class="mobil-prosjekt-tom">
        <svg class="mobil-tom-figur" viewBox="0 0 120 100" width="120" height="100" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="30" width="80" height="60" rx="4" fill="#ffffff" stroke="#835e41" stroke-width="3" />
            <rect x="34" y="46" width="16" height="16" fill="#f4f0e9" stroke="#ddd6cb" stroke-width="2" />
            <rect x="70" y="46" width="16" height="16" fill="#f4f0e9" stroke="#ddd6cb" stroke-width="2" />
            <rect x="52" y="66" width="16" height="24" fill="#835e41" />
            <path d="M14 30 L60 8 L106 30" fill="none" stroke="#835e41" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2>Ingen prosjekter</h2>
        <p>Nye prosjekter dukker opp her når de opprettes.</p>
    </div>
}
else if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen prosjekter funnet.</p>
}
else
{
    <ul class="prosjekt-list">
        @foreach (var p in _filtrert)
        {
            <li class="prosjekt-item @(p.Status.HasValue ? $"mobil-kant-{p.Status.Value.PillFarge()}" : "mobil-kant-noytral")">
                <a class="prosjekt-row" href="@($"prosjekter/{p.Id}")">
                    <span class="prosjekt-navn">@p.Navn</span>
                    @if (p.Status.HasValue)
                    {
                        <StatusPill Tekst="@p.Status.Value.Visningsnavn()" Ikon="@p.Status.Value.PillIkon()" Farge="@p.Status.Value.PillFarge()" />
                    }
                    <span class="prosjekt-meta">
                        @(string.IsNullOrWhiteSpace(p.Kunde) ? "Ingen kunde satt" : p.Kunde)
                        @if (!string.IsNullOrWhiteSpace(p.Adresse))
                        {
                            <text> · @p.Adresse</text>
                        }
                        <text> · @p.AntallDorer dør@(p.AntallDorer == 1 ? "" : "er")</text>
                        @if (p.AntallDorer > 0)
                        {
                            <text> (@p.AntallFerdig ferdig montert)</text>
                        }
                    </span>
                </a>
                @if (_redigerModus && _naverendeRolle != BrukerRolle.Montor)
                {
                    @if (_slettId == p.Id)
                    {
                        <span class="prosjekt-slett-confirm">
                            Slette "@p.Navn"?
                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettProsjekt(p.Id))">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="prosjekt-slett-button" title="Slett prosjekt" @onclick="@(() => _slettId = p.Id)">&times;</button>
                    }
                }
            </li>
        }
    </ul>
}
}

@code {
    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kunde { get; set; }
        public string? Adresse { get; set; }
        public ProsjektStatus? Status { get; set; }
        public int AntallDorer { get; set; }
        public int AntallFerdig { get; set; }
        public int? ProsjektlederId { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
    }

    // Fargespråk (samme som .mobil-kant-* / avtale-badge-*): rød=forfalt,
    // oransje=nærmer seg forfall, blå=planlagt/kommende (fra "Planlagt
    // servicerunde" eller neste-service-dato satt på en utført runde),
    // grønn=utført (siste runde er ferdig og ingenting venter), nøytral=
    // ingenting registrert ennå.
    private sealed class ServiceavtaleRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime? SisteUtfortDato { get; set; }
        public DateTime? NesteDato { get; set; }
        public bool ErForfalt => NesteDato.HasValue && NesteDato.Value.Date < DateTime.Today;
        public bool ErSnartForfalt => NesteDato.HasValue && !ErForfalt && NesteDato.Value.Date <= DateTime.Today.AddDays(14);
        public bool ErKommende => NesteDato.HasValue && !ErForfalt && !ErSnartForfalt;
        public bool ErUtfort => !NesteDato.HasValue && SisteUtfortDato.HasValue;
        public string Farge => ErForfalt ? "rod" : ErSnartForfalt ? "oransje" : ErKommende ? "blaa" : ErUtfort ? "gronn" : "noytral";
    }

    private List<ProsjektRad> _alle = [];
    private List<ServiceavtaleRad> _serviceavtaler = [];
    private List<Bruker> _alleBrukere = [];
    private string _search = "";
    private HashSet<ProsjektStatus> _valgteStatusFilter = [];
    private int? _prosjektlederFilter;
    private int? _montorFilter;
    private HashSet<string> _serviceFilterValgt = [];
    private bool _visFilter;
    private int? _slettId;
    private bool _redigerModus;
    private string _prosjektFane = "prosjekter";

    private int AntallAktiveFiltre =>
        _valgteStatusFilter.Count + (_prosjektlederFilter.HasValue ? 1 : 0) + (_montorFilter.HasValue ? 1 : 0);

    private List<ServiceavtaleRad> FiltrerteServiceavtaler => _serviceavtaler
        .Where(a => _serviceFilterValgt.Count == 0
            || (_serviceFilterValgt.Contains("forfalt") && a.ErForfalt)
            || (_serviceFilterValgt.Contains("naermer") && a.ErSnartForfalt)
            || (_serviceFilterValgt.Contains("kommende") && a.ErKommende)
            || (_serviceFilterValgt.Contains("utfort") && a.ErUtfort))
        .ToList();

    private void ToggleServiceFilter(string verdi)
    {
        if (!_serviceFilterValgt.Add(verdi))
        {
            _serviceFilterValgt.Remove(verdi);
        }
        Verktoylinje.VarsleEndring();
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private List<ProsjektRad> _filtrert => _alle
        .Where(p => string.IsNullOrWhiteSpace(_search) ||
                p.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (p.Kunde?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(p => _valgteStatusFilter.Count == 0 || (p.Status.HasValue && _valgteStatusFilter.Contains(p.Status.Value)))
        .Where(p => _prosjektlederFilter is null || p.ProsjektlederId == _prosjektlederFilter)
        .Where(p => _montorFilter is null || p.AnsvarligMontorId == _montorFilter)
        .ToList();

    private void ToggleStatusFilter(ProsjektStatus status)
    {
        if (!_valgteStatusFilter.Add(status))
        {
            _valgteStatusFilter.Remove(status);
        }
        Verktoylinje.VarsleEndring();
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task SlettProsjekt(int id)
    {
        var eksisterende = await Db.Prosjekter.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            Db.Prosjekter.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        _alle.RemoveAll(p => p.Id == id);
        _slettId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        // Mobilvisning avgjøres sentralt av MainLayout (se kommentar der) og
        // leses herfra via Verktoylinje.ErMobilvisning - unngår at hver side
        // må gjøre sin egen (langsommere) deteksjon ved hver navigasjon.
        Verktoylinje.Endret += OnVerktoylinjeEndret;

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        IQueryable<Prosjekt> query = Db.Prosjekter.Where(p => p.Status != ProsjektStatus.Serviceavtale);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            query = query.Where(p => p.Medlemmer.Any(m => m.Id == _naverendeBrukerId));
        }

        _alle = await query
            .OrderByDescending(p => p.OpprettetDato)
            .Select(p => new ProsjektRad
            {
                Id = p.Id,
                Navn = p.Navn,
                Kunde = p.Kunde != null ? p.Kunde.Navn : null,
                Adresse = p.Adresse,
                Status = p.Status,
                AntallDorer = p.Dorer.Count,
                AntallFerdig = p.Dorer.Count(d => d.Status == PortalItlock.Web.Models.MontasjeStatus.FerdigMontert),
                ProsjektlederId = p.ProsjektlederId,
                ProsjektlederNavn = p.Prosjektleder != null ? p.Prosjektleder.Navn : null,
                AnsvarligMontorId = p.AnsvarligMontorId,
                AnsvarligMontorNavn = p.AnsvarligMontor != null ? p.AnsvarligMontor.Navn : null
            })
            .ToListAsync();

        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();

        // Serviceavtaler er prosjekter med status Serviceavtale (se
        // Serviceavtaler.razor) - på mobil vises de i en egen fane her i
        // stedet for den skrivebord-only /serviceavtaler-siden. En montør
        // ser kun sine egne (satt som "Ansvarlig person" på selve
        // serviceavtalen), admin/prosjektleder ser alle.
        IQueryable<Prosjekt> serviceQuery = Db.Prosjekter.Where(p => p.Status == ProsjektStatus.Serviceavtale);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            serviceQuery = serviceQuery.Where(p => p.AnsvarligMontorId == _naverendeBrukerId);
        }

        var serviceProsjekter = await serviceQuery
            .Include(p => p.Kunde)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        var serviceProsjektIder = serviceProsjekter.Select(p => p.Id).ToList();
        var runder = serviceProsjektIder.Count == 0
            ? []
            : await Db.Servicerunder
                .Where(r => serviceProsjektIder.Contains(r.ProsjektId))
                .ToListAsync();

        _serviceavtaler = serviceProsjekter.Select(p =>
        {
            var proRunder = runder.Where(r => r.ProsjektId == p.Id).ToList();
            var utfortRunder = proRunder.Where(r => !r.ErPlanlagt).OrderByDescending(r => r.Dato).ToList();
            var nestePlanlagtDato = proRunder
                .Where(r => r.ErPlanlagt && r.Dato.Date >= DateTime.Today)
                .OrderBy(r => r.Dato)
                .FirstOrDefault()?.Dato;
            var nesteFraUtfortDato = utfortRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

            DateTime? nesteDato = nestePlanlagtDato.HasValue && nesteFraUtfortDato.HasValue
                ? (nestePlanlagtDato.Value < nesteFraUtfortDato.Value ? nestePlanlagtDato : nesteFraUtfortDato)
                : nestePlanlagtDato ?? nesteFraUtfortDato;

            return new ServiceavtaleRad
            {
                Id = p.Id,
                Navn = p.Navn,
                KundeNavn = p.Kunde?.Navn,
                SisteUtfortDato = utfortRunder.FirstOrDefault()?.Dato,
                NesteDato = nesteDato
            };
        }).ToList();

        Verktoylinje.RegistrerFilter(
            () => { _visFilter = !_visFilter; StateHasChanged(); },
            () => (_prosjektFane == "serviceavtaler" ? _serviceFilterValgt.Count : AntallAktiveFiltre) > 0);
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        Verktoylinje.AvregistrerFilter();
    }
}
