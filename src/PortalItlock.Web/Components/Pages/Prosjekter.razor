@page "/prosjekter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.GeocodingService Geokoding
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref
@inject IJSRuntime JS

<PageTitle>Prosjekter</PageTitle>

<div class="prosjekter-side">

<div class="side-tittel prosjekt-header">
    <div class="prosjekt-header-tittel">
        <span class="prosjekt-header-ikon"><Icon Name="folder" /></span>
        <h1>Prosjekter</h1>
    </div>
    <p class="prosjekt-intro">Oversikt over prosjekter: dører, plantegninger og montasjestatus.</p>
</div>

@if (Verktoylinje.ErMobilvisning)
{
    <div class="mobil-prosjekt-faner">
        <button type="button" class="mobil-prosjekt-fane @(_prosjektFane == "prosjekter" ? "aktiv" : "")" @onclick="@(() => _prosjektFane = "prosjekter")">Prosjekter</button>
        <button type="button" class="mobil-prosjekt-fane @(_prosjektFane == "serviceavtaler" ? "aktiv" : "")" @onclick="@(() => _prosjektFane = "serviceavtaler")">Serviceavtaler</button>
    </div>
}

@if (_prosjektFane == "serviceavtaler")
{
    @if (_visFilter)
    {
        <div class="dor-velger-panel">
            <div class="dor-velger-header">
                <strong>Filtrer serviceavtaler</strong>
                <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
            </div>
            <ul class="funksjon-chip-list">
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("forfalt")" @onchange="@(() => ToggleServiceFilter("forfalt"))" />
                        Forfalt
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("naermer")" @onchange="@(() => ToggleServiceFilter("naermer"))" />
                        Nærmer seg
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("kommende")" @onchange="@(() => ToggleServiceFilter("kommende"))" />
                        Planlagt/kommende
                    </label>
                </li>
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_serviceFilterValgt.Contains("utfort")" @onchange="@(() => ToggleServiceFilter("utfort"))" />
                        Utført
                    </label>
                </li>
            </ul>
            @if (_serviceFilterValgt.Count > 0)
            {
                <button type="button" class="cancel-button" @onclick="@(() => { _serviceFilterValgt.Clear(); Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
            }
        </div>
    }

    @if (_serviceavtaler.Count == 0)
    {
        <p class="list-empty">Ingen serviceavtaler funnet.</p>
    }
    else if (FiltrerteServiceavtaler.Count == 0)
    {
        <p class="list-empty">Ingen serviceavtaler passer filteret.</p>
    }
    else
    {
        <ul class="prosjekt-list">
            @foreach (var a in FiltrerteServiceavtaler)
            {
                <li class="prosjekt-item mobil-kant-@a.Farge">
                    <a class="prosjekt-row" href="@($"serviceavtaler/{a.Id}")">
                        <span class="prosjekt-navn">@a.Navn</span>
                        @if (a.ErForfalt)
                        {
                            <span class="avtale-badge avtale-badge-forfalt">Service forfalt</span>
                        }
                        else if (a.ErSnartForfalt)
                        {
                            <span class="avtale-badge avtale-badge-snart">Nærmer seg forfall</span>
                        }
                        else if (a.NesteDato.HasValue)
                        {
                            <span class="avtale-badge avtale-badge-kommende">Neste service @a.NesteDato.Value.ToString("dd.MM.yyyy")</span>
                        }
                        else if (a.ErUtfort)
                        {
                            <span class="avtale-badge avtale-badge-utfort">Utført</span>
                        }
                        <span class="prosjekt-meta">
                            @(string.IsNullOrWhiteSpace(a.KundeNavn) ? "Ingen kunde satt" : a.KundeNavn)
                            @if (a.SisteUtfortDato.HasValue)
                            {
                                <text> · Sist service: @a.SisteUtfortDato.Value.ToString("dd.MM.yyyy")</text>
                            }
                            else
                            {
                                <text> · Ingen servicerunder registrert ennå</text>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    }

    @if (Verktoylinje.ErMobilvisning)
    {
        <button type="button" class="mobil-serviceavtale-fab" title="Ny serviceavtale" @onclick="@(() => _visNyServiceavtaleForm = !_visNyServiceavtaleForm)">+</button>

        @if (_visNyServiceavtaleForm)
        {
            <div class="mobil-serviceavtale-modal">
                <div class="mobil-serviceavtale-modal-innhold">
                    <div class="mobil-serviceavtale-modal-header">
                        <strong>Ny serviceavtale</strong>
                        <button type="button" class="cancel-button" @onclick="@(() => _visNyServiceavtaleForm = false)">Lukk</button>
                    </div>
                    <div class="field-grid">
                        <label>
                            Navn på avtalen/bygget
                            <input @bind="_nyServiceavtaleNavn" @bind:event="oninput" placeholder="F.eks. Storgata 5 - service" />
                        </label>
                        <label>
                            Kunde (valgfritt)
                            <select @bind="_nyServiceavtaleKundeId">
                                <option value="">Ingen kunde satt</option>
                                @foreach (var k in _kunder)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                        </label>
                        <label>
                            Adresse (valgfritt)
                            <input @bind="_nyServiceavtaleAdresse" @bind:event="oninput" placeholder="F.eks. Storgata 5" />
                        </label>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="save-button" @onclick="OpprettServiceavtaleMobil" disabled="@string.IsNullOrWhiteSpace(_nyServiceavtaleNavn)">
                            Opprett serviceavtale
                        </button>
                    </div>
                </div>
            </div>
        }
    }
}
@if (_prosjektFane != "serviceavtaler")
{
<div class="prosjekt-toolbar">
    <label class="sok-felt prosjekt-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på navn, kunde eller adresse" />
    </label>

    <div class="prosjekt-toolbar-knapper">
        @if (!Verktoylinje.ErMobilvisning)
        {
            <div class="prosjekt-viewtoggle">
                <button type="button" class="@(_visning == "kanban" ? "aktiv" : "")" @onclick="@(() => VelgVisning("kanban"))"><Icon Name="box" />Kanban</button>
                <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick="@(() => VelgVisning("liste"))"><Icon Name="file-text" />Liste</button>
                <button type="button" class="@(_visning == "kart" ? "aktiv" : "")" @onclick="VelgKartvisning"><Icon Name="map" />Kart</button>
            </div>
        }
        @if (_naverendeRolle != BrukerRolle.Montor)
        {
            <a class="new-button prosjekt-admin-knapp" href="prosjekter/ny"><Icon Name="plus" />Nytt prosjekt</a>
            <a class="filter-button prosjekt-admin-knapp" href="prosjekter/ferdigstilte"><Icon Name="check-circle" />Ferdigstilte prosjekter</a>
            <a class="filter-button prosjekt-admin-knapp" href="prosjekter/avslatte"><Icon Name="x" />Avslåtte prosjekter</a>
        }
        @if (!Verktoylinje.ErMobilvisning)
        {
            <select class="sorter-velger" value="@_sortering" @onchange="@(e => _sortering = (string)e.Value!)">
                <option value="nyeste">Sorter: Nyeste først</option>
                <option value="dorer">Sorter: Flest dører</option>
                <option value="navn">Sorter: Alfabetisk</option>
            </select>
            <div class="prosjekt-filterpopup-anker">
                <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
                    <Icon Name="filter" />Filtrer@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
                </button>
                @if (_visFilter)
                {
                    <div class="prosjekt-filterpopup">
                        <div class="prosjekt-filterpopup-header">
                            <strong>Filtrer prosjekter</strong>
                            <button type="button" class="prosjekt-filterpopup-lukk" @onclick="@(() => _visFilter = false)" title="Lukk"><Icon Name="x" /></button>
                        </div>

                        <div class="prosjekt-filterpopup-seksjon">
                            <span class="prosjekt-filterpopup-label">Status</span>
                            <div class="prosjekt-filterpopup-status-liste">
                                @foreach (var s in StatusKolonneRekkefolge)
                                {
                                    <label class="prosjekt-filterpopup-status-rad">
                                        <input type="checkbox" checked="@_valgteStatusFilter.Contains(s!.Value)" @onchange="@(() => ToggleStatusFilter(s!.Value))" />
                                        <span class="prosjekt-filterpopup-dott" style="background:@HexForKanbanFarge(KanbanFarge(s))"></span>
                                        @s!.Value.Visningsnavn()
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="prosjekt-filterpopup-skille"></div>

                        <label class="prosjekt-filterpopup-select-rad">
                            Prosjektleder
                            <select value="@(_prosjektlederFilter?.ToString() ?? "")" @onchange="@(e => { _prosjektlederFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                                <option value="">Alle</option>
                                @foreach (var b in _alleBrukere)
                                {
                                    <option value="@b.Id">@b.Navn</option>
                                }
                            </select>
                        </label>
                        <label class="prosjekt-filterpopup-select-rad">
                            Ansvarlig montør
                            <select value="@(_montorFilter?.ToString() ?? "")" @onchange="@(e => { _montorFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                                <option value="">Alle</option>
                                @foreach (var b in _alleBrukere)
                                {
                                    <option value="@b.Id">@b.Navn</option>
                                }
                            </select>
                        </label>

                        <div class="prosjekt-filterpopup-bunn">
                            <button type="button" class="prosjekt-filterpopup-nullstill" @onclick="@(() => { _valgteStatusFilter.Clear(); _prosjektlederFilter = null; _montorFilter = null; Verktoylinje.VarsleEndring(); })">Nullstill</button>
                            <button type="button" class="prosjekt-filterpopup-vis" @onclick="@(() => _visFilter = false)">Vis resultater (@_filtrert.Count)</button>
                        </div>
                    </div>
                }
            </div>
        }
        @if (_naverendeRolle != BrukerRolle.Montor)
        {
            <button type="button" class="@(_redigerModus ? "edit-button-active" : "filter-button") prosjekt-admin-knapp" @onclick="ToggleRedigerModus">
                <Icon Name="edit" />@(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        }
    </div>
</div>

@if (_visFilter && Verktoylinje.ErMobilvisning)
{
    @* Desktop har sin egen flytende .prosjekt-filterpopup i verktøylinjen over -
       dette er kun mobilversjonen, vist via mobil-verktøylinjens filter-knapp
       (se Verktoylinje.RegistrerFilter lenger ned). *@
    <div class="dor-velger-panel">
        <div class="dor-velger-header">
            <strong>Filtrer på status</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
        </div>
        <ul class="funksjon-chip-list">
            @foreach (var s in StatusKolonneRekkefolge)
            {
                <li>
                    <label class="filter-option">
                        <input type="checkbox" checked="@_valgteStatusFilter.Contains(s!.Value)" @onchange="@(() => ToggleStatusFilter(s!.Value))" />
                        @s!.Value.Visningsnavn()
                    </label>
                </li>
            }
        </ul>
        <label class="filter-option prosjektleder-filter">
            Prosjektleder
            <select value="@(_prosjektlederFilter?.ToString() ?? "")" @onchange="@(e => { _prosjektlederFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                <option value="">Alle</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
        </label>
        <label class="filter-option montor-filter">
            Ansvarlig montør
            <select value="@(_montorFilter?.ToString() ?? "")" @onchange="@(e => { _montorFilter = string.IsNullOrEmpty(e.Value as string) ? null : int.Parse((string)e.Value!); Verktoylinje.VarsleEndring(); })">
                <option value="">Alle</option>
                @foreach (var b in _alleBrukere)
                {
                    <option value="@b.Id">@b.Navn</option>
                }
            </select>
        </label>
        @if (AntallAktiveFiltre > 0)
        {
            <button type="button" class="cancel-button" @onclick="@(() => { _valgteStatusFilter.Clear(); _prosjektlederFilter = null; _montorFilter = null; Verktoylinje.VarsleEndring(); })">Nullstill filter</button>
        }
    </div>
}

<p class="result-count">@_filtrert.Count av @_alle.Count prosjekter</p>

@if (_alle.Count == 0)
{
    <p class="list-empty mobil-tom-tekst-skjul">Ingen prosjekter opprettet ennå.</p>
    <div class="mobil-prosjekt-tom">
        <svg class="mobil-tom-figur" viewBox="0 0 120 100" width="120" height="100" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="30" width="80" height="60" rx="4" fill="#ffffff" stroke="#835e41" stroke-width="3" />
            <rect x="34" y="46" width="16" height="16" fill="#f4f0e9" stroke="#ddd6cb" stroke-width="2" />
            <rect x="70" y="46" width="16" height="16" fill="#f4f0e9" stroke="#ddd6cb" stroke-width="2" />
            <rect x="52" y="66" width="16" height="24" fill="#835e41" />
            <path d="M14 30 L60 8 L106 30" fill="none" stroke="#835e41" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2>Ingen prosjekter</h2>
        <p>Nye prosjekter dukker opp her når de opprettes.</p>
    </div>
}
else if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen prosjekter funnet.</p>
}
else if (Verktoylinje.ErMobilvisning)
{
    <ul class="prosjekt-list">
        @foreach (var p in _filtrert)
        {
            <li class="prosjekt-item @(p.Status.HasValue ? $"mobil-kant-{p.Status.Value.PillFarge()}" : "mobil-kant-noytral")">
                <a class="prosjekt-row" href="@($"prosjekter/{p.Id}")">
                    <span class="prosjekt-navn">@p.Navn</span>
                    @if (p.Status.HasValue)
                    {
                        <StatusPill Tekst="@p.Status.Value.Visningsnavn()" Ikon="@p.Status.Value.PillIkon()" Farge="@p.Status.Value.PillFarge()" />
                    }
                    <span class="prosjekt-meta">
                        @(string.IsNullOrWhiteSpace(p.Kunde) ? "Ingen kunde satt" : p.Kunde)
                        @if (!string.IsNullOrWhiteSpace(p.Adresse))
                        {
                            <text> · @p.Adresse</text>
                        }
                        <text> · @p.AntallDorer dør@(p.AntallDorer == 1 ? "" : "er")</text>
                        @if (p.AntallDorer > 0)
                        {
                            <text> (@p.AntallFerdig ferdig montert)</text>
                        }
                    </span>
                </a>
                @if (_redigerModus && _naverendeRolle != BrukerRolle.Montor)
                {
                    @if (_slettId == p.Id)
                    {
                        <span class="prosjekt-slett-confirm">
                            Slette "@p.Navn"?
                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettProsjekt(p.Id))">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="prosjekt-slett-button" title="Slett prosjekt" @onclick="@(() => _slettId = p.Id)">&times;</button>
                    }
                }
            </li>
        }
    </ul>
}
else if (_visning == "kanban")
{
    <div class="prosjekt-kanban">
        @foreach (var status in StatusKolonneRekkefolge)
        {
            var kolonne = _filtrert.Where(p => p.Status == status).ToList();
            var navnPaStatus = status?.Visningsnavn() ?? "Uten status";
            var farge = KanbanFarge(status);
            var team = kolonne
                .Select(p => p.ProsjektlederNavn)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct()
                .ToList();

            <div class="kanban-kolonne kanban-kolonne-@farge">
                <div class="kanban-kolonne-header">
                    <span class="kanban-kolonne-dott kanban-kolonne-dott-@farge"></span>
                    <span class="kanban-kolonne-navn">@navnPaStatus</span>
                    <span class="kanban-kolonne-teller">@kolonne.Count</span>
                    @if (team.Count > 0)
                    {
                        <div class="kanban-team-stabel">
                            @foreach (var navn in team)
                            {
                                <span class="kanban-team-avatar" style="background:@PersonFarge(navn!)" title="@navn">@PersonInitialer(navn!)</span>
                            }
                        </div>
                    }
                </div>

                @if (kolonne.Count == 0)
                {
                    <p class="kanban-kolonne-tom">Ingen prosjekter</p>
                }
                @foreach (var p in kolonne)
                {
                    <div class="prosjekt-kort-wrap">
                        <a class="kanban-kort" href="@($"prosjekter/{p.Id}")">
                            <span class="kanban-kort-navn">@p.Navn</span>
                            <div class="prosjekt-kort-linje">
                                <Icon Name="users" />
                                <span>@(string.IsNullOrWhiteSpace(p.Kunde) ? "Ingen kunde satt" : p.Kunde)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.Adresse))
                            {
                                <div class="prosjekt-kort-linje">
                                    <Icon Name="map" />
                                    <span>@p.Adresse</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.ProsjektlederNavn))
                            {
                                <span class="team-person">
                                    <span class="team-avatar" style="background:@PersonFarge(p.ProsjektlederNavn)">@PersonInitialer(p.ProsjektlederNavn)</span>
                                    @p.ProsjektlederNavn
                                </span>
                            }
                            else
                            {
                                <span class="prosjekt-team-tom">Ingen prosjektleder satt</span>
                            }
                            @if (p.AntallDorer > 0)
                            {
                                <div class="kanban-kort-bunn">
                                    <span class="prosjekt-fremdrift-bar"><span class="prosjekt-fremdrift-fyll" style="width:@(FremdriftProsent(p))%"></span></span>
                                    <span class="prosjekt-fremdrift-tekst">@p.AntallFerdig / @p.AntallDorer dør@(p.AntallDorer == 1 ? "" : "er")</span>
                                </div>
                            }
                        </a>
                        @if (_redigerModus && _naverendeRolle != BrukerRolle.Montor)
                        {
                            @if (_slettId == p.Id)
                            {
                                <div class="prosjekt-kort-slett-confirm">
                                    <span>Slette "@p.Navn"?</span>
                                    <button type="button" class="delete-confirm-button" @onclick="@(() => SlettProsjekt(p.Id))">Ja, slett</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="prosjekt-kort-slett-button" title="Slett prosjekt" @onclick="@(() => _slettId = p.Id)">
                                    <Icon Name="trash" />
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else if (_visning == "liste")
{
    <div class="prosjekt-tablewrap">
        <table class="prosjekt-table">
            <thead>
                <tr class="prosjekt-thr">
                    <th>Navn</th>
                    <th>Kunde</th>
                    <th>Adresse</th>
                    <th>Status</th>
                    <th>Prosjektleder</th>
                    <th>Montør</th>
                    <th>Dører</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _sidevisning)
                {
                    <tr @key="p.Id" class="prosjekt-tr" @onclick="@(() => Nav.NavigateTo($"prosjekter/{p.Id}"))">
                        <td class="prosjekt-td-navn">@p.Navn</td>
                        <td>@(p.Kunde ?? "-")</td>
                        <td>@(p.Adresse ?? "-")</td>
                        <td>
                            @if (p.Status.HasValue)
                            {
                                <StatusPill Tekst="@p.Status.Value.Visningsnavn()" Ikon="@p.Status.Value.PillIkon()" Farge="@p.Status.Value.PillFarge()" />
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@(p.ProsjektlederNavn ?? "-")</td>
                        <td>@(p.AnsvarligMontorNavn ?? "-")</td>
                        <td>@(p.AntallDorer > 0 ? $"{p.AntallFerdig} / {p.AntallDorer}" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="prosjekt-pagerad">
        <span class="prosjekt-pagerad-tekst">Viser @(((_side - 1) * _sideStorrelse) + 1)-@(Math.Min(_side * _sideStorrelse, _filtrert.Count)) av @_filtrert.Count</span>
        <div class="prosjekt-pager">
            <button type="button" disabled="@(_side <= 1)" @onclick="@(() => _side--)"><Icon Name="chevron-down" /></button>
            @for (var i = 1; i <= AntallSider; i++)
            {
                var side = i;
                <button type="button" class="@(side == _side ? "aktiv" : "")" @onclick="@(() => _side = side)">@side</button>
            }
            <button type="button" disabled="@(_side >= AntallSider)" @onclick="@(() => _side++)"><Icon Name="chevron-down" /></button>
        </div>
    </div>
}
else if (_visning == "kart")
{
    <div class="prosjekt-pillrow">
        <button type="button" class="prosjekt-pill prosjekt-pill-aktiv @(_kartStatusFilter is null ? "valgt" : "")" @onclick="@(() => _kartStatusFilter = null)">Alle <span>(@_filtrert.Count)</span></button>
        @foreach (var status in StatusKolonneRekkefolge)
        {
            var farge = KanbanFarge(status);
            <button type="button" class="prosjekt-pill prosjekt-pill-@farge @(_kartStatusFilter == status ? "valgt" : "")" @onclick="@(() => _kartStatusFilter = status)">
                <span class="prosjekt-pill-prikk"></span>@status!.Value.Visningsnavn()
            </button>
        }
    </div>

    <div class="prosjekt-kartside">
        <div class="prosjekt-kartliste">
            @if (_kartFiltrert.Count == 0)
            {
                <p class="list-empty">Ingen prosjekter funnet.</p>
            }
            else
            {
                @foreach (var p in _kartFiltrert)
                {
                    <button type="button" @key="p.Id" class="prosjekt-kartkort prosjekt-kartkort-@KanbanFarge(p.Status)" @onclick="@(() => FremhevPaKart(p.Id))">
                        <span class="prosjekt-kartkort-tittel">@p.Navn</span>
                        <span class="prosjekt-kartkort-adresse">@(p.Adresse ?? p.Kunde ?? "Ingen adresse")</span>
                        @if (p.Status.HasValue)
                        {
                            <StatusPill Tekst="@p.Status.Value.Visningsnavn()" Ikon="@p.Status.Value.PillIkon()" Farge="@p.Status.Value.PillFarge()" />
                        }
                    </button>
                }
            }
        </div>
        <div class="prosjekt-kartwrap">
            <div id="prosjekt-kart" class="prosjekt-kart"></div>
        </div>
    </div>
}
}

</div>

@code {
    private sealed class ProsjektRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Kunde { get; set; }
        public string? Adresse { get; set; }
        public ProsjektStatus? Status { get; set; }
        public int AntallDorer { get; set; }
        public int AntallFerdig { get; set; }
        public int? ProsjektlederId { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public int? AnsvarligMontorId { get; set; }
        public string? AnsvarligMontorNavn { get; set; }
        public DateTime OpprettetDato { get; set; }

        // Brukes kun av kartvisningen.
        public string? Postnr { get; set; }
        public string? Sted { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    // Egen fargesetting for kanban-kolonnene på hovedsiden, uavhengig av
    // ProsjektStatus.PillFarge() (som brukes globalt av StatusPill og
    // mobil-kant-* på tvers av hele appen). De fire kolonnene her er alle
    // "aktive" statuser og har derfor samme farge ("blaa") i PillFarge - det
    // er riktig for f.eks. StatusPill andre steder, men gjør at kolonnene
    // ikke kan skilles fra hverandre her. Denne gir dem fire distinkte
    // farger kun for kanban-prikken, uten å røre den delte fargebetydningen.
    private static string KanbanFarge(ProsjektStatus? status) => status switch
    {
        ProsjektStatus.Aktiv => "blaa",
        ProsjektStatus.Tilbud => "gul",
        ProsjektStatus.Registrert => "turkis",
        ProsjektStatus.UnderArbeid => "lilla",
        _ => "noytral"
    };

    // Rekkefølgen kanban-kolonnene vises i på skrivebordsvisningen - samme
    // rekkefølge som prosessen faktisk går i. Status er nå påkrevd ved
    // opprettelse (se Lagre() i ProsjektSkjema.razor), så det skal ikke
    // lenger kunne oppstå prosjekter uten status. Tilbud avslått, Avsluttet,
    // Overlevert og Serviceavtale er ikke egne kolonner her - de flytter
    // prosjektet til et eget arkiv (Avslåtte/Ferdigstilte prosjekter,
    // eller serviceavtale-modulen) i stedet.
    private static readonly ProsjektStatus?[] StatusKolonneRekkefolge =
    [
        ProsjektStatus.Aktiv,
        ProsjektStatus.Tilbud,
        ProsjektStatus.Registrert,
        ProsjektStatus.UnderArbeid
    ];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length >= 2
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private static string OpprettetTekst(DateTime opprettet)
    {
        var dager = (DateTime.Today - opprettet.Date).Days;
        return dager switch
        {
            <= 0 => "Opprettet i dag",
            1 => "Opprettet i går",
            _ => $"Opprettet for {dager} dager siden"
        };
    }

    // Fargespråk (samme som .mobil-kant-* / avtale-badge-*): rød=forfalt,
    // oransje=nærmer seg forfall, blå=planlagt/kommende (fra "Planlagt
    // servicerunde" eller neste-service-dato satt på en utført runde),
    // grønn=utført (siste runde er ferdig og ingenting venter), nøytral=
    // ingenting registrert ennå.
    private sealed class ServiceavtaleRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime? SisteUtfortDato { get; set; }
        public DateTime? NesteDato { get; set; }
        public bool ErForfalt => NesteDato.HasValue && NesteDato.Value.Date < DateTime.Today;
        public bool ErSnartForfalt => NesteDato.HasValue && !ErForfalt && NesteDato.Value.Date <= DateTime.Today.AddDays(14);
        public bool ErKommende => NesteDato.HasValue && !ErForfalt && !ErSnartForfalt;
        public bool ErUtfort => !NesteDato.HasValue && SisteUtfortDato.HasValue;
        public string Farge => ErForfalt ? "rod" : ErSnartForfalt ? "oransje" : ErKommende ? "blaa" : ErUtfort ? "gronn" : "noytral";
    }

    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<ProsjektRad> _alle = [];
    private List<ServiceavtaleRad> _serviceavtaler = [];
    private List<Bruker> _alleBrukere = [];
    private List<KundeOption> _kunder = [];
    private string _search = "";
    private HashSet<ProsjektStatus> _valgteStatusFilter = [];
    private int? _prosjektlederFilter;
    private int? _montorFilter;
    private HashSet<string> _serviceFilterValgt = [];
    private bool _visFilter;
    private int? _slettId;
    private bool _redigerModus;
    private string _prosjektFane = "prosjekter";
    private string _visning = "kanban";
    private int _side = 1;
    private int _sideStorrelse = 10;
    private ProsjektStatus? _kartStatusFilter;
    private bool _kartLastet;
    private bool _kartInitialisert;
    private string? _sisteKartSignatur;
    private string _sortering = "nyeste";
    private bool _visNyServiceavtaleForm;
    private string _nyServiceavtaleNavn = "";
    private int? _nyServiceavtaleKundeId;
    private string? _nyServiceavtaleAdresse;

    private int AntallAktiveFiltre =>
        _valgteStatusFilter.Count + (_prosjektlederFilter.HasValue ? 1 : 0) + (_montorFilter.HasValue ? 1 : 0);

    private List<ServiceavtaleRad> FiltrerteServiceavtaler => _serviceavtaler
        .Where(a => _serviceFilterValgt.Count == 0
            || (_serviceFilterValgt.Contains("forfalt") && a.ErForfalt)
            || (_serviceFilterValgt.Contains("naermer") && a.ErSnartForfalt)
            || (_serviceFilterValgt.Contains("kommende") && a.ErKommende)
            || (_serviceFilterValgt.Contains("utfort") && a.ErUtfort))
        .ToList();

    private void ToggleServiceFilter(string verdi)
    {
        if (!_serviceFilterValgt.Add(verdi))
        {
            _serviceFilterValgt.Remove(verdi);
        }
        Verktoylinje.VarsleEndring();
    }

    // Speiler Serviceavtaler.razor sin OpprettServiceavtale() - en
    // serviceavtale ER et prosjekt med status Serviceavtale (se
    // Serviceavtaler.razor). Nyttig for montører ute i felt som må
    // registrere en ny avtale (og dørene på den) uten å gå via PC.
    private async Task OpprettServiceavtaleMobil()
    {
        var navn = _nyServiceavtaleNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var prosjekt = new Prosjekt
        {
            Navn = navn,
            KundeId = _nyServiceavtaleKundeId,
            Adresse = string.IsNullOrWhiteSpace(_nyServiceavtaleAdresse) ? null : _nyServiceavtaleAdresse.Trim(),
            Status = ProsjektStatus.Serviceavtale
        };

        Db.Prosjekter.Add(prosjekt);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/serviceavtaler/{prosjekt.Id}");
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private List<ProsjektRad> _basisFiltrert => _alle
        .Where(p => string.IsNullOrWhiteSpace(_search) ||
                p.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (p.Kunde?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(p => _valgteStatusFilter.Count == 0 || (p.Status.HasValue && _valgteStatusFilter.Contains(p.Status.Value)))
        .Where(p => _prosjektlederFilter is null || p.ProsjektlederId == _prosjektlederFilter)
        .Where(p => _montorFilter is null || p.AnsvarligMontorId == _montorFilter)
        .ToList();

    private List<ProsjektRad> _filtrert
    {
        get
        {
            IEnumerable<ProsjektRad> rader = _sortering switch
            {
                "dorer" => _basisFiltrert.OrderByDescending(p => p.AntallDorer),
                "navn" => _basisFiltrert.OrderBy(p => p.Navn, StringComparer.OrdinalIgnoreCase),
                _ => _basisFiltrert.OrderByDescending(p => p.OpprettetDato)
            };

            return rader.ToList();
        }
    }

    private List<ProsjektRad> _sidevisning => _filtrert
        .Skip((_side - 1) * _sideStorrelse)
        .Take(_sideStorrelse)
        .ToList();

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(_filtrert.Count / (double)_sideStorrelse));

    private List<ProsjektRad> _kartFiltrert => _filtrert
        .Where(p => _kartStatusFilter is null || p.Status == _kartStatusFilter)
        .ToList();

    private static string HexForKanbanFarge(string farge) => farge switch
    {
        "blaa" => "#2054a3",
        "gul" => "#a1690a",
        "turkis" => "#0f7a6b",
        "lilla" => "#7a2b96",
        _ => "#835e41"
    };

    private static string HexBgForKanbanFarge(string farge) => farge switch
    {
        "blaa" => "#dbe7f7",
        "gul" => "#f4e3c7",
        "turkis" => "#d7efeb",
        "lilla" => "#f0d9f7",
        _ => "#eee7df"
    };

    private async Task FremhevPaKart(int id) => await JS.InvokeVoidAsync("kart.fremhev", id);

    private List<object> KartPunkter() => _kartFiltrert
        .Where(p => p.Latitude is not null && p.Longitude is not null)
        .Select(p =>
        {
            var farge = KanbanFarge(p.Status);
            return (object)new
            {
                id = p.Id,
                lat = p.Latitude!.Value,
                lng = p.Longitude!.Value,
                tittel = p.Navn,
                undertekst = p.Adresse ?? p.Kunde ?? "",
                undertekst2 = string.IsNullOrWhiteSpace(p.ProsjektlederNavn) ? null : $"Prosjektleder: {p.ProsjektlederNavn}",
                farge = HexForKanbanFarge(farge),
                pin = true,
                rikPopup = true,
                statusTekst = p.Status?.Visningsnavn(),
                statusBg = HexBgForKanbanFarge(farge),
                datoTekst = (string?)null,
                timerTekst = p.AntallDorer > 0 ? $"{p.AntallFerdig}/{p.AntallDorer} dører" : null,
                href = $"/prosjekter/{p.Id}"
            };
        })
        .ToList();

    // Henter adresse/posisjon og geokoder prosjekter som mangler lagret
    // posisjon - kun kjørt første gang kartvisningen åpnes (samme mønster
    // som Arbeidsordre sin kartvisning og Serviceavtaler.razor).
    private async Task LastInnKartData()
    {
        if (_kartLastet)
        {
            return;
        }
        _kartLastet = true;

        var ider = _alle.Select(p => p.Id).ToList();
        var prosjekter = await Db.Prosjekter.Where(p => ider.Contains(p.Id)).ToListAsync();

        var endret = false;
        foreach (var rad in _alle)
        {
            var p = prosjekter.FirstOrDefault(x => x.Id == rad.Id);
            if (p is null)
            {
                continue;
            }

            rad.Postnr = p.Postnr;
            rad.Sted = p.Sted;
            rad.Latitude = p.Latitude;
            rad.Longitude = p.Longitude;

            if (rad.Latitude is null && !string.IsNullOrWhiteSpace(rad.Adresse))
            {
                var treff = await Geokoding.GeocodeAsync(rad.Adresse!, rad.Postnr, rad.Sted);
                if (treff is not null)
                {
                    rad.Latitude = treff.Value.Latitude;
                    rad.Longitude = treff.Value.Longitude;
                    p.Latitude = treff.Value.Latitude;
                    p.Longitude = treff.Value.Longitude;
                    endret = true;
                }
            }
        }

        if (endret)
        {
            await Db.SaveChangesAsync();
        }
    }

    private async Task VelgKartvisning()
    {
        _visning = "kart";
        await VisningPref.SettAsync("prosjekter", "kart");
        await LastInnKartData();
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("prosjekter", visning);
    }

    private static int FremdriftProsent(ProsjektRad p) =>
        p.AntallDorer == 0 ? 0 : (int)Math.Round(100.0 * p.AntallFerdig / p.AntallDorer);

    private void ToggleStatusFilter(ProsjektStatus status)
    {
        if (!_valgteStatusFilter.Add(status))
        {
            _valgteStatusFilter.Remove(status);
        }
        Verktoylinje.VarsleEndring();
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
    }

    private async Task SlettProsjekt(int id)
    {
        var eksisterende = await Db.Prosjekter.FirstOrDefaultAsync(p => p.Id == id);
        if (eksisterende is not null)
        {
            Db.Prosjekter.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        _alle.RemoveAll(p => p.Id == id);
        _slettId = null;
    }

    [SupplyParameterFromQuery(Name = "fane")] public string? FaneQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Mobilvisning avgjøres sentralt av MainLayout (se kommentar der) og
        // leses herfra via Verktoylinje.ErMobilvisning - unngår at hver side
        // må gjøre sin egen (langsommere) deteksjon ved hver navigasjon.
        Verktoylinje.Endret += OnVerktoylinjeEndret;
        _visning = await VisningPref.HentAsync("prosjekter", _visning);

        if (FaneQuery == "serviceavtaler")
        {
            _prosjektFane = "serviceavtaler";
        }

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        // Ferdigstilte (Overlevert) og avslåtte (TilbudAvslatt) prosjekter
        // vises ikke i denne lista - de finnes i stedet under egne arkiv-sider
        // ("Ferdigstilte prosjekter" / "Avslåtte prosjekter", se
        // ProsjekterFerdigstilte.razor / ProsjekterAvslatte.razor), samme
        // prinsipp som Fakturert-status holdes utenfor arbeidsordre-lista.
        // Avsluttet er en pensjonert status (kan ikke lenger velges i
        // ProsjektSkjema) og holdes derfor også utenfor.
        IQueryable<Prosjekt> query = Db.Prosjekter.Where(p =>
            p.Status != ProsjektStatus.Serviceavtale
            && p.Status != ProsjektStatus.Overlevert
            && p.Status != ProsjektStatus.TilbudAvslatt
            && p.Status != ProsjektStatus.Avsluttet);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            query = query.Where(p => p.Medlemmer.Any(m => m.Id == _naverendeBrukerId));
        }

        _alle = await query
            .OrderByDescending(p => p.OpprettetDato)
            .Select(p => new ProsjektRad
            {
                Id = p.Id,
                Navn = p.Navn,
                Kunde = p.Kunde != null ? p.Kunde.Navn : null,
                Adresse = p.Adresse,
                Status = p.Status,
                AntallDorer = p.Dorer.Count,
                AntallFerdig = p.Dorer.Count(d => d.Status == PortalItlock.Web.Models.MontasjeStatus.FerdigMontert),
                ProsjektlederId = p.ProsjektlederId,
                ProsjektlederNavn = p.Prosjektleder != null ? p.Prosjektleder.Navn : null,
                AnsvarligMontorId = p.AnsvarligMontorId,
                AnsvarligMontorNavn = p.AnsvarligMontor != null ? p.AnsvarligMontor.Navn : null,
                OpprettetDato = p.OpprettetDato
            })
            .ToListAsync();

        _alleBrukere = await Db.Brukere.OrderBy(b => b.Navn).ToListAsync();

        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        // Serviceavtaler er prosjekter med status Serviceavtale (se
        // Serviceavtaler.razor) - på mobil vises de i en egen fane her i
        // stedet for den skrivebord-only /serviceavtaler-siden. En montør
        // ser kun sine egne (satt som "Ansvarlig person" på selve
        // serviceavtalen), admin/prosjektleder ser alle.
        IQueryable<Prosjekt> serviceQuery = Db.Prosjekter.Where(p => p.Status == ProsjektStatus.Serviceavtale);
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            serviceQuery = serviceQuery.Where(p => p.AnsvarligMontorId == _naverendeBrukerId);
        }

        var serviceProsjekter = await serviceQuery
            .Include(p => p.Kunde)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        var serviceProsjektIder = serviceProsjekter.Select(p => p.Id).ToList();
        var runder = serviceProsjektIder.Count == 0
            ? []
            : await Db.Servicerunder
                .Where(r => serviceProsjektIder.Contains(r.ProsjektId))
                .ToListAsync();

        _serviceavtaler = serviceProsjekter.Select(p =>
        {
            var proRunder = runder.Where(r => r.ProsjektId == p.Id).ToList();
            var utfortRunder = proRunder.Where(r => !r.ErPlanlagt).OrderByDescending(r => r.Dato).ToList();
            var nestePlanlagtDato = proRunder
                .Where(r => r.ErPlanlagt && r.Dato.Date >= DateTime.Today)
                .OrderBy(r => r.Dato)
                .FirstOrDefault()?.Dato;
            var nesteFraUtfortDato = utfortRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

            DateTime? nesteDato = nestePlanlagtDato.HasValue && nesteFraUtfortDato.HasValue
                ? (nestePlanlagtDato.Value < nesteFraUtfortDato.Value ? nestePlanlagtDato : nesteFraUtfortDato)
                : nestePlanlagtDato ?? nesteFraUtfortDato;

            return new ServiceavtaleRad
            {
                Id = p.Id,
                Navn = p.Navn,
                KundeNavn = p.Kunde?.Navn,
                SisteUtfortDato = utfortRunder.FirstOrDefault()?.Dato,
                NesteDato = nesteDato
            };
        }).ToList();

        Verktoylinje.RegistrerFilter(
            () => { _visFilter = !_visFilter; StateHasChanged(); },
            () => (_prosjektFane == "serviceavtaler" ? _serviceFilterValgt.Count : AntallAktiveFiltre) > 0);

        if (_visning == "kart")
        {
            await LastInnKartData();
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        Verktoylinje.AvregistrerFilter();
    }

    // Tegner/oppdaterer kartet kun når kartvisningen faktisk er aktiv, og kun
    // når det synlige punktsettet (filter/søk) faktisk har endret seg siden
    // sist - samme mønster som Arbeidsordre/Serviceavtaler/Home sine kart.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Verktoylinje.ErMobilvisning || _visning != "kart" || !_kartLastet)
        {
            return;
        }

        var punkter = KartPunkter();
        var signatur = string.Join("|", punkter.Select(p => p!.ToString()));

        if (!_kartInitialisert)
        {
            await JS.InvokeVoidAsync("kart.init", "prosjekt-kart", punkter);
            _kartInitialisert = true;
            _sisteKartSignatur = signatur;
        }
        else if (signatur != _sisteKartSignatur)
        {
            await JS.InvokeVoidAsync("kart.setPunkter", punkter);
            _sisteKartSignatur = signatur;
        }
    }
}
