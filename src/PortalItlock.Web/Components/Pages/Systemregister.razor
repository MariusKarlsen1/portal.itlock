@page "/systemregister"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Systemregister</PageTitle>

<div class="sys-side">

<div class="system-header">
    <div class="system-header-tittel">
        <span class="system-header-ikon"><Icon Name="lock" /></span>
        <h1>Systemregister</h1>
    </div>
    <p>Oversikt over alle låssystemer: hvem systemet tilhører, adresse og hvem som kan rekvirere nøkler.</p>
</div>

<div class="sr-innhold">
    <aside class="sr-sidebar">
        <nav class="sr-filter-liste">
            <button type="button" class="sr-filter-rad @(_statusFilter == "" ? "aktiv" : "")" @onclick='@(() => SettStatusFilter(""))'>
                <span class="sr-filter-ikon"><Icon Name="lock" /></span>Alle systemer<span class="sr-filter-tall">@_alle.Count</span>
            </button>
            <button type="button" class="sr-filter-rad sr-filter-gronn @(_statusFilter == "aktiv" ? "aktiv" : "")" @onclick='@(() => SettStatusFilter("aktiv"))'>
                <span class="sr-filter-ikon"><Icon Name="check-circle" /></span>Aktive<span class="sr-filter-tall">@_alle.Count(s => EffektivStatus(s) == "aktiv")</span>
            </button>
            <button type="button" class="sr-filter-rad sr-filter-gul @(_statusFilter == "uten-rekvirent" ? "aktiv" : "")" @onclick='@(() => SettStatusFilter("uten-rekvirent"))'>
                <span class="sr-filter-ikon"><Icon Name="alert" /></span>Uten rekvirent<span class="sr-filter-tall">@_alle.Count(s => EffektivStatus(s) == "uten-rekvirent")</span>
            </button>
            <button type="button" class="sr-filter-rad @(_statusFilter == "inaktiv" ? "aktiv" : "")" @onclick='@(() => SettStatusFilter("inaktiv"))'>
                <span class="sr-filter-ikon"><Icon Name="users" /></span>Inaktive<span class="sr-filter-tall">@_alle.Count(s => EffektivStatus(s) == "inaktiv")</span>
            </button>
        </nav>

        @if (TypeGrupper.Count > 0)
        {
            <div class="sr-sidebar-seksjon">
                <h3>Type</h3>
                @foreach (var g in TypeGrupper)
                {
                    <button type="button" class="sr-sidebar-rad @(_typeFilter == g.Navn ? "aktiv" : "")" @onclick="@(() => SettTypeFilter(g.Navn))">
                        <span class="sr-sidebar-navn">@g.Navn</span>
                        <span class="sr-sidebar-tall">@g.Antall</span>
                    </button>
                }
            </div>
        }

        @if (KundeGrupper.Count > 0)
        {
            <div class="sr-sidebar-seksjon">
                <h3>Kunder</h3>
                @foreach (var g in (_visAlleKunder ? KundeGrupper : KundeGrupper.Take(4)))
                {
                    <button type="button" class="sr-sidebar-rad @(_kundeFilter == g.Navn ? "aktiv" : "")" @onclick="@(() => SettKundeFilter(g.Navn))">
                        <span class="sr-sidebar-navn">@g.Navn</span>
                        <span class="sr-sidebar-tall">@g.Antall</span>
                    </button>
                }
                @if (KundeGrupper.Count > 4)
                {
                    <button type="button" class="sr-vis-alle" @onclick="@(() => _visAlleKunder = !_visAlleKunder)">
                        @(_visAlleKunder ? "Vis færre kunder" : "Vis alle kunder")<Icon Name="chevron-down" />
                    </button>
                }
            </div>
        }
    </aside>

    <div class="sr-hoved">
        <div class="sr-toolbar">
            <label class="sok-felt system-sok">
                <Icon Name="search" />
                <input @bind="_search" @bind:event="oninput" placeholder="Søk på system..." />
            </label>
            <div class="sr-toolbar-hoyre">
                <button type="button" class="@(ErFilterAktivt ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFlereFiltre = !_visFlereFiltre)">
                    <Icon Name="filter" />Flere filtre@(ErFilterAktivt ? " (aktiv)" : "")
                </button>
                <a class="new-button" href="systemregister/ny"><Icon Name="plus" />Nytt system</a>
            </div>
        </div>

        @if (_visFlereFiltre)
        {
            <div class="sr-filterpanel">
                <label>
                    Sorter
                    <select @bind="_sortering">
                        <option value="nummer">Systemnummer</option>
                        <option value="kunde">Kunde A-Å</option>
                        <option value="flest">Flest rekvirenter</option>
                        <option value="nyeste">Nyeste først</option>
                    </select>
                </label>
                @if (ErFilterAktivt)
                {
                    <button type="button" class="cancel-button" @onclick="NullstillFilter">Nullstill filter</button>
                }
            </div>
        }

        <p class="result-count">@_filtrert.Count av @_alle.Count systemer</p>

        @if (_filtrert.Count == 0)
        {
            <p class="list-empty">Ingen systemer funnet.</p>
        }
        else
        {
            <div class="sr-liste">
                @foreach (var s in _filtrert)
                {
                    <button type="button" class="sr-rad @(_valgtId == s.Id ? "aktiv" : "")" @onclick="@(() => _valgtId = s.Id)">
                        <div class="sr-rad-venstre">
                            <span class="sr-rad-nummer">@s.Systemnummer</span>
                            <span class="sr-rad-kunde">@(s.Kundenavn ?? "Ingen kunde satt")</span>
                            @if (!string.IsNullOrWhiteSpace(s.Adresse))
                            {
                                <span class="sr-rad-adresse">@s.Adresse@(string.IsNullOrWhiteSpace(s.Sted) ? "" : $", {s.Sted}")</span>
                            }
                        </div>
                        <div class="sr-rad-hoyre">
                            <span class="sr-status-pille sr-status-@EffektivStatus(s)">@EffektivStatusTekst(s)</span>
                            <span class="sr-rad-rekv"><Icon Name="users" />@s.AntallRekvirenter</span>
                        </div>
                    </button>
                }
            </div>
        }
    </div>

    @if (_valgt is not null)
    {
        <aside class="sr-detalj">
            <button type="button" class="sr-detalj-lukk" @onclick="@(() => _valgtId = null)"><Icon Name="x" /></button>

            <div class="sr-detalj-bilde">
                @if (_valgt.HarBilde)
                {
                    <img src="@($"/nokkelsystem/{_valgt.Id}/bilde")" alt="Bygningsbilde" />
                }
                else
                {
                    <div class="sr-detalj-bilde-tom"><Icon Name="image" /></div>
                }
                <span class="sr-status-pille sr-detalj-status sr-status-@EffektivStatus(_valgt)">@EffektivStatusTekst(_valgt)</span>
            </div>

            <div class="sr-detalj-id">
                <span class="sr-detalj-nummer">@_valgt.Systemnummer</span>
                <span class="sr-detalj-kunde">@(_valgt.Kundenavn ?? "Ingen kunde satt")</span>
                @if (!string.IsNullOrWhiteSpace(_valgt.Adresse))
                {
                    <span class="sr-detalj-adresse">@_valgt.Adresse@(string.IsNullOrWhiteSpace(_valgt.Sted) ? "" : $", {_valgt.Sted}")</span>
                }
            </div>

            <div class="sr-detalj-tabs">
                <span class="sr-detalj-tab aktiv">Oversikt</span>
            </div>

            <ul class="sr-detalj-miniliste">
                <li><a href="@($"/systemregister/{_valgt.Id}")">Rekvirenter<span>@_valgt.AntallRekvirenter</span></a></li>
                <li><a href="@($"/systemregister/{_valgt.Id}")">Nøkler<span>@_valgt.AntallNokler</span></a></li>
                <li><a href="@($"/systemregister/{_valgt.Id}")">Kvitteringsliste<span>@_valgt.AntallKvitteringer</span></a></li>
                <li><a href="@($"/systemregister/{_valgt.Id}")">Vedlegg<span>@_valgt.AntallVedlegg</span></a></li>
            </ul>

            <h3 class="sr-detalj-infotittel">Systeminformasjon</h3>
            <dl class="sr-detalj-infoliste">
                <div><dt>Type</dt><dd>@(_valgt.Type ?? "-")</dd></div>
                <div><dt>Fabrikat</dt><dd>@(_valgt.Fabrikat ?? "-")</dd></div>
                <div><dt>Kunde</dt><dd>@(_valgt.Kundenavn ?? "-")</dd></div>
                <div><dt>Kontakt</dt><dd>@(_valgt.Kontaktperson ?? "-")</dd></div>
                <div><dt>Telefon</dt><dd>@(_valgt.Telefon ?? "-")</dd></div>
                <div><dt>E-post</dt><dd>@(_valgt.Epost ?? "-")</dd></div>
            </dl>

            <a class="sr-rediger-knapp" href="@($"/systemregister/{_valgt.Id}")">Rediger system</a>
        </aside>
    }
</div>

</div>

@code {
    private sealed class SystemRad
    {
        public int Id { get; set; }
        public string Systemnummer { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Postnr { get; set; }
        public string? Sted { get; set; }
        public string? Fabrikat { get; set; }
        public string? Type { get; set; }
        public string? Kontaktperson { get; set; }
        public string? Telefon { get; set; }
        public string? Epost { get; set; }
        public NokkelsystemStatus Status { get; set; }
        public bool HarBilde { get; set; }
        public int AntallRekvirenter { get; set; }
        public int AntallKvitteringer { get; set; }
        public int AntallNokler { get; set; }
        public int AntallVedlegg { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record Gruppe(string Navn, int Antall);

    private List<SystemRad> _alle = [];
    private string _search = "";
    private string _statusFilter = "";
    private string _typeFilter = "";
    private string _kundeFilter = "";
    private string _sortering = "nummer";
    private bool _visFlereFiltre;
    private bool _visAlleKunder;
    private int? _valgtId;

    private bool ErFilterAktivt => !string.IsNullOrEmpty(_typeFilter) || !string.IsNullOrEmpty(_kundeFilter) || _sortering != "nummer";

    private SystemRad? _valgt => _alle.FirstOrDefault(s => s.Id == _valgtId);

    private List<Gruppe> TypeGrupper =>
        _alle.Where(s => !string.IsNullOrWhiteSpace(s.Type))
            .GroupBy(s => s.Type!.Trim())
            .Select(g => new Gruppe(g.Key, g.Count()))
            .OrderByDescending(g => g.Antall)
            .ThenBy(g => g.Navn, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<Gruppe> KundeGrupper =>
        _alle.Where(s => !string.IsNullOrWhiteSpace(s.Kundenavn))
            .GroupBy(s => s.Kundenavn!.Trim())
            .Select(g => new Gruppe(g.Key, g.Count()))
            .OrderByDescending(g => g.Antall)
            .ThenBy(g => g.Navn, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<SystemRad> _filtrert
    {
        get
        {
            IEnumerable<SystemRad> rader = _alle
                .Where(s => _statusFilter == "" || EffektivStatus(s) == _statusFilter)
                .Where(s => string.IsNullOrEmpty(_typeFilter) || string.Equals(s.Type?.Trim(), _typeFilter, StringComparison.OrdinalIgnoreCase))
                .Where(s => string.IsNullOrEmpty(_kundeFilter) || string.Equals(s.Kundenavn?.Trim(), _kundeFilter, StringComparison.OrdinalIgnoreCase))
                .Where(s => string.IsNullOrWhiteSpace(_search)
                    || s.Systemnummer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (s.Kundenavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            rader = _sortering switch
            {
                "kunde" => rader.OrderBy(s => s.Kundenavn, StringComparer.OrdinalIgnoreCase),
                "flest" => rader.OrderByDescending(s => s.AntallRekvirenter),
                "nyeste" => rader.OrderByDescending(s => s.OpprettetDato),
                _ => rader.OrderBy(s => s.Systemnummer, StringComparer.OrdinalIgnoreCase)
            };

            return rader.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _alle = await Db.Nokkelsystemer
            .Include(s => s.Rekvirenter)
            .Include(s => s.Kvitteringer)
            .Include(s => s.Vedlegg)
            .OrderBy(s => s.Systemnummer)
            .Select(s => new SystemRad
            {
                Id = s.Id,
                Systemnummer = s.Systemnummer,
                Kundenavn = s.Kundenavn,
                Adresse = s.Adresse,
                Postnr = s.Postnr,
                Sted = s.Sted,
                Fabrikat = s.Fabrikat,
                Type = s.Type,
                Kontaktperson = s.Kontaktperson,
                Telefon = s.Telefon,
                Epost = s.Epost,
                Status = s.Status,
                HarBilde = s.BildeData != null,
                AntallRekvirenter = s.Rekvirenter.Count,
                AntallKvitteringer = s.Kvitteringer.Count,
                AntallNokler = s.Kvitteringer.Sum(k => k.Antall),
                AntallVedlegg = s.Vedlegg.Count,
                OpprettetDato = s.OpprettetDato
            })
            .ToListAsync();

        _valgtId = _alle.Count > 0 ? _alle[0].Id : null;
    }

    private void SettStatusFilter(string filter)
    {
        _statusFilter = _statusFilter == filter ? "" : filter;
    }

    private void SettTypeFilter(string type)
    {
        _typeFilter = _typeFilter == type ? "" : type;
    }

    private void SettKundeFilter(string kunde)
    {
        _kundeFilter = _kundeFilter == kunde ? "" : kunde;
    }

    private void NullstillFilter()
    {
        _typeFilter = "";
        _kundeFilter = "";
        _sortering = "nummer";
    }

    private static string EffektivStatus(SystemRad s)
    {
        if (s.Status == NokkelsystemStatus.Inaktiv)
        {
            return "inaktiv";
        }

        return s.AntallRekvirenter == 0 ? "uten-rekvirent" : "aktiv";
    }

    private static string EffektivStatusTekst(SystemRad s) => EffektivStatus(s) switch
    {
        "uten-rekvirent" => "Uten rekvirent",
        "inaktiv" => "Inaktiv",
        _ => "Aktiv"
    };
}
