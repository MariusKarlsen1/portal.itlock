@page "/systemregister"
@rendermode InteractiveServer
@* Montører har lesetilgang til hele Teknisk og ADK, inkludert systemregisteret
   - men kan ikke endre noe her (se ModulRettigheter). *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Systemregister</PageTitle>

@* S3: samme oppsett og stil som Prosjekter - verktøylinje, Kanban (én kolonne per
   type) og liste i ett kort. Et klikk på et system åpner systemsiden. *@
<div class="sys-side @(_full ? "sys-full" : "")">

<div class="side-tittel prosjekt-header">
    <div class="prosjekt-header-tittel">
        <span class="prosjekt-header-ikon"><Icon Name="lock" /></span>
        <h1>Systemregister</h1>
    </div>
    <p class="prosjekt-intro">Oversikt over alle låssystemer: hvem systemet tilhører, adresse og hvem som kan rekvirere nøkler.</p>
</div>

<div class="pr-ramme">
<div class="prosjekt-toolbar">
    <label class="sok-felt prosjekt-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på system, kunde eller adresse" />
    </label>

    <div class="prosjekt-toolbar-knapper">
        <div class="prosjekt-viewtoggle">
            <button type="button" class="@(_visning == "kanban" ? "aktiv" : "")" @onclick="@(() => VelgVisning("kanban"))"><Icon Name="box" />Kanban</button>
            <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick="@(() => VelgVisning("liste"))"><Icon Name="file-text" />Liste</button>
        </div>
        <a class="new-button" href="systemregister/ny"><Icon Name="plus" />Nytt system</a>
        <button type="button" class="@(_visInaktive ? "edit-button-active" : "filter-button")" @onclick="@(() => _visInaktive = !_visInaktive)">
            <Icon Name="check-circle" />Inaktive systemer
        </button>
        <select class="sorter-velger" value="@_sortering" @onchange="@(e => _sortering = (string)e.Value!)">
            <option value="nummer">Sorter: Systemnummer</option>
            <option value="kunde">Sorter: Kunde A-Å</option>
            <option value="flest">Sorter: Flest rekvirenter</option>
            <option value="nyeste">Sorter: Nyeste først</option>
        </select>
        <div class="prosjekt-filterpopup-anker">
            <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
                <Icon Name="filter" />Filtrer@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
            </button>
            @if (_visFilter)
            {
                <div class="prosjekt-filterpopup">
                    <div class="prosjekt-filterpopup-header">
                        <strong>Filtrer systemer</strong>
                        <button type="button" class="prosjekt-filterpopup-lukk" @onclick="@(() => _visFilter = false)" title="Lukk"><Icon Name="x" /></button>
                    </div>

                    <label class="prosjekt-filterpopup-select-rad">
                        Kunde
                        <select @bind="_kundeFilter">
                            <option value="">Alle</option>
                            @foreach (var g in KundeGrupper)
                            {
                                <option value="@g.Navn">@g.Navn (@g.Antall)</option>
                            }
                        </select>
                    </label>
                    <label class="prosjekt-filterpopup-select-rad">
                        Type
                        <select @bind="_typeFilter">
                            <option value="">Alle</option>
                            @foreach (var g in TypeGrupper)
                            {
                                <option value="@g.Navn">@g.Navn (@g.Antall)</option>
                            }
                        </select>
                    </label>

                    <div class="prosjekt-filterpopup-bunn">
                        <button type="button" class="prosjekt-filterpopup-nullstill" @onclick="NullstillFilter">Nullstill</button>
                        <button type="button" class="prosjekt-filterpopup-vis" @onclick="@(() => _visFilter = false)">Vis resultater (@_filtrert.Count)</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="pr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
    </div>
</div>

<p class="result-count">@_filtrert.Count av @AntallIVisning @(_visInaktive ? "inaktive systemer" : "systemer")</p>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">@(_visInaktive ? "Ingen inaktive systemer." : "Ingen systemer funnet.")</p>
}
else if (_visning == "kanban")
{
    <div class="prosjekt-kanban">
        @foreach (var (type, indeks) in KanbanTyper.Select((t, i) => (t, i)))
        {
            var kolonne = _filtrert.Where(s => TypeNavn(s) == type).ToList();
            var farge = KolonneFarger[indeks % KolonneFarger.Length];

            <div class="kanban-kolonne kanban-kolonne-@farge">
                <div class="kanban-kolonne-header">
                    <span class="kanban-kolonne-dott kanban-kolonne-dott-@farge"></span>
                    <span class="kanban-kolonne-navn">@type</span>
                    <span class="kanban-kolonne-teller">@kolonne.Count</span>
                </div>

                @foreach (var s in kolonne)
                {
                    <div class="prosjekt-kort-wrap">
                        <a class="kanban-kort" href="@($"systemregister/{s.Id}")">
                            <span class="kanban-kort-navn">@s.Systemnummer@(string.IsNullOrWhiteSpace(s.Fabrikat) ? "" : $" · {s.Fabrikat}")</span>
                            <div class="prosjekt-kort-linje">
                                <Icon Name="users" />
                                <span>@(string.IsNullOrWhiteSpace(s.Kundenavn) ? "Ingen kunde satt" : s.Kundenavn)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Adresse))
                            {
                                <div class="prosjekt-kort-linje">
                                    <Icon Name="map" />
                                    <span>@AdresseTekst(s)</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.Kontaktperson))
                            {
                                <span class="team-person">
                                    <span class="team-avatar" style="background:@PersonFarge(s.Kontaktperson)">@Initialer(s.Kontaktperson)</span>
                                    @s.Kontaktperson
                                </span>
                            }
                            <div class="kanban-kort-bunn">
                                <span class="prosjekt-fremdrift-tekst">@s.AntallRekvirenter rekvirent@(s.AntallRekvirenter == 1 ? "" : "er")</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="prosjekt-tablewrap">
        <table class="prosjekt-table">
            <thead>
                <tr class="prosjekt-thr">
                    <th>System</th>
                    <th>Kunde</th>
                    <th>Adresse</th>
                    <th>Type / fabrikat</th>
                    <th>Kontaktperson</th>
                    <th>Rekvirenter</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _filtrert)
                {
                    <tr @key="s.Id" class="prosjekt-tr" @onclick="@(() => Nav.NavigateTo($"systemregister/{s.Id}"))">
                        <td class="prosjekt-td-navn">@s.Systemnummer</td>
                        <td>@if (string.IsNullOrWhiteSpace(s.Kundenavn)) { <span class="pr-tom">—</span> } else { @s.Kundenavn }</td>
                        <td>@if (string.IsNullOrWhiteSpace(s.Adresse)) { <span class="pr-tom">—</span> } else { @AdresseTekst(s) }</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(s.Type) && string.IsNullOrWhiteSpace(s.Fabrikat))
                            {
                                <span class="pr-tom">—</span>
                            }
                            else
                            {
                                <div class="sys-type">
                                    @if (!string.IsNullOrWhiteSpace(s.Type))
                                    {
                                        <StatusPill Tekst="@s.Type" Ikon="lock" Farge="@TypeFarge(s.Type)" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(s.Fabrikat))
                                    {
                                        <span class="sys-fabrikat">@s.Fabrikat</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(s.Kontaktperson))
                            {
                                <span class="pr-tom">—</span>
                            }
                            else
                            {
                                <span class="pr-person"><u>@Initialer(s.Kontaktperson)</u>@s.Kontaktperson</span>
                            }
                        </td>
                        <td>@s.AntallRekvirenter</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

</div>

@code {
    private sealed class SystemRad
    {
        public int Id { get; set; }
        public string Systemnummer { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public string? Fabrikat { get; set; }
        public string? Type { get; set; }
        public string? Kontaktperson { get; set; }
        public NokkelsystemStatus Status { get; set; }
        public int AntallRekvirenter { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private sealed record Gruppe(string Navn, int Antall);

    private const string UtenType = "Uten type";

    // Kolonnefargene fra Prosjekter-kanban, brukt i rekkefølge per type.
    private static readonly string[] KolonneFarger = ["blaa", "lilla", "turkis", "gul", "gronn", "noytral"];

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<SystemRad> _alle = [];
    private string _search = "";
    private string _typeFilter = "";
    private string _kundeFilter = "";
    private string _sortering = "nummer";
    private string _visning = "liste";
    private bool _visFilter;
    private bool _visInaktive;

    private int AntallAktiveFiltre => (string.IsNullOrEmpty(_typeFilter) ? 0 : 1) + (string.IsNullOrEmpty(_kundeFilter) ? 0 : 1);

    private int AntallIVisning => _alle.Count(s => (s.Status == NokkelsystemStatus.Inaktiv) == _visInaktive);

    private List<Gruppe> TypeGrupper =>
        _alle.Where(s => !string.IsNullOrWhiteSpace(s.Type))
            .GroupBy(s => s.Type!.Trim())
            .Select(g => new Gruppe(g.Key, g.Count()))
            .OrderByDescending(g => g.Antall)
            .ThenBy(g => g.Navn, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<Gruppe> KundeGrupper =>
        _alle.Where(s => !string.IsNullOrWhiteSpace(s.Kundenavn))
            .GroupBy(s => s.Kundenavn!.Trim())
            .Select(g => new Gruppe(g.Key, g.Count()))
            .OrderBy(g => g.Navn, StringComparer.OrdinalIgnoreCase)
            .ToList();

    // Én kanban-kolonne per type som finnes i registeret, og «Uten type» til slutt ved behov.
    private List<string> KanbanTyper
    {
        get
        {
            var typer = TypeGrupper.Select(g => g.Navn).ToList();
            if (_alle.Any(s => string.IsNullOrWhiteSpace(s.Type)))
            {
                typer.Add(UtenType);
            }
            return typer;
        }
    }

    private List<SystemRad> _filtrert
    {
        get
        {
            IEnumerable<SystemRad> rader = _alle
                .Where(s => (s.Status == NokkelsystemStatus.Inaktiv) == _visInaktive)
                .Where(s => string.IsNullOrEmpty(_typeFilter) || string.Equals(s.Type?.Trim(), _typeFilter, StringComparison.OrdinalIgnoreCase))
                .Where(s => string.IsNullOrEmpty(_kundeFilter) || string.Equals(s.Kundenavn?.Trim(), _kundeFilter, StringComparison.OrdinalIgnoreCase))
                .Where(s => string.IsNullOrWhiteSpace(_search)
                    || s.Systemnummer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (s.Kundenavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            rader = _sortering switch
            {
                "kunde" => rader.OrderBy(s => s.Kundenavn, StringComparer.OrdinalIgnoreCase),
                "flest" => rader.OrderByDescending(s => s.AntallRekvirenter),
                "nyeste" => rader.OrderByDescending(s => s.OpprettetDato),
                _ => rader.OrderBy(s => s.Systemnummer, StringComparer.OrdinalIgnoreCase)
            };

            return rader.ToList();
        }
    }

    private static string TypeNavn(SystemRad s) => string.IsNullOrWhiteSpace(s.Type) ? UtenType : s.Type.Trim();

    private static string AdresseTekst(SystemRad s) =>
        string.IsNullOrWhiteSpace(s.Sted) ? s.Adresse! : $"{s.Adresse}, {s.Sted}";

    private static string TypeFarge(string type) => type.Trim().ToLowerInvariant() switch
    {
        "sylinder" => "blaa",
        "elektronisk" => "lilla",
        _ => "noytral"
    };

    private static string PersonFarge(string navn) => PersonPaletten[navn.Sum(c => (int)c) % PersonPaletten.Length];

    private static string Initialer(string navn) =>
        string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    private bool _full;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("systemregister-bredde", _full ? "full" : "normal");
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("systemregister", visning);
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("systemregister-bredde", "normal") == "full";
        _visning = await VisningPref.HentAsync("systemregister", "liste");
        if (_visning is not ("kanban" or "liste"))
        {
            _visning = "liste";
        }

        _alle = await Db.Nokkelsystemer
            .OrderBy(s => s.Systemnummer)
            .Select(s => new SystemRad
            {
                Id = s.Id,
                Systemnummer = s.Systemnummer,
                Kundenavn = s.Kundenavn,
                Adresse = s.Adresse,
                Sted = s.Sted,
                Fabrikat = s.Fabrikat,
                Type = s.Type,
                Kontaktperson = s.Kontaktperson,
                Status = s.Status,
                AntallRekvirenter = s.Rekvirenter.Count,
                OpprettetDato = s.OpprettetDato
            })
            .ToListAsync();
    }

    private void NullstillFilter()
    {
        _typeFilter = "";
        _kundeFilter = "";
    }
}
