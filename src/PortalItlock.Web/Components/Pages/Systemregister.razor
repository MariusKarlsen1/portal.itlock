@page "/systemregister"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Systemregister</PageTitle>

<div class="system-header">
    <div class="system-header-tittel">
        <span class="system-header-ikon"><Icon Name="lock" /></span>
        <h1>Systemregister</h1>
    </div>
    <p>Oversikt over alle låssystemer: hvem systemet tilhører, adresse og hvem som kan rekvirere nøkler.</p>
</div>

@if (_alle.Count > 0)
{
    <div class="nokkeltall">
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Totalt systemer</span>
            <span class="nokkel-verdi">@_alle.Count</span>
            <span class="nokkel-under">aktive låssystemer</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Rekvirenter totalt</span>
            <span class="nokkel-verdi">@_alle.Sum(s => s.AntallRekvirenter)</span>
            <span class="nokkel-under">kan bestille nøkler</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Uten rekvirenter</span>
            <span class="nokkel-verdi gul">@_alle.Count(s => s.AntallRekvirenter == 0)</span>
            <span class="nokkel-under">mangler kontaktpunkt</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Nye siste 30 dager</span>
            <span class="nokkel-verdi gronn">@_alle.Count(s => ErNytt(s))</span>
            <span class="nokkel-under">nylig registrert</span>
        </div>
    </div>

    <div class="system-hurtigfilter">
        <button type="button" class="flis @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
            <span class="flis-tall">@_alle.Count</span>
            <span class="flis-etikett">Alle</span>
        </button>
        <button type="button" class="flis flis-gul @(_hurtigfilter == "utenrekv" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("utenrekv"))'>
            <span class="flis-tall flis-gul">@_alle.Count(s => s.AntallRekvirenter == 0)</span>
            <span class="flis-etikett">Uten rekvirenter</span>
        </button>
        <button type="button" class="flis @(_hurtigfilter == "utenadresse" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("utenadresse"))'>
            <span class="flis-tall">@_alle.Count(s => string.IsNullOrWhiteSpace(s.Adresse))</span>
            <span class="flis-etikett">Mangler adresse</span>
        </button>
        <button type="button" class="flis flis-gronn @(_hurtigfilter == "nye" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("nye"))'>
            <span class="flis-tall flis-gronn">@_alle.Count(s => ErNytt(s))</span>
            <span class="flis-etikett">Nye siste 30 dager</span>
        </button>
    </div>
}

<div class="system-toolbar">
    <label class="sok-felt system-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på systemnummer, kunde, adresse eller kontaktperson" />
    </label>
    <div class="system-toolbar-hoyre">
        <select class="sorter-velger" @bind="_sortering">
            <option value="nummer">Systemnummer</option>
            <option value="kunde">Kunde A-Å</option>
            <option value="flest">Flest rekvirenter</option>
            <option value="nyeste">Nyeste først</option>
        </select>
        <a class="new-button" href="systemregister/ny"><Icon Name="plus" />Nytt system</a>
    </div>
</div>

<p class="result-count">@_filtrert.Count av @_alle.Count systemer</p>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen systemer funnet.</p>
}
else
{
    <div class="system-grid">
        @foreach (var s in _filtrert)
        {
            <a class="system-kort @(s.AntallRekvirenter == 0 ? "system-kort-varsel" : "")" href="@($"systemregister/{s.Id}")">
                <div class="system-kort-topp">
                    <div class="system-kort-nr">
                        <span class="system-kort-ikon"><Icon Name="lock" /></span>
                        <span class="system-nummer">@s.Systemnummer</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s.Fabrikat))
                    {
                        <span class="fabrikat-tag">@s.Fabrikat</span>
                    }
                </div>
                <div class="system-kunde-rad">
                    @if (string.IsNullOrWhiteSpace(s.Kundenavn))
                    {
                        <span class="system-avatar" style="background:var(--itlock-ink-muted)">–</span>
                        <span class="system-kunde-navn system-kunde-tom">Ingen kunde satt</span>
                    }
                    else
                    {
                        <span class="system-avatar" style="background:@PersonFarge(s.Kundenavn)">@PersonInitialer(s.Kundenavn)</span>
                        <span class="system-kunde-navn">@s.Kundenavn</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(s.Adresse))
                {
                    <div class="system-kort-linje">
                        <Icon Name="map" />
                        <span>@s.Adresse</span>
                    </div>
                }
                <div class="system-kort-bunn">
                    <span class="system-rekvirent-badge @(s.AntallRekvirenter == 0 ? "system-rekvirent-badge-tom" : "")">
                        <Icon Name="users" />@s.AntallRekvirenter rekvirent@(s.AntallRekvirenter == 1 ? "" : "er")
                    </span>
                    <span class="system-alder">@OpprettetTekst(s.OpprettetDato)</span>
                </div>
            </a>
        }
    </div>
}

@code {
    private sealed class SystemRad
    {
        public int Id { get; set; }
        public string Systemnummer { get; set; } = "";
        public string? Kundenavn { get; set; }
        public string? Adresse { get; set; }
        public string? Fabrikat { get; set; }
        public int AntallRekvirenter { get; set; }
        public DateTime OpprettetDato { get; set; }
    }

    private List<SystemRad> _alle = [];
    private string _search = "";
    private string _hurtigfilter = "alle";
    private string _sortering = "nummer";

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<SystemRad> _filtrert
    {
        get
        {
            IEnumerable<SystemRad> rader = _alle
                .Where(s => _hurtigfilter switch
                {
                    "utenrekv" => s.AntallRekvirenter == 0,
                    "utenadresse" => string.IsNullOrWhiteSpace(s.Adresse),
                    "nye" => ErNytt(s),
                    _ => true
                })
                .Where(s => string.IsNullOrWhiteSpace(_search)
                    || s.Systemnummer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (s.Kundenavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (s.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            rader = _sortering switch
            {
                "kunde" => rader.OrderBy(s => s.Kundenavn, StringComparer.OrdinalIgnoreCase),
                "flest" => rader.OrderByDescending(s => s.AntallRekvirenter),
                "nyeste" => rader.OrderByDescending(s => s.OpprettetDato),
                _ => rader.OrderBy(s => s.Systemnummer, StringComparer.OrdinalIgnoreCase)
            };

            return rader.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _alle = await Db.Nokkelsystemer
            .Include(s => s.Rekvirenter)
            .OrderBy(s => s.Systemnummer)
            .Select(s => new SystemRad
            {
                Id = s.Id,
                Systemnummer = s.Systemnummer,
                Kundenavn = s.Kundenavn,
                Adresse = s.Adresse,
                Fabrikat = s.Fabrikat,
                AntallRekvirenter = s.Rekvirenter.Count,
                OpprettetDato = s.OpprettetDato
            })
            .ToListAsync();
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    private static bool ErNytt(SystemRad s) => s.OpprettetDato >= DateTime.UtcNow.AddDays(-30);

    private static string OpprettetTekst(DateTime dato)
    {
        var dager = (int)(DateTime.UtcNow.Date - dato.Date).TotalDays;
        return dager switch
        {
            <= 0 => "Opprettet i dag",
            1 => "Opprettet i går",
            _ => $"for {dager} dager siden"
        };
    }

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }
}
