@page "/guide/kobling"
@using PortalItlock.Web.Models

<PageTitle>Kobling</PageTitle>

<a class="back-link" href="/">&larr; Tilbake</a>
<h1>Kobling</h1>
<p class="section-hint">Velg system for å se eller lage koblingsskjema.</p>

<div class="kobling-kategori-grid">
    @foreach (var kategori in Enum.GetValues<KoblingsKategori>())
    {
        <a class="kobling-kategori-card" href="@($"/guide/kobling/{kategori}")">
            <span class="kobling-kategori-navn">@kategori.Visningsnavn()</span>
        </a>
    }
</div>
