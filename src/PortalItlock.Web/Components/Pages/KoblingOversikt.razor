@page "/guide/kobling"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kobling</PageTitle>

<a class="back-link" href="/"><Icon Name="arrow-left" />Til hjem</a>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="link-ikon" /></span>
        <div>
            <h1>Kobling</h1>
            <p class="section-hint">Velg system for å se eller lage koblingsskjema.</p>
        </div>
    </div>
    <AuthorizeView Roles="Admin">
        <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "knapp-ghost")" @onclick="ToggleRedigerModus">
            <Icon Name="edit" />
            @(_redigerModus ? "Ferdig" : "Rediger")
        </button>
    </AuthorizeView>
</div>

<div class="kobling-kategori-grid">
    @foreach (var kategori in _kategorier)
    {
        <div @key="kategori.Id" class="kobling-kategori-wrap">
            @if (_redigerModus && _redigerId == kategori.Id)
            {
                <div class="kobling-kategori-rediger">
                    <div class="kobling-kategori-rediger-farger">
                        @foreach (var farge in FargeValg)
                        {
                            <button type="button" class="kobling-farge-prikk kobling-farge-prikk-@farge @(_redigerFarge == farge ? "valgt" : "")" @onclick="@(() => _redigerFarge = farge)" title="@farge"></button>
                        }
                    </div>
                    <select class="kobling-kategori-rediger-ikon" value="@_redigerIkon" @onchange="@(e => _redigerIkon = (string)e.Value!)">
                        @foreach (var ikon in IkonValg)
                        {
                            <option value="@ikon">@ikon</option>
                        }
                    </select>
                    <input @bind="_redigerNavn" @bind:event="oninput" placeholder="Navn" />
                    <input @bind="_redigerBeskrivelse" @bind:event="oninput" placeholder="Beskrivelse" />
                    <div class="kobling-kategori-rediger-knapper">
                        <button type="button" class="knapp knapp-primaer" @onclick="LagreRediger" disabled="@string.IsNullOrWhiteSpace(_redigerNavn)">Lagre</button>
                        <button type="button" class="cancel-button" @onclick="@(() => _redigerId = null)">Avbryt</button>
                    </div>
                </div>
            }
            else
            {
                <a class="kobling-kategori-card" href="@($"/guide/kobling/{kategori.Id}")">
                    <span class="kobling-kategori-ikon kobling-kategori-ikon-@kategori.Farge"><Icon Name="@kategori.Ikon" /></span>
                    <span class="kobling-kategori-tekst">
                        <span class="kobling-kategori-navn">@kategori.Navn</span>
                        @if (!string.IsNullOrWhiteSpace(kategori.Beskrivelse))
                        {
                            <span class="kobling-kategori-beskrivelse">@kategori.Beskrivelse</span>
                        }
                    </span>
                    <span class="kobling-kategori-pil"><Icon Name="chevron-right" /></span>
                </a>
                @if (_redigerModus)
                {
                    @if (_slettId == kategori.Id)
                    {
                        <div class="kobling-kategori-slett-confirm">
                            <p>Slette "@kategori.Navn" og alle koblingsskjema under den?</p>
                            <div class="kobling-kategori-slett-confirm-rad">
                                <button type="button" class="delete-confirm-button" @onclick="@(() => SlettKategori(kategori.Id))">Ja, slett</button>
                                <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="kobling-kategori-endre-button" title="Rediger" @onclick="@(() => StartRediger(kategori))"><Icon Name="edit" /></button>
                        <button type="button" class="kobling-kategori-slett-button" title="Slett" @onclick="@(() => _slettId = kategori.Id)"><Icon Name="x" /></button>
                    }
                }
            }
        </div>
    }

    @if (_redigerModus)
    {
        <div class="kobling-kategori-ny">
            <input @bind="_nyttNavn" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettKategori(); } })"
                   placeholder="Navn på nytt system" />
            <button type="button" class="knapp knapp-primaer" @onclick="OpprettKategori" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)"><Icon Name="plus" />Opprett ny</button>
        </div>
    }
</div>

@code {
    private static readonly string[] FargeValg = ["oransje", "gronn", "gul", "rosa"];
    private static readonly string[] IkonValg = ["lock", "door", "settings", "file-text", "shield", "box", "tool", "folder"];

    private List<KoblingsKategori> _kategorier = [];
    private bool _redigerModus;
    private int? _slettId;
    private string _nyttNavn = "";

    private int? _redigerId;
    private string _redigerNavn = "";
    private string _redigerBeskrivelse = "";
    private string _redigerIkon = "lock";
    private string _redigerFarge = "oransje";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _kategorier = await Db.KoblingsKategorier
            .OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn)
            .ToListAsync();
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
        _redigerId = null;
        _nyttNavn = "";
    }

    private void StartRediger(KoblingsKategori kategori)
    {
        _redigerId = kategori.Id;
        _redigerNavn = kategori.Navn;
        _redigerBeskrivelse = kategori.Beskrivelse ?? "";
        _redigerIkon = kategori.Ikon;
        _redigerFarge = kategori.Farge;
    }

    private async Task LagreRediger()
    {
        var navn = _redigerNavn.Trim();
        if (_redigerId is null || navn.Length == 0)
        {
            return;
        }

        var entitet = await Db.KoblingsKategorier.FirstOrDefaultAsync(k => k.Id == _redigerId);
        if (entitet is not null)
        {
            entitet.Navn = navn;
            entitet.Beskrivelse = string.IsNullOrWhiteSpace(_redigerBeskrivelse) ? null : _redigerBeskrivelse.Trim();
            entitet.Ikon = _redigerIkon;
            entitet.Farge = _redigerFarge;
            await Db.SaveChangesAsync();
        }

        _redigerId = null;
        await LoadAsync();
    }

    private async Task OpprettKategori()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var nesteRekkefolge = _kategorier.Count == 0 ? 1 : _kategorier.Max(k => k.Rekkefolge) + 1;
        Db.KoblingsKategorier.Add(new KoblingsKategori { Navn = navn, Rekkefolge = nesteRekkefolge });
        await Db.SaveChangesAsync();

        _nyttNavn = "";
        await LoadAsync();
    }

    private async Task SlettKategori(int id)
    {
        var entitet = await Db.KoblingsKategorier.FirstOrDefaultAsync(k => k.Id == id);
        if (entitet is not null)
        {
            Db.KoblingsKategorier.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _slettId = null;
        await LoadAsync();
    }
}
