@page "/ce-oppsett"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>CE-oppsett - Full Kontroll</PageTitle>

<h1>CE-oppsett</h1>
<p class="section-hint">
    Sett CE-kategori på beslagstypene. Komponenter av en type kategorisert som "Dørautomatikk" vises som
    maskinen i en CE-godkjenning, "Sikkerhetstilbehør" og "Annet tilbehør" vises i tilbehørslistene.
    Et dokument lastet opp her brukes automatisk som sertifikat/produktark for alle varer av typen som
    ikke har sin egen FDV-fil. De kategoriserte typene vises gruppert øverst - de uten kategori ligger
    samlet nederst.
</p>

@if (!string.IsNullOrEmpty(_feil))
{
    <p class="form-error">@_feil</p>
}

@foreach (var kategori in KategoriserteGrupper)
{
    var rader = TyperFor(kategori);
    if (rader.Count == 0)
    {
        continue;
    }

    <div class="gruppe-kort">
        <div class="gruppe-header">
            <span class="gruppe-tittel">@kategori.Visningsnavn()</span>
            <span class="gruppe-antall">@rader.Count type@(rader.Count == 1 ? "" : "r")</span>
        </div>
        @foreach (var t in rader)
        {
            <div @key="t.Id" class="gruppe-rad">
                <span class="rad-navn">@t.Navn</span>
                <select @bind="t.CeKategori" @bind:after="@(() => LagreKategori(t))">
                    @foreach (var k in Kategorier)
                    {
                        <option value="@k">@k.Visningsnavn()</option>
                    }
                </select>
                <span class="rad-dok">
                    @if (t.HarDokument)
                    {
                        <a href="@($"/komponenttype/{t.Id}/ce-dokument")" target="_blank">@t.DokumentFilnavn</a>
                        <button type="button" class="remove-button" @onclick="@(() => FjernDokument(t))">Fjern</button>
                    }
                    else
                    {
                        <span class="dok-tom">Ingen fil</span>
                        <InputFile OnChange="@(e => LastOppDokument(t, e))" accept=".pdf,application/pdf" />
                    }
                </span>
            </div>
        }
    </div>
}

<div class="gruppe-kort">
    <button type="button" class="uten-kategori-toggle" @onclick="@(() => _visIngen = !_visIngen)">
        <span class="gruppe-tittel gruppe-tittel-muted">Uten kategori (@UtenKategori.Count type@(UtenKategori.Count == 1 ? "" : "r")) &ndash; klikk for å @(_visIngen ? "skjule" : "vise")</span>
        <span class="pil @(_visIngen ? "pil-apen" : "")">&rsaquo;</span>
    </button>
    @if (_visIngen)
    {
        @foreach (var t in UtenKategori)
        {
            <div @key="t.Id" class="gruppe-rad">
                <span class="rad-navn">@t.Navn</span>
                <select @bind="t.CeKategori" @bind:after="@(() => LagreKategori(t))">
                    @foreach (var k in Kategorier)
                    {
                        <option value="@k">@k.Visningsnavn()</option>
                    }
                </select>
                <span class="rad-dok">
                    @if (t.HarDokument)
                    {
                        <a href="@($"/komponenttype/{t.Id}/ce-dokument")" target="_blank">@t.DokumentFilnavn</a>
                        <button type="button" class="remove-button" @onclick="@(() => FjernDokument(t))">Fjern</button>
                    }
                    else
                    {
                        <span class="dok-tom">Ingen fil</span>
                        <InputFile OnChange="@(e => LastOppDokument(t, e))" accept=".pdf,application/pdf" />
                    }
                </span>
            </div>
        }
    }
</div>

@if (_grenseverdier is not null)
{
    <div class="grenseverdi-kort">
        <div class="grenseverdi-header">
            <span class="grenseverdi-ikon"><Icon Name="shield" /></span>
            <div>
                <div class="grenseverdi-tittel">Grenseverdier for målte verdier</div>
                <p class="grenseverdi-hint">Standardverdier iht. NS-EN 16005, brukes til å validere Mål-steget i CE-godkjenningen.</p>
            </div>
        </div>

        <div class="stat-rad">
            <div class="stat-kort">
                <span class="stat-label">Maks åpningstid</span>
                <div class="stat-input-rad">
                    <input class="stat-input" @bind="_grenseverdier.MaksApningstidSek" type="number" step="0.1" />
                    <span class="stat-enhet">sek</span>
                </div>
            </div>
            <div class="stat-kort">
                <span class="stat-label">Maks lukketid 90&ndash;10&deg;</span>
                <div class="stat-input-rad">
                    <input class="stat-input" @bind="_grenseverdier.MaksLukketidHoySek" type="number" step="0.1" />
                    <span class="stat-enhet">sek</span>
                </div>
            </div>
            <div class="stat-kort">
                <span class="stat-label">Maks lukketid 10&ndash;0&deg;</span>
                <div class="stat-input-rad">
                    <input class="stat-input" @bind="_grenseverdier.MaksLukketidLavSek" type="number" step="0.1" />
                    <span class="stat-enhet">sek</span>
                </div>
            </div>
            <div class="stat-kort">
                <span class="stat-label">Maks åpningskraft</span>
                <div class="stat-input-rad">
                    <input class="stat-input" @bind="_grenseverdier.MaksApningskraftN" type="number" step="0.1" />
                    <span class="stat-enhet">N</span>
                </div>
            </div>
        </div>

        <div class="grenseverdi-footer">
            <button type="button" class="save-button" @onclick="LagreGrenseverdier">Lagre grenseverdier</button>
            @if (!string.IsNullOrEmpty(_grenseverdiMelding))
            {
                <span class="save-success">@_grenseverdiMelding</span>
            }
        </div>
    </div>
}

@code {
    private sealed class TypeDraft
    {
        public int Id { get; set; }
        public required string Navn { get; set; }
        public CeTilbehorKategori CeKategori { get; set; }
        public bool HarDokument { get; set; }
        public string? DokumentFilnavn { get; set; }
    }

    private static readonly CeTilbehorKategori[] Kategorier =
    [
        CeTilbehorKategori.Ingen,
        CeTilbehorKategori.DorAutomatikk,
        CeTilbehorKategori.SikkerhetsTilbehor,
        CeTilbehorKategori.AnnetTilbehor
    ];

    private static readonly CeTilbehorKategori[] KategoriserteGrupper =
    [
        CeTilbehorKategori.DorAutomatikk,
        CeTilbehorKategori.SikkerhetsTilbehor,
        CeTilbehorKategori.AnnetTilbehor
    ];

    private List<TypeDraft> _typer = [];
    private CeMaleGrenseverdier? _grenseverdier;
    private string? _feil;
    private string? _grenseverdiMelding;
    private bool _visIngen;

    private List<TypeDraft> TyperFor(CeTilbehorKategori kategori) => _typer.Where(t => t.CeKategori == kategori).ToList();
    private List<TypeDraft> UtenKategori => _typer.Where(t => t.CeKategori == CeTilbehorKategori.Ingen).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _typer = await Db.ComponentTypes
            .OrderBy(t => t.Sortering).ThenBy(t => t.Navn)
            .Select(t => new TypeDraft
            {
                Id = t.Id,
                Navn = t.Navn,
                CeKategori = t.CeKategori,
                HarDokument = t.CeDokumentData != null,
                DokumentFilnavn = t.CeDokumentFilnavn
            })
            .ToListAsync();

        _grenseverdier = await Db.CeMaleGrenseverdier.FirstOrDefaultAsync();
        if (_grenseverdier is null)
        {
            _grenseverdier = new CeMaleGrenseverdier();
            Db.CeMaleGrenseverdier.Add(_grenseverdier);
            await Db.SaveChangesAsync();
        }
    }

    private async Task LagreKategori(TypeDraft draft)
    {
        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == draft.Id);
        entity.CeKategori = draft.CeKategori;
        await Db.SaveChangesAsync();
    }

    private async Task LastOppDokument(TypeDraft draft, InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == draft.Id);
        entity.CeDokumentData = buffer.ToArray();
        entity.CeDokumentFilnavn = file.Name;
        entity.CeDokumentContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();

        draft.HarDokument = true;
        draft.DokumentFilnavn = file.Name;
    }

    private async Task FjernDokument(TypeDraft draft)
    {
        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == draft.Id);
        entity.CeDokumentData = null;
        entity.CeDokumentFilnavn = null;
        entity.CeDokumentContentType = null;
        await Db.SaveChangesAsync();

        draft.HarDokument = false;
        draft.DokumentFilnavn = null;
    }

    private async Task LagreGrenseverdier()
    {
        if (_grenseverdier is null)
        {
            return;
        }

        var entity = await Db.CeMaleGrenseverdier.FirstAsync(g => g.Id == _grenseverdier.Id);
        entity.MaksApningstidSek = _grenseverdier.MaksApningstidSek;
        entity.MaksLukketidHoySek = _grenseverdier.MaksLukketidHoySek;
        entity.MaksLukketidLavSek = _grenseverdier.MaksLukketidLavSek;
        entity.MaksApningskraftN = _grenseverdier.MaksApningskraftN;
        await Db.SaveChangesAsync();

        _grenseverdiMelding = "Grenseverdiene er lagret.";
    }
}
