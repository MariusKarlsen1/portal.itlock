@page "/ce-oppsett"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>CE-oppsett - Full Kontroll</PageTitle>

@* C1 (Prototype CE-oppsett.html): ett kort som kundekortet med grå infolinje og
   CE-kategoriene og grenseverdiene i grå meny til venstre med blå strek. Til høyre
   står typene i en tabell med sertifikat og flytt til kategori, og grenseverdiene
   i én boks. Kategori og sertifikat lagres med en gang, grenseverdiene fra
   lagre-linjen. *@
<div class="sm @(_full ? "sm-full" : "")">
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="sm-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="sm-kort">
        <div class="sm-topp">
            <span class="sm-ikon"><Icon Name="shield" /></span>
            <div class="sm-tittel">
                <div class="sm-smule"><NavLink href="/oppsettmodul">Oppsett</NavLink> / CE-godkjenninger</div>
                <h1>CE-oppsett</h1>
            </div>
            <div class="sm-knapper">
                <button type="button" class="sm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>
        </div>

        <div class="sm-info">
            <span><b>@_typer.Count(t => t.CeKategori != CeTilbehorKategori.Ingen)</b> typer med i CE</span>
            <span><b>@_typer.Count(t => t.CeKategori != CeTilbehorKategori.Ingen && !t.HarDokument)</b> mangler sertifikat</span>
            <span><b>@_typer.Count(t => t.CeKategori == CeTilbehorKategori.Ingen)</b> typer uten kategori</span>
            <span>Grenseverdier iht. NS-EN 16005</span>
        </div>

        <div class="sm-kropp">
            <nav class="sm-meny">
                <span class="ce-gt">CE-kategorier</span>
                @foreach (var k in Kategorier)
                {
                    var kategori = k;
                    <button type="button" class="sm-fane @(_valgt == kategori.ToString() ? "pa" : "")" @onclick="@(() => Velg(kategori.ToString()))">
                        <Icon Name="@Ikon(kategori)" />
                        <span>@Navn(kategori)</span>
                        <em>@_typer.Count(t => t.CeKategori == kategori)</em>
                    </button>
                }
                <span class="ce-gt">Målinger</span>
                <button type="button" class="sm-fane @(_valgt == "grense" ? "pa" : "")" @onclick="@(() => Velg("grense"))">
                    <Icon Name="maximize" />
                    <span>Grenseverdier@(GrenseEndret ? " •" : "")</span>
                </button>
            </nav>

            <div class="sm-innhold">
                @if (_valgt == "grense")
                {
                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>Grenseverdier</h3><small>Standardverdier iht. NS-EN 16005</small></div>
                        @if (_grenseverdier is not null)
                        {
                            <div class="ce-grense">
                                <label class="sm-felt">
                                    <span>Maks åpningstid</span>
                                    <span class="ce-gv"><input type="number" step="0.1" min="0" @bind="_grenseverdier.MaksApningstidSek" @bind:event="oninput" /><i>sek</i></span>
                                </label>
                                <label class="sm-felt">
                                    <span>Maks lukketid 90–10°</span>
                                    <span class="ce-gv"><input type="number" step="0.1" min="0" @bind="_grenseverdier.MaksLukketidHoySek" @bind:event="oninput" /><i>sek</i></span>
                                </label>
                                <label class="sm-felt">
                                    <span>Maks lukketid 10–0°</span>
                                    <span class="ce-gv"><input type="number" step="0.1" min="0" @bind="_grenseverdier.MaksLukketidLavSek" @bind:event="oninput" /><i>sek</i></span>
                                </label>
                                <label class="sm-felt">
                                    <span>Maks åpningskraft</span>
                                    <span class="ce-gv"><input type="number" step="0.1" min="0" @bind="_grenseverdier.MaksApningskraftN" @bind:event="oninput" /><i>N</i></span>
                                </label>
                            </div>
                        }
                    </section>
                    <p class="ce-notat">Brukes til å kontrollere Mål-steget i CE-godkjenningen.</p>
                }
                else
                {
                    var kategori = Enum.Parse<CeTilbehorKategori>(_valgt);
                    var typer = _typer
                        .Where(t => t.CeKategori == kategori)
                        .Where(t => string.IsNullOrWhiteSpace(_search) || t.Navn.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    <section class="sm-boks">
                        <div class="sm-boks-t"><h3>@Navn(kategori)</h3><small>@Beskrivelse(kategori)</small></div>
                        <div class="ce-verktoy">
                            <label class="sm-sok">
                                <Icon Name="search" />
                                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk beslagstype …" />
                            </label>
                            <span>@typer.Count @(typer.Count == 1 ? "type" : "typer")</span>
                        </div>
                        <div class="sm-tabell">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Beslagstype</th>
                                        <th>Sertifikat</th>
                                        <th class="ce-hoyre">Flytt</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in typer)
                                    {
                                        var type = t;
                                        <tr @key="t.Id">
                                            <td><b>@t.Navn</b></td>
                                            <td>
                                                <span class="ce-dok">
                                                    @if (t.HarDokument)
                                                    {
                                                        <a class="ce-fil" href="@($"/komponenttype/{t.Id}/ce-dokument")" target="_blank" title="Åpne sertifikatet"><span class="ce-pdf">PDF</span>@t.DokumentFilnavn</a>
                                                        <label class="ce-lenke" title="Bytt sertifikat">Bytt<InputFile OnChange="@(e => LastOppDokument(type, e))" accept=".pdf,application/pdf" style="display:none;" /></label>
                                                        <button type="button" class="sm-fjern" title="Fjern sertifikatet" @onclick="@(() => FjernDokument(type))"><Icon Name="x" /></button>
                                                    }
                                                    else
                                                    {
                                                        @if (kategori != CeTilbehorKategori.Ingen)
                                                        {
                                                            <span class="ce-mangler">Mangler sertifikat</span>
                                                        }
                                                        <label class="sm-knapp ce-last"><Icon Name="upload" />Last opp PDF<InputFile OnChange="@(e => LastOppDokument(type, e))" accept=".pdf,application/pdf" style="display:none;" /></label>
                                                    }
                                                </span>
                                            </td>
                                            <td class="ce-hoyre">
                                                <select class="ce-flytt" value="" @onchange="@(e => FlyttType(type, e))" title="Flytt til en annen CE-kategori">
                                                    <option value="">Flytt til …</option>
                                                    @foreach (var k in Kategorier.Where(k => k != kategori))
                                                    {
                                                        <option value="@k">@Navn(k)</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (typer.Count == 0)
                            {
                                <p class="sm-dempet ce-tom">@(string.IsNullOrWhiteSpace(_search) ? "Ingen beslagstyper i denne kategorien." : "Ingen treff.")</p>
                            }
                        </div>
                    </section>
                    @if (kategori != CeTilbehorKategori.Ingen)
                    {
                        <p class="ce-notat">Sertifikatet brukes automatisk for alle varer av typen som ikke har sin egen FDV-fil.</p>
                    }
                }
            </div>
        </div>
    </div>

    @if (GrenseEndret)
    {
        <div class="sm-lagrebar">
            <span><Icon Name="edit" /><b>Endrede grenseverdier</b> er ikke lagret</span>
            <span class="sm-knapperad">
                <button type="button" class="sm-knapp" @onclick="ForkastGrense">Forkast</button>
                <button type="button" class="sm-knapp primaer" @onclick="LagreGrenseverdier"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class TypeDraft
    {
        public int Id { get; set; }
        public required string Navn { get; set; }
        public CeTilbehorKategori CeKategori { get; set; }
        public bool HarDokument { get; set; }
        public string? DokumentFilnavn { get; set; }
    }

    // Rekkefølgen i menyen: kategoriene som er med i CE-godkjenningen først.
    private static readonly CeTilbehorKategori[] Kategorier =
    [
        CeTilbehorKategori.DorAutomatikk,
        CeTilbehorKategori.SikkerhetsTilbehor,
        CeTilbehorKategori.AnnetTilbehor,
        CeTilbehorKategori.Ingen
    ];

    private List<TypeDraft> _typer = [];
    private CeMaleGrenseverdier? _grenseverdier;
    private (double, double, double, double) _lagretGrense;
    private string _valgt = nameof(CeTilbehorKategori.DorAutomatikk);
    private string _search = "";
    private string? _feil;
    private string? _melding;
    private bool _full;

    private bool GrenseEndret => _grenseverdier is { } g
        && (g.MaksApningstidSek, g.MaksLukketidHoySek, g.MaksLukketidLavSek, g.MaksApningskraftN) != _lagretGrense;

    private static string Navn(CeTilbehorKategori k) => k == CeTilbehorKategori.Ingen ? "Uten kategori" : k.Visningsnavn();

    private static string Ikon(CeTilbehorKategori k) => k switch
    {
        CeTilbehorKategori.DorAutomatikk => "settings",
        CeTilbehorKategori.SikkerhetsTilbehor => "shield",
        CeTilbehorKategori.AnnetTilbehor => "tool",
        _ => "circle"
    };

    private static string Beskrivelse(CeTilbehorKategori k) => k switch
    {
        CeTilbehorKategori.DorAutomatikk => "Vises som maskinen i CE-godkjenningen.",
        CeTilbehorKategori.SikkerhetsTilbehor => "Vises i listen over sikkerhetstilbehør i CE-godkjenningen.",
        CeTilbehorKategori.AnnetTilbehor => "Vises i listen over annet tilbehør i CE-godkjenningen.",
        _ => "Ikke med i CE-godkjenningen. Flytt en type til en kategori for å ta den med."
    };

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("ce-oppsett-bredde", "normal") == "full";
        await LoadAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("ce-oppsett-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        _typer = await Db.ComponentTypes
            .OrderBy(t => t.Sortering).ThenBy(t => t.Navn)
            .Select(t => new TypeDraft
            {
                Id = t.Id,
                Navn = t.Navn,
                CeKategori = t.CeKategori,
                HarDokument = SqlFn.TypeOf(t.CeDokumentData) != "null",
                DokumentFilnavn = t.CeDokumentFilnavn
            })
            .ToListAsync();

        _grenseverdier = await Db.CeMaleGrenseverdier.FirstOrDefaultAsync();
        if (_grenseverdier is null)
        {
            _grenseverdier = new CeMaleGrenseverdier();
            Db.CeMaleGrenseverdier.Add(_grenseverdier);
            await Db.SaveChangesAsync();
        }

        HuskGrense();
    }

    private void HuskGrense()
    {
        if (_grenseverdier is { } g)
        {
            _lagretGrense = (g.MaksApningstidSek, g.MaksLukketidHoySek, g.MaksLukketidLavSek, g.MaksApningskraftN);
        }
    }

    private void Velg(string valgt)
    {
        _valgt = valgt;
        _search = "";
        _feil = null;
    }

    private async Task FlyttType(TypeDraft type, ChangeEventArgs e)
    {
        if (!Enum.TryParse<CeTilbehorKategori>(e.Value?.ToString(), out var ny) || ny == type.CeKategori)
        {
            return;
        }

        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == type.Id);
        entity.CeKategori = ny;
        await Db.SaveChangesAsync();
        type.CeKategori = ny;
        _melding = $"«{type.Navn}» er flyttet til {Navn(ny)}.";
    }

    private async Task LastOppDokument(TypeDraft draft, InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _feil = $"«{file.Name}» er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == draft.Id);
        entity.CeDokumentData = buffer.ToArray();
        entity.CeDokumentFilnavn = file.Name;
        entity.CeDokumentContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();

        draft.HarDokument = true;
        draft.DokumentFilnavn = file.Name;
        _melding = $"Sertifikatet for «{draft.Navn}» er lagret.";
    }

    private async Task FjernDokument(TypeDraft draft)
    {
        var entity = await Db.ComponentTypes.FirstAsync(t => t.Id == draft.Id);
        entity.CeDokumentData = null;
        entity.CeDokumentFilnavn = null;
        entity.CeDokumentContentType = null;
        await Db.SaveChangesAsync();

        draft.HarDokument = false;
        draft.DokumentFilnavn = null;
        _melding = $"Sertifikatet for «{draft.Navn}» er fjernet.";
    }

    private void ForkastGrense()
    {
        if (_grenseverdier is { } g)
        {
            (g.MaksApningstidSek, g.MaksLukketidHoySek, g.MaksLukketidLavSek, g.MaksApningskraftN) = _lagretGrense;
        }
    }

    private async Task LagreGrenseverdier()
    {
        if (_grenseverdier is null)
        {
            return;
        }

        await Db.SaveChangesAsync();
        HuskGrense();
        _melding = "Grenseverdiene er lagret.";
    }
}
