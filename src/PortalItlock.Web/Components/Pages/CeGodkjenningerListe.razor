@page "/ce-godkjenninger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VisningPreferanseService VisningPref

<PageTitle>CE-godkjenninger - Full Kontroll</PageTitle>

@* C1: samme oppsett og stil som Prosjekter, Tickets og Systemregister - tittel over
   kortet, verktøylinje, Kanban (Under arbeid / Godkjent / Utløper snart / Utgått)
   og liste med avkrysning for PDF-nedlasting og sletting. *@
<div class="ce-side @(_full ? "ce-full" : "")">

<div class="side-tittel prosjekt-header">
    <div class="prosjekt-header-tittel">
        <span class="prosjekt-header-ikon"><Icon Name="shield" /></span>
        <h1>CE-godkjenninger</h1>
    </div>
    <p class="prosjekt-intro">Alle CE-sertifiseringer på tvers av prosjekter - status, gyldighet og hva som snart må fornyes.</p>
</div>

<div class="pr-ramme">
<div class="prosjekt-toolbar">
    <label class="sok-felt prosjekt-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" @bind:after="@(() => _sideNummer = 1)" placeholder="Søk på sertifikatnummer, prosjekt, dør eller adresse" />
    </label>
    <div class="prosjekt-toolbar-knapper">
        <div class="prosjekt-viewtoggle">
            <button type="button" class="@(_visning == "kanban" ? "aktiv" : "")" @onclick="@(() => VelgVisning("kanban"))"><Icon Name="box" />Kanban</button>
            <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick="@(() => VelgVisning("liste"))"><Icon Name="file-text" />Liste</button>
        </div>
        @if (KanEndreCe)
        {
            <button type="button" class="new-button" @onclick="ApneNyPanel"><Icon Name="plus" />Ny CE-godkjenning</button>
        }
        <button type="button" class="@(_datoFilter == "utgatt" ? "edit-button-active" : "filter-button")" @onclick='@(() => VelgDatoFilter("utgatt"))'>
            <Icon Name="clock" />Vis utgåtte
        </button>
        <select class="sorter-velger" @bind="_sortering" @bind:after="@(() => _sideNummer = 1)">
            <option value="utloper">Sorter: Utløper først</option>
            <option value="nummer">Sorter: Sertifikatnummer</option>
            <option value="prosjekt">Sorter: Prosjekt A-Å</option>
            <option value="nyeste">Sorter: Nyeste først</option>
        </select>
        <div class="prosjekt-filterpopup-anker">
            <button type="button" class="@(AntallAktiveFiltre > 0 ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFlereFiltre = !_visFlereFiltre)">
                <Icon Name="filter" />Filtrer@(AntallAktiveFiltre > 0 ? $" ({AntallAktiveFiltre})" : "")
            </button>
            @if (_visFlereFiltre)
            {
                <div class="prosjekt-filterpopup">
                    <div class="prosjekt-filterpopup-header">
                        <strong>Filtrer</strong>
                        <button type="button" class="prosjekt-filterpopup-lukk" @onclick="@(() => _visFlereFiltre = false)" title="Lukk"><Icon Name="x" /></button>
                    </div>
                    <label class="prosjekt-filterpopup-select-rad">
                        Prosjekt
                        <select @bind="_valgtProsjekt" @bind:after="@(() => _sideNummer = 1)">
                            <option value="">Alle prosjekter</option>
                            @foreach (var p in _prosjektListe)
                            {
                                <option value="@p.Navn">@p.Navn</option>
                            }
                        </select>
                    </label>
                    <label class="prosjekt-filterpopup-select-rad">
                        Status
                        <select @bind="_statusFilterToolbar" @bind:after="@(() => _sideNummer = 1)">
                            <option value="">Alle status</option>
                            @foreach (var st in Enum.GetValues<CeGodkjenningStatus>())
                            {
                                <option value="@st">@st.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    <label class="prosjekt-filterpopup-select-rad">
                        Gyldighet
                        <select @bind="_datoFilter" @bind:after="@(() => _sideNummer = 1)">
                            <option value="">Alle</option>
                            <option value="naermer">Utløper innen 30 dager</option>
                            <option value="utgatt">Utgått</option>
                        </select>
                    </label>
                    <label class="prosjekt-filterpopup-select-rad">
                        Vilkår
                        <select @bind="_vilkarFilter" @bind:after="@(() => _sideNummer = 1)">
                            <option value="">Alle</option>
                            <option value="godkjent">Oppfyller alle vilkår</option>
                            <option value="feilet">Mangler noe</option>
                        </select>
                    </label>
                    <span class="ce-filter-label">Gyldig til</span>
                    <div class="ce-datopar">
                        <label>Fra<input type="date" @bind="_gyldigTilMin" @bind:after="@(() => _sideNummer = 1)" /></label>
                        <label>Til<input type="date" @bind="_gyldigTilMaks" @bind:after="@(() => _sideNummer = 1)" /></label>
                    </div>
                    <div class="prosjekt-filterpopup-bunn">
                        <button type="button" class="prosjekt-filterpopup-nullstill" @onclick="NullstillFilter">Nullstill</button>
                        <button type="button" class="prosjekt-filterpopup-vis" @onclick="@(() => _visFlereFiltre = false)">Vis resultater (@_filtrert.Count)</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="pr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
    </div>
</div>

<p class="result-count">@_filtrert.Count av @_rader.Count CE-godkjenninger</p>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen CE-godkjenninger funnet.</p>
}
else if (_visning == "kanban")
{
    var filtrert = _filtrert;
    <div class="prosjekt-kanban">
        @foreach (var (nokkel, navn, farge) in KanbanKolonner(filtrert))
        {
            var kolonne = filtrert.Where(r => Kolonne(r) == nokkel).ToList();
            <div class="kanban-kolonne kanban-kolonne-@farge">
                <div class="kanban-kolonne-header">
                    <span class="kanban-kolonne-dott kanban-kolonne-dott-@farge"></span>
                    <span class="kanban-kolonne-navn">@navn</span>
                    <span class="kanban-kolonne-teller">@kolonne.Count</span>
                </div>
                @if (kolonne.Count == 0)
                {
                    <div class="kanban-kolonne-tom">Ingen</div>
                }
                @foreach (var r in kolonne)
                {
                    <div class="prosjekt-kort-wrap">
                        <a class="kanban-kort" href="@($"/dor/{r.DorId}?ce={r.Id}")">
                            <span class="kanban-kort-navn">@r.Sertifiseringsnummer</span>
                            <div class="prosjekt-kort-linje"><Icon Name="folder" /><span>@(r.ProsjektNavn ?? "Uten prosjekt")</span></div>
                            <div class="prosjekt-kort-linje"><Icon Name="door" /><span>@DorTekst(r)</span></div>
                            @if (!string.IsNullOrWhiteSpace(r.Prosjektleder))
                            {
                                <span class="team-person"><span class="team-avatar" style="background:@PersonFarge(r.Prosjektleder)">@Initialer(r.Prosjektleder)</span>@r.Prosjektleder</span>
                            }
                            <div class="kanban-kort-bunn ce-kort-bunn">
                                <span class="ce-bar"><span class="ce-bar-spor"><i class="ce-bar-@GyldighetFarge(r)" style="width:@(StolpeAndel(r).ToString("0", CultureInfo.InvariantCulture))%"></i></span><b class="ce-bar-tekst-@GyldighetFarge(r)">@DagerIgjenTekst(r)</b></span>
                                <span class="ce-gyldig">Gyldig til @r.GyldigTil.ToString("dd.MM.yyyy")</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    var valgte = ValgteRader;
    @if (valgte.Count > 0)
    {
        <div class="ce-valgt">
            <span><b>@valgte.Count valgt</b> · @string.Join(", ", valgte.Select(r => r.ProsjektNavn ?? r.Sertifiseringsnummer).Distinct().Take(3))@(valgte.Select(r => r.ProsjektNavn).Distinct().Count() > 3 ? " …" : "")</span>
            <div class="ce-valgt-knapper">
                <button type="button" @onclick="@(() => _valgteRader.Clear())">Fjern valg</button>
                <a href="@($"/ce/pdf-samlet?ider={string.Join(",", valgte.Select(r => r.Id))}")" target="_blank"><Icon Name="download" />Last ned PDF-er</a>
                @if (KanEndreCe)
                {
                    <button type="button" @onclick="@(() => _slettValgte = true)"><Icon Name="x" />Slett</button>
                }
            </div>
        </div>
    }
    <div class="prosjekt-tablewrap">
        <table class="prosjekt-table">
            <thead>
                <tr class="prosjekt-thr">
                    <th class="ce-th-sjekk"><input type="checkbox" checked="@AlleValgtPaSiden" @onchange="ToggleAlleValgtPaSiden" /></th>
                    <th>Sertifikatnummer</th>
                    <th>Status</th>
                    <th>Prosjekt / dør</th>
                    <th>Prosjektleder</th>
                    <th>Gyldig til</th>
                    <th class="ce-th-gyldighet">Gyldighet</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _sidevisning)
                {
                    var valgt = _valgteRader.Contains(r.Id);
                    <tr @key="r.Id" class="prosjekt-tr @(valgt ? "ce-rad-valgt" : "")" @onclick="@(() => Nav.NavigateTo($"/dor/{r.DorId}?ce={r.Id}"))">
                        <td @onclick:stopPropagation="true"><input type="checkbox" checked="@valgt" @onchange="@(() => ToggleValgt(r.Id))" /></td>
                        <td class="prosjekt-td-navn">@r.Sertifiseringsnummer</td>
                        <td><span class="ce-pill ce-pill-@StatusPillFarge(r)"><i></i>@StatusPillTekst(r)</span></td>
                        <td>
                            <div class="ce-to">
                                @(r.ProsjektNavn ?? "Uten prosjekt")
                                <small>@DorTekst(r)</small>
                            </div>
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(r.Prosjektleder))
                            {
                                <span class="pr-tom">—</span>
                            }
                            else
                            {
                                <span class="pr-person"><u>@Initialer(r.Prosjektleder)</u>@r.Prosjektleder</span>
                            }
                        </td>
                        <td>@r.GyldigTil.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="ce-bar"><span class="ce-bar-spor"><i class="ce-bar-@GyldighetFarge(r)" style="width:@(StolpeAndel(r).ToString("0", CultureInfo.InvariantCulture))%"></i></span><b class="ce-bar-tekst-@GyldighetFarge(r)">@DagerIgjenTekst(r)</b></span>
                        </td>
                        <td @onclick:stopPropagation="true">
                            <div class="ce-handlinger">
                                <a href="@($"/dor/{r.DorId}?ce={r.Id}")" title="Vis CE-godkjenning"><Icon Name="eye" /></a>
                                @if (KanEndreCe)
                                {
                                    <a href="@($"/dor/{r.DorId}?ce={r.Id}&rediger=true")" title="Rediger CE-godkjenning"><Icon Name="edit" /></a>
                                    <button type="button" class="ce-slett" title="Slett CE-godkjenning" @onclick="@(() => _slettId = r.Id)"><Icon Name="x" /></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_filtrert.Count > 10)
    {
        <div class="ce-bunn">
            <span>Viser @VisningsStart-@VisningsSlutt av @_filtrert.Count</span>
            <div class="ce-bunn-hoyre">
                <div class="ce-sideknapper">
                    <button type="button" disabled="@(GjeldendeSide <= 1)" @onclick="@(() => _sideNummer = GjeldendeSide - 1)">&lsaquo;</button>
                    @for (var side = 1; side <= TotalSider; side++)
                    {
                        var denneSiden = side;
                        <button type="button" class="@(denneSiden == GjeldendeSide ? "aktiv" : "")" @onclick="@(() => _sideNummer = denneSiden)">@denneSiden</button>
                    }
                    <button type="button" disabled="@(GjeldendeSide >= TotalSider)" @onclick="@(() => _sideNummer = GjeldendeSide + 1)">&rsaquo;</button>
                </div>
                <select class="sorter-velger" @bind="_sideStorrelseStr" @bind:after="@(() => _sideNummer = 1)">
                    <option value="10">10 per side</option>
                    <option value="25">25 per side</option>
                    <option value="50">50 per side</option>
                </select>
            </div>
        </div>
    }
}
</div>

@if (_slettValgte)
{
    <div class="confirm-overlay">
        <div class="confirm-box">
            <h3>Slette @ValgteRader.Count CE-godkjenninger?</h3>
            <p>De valgte sertifiseringene slettes permanent.</p>
            <div class="confirm-actions">
                <button type="button" class="cancel-button" @onclick="@(() => _slettValgte = false)">Avbryt</button>
                <button type="button" class="delete-button" @onclick="BekreftSlettValgte">Slett @ValgteRader.Count</button>
            </div>
        </div>
    </div>
}

@if (_visNyPanel)
{
    <div class="confirm-overlay">
        <div class="confirm-box ce-ny-box">
            <h3>Start ny CE-godkjenning</h3>
            <p>Velg prosjekt og dør med automatikk du vil starte en CE-sertifisering for.</p>
            <label class="ce-ny-felt">
                Prosjekt
                <select @bind="_nyProsjektIdStr" @bind:after="LastDorerForNy">
                    <option value="">Velg prosjekt...</option>
                    @foreach (var p in _alleProsjekterForNy)
                    {
                        <option value="@p.Id">@p.Navn</option>
                    }
                </select>
            </label>
            <label class="ce-ny-felt">
                Dør
                <select @bind="_nyDorIdStr">
                    <option value="">Velg dør...</option>
                    @foreach (var d in _dorerForNy)
                    {
                        <option value="@d.Id">@d.Dornummer@(string.IsNullOrWhiteSpace(d.Etasje) ? "" : $" ({d.Etasje})")</option>
                    }
                </select>
            </label>
            @if (_nyFeil is not null)
            {
                <p class="ce-ny-feil">@_nyFeil</p>
            }
            <div class="confirm-actions">
                <button type="button" class="cancel-button" @onclick="@(() => _visNyPanel = false)">Avbryt</button>
                <button type="button" class="ce-ny-start-knapp" @onclick="StartNyFraPanel">Start CE-godkjenning</button>
            </div>
        </div>
    </div>
}

@if (_slettId is not null)
{
    <div class="confirm-overlay">
        <div class="confirm-box">
            <h3>Er du sikker på at du vil tilbakekalle denne sertifiseringen?</h3>
            <p>Denne sertifiseringen slettes permanent.</p>
            <div class="confirm-actions">
                <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                <button type="button" class="delete-button" @onclick="BekreftSlett">Bekreft</button>
            </div>
        </div>
    </div>
}

</div>

@code {
    private sealed class Rad
    {
        public int Id { get; set; }
        public int DorId { get; set; }
        public required string Sertifiseringsnummer { get; set; }
        public CeGodkjenningStatus Status { get; set; }
        public DateTime GyldigFra { get; set; }
        public DateTime GyldigTil { get; set; }
        public bool Godkjent { get; set; }
        public string? ProsjektNavn { get; set; }
        public string? Dornummer { get; set; }
        public string? Adresse { get; set; }
        public string? Prosjektleder { get; set; }
        public DateTime OpprettetDato { get; set; }
        public bool ErUtgatt => GyldigTil.Date < DateTime.Today;
        public bool NaermerSegUtlop => !ErUtgatt && GyldigTil.Date <= DateTime.Today.AddDays(30);
    }

    private List<Rad> _rader = [];
    private string _search = "";
    private bool _visFlereFiltre;
    private string _statusFilterToolbar = "";
    private string _vilkarFilter = "";
    private DateTime? _gyldigFraMin;
    private DateTime? _gyldigFraMaks;
    private DateTime? _gyldigTilMin;
    private DateTime? _gyldigTilMaks;
    private int? _slettId;
    private string _valgtProsjekt = "";
    private string _datoFilter = "";
    private string _sortering = "utloper";
    private string _visning = "liste";
    private readonly HashSet<int> _valgteRader = [];
    private int _sideNummer = 1;
    private string _sideStorrelseStr = "10";
    private int _sideStorrelse => int.TryParse(_sideStorrelseStr, out var n) ? n : 10;

    private bool _full;
    private bool _slettValgte;

    private bool _visNyPanel;
    private string _nyProsjektIdStr = "";
    private string _nyDorIdStr = "";
    private string? _nyFeil;
    private List<(int Id, string Navn)> _alleProsjekterForNy = [];
    private List<(int Id, string Dornummer, string? Etasje)> _dorerForNy = [];

    private int AntallAktiveFiltre =>
        new[] { _valgtProsjekt, _statusFilterToolbar, _datoFilter, _vilkarFilter }.Count(f => !string.IsNullOrEmpty(f))
        + (_gyldigFraMin.HasValue || _gyldigFraMaks.HasValue ? 1 : 0)
        + (_gyldigTilMin.HasValue || _gyldigTilMaks.HasValue ? 1 : 0);

    private List<(string Navn, int Antall)> _prosjektListe =>
        _rader.Where(r => !string.IsNullOrWhiteSpace(r.ProsjektNavn))
            .GroupBy(r => r.ProsjektNavn!)
            .Select(g => (Navn: g.Key, Antall: g.Count()))
            .OrderByDescending(x => x.Antall)
            .ThenBy(x => x.Navn, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<Rad> _filtrert
    {
        get
        {
            IEnumerable<Rad> rader = _rader
                .Where(r => string.IsNullOrEmpty(_valgtProsjekt) || r.ProsjektNavn == _valgtProsjekt)
                .Where(r => string.IsNullOrEmpty(_statusFilterToolbar) || r.Status.ToString() == _statusFilterToolbar)
                .Where(r => _datoFilter switch { "utgatt" => r.ErUtgatt, "naermer" => r.NaermerSegUtlop, _ => true })
                .Where(r => _vilkarFilter switch { "godkjent" => r.Godkjent, "feilet" => !r.Godkjent, _ => true })
                .Where(r => !_gyldigFraMin.HasValue || r.GyldigFra.Date >= _gyldigFraMin.Value.Date)
                .Where(r => !_gyldigFraMaks.HasValue || r.GyldigFra.Date <= _gyldigFraMaks.Value.Date)
                .Where(r => !_gyldigTilMin.HasValue || r.GyldigTil.Date >= _gyldigTilMin.Value.Date)
                .Where(r => !_gyldigTilMaks.HasValue || r.GyldigTil.Date <= _gyldigTilMaks.Value.Date)
                .Where(r => string.IsNullOrWhiteSpace(_search)
                    || r.Sertifiseringsnummer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (r.ProsjektNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Dornummer?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            rader = _sortering switch
            {
                "nummer" => rader.OrderBy(r => r.Sertifiseringsnummer, StringComparer.OrdinalIgnoreCase),
                "prosjekt" => rader.OrderBy(r => r.ProsjektNavn, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Dornummer, StringComparer.OrdinalIgnoreCase),
                "nyeste" => rader.OrderByDescending(r => r.OpprettetDato),
                _ => rader.OrderBy(r => r.GyldigTil)
            };

            return rader.ToList();
        }
    }

    private int TotalSider => Math.Max(1, (int)Math.Ceiling(_filtrert.Count / (double)_sideStorrelse));
    private int GjeldendeSide => Math.Clamp(_sideNummer, 1, TotalSider);
    private int VisningsStart => _filtrert.Count == 0 ? 0 : (GjeldendeSide - 1) * _sideStorrelse + 1;
    private int VisningsSlutt => Math.Min(_filtrert.Count, GjeldendeSide * _sideStorrelse);
    private List<Rad> _sidevisning => _filtrert.Skip((GjeldendeSide - 1) * _sideStorrelse).Take(_sideStorrelse).ToList();

    private bool AlleValgtPaSiden => _sidevisning.Count > 0 && _sidevisning.All(r => _valgteRader.Contains(r.Id));

    // Montører har lesetilgang til CE: de ser sertifiseringene, men oppretter
    // og sletter ingenting. Sjekken gjentas i metodene under.
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private BrukerRolle? _naverendeRolle;
    private bool KanEndreCe => ModulRettigheter.KanRedigere(_naverendeRolle, "ce-godkjenninger");

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        _full = await VisningPref.HentAsync("ce-bredde", "normal") == "full";
        _visning = await VisningPref.HentAsync("ce-visning", "liste");
        if (_visning is not ("kanban" or "liste"))
        {
            _visning = "liste";
        }

        await LastRaderAsync();
    }

    private async Task LastRaderAsync()
    {
        var godkjenninger = await Db.CeGodkjenninger
            .AsNoTracking()
            .Include(c => c.Dor).ThenInclude(d => d!.Prosjekt).ThenInclude(p => p!.Prosjektleder)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();

        // Valideringen trenger bare å vite OM det finnes media - Include(c => c.Media)
        // hentet alle bildene/videoene for alle godkjenningene. Én tom plassholder
        // per godkjenning med media holder (entitetene er ikke sporet).
        var medMedia = (await Db.CeGodkjenningMedia.Select(m => m.CeGodkjenningId).Distinct().ToListAsync()).ToHashSet();
        foreach (var c in godkjenninger.Where(c => medMedia.Contains(c.Id)))
        {
            c.Media = [new CeGodkjenningMedia { CeGodkjenningId = c.Id, Data = [], ContentType = "", Filnavn = "" }];
        }

        var dorIder = godkjenninger.Select(c => c.DorId).Distinct().ToList();
        var alleKomponenter = await Db.DorKomponenter
            .Where(k => dorIder.Contains(k.DorId))
            .Include(k => k.Component).ThenInclude(c => c!.Type)
            .ToListAsync();

        _rader = godkjenninger.Select(c => new Rad
        {
            Id = c.Id,
            DorId = c.DorId,
            Sertifiseringsnummer = c.Sertifiseringsnummer,
            Status = c.Status,
            GyldigFra = c.GyldigFra,
            GyldigTil = c.GyldigTil,
            Godkjent = CeValideringsService.ErGodkjent(c, alleKomponenter.Where(k => k.DorId == c.DorId).ToList()),
            ProsjektNavn = c.Dor?.Prosjekt?.Navn,
            Dornummer = c.Dor?.Dornummer,
            Adresse = c.Adresse,
            Prosjektleder = c.Dor?.Prosjekt?.Prosjektleder?.Navn,
            OpprettetDato = c.OpprettetDato
        }).ToList();

    }

    // «Vis utgåtte» er et filter - trykk igjen for å fjerne.
    private void VelgDatoFilter(string filter)
    {
        _datoFilter = _datoFilter == filter ? "" : filter;
        _sideNummer = 1;
    }

    // Valgte rader som fortsatt finnes (også på andre sider i listen).
    private List<Rad> ValgteRader => _rader.Where(r => _valgteRader.Contains(r.Id)).ToList();

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("ce-bredde", _full ? "full" : "normal");
    }

    private async Task BekreftSlettValgte()
    {
        if (!KanEndreCe)
        {
            return;
        }

        var ider = ValgteRader.Select(r => r.Id).ToList();
        var entiteter = await Db.CeGodkjenninger.Where(c => ider.Contains(c.Id)).ToListAsync();
        Db.CeGodkjenninger.RemoveRange(entiteter);
        await Db.SaveChangesAsync();
        _rader.RemoveAll(r => ider.Contains(r.Id));
        _valgteRader.Clear();
        _slettValgte = false;
    }

    private void ToggleValgt(int id)
    {
        if (!_valgteRader.Remove(id))
        {
            _valgteRader.Add(id);
        }
    }

    private void ToggleAlleValgtPaSiden(ChangeEventArgs e)
    {
        var merkAlle = e.Value is bool b && b;
        foreach (var r in _sidevisning)
        {
            if (merkAlle)
            {
                _valgteRader.Add(r.Id);
            }
            else
            {
                _valgteRader.Remove(r.Id);
            }
        }
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("ce-visning", visning);
    }

    // Kanban-kolonne: utgått og avvist går foran status, godkjente som snart
    // utløper får egen kolonne.
    private static string Kolonne(Rad r) =>
        r.ErUtgatt ? "utgatt"
        : r.Status == CeGodkjenningStatus.Avvist ? "avvist"
        : r.Status == CeGodkjenningStatus.Godkjent ? (r.NaermerSegUtlop ? "snart" : "godkjent")
        : r.Status == CeGodkjenningStatus.TilGjennomgang ? "gjennomgang"
        : "arbeid";

    // De fire faste kolonnene vises alltid, «Til gjennomgang» og «Avvist» bare når de har noe.
    private static IEnumerable<(string Nokkel, string Navn, string Farge)> KanbanKolonner(List<Rad> rader)
    {
        yield return ("arbeid", "Under arbeid", "blaa");
        if (rader.Any(r => Kolonne(r) == "gjennomgang"))
        {
            yield return ("gjennomgang", "Til gjennomgang", "lilla");
        }

        yield return ("godkjent", "Godkjent", "gronn");
        yield return ("snart", "Utløper snart", "gul");
        yield return ("utgatt", "Utgått", "rod");
        if (rader.Any(r => Kolonne(r) == "avvist"))
        {
            yield return ("avvist", "Avvist", "noytral");
        }
    }

    private static string DorTekst(Rad r)
    {
        var dor = string.IsNullOrWhiteSpace(r.Dornummer) ? "Uten dørnummer" : r.Dornummer;
        return string.IsNullOrWhiteSpace(r.Adresse) ? dor : $"{dor} · {r.Adresse}";
    }

    private static string GyldighetFarge(Rad r) => r.ErUtgatt ? "rod" : r.NaermerSegUtlop ? "gul" : "gronn";

    private static double StolpeAndel(Rad r) => r.ErUtgatt ? 100 : Math.Max(4, DagerIgjenAndel(r));

    private static string StatusPillFarge(Rad r) => r.ErUtgatt ? "rod" : r.Status switch
    {
        CeGodkjenningStatus.Godkjent => "gronn",
        CeGodkjenningStatus.Avvist => "rod",
        CeGodkjenningStatus.TilGjennomgang => "gul",
        _ => "blaa"
    };

    private static string StatusPillTekst(Rad r) => r.ErUtgatt ? "Utgått" : r.Status.Visningsnavn();

    private static readonly string[] PersonPaletten = ["#1F4E8C", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private static string PersonFarge(string navn) => PersonPaletten[navn.Sum(c => (int)c) % PersonPaletten.Length];

    private static string Initialer(string navn) =>
        string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    private static double DagerIgjenAndel(Rad r)
    {
        var total = (r.GyldigTil - r.GyldigFra).TotalDays;
        if (total <= 0)
        {
            return 0;
        }

        var igjen = (r.GyldigTil - DateTime.Today).TotalDays;
        return Math.Clamp(igjen / total * 100, 0, 100);
    }

    private static string DagerIgjenTekst(Rad r)
    {
        var dager = (int)Math.Round((r.GyldigTil.Date - DateTime.Today).TotalDays);
        if (dager == -1)
        {
            return "Utgått i går";
        }

        if (dager < 0)
        {
            return $"Utgått for {-dager} dager siden";
        }

        return dager switch
        {
            0 => "Utløper i dag",
            1 => "1 dag igjen",
            _ => $"{dager} dager igjen"
        };
    }

    private void NullstillFilter()
    {
        _valgtProsjekt = "";
        _statusFilterToolbar = "";
        _datoFilter = "";
        _vilkarFilter = "";
        _gyldigFraMin = null;
        _gyldigFraMaks = null;
        _gyldigTilMin = null;
        _gyldigTilMaks = null;
        _sideNummer = 1;
    }

    private async Task BekreftSlett()
    {
        if (!KanEndreCe || _slettId is null)
        {
            return;
        }

        var entitet = await Db.CeGodkjenninger.FindAsync(_slettId.Value);
        if (entitet is not null)
        {
            Db.CeGodkjenninger.Remove(entitet);
            await Db.SaveChangesAsync();
            _rader.RemoveAll(r => r.Id == _slettId.Value);
            _valgteRader.Remove(_slettId.Value);
        }

        _slettId = null;
    }

    private async Task ApneNyPanel()
    {
        if (!KanEndreCe)
        {
            return;
        }

        _nyFeil = null;
        _nyProsjektIdStr = "";
        _nyDorIdStr = "";
        _dorerForNy = [];
        var prosjekter = await Db.Prosjekter.OrderBy(p => p.Navn).ToListAsync();
        _alleProsjekterForNy = prosjekter.Select(p => (p.Id, p.Navn)).ToList();
        _visNyPanel = true;
    }

    private async Task LastDorerForNy()
    {
        _nyDorIdStr = "";
        if (int.TryParse(_nyProsjektIdStr, out var prosjektId))
        {
            var dorer = await Db.Dorer.Where(d => d.ProsjektId == prosjektId).OrderBy(d => d.Dornummer).ToListAsync();
            _dorerForNy = dorer.Select(d => (d.Id, d.Dornummer, d.Etasje)).ToList();
        }
        else
        {
            _dorerForNy = [];
        }
    }

    private void StartNyFraPanel()
    {
        if (!int.TryParse(_nyDorIdStr, out var dorId))
        {
            _nyFeil = "Velg prosjekt og dør først.";
            return;
        }

        Nav.NavigateTo($"/dor/{dorId}?ny=1");
    }
