@page "/ce-godkjenninger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>CE-godkjenninger - itlock</PageTitle>

<div class="ce-header">
    <div class="ce-header-tittel">
        <span class="ce-header-ikon"><Icon Name="shield" /></span>
        <h1>CE-godkjenninger</h1>
    </div>
    <p>Alle CE-sertifiseringer på tvers av prosjekter, samlet på ett sted. Start en ny fra dørsiden til en dør med automatikk.</p>
</div>

<div class="nokkeltall">
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Totalt aktive</span>
        <span class="nokkel-verdi">@_rader.Count</span>
        <span class="nokkel-under">sertifiseringer i systemet</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Utgått</span>
        <span class="nokkel-verdi rod">@_rader.Count(r => r.ErUtgatt)</span>
        <span class="nokkel-under">krever fornyelse nå</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Nærmer seg utløp</span>
        <span class="nokkel-verdi gul">@_rader.Count(r => r.NaermerSegUtlop)</span>
        <span class="nokkel-under">innen 30 dager</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Godkjenningsgrad</span>
        <span class="nokkel-verdi">@GodkjenningsgradTekst()</span>
        <span class="nokkel-under">oppfyller alle vilkår</span>
    </div>
</div>

<div class="ce-hurtigfilter">
    <button type="button" class="flis @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
        <span class="flis-tall">@_rader.Count</span>
        <span class="flis-etikett">Alle</span>
    </button>
    <button type="button" class="flis flis-rod @(_hurtigfilter == "utgatt" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("utgatt"))'>
        <span class="flis-tall flis-rod">@_rader.Count(r => r.ErUtgatt)</span>
        <span class="flis-etikett">Utgått</span>
    </button>
    <button type="button" class="flis flis-gul @(_hurtigfilter == "naermer" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("naermer"))'>
        <span class="flis-tall flis-gul">@_rader.Count(r => r.NaermerSegUtlop)</span>
        <span class="flis-etikett">Nærmer seg utløp</span>
    </button>
    <button type="button" class="flis @(_hurtigfilter == "feilet" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("feilet"))'>
        <span class="flis-tall">@_rader.Count(r => !r.Godkjent)</span>
        <span class="flis-etikett">Feilet vilkår</span>
    </button>
    <button type="button" class="flis @(_hurtigfilter == "underarbeid" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("underarbeid"))'>
        <span class="flis-tall">@_rader.Count(r => r.Status == CeGodkjenningStatus.UnderArbeid)</span>
        <span class="flis-etikett">Under arbeid</span>
    </button>
</div>

<div class="ce-toolbar">
    <label class="sok-felt">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på sertifikatnummer, prosjekt, dørnummer eller adresse" />
    </label>
    <button type="button" class="@(ErFilterAktivt ? "edit-button-active" : "filter-button")" @onclick="@(() => _visFilter = !_visFilter)">
        <Icon Name="filter" />
        Filtrer@(ErFilterAktivt ? " (aktiv)" : "")
    </button>
</div>

@if (_visFilter)
{
    <div class="dor-velger-panel">
        <div class="dor-velger-header">
            <strong>Filtrer</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
        </div>
        <div class="godkjenning-filter-grid">
            <label>
                Status
                <select @bind="_statusFilter">
                    <option value="">Alle status</option>
                    @foreach (var s in Enum.GetValues<CeGodkjenningStatus>())
                    {
                        <option value="@s">@s.Visningsnavn()</option>
                    }
                </select>
            </label>
            <label>
                Vilkår (condition status)
                <select @bind="_vilkarFilter">
                    <option value="">Alle</option>
                    <option value="godkjent">Godkjent</option>
                    <option value="feilet">Feilet</option>
                </select>
            </label>
            <label>
                Gyldig fra - fra dato
                <input type="date" @bind="_gyldigFraMin" />
            </label>
            <label>
                Gyldig fra - til dato
                <input type="date" @bind="_gyldigFraMaks" />
            </label>
            <label>
                Gyldig til - fra dato
                <input type="date" @bind="_gyldigTilMin" />
            </label>
            <label>
                Gyldig til - til dato
                <input type="date" @bind="_gyldigTilMaks" />
            </label>
        </div>
        <label class="filter-option"><input type="checkbox" @bind="_kunNaermerSegUtlop" /> Kun utløpt eller nærmer seg utløp (30 dager)</label>
        @if (ErFilterAktivt)
        {
            <button type="button" class="cancel-button" @onclick="NullstillFilter">Nullstill filter</button>
        }
    </div>
}

<p class="result-count">@_filtrert.Count av @_rader.Count sertifiseringer</p>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen CE-godkjenninger funnet.</p>
}
else
{
    <div class="godkjenning-table-wrap">
        <table class="godkjenning-table">
            <thead>
                <tr>
                    <th @onclick='@(() => SorterPa("Nummer"))'>Sertifikatnummer@(SortPil("Nummer"))</th>
                    <th @onclick='@(() => SorterPa("Status"))'>Status@(SortPil("Status"))</th>
                    <th>Vilkår</th>
                    <th @onclick='@(() => SorterPa("Prosjekt"))'>Prosjekt / adresse@(SortPil("Prosjekt"))</th>
                    <th @onclick='@(() => SorterPa("Dor"))'>Dørnummer@(SortPil("Dor"))</th>
                    <th @onclick='@(() => SorterPa("GyldigFra"))'>Gyldig fra@(SortPil("GyldigFra"))</th>
                    <th @onclick='@(() => SorterPa("GyldigTil"))'>Gyldig til@(SortPil("GyldigTil"))</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _filtrert)
                {
                    <tr @key="r.Id" class="@(r.ErUtgatt ? "godkjenning-tr-utgatt" : (r.NaermerSegUtlop ? "godkjenning-tr-naermer" : ""))">
                        <td><span class="godkjenning-nummer mono">@r.Sertifiseringsnummer</span></td>
                        <td><span class="godkjenning-badge @StatusFarge(r.Status)">@r.Status.Visningsnavn()</span></td>
                        <td>
                            @if (r.Godkjent)
                            {
                                <span class="vilkar-pille vilkar-ok"><Icon Name="check" />Godkjent</span>
                            }
                            else
                            {
                                <span class="vilkar-pille vilkar-feil"><Icon Name="x" />Feilet</span>
                            }
                        </td>
                        <td>
                            <div class="prosjekt-lenke">
                                <span class="navn">@(r.ProsjektNavn ?? "-")</span>
                                @if (!string.IsNullOrWhiteSpace(r.Adresse))
                                {
                                    <span class="adr">@r.Adresse</span>
                                }
                            </div>
                        </td>
                        <td class="mono">@(r.Dornummer ?? "-")</td>
                        <td class="mono">@r.GyldigFra.ToString("dd.MM.yyyy")</td>
                        <td class="mono">
                            @r.GyldigTil.ToString("dd.MM.yyyy")
                            @if (r.ErUtgatt)
                            {
                                <span class="godkjenning-utlop-tekst godkjenning-utlop-tekst-feil">Utgått</span>
                            }
                            else if (r.NaermerSegUtlop)
                            {
                                <span class="godkjenning-utlop-tekst godkjenning-utlop-tekst-varsel">Nærmer seg</span>
                            }
                        </td>
                        <td class="godkjenning-handling">
                            <a class="godkjenning-ikon" href="@($"/dor/{r.DorId}?ce={r.Id}")" title="Vis CE-godkjenning">
                                <Icon Name="eye" />
                            </a>
                            <a class="godkjenning-ikon" href="@($"/dor/{r.DorId}?ce={r.Id}&rediger=true")" title="Rediger CE-godkjenning">
                                <Icon Name="edit" />
                            </a>
                            <button type="button" class="godkjenning-ikon godkjenning-ikon-slett" title="Slett CE-godkjenning" @onclick="@(() => _slettId = r.Id)">
                                <Icon Name="x" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_slettId is not null)
{
    <div class="confirm-overlay">
        <div class="confirm-box">
            <h3>Er du sikker på at du vil tilbakekalle denne sertifiseringen?</h3>
            <p>Denne sertifiseringen slettes permanent.</p>
            <div class="confirm-actions">
                <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                <button type="button" class="delete-button" @onclick="BekreftSlett">Bekreft</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class Rad
    {
        public int Id { get; set; }
        public int DorId { get; set; }
        public required string Sertifiseringsnummer { get; set; }
        public CeGodkjenningStatus Status { get; set; }
        public DateTime GyldigFra { get; set; }
        public DateTime GyldigTil { get; set; }
        public bool Godkjent { get; set; }
        public string? ProsjektNavn { get; set; }
        public string? Dornummer { get; set; }
        public string? Adresse { get; set; }
        public bool ErUtgatt => GyldigTil.Date < DateTime.Today;
        public bool NaermerSegUtlop => !ErUtgatt && GyldigTil.Date <= DateTime.Today.AddDays(30);
    }

    private List<Rad> _rader = [];
    private string _search = "";
    private bool _visFilter;
    private string _statusFilter = "";
    private string _vilkarFilter = "";
    private DateTime? _gyldigFraMin;
    private DateTime? _gyldigFraMaks;
    private DateTime? _gyldigTilMin;
    private DateTime? _gyldigTilMaks;
    private bool _kunNaermerSegUtlop;
    private int? _slettId;
    private string _hurtigfilter = "alle";
    private string _sortFelt = "Nummer";
    private bool _sortSynkende;

    private bool ErFilterAktivt =>
        !string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrEmpty(_vilkarFilter)
        || _gyldigFraMin.HasValue || _gyldigFraMaks.HasValue || _gyldigTilMin.HasValue || _gyldigTilMaks.HasValue
        || _kunNaermerSegUtlop;

    private List<Rad> _filtrert
    {
        get
        {
            IEnumerable<Rad> rader = _rader
                .Where(r => _hurtigfilter switch
                {
                    "utgatt" => r.ErUtgatt,
                    "naermer" => r.NaermerSegUtlop,
                    "feilet" => !r.Godkjent,
                    "underarbeid" => r.Status == CeGodkjenningStatus.UnderArbeid,
                    _ => true
                })
                .Where(r => string.IsNullOrEmpty(_statusFilter) || r.Status.ToString() == _statusFilter)
                .Where(r => _vilkarFilter switch { "godkjent" => r.Godkjent, "feilet" => !r.Godkjent, _ => true })
                .Where(r => !_gyldigFraMin.HasValue || r.GyldigFra.Date >= _gyldigFraMin.Value.Date)
                .Where(r => !_gyldigFraMaks.HasValue || r.GyldigFra.Date <= _gyldigFraMaks.Value.Date)
                .Where(r => !_gyldigTilMin.HasValue || r.GyldigTil.Date >= _gyldigTilMin.Value.Date)
                .Where(r => !_gyldigTilMaks.HasValue || r.GyldigTil.Date <= _gyldigTilMaks.Value.Date)
                .Where(r => !_kunNaermerSegUtlop || r.ErUtgatt || r.NaermerSegUtlop)
                .Where(r => string.IsNullOrWhiteSpace(_search)
                    || r.Sertifiseringsnummer.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (r.ProsjektNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Dornummer?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            IEnumerable<Rad> sortert = _sortFelt switch
            {
                "Status" => rader.OrderBy(r => r.Status.ToString(), StringComparer.OrdinalIgnoreCase),
                "Prosjekt" => rader.OrderBy(r => r.ProsjektNavn, StringComparer.OrdinalIgnoreCase),
                "Dor" => rader.OrderBy(r => r.Dornummer, StringComparer.OrdinalIgnoreCase),
                "GyldigFra" => rader.OrderBy(r => r.GyldigFra),
                "GyldigTil" => rader.OrderBy(r => r.GyldigTil),
                _ => rader.OrderBy(r => r.Sertifiseringsnummer, StringComparer.OrdinalIgnoreCase)
            };

            return (_sortSynkende ? sortert.Reverse() : sortert).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LastRaderAsync();
    }

    private async Task LastRaderAsync()
    {
        var godkjenninger = await Db.CeGodkjenninger
            .Include(c => c.Dor).ThenInclude(d => d!.Prosjekt)
            .Include(c => c.Media)
            .OrderByDescending(c => c.OpprettetDato)
            .ToListAsync();

        var dorIder = godkjenninger.Select(c => c.DorId).Distinct().ToList();
        var alleKomponenter = await Db.DorKomponenter
            .Where(k => dorIder.Contains(k.DorId))
            .Include(k => k.Component).ThenInclude(c => c!.Type)
            .ToListAsync();

        _rader = godkjenninger.Select(c => new Rad
        {
            Id = c.Id,
            DorId = c.DorId,
            Sertifiseringsnummer = c.Sertifiseringsnummer,
            Status = c.Status,
            GyldigFra = c.GyldigFra,
            GyldigTil = c.GyldigTil,
            Godkjent = CeValideringsService.ErGodkjent(c, alleKomponenter.Where(k => k.DorId == c.DorId).ToList()),
            ProsjektNavn = c.Dor?.Prosjekt?.Navn,
            Dornummer = c.Dor?.Dornummer,
            Adresse = c.Adresse
        }).ToList();
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    private void SorterPa(string felt)
    {
        if (_sortFelt == felt)
        {
            _sortSynkende = !_sortSynkende;
        }
        else
        {
            _sortFelt = felt;
            _sortSynkende = false;
        }
    }

    private string SortPil(string felt) => _sortFelt != felt ? "" : (_sortSynkende ? " ↓" : " ↑");

    private static string StatusFarge(CeGodkjenningStatus status) => status switch
    {
        CeGodkjenningStatus.Godkjent => "godkjenning-badge-gronn",
        CeGodkjenningStatus.Avvist => "godkjenning-badge-rod",
        CeGodkjenningStatus.TilGjennomgang => "godkjenning-badge-gul",
        _ => "godkjenning-badge-blaa"
    };

    private string GodkjenningsgradTekst()
    {
        if (_rader.Count == 0)
        {
            return "-";
        }

        var andel = (double)_rader.Count(r => r.Godkjent) / _rader.Count;
        return $"{andel:P0}";
    }

    private void NullstillFilter()
    {
        _statusFilter = "";
        _vilkarFilter = "";
        _gyldigFraMin = null;
        _gyldigFraMaks = null;
        _gyldigTilMin = null;
        _gyldigTilMaks = null;
        _kunNaermerSegUtlop = false;
    }

    private async Task BekreftSlett()
    {
        if (_slettId is null)
        {
            return;
        }

        var entitet = await Db.CeGodkjenninger.FindAsync(_slettId.Value);
        if (entitet is not null)
        {
            Db.CeGodkjenninger.Remove(entitet);
            await Db.SaveChangesAsync();
            _rader.RemoveAll(r => r.Id == _slettId.Value);
        }

        _slettId = null;
    }
}
