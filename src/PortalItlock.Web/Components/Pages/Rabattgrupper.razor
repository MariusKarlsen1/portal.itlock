@page "/rabattgrupper"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Rabattgrupper</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="tag" /></span>
        <div>
            <h1>Rabattgrupper</h1>
            <p class="section-hint">Faste rabattavtaler per leverandør/produktserie. Koble en komponent til riktig rabattgruppe under Komponentregister, så beregnes nettopris automatisk fra veiledende pris ved prisimport.</p>
        </div>
    </div>
</div>

<div class="verktoy-rad">
    <div class="sok-boks">
        <Icon Name="search" />
        <input @bind="_sok" @bind:event="oninput" placeholder="Søk kode, navn eller leverandør..." />
    </div>
    <div class="filter-rad">
        <button type="button" class="filter-chip @(_statusFilter == StatusFilter.Alle ? "aktiv" : "")" @onclick="@(() => _statusFilter = StatusFilter.Alle)">Alle</button>
        <button type="button" class="filter-chip @(_statusFilter == StatusFilter.Aktive ? "aktiv" : "")" @onclick="@(() => _statusFilter = StatusFilter.Aktive)">Aktive</button>
        <button type="button" class="filter-chip @(_statusFilter == StatusFilter.Inaktive ? "aktiv" : "")" @onclick="@(() => _statusFilter = StatusFilter.Inaktive)">Inaktive</button>
    </div>
    <span class="stat-chip"><span class="dot"></span>@_rabattgrupper.Count rabattgrupper</span>
</div>

<div class="kort tabell-kort">
    @if (_rabattgrupper.Count == 0)
    {
        <p class="list-empty">Ingen rabattgrupper opprettet ennå.</p>
    }
    else if (_synlige.Count == 0)
    {
        <p class="list-empty">Ingen treff.</p>
    }
    else
    {
        <div class="tabell-wrap">
            <table class="rabatt-table">
                <thead>
                    <tr>
                        <th>Kode</th>
                        <th>Navn</th>
                        <th>Leverandør</th>
                        <th>Beskrivelse</th>
                        <th>Rabatt %</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _synlige)
                    {
                        <tr @key="r.Id">
                            <td><input @bind="r.Kode" class="kode-input" /></td>
                            <td><input @bind="r.Navn" /></td>
                            <td><input @bind="r.Leverandor" class="leverandor-celle" /></td>
                            <td><input @bind="r.Beskrivelse" /></td>
                            <td>
                                <span class="rabatt-pille">
                                    <input type="number" step="0.01" @bind="r.RabattProsent" class="prosent-input" />
                                    %
                                </span>
                            </td>
                            <td>
                                <label class="aktiv-toggle @(r.Aktiv ? "paa" : "av")">
                                    <input type="checkbox" @bind="r.Aktiv" hidden />
                                    <span class="dot"></span>@(r.Aktiv ? "Aktiv" : "Inaktiv")
                                </label>
                            </td>
                            <td class="rabatt-actions">
                                <button type="button" class="ikon-btn" title="Lagre" @onclick="@(() => Lagre(r))"><Icon Name="check" /></button>
                                <button type="button" class="ikon-btn slett" title="Slett" @onclick="@(() => Slett(r))"><Icon Name="trash" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="kort ny-rabattgruppe">
    <h2>Ny rabattgruppe</h2>
    <div class="ny-rabattgruppe-form">
        <input @bind="_nyKode" placeholder="Kode, f.eks. 3A" style="max-width:7rem;flex:0 1 7rem;" />
        <input @bind="_nyNavn" placeholder="Navn" />
        <input @bind="_nyLeverandor" placeholder="Leverandør" />
        <input type="number" step="0.01" @bind="_nyRabattProsent" placeholder="Rabatt %" class="prosent-input-ny" />
        <button type="button" class="knapp knapp-primaer" @onclick="Opprett">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }
</div>

@code {
    private enum StatusFilter { Alle, Aktive, Inaktive }

    private List<Rabattgruppe> _rabattgrupper = [];
    private string _sok = "";
    private StatusFilter _statusFilter = StatusFilter.Alle;
    private string _nyKode = "";
    private string _nyNavn = "";
    private string _nyLeverandor = "";
    private decimal _nyRabattProsent;
    private string? _melding;
    private string? _feil;

    private List<Rabattgruppe> _synlige => _rabattgrupper.Where(r =>
        (_statusFilter == StatusFilter.Alle || (_statusFilter == StatusFilter.Aktive) == r.Aktiv)
        && (string.IsNullOrWhiteSpace(_sok)
            || r.Kode.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || r.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || r.Leverandor.Contains(_sok, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _rabattgrupper = await Db.Rabattgrupper
            .OrderBy(r => r.Leverandor).ThenBy(r => r.Kode)
            .ToListAsync();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyKode) || string.IsNullOrWhiteSpace(_nyNavn) || string.IsNullOrWhiteSpace(_nyLeverandor))
        {
            _feil = "Kode, navn og leverandør må fylles ut.";
            return;
        }

        Db.Rabattgrupper.Add(new Rabattgruppe
        {
            Kode = _nyKode.Trim(),
            Navn = _nyNavn.Trim(),
            Leverandor = _nyLeverandor.Trim(),
            RabattProsent = _nyRabattProsent
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"Rabattgruppen \"{_nyKode}\" er opprettet.";
        _nyKode = "";
        _nyNavn = "";
        _nyLeverandor = "";
        _nyRabattProsent = 0;
        await LastAsync();
    }

    private async Task Lagre(Rabattgruppe r)
    {
        var entitet = await Db.Rabattgrupper.FirstOrDefaultAsync(x => x.Id == r.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Kode = r.Kode.Trim();
        entitet.Navn = r.Navn.Trim();
        entitet.Leverandor = r.Leverandor.Trim();
        entitet.Beskrivelse = string.IsNullOrWhiteSpace(r.Beskrivelse) ? null : r.Beskrivelse.Trim();
        entitet.RabattProsent = r.RabattProsent;
        entitet.Aktiv = r.Aktiv;
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"\"{r.Kode}\" er lagret.";
    }

    private async Task Slett(Rabattgruppe r)
    {
        var entitet = await Db.Rabattgrupper.FirstOrDefaultAsync(x => x.Id == r.Id);
        if (entitet is null)
        {
            return;
        }

        Db.Rabattgrupper.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"\"{r.Kode}\" er slettet.";
        _feil = null;
        await LastAsync();
    }
}
