@page "/rabattgrupper"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Rabattgrupper</PageTitle>

@* RB4 (rabattgrupper-nye-forslag.html): leverandørene i en meny inni kortet, og
   rabatten står som felt rett i tabellen - skriv nye prosenter for flere koder
   og lagre alt fra lagre-linjen. Nettoprisen på varene med koden regnes ut på
   nytt når rabatten lagres. Klikk på en rad for å endre resten av koden. *@
<div class="rg @(_full ? "rg-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="tag" /></span>
            <div>
                <h1>Rabattgrupper</h1>
                <p class="section-hint">Faste rabattavtaler per leverandør. Skriv nye prosenter rett i tabellen og lagre samlet - nettoprisen på varene med koden regnes ut på nytt.</p>
            </div>
        </div>
    </div>

    @if (!_lastet)
    {
        <p class="rg-tom">Laster …</p>
    }
    else
    {
        <div class="rg-kort">
            <nav class="rg-meny">
                <label class="rg-minisok">
                    <Icon Name="search" />
                    <input type="search" @bind="_sok" @bind:event="oninput" placeholder="Søk kode hos alle …" />
                </label>
                <span class="rg-gt">Leverandører</span>
                <div class="rg-levliste">
                    @foreach (var lev in Leverandorer)
                    {
                        var navn = lev;
                        <button type="button" class="@(!Soker && navn == _valgtLev ? "pa" : "")" @onclick="@(() => VelgLeverandor(navn))">
                            @Logo(navn)
                            <span class="rg-levnavn">@navn</span>
                            <small>@_rader.Count(r => r.Leverandor == navn)</small>
                        </button>
                    }
                    @if (Leverandorer.Count == 0)
                    {
                        <p class="rg-dempet">Ingen rabattgrupper ennå.</p>
                    }
                </div>
                <button type="button" class="rg-ny-lev" @onclick="NyLeverandor"><Icon Name="plus" />Ny leverandør</button>
            </nav>

            <section class="rg-innhold">
                <div class="rg-hd">
                    @if (Soker)
                    {
                        <div>
                            <b>Søk: «@_sok.Trim()»</b>
                            <small>@Synlige.Count treff hos alle leverandører</small>
                        </div>
                    }
                    else if (_valgtLev is not null)
                    {
                        @Logo(_valgtLev)
                        <div>
                            <b>@_valgtLev</b>
                            <small>@_rader.Count(r => r.Leverandor == _valgtLev) rabattkoder · @_rader.Where(r => r.Leverandor == _valgtLev).Sum(r => r.AntallVarer) varer</small>
                        </div>
                    }
                    else
                    {
                        <div>
                            <b>Ingen rabattgrupper ennå</b>
                            <small>Start med å legge inn en leverandør og den første rabattkoden.</small>
                        </div>
                    }
                    <span class="rg-seg">
                        <button type="button" class="@(_statusFilter == StatusFilter.Alle ? "pa" : "")" @onclick="@(() => _statusFilter = StatusFilter.Alle)">Alle</button>
                        <button type="button" class="@(_statusFilter == StatusFilter.Aktive ? "pa" : "")" @onclick="@(() => _statusFilter = StatusFilter.Aktive)">Aktive</button>
                        <button type="button" class="@(_statusFilter == StatusFilter.Inaktive ? "pa" : "")" @onclick="@(() => _statusFilter = StatusFilter.Inaktive)">Inaktive</button>
                    </span>
                    @if (!Soker && _valgtLev is not null)
                    {
                        <button type="button" class="rg-knapp primaer" @onclick="@(() => NyKode(_valgtLev))"><Icon Name="plus" />Ny kode</button>
                    }
                    <button type="button" class="rg-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                        <Icon Name="@(_full ? "minimize" : "maximize")" />
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_melding))
                {
                    <p class="rg-ok rg-ok-inne">@_melding</p>
                }

                <div class="rg-tabell">
                    <table>
                        @if (_ny is not null || Synlige.Count > 0)
                        {
                            <thead>
                                <tr>
                                    <th>Kode</th>
                                    <th>Rabattgruppe</th>
                                    @if (Soker)
                                    {
                                        <th class="rg-skjul-m">Leverandør</th>
                                    }
                                    <th class="n">Rabatt %</th>
                                    <th class="n rg-skjul-m">Varer</th>
                                    <th></th>
                                </tr>
                            </thead>
                        }
                        <tbody>
                            @if (_ny is not null)
                            {
                                @Redigering(_ny, true)
                            }
                            @foreach (var r in Synlige)
                            {
                                var rad = r;
                                var apen = _red is not null && _red.Id == r.Id;
                                var endret = _endret.TryGetValue(r.Id, out var nyPst);
                                <tr @key="r.Id" class="@(apen ? "apen" : "klikk") @(r.Aktiv ? "" : "av") @(endret ? "rg-endret" : "")" @onclick="@(() => Apne(rad))">
                                    <td><span class="rg-kode">@r.Kode</span></td>
                                    <td>
                                        <b>@r.Navn</b>
                                        @if (!r.Aktiv)
                                        {
                                            <span class="rg-inaktiv">· Inaktiv</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.Beskrivelse))
                                        {
                                            <small>@r.Beskrivelse</small>
                                        }
                                    </td>
                                    @if (Soker)
                                    {
                                        <td class="rg-skjul-m">@r.Leverandor</td>
                                    }
                                    <td class="n" @onclick:stopPropagation="true">
                                        @if (endret)
                                        {
                                            <span class="rg-gml">@Pst(r.RabattProsent)</span>
                                        }
                                        <span class="rg-prosent rg-inline">
                                            <input type="number" step="0.01" min="0" max="100" value="@(Pst(endret ? nyPst : r.RabattProsent).Replace(',', '.'))" @onchange="@(e => EndreProsent(rad, e.Value))" disabled="@apen" />
                                            <i>%</i>
                                        </span>
                                    </td>
                                    <td class="n rg-skjul-m">@(r.AntallVarer == 0 ? "–" : r.AntallVarer)</td>
                                    <td class="n rg-pil">@(apen ? "⌃" : "›")</td>
                                </tr>
                                @if (apen)
                                {
                                    @Redigering(_red!, false)
                                }
                            }
                        </tbody>
                    </table>
                    @if (_ny is null && Synlige.Count == 0 && (_valgtLev is not null || Soker))
                    {
                        <p class="rg-tom">
                            @(Soker ? "Ingen treff." : _statusFilter == StatusFilter.Alle ? "Ingen rabattkoder hos denne leverandøren." : "Ingen koder med dette filteret.")
                        </p>
                    }
                </div>

                @if (_endret.Count > 0)
                {
                    var berorte = _rader.Where(r => _endret.ContainsKey(r.Id)).Sum(r => r.AntallVarer);
                    <div class="rg-lagrebar">
                        <span><Icon Name="edit" /><b>@_endret.Count @(_endret.Count == 1 ? "kode" : "koder") endret</b>@(berorte > 0 ? $" · nettopris regnes ut på nytt for {berorte} {(berorte == 1 ? "vare" : "varer")}" : "")</span>
                        <span class="rg-lagrebar-knapper">
                            <button type="button" class="rg-knapp" @onclick="ForkastProsenter">Forkast</button>
                            <button type="button" class="rg-knapp primaer" disabled="@_lagrer" @onclick="LagreProsenter"><Icon Name="check" />@(_lagrer ? "Lagrer …" : "Lagre")</button>
                        </span>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private enum StatusFilter { Alle, Aktive, Inaktive }

    private sealed class RabattRad
    {
        public int Id { get; set; }
        public string Kode { get; set; } = "";
        public string Navn { get; set; } = "";
        public string Leverandor { get; set; } = "";
        public string? Beskrivelse { get; set; }
        public decimal RabattProsent { get; set; }
        public bool Aktiv { get; set; } = true;
        public int AntallVarer { get; set; }

        public RabattRad Kopi() => (RabattRad)MemberwiseClone();
    }

    private List<RabattRad> _rader = [];
    private Dictionary<string, int> _logoer = new(StringComparer.OrdinalIgnoreCase);
    private bool _lastet;
    private string? _valgtLev;
    private string _sok = "";
    private StatusFilter _statusFilter = StatusFilter.Alle;
    private RabattRad? _red;
    private RabattRad? _ny;
    private bool _nyLeverandorFelt;
    private bool _bekrefterSlett;
    private string? _melding;
    private string? _feil;
    private bool _full;
    private bool _lagrer;

    // Prosenter skrevet rett i tabellen som ikke er lagret ennå (rabattgruppe-id → ny prosent).
    private readonly Dictionary<int, decimal> _endret = [];

    private bool Soker => !string.IsNullOrWhiteSpace(_sok);

    private List<string> Leverandorer => _rader
        .Select(r => r.Leverandor)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<RabattRad> Synlige => _rader
        .Where(r => Soker
            ? r.Kode.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
              || r.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
              || (r.Beskrivelse?.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
            : string.Equals(r.Leverandor, _valgtLev, StringComparison.OrdinalIgnoreCase))
        .Where(r => _statusFilter == StatusFilter.Alle || (_statusFilter == StatusFilter.Aktive) == r.Aktiv)
        .OrderBy(r => Soker ? r.Leverandor : "", StringComparer.OrdinalIgnoreCase)
        .ThenBy(r => r.Kode, StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("rabattgrupper-bredde", "normal") == "full";
        await LastAsync();
        var lagret = await VisningPref.HentAsync("rabattgrupper.leverandor", "");
        _valgtLev = Leverandorer.FirstOrDefault(l => string.Equals(l, lagret, StringComparison.OrdinalIgnoreCase))
            ?? Leverandorer.FirstOrDefault();
        _lastet = true;
    }

    private async Task LastAsync()
    {
        _rader = await Db.Rabattgrupper
            .Select(r => new RabattRad
            {
                Id = r.Id,
                Kode = r.Kode,
                Navn = r.Navn,
                Leverandor = r.Leverandor,
                Beskrivelse = r.Beskrivelse,
                RabattProsent = r.RabattProsent,
                Aktiv = r.Aktiv,
                AntallVarer = r.Komponenter.Count
            })
            .ToListAsync();

        // Rabattgruppe.Leverandor er fritekst - logo hentes fra leverandørregisteret når navnet stemmer.
        _logoer = new(StringComparer.OrdinalIgnoreCase);
        foreach (var l in await Db.Leverandorer.Where(l => SqlFn.TypeOf(l.LogoData) != "null").Select(l => new { l.Id, l.Navn }).ToListAsync())
        {
            _logoer.TryAdd(l.Navn.Trim(), l.Id);
        }
    }

    private RenderFragment Logo(string navn) => __builder =>
    {
        if (_logoer.TryGetValue(navn.Trim(), out var id))
        {
            <img class="rg-logo" src="@($"/leverandorlogo/{id}?w=64")" alt="" loading="lazy" />
        }
        else
        {
            <span class="rg-logo rg-logo-tom">@Initialer(navn)</span>
        }
    };

    private RenderFragment Redigering(RabattRad r, bool ny) => __builder =>
    {
        <tr class="rg-redig">
            <td colspan="@(Soker ? 6 : 5)">
                @if (ny)
                {
                    <b class="rg-redig-tittel">Ny rabattkode@(_nyLeverandorFelt ? "" : $" for {r.Leverandor}")</b>
                }
                <div class="rg-grid @(ny && _nyLeverandorFelt ? "med-lev" : "")">
                    @if (ny && _nyLeverandorFelt)
                    {
                        <label class="rg-felt"><span>Leverandør</span><input @bind="r.Leverandor" placeholder="F.eks. ASSA ABLOY" /></label>
                    }
                    <label class="rg-felt"><span>Kode</span><input @bind="r.Kode" placeholder="3A" /></label>
                    <label class="rg-felt"><span>Navn</span><input @bind="r.Navn" placeholder="F.eks. Låskasser standard" /></label>
                    <label class="rg-felt">
                        <span>Rabatt</span>
                        <span class="rg-prosent"><input type="number" step="0.01" min="0" max="100" @bind="r.RabattProsent" @bind:event="oninput" /><i>%</i></span>
                    </label>
                </div>
                <div class="rg-grid rg-grid-2">
                    <label class="rg-felt"><span>Beskrivelse</span><input @bind="r.Beskrivelse" placeholder="Hva omfatter avtalen?" /></label>
                    @if (!ny)
                    {
                        <label class="rg-felt"><span>Leverandør</span><input @bind="r.Leverandor" /></label>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_feil))
                {
                    <p class="form-error">@_feil</p>
                }
                <div class="rg-bunn">
                    <label class="rg-bryter">
                        <input type="checkbox" @bind="r.Aktiv" />
                        <span class="rg-sw"></span>
                        Aktiv
                    </label>
                    <span class="rg-knapper">
                        @if (!ny)
                        {
                            @if (r.AntallVarer > 0)
                            {
                                <span class="rg-info">@r.AntallVarer varer bruker koden – sett den inaktiv i stedet for å slette</span>
                            }
                            else if (_bekrefterSlett)
                            {
                                <span class="rg-info">Slette «@r.Kode»?</span>
                                <button type="button" class="rg-knapp fare" @onclick="@(() => Slett(r))">Ja, slett</button>
                            }
                            else
                            {
                                <button type="button" class="rg-lenke fare" @onclick="@(() => _bekrefterSlett = true)"><Icon Name="trash" />Slett</button>
                            }
                        }
                        <button type="button" class="rg-knapp" @onclick="Lukk">Avbryt</button>
                        <button type="button" class="rg-knapp primaer" @onclick="@(() => Lagre(r, ny))"><Icon Name="check" />@(ny ? "Opprett" : "Lagre")</button>
                    </span>
                </div>
            </td>
        </tr>
    };

    private static string Pst(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"));

    private static string Kr(decimal v) => v.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) + " kr";

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private async Task VelgLeverandor(string lev)
    {
        _sok = "";
        _valgtLev = lev;
        Lukk();
        _melding = null;
        await VisningPref.SettAsync("rabattgrupper.leverandor", lev);
    }

    private void Apne(RabattRad rad)
    {
        if (_red?.Id == rad.Id)
        {
            return;
        }

        _ny = null;
        _feil = null;
        _bekrefterSlett = false;
        _red = rad.Kopi();
    }

    private void NyKode(string lev)
    {
        _red = null;
        _feil = null;
        _nyLeverandorFelt = false;
        _ny = new RabattRad { Leverandor = lev };
    }

    private void NyLeverandor()
    {
        _sok = "";
        _red = null;
        _feil = null;
        _nyLeverandorFelt = true;
        _ny = new RabattRad();
    }

    private void Lukk()
    {
        _red = null;
        _ny = null;
        _feil = null;
        _bekrefterSlett = false;
    }

    private async Task Lagre(RabattRad r, bool ny)
    {
        if (string.IsNullOrWhiteSpace(r.Kode) || string.IsNullOrWhiteSpace(r.Navn) || string.IsNullOrWhiteSpace(r.Leverandor))
        {
            _feil = "Kode, navn og leverandør må fylles ut.";
            return;
        }

        if (r.RabattProsent < 0 || r.RabattProsent > 100)
        {
            _feil = "Rabatten må være mellom 0 og 100 %.";
            return;
        }

        // Bruk samme skrivemåte som en eksisterende leverandør, så det ikke blir to knapper for samme navn.
        var lev = Leverandorer.FirstOrDefault(l => string.Equals(l, r.Leverandor.Trim(), StringComparison.OrdinalIgnoreCase)) ?? r.Leverandor.Trim();

        if (_rader.Any(x => x.Id != r.Id
            && string.Equals(x.Leverandor, lev, StringComparison.OrdinalIgnoreCase)
            && string.Equals(x.Kode, r.Kode.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            _feil = $"{lev} har allerede en kode «{r.Kode.Trim()}».";
            return;
        }

        Rabattgruppe? entitet;
        if (ny)
        {
            entitet = new Rabattgruppe { Kode = "", Navn = "", Leverandor = "" };
            Db.Rabattgrupper.Add(entitet);
        }
        else
        {
            entitet = await Db.Rabattgrupper.FirstOrDefaultAsync(x => x.Id == r.Id);
            if (entitet is null)
            {
                return;
            }
        }

        var gammelProsent = entitet.RabattProsent;
        entitet.Kode = r.Kode.Trim();
        entitet.Navn = r.Navn.Trim();
        entitet.Leverandor = lev;
        entitet.Beskrivelse = string.IsNullOrWhiteSpace(r.Beskrivelse) ? null : r.Beskrivelse.Trim();
        entitet.RabattProsent = r.RabattProsent;
        entitet.Aktiv = r.Aktiv;
        await Db.SaveChangesAsync();
        _endret.Remove(r.Id);
        var omregnet = !ny && gammelProsent != entitet.RabattProsent ? await OppdaterNettoAsync(entitet) : 0;

        _melding = ny ? $"«{entitet.Kode}» er opprettet hos {lev}." : $"«{entitet.Kode}» er lagret.";
        if (omregnet > 0)
        {
            _melding += $" Nettoprisen er regnet ut på nytt for {omregnet} {(omregnet == 1 ? "vare" : "varer")}.";
        }
        Lukk();
        await LastAsync();
        if (!Soker)
        {
            _valgtLev = lev;
            await VisningPref.SettAsync("rabattgrupper.leverandor", lev);
        }
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("rabattgrupper-bredde", _full ? "full" : "normal");
    }

    private void EndreProsent(RabattRad r, object? verdi)
    {
        _melding = null;
        var tekst = verdi?.ToString()?.Replace(',', '.');
        if (!decimal.TryParse(tekst, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var ny) || ny < 0 || ny > 100 || ny == r.RabattProsent)
        {
            _endret.Remove(r.Id);
            return;
        }

        _endret[r.Id] = Math.Round(ny, 2);
    }

    private void ForkastProsenter() => _endret.Clear();

    private async Task LagreProsenter()
    {
        _lagrer = true;
        try
        {
            var varer = 0;
            foreach (var (id, prosent) in _endret.ToList())
            {
                var entitet = await Db.Rabattgrupper.FirstOrDefaultAsync(x => x.Id == id);
                if (entitet is null)
                {
                    continue;
                }

                entitet.RabattProsent = prosent;
                await Db.SaveChangesAsync();
                varer += await OppdaterNettoAsync(entitet);
            }

            var antall = _endret.Count;
            _endret.Clear();
            _melding = $"{antall} {(antall == 1 ? "kode" : "koder")} lagret" + (varer > 0 ? $", og nettoprisen er regnet ut på nytt for {varer} {(varer == 1 ? "vare" : "varer")}." : ".");
            await LastAsync();
        }
        finally
        {
            _lagrer = false;
        }
    }

    // Nettopris = veiledende minus rabatten, for varene som bruker koden (samme
    // regel som prisimporten). Leverandørens pris på varen følger med, og
    // endringen logges i prishistorikken.
    private async Task<int> OppdaterNettoAsync(Rabattgruppe gruppe)
    {
        var varer = await Db.Components
            .Where(c => c.RabattgruppeId == gruppe.Id && c.PrisVeiledende != null)
            .ToListAsync();
        if (varer.Count == 0)
        {
            return 0;
        }

        var levNavn = gruppe.Leverandor.Trim().ToLower();
        var lev = await Db.Leverandorer.FirstOrDefaultAsync(l => l.Navn.ToLower() == levNavn);
        var lenker = new Dictionary<int, ComponentLeverandor>();
        if (lev is not null)
        {
            foreach (var bolk in varer.Select(c => c.Id).Chunk(500))
            {
                foreach (var l in await Db.ComponentLeverandorer.Where(l => l.LeverandorId == lev.Id && bolk.Contains(l.ComponentId)).ToListAsync())
                {
                    lenker[l.ComponentId] = l;
                }
            }
        }

        var faktor = 1 - gruppe.RabattProsent / 100m;
        var endret = 0;
        foreach (var c in varer)
        {
            if (lenker.TryGetValue(c.Id, out var lenke))
            {
                lenke.PrisNetto = Math.Round((lenke.PrisVeiledende ?? c.PrisVeiledende!.Value) * faktor, 2);
            }

            var nyNetto = Math.Round(c.PrisVeiledende!.Value * faktor, 2);
            if (nyNetto != c.PrisNetto)
            {
                PortalItlock.Web.Services.PrisHistorikkLogger.Logg(Db, c, nyNetto, c.PrisVeiledende, $"Rabattgruppe {gruppe.Kode} ({gruppe.Leverandor}) {Pst(gruppe.RabattProsent)} %");
                c.PrisNetto = nyNetto;
                endret++;
            }
        }

        await Db.SaveChangesAsync();
        return endret;
    }

    private async Task Slett(RabattRad r)
    {
        var entitet = await Db.Rabattgrupper.Include(x => x.Komponenter).FirstOrDefaultAsync(x => x.Id == r.Id);
        if (entitet is null || entitet.Komponenter.Count > 0)
        {
            return;
        }

        Db.Rabattgrupper.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"«{r.Kode}» er slettet.";
        Lukk();
        await LastAsync();
        if (_valgtLev is not null && !Leverandorer.Contains(_valgtLev, StringComparer.OrdinalIgnoreCase))
        {
            _valgtLev = Leverandorer.FirstOrDefault();
        }
    }
}
