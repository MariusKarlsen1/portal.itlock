@page "/driftsmelding/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Driftsmelding - Dør @(_m?.Dor?.Dornummer)</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke driftsmeldingen. Den kan være slettet.</p>
}
else if (_m is null || _status is null)
{
    <p>Laster...</p>
}
else
{
    @* Oppsett "4E Kompakt" (oktober 2026): samme kort som ticket og arbeidsordre,
       med fremdriften som en smal linje og "Opprett ticket" på én rad. *@
    <a class="back-link" href="/driftsmeldinger">&larr; Tilbake til driftsmeldinger</a>

    <div class="dm-hode">
        <h1 class="dm-h1"><span>#@_m.Id</span> @Overskrift</h1>
        <StatusPill Tekst="@_status.Navn" Ikon="@_status.Ikon" Farge="@PillFarge" />
        @if (_m.Haster)
        {
            <span class="dm-pill dm-pill-rod"><Icon Name="alert" />Haster</span>
        }
        @if (!string.IsNullOrWhiteSpace(_m.Kategori))
        {
            <span class="dm-pill"><Icon Name="@DriftHelper.KategoriIkon(_m.Kategori)" />@_m.Kategori</span>
        }
    </div>

    <div class="dm-kort">
        <div class="dm-info">
            @if (_m.Dor?.Prosjekt?.Kunde is { } kunde)
            {
                <span><Icon Name="users" /><b>@kunde.Navn</b></span>
            }
            @if (_m.Dor?.Prosjekt is { } prosjekt)
            {
                <a href="@ProsjektLenke"><Icon Name="folder" />@prosjekt.Navn</a>
            }
            <a href="@($"/dor/{_m.DorId}")"><Icon Name="door" /><b>Dør @_m.Dor?.Dornummer</b>@DorSted</a>
            <span><Icon Name="users" />Meldt av <b>@(_m.InnmeldtAvBruker?.Navn ?? "ukjent")</b></span>
            <span><Icon Name="clock" /><b>@DriftHelper.Siden(_m.OpprettetDato)</b></span>
        </div>

        <div class="dm-flyt">
            <span class="ok"><i></i>Mottatt @_m.OpprettetDato.ToString("HH:mm")</span>
            <span class="@(_m.LestAvAnsatt ? "ok" : "na")"><i></i>@(_m.LestDato is { } lest ? $"Lest {lest:HH:mm}" : "Lest")</span>
            <span class="@(_ticket is not null ? "ok" : "na")"><i></i>@(_ticket is null ? "Ticket" : $"Ticket #{_ticket.Id}")</span>
            <span class="@(_status.Steg == DriftHelper.Steg.Lost ? "ok" : _status.Planlagt is not null ? "na" : "")"><i></i>@(_status.Planlagt is { } p ? $"Montør {DriftHelper.Dag(p)}" : "Montør")</span>
            <span class="@(_status.Steg == DriftHelper.Steg.Lost ? "ok" : "")"><i></i>@(_status.LostDato is { } l ? $"Løst {DriftHelper.Dag(l)}" : "Løst")</span>
        </div>

        <div class="dm-kropp">
            @if (_ticket is null)
            {
                <div class="dm-hurtig">
                    <label class="dm-felt">
                        Ticket-tittel
                        <input @bind="_nyTittel" @bind:event="oninput" />
                    </label>
                    <label class="dm-felt">
                        Prioritet
                        <select @bind="_nyPrioritet">
                            @foreach (var pri in Enum.GetValues<TicketPrioritet>())
                            {
                                <option value="@pri">@pri.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                    <label class="dm-felt">
                        Ansvarlig
                        <select @bind="_nyAnsvarligId">
                            <option value="">Ikke tildelt</option>
                            @foreach (var b in _brukere)
                            {
                                <option value="@b.Id">@b.Navn</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="dm-knapp dm-knapp-p" @onclick="OpprettTicket" disabled="@string.IsNullOrWhiteSpace(_nyTittel)"><Icon Name="plus" />Opprett ticket</button>
                </div>
            }
            else
            {
                <a class="dm-ticket" href="@($"/ticket/{_ticket.Id}")">
                    <span class="dm-ticket-ik"><Icon Name="tool" /></span>
                    <span>
                        <b>Ticket #@_ticket.Id · @_ticket.Status.Visningsnavn()</b>
                        <small>@TicketUndertekst</small>
                    </span>
                    <span class="dm-knapp">Åpne →</span>
                </a>
            }

            <div class="dm-to">
                <div class="dm-boble">
                    <div class="dm-boble-topp">
                        <b>@(_m.InnmeldtAvBruker?.Navn ?? "Ukjent")</b>
                        <span>innmelder</span>
                        <time>@DriftHelper.Siden(_m.OpprettetDato)</time>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_m.Tittel))
                    {
                        <strong class="dm-boble-tittel">@_m.Tittel</strong>
                    }
                    <div class="dm-boble-tekst">@_m.Tekst</div>
                </div>

                <div class="dm-side">
                    @if (_m.Media.Count > 0)
                    {
                        <div class="dm-media">
                            @foreach (var media in _m.Media)
                            {
                                @if (media.ContentType.StartsWith("video/"))
                                {
                                    <video controls src="@($"/driftsmeldingmedia/{media.Id}/fil")"></video>
                                }
                                else
                                {
                                    <a href="@($"/driftsmeldingmedia/{media.Id}/fil")" target="_blank"><img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="@media.Filnavn" loading="lazy" /></a>
                                }
                            }
                        </div>
                    }
                    <span class="dm-chip"><Icon Name="eye" />@Fornavn ser: «@_status.Undertekst»</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private sealed class BrukerOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private Driftsmelding? _m;
    private Ticket? _ticket;
    private DriftHelper.MeldingStatus? _status;
    private bool _notFound;
    private int? _naverendeBrukerId;
    private List<BrukerOption> _brukere = [];

    private string _nyTittel = "";
    private TicketPrioritet _nyPrioritet = TicketPrioritet.Normal;
    private int? _nyAnsvarligId;

    private string Overskrift => !string.IsNullOrWhiteSpace(_m?.Tittel)
        ? $"Dør {_m!.Dor?.Dornummer} – {_m.Tittel}"
        : $"Dør {_m?.Dor?.Dornummer}{(string.IsNullOrWhiteSpace(_m?.Kategori) ? "" : $" – {_m!.Kategori!.ToLowerInvariant()}")}";

    private string DorSted => string.Join(", ", new[] { _m?.Dor?.Etasje is { Length: > 0 } e ? $"{e}. etg" : null, _m?.Dor?.DorTil }
        .Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } sted ? $" · {sted}" : "";

    private string ProsjektLenke => _m?.Dor?.Prosjekt?.Status == ProsjektStatus.Serviceavtale
        ? $"/serviceavtaler/{_m.Dor.ProsjektId}"
        : $"/prosjekter/{_m?.Dor?.ProsjektId}";

    private string Fornavn => _m?.InnmeldtAvBruker?.Navn is { } navn ? DriftHelper.Fornavn(navn) : "Innmelder";

    // Driftsportalens farger (rod/bla/gul/gronn) oversatt til StatusPill sine.
    private string PillFarge => _status?.Farge switch
    {
        "bla" => "blaa",
        "rod" => "rod",
        "gul" => "gul",
        "gronn" => "gronn",
        _ => "noytral"
    };

    private string TicketUndertekst
    {
        get
        {
            var ao = _ticket?.Arbeidsordre;
            if (ao is not null)
            {
                var deler = new List<string> { ao.Tittel };
                if (ao.PlanlagtDato is { } p) { deler.Add(DriftHelper.Dag(p)); }
                if (ao.AnsvarligMontor?.Navn is { } montor) { deler.Add(montor); }
                return string.Join(" · ", deler);
            }
            return _ticket?.AnsvarligBruker?.Navn is { } ansvarlig
                ? $"Ansvarlig: {ansvarlig} · ingen arbeidsordre ennå"
                : "Ingen arbeidsordre ennå";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            if (int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _m = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(m => m.InnmeldtAvBruker)
            .Include(m => m.Media)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (_m is null)
        {
            _notFound = true;
            return;
        }

        if (!_m.LestAvAnsatt)
        {
            _m.LestAvAnsatt = true;
            _m.LestDato = DateTime.Now;
            await Db.SaveChangesAsync();
        }

        _ticket = await Db.Tickets
            .Include(t => t.Arbeidsordre).ThenInclude(a => a!.AnsvarligMontor)
            .Include(t => t.AnsvarligBruker)
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.DriftsmeldingId == Id);

        _status = new DriftHelper.MeldingStatus { Melding = _m, Ticket = _ticket };

        if (_ticket is null)
        {
            _brukere = await Db.Brukere
                .Where(b => b.Aktiv && b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
                .OrderBy(b => b.Navn)
                .Select(b => new BrukerOption { Id = b.Id, Navn = b.Navn })
                .ToListAsync();

            // Forslag fylt ut fra meldingen - kan endres før ticketen opprettes.
            // Haster i driftsportalen gir høy prioritet (og kortere SLA-frist).
            _nyTittel = $"Driftsmelding - Dør {_m.Dor?.Dornummer}";
            _nyPrioritet = _m.Haster ? TicketPrioritet.Hoy : TicketPrioritet.Normal;
        }
    }

    private async Task OpprettTicket()
    {
        var eksisterende = await Db.Tickets.Where(t => t.DriftsmeldingId == Id).Select(t => (int?)t.Id).FirstOrDefaultAsync();
        if (eksisterende is int tid)
        {
            Nav.NavigateTo($"/ticket/{tid}");
            return;
        }

        var prosjekt = _m!.Dor?.Prosjekt;

        var ticket = new Ticket
        {
            Tittel = string.IsNullOrWhiteSpace(_nyTittel) ? $"Driftsmelding - Dør {_m.Dor?.Dornummer}" : _nyTittel.Trim(),
            Beskrivelse = _m.Tekst,
            Prioritet = _nyPrioritet,
            SlaFrist = TicketSlaHelper.BeregnFrist(_nyPrioritet, DateTime.Now),
            AnsvarligBrukerId = _nyAnsvarligId,
            DriftsmeldingId = _m.Id,
            KundeId = prosjekt?.KundeId,
            Lokasjon = prosjekt?.Navn
        };
        ticket.Hendelser.Add(new TicketHendelse
        {
            Beskrivelse = "Opprettet fra driftsmelding.",
            UtfortAvBrukerId = _naverendeBrukerId
        });
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/ticket/{ticket.Id}");
    }
}
