@page "/plattform/innstillinger"
@rendermode InteractiveServer
@layout PortalItlock.Web.Components.Layout.PlattformLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Plattform")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject PlattformOppsettService Oppsett
@inject HemmelighetService Hemmelig
@inject TripletexNokkelOppslag TripletexOppslag
@inject EmailService Epost
@inject OrganisasjonBackupService BackupSvc
@inject IConfiguration Config

<PageTitle>Innstillinger - Plattform</PageTitle>

@* Innstillingene for hele plattformen, delt i seks deler med en meny.
   Øverst vises hva som er klart og hva som mangler. Vanlige felt lagres med
   lagre-linjen nederst; nøkler lagres og testes med en gang, kryptert, og
   vises aldri igjen i klartekst. Mangler en nøkkel her, brukes
   serveroppsettet (miljøvariabler) som før. *@
<div class="pa-side">
    <div class="pa-topp">
        <div>
            <div class="pa-eyebrow">Adminportal</div>
            <h1 class="pa-h1">Innstillinger</h1>
        </div>
    </div>

    @if (_inn is null)
    {
        <p class="pa-hint">Henter …</p>
    }
    else
    {
        var klare = Deler.Count(d => Klar(d.Nokkel));
        <section class="pin-klar" aria-label="Klar til bruk">
            <div class="pin-ring" style="background:conic-gradient(#286A42 0 @((klare * 100 / Deler.Length).ToString(CultureInfo.InvariantCulture))%, #ECE7DD 0)"><span>@klare/@Deler.Length</span></div>
            <div class="pin-klar-tekst">
                <div>
                    <h2 class="pa-h2">@(klare == Deler.Length ? "Alt er klart" : klare >= Deler.Length - 2 ? "Nesten klart" : "Litt igjen")</h2>
                    <p class="pa-hint">Trykk på et punkt for å gå dit.</p>
                </div>
                <div class="pin-punkter">
                    @foreach (var d in Deler)
                    {
                        var del = d;
                        <button type="button" class="pin-punkt @(Klar(del.Nokkel) ? "ok" : "mangler")" @onclick="@(() => _del = del.Nokkel)">@(Klar(del.Nokkel) ? "✓" : "!") @PunktTekst(del.Nokkel)</button>
                    }
                </div>
            </div>
        </section>

        <div class="pin-oppsett">
            <nav class="pin-meny" aria-label="Innstillinger">
                @foreach (var d in Deler)
                {
                    var del = d;
                    <button type="button" aria-current="@(_del == del.Nokkel ? "true" : "false")" @onclick="@(() => _del = del.Nokkel)">
                        <span class="pin-ik"><Icon Name="@del.Ikon" /></span>@del.Navn<span class="pin-st @(Klar(del.Nokkel) ? "ok" : "gul")"></span>
                    </button>
                }
            </nav>

            <div class="pin-panel">
                @if (_del == "firma")
                {
                    <div class="pin-to">
                        <section class="pa-kort pin-kort">
                            <div class="pin-kort-topp"><h2 class="pa-h2">Firmaopplysninger</h2><p class="pa-hint">Står på fakturaer, tilbud, prislister og vilkår.</p></div>
                            <div class="pin-felter">
                                <label class="pa-felt s4">Firmanavn<input @bind="_inn.Firmanavn" @bind:event="oninput" /></label>
                                <label class="pa-felt s2">Org.nr.<input @bind="_inn.OrgNr" @bind:event="oninput" placeholder="123 456 789 MVA" /></label>
                                <label class="pa-felt s6">Adresse<input @bind="_inn.Adresse" @bind:event="oninput" placeholder="Gateadresse" /></label>
                                <label class="pa-felt s2">Postnr<input @bind="_inn.Postnr" @bind:event="oninput" /></label>
                                <label class="pa-felt s4">Sted<input @bind="_inn.Sted" @bind:event="oninput" /></label>
                                <label class="pa-felt">Telefon<input @bind="_inn.Telefon" @bind:event="oninput" /></label>
                                <label class="pa-felt">E-post<input @bind="_inn.Epost" @bind:event="oninput" placeholder="post@full-kontroll.no" /></label>
                                <label class="pa-felt">Kontonummer<input @bind="_inn.Kontonummer" @bind:event="oninput" placeholder="1234.56.78901" /><small>Kunden betaler hit</small></label>
                                <label class="pa-felt">Kontaktperson<input @bind="_inn.Kontaktperson" @bind:event="oninput" /></label>
                            </div>
                        </section>
                        <section class="pa-kort pin-kort">
                            <div class="pin-kort-topp"><h2 class="pa-h2">Slik ser det ut</h2><span class="pa-chip">Fakturahode</span></div>
                            <div class="pin-forh">
                                <div class="pin-forh-topp">
                                    <span class="pin-forh-logo"><img src="fullkontroll-logo-mark.png" alt="" />@(string.IsNullOrWhiteSpace(_inn.Firmanavn) ? "Firmanavn" : _inn.Firmanavn)</span>
                                    <span class="pin-forh-tittel">FAKTURA</span>
                                </div>
                                <div class="pa-hint">Til: Eksempel AS<br />Periode: @DateTime.Today.AddMonths(1).ToString("MMMM yyyy", Nb)</div>
                                <div class="pin-forh-bunn">
                                    <b>@(string.IsNullOrWhiteSpace(_inn.Firmanavn) ? "Firmanavn" : _inn.Firmanavn)</b>
                                    @if (!string.IsNullOrWhiteSpace(_inn.Adresse) || !string.IsNullOrWhiteSpace(_inn.Sted))
                                    {
                                        <span>@string.Join(", ", new[] { _inn.Adresse, $"{_inn.Postnr} {_inn.Sted}".Trim() }.Where(s => !string.IsNullOrWhiteSpace(s)))</span>
                                    }
                                    @if (string.IsNullOrWhiteSpace(_inn.OrgNr))
                                    {
                                        <span class="pin-rod">Org.nr. mangler</span>
                                    }
                                    else
                                    {
                                        <span>Org.nr. @_inn.OrgNr</span>
                                    }
                                    @if (string.IsNullOrWhiteSpace(_inn.Kontonummer))
                                    {
                                        <span class="pin-rod">Kontonummer mangler</span>
                                    }
                                    else
                                    {
                                        <span>Konto @_inn.Kontonummer</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_inn.Epost))
                                    {
                                        <span>@_inn.Epost</span>
                                    }
                                </div>
                            </div>
                        </section>
                    </div>
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Adresser</h2></div>
                        <div class="pin-felter">
                            <label class="pa-felt">Nettside<input @bind="_inn.Nettside" @bind:event="oninput" placeholder="full-kontroll.no" /></label>
                            <label class="pa-felt">Portaladresse<input @bind="_inn.PortalAdresse" @bind:event="oninput" placeholder="https://full-kontroll.no" /><small>Brukes i lenker i invitasjoner og e-post</small></label>
                        </div>
                    </section>
                }

                @if (_del == "tripletex")
                {
                    <section class="pa-kort pin-kort">
                        <div class="pin-kobling">
                            <span class="pin-logo" style="background:#1F6E5B">TX</span>
                            <span class="pin-kobling-tekst"><b>Tripletex</b><small>@TripletexStatusTekst</small></span>
                            <span class="pa-chip @(_tripletexOk ? "pa-chip-ok" : "pa-chip-gul")">@(_tripletexOk ? "Koblet" : "Ikke koblet")</span>
                            @if (_tripletexOk)
                            {
                                <button type="button" class="pa-knapp" disabled="@_tester" @onclick="TestTripletex">@(_tester ? "Tester …" : "Test")</button>
                            }
                        </div>
                        <p class="pa-hint">Fakturaene til alle organisasjonene lages her som ordre. Kundene bruker consumer-tokenet sammen med sin egen ansattnøkkel.</p>
                        @Nokkelfelt("consumer", "Consumer token", _inn.TripletexConsumerTokenKryptert, "Full Kontroll sin. Brukes også av kundene.")
                        @Nokkelfelt("employee", "Ansattnøkkel (employee token)", _inn.TripletexEmployeeTokenKryptert, "Fra din Tripletex: Innstillinger → Integrasjoner → API-tilgang")
                        <div class="pa-bryter-rad">
                            <button type="button" class="pa-bryter" role="switch" aria-checked="@(_inn.TripletexTest ? "true" : "false")" aria-label="Testmiljø" @onclick="@(() => _inn.TripletexTest = !_inn.TripletexTest)"></button>
                            <span class="pin-bryter-tekst"><b>Testmiljø</b><small>Bruk api.tripletex.io i stedet for ekte regnskap</small></span>
                        </div>
                        @if (_byttNokkel is "consumer" or "employee")
                        {
                            <div class="pa-knapper">
                                <button type="button" class="pa-knapp pa-knapp-p" disabled="@_tester" @onclick="LagreTripletex">@(_tester ? "Tester …" : "Lagre og test")</button>
                                <button type="button" class="pa-knapp" @onclick="AvbrytBytt">Avbryt</button>
                            </div>
                        }
                        @Melding("tripletex")
                    </section>
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Slik kobler du til</h2></div>
                        <ol class="pin-steg">
                            <li>Logg inn i Tripletex og gå til Innstillinger → Integrasjoner → API-tilgang.</li>
                            <li>Lag en ny ansattnøkkel for «Full Kontroll», og kopier den.</li>
                            <li>Trykk «Bytt» over, lim inn og trykk «Lagre og test». Firmanavnet vises når det virker.</li>
                        </ol>
                    </section>
                }

                @if (_del == "epost")
                {
                    <section class="pa-kort pin-kort">
                        <div class="pin-kobling">
                            <span class="pin-logo" style="background:#1A1712">R</span>
                            <span class="pin-kobling-tekst"><b>Resend</b><small>@(_resendOk ? (_resendFraOppsett ? "Nøkkelen hentes fra serveroppsettet. Lim den inn her, så ligger den kryptert i portalen." : "Nøkkelen er lagret") : "Mangler API-nøkkel")</small></span>
                            <span class="pa-chip @(_resendOk ? "pa-chip-ok" : "pa-chip-gul")">@(_resendOk ? "Klar" : "Mangler")</span>
                        </div>
                        @Nokkelfelt("resend", "API-nøkkel", _inn.ResendApiKeyKryptert, "Lagres kryptert og vises aldri igjen")
                        @if (_byttNokkel == "resend")
                        {
                            <div class="pa-knapper">
                                <button type="button" class="pa-knapp pa-knapp-p" @onclick="LagreResend">Lagre</button>
                                <button type="button" class="pa-knapp" @onclick="AvbrytBytt">Avbryt</button>
                            </div>
                        }
                    </section>
                    <div class="pin-to">
                        <section class="pa-kort pin-kort">
                            <div class="pin-kort-topp"><h2 class="pa-h2">Avsender</h2></div>
                            <label class="pa-felt">Standardavsender<input @bind="_inn.StandardAvsender" @bind:event="oninput" placeholder="Full Kontroll <varsel@full-kontroll.no>" /><small>Brukes når e-posten ikke hører til en organisasjon</small></label>
                            <div class="pa-bryter-rad">
                                <button type="button" class="pa-bryter" role="switch" aria-checked="@(_inn.EpostPerOrganisasjon ? "true" : "false")" aria-label="E-post per organisasjon" @onclick="@(() => _inn.EpostPerOrganisasjon = !_inn.EpostPerOrganisasjon)"></button>
                                <span class="pin-bryter-tekst"><b>Hver organisasjon sender fra sin egen adresse</b><small>F.eks. firmanavn@full-kontroll.no. Slå på når full-kontroll.no er godkjent hos Resend (SPF, DKIM og MX). Da kommer også svar inn i riktig organisasjon.</small></span>
                            </div>
                            <div class="pa-knapper">
                                <button type="button" class="pa-knapp" disabled="@_tester" @onclick="SendTest">Send test-e-post til @(string.IsNullOrWhiteSpace(_inn.Epost) ? "meg" : _inn.Epost)</button>
                            </div>
                            @Melding("epost")
                        </section>
                        <section class="pa-kort pin-kort">
                            <div class="pin-kort-topp"><h2 class="pa-h2">Slik ser kunden den</h2></div>
                            <div class="pin-epost-forh">
                                <div><span>Fra</span><b>@(_inn.EpostPerOrganisasjon ? "Eksempel AS <eksempel-as@full-kontroll.no>" : string.IsNullOrWhiteSpace(_inn.StandardAvsender) ? "Full Kontroll <varsel@full-kontroll.no>" : _inn.StandardAvsender)</b></div>
                                <div><span>Til</span><b>kari@eksempel.no</b></div>
                                <div><span>Emne</span><b>Ny ordre: Bytte av sylinder</b></div>
                            </div>
                        </section>
                    </div>
                }

                @if (_del == "rabatt")
                {
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Volumrabatt</h2><a class="pa-knapp pa-knapp-s" href="/plattform/prisliste">Prisliste og pakker →</a><p class="pa-hint">Gjelder lisenser per stykk uten egen avtalepris. Driftslisenspakker og moduler får ikke volumrabatt.</p></div>
                        <div class="pa-bryter-rad">
                            <button type="button" class="pa-bryter" role="switch" aria-checked="@(_inn.VolumrabattAktiv ? "true" : "false")" aria-label="Volumrabatt" @onclick="@(() => _inn.VolumrabattAktiv = !_inn.VolumrabattAktiv)"></button>
                            <span class="pin-bryter-tekst"><b>@(_inn.VolumrabattAktiv ? "Gi volumrabatt" : "Ingen volumrabatt")</b><small>@(_inn.VolumrabattAktiv ? "Kunder med mange lisenser får rabatt automatisk" : "Alle betaler full pris uansett antall lisenser")</small></span>
                        </div>
                        @if (_inn.VolumrabattAktiv)
                        {
                            <div class="pin-trinn">
                                <div><span class="pa-eyebrow">Trinn 1</span><span class="pin-stor">@_inn.Rabatt1Prosent %</span><span class="pin-trinn-rad">fra <input type="number" min="0" @bind="_inn.Rabatt1FraAntall" @bind:event="oninput" aria-label="Trinn 1 fra antall lisenser" /> lisenser, <input type="number" min="0" max="100" @bind="_inn.Rabatt1Prosent" @bind:event="oninput" aria-label="Trinn 1 prosent" /> %</span></div>
                                <div><span class="pa-eyebrow">Trinn 2</span><span class="pin-stor">@_inn.Rabatt2Prosent %</span><span class="pin-trinn-rad">fra <input type="number" min="0" @bind="_inn.Rabatt2FraAntall" @bind:event="oninput" aria-label="Trinn 2 fra antall lisenser" /> lisenser, <input type="number" min="0" max="100" @bind="_inn.Rabatt2Prosent" @bind:event="oninput" aria-label="Trinn 2 prosent" /> %</span></div>
                            </div>
                        }
                    </section>
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Årlig forskudd</h2></div>
                        <div class="pa-bryter-rad">
                            <button type="button" class="pa-bryter" role="switch" aria-checked="@(_inn.ArligRabattAktiv ? "true" : "false")" aria-label="Gratis måneder ved årlig forskudd" @onclick="@(() => _inn.ArligRabattAktiv = !_inn.ArligRabattAktiv)"></button>
                            <span class="pin-bryter-tekst"><b>@(_inn.ArligRabattAktiv ? "Gi gratis måneder ved årlig betaling" : "Ingen rabatt ved årlig betaling")</b><small>@(_inn.ArligRabattAktiv ? $"Kunden betaler for {12 - _inn.GratisManeder} av 12 måneder" : "Årlig betaling koster det samme som 12 måneder")</small></span>
                        </div>
                        @if (_inn.ArligRabattAktiv)
                        {
                            <div class="pin-trinn">
                                <div><span class="pa-eyebrow">Gratis måneder</span><span class="pin-stor">@_inn.ArligGratisManeder mnd</span><span class="pin-trinn-rad">Antall: <input type="number" min="0" max="6" @bind="_inn.ArligGratisManeder" @bind:event="oninput" aria-label="Gratis måneder" /></span></div>
                            </div>
                        }
                    </section>
                    <p class="pin-eksempel">@RabattEksempel</p>
                }

                @if (_del == "dok")
                {
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Dokumenter kundene får</h2><span class="pa-chip">Versjon @_inn.VilkarVersjon · gjelder fra @_inn.VilkarGjelderFra.ToString("dd.MM.yyyy")</span></div>
                        <div class="pin-dok">
                            <div class="pin-dok-rad">
                                <span class="pin-dok-ik">PDF</span>
                                <span class="pin-dok-tekst"><b>Lisens- og tjenestevilkår</b><small>@AntallAvsnitt(_inn.VilkarTekst) avsnitt</small></span>
                                <button type="button" class="pa-knapp" @onclick="@(() => VisPdf("/plattform/vilkar.pdf?vis=true", "Vilkår og databehandleravtale"))">Forhåndsvis</button>
                                <button type="button" class="pa-knapp" @onclick="@(() => VelgDok("vilkar"))">@(_apenDok == "vilkar" ? "Lukk" : "Rediger")</button>
                            </div>
                            @if (_apenDok == "vilkar")
                            {
                                <div class="pin-dok-red">
                                    <div class="pin-felter">
                                        <label class="pa-felt s2">Versjon<input @bind="_inn.VilkarVersjon" @bind:event="oninput" /></label>
                                        <label class="pa-felt s2">Gjelder fra<input type="date" @bind="_inn.VilkarGjelderFra" /></label>
                                        <label class="pa-felt s6">Tekst<textarea rows="14" @bind="_inn.VilkarTekst" @bind:event="oninput"></textarea><small>«## » gir overskrift, «- » gir punkt. {Leverandor} byttes med firmanavnet. Øk versjonen ved vesentlige endringer, og varsle kundene minst 30 dager før de gjelder.</small></label>
                                    </div>
                                </div>
                            }
                            <div class="pin-dok-rad">
                                <span class="pin-dok-ik">PDF</span>
                                <span class="pin-dok-tekst"><b>Databehandleravtale</b><small>GDPR · @AntallAvsnitt(_inn.DatabehandlerTekst) avsnitt</small></span>
                                <button type="button" class="pa-knapp" @onclick="@(() => VisPdf("/plattform/vilkar.pdf?vis=true", "Vilkår og databehandleravtale"))">Forhåndsvis</button>
                                <button type="button" class="pa-knapp" @onclick="@(() => VelgDok("dba"))">@(_apenDok == "dba" ? "Lukk" : "Rediger")</button>
                            </div>
                            @if (_apenDok == "dba")
                            {
                                <div class="pin-dok-red"><label class="pa-felt">Tekst<textarea rows="14" @bind="_inn.DatabehandlerTekst" @bind:event="oninput"></textarea></label></div>
                            }
                            <div class="pin-dok-rad">
                                <span class="pin-dok-ik">TXT</span>
                                <span class="pin-dok-tekst"><b>Innledning på tilbud</b><small>Første avsnitt i tilbudet til nye kunder</small></span>
                                <button type="button" class="pa-knapp" @onclick="@(() => VelgDok("tilbud"))">@(_apenDok == "tilbud" ? "Lukk" : "Rediger")</button>
                            </div>
                            @if (_apenDok == "tilbud")
                            {
                                <div class="pin-dok-red"><label class="pa-felt">Tekst<textarea rows="5" @bind="_inn.TilbudIntro" @bind:event="oninput"></textarea></label></div>
                            }
                            <div class="pin-dok-rad">
                                <span class="pin-dok-ik">PDF</span>
                                <span class="pin-dok-tekst"><b>Prisliste</b><small>Lages fra Prisliste og pakker</small></span>
                                <button type="button" class="pa-knapp" @onclick="@(() => VisPdf("/plattform/prisliste.pdf?vis=true", "Prisliste"))">Forhåndsvis</button>
                                <a class="pa-knapp" href="/plattform/prisliste">Endre priser</a>
                            </div>
                        </div>
                        <div class="pa-knapper"><button type="button" class="pa-knapp" @onclick="TilbakestillVilkar">Bruk standardtekstene</button></div>
                        @Melding("dok")
                    </section>
                }

                @if (_del == "sikkerhet")
                {
                    <section class="pa-kort pin-kort">
                        <div class="pin-kort-topp"><h2 class="pa-h2">Sikkerhet og backup</h2><p class="pa-hint">Settes på serveren (Railway). Her ser du om alt er i orden.</p></div>
                        <div class="pin-sjekk">
                            <div>
                                <span class="pa-prikk @(Hemmelig.NokkelFraOppsett ? "pa-ok" : "pa-gul")"></span>
                                <span><b>Nøkkel for lagrede nøkler</b><small>@(Hemmelig.NokkelFraOppsett ? "Satt i serveroppsettet (Plattform__Nokkel)." : "Laget automatisk på serveren. Legg en kopi av plattform-nokkel.txt i passordhvelvet, eller sett Plattform__Nokkel i Railway.")</small></span>
                            </div>
                            <div>
                                <span class="pa-prikk @(BackupSvc.NokkelFraOppsett ? "pa-ok" : "pa-gul")"></span>
                                <span><b>Nøkkel for backup</b><small>@(BackupSvc.NokkelFraOppsett ? "Satt i serveroppsettet (Backup__Nokkel)." : "Laget automatisk på serveren. Legg en kopi av backup-nokkel.txt i passordhvelvet, eller sett Backup__Nokkel i Railway.")</small></span>
                            </div>
                            <div>
                                <span class="pa-prikk @(BackupSvc.Lagring.Type == BackupLagringType.Azure ? "pa-ok" : "pa-gul")"></span>
                                <span><b>Lagring av backup</b><small>@(BackupSvc.Lagring.Type == BackupLagringType.Azure ? "Azure Blob Storage, utenfor serveren." : "På serveren. Sett Backup__AzureSasUrl i Railway for å lagre kopiene utenfor serveren.")</small></span>
                            </div>
                        </div>
                    </section>
                }

                @if (HarEndringer || _lagretNettopp)
                {
                    <div class="pin-lagrelinje" role="status">
                        <span>@(HarEndringer ? "Du har endringer som ikke er lagret" : "Lagret ✓")</span>
                        @if (HarEndringer)
                        {
                            <button type="button" class="pin-angre" @onclick="AngreAsync">Angre</button>
                            <button type="button" class="pin-lagre" @onclick="LagreAlt">Lagre</button>
                        }
                    </div>
                }
            </div>
        </div>

        <PdfPreviewModal Url="@_pdfUrl" Tittel="@_pdfTittel" OnClose="@(() => _pdfUrl = null)" />
    }
</div>

@code {
    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private sealed record Del(string Nokkel, string Navn, string Ikon);
    private static readonly Del[] Deler =
    [
        new("firma", "Firma", "building"),
        new("tripletex", "Tripletex", "link-ikon"),
        new("epost", "E-post", "mail"),
        new("rabatt", "Rabatt", "tag"),
        new("dok", "Dokumenter", "file-text"),
        new("sikkerhet", "Sikkerhet", "shield"),
    ];

    private PlattformInnstillinger? _inn;
    private string _del = "firma";
    private string? _byttNokkel;
    private string _nyNokkel = "";
    private string? _apenDok;
    private string? _pdfUrl;
    private string _pdfTittel = "";
    private string _lagret = "";
    private bool _lagretNettopp;
    private bool _tester;
    private bool _tripletexOk;
    private bool _tripletexFraOppsett;
    private bool _resendOk;
    private bool _resendFraOppsett;
    private string? _meldingFor;
    private string? _melding;
    private bool _meldingErFeil;

    protected override async Task OnInitializedAsync()
    {
        await Oppsett.HentAsync();
        _inn = await PlatformDb.PlattformInnstillinger.FirstAsync();
        _lagret = Bilde();
        await OppdaterStatusAsync();
    }

    // Vanlige felt (ikke nøkler), for å se om noe er endret siden sist lagret.
    private string Bilde() => _inn is null ? "" : System.Text.Json.JsonSerializer.Serialize(new object?[]
    {
        _inn.Firmanavn, _inn.OrgNr, _inn.Adresse, _inn.Postnr, _inn.Sted, _inn.Telefon, _inn.Epost, _inn.Kontonummer,
        _inn.Kontaktperson, _inn.Nettside, _inn.PortalAdresse, _inn.TripletexTest, _inn.StandardAvsender, _inn.EpostPerOrganisasjon,
        _inn.VolumrabattAktiv, _inn.Rabatt1FraAntall, _inn.Rabatt1Prosent, _inn.Rabatt2FraAntall, _inn.Rabatt2Prosent,
        _inn.ArligRabattAktiv, _inn.ArligGratisManeder, _inn.VilkarVersjon, _inn.VilkarGjelderFra, _inn.VilkarTekst,
        _inn.DatabehandlerTekst, _inn.TilbudIntro
    });

    private bool HarEndringer => _inn is not null && Bilde() != _lagret;

    private bool Klar(string del) => _inn is not null && del switch
    {
        "firma" => !string.IsNullOrWhiteSpace(_inn.Firmanavn) && !string.IsNullOrWhiteSpace(_inn.OrgNr) && !string.IsNullOrWhiteSpace(_inn.Kontonummer),
        "tripletex" => _tripletexOk && !_tripletexFraOppsett,
        "epost" => _resendOk && !_resendFraOppsett,
        "dok" => !string.IsNullOrWhiteSpace(_inn.VilkarTekst) && !string.IsNullOrWhiteSpace(_inn.DatabehandlerTekst),
        "sikkerhet" => Hemmelig.NokkelFraOppsett && BackupSvc.NokkelFraOppsett && BackupSvc.Lagring.Type == BackupLagringType.Azure,
        _ => true
    };

    private string PunktTekst(string del) => del switch
    {
        "firma" => Klar(del) ? "Firma" : "Org.nr. og kontonummer",
        "tripletex" => _tripletexFraOppsett ? "Tripletex-nøkler fra serveren" : "Tripletex",
        "epost" => _resendFraOppsett ? "Resend-nøkkel fra serveren" : Klar(del) ? "E-post" : "Resend-nøkkel",
        "rabatt" => "Rabatt",
        "dok" => "Vilkår",
        "sikkerhet" => Klar(del) ? "Sikkerhet" : "Nøkler og backup",
        _ => del
    };

    private string TripletexStatusTekst =>
        !_tripletexOk ? "Lim inn consumer token og ansattnøkkel"
        : _tripletexFraOppsett ? "Nøklene hentes fra serveroppsettet. Lim dem inn her, så ligger de kryptert i portalen."
        : $"Koblet{(_inn?.TripletexFirma is { } f ? $" til {f}" : "")}{(_inn?.TripletexTestet is { } t ? $" · testet {t:dd.MM.yyyy HH:mm}" : "")}";

    private string RabattEksempel
    {
        get
        {
            const int antall = 30;
            const decimal pris = 450;
            var sum = antall * pris;
            var inn = _inn!;
            var prosent = !inn.VolumrabattAktiv ? 0
                : antall >= inn.Rabatt2FraAntall && inn.Rabatt2FraAntall > 0 ? inn.Rabatt2Prosent
                : antall >= inn.Rabatt1FraAntall && inn.Rabatt1FraAntall > 0 ? inn.Rabatt1Prosent : 0;
            var perManed = sum * (100 - prosent) / 100;
            var rabattTekst = prosent > 0 ? $"får {prosent} % rabatt og betaler {Kr(perManed)} per måned i stedet for {Kr(sum)}" : $"betaler {Kr(sum)} per måned";
            return $"Eksempel: En kunde med {antall} lisenser à {Kr(pris)} {rabattTekst}. Betaler de årlig, blir det {Kr(perManed * (12 - inn.GratisManeder))} for hele året.";
        }
    }

    private static string Kr(decimal v) => v.ToString("#,##0", Nb) + " kr";

    private static int AntallAvsnitt(string? tekst) =>
        string.IsNullOrWhiteSpace(tekst) ? 0 : tekst.Split('\n').Count(l => l.TrimStart().StartsWith("## "));

    private async Task OppdaterStatusAsync()
    {
        var tx = await Oppsett.PlattformTripletexAsync();
        _tripletexOk = tx is not null;
        _tripletexFraOppsett = tx is { FraServeroppsett: true };
        _resendFraOppsett = string.IsNullOrWhiteSpace(Hemmelig.Dekrypter(_inn?.ResendApiKeyKryptert)) && !string.IsNullOrWhiteSpace(Config["Resend:ApiKey"]);
        _resendOk = !string.IsNullOrWhiteSpace(await Oppsett.ResendNokkelAsync());
    }

    // Nøkkelfelt: skjult med de siste tegnene, og «Bytt» for å lime inn ny.
    private RenderFragment Nokkelfelt(string hvilken, string navn, string? kryptert, string hjelp) => __builder =>
    {
        var skjult = HemmelighetService.Skjult(Hemmelig.Dekrypter(kryptert));
        <div class="pa-felt">
            @navn
            <div class="pin-nokkel">
                @if (_byttNokkel == hvilken)
                {
                    <input type="password" autocomplete="off" @bind="_nyNokkel" @bind:event="oninput" placeholder="Lim inn ny nøkkel" aria-label="@navn" />
                }
                else
                {
                    <span class="pin-skjult">@(string.IsNullOrEmpty(skjult) ? "Ikke lagt inn" : skjult)</span>
                    <button type="button" class="pa-knapp" @onclick="@(() => StartBytt(hvilken))">@(string.IsNullOrEmpty(skjult) ? "Legg inn" : "Bytt")</button>
                }
            </div>
            <small>@hjelp</small>
        </div>
    };

    private RenderFragment Melding(string hvor) => @<span>
        @if (_meldingFor == hvor && !string.IsNullOrEmpty(_melding))
        {
            <p class="@(_meldingErFeil ? "pa-feil" : "pa-melding")">@_melding</p>
        }
    </span>;

    private void Vis(string hvor, string tekst, bool feil = false)
    {
        _meldingFor = hvor;
        _melding = tekst;
        _meldingErFeil = feil;
    }

    private void StartBytt(string hvilken)
    {
        _byttNokkel = hvilken;
        _nyNokkel = "";
        _melding = null;
    }

    private void AvbrytBytt()
    {
        _byttNokkel = null;
        _nyNokkel = "";
    }

    private void VelgDok(string dok) => _apenDok = _apenDok == dok ? null : dok;

    private void VisPdf(string url, string tittel)
    {
        _pdfTittel = tittel;
        _pdfUrl = $"{url}&t={DateTime.Now.Ticks}";
    }

    private async Task LagreAlt()
    {
        if (_inn is null)
        {
            return;
        }

        _inn.Rabatt1Prosent = Math.Clamp(_inn.Rabatt1Prosent, 0, 100);
        _inn.Rabatt2Prosent = Math.Clamp(_inn.Rabatt2Prosent, 0, 100);
        _inn.Rabatt1FraAntall = Math.Max(0, _inn.Rabatt1FraAntall);
        _inn.Rabatt2FraAntall = Math.Max(0, _inn.Rabatt2FraAntall);
        _inn.ArligGratisManeder = Math.Clamp(_inn.ArligGratisManeder, 0, 6);
        await LagreAsync();
        _lagret = Bilde();
        _lagretNettopp = true;
        StateHasChanged();
        await Task.Delay(1500);
        _lagretNettopp = false;
    }

    private async Task AngreAsync()
    {
        if (_inn is null)
        {
            return;
        }

        await PlatformDb.Entry(_inn).ReloadAsync();
        _lagret = Bilde();
    }

    private async Task LagreAsync()
    {
        _inn!.SistEndret = DateTime.Now;
        await PlatformDb.SaveChangesAsync();
        Oppsett.Nullstill();
    }

    private async Task LagreTripletex()
    {
        if (_inn is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_nyNokkel))
        {
            if (_byttNokkel == "consumer")
            {
                _inn.TripletexConsumerTokenKryptert = Hemmelig.Krypter(_nyNokkel.Trim());
            }
            else
            {
                _inn.TripletexEmployeeTokenKryptert = Hemmelig.Krypter(_nyNokkel.Trim());
            }
        }

        AvbrytBytt();
        await LagreAsync();
        _lagret = Bilde();
        await TestTripletex();
    }

    private async Task TestTripletex()
    {
        if (_inn is null)
        {
            return;
        }

        var nokler = await Oppsett.PlattformTripletexAsync();
        if (nokler is null)
        {
            Vis("tripletex", "Legg inn både consumer token og ansattnøkkel.", true);
            await OppdaterStatusAsync();
            return;
        }

        _tester = true;
        StateHasChanged();
        try
        {
            var svar = await TripletexOppslag.Lag(new TripletexService.Nokler(nokler.ConsumerToken, nokler.EmployeeToken, nokler.Test), 0).TestTilkoblingAsync();
            if (svar.Ok)
            {
                _inn.TripletexFirma = svar.FirmaNavn;
                _inn.TripletexTestet = DateTime.Now;
                await LagreAsync();
                _lagret = Bilde();
                Vis("tripletex", $"Virker. Koblet til {svar.FirmaNavn}.");
            }
            else
            {
                Vis("tripletex", $"Tripletex godtok ikke nøklene: {svar.Feilmelding}", true);
            }
        }
        finally
        {
            _tester = false;
        }

        await OppdaterStatusAsync();
    }

    private async Task LagreResend()
    {
        if (_inn is null || string.IsNullOrWhiteSpace(_nyNokkel))
        {
            return;
        }

        _inn.ResendApiKeyKryptert = Hemmelig.Krypter(_nyNokkel.Trim());
        AvbrytBytt();
        await LagreAsync();
        _lagret = Bilde();
        await OppdaterStatusAsync();
        Vis("epost", "Nøkkelen er lagret. Send en test-e-post for å sjekke at den virker.");
    }

    private async Task SendTest()
    {
        if (_inn is null || string.IsNullOrWhiteSpace(_inn.Epost))
        {
            Vis("epost", "Fyll inn e-post under Firma først. Testen sendes dit.", true);
            return;
        }

        _tester = true;
        try
        {
            var ok = await Epost.SendAsync(_inn.Epost, "Test fra Full Kontroll", "<p>Dette er en test fra adminportalen. E-post virker.</p>");
            Vis("epost", ok ? $"Test sendt til {_inn.Epost}." : "Kunne ikke sende. Sjekk Resend-nøkkelen og avsenderen.", !ok);
        }
        finally
        {
            _tester = false;
        }
    }

    private void TilbakestillVilkar()
    {
        _inn!.VilkarTekst = Vilkar.StandardVilkar;
        _inn.DatabehandlerTekst = Vilkar.StandardDatabehandleravtale;
        _inn.TilbudIntro = Vilkar.StandardTilbudIntro;
        Vis("dok", "Standardtekstene er satt inn. Trykk Lagre nederst for å ta dem i bruk.");
    }
}
