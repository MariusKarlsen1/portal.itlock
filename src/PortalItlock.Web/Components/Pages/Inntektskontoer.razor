@page "/rapporter/kontoplan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kontoplan - itlock</PageTitle>

<a class="back-link" href="/rapportermodul"><Icon Name="arrow-left" />Tilbake til rapporter</a>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="settings" /></span>
    <div>
        <h1>Kontoplan (inntektskontoer)</h1>
        <p class="section-hint">
            Portalens eget register over inntektskontoer - opprett nummer og navn her,
            koble dem til varer under Komponentregister, så dukker de opp i
            Resultatrapporten når arbeidsordre med varen ferdigmeldes.
        </p>
    </div>
</div>

@if (_kontoer.Count == 0)
{
    <p class="list-empty">Ingen inntektskontoer opprettet ennå.</p>
}
else
{
    <div class="kort konto-kort">
        @foreach (var k in _kontoer)
        {
            <div class="rad" @key="k.Id">
                <input type="number" @bind="k.Nummer" class="rad-nummer" />
                <input @bind="k.Navn" class="rad-navn" />
                <button type="button" class="btn-liten btn-primaer" @onclick="@(() => Lagre(k))">Lagre</button>
                <button type="button" class="btn-liten btn-slett" @onclick="@(() => Slett(k))">Slett</button>
            </div>
        }
    </div>
}

<div class="kort ny-rad-kort">
    <div class="ny-rad">
        <input type="number" @bind="_nyNummer" placeholder="Nummer, f.eks. 3000" class="rad-nummer" />
        <input @bind="_nyNavn" placeholder="Navn, f.eks. Salgsinntekt dører" class="rad-navn" />
        <button type="button" class="btn-liten btn-primaer" @onclick="Opprett">Legg til</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="save-success">@_melding</p>
}
@if (!string.IsNullOrEmpty(_feil))
{
    <p class="form-error">@_feil</p>
}

@code {
    private List<Inntektskonto> _kontoer = [];
    private int? _nyNummer;
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;

    protected override async Task OnInitializedAsync() => await LastAsync();

    private async Task LastAsync()
    {
        _kontoer = await Db.Inntektskontoer.OrderBy(k => k.Nummer).ToListAsync();
    }

    private async Task Opprett()
    {
        if (_nyNummer is null || string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Nummer og navn må fylles ut.";
            return;
        }

        Db.Inntektskontoer.Add(new Inntektskonto { Nummer = _nyNummer.Value, Navn = _nyNavn.Trim() });
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"Kontoen \"{_nyNummer} - {_nyNavn}\" er opprettet.";
        _nyNummer = null;
        _nyNavn = "";
        await LastAsync();
    }

    private async Task Lagre(Inntektskonto k)
    {
        var entitet = await Db.Inntektskontoer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Nummer = k.Nummer;
        entitet.Navn = k.Navn.Trim();
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"\"{k.Nummer} - {k.Navn}\" er lagret.";
    }

    private async Task Slett(Inntektskonto k)
    {
        var entitet = await Db.Inntektskontoer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        if (await Db.Components.AnyAsync(c => c.InntektskontoId == k.Id))
        {
            _feil = $"\"{k.Nummer} - {k.Navn}\" er i bruk på en eller flere varer og kan ikke slettes - fjern koblingen i Komponentregisteret først.";
            return;
        }

        Db.Inntektskontoer.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"\"{k.Nummer} - {k.Navn}\" er slettet.";
        _feil = null;
        await LastAsync();
    }
}
