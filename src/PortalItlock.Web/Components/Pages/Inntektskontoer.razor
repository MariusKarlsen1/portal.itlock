@page "/rapporter/kontoplan"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Kontoplan - Full Kontroll</PageTitle>

<RapportRamme Tittel="Kontoplan" Undertittel="Inntektskontoene som settes på varer i komponentregisteret og brukes i resultatrapporten." Ikon="settings" UtenKort="true" VisSkrivUt="false">
    <Handlinger>
        <a class="rr-knapp" href="/rapporter/resultat"><Icon Name="file-text" />Resultatrapport</a>
    </Handlinger>
    <ChildContent>
        <div class="kp">
            <div>
                <label class="kp-sok"><Icon Name="search" /><input type="search" placeholder="Søk konto …" @bind="_sok" @bind:event="oninput" /></label>
                <div class="kp-liste">
                    @if (_kontoer.Count == 0)
                    {
                        <p class="kp-tom">Ingen inntektskontoer opprettet ennå.</p>
                    }
                    else
                    {
                        <div class="kp-rad kp-hode"><span>Konto</span><span>Navn</span><span class="h">Varer</span><span class="h">Hittil i år</span><span></span></div>
                        @foreach (var k in Synlige)
                        {
                            var apen = _apenId == k.Id;
                            var varer = _varerPerKonto.GetValueOrDefault(k.Id);
                            <div @key="k.Id" class="kp-blokk @(apen ? "apen" : "")">
                                <button type="button" class="kp-rad" @onclick="@(() => VelgRad(k))">
                                    <span class="kp-konto">@k.Nummer</span>
                                    <span class="kp-navn">@k.Navn</span>
                                    <span class="h">
                                        @if (varer > 0)
                                        {
                                            @($"{varer} {(varer == 1 ? "vare" : "varer")}")
                                        }
                                        else
                                        {
                                            <span class="kp-pille">Ikke i bruk</span>
                                        }
                                    </span>
                                    <span class="h kp-tall">@(_omsetning.TryGetValue(k.Nummer, out var sum) ? RapportPeriode.Kr(sum) : "–")</span>
                                    <span class="kp-mer"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                                </button>
                                @if (apen)
                                {
                                    <div class="kp-rediger">
                                        <label class="kp-felt"><span>Nummer</span><input type="number" @bind="k.Nummer" /></label>
                                        <label class="kp-felt"><span>Navn</span><input @bind="k.Navn" @bind:event="oninput" /></label>
                                        <div class="kp-bunn">
                                            @if (varer > 0)
                                            {
                                                <span class="kp-hint">@varer @(varer == 1 ? "vare bruker" : "varer bruker") denne kontoen – flytt dem i komponentregisteret før du sletter.</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="kp-lenke farlig" @onclick="@(() => Slett(k))"><Icon Name="trash" />Slett konto</button>
                                            }
                                            <span class="kp-knapper">
                                                <button type="button" class="kp-knapp" @onclick="Avbryt">Avbryt</button>
                                                <button type="button" class="kp-knapp primaer" @onclick="@(() => Lagre(k))"><Icon Name="check" />Lagre</button>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <aside class="kp-ny">
                <h2>Ny konto</h2>
                <label class="kp-felt"><span>Kontonummer</span><input type="number" @bind="_nyNummer" placeholder="F.eks. 3000" /></label>
                <label class="kp-felt"><span>Navn</span><input @bind="_nyNavn" @bind:event="oninput" placeholder="F.eks. Salgsinntekt dører" /></label>
                <button type="button" class="kp-knapp primaer full" @onclick="Opprett"><Icon Name="plus" />Legg til konto</button>
                <p class="kp-hint">Salgsinntekter ligger vanligvis i 3000-serien. Bruk gjerne samme nummer som i Tripletex, så stemmer rapportene overens.</p>
                @if (_utenKonto > 0)
                {
                    <p class="kp-varsel">⚠️ <b>@_utenKonto @(_utenKonto == 1 ? "vare" : "varer")</b> solgt i år mangler inntektskonto. <a href="/komponenter">Gå til komponentregisteret →</a></p>
                }
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <p class="save-success">@_melding</p>
                }
                @if (!string.IsNullOrEmpty(_feil))
                {
                    <p class="form-error">@_feil</p>
                }
            </aside>
        </div>
    </ChildContent>
</RapportRamme>

@code {
    private List<Inntektskonto> _kontoer = [];
    private Dictionary<int, int> _varerPerKonto = [];
    private Dictionary<int, decimal> _omsetning = [];
    private int _utenKonto;
    private int? _apenId;
    private string _sok = "";
    private int? _nyNummer;
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;

    private IEnumerable<Inntektskonto> Synlige => string.IsNullOrWhiteSpace(_sok)
        ? _kontoer
        : _kontoer.Where(k => k.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase)
                           || k.Nummer.ToString().Contains(_sok.Trim()));

    protected override async Task OnInitializedAsync()
    {
        await LastAsync();

        // Omsetning hittil i år per konto, og varer solgt uten konto.
        var linjer = (await RapportData.HentAsync(Db, new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today))
            .SelectMany(o => o.Linjer)
            .ToList();
        _omsetning = linjer
            .Where(l => l.KontoNummer is not null)
            .GroupBy(l => l.KontoNummer!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(l => l.Belop));
        _utenKonto = linjer
            .Where(l => l.KontoNummer is null && l.ComponentId is not null)
            .Select(l => l.ComponentId)
            .Distinct()
            .Count();
    }

    private async Task LastAsync()
    {
        _kontoer = await Db.Inntektskontoer.OrderBy(k => k.Nummer).ToListAsync();
        _varerPerKonto = await Db.Components
            .Where(c => c.InntektskontoId != null)
            .GroupBy(c => c.InntektskontoId!.Value)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);
    }

    // Klikk på en rad åpner redigering; Avbryt (eller klikk igjen) forkaster
    // ulagrede endringer ved å laste kontoene på nytt fra databasen.
    private async Task VelgRad(Inntektskonto k)
    {
        if (_apenId == k.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await ForkastEndringer();
        }

        _apenId = k.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await ForkastEndringer();
    }

    private async Task ForkastEndringer()
    {
        foreach (var entry in Db.ChangeTracker.Entries<Inntektskonto>().Where(e => e.State == EntityState.Modified))
        {
            await entry.ReloadAsync();
        }

        await LastAsync();
    }

    private async Task Opprett()
    {
        if (_nyNummer is null || string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Nummer og navn må fylles ut.";
            return;
        }

        if (_kontoer.Any(k => k.Nummer == _nyNummer))
        {
            _feil = $"Konto {_nyNummer} finnes allerede.";
            return;
        }

        Db.Inntektskontoer.Add(new Inntektskonto { Nummer = _nyNummer.Value, Navn = _nyNavn.Trim() });
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"Kontoen \"{_nyNummer} - {_nyNavn.Trim()}\" er opprettet.";
        _nyNummer = null;
        _nyNavn = "";
        await LastAsync();
    }

    private async Task Lagre(Inntektskonto k)
    {
        if (string.IsNullOrWhiteSpace(k.Navn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        var entitet = await Db.Inntektskontoer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Nummer = k.Nummer;
        entitet.Navn = k.Navn.Trim();
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"\"{k.Nummer} - {k.Navn}\" er lagret.";
        _apenId = null;
        await LastAsync();
    }

    private async Task Slett(Inntektskonto k)
    {
        var entitet = await Db.Inntektskontoer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        if (await Db.Components.AnyAsync(c => c.InntektskontoId == k.Id))
        {
            _feil = $"\"{k.Nummer} - {k.Navn}\" er i bruk på en eller flere varer og kan ikke slettes - fjern koblingen i Komponentregisteret først.";
            return;
        }

        Db.Inntektskontoer.Remove(entitet);
        await Db.SaveChangesAsync();
        _melding = $"\"{k.Nummer} - {k.Navn}\" er slettet.";
        _feil = null;
        _apenId = null;
        await LastAsync();
    }
}
