@page "/kravdimensjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Kravdimensjoner</PageTitle>

@* K1 (Prototype krav og dimensjoner.html): ett kort som kundekortet med grå
   infolinje og kategoriene i grå meny til venstre med blå strek. Til høyre står
   navn og plass i kravvelgeren, verdiene i en tabell man skriver rett i, og
   slett i egen boks. Endringer samles og lagres fra lagre-linjen nederst. *@
<div class="kd @(_full ? "kd-full" : "")">
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="kd-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="kd-kort">
        <div class="kd-topp">
            <span class="kd-ikon"><Icon Name="tag" /></span>
            <div class="kd-tittel">
                <div class="kd-smule"><NavLink href="/oppsettmodul">Oppsett</NavLink> / Dørpakker</div>
                <h1>Krav og dimensjoner</h1>
            </div>
            <div class="kd-knapper">
                <label class="kd-sok">
                    <Icon Name="search" />
                    <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk kategori eller verdi …" />
                </label>
                <button type="button" class="kd-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>
        </div>

        <div class="kd-info">
            <span><b>@_dimensions.Count</b> @(_dimensions.Count == 1 ? "kategori" : "kategorier")</span>
            <span><b>@_dimensions.Sum(d => d.Verdier.Count(v => !v.Slettet))</b> verdier</span>
            <span><b>@_dimensions.Sum(d => d.Verdier.Count(v => !v.Slettet && v.Brukt > 0))</b> verdier brukes i dørpakker</span>
            <span>Rekkefølgen her er rekkefølgen i kravvelgeren</span>
        </div>

        <div class="kd-kropp">
            <nav class="kd-meny">
                @foreach (var dim in _filtrerte)
                {
                    var id = dim.Id;
                    <button type="button" @key="dim.Id" class="kd-fane @(dim.Id == _valgtId ? "pa" : "")" @onclick="@(() => { _valgtId = id; _bekreftSlettKategori = false; })">
                        <Icon Name="@IkonForDimensjon(dim.Navn)" />
                        <span>@dim.Navn@(dim.Endret ? " •" : "")</span>
                        <em>@dim.Verdier.Count(v => !v.Slettet)</em>
                    </button>
                }
                @if (_filtrerte.Count == 0)
                {
                    <p class="kd-dempet">Ingen kategorier funnet.</p>
                }
                <div class="kd-ny-kategori">
                    <input @bind="_nyKategoriNavn" @bind:event="oninput" placeholder="＋ Ny kategori"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await CreateDimension(); } })" />
                    @if (!string.IsNullOrWhiteSpace(_nyKategoriNavn))
                    {
                        <button type="button" class="kd-knapp primaer" @onclick="CreateDimension">Opprett</button>
                    }
                </div>
            </nav>

            <div class="kd-innhold">
                @if (_valgt is { } valgt)
                {
                    var plass = _dimensions.IndexOf(valgt);
                    var synlige = valgt.Verdier.Where(v => !v.Slettet).ToList();

                    <section class="kd-boks">
                        <div class="kd-boks-t"><h3>Kategori</h3></div>
                        <div class="kd-skjema">
                            <label class="kd-felt s2">
                                <span>Navn på kategori</span>
                                <input @bind="valgt.Navn" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" />
                            </label>
                            <label class="kd-felt">
                                <span>Plass i kravvelgeren</span>
                                <select value="@plass" @onchange="@(e => FlyttTil(valgt, e))">
                                    @for (var i = 0; i < _dimensions.Count; i++)
                                    {
                                        <option value="@i">Nr. @(i + 1)</option>
                                    }
                                </select>
                            </label>
                        </div>
                    </section>

                    <section class="kd-boks">
                        <div class="kd-boks-t"><h3>Verdier</h3><small>@synlige.Count</small></div>
                        <div class="kd-tabell">
                            <table>
                                <thead>
                                    <tr>
                                        <th class="kd-smal"></th>
                                        <th>Verdi</th>
                                        <th>Brukes i</th>
                                        <th class="kd-smal"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < synlige.Count; i++)
                                    {
                                        var v = synlige[i];
                                        var indeks = i;
                                        <tr @key="v">
                                            <td class="kd-smal">
                                                <span class="kd-pil">
                                                    <button type="button" title="Flytt opp" disabled="@(indeks == 0)" @onclick="@(() => FlyttVerdi(valgt, v, -1))">▲</button>
                                                    <button type="button" title="Flytt ned" disabled="@(indeks == synlige.Count - 1)" @onclick="@(() => FlyttVerdi(valgt, v, 1))">▼</button>
                                                </span>
                                            </td>
                                            <td><input class="kd-verdi" @bind="v.Verdi" @bind:event="oninput" @bind:after="@(() => valgt.Endret = true)" /></td>
                                            <td>
                                                @if (v.Id == 0)
                                                {
                                                    <span class="kd-bruk g">Ny</span>
                                                }
                                                else if (v.Brukt == 0)
                                                {
                                                    <span class="kd-bruk g">Ikke i bruk</span>
                                                }
                                                else
                                                {
                                                    <span class="kd-bruk">@v.Brukt @(v.Brukt == 1 ? "pakke" : "pakker")</span>
                                                }
                                            </td>
                                            <td class="kd-smal">
                                                <button type="button" class="kd-slett" disabled="@(v.Brukt > 0)"
                                                        title="@(v.Brukt > 0 ? $"Kan ikke slettes – brukt i {v.Brukt} {(v.Brukt == 1 ? "pakke" : "pakker")}" : "Slett verdi")"
                                                        @onclick="@(() => SlettVerdi(valgt, v))">
                                                    <Icon Name="x" />
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="kd-nyrad">
                                        <td class="kd-smal"></td>
                                        <td><input class="kd-verdi" @bind="valgt.NyVerdi" @bind:event="oninput" placeholder="＋ Ny verdi – trykk Enter"
                                                   @onkeydown="@(e => { if (e.Key == "Enter") { LeggTilVerdi(valgt); } })" /></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(valgt.NyVerdi))
                                            {
                                                <button type="button" class="kd-knapp" @onclick="@(() => LeggTilVerdi(valgt))">Legg til</button>
                                            }
                                        </td>
                                        <td class="kd-smal"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <div class="kd-fare">
                        <div>
                            <b>Slett kategori</b>
                            <span>@(valgt.Verdier.Any(v => v.Brukt > 0)
                                ? "Kan ikke slettes så lenge noen av verdiene brukes i dørpakker."
                                : "Kategorien og alle verdiene fjernes fra kravvelgeren.")</span>
                        </div>
                        @if (valgt.Verdier.Any(v => v.Brukt > 0))
                        {
                            <button type="button" class="kd-knapp fare" disabled><Icon Name="trash" />Slett</button>
                        }
                        else if (_bekreftSlettKategori)
                        {
                            <span class="kd-knapperad">
                                <button type="button" class="kd-knapp fare" @onclick="@(() => SlettKategori(valgt))">Ja, slett</button>
                                <button type="button" class="kd-knapp" @onclick="@(() => _bekreftSlettKategori = false)">Avbryt</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="kd-knapp fare" @onclick="@(() => _bekreftSlettKategori = true)"><Icon Name="trash" />Slett</button>
                        }
                    </div>
                }
                else
                {
                    <p class="kd-dempet">Velg en kategori i menyen.</p>
                }
            </div>
        </div>
    </div>

    @if (_dimensions.Any(d => d.Endret))
    {
        <div class="kd-lagrebar">
            <span><Icon Name="edit" /><b>Endringer i @_dimensions.Count(d => d.Endret) @(_dimensions.Count(d => d.Endret) == 1 ? "kategori" : "kategorier")</b> er ikke lagret</span>
            <span class="kd-knapperad">
                <button type="button" class="kd-knapp" @onclick="Forkast">Forkast</button>
                <button type="button" class="kd-knapp primaer" @onclick="LagreAlle"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class ValueDraft
    {
        public int Id { get; set; }
        public string Verdi { get; set; } = "";
        public int Brukt { get; set; }
        public bool Slettet { get; set; }
    }

    private sealed class DimensionDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public List<ValueDraft> Verdier { get; set; } = [];
        public string NyVerdi { get; set; } = "";
        public bool Endret { get; set; }
    }

    private List<DimensionDraft> _dimensions = [];
    private string _search = "";
    private int? _valgtId;
    private string _nyKategoriNavn = "";
    private string? _melding;
    private string? _feil;
    private bool _full;
    private bool _bekreftSlettKategori;

    private DimensionDraft? _valgt => _dimensions.FirstOrDefault(d => d.Id == _valgtId);

    private List<DimensionDraft> _filtrerte => string.IsNullOrWhiteSpace(_search)
        ? _dimensions
        : _dimensions.Where(d => d.Navn.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || d.Verdier.Any(v => v.Verdi.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("kravdimensjoner-bredde", "normal") == "full";
        await LoadAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("kravdimensjoner-bredde", _full ? "full" : "normal");
    }

    private static string IkonForDimensjon(string navn) => navn.Trim().ToLowerInvariant() switch
    {
        "type dør" => "box",
        "hvilke bruk" => "home",
        "fg-godkjenning" => "check-circle",
        "risikoklasse" => "alert",
        "lukkefunksjon" => "settings",
        "antall fløyer" => "grip",
        "type beslag" => "lock",
        "tilbakerømning" => "log-out",
        "postsonesylinder" => "shield",
        _ => "tag"
    };

    private async Task LoadAsync()
    {
        var dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        var bruk = await Db.PackageRequirements
            .GroupBy(pr => pr.RequirementValueId)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);

        _dimensions = dimensions.Select(d => new DimensionDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            Verdier = d.Verdier
                .OrderBy(v => v.Rekkefolge)
                .Select(v => new ValueDraft { Id = v.Id, Verdi = v.Verdi, Brukt = bruk.GetValueOrDefault(v.Id) })
                .ToList()
        }).ToList();

        if (_valgtId is null || _dimensions.All(d => d.Id != _valgtId))
        {
            _valgtId = _dimensions.FirstOrDefault()?.Id;
        }
    }

    private void LeggTilVerdi(DimensionDraft dim)
    {
        var tekst = dim.NyVerdi.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        dim.Verdier.Add(new ValueDraft { Id = 0, Verdi = tekst });
        dim.NyVerdi = "";
        dim.Endret = true;
    }

    private void FlyttVerdi(DimensionDraft dim, ValueDraft verdi, int retning)
    {
        var synlige = dim.Verdier.Where(v => !v.Slettet).ToList();
        var i = synlige.IndexOf(verdi);
        var j = i + retning;
        if (i < 0 || j < 0 || j >= synlige.Count)
        {
            return;
        }

        // Bytter plass med naboen i den fullstendige listen (slettede ligger igjen til lagring).
        var a = dim.Verdier.IndexOf(synlige[i]);
        var b = dim.Verdier.IndexOf(synlige[j]);
        (dim.Verdier[a], dim.Verdier[b]) = (dim.Verdier[b], dim.Verdier[a]);
        dim.Endret = true;
    }

    private void SlettVerdi(DimensionDraft dim, ValueDraft verdi)
    {
        if (verdi.Brukt > 0)
        {
            return;
        }

        if (verdi.Id == 0)
        {
            dim.Verdier.Remove(verdi);
        }
        else
        {
            verdi.Slettet = true;
        }

        dim.Endret = true;
    }

    // Rekkefølgen på kategoriene lagres med en gang - den er uavhengig av
    // endringene i lagre-linjen.
    private async Task FlyttTil(DimensionDraft dim, ChangeEventArgs valg)
    {
        var i = _dimensions.IndexOf(dim);
        if (i < 0 || !int.TryParse(valg.Value?.ToString(), out var j) || j < 0 || j >= _dimensions.Count || j == i)
        {
            return;
        }

        _dimensions.RemoveAt(i);
        _dimensions.Insert(j, dim);

        var ider = _dimensions.Select(d => d.Id).ToList();
        var entiteter = await Db.RequirementDimensions.Where(d => ider.Contains(d.Id)).ToListAsync();
        foreach (var e in entiteter)
        {
            e.Rekkefolge = ider.IndexOf(e.Id) + 1;
        }

        await Db.SaveChangesAsync();
        _melding = $"«{dim.Navn}» er flyttet til nr. {j + 1} i kravvelgeren.";
    }

    private async Task Forkast()
    {
        _feil = null;
        _melding = null;
        await LoadAsync();
    }

    private async Task LagreAlle()
    {
        _feil = null;
        var endrede = _dimensions.Where(d => d.Endret).ToList();

        if (endrede.Any(d => string.IsNullOrWhiteSpace(d.Navn)))
        {
            _feil = "Alle kategorier må ha et navn.";
            return;
        }

        if (endrede.Any(d => d.Verdier.Any(v => !v.Slettet && string.IsNullOrWhiteSpace(v.Verdi))))
        {
            _feil = "Verdier kan ikke stå tomme – skriv inn et navn eller slett verdien.";
            return;
        }

        foreach (var dim in endrede)
        {
            var dimension = await Db.RequirementDimensions
                .Include(d => d.Verdier)
                .FirstAsync(d => d.Id == dim.Id);

            dimension.Navn = dim.Navn.Trim();

            var rekkefolge = 1;
            foreach (var draft in dim.Verdier)
            {
                if (draft.Slettet)
                {
                    var entitet = dimension.Verdier.FirstOrDefault(v => v.Id == draft.Id);
                    // Sjekker bruken på nytt i tilfelle en pakke har fått verdien siden siden ble lastet.
                    if (entitet is not null && !await Db.PackageRequirements.AnyAsync(pr => pr.RequirementValueId == draft.Id))
                    {
                        Db.RequirementValues.Remove(entitet);
                    }

                    continue;
                }

                if (draft.Id == 0)
                {
                    dimension.Verdier.Add(new RequirementValue
                    {
                        RequirementDimensionId = dimension.Id,
                        Verdi = draft.Verdi.Trim(),
                        Rekkefolge = rekkefolge++
                    });
                }
                else
                {
                    var existing = dimension.Verdier.First(v => v.Id == draft.Id);
                    existing.Verdi = draft.Verdi.Trim();
                    existing.Rekkefolge = rekkefolge++;
                }
            }
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
        _melding = endrede.Count == 1 ? $"«{endrede[0].Navn.Trim()}» er lagret." : $"{endrede.Count} kategorier er lagret.";
    }

    private async Task SlettKategori(DimensionDraft dim)
    {
        _bekreftSlettKategori = false;
        var ider = dim.Verdier.Where(v => v.Id != 0).Select(v => v.Id).ToList();
        if (await Db.PackageRequirements.AnyAsync(pr => ider.Contains(pr.RequirementValueId)))
        {
            _feil = $"«{dim.Navn}» kan ikke slettes – noen av verdiene er i bruk på pakker.";
            await LoadAsync();
            return;
        }

        var dimension = await Db.RequirementDimensions.Include(d => d.Verdier).FirstOrDefaultAsync(d => d.Id == dim.Id);
        if (dimension is not null)
        {
            Db.RequirementValues.RemoveRange(dimension.Verdier);
            Db.RequirementDimensions.Remove(dimension);
            await Db.SaveChangesAsync();
        }

        _melding = $"«{dim.Navn}» er slettet.";
        _valgtId = null;
        await LoadAsync();
    }

    private async Task CreateDimension()
    {
        var navn = _nyKategoriNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var maxRekkefolge = await Db.RequirementDimensions.MaxAsync(d => (int?)d.Rekkefolge) ?? 0;

        var ny = new RequirementDimension
        {
            Navn = navn,
            Rekkefolge = maxRekkefolge + 1
        };
        Db.RequirementDimensions.Add(ny);

        await Db.SaveChangesAsync();

        _nyKategoriNavn = "";
        _melding = $"«{navn}» er opprettet. Legg til verdier under.";
        // Beholder ulagrede endringer i andre kategorier.
        var ulagret = _dimensions.Where(d => d.Endret).ToList();
        await LoadAsync();
        foreach (var d in ulagret)
        {
            var i = _dimensions.FindIndex(x => x.Id == d.Id);
            if (i >= 0)
            {
                _dimensions[i] = d;
            }
        }

        _valgtId = ny.Id;
    }
}
