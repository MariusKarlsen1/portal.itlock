@page "/kravdimensjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kravdimensjoner</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="tag" /></span>
        <div>
            <h1>Kravdimensjoner</h1>
            <p class="section-hint">Endre navn på kravkategoriene og verdiene under dem, eller legg til nye verdier. Endringer slår ut med én gang i kravvelgeren og på pakkedetaljer.</p>
        </div>
    </div>
</div>

<div class="krav-splitt">
    <div class="krav-liste-panel">
        <div class="krav-sok">
            <Icon Name="search" />
            <input @bind="_search" @bind:event="oninput" placeholder="Søk kategori..." />
        </div>

        <div class="krav-liste">
            @foreach (var dim in _filtrerte)
            {
                <button type="button" @key="dim.Id" class="krav-rad @(dim.Id == _valgtId ? "valgt" : "")" @onclick="@(() => _valgtId = dim.Id)">
                    <span class="krav-ikon"><Icon Name="@IkonForDimensjon(dim.Navn)" /></span>
                    <span class="krav-rad-navn">@dim.Navn</span>
                    <span class="krav-rad-antall">@dim.Verdier.Count</span>
                </button>
            }
            @if (_filtrerte.Count == 0)
            {
                <p class="list-empty">Ingen kategorier funnet.</p>
            }
        </div>

        <div class="krav-ny-kategori">
            <input @bind="_nyKategoriNavn" @bind:event="oninput" placeholder="Navn på ny kategori"
                   @onkeydown="@(async e => { if (e.Key == "Enter") { await CreateDimension(); } })" />
            <button type="button" class="knapp" @onclick="CreateDimension">+ Ny</button>
        </div>
        @if (!string.IsNullOrEmpty(_nyKategoriMelding))
        {
            <p class="save-success krav-ny-kategori-melding">@_nyKategoriMelding</p>
        }
    </div>

    @if (_valgt is { } valgt)
    {
        <div class="krav-detalj-panel">
            <div class="krav-detalj-header">
                <span class="krav-detalj-ikon"><Icon Name="@IkonForDimensjon(valgt.Navn)" /></span>
                <h2>@valgt.Navn</h2>
            </div>

            <label class="krav-felt">
                Navn på kategori
                <input @bind="valgt.Navn" @bind:event="oninput" />
            </label>

            <div class="krav-verdier">
                <span class="krav-verdier-label">Verdier</span>
                <div class="krav-verdi-liste">
                    @foreach (var v in valgt.Verdier)
                    {
                        <div @key="@(v.Id == 0 ? v.GetHashCode() : v.Id)" class="krav-verdi-rad">
                            <input @bind="v.Verdi" @bind:event="oninput" />
                            <button type="button" class="krav-slett-verdi" title="Slett verdi" @onclick="@(() => SlettVerdi(valgt, v))"><Icon Name="x" /></button>
                        </div>
                    }
                </div>
                <div class="krav-legg-til-verdi">
                    <input @bind="valgt.NyVerdi" @bind:event="oninput" placeholder="Ny verdi"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await AddValueAsync(valgt); } })" />
                    <button type="button" class="knapp" @onclick="@(() => AddValueAsync(valgt))">Legg til verdi</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(valgt.Melding))
            {
                <p class="save-success">@valgt.Melding</p>
            }

            <div class="krav-footer">
                <button type="button" class="knapp knapp-primaer" @onclick="@(() => SaveDimension(valgt))">Lagre endringer</button>
            </div>
        </div>
    }
</div>

@code {
    private sealed class ValueDraft
    {
        public int Id { get; set; }
        public string Verdi { get; set; } = "";
    }

    private sealed class DimensionDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public List<ValueDraft> Verdier { get; set; } = [];
        public string NyVerdi { get; set; } = "";
        public string? Melding { get; set; }
    }

    private List<DimensionDraft> _dimensions = [];
    private string _search = "";
    private int? _valgtId;
    private string _nyKategoriNavn = "";
    private string? _nyKategoriMelding;

    private DimensionDraft? _valgt => _dimensions.FirstOrDefault(d => d.Id == _valgtId);

    private List<DimensionDraft> _filtrerte => string.IsNullOrWhiteSpace(_search)
        ? _dimensions
        : _dimensions.Where(d => d.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private static string IkonForDimensjon(string navn) => navn.Trim().ToLowerInvariant() switch
    {
        "type dør" => "box",
        "hvilke bruk" => "home",
        "fg-godkjenning" => "check-circle",
        "risikoklasse" => "alert",
        "lukkefunksjon" => "settings",
        "antall fløyer" => "grip",
        "type beslag" => "lock",
        "tilbakerømning" => "log-out",
        "postsonesylinder" => "shield",
        _ => "tag"
    };

    private async Task LoadAsync()
    {
        var dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _dimensions = dimensions.Select(d => new DimensionDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            Verdier = d.Verdier
                .OrderBy(v => v.Rekkefolge)
                .Select(v => new ValueDraft { Id = v.Id, Verdi = v.Verdi })
                .ToList()
        }).ToList();

        if (_valgtId is null || _dimensions.All(d => d.Id != _valgtId))
        {
            _valgtId = _dimensions.FirstOrDefault()?.Id;
        }
    }

    private async Task AddValueAsync(DimensionDraft dim)
    {
        var text = dim.NyVerdi.Trim();
        if (text.Length == 0)
        {
            return;
        }

        dim.Verdier.Add(new ValueDraft { Id = 0, Verdi = text });
        dim.NyVerdi = "";
        await Task.CompletedTask;
    }

    private async Task SlettVerdi(DimensionDraft dim, ValueDraft v)
    {
        if (v.Id == 0)
        {
            dim.Verdier.Remove(v);
            return;
        }

        var brukt = await Db.PackageRequirements.CountAsync(pr => pr.RequirementValueId == v.Id);
        if (brukt > 0)
        {
            dim.Melding = $"Kan ikke slette \"{v.Verdi}\" - brukt på {brukt} pakke{(brukt == 1 ? "" : "r")}.";
            return;
        }

        var entity = await Db.RequirementValues.FindAsync(v.Id);
        if (entity is not null)
        {
            Db.RequirementValues.Remove(entity);
            await Db.SaveChangesAsync();
        }

        dim.Verdier.Remove(v);
        dim.Melding = "Slettet.";
    }

    private async Task SaveDimension(DimensionDraft dim)
    {
        var dimension = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .FirstAsync(d => d.Id == dim.Id);

        dimension.Navn = dim.Navn.Trim();

        var nextRekkefolge = dimension.Verdier.Count == 0 ? 1 : dimension.Verdier.Max(v => v.Rekkefolge) + 1;

        foreach (var draft in dim.Verdier)
        {
            if (draft.Id == 0)
            {
                dimension.Verdier.Add(new RequirementValue
                {
                    RequirementDimensionId = dimension.Id,
                    Verdi = draft.Verdi.Trim(),
                    Rekkefolge = nextRekkefolge++
                });
            }
            else
            {
                var existing = dimension.Verdier.First(v => v.Id == draft.Id);
                existing.Verdi = draft.Verdi.Trim();
            }
        }

        await Db.SaveChangesAsync();

        await LoadAsync();
        var reloaded = _dimensions.FirstOrDefault(d => d.Id == dim.Id);
        if (reloaded is not null)
        {
            reloaded.Melding = "Lagret.";
        }
    }

    private async Task CreateDimension()
    {
        var navn = _nyKategoriNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var maxRekkefolge = await Db.RequirementDimensions.MaxAsync(d => (int?)d.Rekkefolge) ?? 0;

        var ny = new RequirementDimension
        {
            Navn = navn,
            Rekkefolge = maxRekkefolge + 1
        };
        Db.RequirementDimensions.Add(ny);

        await Db.SaveChangesAsync();

        _nyKategoriNavn = "";
        _nyKategoriMelding = null;
        await LoadAsync();
        _valgtId = ny.Id;
    }
}
