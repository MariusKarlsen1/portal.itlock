@page "/kravdimensjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kravdimensjoner</PageTitle>

<h1>Kravdimensjoner</h1>
<p>Endre navn på kravkategoriene og verdiene under dem, eller legg til nye verdier. Endringer slår ut med én gang i kravvelgeren og på pakkedetaljer.</p>

<div class="dim-list">
    @foreach (var dim in _dimensions)
    {
        <details class="dim-group">
            <summary>
                <span class="dim-name">@dim.Navn</span>
                <span class="dim-count">@dim.Verdier.Count verdier</span>
            </summary>
            <div class="dim-body">
                <label>
                    Navn på kategori
                    <input @bind="dim.Navn" @bind:event="oninput" />
                </label>

                <h4>Verdier</h4>
                <ul class="value-list">
                    @foreach (var v in dim.Verdier)
                    {
                        <li>
                            <input @bind="v.Verdi" @bind:event="oninput" />
                        </li>
                    }
                </ul>

                <div class="add-value">
                    <input @bind="dim.NyVerdi" @bind:event="oninput" placeholder="Ny verdi" />
                    <button type="button" class="add-button" @onclick="@(() => AddValue(dim))">Legg til verdi</button>
                </div>

                @if (!string.IsNullOrEmpty(dim.Melding))
                {
                    <p class="save-success">@dim.Melding</p>
                }

                <button type="button" class="save-button" @onclick="@(() => SaveDimension(dim))">Lagre endringer</button>
            </div>
        </details>
    }
</div>

<div class="new-dim">
    <h2>Opprett ny kravkategori</h2>
    <p>Bruk dette hvis du vil skille på noe som ikke er dekket av kategoriene over.</p>
    <div class="new-dim-form">
        <input @bind="_nyKategoriNavn" @bind:event="oninput" placeholder="Navn på ny kategori" />
        <button type="button" class="add-button" @onclick="CreateDimension">Opprett kategori</button>
    </div>
    @if (!string.IsNullOrEmpty(_nyKategoriMelding))
    {
        <p class="save-success">@_nyKategoriMelding</p>
    }
</div>

@code {
    private sealed class ValueDraft
    {
        public int Id { get; set; }
        public string Verdi { get; set; } = "";
    }

    private sealed class DimensionDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public List<ValueDraft> Verdier { get; set; } = [];
        public string NyVerdi { get; set; } = "";
        public string? Melding { get; set; }
    }

    private List<DimensionDraft> _dimensions = [];
    private string _nyKategoriNavn = "";
    private string? _nyKategoriMelding;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var dimensions = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _dimensions = dimensions.Select(d => new DimensionDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            Verdier = d.Verdier
                .OrderBy(v => v.Rekkefolge)
                .Select(v => new ValueDraft { Id = v.Id, Verdi = v.Verdi })
                .ToList()
        }).ToList();
    }

    private void AddValue(DimensionDraft dim)
    {
        var text = dim.NyVerdi.Trim();
        if (text.Length == 0)
        {
            return;
        }

        dim.Verdier.Add(new ValueDraft { Id = 0, Verdi = text });
        dim.NyVerdi = "";
    }

    private async Task SaveDimension(DimensionDraft dim)
    {
        var dimension = await Db.RequirementDimensions
            .Include(d => d.Verdier)
            .FirstAsync(d => d.Id == dim.Id);

        dimension.Navn = dim.Navn.Trim();

        var nextRekkefolge = dimension.Verdier.Count == 0 ? 1 : dimension.Verdier.Max(v => v.Rekkefolge) + 1;

        foreach (var draft in dim.Verdier)
        {
            if (draft.Id == 0)
            {
                dimension.Verdier.Add(new RequirementValue
                {
                    RequirementDimensionId = dimension.Id,
                    Verdi = draft.Verdi.Trim(),
                    Rekkefolge = nextRekkefolge++
                });
            }
            else
            {
                var existing = dimension.Verdier.First(v => v.Id == draft.Id);
                existing.Verdi = draft.Verdi.Trim();
            }
        }

        await Db.SaveChangesAsync();

        await LoadAsync();
        var reloaded = _dimensions.FirstOrDefault(d => d.Id == dim.Id);
        if (reloaded is not null)
        {
            reloaded.Melding = "Lagret.";
        }
    }

    private async Task CreateDimension()
    {
        var navn = _nyKategoriNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var maxRekkefolge = await Db.RequirementDimensions.MaxAsync(d => (int?)d.Rekkefolge) ?? 0;

        Db.RequirementDimensions.Add(new RequirementDimension
        {
            Navn = navn,
            Rekkefolge = maxRekkefolge + 1
        });

        await Db.SaveChangesAsync();

        _nyKategoriNavn = "";
        _nyKategoriMelding = $"Kategorien \"{navn}\" er opprettet. Fold den ut over for å legge til verdier.";
        await LoadAsync();
    }
}
