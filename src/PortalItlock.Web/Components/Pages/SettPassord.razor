@page "/sett-passord"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Sett passord - itlock</PageTitle>

<div class="login-card">
    <h1>Sett passord</h1>
    <p class="sett-passord-hint">Skriv inn e-posten din for å sette passord første gang, eller etter at en admin har nullstilt det.</p>

    @if (Feil is not null)
    {
        <p class="login-error">@Feil</p>
    }

    <form method="post" action="/account/sett-passord">
        <label>
            E-post
            <input type="email" name="epost" required autofocus />
        </label>
        <label>
            Nytt passord (minst 8 tegn)
            <input type="password" name="passord" required minlength="8" />
        </label>
        <label>
            Bekreft passord
            <input type="password" name="bekreft" required minlength="8" />
        </label>
        <button type="submit">Sett passord</button>
    </form>

    <a class="sett-passord-tilbake" href="/login">Tilbake til innlogging</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "feil")]
    public string? FeilKode { get; set; }

    private string? Feil => FeilKode switch
    {
        "finnes-ikke" => "Fant ingen bruker med denne e-posten. Kontakt admin.",
        "allerede-satt" => "Passord er allerede satt for denne kontoen. Be en admin nullstille det.",
        "ugyldig" => "Passordet må være minst 8 tegn, og de to feltene må være like.",
        _ => null
    };
}
