@page "/kalender"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Kalender</PageTitle>

<div class="kal-side">

    <header class="kal-topp">
        <div class="kal-topp-tekst">
            <h1>Kalender</h1>
            <p>Oversikt over montører, oppdrag, fravær og viktige hendelser.</p>
        </div>
        <button type="button" class="kal-ny-knapp" @onclick="@(() => AapneNyHendelse(null, _valgtDato))">
            <Icon Name="plus" />Ny hendelse
        </button>
    </header>

    @* Øverste rad: hurtigfaner, søk og de tre nedtrekkene. Alt ligger utenfor
       kortet, på sidens egen bakgrunn, slik referansen viser. *@
    <div class="kal-verktoylinje">
        <div class="kal-faner">
            @foreach (var (nokkel, navn, ikon) in Faner)
            {
                <button type="button" class="@(_fane == nokkel ? "aktiv" : "")" @onclick="@(() => VelgFane(nokkel))">
                    @if (ikon is not null)
                    {
                        <Icon Name="@ikon" />
                    }
                    @navn
                </button>
            }
        </div>

        <label class="kal-sokefelt">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" placeholder="Søk i kalender …" />
        </label>

        <label class="kal-velgerfelt">
            <Icon Name="users" />
            <select @bind="_valgtMontorId" @bind:after="LastAsync">
                <option value="">Alle montører</option>
                @foreach (var m in _ansatte)
                {
                    <option value="@m.Id">@m.Navn</option>
                }
            </select>
            <Icon Name="chevron-down" />
        </label>

        <label class="kal-velgerfelt">
            <Icon Name="folder" />
            <select @bind="_valgtProsjektId" @bind:after="LastAsync">
                <option value="">Alle prosjekter</option>
                @foreach (var p in _prosjekter)
                {
                    <option value="@p.Id">@p.Navn</option>
                }
            </select>
            <Icon Name="chevron-down" />
        </label>

        <label class="kal-velgerfelt">
            <select @bind="_typeFilter" @bind:after="LastAsync">
                <option value="alle">Alle typer</option>
                <option value="arbeidsordre">Arbeidsordre</option>
                <option value="ressurs">Hendelser</option>
            </select>
            <Icon Name="chevron-down" />
        </label>

        <div class="kal-filter-wrap">
            <button type="button" class="kal-filterknapp @(_visFilter ? "aktiv" : "")" @onclick="@(() => _visFilter = !_visFilter)">
                <Icon Name="filter" />Flere filtre
            </button>
            @if (_visFilter)
            {
                <div class="kal-filterpanel">
                    <label>
                        <span>Avdeling</span>
                        <select @bind="_avdelingFilter">
                            <option value="">Alle avdelinger</option>
                            @foreach (var a in Avdelinger)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                    </label>
                    <a class="kal-filter-lenke" href="/min-dag"><Icon Name="calendar" />Se min dag</a>
                </div>
            }
        </div>
    </div>

    @if (_laster)
    {
        <p class="list-empty">Laster...</p>
    }
    else
    {
        <div class="kal-hovedgrid">
            <div class="kal-hoved">
                @* Periodelinja ligger øverst i det samme kortet som rutenettet,
                   uansett hvilken visning som er valgt. *@
                <div class="kal-periodelinje">
                    <button type="button" class="kal-idag" @onclick="GaTilIDag">I dag</button>
                    <div class="kal-nav">
                        <button type="button" class="kal-navknapp" @onclick="Forrige" aria-label="Forrige"><Icon Name="chevron-left" /></button>
                        <button type="button" class="kal-navknapp" @onclick="Neste" aria-label="Neste"><Icon Name="chevron-right" /></button>
                    </div>
                    <span class="kal-periodetittel">@PeriodeLabel</span>
                    <div class="kal-visningtoggle">
                        <button type="button" class="@(_visning == "dag" ? "aktiv" : "")" @onclick="@(() => SettVisning("dag"))">Dag</button>
                        <button type="button" class="@(_visning == "uke" ? "aktiv" : "")" @onclick="@(() => SettVisning("uke"))">Uke</button>
                        <button type="button" class="@(_visning == "maned" ? "aktiv" : "")" @onclick="@(() => SettVisning("maned"))">Måned</button>
                        <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick="@(() => SettVisning("liste"))">Liste</button>
                    </div>
                    <button type="button" class="kal-idag-ikon" title="Gå til i dag" @onclick="GaTilIDag"><Icon Name="calendar" /></button>
                </div>

                @if (_visning == "maned")
                {
                    @* Månedsvisningen bruker de samme blokkene og de samme
                       brikkene som ukevisningen, slik at en jobb ser lik ut
                       uansett hvilken visning man står i. Ukenummeret står i
                       sin egen smale kolonne til venstre. *@
                    <div class="kal-manedsgrid-wrap">
                        <div class="kal-manedsgrid">
                            <div class="kal-manedsgrid-hode">
                                <span class="kal-ukenr-hode"></span>
                                @foreach (var dagnavn in Ukedagnavn)
                                {
                                    <span class="kal-manedsdag-hode">@dagnavn</span>
                                }
                            </div>

                            @foreach (var uke in _dager.Chunk(7))
                            {
                                <div class="kal-manedsuke" @key="uke[0].Dato">
                                    <span class="kal-ukenr">@ISOWeek.GetWeekOfYear(uke[0].Dato)</span>
                                    @foreach (var dag in uke)
                                    {
                                        var helligdag = NorskHelligdag.Navn(dag.Dato);
                                        var dagensBlokker = BlokkerForDag(dag.Dato);
                                        <div class="kal-manedsdag @(dag.Dato.Month != _visningsManed.Month ? "utenfor" : "") @(dag.Dato == DateTime.Today ? "idag" : "") @(_dragOverDato == dag.Dato ? "dragover" : "") @(helligdag is not null || NorskHelligdag.ErSondag(dag.Dato) ? "rod" : "")"
                                             @ondragover="@(() => { })" @ondragover:preventDefault="true"
                                             @ondragenter="@(() => _dragOverDato = dag.Dato)"
                                             @ondragleave="@(() => _dragOverDato = null)"
                                             @ondrop="@(() => OnDropAsync(dag.Dato))"
                                             @oncontextmenu="@(() => AapneNyHendelse(null, dag.Dato))"
                                             @oncontextmenu:preventDefault="true">
                                            <div class="kal-manedsdag-topp">
                                                <span class="kal-manedsdag-tall">@dag.Dato.Day</span>
                                                @if (helligdag is not null)
                                                {
                                                    <span class="kal-helligdag">@helligdag</span>
                                                }
                                                <button type="button" class="kal-manedsdag-ny" title="Ny hendelse" @onclick:stopPropagation="true" @onclick="@(() => AapneNyHendelse(null, dag.Dato))"><Icon Name="plus" /></button>
                                            </div>

                                            @foreach (var b in dagensBlokker.Take(3))
                                            {
                                                <button type="button" @key="b.Nokkel"
                                                        class="kal-ukeblokk kal-manedsblokk"
                                                        style="background:@b.Farge.Flate; border-left-color:@b.Farge.Kant; color:@b.Farge.Blekk"
                                                        draggable="@(b.ArbeidsordreId is not null)"
                                                        @ondragstart="@(() => _draggingOrdreId = b.ArbeidsordreId)"
                                                        @onclick="@(() => VelgAktivitet(b))"
                                                        @oncontextmenu="@(() => AapneRedigerHendelse(b))"
                                                        @oncontextmenu:preventDefault="true"
                                                        @oncontextmenu:stopPropagation="true">
                                                    <span class="kal-ukeblokk-topp">
                                                        <span class="kal-ukeblokk-ikon"><Icon Name="@b.Ikon" /></span>
                                                        <span class="kal-ukeblokk-tid">@b.TidTekst</span>
                                                    </span>
                                                    <span class="kal-ukeblokk-tittel">@b.KortTittel</span>
                                                </button>
                                            }

                                            @if (dagensBlokker.Count > 3)
                                            {
                                                <button type="button" class="kal-manedsdag-flere" @onclick:stopPropagation="true" @onclick="@(() => VisDag(dag.Dato))">+@(dagensBlokker.Count - 3) til</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_visning == "dag")
                {
                    <div class="kal-ressursgrid-wrap">
                        <div class="kal-ressursgrid">
                            <div class="kal-ressurs-hode">
                                <div class="kal-ansatt-hode">Ansatte</div>
                                <div class="kal-timehode">
                                    @for (var t = DagStartTime; t <= DagSluttTime; t++)
                                    {
                                        <span class="kal-timehode-celle">@t.ToString("00"):00</span>
                                    }
                                    @if (ErIDag)
                                    {
                                        <span class="kal-na-merke" style="left:@NaProsent.ToString(Invariant)%">@DateTime.Now.ToString(@"HH\:mm")</span>
                                    }
                                </div>
                            </div>

                            @foreach (var ansatt in SynligeAnsatte)
                            {
                                <div class="kal-ressursrad" @key="ansatt.Id">
                                    <div class="kal-ansatt">
                                        <span class="kal-avatar" style="background:@FargeForMontor(ansatt.Id)">@ansatt.Initialer</span>
                                        <span class="kal-ansatt-tekst">
                                            <span class="kal-ansatt-navn">@ansatt.Navn</span>
                                            <span class="kal-ansatt-rolle">@ansatt.Stilling</span>
                                        </span>
                                    </div>
                                    <div class="kal-spor"
                                         @oncontextmenu="@(() => AapneNyHendelse(ansatt.Id, _valgtDato))"
                                         @oncontextmenu:preventDefault="true">
                                        @for (var t = DagStartTime; t <= DagSluttTime; t++)
                                        {
                                            <span class="kal-sporlinje" style="left:@TimeProsent(t).ToString(Invariant)%"></span>
                                        }
                                        @if (ErIDag)
                                        {
                                            <span class="kal-na-linje" style="left:@NaProsent.ToString(Invariant)%"></span>
                                        }
                                        @foreach (var b in BlokkerFor(ansatt.Id))
                                        {
                                            <button type="button" @key="b.Nokkel"
                                                    class="kal-akt @(_valgtAktivitet?.Nokkel == b.Nokkel ? "valgt" : "")"
                                                    style="left:@TimeProsent(b.FraTimer).ToString(Invariant)%; width:@BreddeProsent(b).ToString(Invariant)%; background:@b.Farge.Flate; border-left-color:@b.Farge.Kant; color:@b.Farge.Blekk"
                                                    @onclick="@(() => VelgAktivitet(b))"
                                                    @oncontextmenu="@(() => AapneRedigerHendelse(b))"
                                                    @oncontextmenu:preventDefault="true"
                                                    @oncontextmenu:stopPropagation="true">
                                                <span class="kal-akt-ikon"><Icon Name="@b.Ikon" /></span>
                                                <span class="kal-akt-tekst">
                                                    <span class="kal-akt-tittel">@b.Tittel</span>
                                                    @if (b.Undertekst is not null)
                                                    {
                                                        <span class="kal-akt-sub">@b.Undertekst</span>
                                                    }
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (SynligeAnsatte.Count == 0)
                            {
                                <p class="list-empty">Ingen ansatte å vise.</p>
                            }
                        </div>
                    </div>
                }
                else if (_visning == "uke")
                {
                    @* Ukevisningen er det samme ressursrutenettet som dagvisningen,
                       men med sju dagkolonner i stedet for en tidsakse: én rad pr.
                       montør, én rute pr. dag. Høyreklikk i en rute legger inn en
                       hendelse manuelt - arbeidsordrene legger seg selv inn ut fra
                       planlagt dato og ansvarlig montør. *@
                    <div class="kal-ukegrid-wrap">
                        <div class="kal-ukegrid">
                            <div class="kal-ukegrid-hode">
                                <div class="kal-ukegrid-hjorne">
                                    <span>Montører (@SynligeAnsatte.Count)</span>
                                    <button type="button" class="kal-hjorne-ny" title="Ny hendelse" @onclick="@(() => AapneNyHendelse(null, _valgtDato))"><Icon Name="plus" /></button>
                                </div>
                                @foreach (var dag in UkensDager)
                                {
                                    <div class="kal-ukedag-hode @(dag.Date == DateTime.Today ? "idag" : "")">
                                        <span class="kal-ukedag-navn">@StorForbokstav(dag.ToString("ddd", Kultur).TrimEnd('.'))</span>
                                        <span class="kal-ukedag-dato">@dag.Day. @dag.ToString("MMM", Kultur).TrimEnd('.')</span>
                                    </div>
                                }
                            </div>

                            @foreach (var ansatt in SynligeAnsatte)
                            {
                                <div class="kal-ukerad" @key="ansatt.Id">
                                    <div class="kal-ansatt">
                                        <span class="kal-avatar" style="background:@FargeForMontor(ansatt.Id)">@ansatt.Initialer</span>
                                        <span class="kal-ansatt-tekst">
                                            <span class="kal-ansatt-navn">@ansatt.Navn</span>
                                            <span class="kal-ansatt-rolle">@ansatt.Stilling</span>
                                        </span>
                                    </div>
                                    @foreach (var dag in UkensDager)
                                    {
                                        <div class="kal-ukecelle @(dag.Date == DateTime.Today ? "idag" : "")"
                                             @oncontextmenu="@(() => AapneNyHendelse(ansatt.Id, dag))"
                                             @oncontextmenu:preventDefault="true">
                                            @foreach (var b in BlokkerFor(ansatt.Id, dag))
                                            {
                                                @* Brikka og "..."-knappen er sosken og ikke nostet, for en
                                                   knapp inni en knapp er ugyldig. *@
                                                <div class="kal-ukeblokk-wrap" @key="b.Nokkel">
                                                    <button type="button"
                                                            class="kal-ukeblokk @(_valgtAktivitet?.Nokkel == b.Nokkel ? "valgt" : "")"
                                                            style="background:@b.Farge.Flate; border-left-color:@b.Farge.Kant; color:@b.Farge.Blekk"
                                                            @onclick="@(() => VelgAktivitet(b))"
                                                            @oncontextmenu="@(() => AapneRedigerHendelse(b))"
                                                            @oncontextmenu:preventDefault="true"
                                                            @oncontextmenu:stopPropagation="true">
                                                        <span class="kal-ukeblokk-topp">
                                                            <span class="kal-ukeblokk-ikon"><Icon Name="@b.Ikon" /></span>
                                                            <span class="kal-ukeblokk-tid">@b.TidTekst</span>
                                                        </span>
                                                        <span class="kal-ukeblokk-tittel">@b.KortTittel</span>
                                                        @if (b.KortUnder is not null)
                                                        {
                                                            <span class="kal-ukeblokk-sub">@b.KortUnder</span>
                                                        }
                                                    </button>
                                                    <button type="button" class="kal-ukeblokk-meny"
                                                            title="@(b.RessursplanId is null ? "Åpne arbeidsordren" : "Rediger hendelsen")"
                                                            @onclick="@(() => AapneRedigerHendelse(b))"
                                                            @onclick:stopPropagation="true">
                                                        <Icon Name="more-horizontal" />
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (SynligeAnsatte.Count == 0)
                            {
                                <p class="list-empty">Ingen montører å vise.</p>
                            }
                        </div>
                    </div>
                }
                else if (_visning == "liste")
                {
                    <div class="kort kal-tabellkort">
                        <div class="kal-tabellheader">
                            <h2>Kommende arbeidsordre (@TabellRader.Count)</h2>
                            <div class="kal-tabellfilter">
                                <button type="button" class="@(_tabellStatusFilter == "alle" ? "aktiv" : "")" @onclick="@(() => _tabellStatusFilter = "alle")">Alle (@_alleArbeidsordreIPeriode.Count)</button>
                                <button type="button" class="@(_tabellStatusFilter == "ikke-startet" ? "aktiv" : "")" @onclick="@(() => _tabellStatusFilter = "ikke-startet")">Ikke startet (@_alleArbeidsordreIPeriode.Count(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar))</button>
                                <button type="button" class="@(_tabellStatusFilter == "pagar" ? "aktiv" : "")" @onclick="@(() => _tabellStatusFilter = "pagar")">Pågår (@_alleArbeidsordreIPeriode.Count(a => a.Status == ArbeidsordreStatus.Pagaende))</button>
                                <button type="button" class="@(_tabellStatusFilter == "ferdig" ? "aktiv" : "")" @onclick="@(() => _tabellStatusFilter = "ferdig")">Ferdig (@_alleArbeidsordreIPeriode.Count(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert))</button>
                            </div>
                        </div>
                        @if (TabellRader.Count == 0)
                        {
                            <p class="list-empty">Ingen kommende arbeidsordre de neste 90 dagene.</p>
                        }
                        else
                        {
                            <table class="kal-tabell">
                                <thead>
                                    <tr><th>#</th><th>Tittel</th><th>Kunde</th><th>Dato</th><th>Tid</th><th>Ansvarlig</th><th>Status</th><th>Type</th><th>Prosjekt</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in TabellRader)
                                    {
                                        <tr @key="o.Id">
                                            <td>#@o.Id</td>
                                            <td><a href="@($"/arbeidsordre/{o.Id}")">@o.Tittel</a></td>
                                            <td>@(o.KundeNavn ?? "-")</td>
                                            <td>@o.Start?.ToString("dd.MM.yyyy")</td>
                                            <td>@o.TidTekst</td>
                                            <td>@(o.MontorNavn ?? "Ikke tildelt")</td>
                                            <td><StatusPill Tekst="@o.Status.Visningsnavn()" Ikon="@o.Status.PillIkon()" Farge="@o.Status.PillFarge()" /></td>
                                            <td>@(o.Type?.Visningsnavn() ?? "-")</td>
                                            <td>@(o.ProsjektNavn ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>

            <div class="kal-sidebar">
                @if (_visning == "dag" && _valgtAktivitet is not null)
                {
                    var a = _valgtAktivitet;
                    <div class="kal-detalj">
                        <div class="kal-detalj-topp">
                            <h2>@a.Tittel</h2>
                            <button type="button" class="kal-detalj-lukk" aria-label="Lukk" @onclick="@(() => _valgtAktivitet = null)"><Icon Name="x" /></button>
                        </div>
                        <div class="kal-detalj-undertittel">
                            <span>@a.Undertekst</span>
                            @if (a.StatusTekst is not null)
                            {
                                <span class="kal-detalj-status" style="background:@a.Farge.Flate; color:@a.Farge.Blekk">@a.StatusTekst</span>
                            }
                        </div>

                        <ul class="kal-detalj-fakta">
                            <li><Icon Name="clock" />@a.TidTekst</li>
                            <li><Icon Name="calendar" />@DetaljDato</li>
                            @if (a.Adresse is not null)
                            {
                                <li><Icon Name="map-pin" />@a.Adresse</li>
                            }
                        </ul>

                        @if (a.Deltakere.Count > 0)
                        {
                            <div class="kal-detalj-deltakere">
                                @foreach (var d in a.Deltakere)
                                {
                                    <span class="kal-avatar kal-avatar-stor" style="background:@FargeForMontor(d.Id)" title="@d.Navn">@d.Initialer</span>
                                }
                            </div>
                        }

                        @if (a.ArbeidsordreId is not null)
                        {
                            <div class="kal-detalj-knapper">
                                <a class="kal-detalj-knapp" href="@($"/arbeidsordre/{a.ArbeidsordreId}")"><Icon Name="folder" />Åpne arbeidsordre</a>
                                <a class="kal-detalj-knapp" href="@($"/arbeidsordre/{a.ArbeidsordreId}")"><Icon Name="edit" />Rediger</a>
                            </div>
                        }

                        <div class="kal-detalj-faner">
                            <button type="button" class="@(_detaljFane == "detaljer" ? "aktiv" : "")" @onclick='@(() => _detaljFane = "detaljer")'>Detaljer</button>
                            <button type="button" class="@(_detaljFane == "sjekkliste" ? "aktiv" : "")" @onclick='@(() => _detaljFane = "sjekkliste")'>Sjekkliste</button>
                            <button type="button" class="@(_detaljFane == "filer" ? "aktiv" : "")" @onclick='@(() => _detaljFane = "filer")'>Filer (@a.AntallFiler)</button>
                        </div>

                        @if (_detaljFane == "sjekkliste")
                        {
                            @if (a.Sjekkpunkter.Count == 0)
                            {
                                <p class="kal-detalj-tom">Ingen sjekkpunkter på denne arbeidsordren.</p>
                            }
                            else
                            {
                                <ul class="kal-detalj-sjekkliste">
                                    @foreach (var p in a.Sjekkpunkter)
                                    {
                                        <li class="@(p.Fullfort ? "fullfort" : "")">
                                            <Icon Name="@(p.Fullfort ? "check-circle" : "circle")" />@p.Tekst
                                        </li>
                                    }
                                </ul>
                            }
                        }
                        else if (_detaljFane == "filer")
                        {
                            @if (a.AntallFiler == 0)
                            {
                                <p class="kal-detalj-tom">Ingen filer lastet opp.</p>
                            }
                            else
                            {
                                <p class="kal-detalj-tom">@a.AntallFiler fil(er) ligger på arbeidsordren.</p>
                                <a class="kal-detalj-knapp" href="@($"/arbeidsordre/{a.ArbeidsordreId}")"><Icon Name="folder" />Se filene</a>
                            }
                        }
                        else
                        {
                            <div class="kal-detalj-lokasjon">
                                <div class="kal-detalj-lokasjon-topp">
                                    <h3>Lokasjon</h3>
                                    @if (a.Adresse is not null)
                                    {
                                        <a href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(a.Adresse)}")" target="_blank" aria-label="Åpne i kart"><Icon Name="chevron-right" /></a>
                                    }
                                </div>
                                <div class="kal-detalj-kart">
                                    @if (a.Latitude is not null && a.Longitude is not null)
                                    {
                                        <div class="kal-detalj-kartflate" id="kal-detalj-kart" @key="a.Nokkel"></div>
                                    }
                                    else
                                    {
                                        <div class="kal-detalj-kartflate kal-detalj-kart-tom"><Icon Name="map-pin" /></div>
                                    }
                                    <span class="kal-detalj-kartkort">
                                        <strong>@(a.ArbeidsordreId is null ? a.Tittel : $"AO-{a.ArbeidsordreId}")</strong>
                                        <span>@(a.ProsjektNavn ?? a.Undertekst)</span>
                                    </span>
                                </div>
                                <div class="kal-detalj-lokasjon-fot">
                                    <span>@(a.Adresse ?? "Ingen adresse registrert")</span>
                                    @if (a.Adresse is not null)
                                    {
                                        <a class="kal-detalj-knapp" href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(a.Adresse)}")" target="_blank"><Icon Name="map-pin" />Åpne i kart</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_visning == "dag")
                {
                    <div class="kal-detalj kal-detalj-tomtilstand">
                        <Icon Name="calendar" />
                        <h2>Ingen aktivitet valgt</h2>
                        <p>Klikk på en aktivitet i tidslinjen for å se detaljer, sjekkliste, filer og lokasjon.</p>
                    </div>
                }

                <div class="kort kal-minikalender-kort">
                    <div class="kal-minikal-header">
                        <button type="button" @onclick="MinikalForrigeManed"><Icon Name="arrow-left" /></button>
                        <span>@Kultur.TextInfo.ToTitleCase(_minikalManed.ToString("MMMM yyyy", Kultur))</span>
                        <button type="button" class="kal-neste" @onclick="MinikalNesteManed"><Icon Name="arrow-left" /></button>
                    </div>
                    <div class="kal-minikal-ukedager">
                        @foreach (var d in Ukedagnavn)
                        {
                            <span>@d[0]</span>
                        }
                    </div>
                    <div class="kal-minikal-grid">
                        @foreach (var dag in MinikalenderDager)
                        {
                            @if (dag is null)
                            {
                                <span class="kal-minikal-tom"></span>
                            }
                            else
                            {
                                <button type="button"
                                        class="kal-minikal-dag @(dag.Value.Date == DateTime.Today ? "idag" : "") @(dag.Value.Date == _valgtDato.Date ? "valgt" : "") @(ErIVistUke(dag.Value) ? "i-uke" : "")"
                                        @onclick="@(() => VelgDato(dag.Value))">
                                    @dag.Value.Day
                                    @if (_dagerMedAktivitet.Contains(dag.Value.Date))
                                    {
                                        <span class="kal-minikal-prikk"></span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="kort kal-hurtig-kort">
                    <h3>Hurtighandlinger</h3>
                    <div class="kal-hurtig-rutenett">
                        <a class="kal-hurtig-knapp" href="/arbeidsordre/ny"><Icon Name="plus" />Ny arbeidsordre</a>
                        <button type="button" class="kal-hurtig-knapp" @onclick="@(() => AapneNyHendelse(null, _valgtDato))"><Icon Name="calendar" />Ny hendelse</button>
                        <a class="kal-hurtig-knapp" href="/fravar"><Icon Name="sun" />Søk om fravær</a>
                        <a class="kal-hurtig-knapp" href="/fravar"><Icon Name="list" />Se fravær</a>
                    </div>
                </div>

                <div class="kort kal-filter-kort">
                    <div class="kal-filter-kort-topp">
                        <h3>Filter</h3>
                        <button type="button" class="kal-filter-nullstill" @onclick="NullstillSidefilter">Nullstill</button>
                    </div>

                    <p class="kal-filter-gruppe">Vis i kalender</p>
                    @foreach (var (nokkel, navn, farge) in KalenderKategori.Alle)
                    {
                        <label class="kal-filter-rad" @key="nokkel">
                            <input type="checkbox" style="accent-color:@farge" checked="@(!_skjulteTyper.Contains(nokkel))" @onchange="@(() => ToggleType(nokkel))" />
                            @navn
                        </label>
                    }

                    <p class="kal-filter-gruppe">Vis montører</p>
                    <label class="kal-filter-sok">
                        <Icon Name="search" />
                        <input @bind="_montorSok" @bind:event="oninput" placeholder="Søk montør …" />
                    </label>
                    <div class="kal-filter-montorliste">
                        @foreach (var m in MontorerIFilter)
                        {
                            <label class="kal-filter-rad" @key="m.Id">
                                <input type="checkbox" checked="@(!_skjulteMontorer.Contains(m.Id))" @onchange="@(() => ToggleMontor(m.Id))" />
                                @m.Navn
                            </label>
                        }
                        @if (MontorerIFilter.Count == 0)
                        {
                            <p class="kal-filter-tom">Ingen treff.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@if (_visHendelseSkjema)
{
    <div class="kal-modal-overlay" @onclick="LukkHendelseSkjema">
        <div class="kal-modal" @onclick:stopPropagation="true">
            <h2>@(_hendelseId is null ? "Ny hendelse" : "Rediger hendelse")</h2>
            <p class="kal-modal-hjelp">
                Arbeidsordre legger seg selv inn i kalenderen ut fra planlagt dato og ansvarlig montør.
                Her legger du inn alt det andre - møter, kjøring, opplæring og internt arbeid.
            </p>

            <label class="kal-modal-felt">
                Tittel
                <input @bind="_hendelseTittel" placeholder="F.eks. Opplæring – kontor" />
            </label>

            <div class="kal-modal-par">
                <label class="kal-modal-felt">
                    Type
                    <select @bind="_hendelseKategori">
                        @foreach (var (nokkel, navn) in KalenderKategori.Hendelsestyper)
                        {
                            <option value="@nokkel">@navn</option>
                        }
                    </select>
                </label>
                <label class="kal-modal-felt">
                    Montør
                    <select @bind="_hendelseAnsattId">
                        @foreach (var m in _ansatte)
                        {
                            <option value="@m.Id">@m.Navn</option>
                        }
                    </select>
                </label>
                <label class="kal-modal-felt">
                    Dato
                    <input type="date" @bind="_hendelseDato" />
                </label>
                <label class="kal-modal-felt">
                    Fra
                    <input type="time" @bind="_hendelseFra" />
                </label>
                <label class="kal-modal-felt">
                    Til
                    <input type="time" @bind="_hendelseTil" />
                </label>
            </div>

            <label class="kal-modal-felt">
                Beskrivelse
                <textarea rows="3" @bind="_hendelseInfo" placeholder="Valgfritt"></textarea>
            </label>

            @if (_hendelseFeil is not null)
            {
                <p class="kal-modal-feil">@_hendelseFeil</p>
            }

            <div class="kal-modal-knapper">
                <button type="button" class="kal-modal-avbryt" @onclick="LukkHendelseSkjema">Avbryt</button>
                @if (_hendelseId is not null)
                {
                    <button type="button" class="kal-modal-slett" @onclick="SlettHendelse">Slett</button>
                }
                <button type="button" class="kal-ny-knapp" @onclick="LagreHendelse">Lagre</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class MontorOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class OrdreRad
    {
        public int Id { get; set; }
        public string Tittel { get; set; } = "";
        public string? MontorNavn { get; set; }
        public string? KundeNavn { get; set; }
        public string? ProsjektNavn { get; set; }
        public ArbeidsordreStatus Status { get; set; }
        public ArbeidsordreType? Type { get; set; }
        public DateTime? Start { get; set; }
        public DateTime? Slutt { get; set; }

        public string? TidTekst => Start is null
            ? null
            : Slutt is null
                ? Start.Value.ToString("HH:mm")
                : $"{Start.Value:HH:mm}–{Slutt.Value:HH:mm}";
    }

    private sealed class RessursRad
    {
        public int MontorId { get; set; }
        public string? MontorNavn { get; set; }
        public string Tittel { get; set; } = "";
        public string Info { get; set; } = "";
        public TimeSpan Fra { get; set; }
        public TimeSpan Til { get; set; }
    }

    private sealed class DagRad
    {
        public required DateTime Dato { get; set; }
        public List<OrdreRad> Ordre { get; set; } = [];
        public List<RessursRad> Ressurser { get; set; } = [];
    }

    private sealed class AnsattRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Stilling { get; set; } = "";
        public string Initialer { get; set; } = "";
    }

    private sealed record DeltakerRad(int Id, string Navn, string Initialer);

    private sealed record SjekkpunktRad(string Tekst, bool Fullfort);

    // En blokk i dagvisningens tidslinje - enten en arbeidsordre eller en
    // ressursplanlagt post. Nokkel skiller de to så valgt blokk kan spores.
    private sealed class AktivitetBlokk
    {
        public required string Nokkel { get; init; }
        public int? ArbeidsordreId { get; init; }

        // Satt på ressursplanlagte poster, slik at de kan redigeres og slettes
        // der de står i rutenettet.
        public int? RessursplanId { get; init; }
        public int AnsattId { get; init; }
        public DateTime Dato { get; init; }

        // Nøkkelen i KalenderKategori - styrer farge og hvilken avkryssing
        // under "Vis i kalender" blokken hører til.
        public string Kategori { get; init; } = KalenderKategori.Arbeidsordre;
        public string Tittel { get; init; } = "";
        public string? Undertekst { get; init; }
        public string? ProsjektNavn { get; init; }
        public string? StatusTekst { get; init; }
        public string? Adresse { get; init; }
        public double? Latitude { get; init; }
        public double? Longitude { get; init; }
        public double FraTimer { get; init; }
        public double TilTimer { get; init; }
        public string Ikon { get; init; } = "folder";
        public required Fargepar Farge { get; init; }
        public List<DeltakerRad> Deltakere { get; init; } = [];
        public List<SjekkpunktRad> Sjekkpunkter { get; set; } = [];
        public int AntallFiler { get; set; }

        public string TidTekst => $"{TimeTekst(FraTimer)} – {TimeTekst(TilTimer)}";

        // Teksten i ukerutenettet: "#1045 – Montasje" med prosjektet under, slik
        // at nummeret er synlig uten å åpne arbeidsordren.
        public string KortTittel => ArbeidsordreId is null ? Tittel : $"#{ArbeidsordreId} – {Tittel}";

        public string? KortUnder => ProsjektNavn ?? Undertekst;

        private static string TimeTekst(double timer) =>
            TimeSpan.FromHours(timer).ToString(@"hh\:mm");
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;
    private static readonly string[] Ukedagnavn = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];

    // ToTitleCase ville gjort "torsdag 9. okt" til "Torsdag 9. Okt" - bare
    // ukedagen skal ha stor forbokstav på norsk.
    private static string StorForbokstav(string tekst) =>
        tekst.Length == 0 ? tekst : char.ToUpper(tekst[0], Kultur) + tekst[1..];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private string _visning = "uke";
    private DateTime _visningsManed = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _valgtDato = DateTime.Today;
    private DateTime _minikalManed = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private int? _valgtMontorId;
    private int? _valgtProsjektId;
    private string _typeFilter = "alle";
    private string _tabellStatusFilter = "alle";

    private string _avdelingFilter = "";
    private bool _visFilter;
    private string _detaljFane = "detaljer";
    private AktivitetBlokk? _valgtAktivitet;
    private List<AnsattRad> _ansatte = [];
    private List<AktivitetBlokk> _blokker = [];

    private List<ProsjektOption> _prosjekter = [];
    private Dictionary<int, string> _fargekart = [];
    private List<DagRad> _dager = [];
    private List<OrdreRad> _alleArbeidsordreIPeriode = [];
    private bool _laster = true;
    private int? _draggingOrdreId;
    private DateTime? _dragOverDato;

    // Hurtigfanene over verktøylinja. De setter de samme filtrene som
    // sidepanelet, bare i ett klikk.
    private static readonly (string Nokkel, string Navn, string? Ikon)[] Faner =
    [
        ("alle", "Alle", null),
        ("montorer", "Montører", "users"),
        ("arbeidsordre", "Arbeidsordre", null),
        ("prosjekter", "Prosjekter", null),
        ("fravar", "Fravær", "calendar")
    ];

    private string _fane = "alle";
    private string _sok = "";

    // Sidepanelets filtre. Lagres bare i minnet - de skal kunne skrus av og på
    // mens man jobber, ikke følge brukeren mellom besøk.
    private readonly HashSet<string> _skjulteTyper = [];
    private readonly HashSet<int> _skjulteMontorer = [];
    private string _montorSok = "";
    private HashSet<DateTime> _dagerMedAktivitet = [];

    // Skjema for hendelser lagt inn manuelt i rutenettet.
    private bool _visHendelseSkjema;
    private int? _hendelseId;
    private int? _hendelseAnsattId;
    private DateTime _hendelseDato = DateTime.Today;
    private string _hendelseTittel = "";
    private string _hendelseInfo = "";
    private TimeOnly _hendelseFra = new(8, 0);
    private TimeOnly _hendelseTil = new(16, 0);
    private string _hendelseKategori = KalenderKategori.Mote;
    private string? _hendelseFeil;

    private List<DateTime> UkensDager
    {
        get
        {
            var mandag = FinnMandag(_valgtDato);
            return Enumerable.Range(0, 7).Select(i => mandag.AddDays(i)).ToList();
        }
    }

    private List<DateTime?> MinikalenderDager
    {
        get
        {
            var forsteIManed = new DateTime(_minikalManed.Year, _minikalManed.Month, 1);
            var offset = ((int)forsteIManed.DayOfWeek + 6) % 7;
            var dager = new List<DateTime?>();
            for (var i = 0; i < offset; i++)
            {
                dager.Add(null);
            }
            var dagerIManed = DateTime.DaysInMonth(_minikalManed.Year, _minikalManed.Month);
            for (var d = 1; d <= dagerIManed; d++)
            {
                dager.Add(new DateTime(_minikalManed.Year, _minikalManed.Month, d));
            }
            return dager;
        }
    }

    private string PeriodeLabel => _visning switch
    {
        "uke" => $"Uke {ISOWeek.GetWeekOfYear(FinnMandag(_valgtDato))} – {FinnMandag(_valgtDato).ToString("MMMM yyyy", Kultur)}",
        "dag" => StorForbokstav(_valgtDato.ToString("dddd d. MMMM yyyy", Kultur)),
        _ => Kultur.TextInfo.ToTitleCase(_visningsManed.ToString("MMMM yyyy", Kultur))
    };

    private List<OrdreRad> TabellRader => _tabellStatusFilter switch
    {
        "ikke-startet" => _alleArbeidsordreIPeriode.Where(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar).ToList(),
        "pagar" => _alleArbeidsordreIPeriode.Where(a => a.Status == ArbeidsordreStatus.Pagaende).ToList(),
        "ferdig" => _alleArbeidsordreIPeriode.Where(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert).ToList(),
        _ => _alleArbeidsordreIPeriode
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        // Dagvisningen har én rad pr. ansatt, ikke bare montører - også
        // prosjektledere og administrasjon har aktiviteter i kalenderen.
        var brukere = await Db.Brukere
            .Where(b => b.Aktiv && b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
            .OrderBy(b => b.Navn)
            .ToListAsync();

        _ansatte = brukere.Select(b => new AnsattRad
        {
            Id = b.Id,
            Navn = b.Navn,
            Stilling = string.IsNullOrWhiteSpace(b.Stilling) ? b.Rolle.Visningsnavn() : b.Stilling,
            Initialer = b.Initialer
        }).ToList();

        _prosjekter = await Db.Prosjekter
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        var aktiveIder = await Db.Brukere.Where(b => b.Aktiv).Select(b => b.Id).ToListAsync();
        _fargekart = AnsattFarge.Bygg(aktiveIder);

        _visning = await VisningPref.HentAsync("kalender", _visning);

        await LastDagerMedAktivitetAsync();
        await LastAsync();
    }

    private async Task SettVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("kalender", visning);
        await LastAsync();
    }

    private async Task Forrige()
    {
        switch (_visning)
        {
            case "uke": _valgtDato = _valgtDato.AddDays(-7); break;
            case "dag": _valgtDato = _valgtDato.AddDays(-1); break;
            default: _visningsManed = _visningsManed.AddMonths(-1); break;
        }
        await LastAsync();
    }

    private async Task Neste()
    {
        switch (_visning)
        {
            case "uke": _valgtDato = _valgtDato.AddDays(7); break;
            case "dag": _valgtDato = _valgtDato.AddDays(1); break;
            default: _visningsManed = _visningsManed.AddMonths(1); break;
        }
        await LastAsync();
    }

    private async Task GaTilIDag()
    {
        _valgtDato = DateTime.Today;
        _visningsManed = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await LastAsync();
    }

    private async Task MinikalForrigeManed()
    {
        _minikalManed = _minikalManed.AddMonths(-1);
        await LastDagerMedAktivitetAsync();
    }

    private async Task MinikalNesteManed()
    {
        _minikalManed = _minikalManed.AddMonths(1);
        await LastDagerMedAktivitetAsync();
    }

    // Uken som vises i rutenettet markeres i minikalenderen, slik at man ser
    // hvor man står i måneden.
    private bool ErIVistUke(DateTime dag)
    {
        var mandag = FinnMandag(_valgtDato);
        return dag.Date >= mandag && dag.Date <= mandag.AddDays(6);
    }

    // Prikkene under datoene i minikalenderen. Hentes for hele måneden som
    // vises der, ikke bare for perioden i rutenettet - ellers ville bare den
    // ene uken fått prikker.
    private async Task LastDagerMedAktivitetAsync()
    {
        var fra = new DateTime(_minikalManed.Year, _minikalManed.Month, 1);
        var til = fra.AddMonths(1);

        var ordredatoer = await Db.Arbeidsordre
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato >= fra && a.PlanlagtDato < til)
            .Where(a => _naverendeRolle != BrukerRolle.Montor || a.AnsvarligMontorId == _naverendeBrukerId)
            .Select(a => a.PlanlagtDato!.Value)
            .ToListAsync();

        var hendelsesdatoer = await Db.Ressursplaner
            .Where(r => r.Dato >= fra && r.Dato < til)
            .Where(r => _naverendeRolle != BrukerRolle.Montor || r.MontorId == _naverendeBrukerId)
            .Select(r => r.Dato)
            .ToListAsync();

        _dagerMedAktivitet = ordredatoer.Concat(hendelsesdatoer).Select(d => d.Date).ToHashSet();
    }

    private async Task VelgDato(DateTime dato)
    {
        _valgtDato = dato.Date;
        if (_visning == "maned")
        {
            _visningsManed = new DateTime(dato.Year, dato.Month, 1);
        }
        await LastAsync();
    }

    private (DateTime Fra, DateTime Til) BeregnSynligPeriode() => _visning switch
    {
        "uke" => (FinnMandag(_valgtDato), FinnMandag(_valgtDato).AddDays(6)),
        "dag" => (_valgtDato.Date, _valgtDato.Date),
        "liste" => (DateTime.Today, DateTime.Today.AddDays(90)),
        _ => (FinnForrigeMandag(_visningsManed), FinnNesteSondag(_visningsManed.AddMonths(1).AddDays(-1)))
    };

    private async Task LastAsync()
    {
        _laster = true;

        var (forsteIGrid, sisteIGrid) = BeregnSynligPeriode();

        IQueryable<Arbeidsordre> query = Db.Arbeidsordre
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Kunde)
            .Include(a => a.Prosjekt)
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= forsteIGrid && a.PlanlagtDato.Value.Date <= sisteIGrid);

        if (_naverendeRolle == BrukerRolle.Montor)
        {
            query = query.Where(a => a.AnsvarligMontorId == _naverendeBrukerId);
        }
        else if (_valgtMontorId is not null)
        {
            query = query.Where(a => a.AnsvarligMontorId == _valgtMontorId);
        }

        if (_valgtProsjektId is not null)
        {
            query = query.Where(a => a.ProsjektId == _valgtProsjektId);
        }

        var visArbeidsordre = _typeFilter is "alle" or "arbeidsordre";
        var visRessurs = _typeFilter is "alle" or "ressurs";

        var ordre = visArbeidsordre ? await query.ToListAsync() : [];
        var ordreRader = ordre.Select(a => new OrdreRad
        {
            Id = a.Id,
            Tittel = a.Tittel,
            MontorNavn = a.AnsvarligMontor?.Navn,
            KundeNavn = a.Kunde?.Navn ?? a.Prosjekt?.Kunde?.Navn,
            ProsjektNavn = a.Prosjekt?.Navn,
            Status = a.Status,
            Type = a.Type,
            Start = a.PlanlagtDato,
            Slutt = a.PlanlagtSlutt
        }).OrderBy(o => o.Start).ToList();

        _alleArbeidsordreIPeriode = ordreRader;

        var ordrePerDag = ordreRader
            .Where(o => o.Start.HasValue)
            .GroupBy(o => o.Start!.Value.Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        IQueryable<Ressursplan> ressursQuery = Db.Ressursplaner
            .Include(r => r.Montor)
            .Where(r => r.Dato >= forsteIGrid && r.Dato <= sisteIGrid);

        if (_naverendeRolle == BrukerRolle.Montor)
        {
            ressursQuery = ressursQuery.Where(r => r.MontorId == _naverendeBrukerId);
        }
        else if (_valgtMontorId is not null)
        {
            ressursQuery = ressursQuery.Where(r => r.MontorId == _valgtMontorId);
        }

        var ressurser = visRessurs ? await ressursQuery.ToListAsync() : [];
        var ressurserPerDag = ressurser
            .GroupBy(r => r.Dato.Date)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(r => r.Fra)
                .Select(r => new RessursRad { MontorId = r.MontorId, MontorNavn = r.Montor?.Navn, Tittel = r.Tittel, Info = r.Info, Fra = r.Fra, Til = r.Til })
                .ToList());

        var dager = new List<DagRad>();
        for (var dato = forsteIGrid; dato <= sisteIGrid; dato = dato.AddDays(1))
        {
            dager.Add(new DagRad
            {
                Dato = dato,
                Ordre = ordrePerDag.GetValueOrDefault(dato, []),
                Ressurser = ressurserPerDag.GetValueOrDefault(dato, [])
            });
        }

        _dager = dager;

        // Dag-, uke- og månedsvisningen er bygd av de samme blokkene - dagen
        // viser dem langs en tidsakse, uken fordelt på sju dagkolonner, og
        // måneden i hver sin dagrute.
        if (_visning is "dag" or "uke" or "maned")
        {
            ByggBlokker(ordre, ressurser);
        }

        _laster = false;
    }

    // Bygger tidslinjeblokkene for dagvisningen: én pr. arbeidsordre med
    // ansvarlig montør, pluss ressursplanlagte poster. Arbeidsordre uten
    // klokkeslett får et standard arbeidsvindu, ellers ville de vært umulige
    // å plassere på aksen.
    private void ByggBlokker(List<Arbeidsordre> ordre, List<Ressursplan> ressurser)
    {
        var blokker = new List<AktivitetBlokk>();

        foreach (var a in ordre.Where(a => a.AnsvarligMontorId is not null && a.PlanlagtDato is not null))
        {
            var fra = a.PlanlagtDato!.Value.TimeOfDay.TotalHours;
            if (fra <= 0)
            {
                fra = 8;
            }
            var til = a.PlanlagtSlutt?.TimeOfDay.TotalHours ?? fra + 2;
            if (til <= fra)
            {
                til = fra + 1;
            }

            var adresse = string.Join(" ", new[]
            {
                a.Adresse ?? a.Prosjekt?.Adresse,
                a.Postnr ?? a.Prosjekt?.Postnr,
                a.Sted ?? a.Prosjekt?.Sted
            }.Where(s => !string.IsNullOrWhiteSpace(s)));

            var ansvarlig = _ansatte.FirstOrDefault(x => x.Id == a.AnsvarligMontorId);

            blokker.Add(new AktivitetBlokk
            {
                Nokkel = $"ao-{a.Id}",
                ArbeidsordreId = a.Id,
                AnsattId = a.AnsvarligMontorId!.Value,
                Dato = a.PlanlagtDato!.Value.Date,
                Kategori = a.ProsjektId is null ? KalenderKategori.Arbeidsordre : KalenderKategori.Prosjekt,
                Tittel = a.Tittel,
                Undertekst = $"AO-{a.Id}{(a.Prosjekt?.Navn is { } pn ? $" · {pn}" : "")}",
                ProsjektNavn = a.Prosjekt?.Navn,
                StatusTekst = a.Status.Visningsnavn(),
                Adresse = string.IsNullOrWhiteSpace(adresse) ? null : adresse,
                Latitude = a.Latitude ?? a.Prosjekt?.Latitude,
                Longitude = a.Longitude ?? a.Prosjekt?.Longitude,
                FraTimer = fra,
                TilTimer = til,
                Ikon = IkonForType(a.Type),
                Farge = AktivitetFarge.Velg(a.ProsjektId ?? a.Id),
                Deltakere = ansvarlig is null ? [] : [new DeltakerRad(ansvarlig.Id, ansvarlig.Navn, ansvarlig.Initialer)]
            });
        }

        foreach (var r in ressurser)
        {
            var deltaker = _ansatte.FirstOrDefault(x => x.Id == r.MontorId);

            blokker.Add(new AktivitetBlokk
            {
                Nokkel = $"res-{r.Id}",
                RessursplanId = r.Id,
                Kategori = string.IsNullOrWhiteSpace(r.Kategori) ? KalenderKategori.Internt : r.Kategori,
                AnsattId = r.MontorId,
                Dato = r.Dato.Date,
                Tittel = r.Tittel,
                Undertekst = string.IsNullOrWhiteSpace(r.Info) ? null : r.Info,
                FraTimer = r.Fra.TotalHours,
                TilTimer = r.Til.TotalHours > r.Fra.TotalHours ? r.Til.TotalHours : r.Fra.TotalHours + 1,
                Ikon = KalenderKategori.Ikon(string.IsNullOrWhiteSpace(r.Kategori) ? KalenderKategori.Internt : r.Kategori),
                // Hendelser er ikke jobber - de får fargen til sin egen
                // kategori, den samme som står i filterlista, slik at de ikke
                // forveksles med en arbeidsordre.
                Farge = KalenderKategori.Fargepar(string.IsNullOrWhiteSpace(r.Kategori) ? KalenderKategori.Internt : r.Kategori),
                Deltakere = deltaker is null ? [] : [new DeltakerRad(deltaker.Id, deltaker.Navn, deltaker.Initialer)]
            });
        }

        _blokker = blokker;

        // Hold valget hvis blokken fortsatt finnes, ellers nullstill panelet.
        if (_valgtAktivitet is not null)
        {
            _valgtAktivitet = blokker.FirstOrDefault(b => b.Nokkel == _valgtAktivitet.Nokkel);
        }
    }

    private static string IkonForType(ArbeidsordreType? type) => type switch
    {
        ArbeidsordreType.Fastpris => "box",
        ArbeidsordreType.TidMedgatt => "clock",
        _ => "folder"
    };

    // ---------- Dagvisning: ansattrader med tidslinje ----------

    private List<string> Avdelinger => _ansatte
        .Select(a => a.Stilling)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private List<AnsattRad> SynligeAnsatte => _ansatte
        .Where(a => _avdelingFilter.Length == 0 || a.Stilling == _avdelingFilter)
        .Where(a => _valgtMontorId is null || a.Id == _valgtMontorId)
        .Where(a => !_skjulteMontorer.Contains(a.Id))
        .ToList();

    // Lista i "Vis montører" - søket filtrerer bare hvem som står i lista, ikke
    // hvem som er huket av.
    private List<AnsattRad> MontorerIFilter => _ansatte
        .Where(a => _montorSok.Length == 0 || a.Navn.Contains(_montorSok, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void ToggleMontor(int id)
    {
        if (!_skjulteMontorer.Add(id))
        {
            _skjulteMontorer.Remove(id);
        }
    }

    private void ToggleType(string slag)
    {
        if (!_skjulteTyper.Add(slag))
        {
            _skjulteTyper.Remove(slag);
        }
    }

    private void NullstillSidefilter()
    {
        _skjulteTyper.Clear();
        _skjulteMontorer.Clear();
        _montorSok = "";
    }

    // Fanene er snarveier inn i det samme typefilteret som sidepanelet bruker,
    // slik at de to alltid viser det samme.
    private void VelgFane(string fane)
    {
        _fane = fane;
        _skjulteTyper.Clear();

        var synlig = fane switch
        {
            "arbeidsordre" => new[] { KalenderKategori.Arbeidsordre, KalenderKategori.Prosjekt },
            "prosjekter" => [KalenderKategori.Prosjekt],
            "fravar" => [KalenderKategori.Fravar],
            _ => []
        };

        if (synlig.Length == 0)
        {
            return;
        }

        foreach (var (nokkel, _, _) in KalenderKategori.Alle.Where(k => !synlig.Contains(k.Nokkel)))
        {
            _skjulteTyper.Add(nokkel);
        }
    }

    // ---------- Hendelser lagt inn manuelt (Ressursplan) ----------

    private void AapneNyHendelse(int? ansattId, DateTime dag)
    {
        _hendelseId = null;
        _hendelseAnsattId = ansattId ?? SynligeAnsatte.FirstOrDefault()?.Id ?? _ansatte.FirstOrDefault()?.Id;
        _hendelseDato = dag.Date;
        _hendelseTittel = "";
        _hendelseInfo = "";
        _hendelseFra = new TimeOnly(8, 0);
        _hendelseTil = new TimeOnly(16, 0);
        _hendelseKategori = KalenderKategori.Mote;
        _hendelseFeil = null;
        _visHendelseSkjema = true;
    }

    private void AapneRedigerHendelse(AktivitetBlokk blokk)
    {
        // Arbeidsordre redigeres på sin egen side - her er det bare de manuelt
        // innlagte hendelsene som kan endres.
        if (blokk.RessursplanId is null)
        {
            Nav.NavigateTo($"/arbeidsordre/{blokk.ArbeidsordreId}");
            return;
        }

        _hendelseId = blokk.RessursplanId;
        _hendelseAnsattId = blokk.AnsattId;
        _hendelseDato = blokk.Dato;
        _hendelseTittel = blokk.Tittel;
        _hendelseInfo = blokk.Undertekst ?? "";
        _hendelseFra = TimeOnly.FromTimeSpan(TimeSpan.FromHours(blokk.FraTimer));
        _hendelseTil = TimeOnly.FromTimeSpan(TimeSpan.FromHours(blokk.TilTimer));
        _hendelseKategori = blokk.Kategori;
        _hendelseFeil = null;
        _visHendelseSkjema = true;
    }

    private void LukkHendelseSkjema()
    {
        _visHendelseSkjema = false;
        _hendelseFeil = null;
    }

    private async Task LagreHendelse()
    {
        if (_hendelseAnsattId is null)
        {
            _hendelseFeil = "Velg hvem hendelsen gjelder.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_hendelseTittel))
        {
            _hendelseFeil = "Gi hendelsen en tittel.";
            return;
        }

        if (_hendelseTil <= _hendelseFra)
        {
            _hendelseFeil = "Til-klokkeslett må være etter fra-klokkeslett.";
            return;
        }

        if (_hendelseId is null)
        {
            Db.Ressursplaner.Add(new Ressursplan
            {
                Dato = _hendelseDato.Date,
                MontorId = _hendelseAnsattId.Value,
                Tittel = _hendelseTittel.Trim(),
                Info = _hendelseInfo.Trim(),
                Kategori = _hendelseKategori,
                Fra = _hendelseFra.ToTimeSpan(),
                Til = _hendelseTil.ToTimeSpan(),
                OpprettetAvBrukerId = _naverendeBrukerId
            });
        }
        else
        {
            var eksisterende = await Db.Ressursplaner.FirstOrDefaultAsync(r => r.Id == _hendelseId.Value);
            if (eksisterende is null)
            {
                // Noen andre har slettet den i mellomtiden.
                LukkHendelseSkjema();
                await LastAsync();
                return;
            }

            eksisterende.Dato = _hendelseDato.Date;
            eksisterende.MontorId = _hendelseAnsattId.Value;
            eksisterende.Tittel = _hendelseTittel.Trim();
            eksisterende.Info = _hendelseInfo.Trim();
            eksisterende.Kategori = _hendelseKategori;
            eksisterende.Fra = _hendelseFra.ToTimeSpan();
            eksisterende.Til = _hendelseTil.ToTimeSpan();
        }

        await Db.SaveChangesAsync();
        LukkHendelseSkjema();
        await LastAsync();
    }

    private async Task SlettHendelse()
    {
        if (_hendelseId is null)
        {
            return;
        }

        var eksisterende = await Db.Ressursplaner.FirstOrDefaultAsync(r => r.Id == _hendelseId.Value);
        if (eksisterende is not null)
        {
            Db.Ressursplaner.Remove(eksisterende);
            await Db.SaveChangesAsync();
        }

        LukkHendelseSkjema();
        await LastAsync();
    }

    private bool ErIDag => _valgtDato.Date == DateTime.Today;

    // "Lørdag 10. okt 2026" - settes sammen manuelt fordi nb-NO skriver
    // månedsforkortelsen med punktum ("okt."), som ikke hører hjemme her.
    private string DetaljDato =>
        $"{StorForbokstav(_valgtDato.ToString("dddd", Kultur))} {_valgtDato.Day}. " +
        $"{_valgtDato.ToString("MMM", Kultur).TrimEnd('.')} {_valgtDato.Year}";

    // Tidsaksen dekker 07-17 som standard, men utvides hvis dagen har
    // aktiviteter utenfor det vinduet.
    private int DagStartTime
    {
        get
        {
            var dagens = DagensBlokker;
            var tidligst = dagens.Count == 0 ? 7 : (int)Math.Floor(dagens.Min(b => b.FraTimer));
            return Math.Clamp(Math.Min(7, tidligst), 0, 12);
        }
    }

    private int DagSluttTime
    {
        get
        {
            var dagens = DagensBlokker;
            var senest = dagens.Count == 0 ? 17 : (int)Math.Ceiling(dagens.Max(b => b.TilTimer));
            return Math.Clamp(Math.Max(17, senest), DagStartTime + 4, 24);
        }
    }

    private double DagTimespenn => Math.Max(1, DagSluttTime - DagStartTime);

    private double TimeProsent(double timer) =>
        Math.Round(Math.Clamp((timer - DagStartTime) / DagTimespenn, 0, 1) * 100, 3);

    private double BreddeProsent(AktivitetBlokk b) =>
        Math.Max(4, Math.Round((Math.Min(b.TilTimer, DagSluttTime) - Math.Max(b.FraTimer, DagStartTime)) / DagTimespenn * 100, 3));

    private double NaProsent => TimeProsent(DateTime.Now.TimeOfDay.TotalHours);

    // Dagvisningen tegner bare den valgte dagen; blokklista dekker hele
    // perioden, så den må filtreres her.
    private List<AktivitetBlokk> DagensBlokker => _blokker
        .Where(b => b.Dato == _valgtDato.Date)
        .ToList();

    private List<AktivitetBlokk> BlokkerFor(int ansattId) => DagensBlokker
        .Where(b => b.AnsattId == ansattId)
        .OrderBy(b => b.FraTimer)
        .ToList();

    // Månedsvisningen viser alle montørene i samme rute, så den filtrerer bare
    // på dato - men gjennom de samme type-, montør- og søkefiltrene.
    private List<AktivitetBlokk> BlokkerForDag(DateTime dag) => _blokker
        .Where(b => b.Dato == dag.Date)
        .Where(b => !_skjulteTyper.Contains(b.Kategori))
        .Where(b => !_skjulteMontorer.Contains(b.AnsattId))
        .Where(b => _sok.Length == 0
            || b.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (b.KortUnder?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(b => b.FraTimer)
        .ToList();

    // "+n til" tar deg til dagvisningen for den dagen, der det er plass til alt.
    private async Task VisDag(DateTime dag)
    {
        _valgtDato = dag.Date;
        await SettVisning("dag");
    }

    private List<AktivitetBlokk> BlokkerFor(int ansattId, DateTime dag) => _blokker
        .Where(b => b.AnsattId == ansattId && b.Dato == dag.Date)
        .Where(b => !_skjulteTyper.Contains(b.Kategori))
        .Where(b => _sok.Length == 0
            || b.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (b.KortUnder?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(b => b.FraTimer)
        .ToList();

    // Minikartet i Lokasjon-seksjonen tegnes først når elementet faktisk
    // finnes i DOM-en, derfor etter render og ikke i VelgAktivitet.
    private string? _tegnetKartFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var skalTegne = _visning == "dag"
            && _detaljFane == "detaljer"
            && _valgtAktivitet is { Latitude: not null, Longitude: not null };

        if (skalTegne && _tegnetKartFor != _valgtAktivitet!.Nokkel)
        {
            _tegnetKartFor = _valgtAktivitet.Nokkel;
            await JS.InvokeVoidAsync("minikart.vis", "kal-detalj-kart",
                _valgtAktivitet.Latitude, _valgtAktivitet.Longitude, _valgtAktivitet.Farge.Kant);
        }
        else if (!skalTegne && _tegnetKartFor is not null)
        {
            _tegnetKartFor = null;
            await JS.InvokeVoidAsync("minikart.fjern", "kal-detalj-kart");
        }
    }

    private async Task VelgAktivitet(AktivitetBlokk blokk)
    {
        _valgtAktivitet = blokk;
        _detaljFane = "detaljer";

        // Sjekkpunkter og filer hentes først når man faktisk åpner en
        // aktivitet - unødvendig å laste for alle blokkene i tidslinja.
        if (blokk.ArbeidsordreId is { } ordreId && blokk.Sjekkpunkter.Count == 0 && blokk.AntallFiler == 0)
        {
            blokk.Sjekkpunkter = await Db.ArbeidsordreSjekkpunkter
                .Where(p => p.ArbeidsordreId == ordreId)
                .OrderBy(p => p.Id)
                .Select(p => new SjekkpunktRad(p.Tekst, p.Fullfort))
                .ToListAsync();

            blokk.AntallFiler = await Db.ArbeidsordreMedia.CountAsync(m => m.ArbeidsordreId == ordreId);
        }
    }

    private static string FargeHex(string farge) => farge switch
    {
        "blaa" => "#0b66e6",
        "gul" => "#c2590a",
        "gronn" => "#0c9c5c",
        "lilla" => "#7a2b96",
        "rod" => "#a32020",
        _ => "#9a958c"
    };

    private static DateTime FinnMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek + 6) % 7;
        return dato.Date.AddDays(-diff);
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }

    private static DateTime FinnNesteSondag(DateTime dato)
    {
        var diff = ((int)DayOfWeek.Sunday - (int)dato.DayOfWeek + 7) % 7;
        return dato.AddDays(diff);
    }

    private async Task OnDropAsync(DateTime nyDato)
    {
        _dragOverDato = null;

        if (_draggingOrdreId is null)
        {
            return;
        }

        var ordre = await Db.Arbeidsordre.FindAsync(_draggingOrdreId.Value);
        if (ordre is null)
        {
            _draggingOrdreId = null;
            return;
        }

        if (ordre.PlanlagtDato.HasValue)
        {
            var dagerFlyttet = nyDato.Date - ordre.PlanlagtDato.Value.Date;
            ordre.PlanlagtDato = ordre.PlanlagtDato.Value + dagerFlyttet;
            if (ordre.PlanlagtSlutt.HasValue)
            {
                ordre.PlanlagtSlutt = ordre.PlanlagtSlutt.Value + dagerFlyttet;
            }
        }
        else
        {
            ordre.PlanlagtDato = nyDato;
        }

        await Db.SaveChangesAsync();
        _draggingOrdreId = null;
        await LastAsync();
    }

    private string FargeForMontor(int montorId) => _fargekart.GetValueOrDefault(montorId, "#6b6b63");

