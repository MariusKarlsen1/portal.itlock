@page "/rapporter/kunde"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Kunderapport - itlock</PageTitle>

<a class="back-link" href="/rapportermodul">&larr; Tilbake til rapporter</a>
<h1>Topp 20 kunder</h1>
<p class="section-hint">
    Omsetning pr. kunde for valgt periode, beregnet fra ferdigmeldte
    arbeidsordre i portalen (samme oppsett som Tripletex sin kunderapport,
    men uavhengig av om ordren er fakturert i Tripletex ennå).
</p>

<div class="rapport-filter">
    <label>
        Fra
        <input type="date" @bind="_fraDato" />
    </label>
    <label>
        Til
        <input type="date" @bind="_tilDato" />
    </label>
    <label>
        Kundetype
        <select @bind="_typeFilter">
            <option value="">Alle</option>
            <option value="IkkeSatt">Ikke satt</option>
            @foreach (var t in Enum.GetValues<KundeType>())
            {
                <option value="@t">@t.Visningsnavn()</option>
            }
        </select>
    </label>
    <button type="button" class="save-button" @onclick="HentRapport" disabled="@_lasterNa">
        @(_lasterNa ? "Henter..." : "Vis rapport")
    </button>
</div>

@if (_harHentet)
{
    @if (_alleRader.Count == 0)
    {
        <p class="list-empty">Ingen ferdigmeldte arbeidsordre med omsetning i denne perioden.</p>
    }
    else
    {
        <h2>Omsetning pr. kundetype</h2>
        <table class="rapport-table">
            <thead>
                <tr>
                    <th>Kundetype</th>
                    <th>Omsetning</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (typeNavn, sum) in SumPrType)
                {
                    <tr>
                        <td>@typeNavn</td>
                        <td class="tall-cell">@sum.ToString("N0", Kultur) kr</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2>Topp 20 kunder@(string.IsNullOrEmpty(_typeFilter) ? "" : $" - {TypeFilterNavn}")</h2>
        @if (FiltrerteRader.Count == 0)
        {
            <p class="list-empty">Ingen kunder med omsetning i denne perioden for valgt kundetype.</p>
        }
        else
        {
            <table class="rapport-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Kunde</th>
                        <th>Kundetype</th>
                        <th>Omsetning</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var plass = 0; }
                    @foreach (var r in FiltrerteRader)
                    {
                        plass++;
                        <tr>
                            <td>@plass</td>
                            <td>@r.Navn</td>
                            <td>@(r.Type?.Visningsnavn() ?? "Ikke satt")</td>
                            <td class="tall-cell">@r.Sum.ToString("N0", Kultur) kr</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private DateTime _fraDato = new(DateTime.Today.Year, 1, 1);
    private DateTime _tilDato = DateTime.Today;
    private string _typeFilter = "";
    private bool _lasterNa;
    private bool _harHentet;

    private sealed record KundeRad(string Navn, KundeType? Type, decimal Sum);
    private List<KundeRad> _alleRader = [];

    private string TypeFilterNavn => _typeFilter == "IkkeSatt"
        ? "Ikke satt"
        : Enum.TryParse<KundeType>(_typeFilter, out var t) ? t.Visningsnavn() : "";

    private List<KundeRad> FiltrerteRader => _alleRader
        .Where(r => string.IsNullOrEmpty(_typeFilter)
            || (_typeFilter == "IkkeSatt" ? r.Type is null : r.Type.HasValue && r.Type.Value.ToString() == _typeFilter))
        .OrderByDescending(r => r.Sum)
        .Take(20)
        .ToList();

    private List<(string TypeNavn, decimal Sum)> SumPrType => _alleRader
        .GroupBy(r => r.Type)
        .Select(g => (g.Key?.Visningsnavn() ?? "Ikke satt", g.Sum(r => r.Sum)))
        .OrderByDescending(x => x.Item2)
        .ToList();

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _lasterNa = true;
        try
        {
            var tilEksklusiv = _tilDato.Date.AddDays(1);
            var ordrer = await Db.Arbeidsordre
                .Where(a => a.FullfortDato != null && a.FullfortDato >= _fraDato.Date && a.FullfortDato < tilEksklusiv)
                .Include(a => a.Kunde)
                .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
                .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer).ThenInclude(l => l.Component)
                .Include(a => a.Varer).ThenInclude(v => v.Component)
                .ToListAsync();

            _alleRader = ordrer
                .Where(a => (a.Kunde ?? a.Prosjekt?.Kunde) is not null)
                .GroupBy(a => a.Kunde ?? a.Prosjekt!.Kunde!)
                .Select(g => new KundeRad(g.Key.Navn, g.Key.Type, g.Sum(a => ArbeidsordreOkonomiBeregner.BeregnLinjer(a).Sum(l => l.Belop))))
                .ToList();
            _harHentet = true;
        }
        finally
        {
            _lasterNa = false;
        }
    }
}
