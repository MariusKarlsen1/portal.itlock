@page "/glemt-passord"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Glemt passord - itlock</PageTitle>

<div class="login-card">
    <h1>Glemt passord</h1>
    <p class="sett-passord-hint">Skriv inn e-posten din, så sender vi deg en lenke for å velge nytt passord hvis vi finner en konto med den adressen.</p>

    @if (Sendt == "1")
    {
        <p class="login-success">Hvis e-posten finnes hos oss, har vi sendt deg en lenke for å tilbakestille passordet. Sjekk innboksen din.</p>
    }
    else
    {
        @if (ForMange == "1")
        {
            <p class="login-error">For mange forsøk. Vent noen minutter og prøv igjen.</p>
        }

        <form method="post" action="/account/glemt-passord">
            <label>
                E-post
                <input type="email" name="epost" required autofocus />
            </label>
            <button type="submit">Send lenke</button>
        </form>
    }

    <a class="sett-passord-tilbake" href="/login">Tilbake til innlogging</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sendt")]
    public string? Sendt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }
}
