@page "/glemt-passord"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Glemt passord - Full Kontroll</PageTitle>

<InnloggingRamme Scene="nokkel" Steg="@(Sendt == "1" ? 2 : 1)" Tittel="Glemt passordet?"
                 Ingress="Det skjer de beste. Vi sender deg en lenke, så lager du et nytt passord på et øyeblikk.">
    @if (Sendt == "1")
    {
        <div class="li-sendt">
            <div class="li-sendt-ikon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></svg></div>
            <h2>Sjekk innboksen din</h2>
            <p>Hvis vi fant en konto med den adressen, har vi sendt deg en lenke for å velge nytt passord.</p>
            <div class="li-tips"><b>Lenken gjelder i 1 time.</b> Finner du den ikke? Sjekk søppelpost, eller be om en ny lenke.</div>
            <a class="li-knapp li-sekundar" href="/glemt-passord">Send en ny lenke</a>
            <div class="li-lenker">
                <a class="li-tilbake" href="/login">← Tilbake til innlogging</a>
            </div>
        </div>
    }
    else
    {
        <h2>Glemt passord</h2>
        <p class="li-ingress">Skriv inn e-postadressen din, så sender vi deg en lenke for å velge nytt passord.</p>

        @if (ForMange == "1")
        {
            <p class="li-melding li-feil">For mange forsøk. Vent noen minutter og prøv igjen.</p>
        }

        <form method="post" action="/account/glemt-passord">
            <div class="li-felt">
                <label for="liEpost">E-postadresse</label>
                <input id="liEpost" type="email" name="epost" autocomplete="username" placeholder="din@epost.no" required autofocus />
            </div>
            <button class="li-knapp li-primar" type="submit">Send meg lenken <span class="li-pil">→</span></button>
        </form>

        <div class="li-lenker">
            <div>Kom du på det? <a href="/login">Logg inn</a></div>
            <a class="li-tilbake" href="/">← Tilbake til forsiden</a>
        </div>
    }
</InnloggingRamme>

@code {
    [SupplyParameterFromQuery(Name = "sendt")]
    public string? Sendt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }
}
