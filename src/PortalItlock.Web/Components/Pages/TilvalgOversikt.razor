@page "/tilvalg"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Tilvalg - Proxima</PageTitle>

<h1>Tilvalg</h1>
<p class="section-hint">Alle tilvalg på tvers av prosjekter. Besvarte tilvalg du ikke har åpnet ennå er merket.</p>

@if (_tilvalg.Count == 0)
{
    <p class="list-empty">Ingen tilvalg opprettet ennå. Gå inn på et prosjekt for å opprette et nytt tilvalg.</p>
}
else
{
    <div class="tilvalg-tabell-kort">
        <table class="tilvalg-tabell">
            <thead>
                <tr>
                    <th>Tittel</th>
                    <th>Prosjekt</th>
                    <th>Status</th>
                    <th>Sum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _tilvalg)
                {
                    <tr @key="t.Id" class="@(t.Status == TilvalgStatus.Besvart && !t.LestAvAnsatt ? "tilvalg-rad-uleste" : "")">
                        <td><a class="tilvalg-rad-tittel" href="@($"/tilvalg/{t.Id}")">@t.Tittel</a></td>
                        <td class="tilvalg-tabell-prosjekt">@t.Prosjekt?.Navn @(t.Prosjekt?.Kunde is not null ? $"({t.Prosjekt.Kunde.Navn})" : "")</td>
                        <td><span class="tilvalg-status tilvalg-status-@t.Status">@t.Status.Visningsnavn()</span></td>
                        <td class="tilvalg-tabell-sum">@(t.Status == TilvalgStatus.Besvart && t.SumTotal.HasValue ? $"{t.SumTotal.Value:N2} kr" : "–")</td>
                        <td><a class="tilvalg-rad-apne" href="@($"/tilvalg/{t.Id}")">Åpne &rarr;</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Tilvalg> _tilvalg = [];

    protected override async Task OnInitializedAsync()
    {
        _tilvalg = await Db.Tilvalg
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .OrderByDescending(t => t.Status == TilvalgStatus.Besvart && !t.LestAvAnsatt)
            .ThenByDescending(t => t.OpprettetDato)
            .ToListAsync();
    }
}
