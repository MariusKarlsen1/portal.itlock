@page "/tilvalg"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Tilvalg - itlock</PageTitle>

<a class="back-link" href="/kundemodul">&larr; Tilbake til Kunder</a>
<h1>Tilvalg</h1>
<p class="section-hint">Alle tilvalg på tvers av prosjekter. Besvarte tilvalg du ikke har åpnet ennå er merket.</p>

@if (_tilvalg.Count == 0)
{
    <p class="list-empty">Ingen tilvalg opprettet ennå. Gå inn på et prosjekt for å opprette et nytt tilvalg.</p>
}
else
{
    <div class="tilvalg-oversikt-liste">
        @foreach (var t in _tilvalg)
        {
            <a @key="t.Id" class="tilvalg-oversikt-rad @(t.Status == TilvalgStatus.Besvart && !t.LestAvAnsatt ? "tilvalg-oversikt-uleste" : "")" href="@($"/tilvalg/{t.Id}")">
                <div class="tilvalg-oversikt-info">
                    <strong>@t.Tittel</strong>
                    <span class="tilvalg-oversikt-prosjekt">@t.Prosjekt?.Navn @(t.Prosjekt?.Kunde is not null ? $"({t.Prosjekt.Kunde.Navn})" : "")</span>
                </div>
                <span class="tilvalg-status tilvalg-status-@t.Status">@t.Status.Visningsnavn()</span>
                @if (t.Status == TilvalgStatus.Besvart && t.SumTotal.HasValue)
                {
                    <span class="tilvalg-oversikt-sum">@t.SumTotal.Value.ToString("N2") kr</span>
                }
            </a>
        }
    </div>
}

@code {
    private List<Tilvalg> _tilvalg = [];

    protected override async Task OnInitializedAsync()
    {
        _tilvalg = await Db.Tilvalg
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .OrderByDescending(t => t.Status == TilvalgStatus.Besvart && !t.LestAvAnsatt)
            .ThenByDescending(t => t.OpprettetDato)
            .ToListAsync();
    }
}
