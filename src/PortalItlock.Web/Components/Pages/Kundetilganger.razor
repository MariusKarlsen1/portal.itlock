@page "/kundetilganger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PlatformDbContext PlatformDb
@inject ITenantContext TenantCtx
@inject TenantOppslagService Oppslag

<PageTitle>Kundetilganger</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Kundetilganger</h1>
            <p class="section-hint">Innlogging for kunder som skal kunne sende inn servicehenvendelser via "For kunden". Sett en tilgang inaktiv for å midlertidig sperre den ute uten å slette den.</p>
        </div>
    </div>
    <label class="bruker-sok">
        <Icon Name="search" />
        <input type="search" placeholder="Søk …" aria-label="Søk i kundetilganger" @bind="_sok" @bind:event="oninput" />
    </label>
</div>

<div class="bruker-oppsett">
    <div class="bruker-liste">
        @if (_tilganger.Count == 0)
        {
            <p class="list-empty">Ingen kundetilganger opprettet ennå.</p>
        }
        else if (!Synlige.Any())
        {
            <p class="list-empty">Ingen kundetilganger passer søket.</p>
        }
        @foreach (var t in Synlige)
        {
            var apen = _apenId == t.Id;
            <div @key="t.Id" class="bruker-rad @(apen ? "apen" : "") @(t.Aktiv ? "" : "inaktiv")">
                <button type="button" class="bruker-rad-topp" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VelgRad(t))">
                    <span class="avatar">@Initialer(t.Navn)</span>
                    <span class="rad-info">
                        <b>@(string.IsNullOrWhiteSpace(t.Navn) ? "(Uten navn)" : t.Navn)</b>
                        <small>@KundeNavn(t.KundeId) · @t.Epost</small>
                    </span>
                    @if (!t.Aktiv)
                    {
                        <span class="status status-inaktiv">Inaktiv</span>
                    }
                    else if (!t.HarPassord)
                    {
                        <span class="status status-venter">Venter på passord</span>
                    }
                    else
                    {
                        <span></span>
                    }
                    <span class="mer-knapp" title="@(apen ? "Lukk" : "Rediger")"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                </button>

                @if (apen)
                {
                    <div class="rediger">
                        <label class="felt">
                            <span>Kontaktperson</span>
                            <input @bind="t.Navn" @bind:event="oninput" />
                        </label>
                        <label class="felt">
                            <span>E-post</span>
                            <input @bind="t.Epost" @bind:event="oninput" />
                        </label>
                        <label class="felt">
                            <span>Kunde</span>
                            <select @bind="t.KundeId">
                                <option value="">Velg kunde...</option>
                                @foreach (var k in _kunder)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                        </label>
                        <div class="felt">
                            <span>Tilgang</span>
                            <label class="bryter">
                                <input type="checkbox" @bind="t.Aktiv" />
                                <i></i>
                                @(t.Aktiv ? "Aktiv" : "Inaktiv – kan ikke logge inn")
                            </label>
                        </div>
                        <div class="rediger-bunn">
                            <span class="rediger-lenker">
                                @if (t.HarPassord)
                                {
                                    <button type="button" class="lenke-knapp" @onclick="@(() => NullstillPassord(t))"><Icon Name="lock" />Nullstill passord</button>
                                }
                                <button type="button" class="lenke-knapp farlig" @onclick="@(() => SlettTilgang(t))"><Icon Name="trash" />Slett tilgang</button>
                            </span>
                            <span class="rediger-knapper">
                                <button type="button" class="knapp-sekundaer" @onclick="Avbryt">Avbryt</button>
                                <button type="button" class="knapp-primaer" @onclick="@(() => Lagre(t))"><Icon Name="check" />Lagre</button>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <aside class="ny-bruker">
        <h2>Ny kundetilgang</h2>
        @if (_lisensTildelt > 0)
        {
            <div class="lisens @(_lisensBrukt >= _lisensTildelt ? "lisens-full" : "")">
                <span><b>@_lisensBrukt av @_lisensTildelt</b> kundetilganger – @(Math.Max(0, _lisensTildelt - _lisensBrukt)) ledige</span>
                <span class="lisens-bar"><i style="width:@(Math.Min(100, _lisensBrukt * 100 / _lisensTildelt))%"></i></span>
                @if (_lisensBrukt >= _lisensTildelt)
                {
                    <small>Dere har nådd grensen – ta kontakt med Itlock for å få aktivert flere.</small>
                }
            </div>
        }
        <label class="felt">
            <span>Kontaktperson</span>
            <input @bind="_nyNavn" @bind:event="oninput" placeholder="Navn hos kunden" />
        </label>
        <label class="felt">
            <span>E-post</span>
            <input @bind="_nyEpost" @bind:event="oninput" placeholder="navn@kunde.no" />
        </label>
        <label class="felt">
            <span>Kunde</span>
            <select @bind="_nyKundeId">
                <option value="">Velg kunde...</option>
                @foreach (var k in _kunder)
                {
                    <option value="@k.Id">@k.Navn</option>
                }
            </select>
        </label>
        <button type="button" class="knapp-primaer opprett" @onclick="OpprettTilgang" disabled="@(_nyKundeId is null)"><Icon Name="plus" />Opprett tilgang</button>
        <p class="ny-hint">Kontaktpersonen velger "Sett passord" på innloggingssiden og kan deretter sende inn henvendelser for kunden.</p>
        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="save-success">@_melding</p>
        }
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
    </aside>
</div>

@code {
    private sealed class TilgangRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public int? KundeId { get; set; }
        public bool Aktiv { get; set; }
        public bool HarPassord { get; set; }
    }

    private List<TilgangRad> _tilganger = [];
    private List<Kunde> _kunder = [];
    private string _nyNavn = "";
    private string _nyEpost = "";
    private int? _nyKundeId;
    private string? _melding;
    private string? _feil;
    private int _lisensTildelt;
    private int _lisensBrukt;
    private string _sok = "";
    private int? _apenId;

    private IEnumerable<TilgangRad> Synlige
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_sok))
            {
                return _tilganger;
            }

            var s = _sok.Trim();
            return _tilganger.Where(t => t.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)
                                      || t.Epost.Contains(s, StringComparison.OrdinalIgnoreCase)
                                      || KundeNavn(t.KundeId).Contains(s, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string KundeNavn(int? kundeId) =>
        _kunder.FirstOrDefault(k => k.Id == kundeId)?.Navn ?? "Ingen kunde valgt";

    // Klikk på en rad åpner redigering; klikk igjen (eller Avbryt) lukker og
    // henter de lagrede verdiene på nytt, så ulagrede endringer forkastes.
    private async Task VelgRad(TilgangRad rad)
    {
        if (_apenId == rad.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await LoadAsync();
        }

        _apenId = rad.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        await LoadAsync();
    }

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0].Length >= 2 ? deler[0][..2].ToUpperInvariant() : deler[0][..1].ToUpperInvariant(),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpperInvariant()
        };
    }

    private async Task LoadAsync()
    {
        _tilganger = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .Select(b => new TilgangRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                KundeId = b.KundeId,
                Aktiv = b.Aktiv,
                HarPassord = b.PasswordHash != null
            })
            .ToListAsync();

        _lisensBrukt = _tilganger.Count;
        var tenantId = TenantCtx.Current?.Id;
        _lisensTildelt = tenantId is null
            ? 0
            : await PlatformDb.TenantLisenser
                .Where(l => l.TenantId == tenantId && l.Type == LisensType.KundeTilgang)
                .Select(l => l.AntallTildelt)
                .FirstOrDefaultAsync();
    }

    private async Task OpprettTilgang()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || _nyKundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        if (await Oppslag.FinnTenantForEpostAsync(epost) is not null)
        {
            _feil = "Denne e-posten er allerede registrert hos en annen organisasjon.";
            return;
        }

        if (_lisensTildelt > 0 && _lisensBrukt >= _lisensTildelt)
        {
            _feil = $"Dere har brukt opp alle {_lisensTildelt} kundetilgangene deres. Ta kontakt med Itlock for å få aktivert flere før dere kan opprette nye kundetilganger.";
            return;
        }

        Db.Brukere.Add(new Bruker
        {
            Navn = navn,
            Epost = epost,
            Rolle = BrukerRolle.Kunde,
            KundeId = _nyKundeId
        });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _nyKundeId = null;
        _feil = null;
        _melding = $"Kundetilgangen \"{navn}\" er opprettet. De kan nå sette passord via \"Sett passord\" på innloggingssiden.";
        await LoadAsync();
    }

    private async Task Lagre(TilgangRad rad)
    {
        var navn = rad.Navn.Trim();
        var epost = rad.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || rad.KundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.KundeId = rad.KundeId;
        bruker.Aktiv = rad.Aktiv;
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
        _apenId = null;
        await LoadAsync();
    }

    private async Task NullstillPassord(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{rad.Navn}\". De kan sette nytt via \"Sett passord\" på innloggingssiden.";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettTilgang(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Navn}\" er slettet.";
        _feil = null;
        _apenId = null;
        await LoadAsync();
    }
}
