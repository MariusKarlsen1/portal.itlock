@page "/kundetilganger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PlatformDbContext PlatformDb
@inject ITenantContext TenantCtx
@inject TenantOppslagService Oppslag
@inject VisningPreferanseService VisningPref

<PageTitle>Kundetilganger</PageTitle>

@* Som Brukere: kundene i en meny inni kortet med «Alle kundetilganger» øverst og
   lisensen nederst, og tilgangene til høyre i en tabell med navn, kunde, e-post
   og status. Klikk på en rad for å redigere, sperre eller slette. *@
<div class="br @(_full ? "br-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="lock" /></span>
            <div>
                <h1>Kundetilganger</h1>
                <p class="section-hint">Innlogging for kunder som skal kunne sende inn servicehenvendelser via "For kunden". Sperr en tilgang for å stenge den ute uten å slette den.</p>
            </div>
        </div>
    </div>

    <div class="br-kort">
        <nav class="br-meny">
            <div class="br-rolleliste">
                <button type="button" class="@(_visAlle ? "pa" : "")" @onclick="VisAlle"><span>Alle kundetilganger</span><small>@_tilganger.Count</small></button>
                @foreach (var k in MenyKunder)
                {
                    var id = k.Id;
                    <button type="button" @key="k.Id" class="@(!_visAlle && Valgt == id ? "pa" : "")" @onclick="@(() => VelgKunde(id))">
                        <span>@k.Navn</span><small>@_tilganger.Count(t => t.KundeId == id)</small>
                    </button>
                }
            </div>
            <div class="br-meny-bunn">
                @if (_lisensTildelt > 0)
                {
                    <div class="lisens @(_lisensBrukt >= _lisensTildelt ? "lisens-full" : "")">
                        <span><b>Kundetilganger: @_lisensBrukt av @_lisensTildelt</b> – @(Math.Max(0, _lisensTildelt - _lisensBrukt)) ledige</span>
                        <span class="lisens-bar"><i style="width:@(Math.Min(100, _lisensBrukt * 100 / _lisensTildelt))%"></i></span>
                    </div>
                    @if (_lisensBrukt >= _lisensTildelt)
                    {
                        <small class="lisens-hint">Ta kontakt med Full Kontroll for å få aktivert flere lisenser.</small>
                    }
                }
            </div>
        </nav>

        <section class="br-innhold">
            <div class="br-verktoy">
                <label class="bruker-sok">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk kunde eller kontaktperson …" aria-label="Søk i kundetilganger" @bind="_sok" @bind:event="oninput" />
                </label>
                <button type="button" class="knapp-primaer opprett" @onclick="@(() => VisNy(_visAlle ? null : Valgt))"><Icon Name="plus" />Ny kundetilgang</button>
                <button type="button" class="br-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_melding))
            {
                <p class="save-success br-melding">@_melding</p>
            }
            @if (!string.IsNullOrEmpty(_feil) && !_visNy)
            {
                <p class="form-error br-melding">@_feil</p>
            }

            <div class="br-rull">
                @if (_visNy)
                {
                    <div class="br-ny">
                        <b>Ny kundetilgang@(_nyKundeId is int nk && _nyKundeLast ? $" hos {KundeNavn(nk)}" : "")</b>
                        <div class="br-ny-felt">
                            <label class="felt">
                                <span>Kontaktperson</span>
                                <input @bind="_nyNavn" @bind:event="oninput" placeholder="Navn hos kunden" />
                            </label>
                            <label class="felt">
                                <span>E-post</span>
                                <input @bind="_nyEpost" @bind:event="oninput" placeholder="navn@kunde.no" />
                            </label>
                            @if (!_nyKundeLast)
                            {
                                <label class="felt">
                                    <span>Kunde</span>
                                    <select @bind="_nyKundeId">
                                        <option value="">Velg kunde...</option>
                                        @foreach (var k in _kunder)
                                        {
                                            <option value="@k.Id">@k.Navn</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                        <p class="ny-hint">Kontaktpersonen velger "Sett passord" på innloggingssiden og kan deretter sende inn henvendelser for kunden.</p>
                        @if (!string.IsNullOrEmpty(_feil))
                        {
                            <p class="form-error">@_feil</p>
                        }
                        <div class="rediger-knapper">
                            <button type="button" class="knapp-sekundaer" @onclick="@(() => { _visNy = false; _feil = null; })">Avbryt</button>
                            <button type="button" class="knapp-primaer" @onclick="OpprettTilgang" disabled="@(_nyKundeId is null)"><Icon Name="plus" />Opprett tilgang</button>
                        </div>
                    </div>
                }

                <div class="bruker-liste">
                    @if (_tilganger.Count == 0)
                    {
                        <p class="list-empty">Ingen kundetilganger opprettet ennå. Trykk «Ny kundetilgang» for å lage den første.</p>
                    }
                    else if (VisteTilganger.Count == 0)
                    {
                        <p class="list-empty">@(string.IsNullOrWhiteSpace(_sok) ? "Ingen kontaktpersoner med tilgang hos denne kunden ennå." : "Ingen tilganger passer søket.")</p>
                    }
                    @if (VisteTilganger.Count > 0)
                    {
                        <div class="br-tabellhode"><span>Navn</span><span>Kunde</span><span>E-post</span><span>Status</span><span></span></div>
                    }
                    @foreach (var t in VisteTilganger)
                    {
                        var apen = _apenId == t.Id;
                        <div @key="t.Id" class="bruker-rad @(apen ? "apen" : "") @(t.Aktiv ? "" : "deaktivert")">
                            <button type="button" class="bruker-rad-topp" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VelgRad(t))">
                                <span class="rad-navn">
                                    <span class="avatar">@Initialer(t.Navn)</span>
                                    <b>@(string.IsNullOrWhiteSpace(t.Navn) ? "(Uten navn)" : t.Navn)</b>
                                </span>
                                <span class="rad-stilling">@KundeNavn(t.KundeId)</span>
                                <span class="rad-epost">
                                    @if (t.HarPassord)
                                    {
                                        @t.Epost
                                    }
                                    else
                                    {
                                        <span class="venter">Venter på passord</span>
                                    }
                                </span>
                                <span class="rolle-merke @(t.Aktiv ? "status-aktiv" : "status-sperret")">@(t.Aktiv ? "Aktiv" : "Sperret")</span>
                                <span class="mer-knapp" title="@(apen ? "Lukk" : "Rediger")"><Icon Name="@(apen ? "chevron-down" : "more-horizontal")" /></span>
                            </button>

                            @if (apen)
                            {
                                <div class="rediger">
                                    <label class="felt">
                                        <span>Kontaktperson</span>
                                        <input @bind="t.Navn" @bind:event="oninput" />
                                    </label>
                                    <label class="felt">
                                        <span>E-post</span>
                                        <input @bind="t.Epost" @bind:event="oninput" />
                                    </label>
                                    <label class="felt">
                                        <span>Kunde</span>
                                        <select @bind="t.KundeId">
                                            <option value="">Velg kunde...</option>
                                            @foreach (var k in _kunder)
                                            {
                                                <option value="@k.Id">@k.Navn</option>
                                            }
                                        </select>
                                    </label>
                                    <div class="rediger-bunn">
                                        <span class="rediger-lenker">
                                            @if (t.HarPassord)
                                            {
                                                <button type="button" class="lenke-knapp" @onclick="@(() => NullstillPassord(t))"><Icon Name="lock" />Nullstill passord</button>
                                            }
                                            @if (t.Aktiv)
                                            {
                                                <button type="button" class="lenke-knapp" @onclick="@(() => SettAktiv(t, false))"><Icon Name="x-circle" />Sperr</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="lenke-knapp" @onclick="@(() => SettAktiv(t, true))"><Icon Name="check-circle" />Åpne igjen</button>
                                            }
                                            @if (_bekreftSlett == t.Id)
                                            {
                                                <span class="slett-bekreft">Slette @t.Navn? <button type="button" class="lenke-knapp farlig" @onclick="@(() => SlettTilgang(t))">Ja, slett</button> <button type="button" class="lenke-knapp" @onclick="@(() => _bekreftSlett = null)">Avbryt</button></span>
                                            }
                                            else
                                            {
                                                <button type="button" class="lenke-knapp farlig" @onclick="@(() => _bekreftSlett = t.Id)"><Icon Name="trash" />Slett tilgang</button>
                                            }
                                        </span>
                                        <span class="rediger-knapper">
                                            <button type="button" class="knapp-sekundaer" @onclick="Avbryt">Avbryt</button>
                                            <button type="button" class="knapp-primaer" @onclick="@(() => Lagre(t))"><Icon Name="check" />Lagre</button>
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="br-bunn">@_tilganger.Count(t => t.Aktiv) aktive av @_tilganger.Count kundetilganger</div>
        </section>
    </div>
</div>

@code {
    private sealed class TilgangRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public int? KundeId { get; set; }
        public bool Aktiv { get; set; }
        public bool HarPassord { get; set; }
    }

    private List<TilgangRad> _tilganger = [];
    private List<Kunde> _kunder = [];
    private string _nyNavn = "";
    private string _nyEpost = "";
    private int? _nyKundeId;
    private string? _melding;
    private string? _feil;
    private int _lisensTildelt;
    private int _lisensBrukt;
    private string _sok = "";
    private int? _apenId;
    private int? _valgtKundeId;
    private bool _visNy;
    private bool _nyKundeLast;
    private bool _full;
    private bool _visAlle = true;
    private int? _bekreftSlett;

    // Kundene i menyen: de som har (eller nettopp har fått) tilgang, filtrert på
    // kundenavn eller kontaktpersonene hos kunden.
    private List<Kunde> MenyKunder
    {
        get
        {
            var medTilgang = _tilganger.Where(t => t.KundeId is not null).Select(t => t.KundeId!.Value).ToHashSet();
            if (_valgtKundeId is int valgt)
            {
                medTilgang.Add(valgt);
            }

            var s = _sok.Trim();
            return _kunder
                .Where(k => medTilgang.Contains(k.Id))
                .Where(k => s.Length == 0
                    || k.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || _tilganger.Any(t => t.KundeId == k.Id && (t.Navn.Contains(s, StringComparison.OrdinalIgnoreCase) || t.Epost.Contains(s, StringComparison.OrdinalIgnoreCase))))
                .ToList();
        }
    }

    private int? Valgt => _valgtKundeId is int id && MenyKunder.Any(k => k.Id == id) ? id : MenyKunder.FirstOrDefault()?.Id;

    private List<TilgangRad> VisteTilganger => _visAlle
        ? Synlige.ToList()
        : _tilganger.Where(t => t.KundeId == Valgt).ToList();

    private async Task VisAlle()
    {
        if (_apenId is not null)
        {
            await Avbryt();
        }

        _visAlle = true;
        _visNy = false;
        _melding = null;
        _feil = null;
    }

    private async Task VelgKunde(int id)
    {
        if (_apenId is not null)
        {
            await Avbryt();
        }

        _valgtKundeId = id;
        _visAlle = false;
        _visNy = false;
        _melding = null;
        _feil = null;
    }

    private void VisNy(int? kundeId)
    {
        _visNy = true;
        _nyKundeId = kundeId;
        _nyKundeLast = kundeId is not null;
        _melding = null;
        _feil = null;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("kundetilganger-bredde", _full ? "full" : "normal");
    }

    // Av/på-bryteren på raden lagrer med en gang.
    private async Task SettAktiv(TilgangRad rad, bool aktiv)
    {
        await Db.Brukere.Where(b => b.Id == rad.Id).ExecuteUpdateAsync(s => s.SetProperty(b => b.Aktiv, aktiv));
        rad.Aktiv = aktiv;
        _apenId = null;
        _feil = null;
        _melding = aktiv ? $"«{rad.Navn}» kan logge inn igjen." : $"«{rad.Navn}» er sperret og kan ikke logge inn.";
    }

    private IEnumerable<TilgangRad> Synlige
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_sok))
            {
                return _tilganger;
            }

            var s = _sok.Trim();
            return _tilganger.Where(t => t.Navn.Contains(s, StringComparison.OrdinalIgnoreCase)
                                      || t.Epost.Contains(s, StringComparison.OrdinalIgnoreCase)
                                      || KundeNavn(t.KundeId).Contains(s, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string KundeNavn(int? kundeId) =>
        _kunder.FirstOrDefault(k => k.Id == kundeId)?.Navn ?? "Ingen kunde valgt";

    // Klikk på en rad åpner redigering; klikk igjen (eller Avbryt) lukker og
    // henter de lagrede verdiene på nytt, så ulagrede endringer forkastes.
    private async Task VelgRad(TilgangRad rad)
    {
        if (_apenId == rad.Id)
        {
            await Avbryt();
            return;
        }

        if (_apenId is not null)
        {
            await LoadAsync();
        }

        _apenId = rad.Id;
        _melding = null;
        _feil = null;
    }

    private async Task Avbryt()
    {
        _apenId = null;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("kundetilganger-bredde", "normal") == "full";
        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        await LoadAsync();
    }

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0].Length >= 2 ? deler[0][..2].ToUpperInvariant() : deler[0][..1].ToUpperInvariant(),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpperInvariant()
        };
    }

    private async Task LoadAsync()
    {
        _tilganger = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Kunde && b.SlettetDato == null)
            .OrderBy(b => b.Navn)
            .Select(b => new TilgangRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                KundeId = b.KundeId,
                Aktiv = b.Aktiv,
                HarPassord = b.PasswordHash != null
            })
            .ToListAsync();

        _lisensBrukt = _tilganger.Count;
        var tenantId = TenantCtx.Current?.Id;
        _lisensTildelt = tenantId is null
            ? 0
            : await PlatformDb.TenantLisenser
                .Where(l => l.TenantId == tenantId && l.Type == LisensType.KundeTilgang)
                .Select(l => l.AntallTildelt)
                .FirstOrDefaultAsync();
    }

    private async Task OpprettTilgang()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || _nyKundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        if (await Oppslag.FinnTenantForEpostAsync(epost) is not null)
        {
            _feil = "Denne e-posten er allerede registrert hos en annen organisasjon.";
            return;
        }

        if (_lisensTildelt > 0 && _lisensBrukt >= _lisensTildelt)
        {
            _feil = $"Dere har brukt opp alle {_lisensTildelt} kundetilgangene deres. Ta kontakt med Itlock for å få aktivert flere før dere kan opprette nye kundetilganger.";
            return;
        }

        Db.Brukere.Add(new Bruker
        {
            Navn = navn,
            Epost = epost,
            Rolle = BrukerRolle.Kunde,
            KundeId = _nyKundeId
        });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _valgtKundeId = _nyKundeId;
        _visNy = false;
        _nyKundeId = null;
        _feil = null;
        _melding = $"Kundetilgangen \"{navn}\" er opprettet. De kan nå sette passord via \"Sett passord\" på innloggingssiden.";
        await LoadAsync();
    }

    private async Task Lagre(TilgangRad rad)
    {
        var navn = rad.Navn.Trim();
        var epost = rad.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || rad.KundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.KundeId = rad.KundeId;
        bruker.Aktiv = rad.Aktiv;
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
        _apenId = null;
        await LoadAsync();
    }

    private async Task NullstillPassord(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{rad.Navn}\". De kan sette nytt via \"Sett passord\" på innloggingssiden.";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettTilgang(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Navn}\" er slettet.";
        _feil = null;
        _apenId = null;
        _bekreftSlett = null;
        await LoadAsync();
    }
}
