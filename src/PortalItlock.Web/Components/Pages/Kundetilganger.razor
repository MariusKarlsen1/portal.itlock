@page "/kundetilganger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PlatformDbContext PlatformDb
@inject ITenantContext TenantCtx
@inject TenantOppslagService Oppslag

<PageTitle>Kundetilganger</PageTitle>

<span class="eyebrow">Kundeportal</span>
<h1>Kundetilganger</h1>
<p class="section-hint">Innlogging for kunder som skal kunne sende inn servicehenvendelser via "For kunden". Sett en tilgang inaktiv for å midlertidig sperre den ute uten å slette den.</p>

@if (_lisensTildelt > 0)
{
    <p class="@(_lisensBrukt >= _lisensTildelt ? "lisens-varsel lisens-varsel-full" : "lisens-varsel")">
        @_lisensBrukt av @_lisensTildelt kundetilganger i bruk.
        @if (_lisensBrukt >= _lisensTildelt)
        {
            <text> Dere har nådd grensen - ta kontakt med Itlock for å få aktivert flere før dere kan opprette nye kundetilganger.</text>
        }
    </p>
}

@if (!string.IsNullOrEmpty(_melding))
{
    <p class="save-success">@_melding</p>
}
@if (!string.IsNullOrEmpty(_feil))
{
    <p class="form-error">@_feil</p>
}

<div class="rutenett">
    @foreach (var t in _tilganger)
    {
        <div @key="t.Id" class="tilgang-kort">
            <div class="kort-topplinje"></div>
            <div class="kort-body">
                <div class="kort-header">
                    <span class="avatar">@Initialer(t.Navn)</span>
                    <div class="header-tekst">
                        <div class="kort-navn">@(string.IsNullOrWhiteSpace(t.Navn) ? "(Uten navn)" : t.Navn)</div>
                        <div class="kort-kunde">@(_kunder.FirstOrDefault(k => k.Id == t.KundeId)?.Navn ?? "Ingen kunde valgt")</div>
                    </div>
                    <span class="pille @(t.Aktiv ? "pille-aktiv" : "pille-inaktiv")"><span class="dot"></span>@(t.Aktiv ? "Aktiv" : "Inaktiv")</span>
                </div>

                <div class="felt-grid">
                    <label class="felt"><span class="felt-label">Navn</span><input @bind="t.Navn" @bind:event="oninput" /></label>
                    <label class="felt"><span class="felt-label">E-post</span><input @bind="t.Epost" @bind:event="oninput" /></label>
                    <label class="felt" style="grid-column:1 / -1;">
                        <span class="felt-label">Kunde</span>
                        <select @bind="t.KundeId">
                            <option value="">Velg kunde...</option>
                            @foreach (var k in _kunder)
                            {
                                <option value="@k.Id">@k.Navn</option>
                            }
                        </select>
                    </label>
                    <label class="felt aktiv-felt">
                        <input type="checkbox" @bind="t.Aktiv" />
                        <span class="felt-label">Aktiv tilgang</span>
                    </label>
                </div>

                <div class="kort-footer">
                    <span class="passord-status">
                        @if (t.HarPassord)
                        {
                            <span class="passord-satt">&#9679;</span> <text>Passord satt</text>
                        }
                        else
                        {
                            <span class="passord-ikke-satt">&#9679;</span> <text>Passord ikke satt</text>
                        }
                    </span>
                    <div class="btn-rad">
                        @if (t.HarPassord)
                        {
                            <button type="button" class="btn-liten" @onclick="@(() => NullstillPassord(t))">Nullstill</button>
                        }
                        <button type="button" class="btn-liten" style="color:#a32020;" @onclick="@(() => SlettTilgang(t))">Slett</button>
                        <button type="button" class="btn-liten btn-primaer" @onclick="@(() => Lagre(t))">Lagre</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="ny-tilgang-kort">
        <span class="ny-tilgang-tittel">+ Ny kundetilgang</span>
        <div class="ny-tilgang-form">
            <input @bind="_nyNavn" @bind:event="oninput" placeholder="Kontaktperson hos kunden" />
            <input @bind="_nyEpost" @bind:event="oninput" placeholder="E-post" />
            <select @bind="_nyKundeId">
                <option value="">Velg kunde...</option>
                @foreach (var k in _kunder)
                {
                    <option value="@k.Id">@k.Navn</option>
                }
            </select>
            <button type="button" class="btn-liten btn-primaer ny-tilgang-knapp" @onclick="OpprettTilgang" disabled="@(_nyKundeId is null)">Opprett</button>
        </div>
    </div>
</div>

@if (_tilganger.Count == 0)
{
    <p class="list-empty">Ingen kundetilganger opprettet ennå.</p>
}

@code {
    private sealed class TilgangRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Epost { get; set; } = "";
        public int? KundeId { get; set; }
        public bool Aktiv { get; set; }
        public bool HarPassord { get; set; }
    }

    private List<TilgangRad> _tilganger = [];
    private List<Kunde> _kunder = [];
    private string _nyNavn = "";
    private string _nyEpost = "";
    private int? _nyKundeId;
    private string? _melding;
    private string? _feil;
    private int _lisensTildelt;
    private int _lisensBrukt;

    protected override async Task OnInitializedAsync()
    {
        _kunder = await Db.Kunder.OrderBy(k => k.Navn).ToListAsync();
        await LoadAsync();
    }

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0].Length >= 2 ? deler[0][..2].ToUpperInvariant() : deler[0][..1].ToUpperInvariant(),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpperInvariant()
        };
    }

    private async Task LoadAsync()
    {
        _tilganger = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .Select(b => new TilgangRad
            {
                Id = b.Id,
                Navn = b.Navn,
                Epost = b.Epost,
                KundeId = b.KundeId,
                Aktiv = b.Aktiv,
                HarPassord = b.PasswordHash != null
            })
            .ToListAsync();

        _lisensBrukt = _tilganger.Count;
        var tenantId = TenantCtx.Current?.Id;
        _lisensTildelt = tenantId is null
            ? 0
            : await PlatformDb.TenantLisenser
                .Where(l => l.TenantId == tenantId && l.Type == LisensType.KundeTilgang)
                .Select(l => l.AntallTildelt)
                .FirstOrDefaultAsync();
    }

    private async Task OpprettTilgang()
    {
        var navn = _nyNavn.Trim();
        var epost = _nyEpost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || _nyKundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var eksisterendeEposter = await Db.Brukere.Select(b => b.Epost).ToListAsync();
        if (eksisterendeEposter.Any(e => EpostHjelper.ErLik(e, epost)))
        {
            _feil = "Det finnes allerede en bruker med denne e-posten.";
            return;
        }

        if (await Oppslag.FinnTenantForEpostAsync(epost) is not null)
        {
            _feil = "Denne e-posten er allerede registrert hos en annen organisasjon.";
            return;
        }

        if (_lisensTildelt > 0 && _lisensBrukt >= _lisensTildelt)
        {
            _feil = $"Dere har brukt opp alle {_lisensTildelt} kundetilgangene deres. Ta kontakt med Itlock for å få aktivert flere før dere kan opprette nye kundetilganger.";
            return;
        }

        Db.Brukere.Add(new Bruker
        {
            Navn = navn,
            Epost = epost,
            Rolle = BrukerRolle.Kunde,
            KundeId = _nyKundeId
        });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _nyEpost = "";
        _nyKundeId = null;
        _feil = null;
        _melding = $"Kundetilgangen \"{navn}\" er opprettet. De kan nå sette passord via \"Sett passord\" på innloggingssiden.";
        await LoadAsync();
    }

    private async Task Lagre(TilgangRad rad)
    {
        var navn = rad.Navn.Trim();
        var epost = rad.Epost.Trim();
        if (navn.Length == 0 || epost.Length == 0 || rad.KundeId is null)
        {
            _feil = "Navn, e-post og kunde må fylles ut.";
            return;
        }

        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.Navn = navn;
        bruker.Epost = epost;
        bruker.KundeId = rad.KundeId;
        bruker.Aktiv = rad.Aktiv;
        await Db.SaveChangesAsync();
        _feil = null;
        _melding = $"\"{navn}\" er lagret.";
    }

    private async Task NullstillPassord(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        bruker.PasswordHash = null;
        await Db.SaveChangesAsync();
        _melding = $"Passord nullstilt for \"{rad.Navn}\". De kan sette nytt via \"Sett passord\" på innloggingssiden.";
        _feil = null;
        await LoadAsync();
    }

    private async Task SlettTilgang(TilgangRad rad)
    {
        var bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == rad.Id);
        if (bruker is null)
        {
            return;
        }

        Db.Brukere.Remove(bruker);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Navn}\" er slettet.";
        _feil = null;
        await LoadAsync();
    }
}
