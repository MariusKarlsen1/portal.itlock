@page "/komponenter/leverandorer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Leverandører - Full Kontroll</PageTitle>

@* Som Kunder: samme side, verktøylinje og kort/liste, med logo eller initialer
   øverst på kortet, kontaktinfo, antall varer og når prisene sist ble oppdatert.
   Klikk åpner leverandøren. *@
<div class="kunder-side kl7 @(_full ? "kl7-full" : "")">

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="users" /></span>
        <div>
            <h1>Leverandører</h1>
            <p class="section-hint">Alle leverandører med varene som er koblet til dem, priser pr. leverandør og hvem som er standard for hver vare.</p>
        </div>
    </div>
</div>

<div class="kl7-kort kl7-@_visning">
<div class="verktoy-rad">
    <div class="sok-boks">
        <Icon Name="search" />
        <input @bind="_sok" @bind:event="oninput" placeholder="Søk på leverandør, kontaktperson, telefon eller e-post..." />
    </div>
    <div class="kl-visning">
        <button type="button" class="@(_visning == "liste" ? "aktiv" : "")" @onclick='@(() => VelgVisning("liste"))'><Icon Name="list" />Liste</button>
        <button type="button" class="@(_visning == "kort" ? "aktiv" : "")" @onclick='@(() => VelgVisning("kort"))'><Icon Name="grid" />Kort</button>
    </div>
    <button type="button" class="knapp knapp-primaer" @onclick="@(() => _visNyForm = !_visNyForm)"><Icon Name="plus" />Ny leverandør</button>
    <a class="knapp" href="/komponenter/prisimport"><Icon Name="upload" />Prisimport</a>
    <button type="button" class="kl7-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>
</div>

@if (_visNyForm)
{
    <div class="ny-leverandor">
        <div class="ny-leverandor-form">
            <input @bind="_nyNavn" placeholder="Navn" />
            <input @bind="_nyKontaktperson" placeholder="Kontaktperson (valgfritt)" />
            <input @bind="_nyTelefon" placeholder="Telefon (valgfritt)" />
            <button type="button" class="knapp knapp-primaer" @onclick="Opprett">Opprett</button>
            <button type="button" class="knapp" @onclick="@(() => { _visNyForm = false; _feil = null; })">Avbryt</button>
        </div>
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
    </div>
}

<p class="kl-antall">@_filtrerte.Count av @_leverandorer.Count @(_leverandorer.Count == 1 ? "leverandør" : "leverandører")</p>

@if (_filtrerte.Count == 0)
{
    <p class="list-empty">Ingen leverandører funnet.</p>
}
else if (_visning == "liste")
{
    <div class="kunde-tabell-wrap">
        <table class="kunde-tabell">
            <thead>
                <tr>
                    <th>Leverandør</th>
                    <th>Kontaktperson</th>
                    <th>Telefon</th>
                    <th>E-post</th>
                    <th>Varer</th>
                    <th>Priser oppdatert</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _filtrerte)
                {
                    var id = l.Id;
                    <tr @key="l.Id" @onclick="@(() => Nav.NavigateTo($"/komponenter/leverandorer/{id}"))">
                        <td>
                            <div class="tabell-kunde-celle">
                                @if (l.HarLogo)
                                {
                                    <img class="tabell-kunde-foto lv-logo-liten" src="@($"/leverandorlogo/{l.Id}?w=96")" loading="lazy" alt="@l.Navn" />
                                }
                                else
                                {
                                    <span class="tabell-kunde-foto-tom">@Initialer(l.Navn)</span>
                                }
                                <span class="tabell-kunde-navn">@l.Navn</span>
                            </div>
                        </td>
                        <td>@(l.Kontaktperson ?? "-")</td>
                        <td class="mono">@(string.IsNullOrWhiteSpace(l.Telefon) ? "-" : l.Telefon)</td>
                        <td>@(string.IsNullOrWhiteSpace(l.Epost) ? "-" : l.Epost)</td>
                        <td>@l.AntallVarer.ToString("N0", Kultur)</td>
                        <td>
                            @if (ErGammel(l))
                            {
                                <span class="status-pille status-pille-inaktiv">@(l.SistOppdatert?.ToString("dd.MM.yyyy") ?? "Aldri")</span>
                            }
                            else
                            {
                                @(l.SistOppdatert?.ToString("dd.MM.yyyy") ?? "-")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="kunde-grid">
        @foreach (var l in _filtrerte)
        {
            <div @key="l.Id" class="kunde-kort">
                <a class="kunde-kort-lenke" href="@($"/komponenter/leverandorer/{l.Id}")" aria-label="@($"Åpne {l.Navn}")"></a>
                <div class="kunde-kort-foto-wrap">
                    @if (l.HarLogo)
                    {
                        <img class="kunde-kort-foto lv-logo-stor" src="@($"/leverandorlogo/{l.Id}?w=480")" loading="lazy" alt="@l.Navn" />
                    }
                    else
                    {
                        <span class="kunde-kort-foto-tom">@Initialer(l.Navn)</span>
                    }
                    @if (ErGammel(l))
                    {
                        <span class="status-pille kort-status-pille status-pille-inaktiv">Gamle priser</span>
                    }
                </div>
                <div class="kunde-kort-innhold">
                    <div class="kunde-navn">@l.Navn</div>
                    <div class="kunde-info-rad">
                        <span><Icon Name="users" />@(l.Kontaktperson ?? "Ingen kontaktperson")</span>
                        <span><Icon Name="phone" />@(string.IsNullOrWhiteSpace(l.Telefon) ? "Ingen telefon" : l.Telefon)</span>
                        <span><Icon Name="mail" />@(string.IsNullOrWhiteSpace(l.Epost) ? "Ingen e-post" : l.Epost)</span>
                    </div>
                    <div class="kunde-kort-bunn">
                        <span class="prosjekt-badge"><Icon Name="box" />@l.AntallVarer.ToString("N0", Kultur) @(l.AntallVarer == 1 ? "vare" : "varer")</span>
                        <span class="type-badge">@(l.SistOppdatert is { } d ? $"Priser {d:dd.MM.yyyy}" : "Ingen prisliste")</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>

</div>

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private sealed record LeverandorRad(int Id, string Navn, string? Kontaktperson, string? Telefon, string? Epost, int AntallVarer, bool HarLogo, DateTime? SistOppdatert);

    private bool _full;

    private static bool ErGammel(LeverandorRad l) =>
        l.AntallVarer > 0 && (l.SistOppdatert is null || l.SistOppdatert < DateTime.Today.AddYears(-1));

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("leverandorer-bredde", _full ? "full" : "normal");
    }

    private List<LeverandorRad> _leverandorer = [];
    private string _sok = "";
    private bool _visNyForm;
    private string _nyNavn = "";
    private string _nyKontaktperson = "";
    private string _nyTelefon = "";
    private string? _feil;

    private List<LeverandorRad> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _leverandorer
        : _leverandorer.Where(l => Treff(l.Navn) || Treff(l.Kontaktperson) || Treff(l.Telefon) || Treff(l.Epost)).ToList();

    private bool Treff(string? tekst) => tekst?.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase) ?? false;

    private string _visning = "kort";

    protected override async Task OnInitializedAsync()
    {
        _visning = await VisningPref.HentAsync("leverandorer", "kort") == "liste" ? "liste" : "kort";
        _full = await VisningPref.HentAsync("leverandorer-bredde", "normal") == "full";
        await LastAsync();
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("leverandorer", visning);
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private async Task LastAsync()
    {
        var rader = await Db.Leverandorer
            .OrderBy(l => l.Navn)
            .Select(l => new { l.Id, l.Navn, l.Kontaktperson, l.Telefon, l.Epost, HarLogo = SqlFn.TypeOf(l.LogoData) != "null" })
            .ToListAsync();

        // Antall varer telles på koblingstabellen (l.Komponenter.Count ga 0).
        var antall = await Db.ComponentLeverandorer
            .GroupBy(cl => cl.LeverandorId)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);

        // Når prislisten sist ble lastet opp (Prisimport lagrer leverandørnavnet).
        var sist = (await Db.Importhistorikk
                .Where(h => h.Status == "Fullført" && h.Leverandor != null && (h.Kilde == "Oppdater priser" || h.Kilde == "Prisimport"))
                .Select(h => new { h.Leverandor, h.OpprettetDato })
                .ToListAsync())
            .GroupBy(h => h.Leverandor!.Trim().ToLowerInvariant())
            .ToDictionary(g => g.Key, g => g.Max(h => h.OpprettetDato));

        _leverandorer = rader
            .Select(l => new LeverandorRad(l.Id, l.Navn, l.Kontaktperson, l.Telefon, l.Epost, antall.GetValueOrDefault(l.Id), l.HarLogo,
                sist.TryGetValue(l.Navn.Trim().ToLowerInvariant(), out var d) ? d : null))
            .ToList();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        if (await Db.Leverandorer.AnyAsync(l => l.Navn.ToLower() == _nyNavn.Trim().ToLower()))
        {
            _feil = $"Det finnes allerede en leverandør som heter \"{_nyNavn.Trim()}\".";
            return;
        }

        Db.Leverandorer.Add(new Leverandor
        {
            Navn = _nyNavn.Trim(),
            Kontaktperson = string.IsNullOrWhiteSpace(_nyKontaktperson) ? null : _nyKontaktperson.Trim(),
            Telefon = string.IsNullOrWhiteSpace(_nyTelefon) ? null : _nyTelefon.Trim()
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _nyNavn = "";
        _nyKontaktperson = "";
        _nyTelefon = "";
        _visNyForm = false;
        await LastAsync();
    }
}
