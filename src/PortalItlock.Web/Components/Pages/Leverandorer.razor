@page "/komponenter/leverandorer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Leverandører - Full Kontroll</PageTitle>

<div class="leverandor-header">
    <div>
        <h1>Leverandører</h1>
        <p class="section-hint">
            Søk opp en leverandør for å se alle varene som er koblet til den, sette
            varenummer/pris pr. leverandør, og velge hvilken leverandør som er
            standard for hver vare.
        </p>
    </div>
    <button type="button" class="add-button" @onclick="@(() => _visNyForm = !_visNyForm)"><Icon Name="plus" />Ny leverandør</button>
</div>

@if (_visNyForm)
{
    <div class="ny-leverandor">
        <div class="ny-leverandor-form">
            <input @bind="_nyNavn" placeholder="Navn" />
            <input @bind="_nyKontaktperson" placeholder="Kontaktperson (valgfritt)" />
            <input @bind="_nyTelefon" placeholder="Telefon (valgfritt)" />
            <button type="button" class="add-button" @onclick="Opprett">Opprett</button>
        </div>
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
    </div>
}

<div class="leverandor-verktoy">
    <label class="sok-boks">
        <Icon Name="search" />
        <input @bind="_sok" @bind:event="oninput" placeholder="Søk leverandør..." />
    </label>
    <div class="visning-veksler">
        <button type="button" class="visning-knapp @(_visning == "kort" ? "aktiv" : "")" title="Kortvisning" @onclick='@(() => VelgVisning("kort"))'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
        </button>
        <button type="button" class="visning-knapp @(_visning == "liste" ? "aktiv" : "")" title="Listevisning" @onclick='@(() => VelgVisning("liste"))'>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="6" r="1.5" /><path d="M9.5 6h11" /><circle cx="5" cy="12" r="1.5" /><path d="M9.5 12h11" /><circle cx="5" cy="18" r="1.5" /><path d="M9.5 18h11" /></svg>
        </button>
    </div>
</div>

@if (_filtrerte.Count == 0)
{
    <p class="list-empty">Ingen leverandører funnet.</p>
}
else if (_visning == "liste")
{
    <div class="leverandor-tabell-wrap">
        <table class="leverandor-tabell">
            <thead>
                <tr>
                    <th>Leverandør</th>
                    <th>Kontaktperson</th>
                    <th>Telefon</th>
                    <th class="n">Varer</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _filtrerte)
                {
                    var id = l.Id;
                    <tr @key="l.Id" @onclick="@(() => Nav.NavigateTo($"/komponenter/leverandorer/{id}"))">
                        <td>
                            <span class="tabell-leverandor">
                                @if (l.HarLogo)
                                {
                                    <img class="tabell-logo" src="@($"/leverandorlogo/{l.Id}?w=96")" alt="@l.Navn" loading="lazy" />
                                }
                                else
                                {
                                    <span class="tabell-logo tabell-logo-tom">@Initialer(l.Navn)</span>
                                }
                                <b>@l.Navn</b>
                            </span>
                        </td>
                        <td class="dempet">@(l.Kontaktperson ?? "–")</td>
                        <td class="dempet">@(string.IsNullOrWhiteSpace(l.Telefon) ? "–" : l.Telefon)</td>
                        <td class="n">@l.AntallVarer</td>
                        <td class="n pil">›</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="leverandor-grid">
        @foreach (var l in _filtrerte)
        {
            <a @key="l.Id" class="leverandor-kort" href="@($"/komponenter/leverandorer/{l.Id}")">
                <span class="leverandor-logo-tile">
                    @if (l.HarLogo)
                    {
                        <img src="@($"/leverandorlogo/{l.Id}?w=480")" alt="@l.Navn" loading="lazy" />
                    }
                    else
                    {
                        <span class="leverandor-logo-tekst">@l.Navn</span>
                    }
                </span>
                <span class="leverandor-kort-info">
                    <span class="leverandor-kort-navn">@l.Navn</span>
                    <span class="leverandor-kort-meta">@(l.Kontaktperson ?? "Ingen kontaktperson satt")@(string.IsNullOrWhiteSpace(l.Telefon) ? "" : $" · {l.Telefon}")</span>
                </span>
                <span class="leverandor-kort-varer @(l.AntallVarer == 0 ? "tom" : "")">@l.AntallVarer @(l.AntallVarer == 1 ? "vare" : "varer")</span>
            </a>
        }
    </div>
}

@code {
    private sealed record LeverandorRad(int Id, string Navn, string? Kontaktperson, string? Telefon, int AntallVarer, bool HarLogo);

    private List<LeverandorRad> _leverandorer = [];
    private string _sok = "";
    private bool _visNyForm;
    private string _nyNavn = "";
    private string _nyKontaktperson = "";
    private string _nyTelefon = "";
    private string? _feil;

    private List<LeverandorRad> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _leverandorer
        : _leverandorer.Where(l => l.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private string _visning = "kort";

    protected override async Task OnInitializedAsync()
    {
        _visning = await VisningPref.HentAsync("leverandorer", "kort") == "liste" ? "liste" : "kort";
        await LastAsync();
    }

    private async Task VelgVisning(string visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("leverandorer", visning);
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private async Task LastAsync()
    {
        _leverandorer = await Db.Leverandorer
            .OrderBy(l => l.Navn)
            .Select(l => new LeverandorRad(l.Id, l.Navn, l.Kontaktperson, l.Telefon, l.Komponenter.Count, l.LogoData != null))
            .ToListAsync();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        if (await Db.Leverandorer.AnyAsync(l => l.Navn.ToLower() == _nyNavn.Trim().ToLower()))
        {
            _feil = $"Det finnes allerede en leverandør som heter \"{_nyNavn.Trim()}\".";
            return;
        }

        Db.Leverandorer.Add(new Leverandor
        {
            Navn = _nyNavn.Trim(),
            Kontaktperson = string.IsNullOrWhiteSpace(_nyKontaktperson) ? null : _nyKontaktperson.Trim(),
            Telefon = string.IsNullOrWhiteSpace(_nyTelefon) ? null : _nyTelefon.Trim()
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _nyNavn = "";
        _nyKontaktperson = "";
        _nyTelefon = "";
        _visNyForm = false;
        await LastAsync();
    }
}
