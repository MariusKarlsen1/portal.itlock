@page "/komponenter/leverandorer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Leverandører - itlock</PageTitle>

<a class="back-link" href="/komponentprismodul">&larr; Tilbake til komponenter og priser</a>

<div class="leverandor-header">
    <div>
        <h1>Leverandører</h1>
        <p class="section-hint">
            Søk opp en leverandør for å se alle varene som er koblet til den, sette
            varenummer/pris pr. leverandør, og velge hvilken leverandør som er
            standard for hver vare.
        </p>
    </div>
    <button type="button" class="add-button" @onclick="@(() => _visNyForm = !_visNyForm)"><Icon Name="plus" />Ny leverandør</button>
</div>

@if (_visNyForm)
{
    <div class="ny-leverandor">
        <div class="ny-leverandor-form">
            <input @bind="_nyNavn" placeholder="Navn" />
            <input @bind="_nyKontaktperson" placeholder="Kontaktperson (valgfritt)" />
            <input @bind="_nyTelefon" placeholder="Telefon (valgfritt)" />
            <button type="button" class="add-button" @onclick="Opprett">Opprett</button>
        </div>
        @if (!string.IsNullOrEmpty(_feil))
        {
            <p class="form-error">@_feil</p>
        }
    </div>
}

<label class="sok-boks">
    <Icon Name="search" />
    <input @bind="_sok" @bind:event="oninput" placeholder="Søk leverandør..." />
</label>

@if (_filtrerte.Count == 0)
{
    <p class="list-empty">Ingen leverandører funnet.</p>
}
else
{
    <div class="leverandor-grid">
        @foreach (var l in _filtrerte)
        {
            <a @key="l.Id" class="leverandor-kort" href="@($"/komponenter/leverandorer/{l.Id}")">
                <span class="leverandor-logo-tile">
                    @if (l.HarLogo)
                    {
                        <img src="@($"/leverandorlogo/{l.Id}")" alt="@l.Navn" />
                    }
                    else
                    {
                        <span class="leverandor-logo-tekst">@l.Navn</span>
                    }
                </span>
                <span class="leverandor-kort-info">
                    <span class="leverandor-kort-navn">@l.Navn</span>
                    <span class="leverandor-kort-meta">@(l.Kontaktperson ?? "Ingen kontaktperson satt")@(string.IsNullOrWhiteSpace(l.Telefon) ? "" : $" · {l.Telefon}")</span>
                </span>
                <span class="leverandor-kort-varer @(l.AntallVarer == 0 ? "tom" : "")">@l.AntallVarer @(l.AntallVarer == 1 ? "vare" : "varer")</span>
            </a>
        }
    </div>
}

@code {
    private sealed record LeverandorRad(int Id, string Navn, string? Kontaktperson, string? Telefon, int AntallVarer, bool HarLogo);

    private List<LeverandorRad> _leverandorer = [];
    private string _sok = "";
    private bool _visNyForm;
    private string _nyNavn = "";
    private string _nyKontaktperson = "";
    private string _nyTelefon = "";
    private string? _feil;

    private List<LeverandorRad> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _leverandorer
        : _leverandorer.Where(l => l.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LastAsync();

    private async Task LastAsync()
    {
        _leverandorer = await Db.Leverandorer
            .OrderBy(l => l.Navn)
            .Select(l => new LeverandorRad(l.Id, l.Navn, l.Kontaktperson, l.Telefon, l.Komponenter.Count, l.LogoData != null))
            .ToListAsync();
    }

    private async Task Opprett()
    {
        if (string.IsNullOrWhiteSpace(_nyNavn))
        {
            _feil = "Navn må fylles ut.";
            return;
        }

        if (await Db.Leverandorer.AnyAsync(l => l.Navn.ToLower() == _nyNavn.Trim().ToLower()))
        {
            _feil = $"Det finnes allerede en leverandør som heter \"{_nyNavn.Trim()}\".";
            return;
        }

        Db.Leverandorer.Add(new Leverandor
        {
            Navn = _nyNavn.Trim(),
            Kontaktperson = string.IsNullOrWhiteSpace(_nyKontaktperson) ? null : _nyKontaktperson.Trim(),
            Telefon = string.IsNullOrWhiteSpace(_nyTelefon) ? null : _nyTelefon.Trim()
        });
        await Db.SaveChangesAsync();

        _feil = null;
        _nyNavn = "";
        _nyKontaktperson = "";
        _nyTelefon = "";
        _visNyForm = false;
        await LastAsync();
    }
}
