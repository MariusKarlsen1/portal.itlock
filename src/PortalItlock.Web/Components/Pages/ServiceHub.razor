@page "/service"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]

<PageTitle>Service</PageTitle>

<h1>Service</h1>

<nav class="service-tabs">
    <button type="button" class="@TabClass("avtaler")" @onclick="@(() => _activeTab = "avtaler")">Serviceavtaler</button>
    <button type="button" class="@TabClass("oppdrag")" @onclick="@(() => _activeTab = "oppdrag")">Serviceoppdrag</button>
    <button type="button" class="@TabClass("arshjul")" @onclick="@(() => _activeTab = "arshjul")">Årshjul</button>
</nav>

@if (_activeTab == "oppdrag")
{
    <Serviceoppdrag />
}
else if (_activeTab == "arshjul")
{
    <ArshjulPanel />
}
else
{
    <Serviceavtaler />
}

@code {
    private string _activeTab = "avtaler";
    private string TabClass(string tab) => _activeTab == tab ? "tab-button tab-button-active" : "tab-button";
}
