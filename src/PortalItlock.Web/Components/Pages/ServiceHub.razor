@page "/service"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Service - Full Kontroll</PageTitle>

@* Service samlet i ett kort (S9-I + Å3, service-forslag.html): serviceavtaler med
   "Trenger handling" og kart øverst, og årshjulet. Serviceoppdrag som kunder melder
   inn ligger nå under Forespørsler. *@
<div class="service-hub-side sh-kort @(_full ? "sh-full" : "")">
    <button type="button" class="sh-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>
    <div class="sh-topp">
        <h1>Service</h1>
        <p>Serviceavtaler og årshjulet for planlagt service. Serviceoppdrag fra kunder finner du under <a href="/foresporsler?fane=serviceoppdrag">Forespørsler</a>.</p>
    </div>

    <nav class="sh-faner">
        <button type="button" class="@(_activeTab == "avtaler" ? "aktiv" : "")" @onclick='@(() => _activeTab = "avtaler")'>
            <Icon Name="clock" />Serviceavtaler<span>@_antallAvtaler</span>
        </button>
        <button type="button" class="@(_activeTab == "arshjul" ? "aktiv" : "")" @onclick='@(() => _activeTab = "arshjul")'>
            <Icon Name="calendar" />Årshjul
        </button>
    </nav>

    @if (_activeTab == "arshjul")
    {
        <ArshjulPanel />
    }
    else
    {
        <Serviceavtaler />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "fane")] public string? Fane { get; set; }

    private string _activeTab = "avtaler";
    private int _antallAvtaler;
    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _activeTab = Fane == "arshjul" ? "arshjul" : "avtaler";
        _full = await VisningPref.HentAsync("service-bredde", "normal") == "full";
        _antallAvtaler = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Serviceavtale);
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("service-bredde", _full ? "full" : "normal");
    }
}
