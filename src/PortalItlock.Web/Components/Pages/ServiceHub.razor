@page "/service"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Service - itlock</PageTitle>

<div class="service-header">
    <div class="service-header-tittel">
        <span class="service-header-ikon"><Icon Name="clock" /></span>
        <h1>Service</h1>
    </div>
    <p>Alt som gjelder service samlet på ett sted: serviceavtaler, serviceoppdrag fra kunder og årshjulet for planlagt service.</p>
</div>

<nav class="service-tabs">
    <button type="button" class="@TabClass("avtaler")" @onclick="@(() => _activeTab = "avtaler")">
        <Icon Name="clock" />Serviceavtaler<span class="tab-badge">@_antallAvtaler</span>
    </button>
    <button type="button" class="@TabClass("oppdrag")" @onclick="@(() => _activeTab = "oppdrag")">
        <Icon Name="bell" />Serviceoppdrag<span class="tab-badge">@_antallApneOppdrag</span>
    </button>
    <button type="button" class="@TabClass("arshjul")" @onclick="@(() => _activeTab = "arshjul")">
        <Icon Name="calendar" />Årshjul
    </button>
</nav>

@if (_activeTab == "oppdrag")
{
    <Serviceoppdrag />
}
else if (_activeTab == "arshjul")
{
    <ArshjulPanel />
}
else
{
    <Serviceavtaler />
}

@code {
    private string _activeTab = "avtaler";
    private int _antallAvtaler;
    private int _antallApneOppdrag;

    private string TabClass(string tab) => _activeTab == tab ? "tab-button tab-button-active" : "tab-button";

    protected override async Task OnInitializedAsync()
    {
        _antallAvtaler = await Db.Prosjekter.CountAsync(p => p.Status == ProsjektStatus.Serviceavtale);
        _antallApneOppdrag = await Db.Servicehenvendelser.CountAsync(h =>
            h.Status != ServicehenvendelseStatus.Fullfort && h.Status != ServicehenvendelseStatus.Avslatt);
    }
}
