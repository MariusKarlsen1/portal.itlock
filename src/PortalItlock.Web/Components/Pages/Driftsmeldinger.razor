@page "/driftsmeldinger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Driftsmeldinger</PageTitle>

<h1>Driftsmeldinger</h1>
<p class="section-hint">Meldinger sendt inn av driftslisenser (vaktmestere) på dører i prosjektene dine.</p>

@if (_meldinger.Count == 0)
{
    <p class="list-empty">Ingen driftsmeldinger registrert ennå.</p>
}
else
{
    <div class="melding-liste">
        @foreach (var m in _meldinger)
        {
            <div @key="m.Id" class="melding-kort">
                <div class="melding-header">
                    <div>
                        <strong>Dør @m.Dor?.Dornummer</strong> - @m.Dor?.Prosjekt?.Navn
                        <p class="melding-dato">@m.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(m.InnmeldtAvBruker is not null ? $"- {m.InnmeldtAvBruker.Navn}" : "")</p>
                    </div>
                    <a class="edit-link" href="@($"/dor/{m.DorId}")">Åpne dør</a>
                </div>
                <p class="melding-tekst">@m.Tekst</p>
                @if (m.Media.Count > 0)
                {
                    <div class="melding-media">
                        @foreach (var media in m.Media)
                        {
                            @if (media.ContentType.StartsWith("video/"))
                            {
                                <video controls class="melding-video" src="@($"/driftsmeldingmedia/{media.Id}/fil")"></video>
                            }
                            else
                            {
                                <a href="@($"/driftsmeldingmedia/{media.Id}/fil")" target="_blank">
                                    <img src="@($"/driftsmeldingmedia/{media.Id}/fil")" alt="@media.Filnavn" class="melding-bilde" />
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Driftsmelding> _meldinger = [];

    protected override async Task OnInitializedAsync()
    {
        _meldinger = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .Include(m => m.InnmeldtAvBruker)
            .Include(m => m.Media)
            .OrderByDescending(m => m.OpprettetDato)
            .ToListAsync();

        var uleseIder = _meldinger.Where(m => !m.LestAvAnsatt).Select(m => m.Id).ToList();
        if (uleseIder.Count > 0)
        {
            await Db.Driftsmeldinger.Where(m => uleseIder.Contains(m.Id))
                .ExecuteUpdateAsync(s => s.SetProperty(m => m.LestAvAnsatt, true));
        }
    }
}
