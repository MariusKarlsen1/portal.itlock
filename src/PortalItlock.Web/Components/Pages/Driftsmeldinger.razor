@page "/driftsmeldinger"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Driftsmeldinger</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="bell" /></span>
        <div>
            <h1>Driftsmeldinger</h1>
            <p class="section-hint">Meldinger sendt inn av driftslisenser (vaktmestere) på dører i prosjektene dine. Trykk på en melding for å se hele saken og opprette ticket.</p>
        </div>
    </div>
    @if (AntallUleste > 0)
    {
        <span class="uleste-pill"><Icon Name="alert" />@AntallUleste uleste</span>
    }
</div>

@if (_meldinger.Count == 0)
{
    <p class="list-empty">Ingen driftsmeldinger registrert ennå.</p>
}
else
{
    <div class="filter-rad">
        <button type="button" class="filter-chip @(!_visKunUleste ? "aktiv" : "")" @onclick="@(() => _visKunUleste = false)">Alle (@_meldinger.Count)</button>
        <button type="button" class="filter-chip @(_visKunUleste ? "aktiv" : "")" @onclick="@(() => _visKunUleste = true)">Uleste (@AntallUleste)</button>
    </div>

    <ul class="melding-liste">
        @foreach (var m in SynligeMeldinger)
        {
            <li @key="m.Id">
                <a class="melding-rad @(m.LestAvAnsatt ? "" : "ulest")" href="@($"/driftsmelding/{m.Id}")">
                    <span class="melding-ikon">
                        <Icon Name="tool" />
                        @if (!m.LestAvAnsatt)
                        {
                            <span class="prikk-ulest"></span>
                        }
                    </span>
                    <span class="melding-innhold">
                        <span class="melding-topp">
                            <span class="melding-dor">Dør @m.Dor?.Dornummer - @m.Dor?.Prosjekt?.Navn</span>
                            <span class="melding-dato">@m.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                        </span>
                        <span class="melding-utdrag">@Utdrag(m.Tekst)</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<Driftsmelding> _meldinger = [];
    private bool _visKunUleste;

    protected override async Task OnInitializedAsync()
    {
        _meldinger = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .OrderByDescending(m => m.OpprettetDato)
            .ToListAsync();
    }

    private int AntallUleste => _meldinger.Count(m => !m.LestAvAnsatt);

    private IEnumerable<Driftsmelding> SynligeMeldinger =>
        _visKunUleste ? _meldinger.Where(m => !m.LestAvAnsatt) : _meldinger;

    private static string Utdrag(string tekst) => tekst.Length > 80 ? tekst[..80] + "..." : tekst;
}
