@page "/abc-kalkulator"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>ABC-kalkulator</PageTitle>

<div class="abc-side @(_full ? "abc-full" : "")">
    <div class="side-header">
        <span class="side-header-ikon"><Icon Name="tool" /></span>
        <div>
            <h1>ABC-kalkulator</h1>
            <p class="section-hint">Ta målene og finn riktige beslag</p>
        </div>
    </div>

    @* Samme kort som Befaringslista: mål og resultat i ett kort med utvid-knapp. *@
    <div class="abc-kort">
        <button type="button" class="abc-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        <AbcKalkulator />
    </div>
</div>

@code {
    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("abc-kalkulator-bredde", "normal") == "full";
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("abc-kalkulator-bredde", _full ? "full" : "normal");
    }
}
