@page "/guide/oppsett-adgangskontroll"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Oppsett adgangskontroll</PageTitle>

<div class="adgk-panel">
    <div class="adgk-topprad">
        <a class="back-link" href="/guidermodul"><Icon Name="arrow-left" />Tilbake</a>
        <AuthorizeView Roles="Admin">
            <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "knapp-ghost")" @onclick="ToggleRedigerModus">
                <Icon Name="edit" />
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        </AuthorizeView>
    </div>

    <div class="adgk-header">
        <span class="adgk-header-ikon"><Icon Name="skjerm-sky" /></span>
        <div>
            <h1>Oppsett adgangskontroll</h1>
            <p class="section-hint">Velg systemet du skal konfigurere og følg guiden for oppsett og innstillinger.</p>
        </div>
    </div>

    <div class="adgk-grid">
        @foreach (var kategori in _kategorier)
        {
            <div @key="kategori.Id" class="adgk-kort-wrap">
                @if (_redigerModus && _redigerId == kategori.Id)
                {
                    <div class="adgk-kort-rediger">
                        <div class="adgk-kort-rediger-farger">
                            @foreach (var farge in FargeValg)
                            {
                                <button type="button" class="adgk-farge-prikk adgk-farge-prikk-@farge @(_redigerFarge == farge ? "valgt" : "")" @onclick="@(() => _redigerFarge = farge)" title="@farge"></button>
                            }
                        </div>
                        <input @bind="_redigerNavn" @bind:event="oninput" placeholder="Navn" />
                        <textarea @bind="_redigerBeskrivelse" @bind:event="oninput" rows="2" placeholder="Beskrivelse"></textarea>
                        <div class="adgk-kort-rediger-knapper">
                            <button type="button" class="knapp knapp-primaer" @onclick="LagreRediger" disabled="@string.IsNullOrWhiteSpace(_redigerNavn)">Lagre</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _redigerId = null)">Avbryt</button>
                        </div>
                    </div>
                }
                else
                {
                    <a class="adgk-kort" href="@($"/guide/oppsett-adgangskontroll/{kategori.Id}")">
                        <span class="adgk-kort-bar adgk-kort-bar-@kategori.Farge"></span>
                        <div class="adgk-kort-innhold">
                            <svg class="adgk-kort-bolge adgk-kort-bolge-@kategori.Farge" viewBox="0 0 220 110" preserveAspectRatio="none" aria-hidden="true">
                                <path d="M0 55c25-30 45 30 70 10s45-45 75-20 50 10 75-5V110H0Z" fill="currentColor" />
                            </svg>
                            <span class="adgk-kort-ikon adgk-kort-ikon-@kategori.Farge"><Icon Name="skjerm-sky" /></span>
                            <h3>@kategori.Navn</h3>
                            @if (!string.IsNullOrWhiteSpace(kategori.Beskrivelse))
                            {
                                <p>@kategori.Beskrivelse</p>
                            }
                            <span class="adgk-kort-pil adgk-kort-pil-@kategori.Farge"><Icon Name="arrow-right" /></span>
                        </div>
                    </a>
                    @if (_redigerModus)
                    {
                        @if (_slettId == kategori.Id)
                        {
                            <div class="adgk-kort-slett-confirm">
                                <p>Slette «@kategori.Navn» og alle filer under den?</p>
                                <div class="adgk-kort-slett-confirm-rad">
                                    <button type="button" class="delete-confirm-button" @onclick="@(() => SlettKategori(kategori.Id))">Ja, slett</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="adgk-kort-endre-button" title="Rediger" @onclick="@(() => StartRediger(kategori))"><Icon Name="edit" /></button>
                            <button type="button" class="adgk-kort-slett-button" title="Slett" @onclick="@(() => _slettId = kategori.Id)"><Icon Name="x" /></button>
                        }
                    }
                }
            </div>
        }

        @if (_redigerModus)
        {
            <div class="adgk-kort-ny">
                <input @bind="_nyttNavn" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettKategori(); } })"
                       placeholder="Navn på ny kategori" />
                <button type="button" class="knapp knapp-primaer" @onclick="OpprettKategori" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)"><Icon Name="plus" />Opprett ny</button>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] FargeValg = ["brun", "bla", "gronn", "gra"];

    private List<NedlastningsKategori> _kategorier = [];
    private bool _redigerModus;
    private int? _slettId;
    private string _nyttNavn = "";

    private int? _redigerId;
    private string _redigerNavn = "";
    private string _redigerBeskrivelse = "";
    private string _redigerFarge = "brun";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _kategorier = await Db.NedlastningsKategorier
            .OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn)
            .ToListAsync();
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
        _redigerId = null;
        _nyttNavn = "";
    }

    private void StartRediger(NedlastningsKategori kategori)
    {
        _redigerId = kategori.Id;
        _redigerNavn = kategori.Navn;
        _redigerBeskrivelse = kategori.Beskrivelse ?? "";
        _redigerFarge = kategori.Farge;
    }

    private async Task LagreRediger()
    {
        var navn = _redigerNavn.Trim();
        if (_redigerId is null || navn.Length == 0)
        {
            return;
        }

        var entitet = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == _redigerId);
        if (entitet is not null)
        {
            entitet.Navn = navn;
            entitet.Beskrivelse = string.IsNullOrWhiteSpace(_redigerBeskrivelse) ? null : _redigerBeskrivelse.Trim();
            entitet.Farge = _redigerFarge;
            await Db.SaveChangesAsync();
        }

        _redigerId = null;
        await LoadAsync();
    }

    private async Task OpprettKategori()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var nesteRekkefolge = _kategorier.Count == 0 ? 1 : _kategorier.Max(k => k.Rekkefolge) + 1;
        var nesteFarge = FargeValg[_kategorier.Count % FargeValg.Length];
        Db.NedlastningsKategorier.Add(new NedlastningsKategori { Navn = navn, Farge = nesteFarge, Rekkefolge = nesteRekkefolge });
        await Db.SaveChangesAsync();

        _nyttNavn = "";
        await LoadAsync();
    }

    private async Task SlettKategori(int id)
    {
        var entitet = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == id);
        if (entitet is not null)
        {
            Db.NedlastningsKategorier.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _slettId = null;
        await LoadAsync();
    }
}
