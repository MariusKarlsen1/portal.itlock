@page "/guide/oppsett-adgangskontroll"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Oppsett adgangskontroll</PageTitle>

@* O1 (oppsett-forslag): samme systemliste som /guide/kobling, med annenhver
   grå og hvit rad. Hele raden åpner systemet. *@
<div class="kob-side @(_full ? "kob-full" : "")">
    <a class="back-link kob-tilbake" href="/guidermodul"><Icon Name="arrow-left" />Tilbake</a>

    <header class="kob-hode">
        <span class="kob-hode-ikon"><Icon Name="lock" /></span>
        <div>
            <h1>Oppsett adgangskontroll</h1>
            <p>Guider og filer for oppsett av hvert system</p>
        </div>
    </header>

    <div class="kob-kort">
        <div class="kob-verktoy">
            <label class="kob-sok">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" @bind:after="TilbakeTilForsteSide" placeholder="Søk etter system, f.eks. Salto, ARX eller iLOQ" aria-label="Søk etter system" />
            </label>
            <div class="kob-filter-wrap">
                <button type="button" class="kob-knapp @(_filterValgt.Count > 0 ? "aktiv" : "")" @onclick="@(() => _visFilter = !_visFilter)">
                    <Icon Name="filter" />Filter@(_filterValgt.Count > 0 ? $" ({_filterValgt.Count})" : "")<Icon Name="chevron-down" />
                </button>
                @if (_visFilter)
                {
                    <div class="kob-filter-popup">
                        <div class="kob-filter-popup-header">
                            <strong>Filtrer på kategori</strong>
                            <button type="button" class="kob-filter-popup-lukk" @onclick="@(() => _visFilter = false)" title="Lukk"><Icon Name="x" /></button>
                        </div>
                        @foreach (var gruppe in Grupper)
                        {
                            <label class="kob-filter-popup-rad">
                                <input type="checkbox" checked="@_filterValgt.Contains(gruppe)" @onchange="@(() => ToggleFilter(gruppe))" />
                                @gruppe
                            </label>
                        }
                        <button type="button" class="kob-filter-popup-nullstill" @onclick="NullstillFilter" disabled="@(_filterValgt.Count == 0)">Nullstill</button>
                    </div>
                }
            </div>
            <AuthorizeView Roles="Admin">
                <button type="button" class="kob-knapp kob-knapp-primaer" @onclick="AapneNy"><Icon Name="plus" />Nytt system</button>
            </AuthorizeView>
            <button type="button" class="kob-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>

        <div class="kob-ramme">
            <table class="kob-liste">
                <thead>
                    <tr>
                        <th><button type="button" @onclick='@(() => Sorter("system"))'>System @SortPil("system")</button></th>
                        <th class="kob-smal-skjul"><button type="button" @onclick='@(() => Sorter("kategori"))'>Kategori @SortPil("kategori")</button></th>
                        <th><button type="button" @onclick='@(() => Sorter("produsent"))'>Produsent @SortPil("produsent")</button></th>
                        <th><button type="button" @onclick='@(() => Sorter("antall"))'>Filer @SortPil("antall")</button></th>
                        <th class="kob-smal-skjul"><button type="button" @onclick='@(() => Sorter("oppdatert"))'>Sist oppdatert @SortPil("oppdatert")</button></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Sidevisning.Count == 0)
                    {
                        <tr class="kob-ingen">
                            <td colspan="6">Ingen systemer passer søket.</td>
                        </tr>
                    }
                    @foreach (var rad in Sidevisning)
                    {
                        <tr @key="rad.Id" @onclick="@(() => Nav.NavigateTo($"/guide/oppsett-adgangskontroll/{rad.Id}"))">
                            <td><a href="@($"/guide/oppsett-adgangskontroll/{rad.Id}")" @onclick:stopPropagation="true">@rad.Navn</a></td>
                            <td class="kob-smal-skjul">@rad.Gruppe</td>
                            <td>
                                @if (rad.Produsent is null)
                                {
                                    <text>–</text>
                                }
                                else
                                {
                                    <span class="kob-merke">@rad.Produsent</span>
                                }
                            </td>
                            <td>@rad.AntallFiler</td>
                            <td class="kob-smal-skjul">@(rad.SistOppdatert?.ToString("dd.MM.yyyy", Kultur) ?? "–")</td>
                            <td class="kob-handling" @onclick:stopPropagation="true">
                                <AuthorizeView Roles="Admin">
                                    <RadMeny Navn="@rad.Navn" OnRediger="@(() => AapneRediger(rad))" OnSlett="@(() => _slettId = rad.Id)" />
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="kob-fot">
            <label class="kob-side-velger">
                Vis
                <select @bind="_sideStorrelse" @bind:after="TilbakeTilForsteSide">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                per side
            </label>
            <div class="kob-pager">
                <span>@BunnTekst</span>
                @if (AntallSider > 1)
                {
                    <button type="button" aria-label="Forrige side" disabled="@(GjeldendeSide <= 1)" @onclick="@(() => _side = GjeldendeSide - 1)"><Icon Name="chevron-left" /></button>
                    <button type="button" aria-label="Neste side" disabled="@(GjeldendeSide >= AntallSider)" @onclick="@(() => _side = GjeldendeSide + 1)"><Icon Name="chevron-right" /></button>
                }
            </div>
        </div>
    </div>
</div>

@if (_visSkjema)
{
    <div class="kob-modal-overlay" @onclick="LukkSkjema">
        <div class="kob-modal" @onclick:stopPropagation="true">
            <h2>@(_redigerId is null ? "Nytt system" : "Rediger system")</h2>

            <label class="kob-modal-felt">
                System
                <input @bind="_formNavn" placeholder="F.eks. dormakaba" />
            </label>

            <div class="kob-modal-par">
                <label class="kob-modal-felt">
                    Kategori
                    <input @bind="_formGruppe" list="adgk-grupper" placeholder="F.eks. Adgangskontroll" />
                    <datalist id="adgk-grupper">
                        @foreach (var gruppe in Grupper)
                        {
                            <option value="@gruppe"></option>
                        }
                    </datalist>
                </label>
                <label class="kob-modal-felt">
                    Produsent
                    <input @bind="_formProdusent" placeholder="Valgfritt" />
                </label>
            </div>

            <label class="kob-modal-felt">
                Beskrivelse
                <input @bind="_formBeskrivelse" placeholder="Valgfritt" />
            </label>

            @if (_formFeil is not null)
            {
                <p class="kob-modal-feil">@_formFeil</p>
            }

            <div class="kob-modal-knapper">
                <button type="button" class="cancel-button" @onclick="LukkSkjema">Avbryt</button>
                <button type="button" class="kob-nyknapp" @onclick="LagreSkjema">Lagre</button>
            </div>
        </div>
    </div>
}

@if (_slettId is not null)
{
    var slettes = _kategorier.FirstOrDefault(k => k.Id == _slettId);
    <div class="kob-modal-overlay" @onclick="@(() => _slettId = null)">
        <div class="kob-modal kob-modal-smal" @onclick:stopPropagation="true">
            <h2>Slette @(slettes?.Navn ?? "systemet")?</h2>
            <p class="kob-modal-tekst">Alle filer som ligger under systemet blir slettet sammen med det. Dette kan ikke angres.</p>
            <div class="kob-modal-knapper">
                <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                <button type="button" class="delete-confirm-button" @onclick="@(() => SlettKategori(_slettId!.Value))">Ja, slett</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private static readonly string[] FargeValg = ["brun", "bla", "gronn", "gra"];

    // Én rad i systemtabellen. "Sist oppdatert" er det ferskeste tidspunktet
    // blant filene under systemet.
    private sealed record SystemRad(
        int Id,
        string Navn,
        string Gruppe,
        string? Produsent,
        int AntallFiler,
        DateTime? SistOppdatert,
        string Farge,
        string? Beskrivelse);

    private List<NedlastningsKategori> _kategorier = [];

    private string _sok = "";
    private bool _visFilter;
    private readonly HashSet<string> _filterValgt = [];

    private string _sortKolonne = "system";
    private bool _sortStigende = true;

    private int _sideStorrelse = 10;
    private int _side = 1;

    private int? _slettId;
    private bool _full;

    private bool _visSkjema;
    private int? _redigerId;
    private string _formNavn = "";
    private string _formGruppe = "";
    private string _formProdusent = "";
    private string _formBeskrivelse = "";
    private string _formFarge = "brun";
    private string? _formFeil;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("oppsett-adgang-bredde", "normal") == "full";
        await LoadAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("oppsett-adgang-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        _kategorier = await Db.NedlastningsKategorier
            .Include(k => k.Filer)
            .OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn)
            .ToListAsync();
    }

    private List<SystemRad> AlleRader => _kategorier
        .Select(k => new SystemRad(
            k.Id,
            k.Navn,
            string.IsNullOrWhiteSpace(k.Gruppe) ? "Andre" : k.Gruppe,
            string.IsNullOrWhiteSpace(k.Produsent) ? null : k.Produsent,
            k.Filer.Count,
            k.Filer.Count == 0 ? null : k.Filer.Max(f => f.OpprettetDato),
            k.Farge,
            k.Beskrivelse))
        .ToList();

    private List<string> Grupper => AlleRader
        .Select(r => r.Gruppe)
        .Distinct()
        .OrderBy(g => g, StringComparer.CurrentCulture)
        .ToList();

    private List<SystemRad> Filtrert
    {
        get
        {
            var rader = AlleRader
                .Where(r => _filterValgt.Count == 0 || _filterValgt.Contains(r.Gruppe))
                .Where(r => string.IsNullOrWhiteSpace(_sok)
                    || r.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                    || r.Gruppe.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                    || (r.Produsent?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Beskrivelse?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false));

            rader = _sortKolonne switch
            {
                "kategori" => _sortStigende ? rader.OrderBy(r => r.Gruppe).ThenBy(r => r.Navn) : rader.OrderByDescending(r => r.Gruppe).ThenBy(r => r.Navn),
                "produsent" => _sortStigende ? rader.OrderBy(r => r.Produsent ?? "").ThenBy(r => r.Navn) : rader.OrderByDescending(r => r.Produsent ?? "").ThenBy(r => r.Navn),
                "antall" => _sortStigende ? rader.OrderBy(r => r.AntallFiler).ThenBy(r => r.Navn) : rader.OrderByDescending(r => r.AntallFiler).ThenBy(r => r.Navn),
                "oppdatert" => _sortStigende
                    ? rader.OrderBy(r => r.SistOppdatert ?? DateTime.MinValue).ThenBy(r => r.Navn)
                    : rader.OrderByDescending(r => r.SistOppdatert ?? DateTime.MinValue).ThenBy(r => r.Navn),
                _ => _sortStigende ? rader.OrderBy(r => r.Navn) : rader.OrderByDescending(r => r.Navn)
            };

            return rader.ToList();
        }
    }

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(Filtrert.Count / (double)_sideStorrelse));

    // Klemmes mot antall sider, så man ikke blir stående på en tom side når
    // søk eller filter krymper lista.
    private int GjeldendeSide => Math.Clamp(_side, 1, AntallSider);

    private List<SystemRad> Sidevisning => Filtrert
        .Skip((GjeldendeSide - 1) * _sideStorrelse)
        .Take(_sideStorrelse)
        .ToList();

    private string BunnTekst
    {
        get
        {
            var antall = Filtrert.Count;
            if (antall == 0)
            {
                return "Viser 0 systemer";
            }

            var fra = ((GjeldendeSide - 1) * _sideStorrelse) + 1;
            var til = Math.Min(fra + _sideStorrelse - 1, antall);
            return $"Viser {fra}–{til} av {antall} {(antall == 1 ? "system" : "systemer")}";
        }
    }

    private void TilbakeTilForsteSide() => _side = 1;

    private void Sorter(string kolonne)
    {
        if (_sortKolonne == kolonne)
        {
            _sortStigende = !_sortStigende;
        }
        else
        {
            _sortKolonne = kolonne;
            _sortStigende = true;
        }

        _side = 1;
    }

    private RenderFragment SortPil(string kolonne) => builder =>
    {
        var aktiv = _sortKolonne == kolonne;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"kob-sortpil{(aktiv ? " aktiv" : "")}{(aktiv && _sortStigende ? " opp" : "")}");
        builder.OpenComponent<Icon>(2);
        builder.AddComponentParameter(3, nameof(Icon.Name), "chevron-down");
        builder.CloseComponent();
        builder.CloseElement();
    };

    private void ToggleFilter(string gruppe)
    {
        if (!_filterValgt.Add(gruppe))
        {
            _filterValgt.Remove(gruppe);
        }

        _side = 1;
    }

    private void NullstillFilter()
    {
        _filterValgt.Clear();
        _side = 1;
    }

    private void AapneNy()
    {
        _redigerId = null;
        _formNavn = "";
        _formGruppe = "";
        _formProdusent = "";
        _formBeskrivelse = "";
        _formFarge = FargeValg[_kategorier.Count % FargeValg.Length];
        _formFeil = null;
        _visSkjema = true;
    }

    private void AapneRediger(SystemRad rad)
    {
        _redigerId = rad.Id;
        _formNavn = rad.Navn;
        _formGruppe = rad.Gruppe == "Andre" ? "" : rad.Gruppe;
        _formProdusent = rad.Produsent ?? "";
        _formBeskrivelse = rad.Beskrivelse ?? "";
        _formFarge = rad.Farge;
        _formFeil = null;
        _visSkjema = true;
    }

    private void LukkSkjema()
    {
        _visSkjema = false;
        _formFeil = null;
    }

    private async Task LagreSkjema()
    {
        var navn = _formNavn.Trim();
        if (navn.Length == 0)
        {
            _formFeil = "Gi systemet et navn.";
            return;
        }

        var gruppe = string.IsNullOrWhiteSpace(_formGruppe) ? null : _formGruppe.Trim();
        var produsent = string.IsNullOrWhiteSpace(_formProdusent) ? null : _formProdusent.Trim();
        var beskrivelse = string.IsNullOrWhiteSpace(_formBeskrivelse) ? null : _formBeskrivelse.Trim();

        if (_redigerId is null)
        {
            var nesteRekkefolge = _kategorier.Count == 0 ? 1 : _kategorier.Max(k => k.Rekkefolge) + 1;
            Db.NedlastningsKategorier.Add(new NedlastningsKategori
            {
                Navn = navn,
                Gruppe = gruppe,
                Produsent = produsent,
                Beskrivelse = beskrivelse,
                Farge = _formFarge,
                Rekkefolge = nesteRekkefolge
            });
        }
        else
        {
            var entitet = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == _redigerId.Value);
            if (entitet is null)
            {
                // Noen andre har slettet systemet i mellomtiden.
                LukkSkjema();
                await LoadAsync();
                return;
            }

            entitet.Navn = navn;
            entitet.Gruppe = gruppe;
            entitet.Produsent = produsent;
            entitet.Beskrivelse = beskrivelse;
            entitet.Farge = _formFarge;
        }

        await Db.SaveChangesAsync();
        LukkSkjema();
        await LoadAsync();
    }

    private async Task SlettKategori(int id)
    {
        var entitet = await Db.NedlastningsKategorier.FirstOrDefaultAsync(k => k.Id == id);
        if (entitet is not null)
        {
            Db.NedlastningsKategorier.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _slettId = null;
        await LoadAsync();
    }
}
