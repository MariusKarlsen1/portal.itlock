@page "/timerfravarmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Timer og fravær - itlock</PageTitle>

<h1>Timer og fravær</h1>
<p class="section-hint">Timeregistrering og fravær.</p>

<div class="modul-grid">
    <a href="/fravar" class="modul-card">
        <Icon Name="sun" />
        <span class="modul-card-title">Fravær</span>
        <span class="modul-card-desc">Søk om ferie eller meld fravær.</span>
    </a>
    <a href="/timeregistrering" class="modul-card">
        <Icon Name="clock" />
        <span class="modul-card-title">Timeregistrering</span>
        <span class="modul-card-desc">Registrer timer på en arbeidsordre.</span>
    </a>
</div>
