@page "/app"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject TilleggsmodulService Tilleggsmoduler

<PageTitle>Hjem</PageTitle>

@* Montørforsiden på mobil: hilsen, aktiv arbeidsordre, og seks snarveier
   (Ordre, Prosjekter, Kalender, Bilen min, Timeliste, Søknader) med en
   linje status på hver. Sandfarget topp med et svakt sirkelmønster, og én
   ikonfarge på kortene. Synkroniser, fullversjon og logg ut ligger i
   personmenyen (initialene øverst). *@
<div class="mh">
    @if (!_lastet)
    {
        <p class="mh-tom">Laster …</p>
    }
    else
    {
        <section class="mh-topp">
            <div class="mh-merkerad">
                <span class="mh-logo" aria-hidden="true"><i><b></b><b></b><b></b></i>Full Kontroll</span>
                <AppMeny />
            </div>
            <h1>@Hilsen(), @Fornavn</h1>
            <p class="mh-dato">@DatoTekst()@if (_dagens.Count > 0) {<span class="mh-prikk"></span>@(_dagens.Count == 1 ? "1 jobb i dag" : $"{_dagens.Count} jobber i dag")}</p>
            @if (_aktiv is { } a)
            {
                <div class="mh-aktiv">
                    <a class="mh-aktiv-tekst" href="@($"/app/ordre/{a.Id}")">
                        <small>@(a.Status == ArbeidsordreStatus.Pagaende ? "Pågår nå" : a.PlanlagtDato?.Date == DateTime.Today ? $"Aktiv ordre{(a.PlanlagtDato.Value.TimeOfDay > TimeSpan.Zero ? " · " + a.PlanlagtDato.Value.ToString("HH:mm") : "")}" : "Neste jobb")</small>
                        <b>#@a.Id @a.Tittel</b>
                        <span><Icon Name="map-pin" />@AdresseFor(a)</span>
                    </a>
                    <a class="mh-start" href="/min-dag" title="Start timer på dagens jobb" aria-label="Start timer på dagens jobb"><Icon Name="play" /></a>
                </div>
            }
        </section>

        <nav class="mh-liste" aria-label="Snarveier">
            @Kort("/app/ordre", "tool", "Ordre", $"{_pagaende} i arbeid · {_apne} åpne", null)
            @Kort("/app/prosjekter", "folder", "Prosjekter", $"{_prosjekter} pågående" + (_dorerIgjen > 0 ? $" · {_dorerIgjen} dører igjen" : ""), null)
            @Kort("/app/kalender", "calendar", "Kalender", KalenderTekst(), null)
            @if (_harLager)
            {
                @Kort("/app/lager", "box", "Lager", "Bilen og hovedlageret", null)
            }
            @if (_harTimer)
            {
                @Kort("/app/timeliste", "clock", "Timeliste", $"Denne uka {_ukeTimer.ToString("0.#", Kultur)} av {Ukesmal.ToString("0.#", Kultur)} t", Ring())
                @Kort("/app/soknader", "sun", "Søknader", _soknaderVenter > 0 ? $"Ferie og fravær · {_soknaderVenter} venter" : "Ferie, avspasering og fravær", _soknaderVenter > 0 ? Teller(_soknaderVenter) : null)
            }
        </nav>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    // Normal arbeidsuke, brukt til ringen på Timeliste.
    private const decimal Ukesmal = 37.5m;

    private bool _lastet;
    private string Fornavn = "";
    private List<Arbeidsordre> _dagens = [];
    private Arbeidsordre? _aktiv;
    private int _apne, _pagaende, _prosjekter, _dorerIgjen, _soknaderVenter;
    private decimal _ukeTimer;
    private bool _harLager, _harTimer;

    protected override async Task OnInitializedAsync()
    {
        var brukerId = 0;
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            brukerId = id;
        }

        var bruker = await Db.Brukere.AsNoTracking().FirstOrDefaultAsync(b => b.Id == brukerId);
        Fornavn = bruker?.Navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

        var moduler = await Tilleggsmoduler.AktiveAsync();
        _harLager = moduler.Contains(TilleggsModuler.Lager);
        _harTimer = moduler.Contains(TilleggsModuler.Timer);

        var idag = DateTime.Today;
        var mine = await Db.Arbeidsordre.AsNoTracking().Include(a => a.Prosjekt)
            .Where(a => a.AnsvarligMontorId == brukerId && (a.Status == ArbeidsordreStatus.Ny || a.Status == ArbeidsordreStatus.Klar || a.Status == ArbeidsordreStatus.Pagaende))
            .ToListAsync();
        _apne = mine.Count(a => a.Status != ArbeidsordreStatus.Pagaende);
        _pagaende = mine.Count(a => a.Status == ArbeidsordreStatus.Pagaende);
        _dagens = mine.Where(a => a.PlanlagtDato?.Date == idag).OrderBy(a => a.PlanlagtDato).ToList();

        // Aktiv ordre: det som pågår, ellers dagens første, ellers den neste planlagte.
        _aktiv = mine.FirstOrDefault(a => a.Status == ArbeidsordreStatus.Pagaende && a.PlanlagtDato?.Date == idag)
            ?? _dagens.FirstOrDefault()
            ?? mine.Where(a => a.PlanlagtDato >= idag).OrderBy(a => a.PlanlagtDato).FirstOrDefault()
            ?? mine.FirstOrDefault(a => a.Status == ArbeidsordreStatus.Pagaende);

        var pagaendeStatus = new[] { ProsjektStatus.Registrert, ProsjektStatus.UnderArbeid };
        _prosjekter = await Db.Prosjekter.CountAsync(p => p.Status != null && pagaendeStatus.Contains(p.Status.Value));
        _dorerIgjen = await Db.Dorer.CountAsync(d => d.Prosjekt!.Status == ProsjektStatus.UnderArbeid && d.Status != MontasjeStatus.FerdigMontert);

        if (_harTimer)
        {
            var mandag = idag.AddDays(-(((int)idag.DayOfWeek + 6) % 7));
            var uke = await Db.Timeregistreringer.AsNoTracking()
                .Where(t => t.MontorId == brukerId && t.Dato >= mandag && t.Dato < mandag.AddDays(7) && t.Status != TimeregistreringStatus.Avslatt)
                .Select(t => new { t.Start, t.Slutt, t.PauseMinutter }).ToListAsync();
            _ukeTimer = uke.Sum(t => Math.Max(0, (decimal)(t.Slutt - t.Start).TotalHours - t.PauseMinutter / 60m));
            _soknaderVenter = await Db.FravarSoknader.CountAsync(s => s.BrukerId == brukerId && s.Status == FravarStatus.Venter);
        }

        _lastet = true;
    }

    private static string Hilsen()
    {
        var time = DateTime.Now.Hour;
        return time >= 17 ? "God kveld" : time >= 10 ? "Hei" : "God morgen";
    }

    private static string DatoTekst()
    {
        var t = DateTime.Today.ToString("dddd d. MMMM", Kultur);
        return char.ToUpper(t[0]) + t[1..];
    }

    private string KalenderTekst()
    {
        if (_dagens.Count == 0) return "Se uka di og hvor teamet er";
        var tider = _dagens.Select(Klokke).Where(k => k.Length > 0).ToList();
        return tider.Count > 0 ? "I dag: " + string.Join(", ", tider) : $"I dag: {_dagens.Count} jobber";
    }

    private static string Klokke(Arbeidsordre a) => a.PlanlagtDato is { } d && d.TimeOfDay > TimeSpan.Zero ? d.ToString("HH:mm") : "";

    private static string AdresseFor(Arbeidsordre a)
    {
        var deler = new[] { a.Adresse ?? a.Prosjekt?.Adresse, a.Sted ?? a.Prosjekt?.Sted }.Where(s => !string.IsNullOrWhiteSpace(s));
        var adresse = string.Join(", ", deler);
        return adresse.Length > 0 ? adresse : a.Prosjekt?.Navn ?? "";
    }

    private decimal UkeProsent => Math.Round(_ukeTimer / Ukesmal * 100);

    private RenderFragment Ring() => @<span class="mh-ring" style="@($"--p:{Math.Min(100m, UkeProsent).ToString(CultureInfo.InvariantCulture)}")"><i>@UkeProsent.ToString("0", Kultur)%</i></span>;

    private static RenderFragment Teller(int antall) => @<span class="mh-teller">@antall</span>;

    private static RenderFragment Kort(string href, string ikon, string tittel, string under, RenderFragment? ekstra) => @<a class="mh-kort" href="@href">
        <span class="mh-ik"><Icon Name="@ikon" /></span>
        <span class="mh-tekst"><b>@tittel</b><small>@under</small></span>
        @ekstra
        <span class="mh-pil"><Icon Name="chevron-right" /></span>
    </a>;
}
