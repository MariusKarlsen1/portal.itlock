@page "/tilbud-service/avslatt"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref
@inject NavigationManager Nav

<PageTitle>Avslåtte tilbud service</PageTitle>

@* Samme oppsett som Godkjente tilbud (G1): topp og kort som arbeidsordrelisten,
   små nøkkeltall, chips for hvor lenge kunden hadde tilbudet, år, kunde og
   sortering, og tabell med sendt, avslått, tid hos kunden, sum og «Prøv igjen»
   (kopi av tilbudet som nytt utkast). *@
<div class="fm-side @(_full ? "fm-full" : "")">
    <div class="fm-hode">
        <div class="fm-hode-tittel">
            <span class="fm-hode-ikon rod"><Icon Name="x" /></span>
            <h1>Avslåtte tilbud</h1>
        </div>
        <p>Tilbud kunden har sagt nei til. Avslått de siste 7 dagene vises fortsatt på tavlen.</p>
    </div>

    <div class="fm-kort">
        @if (!_lastet)
        {
            <p class="list-empty">Laster...</p>
        }
        else
        {
            var iAr = IAr;
            var tapt = iAr.Sum(t => t.Sum);
            var (godkjent, besvart) = TilbudServiceSvar.Vinnerrate(_svar, _ar);
            var tider = iAr.Where(t => t.TidHosKunden is not null).Select(t => t.TidHosKunden!.Value).ToList();
            var storst = iAr.OrderByDescending(t => t.Sum).FirstOrDefault();
            <div class="fm-kpi">
                <div>
                    <span class="fm-lbl">@(_ar is int ar ? $"Tapt i {ar}" : "Tapt totalt")</span>
                    <b class="fm-rod">@Kr(tapt)</b>
                    <small>@iAr.Count tilbud
                        @if (_ar is int a && _tilbud.Any(t => t.Avslatt.Year == a - 1))
                        {
                            var ifjor = _tilbud.Where(t => t.Avslatt.Year == a - 1).Sum(t => t.Sum);
                            var endring = ifjor == 0 ? 0 : (int)Math.Round((tapt - ifjor) / ifjor * 100);
                            @* Mindre tapt enn i fjor er bra (grønt). *@
                            <span class="@(endring <= 0 ? "fm-opp" : "fm-ned")">· @(endring <= 0 ? "▼" : "▲") @Math.Abs(endring) % mot @(a - 1)</span>
                        }
                    </small>
                </div>
                <div>
                    <span class="fm-lbl">Vinnerrate</span>
                    <b>@(besvart == 0 ? "–" : $"{Math.Round(godkjent * 100m / besvart)} %")</b>
                    <small>@(besvart - godkjent) av @besvart avslått</small>
                </div>
                <div>
                    <span class="fm-lbl">Snitt tid hos kunden</span>
                    <b>@(tider.Count == 0 ? "–" : $"{Math.Round(tider.Average())} dager")</b>
                    <small>fra sendt</small>
                </div>
                <div>
                    <span class="fm-lbl">Største tap</span>
                    <b>@(storst is null ? "–" : Kr(storst.Sum))</b>
                    <small>@(storst is null ? "" : $"#{storst.TilbudId}")</small>
                </div>
            </div>

            <div class="fm-verktoy">
                <label class="fm-sok">
                    <Icon Name="search" />
                    <input @bind="_sok" @bind:event="oninput" @bind:after="TilForsteSide" placeholder="Søk på tilbud eller kunde..." />
                </label>
                <a class="fm-kn" href="/tilbud-service"><Icon Name="list" />Alle tilbud</a>
                <a class="fm-kn" href="/tilbud-service/godkjent"><Icon Name="check-circle" />Godkjente tilbud</a>
                <button type="button" class="fm-kn fm-kn-ikon" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            <div class="fm-filtre">
                @foreach (var (nokkel, navn) in new[] { ("alle", "Alle"), ("u7", "Under 7 dager"), ("7-30", "7–30 dager"), ("o30", "Over 30 dager") })
                {
                    <button type="button" class="fm-chip @(_tid == nokkel ? "paa" : "")" aria-pressed="@(_tid == nokkel ? "true" : "false")" title="Hvor lenge kunden hadde tilbudet"
                            @onclick="@(() => { _tid = nokkel; _side = 1; })">@navn <span>@iAr.Count(t => PasserTid(t, nokkel))</span></button>
                }
                <span class="fm-filtre-h">
                    <select class="fm-velg fm-velg-smal" title="År" value="@(_ar?.ToString() ?? "")" @onchange="VelgAr" aria-label="År">
                        <option value="">Alle år</option>
                        @foreach (var aar in Ar)
                        {
                            <option value="@aar">@aar</option>
                        }
                    </select>
                    <select class="fm-velg" value="@_kundeFilter" @onchange="@(e => { _kundeFilter = (string)e.Value!; _side = 1; })" aria-label="Kunde">
                        <option value="">Kunde</option>
                        @foreach (var k in _tilbud.Select(t => t.KundeNavn).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().Order())
                        {
                            <option value="@k">@k</option>
                        }
                    </select>
                    <select class="fm-velg" title="Sortering" value="@(_nyeste ? "nyeste" : "eldste")" @onchange="@(e => { _nyeste = (string?)e.Value == "nyeste"; _side = 1; })" aria-label="Sortering">
                        <option value="nyeste">Nyeste først</option>
                        <option value="eldste">Eldste først</option>
                    </select>
                </span>
            </div>

            var liste = Filtrert;
            if (_tilbud.Count == 0)
            {
                <p class="list-empty">Ingen avslåtte tilbud.</p>
            }
            else if (liste.Count == 0)
            {
                <p class="list-empty">Ingen avslåtte tilbud passer filteret.</p>
            }
            else
            {
                <div class="fm-tabwrap">
                    <table class="fm-tab">
                        <thead>
                            <tr>
                                <th>Tilbud</th>
                                <th>Sendt</th>
                                <th>Avslått</th>
                                <th>Tid hos kunden</th>
                                <th class="fm-h">Sum eks. mva</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in liste.Skip((GjeldendeSide - 1) * _perSide).Take(_perSide))
                            {
                                <tr @key="t.TilbudId" class="fm-klikk" @onclick="@(() => Nav.NavigateTo($"/tilbud/{t.TilbudId}"))">
                                    <td>
                                        <span class="fm-tilbud">
                                            <span class="fm-tav">@Initialer(t.KundeNavn ?? t.Tittel)</span>
                                            <span>
                                                <b>@t.Tittel</b>
                                                <span class="fm-sub">@(t.KundeNavn ?? "Ingen kunde satt") · #@t.TilbudId</span>
                                            </span>
                                        </span>
                                    </td>
                                    <td class="fm-nowrap fm-mut">@(t.SendtDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                    <td class="fm-nowrap">@t.Avslatt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (t.TidHosKunden is int dager)
                                        {
                                            <span class="fm-vent rod"><i><i style="width:@Math.Min(100, dager * 100 / 30)%"></i></i>@dager d</span>
                                        }
                                        else
                                        {
                                            <span class="fm-tom">–</span>
                                        }
                                    </td>
                                    <td class="fm-h fm-nowrap"><b>@(t.Sum > 0 ? Kr(t.Sum) : "–")</b></td>
                                    <td class="fm-h" @onclick:stopPropagation="true">
                                        <span class="fm-handl">
                                            <button type="button" class="fm-kn fm-kn-s" title="Lag en kopi av tilbudet som nytt utkast" disabled="@(_kopiererId is not null)"
                                                    @onclick="@(() => ProvIgjen(t.TilbudId))">
                                                @(_kopiererId == t.TilbudId ? "Kopierer..." : "↻ Prøv igjen")
                                            </button>
                                            <a class="fm-kn fm-kn-s" href="@($"/tilbud/{t.TilbudId}")">Åpne</a>
                                            <RadMeny Navn="@t.Tittel" RedigerHref="@($"/tilbud/{t.TilbudId}")" OnSlett="@(() => { _slettId = t.TilbudId; _slettNavn = t.Tittel; })" />
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Tapt &ndash; @liste.Count avslåtte tilbud</td>
                                <td class="fm-h">@Kr(liste.Sum(t => t.Sum))</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            <div class="fm-fot">
                <div class="side-navigasjon">
                    <span>Viser @((GjeldendeSide - 1) * _perSide + 1)–@Math.Min(GjeldendeSide * _perSide, liste.Count) av @liste.Count</span>
                    @if (AntallSider > 1)
                    {
                        <div class="side-knapper">
                            <button type="button" disabled="@(GjeldendeSide == 1)" @onclick="@(() => _side = GjeldendeSide - 1)">&lsaquo;</button>
                            @for (var i = 1; i <= AntallSider; i++)
                            {
                                var nr = i;
                                <button type="button" class="@(nr == GjeldendeSide ? "aktiv" : "")" @onclick="@(() => _side = nr)">@nr</button>
                            }
                            <button type="button" disabled="@(GjeldendeSide == AntallSider)" @onclick="@(() => _side = GjeldendeSide + 1)">&rsaquo;</button>
                        </div>
                    }
                </div>
                <select class="fm-velg" title="Antall per side" value="@_perSide" @onchange="@(e => { _perSide = int.Parse((string)e.Value!); _side = 1; })">
                    <option value="10">10 per side</option>
                    <option value="15">15 per side</option>
                    <option value="20">20 per side</option>
                </select>
            </div>
            }
        }
    </div>
</div>

<SlettDialog Type="SletteType.Tilbud" Id="_slettId" Navn="@_slettNavn" OnLukk="@(() => _slettId = null)" OnSlettet="TilbudSlettet" />

@code {
    private sealed class TilbudRad
    {
        public int TilbudId { get; set; }
        public string Tittel { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime? SendtDato { get; set; }
        public decimal? SendtSum { get; set; }
        public DateTime Avslatt { get; set; }
        public decimal Sum { get; set; }

        // Hvor lenge kunden hadde tilbudet før det ble avslått.
        public int? TidHosKunden => SendtDato is { } s ? Math.Max(0, (Avslatt.Date - s.Date).Days) : null;
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private List<TilbudRad> _tilbud = [];
    private List<TilbudServiceSvar.Svar> _svar = [];
    private bool _lastet;
    private bool _full;
    private string _sok = "";
    private int? _ar;
    private bool _nyeste = true;
    private int _perSide = 10;
    private int _side = 1;
    private int? _kopiererId;
    private string _tid = "alle";
    private string _kundeFilter = "";

    private static bool PasserTid(TilbudRad t, string tid)
    {
        var d = t.TidHosKunden;
        return tid switch
        {
            "u7" => d is < 7,
            "7-30" => d is >= 7 and <= 30,
            "o30" => d is > 30,
            _ => true
        };
    }

    private List<int> Ar => _tilbud.Select(t => t.Avslatt.Year).Distinct().OrderByDescending(a => a).ToList();

    private List<TilbudRad> IAr => _tilbud.Where(t => _ar is null || t.Avslatt.Year == _ar).ToList();

    private List<TilbudRad> Filtrert
    {
        get
        {
            var rader = IAr.Where(t => PasserTid(t, _tid))
                .Where(t => _kundeFilter.Length == 0 || t.KundeNavn == _kundeFilter)
                .Where(t => string.IsNullOrWhiteSpace(_sok)
                    || t.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
                    || (t.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false)
                    || t.TilbudId.ToString() == _sok.Trim().TrimStart('#'));
            return (_nyeste ? rader.OrderByDescending(t => t.Avslatt) : rader.OrderBy(t => t.Avslatt)).ToList();
        }
    }

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(Filtrert.Count / (double)_perSide));
    private int GjeldendeSide => Math.Clamp(_side, 1, AntallSider);

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    private static string Initialer(string navn) => string.Concat(
        navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    private void TilForsteSide() => _side = 1;

    private void VelgAr(ChangeEventArgs e)
    {
        _ar = int.TryParse((string?)e.Value, out var ar) ? ar : null;
        _side = 1;
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("avslatte-tilbud-bredde", _full ? "full" : "normal");
    }

    // "Prøv igjen": kopierer tilbudet med alle linjer til et nytt utkast på
    // samme serviceprosjekt, og åpner det. Det avslåtte tilbudet blir liggende.
    private async Task ProvIgjen(int tilbudId)
    {
        _kopiererId = tilbudId;
        var gammelt = await Db.Tilbud.AsNoTracking().Include(t => t.Linjer).FirstOrDefaultAsync(t => t.Id == tilbudId);
        if (gammelt is null)
        {
            _kopiererId = null;
            return;
        }

        var nytt = (Tilbud)Db.Entry(gammelt).CurrentValues.ToObject();
        nytt.Id = 0;
        nytt.Status = EndringsmeldingStatus.Utkast;
        nytt.OpprettetDato = DateTime.UtcNow;
        nytt.OppdatertDato = null;
        nytt.SendtDato = null;
        nytt.SendtSum = null;
        nytt.AvslattDato = null;
        nytt.GyldigTil = null;
        nytt.Linjer = gammelt.Linjer.Select(l =>
        {
            var kopi = (TilbudLinje)Db.Entry(l).CurrentValues.ToObject();
            kopi.Id = 0;
            kopi.TilbudId = 0;
            kopi.Plukket = false;
            kopi.PlukketDato = null;
            kopi.PlukketAvBrukerId = null;
            return kopi;
        }).ToList();
        nytt.Hendelser =
        [
            new TilbudHendelse { Beskrivelse = $"Tilbudet ble opprettet som kopi av avslått tilbud #{tilbudId}" }
        ];

        Db.Tilbud.Add(nytt);
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/tilbud/{nytt.Id}");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("avslatte-tilbud-bredde", "normal") == "full";

        // Nylig avslåtte (innenfor 7 dager) vises fortsatt i Avslått-kolonnen
        // på selve tavlen (se TilbudServiceListe.razor/ErNyligAvslatt) - denne
        // arkivsiden viser derfor kun de som enten mangler AvslattDato (avslått
        // før feltet fantes) eller er eldre enn 7 dager.
        var grense = DateTime.UtcNow.AddDays(-7);

        _tilbud = await Db.Tilbud
            .Where(t => t.Prosjekt!.Status == ProsjektStatus.Serviceavtale
                && t.Status == EndringsmeldingStatus.Avslatt
                && (t.AvslattDato == null || t.AvslattDato < grense))
            .Select(t => new TilbudRad
            {
                TilbudId = t.Id,
                Tittel = t.Tittel,
                KundeNavn = t.Prosjekt!.Kunde != null ? t.Prosjekt.Kunde.Navn : null,
                SendtDato = t.SendtDato,
                SendtSum = t.SendtSum
            })
            .ToListAsync();

        _svar = await TilbudServiceSvar.HentAsync(Db);
        var svarDato = _svar.ToDictionary(s => s.TilbudId, s => s.Dato);
        var beregnet = await TilbudServiceSvar.BeregnSummerAsync(Db, _tilbud.Where(t => t.SendtSum is null).Select(t => t.TilbudId));

        foreach (var t in _tilbud)
        {
            t.Avslatt = svarDato.GetValueOrDefault(t.TilbudId, DateTime.Today);
            t.Sum = t.SendtSum ?? beregnet.GetValueOrDefault(t.TilbudId);
        }

        _ar = Ar.Contains(DateTime.Today.Year) ? DateTime.Today.Year : null;
        _lastet = true;
    }

    // Sletting fra ⋯-menyen (bekreftes i SlettDialog).
    private int? _slettId;
    private string? _slettNavn;

    private void TilbudSlettet(int id) => _tilbud.RemoveAll(t => t.TilbudId == id);
}
