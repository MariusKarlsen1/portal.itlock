@page "/hjemmesidetekster"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Hjemmesidetekster</PageTitle>

<h1>Hjemmesidetekster</h1>
<p class="section-hint">Rediger overskrift, ingress og teksten under hver rolle-boks på forsiden. Rolleboksene til høyre oppdateres direkte mens du skriver.</p>

@if (_tekst is not null)
{
    <div class="layout">
        <div class="hoved">
            <section class="tekst-section">
                <h2>Overskrift og ingress</h2>
                <div class="field-grid">
                    <label class="span-2">
                        Overskrift
                        <input @bind="_tekst.Tittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Ingress
                        <textarea rows="3" @bind="_tekst.Ingress" @bind:event="oninput"></textarea>
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For montører</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.MontorerTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.MontorerBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For prosjektledere</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.ProsjektlederTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.ProsjektlederBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For admin</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.AdminTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.AdminBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (_melding is not null)
                {
                    <span class="save-success">@_melding</span>
                }
            </div>
        </div>

        <div class="preview">
            <div class="preview-skjerm">
                <span class="preview-label">Slik ser rolleboksene ut på forsiden</span>
                <div class="preview-roller">
                    <div class="preview-rolle-kort">
                        <span class="preview-rolle-ikon"><Icon Name="tool" /></span>
                        <span class="preview-rolle-tittel">@_tekst.MontorerTittel</span>
                        <span class="preview-rolle-tekst">@_tekst.MontorerBeskrivelse</span>
                    </div>
                    <div class="preview-rolle-kort">
                        <span class="preview-rolle-ikon"><Icon Name="folder" /></span>
                        <span class="preview-rolle-tittel">@_tekst.ProsjektlederTittel</span>
                        <span class="preview-rolle-tekst">@_tekst.ProsjektlederBeskrivelse</span>
                    </div>
                    <div class="preview-rolle-kort">
                        <span class="preview-rolle-ikon"><Icon Name="lock" /></span>
                        <span class="preview-rolle-tittel">@_tekst.AdminTittel</span>
                        <span class="preview-rolle-tekst">@_tekst.AdminBeskrivelse</span>
                    </div>
                </div>
            </div>
            <p class="preview-hint">Overskrift og ingress lagres, men vises ikke synlig noe sted på forsiden per nå &ndash; heltekst-boksen øverst styres av en dynamisk hilsen i stedet.</p>
        </div>
    </div>
}

@code {
    private HjemmesideTekst? _tekst;
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();
    }

    private async Task Lagre()
    {
        await Db.SaveChangesAsync();
        _melding = "Lagret.";
    }
}
