@page "/hjemmesidetekster"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Hjemmesidetekster</PageTitle>

<h1>Hjemmesidetekster</h1>
<p class="section-hint">Se direkte hvordan overskrift, ingress og rolle-boksene faktisk ser ut på forsiden mens du skriver.</p>

@if (_tekst is not null)
{
    <div class="layout">
        <div class="hoved">
            <section class="tekst-section">
                <h2>Overskrift og ingress</h2>
                <div class="field-grid">
                    <label class="span-2">
                        Overskrift
                        <input @bind="_tekst.Tittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Ingress
                        <textarea rows="3" @bind="_tekst.Ingress" @bind:event="oninput"></textarea>
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For montører</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.MontorerTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.MontorerBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For prosjektledere</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.ProsjektlederTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.ProsjektlederBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <section class="tekst-section">
                <h2>For admin</h2>
                <div class="field-grid">
                    <label>
                        Tittel
                        <input @bind="_tekst.AdminTittel" @bind:event="oninput" />
                    </label>
                    <label class="span-2">
                        Beskrivelse
                        <input @bind="_tekst.AdminBeskrivelse" @bind:event="oninput" />
                    </label>
                </div>
            </section>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (_melding is not null)
                {
                    <span class="save-success">@_melding</span>
                }
            </div>
        </div>

        <div class="preview">
            <div class="preview-skjerm">
                <div class="preview-hero">
                    <h1 class="preview-h1">@_tekst.Tittel</h1>
                    <p class="preview-ingress">@_tekst.Ingress</p>
                </div>
                <div class="rolle-rad">
                    <div class="rolle-kort">
                        <span class="rolle-ikon"><Icon Name="tool" /></span>
                        <span class="rolle-tittel">@_tekst.MontorerTittel</span>
                        <span class="rolle-beskrivelse">@_tekst.MontorerBeskrivelse</span>
                    </div>
                    <div class="rolle-kort">
                        <span class="rolle-ikon"><Icon Name="folder" /></span>
                        <span class="rolle-tittel">@_tekst.ProsjektlederTittel</span>
                        <span class="rolle-beskrivelse">@_tekst.ProsjektlederBeskrivelse</span>
                    </div>
                    <div class="rolle-kort">
                        <span class="rolle-ikon"><Icon Name="lock" /></span>
                        <span class="rolle-tittel">@_tekst.AdminTittel</span>
                        <span class="rolle-beskrivelse">@_tekst.AdminBeskrivelse</span>
                    </div>
                </div>
            </div>
            <p class="preview-hint">Slik ser toppen av forsiden ut for brukerne</p>
        </div>
    </div>
}

@code {
    private HjemmesideTekst? _tekst;
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();
    }

    private async Task Lagre()
    {
        await Db.SaveChangesAsync();
        _melding = "Lagret.";
    }
}
