@page "/hjemmesidetekster"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Hjemmesidetekster</PageTitle>

<h1>Hjemmesidetekster</h1>
<p>Rediger overskrift, ingress og teksten under hver rolle-boks på forsiden.</p>

@if (_tekst is not null)
{
    <section class="tekst-section">
        <h2>Overskrift og ingress</h2>
        <div class="field-grid">
            <label class="span-2">
                Overskrift
                <input @bind="_tekst.Tittel" @bind:event="oninput" />
            </label>
            <label class="span-2">
                Ingress
                <textarea rows="3" @bind="_tekst.Ingress" @bind:event="oninput"></textarea>
            </label>
        </div>
    </section>

    <section class="tekst-section">
        <h2>For montører</h2>
        <div class="field-grid">
            <label>
                Tittel
                <input @bind="_tekst.MontorerTittel" @bind:event="oninput" />
            </label>
            <label class="span-2">
                Beskrivelse
                <input @bind="_tekst.MontorerBeskrivelse" @bind:event="oninput" />
            </label>
        </div>
    </section>

    <section class="tekst-section">
        <h2>For prosjektledere</h2>
        <div class="field-grid">
            <label>
                Tittel
                <input @bind="_tekst.ProsjektlederTittel" @bind:event="oninput" />
            </label>
            <label class="span-2">
                Beskrivelse
                <input @bind="_tekst.ProsjektlederBeskrivelse" @bind:event="oninput" />
            </label>
        </div>
    </section>

    <section class="tekst-section">
        <h2>For admin</h2>
        <div class="field-grid">
            <label>
                Tittel
                <input @bind="_tekst.AdminTittel" @bind:event="oninput" />
            </label>
            <label class="span-2">
                Beskrivelse
                <input @bind="_tekst.AdminBeskrivelse" @bind:event="oninput" />
            </label>
        </div>
    </section>

    <div class="form-actions">
        <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
        @if (_melding is not null)
        {
            <span class="save-success">@_melding</span>
        }
    </div>
}

@code {
    private HjemmesideTekst? _tekst;
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        _tekst = await Db.HjemmesideTekster.FirstOrDefaultAsync();
    }

    private async Task Lagre()
    {
        await Db.SaveChangesAsync();
        _melding = "Lagret.";
    }
}
