@page "/dashbord"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Dashbord - Full Kontroll</PageTitle>

@* Oppsett "A2 Rolig" (oktober 2026): ett kort med faner som ticket og
   arbeidsordre, fire nøkkeltall per fane, varsler som en enkel liste og
   dempede farger i grafene. *@
<div class="db-side @(_full ? "db-full" : "")" @onclick="@(() => _visArValg = false)">

    <div class="d2-topp">
        <div>
            <h1>Dashbord</h1>
            <p>Tilbud, prosjekter, drift og økonomi – alt på ett sted</p>
        </div>
        <div class="d2-topp-hoyre">
            <span class="d2-oppdatert">Oppdatert @_lastet.ToString("dd.MM 'kl.' HH:mm")</span>
            <div class="d2-ar" @onclick:stopPropagation="true">
                <button type="button" class="d2-ar-knapp" @onclick="ToggleArValg"><Icon Name="calendar" />@_valgtAr<Icon Name="chevron-down" /></button>
                @if (_visArValg)
                {
                    <div class="d2-ar-meny">
                        @foreach (var ar in TilgjengeligeAr)
                        {
                            <button type="button" class="@(ar == _valgtAr ? "aktiv" : "")" @onclick="@(() => VelgAr(ar))">@ar</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d2-kort">
        <nav class="d2-faner">
            <button type="button" class="d2-fane @(_fane == "oversikt" ? "aktiv" : "")" @onclick="@(() => _fane = "oversikt")"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="d2-fane @(_fane == "tilbud" ? "aktiv" : "")" @onclick="@(() => _fane = "tilbud")"><Icon Name="file-text" />Tilbud @if (_venter.Count > 0) {<em>@_venter.Count</em>}</button>
            <button type="button" class="d2-fane @(_fane == "prosjekter" ? "aktiv" : "")" @onclick="@(() => _fane = "prosjekter")"><Icon Name="folder" />Prosjekter</button>
            <button type="button" class="d2-fane @(_fane == "arbeidsordre" ? "aktiv" : "")" @onclick="@(() => _fane = "arbeidsordre")"><Icon Name="tool" />Arbeidsordre @if (KlarTilFakturering.Count > 0) {<em>@KlarTilFakturering.Count</em>}</button>
            <button type="button" class="d2-fane @(_fane == "tickets" ? "aktiv" : "")" @onclick="@(() => _fane = "tickets")"><Icon Name="alert" />Tickets @if (_ticketsSlaForfalt > 0) {<em class="r">@_ticketsSlaForfalt</em>}</button>
            <button type="button" class="d2-fane @(_fane == "driftsmeldinger" ? "aktiv" : "")" @onclick="@(() => _fane = "driftsmeldinger")"><Icon Name="mail" />Driftsmeldinger @if (DmNye > 0) {<em class="r">@DmNye</em>}</button>
            <button type="button" class="d2-fane @(_fane == "okonomi" ? "aktiv" : "")" @onclick="@(() => _fane = "okonomi")"><Icon Name="receipt" />Økonomi</button>
            <button type="button" class="d2-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>
        </nav>

        <div class="d2-innhold">

        @if (_fane == "oversikt")
        {
            <div class="d2-varsler">
                @if (_ticketsSlaForfalt > 0)
                {
                    var eldste = _ticketsApneListe.Where(t => t.SlaFrist < DateTime.Now).OrderBy(t => t.SlaFrist).First();
                    <button type="button" class="d2-varsel" @onclick="@(() => _fane = "tickets")"><i class="d2-prikk rod"></i><span><b>@_ticketsSlaForfalt @(_ticketsSlaForfalt == 1 ? "ticket har" : "tickets har") passert SLA-fristen</b><small>Eldste: #@eldste.Id @eldste.Tittel – @Varighet(DateTime.Now - eldste.SlaFrist!.Value) over</small></span><span class="d2-varsel-lenke">Se →</span></button>
                }
                @if (VenterLenge.Count > 0)
                {
                    <button type="button" class="d2-varsel" @onclick="@(() => { _fane = "tilbud"; _filter = "venter"; })"><i class="d2-prikk gul"></i><span><b>@VenterLenge.Count @(VenterLenge.Count == 1 ? "tilbud har" : "tilbud har") ventet svar i over 14 dager</b><small>Til sammen @Kr(VenterLenge.Sum(t => t.SendtSum ?? 0))</small></span><span class="d2-varsel-lenke">Følg opp →</span></button>
                }
                @if (KlarTilFakturering.Count > 0)
                {
                    <button type="button" class="d2-varsel" @onclick="@(() => _fane = "arbeidsordre")"><i class="d2-prikk bla"></i><span><b>@KlarTilFakturering.Count @(KlarTilFakturering.Count == 1 ? "arbeidsordre er klar" : "arbeidsordre er klare") til fakturering</b><small>Ferdig, ikke fakturert</small></span><span class="d2-varsel-lenke">Se →</span></button>
                }
                @if (_ticketsSlaForfalt == 0 && VenterLenge.Count == 0 && KlarTilFakturering.Count == 0)
                {
                    <div class="d2-varsel"><i class="d2-prikk gronn"></i><span><b>Alt er i rute</b><small>Ingen forfalte tickets, gamle tilbud eller ordre som venter fakturering</small></span><span></span></div>
                }
            </div>

            <div class="d2-kpis">
                <div class="d2-kpi"><small>Vinnprosent</small><b>@(_avgjorte == 0 ? "–" : $"{_vinnprosent:N0} %")</b><span>@_vunnet.Count vunnet av @_avgjorte avgjorte</span></div>
                <div class="d2-kpi"><small>Venter svar</small><b>@KrKort(_venter.Sum(t => t.SendtSum ?? 0))</b><span>@_venter.Count tilbud</span></div>
                <div class="d2-kpi"><small>Vunnet</small><b>@KrKort(_vunnet.Sum(t => t.SendtSum ?? 0))</b><span>@_vunnet.Count tilbud</span></div>
                <div class="d2-kpi"><small>Avslått</small><b>@KrKort(_avslatt.Sum(t => t.SendtSum ?? 0))</b><span>@_avslatt.Count tilbud</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Tilbud sendt per måned</h3><div class="d2-forkl"><span><i class="f-brun"></i>Vunnet</span><span><i class="f-beige"></i>Venter svar</span><span><i class="f-lys"></i>Avslått</span></div></div>
                    @Soyler(_maneder.Select(m => new[] { m.VunnetSum, m.VenterSum, m.AvslattSum }).ToList(), ["f-brun", "f-beige", "f-lys"])
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Omsetning hittil i år</h3><span class="d2-chip">@(_omsetningDeltaProsent >= 0 ? "↗ +" : "↘ ")@_omsetningDeltaProsent % mot i fjor</span></div>
                    <div class="d2-stortall">@Kr(_omsetningHittil)</div>
                    @Linje()
                    <div class="d2-forkl"><span><i class="f-brun"></i>@_valgtAr</span><span><i class="f-stiplet"></i>@(_valgtAr - 1)</span></div>
                </section>
            </div>

            <div class="d2-g3">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Salgstrakt</h3><small>@_valgtAr</small></div>
                    <div class="d2-trakt">
                        @foreach (var (navn, antall, sum, klasse) in Trakt)
                        {
                            <div class="d2-trakt-rad"><span>@navn</span><span><span class="d2-trakt-bar @klasse" style="width:@Prosent(antall, Math.Max(1, _arTilbud.Count))%">@antall</span></span><span class="d2-trakt-sum">@KrKort(sum)</span></div>
                        }
                    </div>
                    <small class="d2-dempet">Vinnprosent @(_avgjorte == 0 ? "–" : $"{_vinnprosent:N0} %")</small>
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>I dag</h3><a class="d2-lenke" href="/arbeidsordre">Arbeidsordre →</a></div>
                    @if (IDag.Count == 0)
                    {
                        <p class="d2-tom">Ingen arbeidsordre planlagt i dag.</p>
                    }
                    @foreach (var a in IDag)
                    {
                        <a class="d2-rad" href="@($"/arbeidsordre/{a.Id}")">
                            <span class="d2-av">@Initialer(a.AnsvarligMontor?.Navn)</span>
                            <span><b>@a.Tittel</b><small>@(a.Prosjekt?.Navn ?? a.Kunde?.Navn ?? "")@(a.PlanlagtDato?.TimeOfDay > TimeSpan.Zero ? $" · {a.PlanlagtDato:HH:mm}" : "")</small></span>
                            <span class="d2-chip">@a.Status.Visningsnavn()</span>
                        </a>
                    }
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Kommende frister</h3></div>
                    @if (_kommendeFrister.Count == 0)
                    {
                        <p class="d2-tom">Ingen kommende frister.</p>
                    }
                    @foreach (var f in _kommendeFrister)
                    {
                        <div class="d2-rad">
                            <span class="d2-ik"><Icon Name="@f.Ikon" /></span>
                            <span><b>@f.Tittel</b><small>@f.Undertekst · @f.Dato.ToString("dd.MM.yyyy")</small></span>
                            <span class="d2-chip @(f.Farge == "rod" ? "rod" : "")">@f.RelativTekst</span>
                        </div>
                    }
                </section>
            </div>
        }
        else if (_fane == "tilbud")
        {
            var eldsteVenter = _venter.Where(t => t.SendtDato.HasValue).OrderBy(t => t.SendtDato).FirstOrDefault();
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Vinnprosent</small><b>@(_avgjorte == 0 ? "–" : $"{_vinnprosent:N0} %")</b><span>@_vunnet.Count av @_avgjorte avgjorte</span></div>
                <div class="d2-kpi"><small>Venter svar</small><b>@KrKort(_venter.Sum(t => t.SendtSum ?? 0))</b><span>@_venter.Count tilbud</span></div>
                <div class="d2-kpi"><small>Eldste ubesvarte</small><b>@(eldsteVenter is null ? "–" : $"{DagerSiden(eldsteVenter.SendtDato)} dager")</b><span>@(eldsteVenter?.Tittel ?? "Ingen tilbud venter")</span></div>
                <div class="d2-kpi"><small>Sendt i @_valgtAr</small><b>@_arTilbud.Count</b><span>@KrKort(_arTilbud.Sum(t => t.SendtSum ?? 0))</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Vunnet og tapt per måned</h3><div class="d2-forkl"><span><i class="f-brun"></i>Vunnet</span><span><i class="f-lys"></i>Avslått</span></div></div>
                    @Soyler(_maneder.Select(m => new[] { m.VunnetSum, m.AvslattSum }).ToList(), ["f-brun", "f-lys"])
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Største tilbud som venter</h3></div>
                    @if (_venter.Count == 0)
                    {
                        <p class="d2-tom">Ingen tilbud venter svar.</p>
                    }
                    @foreach (var t in _venter.OrderByDescending(t => t.SendtSum ?? 0).Take(3))
                    {
                        <a class="d2-rad" href="@($"/tilbud/{t.Id}")">
                            <span class="d2-ik"><Icon Name="file-text" /></span>
                            <span><b>@t.Tittel</b><small>@(t.Prosjekt?.Kunde?.Navn ?? "Ingen kunde") · venter <span class="@(DagerSiden(t.SendtDato) > 14 ? "d2-rodtekst" : "")">@DagerSiden(t.SendtDato) d</span></small></span>
                            <span class="d2-rad-hoyre"><b>@KrKort(t.SendtSum ?? 0)</b><span class="d2-knapp">Følg opp</span></span>
                        </a>
                    }
                </section>
            </div>

            <section class="d2-tile">
                <div class="d2-tabhode">
                    <div class="d2-segm">
                        <button type="button" class="@(_filter == "alle" ? "aktiv" : "")" @onclick="@(() => _filter = "alle")">Alle<em>@_arTilbud.Count</em></button>
                        <button type="button" class="@(_filter == "venter" ? "aktiv" : "")" @onclick="@(() => _filter = "venter")">Venter svar<em>@_venter.Count</em></button>
                        <button type="button" class="@(_filter == "vunnet" ? "aktiv" : "")" @onclick="@(() => _filter = "vunnet")">Vunnet<em>@_vunnet.Count</em></button>
                        <button type="button" class="@(_filter == "avslatt" ? "aktiv" : "")" @onclick="@(() => _filter = "avslatt")">Avslått<em>@_avslatt.Count</em></button>
                    </div>
                    <label class="d2-sok"><Icon Name="search" /><input @bind="_sok" @bind:event="oninput" placeholder="Søk i tilbud eller kunde..." /></label>
                </div>
                @if (TilbudVises.Count == 0)
                {
                    <p class="d2-tom">Ingen tilbud å vise.</p>
                }
                else
                {
                    <div class="d2-tabwrap">
                        <table class="d2-tabell">
                            <thead><tr><th>Tilbud</th><th>Kunde</th><th class="n">Sum</th><th>Sendt</th><th>Ventet</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in TilbudVises)
                                {
                                    var venter = t.Status == EndringsmeldingStatus.SendtTilKunde;
                                    <tr @key="t.Id">
                                        <td><a href="@($"/tilbud/{t.Id}")">@t.Tittel</a></td>
                                        <td>@(t.Prosjekt?.Kunde?.Navn ?? "Ingen kunde")</td>
                                        <td class="n">@Kr(t.SendtSum ?? 0)</td>
                                        <td>@t.SendtDato?.ToString("dd.MM.yyyy")</td>
                                        <td>@if (venter) {<span class="@(DagerSiden(t.SendtDato) > 14 ? "d2-rodtekst" : "")">@DagerSiden(t.SendtDato) d</span>} else {<span class="d2-dempet">–</span>}</td>
                                        <td><span class="d2-status @TilbudStatusKlasse(t.Status)">@t.Status.Visningsnavn()</span></td>
                                        <td>@if (venter) {<a class="d2-knapp" href="@($"/tilbud/{t.Id}")">Følg opp</a>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else if (_fane == "prosjekter")
        {
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Aktive prosjekter</small><b>@AktiveProsjekter.Count</b><span>uten serviceavtaler</span></div>
                <div class="d2-kpi"><small>Vunnet (overlevert)</small><b>@KrKort(ProsjekterVunnet.Sum(x => x.Verdi))</b><span>@ProsjekterVunnet.Count prosjekter</span></div>
                <div class="d2-kpi"><small>Tapt</small><b>@KrKort(ProsjekterTapt.Sum(x => x.Verdi))</b><span>@ProsjekterTapt.Count prosjekter</span></div>
                <div class="d2-kpi"><small>Serviceavtaler</small><b>@_prosjekterAlle.Count(p => p.Status == ProsjektStatus.Serviceavtale)</b><span>aktive avtaler</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Aktive prosjekter – fremdrift</h3><a class="d2-lenke" href="/prosjekter">Alle prosjekter →</a></div>
                    @if (AktiveProsjekter.Count == 0)
                    {
                        <p class="d2-tom">Ingen aktive prosjekter.</p>
                    }
                    @foreach (var p in AktiveProsjekter.Take(6))
                    {
                        var ferdig = p.Arbeidsordre.Count(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert);
                        <a class="d2-rad d2-rad-fremdrift" href="@($"/prosjekter/{p.Id}")">
                            <span><b>@p.Navn</b><small>@(p.Arbeidsordre.Count == 0 ? "Ingen arbeidsordre ennå" : $"{ferdig} av {p.Arbeidsordre.Count} arbeidsordre ferdig")</small></span>
                            <span class="d2-bar"><i style="width:@Prosent(ferdig, Math.Max(1, p.Arbeidsordre.Count))%"></i></span>
                            <span class="d2-prosent">@Prosent(ferdig, Math.Max(1, p.Arbeidsordre.Count)) %</span>
                        </a>
                    }
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Prosjekter per fase</h3></div>
                    <div class="d2-trakt">
                        @foreach (var (navn, antall) in Faser)
                        {
                            <div class="d2-trakt-rad"><span>@navn</span><span><span class="d2-trakt-bar f-brun" style="width:@Prosent(antall, Math.Max(1, Faser.Max(f => f.Antall)))%">@antall</span></span><span></span></div>
                        }
                    </div>
                </section>
            </div>

            <section class="d2-tile">
                <div class="d2-tabhode">
                    <h3 class="d2-tab-tittel">Vunnet og tapt</h3>
                    <div class="d2-segm">
                        <button type="button" class="@(_prosjektFilter == "alle" ? "aktiv" : "")" @onclick="@(() => _prosjektFilter = "alle")">Alle</button>
                        <button type="button" class="@(_prosjektFilter == "vunnet" ? "aktiv" : "")" @onclick="@(() => _prosjektFilter = "vunnet")">Vunnet</button>
                        <button type="button" class="@(_prosjektFilter == "tapt" ? "aktiv" : "")" @onclick="@(() => _prosjektFilter = "tapt")">Tapt</button>
                    </div>
                </div>
                @{ var vt = VunnetOgTapt.Where(x => _prosjektFilter == "alle" || (_prosjektFilter == "vunnet") == x.ErVunnet).Take(10).ToList(); }
                @if (vt.Count == 0)
                {
                    <p class="d2-tom">Ingen vunnet eller tapte prosjekter ennå.</p>
                }
                else
                {
                    <div class="d2-tabwrap">
                        <table class="d2-tabell">
                            <thead><tr><th>Prosjekt</th><th>Kunde</th><th>Status</th><th class="n">Verdi</th><th>Dato</th></tr></thead>
                            <tbody>
                                @foreach (var x in vt)
                                {
                                    <tr @key="x.Prosjekt.Id">
                                        <td><a href="@($"/prosjekter/{x.Prosjekt.Id}")">@x.Prosjekt.Navn</a></td>
                                        <td>@(x.Prosjekt.Kunde?.Navn ?? "Ingen kunde")</td>
                                        <td><span class="d2-status @(x.ErVunnet ? "gronn" : "rod")">@(x.ErVunnet ? "Vunnet" : "Tapt")</span></td>
                                        <td class="n">@Kr(x.Verdi)</td>
                                        <td>@x.Dato.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else if (_fane == "arbeidsordre")
        {
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Planlagt denne uken</small><b>@PlanlagtDenneUken</b><span>@IDag.Count i dag</span></div>
                <div class="d2-kpi"><small>Pågående</small><b>@_arbeidsordreAlle.Count(a => a.Status == ArbeidsordreStatus.Pagaende)</b><span>@_arbeidsordreAlle.Count(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar) nye eller klare</span></div>
                <div class="d2-kpi"><small>Ferdig – ikke fakturert</small><b>@KlarTilFakturering.Count</b><span>@KrKort(KlarTilFakturering.Sum(ArbeidsordreBeregningHelper.BeregnVareSum))</span></div>
                <div class="d2-kpi"><small>Fakturert</small><b>@ArbeidsordreFakturert.Count</b><span>@KrKort(ArbeidsordreFakturert.Sum(x => x.Verdi))</span></div>
            </div>

            <section class="d2-tile">
                <div class="d2-tile-t">
                    <h3>@(_ukeForskyvning == 0 ? "Denne uken · " : "")Uke @ISOWeek.GetWeekOfYear(UkeStart)</h3>
                    <div class="d2-segm">
                        <button type="button" @onclick="@(() => _ukeForskyvning--)">‹</button>
                        <button type="button" class="@(_ukeForskyvning == 0 ? "aktiv" : "")" @onclick="@(() => _ukeForskyvning = 0)">Denne uken</button>
                        <button type="button" @onclick="@(() => _ukeForskyvning++)">›</button>
                    </div>
                </div>
                <div class="d2-uke">
                    @for (var i = 0; i < 5; i++)
                    {
                        var dag = UkeStart.AddDays(i);
                        var jobber = _arbeidsordreAlle.Where(a => a.PlanlagtDato?.Date == dag).OrderBy(a => a.PlanlagtDato).ToList();
                        <div class="d2-dag @(dag == DateTime.Today ? "idag" : "")">
                            <h4>@dag.ToString("ddd", Kultur).TrimEnd('.') <span>@dag.ToString("dd.MM")</span></h4>
                            @if (jobber.Count == 0)
                            {
                                <small class="d2-dempet">Ingen planlagt</small>
                            }
                            @foreach (var a in jobber)
                            {
                                <a class="d2-jobb @JobbKlasse(a.Status)" href="@($"/arbeidsordre/{a.Id}")"><b>@a.Tittel</b>@(a.Prosjekt?.Navn ?? a.Kunde?.Navn)@(a.AnsvarligMontor is null ? "" : $" · {Fornavn(a.AnsvarligMontor.Navn)}")</a>
                            }
                        </div>
                    }
                </div>
            </section>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Klar til fakturering</h3></div>
                    @if (KlarTilFakturering.Count == 0)
                    {
                        <p class="d2-tom">Ingen ferdige arbeidsordre venter fakturering.</p>
                    }
                    @foreach (var a in KlarTilFakturering.Take(6))
                    {
                        <a class="d2-rad" href="@($"/arbeidsordre/{a.Id}")">
                            <span class="d2-ik"><Icon Name="check" /></span>
                            <span><b>@a.Tittel</b><small>@(a.Prosjekt?.Navn ?? a.Kunde?.Navn) · ferdig @((a.FullfortDato ?? a.OpprettetDato).ToString("dd.MM"))</small></span>
                            <span class="d2-rad-hoyre"><b>@KrKort(ArbeidsordreBeregningHelper.BeregnVareSum(a))</b><span class="d2-knapp">Fakturer</span></span>
                        </a>
                    }
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Per montør denne måneden</h3></div>
                    @if (PerMontor.Count == 0)
                    {
                        <p class="d2-tom">Ingen arbeidsordre planlagt denne måneden.</p>
                    }
                    @foreach (var (navn, antall) in PerMontor)
                    {
                        <div class="d2-hbar"><span>@navn</span><span class="d2-bar"><i style="width:@Prosent(antall, PerMontor[0].Antall)%"></i></span><span>@antall ordre</span></div>
                    }
                </section>
            </div>

            <section class="d2-tile">
                <div class="d2-tabhode">
                    <h3 class="d2-tab-tittel">Fakturerte arbeidsordre</h3>
                    <a class="d2-lenke" href="/arbeidsordre">Se alle →</a>
                </div>
                @if (ArbeidsordreFakturert.Count == 0)
                {
                    <p class="d2-tom">Ingen fakturerte arbeidsordre ennå.</p>
                }
                else
                {
                    <div class="d2-tabwrap">
                        <table class="d2-tabell">
                            <thead><tr><th>Arbeidsordre</th><th>Prosjekt</th><th>Ansvarlig</th><th class="n">Verdi</th><th>Opprettet</th></tr></thead>
                            <tbody>
                                @foreach (var x in ArbeidsordreFakturert.Take(8))
                                {
                                    <tr @key="x.Arbeidsordre.Id">
                                        <td><a href="@($"/arbeidsordre/{x.Arbeidsordre.Id}")">@x.Arbeidsordre.Tittel</a></td>
                                        <td>@(x.Arbeidsordre.Prosjekt?.Navn ?? "-")</td>
                                        <td>@(x.Arbeidsordre.AnsvarligMontor?.Navn ?? "Ikke tildelt")</td>
                                        <td class="n">@Kr(x.Verdi)</td>
                                        <td>@x.Arbeidsordre.OpprettetDato.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else if (_fane == "tickets")
        {
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Åpne tickets</small><b>@_ticketsApne</b><span>@_ticketsAlle.Count(t => t.Status != TicketStatus.Lukket && t.OpprettetDato >= DateTime.Today.AddDays(-7)) nye siste uke</span></div>
                <div class="d2-kpi"><small>SLA forfalt</small><b class="@(_ticketsSlaForfalt > 0 ? "d2-rodtekst" : "")">@_ticketsSlaForfalt</b><span>av @_ticketsApne åpne</span></div>
                <div class="d2-kpi"><small>Venter godkjenning</small><b>@_ticketsAlle.Count(t => t.Status == TicketStatus.VenterGodkjenning)</b><span>klare til å lukkes</span></div>
                <div class="d2-kpi"><small>Snitt løsetid</small><b>@SnittLosetidTekst</b><span>@_ticketsLukketIAr lukket i @_valgtAr</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>SLA – nærmest frist først</h3><small>åpne tickets</small></div>
                    @{ var slaListe = _ticketsApneListe.Where(t => t.SlaFrist.HasValue).Take(6).ToList(); }
                    @if (slaListe.Count == 0)
                    {
                        <p class="d2-tom">Ingen åpne tickets med SLA-frist.</p>
                    }
                    @foreach (var t in slaListe)
                    {
                        var forfalt = t.SlaFrist!.Value < DateTime.Now;
                        <a class="d2-rad d2-rad-sla" href="@($"/ticket/{t.Id}")">
                            <span><b>#@t.Id @t.Tittel</b><small>@(t.Kunde?.Navn ?? "Ingen kunde") · @t.Prioritet.Visningsnavn().ToLowerInvariant()</small></span>
                            <span class="d2-bar"><i class="@(forfalt ? "rod" : "")" style="width:@SlaBrukt(t)%"></i></span>
                            <span class="d2-sla-tid @(forfalt ? "d2-rodtekst" : "")">@(forfalt ? $"{Varighet(DateTime.Now - t.SlaFrist.Value)} over" : Varighet(t.SlaFrist.Value - DateTime.Now))</span>
                        </a>
                    }
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Åpne per type</h3></div>
                    @if (TicketsPerType.Count == 0)
                    {
                        <p class="d2-tom">Ingen åpne tickets.</p>
                    }
                    @foreach (var (navn, antall) in TicketsPerType)
                    {
                        <div class="d2-hbar"><span>@navn</span><span class="d2-bar"><i style="width:@Prosent(antall, TicketsPerType[0].Antall)%"></i></span><span>@antall</span></div>
                    }
                    <div class="d2-tile-t d2-mellom"><h3>Per ansvarlig</h3></div>
                    @foreach (var (navn, antall) in TicketsPerAnsvarlig)
                    {
                        <div class="d2-hbar"><span>@navn</span><span class="d2-bar"><i class="@(navn == "Ikke tildelt" ? "rod" : "")" style="width:@Prosent(antall, TicketsPerAnsvarlig[0].Antall)%"></i></span><span>@antall</span></div>
                    }
                </section>
            </div>

            <section class="d2-tile">
                <div class="d2-tabhode">
                    <div class="d2-segm">
                        <button type="button" class="@(_ticketFilter == "apne" ? "aktiv" : "")" @onclick="@(() => _ticketFilter = "apne")">Åpne<em>@_ticketsApne</em></button>
                        <button type="button" class="@(_ticketFilter == "godkjenning" ? "aktiv" : "")" @onclick="@(() => _ticketFilter = "godkjenning")">Venter godkjenning<em>@_ticketsAlle.Count(t => t.Status == TicketStatus.VenterGodkjenning)</em></button>
                        <button type="button" class="@(_ticketFilter == "lukket" ? "aktiv" : "")" @onclick="@(() => _ticketFilter = "lukket")">Lukket i @_valgtAr<em>@_ticketsLukketIAr</em></button>
                    </div>
                    <a class="d2-lenke" href="/tickets">Se alle →</a>
                </div>
                @if (TicketsVises.Count == 0)
                {
                    <p class="d2-tom">Ingen tickets å vise.</p>
                }
                else
                {
                    <div class="d2-tabwrap">
                        <table class="d2-tabell">
                            <thead><tr><th>Ticket</th><th>Kunde</th><th>Status</th><th>Prioritet</th><th>SLA-frist</th></tr></thead>
                            <tbody>
                                @foreach (var t in TicketsVises.Take(10))
                                {
                                    var forfalt = t.Status != TicketStatus.Lukket && t.SlaFrist < DateTime.Now;
                                    <tr @key="t.Id">
                                        <td><a href="@($"/ticket/{t.Id}")">#@t.Id - @t.Tittel</a></td>
                                        <td>@(t.Kunde?.Navn ?? "Ingen kunde")</td>
                                        <td><span class="d2-status @TicketStatusKlasse(t.Status)">@t.Status.Visningsnavn()</span></td>
                                        <td>@t.Prioritet.Visningsnavn()</td>
                                        <td class="@(forfalt ? "d2-rodtekst" : "")">@(t.SlaFrist?.ToString("dd.MM.yyyy HH:mm") ?? "-")@(forfalt ? " · forfalt" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else if (_fane == "driftsmeldinger")
        {
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Nye</small><b class="@(DmNye > 0 ? "d2-rodtekst" : "")">@DmNye</b><span>@_driftsmeldinger.Count(d => d.Status == DmStatus.Ubehandlet && d.Melding.Haster) haster</span></div>
                <div class="d2-kpi"><small>Under arbeid</small><b>@_driftsmeldinger.Count(d => d.Status == DmStatus.UnderBehandling)</b><span>har ticket</span></div>
                <div class="d2-kpi"><small>Løst denne måneden</small><b>@DmLostDenneManed</b><span>@_driftsmeldinger.Count totalt</span></div>
                <div class="d2-kpi"><small>Tid til ticket</small><b>@TidTilTicketTekst</b><span>snitt siste 30 dager</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Driftsmeldinger per måned</h3><div class="d2-forkl"><span><i class="f-rod"></i>Ny</span><span><i class="f-beige"></i>Under arbeid</span><span><i class="f-brun"></i>Løst</span><span><i class="f-lys"></i>Lukket</span></div></div>
                    @Soyler(DmManeder.Select(m => new decimal[] { m.Ubehandlet, m.UnderBehandling, m.Lost, m.Lukket }).ToList(), ["f-rod", "f-beige", "f-brun", "f-lys"])
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Per bygg</h3><small>åpne / fullført</small></div>
                    @if (DmPerBygg.Count == 0)
                    {
                        <p class="d2-tom">Ingen driftsmeldinger ennå.</p>
                    }
                    @foreach (var (navn, apne, ferdig) in DmPerBygg)
                    {
                        <div class="d2-hbar"><span>@navn</span><span class="d2-bar d2-bar-delt"><i class="rod" style="width:@Prosent(apne, apne + ferdig)%"></i><i style="width:@Prosent(ferdig, apne + ferdig)%"></i></span><span>@apne / @ferdig</span></div>
                    }
                </section>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Nyeste driftsmeldinger</h3><a class="d2-lenke" href="/foresporsler?mappe=drift">Alle →</a></div>
                    @if (_driftsmeldinger.Count == 0)
                    {
                        <p class="d2-tom">Ingen driftsmeldinger registrert ennå.</p>
                    }
                    @foreach (var d in _driftsmeldinger.Take(6))
                    {
                        <a class="d2-rad" href="@($"/driftsmelding/{d.Melding.Id}")">
                            <span class="d2-ik @(d.Melding.Haster && d.Status == DmStatus.Ubehandlet ? "rod" : "")"><Icon Name="mail" /></span>
                            <span><b>@d.DorNummer · @d.Tittel</b><small>@d.ProsjektNavn · @d.Melding.OpprettetDato.ToString("dd.MM HH:mm")</small></span>
                            <span class="d2-status @DmKlasse(d.Status)">@DmNavn(d.Status)</span>
                        </a>
                    }
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Dører med flest meldinger</h3><small>siste 12 mnd</small></div>
                    @if (DmPerDor.Count == 0)
                    {
                        <p class="d2-tom">Ingen driftsmeldinger siste 12 måneder.</p>
                    }
                    @foreach (var (navn, antall) in DmPerDor)
                    {
                        <div class="d2-hbar"><span>@navn</span><span class="d2-bar"><i class="@(antall >= 3 ? "rod" : "")" style="width:@Prosent(antall, DmPerDor[0].Antall)%"></i></span><span>@antall@(antall >= 3 ? " ⚠" : "")</span></div>
                    }
                    @if (DmPerDor.Any(d => d.Antall >= 3))
                    {
                        <small class="d2-dempet">⚠ Gjentatte feil – vurder utskifting og send tilbud.</small>
                    }
                </section>
            </div>
        }
        else if (_fane == "okonomi")
        {
            <div class="d2-kpis">
                <div class="d2-kpi"><small>Omsetning i @_valgtAr</small><b>@KrKort(_omsetningHittil)</b><span>@(_omsetningDeltaProsent >= 0 ? "↗ +" : "↘ ")@_omsetningDeltaProsent % mot i fjor</span></div>
                <div class="d2-kpi"><small>Tilbudsreserve</small><b>@KrKort(_tilbudsreserveTotalt)</b><span>alle tilbud som venter svar</span></div>
                <div class="d2-kpi"><small>Ordrereserve</small><b>@KrKort(Ordrereserve)</b><span>vunnet, ikke overlevert</span></div>
                <div class="d2-kpi"><small>Snitt vunnet tilbud</small><b>@KrKort(_snittTilbudsstorrelse)</b><span>alle år</span></div>
            </div>

            <div class="d2-g2">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Omsetning per måned</h3><div class="d2-forkl"><span><i class="f-brun"></i>@_valgtAr</span><span><i class="f-lys"></i>@(_valgtAr - 1)</span></div></div>
                    @Parsoyler()
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Største kunder i @_valgtAr</h3></div>
                    @if (StorsteKunder.Count == 0)
                    {
                        <p class="d2-tom">Ingen vunnede tilbud i @_valgtAr.</p>
                    }
                    @foreach (var (navn, sum) in StorsteKunder)
                    {
                        <div class="d2-hbar d2-hbar-kr"><span>@navn</span><span class="d2-bar"><i style="width:@Prosent(sum, StorsteKunder[0].Sum)%"></i></span><span>@KrKort(sum)</span></div>
                    }
                </section>
            </div>

            <div class="d2-g3">
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Prosjekt og serviceavtale</h3><small>vunnet i @_valgtAr</small></div>
                    @{ var (prosjektSum, serviceSum) = VunnetPerType; var totalt = prosjektSum + serviceSum; }
                    <div class="d2-delt"><span class="f-brun" style="width:@Prosent(prosjektSum, Math.Max(1, totalt))%"></span><span class="f-beige" style="width:@Prosent(serviceSum, Math.Max(1, totalt))%"></span></div>
                    <div class="d2-forkl d2-forkl-kolonne"><span><i class="f-brun"></i>Prosjekt <b>@KrKort(prosjektSum)</b></span><span><i class="f-beige"></i>Serviceavtale <b>@KrKort(serviceSum)</b></span></div>
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Ordrereserve</h3><small>vunnet, ikke overlevert</small></div>
                    <div class="d2-stortall">@Kr(Ordrereserve)</div>
                    <small class="d2-dempet">Godkjente tilbud på prosjekter som ikke er overlevert eller avsluttet.</small>
                </section>
                <section class="d2-tile">
                    <div class="d2-tile-t"><h3>Mot hele fjoråret</h3></div>
                    <div class="d2-stortall">@(FjoraretTotalt == 0 ? "–" : $"{Prosent(_omsetningHittil, FjoraretTotalt)} %")</div>
                    <span class="d2-bar d2-bar-stor"><i style="width:@(FjoraretTotalt == 0 ? 0 : Math.Min(100, Prosent(_omsetningHittil, FjoraretTotalt)))%"></i></span>
                    <small class="d2-dempet">@KrKort(_omsetningHittil) av @KrKort(FjoraretTotalt) i hele @(_valgtAr - 1)</small>
                </section>
            </div>
        }

        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _fane = "oversikt";
    private DateTime _lastet = DateTime.Now;

    private List<Tilbud> _alle = [];
    private List<Tilbud> _venter = [];
    private List<Tilbud> _vunnet = [];
    private List<Tilbud> _avslatt = [];
    private List<Tilbud> _arTilbud = [];
    private int _avgjorte;
    private double _vinnprosent;
    private string _filter = "alle";
    private string _sok = "";
    private int _valgtAr = DateTime.Today.Year;
    private bool _visArValg;

    private string _prosjektFilter = "alle";
    private string _ticketFilter = "apne";
    private int _ukeForskyvning;

    private List<Prosjekt> _prosjekterAlle = [];
    private List<Arbeidsordre> _arbeidsordreAlle = [];
    private List<Ticket> _ticketsAlle = [];

    // ---------- driftsmeldinger ----------
    private enum DmStatus { Ubehandlet, UnderBehandling, Lost, Lukket }

    private static DmStatus DmStatusForTicket(Ticket? t) => t?.Status switch
    {
        TicketStatus.UnderBehandling => DmStatus.UnderBehandling,
        TicketStatus.VenterGodkjenning => DmStatus.Lost,
        TicketStatus.Lukket => DmStatus.Lukket,
        _ => DmStatus.Ubehandlet
    };

    private static string DmNavn(DmStatus s) => s switch
    {
        DmStatus.Ubehandlet => "Ubehandlet",
        DmStatus.UnderBehandling => "Under behandling",
        DmStatus.Lost => "Løst",
        DmStatus.Lukket => "Lukket",
        _ => s.ToString()
    };

    private static string DmKlasse(DmStatus s) => s switch
    {
        DmStatus.Ubehandlet => "rod",
        DmStatus.UnderBehandling => "gul",
        DmStatus.Lost => "gronn",
        _ => ""
    };

    private sealed class DmRad
    {
        public Driftsmelding Melding { get; set; } = null!;
        public Ticket? Ticket { get; set; }
        public string Tittel => string.IsNullOrWhiteSpace(Melding.Tittel) ? $"Dør {Melding.Dor?.Dornummer}" : Melding.Tittel!;
        public string ProsjektNavn => Melding.Dor?.Prosjekt?.Navn ?? "-";
        public string DorNummer => Melding.Dor?.Dornummer ?? "-";
        public DmStatus Status => DmStatusForTicket(Ticket);
    }

    private List<DmRad> _driftsmeldinger = [];

    private sealed record DmManedData(int Ubehandlet, int UnderBehandling, int Lost, int Lukket);

    private List<DmManedData> DmManeder => Enumerable.Range(1, 12).Select(m =>
    {
        var start = new DateTime(_valgtAr, m, 1);
        var iManed = _driftsmeldinger.Where(d => d.Melding.OpprettetDato >= start && d.Melding.OpprettetDato < start.AddMonths(1)).ToList();
        return new DmManedData(
            iManed.Count(d => d.Status == DmStatus.Ubehandlet),
            iManed.Count(d => d.Status == DmStatus.UnderBehandling),
            iManed.Count(d => d.Status == DmStatus.Lost),
            iManed.Count(d => d.Status == DmStatus.Lukket));
    }).ToList();

    private int DmNye => _driftsmeldinger.Count(d => d.Status == DmStatus.Ubehandlet);

    private int DmLostDenneManed
    {
        get
        {
            var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            return _driftsmeldinger.Count(d => d.Status is DmStatus.Lost or DmStatus.Lukket
                && (d.Ticket?.LukketDato ?? d.Ticket?.OpprettetDato) >= start);
        }
    }

    // Snitt tid fra driftsmelding kom inn til ticket ble opprettet, siste 30 dager.
    private string TidTilTicketTekst
    {
        get
        {
            var tider = _driftsmeldinger
                .Where(d => d.Ticket is not null && d.Melding.OpprettetDato >= DateTime.Today.AddDays(-30))
                .Select(d => d.Ticket!.OpprettetDato - d.Melding.OpprettetDato)
                .Where(t => t >= TimeSpan.Zero)
                .ToList();
            return tider.Count == 0 ? "–" : Varighet(TimeSpan.FromTicks((long)tider.Average(t => t.Ticks)));
        }
    }

    private List<(string Navn, int Apne, int Ferdig)> DmPerBygg => _driftsmeldinger
        .GroupBy(d => d.ProsjektNavn)
        .Select(g => (Navn: g.Key,
            Apne: g.Count(d => d.Status is DmStatus.Ubehandlet or DmStatus.UnderBehandling),
            Ferdig: g.Count(d => d.Status is DmStatus.Lost or DmStatus.Lukket)))
        .OrderByDescending(g => g.Apne).ThenByDescending(g => g.Ferdig)
        .Take(6)
        .ToList();

    private List<(string Navn, int Antall)> DmPerDor => _driftsmeldinger
        .Where(d => d.Melding.OpprettetDato >= DateTime.Today.AddYears(-1))
        .GroupBy(d => $"{d.DorNummer} · {d.ProsjektNavn}")
        .Select(g => (Navn: g.Key, Antall: g.Count()))
        .OrderByDescending(g => g.Antall)
        .Take(5)
        .ToList();

    // ---------- tilbud ----------
    private sealed record ManedData(decimal VunnetSum, decimal AvslattSum, decimal VenterSum);
    private List<ManedData> _maneder = [];

    private decimal _omsetningHittil;
    private decimal _omsetningDeltaProsent;
    private List<decimal> _omsetningKurve = [];
    private List<decimal> _omsetningKurveFjor = [];
    private decimal _tilbudsreserveTotalt;
    private decimal _snittTilbudsstorrelse;

    private List<Tilbud> VenterLenge => _venter.Where(t => DagerSiden(t.SendtDato) > 14).ToList();

    private List<(string Navn, int Antall, decimal Sum, string Klasse)> Trakt =>
    [
        ("Sendt", _arTilbud.Count, _arTilbud.Sum(t => t.SendtSum ?? 0), "f-brun"),
        ("Venter svar", _venter.Count, _venter.Sum(t => t.SendtSum ?? 0), "f-beige"),
        ("Vunnet", _vunnet.Count, _vunnet.Sum(t => t.SendtSum ?? 0), "f-brun"),
        ("Avslått", _avslatt.Count, _avslatt.Sum(t => t.SendtSum ?? 0), "f-lys")
    ];

    private List<Tilbud> TilbudVises
    {
        get
        {
            IEnumerable<Tilbud> q = _filter switch
            {
                "venter" => _venter,
                "vunnet" => _vunnet,
                "avslatt" => _avslatt,
                _ => _arTilbud
            };
            if (!string.IsNullOrWhiteSpace(_sok))
            {
                var s = _sok.Trim();
                q = q.Where(t => t.Tittel.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (t.Prosjekt?.Kunde?.Navn ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.ToList();
        }
    }

    private static string TilbudStatusKlasse(EndringsmeldingStatus status) => status switch
    {
        EndringsmeldingStatus.Godkjent => "gronn",
        EndringsmeldingStatus.Avslatt => "rod",
        EndringsmeldingStatus.SendtTilKunde => "gul",
        _ => ""
    };

    // ---------- prosjekter ----------
    private List<(Prosjekt Prosjekt, decimal Verdi)> ProsjekterVunnet => _prosjekterAlle
        .Where(p => p.Status == ProsjektStatus.Overlevert)
        .Select(p => (p, p.Arbeidsordre.Sum(ArbeidsordreBeregningHelper.BeregnVareSum)))
        .ToList();

    private List<(Prosjekt Prosjekt, decimal Verdi)> ProsjekterTapt => _prosjekterAlle
        .Where(p => p.Status == ProsjektStatus.TilbudAvslatt)
        .Select(p => (p, p.Tilbud.Where(t => t.Status == EndringsmeldingStatus.Avslatt).Sum(t => t.SendtSum ?? TilbudBeregningHelper.BeregnTotaltUtenMva(t))))
        .ToList();

    private sealed record VunnetTaptRad(Prosjekt Prosjekt, decimal Verdi, bool ErVunnet, DateTime Dato);

    private List<VunnetTaptRad> VunnetOgTapt => ProsjekterVunnet
        .Select(x => new VunnetTaptRad(x.Prosjekt, x.Verdi, true, x.Prosjekt.OverlevertDato ?? x.Prosjekt.OpprettetDato))
        .Concat(ProsjekterTapt.Select(x => new VunnetTaptRad(x.Prosjekt, x.Verdi, false, x.Prosjekt.OpprettetDato)))
        .OrderByDescending(x => x.Dato)
        .ToList();

    private List<Prosjekt> AktiveProsjekter => _prosjekterAlle
        .Where(p => p.Status is ProsjektStatus.Aktiv or ProsjektStatus.Registrert or ProsjektStatus.UnderArbeid)
        .OrderByDescending(p => p.Arbeidsordre.Count)
        .ToList();

    private List<(string Navn, int Antall)> Faser =>
    [
        ("Tilbud", _prosjekterAlle.Count(p => p.Status == ProsjektStatus.Tilbud)),
        ("Registrert", _prosjekterAlle.Count(p => p.Status == ProsjektStatus.Registrert)),
        ("Aktiv", _prosjekterAlle.Count(p => p.Status == ProsjektStatus.Aktiv)),
        ("Under arbeid", _prosjekterAlle.Count(p => p.Status == ProsjektStatus.UnderArbeid)),
