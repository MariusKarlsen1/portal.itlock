    private sealed class FristRad
    {
        public string Tittel { get; set; } = "";
        public string Undertekst { get; set; } = "";
        public DateTime Dato { get; set; }
        public string Ikon { get; set; } = "calendar";

        public string RelativTekst
        {
            get
            {
                var d = (Dato.Date - DateTime.Today).Days;
                if (d < 0) return "Forfalt";
                if (d == 0) return "I dag";
                if (d == 1) return "1 dag";
                return $"{d} dager";
            }
        }

        public string Farge => (Dato.Date - DateTime.Today).Days <= 0 ? "rod" : "";
    }

    private List<FristRad> _kommendeFrister = [];

    private bool _full;

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dashbord-bredde", _full ? "full" : "normal");
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("dashbord-bredde", "normal") == "full";
        _alle = await Db.Tilbud
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .Where(t => t.SendtDato != null)
            .OrderByDescending(t => t.SendtDato)
            .ToListAsync();

        _valgtAr = _alle.Count > 0 ? _alle.Max(t => t.SendtDato!.Value.Year) : DateTime.Today.Year;

        _prosjekterAlle = await Db.Prosjekter
            .Include(p => p.Kunde)
            .Include(p => p.Arbeidsordre).ThenInclude(a => a.Tilbud).ThenInclude(t => t!.Linjer)
            .Include(p => p.Arbeidsordre).ThenInclude(a => a.Varer)
            .Include(p => p.Arbeidsordre).ThenInclude(a => a.Timeregistreringer)
            .Include(p => p.Arbeidsordre).ThenInclude(a => a.KodeLinjer)
            .Include(p => p.Tilbud).ThenInclude(t => t.Linjer)
            .AsSplitQuery()
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _arbeidsordreAlle = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.Kunde)
            .Include(a => a.AnsvarligMontor)
            .Include(a => a.Tilbud).ThenInclude(t => t!.Linjer)
            .Include(a => a.Varer)
            .Include(a => a.Timeregistreringer)
            .Include(a => a.KodeLinjer)
            .AsSplitQuery()
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _ticketsAlle = await Db.Tickets
            .Include(t => t.Kunde)
            .Include(t => t.AnsvarligBruker)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();

        var dmListe = await Db.Driftsmeldinger
            .Include(m => m.Dor).ThenInclude(d => d!.Prosjekt)
            .OrderByDescending(m => m.OpprettetDato)
            .ToListAsync();

        var dmTicketPerMelding = _ticketsAlle
            .Where(t => t.DriftsmeldingId != null)
            .GroupBy(t => t.DriftsmeldingId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(t => t.OpprettetDato).First());

        _driftsmeldinger = dmListe.Select(m => new DmRad { Melding = m, Ticket = dmTicketPerMelding.GetValueOrDefault(m.Id) }).ToList();

        await LastKommendeFristerAsync();

        OppdaterFiltrering();
        OppdaterTickets();
        _lastet = DateTime.Now;
    }

    private static DateTime FinnMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek + 6) % 7;
        return dato.Date.AddDays(-diff);
    }

    private async Task LastKommendeFristerAsync()
    {
        var frister = new List<FristRad>();

        var serviceProsjekter = await Db.Prosjekter.Where(p => p.Status == ProsjektStatus.Serviceavtale).ToListAsync();
        if (serviceProsjekter.Count > 0)
        {
            var ider = serviceProsjekter.Select(p => p.Id).ToList();
            var runder = await Db.Servicerunder.Where(r => ider.Contains(r.ProsjektId)).ToListAsync();
            foreach (var p in serviceProsjekter)
            {
                var neste = runder.Where(r => r.ProsjektId == p.Id)
                    .OrderByDescending(r => r.Dato)
                    .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

                if (neste.HasValue)
                {
                    frister.Add(new FristRad { Tittel = $"Serviceavtale - {p.Navn}", Undertekst = "Årlig service", Dato = neste.Value, Ikon = "shield" });
                }
            }
        }

        var ceListe = await Db.CeGodkjenninger.Where(c => c.Status == CeGodkjenningStatus.Godkjent).ToListAsync();
        foreach (var c in ceListe)
        {
            frister.Add(new FristRad { Tittel = $"CE-sertifisering - {(c.ProsjektNavn ?? c.KundeNavn ?? "Ukjent")}", Undertekst = "Dokumentasjon fornyes", Dato = c.GyldigTil, Ikon = "shield" });
        }

        var ferdigOrdre = await Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig).ToListAsync();
        foreach (var a in ferdigOrdre)
        {
            var frist = (a.FullfortDato ?? a.OpprettetDato).AddDays(14);
            frister.Add(new FristRad { Tittel = $"Fakturafrist - {a.Tittel}", Undertekst = "Send faktura", Dato = frist, Ikon = "receipt" });
        }

        _kommendeFrister = frister.OrderBy(f => f.Dato).Take(5).ToList();
    }

    private void ToggleArValg() => _visArValg = !_visArValg;

    private void VelgAr(int ar)
    {
        _valgtAr = ar;
        _visArValg = false;
        OppdaterFiltrering();
        OppdaterTickets();
    }

    private void OppdaterFiltrering()
    {
        _arTilbud = _alle.Where(t => t.SendtDato!.Value.Year == _valgtAr).ToList();
        _venter = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).ToList();
        _vunnet = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Godkjent).ToList();
        _avslatt = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Avslatt).ToList();
        _avgjorte = _vunnet.Count + _avslatt.Count;
        _vinnprosent = _avgjorte == 0 ? 0 : (double)_vunnet.Count / _avgjorte * 100;

        _maneder = Enumerable.Range(1, 12).Select(m =>
        {
            var start = new DateTime(_valgtAr, m, 1);
            var iManed = _arTilbud.Where(t => t.SendtDato >= start && t.SendtDato < start.AddMonths(1)).ToList();
            return new ManedData(
                iManed.Where(t => t.Status == EndringsmeldingStatus.Godkjent).Sum(t => t.SendtSum ?? 0),
                iManed.Where(t => t.Status == EndringsmeldingStatus.Avslatt).Sum(t => t.SendtSum ?? 0),
                iManed.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).Sum(t => t.SendtSum ?? 0));
        }).ToList();

        // Omsetning - løpende sum av vunnede tilbud gjennom året (i år og i fjor), pluss endring mot samme periode i fjor.
        _omsetningKurve = Lopende(_valgtAr);
        _omsetningKurveFjor = Lopende(_valgtAr - 1);

        var cutoffManed = _valgtAr == DateTime.Today.Year ? DateTime.Today.Month : 12;
        var sumIAr = VunnetIManeder(_valgtAr, cutoffManed);
        var sumIFjor = VunnetIManeder(_valgtAr - 1, cutoffManed);
        _omsetningHittil = sumIAr;
        _omsetningDeltaProsent = sumIFjor == 0 ? (sumIAr > 0 ? 100 : 0) : Math.Round((sumIAr - sumIFjor) / sumIFjor * 100, 0);

        _tilbudsreserveTotalt = _alle.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).Sum(t => t.SendtSum ?? 0);
        var vunnetAlleTider = _alle.Where(t => t.Status == EndringsmeldingStatus.Godkjent).ToList();
        _snittTilbudsstorrelse = vunnetAlleTider.Count == 0 ? 0 : vunnetAlleTider.Average(t => t.SendtSum ?? 0);
    }

    private decimal VunnetIManeder(int ar, int tilOgMedManed) => _alle
        .Where(t => t.Status == EndringsmeldingStatus.Godkjent && t.SendtDato!.Value.Year == ar && t.SendtDato.Value.Month <= tilOgMedManed)
        .Sum(t => t.SendtSum ?? 0);

    private decimal VunnetIManed(int ar, int maned) => _alle
        .Where(t => t.Status == EndringsmeldingStatus.Godkjent && t.SendtDato!.Value.Year == ar && t.SendtDato.Value.Month == maned)
        .Sum(t => t.SendtSum ?? 0);

    private List<decimal> Lopende(int ar)
    {
        decimal sum = 0;
        return Enumerable.Range(1, 12).Select(m => sum += VunnetIManed(ar, m)).ToList();
    }

    private void OppdaterTickets()
    {
        _ticketsApneListe = _ticketsAlle
            .Where(t => t.Status != TicketStatus.Lukket)
            .OrderBy(t => t.SlaFrist ?? DateTime.MaxValue)
            .ToList();
        _ticketsApne = _ticketsApneListe.Count;
        _ticketsSlaForfalt = _ticketsApneListe.Count(t => t.SlaFrist.HasValue && t.SlaFrist.Value < DateTime.Now);
        _ticketsLukketIAr = _ticketsAlle.Count(t => t.Status == TicketStatus.Lukket && t.LukketDato?.Year == _valgtAr);
    }

    // ---------- grafer ----------
    // Stablet søylediagram for årets 12 måneder. Inneværende måned er uthevet,
    // kommende måneder i år er dempet.
    private RenderFragment Soyler(List<decimal[]> data, string[] klasser) => __builder =>
    {
        var maks = Math.Max(1, data.Max(d => d.Sum()));
        var naIndeks = _valgtAr == DateTime.Today.Year ? DateTime.Today.Month - 1 : 99;
        <div class="d2-soyler">
            @for (var i = 0; i < data.Count; i++)
            {
                var sum = data[i].Sum();
                var hoyde = sum <= 0 ? 2 : Math.Max(4, (double)(sum / maks) * 150);
                <div class="d2-soyle @(i == naIndeks ? "na" : "") @(i > naIndeks ? "fremtid" : "")">
                    <div class="d2-stabel" style="height:@(hoyde.ToString("0", CultureInfo.InvariantCulture))px">
                        @for (var j = 0; j < data[i].Length; j++)
                        {
                            if (data[i][j] > 0)
                            {
                                <i class="@klasser[j]" style="height:@((data[i][j] / sum * 100).ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                            }
                        }
                    </div>
                    <span>@(new DateTime(2000, i + 1, 1).ToString("MMM", Kultur).TrimEnd('.'))</span>
                </div>
            }
        </div>
    };

    // Løpende omsetning i år (heltrukket) mot i fjor (stiplet).
    private RenderFragment Linje() => __builder =>
    {
        var naManed = _valgtAr == DateTime.Today.Year ? DateTime.Today.Month : 12;
        var iAr = _omsetningKurve.Take(naManed).ToList();
        var maks = Math.Max(1, Math.Max(_omsetningKurve.DefaultIfEmpty(0).Max(), _omsetningKurveFjor.DefaultIfEmpty(0).Max()));
        string Punkt(int i, decimal v) => $"{(i * 300.0 / 11).ToString("0.#", CultureInfo.InvariantCulture)},{(160 - (double)(v / maks) * 150).ToString("0.#", CultureInfo.InvariantCulture)}";
        var linjeIAr = string.Join(" ", iAr.Select((v, i) => Punkt(i, v)));
        var linjeFjor = string.Join(" ", _omsetningKurveFjor.Select((v, i) => Punkt(i, v)));
        var sisteX = ((iAr.Count - 1) * 300.0 / 11).ToString("0.#", CultureInfo.InvariantCulture);
        <svg class="d2-linje" viewBox="0 0 300 170" preserveAspectRatio="none">
            <line x1="0" x2="300" y1="40" y2="40" /><line x1="0" x2="300" y1="80" y2="80" /><line x1="0" x2="300" y1="120" y2="120" />
            <polyline class="fjor" points="@linjeFjor" />
            @if (iAr.Count > 0)
            {
                <polygon class="omrade" points="0,170 @linjeIAr @sisteX,170" />
                <polyline class="iar" points="@linjeIAr" />
            }
        </svg>
    };

    // To søyler per måned: i år og i fjor.
    private RenderFragment Parsoyler() => __builder =>
    {
        var iAr = Enumerable.Range(1, 12).Select(m => VunnetIManed(_valgtAr, m)).ToList();
        var iFjor = Enumerable.Range(1, 12).Select(m => VunnetIManed(_valgtAr - 1, m)).ToList();
        var maks = Math.Max(1, Math.Max(iAr.Max(), iFjor.Max()));
        var naIndeks = _valgtAr == DateTime.Today.Year ? DateTime.Today.Month - 1 : 99;
        <div class="d2-soyler">
            @for (var i = 0; i < 12; i++)
            {
                <div class="d2-soyle @(i == naIndeks ? "na" : "")">
                    <div class="d2-par">
                        <i class="f-brun" style="height:@(Math.Max(iAr[i] > 0 ? 3 : 0, (double)(iAr[i] / maks) * 150).ToString("0", CultureInfo.InvariantCulture))px"></i>
                        <i class="f-lys" style="height:@(Math.Max(iFjor[i] > 0 ? 3 : 0, (double)(iFjor[i] / maks) * 150).ToString("0", CultureInfo.InvariantCulture))px"></i>
                    </div>
                    <span>@(new DateTime(2000, i + 1, 1).ToString("MMM", Kultur).TrimEnd('.'))</span>
                </div>
            }
        </div>
    };

    // ---------- små hjelpere ----------
    private static string Kr(decimal sum) => $"{sum.ToString("N0", Kultur)} kr";

    // Kort beløp til nøkkeltall: "1,24 mill. kr" / "241 000 kr".
    private static string KrKort(decimal sum) => Math.Abs(sum) >= 1_000_000
        ? $"{(sum / 1_000_000).ToString("0.##", Kultur)} mill. kr"
        : Kr(sum);

    private static int Prosent(decimal del, decimal hel) => hel <= 0 ? 0 : (int)Math.Round(del / hel * 100);
    private static int Prosent(int del, int hel) => hel <= 0 ? 0 : (int)Math.Round(del * 100.0 / hel);

    private static int DagerSiden(DateTime? dato) => dato is null ? 0 : Math.Max(0, (DateTime.Today - dato.Value.Date).Days);

    private static string Varighet(TimeSpan t)
    {
        if (t.TotalHours >= 24) { return $"{(int)t.TotalDays} d {t.Hours} t"; }
        if (t.TotalMinutes >= 60) { return $"{(int)t.TotalHours} t {t.Minutes} min"; }
        return $"{Math.Max(1, (int)t.TotalMinutes)} min";
    }

    private static string Fornavn(string navn) => navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;

    private static string Initialer(string? navn) =>
        string.IsNullOrWhiteSpace(navn)
            ? "?"
            : string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));
}
