@page "/dashbord"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref
@inject TripletexService Tripletex
@inject NavigationManager Nav

<PageTitle>Dashbord - Full Kontroll</PageTitle>

@* B1 + S3 (Prototype dashbord anbefalt.html / salg og okonomi alle.html):
   ett kort som kundekortet med to faner. Oversikt viser det som må gjøres,
   Salg og økonomi viser hvem pengene kommer fra og hvorfor tilbud vinnes
   eller tapes. Arbeidsordre, tickets, driftsmeldinger og lager har egne sider. *@
<div class="db-side @(_full ? "db-full" : "")">
    <div class="db-kk">
        <div class="db-kk-topp">
            <span class="db-kk-ikon"><Icon Name="trend-up" /></span>
            <div class="db-kk-tittel">
                <div class="db-kk-sti"><a href="/">Hjem</a> / Dashbord</div>
                <h1>Dashbord</h1>
            </div>
            <div class="db-kk-handl">
                <select class="db-ar" value="@_valgtAr" @onchange="VelgAr" aria-label="Velg år">
                    @foreach (var ar in TilgjengeligeAr)
                    {
                        <option value="@ar">@ar</option>
                    }
                </select>
                <button type="button" class="db-knapp" @onclick="LastAsync" disabled="@_laster"><Icon Name="refresh" />Oppdater</button>
                <button type="button" class="db-kk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>
        </div>
        <div class="db-kk-info">
            <span>Oppdatert <b>@_lastet.ToString("dd.MM 'kl.' HH:mm")</b></span>
            <span>År <b>@_valgtAr</b></span>
            <span>Fakturert hittil i år <b>@(_tripletexFeil is null ? KrKort(_fakturert) : "–")</b></span>
            <span>Trenger handling <b class="@(AntallOppgaver > 0 ? "db-rod" : "")">@AntallOppgaver</b></span>
        </div>
        <nav class="db-faner">
            <button type="button" class="@(_fane == "oversikt" ? "pa" : "")" @onclick="@(() => _fane = "oversikt")"><Icon Name="grid" />Oversikt @if (AntallOppgaver > 0) { <em class="r">@AntallOppgaver</em> }</button>
            <button type="button" class="@(_fane == "salg" ? "pa" : "")" @onclick="@(() => _fane = "salg")"><Icon Name="receipt" />Salg og økonomi</button>
        </nav>

        <div class="db-innhold">
            @if (!_klar)
            {
                <p class="db-tom">Laster …</p>
            }
            else if (_fane == "oversikt")
            {
                @Oversikt()
            }
            else
            {
                @SalgOgOkonomi()
            }
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _fane = "oversikt";
    private bool _klar;
    private bool _laster;
    private bool _full;
    private DateTime _lastet = DateTime.Now;
    private int _valgtAr = DateTime.Today.Year;

    private List<Tilbud> _alle = [];
    private List<Tilbud> _arTilbud = [];
    private List<Tilbud> _vunnet = [];
    private List<Tilbud> _avslatt = [];
    private List<Tilbud> _venterAlle = [];
    private List<Prosjekt> _aktiveProsjekter = [];
    private List<Arbeidsordre> _klarTilFakturering = [];
    private List<Arbeidsordre> _iDag = [];
    private List<Ticket> _slaForfalt = [];
    private List<FristRad> _frister = [];

    // Fakturert hentes fra Tripletex (der faktureringen skjer).
    private List<TripletexService.TripletexFaktura> _fakturaer = [];
    private decimal _fakturert;
    private decimal _fakturertIFjor;
    private string? _tripletexFeil;
    private Dictionary<string, KundeType?> _kundetyper = [];

    // ======================================================================
    // Oversikt
    // ======================================================================
    private RenderFragment Oversikt() => @<div class="db-fane">
        <section class="db-bx">
            <div class="db-bx-hd">Trenger handling @if (AntallOppgaver > 0) { <em class="db-ant r">@AntallOppgaver</em> }</div>
            @if (AntallOppgaver == 0)
            {
                <p class="db-ok"><b>✓ Alt er i rute</b>Ingen forfalte tickets, gamle tilbud, ordre som venter fakturering eller passerte frister.</p>
            }
            else
            {
                <table class="db-tab">
                    <thead><tr><th>Type</th><th>Hva</th><th class="n">Antall</th><th></th></tr></thead>
                    <tbody>
                        @if (_slaForfalt.Count > 0)
                        {
                            var eldste = _slaForfalt[0];
                            @Oppgave("Tickets", "rod", _slaForfalt.Count, $"{_slaForfalt.Count} {(_slaForfalt.Count == 1 ? "ticket har" : "tickets har")} passert SLA-fristen",
                                $"Eldste: #{eldste.Id} {eldste.Tittel} – {Varighet(DateTime.Now - eldste.SlaFrist!.Value)} over", "/tickets", "Se tickets")
                        }
                        @if (VenterLenge.Count > 0)
                        {
                            @Oppgave("Tilbud", "gul", VenterLenge.Count, $"{VenterLenge.Count} tilbud har ventet svar i over 14 dager",
                                $"Til sammen {Kr(VenterLenge.Sum(t => t.SendtSum ?? 0))}", "/rapporter/tilbudsreserve", "Følg opp")
                        }
                        @if (_klarTilFakturering.Count > 0)
                        {
                            @Oppgave("Fakturering", "bla", _klarTilFakturering.Count, $"{_klarTilFakturering.Count} {(_klarTilFakturering.Count == 1 ? "arbeidsordre er klar" : "arbeidsordre er klare")} til fakturering",
                                "Ferdig, ikke fakturert", "/arbeidsordre", "Fakturer")
                        }
                        @if (PasserteFrister.Count > 0)
                        {
                            @Oppgave("Frister", "rod", PasserteFrister.Count, $"{PasserteFrister.Count} {(PasserteFrister.Count == 1 ? "frist har" : "frister har")} passert",
                                string.Join(" · ", PasserteFrister.Take(2).Select(f => f.Tittel)), "", "")
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="db-bx">
            <div class="db-bx-hd">Aktive prosjekter<a class="db-hoyre" href="/prosjekter">Alle prosjekter ›</a></div>
            @if (_aktiveProsjekter.Count == 0)
            {
                <p class="db-tom">Ingen aktive prosjekter.</p>
            }
            else
            {
                <table class="db-tab">
                    <thead><tr><th>Prosjekt</th><th>Status</th><th>Fremdrift</th></tr></thead>
                    <tbody>
                        @foreach (var p in _aktiveProsjekter.Take(6))
                        {
                            var ferdig = p.Arbeidsordre.Count(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert);
                            var pst = Prosent(ferdig, Math.Max(1, p.Arbeidsordre.Count));
                            var id = p.Id;
                            <tr class="db-klikk" @onclick="@(() => Nav.NavigateTo($"/prosjekter/{id}"))">
                                <td><b>@p.Navn</b><small>@(p.Kunde?.Navn ?? "")</small></td>
                                <td><span class="db-chip">@ProsjektStatusNavn(p.Status)</span></td>
                                <td><span class="db-strek"><span><i style="width:@pst%"></i></span><small>@(p.Arbeidsordre.Count == 0 ? "Ingen arbeidsordre" : $"{ferdig} av {p.Arbeidsordre.Count} ferdig")</small></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <div class="db-to">
            <section class="db-bx">
                <div class="db-bx-hd">I dag<a class="db-hoyre" href="/arbeidsordre">Arbeidsordre ›</a></div>
                @if (_iDag.Count == 0)
                {
                    <p class="db-tom">Ingen arbeidsordre planlagt i dag.</p>
                }
                @foreach (var a in _iDag)
                {
                    <a class="db-rad" href="@($"/arbeidsordre/{a.Id}")">
                        <span class="db-av">@Initialer(a.AnsvarligMontor?.Navn)</span>
                        <span><b>@a.Tittel</b><small>@(a.Prosjekt?.Navn ?? a.Kunde?.Navn ?? "")@(a.PlanlagtDato?.TimeOfDay > TimeSpan.Zero ? $" · {a.PlanlagtDato:HH:mm}" : "")</small></span>
                        <span class="db-chip">@a.Status.Visningsnavn()</span>
                    </a>
                }
            </section>
            <section class="db-bx">
                <div class="db-bx-hd">Kommende frister</div>
                @if (_frister.Count == 0)
                {
                    <p class="db-tom">Ingen kommende frister.</p>
                }
                @foreach (var f in _frister)
                {
                    <div class="db-rad">
                        <span class="db-ik"><Icon Name="@f.Ikon" /></span>
                        <span><b>@f.Tittel</b><small>@f.Undertekst · @f.Dato.ToString("dd.MM.yyyy")</small></span>
                        <span class="db-chip @(f.Passert ? "rod" : "")">@f.RelativTekst</span>
                    </div>
                }
            </section>
        </div>
    </div>;

    private RenderFragment Oppgave(string type, string farge, int antall, string tittel, string tekst, string href, string knapp) => @<tr class="@(href == "" ? "" : "db-klikk")" @onclick="@(() => { if (href != "") Nav.NavigateTo(href); })">
        <td><span class="db-chip @farge">@type</span></td>
        <td><b>@tittel</b><small>@tekst</small></td>
        <td class="n"><b>@antall</b></td>
        <td class="n">@if (href != "") { <a class="db-knapp liten" href="@href" @onclick:stopPropagation="true">@knapp ›</a> }</td>
    </tr>;

    // ======================================================================
    // Salg og økonomi (S3 - hvem og hvorfor)
    // ======================================================================
    private RenderFragment SalgOgOkonomi() => @<div class="db-fane">
        @{
            var tilbudSendt = _arTilbud.Sum(t => t.SendtSum ?? 0);
            var reserve = _venterAlle.Sum(t => t.SendtSum ?? 0);
            var avgjorte = _vunnet.Count + _avslatt.Count;
            var vunnetSum = _vunnet.Sum(t => t.SendtSum ?? 0);
            var taptSum = _avslatt.Sum(t => t.SendtSum ?? 0);
            var gamle = _venterAlle.Where(t => DagerSiden(t.SendtDato) > 60).OrderByDescending(t => t.SendtSum ?? 0).ToList();
            var maksType = FakturertPerType.Count == 0 ? 1 : Math.Max(1, FakturertPerType.Max(x => x.Sum));
            var maned = Enumerable.Range(1, 12).Select(m => (
                V: _vunnet.Where(t => (t.GodkjentDato ?? t.SendtDato)!.Value.Month == m).Sum(t => t.SendtSum ?? 0),
                T: _avslatt.Where(t => (t.AvslattDato ?? t.SendtDato)!.Value.Month == m).Sum(t => t.SendtSum ?? 0))).ToList();
            var maks = Math.Max(1, maned.Max(x => x.V + x.T));
        }
        <div class="db-tall4">
            <a href="/rapporter/fakturaer" class="g">
                <span>Fakturert hittil i @_valgtAr</span>
                <b>@(_tripletexFeil is null ? KrKort(_fakturert) : "–")</b>
                <small>@if (_tripletexFeil is not null) { <text>Tripletex er ikke tilgjengelig</text> } else { @Endring(_fakturert, _fakturertIFjor) <text> mot i fjor · Tripletex</text> }</small>
            </a>
            <a href="/rapporter/tilbudsreserve"><span>Tilbud sendt i @_valgtAr</span><b>@KrKort(tilbudSendt)</b><small>@_arTilbud.Count tilbud · @(avgjorte == 0 ? "–" : $"{Prosent(_vunnet.Count, avgjorte)} %") vunnet</small></a>
            <a href="/rapporter/tilbudsreserve"><span>Tilbudsreserve</span><b>@KrKort(reserve)</b><small>@_venterAlle.Count tilbud venter svar</small></a>
            <a href="/rapporter/fakturaer"><span>Ordrereserve</span><b>@KrKort(Ordrereserve)</b><small>vunnet, ikke overlevert</small></a>
        </div>

        <div class="db-tre">
            <section class="db-bx">
                <div class="db-bx-hd">Vinnprosent per kundetype</div>
                @if (VinnPerType.Count == 0)
                {
                    <p class="db-tom">Ingen avgjorte tilbud i @_valgtAr.</p>
                }
                else
                {
                    <div class="db-bars">
                        @foreach (var (navn, prosent, antall) in VinnPerType)
                        {
                            <div title="@antall avgjorte tilbud"><span>@navn</span><span class="db-bar"><i style="width:@prosent%"></i></span><b>@prosent %</b></div>
                        }
                    </div>
                }
            </section>
            <section class="db-bx">
                <div class="db-bx-hd">Fakturert per kundetype</div>
                @if (_tripletexFeil is not null)
                {
                    <p class="db-tom">Hentes fra Tripletex – @_tripletexFeil</p>
                }
                else if (FakturertPerType.Count == 0)
                {
                    <p class="db-tom">Ingen fakturaer i @_valgtAr.</p>
                }
                else
                {
                    <div class="db-bars">
                        @foreach (var (navn, sum) in FakturertPerType)
                        {
                            <div><span>@navn</span><span class="db-bar"><i style="width:@Prosent(sum, maksType)%"></i></span><b>@KrKort(sum)</b></div>
                        }
                    </div>
                }
            </section>
            <section class="db-bx">
                <div class="db-bx-hd">Største tapte tilbud<small>@_avslatt.Count i @_valgtAr</small></div>
                @if (_avslatt.Count == 0)
                {
                    <p class="db-tom">Ingen tapte tilbud i @_valgtAr.</p>
                }
                @foreach (var t in _avslatt.OrderByDescending(t => t.SendtSum ?? 0).Take(5))
                {
                    <a class="db-rad" href="@($"/tilbud/{t.Id}")">
                        <span><b>@t.Tittel</b><small>@(t.Prosjekt?.Kunde?.Navn ?? "")@(t.Prosjekt?.Kunde?.Type is { } kt ? $" · {kt.Visningsnavn()}" : "")</small></span>
                        <b class="db-rod">@Kr(t.SendtSum ?? 0)</b>
                    </a>
                }
            </section>
        </div>

        <div class="db-to">
            <section class="db-bx">
                <div class="db-bx-hd">Største kunder i @_valgtAr<a class="db-hoyre" href="/rapporter/salg-per-kunde">Salg per kunde ›</a></div>
                @if (_tripletexFeil is not null)
                {
                    <p class="db-tom">Hentes fra Tripletex – @_tripletexFeil</p>
                }
                else if (StorsteKunder.Count == 0)
                {
                    <p class="db-tom">Ingen fakturaer i @_valgtAr.</p>
                }
                else
                {
                    <table class="db-tab">
                        <thead><tr><th>Kunde</th><th>Kundetype</th><th class="n">Fakturert</th><th class="n">Andel</th><th class="n">Tilbud ute</th></tr></thead>
                        <tbody>
                            @foreach (var k in StorsteKunder)
                            {
                                <tr>
                                    <td><b>@k.Navn</b></td>
                                    <td><span class="db-chip">@TypeNavn(k.Type)</span></td>
                                    <td class="n"><b>@Kr(k.Fakturert)</b></td>
                                    <td class="n">@(_fakturert == 0 ? "–" : $"{(k.Fakturert / _fakturert * 100).ToString("0.0", Kultur)} %")</td>
                                    <td class="n">@(k.TilbudUte == 0 ? "–" : Kr(k.TilbudUte))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
            <section class="db-bx">
                <div class="db-bx-hd">Tilbud på vei til å gå ut<small>over 60 dager uten svar</small></div>
                @if (gamle.Count == 0)
                {
                    <p class="db-ok"><b>✓ Ingen</b>Ingen tilbud har ventet over 60 dager.</p>
                }
                else
                {
                    <table class="db-tab">
                        <thead><tr><th>Tilbud</th><th class="n">Venter</th><th class="n">Sum</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in gamle.Take(6))
                            {
                                <tr>
                                    <td><b>@t.Tittel</b><small>@(t.Prosjekt?.Kunde?.Navn ?? "")</small></td>
                                    <td class="n"><b class="db-rod">@DagerSiden(t.SendtDato) d</b></td>
                                    <td class="n">@Kr(t.SendtSum ?? 0)</td>
                                    <td class="n"><a class="db-knapp liten" href="@($"/tilbud/{t.Id}")">Følg opp ›</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <section class="db-bx">
            <div class="db-bx-hd">Vunnet og tapt i @_valgtAr<span class="db-forkl db-hoyre"><span><i class="g"></i>Vunnet</span><span><i class="r"></i>Tapt</span></span></div>
            <div class="db-tall4 db-tall4-inne">
                <div class="g"><span>Vunnet</span><b>@KrKort(vunnetSum)</b><small>@_vunnet.Count tilbud</small></div>
                <div class="r"><span>Tapt</span><b>@KrKort(taptSum)</b><small>@_avslatt.Count tilbud</small></div>
                <div><span>Vinnprosent</span><b>@(avgjorte == 0 ? "–" : $"{Prosent(_vunnet.Count, avgjorte)} %")</b><small>av antall avgjorte</small></div>
                <div><span>Vinnprosent i kroner</span><b>@(vunnetSum + taptSum == 0 ? "–" : $"{Prosent(vunnetSum, vunnetSum + taptSum)} %")</b><small>av verdien som er avgjort</small></div>
            </div>
            <div class="db-vt">
                <div class="db-graf">
                    @for (var i = 0; i < 12; i++)
                    {
                        var (v, t) = maned[i];
                        <div class="@(_valgtAr == DateTime.Today.Year && i + 1 == DateTime.Today.Month ? "na" : "")" title="@($"{Kultur.DateTimeFormat.GetMonthName(i + 1)}: {Kr(v)} vunnet, {Kr(t)} tapt")">
                            <i class="g" style="height:@Prosent(v, maks)%"></i>
                            <i class="r" style="height:@Prosent(t, maks)%"></i>
                            <span>@Kultur.DateTimeFormat.GetAbbreviatedMonthName(i + 1).TrimEnd('.')</span>
                        </div>
                    }
                </div>
                <table class="db-tab">
                    <thead><tr><th>Siste avgjorte</th><th>Utfall</th><th class="n">Sum</th></tr></thead>
                    <tbody>
                        @foreach (var t in _vunnet.Concat(_avslatt).OrderByDescending(t => t.GodkjentDato ?? t.AvslattDato ?? t.SendtDato).Take(6))
                        {
                            var vant = t.Status == EndringsmeldingStatus.Godkjent;
                            var id = t.Id;
                            <tr class="db-klikk" @onclick="@(() => Nav.NavigateTo($"/tilbud/{id}"))">
                                <td><b>@t.Tittel</b><small>@(t.Prosjekt?.Kunde?.Navn ?? "")</small></td>
                                <td><span class="db-chip @(vant ? "gronn" : "rod")">@(vant ? "Vunnet" : "Tapt")</span></td>
                                <td class="n">@Kr(t.SendtSum ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>;

    // ---------- utregninger ----------
    private List<Tilbud> VenterLenge => _venterAlle.Where(t => DagerSiden(t.SendtDato) > 14).ToList();

    private List<FristRad> PasserteFrister => _frister.Where(f => f.Passert).ToList();

    private int AntallOppgaver =>
        (_slaForfalt.Count > 0 ? 1 : 0) + (VenterLenge.Count > 0 ? 1 : 0) + (_klarTilFakturering.Count > 0 ? 1 : 0) + (PasserteFrister.Count > 0 ? 1 : 0);

    // Godkjente tilbud på prosjekter som ikke er overlevert/avsluttet ennå.
    private decimal Ordrereserve => _alle
        .Where(t => t.Status == EndringsmeldingStatus.Godkjent
            && t.Prosjekt?.Status is not (ProsjektStatus.Overlevert or ProsjektStatus.Avsluttet))
        .Sum(t => t.SendtSum ?? 0);

    private List<(string Navn, int Prosent, int Antall)> VinnPerType => _vunnet.Concat(_avslatt)
        .GroupBy(t => t.Prosjekt?.Kunde?.Type)
        .Select(g => (Navn: TypeNavn(g.Key), Prosent: Prosent(g.Count(t => t.Status == EndringsmeldingStatus.Godkjent), g.Count()), Antall: g.Count()))
        .OrderByDescending(x => x.Antall)
        .ToList();

    private List<(string Navn, decimal Sum)> FakturertPerType => _fakturaer
        .GroupBy(f => _kundetyper.GetValueOrDefault(Nokkel(f.KundeNavn)))
        .Select(g => (Navn: TypeNavn(g.Key), Sum: g.Sum(Netto)))
        .Where(x => x.Sum != 0)
        .OrderByDescending(x => x.Sum)
        .ToList();

    private sealed record KundeRad(string Navn, KundeType? Type, decimal Fakturert, decimal TilbudUte);

    private List<KundeRad> StorsteKunder => _fakturaer
        .Where(f => f.KundeNavn is not null)
        .GroupBy(f => Nokkel(f.KundeNavn))
        .Select(g => new KundeRad(
            g.First().KundeNavn!,
            _kundetyper.GetValueOrDefault(g.Key),
            g.Sum(Netto),
            _venterAlle.Where(t => Nokkel(t.Prosjekt?.Kunde?.Navn) == g.Key).Sum(t => t.SendtSum ?? 0)))
        .OrderByDescending(k => k.Fakturert)
        .Take(6)
        .ToList();

    private List<int> TilgjengeligeAr => _alle.Select(t => t.SendtDato!.Value.Year)
        .Append(DateTime.Today.Year).Append(_valgtAr)
        .Distinct().OrderByDescending(y => y).ToList();

    // ---------- lasting ----------
    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("dashbord-bredde", "normal") == "full";
        await LastAsync();
        _klar = true;
    }

    private async Task LastAsync()
    {
        _laster = true;
        try
        {
            _alle = await Db.Tilbud.AsNoTracking()
                .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
                .Where(t => t.SendtDato != null
                    || t.Status == EndringsmeldingStatus.Godkjent
                    || t.Status == EndringsmeldingStatus.Avslatt)
                .ToListAsync();

            // Tilbud som ble godkjent/avslått uten å være «sendt» i portalen har
            // verken sendt-dato eller frosset sum: bruk svardatoen og regn summen.
            var utenSum = _alle.Where(t => t.SendtSum is null).Select(t => t.Id).ToList();
            var summer = utenSum.Count == 0 ? []
                : (await Db.Tilbud.AsNoTracking().Where(t => utenSum.Contains(t.Id)).Include(t => t.Linjer).ToListAsync())
                    .ToDictionary(t => t.Id, TilbudBeregningHelper.BeregnTotaltUtenMva);
            foreach (var t in _alle)
            {
                t.SendtDato ??= t.GodkjentDato ?? t.AvslattDato?.ToLocalTime().Date ?? t.OpprettetDato;
                t.SendtSum ??= summer.GetValueOrDefault(t.Id);
            }
            _alle = _alle.OrderByDescending(t => t.SendtDato).ToList();
            _venterAlle = _alle.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).ToList();

            _aktiveProsjekter = (await Db.Prosjekter.AsNoTracking()
                .Include(p => p.Kunde)
                .Include(p => p.Arbeidsordre)
                .Where(p => p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.Registrert || p.Status == ProsjektStatus.UnderArbeid)
                .AsSplitQuery()
                .ToListAsync())
                .OrderByDescending(p => p.Arbeidsordre.Count).ToList();

            var idag = DateTime.Today;
            var imorgen = idag.AddDays(1);
            var arbeidsordre = await Db.Arbeidsordre.AsNoTracking()
                .Include(a => a.Prosjekt)
                .Include(a => a.Kunde)
                .Include(a => a.AnsvarligMontor)
                .Where(a => a.Status == ArbeidsordreStatus.Ferdig || (a.PlanlagtDato >= idag && a.PlanlagtDato < imorgen))
                .ToListAsync();
            _klarTilFakturering = arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig).OrderBy(a => a.FullfortDato ?? a.OpprettetDato).ToList();
            _iDag = arbeidsordre.Where(a => a.PlanlagtDato?.Date == idag).OrderBy(a => a.PlanlagtDato).ToList();

            var na = DateTime.Now;
            _slaForfalt = (await Db.Tickets.AsNoTracking()
                .Where(t => t.Status != TicketStatus.Lukket && t.SlaFrist != null && t.SlaFrist < na)
                .ToListAsync())
                .OrderBy(t => t.SlaFrist).ToList();

            _kundetyper = (await Db.Kunder.AsNoTracking().Select(k => new { k.Navn, k.Type }).ToListAsync())
                .GroupBy(k => Nokkel(k.Navn))
                .ToDictionary(g => g.Key, g => g.Select(k => k.Type).FirstOrDefault(t => t is not null));

            await LastFristerAsync(arbeidsordre);
            OppdaterAr();
            await LastFakturertAsync();
            _lastet = DateTime.Now;
        }
        finally
        {
            _laster = false;
        }
    }

    private void OppdaterAr()
    {
        _arTilbud = _alle.Where(t => t.SendtDato!.Value.Year == _valgtAr).ToList();
        _vunnet = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Godkjent).ToList();
        _avslatt = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Avslatt).ToList();
    }

    // Fakturert i valgt år (til og med i dag for inneværende år) og samme periode i fjor.
    private async Task LastFakturertAsync()
    {
        var fra = new DateTime(_valgtAr, 1, 1);
        var til = _valgtAr == DateTime.Today.Year ? DateTime.Today : new DateTime(_valgtAr, 12, 31);
        var (iAr, feil) = await Tripletex.HentFakturaerAsync(fra, til);
        _tripletexFeil = feil;
        _fakturaer = feil is null ? iAr : [];
        _fakturert = _fakturaer.Sum(Netto);
        _fakturertIFjor = 0;
        if (feil is null)
        {
            var (iFjor, feilFjor) = await Tripletex.HentFakturaerAsync(fra.AddYears(-1), til.AddYears(-1));
            _fakturertIFjor = feilFjor is null ? iFjor.Sum(Netto) : 0;
        }
    }

    private async Task VelgAr(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var ar) || ar == _valgtAr)
        {
            return;
        }

        _valgtAr = ar;
        OppdaterAr();
        _laster = true;
        try
        {
            await LastFakturertAsync();
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dashbord-bredde", _full ? "full" : "normal");
    }

    // ---------- frister ----------
    private sealed class FristRad
    {
        public string Tittel { get; set; } = "";
        public string Undertekst { get; set; } = "";
        public DateTime Dato { get; set; }
        public string Ikon { get; set; } = "calendar";
        public bool Passert => Dato.Date < DateTime.Today;

        public string RelativTekst
        {
            get
            {
                var d = (Dato.Date - DateTime.Today).Days;
                if (d < 0) return "Passert";
                if (d == 0) return "I dag";
                if (d == 1) return "1 dag";
                return $"{d} dager";
            }
        }
    }

    private async Task LastFristerAsync(List<Arbeidsordre> arbeidsordre)
    {
        var frister = new List<FristRad>();

        var serviceProsjekter = await Db.Prosjekter.AsNoTracking().Where(p => ((p.Status == ProsjektStatus.Serviceavtale && !p.ErServiceoppdrag) || p.HarServiceavtale)).ToListAsync();
        if (serviceProsjekter.Count > 0)
        {
            var ider = serviceProsjekter.Select(p => p.Id).ToList();
            var runder = await Db.Servicerunder.AsNoTracking().Where(r => ider.Contains(r.ProsjektId)).ToListAsync();
            foreach (var p in serviceProsjekter)
            {
                var neste = runder.Where(r => r.ProsjektId == p.Id)
                    .OrderByDescending(r => r.Dato)
                    .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;
                if (neste.HasValue)
                {
                    frister.Add(new FristRad { Tittel = $"Serviceavtale – {p.Navn}", Undertekst = "Årlig service", Dato = neste.Value, Ikon = "shield" });
                }
            }
        }

        foreach (var c in await Db.CeGodkjenninger.AsNoTracking().Where(c => c.Status == CeGodkjenningStatus.Godkjent).ToListAsync())
        {
            frister.Add(new FristRad { Tittel = $"CE-sertifisering – {(c.ProsjektNavn ?? c.KundeNavn ?? "Ukjent")}", Undertekst = "Dokumentasjon fornyes", Dato = c.GyldigTil, Ikon = "shield" });
        }

        foreach (var a in arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig))
        {
            frister.Add(new FristRad { Tittel = $"Fakturafrist – {a.Tittel}", Undertekst = "Send faktura", Dato = (a.FullfortDato ?? a.OpprettetDato).AddDays(14), Ikon = "receipt" });
        }

        _frister = frister.OrderBy(f => f.Dato).Take(6).ToList();
    }

    // ---------- små hjelpere ----------
    private static decimal Netto(TripletexService.TripletexFaktura f) => f.ErKreditnota ? -Math.Abs(f.Belop) : f.Belop;

    private static string Nokkel(string? navn) => (navn ?? "").Trim().ToLowerInvariant();

    private static string TypeNavn(KundeType? t) => t?.Visningsnavn() ?? "Ikke satt";

    private static string ProsjektStatusNavn(ProsjektStatus? s) => s switch
    {
        ProsjektStatus.Registrert => "Registrert",
        ProsjektStatus.UnderArbeid => "Under arbeid",
        _ => "Aktiv"
    };

    private static RenderFragment Endring(decimal naa, decimal fjor) => __builder =>
    {
        if (fjor <= 0)
        {
            <span>ny</span>
            return;
        }

        var d = (int)Math.Round((naa - fjor) / fjor * 100);
        <span class="@(d >= 0 ? "db-gronn" : "db-rod")">@(d >= 0 ? "▲" : "▼") @Math.Abs(d) %</span>
    };

    private static string Kr(decimal sum) => $"{sum.ToString("N0", Kultur)} kr";

    private static string KrKort(decimal sum) => Math.Abs(sum) >= 1_000_000
        ? $"{(sum / 1_000_000).ToString("0.##", Kultur)} mill. kr"
        : Kr(sum);

    private static int Prosent(decimal del, decimal hel) => hel <= 0 ? 0 : (int)Math.Round(Math.Max(0, del) / hel * 100);
    private static int Prosent(int del, int hel) => hel <= 0 ? 0 : (int)Math.Round(del * 100.0 / hel);

    private static int DagerSiden(DateTime? dato) => dato is null ? 0 : Math.Max(0, (DateTime.Today - dato.Value.Date).Days);

    private static string Varighet(TimeSpan t)
    {
        if (t.TotalHours >= 24) { return $"{(int)t.TotalDays} d {t.Hours} t"; }
        if (t.TotalMinutes >= 60) { return $"{(int)t.TotalHours} t {t.Minutes} min"; }
        return $"{Math.Max(1, (int)t.TotalMinutes)} min";
    }

    private static string Initialer(string? navn) =>
        string.IsNullOrWhiteSpace(navn)
            ? "?"
            : string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));
}
