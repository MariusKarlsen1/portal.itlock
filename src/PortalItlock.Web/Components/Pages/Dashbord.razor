    // Hvor mye av SLA-tiden som er brukt (for streken), i prosent.
    private static int SlaBrukt(Ticket t)
    {
        if (t.SlaFrist is not { } frist)
        {
            return 0;
        }
        var total = (frist - t.OpprettetDato).TotalMinutes;
        return total <= 0 ? 100 : (int)Math.Clamp((DateTime.Now - t.OpprettetDato).TotalMinutes / total * 100, 0, 100);
    }

