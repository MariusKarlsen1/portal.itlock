@page "/dashbord"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dashbord - Full Kontroll</PageTitle>

<div class="db-side">

    <div class="topp-rad">
        <div class="side-header">
            <div class="side-header-ikon"><Icon Name="trend-up" /></div>
            <div>
                <h1>Dashboard</h1>
                <p class="section-hint">Oversikt over sendte tilbud, prosjekter, oppgaver og nøkkeltall.</p>
            </div>
        </div>

        <div class="ars-valg" @onclick:stopPropagation="true">
            <button type="button" class="ars-select" @onclick="ToggleArValg">
                <Icon Name="calendar" />
                <span>@_valgtAr</span>
                <Icon Name="chevron-down" />
            </button>
            @if (_visArValg)
            {
                <div class="ars-meny">
                    @foreach (var ar in TilgjengeligeAr)
                    {
                        <button type="button" class="ars-meny-rad @(ar == _valgtAr ? "aktiv" : "")" @onclick="@(() => VelgAr(ar))">@ar</button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="db-fanerad">
        <button type="button" class="db-fane @(_fane == "oversikt" ? "aktiv" : "")" @onclick="@(() => _fane = "oversikt")">Oversikt</button>
        <button type="button" class="db-fane @(_fane == "tilbud" ? "aktiv" : "")" @onclick="@(() => _fane = "tilbud")">Tilbud</button>
        <button type="button" class="db-fane @(_fane == "prosjekter" ? "aktiv" : "")" @onclick="@(() => _fane = "prosjekter")">Prosjekter</button>
        <button type="button" class="db-fane @(_fane == "arbeidsordre" ? "aktiv" : "")" @onclick="@(() => _fane = "arbeidsordre")">Arbeidsordre</button>
        <button type="button" class="db-fane @(_fane == "tickets" ? "aktiv" : "")" @onclick="@(() => _fane = "tickets")">Tickets</button>
        <button type="button" class="db-fane @(_fane == "okonomi" ? "aktiv" : "")" @onclick="@(() => _fane = "okonomi")">Økonomi</button>
    </div>

    @if (_fane == "oversikt")
    {
        <div class="db-statrow">
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-aksent"><Icon Name="trend-up" /></span>
                <div>
                    <span class="db-statcard-num">@(_avgjorte == 0 ? "-" : $"{_vinnprosent:N0}%")</span>
                    <span class="db-statcard-lbl">Vinnprosent</span>
                    <span class="db-statcard-sub">@_vunnet.Count vunnet av @_avgjorte avgjorte</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-gul"><Icon Name="receipt" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_venter.Sum(t => t.SendtSum ?? 0))</span>
                    <span class="db-statcard-lbl">Venter svar</span>
                    <span class="db-statcard-sub">@_venter.Count tilbud</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-gronn"><Icon Name="check" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_vunnet.Sum(t => t.SendtSum ?? 0))</span>
                    <span class="db-statcard-lbl">Vunnet</span>
                    <span class="db-statcard-sub">@_vunnet.Count tilbud</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-rod"><Icon Name="x" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_avslatt.Sum(t => t.SendtSum ?? 0))</span>
                    <span class="db-statcard-lbl">Avslått</span>
                    <span class="db-statcard-sub">@_avslatt.Count tilbud</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-lilla"><Icon Name="file-text" /></span>
                <div>
                    <span class="db-statcard-num">@_arTilbud.Count</span>
                    <span class="db-statcard-lbl">Sendte tilbud</span>
                    <span class="db-statcard-sub">i @_valgtAr</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-blaa"><Icon Name="clock" /></span>
                <div>
                    <span class="db-statcard-num">@_timerDenneUken.ToString("N1", Kultur)t</span>
                    <span class="db-statcard-lbl">Timer (uke)</span>
                    <span class="db-statcard-sub db-delta">@TimerDeltaTekst</span>
                </div>
            </div>
        </div>

        <div class="db-grid2">
            <div class="kort graf-kort">
                <div class="graf-header">
                    <h2>Tilbud sendt per måned &middot; @_valgtAr</h2>
                    <div class="dashbord-forklaring">
                        <span><span class="dashbord-dott dashbord-dott-gronn"></span>Vunnet</span>
                        <span><span class="dashbord-dott dashbord-dott-rod"></span>Avslått</span>
                        <span><span class="dashbord-dott dashbord-dott-gul"></span>Venter svar</span>
                    </div>
                </div>
                <div class="dashbord-graf">
                    @foreach (var m in _maneder)
                    {
                        <div class="dashbord-graf-soyle" @key="m.Etikett">
                            <div class="dashbord-graf-stabel" style="height:@(m.HoydePx)px;">
                                @if (m.VunnetSum > 0)
                                {
                                    <div class="dashbord-graf-del dashbord-graf-del-gronn" style="height:@(m.VunnetAndel)%;"></div>
                                }
                                @if (m.AvslattSum > 0)
                                {
                                    <div class="dashbord-graf-del dashbord-graf-del-rod" style="height:@(m.AvslattAndel)%;"></div>
                                }
                                @if (m.VenterSum > 0)
                                {
                                    <div class="dashbord-graf-del dashbord-graf-del-gul" style="height:@(m.VenterAndel)%;"></div>
                                }
                            </div>
                            <span class="dashbord-graf-etikett">@m.Etikett</span>
                        </div>
                    }
                </div>
            </div>

            <div class="kort db-omsetning-kort">
                <h2>Omsetning hittil i år</h2>
                <div class="db-omsetning-verdi">@Kr(_omsetningHittil)</div>
                <div class="db-omsetning-delta @(_omsetningDeltaProsent >= 0 ? "positiv" : "negativ")">
                    @(_omsetningDeltaProsent >= 0 ? "↗" : "↘") @(_omsetningDeltaProsent >= 0 ? "+" : "")@_omsetningDeltaProsent % fra samme periode i fjor
                </div>
                <svg class="db-omsetning-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polygon points="@OmsetningOmradePunkter()" class="db-omsetning-omrade" />
                    <polyline points="@OmsetningLinjePunkter()" class="db-omsetning-linje" vector-effect="non-scaling-stroke" />
                </svg>
                <div class="db-omsetning-etiketter">
                    @foreach (var m in _omsetningKurve)
                    {
                        <span>@m.Etikett</span>
                    }
                </div>
            </div>
        </div>

        <div class="db-grid3">
            <div class="kort db-donut-kort">
                <h2>Prosjekter fordelt på status</h2>
                <div class="db-donut-rad">
                    <div class="db-donut" style="background:@DonutGradient(_prosjektDonutDeler)">
                        <div class="db-donut-indre">
                            <span class="db-donut-tall">@_prosjektDonutDeler.Sum(d => d.Verdi)</span>
                            <span class="db-donut-label">Totalt</span>
                        </div>
                    </div>
                    <ul class="db-donut-legend">
                        @foreach (var d in _prosjektDonutDeler)
                        {
                            <li><span class="db-legend-dott" style="background:@FargeHex(d.Farge)"></span>@d.Navn <strong>@d.Verdi</strong></li>
                        }
                    </ul>
                </div>
                <a class="db-se-alle" href="/prosjekter">Se alle →</a>
            </div>

            <div class="kort db-donut-kort">
                <h2>Arbeidsordre fordelt på status</h2>
                <div class="db-donut-rad">
                    <div class="db-donut" style="background:@DonutGradient(_arbeidsordreDonutDeler)">
                        <div class="db-donut-indre">
                            <span class="db-donut-tall">@_arbeidsordreDonutDeler.Sum(d => d.Verdi)</span>
                            <span class="db-donut-label">Totalt</span>
                        </div>
                    </div>
                    <ul class="db-donut-legend">
                        @foreach (var d in _arbeidsordreDonutDeler)
                        {
                            <li><span class="db-legend-dott" style="background:@FargeHex(d.Farge)"></span>@d.Navn <strong>@d.Verdi</strong></li>
                        }
                    </ul>
                </div>
                <a class="db-se-alle" href="/arbeidsordre">Se alle →</a>
            </div>

            <div class="kort db-frister-kort">
                <div class="db-frister-header">
                    <h2>Kommende frister</h2>
                </div>
                @if (_kommendeFrister.Count == 0)
                {
                    <p class="list-empty">Ingen kommende frister.</p>
                }
                else
                {
                    <ul class="db-frister-liste">
                        @foreach (var f in _kommendeFrister)
                        {
                            <li class="db-frist-rad">
                                <span class="db-frist-ikon"><Icon Name="@f.Ikon" /></span>
                                <span class="db-frist-info">
                                    <span class="db-frist-tittel">@f.Tittel</span>
                                    <span class="db-frist-sub">@f.Undertekst</span>
                                </span>
                                <span class="db-frist-hoyre">
                                    <span class="db-frist-dato">@f.Dato.ToString("dd.MM.yyyy")</span>
                                    <span class="db-frist-pill db-frist-pill-@f.Farge">@f.RelativTekst</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    else if (_fane == "tilbud")
    {
        <div class="kort tabell-kort">
            <div class="tabell-header">
                <h2>Sendte tilbud</h2>
                <div class="dashbord-filter">
                    <button type="button" class="dashbord-filter-knapp @(_filter == "alle" ? "aktiv" : "")" @onclick="@(() => _filter = "alle")">Alle</button>
                    <button type="button" class="dashbord-filter-knapp @(_filter == "venter" ? "aktiv" : "")" @onclick="@(() => _filter = "venter")">Venter svar</button>
                    <button type="button" class="dashbord-filter-knapp @(_filter == "vunnet" ? "aktiv" : "")" @onclick="@(() => _filter = "vunnet")">Vunnet</button>
                    <button type="button" class="dashbord-filter-knapp @(_filter == "avslatt" ? "aktiv" : "")" @onclick="@(() => _filter = "avslatt")">Avslått</button>
                </div>
            </div>

            @if (_vises.Count == 0)
            {
                <p class="list-empty">Ingen sendte tilbud i @_valgtAr.</p>
            }
            else
            {
                <table class="dashbord-tabell">
                    <thead>
                        <tr>
                            <th>Tilbud</th>
                            <th>Kunde</th>
                            <th>Sum</th>
                            <th>Sendt</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _vises)
                        {
                            <tr @key="t.Id">
                                <td><a href="@($"/tilbud/{t.Id}")">@t.Tittel</a></td>
                                <td>@(t.Prosjekt?.Kunde?.Navn ?? "Ingen kunde")</td>
                                <td>@Kr(t.SendtSum ?? 0)</td>
                                <td>@t.SendtDato?.ToString("dd.MM.yyyy")</td>
                                <td><StatusPill Tekst="@t.Status.Visningsnavn()" Ikon="@TilbudStatusIkon(t.Status)" Farge="@TilbudStatusFarge(t.Status)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_fane == "prosjekter")
    {
        <div class="db-statrow db-statrow-4">
            @foreach (var d in _prosjektDonutDeler)
            {
                <div class="kort db-statcard">
                    <span class="db-statcard-ic db-ic-@d.Farge"><Icon Name="folder" /></span>
                    <div>
                        <span class="db-statcard-num">@d.Verdi</span>
                        <span class="db-statcard-lbl">@d.Navn</span>
                    </div>
                </div>
            }
        </div>

        <div class="kort tabell-kort">
            <div class="tabell-header">
                <h2>Siste prosjekter</h2>
                <a class="db-se-alle" href="/prosjekter">Se alle →</a>
            </div>
            @if (_prosjekterAlle.Count == 0)
            {
                <p class="list-empty">Ingen prosjekter registrert ennå.</p>
            }
            else
            {
                <table class="dashbord-tabell">
                    <thead>
                        <tr><th>Prosjekt</th><th>Kunde</th><th>Status</th><th>Opprettet</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _prosjekterAlle.Take(8))
                        {
                            <tr @key="p.Id">
                                <td><a href="@($"/prosjekter/{p.Id}")">@p.Navn</a></td>
                                <td>@(p.Kunde?.Navn ?? "Ingen kunde")</td>
                                <td><StatusPill Tekst="@(p.Status?.Visningsnavn() ?? "Ukjent")" Ikon="@(p.Status?.PillIkon() ?? "folder")" Farge="@(p.Status?.PillFarge() ?? "noytral")" /></td>
                                <td>@p.OpprettetDato.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_fane == "arbeidsordre")
    {
        <div class="db-statrow db-statrow-5">
            @foreach (var d in _arbeidsordreDonutDeler)
            {
                <div class="kort db-statcard">
                    <span class="db-statcard-ic db-ic-@d.Farge"><Icon Name="tool" /></span>
                    <div>
                        <span class="db-statcard-num">@d.Verdi</span>
                        <span class="db-statcard-lbl">@d.Navn</span>
                    </div>
                </div>
            }
        </div>

        <div class="kort tabell-kort">
            <div class="tabell-header">
                <h2>Siste arbeidsordre</h2>
                <a class="db-se-alle" href="/arbeidsordre">Se alle →</a>
            </div>
            @if (_arbeidsordreAlle.Count == 0)
            {
                <p class="list-empty">Ingen arbeidsordre registrert ennå.</p>
            }
            else
            {
                <table class="dashbord-tabell">
                    <thead>
                        <tr><th>Arbeidsordre</th><th>Prosjekt</th><th>Ansvarlig</th><th>Status</th><th>Planlagt</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _arbeidsordreAlle.Take(8))
                        {
                            <tr @key="a.Id">
                                <td><a href="@($"/arbeidsordre/{a.Id}")">@a.Tittel</a></td>
                                <td>@(a.Prosjekt?.Navn ?? "-")</td>
                                <td>@(a.AnsvarligMontor?.Navn ?? "Ikke tildelt")</td>
                                <td><StatusPill Tekst="@a.Status.Visningsnavn()" Ikon="@a.Status.PillIkon()" Farge="@a.Status.PillFarge()" /></td>
                                <td>@(a.PlanlagtDato?.ToString("dd.MM.yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_fane == "tickets")
    {
        <div class="db-statrow db-statrow-3">
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-blaa"><Icon Name="bell" /></span>
                <div>
                    <span class="db-statcard-num">@_ticketsApne</span>
                    <span class="db-statcard-lbl">Åpne tickets</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-rod"><Icon Name="alert" /></span>
                <div>
                    <span class="db-statcard-num">@_ticketsSlaForfalt</span>
                    <span class="db-statcard-lbl">SLA forfalt</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-gronn"><Icon Name="check-circle" /></span>
                <div>
                    <span class="db-statcard-num">@_ticketsLukketIAr</span>
                    <span class="db-statcard-lbl">Lukket i @_valgtAr</span>
                </div>
            </div>
        </div>

        <div class="kort tabell-kort">
            <div class="tabell-header">
                <h2>Åpne tickets</h2>
                <a class="db-se-alle" href="/tickets">Se alle →</a>
            </div>
            @if (_ticketsApneListe.Count == 0)
            {
                <p class="list-empty">Ingen åpne tickets.</p>
            }
            else
            {
                <table class="dashbord-tabell">
                    <thead>
                        <tr><th>Ticket</th><th>Kunde</th><th>Status</th><th>Prioritet</th><th>SLA-frist</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _ticketsApneListe.Take(8))
                        {
                            <tr @key="t.Id">
                                <td><a href="@($"/ticket/{t.Id}")">#@t.Id - @t.Tittel</a></td>
                                <td>@(t.Kunde?.Navn ?? "Ingen kunde")</td>
                                <td><StatusPill Tekst="@t.Status.Visningsnavn()" Ikon="@t.Status.PillIkon()" Farge="@t.Status.PillFarge()" /></td>
                                <td>@t.Prioritet.Visningsnavn()</td>
                                <td>@(t.SlaFrist?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (_fane == "okonomi")
    {
        <div class="db-statrow db-statrow-3">
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-gronn"><Icon Name="receipt" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_omsetningHittil)</span>
                    <span class="db-statcard-lbl">Omsetning i @_valgtAr</span>
                    <span class="db-statcard-sub db-delta">@(_omsetningDeltaProsent >= 0 ? "+" : "")@_omsetningDeltaProsent % fra i fjor</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-gul"><Icon Name="file-text" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_tilbudsreserveTotalt)</span>
                    <span class="db-statcard-lbl">Tilbudsreserve</span>
                    <span class="db-statcard-sub">Alle tilbud som venter svar</span>
                </div>
            </div>
            <div class="kort db-statcard">
                <span class="db-statcard-ic db-ic-aksent"><Icon Name="trend-up" /></span>
                <div>
                    <span class="db-statcard-num">@Kr(_snittTilbudsstorrelse)</span>
                    <span class="db-statcard-lbl">Snitt vunnet tilbud</span>
                </div>
            </div>
        </div>

        <div class="kort db-omsetning-kort db-omsetning-kort-stor">
            <h2>Omsetning hittil i år</h2>
            <div class="db-omsetning-verdi">@Kr(_omsetningHittil)</div>
            <div class="db-omsetning-delta @(_omsetningDeltaProsent >= 0 ? "positiv" : "negativ")">
                @(_omsetningDeltaProsent >= 0 ? "↗" : "↘") @(_omsetningDeltaProsent >= 0 ? "+" : "")@_omsetningDeltaProsent % fra samme periode i fjor
            </div>
            <svg class="db-omsetning-svg db-omsetning-svg-stor" viewBox="0 0 100 100" preserveAspectRatio="none">
                <polygon points="@OmsetningOmradePunkter()" class="db-omsetning-omrade" />
                <polyline points="@OmsetningLinjePunkter()" class="db-omsetning-linje" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="db-omsetning-etiketter">
                @foreach (var m in _omsetningKurve)
                {
                    <span>@m.Etikett</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _fane = "oversikt";

    private List<Tilbud> _alle = [];
    private List<Tilbud> _venter = [];
    private List<Tilbud> _vunnet = [];
    private List<Tilbud> _avslatt = [];
    private List<Tilbud> _arTilbud = [];
    private int _avgjorte;
    private double _vinnprosent;
    private string _filter = "alle";
    private int _valgtAr = DateTime.Today.Year;
    private bool _visArValg;

    private List<Prosjekt> _prosjekterAlle = [];
    private List<Arbeidsordre> _arbeidsordreAlle = [];
    private List<Ticket> _ticketsAlle = [];

    private decimal _timerDenneUken;
    private decimal _timerForrigeUken;

    private decimal _omsetningHittil;
    private decimal _omsetningDeltaProsent;
    private List<(string Etikett, decimal Kumulativ)> _omsetningKurve = [];

    private decimal _tilbudsreserveTotalt;
    private decimal _snittTilbudsstorrelse;

    private sealed record ManedData(string Etikett, decimal VunnetSum, decimal AvslattSum, decimal VenterSum, int HoydePx, double VunnetAndel, double AvslattAndel, double VenterAndel);
    private List<ManedData> _maneder = [];

    private sealed record DonutDel(string Navn, int Verdi, string Farge);
    private List<DonutDel> _prosjektDonutDeler = [];
    private List<DonutDel> _arbeidsordreDonutDeler = [];

    private sealed class FristRad
    {
        public string Tittel { get; set; } = "";
        public string Undertekst { get; set; } = "";
        public DateTime Dato { get; set; }
        public string Ikon { get; set; } = "calendar";

        public string RelativTekst
        {
            get
            {
                var d = (Dato.Date - DateTime.Today).Days;
                if (d < 0) return "Forfalt";
                if (d == 0) return "I dag";
                if (d == 1) return "1 dag";
                return $"{d} dager";
            }
        }

        public string Farge
        {
            get
            {
                var d = (Dato.Date - DateTime.Today).Days;
                return d <= 0 ? "rod" : d <= 7 ? "gul" : "noytral";
            }
        }
    }

    private List<FristRad> _kommendeFrister = [];

    private int _ticketsApne;
    private int _ticketsSlaForfalt;
    private int _ticketsLukketIAr;
    private List<Ticket> _ticketsApneListe = [];

    private List<int> TilgjengeligeAr
    {
        get
        {
            var ar = _alle.Where(t => t.SendtDato.HasValue).Select(t => t.SendtDato!.Value.Year).Distinct().OrderByDescending(y => y).ToList();
            if (!ar.Contains(_valgtAr))
            {
                ar.Insert(0, _valgtAr);
            }
            return ar;
        }
    }

    private List<Tilbud> _vises => _filter switch
    {
        "venter" => _venter,
        "vunnet" => _vunnet,
        "avslatt" => _avslatt,
        _ => _arTilbud
    };

    protected override async Task OnInitializedAsync()
    {
        _alle = await Db.Tilbud
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .Where(t => t.SendtDato != null)
            .OrderByDescending(t => t.SendtDato)
            .ToListAsync();

        _valgtAr = _alle.Count > 0 ? _alle.Max(t => t.SendtDato!.Value.Year) : DateTime.Today.Year;

        _prosjekterAlle = await Db.Prosjekter
            .Include(p => p.Kunde)
            .OrderByDescending(p => p.OpprettetDato)
            .ToListAsync();

        _arbeidsordreAlle = await Db.Arbeidsordre
            .Include(a => a.Prosjekt)
            .Include(a => a.AnsvarligMontor)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _ticketsAlle = await Db.Tickets
            .Include(t => t.Kunde)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();

        var mandag = FinnMandag(DateTime.Today);
        var forrigeMandag = mandag.AddDays(-7);
        var registreringer = await Db.Timeregistreringer
            .Where(t => t.Dato >= forrigeMandag && t.Dato < mandag.AddDays(7))
            .ToListAsync();
        _timerDenneUken = registreringer.Where(t => t.Dato >= mandag).Sum(t => t.TotalTimer);
        _timerForrigeUken = registreringer.Where(t => t.Dato < mandag).Sum(t => t.TotalTimer);

        await LastKommendeFristerAsync();

        OppdaterFiltrering();
        OppdaterDonuter();
        OppdaterTickets();
    }

    private static DateTime FinnMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek + 6) % 7;
        return dato.Date.AddDays(-diff);
    }

    private string TimerDeltaTekst
    {
        get
        {
            if (_timerForrigeUken <= 0)
            {
                return _timerDenneUken > 0 ? "Nytt denne uken" : "Ingen timer registrert";
            }

            var prosent = Math.Round((_timerDenneUken - _timerForrigeUken) / _timerForrigeUken * 100);
            return (prosent >= 0 ? "+" : "") + prosent + "% fra forrige uke";
        }
    }

    private async Task LastKommendeFristerAsync()
    {
        var frister = new List<FristRad>();

        var serviceProsjekter = await Db.Prosjekter.Where(p => p.Status == ProsjektStatus.Serviceavtale).ToListAsync();
        if (serviceProsjekter.Count > 0)
        {
            var ider = serviceProsjekter.Select(p => p.Id).ToList();
            var runder = await Db.Servicerunder.Where(r => ider.Contains(r.ProsjektId)).ToListAsync();
            foreach (var p in serviceProsjekter)
            {
                var neste = runder.Where(r => r.ProsjektId == p.Id)
                    .OrderByDescending(r => r.Dato)
                    .FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

                if (neste.HasValue)
                {
                    frister.Add(new FristRad { Tittel = $"Serviceavtale - {p.Navn}", Undertekst = "Årlig service", Dato = neste.Value, Ikon = "shield" });
                }
            }
        }

        var ceListe = await Db.CeGodkjenninger.Where(c => c.Status == CeGodkjenningStatus.Godkjent).ToListAsync();
        foreach (var c in ceListe)
        {
            frister.Add(new FristRad { Tittel = $"CE-sertifisering - {(c.ProsjektNavn ?? c.KundeNavn ?? "Ukjent")}", Undertekst = "Dokumentasjon fornyes", Dato = c.GyldigTil, Ikon = "shield" });
        }

        var ferdigOrdre = await Db.Arbeidsordre.Where(a => a.Status == ArbeidsordreStatus.Ferdig).ToListAsync();
        foreach (var a in ferdigOrdre)
        {
            var frist = (a.FullfortDato ?? a.OpprettetDato).AddDays(14);
            frister.Add(new FristRad { Tittel = $"Fakturafrist - {a.Tittel}", Undertekst = "Send faktura", Dato = frist, Ikon = "receipt" });
        }

        _kommendeFrister = frister.OrderBy(f => f.Dato).Take(6).ToList();
    }

    private void ToggleArValg()
    {
        _visArValg = !_visArValg;
    }

    private void VelgAr(int ar)
    {
        _valgtAr = ar;
        _visArValg = false;
        OppdaterFiltrering();
    }

    private void OppdaterFiltrering()
    {
        _arTilbud = _alle.Where(t => t.SendtDato!.Value.Year == _valgtAr).ToList();
        _venter = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).ToList();
        _vunnet = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Godkjent).ToList();
        _avslatt = _arTilbud.Where(t => t.Status == EndringsmeldingStatus.Avslatt).ToList();
        _avgjorte = _vunnet.Count + _avslatt.Count;
        _vinnprosent = _avgjorte == 0 ? 0 : (double)_vunnet.Count / _avgjorte * 100;

        var rader = new List<(string Etikett, decimal Vunnet, decimal Avslatt, decimal Venter)>();
        for (var maned = 1; maned <= 12; maned++)
        {
            var manedStart = new DateTime(_valgtAr, maned, 1);
            var manedSlutt = manedStart.AddMonths(1);
            var iManed = _arTilbud.Where(t => t.SendtDato >= manedStart && t.SendtDato < manedSlutt).ToList();
            rader.Add((
                manedStart.ToString("MMM", Kultur),
                iManed.Where(t => t.Status == EndringsmeldingStatus.Godkjent).Sum(t => t.SendtSum ?? 0),
                iManed.Where(t => t.Status == EndringsmeldingStatus.Avslatt).Sum(t => t.SendtSum ?? 0),
                iManed.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).Sum(t => t.SendtSum ?? 0)));
        }

        var maxTotalt = Math.Max(1, rader.Max(r => r.Vunnet + r.Avslatt + r.Venter));
        _maneder = rader.Select(r =>
        {
            var totalt = r.Vunnet + r.Avslatt + r.Venter;
            return new ManedData(
                r.Etikett, r.Vunnet, r.Avslatt, r.Venter,
                totalt <= 0 ? 0 : (int)Math.Max(24, totalt / maxTotalt * 150),
                totalt <= 0 ? 0 : (double)(r.Vunnet / totalt * 100),
                totalt <= 0 ? 0 : (double)(r.Avslatt / totalt * 100),
                totalt <= 0 ? 0 : (double)(r.Venter / totalt * 100));
        }).ToList();

        // Omsetning - løpende sum av vunnede tilbud gjennom året, pluss YoY-delta mot samme periode i fjor.
        var vunnetIAr = _alle.Where(t => t.Status == EndringsmeldingStatus.Godkjent && t.SendtDato!.Value.Year == _valgtAr).ToList();
        decimal lopende = 0;
        var kurve = new List<(string, decimal)>();
        for (var m = 1; m <= 12; m++)
        {
            var manedStart = new DateTime(_valgtAr, m, 1);
            var manedSlutt = manedStart.AddMonths(1);
            lopende += vunnetIAr.Where(t => t.SendtDato >= manedStart && t.SendtDato < manedSlutt).Sum(t => t.SendtSum ?? 0);
            kurve.Add((manedStart.ToString("MMM", Kultur), lopende));
        }
        _omsetningKurve = kurve;

        var cutoffManed = _valgtAr == DateTime.Today.Year ? DateTime.Today.Month : 12;
        var sumIAr = vunnetIAr.Where(t => t.SendtDato!.Value.Month <= cutoffManed).Sum(t => t.SendtSum ?? 0);
        var vunnetIFjor = _alle.Where(t => t.Status == EndringsmeldingStatus.Godkjent && t.SendtDato!.Value.Year == _valgtAr - 1 && t.SendtDato!.Value.Month <= cutoffManed).Sum(t => t.SendtSum ?? 0);
        _omsetningHittil = sumIAr;
        _omsetningDeltaProsent = vunnetIFjor == 0 ? (sumIAr > 0 ? 100 : 0) : Math.Round((sumIAr - vunnetIFjor) / vunnetIFjor * 100, 0);

        _tilbudsreserveTotalt = _alle.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).Sum(t => t.SendtSum ?? 0);
        var vunnetAlleTider = _alle.Where(t => t.Status == EndringsmeldingStatus.Godkjent).ToList();
        _snittTilbudsstorrelse = vunnetAlleTider.Count == 0 ? 0 : vunnetAlleTider.Average(t => t.SendtSum ?? 0);
    }

    private void OppdaterDonuter()
    {
        var bucketed = _prosjekterAlle
            .Where(p => p.Status != ProsjektStatus.Serviceavtale)
            .GroupBy(p => ProsjektBucket(p.Status))
            .ToDictionary(g => g.Key, g => g.Count());

        _prosjektDonutDeler =
        [
            new DonutDel("Nye", bucketed.GetValueOrDefault("Nye"), "blaa"),
            new DonutDel("Pågående", bucketed.GetValueOrDefault("Pågående"), "gul"),
            new DonutDel("Ferdigstilt", bucketed.GetValueOrDefault("Ferdigstilt"), "gronn"),
            new DonutDel("Avslått", bucketed.GetValueOrDefault("Avslått"), "rod"),
        ];

        var aoGrupper = _arbeidsordreAlle.GroupBy(a => a.Status).ToDictionary(g => g.Key, g => g.Count());
        _arbeidsordreDonutDeler = Enum.GetValues<ArbeidsordreStatus>()
            .Select(s => new DonutDel(s.Visningsnavn(), aoGrupper.GetValueOrDefault(s), s.PillFarge()))
            .ToList();
    }

    private static string ProsjektBucket(ProsjektStatus? status) => status switch
    {
        ProsjektStatus.Registrert => "Nye",
        ProsjektStatus.Overlevert => "Ferdigstilt",
        ProsjektStatus.Avsluttet => "Ferdigstilt",
        ProsjektStatus.TilbudAvslatt => "Avslått",
        _ => "Pågående"
    };

    private void OppdaterTickets()
    {
        _ticketsApneListe = _ticketsAlle
            .Where(t => t.Status != TicketStatus.Lukket)
            .OrderBy(t => t.SlaFrist ?? DateTime.MaxValue)
            .ToList();
        _ticketsApne = _ticketsApneListe.Count;
        _ticketsSlaForfalt = _ticketsApneListe.Count(t => t.SlaFrist.HasValue && t.SlaFrist.Value < DateTime.Now);
        _ticketsLukketIAr = _ticketsAlle.Count(t => t.Status == TicketStatus.Lukket && t.LukketDato?.Year == _valgtAr);
    }

    private static string FargeHex(string farge) => farge switch
    {
        "blaa" => "#0b66e6",
        "gul" => "#c2590a",
        "gronn" => "#0c9c5c",
        "lilla" => "#7a2b96",
        "rod" => "#a32020",
        _ => "#9a958c"
    };

    private static string DonutGradient(List<DonutDel> deler)
    {
        var total = deler.Sum(d => d.Verdi);
        if (total <= 0)
        {
            return "var(--itlock-border)";
        }

        var segmenter = new List<string>();
        decimal kumulativ = 0;
        foreach (var d in deler)
        {
            if (d.Verdi <= 0)
            {
                continue;
            }

            var start = kumulativ / total * 100;
            kumulativ += d.Verdi;
            var slutt = kumulativ / total * 100;
            segmenter.Add($"{FargeHex(d.Farge)} {start.ToString("0.##", CultureInfo.InvariantCulture)}% {slutt.ToString("0.##", CultureInfo.InvariantCulture)}%");
        }

        return $"conic-gradient({string.Join(", ", segmenter)})";
    }

    private string OmsetningLinjePunkter()
    {
        if (_omsetningKurve.Count == 0)
        {
            return "";
        }

        var maks = Math.Max(1, _omsetningKurve.Max(k => k.Kumulativ));
        var punkter = new List<string>();
        for (var i = 0; i < _omsetningKurve.Count; i++)
        {
            var x = _omsetningKurve.Count == 1 ? 0 : (double)i / (_omsetningKurve.Count - 1) * 100;
            var y = 100 - (double)(_omsetningKurve[i].Kumulativ / maks) * 90;
            punkter.Add($"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}");
        }

        return string.Join(" ", punkter);
    }

    private string OmsetningOmradePunkter() => $"{OmsetningLinjePunkter()} 100,100 0,100";

    private static string Kr(decimal sum) => $"{sum.ToString("N0", Kultur)} kr";

    private static string TilbudStatusFarge(EndringsmeldingStatus status) => status switch
    {
        EndringsmeldingStatus.Godkjent => "gronn",
        EndringsmeldingStatus.Avslatt => "rod",
        EndringsmeldingStatus.SendtTilKunde => "gul",
        _ => "noytral"
    };

    private static string TilbudStatusIkon(EndringsmeldingStatus status) => status switch
    {
        EndringsmeldingStatus.Godkjent => "check",
        EndringsmeldingStatus.Avslatt => "x",
        EndringsmeldingStatus.SendtTilKunde => "receipt",
        _ => "file-text"
    };
