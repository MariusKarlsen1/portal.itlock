@page "/tilbud-service/godkjent"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Godkjente tilbud service</PageTitle>

<a class="back-link" href="/tilbud-service">&larr; Tilbake til tilbud service</a>

<div class="side-header">
    <span class="side-header-ikon side-header-ikon-gronn"><Icon Name="check-circle" /></span>
    <div>
        <h1>Godkjente tilbud</h1>
        <p class="section-hint">Godkjente tilbud der arbeidsordren er ferdigmeldt - jobben er fullført. Godkjente tilbud der arbeidet fortsatt pågår ligger på den vanlige tavlen.</p>
    </div>
</div>

<input class="sok-felt" @bind="_sok" @bind:event="oninput" placeholder="Søk på navn eller kunde..." />

@if (_tilbud.Count == 0)
{
    <p class="list-empty">Ingen godkjente tilbud med ferdigmeldt arbeidsordre ennå.</p>
}
else if (_synlige.Count == 0)
{
    <p class="list-empty">Ingen treff.</p>
}
else
{
    <div class="avtale-liste">
        @foreach (var t in _synlige)
        {
            <div class="avtale-rad" @key="t.TilbudId">
                <a class="avtale-lenke" href="@($"/tilbud/{t.TilbudId}")"></a>
                <span class="avtale-ikon"><Icon Name="check-circle" /></span>
                <div class="avtale-info">
                    <div class="avtale-navn">@t.Tittel</div>
                    <div class="avtale-meta">
                        @if (string.IsNullOrWhiteSpace(t.KundeNavn))
                        {
                            <span class="ingen-kunde">Ingen kunde satt</span>
                        }
                        else
                        {
                            @t.KundeNavn
                        }
                        &middot; Opprettet @t.OpprettetDato.ToString("dd.MM.yyyy")
                    </div>
                </div>
                @if (t.SendtSum is { } sum)
                {
                    <span class="avtale-sum">@sum.ToString("N0", Kultur) kr</span>
                }
                <span class="apne-pil"><Icon Name="arrow-left" /></span>
            </div>
        }
    </div>
}

@code {
    private sealed class TilbudRad
    {
        public int TilbudId { get; set; }
        public string Tittel { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime OpprettetDato { get; set; }
        public decimal? SendtSum { get; set; }
    }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private List<TilbudRad> _tilbud = [];
    private string _sok = "";

    private List<TilbudRad> _synlige => string.IsNullOrWhiteSpace(_sok)
        ? _tilbud
        : _tilbud.Where(t => t.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (t.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    protected override async Task OnInitializedAsync()
    {
        _tilbud = await Db.Tilbud
            .Where(t => t.Prosjekt!.Status == ProsjektStatus.Serviceavtale
                && t.Status == EndringsmeldingStatus.Godkjent
                && Db.Arbeidsordre.Any(a => a.TilbudId == t.Id
                    && (a.Status == ArbeidsordreStatus.Ferdig || a.Status == ArbeidsordreStatus.Fakturert)))
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .OrderByDescending(t => t.OppdatertDato ?? t.OpprettetDato)
            .Select(t => new TilbudRad
            {
                TilbudId = t.Id,
                Tittel = t.Tittel,
                KundeNavn = t.Prosjekt!.Kunde != null ? t.Prosjekt.Kunde.Navn : null,
                OpprettetDato = t.OpprettetDato,
                SendtSum = t.SendtSum
            })
            .ToListAsync();
    }
}
