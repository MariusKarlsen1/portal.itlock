@page "/prosjekteringmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]

<PageTitle>Prosjektering - itlock</PageTitle>

<h1>Prosjektering</h1>
<p class="section-hint">Prosjekter, arbeidsordre, dørpakker, prisoverslag, serviceavtaler og systemregister.</p>

<div class="modul-grid">
    <a href="/prosjekter" class="modul-card">
        <Icon Name="folder" />
        <span class="modul-card-title">Prosjekter</span>
        <span class="modul-card-desc">Dører, plantegninger og montasjestatus per prosjekt.</span>
    </a>
    <a href="/arbeidsordre" class="modul-card">
        <Icon Name="check-circle" />
        <span class="modul-card-title">Arbeidsordre</span>
        <span class="modul-card-desc">Opprett arbeidsordre med info om jobben og ansvarlig montør.</span>
    </a>
    <a href="/finn-dorpakke" class="modul-card">
        <Icon Name="box" />
        <span class="modul-card-title">Finn dørpakke</span>
        <span class="modul-card-desc">Huk av krav og finn riktig dørpakke til prosjektet.</span>
    </a>
    <a href="/prisoverslag" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Prisoverslag</span>
        <span class="modul-card-desc">Rask kalkulator med komponenter, timer og påslag.</span>
    </a>
    <a href="/serviceavtaler" class="modul-card">
        <Icon Name="clock" />
        <span class="modul-card-title">Serviceavtaler</span>
        <span class="modul-card-desc">Prosjekter på serviceavtale, med servicehistorikk og rapporter.</span>
    </a>
    <a href="/systemregister" class="modul-card">
        <Icon Name="users" />
        <span class="modul-card-title">Systemregister</span>
        <span class="modul-card-desc">Søk opp låssystem, kunde, adresse og rekvirenter.</span>
    </a>
</div>
