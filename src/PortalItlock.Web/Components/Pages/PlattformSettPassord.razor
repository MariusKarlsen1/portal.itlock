@page "/plattform/sett-passord"
@layout PortalItlock.Web.Components.Layout.TomLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Plattform - sett passord</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="pi-root">
    <div class="pi-kort">
        <div class="pi-venstre">
            <div>
                <div class="pi-merke">
                    <svg class="pi-merke-svg" viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor" />
                        <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor" />
                        <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor" />
                    </svg>
                    <span class="pi-merke-tekst">
                        <strong>Full Kontroll</strong>
                    </span>
                </div>
                <div class="pi-strek"></div>
                <h1>Sett passord</h1>
                <p>Skriv inn plattform-e-posten din, så sender vi deg en lenke for å sette passord - første gang, eller etter at den er nullstilt.</p>
            </div>
            <div>
                <div class="pi-strek"></div>
                <span class="pi-copyright">Opphavsrett © Full Kontroll @DateTime.Now.Year</span>
            </div>
        </div>

        <div class="pi-hoyre">
            @if (Sendt == "1")
            {
                <p class="pi-suksess">Hvis e-posten finnes hos oss, har vi sendt deg en lenke for å sette passord. Sjekk innboksen din.</p>
            }
            else
            {
                @if (ForMange == "1")
                {
                    <p class="pi-feil">For mange forsøk. Vent noen minutter og prøv igjen.</p>
                }

                <form method="post" action="/plattform/konto/glemt-passord" class="pi-form">
                    <input type="hidden" name="redirectTil" value="sett-passord" />
                    <label class="pi-felt">
                        E-postadresse
                        <span class="pi-input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                            <input type="email" name="epost" required autofocus placeholder="din@epost.no" />
                        </span>
                    </label>
                    <button type="submit" class="pi-knapp">Send lenke →</button>
                </form>
            }

            <a class="pi-for-kunden" href="/plattform/logg-inn">Tilbake til innlogging</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sendt")]
    public string? Sendt { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }
}
