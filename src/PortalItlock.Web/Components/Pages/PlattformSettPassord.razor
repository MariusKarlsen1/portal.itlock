@page "/plattform/sett-passord"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Plattform - sett passord</PageTitle>

<div class="login-card">
    <h1>Sett passord</h1>
    <p class="sett-passord-hint">Skriv inn plattform-e-posten din for å sette passord første gang.</p>

    @if (Feil is not null)
    {
        <p class="login-error">@Feil</p>
    }

    <form method="post" action="/plattform/konto/sett-passord">
        <label>
            E-post
            <input type="email" name="epost" required autofocus />
        </label>
        <label>
            Nytt passord (minst 8 tegn)
            <input type="password" name="passord" required minlength="8" />
        </label>
        <label>
            Bekreft passord
            <input type="password" name="bekreft" required minlength="8" />
        </label>
        <button type="submit">Sett passord</button>
    </form>

    <a class="sett-passord-tilbake" href="/plattform/logg-inn">Tilbake til innlogging</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "feil")]
    public string? FeilKode { get; set; }

    private string? Feil => FeilKode switch
    {
        "ikke-tilgjengelig" => "Denne e-posten kan ikke sette passord akkurat nå. Sjekk at du har skrevet riktig e-post, eller bruk \"Glemt passord\".",
        "ugyldig" => "Passordet må være minst 8 tegn, og de to feltene må være like.",
        _ => null
    };
}
