@page "/foresporsel/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_f?.Emne ?? "Forespørsel")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke forespørselen. Den kan være slettet.</p>
}
else if (_f is null)
{
    <p>Laster...</p>
}
else
{
    <a class="back-link" href="/foresporsler"><Icon Name="arrow-left" />Tilbake til forespørsler</a>

    <div class="detalj-header">
        <div>
            <h1>@_f.Emne</h1>
            <div class="detalj-meta-rad">
                <span>Fra <strong>@(string.IsNullOrWhiteSpace(_f.FraNavn) ? _f.FraEpost : $"{_f.FraNavn} <{_f.FraEpost}>")</strong></span>
                <span class="detalj-meta-punkt"></span>
                <span>Mottatt @_f.MottattDato.ToString("dd.MM.yyyy HH:mm")</span>
                <span class="detalj-meta-punkt"></span>
                <span class="status-pill @(_f.Lest ? "lest" : "ulest")">
                    @if (_f.Lest)
                    {
                        <Icon Name="check-circle" />
                    }
                    @(_f.Lest ? "Lest" : "Ulest")
                </span>
            </div>
        </div>
    </div>

    <div class="detalj-panel">
        <h2>Innhold</h2>
        @if (string.IsNullOrWhiteSpace(_f.Innhold))
        {
            <p class="list-empty">Ingen tekst i e-posten.</p>
        }
        else
        {
            <p class="foresporsel-tekst-visning">@_f.Innhold</p>
        }
    </div>

    @if (_f.Media.Count > 0)
    {
        <div class="detalj-panel">
            <h2>Vedlegg</h2>
            <ul class="vedlegg-liste">
                @foreach (var m in _f.Media)
                {
                    <li>
                        <a class="vedlegg-chip" href="@($"/foresporselmedia/{m.Id}/fil")" target="_blank">
                            <span class="vedlegg-chip-ikon"><Icon Name="file-text" /></span>
                            <span class="vedlegg-chip-navn">@m.Filnavn</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="detalj-panel">
        <h2>Ticket</h2>
        @if (_knyttetTicketId is int tid)
        {
            <a class="ticket-lenke" href="@($"/ticket/{tid}")">
                <span class="ticket-lenke-ikon"><Icon Name="tag" /></span>
                <span class="ticket-lenke-tekst">
                    <span class="ticket-lenke-tittel">Åpne ticket #@tid</span>
                    <span class="ticket-lenke-sub">Opprettet fra denne forespørselen</span>
                </span>
            </a>
        }
        else
        {
            <p class="ticket-tom-tekst">Ingen ticket opprettet fra denne forespørselen ennå.</p>
            <button type="button" class="knapp knapp-primaer" @onclick="OpprettTicket"><Icon Name="plus" />Opprett ticket</button>
        }
    </div>

    <div class="detalj-panel">
        <h2>Rådata</h2>
        <button type="button" class="raadata-toggle" @onclick="@(() => _visRaadata = !_visRaadata)">
            <Icon Name="chevron-down" />
            @(_visRaadata ? "Skjul rådata" : "Vis rådata")
        </button>
        @if (_visRaadata)
        {
            <pre class="raadata-boks">@_f.RawJson</pre>
        }
    </div>

    <div class="handling-rad">
        <a class="knapp" href="@($"mailto:{_f.FraEpost}?subject={Uri.EscapeDataString("Re: " + _f.Emne)}")"><Icon Name="mail" />Svar i e-post</a>
        <button type="button" class="knapp" @onclick="ToggleLest"><Icon Name="check-circle" />@(_f.Lest ? "Merk som ulest" : "Merk som lest")</button>
        <button type="button" class="knapp knapp-slett" @onclick="SlettForesporsel"><Icon Name="trash" />Slett</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Foresporsel? _f;
    private bool _notFound;
    private bool _visRaadata;
    private int? _knyttetTicketId;

    protected override async Task OnParametersSetAsync()
    {
        _f = await Db.Foresporsler
            .Include(f => f.Media)
            .FirstOrDefaultAsync(f => f.Id == Id);

        if (_f is null)
        {
            _notFound = true;
            return;
        }

        if (!_f.Lest)
        {
            _f.Lest = true;
            await Db.SaveChangesAsync();
        }

        _knyttetTicketId = await Db.Tickets
            .Where(t => t.ForesporselId == Id)
            .Select(t => (int?)t.Id)
            .FirstOrDefaultAsync();
    }

    private async Task ToggleLest()
    {
        _f!.Lest = !_f.Lest;
        await Db.SaveChangesAsync();
    }

    private async Task OpprettTicket()
    {
        if (_knyttetTicketId is int eksisterende)
        {
            Nav.NavigateTo($"/ticket/{eksisterende}");
            return;
        }

        var kunde = await Db.Kunder.FirstOrDefaultAsync(k => k.Epost == _f!.FraEpost);

        var ticket = new Ticket
        {
            Tittel = _f!.Emne,
            KundeId = kunde?.Id,
            ForesporselId = _f.Id
        };
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/ticket/{ticket.Id}");
    }

    private async Task SlettForesporsel()
    {
        Db.Foresporsler.Remove(_f!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/foresporsler");
    }
}
