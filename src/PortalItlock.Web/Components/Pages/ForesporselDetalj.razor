@page "/foresporsel/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@inject NavigationManager Nav

@code {
    [Parameter] public int Id { get; set; }

    protected override void OnInitialized()
    {
        Nav.NavigateTo($"/foresporsler?id={Id}", forceLoad: false, replace: true);
    }
}
