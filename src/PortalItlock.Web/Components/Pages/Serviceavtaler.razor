@page "/serviceavtaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Serviceavtaler</PageTitle>

<div class="avtale-toppknapp-rad">
    <button type="button" class="@(_visNyPanel ? "edit-button-active" : "add-knapp")" @onclick="@(() => _visNyPanel = !_visNyPanel)">
        <Icon Name="plus" />Ny serviceavtale
    </button>
</div>

@if (_visNyPanel)
{
    <div class="ny-avtale">
        <div class="ny-avtale-header">
            <strong>Ny serviceavtale</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visNyPanel = false)">Lukk</button>
        </div>
        <div class="field-grid">
            <label>
                Navn på avtalen/bygget
                <input @bind="_nyttNavn" @bind:event="oninput" placeholder="F.eks. Storgata 5 - service" />
            </label>
            <label>
                Kunde (valgfritt)
                <select @bind="_valgtKundeId">
                    <option value="">Ingen kunde satt</option>
                    @foreach (var k in _kunder)
                    {
                        <option value="@k.Id">@k.Navn</option>
                    }
                </select>
            </label>
            <label>
                Adresse (valgfritt)
                <input @bind="_nyAdresse" @bind:event="oninput" placeholder="F.eks. Storgata 5" />
            </label>
        </div>
        <div class="form-actions">
            <button type="button" class="add-button" @onclick="OpprettServiceavtale" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Opprett serviceavtale</button>
        </div>
    </div>
}

@if (_avtaler.Count > 0)
{
    @* K1 (service-kart-topp.html): kartet øverst, fire klikkbare statustall som
       filtrerer både kartet og lista, og én liste med det som haster øverst.
       Klikk en rad for å folde ut historikk, siste runde, avvik og kunde. *@
    var runderTotalt = _avtaler.Sum(a => a.RunderIAr.Count);

    @if (_avtaler.Any(a => a.Lat.HasValue && a.Lng.HasValue))
    {
        <div class="sv9-kart-wrap">
            <div id="sv9-kart" class="sv9-kart"></div>
            <div class="sv9-kart-leg">
                <span><i style="background:#b23b22"></i>Forfalt</span>
                <span><i style="background:#d9a520"></i>Nærmer seg</span>
                <span><i style="background:#2e7d4f"></i>I rute</span>
                <span><i style="background:#9c958a"></i>Mangler dato</span>
            </div>
        </div>
    }

    <div class="svk-tall">
        @if (_avtaler.Any(a => a.Avvik.Count > 0))
        {
            <button type="button" class="svk-chip @(_hurtigfilter == "avvik" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("avvik"))'>
                <Icon Name="alert" />
                <b>@_avtaler.Count(a => a.Avvik.Count > 0)</b>
                <span>Med avvik<small>åpne avvik</small></span>
            </button>
        }
        <div class="svk-sum">
            @_avtaler.Count avtaler · @_avtaler.Sum(a => a.Dorer) dører
            <small>@_avtaler.Sum(a => a.RunderIAr.Count(r => r == "u")) av @runderTotalt runder utført i @Ar</small>
        </div>
    </div>

    <div class="toolbar">
        <label class="sok-felt">
            <Icon Name="search" />
            <input @bind="_search" @bind:event="oninput" placeholder="Søk i avtaler, kunder eller adresser..." />
        </label>
        @if (Montorer.Count > 0)
        {
            <label class="dd">
                Montør:
                <select @bind="_montorFilter">
                    <option value="">Alle</option>
                    @foreach (var m in Montorer)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </label>
        }
        <label class="dd">
            Sorter:
            <select @bind="_sortering">
                <option value="haster">Det som haster</option>
                <option value="neste-service">Neste service</option>
                <option value="navn">Navn</option>
                <option value="kunde">Kunde</option>
                <option value="montor">Montør</option>
                <option value="dorer">Dører</option>
                <option value="avvik">Avvik</option>
            </select>
        </label>
    </div>
}

@if (_filtrert.Count == 0)
{
    <p class="list-empty">@(_avtaler.Count == 0 ? "Ingen serviceavtaler funnet." : "Ingen treff.")</p>
}
else
{
    @* SV6 (service-forslag): alle avtalene i én tabell. Trykk en kolonne for å
       sortere, klikk velger raden og dobbeltklikk (eller Enter) åpner avtalen.
       Ingenting folder seg ut under raden lenger. *@
    <div class="sv6-wrap">
        <div class="sv6-tabell" role="table">
            <div class="sv6-rad sv6-hode" role="row">
                @foreach (var (navn, nokkel) in Kolonner)
                {
                    if (nokkel is null)
                    {
                        <span class="sv6-th" role="columnheader">@navn</span>
                    }
                    else
                    {
                        <button type="button" class="sv6-th @(_sortering == nokkel ? "aktiv" : "")" role="columnheader" @onclick="@(() => SorterEtter(nokkel))">
                            @navn
                            @if (_sortering == nokkel)
                            {
                                <span class="sv6-pil">@(_synkende ? "▼" : "▲")</span>
                            }
                        </button>
                    }
                }
            </div>
            @foreach (var a in SideRader)
            {
                <div class="sv6-rad @(_valgtId == a.ProsjektId ? "valgt" : "")" role="row" tabindex="0" @key="a.ProsjektId"
                     title="Åpne avtalen"
                     @onclick="@(() => AapneAvtale(a.ProsjektId))"
                     @onkeydown="@(e => { if (e.Key == "Enter") { AapneAvtale(a.ProsjektId); } })">
                    <span><span class="sv-pill sv-p-@a.Gruppe">@GruppeTekst(a.Gruppe)</span></span>
                    <span class="sv6-navn">
                        <b>@a.ProsjektNavn</b>
                    </span>
                    <span class="sv6-kunde">@(a.KundeNavn ?? "Ingen kunde satt")@if (!string.IsNullOrWhiteSpace(a.StedTekst)) {<small> · @a.StedTekst</small>}</span>
                    <span class="sv6-montor">
                        @if (a.Montor is not null)
                        {
                            <span class="sv-av" style="background:@Farge(a.Montor)">@Initialer(a.Montor)</span>@a.Montor
                        }
                        else
                        {
                            <span class="sv-mangler">Ingen montør</span>
                        }
                    </span>
                    <span class="sv6-tall">@a.Dorer</span>
                    <span class="sv6-runder">
                        <span class="sv-strek">
                            @foreach (var r in a.RunderIAr)
                            {
                                <i class="sv-r-@r" title="@RundeTittel(r)"></i>
                            }
                        </span>
                        <small>@(a.RunderIAr.Count == 0 ? "ingen i år" : $"{a.RunderIAr.Count(r => r == "u")} av {a.RunderIAr.Count}")</small>
                    </span>
                    <span class="sv6-neste">
                        <b class="sv-t-@a.Gruppe">@(a.NesteServiceDato?.ToString("dd.MM.yyyy") ?? "Ikke satt")</b>
                        <small>@(a.NesteServiceDato.HasValue ? Naar(a.NesteServiceDato) : a.Montor is null ? "mangler dato og montør" : "mangler dato")</small>
                    </span>
                    <span class="sv6-avvik">
                        @if (a.Avvik.Count > 0)
                        {
                            <span class="sv-t-forfalt"><Icon Name="alert" />@a.Avvik.Count</span>
                        }
                        else
                        {
                            <text>–</text>
                        }
                    </span>
                    <span class="sv6-meny">
                        <RadMeny Navn="@a.ProsjektNavn" RedigerHref="@($"/serviceavtaler/{a.ProsjektId}?rediger=1")"
                                 OnSlett="@(() => { _slettId = a.ProsjektId; _slettNavn = a.ProsjektNavn; })" />
                    </span>
                </div>
            }
        </div>
    </div>
    var antallFiltrert = _filtrert.Count;
    var side = GyldigSide(antallFiltrert);
    var antallSider = Math.Max(1, (antallFiltrert + _perSide - 1) / _perSide);
    <div class="sv-sider">
        <span class="sv-fot">Viser @(antallFiltrert == 0 ? 0 : (side - 1) * _perSide + 1)–@Math.Min(side * _perSide, antallFiltrert) av @antallFiltrert serviceavtaler · klikk en rad for å åpne avtalen · trykk en kolonne for å sortere</span>
        <span class="sv-sider-hoyre">
            <label class="sv-per-side">Per side
                <select @bind="_perSide" @bind:after="@(() => _side = 1)">
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                </select>
            </label>
            @if (antallSider > 1)
            {
                <button type="button" class="sv-side-kn" disabled="@(side <= 1)" @onclick="@(() => _side = side - 1)" aria-label="Forrige side"><Icon Name="chevron-left" /></button>
                <span class="sv-side-tall">Side @side av @antallSider</span>
                <button type="button" class="sv-side-kn" disabled="@(side >= antallSider)" @onclick="@(() => _side = side + 1)" aria-label="Neste side"><Icon Name="chevron-right" /></button>
            }
        </span>
    </div>
}


<SlettDialog Type="SletteType.Serviceavtale" Id="_slettId" Navn="@_slettNavn" OnLukk="@(() => _slettId = null)" OnSlettet="AvtaleSlettet" />

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static int Ar => DateTime.Today.Year;

    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed record AvvikInfo(string Dornummer, string Beskrivelse, string StatusTekst);
    private sealed record RundeInfo(int Id, DateTime Dato, string? UtfortAv, int Deler);
    private sealed record TidsPunkt(string Type, string Tittel, string Under);

    private sealed class AvtaleRad
    {
        public int ProsjektId { get; set; }
        public string ProsjektNavn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public string? Adresse { get; set; }
        public string? Sted { get; set; }
        public string? StedTekst => !string.IsNullOrWhiteSpace(Sted) ? Sted : Adresse;
        public string? Kontakt { get; set; }
        public string? Telefon { get; set; }
        public string? Montor { get; set; }
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public int Dorer { get; set; }
        public int MinutterPerBesok { get; set; }
        public int? IntervallMnd { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public RundeInfo? SisteRunde { get; set; }
        public List<RundeInfo> Utforte { get; set; } = [];
        public List<AvvikInfo> Avvik { get; set; } = [];
        // Årets runder i rekkefølge: "u" utført, "p" planlagt/gjenstår, "f" forfalt.
        public List<string> RunderIAr { get; set; } = [];

        public bool ErForfalt => NesteServiceDato.HasValue && NesteServiceDato.Value.Date < DateTime.Today;
        public bool ErSnartForfalt => NesteServiceDato.HasValue && !ErForfalt && NesteServiceDato.Value.Date <= DateTime.Today.AddDays(14);

        // "Aktiv" = har en registrert neste-service-dato som verken er forfalt
        // eller nærmer seg forfall ennå (mer enn 14 dager frem i tid).
        public bool ErAktiv => NesteServiceDato.HasValue && !ErForfalt && !ErSnartForfalt;

        public string Gruppe => ErForfalt ? "forfalt" : ErSnartForfalt ? "snart" : !NesteServiceDato.HasValue ? "utendato" : "aktiv";
    }

    private List<AvtaleRad> _avtaler = [];
    private List<KundeOption> _kunder = [];
    private string _nyttNavn = "";
    private int? _valgtKundeId;
    private string? _nyAdresse;
    private string _search = "";
    private string _hurtigfilter = "alle";
    private string _sortering = "haster";
    private string _montorFilter = "";
    private bool _visNyPanel;
    private bool _synkende;
    private int? _valgtId;

    // Sider i lista: 10, 15 eller 20 per side.
    private int _perSide = 15;
    private int _side = 1;

    private int GyldigSide(int antall) => Math.Clamp(_side, 1, Math.Max(1, (antall + _perSide - 1) / _perSide));

    private List<AvtaleRad> SideRader
    {
        get
        {
            var liste = _filtrert;
            return liste.Skip((GyldigSide(liste.Count) - 1) * _perSide).Take(_perSide).ToList();
        }
    }

    // Kolonnene i SV6-tabellen. Nøkkel null = kan ikke sorteres.
    private (string Navn, string? Nokkel)[] Kolonner =>
    [
        ("Status", "haster"),
        ("Avtale", "navn"),
        ("Kunde", "kunde"),
        ("Montør", "montor"),
        ("Dører", "dorer"),
        ($"Runder {Ar}", null),
        ("Neste service", "neste-service"),
        ("Avvik", "avvik"),
        ("", null)
    ];

    // Samme kolonne igjen snur rekkefølgen.
    private void SorterEtter(string nokkel)
    {
        if (_sortering == nokkel)
        {
            _synkende = !_synkende;
        }
        else
        {
            _sortering = nokkel;
            _synkende = false;
        }
    }

    private void AapneAvtale(int id) => Nav.NavigateTo($"/serviceavtaler/{id}");

    private static string GruppeTekst(string gruppe) => gruppe switch
    {
        "forfalt" => "Forfalt",
        "snart" => "Nærmer seg",
        "utendato" => "Mangler dato",
        _ => "I rute"
    };

    private static readonly string[] Paletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#b5502d", "#3a6fb5"];

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<string> Montorer => _avtaler.Where(a => a.Montor is not null).Select(a => a.Montor!).Distinct().OrderBy(m => m).ToList();

    private List<AvtaleRad> _filtrert
    {
        get
        {
            var liste = _avtaler
                .Where(a => _hurtigfilter switch
                {
                    "aktiv" => a.ErAktiv,
                    "forfalt" => a.ErForfalt,
                    "snart" => a.ErSnartForfalt,
                    "utendato" => !a.NesteServiceDato.HasValue,
                    "avvik" => a.Avvik.Count > 0,
                    _ => true
                })
                .Where(a => string.IsNullOrEmpty(_montorFilter) || a.Montor == _montorFilter)
                .Where(a => string.IsNullOrWhiteSpace(_search)
                    || a.ProsjektNavn.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (a.KundeNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (a.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (a.Sted?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            var sortert = _sortering switch
            {
                "navn" => liste.OrderBy(a => a.ProsjektNavn).ToList(),
                "kunde" => liste.OrderBy(a => a.KundeNavn ?? "").ToList(),
                "montor" => liste.OrderBy(a => a.Montor is null).ThenBy(a => a.Montor).ToList(),
                "dorer" => liste.OrderBy(a => a.Dorer).ToList(),
                "avvik" => liste.OrderByDescending(a => a.Avvik.Count).ThenBy(Hastegrad).ToList(),
                "neste-service" => liste.OrderBy(a => a.NesteServiceDato ?? DateTime.MaxValue).ToList(),
                _ => liste.OrderBy(Hastegrad).ThenBy(a => a.NesteServiceDato ?? DateTime.MaxValue).ThenBy(a => a.ProsjektNavn).ToList()
            };

            if (_synkende)
            {
                sortert.Reverse();
            }

            return sortert;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.Kunde)
            .Include(p => p.AnsvarligMontor)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        var ider = prosjekter.Select(p => p.Id).ToList();

        var runder = await Db.Servicerunder
            .Where(s => ider.Contains(s.ProsjektId))
            .Select(s => new { s.Id, s.ProsjektId, s.Dato, s.NesteServiceDato, s.ErPlanlagt, UtfortAv = s.UtfortAvBruker != null ? s.UtfortAvBruker.Navn : null, Deler = s.Deler.Count })
            .ToListAsync();

        var dorer = await Db.Dorer
            .Where(d => ider.Contains(d.ProsjektId))
            .GroupBy(d => d.ProsjektId)
            .Select(g => new { ProsjektId = g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.ProsjektId, x => x.Antall);

        var minutter = (await Db.ServiceMinuttLinjer
            .Where(l => ider.Contains(l.ProsjektId))
            .Select(l => new { l.ProsjektId, l.Minutter, l.Antall })
            .ToListAsync())
            .GroupBy(l => l.ProsjektId)
            .ToDictionary(g => g.Key, g => g.Sum(l => (l.Minutter ?? 0) * l.Antall));

        var avvik = await Db.Avvik
            .Where(a => a.Status != AvvikStatus.Godkjent && a.Dor != null && ider.Contains(a.Dor.ProsjektId))
            .OrderByDescending(a => a.OpprettetDato)
            .Select(a => new { a.Dor!.ProsjektId, a.Dor.Dornummer, a.Beskrivelse, a.Status })
            .ToListAsync();

        _avtaler = prosjekter.Select(p =>
        {
            var proRunder = runder.Where(r => r.ProsjektId == p.Id).OrderByDescending(r => r.Dato).ToList();
            var utforte = proRunder.Where(r => !r.ErPlanlagt).ToList();
            var siste = utforte.FirstOrDefault();
            var neste = proRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

            // Intervallet leses fra siste runde: tiden mellom runden og
            // neste planlagte service, rundet til hele måneder.
            int? intervall = null;
            var medNeste = utforte.FirstOrDefault(r => r.NesteServiceDato.HasValue);
            if (medNeste is not null)
            {
                var mnd = (int)Math.Round((medNeste.NesteServiceDato!.Value - medNeste.Dato).TotalDays / 30.4);
                intervall = mnd is > 0 and <= 36 ? mnd : null;
            }

            var rad = new AvtaleRad
            {
                ProsjektId = p.Id,
                ProsjektNavn = p.Navn,
                KundeNavn = p.Kunde?.Navn,
                Adresse = p.Adresse,
                Sted = p.Sted,
                Kontakt = !string.IsNullOrWhiteSpace(p.Kontaktperson) ? p.Kontaktperson : p.Kunde?.Kontaktperson,
                Telefon = !string.IsNullOrWhiteSpace(p.Telefon) ? p.Telefon : p.Kunde?.Telefon,
                Montor = p.AnsvarligMontor?.Navn ?? siste?.UtfortAv,
                Lat = p.Latitude,
                Lng = p.Longitude,
                Dorer = dorer.GetValueOrDefault(p.Id),
                MinutterPerBesok = minutter.GetValueOrDefault(p.Id),
                // Avtalens egen frekvens (satt på avtalen) går foran det som leses av rundene.
                IntervallMnd = p.ServiceGangerPerAr is > 0 and <= 12 ? 12 / p.ServiceGangerPerAr.Value : intervall,
                NesteServiceDato = neste,
                SisteRunde = siste is null ? null : new RundeInfo(siste.Id, siste.Dato, siste.UtfortAv, siste.Deler),
                Utforte = utforte.Select(r => new RundeInfo(r.Id, r.Dato, r.UtfortAv, r.Deler)).ToList(),
                Avvik = avvik.Where(a => a.ProsjektId == p.Id)
                    .Select(a => new AvvikInfo(a.Dornummer, a.Beskrivelse, a.Status == AvvikStatus.SendtTilKunde ? "sendt kunde" : "åpent"))
                    .ToList()
            };

            // Årets runder: utførte, planlagte runder fram i tid, og neste
            // service dersom den faller i år og ikke allerede er planlagt.
            var aretsRunder = new List<(DateTime Dato, string Type)>();
            aretsRunder.AddRange(utforte.Where(r => r.Dato.Year == Ar).Select(r => (r.Dato, "u")));
            aretsRunder.AddRange(proRunder.Where(r => r.ErPlanlagt && r.Dato.Year == Ar).Select(r => (r.Dato, r.Dato.Date < DateTime.Today ? "f" : "p")));
            if (neste is { } n && n.Year == Ar && !proRunder.Any(r => r.ErPlanlagt && Math.Abs((r.Dato - n).TotalDays) < 20))
            {
                aretsRunder.Add((n, rad.ErForfalt ? "f" : "p"));
            }
            rad.RunderIAr = aretsRunder.OrderBy(x => x.Dato).Select(x => x.Type).ToList();

            // Har avtalen et fast antall runder i året, vises de som gjenstår
            // også, så "1 av 2" stemmer med avtalen selv om neste ikke er planlagt.
            if (p.ServiceGangerPerAr is > 0 and <= 12 && rad.RunderIAr.Count < p.ServiceGangerPerAr.Value)
            {
                rad.RunderIAr.AddRange(Enumerable.Repeat("p", p.ServiceGangerPerAr.Value - rad.RunderIAr.Count));
            }
            return rad;
        }).ToList();
        _lastet = true;
    }

    // ---------- K1: statustall og kart ----------
    private bool _lastet;
    private string? _kartNokkel;

    private static string StatusFarge(AvtaleRad a) => a.Gruppe switch
    {
        "forfalt" => "#b23b22",
        "snart" => "#d9a520",
        "utendato" => "#9c958a",
        _ => "#2e7d4f"
    };

    private static int Hastegrad(AvtaleRad a) => a.Gruppe switch
    {
        "forfalt" => 0,
        "snart" => 1,
        "utendato" => 2,
        _ => 3
    };

    // Kartet viser de samme avtalene som lista (statustall, søk og montør), og
    // tegnes på nytt bare når utvalget faktisk endres.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_lastet || !_avtaler.Any(a => a.Lat.HasValue && a.Lng.HasValue))
        {
            return;
        }

        var synlige = _filtrert.Where(a => a.Lat.HasValue && a.Lng.HasValue).ToList();
        // Sortert, så kartet ikke tegnes på nytt bare fordi tabellen sorteres annerledes.
        var nokkel = string.Join(',', synlige.Select(a => a.ProsjektId).Order());
        if (nokkel == _kartNokkel)
        {
            return;
        }
        _kartNokkel = nokkel;

        var punkter = synlige
            .Select(a => new
            {
                lat = a.Lat!.Value,
                lng = a.Lng!.Value,
                farge = StatusFarge(a),
                nr = (int?)null,
                tittel = $"{a.ProsjektNavn} – {(a.NesteServiceDato.HasValue ? $"neste service {a.NesteServiceDato:dd.MM.yyyy}" : "ingen dato")}",
                href = $"/serviceavtaler/{a.ProsjektId}"
            })
            .ToList();

        try
        {
            await JS.InvokeVoidAsync("minikart.visAvtaler", "sv9-kart", punkter);
        }
        catch (JSDisconnectedException)
        {
        }
    }


    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    // Tidslinje i utfoldingen: inntil tre siste runder, neste service og deretter.
    private static List<TidsPunkt> Tidslinje(AvtaleRad a)
    {
        var punkter = a.Utforte.Take(3).Reverse()
            .Select(r => new TidsPunkt("u", r.Dato.ToString("MMM yyyy", Kultur), $"{r.UtfortAv ?? "–"}{(r.Deler > 0 ? $" · {r.Deler} deler" : "")}"))
            .ToList();

        if (a.NesteServiceDato is { } n)
        {
            punkter.Add(new TidsPunkt(a.ErForfalt ? "forfalt" : "neste", n.ToString("dd.MM.yyyy"), Naar(n)));
            if (a.IntervallMnd is { } mnd)
            {
                punkter.Add(new TidsPunkt("senere", n.AddMonths(mnd).ToString("MMM yyyy", Kultur), "deretter"));
            }
        }
        else
        {
            punkter.Add(new TidsPunkt("senere", "Ikke satt", "neste service"));
        }

        return punkter;
    }

    private static string Naar(DateTime? dato)
    {
        if (dato is not { } d)
        {
            return "ingen dato satt";
        }

        var dager = (d.Date - DateTime.Today).Days;
        return dager switch
        {
            0 => "i dag",
            1 => "i morgen",
            -1 => "1 dag over",
            var x when 0 > x => $"{-x} dager over",
            _ => $"om {dager} dager"
        };
    }

    private static string IntervallTekst(int mnd) => mnd switch
    {
        12 => "Årlig",
        6 => "Halvårlig",
        3 => "Kvartalsvis",
        1 => "Månedlig",
        _ => $"Hver {mnd}. mnd"
    };

    private static string Varighet(int minutter) => minutter >= 60
        ? (minutter % 60 == 0 ? $"{minutter / 60} t" : $"{minutter / 60} t {minutter % 60} min")
        : $"{minutter} min";

    private static string RundeTittel(string r) => r switch { "u" => "Utført", "f" => "Forfalt", _ => "Planlagt" };

    private static string Farge(string navn)
    {
        unchecked
        {
            var h = 17;
            foreach (var c in navn) { h = h * 31 + c; }
            return Paletten[(h & int.MaxValue) % Paletten.Length];
        }
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split([' ', '-', '–'], StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private async Task OpprettServiceavtale()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var prosjekt = new Prosjekt
        {
            Navn = navn,
            KundeId = _valgtKundeId,
            Adresse = string.IsNullOrWhiteSpace(_nyAdresse) ? null : _nyAdresse.Trim(),
            Status = ProsjektStatus.Serviceavtale
        };

        Db.Prosjekter.Add(prosjekt);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/serviceavtaler/{prosjekt.Id}");
    }

    // Sletting fra ⋯-menyen (bekreftes i SlettDialog). En serviceavtale er et prosjekt.
    private int? _slettId;
    private string? _slettNavn;

    private void AvtaleSlettet(int id) => _avtaler.RemoveAll(a => a.ProsjektId == id);
}
