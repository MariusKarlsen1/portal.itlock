@page "/serviceavtaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Serviceavtaler</PageTitle>

@if (_avtaler.Count > 0)
{
    <div class="nokkeltall">
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Totalt avtaler</span>
            <span class="nokkel-verdi">@_avtaler.Count</span>
            <span class="nokkel-under">aktive serviceavtaler</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Forfalt</span>
            <span class="nokkel-verdi rod">@_avtaler.Count(a => a.ErForfalt)</span>
            <span class="nokkel-under">krever oppfølging nå</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Nærmer seg forfall</span>
            <span class="nokkel-verdi gul">@_avtaler.Count(a => a.ErSnartForfalt)</span>
            <span class="nokkel-under">innen 14 dager</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Uten neste dato</span>
            <span class="nokkel-verdi">@_avtaler.Count(a => !a.NesteServiceDato.HasValue)</span>
            <span class="nokkel-under">mangler planlagt service</span>
        </div>
    </div>

    <div class="avtale-hurtigfilter">
        <button type="button" class="flis @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
            <span class="flis-tall">@_avtaler.Count</span>
            <span class="flis-etikett">Alle</span>
        </button>
        <button type="button" class="flis flis-rod @(_hurtigfilter == "forfalt" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("forfalt"))'>
            <span class="flis-tall flis-rod">@_avtaler.Count(a => a.ErForfalt)</span>
            <span class="flis-etikett">Forfalt</span>
        </button>
        <button type="button" class="flis flis-gul @(_hurtigfilter == "snart" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("snart"))'>
            <span class="flis-tall flis-gul">@_avtaler.Count(a => a.ErSnartForfalt)</span>
            <span class="flis-etikett">Nærmer seg forfall</span>
        </button>
        <button type="button" class="flis @(_hurtigfilter == "utendato" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("utendato"))'>
            <span class="flis-tall">@_avtaler.Count(a => !a.NesteServiceDato.HasValue)</span>
            <span class="flis-etikett">Uten neste dato</span>
        </button>
    </div>
}

<div class="avtale-toolbar">
    <label class="sok-felt">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på avtale eller kunde" />
    </label>
    <button type="button" class="@(_visNyPanel ? "edit-button-active" : "filter-button")" @onclick="@(() => _visNyPanel = !_visNyPanel)">
        <Icon Name="plus" />Ny serviceavtale
    </button>
</div>

@if (_visNyPanel)
{
    <div class="ny-avtale">
        <div class="ny-avtale-header">
            <strong>Ny serviceavtale</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visNyPanel = false)">Lukk</button>
        </div>
        <div class="field-grid">
            <label>
                Navn på avtalen/bygget
                <input @bind="_nyttNavn" @bind:event="oninput" placeholder="F.eks. Storgata 5 - service" />
            </label>
            <label>
                Kunde (valgfritt)
                <select @bind="_valgtKundeId">
                    <option value="">Ingen kunde satt</option>
                    @foreach (var k in _kunder)
                    {
                        <option value="@k.Id">@k.Navn</option>
                    }
                </select>
            </label>
            <label>
                Adresse (valgfritt)
                <input @bind="_nyAdresse" @bind:event="oninput" placeholder="F.eks. Storgata 5" />
            </label>
        </div>
        <div class="form-actions">
            <button type="button" class="add-button" @onclick="OpprettServiceavtale" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Opprett serviceavtale</button>
        </div>
    </div>
}

<p class="result-count">@_filtrert.Count av @_avtaler.Count avtaler</p>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen serviceavtaler funnet.</p>
}
else
{
    <div class="avtale-grid">
        @foreach (var a in _filtrert)
        {
            <a class="avtale-kort @(a.ErForfalt ? "avtale-kort-forfalt" : (a.ErSnartForfalt ? "avtale-kort-snart" : ""))" href="@($"serviceavtaler/{a.ProsjektId}")">
                <div class="avtale-topp">
                    <span class="avtale-navn">@a.ProsjektNavn</span>
                    @if (a.ErForfalt)
                    {
                        <span class="avtale-badge avtale-badge-forfalt">Service forfalt</span>
                    }
                    else if (a.ErSnartForfalt)
                    {
                        <span class="avtale-badge avtale-badge-snart">Nærmer seg forfall</span>
                    }
                    else if (a.NesteServiceDato.HasValue)
                    {
                        <span class="avtale-badge">Neste service @a.NesteServiceDato.Value.ToString("dd.MM.yyyy")</span>
                    }
                </div>
                <div class="avtale-kunde-rad">
                    @if (string.IsNullOrWhiteSpace(a.KundeNavn))
                    {
                        <span class="avatar" style="background:var(--itlock-ink-muted)">–</span>
                        <span class="avtale-kunde-tom">Ingen kunde satt</span>
                    }
                    else
                    {
                        <span class="avatar" style="background:@PersonFarge(a.KundeNavn)">@PersonInitialer(a.KundeNavn)</span>
                        <span>@a.KundeNavn</span>
                    }
                </div>
                <div class="avtale-service-rad">
                    @if (a.SisteServiceDato.HasValue)
                    {
                        <span>Sist service: @a.SisteServiceDato.Value.ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span>Ingen servicerunder registrert ennå</span>
                    }
                </div>
            </a>
        }
    </div>
}

@code {
    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class AvtaleRad
    {
        public int ProsjektId { get; set; }
        public string ProsjektNavn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime? SisteServiceDato { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public bool ErForfalt => NesteServiceDato.HasValue && NesteServiceDato.Value.Date < DateTime.Today;
        public bool ErSnartForfalt => NesteServiceDato.HasValue && !ErForfalt && NesteServiceDato.Value.Date <= DateTime.Today.AddDays(14);
    }

    private List<AvtaleRad> _avtaler = [];
    private List<KundeOption> _kunder = [];
    private string _nyttNavn = "";
    private int? _valgtKundeId;
    private string? _nyAdresse;
    private string _search = "";
    private string _hurtigfilter = "alle";
    private bool _visNyPanel;

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<AvtaleRad> _filtrert => _avtaler
        .Where(a => _hurtigfilter switch
        {
            "forfalt" => a.ErForfalt,
            "snart" => a.ErSnartForfalt,
            "utendato" => !a.NesteServiceDato.HasValue,
            _ => true
        })
        .Where(a => string.IsNullOrWhiteSpace(_search)
            || a.ProsjektNavn.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (a.KundeNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.Kunde)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        var prosjektIder = prosjekter.Select(p => p.Id).ToList();

        var runder = await Db.Servicerunder
            .Where(s => prosjektIder.Contains(s.ProsjektId))
            .ToListAsync();

        _avtaler = prosjekter.Select(p =>
        {
            var proRunder = runder.Where(r => r.ProsjektId == p.Id).OrderByDescending(r => r.Dato).ToList();
            return new AvtaleRad
            {
                ProsjektId = p.Id,
                ProsjektNavn = p.Navn,
                KundeNavn = p.Kunde?.Navn,
                SisteServiceDato = proRunder.FirstOrDefault()?.Dato,
                NesteServiceDato = proRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato
            };
        }).ToList();
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private async Task OpprettServiceavtale()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var prosjekt = new Prosjekt
        {
            Navn = navn,
            KundeId = _valgtKundeId,
            Adresse = string.IsNullOrWhiteSpace(_nyAdresse) ? null : _nyAdresse.Trim(),
            Status = ProsjektStatus.Serviceavtale
        };

        Db.Prosjekter.Add(prosjekt);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/serviceavtaler/{prosjekt.Id}");
    }
}
