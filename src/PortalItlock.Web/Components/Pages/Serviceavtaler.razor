@page "/serviceavtaler"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject GeocodingService Geokoding
@inject IJSRuntime JS

<PageTitle>Serviceavtaler</PageTitle>

<div class="avtale-toppknapp-rad">
    <button type="button" class="@(_visNyPanel ? "edit-button-active" : "add-knapp")" @onclick="@(() => _visNyPanel = !_visNyPanel)">
        <Icon Name="plus" />Ny serviceavtale
    </button>
</div>

@if (_visNyPanel)
{
    <div class="ny-avtale">
        <div class="ny-avtale-header">
            <strong>Ny serviceavtale</strong>
            <button type="button" class="cancel-button" @onclick="@(() => _visNyPanel = false)">Lukk</button>
        </div>
        <div class="field-grid">
            <label>
                Navn på avtalen/bygget
                <input @bind="_nyttNavn" @bind:event="oninput" placeholder="F.eks. Storgata 5 - service" />
            </label>
            <label>
                Kunde (valgfritt)
                <select @bind="_valgtKundeId">
                    <option value="">Ingen kunde satt</option>
                    @foreach (var k in _kunder)
                    {
                        <option value="@k.Id">@k.Navn</option>
                    }
                </select>
            </label>
            <label>
                Adresse (valgfritt)
                <input @bind="_nyAdresse" @bind:event="oninput" placeholder="F.eks. Storgata 5" />
            </label>
        </div>
        <div class="form-actions">
            <button type="button" class="add-button" @onclick="OpprettServiceavtale" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Opprett serviceavtale</button>
        </div>
    </div>
}

@if (_avtaler.Count > 0)
{
    <div class="pillrow">
        <button type="button" class="pill @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
            <span class="pill-dot"></span>Alle @_avtaler.Count
        </button>
        <button type="button" class="pill pill-gronn @(_hurtigfilter == "aktiv" ? "aktiv-gronn" : "")" @onclick='@(() => SettHurtigfilter("aktiv"))'>
            <span class="pill-dot"></span>Aktive @_avtaler.Count(a => a.ErAktiv)
        </button>
        <button type="button" class="pill pill-gul @(_hurtigfilter == "snart" ? "aktiv-gul" : "")" @onclick='@(() => SettHurtigfilter("snart"))'>
            <span class="pill-dot"></span>Nærmer seg @_avtaler.Count(a => a.ErSnartForfalt)
        </button>
        <button type="button" class="pill pill-rod @(_hurtigfilter == "forfalt" ? "aktiv-rod" : "")" @onclick='@(() => SettHurtigfilter("forfalt"))'>
            <span class="pill-dot"></span>Forfalt @_avtaler.Count(a => a.ErForfalt)
        </button>
        <button type="button" class="pill pill-noytral @(_hurtigfilter == "utendato" ? "aktiv-noytral" : "")" @onclick='@(() => SettHurtigfilter("utendato"))'>
            <span class="pill-dot"></span>Uten dato @_avtaler.Count(a => !a.NesteServiceDato.HasValue)
        </button>
    </div>

    <div class="toolbar">
        <label class="sok-felt">
            <Icon Name="search" />
            <input @bind="_search" @bind:event="oninput" @bind:after="GaTilSide1" placeholder="Søk på kunde, adresse eller avtale..." />
        </label>
        <label class="dd">
            Sorter:
            <select @bind="_sortering" @bind:after="GaTilSide1">
                <option value="neste-service">Neste service</option>
                <option value="navn">Navn</option>
                <option value="kunde">Kunde</option>
            </select>
        </label>
    </div>
}

@if (_filtrert.Count == 0)
{
    <p class="list-empty">@(_avtaler.Count == 0 ? "Ingen serviceavtaler funnet." : "Ingen treff.")</p>
}
else
{
    <div class="body2col">
        <div>
            <div class="tablewrap">
                <table>
                    <thead>
                        <tr><th></th><th>Navn / Kunde</th><th>Adresse</th><th>Neste service</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _sideRader)
                        {
                            var (statusTekst, statusKlasse) = StatusVisning(a);
                            <tr @key="a.ProsjektId" class="avtale-tr" @onclick="@(() => Nav.NavigateTo($"serviceavtaler/{a.ProsjektId}"))">
                                <td><span class="avatar" style="background:@PersonFarge(a.KundeNavn ?? a.ProsjektNavn)">@PersonInitialer(a.KundeNavn ?? a.ProsjektNavn)</span></td>
                                <td>
                                    <div class="navn-txt">@a.ProsjektNavn</div>
                                    <div class="kunde-txt">@(a.KundeNavn ?? "Ingen kunde satt")</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(a.Adresse) ? "–" : a.Adresse)</td>
                                <td>@(a.NesteServiceDato?.ToString("dd.MM.yyyy") ?? "Uten dato")</td>
                                <td><span class="statuspill @statusKlasse">@statusTekst</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="fotrad">
                <span class="sideantall">Viser @(_forsteRadNr)-@(_sisteRadNr) av @_filtrert.Count</span>
                <div class="sidevelger">
                    @for (var s = 1; s <= _antallSider; s++)
                    {
                        var side = s;
                        <span class="pagebtn @(side == _sideNr ? "aktiv" : "")" @onclick="@(() => _sideNr = side)">@side</span>
                    }
                </div>
            </div>
        </div>

        <div class="mapwrap">
            <div id="avtale-kart" class="mapkart"></div>
            @if (_filtrert.Count(a => a.Latitude is not null) == 0)
            {
                <div class="mapkart-tom">
                    <Icon Name="map" />
                    <span>Ingen av avtalene har registrert adresse med posisjon ennå.</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class AvtaleRad
    {
        public int ProsjektId { get; set; }
        public string ProsjektNavn { get; set; } = "";
        public string? KundeNavn { get; set; }
        public string? Adresse { get; set; }
        public string? Postnr { get; set; }
        public string? Sted { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public DateTime? SisteServiceDato { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public bool ErForfalt => NesteServiceDato.HasValue && NesteServiceDato.Value.Date < DateTime.Today;
        public bool ErSnartForfalt => NesteServiceDato.HasValue && !ErForfalt && NesteServiceDato.Value.Date <= DateTime.Today.AddDays(14);

        // "Aktiv" = har en registrert neste-service-dato som verken er forfalt
        // eller nærmer seg forfall ennå (mer enn 14 dager frem i tid).
        public bool ErAktiv => NesteServiceDato.HasValue && !ErForfalt && !ErSnartForfalt;
    }

    private List<AvtaleRad> _avtaler = [];
    private List<KundeOption> _kunder = [];
    private string _nyttNavn = "";
    private int? _valgtKundeId;
    private string? _nyAdresse;
    private string _search = "";
    private string _hurtigfilter = "alle";
    private string _sortering = "neste-service";
    private bool _visNyPanel;
    private int _sideNr = 1;
    private const int SideStorrelse = 10;

    private static readonly string[] PersonPaletten = ["#3B82F6", "#10B981", "#F59E0B", "#06B6D4", "#A855F7", "#EC4899", "#6366F1"];

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<AvtaleRad> _filtrertUsortert => _avtaler
        .Where(a => _hurtigfilter switch
        {
            "aktiv" => a.ErAktiv,
            "forfalt" => a.ErForfalt,
            "snart" => a.ErSnartForfalt,
            "utendato" => !a.NesteServiceDato.HasValue,
            _ => true
        })
        .Where(a => string.IsNullOrWhiteSpace(_search)
            || a.ProsjektNavn.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (a.KundeNavn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private List<AvtaleRad> _filtrert => _sortering switch
    {
        "navn" => _filtrertUsortert.OrderBy(a => a.ProsjektNavn).ToList(),
        "kunde" => _filtrertUsortert.OrderBy(a => a.KundeNavn ?? "").ToList(),
        _ => _filtrertUsortert.OrderBy(a => a.NesteServiceDato ?? DateTime.MaxValue).ToList()
    };

    private int _antallSider => Math.Max(1, (int)Math.Ceiling(_filtrert.Count / (double)SideStorrelse));
    private int _forsteRadNr => _filtrert.Count == 0 ? 0 : (_sideNr - 1) * SideStorrelse + 1;
    private int _sisteRadNr => Math.Min(_sideNr * SideStorrelse, _filtrert.Count);
    private List<AvtaleRad> _sideRader => _filtrert.Skip((_sideNr - 1) * SideStorrelse).Take(SideStorrelse).ToList();

    private static (string Tekst, string Klasse) StatusVisning(AvtaleRad a) => a switch
    {
        { ErForfalt: true } => ("Forfalt", "sp-forfalt"),
        { ErSnartForfalt: true } => ("Nærmer seg", "sp-naermer"),
        { ErAktiv: true } => ("Aktiv", "sp-aktiv"),
        _ => ("Uten dato", "sp-utendato")
    };

    protected override async Task OnInitializedAsync()
    {
        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        var prosjekter = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.Kunde)
            .OrderBy(p => p.Navn)
            .ToListAsync();

        var prosjektIder = prosjekter.Select(p => p.Id).ToList();

        var runder = await Db.Servicerunder
            .Where(s => prosjektIder.Contains(s.ProsjektId))
            .ToListAsync();

        _avtaler = prosjekter.Select(p =>
        {
            var proRunder = runder.Where(r => r.ProsjektId == p.Id).OrderByDescending(r => r.Dato).ToList();
            return new AvtaleRad
            {
                ProsjektId = p.Id,
                ProsjektNavn = p.Navn,
                KundeNavn = p.Kunde?.Navn,
                Adresse = p.Adresse,
                Postnr = p.Postnr,
                Sted = p.Sted,
                Latitude = p.Latitude,
                Longitude = p.Longitude,
                SisteServiceDato = proRunder.FirstOrDefault()?.Dato,
                NesteServiceDato = proRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato
            };
        }).ToList();

        await GeokodManglende(prosjekter);
    }

    // Henter posisjon for avtaler som har adresse men ikke lagret lat/lng ennå
    // (samme mønster som Kart.razor) - lagrer resultatet på selve Prosjektet
    // slik at det ikke må geokodes på nytt neste gang siden lastes.
    private async Task GeokodManglende(List<Prosjekt> prosjekter)
    {
        var endret = false;

        foreach (var a in _avtaler.Where(a => a.Latitude is null && !string.IsNullOrWhiteSpace(a.Adresse)))
        {
            var treff = await Geokoding.GeocodeAsync(a.Adresse!, a.Postnr, a.Sted);
            if (treff is null)
            {
                continue;
            }

            a.Latitude = treff.Value.Latitude;
            a.Longitude = treff.Value.Longitude;

            var prosjekt = prosjekter.First(p => p.Id == a.ProsjektId);
            prosjekt.Latitude = treff.Value.Latitude;
            prosjekt.Longitude = treff.Value.Longitude;
            endret = true;
        }

        if (endret)
        {
            await Db.SaveChangesAsync();
        }
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
        _sideNr = 1;
    }

    private void GaTilSide1()
    {
        _sideNr = 1;
    }

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private async Task OpprettServiceavtale()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var prosjekt = new Prosjekt
        {
            Navn = navn,
            KundeId = _valgtKundeId,
            Adresse = string.IsNullOrWhiteSpace(_nyAdresse) ? null : _nyAdresse.Trim(),
            Status = ProsjektStatus.Serviceavtale
        };

        Db.Prosjekter.Add(prosjekt);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/serviceavtaler/{prosjekt.Id}");
    }

    // ---------- Kart ----------

    private bool _kartInitialisert;
    private string? _sisteKartSignatur;

    // Kalles på hver render (billig - maks 15 punkter) og tegner kartet på
    // nytt kun når det faktisk initialiseres første gang eller når settet av
    // synlige punkter (filter/søk) har endret seg siden sist - unngår unødig
    // JS-kall på hver eneste re-render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_avtaler.Count == 0)
        {
            return;
        }

        var data = KartData();
        var signatur = string.Join("|", data.Select(d => d.ToString()));

        if (!_kartInitialisert)
        {
            await JS.InvokeVoidAsync("kart.init", "avtale-kart", data);
            _kartInitialisert = true;
            _sisteKartSignatur = signatur;
        }
        else if (signatur != _sisteKartSignatur)
        {
            await JS.InvokeVoidAsync("kart.setPunkter", data);
            _sisteKartSignatur = signatur;
        }
    }

    private List<object> KartData() => _filtrert
        .Where(a => a.Latitude is not null && a.Longitude is not null)
        .Select(a =>
        {
            var (statusTekst, _) = StatusVisning(a);
            return (object)new
            {
                lat = a.Latitude!.Value,
                lng = a.Longitude!.Value,
                tittel = a.ProsjektNavn,
                undertekst = a.KundeNavn ?? "",
                status = statusTekst,
                farge = KartFarge(a)
            };
        })
        .ToList();

    private static string KartFarge(AvtaleRad a) => a switch
    {
        { ErForfalt: true } => "#D94848",
        { ErSnartForfalt: true } => "#C2862E",
        { ErAktiv: true } => "#189A5C",
        _ => "#9a9a9e"
    };
}
