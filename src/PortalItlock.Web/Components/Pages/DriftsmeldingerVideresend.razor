@page "/driftsmeldinger"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@inject NavigationManager Nav

@* Driftsmeldinger har ikke egen side lenger - de havner i Forespørsler (mappen
   «Driftsmeldinger»). Gamle lenker og bokmerker sendes dit. *@

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/foresporsler?mappe=drift", replace: true);
}
