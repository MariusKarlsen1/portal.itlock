@page "/serviceavtaler/{ProsjektId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject ServicerapportPdfService PdfService
@inject LagretPdfService LagretPdfService
@inject MobilVerktoylinjeService Verktoylinje

<PageTitle>@(_prosjekt?.Navn ?? "Serviceavtale")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet.</p>
}
else if (_prosjekt is not null)
{
    @* "/serviceavtaler" er en skrivebord-only oversikt (viser bl.a. "Ny
       serviceavtale"-skjemaet øverst) - på mobil finnes serviceavtaler i
       stedet under fanen "Serviceavtaler" på "Alle prosjekter"-siden. Uten
       dette havnet man på skrivebordssiden sitt opprett-skjema i stedet for
       tilbake til oversikten. *@
    <a class="back-link" href="@(Verktoylinje.ErMobilvisning ? "/prosjekter?fane=serviceavtaler" : "/serviceavtaler")">&larr; Tilbake til serviceavtaler</a>

    @* Oppsett "Kort med faner" (oktober 2026): samme rolige kort som
       dashbordet, ticket og arbeidsordre, med en ny Oversikt-fane. *@
    <div class="sa-hode">
        <h1>@_prosjekt.Navn</h1>
        <span class="sa-pill">Serviceavtale</span>
        @if (_runder.Count > 0)
        {
            <span class="sa-pill sa-pill-gronn"><Icon Name="check" />@_runder.Count @(_runder.Count == 1 ? "servicerunde" : "servicerunder")</span>
        }
        @if (_naverendeRolle != BrukerRolle.Montor)
        {
            <button type="button" class="sa-knapp sa-rediger-avtale" @onclick="ApneRedigerAvtale"><Icon Name="edit" />Rediger avtale</button>
        }
    </div>

    <div class="sa-kort">
        <div class="sa-info">
            <span><Icon Name="users" /><b>@(_prosjekt.Kunde?.Navn ?? "Ingen kunde satt")</b>@(string.IsNullOrWhiteSpace(_prosjekt.Kontaktperson) ? "" : $" · {_prosjekt.Kontaktperson}")</span>
            @if (!string.IsNullOrWhiteSpace(_prosjekt.Adresse))
            {
                <span><Icon Name="map-pin" /><b>@_prosjekt.Adresse</b></span>
            }
            <span><Icon Name="door" /><b>@_dorer.Count @(_dorer.Count == 1 ? "dør" : "dører")</b></span>
            <span><Icon Name="calendar" />Neste service <b>@(NesteService?.ToString("dd.MM.yyyy") ?? "ikke planlagt")</b></span>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <label class="sa-ansvarlig" title="Personen ser denne serviceavtalen under &quot;Serviceavtaler&quot; på mobil.">
                    <Icon Name="tool" />Ansvarlig
                    <select value="@(_prosjekt.AnsvarligMontorId?.ToString() ?? "")" @onchange="EndreAnsvarligMontor">
                        <option value="">Ikke satt</option>
                        @foreach (var m in _montorer)
                        {
                            <option value="@m.Id">@m.Navn</option>
                        }
                    </select>
                </label>
                <label class="sa-ansvarlig sa-frekvens" title="Hvor mange servicerunder avtalen skal ha i året.">
                    <Icon Name="calendar" />Service
                    <select value="@(_prosjekt.ServiceGangerPerAr?.ToString() ?? "")" @onchange="EndreServiceGangerPerAr">
                        <option value="">Ikke satt</option>
                        @foreach (var g in GangerPerArValg)
                        {
                            <option value="@g">@GangerPerArTekst(g)</option>
                        }
                    </select>
                </label>
            }
        </div>

        <nav class="sa-faner">
            <button type="button" class="@(_activeTab is "oversikt" or "dorer" or "plantegninger" ? "sa-fane aktiv" : "sa-fane")" @onclick="VisOversikt"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="@FaneKlasse("service")" @onclick="@(() => _activeTab = "service")"><Icon Name="tool" />Servicerunder @if (_dorRunder.Count > 0) {<em>@_dorRunder.Count</em>}</button>
            <button type="button" class="@FaneKlasse("avvik")" @onclick="@(() => _activeTab = "avvik")"><Icon Name="alert" />Driftsmeldinger og avvik @if (ApneAvvikOgMeldinger.Count > 0) {<em class="r">@ApneAvvikOgMeldinger.Count</em>}</button>
            <button type="button" class="@FaneKlasse("rapporter")" @onclick="VisRapporter"><Icon Name="file-text" />Rapporter</button>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="@FaneKlasse("prising")" @onclick="@(() => _activeTab = "prising")"><Icon Name="receipt" />Avtale og prising</button>
            }
        </nav>

        <div class="sa-innhold">
        @if (_activeTab == "dorer")
        {
            <button type="button" class="ov-tilbake" @onclick="VisOversikt">&larr; Oversikt</button>
            <DorerListePanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "rapporter")
        {
            @* Rapporter: alle servicerapportene fra rundene, med signatur og PDF.
               FDV-dokumentasjonen ligger under. *@
            <section class="rp">
                <div class="rp-topp">
                    <div>
                        <b>Servicerapporter</b>
                        <span>Rapporten lagres automatisk når runden fullføres, og på nytt når kunden signerer.</span>
                    </div>
                </div>
                @if (_rapporter.Count == 0)
                {
                    <p class="sa-tom">Ingen fullførte servicerunder ennå. Rapportene kommer her når en runde er fullført.</p>
                }
                else
                {
                    <div class="rp-tabwrap">
                        <table class="rp-tab">
                            <thead><tr><th>Rapport</th><th>Montør</th><th class="n">Dører</th><th class="n">Avvik</th><th>Kundens signatur</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in _rapporter)
                                {
                                    <tr @key="r.RundeId">
                                        <td><b>Servicerapport @r.Dato.ToString("dd.MM.yyyy")</b><small>@(r.PdfId is null ? "Ikke lagret ennå" : $"Lagret {r.PdfDato:dd.MM.yyyy HH:mm}")</small></td>
                                        <td>@(r.Montor ?? "–")</td>
                                        <td class="n">@r.Dorer</td>
                                        <td class="n @(r.Avvik > 0 ? "sa-rodtekst" : "")">@r.Avvik</td>
                                        <td>
                                            @if (r.SignertAv is not null)
                                            {
                                                <span class="sa-chip gronn"><Icon Name="check" />@r.SignertAv</span>
                                            }
                                            else
                                            {
                                                <span class="sa-chip">Ikke signert</span>
                                            }
                                        </td>
                                        <td class="n rp-kn">
                                            @if (r.PdfId is { } pid)
                                            {
                                                <a class="sa-knapp sa-knapp-liten" href="@($"/lagretpdf/{pid}?vis=1")" target="_blank"><Icon Name="file-text" />Vis</a>
                                                <a class="sa-knapp sa-knapp-liten" href="@($"/lagretpdf/{pid}")" download><Icon Name="download" /></a>
                                            }
                                            else
                                            {
                                                <a class="sa-knapp sa-knapp-liten" href="@($"/servicerunde/{r.RundeId}/pdf")" target="_blank"><Icon Name="file-text" />Lag PDF</a>
                                            }
                                            <a class="sa-knapp sa-knapp-liten" href="@($"/servicerunder/{r.RundeId}")">Åpne runden</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            <h3 class="rp-h">FDV-dokumentasjon</h3>
            <FdvPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "prising" && _naverendeRolle != BrukerRolle.Montor)
        {
            <ServicePrisingPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "avvik")
        {
            <AvvikDriftsmeldingPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "plantegninger")
        {
            <button type="button" class="ov-tilbake" @onclick="VisOversikt">&larr; Oversikt</button>
            <PlantegningerListePanel ProsjektId="ProsjektId" VisHint="false" />
        }
        else if (_activeTab == "oversikt")
        {
            @* Oversikt O6 «Plantegning i fokus» (Prototype serviceavtale oversikt.html):
               plantegningen med status på hver dør først, korte tall, start av runde
               og sakene for tegningen til høyre. Under: krever oppmerksomhet og
               sjekkpunktene for avtalen. *@
            var tegning = _tegninger.FirstOrDefault(t => t.Id == _valgtTegningId) ?? _tegninger.FirstOrDefault();
            var paTegning = tegning is null ? [] : _kartDorer.Where(d => d.PlantegningId == tegning.Id).ToList();
            var tegningIder = paTegning.Select(d => d.Id).ToHashSet();
            var sakerHer = tegning is null ? ApneAvvikOgMeldinger : ApneAvvikOgMeldinger.Where(x => x.DorId is { } did && tegningIder.Contains(did)).ToList();
            var pagar = _dorRunder.FirstOrDefault(r => r.FullfortDato is null);
            @if (_dorer.Count == 0 && _naverendeRolle != BrukerRolle.Montor)
            {
                @* Nytt anlegg uten prosjekt: avtalen har sitt eget dørregister.
                   Dørene legges inn her, og «Ny servicerunde» henter dem herfra. *@
                <section class="kig">
                    <div class="kig-t">
                        <b>Kom i gang med avtalen</b>
                        <span>Avtalen har ingen dører ennå. Legg dem inn her – avtalen får sitt eget dørregister, og servicerundene henter dørene derfra som fra et prosjekt.</span>
                    </div>
                    <div class="kig-steg">
                        <button type="button" @onclick="@(() => _activeTab = "plantegninger")"><i>1</i><span><b>Last opp plantegning</b><small>Valgfritt. PDF eller bilde per etasje</small></span></button>
                        <button type="button" @onclick="@(() => Nav.NavigateTo($"/serviceavtaler/{ProsjektId}/befaring"))"><i>2</i><span><b>Befaring – legg inn dører</b><small>Dørnummer, rom og komponenttyper. Pris med en gang</small></span></button>
                        <button type="button" @onclick="@(() => _visDorImport = true)"><i>↥</i><span><b>Importer dørliste</b><small>Fra kundens Excel eller dørskjema</small></span></button>
                        <button type="button" @onclick="@(() => _activeTab = "prising")"><i>3</i><span><b>Sett pris</b><small>Prisreglene regner ut prisen per år</small></span></button>
                    </div>
                </section>
            }
            @if (_visDorImport)
            {
                <DorImportModal ProsjektId="ProsjektId" OnClose="@(() => _visDorImport = false)" OnImportert="@(() => Nav.NavigateTo($"/serviceavtaler/{ProsjektId}?fane=dorer", forceLoad: true))" />
            }
            <div class="ov6">
                <section class="ov6-plan">
                    <div class="ov6-verktoy">
                        @if (_tegninger.Count > 0)
                        {
                            <label class="ov6-velg">
                                <Icon Name="map" />
                                <select value="@(tegning?.Id)" @onchange="@(e => _valgtTegningId = int.TryParse(e.Value?.ToString(), out var tid) ? tid : _valgtTegningId)">
                                    @foreach (var t in _tegninger)
                                    {
                                        <option value="@t.Id">@t.Navn (@_kartDorer.Count(d => d.PlantegningId == t.Id) dører)</option>
                                    }
                                </select>
                            </label>
                            <span class="ov6-antall">@_tegninger.Count @(_tegninger.Count == 1 ? "plantegning" : "plantegninger")</span>
                        }
                        <span class="ov6-hjelp">Rull for å zoome · klikk på en dør for å se status</span>
                        <a class="sa-knapp sa-knapp-liten" href="@($"/serviceavtaler/{ProsjektId}/befaring")" title="Legg til dører med komponenttyper – rask pris"><Icon Name="plus" />Befaring</a>
                        <button type="button" class="sa-knapp sa-knapp-liten" @onclick="@(() => _activeTab = "dorer")"><Icon Name="door" />Dører</button>
                        <button type="button" class="sa-knapp sa-knapp-liten" @onclick="@(() => _activeTab = "plantegninger")"><Icon Name="map" />Plantegninger</button>
                    </div>
                    @if (tegning is null)
                    {
                        <div class="ov6-tom"><Icon Name="map" /><span>Ingen plantegninger på avtalen ennå. Dørene finnes under Dører, og tegninger legges til under Plantegninger.</span></div>
                    }
                    else if (!tegning.ErBilde)
                    {
                        <div class="ov6-tom"><Icon Name="map" /><span>«@tegning.Navn» er ikke et bilde og kan ikke vises med dørene på. Åpne den under Plantegninger.</span></div>
                    }
                    else
                    {
                        <div class="ov6-flate" data-hjulzoom @key="tegning.Id">
                            <div class="ov6-tegning" data-hjulzoom-flate>
                                <img src="@($"/plantegningbilde/{tegning.Id}")" alt="@tegning.Navn" />
                                @foreach (var d in paTegning.Where(d => d.PosX.HasValue && d.PosY.HasValue))
                                {
                                    <button type="button" @key="d.Id" class="ov6-pin @DorFarge(d.Id) @(_valgtKartDor?.Id == d.Id ? "valgt" : "")" title="@(string.IsNullOrWhiteSpace(d.Rom) ? d.Dornummer : $"{d.Dornummer} · {d.Rom}")"
                                       style="left:@d.PosX!.Value.ToString(CultureInfo.InvariantCulture)%;top:@d.PosY!.Value.ToString(CultureInfo.InvariantCulture)%" @onclick="@(() => VelgKartDor(d))">@d.Dornummer</button>
                                }
                            </div>
                        </div>
                        @if (_valgtKartDor is { } vd && paTegning.Any(x => x.Id == vd.Id))
                        {
                            <div class="ov6-dor">
                                <span class="ov6-dor-nr @vd.Farge">@vd.Dornummer</span>
                                <div class="ov6-dor-t">
                                    <b>Dør @vd.Dornummer@(string.IsNullOrWhiteSpace(vd.Rom) ? "" : $" · {vd.Rom}")</b>
                                    <small>@StatusTekst(vd.Farge) · @(vd.SistKontrollert is { } sk ? $"sist kontrollert {sk:dd.MM.yyyy}{(vd.SistStatus == ServicerundeDorStatus.Avvik ? " (avvik)" : "")}" : "ikke kontrollert i en runde ennå")</small>
                                    @foreach (var x in vd.Saker.Take(3))
                                    {
                                        <a class="ov6-dor-sak" href="@x.Lenke"><Icon Name="@(x.ErAvvik ? "alert" : "mail")" />@x.Tittel<em>@x.Status</em></a>
                                    }
                                </div>
                                <a class="sa-knapp sa-knapp-liten" href="@($"/dor/{vd.Id}")">Åpne dør</a>
                                <button type="button" class="ov6-dor-x" title="Lukk" @onclick="@(() => _valgtKartDor = null)">×</button>
                            </div>
                        }
                        <div class="ov6-lg">
                            <span><i class="gronn"></i>I orden</span>
                            <span><i class="rod"></i>Åpen melding eller avvik</span>
                            <span><i class="gul"></i>Under arbeid</span>
                            <span class="ov6-lg-h">@paTegning.Count av @_kartDorer.Count dører på denne tegningen</span>
                        </div>
                    }
                </section>

                <aside class="ov6-side">
                    <div class="ov6-tall">
                        <button type="button" @onclick="@(() => _activeTab = "service")"><small>Neste runde</small><b>@(NesteService?.ToString("dd.MM") ?? "–")</b></button>
                        <button type="button" @onclick="@(() => _activeTab = "prising")"><small>Per år</small><b>@(_avtaleStatus is { } st ? KrKort(st.Godkjent ?? st.Beregnet) : "–")</b></button>
                        <button type="button" @onclick="@(() => _activeTab = "dorer")"><small>Dører</small><b>@_kartDorer.Count</b></button>
                        <button type="button" @onclick="@(() => _activeTab = "avvik")"><small>Åpne saker</small><b class="@(ApneAvvikOgMeldinger.Count > 0 ? "sa-rodtekst" : "")">@ApneAvvikOgMeldinger.Count</b></button>
                    </div>
                    @if (pagar is not null)
                    {
                        <a class="sa-knapp sa-knapp-p ov6-start" href="@($"/servicerunder/{pagar.Id}")"><Icon Name="tool" />Fortsett runden</a>
                    }
                    else
                    {
                        <button type="button" class="sa-knapp sa-knapp-p ov6-start" @onclick="StartFraOversikt"><Icon Name="tool" />Start runden</button>
                    }
                    <section class="ov6-saker">
                        <div class="ov6-saker-t"><b>Saker@(tegning is null ? "" : $" på {tegning.Navn}")</b><em class="@(sakerHer.Count > 0 ? "r" : "")">@sakerHer.Count</em></div>
                        @if (sakerHer.Count == 0)
                        {
                            <span class="so-ok"><Icon Name="check-circle" />Ingen åpne saker</span>
                        }
                        @foreach (var x in sakerHer.Take(8))
                        {
                            <a class="sa-rad" href="@x.Lenke">
                                <span class="sa-ik @(x.ErAvvik ? "rod" : "")"><Icon Name="@(x.ErAvvik ? "alert" : "mail")" /></span>
                                <span><b>@x.Tittel</b><small>@x.Undertekst</small></span>
                                <span class="sa-chip @(x.ErAvvik ? "rod" : "gul")">@x.Status</span>
                            </a>
                        }
                    </section>
                </aside>
            </div>

            @if (_avtaleStatus is { } sv && Oppmerksomhet(sv) is { Count: > 0 } saker)
            {
                <section class="so-oppm">
                    <div class="sa-tile-t"><h3>Krever oppmerksomhet</h3></div>
                    @foreach (var sak in saker)
                    {
                        <div class="so-oppm-rad">
                            <span class="sa-ik @sak.Farge"><Icon Name="@sak.Ikon" /></span>
                            <span><b>@sak.Tittel</b><small>@sak.Tekst</small></span>
                            @if (sak.Lenke is { } lenke)
                            {
                                <a class="sa-knapp" href="@lenke">@sak.Knapp</a>
                            }
                            else
                            {
                                <button type="button" class="sa-knapp" @onclick="@(() => _activeTab = "prising")">@sak.Knapp</button>
                            }
                        </div>
                    }
                </section>
            }


        }
        else
        {
            @* Fase 4: runde dør for dør med øyeblikksbilde og kontrollpunkter per dør. *@
            <section class="srs">
                <div class="srs-topp">
                    <div>
                        <b>Servicerunder</b>
                        <span>«Ny servicerunde» henter inn dørene, plantegningene og kontrollpunktene som et fast øyeblikksbilde. Så huker du av dør for dør.</span>
                    </div>
                    @if (_dorRunder.FirstOrDefault(r => r.FullfortDato is null) is { } pagar)
                    {
                        <a class="sa-knapp sa-knapp-p" href="@($"/servicerunder/{pagar.Id}")"><Icon Name="tool" />Fortsett runden</a>
                    }
                    else
                    {
                        <button type="button" class="sa-knapp sa-knapp-p" @onclick="VisStartRunde"><Icon Name="plus" />Ny servicerunde</button>
                    }
                </div>
                @if (_naverendeRolle != BrukerRolle.Montor)
                {
                    <div class="srs-plan">
                        <span>Planlegg runde</span>
                        <input type="date" @bind="_planlagtDato" />
                        <button type="button" class="sa-knapp sa-knapp-liten" @onclick="PlanleggServicerunde" disabled="@(_planlagtDato is null)"><Icon Name="calendar" />Planlegg</button>
                    </div>
                }
                @if (_forhand is { } fh)
                {
                    <div class="srs-forh">
                        <div class="srs-tall"><b>@fh.Dorer</b><span>dører hentes inn med komponenter og kontrollpunkter</span></div>
                        <ul>
                            <li>@fh.Plantegninger @(fh.Plantegninger == 1 ? "plantegning" : "plantegninger") med dørplasseringer</li>
                            <li>@fh.ApneDriftsmeldinger åpne driftsmeldinger og @fh.ApneAvvik åpne avvik vises på dørene</li>
                            @if (fh.ForrigeRunde is { } fr)
                            {
                                <li>@(fh.EndredeDorer.Count == 0 ? "Ingen dører" : $"{fh.EndredeDorer.Count} {(fh.EndredeDorer.Count == 1 ? "dør" : "dører")} ({string.Join(", ", fh.EndredeDorer.Take(8))})") endret siden forrige runde @fr.ToString("dd.MM.yyyy")</li>
                            }
                        </ul>
                        <div class="srs-knapper">
                            <span><Icon Name="lock" />Lagres som et fast øyeblikksbilde</span>
                            <button type="button" class="sa-knapp" @onclick="@(() => _forhand = null)">Avbryt</button>
                            <button type="button" class="sa-knapp sa-knapp-p" @onclick="StartRunde" disabled="@(fh.Dorer == 0)"><Icon Name="tool" />Start runde</button>
                        </div>
                    </div>
                }
                @{
                    var dorRundeIder = _dorRunder.Select(x => x.Id).ToHashSet();
                    var eldre = _runder.Where(x => !dorRundeIder.Contains(x.Id)).ToList();
                }
                @if (_dorRunder.Count > 0 || _planlagteRunder.Count > 0 || eldre.Count > 0)
                {
                    <div class="rp-tabwrap">
                        <table class="rp-tab srs-tab">
                            <thead><tr><th>Runde</th><th>Montør</th><th class="n">Dører</th><th class="n">Avvik</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in _planlagteRunder)
                                {
                                    var dager = (p.Dato.Date - DateTime.Today).Days;
                                    <tr @key="@($"p{p.Id}")" class="plan">
                                        <td><b>@p.Dato.ToString("dd.MM.yyyy")</b><small class="@(dager < 0 ? "sa-rodtekst" : "")">@NarTekst(dager)</small></td>
                                        <td>@(AnsvarligNavn ?? "–")</td>
                                        <td class="n">@_dorer.Count</td>
                                        <td class="n">–</td>
                                        <td><span class="sa-chip @(dager < 0 ? "rod" : "gul")"><Icon Name="calendar" />@(dager < 0 ? "Forfalt" : "Planlagt")</span></td>
                                        <td class="n">
                                            @if (!_dorRunder.Any(x => x.FullfortDato is null))
                                            {
                                                <button type="button" class="sa-knapp sa-knapp-p sa-knapp-liten" @onclick="VisStartRunde"><Icon Name="play" />Start</button>
                                            }
                                            <button type="button" class="sa-fjern" title="Fjern planlagt runde" @onclick="@(() => SlettPlanlagtRunde(p.Id))">×</button>
                                        </td>
                                    </tr>
                                }
                                @foreach (var r in _dorRunder)
                                {
                                    @* En runde kan gå over flere dager: pågående viser når den startet,
                                       hvor lenge den har pågått og hvor langt den har kommet. *@
                                    var dagerPagatt = (DateTime.Today - r.Dato.Date).Days;
                                    var flereDager = r.FullfortDato is { } ff && ff.Date != r.Dato.Date;
                                    <tr @key="r.Id" class="klikk @(r.FullfortDato is null ? "pagar" : "")" @onclick="@(() => Nav.NavigateTo($"/servicerunder/{r.Id}"))">
                                        <td>
                                            @if (r.FullfortDato is null)
                                            {
                                                <b>Startet @r.Dato.ToString("dd.MM.yyyy")</b>
                                                <small>@(dagerPagatt <= 0 ? "Startet i dag" : dagerPagatt == 1 ? "Pågått i 1 dag" : $"Pågått i {dagerPagatt} dager")</small>
                                            }
                                            else
                                            {
                                                <b>@(flereDager ? $"{r.Dato:dd.MM} – {r.FullfortDato:dd.MM.yyyy}" : r.Dato.ToString("dd.MM.yyyy"))</b>
                                                @if (!string.IsNullOrWhiteSpace(r.StatusBeskrivelse)) {<small>@Kort(RikTekst.TilTekst(r.StatusBeskrivelse))</small>}
                                            }
                                        </td>
                                        <td>@(r.Montor ?? "–")</td>
                                        <td class="n">@r.Dorer</td>
                                        <td class="n @(r.Avvik > 0 ? "sa-rodtekst" : "")">@r.Avvik</td>
                                        <td>
                                            @if (r.FullfortDato is null)
                                            {
                                                <span class="sa-chip bla"><Icon Name="tool" />Pågår · @r.Kontrollert av @r.Dorer dører</span>
                                                <span class="srs-fram"><i style="width:@(r.Dorer == 0 ? 0 : r.Kontrollert * 100 / r.Dorer)%"></i></span>
                                            }
                                            else
                                            {
                                                <span class="sa-chip gronn"><Icon Name="check" />Fullført @r.FullfortDato.Value.ToString("dd.MM")</span>
                                            }
                                        </td>
                                        <td class="n">
                                            <a class="sa-knapp @(r.FullfortDato is null ? "sa-knapp-p" : "") sa-knapp-liten" href="@($"/servicerunder/{r.Id}")" @onclick:stopPropagation="true"><Icon Name="@(r.FullfortDato is null ? "tool" : "eye")" />@(r.FullfortDato is null ? "Fortsett servicerunde" : "Åpne servicerunde")</a>
                                            @if (r.FullfortDato is not null)
                                            {
                                                <a class="sa-knapp sa-knapp-liten" href="@($"/servicerunde/{r.Id}/pdf")" target="_blank" title="Servicerapport (PDF)" @onclick:stopPropagation="true"><Icon Name="file-text" /></a>
                                            }
                                        </td>
                                    </tr>
                                }
                                @foreach (var r in eldre)
                                {
                                    var pdf = _lagredePdfer.GetValueOrDefault(r.Id)?.OrderByDescending(x => x.OpprettetDato).FirstOrDefault();
                                    <tr @key="@($"e{r.Id}")">
                                        <td><b>@r.Dato.ToString("dd.MM.yyyy")</b>@if (!string.IsNullOrWhiteSpace(r.StatusBeskrivelse)) {<small>@Kort(RikTekst.TilTekst(r.StatusBeskrivelse))</small>}</td>
                                        <td>@(r.UtfortAvNavn ?? "–")</td>
                                        <td class="n">–</td>
                                        <td class="n">–</td>
                                        <td><span class="sa-chip gronn"><Icon Name="check" />Registrert</span></td>
                                        <td class="n"><a class="sa-knapp sa-knapp-liten" href="@(pdf is null ? $"/servicerunde/{r.Id}/pdf" : $"/lagretpdf/{pdf.Id}?vis=1")" target="_blank"><Icon Name="file-text" />Rapport</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_forhand is null)
                {
                    <p class="sa-tom">Ingen servicerunder ennå. Trykk «Ny servicerunde» for å starte den første. Dørene, plantegningene og kontrollpunktene hentes inn automatisk.</p>
                }
            </section>

        }
        </div>
    </div>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av servicerapport" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreServicerapportPdf" OnClose="@(() => _pdfPreviewUrl = null)" />

    @* Rediger avtalen: navn, kunde, kontakt, adresse, ansvarlig og service per år. *@
    @if (_redAvtale is { } ra)
    {
        <div class="sr-overlay" @onclick="@(() => _redAvtale = null)">
            <div class="sr-modal" role="dialog" aria-modal="true" aria-label="Rediger avtale" @onclick:stopPropagation="true">
                <div class="sr-hode"><h3>Rediger avtale</h3><button type="button" class="sr-lukk" aria-label="Lukk" @onclick="@(() => _redAvtale = null)"><Icon Name="x" /></button></div>
                <div class="sr-kropp">
                    <label class="sa-felt">Navn på avtalen<input @bind="ra.Navn" @bind:event="oninput" /></label>
                    <div class="sa-to">
                        <label class="sa-felt">Kunde
                            <select @bind="ra.KundeId">
                                <option value="">Ingen kunde</option>
                                @foreach (var k in _kunderValg)
                                {
                                    <option value="@k.Id">@k.Navn</option>
                                }
                            </select>
                        </label>
                        <label class="sa-felt">Ansvarlig
                            <select @bind="ra.AnsvarligId">
                                <option value="">Ikke satt</option>
                                @foreach (var m in _montorer)
                                {
                                    <option value="@m.Id">@m.Navn</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="sa-to">
                        <label class="sa-felt">Kontaktperson<input @bind="ra.Kontaktperson" @bind:event="oninput" /></label>
                        <label class="sa-felt">Telefon<input type="tel" @bind="ra.Telefon" @bind:event="oninput" /></label>
                    </div>
                    <label class="sa-felt">Adresse<input @bind="ra.Adresse" @bind:event="oninput" /></label>
                    <div class="sa-to">
                        <label class="sa-felt">Postnr<input @bind="ra.Postnr" @bind:event="oninput" inputmode="numeric" /></label>
                        <label class="sa-felt">Sted<input @bind="ra.Sted" @bind:event="oninput" /></label>
                    </div>
                    <label class="sa-felt">Service per år
                        <select @bind="ra.GangerPerAr">
                            <option value="">Ikke satt</option>
                            @foreach (var g in GangerPerArValg)
                            {
                                <option value="@g">@GangerPerArTekst(g)</option>
                            }
                        </select>
                    </label>
                    @if (!string.IsNullOrEmpty(_redAvtaleFeil))
                    {
                        <p class="form-error">@_redAvtaleFeil</p>
                    }
                    @* Ble et prosjekt lagt som serviceavtale ved en feil, flyttes det tilbake her. *@
                    @if (_bekreftFlytt)
                    {
                        <div class="sa-flytt">
                            @if (ErKobletAvtale)
                            {
                                <b>Avslutte serviceavtalen på «@ra.Navn»?</b>
                                <span>Prosjektet forsvinner fra serviceavtalene, men blir liggende som før under Ferdigstilte prosjekter. Dører, runder og historikk beholdes.</span>
                            }
                            else
                            {
                                <b>Flytte «@ra.Navn» til prosjekter?</b>
                                <span>Avtalen blir et vanlig prosjekt med status «Under arbeid» og forsvinner fra serviceavtalene. Dører, tilbud og historikk følger med.</span>
                            }
                            <span class="sa-flytt-knapper">
                                <button type="button" class="sa-knapp" @onclick="@(() => _bekreftFlytt = false)">Avbryt</button>
                                <button type="button" class="sa-knapp sa-knapp-p" @onclick="FlyttTilProsjekter">@(ErKobletAvtale ? "Ja, avslutt serviceavtalen" : "Ja, flytt til prosjekter")</button>
                            </span>
                        </div>
                    }
                </div>
                <div class="sr-fot">
                    @if (!_bekreftFlytt)
                    {
                        <button type="button" class="sa-knapp" @onclick="@(() => _bekreftFlytt = true)"><Icon Name="folder" />@(ErKobletAvtale ? "Avslutt serviceavtale" : "Flytt til prosjekter")</button>
                    }
                    <span class="sr-sp"></span>
                    <button type="button" class="sa-knapp" @onclick="@(() => _redAvtale = null)">Avbryt</button>
                    <button type="button" class="sa-knapp sa-knapp-p" @onclick="LagreAvtale">Lagre</button>
                </div>
            </div>
        </div>
    }

}

@code {
    [Parameter] public int ProsjektId { get; set; }

    // ?fane=service / avvik / dorer ... åpner riktig fane direkte (brukes fra
    // knappene i serviceavtale-listen, f.eks. «Planlegg runde»).
    [SupplyParameterFromQuery(Name = "fane")] public string? Fane { get; set; }

    // «Rediger» fra ⋯-menyen i listen åpner «Rediger avtale» med en gang.
    [SupplyParameterFromQuery(Name = "rediger")] public int? RedigerQuery { get; set; }
    private bool _redigerApnet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RedigerQuery == 1 && !_redigerApnet && _prosjekt is not null)
        {
            _redigerApnet = true;
            await ApneRedigerAvtale();
            StateHasChanged();
        }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _activeTab = "oversikt";
    private string FaneKlasse(string tab) => _activeTab == tab ? "sa-fane aktiv" : "sa-fane";

    private sealed class DelRad
    {
        public int Id { get; set; }
        public string? DorNummer { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateTime Dato { get; set; }
    }

    private sealed class SjekkRad
    {
        public int Id { get; set; }
        public string Tekst { get; set; } = "";
        public int Rekkefolge { get; set; }
        public bool Fullfort { get; set; }
        public DateTime? FullfortDato { get; set; }
        public string? FullfortAvNavn { get; set; }
    }

    private sealed class RundeRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string? UtfortAvNavn { get; set; }
        public string StatusBeskrivelse { get; set; } = "";
        public string? Anbefalinger { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public bool ErPlanlagt { get; set; }
        public List<DelRad> Deler { get; set; } = [];
        public List<SjekkRad> Sjekkpunkter { get; set; } = [];
        public List<int> BildeIder { get; set; } = [];
    }

    private sealed class DorOption
    {
        public int Id { get; set; }
        public string Dornummer { get; set; } = "";
    }

    private sealed class NyDelRad
    {
        public int? DorId { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateOnly Dato { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    private sealed class NyttBildeRad
    {
        public required byte[] Data { get; set; }
        public required string ContentType { get; set; }
        public required string Filnavn { get; set; }
        public string DataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Data)}";
    }

    // Et sjekkpunkt på runden som registreres nå: fra felles mal, avtalens
    // faste punkter, eller lagt til bare for denne runden.
    private sealed class NyttSjekkpunkt
    {
        public required string Tekst { get; set; }
        public required string Kilde { get; set; }
        public bool Fullfort { get; set; }
    }

    private sealed record AvvikEllerMelding(string Tittel, string Undertekst, string Status, bool ErAvvik, string Lenke, DateTime Dato, int? DorId = null);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private Prosjekt? _prosjekt;
    private bool _notFound;
    private int? _loadedId;
    private List<RundeRad> _runder = [];
    private List<RundeRad> _planlagteRunder = [];
    private DateOnly? _planlagtDato = DateOnly.FromDateTime(DateTime.Today);
    private string? _savedMessage;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private int? _aktivRundeId;
    private Dictionary<int, List<LagretPdf>> _lagredePdfer = [];
    private readonly HashSet<int> _utfoldedeRunder = [];
    private readonly HashSet<int> _apneSteg = [1, 2];

    private DateOnly _nyDato = DateOnly.FromDateTime(DateTime.Today);
    private string _nyStatusBeskrivelse = "";
    private string? _nyAnbefalinger;
    private DateOnly? _nyNesteServiceDato;
    private string? _nyForside;
    private List<TilbudForside> _forsideMaler = [];
    private int? _valgtForsideMalId;
    private List<DorOption> _dorer = [];
    private List<NyDelRad> _nyeDeler = [];
    private List<ServicerundeSjekklistepunkt> _sjekklistemal = [];
    private List<ServiceavtaleSjekkpunkt> _avtalePunkter = [];
    private List<NyttSjekkpunkt> _nyeSjekkpunkter = [];
    private string _nyttRundePunkt = "";
    private bool _nyttPunktFast;
    private string _nyttFastPunkt = "";
    private List<NyttBildeRad> _nyeBilder = [];
    private string? _bildeFeil;
    private List<Bruker> _montorer = [];
    private List<Avvik> _apneAvvik = [];
    private List<DriftHelper.MeldingStatus> _apneMeldinger = [];

    // ---------- avledede verdier til oversikten ----------
    private RundeRad? SisteRunde => _runder.FirstOrDefault();

    private DateTime? NesteService =>
        _planlagteRunder.Where(r => r.Dato.Date >= DateTime.Today).Select(r => (DateTime?)r.Dato).FirstOrDefault()
        ?? (SisteRunde?.NesteServiceDato is { } d && d.Date >= DateTime.Today ? d : null);

    private string? AnsvarligNavn => _montorer.FirstOrDefault(m => m.Id == _prosjekt?.AnsvarligMontorId)?.Navn;

    private List<DelRad> DelerIAr => _runder.SelectMany(r => r.Deler).Where(d => d.Dato.Year == DateTime.Today.Year).ToList();

    private List<AvvikEllerMelding> ApneAvvikOgMeldinger => _apneAvvik
        .Select(a => new AvvikEllerMelding(
            $"{a.Dor?.Dornummer} · {Forkort(a.Beskrivelse, 60)}",
            $"Avvik · {a.OpprettetDato:dd.MM.yyyy}",
            a.Status.Visningsnavn(), true, $"/dor/{a.DorId}", a.OpprettetDato, a.DorId))
        .Concat(_apneMeldinger.Select(m => new AvvikEllerMelding(
            $"{m.Melding.Dor?.Dornummer} · {(string.IsNullOrWhiteSpace(m.Melding.Tittel) ? Forkort(m.Melding.Tekst, 60) : m.Melding.Tittel)}",
            $"Driftsmelding · {m.Melding.InnmeldtAvBruker?.Navn ?? "ukjent"} · {m.Melding.OpprettetDato:dd.MM.yyyy}",
            m.Navn, false, $"/driftsmelding/{m.Melding.Id}", m.Melding.OpprettetDato, m.Melding.DorId)))
        .OrderByDescending(x => x.Dato)
        .ToList();

    private static string Forkort(string tekst, int maks) => tekst.Length <= maks ? tekst : tekst[..maks].TrimEnd() + "…";

    private static string SidenTekst(DateTime dato)
    {
        var dager = (DateTime.Today - dato.Date).Days;
        if (dager < 31) { return dager <= 0 ? "i dag" : dager == 1 ? "i går" : $"{dager} dager siden"; }
        var mnd = dager / 30;
        return mnd < 12 ? $"{mnd} mnd siden" : $"{mnd / 12} år siden";
    }

    private void VekslSteg(int steg)
    {
        if (!_apneSteg.Add(steg))
        {
            _apneSteg.Remove(steg);
        }
    }

    // ---------- gjenbrukbare biter ----------
    private RenderFragment RundeKort(RundeRad r, bool full) => __builder =>
    {
        var apen = _utfoldedeRunder.Contains(r.Id);
        <div class="sa-runde @(_redigererRundeId == r.Id ? "sd-redigeres" : "")" @key="r.Id">
            <span class="sa-kal"><small>@r.Dato.ToString("MMM", Kultur).TrimEnd('.')</small><b>@r.Dato.Day</b><span>@r.Dato.Year</span></span>
            <div class="sa-runde-innhold">
                <b>Servicerunde@(r.UtfortAvNavn is null ? "" : $" · {r.UtfortAvNavn}")@if (_redigererRundeId == r.Id) {<span class="sd-merke">redigeres nå</span>}</b>
                <div class="sd-rik">@((MarkupString)RikTekst.TilHtml(r.StatusBeskrivelse))</div>
                @if (!string.IsNullOrWhiteSpace(r.Anbefalinger))
                {
                    <div class="sa-anbefaling sd-rik"><b>Anbefaling:</b> @((MarkupString)RikTekst.TilHtml(r.Anbefalinger))</div>
                }
                <div class="sa-chips">
                    @if (r.Deler.Count > 0)
                    {
                        <span class="sa-chip">@r.Deler.Count byttede deler</span>
                    }
                    @if (r.Sjekkpunkter.Count > 0)
                    {
                        <span class="sa-chip @(r.Sjekkpunkter.All(p => p.Fullfort) ? "gronn" : "")">sjekkliste @r.Sjekkpunkter.Count(p => p.Fullfort)/@r.Sjekkpunkter.Count</span>
                    }
                    @if (r.NesteServiceDato.HasValue)
                    {
                        <span class="sa-chip">neste: @r.NesteServiceDato.Value.ToString("dd.MM.yyyy")</span>
                    }
                </div>
                @if (r.BildeIder.Count > 0)
                {
                    <div class="sa-mini">
                        @foreach (var bildeId in r.BildeIder.Take(full ? 8 : 4))
                        {
                            <a href="@($"/servicerundemedia/{bildeId}")" target="_blank"><img src="@($"/servicerundemedia/{bildeId}")" alt="Bilde fra servicerunden" loading="lazy" /></a>
                        }
                    </div>
                }
                @if (full && (r.Deler.Count > 0 || r.Sjekkpunkter.Count > 0 || _lagredePdfer.GetValueOrDefault(r.Id, []).Count > 0))
                {
                    <button type="button" class="sa-lenke sa-detaljer-knapp" @onclick="@(() => { if (!_utfoldedeRunder.Add(r.Id)) { _utfoldedeRunder.Remove(r.Id); } })">@(apen ? "Skjul detaljer ▴" : "Vis detaljer ▾")</button>
                    @if (apen)
                    {
                        @if (r.Deler.Count > 0)
                        {
                            <div class="sa-detalj">
                                <h4>Byttede deler</h4>
                                @foreach (var d in r.Deler)
                                {
                                    <div class="sa-detalj-rad" @key="d.Id">@d.Dato.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(d.DorNummer) ? "" : $" · Dør {d.DorNummer}") · @d.Beskrivelse@(string.IsNullOrWhiteSpace(d.Feil) ? "" : $" (Feil: {d.Feil})")</div>
                                }
                            </div>
                        }
                        @if (r.Sjekkpunkter.Count > 0)
                        {
                            <div class="sa-detalj">
                                <h4>Sjekkliste</h4>
                                @foreach (var p in r.Sjekkpunkter)
                                {
                                    <div class="sa-sjekk @(p.Fullfort ? "ok" : "")" @key="p.Id">
                                        <button type="button" class="sa-bx" @onclick="@(() => ToggleSjekkpunkt(p))">@(p.Fullfort ? "✓" : "")</button>
                                        <span>@p.Tekst</span>
                                        <small>@(p.Fullfort && p.FullfortDato.HasValue ? $"{p.FullfortDato.Value:dd.MM.yyyy HH:mm}{(p.FullfortAvNavn is null ? "" : $" · {p.FullfortAvNavn}")}" : "")</small>
                                    </div>
                                }
                            </div>
                        }
                        <div class="sa-detalj">
                            <h4>Lagrede PDF-er</h4>
                            <LagredePdfListe Pdfer="@_lagredePdfer.GetValueOrDefault(r.Id, [])" />
                        </div>
                    }
                }
            </div>
            <div class="sa-runde-knapper">
                <button type="button" class="sa-knapp sa-knapp-p sa-knapp-liten" @onclick="@(() => VisRapportForhandsvisning(r.Id))"><Icon Name="file-text" />Generer rapport</button>
                <button type="button" class="sa-knapp sa-knapp-liten" @onclick="@(() => LastInnRunde(r.Id))"><Icon Name="edit" />Rediger</button>
            </div>
        </div>
    };

    // Status for et sjekkpunkt fra siste runde (OK / ikke huket av), med
    // mulighet til å fjerne avtalens egne faste punkter.
    private RenderFragment SjekkpunktStatus(string tekst, string kilde, ServiceavtaleSjekkpunkt? fast) => __builder =>
    {
        var sist = SisteRunde?.Sjekkpunkter.FirstOrDefault(p => p.Tekst == tekst);
        <div class="sa-sjekk @(sist?.Fullfort == true ? "ok" : sist is not null ? "avvik" : "")">
            <span class="sa-bx sa-bx-status">@(sist?.Fullfort == true ? "✓" : "")</span>
            <span>@tekst</span>
            <small>@(sist is null ? kilde : sist.Fullfort ? $"OK {SisteRunde!.Dato:dd.MM}" : $"Ikke gjort {SisteRunde!.Dato:dd.MM}")</small>
            @if (fast is not null && _naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="sa-fjern" title="Fjern fast sjekkpunkt" @onclick="@(() => FjernFastPunkt(fast))">×</button>
            }
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_loadedId == ProsjektId)
        {
            return;
        }

        _loadedId = ProsjektId;
        _activeTab = Fane is "fdv" ? "rapporter" : Fane is "oversikt" or "service" or "dorer" or "plantegninger" or "rapporter" or "prising" or "avvik" ? Fane : "oversikt";
        _notFound = false;
        _savedMessage = null;
        NullstillSkjema();

        _prosjekt = await Db.Prosjekter
            .Include(p => p.Kunde)
            .FirstOrDefaultAsync(p => p.Id == ProsjektId);

        if (_prosjekt is null)
        {
            _notFound = true;
            return;
        }

        ForeslaNesteDato();

        _montorer = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Montor && b.Aktiv)
            .OrderBy(b => b.Navn)
            .ToListAsync();

        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .OrderBy(d => d.Dornummer)
            .Select(d => new DorOption { Id = d.Id, Dornummer = d.Dornummer })
            .ToListAsync();
        _kartDorer = await Db.Dorer.AsNoTracking()
            .Where(d => d.ProsjektId == ProsjektId)
            .OrderBy(d => d.Dornummer)
            .Select(d => new KartDor(d.Id, d.Dornummer, d.Romnr ?? d.DorTil, d.PlantegningId, d.PosX, d.PosY))
            .ToListAsync();
        _tegninger = (await Db.Plantegninger.AsNoTracking().Where(p => p.ProsjektId == ProsjektId)
                .Select(p => new { p.Id, p.Navn, p.ContentType }).ToListAsync())
            .Select(p => new KartTegning(p.Id, p.Navn, p.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(t => _kartDorer.Count(d => d.PlantegningId == t.Id)).ThenBy(t => t.Navn).ToList();
        _valgtTegningId ??= _tegninger.FirstOrDefault()?.Id;
        await LastSjekklisteAsync();
        _avtalePunkter = await Db.ServiceavtaleSjekkpunkter.Where(p => p.ProsjektId == ProsjektId).OrderBy(p => p.Rekkefolge).ToListAsync();
        ByggNyeSjekkpunkter();

        _apneAvvik = await Db.Avvik
            .Include(a => a.Dor)
            .Where(a => a.Dor!.ProsjektId == ProsjektId && a.Status != AvvikStatus.Godkjent)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();
        _apneMeldinger = (await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.Dor!.ProsjektId == ProsjektId)))
            .Where(m => m.ErApen)
            .ToList();

        await LastRunderAsync();
        await LastAvtaleStatus();
