    // Neste service foreslås ut fra hvor mange ganger i året avtalen har
    // (dato + 12/ganger måneder). Bare så lenge brukeren ikke har skrevet inn
    // en egen dato - da blir den stående.
    private bool _nesteForeslatt;

    private void ForeslaNesteDato()
    {
        if (_prosjekt?.ServiceGangerPerAr is not { } ganger || ganger <= 0)
        {
            if (_nesteForeslatt)
            {
                _nyNesteServiceDato = null;
                _nesteForeslatt = false;
            }
            return;
        }

        if (_nyNesteServiceDato is null || _nesteForeslatt)
        {
            _nyNesteServiceDato = _nyDato.AddMonths(12 / ganger);
            _nesteForeslatt = true;
        }
    }

