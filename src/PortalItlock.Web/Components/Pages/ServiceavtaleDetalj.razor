@page "/serviceavtaler/{ProsjektId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ServicerapportPdfService PdfService
@inject LagretPdfService LagretPdfService
@inject MobilVerktoylinjeService Verktoylinje

<PageTitle>@(_prosjekt?.Navn ?? "Serviceavtale")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke prosjektet.</p>
}
else if (_prosjekt is not null)
{
    @* "/serviceavtaler" er en skrivebord-only oversikt (viser bl.a. "Ny
       serviceavtale"-skjemaet øverst) - på mobil finnes serviceavtaler i
       stedet under fanen "Serviceavtaler" på "Alle prosjekter"-siden. Uten
       dette havnet man på skrivebordssiden sitt opprett-skjema i stedet for
       tilbake til oversikten. *@
    <a class="back-link" href="@(Verktoylinje.ErMobilvisning ? "/prosjekter?fane=serviceavtaler" : "/serviceavtaler")">&larr; Tilbake til serviceavtaler</a>

    @* Oppsett "Kort med faner" (oktober 2026): samme rolige kort som
       dashbordet, ticket og arbeidsordre, med en ny Oversikt-fane. *@
    <div class="sa-hode">
        <h1>@_prosjekt.Navn</h1>
        <span class="sa-pill">Serviceavtale</span>
        @if (_runder.Count > 0)
        {
            <span class="sa-pill sa-pill-gronn"><Icon Name="check" />@_runder.Count @(_runder.Count == 1 ? "servicerunde" : "servicerunder")</span>
        }
    </div>

    <div class="sa-kort">
        <div class="sa-info">
            <span><Icon Name="users" /><b>@(_prosjekt.Kunde?.Navn ?? "Ingen kunde satt")</b>@(string.IsNullOrWhiteSpace(_prosjekt.Kontaktperson) ? "" : $" · {_prosjekt.Kontaktperson}")</span>
            @if (!string.IsNullOrWhiteSpace(_prosjekt.Adresse))
            {
                <span><Icon Name="map-pin" /><b>@_prosjekt.Adresse</b></span>
            }
            <span><Icon Name="door" /><b>@_dorer.Count @(_dorer.Count == 1 ? "dør" : "dører")</b></span>
            <span><Icon Name="calendar" />Neste service <b>@(NesteService?.ToString("dd.MM.yyyy") ?? "ikke planlagt")</b></span>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <label class="sa-ansvarlig" title="Personen ser denne serviceavtalen under &quot;Serviceavtaler&quot; på mobil.">
                    <Icon Name="tool" />Ansvarlig
                    <select value="@(_prosjekt.AnsvarligMontorId?.ToString() ?? "")" @onchange="EndreAnsvarligMontor">
                        <option value="">Ikke satt</option>
                        @foreach (var m in _montorer)
                        {
                            <option value="@m.Id">@m.Navn</option>
                        }
                    </select>
                </label>
            }
        </div>

        <nav class="sa-faner">
            <button type="button" class="@FaneKlasse("oversikt")" @onclick="@(() => _activeTab = "oversikt")"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="@FaneKlasse("service")" @onclick="@(() => _activeTab = "service")"><Icon Name="tool" />Service @if (_runder.Count > 0) {<em>@_runder.Count</em>}</button>
            <button type="button" class="@FaneKlasse("dorer")" @onclick="@(() => _activeTab = "dorer")"><Icon Name="door" />Dører @if (_dorer.Count > 0) {<em>@_dorer.Count</em>}</button>
            <button type="button" class="@FaneKlasse("plantegninger")" @onclick="@(() => _activeTab = "plantegninger")"><Icon Name="map" />Plantegninger</button>
            <button type="button" class="@FaneKlasse("fdv")" @onclick="@(() => _activeTab = "fdv")"><Icon Name="file-text" />FDV</button>
            @if (_naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="@FaneKlasse("prising")" @onclick="@(() => _activeTab = "prising")"><Icon Name="receipt" />Prising</button>
            }
            <button type="button" class="@FaneKlasse("avvik")" @onclick="@(() => _activeTab = "avvik")"><Icon Name="alert" />Avvik og driftsmeldinger @if (ApneAvvikOgMeldinger.Count > 0) {<em class="r">@ApneAvvikOgMeldinger.Count</em>}</button>
        </nav>

        <div class="sa-innhold">
        @if (_activeTab == "dorer")
        {
            <DorerListePanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "fdv")
        {
            <FdvPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "prising" && _naverendeRolle != BrukerRolle.Montor)
        {
            <ServicePrisingPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "avvik")
        {
            <AvvikDriftsmeldingPanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "plantegninger")
        {
            <PlantegningerListePanel ProsjektId="ProsjektId" />
        }
        else if (_activeTab == "oversikt")
        {
            <div class="sa-neste">
                @if (NesteService is { } neste)
                {
                    <span class="sa-kal"><small>@neste.ToString("MMM", Kultur).TrimEnd('.')</small><b>@neste.Day</b><span>@neste.ToString("dddd", Kultur)</span></span>
                    <span class="sa-neste-tekst"><b>@NesteTekst(neste)</b><small>@_dorer.Count dører@(AnsvarligNavn is null ? "" : $" · {AnsvarligNavn} er ansvarlig")</small></span>
                }
                else
                {
                    <span class="sa-kal sa-kal-tom"><Icon Name="calendar" /></span>
                    <span class="sa-neste-tekst"><b>Ingen service er planlagt</b><small>Planlegg neste runde under Service</small></span>
                }
                <button type="button" class="sa-knapp sa-knapp-p" @onclick="@(() => _activeTab = "service")"><Icon Name="plus" />Registrer runde</button>
            </div>

            <div class="sa-kpis">
                <div class="sa-kpi"><small>Siste service</small><b>@(SisteRunde?.Dato.ToString("dd.MM.yyyy") ?? "–")</b><span>@(SisteRunde is null ? "ingen runder ennå" : $"{SisteRunde.UtfortAvNavn ?? "ukjent"} · {SidenTekst(SisteRunde.Dato)}")</span></div>
                <div class="sa-kpi"><small>Runder i @DateTime.Today.Year</small><b>@_runder.Count(r => r.Dato.Year == DateTime.Today.Year)</b><span>@_planlagteRunder.Count planlagt</span></div>
                <div class="sa-kpi"><small>Åpne avvik og meldinger</small><b class="@(ApneAvvikOgMeldinger.Count > 0 ? "sa-rodtekst" : "")">@ApneAvvikOgMeldinger.Count</b><span>@_apneAvvik.Count avvik · @(ApneAvvikOgMeldinger.Count - _apneAvvik.Count) meldinger</span></div>
                <div class="sa-kpi"><small>Byttede deler i @DateTime.Today.Year</small><b>@DelerIAr.Count</b><span>på @DelerIAr.Select(d => d.DorNummer).Where(n => n is not null).Distinct().Count() dører</span></div>
            </div>

            <div class="sa-g2">
                <section class="sa-tile">
                    <div class="sa-tile-t"><h3>Siste servicerunder</h3><button type="button" class="sa-lenke" @onclick="@(() => _activeTab = "service")">Alle →</button></div>
                    @if (_runder.Count == 0)
                    {
                        <p class="sa-tom">Ingen servicerunder registrert ennå.</p>
                    }
                    @foreach (var r in _runder.Take(2))
                    {
                        @RundeKort(r, false)
                    }
                </section>

                <div class="sa-kol">
                    <section class="sa-tile">
                        <div class="sa-tile-t"><h3>Sjekkpunkter for avtalen</h3><small>gjøres hver runde</small></div>
                        @if (_sjekklistemal.Count == 0 && _avtalePunkter.Count == 0)
                        {
                            <p class="sa-tom">Ingen sjekkpunkter ennå. Legg til punkter som skal gjøres hver runde.</p>
                        }
                        @foreach (var p in _sjekklistemal)
                        {
                            @SjekkpunktStatus(p.Tekst, "felles", null)
                        }
                        @foreach (var p in _avtalePunkter)
                        {
                            @SjekkpunktStatus(p.Tekst, "fast", p)
                        }
                        @if (_naverendeRolle != BrukerRolle.Montor)
                        {
                            <div class="sa-nytt-punkt">
                                <input @bind="_nyttFastPunkt" @bind:event="oninput" placeholder="Legg til fast sjekkpunkt..." @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilFastPunkt(); } })" />
                                <button type="button" class="sa-knapp sa-knapp-p sa-knapp-liten" @onclick="LeggTilFastPunkt" disabled="@string.IsNullOrWhiteSpace(_nyttFastPunkt)"><Icon Name="plus" />Legg til</button>
                            </div>
                        }
                    </section>

                    <section class="sa-tile">
                        <div class="sa-tile-t"><h3>Åpne avvik og meldinger</h3><button type="button" class="sa-lenke" @onclick="@(() => _activeTab = "avvik")">Se →</button></div>
                        @if (ApneAvvikOgMeldinger.Count == 0)
                        {
                            <p class="sa-tom">Ingen åpne avvik eller driftsmeldinger.</p>
                        }
                        @foreach (var a in ApneAvvikOgMeldinger.Take(4))
                        {
                            <a class="sa-rad" href="@a.Lenke">
                                <span class="sa-ik @(a.ErAvvik ? "rod" : "")"><Icon Name="@(a.ErAvvik ? "alert" : "mail")" /></span>
                                <span><b>@a.Tittel</b><small>@a.Undertekst</small></span>
                                <span class="sa-chip @(a.ErAvvik ? "rod" : "gul")">@a.Status</span>
                            </a>
                        }
                    </section>

                    <section class="sa-tile">
                        <div class="sa-tile-t"><h3>Avtalen</h3></div>
                        <div class="sa-egen"><span>Kunde</span><span>@(_prosjekt.Kunde?.Navn ?? "Ikke satt")</span></div>
                        @if (!string.IsNullOrWhiteSpace(_prosjekt.Kontaktperson))
                        {
                            <div class="sa-egen"><span>Kontaktperson</span><span>@_prosjekt.Kontaktperson@(string.IsNullOrWhiteSpace(_prosjekt.Telefon) ? "" : $" · {_prosjekt.Telefon}")</span></div>
                        }
                        <div class="sa-egen"><span>Dører</span><span>@_dorer.Count</span></div>
                        <div class="sa-egen"><span>Første servicerunde</span><span>@(_runder.LastOrDefault()?.Dato.ToString("dd.MM.yyyy") ?? "–")</span></div>
                        <div class="sa-egen"><span>Ansvarlig</span><span>@(AnsvarligNavn ?? "Ikke satt")</span></div>
                    </section>
                </div>
            </div>
        }
        else
        {
            <div class="sa-g2">
                <section class="sa-tile">
                    <div class="sa-tile-t"><h3>Registrer servicerunde</h3><small>huk av sjekkpunktene underveis</small></div>

                    <div class="sa-steg @(_apneSteg.Contains(1) ? "apen" : "")">
                        <button type="button" class="sa-steg-t" @onclick="@(() => VekslSteg(1))"><i>1</i><span><b>Hva ble gjort</b><small>Dato, status og anbefalinger</small></span><span class="sa-pil">@(_apneSteg.Contains(1) ? "▾" : "▸")</span></button>
                        @if (_apneSteg.Contains(1))
                        {
                            <div class="sa-steg-inn">
                                <div class="sa-to">
                                    <label class="sa-felt">Dato<input type="date" @bind="_nyDato" /></label>
                                    <label class="sa-felt">Neste planlagte service (valgfritt)<input type="date" @bind="_nyNesteServiceDato" /></label>
                                </div>
                                <label class="sa-felt">Status og utført arbeid<textarea rows="4" @bind="_nyStatusBeskrivelse" @bind:event="oninput" placeholder="Hva ble sjekket/gjort på denne servicerunden?"></textarea></label>
                                <label class="sa-felt">Anbefalinger (valgfritt)<textarea rows="3" @bind="_nyAnbefalinger" placeholder="Eventuelle anbefalinger dersom noe ble oppdaget"></textarea></label>
                            </div>
                        }
                    </div>

                    <div class="sa-steg @(_apneSteg.Contains(2) ? "apen" : "")">
                        <button type="button" class="sa-steg-t" @onclick="@(() => VekslSteg(2))"><i>2</i><span><b>Sjekkliste</b><small>Huk av det som er gjort · @_nyeSjekkpunkter.Count(p => p.Fullfort) av @_nyeSjekkpunkter.Count</small></span><span class="sa-pil">@(_apneSteg.Contains(2) ? "▾" : "▸")</span></button>
                        @if (_apneSteg.Contains(2))
                        {
                            <div class="sa-steg-inn">
                                @if (_nyeSjekkpunkter.Count == 0)
                                {
                                    <p class="sa-tom">Ingen sjekkpunkter. Legg til under.</p>
                                }
                                @foreach (var p in _nyeSjekkpunkter)
                                {
                                    <div class="sa-sjekk @(p.Fullfort ? "ok" : "")">
                                        <button type="button" class="sa-bx" title="@(p.Fullfort ? "Fjern avhuking" : "Huk av")" @onclick="@(() => p.Fullfort = !p.Fullfort)">@(p.Fullfort ? "✓" : "")</button>
                                        <span>@p.Tekst</span>
                                        <small>@p.Kilde</small>
                                        @if (p.Kilde == "kun denne runden")
                                        {
                                            <button type="button" class="sa-fjern" title="Fjern" @onclick="@(() => _nyeSjekkpunkter.Remove(p))">×</button>
                                        }
                                    </div>
                                }
                                <div class="sa-nytt-punkt sa-nytt-punkt-3">
                                    <input @bind="_nyttRundePunkt" @bind:event="oninput" placeholder="Nytt sjekkpunkt, f.eks. «Sjekk fukt i karm D-117»" @onkeydown="@(async e => { if (e.Key == "Enter") { await LeggTilRundePunkt(); } })" />
                                    <select @bind="_nyttPunktFast">
                                        <option value="False">Kun denne runden</option>
                                        @if (_naverendeRolle != BrukerRolle.Montor)
                                        {
                                            <option value="True">Alle runder (fast)</option>
                                        }
                                    </select>
                                    <button type="button" class="sa-knapp sa-knapp-p sa-knapp-liten" @onclick="LeggTilRundePunkt" disabled="@string.IsNullOrWhiteSpace(_nyttRundePunkt)"><Icon Name="plus" />Legg til</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="sa-steg @(_apneSteg.Contains(3) ? "apen" : "")">
                        <button type="button" class="sa-steg-t" @onclick="@(() => VekslSteg(3))"><i>3</i><span><b>Byttede deler</b><small>Valgfritt · @(_nyeDeler.Count == 0 ? "ingen lagt til" : $"{_nyeDeler.Count} lagt til")</small></span><span class="sa-pil">@(_apneSteg.Contains(3) ? "▾" : "▸")</span></button>
                        @if (_apneSteg.Contains(3))
                        {
                            <div class="sa-steg-inn">
                                @foreach (var d in _nyeDeler)
                                {
                                    <div @key="d" class="sa-delrad">
                                        <select @bind="d.DorId">
                                            <option value="">Ingen spesifikk dør</option>
                                            @foreach (var dor in _dorer)
                                            {
                                                <option value="@dor.Id">@dor.Dornummer</option>
                                            }
                                        </select>
                                        <input type="date" @bind="d.Dato" />
                                        <input type="text" @bind="d.Beskrivelse" placeholder="Hva ble byttet" />
                                        <input type="text" @bind="d.Feil" placeholder="Hva var galt (valgfritt)" />
                                        <button type="button" class="sa-fjern" title="Fjern" @onclick="@(() => _nyeDeler.Remove(d))">×</button>
                                    </div>
                                }
                                <button type="button" class="sa-knapp sa-knapp-liten" @onclick="LeggTilDelRad"><Icon Name="plus" />Legg til byttet del</button>
                            </div>
                        }
                    </div>

                    <div class="sa-steg @(_apneSteg.Contains(4) ? "apen" : "")">
                        <button type="button" class="sa-steg-t" @onclick="@(() => VekslSteg(4))"><i>4</i><span><b>Bilder</b><small>Valgfritt · @(_nyeBilder.Count == 0 ? "ingen valgt" : $"{_nyeBilder.Count} valgt")</small></span><span class="sa-pil">@(_apneSteg.Contains(4) ? "▾" : "▸")</span></button>
                        @if (_apneSteg.Contains(4))
                        {
                            <div class="sa-steg-inn">
                                <label class="sa-slipp">
                                    <Icon Name="upload" />
                                    <span><b>Last opp bilder</b><br />Dra og slipp, eller velg fra maskinen din</span>
                                    <InputFile OnChange="LastOppBilder" accept="image/*" multiple />
                                </label>
                                @if (!string.IsNullOrEmpty(_bildeFeil))
                                {
                                    <p class="form-error">@_bildeFeil</p>
                                }
                                @if (_nyeBilder.Count > 0)
                                {
                                    <div class="sa-bilder">
                                        @foreach (var b in _nyeBilder)
                                        {
                                            <div @key="b" class="sa-bilde">
                                                <img src="@b.DataUrl" alt="@b.Filnavn" />
                                                <button type="button" class="sa-fjern" title="Fjern" @onclick="@(() => _nyeBilder.Remove(b))">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="sa-steg @(_apneSteg.Contains(5) ? "apen" : "")">
                        <button type="button" class="sa-steg-t" @onclick="@(() => VekslSteg(5))"><i>5</i><span><b>Forside til rapporten</b><small>Valgfritt · velg mal eller skriv selv</small></span><span class="sa-pil">@(_apneSteg.Contains(5) ? "▾" : "▸")</span></button>
                        @if (_apneSteg.Contains(5))
                        {
                            <div class="sa-steg-inn">
                                <div class="sa-malrad">
                                    <select @bind="_valgtForsideMalId">
                                        <option value="">Velg forside...</option>
                                        @foreach (var f in _forsideMaler)
                                        {
                                            <option value="@f.Id">@f.Navn</option>
                                        }
                                    </select>
                                    <button type="button" class="sa-knapp sa-knapp-liten" @onclick="BrukForsideMal" disabled="@(_valgtForsideMalId is null)">Bruk</button>
                                </div>
                                <ForsideTekstRedigering @bind-Value="_nyForside" Rows="6" Placeholder="Forsidetekst som legges først i den genererte servicerapporten." />
                            </div>
                        }
                    </div>

                    <div class="sa-registrer">
                        @if (!string.IsNullOrEmpty(_savedMessage))
                        {
                            <span class="save-success">@_savedMessage</span>
                        }
                        <button type="button" class="sa-knapp" @onclick="@(() => RegistrerRunde(false))" disabled="@string.IsNullOrWhiteSpace(_nyStatusBeskrivelse)"><Icon Name="check" />Registrer servicerunde</button>
                        <button type="button" class="sa-knapp sa-knapp-p" @onclick="@(() => RegistrerRunde(true))" disabled="@string.IsNullOrWhiteSpace(_nyStatusBeskrivelse)"><Icon Name="file-text" />Registrer og generer rapport</button>
                    </div>
                </section>

                <div class="sa-kol">
                    <section class="sa-tile">
                        <div class="sa-tile-t"><h3>Planlagte runder</h3></div>
                        @if (_planlagteRunder.Count == 0)
                        {
                            <p class="sa-tom">Ingen runder planlagt.</p>
                        }
                        @foreach (var p in _planlagteRunder)
                        {
                            var dager = (p.Dato.Date - DateTime.Today).Days;
                            <div @key="p.Id" class="sa-plan">
                                <span class="sa-kal"><small>@p.Dato.ToString("MMM", Kultur).TrimEnd('.')</small><b>@p.Dato.Day</b><span>@p.Dato.ToString("ddd", Kultur).TrimEnd('.')</span></span>
                                <span><b>Servicerunde</b><small class="@(dager < 0 ? "sa-rodtekst" : "")">@(dager < 0 ? $"{-dager} dager over tiden" : dager == 0 ? "i dag" : $"om {dager} dager") · @p.Dato.ToString("dd.MM.yyyy")</small></span>
                                <button type="button" class="sa-fjern" title="Fjern" @onclick="@(() => SlettPlanlagtRunde(p.Id))">×</button>
                            </div>
                        }
                        <div class="sa-nytt-punkt">
                            <input type="date" @bind="_planlagtDato" />
                            <button type="button" class="sa-knapp sa-knapp-liten" @onclick="PlanleggServicerunde" disabled="@(_planlagtDato is null)"><Icon Name="calendar" />Planlegg</button>
                        </div>
                    </section>

                    <section class="sa-tile">
                        <div class="sa-tile-t"><h3>Historikk</h3><small>@_runder.Count runder</small></div>
                        @if (_runder.Count == 0)
                        {
                            <p class="sa-tom">Ingen servicerunder registrert ennå.</p>
                        }
                        @foreach (var r in _runder)
                        {
                            @RundeKort(r, true)
                        }
                    </section>
                </div>
            </div>
        }
        </div>
    </div>

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av servicerapport" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreServicerapportPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int ProsjektId { get; set; }

    // ?fane=service / avvik / dorer ... åpner riktig fane direkte (brukes fra
    // knappene i serviceavtale-listen, f.eks. «Planlegg runde»).
    [SupplyParameterFromQuery(Name = "fane")] public string? Fane { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _activeTab = "oversikt";
    private string FaneKlasse(string tab) => _activeTab == tab ? "sa-fane aktiv" : "sa-fane";

    private sealed class DelRad
    {
        public int Id { get; set; }
        public string? DorNummer { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateTime Dato { get; set; }
    }

    private sealed class SjekkRad
    {
        public int Id { get; set; }
        public string Tekst { get; set; } = "";
        public int Rekkefolge { get; set; }
        public bool Fullfort { get; set; }
        public DateTime? FullfortDato { get; set; }
        public string? FullfortAvNavn { get; set; }
    }

    private sealed class RundeRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string? UtfortAvNavn { get; set; }
        public string StatusBeskrivelse { get; set; } = "";
        public string? Anbefalinger { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public bool ErPlanlagt { get; set; }
        public List<DelRad> Deler { get; set; } = [];
        public List<SjekkRad> Sjekkpunkter { get; set; } = [];
        public List<int> BildeIder { get; set; } = [];
    }

    private sealed class DorOption
    {
        public int Id { get; set; }
        public string Dornummer { get; set; } = "";
    }

    private sealed class NyDelRad
    {
        public int? DorId { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateOnly Dato { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    private sealed class NyttBildeRad
    {
        public required byte[] Data { get; set; }
        public required string ContentType { get; set; }
        public required string Filnavn { get; set; }
        public string DataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Data)}";
    }

