    // Status for et sjekkpunkt fra siste runde (OK / ikke huket av), med
    // mulighet til å fjerne avtalens egne faste punkter.
    private RenderFragment SjekkpunktStatus(string tekst, string kilde, ServiceavtaleSjekkpunkt? fast) => __builder =>
    {
        var sist = SisteRunde?.Sjekkpunkter.FirstOrDefault(p => p.Tekst == tekst);
        <div class="sa-sjekk @(sist?.Fullfort == true ? "ok" : sist is not null ? "avvik" : "")">
            <span class="sa-bx sa-bx-status">@(sist?.Fullfort == true ? "✓" : "")</span>
            <span>@tekst</span>
            <small>@(sist is null ? kilde : sist.Fullfort ? $"OK {SisteRunde!.Dato:dd.MM}" : $"Ikke gjort {SisteRunde!.Dato:dd.MM}")</small>
            @if (fast is not null && _naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="sa-fjern" title="Fjern fast sjekkpunkt" @onclick="@(() => FjernFastPunkt(fast))">×</button>
            }
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_loadedId == ProsjektId)
        {
            return;
        }

        _loadedId = ProsjektId;
        _activeTab = Fane is "oversikt" or "service" or "dorer" or "plantegninger" or "fdv" or "prising" or "avvik" ? Fane : "oversikt";
        _notFound = false;
        _savedMessage = null;
        NullstillSkjema();

        _prosjekt = await Db.Prosjekter
            .Include(p => p.Kunde)
            .FirstOrDefaultAsync(p => p.Id == ProsjektId);

        if (_prosjekt is null)
        {
            _notFound = true;
            return;
        }

        _montorer = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Montor && b.Aktiv)
            .OrderBy(b => b.Navn)
            .ToListAsync();

        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .OrderBy(d => d.Dornummer)
            .Select(d => new DorOption { Id = d.Id, Dornummer = d.Dornummer })
            .ToListAsync();
        _sjekklistemal = await Db.ServicerundeSjekklistepunkter.OrderBy(p => p.Rekkefolge).ToListAsync();
        _avtalePunkter = await Db.ServiceavtaleSjekkpunkter.Where(p => p.ProsjektId == ProsjektId).OrderBy(p => p.Rekkefolge).ToListAsync();
        ByggNyeSjekkpunkter();

        _apneAvvik = await Db.Avvik
            .Include(a => a.Dor)
            .Where(a => a.Dor!.ProsjektId == ProsjektId && a.Status != AvvikStatus.Godkjent)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();
        _apneMeldinger = (await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.Dor!.ProsjektId == ProsjektId)))
            .Where(m => m.ErApen)
            .ToList();

        await LastRunderAsync();
    }

    // Sjekklisten for neste runde: felles mal + avtalens faste punkter.
    // Punkter lagt til "kun denne runden" beholdes til runden er registrert.
    private void ByggNyeSjekkpunkter()
    {
        var engangs = _nyeSjekkpunkter.Where(p => p.Kilde == "kun denne runden").ToList();
        _nyeSjekkpunkter = _sjekklistemal.Select(p => new NyttSjekkpunkt { Tekst = p.Tekst, Kilde = "felles" })
            .Concat(_avtalePunkter.Select(p => new NyttSjekkpunkt { Tekst = p.Tekst, Kilde = "fast" }))
            .Concat(engangs)
            .ToList();
    }

    private void NullstillSkjema()
    {
        _nyDato = DateOnly.FromDateTime(DateTime.Today);
        _nyStatusBeskrivelse = "";
        _nyAnbefalinger = null;
        _nyNesteServiceDato = null;
        _nyForside = null;
        _valgtForsideMalId = null;
        _nyeDeler = [];
        _nyeBilder = [];
        _bildeFeil = null;
        _nyeSjekkpunkter = [];
        _nyttRundePunkt = "";
        _nyttPunktFast = false;
    }

    private async Task EndreAnsvarligMontor(ChangeEventArgs e)
    {
        if (_prosjekt is null)
        {
            return;
        }

        var verdi = e.Value as string;
        _prosjekt.AnsvarligMontorId = string.IsNullOrEmpty(verdi) ? null : int.Parse(verdi);
        await Db.SaveChangesAsync();
    }

    private void BrukForsideMal()
    {
        if (_valgtForsideMalId is null)
        {
            return;
        }

        var mal = _forsideMaler.FirstOrDefault(f => f.Id == _valgtForsideMalId);
        if (mal is not null)
        {
            _nyForside = mal.Innhold;
        }
    }

    // ---------- sjekkpunkter ----------
    private async Task LeggTilFastPunkt()
    {
        var tekst = _nyttFastPunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        await LagreFastPunkt(tekst);
        _nyttFastPunkt = "";
    }

    private async Task LeggTilRundePunkt()
    {
        var tekst = _nyttRundePunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        if (_nyttPunktFast && _naverendeRolle != BrukerRolle.Montor)
        {
            await LagreFastPunkt(tekst);
        }
        else
        {
            _nyeSjekkpunkter.Add(new NyttSjekkpunkt { Tekst = tekst, Kilde = "kun denne runden" });
        }

        _nyttRundePunkt = "";
    }

    private async Task LagreFastPunkt(string tekst)
    {
        var punkt = new ServiceavtaleSjekkpunkt
        {
            ProsjektId = ProsjektId,
            Tekst = tekst,
            Rekkefolge = _avtalePunkter.Count == 0 ? 1 : _avtalePunkter.Max(p => p.Rekkefolge) + 1
        };
        Db.ServiceavtaleSjekkpunkter.Add(punkt);
        await Db.SaveChangesAsync();
        _avtalePunkter.Add(punkt);

        // Legg det nye faste punktet også inn i runden som registreres nå.
        var engangs = _nyeSjekkpunkter.Where(p => p.Kilde == "kun denne runden").ToList();
        var forFaste = _nyeSjekkpunkter.Except(engangs).ToList();
        forFaste.Add(new NyttSjekkpunkt { Tekst = tekst, Kilde = "fast" });
        _nyeSjekkpunkter = forFaste.Concat(engangs).ToList();
    }

    private async Task FjernFastPunkt(ServiceavtaleSjekkpunkt punkt)
    {
        var entitet = await Db.ServiceavtaleSjekkpunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
        if (entitet is not null)
        {
            Db.ServiceavtaleSjekkpunkter.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _avtalePunkter.Remove(punkt);
        _nyeSjekkpunkter.RemoveAll(p => p.Kilde == "fast" && p.Tekst == punkt.Tekst);
    }

    // ---------- runder ----------
    private async Task LastRunderAsync()
    {
        var alle = await Db.Servicerunder
            .Where(r => r.ProsjektId == ProsjektId)
            .Include(r => r.UtfortAvBruker)
            .OrderByDescending(r => r.Dato)
            .Select(r => new RundeRad
            {
                Id = r.Id,
                Dato = r.Dato,
                UtfortAvNavn = r.UtfortAvBruker != null ? r.UtfortAvBruker.Navn : null,
                StatusBeskrivelse = r.StatusBeskrivelse,
                Anbefalinger = r.Anbefalinger,
                NesteServiceDato = r.NesteServiceDato,
                ErPlanlagt = r.ErPlanlagt,
                Deler = r.Deler.OrderBy(d => d.Dato).Select(d => new DelRad
                {
                    Id = d.Id,
                    DorNummer = d.Dor != null ? d.Dor.Dornummer : null,
                    Beskrivelse = d.Beskrivelse,
                    Feil = d.Feil,
                    Dato = d.Dato
                }).ToList(),
                Sjekkpunkter = r.Sjekkpunkter.OrderBy(p => p.Rekkefolge).Select(p => new SjekkRad
                {
                    Id = p.Id,
                    Tekst = p.Tekst,
                    Rekkefolge = p.Rekkefolge,
                    Fullfort = p.Fullfort,
                    FullfortDato = p.FullfortDato,
                    FullfortAvNavn = p.FullfortAvBruker != null ? p.FullfortAvBruker.Navn : null
                }).ToList(),
                BildeIder = r.Media.Select(m => m.Id).ToList()
            })
            .ToListAsync();

        _runder = alle.Where(r => !r.ErPlanlagt).ToList();
        _planlagteRunder = alle.Where(r => r.ErPlanlagt).OrderBy(r => r.Dato).ToList();

        _lagredePdfer = [];
        foreach (var r in _runder)
        {
            _lagredePdfer[r.Id] = await LagretPdfService.HentAsync("Servicerunde", r.Id);
        }
    }

    private async Task PlanleggServicerunde()
    {
        if (_planlagtDato is null)
        {
            return;
        }

        var runde = new Servicerunde
        {
            ProsjektId = ProsjektId,
            Dato = _planlagtDato.Value.ToDateTime(TimeOnly.MinValue),
            StatusBeskrivelse = "",
            ErPlanlagt = true
        };

        Db.Servicerunder.Add(runde);
        await Db.SaveChangesAsync();

        _planlagtDato = DateOnly.FromDateTime(DateTime.Today);
        await LastRunderAsync();
    }

    private async Task SlettPlanlagtRunde(int rundeId)
    {
        var entitet = await Db.Servicerunder.FirstOrDefaultAsync(r => r.Id == rundeId && r.ErPlanlagt);
        if (entitet is not null)
        {
            Db.Servicerunder.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        await LastRunderAsync();
    }

    private void VisRapportForhandsvisning(int rundeId)
    {
        _aktivRundeId = rundeId;
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/servicerunde/{rundeId}/pdf";
    }

    private async Task LagreServicerapportPdf()
    {
        if (_aktivRundeId is not { } rundeId)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(rundeId);
        if (bytes is null)
        {
            return;
        }

        var runde = _runder.FirstOrDefault(r => r.Id == rundeId);
        var pdf = await LagretPdfService.LagreAsync(
            "Servicerunde", rundeId, $"Servicerapport - {runde?.Dato.ToString("dd.MM.yyyy")} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        if (!_lagredePdfer.TryGetValue(rundeId, out var liste))
        {
            liste = [];
            _lagredePdfer[rundeId] = liste;
        }
        liste.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret under «Vis detaljer» på runden.";
    }

    private void LeggTilDelRad()
    {
        _nyeDeler.Add(new NyDelRad());
    }

    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        _bildeFeil = null;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            _nyeBilder.Add(new NyttBildeRad
            {
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name
            });
        }
    }

    private async Task RegistrerRunde(bool genererRapport)
    {
        if (string.IsNullOrWhiteSpace(_nyStatusBeskrivelse))
        {
            return;
        }

        var runde = new Servicerunde
        {
            ProsjektId = ProsjektId,
            Dato = _nyDato.ToDateTime(TimeOnly.MinValue),
            UtfortAvBrukerId = _naverendeBrukerId,
            StatusBeskrivelse = _nyStatusBeskrivelse.Trim(),
            Anbefalinger = string.IsNullOrWhiteSpace(_nyAnbefalinger) ? null : _nyAnbefalinger.Trim(),
            NesteServiceDato = _nyNesteServiceDato?.ToDateTime(TimeOnly.MinValue),
            Forside = string.IsNullOrWhiteSpace(_nyForside) ? null : _nyForside
        };

        foreach (var d in _nyeDeler.Where(d => !string.IsNullOrWhiteSpace(d.Beskrivelse)))
        {
            runde.Deler.Add(new ServicerundeDel
            {
                DorId = d.DorId,
                Beskrivelse = d.Beskrivelse.Trim(),
                Feil = string.IsNullOrWhiteSpace(d.Feil) ? null : d.Feil.Trim(),
                Dato = d.Dato.ToDateTime(TimeOnly.MinValue)
            });
        }

        // Sjekklisten slik den er huket av i skjemaet (felles mal, faste punkter og engangspunkter).
        var rekkefolge = 1;
        foreach (var punkt in _nyeSjekkpunkter)
        {
            runde.Sjekkpunkter.Add(new ServicerundeSjekkpunkt
            {
                Tekst = punkt.Tekst,
                Rekkefolge = rekkefolge++,
                Fullfort = punkt.Fullfort,
                FullfortDato = punkt.Fullfort ? DateTime.Now : null,
                FullfortAvBrukerId = punkt.Fullfort ? _naverendeBrukerId : null
            });
        }

        foreach (var b in _nyeBilder)
        {
            runde.Media.Add(new ServicerundeMedia
            {
                Data = b.Data,
                ContentType = b.ContentType,
                Filnavn = b.Filnavn
            });
        }

        Db.Servicerunder.Add(runde);
        await Db.SaveChangesAsync();

        NullstillSkjema();
        ByggNyeSjekkpunkter();
        _savedMessage = "Servicerunde registrert.";

        await LastRunderAsync();

        if (genererRapport)
        {
            VisRapportForhandsvisning(runde.Id);
        }
    }

    private async Task ToggleSjekkpunkt(SjekkRad rad)
    {
        var entitet = await Db.ServicerundeSjekkpunkter.FirstOrDefaultAsync(p => p.Id == rad.Id);
        if (entitet is null)
        {
            return;
        }

        rad.Fullfort = !rad.Fullfort;
        entitet.Fullfort = rad.Fullfort;
        entitet.FullfortDato = rad.Fullfort ? DateTime.Now : null;
        entitet.FullfortAvBrukerId = rad.Fullfort ? _naverendeBrukerId : null;
        await Db.SaveChangesAsync();

        await LastRunderAsync();
    }
}
