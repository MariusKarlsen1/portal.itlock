    private static string KrKort(decimal v) => "kr " + v.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"));

    private sealed record OppmSak(string Farge, string Ikon, string Tittel, string Tekst, string Knapp, string? Lenke = null);

    private List<OppmSak> Oppmerksomhet(ServiceRegelMotor.AvtaleStatus st)
    {
        var l = new List<OppmSak>();
        if (_naverendeRolle == BrukerRolle.Montor)
        {
            return l;
        }
        if (st.Endringer > 0)
        {
            l.Add(new("gul", "tag", $"{st.Endringer} {(st.Endringer == 1 ? "dør har" : "dører har")} endret servicekategori", "Siden prisen ble godkjent. Avtaleprisen endres ikke før du godkjenner på nytt.", "Se prising"));
        }
        if (st.Godkjent is null && st.Beregnet > 0)
        {
            l.Add(new("gul", "receipt", "Avtaleprisen er ikke godkjent", $"Beregnet {KrKort(st.Beregnet)} per år eks. mva.", "Godkjenn"));
        }
        else if (st.PrisAvviker && st.Endringer == 0)
        {
            l.Add(new("gul", "receipt", "Ny beregning avviker fra godkjent pris", $"Godkjent {KrKort(st.Godkjent.Value)} – beregnet nå {KrKort(st.Beregnet)} per år.", "Se prising"));
        }
        if (st.Regelmodell && st.IkkeKategorisert > 0)
        {
            l.Add(new("rod", "alert", $"{st.IkkeKategorisert} {(st.IkkeKategorisert == 1 ? "dør er" : "dører er")} ikke kategorisert", "Ingen prisregel treffer – dørene får ingen pris.", "Prisregler", "/service-prisregler"));
        }
        if (st.Regelmodell && st.Konflikter > 0)
        {
            l.Add(new("rod", "alert", $"{st.Konflikter} {(st.Konflikter == 1 ? "dør treffer" : "dører treffer")} to prisregler", "Første regel brukes til konflikten er løst.", "Prisregler", "/service-prisregler"));
        }
        if (_uspesifisert > 0)
        {
            l.Add(new("gul", "tag", $"{_uspesifisert} {(_uspesifisert == 1 ? "komponent" : "komponenter")} uten produkt", "Fra befaringen – bare komponenttypen er registrert. Velg produkt nå, eller la montøren gjøre det i runden.", "Spesifiser", $"/serviceavtaler/{ProsjektId}/spesifiser"));
        }
        return l;
    }

    private async Task LastRunderAsync()
    {
        var alle = await Db.Servicerunder
            .Where(r => r.ProsjektId == ProsjektId)
            .Include(r => r.UtfortAvBruker)
            .OrderByDescending(r => r.Dato)
            .Select(r => new RundeRad
            {
                Id = r.Id,
                Dato = r.Dato,
                UtfortAvNavn = r.UtfortAvBruker != null ? r.UtfortAvBruker.Navn : null,
                StatusBeskrivelse = r.StatusBeskrivelse,
                Anbefalinger = r.Anbefalinger,
                NesteServiceDato = r.NesteServiceDato,
                ErPlanlagt = r.ErPlanlagt,
                Deler = r.Deler.OrderBy(d => d.Dato).Select(d => new DelRad
                {
                    Id = d.Id,
                    DorNummer = d.Dor != null ? d.Dor.Dornummer : null,
                    Beskrivelse = d.Beskrivelse,
                    Feil = d.Feil,
                    Dato = d.Dato
                }).ToList(),
                Sjekkpunkter = r.Sjekkpunkter.OrderBy(p => p.Rekkefolge).Select(p => new SjekkRad
                {
                    Id = p.Id,
                    Tekst = p.Tekst,
                    Rekkefolge = p.Rekkefolge,
                    Fullfort = p.Fullfort,
                    FullfortDato = p.FullfortDato,
                    FullfortAvNavn = p.FullfortAvBruker != null ? p.FullfortAvBruker.Navn : null
                }).ToList(),
                BildeIder = r.Media.Select(m => m.Id).ToList()
            })
            .ToListAsync();

        _runder = alle.Where(r => !r.ErPlanlagt).ToList();
        _planlagteRunder = alle.Where(r => r.ErPlanlagt).OrderBy(r => r.Dato).ToList();

        _lagredePdfer = [];
        foreach (var r in _runder)
        {
            _lagredePdfer[r.Id] = await LagretPdfService.HentAsync("Servicerunde", r.Id);
        }
    }

