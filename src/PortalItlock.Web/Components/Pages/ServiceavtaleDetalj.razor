                        <label class="sa-felt">Telefon<input type="tel" @bind="ra.Telefon" @bind:event="oninput" /></label>
                    </div>
                    <label class="sa-felt">Adresse<input @bind="ra.Adresse" @bind:event="oninput" /></label>
