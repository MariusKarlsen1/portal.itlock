                    <button type="button" class="sa-knapp sa-knapp-p" @onclick="LagreAvtale">Lagre</button>
                </div>
            </div>
        </div>
    }

}

@code {
    [Parameter] public int ProsjektId { get; set; }

    // ?fane=service / avvik / dorer ... åpner riktig fane direkte (brukes fra
    // knappene i serviceavtale-listen, f.eks. «Planlegg runde»).
    [SupplyParameterFromQuery(Name = "fane")] public string? Fane { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private string _activeTab = "oversikt";
    private string FaneKlasse(string tab) => _activeTab == tab ? "sa-fane aktiv" : "sa-fane";

    private sealed class DelRad
    {
        public int Id { get; set; }
        public string? DorNummer { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateTime Dato { get; set; }
    }

    private sealed class SjekkRad
    {
        public int Id { get; set; }
        public string Tekst { get; set; } = "";
        public int Rekkefolge { get; set; }
        public bool Fullfort { get; set; }
        public DateTime? FullfortDato { get; set; }
        public string? FullfortAvNavn { get; set; }
    }

    private sealed class RundeRad
    {
        public int Id { get; set; }
        public DateTime Dato { get; set; }
        public string? UtfortAvNavn { get; set; }
        public string StatusBeskrivelse { get; set; } = "";
        public string? Anbefalinger { get; set; }
        public DateTime? NesteServiceDato { get; set; }
        public bool ErPlanlagt { get; set; }
        public List<DelRad> Deler { get; set; } = [];
        public List<SjekkRad> Sjekkpunkter { get; set; } = [];
        public List<int> BildeIder { get; set; } = [];
    }

    private sealed class DorOption
    {
        public int Id { get; set; }
        public string Dornummer { get; set; } = "";
    }

    private sealed class NyDelRad
    {
        public int? DorId { get; set; }
        public string Beskrivelse { get; set; } = "";
        public string? Feil { get; set; }
        public DateOnly Dato { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    private sealed class NyttBildeRad
    {
        public required byte[] Data { get; set; }
        public required string ContentType { get; set; }
        public required string Filnavn { get; set; }
        public string DataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Data)}";
    }

    // Et sjekkpunkt på runden som registreres nå: fra felles mal, avtalens
    // faste punkter, eller lagt til bare for denne runden.
    private sealed class NyttSjekkpunkt
    {
        public required string Tekst { get; set; }
        public required string Kilde { get; set; }
        public bool Fullfort { get; set; }
    }

    private sealed record AvvikEllerMelding(string Tittel, string Undertekst, string Status, bool ErAvvik, string Lenke, DateTime Dato);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private BrukerRolle? _naverendeRolle;

    private Prosjekt? _prosjekt;
    private bool _notFound;
    private int? _loadedId;
    private List<RundeRad> _runder = [];
    private List<RundeRad> _planlagteRunder = [];
    private DateOnly? _planlagtDato = DateOnly.FromDateTime(DateTime.Today);
    private string? _savedMessage;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private int? _aktivRundeId;
    private Dictionary<int, List<LagretPdf>> _lagredePdfer = [];
    private readonly HashSet<int> _utfoldedeRunder = [];
    private readonly HashSet<int> _apneSteg = [1, 2];

    private DateOnly _nyDato = DateOnly.FromDateTime(DateTime.Today);
    private string _nyStatusBeskrivelse = "";
    private string? _nyAnbefalinger;
    private DateOnly? _nyNesteServiceDato;
    private string? _nyForside;
    private List<TilbudForside> _forsideMaler = [];
    private int? _valgtForsideMalId;
    private List<DorOption> _dorer = [];
    private List<NyDelRad> _nyeDeler = [];
    private List<ServicerundeSjekklistepunkt> _sjekklistemal = [];
    private List<ServiceavtaleSjekkpunkt> _avtalePunkter = [];
    private List<NyttSjekkpunkt> _nyeSjekkpunkter = [];
    private string _nyttRundePunkt = "";
    private bool _nyttPunktFast;
    private string _nyttFastPunkt = "";
    private List<NyttBildeRad> _nyeBilder = [];
    private string? _bildeFeil;
    private List<Bruker> _montorer = [];
    private List<Avvik> _apneAvvik = [];
    private List<DriftHelper.MeldingStatus> _apneMeldinger = [];

    // ---------- avledede verdier til oversikten ----------
    private RundeRad? SisteRunde => _runder.FirstOrDefault();

    private DateTime? NesteService =>
        _planlagteRunder.Where(r => r.Dato.Date >= DateTime.Today).Select(r => (DateTime?)r.Dato).FirstOrDefault()
        ?? (SisteRunde?.NesteServiceDato is { } d && d.Date >= DateTime.Today ? d : null);

    private string? AnsvarligNavn => _montorer.FirstOrDefault(m => m.Id == _prosjekt?.AnsvarligMontorId)?.Navn;

    private List<DelRad> DelerIAr => _runder.SelectMany(r => r.Deler).Where(d => d.Dato.Year == DateTime.Today.Year).ToList();

    private List<AvvikEllerMelding> ApneAvvikOgMeldinger => _apneAvvik
        .Select(a => new AvvikEllerMelding(
            $"{a.Dor?.Dornummer} · {Forkort(a.Beskrivelse, 60)}",
            $"Avvik · {a.OpprettetDato:dd.MM.yyyy}",
            a.Status.Visningsnavn(), true, $"/dor/{a.DorId}", a.OpprettetDato))
        .Concat(_apneMeldinger.Select(m => new AvvikEllerMelding(
            $"{m.Melding.Dor?.Dornummer} · {(string.IsNullOrWhiteSpace(m.Melding.Tittel) ? Forkort(m.Melding.Tekst, 60) : m.Melding.Tittel)}",
            $"Driftsmelding · {m.Melding.InnmeldtAvBruker?.Navn ?? "ukjent"} · {m.Melding.OpprettetDato:dd.MM.yyyy}",
            m.Navn, false, $"/driftsmelding/{m.Melding.Id}", m.Melding.OpprettetDato)))
        .OrderByDescending(x => x.Dato)
        .ToList();

    private static string Forkort(string tekst, int maks) => tekst.Length <= maks ? tekst : tekst[..maks].TrimEnd() + "…";

    private static string NesteTekst(DateTime dato)
    {
        var dager = (dato.Date - DateTime.Today).Days;
        return dager switch
        {
            0 => "Neste service er i dag",
            1 => "Neste service er i morgen",
            _ => $"Neste service om {dager} dager"
        };
    }

    private static string SidenTekst(DateTime dato)
    {
        var dager = (DateTime.Today - dato.Date).Days;
        if (dager < 31) { return dager <= 0 ? "i dag" : dager == 1 ? "i går" : $"{dager} dager siden"; }
        var mnd = dager / 30;
        return mnd < 12 ? $"{mnd} mnd siden" : $"{mnd / 12} år siden";
    }

    private void VekslSteg(int steg)
    {
        if (!_apneSteg.Add(steg))
        {
            _apneSteg.Remove(steg);
        }
    }

    // ---------- gjenbrukbare biter ----------
    private RenderFragment RundeKort(RundeRad r, bool full) => __builder =>
    {
        var apen = _utfoldedeRunder.Contains(r.Id);
        <div class="sa-runde @(_redigererRundeId == r.Id ? "sd-redigeres" : "")" @key="r.Id">
            <span class="sa-kal"><small>@r.Dato.ToString("MMM", Kultur).TrimEnd('.')</small><b>@r.Dato.Day</b><span>@r.Dato.Year</span></span>
            <div class="sa-runde-innhold">
                <b>Servicerunde@(r.UtfortAvNavn is null ? "" : $" · {r.UtfortAvNavn}")@if (_redigererRundeId == r.Id) {<span class="sd-merke">redigeres nå</span>}</b>
                <p>@r.StatusBeskrivelse</p>
                @if (!string.IsNullOrWhiteSpace(r.Anbefalinger))
                {
                    <div class="sa-anbefaling"><b>Anbefaling:</b> @r.Anbefalinger</div>
                }
                <div class="sa-chips">
                    @if (r.Deler.Count > 0)
                    {
                        <span class="sa-chip">@r.Deler.Count byttede deler</span>
                    }
                    @if (r.Sjekkpunkter.Count > 0)
                    {
                        <span class="sa-chip @(r.Sjekkpunkter.All(p => p.Fullfort) ? "gronn" : "")">sjekkliste @r.Sjekkpunkter.Count(p => p.Fullfort)/@r.Sjekkpunkter.Count</span>
                    }
                    @if (r.NesteServiceDato.HasValue)
                    {
                        <span class="sa-chip">neste: @r.NesteServiceDato.Value.ToString("dd.MM.yyyy")</span>
                    }
                </div>
                @if (r.BildeIder.Count > 0)
                {
                    <div class="sa-mini">
                        @foreach (var bildeId in r.BildeIder.Take(full ? 8 : 4))
                        {
                            <a href="@($"/servicerundemedia/{bildeId}")" target="_blank"><img src="@($"/servicerundemedia/{bildeId}")" alt="Bilde fra servicerunden" loading="lazy" /></a>
                        }
                    </div>
                }
                @if (full && (r.Deler.Count > 0 || r.Sjekkpunkter.Count > 0 || _lagredePdfer.GetValueOrDefault(r.Id, []).Count > 0))
                {
                    <button type="button" class="sa-lenke sa-detaljer-knapp" @onclick="@(() => { if (!_utfoldedeRunder.Add(r.Id)) { _utfoldedeRunder.Remove(r.Id); } })">@(apen ? "Skjul detaljer ▴" : "Vis detaljer ▾")</button>
                    @if (apen)
                    {
                        @if (r.Deler.Count > 0)
                        {
                            <div class="sa-detalj">
                                <h4>Byttede deler</h4>
                                @foreach (var d in r.Deler)
                                {
                                    <div class="sa-detalj-rad" @key="d.Id">@d.Dato.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(d.DorNummer) ? "" : $" · Dør {d.DorNummer}") · @d.Beskrivelse@(string.IsNullOrWhiteSpace(d.Feil) ? "" : $" (Feil: {d.Feil})")</div>
                                }
                            </div>
                        }
                        @if (r.Sjekkpunkter.Count > 0)
                        {
                            <div class="sa-detalj">
                                <h4>Sjekkliste</h4>
                                @foreach (var p in r.Sjekkpunkter)
                                {
                                    <div class="sa-sjekk @(p.Fullfort ? "ok" : "")" @key="p.Id">
                                        <button type="button" class="sa-bx" @onclick="@(() => ToggleSjekkpunkt(p))">@(p.Fullfort ? "✓" : "")</button>
                                        <span>@p.Tekst</span>
                                        <small>@(p.Fullfort && p.FullfortDato.HasValue ? $"{p.FullfortDato.Value:dd.MM.yyyy HH:mm}{(p.FullfortAvNavn is null ? "" : $" · {p.FullfortAvNavn}")}" : "")</small>
                                    </div>
                                }
                            </div>
                        }
                        <div class="sa-detalj">
                            <h4>Lagrede PDF-er</h4>
                            <LagredePdfListe Pdfer="@_lagredePdfer.GetValueOrDefault(r.Id, [])" />
                        </div>
                    }
                }
            </div>
            <div class="sa-runde-knapper">
                <button type="button" class="sa-knapp sa-knapp-p sa-knapp-liten" @onclick="@(() => VisRapportForhandsvisning(r.Id))"><Icon Name="file-text" />Generer rapport</button>
                <button type="button" class="sa-knapp sa-knapp-liten" @onclick="@(() => LastInnRunde(r.Id))"><Icon Name="edit" />Rediger</button>
            </div>
        </div>
    };

    // Status for et sjekkpunkt fra siste runde (OK / ikke huket av), med
    // mulighet til å fjerne avtalens egne faste punkter.
    private RenderFragment SjekkpunktStatus(string tekst, string kilde, ServiceavtaleSjekkpunkt? fast) => __builder =>
    {
        var sist = SisteRunde?.Sjekkpunkter.FirstOrDefault(p => p.Tekst == tekst);
        <div class="sa-sjekk @(sist?.Fullfort == true ? "ok" : sist is not null ? "avvik" : "")">
            <span class="sa-bx sa-bx-status">@(sist?.Fullfort == true ? "✓" : "")</span>
            <span>@tekst</span>
            <small>@(sist is null ? kilde : sist.Fullfort ? $"OK {SisteRunde!.Dato:dd.MM}" : $"Ikke gjort {SisteRunde!.Dato:dd.MM}")</small>
            @if (fast is not null && _naverendeRolle != BrukerRolle.Montor)
            {
                <button type="button" class="sa-fjern" title="Fjern fast sjekkpunkt" @onclick="@(() => FjernFastPunkt(fast))">×</button>
            }
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }

            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_loadedId == ProsjektId)
        {
            return;
        }

        _loadedId = ProsjektId;
        _activeTab = Fane is "oversikt" or "service" or "dorer" or "plantegninger" or "fdv" or "prising" or "avvik" ? Fane : "oversikt";
        _notFound = false;
        _savedMessage = null;
        NullstillSkjema();

        _prosjekt = await Db.Prosjekter
            .Include(p => p.Kunde)
            .FirstOrDefaultAsync(p => p.Id == ProsjektId);

        if (_prosjekt is null)
        {
            _notFound = true;
            return;
        }

        ForeslaNesteDato();

        _montorer = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Montor && b.Aktiv)
            .OrderBy(b => b.Navn)
            .ToListAsync();

        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .OrderBy(d => d.Dornummer)
            .Select(d => new DorOption { Id = d.Id, Dornummer = d.Dornummer })
            .ToListAsync();
        await LastSjekklisteAsync();
        _avtalePunkter = await Db.ServiceavtaleSjekkpunkter.Where(p => p.ProsjektId == ProsjektId).OrderBy(p => p.Rekkefolge).ToListAsync();
        ByggNyeSjekkpunkter();

        _apneAvvik = await Db.Avvik
            .Include(a => a.Dor)
            .Where(a => a.Dor!.ProsjektId == ProsjektId && a.Status != AvvikStatus.Godkjent)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();
        _apneMeldinger = (await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.Dor!.ProsjektId == ProsjektId)))
            .Where(m => m.ErApen)
            .ToList();

        await LastRunderAsync();
    }

    // Sjekklistene fra Oppsett → Sjekkliste for servicerunder. Avtalen bruker
    // sin valgte liste, eller standardlisten når den ikke har valgt noen.
    private List<ServiceSjekkliste> _sjekklister = [];

    private int? ValgtSjekklisteId =>
        _prosjekt?.ServiceSjekklisteId is int id && _sjekklister.Any(l => l.Id == id)
            ? id
            : _sjekklister.FirstOrDefault(l => l.ErStandard)?.Id;

    private async Task LastSjekklisteAsync()
    {
        _sjekklister = await Db.ServiceSjekklister
            .OrderByDescending(l => l.ErStandard).ThenBy(l => l.Navn)
            .ToListAsync();
        var listeId = ValgtSjekklisteId;
        _sjekklistemal = await Db.ServicerundeSjekklistepunkter
            .Where(p => p.ServiceSjekklisteId == listeId)
            .OrderBy(p => p.Rekkefolge)
            .ToListAsync();
    }

    private async Task VelgSjekkliste(ChangeEventArgs e)
    {
        if (_prosjekt is null || !int.TryParse(e.Value?.ToString(), out var id))
        {
            return;
        }

        // Standardlisten lagres som null, så avtalen følger med hvis en annen liste blir standard.
        int? nyVerdi = _sjekklister.FirstOrDefault(l => l.Id == id)?.ErStandard == true ? null : id;
        // Lagrer bare dette feltet, så andre ulagrede endringer på siden ikke blir med.
        await Db.Prosjekter.Where(p => p.Id == _prosjekt.Id)
            .ExecuteUpdateAsync(x => x.SetProperty(p => p.ServiceSjekklisteId, nyVerdi));
        // Oppdaterer også originalverdien, så EF ikke ser feltet som endret
        // (IsModified = false ville satt verdien tilbake til den gamle).
        var felt = Db.Entry(_prosjekt).Property(p => p.ServiceSjekklisteId);
        felt.CurrentValue = nyVerdi;
        felt.OriginalValue = nyVerdi;
        await LastSjekklisteAsync();
        ByggNyeSjekkpunkter();
    }

    // Sjekklisten for neste runde: felles mal + avtalens faste punkter.
    // Punkter lagt til "kun denne runden" beholdes til runden er registrert.
    private void ByggNyeSjekkpunkter()
    {
        var engangs = _nyeSjekkpunkter.Where(p => p.Kilde == "kun denne runden").ToList();
        _nyeSjekkpunkter = _sjekklistemal.Select(p => new NyttSjekkpunkt { Tekst = p.Tekst, Kilde = "felles" })
            .Concat(_avtalePunkter.Select(p => new NyttSjekkpunkt { Tekst = p.Tekst, Kilde = "fast" }))
            .Concat(engangs)
            .ToList();
    }

