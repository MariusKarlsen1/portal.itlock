    private async Task LastRapporter()
    {
        var runder = await Db.Servicerunder.AsNoTracking()
            .Where(r => r.ProsjektId == ProsjektId && r.DorForDor && r.FullfortDato != null)
            .OrderByDescending(r => r.Dato)
            .Select(r => new
            {
                r.Id, r.Dato, r.KundeSignertAv,
                Montor = r.UtfortAvBruker != null ? r.UtfortAvBruker.Navn : null,
                Dorer = r.Dorer.Count,
                Avvik = r.Dorer.Count(d => d.Status == ServicerundeDorStatus.Avvik)
            })
            .ToListAsync();
        var ider = runder.Select(r => r.Id).ToList();
        var pdfer = (await Db.LagredePdfer.AsNoTracking()
                .Where(x => x.EntityType == "Servicerunde" && ider.Contains(x.EntityId))
                .Select(x => new { x.Id, x.EntityId, x.OpprettetDato })
                .ToListAsync())
            .GroupBy(x => x.EntityId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.OpprettetDato).First());
        _rapporter = runder.Select(r =>
        {
            var pdf = pdfer.GetValueOrDefault(r.Id);
            return new RapportRad(r.Id, r.Dato, r.Montor, r.Dorer, r.Avvik, r.KundeSignertAv, pdf?.Id, pdf?.OpprettetDato);
        }).ToList();
    }

