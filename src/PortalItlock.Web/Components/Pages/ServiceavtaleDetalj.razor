                NesteServiceDato = r.NesteServiceDato,
                ErPlanlagt = r.ErPlanlagt,
                Deler = r.Deler.OrderBy(d => d.Dato).Select(d => new DelRad
                {
                    Id = d.Id,
                    DorNummer = d.Dor != null ? d.Dor.Dornummer : null,
                    Beskrivelse = d.Beskrivelse,
                    Feil = d.Feil,
                    Dato = d.Dato
                }).ToList(),
                Sjekkpunkter = r.Sjekkpunkter.OrderBy(p => p.Rekkefolge).Select(p => new SjekkRad
                {
