    private async Task LastOppBilder(InputFileChangeEventArgs e)
    {
        _bildeFeil = null;

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > 20_000_000)
            {
                _bildeFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            _nyeBilder.Add(new NyttBildeRad
            {
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Filnavn = file.Name
            });
        }
    }

    private async Task RegistrerRunde(bool genererRapport)
    {
        if (!HarStatus)
        {
            return;
        }

        var runde = new Servicerunde
        {
            ProsjektId = ProsjektId,
            Dato = _nyDato.ToDateTime(TimeOnly.MinValue),
            UtfortAvBrukerId = _naverendeBrukerId,
            StatusBeskrivelse = _nyStatusBeskrivelse.Trim(),
            Anbefalinger = string.IsNullOrWhiteSpace(RikTekst.TilTekst(_nyAnbefalinger)) ? null : _nyAnbefalinger!.Trim(),
            NesteServiceDato = _nyNesteServiceDato?.ToDateTime(TimeOnly.MinValue),
            Forside = string.IsNullOrWhiteSpace(_nyForside) ? null : _nyForside
        };

        foreach (var d in _nyeDeler.Where(d => !string.IsNullOrWhiteSpace(d.Beskrivelse)))
        {
            runde.Deler.Add(new ServicerundeDel
            {
                DorId = d.DorId,
                Beskrivelse = d.Beskrivelse.Trim(),
                Feil = string.IsNullOrWhiteSpace(d.Feil) ? null : d.Feil.Trim(),
                Dato = d.Dato.ToDateTime(TimeOnly.MinValue)
            });
        }

        // Sjekklisten slik den er huket av i skjemaet (felles mal, faste punkter og engangspunkter).
        var rekkefolge = 1;
        foreach (var punkt in _nyeSjekkpunkter)
        {
            runde.Sjekkpunkter.Add(new ServicerundeSjekkpunkt
            {
                Tekst = punkt.Tekst,
                Rekkefolge = rekkefolge++,
                Fullfort = punkt.Fullfort,
                FullfortDato = punkt.Fullfort ? DateTime.Now : null,
                FullfortAvBrukerId = punkt.Fullfort ? _naverendeBrukerId : null
            });
        }

        foreach (var b in _nyeBilder)
        {
            runde.Media.Add(new ServicerundeMedia
            {
                Data = b.Data,
                ContentType = b.ContentType,
                Filnavn = b.Filnavn
            });
        }

        Db.Servicerunder.Add(runde);
        if (_startFraPlanId is { } planId && await Db.Servicerunder.FirstOrDefaultAsync(x => x.Id == planId && x.ErPlanlagt && x.ProsjektId == ProsjektId) is { } plan)
        {
            Db.Servicerunder.Remove(plan);
        }
        await Db.SaveChangesAsync();

        _startFraPlanId = null;
        NullstillSkjema();
        ByggNyeSjekkpunkter();
        _savedMessage = "Servicerunde registrert.";

        await LastRunderAsync();

        if (genererRapport)
        {
            VisRapportForhandsvisning(runde.Id);
        }
    }

    private async Task ToggleSjekkpunkt(SjekkRad rad)
    {
        var entitet = await Db.ServicerundeSjekkpunkter.FirstOrDefaultAsync(p => p.Id == rad.Id);
        if (entitet is null)
        {
            return;
        }

        rad.Fullfort = !rad.Fullfort;
        entitet.Fullfort = rad.Fullfort;
        entitet.FullfortDato = rad.Fullfort ? DateTime.Now : null;
        entitet.FullfortAvBrukerId = rad.Fullfort ? _naverendeBrukerId : null;
        await Db.SaveChangesAsync();

        await LastRunderAsync();
    }

    // Rediger avtalen
    private sealed class RedAvtale
    {
        public string Navn { get; set; } = "";
        public int? KundeId { get; set; }
        public int? AnsvarligId { get; set; }
        public string? Kontaktperson { get; set; }
        public string? Telefon { get; set; }
        public string? Adresse { get; set; }
        public string? Postnr { get; set; }
        public string? Sted { get; set; }
        public int? GangerPerAr { get; set; }
    }

    private RedAvtale? _redAvtale;
    private string? _redAvtaleFeil;
    private List<(int Id, string Navn)> _kunderValg = [];

    private async Task ApneRedigerAvtale()
    {
        _bekreftFlytt = false;
        if (_prosjekt is null)
        {
            return;
        }
        _kunderValg = (await Db.Kunder.AsNoTracking().OrderBy(k => k.Navn).Select(k => new { k.Id, k.Navn }).ToListAsync())
            .Select(k => (k.Id, k.Navn)).ToList();
        _redAvtaleFeil = null;
        _redAvtale = new RedAvtale
        {
            Navn = _prosjekt.Navn,
            KundeId = _prosjekt.KundeId,
            AnsvarligId = _prosjekt.AnsvarligMontorId,
            Kontaktperson = _prosjekt.Kontaktperson,
            Telefon = _prosjekt.Telefon,
            Adresse = _prosjekt.Adresse,
            Postnr = _prosjekt.Postnr,
            Sted = _prosjekt.Sted,
            GangerPerAr = _prosjekt.ServiceGangerPerAr
        };
    }

    private bool _bekreftFlytt;

    private bool ErKobletAvtale => _prosjekt is { HarServiceavtale: true } p && p.Status != ProsjektStatus.Serviceavtale;

    private async Task FlyttTilProsjekter()
    {
        if (_prosjekt is null)
        {
            return;
        }

        // Fase 3: et prosjekt med serviceavtale-kobling beholder statusen sin -
        // bare koblingen fjernes.
        if (ErKobletAvtale)
        {
            _prosjekt.HarServiceavtale = false;
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/serviceavtaler");
            return;
        }
        _prosjekt.Status = ProsjektStatus.UnderArbeid;
        await Db.SaveChangesAsync();
        Nav.NavigateTo($"/prosjekter/{_prosjekt.Id}");
    }

    private async Task LagreAvtale()
    {
        if (_prosjekt is null || _redAvtale is not { } ra)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(ra.Navn))
        {
            _redAvtaleFeil = "Avtalen må ha et navn.";
            return;
        }

        static string? Rens(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
        _prosjekt.Navn = ra.Navn.Trim();
        if (_prosjekt.KundeId != ra.KundeId)
        {
            _prosjekt.KundeId = ra.KundeId;
            _prosjekt.Kunde = ra.KundeId is { } kid ? await Db.Kunder.FindAsync(kid) : null;
        }
        _prosjekt.AnsvarligMontorId = ra.AnsvarligId;
        _prosjekt.Kontaktperson = Rens(ra.Kontaktperson);
        _prosjekt.Telefon = Rens(ra.Telefon);
        _prosjekt.Adresse = Rens(ra.Adresse);
        _prosjekt.Postnr = Rens(ra.Postnr);
        _prosjekt.Sted = Rens(ra.Sted);
        _prosjekt.ServiceGangerPerAr = ra.GangerPerAr;
        await Db.SaveChangesAsync();
        _redAvtale = null;
    }

    // D: redigering av en registrert runde i skjemaet til venstre
    private int? _redigererRundeId;
    private DateTime _redOpprinneligDato;
    private int? _startFraPlanId;
    private List<int> _redBilder = [];
    private readonly HashSet<int> _fjernBilder = [];
    private bool _bekreftSlettRunde;

    private static string Kort(string tekst) => tekst.Length <= 50 ? tekst : tekst[..50].TrimEnd() + "…";

    private void AvbrytRedigering()
    {
        _redigererRundeId = null;
        _startFraPlanId = null;
        _redBilder = [];
        _fjernBilder.Clear();
        _bekreftSlettRunde = false;
        NullstillSkjema();
        ByggNyeSjekkpunkter();
        _apneSteg.Clear();
        _apneSteg.Add(1);
        _apneSteg.Add(2);
    }

    private void StartPlanlagt(RundeRad plan)
    {
        AvbrytRedigering();
        _startFraPlanId = plan.Id;
        _nyDato = DateOnly.FromDateTime(DateTime.Today);
        _savedMessage = null;
    }

    private async Task LastInnRunde(int rundeId)
    {
        var r = await Db.Servicerunder.AsNoTracking()
            .Where(x => x.Id == rundeId && x.ProsjektId == ProsjektId)
            .Select(x => new
            {
                x.Id,
                x.Dato,
                x.NesteServiceDato,
                x.StatusBeskrivelse,
                x.Anbefalinger,
                x.Forside,
                Deler = x.Deler.OrderBy(d => d.Dato).Select(d => new { d.DorId, d.Beskrivelse, d.Feil, d.Dato }).ToList(),
                Sjekk = x.Sjekkpunkter.OrderBy(p => p.Rekkefolge).Select(p => new { p.Tekst, p.Fullfort }).ToList(),
                Bilder = x.Media.Select(m => m.Id).ToList()
            })
            .FirstOrDefaultAsync();
        if (r is null)
        {
            return;
        }

        AvbrytRedigering();
        _skjemaNokkel++;
        _redigererRundeId = r.Id;
        _redOpprinneligDato = r.Dato;
        _nyDato = DateOnly.FromDateTime(r.Dato);
        _nyNesteServiceDato = r.NesteServiceDato is { } n ? DateOnly.FromDateTime(n) : null;
        _nesteForeslatt = false;
        _nyStatusBeskrivelse = r.StatusBeskrivelse;
        _nyAnbefalinger = r.Anbefalinger;
        _nyForside = r.Forside;
        _nyeDeler = r.Deler.Select(d => new NyDelRad { DorId = d.DorId, Beskrivelse = d.Beskrivelse, Feil = d.Feil, Dato = DateOnly.FromDateTime(d.Dato) }).ToList();
        _nyeSjekkpunkter = r.Sjekk.Select(p => new NyttSjekkpunkt { Tekst = p.Tekst, Kilde = "denne runden", Fullfort = p.Fullfort }).ToList();
        _redBilder = r.Bilder;
        _savedMessage = null;
        foreach (var s in new[] { 1, 2, 3, 4 })
        {
            _apneSteg.Add(s);
        }
    }

    private async Task LagreRedigering(bool genererRapport)
    {
        if (_redigererRundeId is not { } id || !HarStatus)
        {
            return;
        }

        var runde = await Db.Servicerunder
            .Include(x => x.Deler)
            .Include(x => x.Sjekkpunkter)
            .Include(x => x.Media)
            .FirstOrDefaultAsync(x => x.Id == id && x.ProsjektId == ProsjektId);
        if (runde is null)
        {
            AvbrytRedigering();
            return;
        }

        runde.Dato = _nyDato.ToDateTime(TimeOnly.MinValue);
        runde.NesteServiceDato = _nyNesteServiceDato?.ToDateTime(TimeOnly.MinValue);
        runde.StatusBeskrivelse = _nyStatusBeskrivelse.Trim();
        runde.Anbefalinger = string.IsNullOrWhiteSpace(RikTekst.TilTekst(_nyAnbefalinger)) ? null : _nyAnbefalinger!.Trim();
        runde.Forside = string.IsNullOrWhiteSpace(_nyForside) ? null : _nyForside;

        Db.ServicerundeDeler.RemoveRange(runde.Deler);
        foreach (var d in _nyeDeler.Where(d => !string.IsNullOrWhiteSpace(d.Beskrivelse)))
        {
            runde.Deler.Add(new ServicerundeDel
            {
                DorId = d.DorId,
                Beskrivelse = d.Beskrivelse.Trim(),
                Feil = string.IsNullOrWhiteSpace(d.Feil) ? null : d.Feil.Trim(),
                Dato = d.Dato.ToDateTime(TimeOnly.MinValue)
            });
        }

        // Sjekkpunktene beholdes der teksten er den samme, så tidspunkt og hvem som huket av står.
        var gamle = runde.Sjekkpunkter.ToList();
        var rekkefolge = 1;
        foreach (var p in _nyeSjekkpunkter)
        {
            var finnes = gamle.FirstOrDefault(g => g.Tekst == p.Tekst);
            if (finnes is not null)
            {
                gamle.Remove(finnes);
                if (finnes.Fullfort != p.Fullfort)
                {
                    finnes.Fullfort = p.Fullfort;
                    finnes.FullfortDato = p.Fullfort ? DateTime.Now : null;
                    finnes.FullfortAvBrukerId = p.Fullfort ? _naverendeBrukerId : null;
                }
                finnes.Rekkefolge = rekkefolge++;
            }
            else
            {
                runde.Sjekkpunkter.Add(new ServicerundeSjekkpunkt
                {
                    Tekst = p.Tekst,
                    Rekkefolge = rekkefolge++,
                    Fullfort = p.Fullfort,
                    FullfortDato = p.Fullfort ? DateTime.Now : null,
                    FullfortAvBrukerId = p.Fullfort ? _naverendeBrukerId : null
                });
            }
        }
        Db.ServicerundeSjekkpunkter.RemoveRange(gamle);

        foreach (var m in runde.Media.Where(m => _fjernBilder.Contains(m.Id)).ToList())
        {
            Db.ServicerundeMedia.Remove(m);
        }
        foreach (var b in _nyeBilder)
        {
            runde.Media.Add(new ServicerundeMedia { Data = b.Data, ContentType = b.ContentType, Filnavn = b.Filnavn });
        }

        await Db.SaveChangesAsync();
        AvbrytRedigering();
        _savedMessage = "Servicerunden er oppdatert.";
        await LastRunderAsync();

        if (genererRapport)
        {
            VisRapportForhandsvisning(id);
        }
    }

    private async Task SlettRundeFraSkjema()
    {
        if (_redigererRundeId is not { } id || _naverendeRolle == BrukerRolle.Montor)
        {
            return;
        }
        if (!_bekreftSlettRunde)
        {
            _bekreftSlettRunde = true;
            return;
        }
        var runde = await Db.Servicerunder.FirstOrDefaultAsync(x => x.Id == id && x.ProsjektId == ProsjektId);
        if (runde is not null)
        {
            Db.Servicerunder.Remove(runde);
            await Db.SaveChangesAsync();
        }
        AvbrytRedigering();
        _savedMessage = "Servicerunden er slettet.";
        await LastRunderAsync();
    }

    // Historikken kan filtreres på år med en nedtrekksliste.
    private string _historikkAr = "";
    private List<int> RundeAr => _runder.Select(r => r.Dato.Year).Distinct().OrderByDescending(a => a).ToList();
    private List<RundeRad> HistorikkRunder => _historikkAr == "" ? _runder : _runder.Where(r => r.Dato.Year.ToString() == _historikkAr).ToList();

    // «om 6 måneder», «om 12 dager», «i dag» eller «3 dager over tiden».
    private static string NarTekst(int dager) =>
        dager == 0 ? "i dag"
        : dager == -1 ? "1 dag over tiden"
        : dager <= -2 ? $"{-dager} dager over tiden"
        : dager == 1 ? "om 1 dag"
        : dager <= 44 ? $"om {dager} dager"
        : $"om {(int)Math.Round(dager / 30.4)} måneder";
}
