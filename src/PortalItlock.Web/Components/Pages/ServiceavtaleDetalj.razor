    {
        if (_valgtForsideMalId is null)
        {
            return;
        }

        var mal = _forsideMaler.FirstOrDefault(f => f.Id == _valgtForsideMalId);
        if (mal is not null)
        {
            _nyForside = mal.Innhold;
        }
    }

    // ---------- sjekkpunkter ----------
    private async Task LeggTilFastPunkt()
    {
        var tekst = _nyttFastPunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        await LagreFastPunkt(tekst);
        _nyttFastPunkt = "";
    }

    private async Task LeggTilRundePunkt()
    {
        var tekst = _nyttRundePunkt.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        if (_nyttPunktFast && _naverendeRolle != BrukerRolle.Montor)
        {
            await LagreFastPunkt(tekst);
        }
        else
        {
            _nyeSjekkpunkter.Add(new NyttSjekkpunkt { Tekst = tekst, Kilde = "kun denne runden" });
        }

        _nyttRundePunkt = "";
    }

    private async Task LagreFastPunkt(string tekst)
    {
        var punkt = new ServiceavtaleSjekkpunkt
        {
            ProsjektId = ProsjektId,
            Tekst = tekst,
            Rekkefolge = _avtalePunkter.Count == 0 ? 1 : _avtalePunkter.Max(p => p.Rekkefolge) + 1
        };
        Db.ServiceavtaleSjekkpunkter.Add(punkt);
        await Db.SaveChangesAsync();
        _avtalePunkter.Add(punkt);

        // Legg det nye faste punktet også inn i runden som registreres nå.
        var engangs = _nyeSjekkpunkter.Where(p => p.Kilde == "kun denne runden").ToList();
        var forFaste = _nyeSjekkpunkter.Except(engangs).ToList();
        forFaste.Add(new NyttSjekkpunkt { Tekst = tekst, Kilde = "fast" });
        _nyeSjekkpunkter = forFaste.Concat(engangs).ToList();
    }

    private async Task FjernFastPunkt(ServiceavtaleSjekkpunkt punkt)
    {
        var entitet = await Db.ServiceavtaleSjekkpunkter.FirstOrDefaultAsync(p => p.Id == punkt.Id);
        if (entitet is not null)
        {
            Db.ServiceavtaleSjekkpunkter.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _avtalePunkter.Remove(punkt);
        _nyeSjekkpunkter.RemoveAll(p => p.Kilde == "fast" && p.Tekst == punkt.Tekst);
    }

