@page "/guide/kobling/{KategoriId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Kobling - @(_kategori?.Navn ?? "")</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else if (_kategori is not null)
{
    @* B2 (kobling-forslag): skjemaene til venstre og valgt skjema til høyre, i
       ett kort med grå hoder. Fanene deler på alle, prosjekter og maler. *@
    <SideKort Nokkel="kobling-kategori">
    <div class="kk-innhold">
        <a class="back-link kk-tilbake" href="/guide/kobling"><Icon Name="arrow-left" />Til kobling</a>

        <header class="kk-topp">
            <div class="kk-topp-tekst">
                <h1>@_kategori.Navn</h1>
                <p>@(string.IsNullOrWhiteSpace(_kategori.Gruppe) ? "Andre" : _kategori.Gruppe) · @_skjemaer.Count koblingsskjema</p>
            </div>
            @if (KanOppretteSkjema)
            {
                <button type="button" class="kk-knapp kk-knapp-primaer" @onclick="@(() => _visNytt = !_visNytt)"><Icon Name="plus" />Nytt skjema</button>
            }
        </header>

        <div class="kk-faner" role="tablist">
            <button type="button" role="tab" aria-selected="@(_visning == "alle" ? "true" : "false")" class="@(_visning == "alle" ? "aktiv" : "")" @onclick='@(() => VelgVisning("alle"))'>Alle skjemaer <small>@_skjemaer.Count</small></button>
            <button type="button" role="tab" aria-selected="@(_visning == "prosjekt" ? "true" : "false")" class="@(_visning == "prosjekt" ? "aktiv" : "")" @onclick='@(() => VelgVisning("prosjekt"))'>På prosjekter <small>@_skjemaer.Count(s => s.ProsjektId != null)</small></button>
            <button type="button" role="tab" aria-selected="@(_visning == "mal" ? "true" : "false")" class="@(_visning == "mal" ? "aktiv" : "")" @onclick='@(() => VelgVisning("mal"))'>Maler <small>@_skjemaer.Count(s => s.ProsjektId == null)</small></button>
        </div>

        <div class="kk-delt">
            <section class="kk-ramme">
                <div class="kk-gra">Skjemaer</div>
                <label class="kk-sok">
                    <Icon Name="search" />
                    <input @bind="_sok" @bind:event="oninput" placeholder="Søk etter skjema eller prosjekt" aria-label="Søk etter skjema eller prosjekt" />
                </label>
                <div class="kk-rader">
                    @foreach (var s in _filtrerte)
                    {
                        <div @key="s.Id" class="kk-rad @(s.Id == _valgtId ? "valgt" : "")" @onclick="@(() => VelgSkjema(s.Id))">
                            <span class="kk-mini"><KoblingsSkjemaMiniPreview Symboler="s.Symboler" Streker="s.Streker" /></span>
                            <span class="kk-rad-tekst">
                                <b>@s.Navn</b>
                                <small>@MetaTekst(s)</small>
                            </span>
                            @if (KanEndreSkjema)
                            {
                                <RadMeny Navn="@s.Navn" RedigerHref="@($"/koblingsskjema/{s.Id}?rediger=1")"
                                         OnSlett="@(() => { _slettSkjemaId = s.Id; _slettSkjemaNavn = s.Navn; })" />
                            }
                        </div>
                    }
                </div>
                @if (_filtrerte.Count == 0)
                {
                    <p class="kk-ingen">@(_skjemaer.Count == 0 ? "Ingen koblingsskjema laget ennå." : "Ingen treff.")</p>
                }
                @if (_visNytt && KanOppretteSkjema)
                {
                    <div class="kk-nytt">
                        <input @bind="_nyttNavn" @bind:event="oninput"
                               @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettSkjema(); } })"
                               placeholder="Navn på nytt koblingsskjema" aria-label="Navn på nytt koblingsskjema" />
                        <button type="button" class="kk-knapp kk-knapp-primaer" @onclick="OpprettSkjema" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)"><Icon Name="plus" />Lag</button>
                    </div>
                }
            </section>

            <section class="kk-ramme">
                @if (_valgt is null)
                {
                    <div class="kk-gra">Skjema</div>
                    <div class="kk-velg">
                        <Icon Name="file-text" />
                        <span>Velg et koblingsskjema i listen</span>
                    </div>
                }
                else
                {
                    <div class="kk-gra">
                        <span>@_valgt.Navn</span>
                        <a class="kk-knapp kk-knapp-liten" href="@($"/koblingsskjema/{_valgt.Id}/pdf")" target="_blank" rel="noopener"><Icon Name="download" />Last ned PDF</a>
                    </div>
                    <div class="kk-zoom">
                        <button type="button" @onclick="ZoomUt" title="Zoom ut" aria-label="Zoom ut"><Icon Name="minus" /></button>
                        <span>@($"{_zoom * 100:0}%")</span>
                        <button type="button" @onclick="ZoomInn" title="Zoom inn" aria-label="Zoom inn"><Icon Name="plus" /></button>
                        <button type="button" @onclick="ZoomReset" title="Tilpass skjerm" aria-label="Tilpass skjerm"><Icon Name="maximize" /></button>
                        <small>@SkjemaInfo(_valgt)</small>
                    </div>
                    <div class="kk-tegning">
                        <div class="kk-flate" style="transform: scale(@(_zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)))">
                            <KoblingsSkjemaMiniPreview Symboler="_valgt.Symboler" Streker="_valgt.Streker" />
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
    </SideKort>
    <SlettDialog Type="SletteType.Koblingsskjema" Id="_slettSkjemaId" Navn="@_slettSkjemaNavn"
                 OnLukk="@(() => _slettSkjemaId = null)" OnSlettet="SkjemaSlettet" />
}

@code {
    [Parameter] public int KategoriId { get; set; }

    private bool _ugyldigKategori;
    private KoblingsKategori? _kategori;
    private List<KoblingsSkjema> _skjemaer = [];
    private int? _valgtId;
    private string _sok = "";
    private string _nyttNavn = "";
    private int? _loadetKategoriId;
    private double _zoom = 1.0;

    // Fanene i kortet: alle, de som er koblet til et prosjekt, og maler (uten prosjekt).
    private string _visning = "alle";
    private bool _visNytt;

    private List<KoblingsSkjema> _filtrerte => _skjemaer
        .Where(s => _visning switch
        {
            "prosjekt" => s.ProsjektId != null,
            "mal" => s.ProsjektId == null,
            _ => true
        })
        .Where(s => string.IsNullOrWhiteSpace(_sok)
            || s.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (s.Prosjekt?.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private void VelgVisning(string visning)
    {
        _visning = visning;
        if (_valgtId is null || !_filtrerte.Any(s => s.Id == _valgtId))
        {
            var forste = _filtrerte.FirstOrDefault();
            if (forste is not null)
            {
                VelgSkjema(forste.Id);
            }
        }
    }

    private KoblingsSkjema? _valgt => _skjemaer.FirstOrDefault(s => s.Id == _valgtId);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private BrukerRolle? _naverendeRolle;

    // Kobling er det ene unntaket for montører: de kan lage NYE skjema, men
    // ikke endre eller slette de som ligger der fra før. Begge sjekkene gjøres
    // også i metodene, ikke bare på knappene.
    private bool KanOppretteSkjema => ModulRettigheter.KanOpprette(_naverendeRolle, "guide/kobling");
    private bool KanEndreSkjema => ModulRettigheter.KanRedigere(_naverendeRolle, "guide/kobling");

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
            {
                _naverendeRolle = rolle;
            }
        }

        if (_loadetKategoriId == KategoriId)
        {
            return;
        }

        _loadetKategoriId = KategoriId;

        var kategori = await Db.KoblingsKategorier.FirstOrDefaultAsync(k => k.Id == KategoriId);
        if (kategori is null)
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _kategori = kategori;

        await LastSkjemaer();
    }

    private async Task LastSkjemaer()
    {
        _skjemaer = await Db.KoblingsSkjemaer
            .Where(s => s.KategoriId == KategoriId)
            .Include(s => s.Symboler)
            .Include(s => s.Streker)
            .Include(s => s.Prosjekt)
            .Include(s => s.Dor)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato)
            .ToListAsync();

        if (_valgtId is null || !_skjemaer.Any(s => s.Id == _valgtId))
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
        }
    }

    private void VelgSkjema(int id)
    {
        _valgtId = id;
        _zoom = 1.0;
    }

    private void ZoomInn() => _zoom = Math.Min(2.5, Math.Round(_zoom + 0.1, 2));
    private void ZoomUt() => _zoom = Math.Max(0.3, Math.Round(_zoom - 0.1, 2));
    private void ZoomReset() => _zoom = 1.0;

    private async Task OpprettSkjema()
    {
        if (!KanOppretteSkjema)
        {
            return;
        }

        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var skjema = new KoblingsSkjema { KategoriId = KategoriId, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    private static string MetaTekst(KoblingsSkjema s)
    {
        var dato = s.OppdatertDato is null
            ? $"Opprettet {s.OpprettetDato:dd.MM.yyyy}"
            : $"Oppdatert {s.OppdatertDato:dd.MM.yyyy}";
        var antall = s.Symboler.Count;
        return antall == 1 ? $"{dato} · 1 symbol" : $"{dato} · {antall} symboler";
    }

    // Prosjekt eller mal, dør og versjon samlet på linjen over tegningen.
    private static string SkjemaInfo(KoblingsSkjema s)
    {
        var deler = new List<string> { s.Prosjekt?.Navn ?? "Mal" };
        if (s.Dor is not null)
        {
            deler.Add($"dør {s.Dor.Dornummer}");
        }

        if (!string.IsNullOrWhiteSpace(s.Versjon))
        {
            deler.Add($"v{s.Versjon}");
        }

        return string.Join(" · ", deler);
    }

    // Sletting fra ⋯-menyen i listen (bekreftes i SlettDialog).
    private int? _slettSkjemaId;
    private string? _slettSkjemaNavn;

    private void SkjemaSlettet(int id)
    {
        _skjemaer.RemoveAll(s => s.Id == id);
        if (_valgtId == id)
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
        }
    }
}
