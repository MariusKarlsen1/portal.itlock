@page "/guide/kobling/{Kategori}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Kobling - @_tittel</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else
{
    <a class="back-link" href="/guide/kobling">&larr; Tilbake til kobling</a>
    <h1>Kobling - @_tittel</h1>

    @if (_skjemaer.Count == 0)
    {
        <p class="list-empty">Ingen koblingsskjema laget ennå.</p>
    }
    else
    {
        <ul class="kobling-skjema-list">
            @foreach (var s in _skjemaer)
            {
                <li @key="s.Id" class="kobling-skjema-item">
                    <a href="@($"/koblingsskjema/{s.Id}")">@s.Navn</a>
                    <span class="kobling-skjema-meta">@(s.OppdatertDato ?? s.OpprettetDato).ToString("dd.MM.yyyy")</span>
                    <AuthorizeView Roles="Admin">
                        <button type="button" class="remove-button" @onclick="@(() => SlettSkjema(s))">Slett</button>
                    </AuthorizeView>
                </li>
            }
        </ul>
    }

    <AuthorizeView Roles="Admin">
        <div class="kobling-nytt-skjema">
            <input @bind="_nyttNavn" @bind:event="oninput" placeholder="Navn på nytt koblingsskjema" />
            <button type="button" class="add-button" @onclick="OpprettSkjema" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Nytt skjema</button>
        </div>
    </AuthorizeView>
}

@code {
    [Parameter] public string Kategori { get; set; } = "";

    private bool _ugyldigKategori;
    private KoblingsKategori _kategori;
    private string _tittel = "";
    private List<KoblingsSkjema> _skjemaer = [];
    private string _nyttNavn = "";
    private string? _loadetKategori;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetKategori == Kategori)
        {
            return;
        }

        _loadetKategori = Kategori;

        if (!Enum.TryParse<KoblingsKategori>(Kategori, true, out _kategori))
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _tittel = _kategori.Visningsnavn();

        _skjemaer = await Db.KoblingsSkjemaer
            .Where(s => s.Kategori == _kategori)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato)
            .ToListAsync();
    }

    private async Task OpprettSkjema()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var skjema = new KoblingsSkjema { Kategori = _kategori, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    private async Task SlettSkjema(KoblingsSkjema s)
    {
        Db.KoblingsSkjemaer.Remove(s);
        await Db.SaveChangesAsync();
        _skjemaer.Remove(s);
    }
}
