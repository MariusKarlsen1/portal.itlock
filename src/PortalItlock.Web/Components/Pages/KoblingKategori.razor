@page "/guide/kobling/{KategoriId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Kobling - @(_kategori?.Navn ?? "")</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else if (_kategori is not null)
{
    <a class="back-link" href="/guide/kobling"><Icon Name="arrow-left" />Tilbake til kobling</a>

    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="@_kategori.Ikon" /></span>
            <div>
                <h1>Kobling – @_kategori.Navn</h1>
                <p class="section-hint">Velg et koblingsskjema i listen for å se det, eller velg komponenter for å bygge eget skjema.</p>
            </div>
        </div>
        <AuthorizeView Roles="Admin">
            <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "knapp-ghost")" @onclick="ToggleRedigerModus">
                <Icon Name="edit" />
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        </AuthorizeView>
    </div>

    @if (_skjemaer.Count == 0 && !_redigerModus)
    {
        <p class="list-empty">Ingen koblingsskjema laget ennå.</p>
    }
    else
    {
        <div class="master-detail">
            <div class="master-panel">
                <div class="search-box">
                    <Icon Name="search" />
                    <input @bind="_sok" @bind:event="oninput" placeholder="Søk i skjema …" />
                </div>
                @foreach (var s in _filtrerte)
                {
                    <div @key="s.Id" class="master-row @(s.Id == _valgtId ? "master-row-valgt" : "")" @onclick="@(() => VelgSkjema(s.Id))">
                        <span class="master-row-preview"><KoblingsSkjemaMiniPreview Symboler="s.Symboler" Streker="s.Streker" /></span>
                        <div class="master-row-tekst">
                            <span class="master-row-navn">@s.Navn</span>
                            <span class="master-row-meta">@MetaTekst(s)</span>
                        </div>
                        <Icon Name="chevron-right" />
                    </div>
                }
                @if (_filtrerte.Count == 0)
                {
                    <p class="list-empty master-tomt-sok">Ingen treff.</p>
                }
                @if (_redigerModus)
                {
                    <div class="master-nytt">
                        <input @bind="_nyttNavn" @bind:event="oninput"
                               @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettSkjema(); } })"
                               placeholder="Navn på nytt koblingsskjema" />
                        <button type="button" class="knapp knapp-primaer" @onclick="OpprettSkjema" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)"><Icon Name="plus" />Nytt skjema</button>
                    </div>
                }
            </div>

            <div class="detail-panel">
                @if (_valgt is null)
                {
                    <div class="detail-tomt">
                        <Icon Name="file-text" />
                        <span>Velg et koblingsskjema i listen</span>
                    </div>
                }
                else
                {
                    <div class="skjema-hoved">
                        <div class="skjema-header">
                            <div class="skjema-header-venstre">
                                <span class="skjema-header-ikon skjema-header-ikon-@_kategori.Farge"><Icon Name="@_kategori.Ikon" /></span>
                                <div>
                                    <h2>@_valgt.Navn</h2>
                                    <div class="skjema-tags">
                                        <span class="skjema-tag"><Icon Name="@_kategori.Ikon" />@_kategori.Navn</span>
                                        <span class="skjema-tag"><Icon Name="file-text" />Systemskjema</span>
                                        <span class="skjema-tag-dato">Oppdatert @DatoTekst(_valgt)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="skjema-toolbar">
                                <a class="knapp knapp-primaer" href="@($"/koblingsskjema/{_valgt.Id}/pdf")" target="_blank"><Icon Name="download" />Last ned PDF</a>
                                <a class="knapp knapp-ghost" href="@($"/koblingsskjema/{_valgt.Id}/pdf")" target="_blank"><Icon Name="printer" />Skriv ut</a>
                                <AuthorizeView Roles="Admin">
                                    <div class="skjema-mer-wrap">
                                        <button type="button" class="skjema-mer-knapp" @onclick="@(() => _visMerMeny = !_visMerMeny)" title="Mer"><Icon Name="more-vertical" /></button>
                                        @if (_visMerMeny)
                                        {
                                            <div class="skjema-mer-meny">
                                                <a href="@($"/koblingsskjema/{_valgt.Id}")"><Icon Name="maximize" />Åpne i skjema-editor</a>
                                                @if (_slettId == _valgt.Id)
                                                {
                                                    <div class="skjema-mer-slett-confirm">
                                                        <span>Slette «@_valgt.Navn»?</span>
                                                        <div class="skjema-mer-slett-confirm-rad">
                                                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettSkjema(_valgt))">Ja, slett</button>
                                                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" class="skjema-mer-slett-knapp" @onclick="@(() => _slettId = _valgt.Id)"><Icon Name="x" />Slett skjema</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </AuthorizeView>
                            </div>
                        </div>

                        <div class="skjema-zoom-rad">
                            <button type="button" @onclick="ZoomUt" title="Zoom ut"><Icon Name="minus" /></button>
                            <span class="skjema-zoom-tall">@($"{_zoom * 100:0}%")</span>
                            <button type="button" @onclick="ZoomInn" title="Zoom inn"><Icon Name="plus" /></button>
                            <button type="button" @onclick="ZoomReset" title="Tilpass skjerm"><Icon Name="maximize" /></button>
                        </div>

                        <div class="skjema-diagram-ramme">
                            <div class="skjema-diagram-flate" style="transform: scale(@(_zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)))">
                                <KoblingsSkjemaMiniPreview Symboler="_valgt.Symboler" Streker="_valgt.Streker" />
                            </div>
                        </div>
                    </div>

                    <div class="skjema-sidepanel">
                        <div class="skjema-faner">
                            <button type="button" class="@(_fane == "info" ? "aktiv" : "")" @onclick='@(() => _fane = "info")'>Informasjon</button>
                            <button type="button" class="@(_fane == "komponenter" ? "aktiv" : "")" @onclick='@(() => _fane = "komponenter")'>Komponenter</button>
                            <button type="button" class="@(_fane == "notater" ? "aktiv" : "")" @onclick='@(() => _fane = "notater")'>Notater</button>
                        </div>

                        @if (_fane == "info")
                        {
                            <div class="skjema-info-seksjon">
                                <h3>Om skjemaet</h3>
                                @if (_redigerModus)
                                {
                                    <div class="skjema-info-rediger">
                                        <label>
                                            Beskrivelse
                                            <textarea @bind="_redigerBeskrivelse" @bind:event="oninput" rows="2" placeholder="Kort beskrivelse av skjemaet"></textarea>
                                        </label>
                                        <label>
                                            Versjon
                                            <input @bind="_redigerVersjon" @bind:event="oninput" placeholder="f.eks. 1.0" />
                                        </label>
                                        <button type="button" class="knapp knapp-primaer skjema-info-lagre" @onclick="LagreInfo">Lagre</button>
                                    </div>
                                }
                                else
                                {
                                    <dl class="skjema-info-liste">
                                        <div><dt>System</dt><dd>@_kategori.Navn</dd></div>
                                        <div><dt>Beskrivelse</dt><dd>@(string.IsNullOrWhiteSpace(_valgt.Beskrivelse) ? "–" : _valgt.Beskrivelse)</dd></div>
                                        <div><dt>Sist oppdatert</dt><dd>@DatoTekst(_valgt)</dd></div>
                                        <div><dt>Versjon</dt><dd>@(string.IsNullOrWhiteSpace(_valgt.Versjon) ? "–" : _valgt.Versjon)</dd></div>
                                        <div><dt>Filformat</dt><dd>PDF/SVG</dd></div>
                                    </dl>
                                }
                            </div>
                        }
                        else if (_fane == "komponenter")
                        {
                            <div class="skjema-info-seksjon">
                                <h3>Komponenter</h3>
                                @if (_valgt.Komponenter.Count == 0)
                                {
                                    <p class="list-empty skjema-produkt-tomt">Ingen komponenter lagt til ennå.</p>
                                }
                                else
                                {
                                    <table class="skjema-komponent-tabell">
                                        <thead>
                                            <tr>
                                                <th>Produkt</th>
                                                <th>Type</th>
                                                @if (_redigerModus)
                                                {
                                                    <th></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var k in _valgt.Komponenter.OrderBy(k => k.Rekkefolge))
                                            {
                                                <tr @key="k.Id">
                                                    <td><Icon Name="@k.Ikon" />@k.Navn</td>
                                                    <td>@k.Type</td>
                                                    @if (_redigerModus)
                                                    {
                                                        <td><button type="button" class="skjema-komponent-slett" title="Slett" @onclick="@(() => SlettKomponent(k))"><Icon Name="x" /></button></td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }

                                @if (_redigerModus)
                                {
                                    <div class="skjema-komponent-nytt">
                                        <select @bind="_nyKomponentIkon">
                                            @foreach (var ikon in IkonValg)
                                            {
                                                <option value="@ikon">@ikon</option>
                                            }
                                        </select>
                                        <input @bind="_nyKomponentNavn" @bind:event="oninput" placeholder="Produktnavn" />
                                        <input @bind="_nyKomponentType" @bind:event="oninput" placeholder="Type (f.eks. Kontroller)" />
                                        <button type="button" class="knapp knapp-primaer" @onclick="LeggTilKomponent" disabled="@string.IsNullOrWhiteSpace(_nyKomponentNavn)"><Icon Name="plus" />Legg til produkt</button>
                                    </div>
                                }
                            </div>
                        }
                        else if (_fane == "notater")
                        {
                            <div class="skjema-info-seksjon">
                                <h3>Notater</h3>
                                @if (_redigerModus)
                                {
                                    <textarea class="skjema-notater-tekst" @bind="_redigerNotater" @bind:event="oninput" rows="10" placeholder="Skriv notater om dette koblingsskjemaet …"></textarea>
                                    <button type="button" class="knapp knapp-primaer skjema-info-lagre" @onclick="LagreNotater">Lagre notater</button>
                                }
                                else if (string.IsNullOrWhiteSpace(_valgt.Notater))
                                {
                                    <p class="list-empty skjema-produkt-tomt">Ingen notater lagt til ennå.</p>
                                }
                                else
                                {
                                    <p class="skjema-notater-visning">@_valgt.Notater</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private static readonly string[] IkonValg = ["box", "server", "shield", "tool", "lock", "door", "file-text", "settings"];

    [Parameter] public int KategoriId { get; set; }

    private bool _ugyldigKategori;
    private KoblingsKategori? _kategori;
    private List<KoblingsSkjema> _skjemaer = [];
    private bool _redigerModus;
    private int? _slettId;
    private int? _valgtId;
    private string _sok = "";
    private string _nyttNavn = "";
    private int? _loadetKategoriId;
    private string _fane = "info";
    private double _zoom = 1.0;
    private bool _visMerMeny;

    private string _redigerBeskrivelse = "";
    private string _redigerVersjon = "";
    private string _redigerNotater = "";

    private string _nyKomponentNavn = "";
    private string _nyKomponentType = "";
    private string _nyKomponentIkon = "box";

    private List<KoblingsSkjema> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _skjemaer
        : _skjemaer.Where(s => s.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private KoblingsSkjema? _valgt => _skjemaer.FirstOrDefault(s => s.Id == _valgtId);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetKategoriId == KategoriId)
        {
            return;
        }

        _loadetKategoriId = KategoriId;

        var kategori = await Db.KoblingsKategorier.FirstOrDefaultAsync(k => k.Id == KategoriId);
        if (kategori is null)
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _kategori = kategori;

        await LastSkjemaer();
        LastRedigerUtkast();
    }

    private async Task LastSkjemaer()
    {
        _skjemaer = await Db.KoblingsSkjemaer
            .Where(s => s.KategoriId == KategoriId)
            .Include(s => s.Symboler)
            .Include(s => s.Streker)
            .Include(s => s.Prosjekt)
            .Include(s => s.Komponenter)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato)
            .ToListAsync();

        if (_valgtId is null || !_skjemaer.Any(s => s.Id == _valgtId))
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
        }
    }

    private void VelgSkjema(int id)
    {
        _valgtId = id;
        _visMerMeny = false;
        _slettId = null;
        _zoom = 1.0;
        LastRedigerUtkast();
    }

    private void LastRedigerUtkast()
    {
        _redigerBeskrivelse = _valgt?.Beskrivelse ?? "";
        _redigerVersjon = _valgt?.Versjon ?? "";
        _redigerNotater = _valgt?.Notater ?? "";
    }

    private void ZoomInn() => _zoom = Math.Min(2.5, Math.Round(_zoom + 0.1, 2));
    private void ZoomUt() => _zoom = Math.Max(0.3, Math.Round(_zoom - 0.1, 2));
    private void ZoomReset() => _zoom = 1.0;

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
        _visMerMeny = false;
        _nyttNavn = "";
        LastRedigerUtkast();
    }

    private async Task OpprettSkjema()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var skjema = new KoblingsSkjema { KategoriId = KategoriId, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    private async Task SlettSkjema(KoblingsSkjema s)
    {
        Db.KoblingsSkjemaer.Remove(s);
        await Db.SaveChangesAsync();
        _skjemaer.Remove(s);
        _slettId = null;
        _visMerMeny = false;
        if (_valgtId == s.Id)
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
            LastRedigerUtkast();
        }
    }

    private async Task LagreInfo()
    {
        if (_valgt is null)
        {
            return;
        }

        var entitet = await Db.KoblingsSkjemaer.FirstOrDefaultAsync(s => s.Id == _valgt.Id);
        if (entitet is not null)
        {
            entitet.Beskrivelse = string.IsNullOrWhiteSpace(_redigerBeskrivelse) ? null : _redigerBeskrivelse.Trim();
            entitet.Versjon = string.IsNullOrWhiteSpace(_redigerVersjon) ? null : _redigerVersjon.Trim();
            await Db.SaveChangesAsync();
        }

        await LastSkjemaer();
    }

    private async Task LagreNotater()
    {
        if (_valgt is null)
        {
            return;
        }

        var entitet = await Db.KoblingsSkjemaer.FirstOrDefaultAsync(s => s.Id == _valgt.Id);
        if (entitet is not null)
        {
            entitet.Notater = string.IsNullOrWhiteSpace(_redigerNotater) ? null : _redigerNotater.Trim();
            await Db.SaveChangesAsync();
        }

        await LastSkjemaer();
    }

    private async Task LeggTilKomponent()
    {
        if (_valgt is null || string.IsNullOrWhiteSpace(_nyKomponentNavn))
        {
            return;
        }

        var nesteRekkefolge = _valgt.Komponenter.Count == 0 ? 1 : _valgt.Komponenter.Max(k => k.Rekkefolge) + 1;
        Db.KoblingsSkjemaKomponenter.Add(new KoblingsSkjemaKomponent
        {
            KoblingsSkjemaId = _valgt.Id,
            Navn = _nyKomponentNavn.Trim(),
            Type = string.IsNullOrWhiteSpace(_nyKomponentType) ? null : _nyKomponentType.Trim(),
            Ikon = _nyKomponentIkon,
            Rekkefolge = nesteRekkefolge
        });
        await Db.SaveChangesAsync();

        _nyKomponentNavn = "";
        _nyKomponentType = "";
        await LastSkjemaer();
    }

    private async Task SlettKomponent(KoblingsSkjemaKomponent k)
    {
        Db.KoblingsSkjemaKomponenter.Remove(k);
        await Db.SaveChangesAsync();
        await LastSkjemaer();
    }

    private static string MetaTekst(KoblingsSkjema s)
    {
        var dato = s.OppdatertDato is null
            ? $"Opprettet {s.OpprettetDato:dd.MM.yyyy}"
            : $"Oppdatert {s.OppdatertDato:dd.MM.yyyy}";
        var antall = s.Symboler.Count;
        return antall == 1 ? $"{dato} · 1 symbol" : $"{dato} · {antall} symboler";
    }

    private static string DatoTekst(KoblingsSkjema s) => (s.OppdatertDato ?? s.OpprettetDato).ToString("dd.MM.yyyy");
}
