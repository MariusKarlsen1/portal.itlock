@page "/guide/kobling/{KategoriId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Kobling - @_tittel</PageTitle>

@if (_ugyldigKategori)
{
    <p class="form-error">Ukjent kategori.</p>
}
else
{
    <a class="back-link" href="/guide/kobling"><Icon Name="arrow-left" />Tilbake til kobling</a>

    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="lock" /></span>
            <div>
                <h1>Kobling – @_tittel</h1>
                <p class="section-hint">Velg et koblingsskjema i listen for å se det.</p>
            </div>
        </div>
        <AuthorizeView Roles="Admin">
            <button type="button" class="knapp @(_redigerModus ? "knapp-aktiv" : "knapp-ghost")" @onclick="ToggleRedigerModus">
                <Icon Name="edit" />
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        </AuthorizeView>
    </div>

    @if (_skjemaer.Count == 0 && !_redigerModus)
    {
        <p class="list-empty">Ingen koblingsskjema laget ennå.</p>
    }
    else
    {
        <div class="master-detail">
            <div class="master-panel">
                <div class="search-box">
                    <Icon Name="search" />
                    <input @bind="_sok" @bind:event="oninput" placeholder="Søk …" />
                </div>
                @foreach (var s in _filtrerte)
                {
                    <div @key="s.Id" class="master-row @(s.Id == _valgtId ? "master-row-valgt" : "")" @onclick="@(() => _valgtId = s.Id)">
                        <span class="master-row-preview"><KoblingsSkjemaMiniPreview Symboler="s.Symboler" Streker="s.Streker" /></span>
                        <div class="master-row-tekst">
                            <span class="master-row-navn">@s.Navn</span>
                            <span class="master-row-meta">@MetaTekst(s)</span>
                        </div>
                    </div>
                }
                @if (_filtrerte.Count == 0)
                {
                    <p class="list-empty master-tomt-sok">Ingen treff.</p>
                }
                @if (_redigerModus)
                {
                    <div class="master-nytt">
                        <input @bind="_nyttNavn" @bind:event="oninput"
                               @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettSkjema(); } })"
                               placeholder="Navn på nytt koblingsskjema" />
                        <button type="button" class="knapp knapp-primaer" @onclick="OpprettSkjema" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)"><Icon Name="plus" />Nytt skjema</button>
                    </div>
                }
            </div>

            <div class="detail-panel">
                @if (_valgt is null)
                {
                    <div class="detail-tomt">
                        <Icon Name="file-text" />
                        <span>Velg et koblingsskjema i listen</span>
                    </div>
                }
                else
                {
                    <div class="detail-innhold">
                        <div class="kobling-forhandsvisning">
                            <KoblingsSkjemaMiniPreview Symboler="_valgt.Symboler" Streker="_valgt.Streker" />
                        </div>
                        <div class="detail-tekst">
                            <div>
                                <h2>@_valgt.Navn</h2>
                                <p class="section-hint">
                                    @MetaTekst(_valgt)
                                    @if (_valgt.Prosjekt is not null)
                                    {
                                        <span class="detail-prosjekt"><Icon Name="tag" />@_valgt.Prosjekt.Navn</span>
                                    }
                                </p>
                            </div>
                            <div class="detail-knapperad">
                                <a class="knapp knapp-primaer" href="@($"/koblingsskjema/{_valgt.Id}")">
                                    <Icon Name="maximize" />Åpne
                                </a>
                                @if (_redigerModus)
                                {
                                    @if (_slettId == _valgt.Id)
                                    {
                                        <span class="detail-slett-confirm">
                                            <span>Slette «@_valgt.Navn»?</span>
                                            <button type="button" class="delete-confirm-button" @onclick="@(() => SlettSkjema(_valgt))">Ja, slett</button>
                                            <button type="button" class="cancel-button" @onclick="@(() => _slettId = null)">Avbryt</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="knapp knapp-fare" @onclick="@(() => _slettId = _valgt.Id)">
                                            <Icon Name="x" />Slett
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public int KategoriId { get; set; }

    private bool _ugyldigKategori;
    private string _tittel = "";
    private List<KoblingsSkjema> _skjemaer = [];
    private bool _redigerModus;
    private int? _slettId;
    private int? _valgtId;
    private string _sok = "";
    private string _nyttNavn = "";
    private int? _loadetKategoriId;

    private List<KoblingsSkjema> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _skjemaer
        : _skjemaer.Where(s => s.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private KoblingsSkjema? _valgt => _skjemaer.FirstOrDefault(s => s.Id == _valgtId);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadetKategoriId == KategoriId)
        {
            return;
        }

        _loadetKategoriId = KategoriId;

        var kategori = await Db.KoblingsKategorier.FirstOrDefaultAsync(k => k.Id == KategoriId);
        if (kategori is null)
        {
            _ugyldigKategori = true;
            return;
        }

        _ugyldigKategori = false;
        _tittel = kategori.Navn;

        await LastSkjemaer();
    }

    private async Task LastSkjemaer()
    {
        _skjemaer = await Db.KoblingsSkjemaer
            .Where(s => s.KategoriId == KategoriId)
            .Include(s => s.Symboler)
            .Include(s => s.Streker)
            .Include(s => s.Prosjekt)
            .OrderByDescending(s => s.OppdatertDato ?? s.OpprettetDato)
            .ToListAsync();

        if (_valgtId is null || !_skjemaer.Any(s => s.Id == _valgtId))
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
        }
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
        _slettId = null;
        _nyttNavn = "";
    }

    private async Task OpprettSkjema()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var skjema = new KoblingsSkjema { KategoriId = KategoriId, Navn = navn };
        Db.KoblingsSkjemaer.Add(skjema);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/koblingsskjema/{skjema.Id}");
    }

    private async Task SlettSkjema(KoblingsSkjema s)
    {
        Db.KoblingsSkjemaer.Remove(s);
        await Db.SaveChangesAsync();
        _skjemaer.Remove(s);
        _slettId = null;
        if (_valgtId == s.Id)
        {
            _valgtId = _skjemaer.FirstOrDefault()?.Id;
        }
    }

    private static string MetaTekst(KoblingsSkjema s)
    {
        var dato = s.OppdatertDato is null
            ? $"Opprettet {s.OpprettetDato:dd.MM.yyyy}"
            : $"Oppdatert {s.OppdatertDato:dd.MM.yyyy}";
        var antall = s.Symboler.Count;
        return antall == 1 ? $"{dato} · 1 symbol" : $"{dato} · {antall} symboler";
    }
}
