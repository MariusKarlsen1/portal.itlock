@page "/ticket/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.EmailService Epost
@inject PortalItlock.Web.Services.TicketRapportPdfService RapportPdf

<PageTitle>@(_ticket?.Tittel ?? "Ticket")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke ticketen. Den kan være slettet.</p>
}
else if (_ticket is null)
{
    <p>Laster...</p>
}
else
{
    @* .ticket-side gjør at siden slipper 1200px-begrensningen i MainLayout og
       i stedet følger fane-/vindusbredden - se MainLayout.razor.css. *@
    <div class="ticket-side">

    <a class="back-link" href="/tickets">&larr; Tilbake til tickets</a>

    <div class="tk-hode">
        <h1 class="tk-h1"><span>#@_ticket.Id</span> @_ticket.Tittel</h1>
        <StatusPill Tekst="@_ticket.Status.Visningsnavn()" Ikon="@_ticket.Status.PillIkon()" Farge="@_ticket.Status.PillFarge()" />
        @if (_ticket.Prioritet is TicketPrioritet.Hoy or TicketPrioritet.Kritisk)
        {
            <span class="tk-pill tk-pill-rod">@_ticket.Prioritet.Visningsnavn() prioritet</span>
        }
        @if (_ticket.ErReklamasjon)
        {
            <span class="tk-pill tk-pill-brun">Reklamasjon</span>
        }
    </div>

    <div class="tk-kort">
        @* Nøkkelinfo i én smal linje øverst i kortet. *@
        <div class="tk-info">
            <span><Icon Name="users" /><b>@(_ticket.Kunde?.Navn ?? "Ingen kunde satt")</b>@(string.IsNullOrWhiteSpace(_ticket.Kontaktperson) ? "" : $" · {_ticket.Kontaktperson}")</span>
            @if (!string.IsNullOrWhiteSpace(_ticket.Lokasjon))
            {
                <span><Icon Name="map-pin" /><b>@_ticket.Lokasjon</b></span>
            }
            <span><Icon Name="tool" /><b>@(_ticket.AnsvarligBruker?.Navn ?? "Ikke tildelt")</b></span>
            @if (!string.IsNullOrWhiteSpace(KategoriTekst))
            {
                <span><Icon Name="tag" />@KategoriTekst</span>
            }
            <span><Icon Name="calendar" />Opprettet <b>@_ticket.OpprettetDato.ToString("dd.MM")</b></span>
            @if (_ticket.DriftsmeldingId is not null)
            {
                <a class="tk-info-kilde" href="@($"/driftsmelding/{_ticket.DriftsmeldingId}")"><Icon Name="mail" />Fra driftsmelding →</a>
            }
            else if (_ticket.ForesporselId is not null)
            {
                <a class="tk-info-kilde" href="@($"/foresporsel/{_ticket.ForesporselId}")"><Icon Name="mail" />Fra forespørsel →</a>
            }
        </div>

        <nav class="tk-faner">
            <button type="button" class="tk-fane @(_aktivFane == "oversikt" ? "aktiv" : "")" @onclick="@(() => _aktivFane = "oversikt")"><Icon Name="grid" />Oversikt</button>
            <button type="button" class="tk-fane @(_aktivFane == "kobling" ? "aktiv" : "")" @onclick="@(() => _aktivFane = "kobling")"><Icon Name="folder" />Kobling @if (AntallKoblinger > 0) {<span class="fane-teller">@AntallKoblinger</span>}</button>
            <button type="button" class="tk-fane @(_aktivFane == "vedlegg" ? "aktiv" : "")" @onclick="@(() => _aktivFane = "vedlegg")"><Icon Name="camera" />Vedlegg @if (_ticket.Media.Count > 0) {<span class="fane-teller">@_ticket.Media.Count</span>}</button>
            <button type="button" class="tk-fane tk-fane-hoyre @(_aktivFane == "detaljer" ? "aktiv" : "")" @onclick="@(() => _aktivFane = "detaljer")"><Icon Name="list" />Detaljer</button>
        </nav>

        <div class="tk-kropp">
            <div class="tk-hoved">

                @if (_aktivFane == "oversikt")
                {
                    var neste = NesteSteg();
                    <div class="tk-neste">
                        <span class="tk-neste-ik"><Icon Name="@neste.Ikon" /></span>
                        <span class="tk-neste-tekst"><b>@neste.Tittel</b><small>@neste.Undertekst</small></span>
                        @if (neste.Lenke is not null)
                        {
                            <a class="tk-knapp tk-knapp-p" href="@neste.Lenke">@neste.Knapp →</a>
                        }
                        else if (neste.Handling is not null)
                        {
                            <button type="button" class="tk-knapp tk-knapp-p" @onclick="neste.Handling">@neste.Knapp →</button>
                        }
                    </div>

                    @if (_godkjennerModus)
                    {
                        <div class="tk-godkjenn">
                            <b>Godkjenn og lukk ticket #@_ticket.Id</b>
                            <textarea rows="3" @bind="_sluttoppsummering" @bind:event="oninput" placeholder="Kort oppsummering av hva som er gjort..."></textarea>
                            @if (!string.IsNullOrWhiteSpace(_ticket.Kunde?.Epost))
                            {
                                <small>Sendes som e-post til @_ticket.Kunde!.Epost når du bekrefter, sammen med en PDF-oppsummering.</small>
                            }
                            else
                            {
                                <small>Kunden har ingen registrert e-post - det sendes ikke noe varsel automatisk.</small>
                            }
                            <div class="tk-godkjenn-rad">
                                <button type="button" class="tk-knapp" @onclick="@(() => _godkjennerModus = false)">Avbryt</button>
                                <button type="button" class="tk-knapp tk-knapp-g" @onclick="GodkjennOgLukk"><Icon Name="check" />Bekreft og lukk</button>
                            </div>
                        </div>
                    }

                    <div class="tk-kpi">
                        <div class="@(SlaErForfalt ? "rod" : "")"><small><Icon Name="clock" />SLA-frist</small><b>@SlaKort</b><em>@(_ticket.SlaFrist?.ToString("dd.MM 'kl.' HH:mm") ?? "Ingen frist")</em></div>
                        <div class="@(_ticket.Prioritet is TicketPrioritet.Hoy or TicketPrioritet.Kritisk ? "rod" : "")"><small><Icon Name="alert-triangle" />Prioritet</small><b>@_ticket.Prioritet.Visningsnavn()</b><em>@(_ticket.ErReklamasjon ? "Reklamasjon" : "Vanlig sak")</em></div>
                        <div><small><Icon Name="mail" />Samtale</small><b>@_ticket.Hendelser.Count</b><em>@_ticket.Hendelser.Count(h => h.ErKundeSynlig) synlige for kunden</em></div>
                        <div><small><Icon Name="calendar" />@(_ticket.Status == TicketStatus.Lukket ? "Var åpen i" : "Åpen i")</small><b>@AapenTekst</b><em>siden @_ticket.OpprettetDato.ToString("dd.MM 'kl.' HH:mm")</em></div>
                    </div>

                    <div class="tk-to">
                        <div class="tk-kol">
                            <section class="tk-blokk">
                                <div class="tk-blokk-t"><h3>Samtale</h3><span class="tk-dempet">@_ticket.Hendelser.Count hendelser</span></div>
                                <div class="tk-samtale">
                                    <div class="tk-skriv">
                                        <textarea rows="2" @bind="_nyKommentar" @bind:event="oninput" placeholder="Skriv en kommentar eller et svar..."></textarea>
                                        <div class="tk-skriv-bunn">
                                            <button type="button" class="tk-bryter @(_nyKommentarKundeSynlig ? "pa" : "")" @onclick="@(() => _nyKommentarKundeSynlig = !_nyKommentarKundeSynlig)"><i></i>Synlig for kunden</button>
                                            <span class="tk-dempet">@(_nyKommentarKundeSynlig ? "Kunden ser dette i kundeportalen" : "Bare internt")</span>
                                            <button type="button" class="tk-knapp tk-knapp-p" @onclick="LeggTilKommentar" disabled="@string.IsNullOrWhiteSpace(_nyKommentar)"><Icon Name="send" />Legg til</button>
                                        </div>
                                    </div>
                                    @if (_ticket.Hendelser.Count == 0)
                                    {
                                        <p class="tk-tom">Ingen hendelser registrert ennå.</p>
                                    }
                                    @foreach (var h in _ticket.Hendelser.OrderByDescending(h => h.Tidspunkt))
                                    {
                                        @if (ErMelding(h))
                                        {
                                            var fraKunde = h.UtfortAvBruker?.Rolle is BrukerRolle.Kunde or BrukerRolle.Driftslisens;
                                            <div class="tk-melding @(fraKunde ? "kunde" : "")">
                                                <span class="tk-av @(fraKunde ? "tk-av-gronn" : "")">@Initialer(h.UtfortAvBruker?.Navn)</span>
                                                <div class="tk-boble">
                                                    <div class="tk-boble-topp">
                                                        <b>@(h.UtfortAvBruker?.Navn ?? "Ukjent")</b>
                                                        @if (fraKunde)
                                                        {
                                                            <span class="tk-merke-kunde">kunden</span>
                                                        }
                                                        else if (h.ErKundeSynlig)
                                                        {
                                                            <span class="kunde-synlig-badge">Synlig for kunde</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="tk-dempet">intern</span>
                                                        }
                                                        <time>@Naar(h.Tidspunkt)</time>
                                                    </div>
                                                    <div class="tk-boble-tekst">@h.Beskrivelse</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="tk-system">
                                                <Icon Name="@SystemIkon(h.Beskrivelse)" />
                                                <span>@h.Beskrivelse@(h.UtfortAvBruker is null ? "" : $" · {h.UtfortAvBruker.Navn}")</span>
                                                <time>@Naar(h.Tidspunkt)</time>
                                            </div>
                                        }
                                    }
                                </div>
                            </section>

                            <section class="tk-blokk">
                                <div class="tk-blokk-t"><h3>Beskrivelse</h3><button type="button" class="tk-lenke" @onclick="@(() => _aktivFane = "detaljer")">Endre</button></div>
                                @if (string.IsNullOrWhiteSpace(_ticket.Beskrivelse))
                                {
                                    <p class="tk-tom">Ingen beskrivelse lagt inn.</p>
                                }
                                else
                                {
                                    <p class="tk-beskr">@_ticket.Beskrivelse</p>
                                }
                                @if (Bilder.Any())
                                {
                                    <div class="tk-bilder">
                                        @foreach (var m in Bilder)
                                        {
                                            <a href="@($"/ticketmedia/{m.Id}/fil")" target="_blank"><img src="@($"/ticketmedia/{m.Id}/fil")" alt="@m.Filnavn" loading="lazy" /></a>
                                        }
                                    </div>
                                }
                            </section>
                        </div>

                        <div class="tk-kol">
                            <section class="tk-blokk">
                                <div class="tk-blokk-t"><h3>Koblet til</h3><button type="button" class="tk-lenke" @onclick="@(() => _aktivFane = "kobling")">Endre</button></div>
                                @if (_ticket.Prosjekt is not null)
                                {
                                    <a class="tk-kobl" href="@ProsjektLenke"><span class="tk-ik tk-ik-brun"><Icon Name="folder" /></span><span><b>@_ticket.Prosjekt.Navn</b><small>@(_ticket.Prosjekt.Status == ProsjektStatus.Serviceavtale ? "Serviceavtale" : "Prosjekt")</small></span><Icon Name="chevron-right" /></a>
                                }
                                @foreach (var t in _prosjektTilbud)
                                {
                                    <a class="tk-kobl" href="@($"/tilbud/{t.Id}")"><span class="tk-ik tk-ik-brun"><Icon Name="file-text" /></span><span><b>Tilbud: @t.Tittel</b><small>@t.Status.Visningsnavn()</small></span><Icon Name="chevron-right" /></a>
                                }
                                @if (_ticket.Arbeidsordre is not null)
                                {
                                    <a class="tk-kobl" href="@($"/arbeidsordre/{_ticket.ArbeidsordreId}")"><span class="tk-ik tk-ik-gronn"><Icon Name="tool" /></span><span><b>@_ticket.Arbeidsordre.Tittel</b><small>@_ticket.Arbeidsordre.Status.Visningsnavn()<HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer">@(_arbeidsordreTimer is > 0 ? $" · {_arbeidsordreTimer.Value:N1} t registrert" : "")</HvisModul></small></span><Icon Name="chevron-right" /></a>
                                }
                                @if (_ticket.Dor is not null)
                                {
                                    <a class="tk-kobl" href="@($"/dor/{_ticket.DorId}")"><span class="tk-ik tk-ik-bla"><Icon Name="door" /></span><span><b>Dør @_ticket.Dor.Dornummer</b><small>@GarantiStatusTekst</small></span><Icon Name="chevron-right" /></a>
                                }
                                @if (_ticket.Foresporsel is not null)
                                {
                                    <a class="tk-kobl" href="@($"/foresporsel/{_ticket.ForesporselId}")"><span class="tk-ik tk-ik-gul"><Icon Name="mail" /></span><span><b>@_ticket.Foresporsel.Emne</b><small>Forespørsel fra @(_ticket.Foresporsel.FraNavn ?? _ticket.Foresporsel.FraEpost)</small></span><Icon Name="chevron-right" /></a>
                                }
                                @if (_ticket.DriftsmeldingId is not null)
                                {
                                    <a class="tk-kobl" href="@($"/driftsmelding/{_ticket.DriftsmeldingId}")"><span class="tk-ik tk-ik-gul"><Icon Name="mail" /></span><span><b>Driftsmelding</b><small>Kilde til ticketen</small></span><Icon Name="chevron-right" /></a>
                                }
                                @if (AntallKoblinger == 0 && _ticket.DriftsmeldingId is null)
                                {
                                    <p class="tk-tom">Saken er ikke koblet til noe ennå.</p>
                                }
                                <div class="tk-opprett">
                                    <span>Gjør saken om til en jobb</span>
                                    <div>@OpprettKnapper("tk-knapp")</div>
                                </div>
                            </section>
                        </div>
                    </div>
                }
                else if (_aktivFane == "kobling")
                {
                    <div class="tk-kobl-grid">
                        <section class="tk-koblkort">
                            <div class="tk-koblkort-t"><span class="tk-ik tk-ik-brun"><Icon Name="folder" /></span><div><h3>Prosjekt / serviceavtale</h3><small>Hvor timer og kost havner</small></div></div>
                            @if (_ticket.ProsjektId is null)
                            {
                                <div class="tk-velg">
                                    <select @bind="_valgtProsjektId">
                                        <option value="">Velg prosjekt/serviceavtale...</option>
                                        @foreach (var p in _prosjekter)
                                        {
                                            <option value="@p.Id">@p.Visningsnavn</option>
                                        }
                                    </select>
                                    <button type="button" class="tk-knapp" @onclick="KnyttTilProsjekt" disabled="@(_valgtProsjektId is null)">Knytt</button>
                                </div>
                                <div class="tk-opprett-rad"><span class="tk-dempet">eller</span>@OpprettKnapper("tk-knapp")</div>
                            }
                            else
                            {
                                <div class="tk-valgt"><Icon Name="check" /><b>@_ticket.Prosjekt?.Navn</b><span><a href="@ProsjektLenke">Åpne</a><button type="button" @onclick="@(() => _ticket.ProsjektId = null)">Endre</button></span></div>
                            }
                        </section>

                        <section class="tk-koblkort">
                            <div class="tk-koblkort-t"><span class="tk-ik tk-ik-gronn"><Icon Name="tool" /></span><div><h3>Arbeidsordre</h3><small>Jobben montøren gjør</small></div></div>
                            @if (_ticket.ProsjektId is null)
                            {
                                <p class="tk-dempet">Knytt et prosjekt først.</p>
                            }
                            else if (_ticket.ArbeidsordreId is null)
                            {
                                <div class="tk-velg">
                                    <select @bind="_valgtArbeidsordreId">
                                        <option value="">Velg arbeidsordre...</option>
                                        @foreach (var a in _prosjektArbeidsordre)
                                        {
                                            <option value="@a.Id">@a.Tittel (@a.Status.Visningsnavn())</option>
                                        }
                                    </select>
                                    <button type="button" class="tk-knapp" @onclick="KnyttTilArbeidsordre" disabled="@(_valgtArbeidsordreId is null)">Knytt</button>
                                </div>
                            }
                            else
                            {
                                <div class="tk-valgt"><Icon Name="check" /><b>@_ticket.Arbeidsordre?.Tittel</b><span><a href="@($"/arbeidsordre/{_ticket.ArbeidsordreId}")">Åpne</a><button type="button" @onclick="@(() => _ticket.ArbeidsordreId = null)">Endre</button></span></div>
                                <small class="tk-dempet">@_ticket.Arbeidsordre?.Status.Visningsnavn()<HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer">@(_arbeidsordreTimer.HasValue ? $" · {_arbeidsordreTimer.Value:N1} t registrert" : "")</HvisModul></small>
                            }
                        </section>

                        <section class="tk-koblkort">
                            <div class="tk-koblkort-t"><span class="tk-ik tk-ik-bla"><Icon Name="door" /></span><div><h3>Dør</h3><small>Hvilken dør det gjelder</small></div></div>
                            @if (_ticket.ProsjektId is null)
                            {
                                <p class="tk-dempet">Knytt et prosjekt først.</p>
                            }
                            else if (_ticket.DorId is null)
                            {
                                <div class="tk-velg">
                                    <select @bind="_valgtDorId">
                                        <option value="">Velg dør...</option>
                                        @foreach (var d in _prosjektDorer)
                                        {
                                            <option value="@d.Id">Dør @d.Dornummer</option>
                                        }
                                    </select>
                                    <button type="button" class="tk-knapp" @onclick="KnyttTilDor" disabled="@(_valgtDorId is null)">Knytt</button>
                                </div>
                            }
                            else
                            {
                                <div class="tk-valgt"><Icon Name="check" /><b>Dør @_ticket.Dor?.Dornummer</b><span><a href="@($"/dor/{_ticket.DorId}")">Åpne</a><button type="button" @onclick="@(() => _ticket.DorId = null)">Endre</button></span></div>
                                <span class="@GarantiStatusKlasse">@GarantiStatusTekst</span>
                            }
                        </section>

                        <section class="tk-koblkort">
                            <div class="tk-koblkort-t"><span class="tk-ik tk-ik-gul"><Icon Name="mail" /></span><div><h3>Forespørsel</h3><small>E-post/forespørsel fra kunden</small></div></div>
                            @if (_ticket.ForesporselId is null)
                            {
                                <div class="tk-velg">
                                    <select @bind="_valgtForesporselId">
                                        <option value="">Velg forespørsel...</option>
                                        @foreach (var f in _ledigeForesporsler)
                                        {
                                            <option value="@f.Id">@f.Emne - @(f.FraNavn ?? f.FraEpost) (@f.MottattDato.ToString("dd.MM.yyyy"))</option>
                                        }
                                    </select>
                                    <button type="button" class="tk-knapp" @onclick="KnyttTilForesporsel" disabled="@(_valgtForesporselId is null)">Knytt</button>
                                </div>
                            }
                            else
                            {
                                <div class="tk-valgt"><Icon Name="check" /><b>@_ticket.Foresporsel?.Emne</b><span><a href="@($"/foresporsel/{_ticket.ForesporselId}")">Åpne</a><button type="button" @onclick="@(() => _ticket.ForesporselId = null)">Fjern</button></span></div>
                                <small class="tk-dempet">Fra @(_ticket.Foresporsel?.FraNavn ?? _ticket.Foresporsel?.FraEpost)</small>
                            }
                        </section>
                    </div>

                    @if (_ticket.ProsjektId is not null)
                    {
                        <section class="tk-blokk">
                            <div class="tk-blokk-t"><h3>Tilbud på prosjektet</h3>@OpprettKnapper("tk-knapp")</div>
                            @if (_prosjektTilbud.Count == 0)
                            {
                                <p class="tk-tom">Ingen tilbud på prosjektet ennå.</p>
                            }
                            @foreach (var t in _prosjektTilbud)
                            {
                                <div class="tk-kobl">
                                    <span class="tk-ik tk-ik-brun"><Icon Name="file-text" /></span>
                                    <span><a class="kobling-link" href="@($"/tilbud/{t.Id}")">@t.Tittel</a><small>@t.Status.Visningsnavn()</small></span>
                                    @if (_ticket.ForesporselId is not null && string.IsNullOrWhiteSpace(t.ForesporselBeskrivelse))
                                    {
                                        <button type="button" class="tk-knapp" @onclick="@(() => KopierForesporselTilTilbud(t))">Kopier forespørsel-tekst hit</button>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                </div>
                            }
                        </section>
                    }

                    @if (_ticket.Foresporsel is not null)
                    {
                        <section class="tk-blokk">
                            <div class="tk-blokk-t"><h3>Knyttet forespørsel</h3></div>
                            @if (!string.IsNullOrWhiteSpace(_ticket.Foresporsel.Innhold))
                            {
                                <p class="foresporsel-tekst-visning">@_ticket.Foresporsel.Innhold</p>
                            }
                            @if (_ticket.Foresporsel.Media.Count > 0)
                            {
                                <p class="tk-tom">Vedlegg fra forespørselen (kopieres til prosjektets Grunnlag-mappe når knyttet til et vanlig prosjekt):</p>
                                <ul class="vedlegg-liste">
                                    @foreach (var m in _ticket.Foresporsel.Media)
                                    {
                                        <li>@m.Filnavn</li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                }
                else if (_aktivFane == "vedlegg")
                {
                    <section class="tk-blokk">
                        <div class="tk-blokk-t"><h3>Bilder og filer</h3><span class="tk-dempet">@_ticket.Media.Count vedlegg</span></div>
                        <div class="tk-vedlegg">
                            @foreach (var m in _ticket.Media)
                            {
                                <div class="tk-fil">
                                    <a href="@($"/ticketmedia/{m.Id}/fil")" target="_blank">
                                        @if (m.ContentType.StartsWith("image/"))
                                        {
                                            <img src="@($"/ticketmedia/{m.Id}/fil")" alt="@m.Filnavn" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="tk-fil-ik"><Icon Name="file-text" /></span>
                                        }
                                        <small>@m.Filnavn</small>
                                    </a>
                                    <button type="button" class="tk-fil-x" title="Fjern" @onclick="@(() => SlettMedia(m))">×</button>
                                </div>
                            }
                            <label class="tk-fil tk-fil-ny">
                                <Icon Name="upload" />Last opp<br />bilde eller fil
                                <InputFile OnChange="LastOppFiler" multiple />
                            </label>
                        </div>
                    </section>
                }
                else if (_aktivFane == "detaljer")
                {
                    <section class="tk-blokk">
                        <div class="tk-blokk-t"><h3>Saken</h3></div>
                        <div class="tk-skjema">
                            <div class="felt span-3"><label>Tittel</label><input @bind="_ticket.Tittel" @bind:event="oninput" /></div>
                            <div class="felt span-3"><label>Beskrivelse</label><textarea rows="3" @bind="_ticket.Beskrivelse" @bind:after="AutoLagre"></textarea></div>
                            <div class="felt">
                                <label>Kunde</label>
                                <select @bind="_ticket.KundeId">
                                    <option value="">Ingen kunde satt</option>
                                    @foreach (var k in _kunder)
                                    {
                                        <option value="@k.Id">@k.Navn</option>
                                    }
                                </select>
                            </div>
                            <div class="felt"><label>Kontaktperson</label><input @bind="_ticket.Kontaktperson" @bind:event="oninput" /></div>
                            <div class="felt"><label>Lokasjon</label><input @bind="_ticket.Lokasjon" @bind:event="oninput" placeholder="F.eks. Industriveien 10" /></div>
                        </div>
                        <div class="tk-blokk-t tk-skille"><h3>Klassifisering og ansvar</h3></div>
                        <div class="tk-skjema">
                            <div class="felt">
                                <label>Board</label>
                                <select @bind="_ticket.Board">
                                    <option value="">Ikke satt</option>
                                    @foreach (var b in _boardAlternativer)
                                    {
                                        <option value="@b">@b</option>
                                    }
                                </select>
                            </div>
                            <div class="felt">
                                <label>Type</label>
                                <select @bind="_ticket.Type">
                                    <option value="">Ikke satt</option>
                                    @foreach (var t in _typeAlternativer)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="felt">
                                <label>Subtype</label>
                                <select @bind="_ticket.Subtype">
                                    <option value="">Ikke satt</option>
                                    @foreach (var sub in _subtypeAlternativer)
                                    {
                                        <option value="@sub">@sub</option>
                                    }
                                </select>
                            </div>
                            <div class="felt"><label>Produkt/anlegg</label><input @bind="_ticket.ProduktAnlegg" @bind:event="oninput" /></div>
                            <div class="felt">
                                <label>Prioritet</label>
                                <select @bind="_ticket.Prioritet" @bind:after="OppdaterSlaFrist">
                                    @foreach (var p in Enum.GetValues<TicketPrioritet>())
                                    {
                                        <option value="@p">@p.Visningsnavn()</option>
                                    }
                                </select>
                            </div>
                            <div class="felt">
                                <label>Ansvarlig</label>
                                <select @bind="_ticket.AnsvarligBrukerId">
                                    <option value="">Ikke tildelt</option>
                                    @foreach (var b in _brukere)
                                    {
                                        <option value="@b.Id">@b.Navn</option>
                                    }
                                </select>
                            </div>
                            <div class="felt">
                                <label>Status</label>
                                <select value="@_ticket.Status" @onchange="EndreStatus">
                                    @foreach (var s in TicketStatusExtensions.Rekkefolge)
                                    {
                                        <option value="@s">@s.Visningsnavn()</option>
                                    }
                                </select>
                            </div>
                            <label class="checkbox-row span-3">
                                <input type="checkbox" @bind="_ticket.ErReklamasjon" @bind:after="AutoLagre" />
                                Dette er en reklamasjon
                                @if (_ticket.ErReklamasjon)
                                {
                                    <span class="@GarantiStatusKlasse">@GarantiStatusTekst</span>
                                }
                            </label>
                            <div class="span-3 tk-lagre-rad">
                                <button type="button" class="tk-knapp tk-knapp-p" @onclick="LagreInfo"><Icon Name="check" />Lagre</button>
                                @if (!string.IsNullOrEmpty(_lagretMelding))
                                {
                                    <span class="save-success">@_lagretMelding</span>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="tk-faresone">
                        <div><b>Slett ticket</b><small>Sletter ticketen med samtale og vedlegg.</small></div>
                        <button type="button" class="tk-knapp tk-knapp-rod" @onclick="SlettTicket"><Icon Name="trash" />Slett ticket</button>
                    </section>
                }
            </div>

            <aside class="tk-side">
                <div class="tk-side-blokk">
                    <h4>Handlinger</h4>
                    <button type="button" class="tk-sk tk-sk-p" @onclick="LagreInfo"><Icon Name="check" />Lagre</button>
                    @if (_ticket.Status is TicketStatus.Ny or TicketStatus.UnderBehandling)
                    {
                        <button type="button" class="tk-sk" @onclick="SendTilGodkjenning"><Icon Name="arrow-right" />Send til godkjenning</button>
                    }
                    @if (_ticket.Status != TicketStatus.Lukket && !_godkjennerModus)
                    {
                        <button type="button" class="tk-sk tk-sk-g" @onclick="StartGodkjenning"><Icon Name="check-circle" />Godkjenn og lukk</button>
                    }
                    @if (_ticket.Status == TicketStatus.Lukket)
                    {
                        <button type="button" class="tk-sk" @onclick="Gjenapne"><Icon Name="arrow-left" />Gjenåpne ticket</button>
                    }
                    @OpprettKnapper("tk-sk")
                    <button type="button" class="tk-sk tk-sk-r" @onclick="@(() => _aktivFane = "detaljer")"><Icon Name="trash" />Slett ticket</button>
                    @if (!string.IsNullOrEmpty(_lagretMelding))
                    {
                        <span class="save-success">@_lagretMelding</span>
                    }
                </div>

                @if (_ticket.SlaFrist.HasValue && _ticket.Status != TicketStatus.Lukket)
                {
                    <div class="tk-side-blokk">
                        <h4>SLA</h4>
                        <div class="tk-sla @(SlaErForfalt ? "forfalt" : "")">
                            <b>@(SlaErForfalt ? "Forfalt" : SlaKort + " igjen")</b>
                            <small>Frist @_ticket.SlaFrist.Value.ToString("dd.MM 'kl.' HH:mm") · @_ticket.Prioritet.Visningsnavn().ToLowerInvariant() prioritet</small>
                            <span class="tk-bar"><i style="width:@SlaBrukt%"></i></span>
                        </div>
                    </div>
                }

                <div class="tk-side-blokk">
                    <h4>Ansvarlig</h4>
                    <div class="tk-ansvar">
                        <span class="tk-av">@Initialer(_ticket.AnsvarligBruker?.Navn)</span>
                        <div><b>@(_ticket.AnsvarligBruker?.Navn ?? "Ikke tildelt")</b><button type="button" class="tk-lenke" @onclick="@(() => _aktivFane = "detaljer")">Bytt</button></div>
                    </div>
                </div>

                <div class="tk-side-blokk">
                    <h4>Egenskaper</h4>
                    <div class="tk-egen"><span>Opprettet</span><span>@_ticket.OpprettetDato.ToString("dd.MM.yyyy")</span></div>
                    <div class="tk-egen"><span>Prosjekt</span><span>@(_ticket.Prosjekt?.Navn ?? "Ingen")</span></div>
                    <div class="tk-egen"><span>Arbeidsordre</span><span>@(_ticket.Arbeidsordre?.Tittel ?? "Ingen")</span></div>
                    <div class="tk-egen"><span>Forespørsel</span><span>@(_ticket.Foresporsel is null ? "Ingen" : "Knyttet")</span></div>
                    <div class="tk-egen"><span>Vedlegg</span><span>@_ticket.Media.Count</span></div>
                    @if (_ticket.Status == TicketStatus.Lukket)
                    {
                        <div class="tk-egen"><span>Lukket</span><span>@(_ticket.LukketDato?.ToString("dd.MM.yyyy")) · @(_ticket.GodkjentAvBruker?.Navn ?? "ukjent")</span></div>
                    }
                </div>
            </aside>
        </div>
    </div>

    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private Ticket? _ticket;
    private bool _notFound;
    private string? _lagretMelding;
    private int? _naverendeBrukerId;
    private string _aktivFane = "oversikt";

    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class BrukerOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Visningsnavn { get; set; } = "";
    }

    private List<KundeOption> _kunder = [];
    private List<BrukerOption> _brukere = [];
    private List<ProsjektOption> _prosjekter = [];
    private List<Tilbud> _prosjektTilbud = [];
    private List<Arbeidsordre> _prosjektArbeidsordre = [];
    private decimal? _arbeidsordreTimer;
    private List<Foresporsel> _ledigeForesporsler = [];
    private List<Dor> _prosjektDorer = [];

    private int? _valgtProsjektId;
    private int? _valgtArbeidsordreId;
    private int? _valgtForesporselId;
    private int? _valgtDorId;
    private string _nyKommentar = "";
    private bool _nyKommentarKundeSynlig;

    private List<string> _boardAlternativer = [];
    private List<string> _typeAlternativer = [];
    private List<string> _subtypeAlternativer = [];
    private bool _godkjennerModus;
    private string _sluttoppsummering = "";

    private bool SlaErForfalt => _ticket?.SlaFrist is { } frist && frist < DateTime.Now && _ticket.Status != TicketStatus.Lukket;

    private string GarantiStatusTekst
    {
        get
        {
            if (_ticket?.DorId is null || _ticket.Dor is null)
            {
                return "Ingen dør knyttet - kan ikke sjekke garanti.";
            }

            if (_ticket.Prosjekt?.OverlevertDato is null)
            {
                return "Prosjektet er ikke overlevert enda - garantien har ikke startet.";
            }

            var utlop = GarantiBeregning.TidligsteUtlop(_ticket.Dor, _ticket.Prosjekt.OverlevertDato);
            if (utlop is null)
            {
                return "Ingen beslag med registrert garantitid på døren.";
            }

            return utlop.Value.Date < DateTime.Today
                ? $"Utenfor garanti (utløp {utlop.Value:dd.MM.yyyy})"
                : $"Innenfor garanti (til {utlop.Value:dd.MM.yyyy})";
        }
    }

    private string GarantiStatusKlasse =>
        _ticket?.DorId is not null && _ticket.Dor is not null
        && GarantiBeregning.TidligsteUtlop(_ticket.Dor, _ticket.Prosjekt?.OverlevertDato) is { } utlop
        && utlop.Date < DateTime.Today
            ? "garanti-utlopt"
            : "garanti-ok";

    private string SlaStatusTekst
    {
        get
        {
            if (_ticket?.SlaFrist is not { } frist)
            {
                return "";
            }

            var diff = frist - DateTime.Now;
            if (diff.TotalMinutes < 0)
            {
                var forsinket = DateTime.Now - frist;
                return forsinket.TotalHours >= 24
                    ? $"forfalt for {(int)forsinket.TotalDays} dag(er) siden"
                    : $"forfalt for {(int)forsinket.TotalHours} time(r) siden";
            }

            return diff.TotalHours >= 24
                ? $"{(int)diff.TotalDays} dag(er) igjen"
                : $"{(int)diff.TotalHours} time(r) igjen";
        }
    }

    private void OppdaterSlaFrist()
    {
        if (_ticket is null || _ticket.Status == TicketStatus.Lukket)
        {
            return;
        }

        _ticket.SlaFrist = TicketSlaHelper.BeregnFrist(_ticket.Prioritet, _ticket.OpprettetDato);
        _ticket.EskaleringsVarselSendt = false;
    }

    private string ProsjektLenke => _ticket?.Prosjekt?.Status == ProsjektStatus.Serviceavtale
        ? $"/serviceavtaler/{_ticket.ProsjektId}"
        : $"/prosjekter/{_ticket.ProsjektId}";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        _ticket = await Db.Tickets
            .Include(t => t.Kunde)
            .Include(t => t.AnsvarligBruker)
            .Include(t => t.GodkjentAvBruker)
            .Include(t => t.Prosjekt)
            .Include(t => t.Arbeidsordre)
            .Include(t => t.Dor).ThenInclude(d => d!.Komponenter).ThenInclude(dk => dk.Component)
            .Include(t => t.Foresporsel).ThenInclude(f => f!.Media)
            .Include(t => t.Hendelser).ThenInclude(h => h.UtfortAvBruker)
            .Include(t => t.Media)
            // Flere separate én-til-mange-samlinger (Komponenter/Media/Hendelser/
            // Foresporsel.Media) i samme spørring gir et unødvendig stort
            // kartesisk produkt i SQL-resultatet - AsSplitQuery() kjører i
            // stedet flere enkle spørringer og slår dem sammen i minnet. Samme
            // data/resultat, kun raskere for tickets med mye historikk.
            .AsSplitQuery()
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (_ticket is null)
        {
            _notFound = true;
            return;
        }

        if (_ticket.SlaFrist is null && _ticket.Status != TicketStatus.Lukket)
        {
            _ticket.SlaFrist = TicketSlaHelper.BeregnFrist(_ticket.Prioritet, _ticket.OpprettetDato);
            await Db.SaveChangesAsync();
        }

        var kategorier = await Db.TicketKategorier.OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn).ToListAsync();
        _boardAlternativer = kategorier.Where(k => k.Gruppe == TicketKategoriGruppe.Board).Select(k => k.Navn).ToList();
        _typeAlternativer = kategorier.Where(k => k.Gruppe == TicketKategoriGruppe.Type).Select(k => k.Navn).ToList();
        _subtypeAlternativer = kategorier.Where(k => k.Gruppe == TicketKategoriGruppe.Subtype).Select(k => k.Navn).ToList();

        // Behold en eksisterende verdi selv om den ikke lenger finnes i kategori-listen (f.eks. gammel fritekst).
        if (!string.IsNullOrWhiteSpace(_ticket.Board) && !_boardAlternativer.Contains(_ticket.Board)) { _boardAlternativer.Insert(0, _ticket.Board); }
        if (!string.IsNullOrWhiteSpace(_ticket.Type) && !_typeAlternativer.Contains(_ticket.Type)) { _typeAlternativer.Insert(0, _ticket.Type); }
        if (!string.IsNullOrWhiteSpace(_ticket.Subtype) && !_subtypeAlternativer.Contains(_ticket.Subtype)) { _subtypeAlternativer.Insert(0, _ticket.Subtype); }

        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        _brukere = await Db.Brukere
            .OrderBy(b => b.Navn)
            .Select(b => new BrukerOption { Id = b.Id, Navn = b.Navn })
            .ToListAsync();

        _prosjekter = await Db.Prosjekter
            .Include(p => p.Kunde)
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption
            {
                Id = p.Id,
                Visningsnavn = p.Navn + (p.Status == ProsjektStatus.Serviceavtale ? " (service)" : "") + (p.Kunde != null ? " - " + p.Kunde.Navn : "")
            })
            .ToListAsync();

        if (_ticket.ProsjektId.HasValue)
        {
            _prosjektTilbud = await Db.Tilbud
                .Where(t => t.ProsjektId == _ticket.ProsjektId)
                .ToListAsync();

            _prosjektArbeidsordre = await Db.Arbeidsordre
                .Where(a => a.ProsjektId == _ticket.ProsjektId)
                .ToListAsync();

            _prosjektDorer = await Db.Dorer
                .Where(d => d.ProsjektId == _ticket.ProsjektId)
                .OrderBy(d => d.Dornummer)
                .ToListAsync();
        }

        if (_ticket.ArbeidsordreId.HasValue)
        {
            var registreringer = await Db.Timeregistreringer
                .Where(t => t.ArbeidsordreId == _ticket.ArbeidsordreId.Value)
                .ToListAsync();
            _arbeidsordreTimer = registreringer.Sum(t => t.TotalTimer);
        }
        else
        {
            _arbeidsordreTimer = null;
        }

        if (_ticket.ForesporselId is null)
        {
            var brukteForesporselIder = await Db.Tickets
                .Where(t => t.ForesporselId != null)
                .Select(t => t.ForesporselId!.Value)
                .ToListAsync();

            _ledigeForesporsler = await Db.Foresporsler
                .Where(f => !brukteForesporselIder.Contains(f.Id))
                .OrderByDescending(f => f.MottattDato)
                .ToListAsync();
        }

        // Auto-flipp til "Venter godkjenning" når lenket arbeidsordre er ferdigstilt.
        if (_ticket.Status == TicketStatus.UnderBehandling
            && _ticket.Arbeidsordre is not null
            && (_ticket.Arbeidsordre.Status == ArbeidsordreStatus.Ferdig || _ticket.Arbeidsordre.Status == ArbeidsordreStatus.Fakturert))
        {
            _ticket.Status = TicketStatus.VenterGodkjenning;
            LoggHendelse("Arbeidsordre ferdigstilt - venter godkjenning.");
            await Db.SaveChangesAsync();
        }
    }

    private void LoggHendelse(string beskrivelse, bool erKundeSynlig = false)
    {
        _ticket!.Hendelser.Add(new TicketHendelse
        {
            TicketId = _ticket.Id,
            Beskrivelse = beskrivelse,
            UtfortAvBrukerId = _naverendeBrukerId,
            ErKundeSynlig = erKundeSynlig
        });
    }

    private async Task LagreInfo()
    {
        // Ansvarlig på ticketen og ansvarlig montør på en knyttet arbeidsordre er to
        // separate felt som lett kan skli fra hverandre - skyver ticketens verdi videre
        // hit slik at brukeren slipper å sette den samme personen to steder.
        if (_ticket?.ArbeidsordreId is not null && _ticket.AnsvarligBrukerId is not null)
        {
            var knyttetOrdre = _prosjektArbeidsordre.FirstOrDefault(a => a.Id == _ticket.ArbeidsordreId)
                ?? await Db.Arbeidsordre.FindAsync(_ticket.ArbeidsordreId.Value);
            if (knyttetOrdre is not null && knyttetOrdre.AnsvarligMontorId != _ticket.AnsvarligBrukerId)
            {
                knyttetOrdre.AnsvarligMontorId = _ticket.AnsvarligBrukerId;
            }
        }

        await Db.SaveChangesAsync();
        _lagretMelding = "Lagret.";
    }

    private async Task AutoLagre() => await Db.SaveChangesAsync();

    private async Task EndreStatus(ChangeEventArgs e)
    {
        if (_ticket is null || !Enum.TryParse<TicketStatus>(e.Value?.ToString(), out var ny) || ny == _ticket.Status)
        {
            return;
        }

        if (ny == TicketStatus.Lukket)
        {
            _godkjennerModus = true;
            return;
        }

        if (_ticket.Status == TicketStatus.Lukket)
        {
            await Gjenapne();
            return;
        }

        var gammel = _ticket.Status;
        _ticket.Status = ny;
        OppdaterSlaFrist();
        LoggHendelse($"Status endret fra {gammel.Visningsnavn()} til {ny.Visningsnavn()}.");
        await Db.SaveChangesAsync();
    }

    private async Task SlettTicket()
    {
        Db.Tickets.Remove(_ticket!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/tickets");
    }

    private string ProsjektNyUrl()
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(_ticket?.Tittel)) { qs.Add($"navn={Uri.EscapeDataString(_ticket.Tittel)}"); }
        if (_ticket?.KundeId is int kundeId) { qs.Add($"kundeId={kundeId}"); }
        if (!string.IsNullOrWhiteSpace(_ticket?.Lokasjon)) { qs.Add($"adresse={Uri.EscapeDataString(_ticket.Lokasjon)}"); }
        if (!string.IsNullOrWhiteSpace(_ticket?.Kontaktperson)) { qs.Add($"kontaktperson={Uri.EscapeDataString(_ticket.Kontaktperson)}"); }
        return "/prosjekter/ny" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }

    private string TilbudServiceNyUrl()
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(_ticket?.Tittel)) { qs.Add($"navn={Uri.EscapeDataString(_ticket.Tittel)}"); }
        if (_ticket?.KundeId is int kundeId) { qs.Add($"kundeId={kundeId}"); }
        if (!string.IsNullOrWhiteSpace(_ticket?.Lokasjon)) { qs.Add($"adresse={Uri.EscapeDataString(_ticket.Lokasjon)}"); }
        return "/tilbud-service" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }

    private async Task KnyttTilProsjekt()
    {
        if (_valgtProsjektId is null)
        {
            return;
        }

        _ticket!.ProsjektId = _valgtProsjektId;
        if (_ticket.Status == TicketStatus.Ny)
        {
            _ticket.Status = TicketStatus.UnderBehandling;
        }

        var navn = _prosjekter.FirstOrDefault(p => p.Id == _valgtProsjektId)?.Visningsnavn ?? "";
        LoggHendelse($"Knyttet til prosjekt/serviceavtale: {navn}");

        if (_ticket.ForesporselId is not null)
        {
            var prosjekt = await Db.Prosjekter.FindAsync(_valgtProsjektId.Value);
            var foresporsel = await Db.Foresporsler
                .Include(f => f.Media)
                .FirstOrDefaultAsync(f => f.Id == _ticket.ForesporselId);

            if (prosjekt is not null && foresporsel is not null)
            {
                if (prosjekt.Status != ProsjektStatus.Serviceavtale)
                {
                    if (foresporsel.Media.Count > 0)
                    {
                        var grunnlagMappe = await Db.ProsjektMapper.FirstOrDefaultAsync(m => m.ProsjektId == prosjekt.Id && m.Navn == "Grunnlag")
                            ?? new ProsjektMappe { ProsjektId = prosjekt.Id, Navn = "Grunnlag" };

                        foreach (var m in foresporsel.Media)
                        {
                            Db.ProsjektVedlegg.Add(new ProsjektVedlegg
                            {
                                ProsjektId = prosjekt.Id,
                                Filnavn = m.Filnavn,
                                ContentType = m.ContentType,
                                Data = m.Data,
                                Mappe = grunnlagMappe
                            });
                        }
                        LoggHendelse($"Kopierte {foresporsel.Media.Count} vedlegg fra forespørselen til prosjektets Grunnlag-mappe.");
                    }
                }
                else
                {
                    var forsteTilbud = await Db.Tilbud.FirstOrDefaultAsync(t => t.ProsjektId == prosjekt.Id);
                    if (forsteTilbud is not null && string.IsNullOrWhiteSpace(forsteTilbud.ForesporselBeskrivelse))
                    {
                        forsteTilbud.ForesporselBeskrivelse = foresporsel.Innhold;
                        LoggHendelse($"Kopierte forespørsel-tekst til tilbud: {forsteTilbud.Tittel}");
                    }
                }
            }
        }

        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task KopierForesporselTilTilbud(Tilbud tilbud)
    {
        if (_ticket!.ForesporselId is null)
        {
            return;
        }

        var foresporsel = await Db.Foresporsler.FindAsync(_ticket.ForesporselId.Value);
        if (foresporsel is null)
        {
            return;
        }

        tilbud.ForesporselBeskrivelse = foresporsel.Innhold;
        LoggHendelse($"Kopierte forespørsel-tekst til tilbud: {tilbud.Tittel}");
        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task KnyttTilArbeidsordre()
    {
        if (_valgtArbeidsordreId is null)
        {
            return;
        }

        _ticket!.ArbeidsordreId = _valgtArbeidsordreId;
        var ao = _prosjektArbeidsordre.FirstOrDefault(a => a.Id == _valgtArbeidsordreId);

        // Ved selve koblingen: den siden som allerede har en ansvarlig satt får
        // "vinne" og fylle den andre - uten å overskrive et bevisst valgt navn.
        if (ao is not null)
        {
            if (_ticket.AnsvarligBrukerId is not null && ao.AnsvarligMontorId is null)
            {
                ao.AnsvarligMontorId = _ticket.AnsvarligBrukerId;
            }
            else if (ao.AnsvarligMontorId is not null && _ticket.AnsvarligBrukerId is null)
            {
                _ticket.AnsvarligBrukerId = ao.AnsvarligMontorId;
            }
        }

        LoggHendelse($"Knyttet til arbeidsordre: {ao?.Tittel}");
        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task KnyttTilDor()
    {
        if (_valgtDorId is null)
        {
            return;
        }

        _ticket!.DorId = _valgtDorId;
        var dor = _prosjektDorer.FirstOrDefault(d => d.Id == _valgtDorId);
        LoggHendelse($"Knyttet til dør: {dor?.Dornummer}");
        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task KnyttTilForesporsel()
    {
        if (_valgtForesporselId is null)
        {
            return;
        }

        _ticket!.ForesporselId = _valgtForesporselId;
        var f = _ledigeForesporsler.FirstOrDefault(f => f.Id == _valgtForesporselId);
        LoggHendelse($"Knyttet til forespørsel: {f?.Emne}");
        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task GodkjennOgLukk()
    {
        _ticket!.Status = TicketStatus.Lukket;
        _ticket.LukketDato = DateTime.Now;
        _ticket.GodkjentAvBrukerId = _naverendeBrukerId;
        _ticket.Sluttoppsummering = string.IsNullOrWhiteSpace(_sluttoppsummering) ? null : _sluttoppsummering.Trim();
        LoggHendelse("Godkjent og lukket.");
        await Db.SaveChangesAsync();

        if (!string.IsNullOrWhiteSpace(_ticket.Kunde?.Epost))
        {
            var kundeEpost = _ticket.Kunde.Epost;
            var pdf = await RapportPdf.GenerateAsync(_ticket.Id);
            var oppsummeringHtml = string.IsNullOrWhiteSpace(_ticket.Sluttoppsummering)
                ? ""
                : $"<p>{System.Net.WebUtility.HtmlEncode(_ticket.Sluttoppsummering).Replace("\n", "<br>")}</p>";
            var html = $"<p>Hei,</p>" +
                $"<p>Din sak <strong>#{_ticket.Id} - {System.Net.WebUtility.HtmlEncode(_ticket.Tittel)}</strong> er nå ferdig behandlet.</p>" +
                oppsummeringHtml +
                "<p>Ta kontakt hvis du har spørsmål.</p><p>Mvh Full Kontroll</p>";

            var vedlegg = pdf is not null ? new[] { ($"Sak-{_ticket.Id}-oppsummering.pdf", pdf) } : null;
            var sendt = await Epost.SendAsync(kundeEpost, $"Din sak #{_ticket.Id} er ferdig behandlet", html, vedlegg);
            LoggHendelse(sendt ? $"E-post sendt til {kundeEpost}." : $"Klarte ikke å sende e-post til {kundeEpost}.");
            await Db.SaveChangesAsync();
        }

        _godkjennerModus = false;
        _sluttoppsummering = "";
        await OnParametersSetAsync();
    }

    private async Task Gjenapne()
    {
        _ticket!.Status = TicketStatus.UnderBehandling;
        _ticket.LukketDato = null;
        _ticket.GodkjentAvBrukerId = null;
        _ticket.SlaFrist = TicketSlaHelper.BeregnFrist(_ticket.Prioritet, DateTime.Now);
        _ticket.EskaleringsVarselSendt = false;
        LoggHendelse("Gjenåpnet.");
        await Db.SaveChangesAsync();
        await OnParametersSetAsync();
    }

    private async Task LeggTilKommentar()
    {
        var tekst = _nyKommentar.Trim();
        if (tekst.Length == 0)
        {
            return;
        }

        LoggHendelse(tekst, _nyKommentarKundeSynlig);
        _nyKommentar = "";
        _nyKommentarKundeSynlig = false;
        await Db.SaveChangesAsync();
    }

    private async Task LastOppFiler(InputFileChangeEventArgs e)
    {
        foreach (var fil in e.GetMultipleFiles(10))
        {
            using var stream = fil.OpenReadStream(maxAllowedSize: 20_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _ticket!.Media.Add(new TicketMedia
            {
                TicketId = _ticket.Id,
                Data = ms.ToArray(),
                ContentType = fil.ContentType,
                Filnavn = fil.Name
            });
        }

        LoggHendelse("La til vedlegg.");
        await Db.SaveChangesAsync();
    }

    private async Task SlettMedia(TicketMedia media)
    {
        Db.TicketMedia.Remove(media);
        _ticket!.Media.Remove(media);
        await Db.SaveChangesAsync();
    }

    // ---------- Visning (ticket-oppsett oktober 2026) ----------

    private sealed record Steg(string Ikon, string Tittel, string Undertekst, string Knapp, string? Lenke = null, Func<Task>? Handling = null);

    private Steg NesteSteg()
    {
        var t = _ticket!;
        if (t.Status == TicketStatus.Lukket)
        {
            return new Steg("check-circle", "Ticketen er lukket", $"Lukket {t.LukketDato:dd.MM.yyyy} av {t.GodkjentAvBruker?.Navn ?? "ukjent"}", "Gjenåpne", Handling: Gjenapne);
        }
        if (t.Status == TicketStatus.VenterGodkjenning)
        {
            return new Steg("check-circle", "Klar til godkjenning", "Arbeidet er gjort - skriv en kort oppsummering og lukk saken", "Godkjenn og lukk", Handling: StartGodkjenning);
        }
        if (t.ProsjektId is null)
        {
            return new Steg("folder", "Koble saken til et prosjekt", "Knytt til et eksisterende prosjekt/serviceavtale, eller opprett prosjekt eller tilbud", "Kobling", Handling: () => { _aktivFane = "kobling"; return Task.CompletedTask; });
        }
        if (t.Arbeidsordre is null)
        {
            return new Steg("tool", "Knytt en arbeidsordre", "Så montøren får jobben og timene havner på riktig sted", "Kobling", Handling: () => { _aktivFane = "kobling"; return Task.CompletedTask; });
        }
        var plan = t.Arbeidsordre.PlanlagtDato is { } d ? $" - planlagt {d:dd.MM}" : "";
        return new Steg("tool", $"Arbeidsordre: {t.Arbeidsordre.Tittel}{plan}", "Når jobben er gjort: send ticketen til godkjenning", "Åpne arbeidsordre", Lenke: $"/arbeidsordre/{t.ArbeidsordreId}");
    }

    private Task StartGodkjenning()
    {
        _aktivFane = "oversikt";
        _godkjennerModus = true;
        return Task.CompletedTask;
    }

    private async Task SendTilGodkjenning() =>
        await EndreStatus(new ChangeEventArgs { Value = TicketStatus.VenterGodkjenning.ToString() });

    private string KategoriTekst => string.Join(" · ",
        new[] { _ticket?.Board, _ticket?.Type, _ticket?.Subtype }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private int AntallKoblinger =>
        (_ticket?.ProsjektId is null ? 0 : 1) + (_ticket?.ArbeidsordreId is null ? 0 : 1)
        + (_ticket?.DorId is null ? 0 : 1) + (_ticket?.ForesporselId is null ? 0 : 1);

    private IEnumerable<TicketMedia> Bilder =>
        _ticket?.Media.Where(m => m.ContentType.StartsWith("image/")) ?? [];

    private string SlaKort
    {
        get
        {
            if (_ticket?.SlaFrist is not { } frist)
            {
                return "-";
            }
            if (_ticket.Status == TicketStatus.Lukket)
            {
                return "Lukket";
            }

            var diff = frist - DateTime.Now;
            if (diff.TotalMinutes < 0)
            {
                return "Forfalt";
            }
            return diff.TotalHours >= 24
                ? $"{(int)diff.TotalDays} d {diff.Hours} t"
                : $"{(int)diff.TotalHours} t {diff.Minutes} min";
        }
    }

    // Hvor mye av SLA-tiden som er brukt, i prosent (for streken i sidepanelet).
    private int SlaBrukt
    {
        get
        {
            if (_ticket?.SlaFrist is not { } frist)
            {
                return 0;
            }
            var total = (frist - _ticket.OpprettetDato).TotalMinutes;
            if (total <= 0)
            {
                return 100;
            }
            return (int)Math.Clamp((DateTime.Now - _ticket.OpprettetDato).TotalMinutes / total * 100, 0, 100);
        }
    }

    private string AapenTekst
    {
        get
        {
            var slutt = _ticket?.Status == TicketStatus.Lukket && _ticket.LukketDato is { } l ? l : DateTime.Now;
            var tid = slutt - _ticket!.OpprettetDato;
            if (tid.TotalHours < 24)
            {
                return $"{Math.Max(0, (int)tid.TotalHours)} timer";
            }
            var dager = (int)tid.TotalDays;
            return dager == 1 ? "1 dag" : $"{dager} dager";
        }
    }

    // Hendelser som er skrevet av en person (kommentarer) vises som meldinger;
    // automatiske logglinjer vises som små systemlinjer i samtalen.
    private static readonly string[] SystemPrefikser =
    [
        "Status endret", "Knyttet til", "Kopierte", "La til vedlegg", "Godkjent og lukket", "Gjenåpnet",
        "E-post sendt", "Klarte ikke", "Arbeidsordre ferdigstilt", "Ticket opprettet", "Opprettet",
        "Tildelt til", "Tildeling fjernet", "Automatisk"
    ];

    private static bool ErMelding(TicketHendelse h) =>
        h.UtfortAvBruker is not null && !SystemPrefikser.Any(p => h.Beskrivelse.StartsWith(p, StringComparison.OrdinalIgnoreCase));

    private static string SystemIkon(string tekst) =>
        tekst.StartsWith("Status") || tekst.StartsWith("Godkjent") ? "check-circle"
        : tekst.Contains("arbeidsordre", StringComparison.OrdinalIgnoreCase) ? "tool"
        : tekst.StartsWith("E-post") || tekst.StartsWith("Klarte") ? "mail"
        : tekst.StartsWith("La til vedlegg") ? "camera"
        : tekst.StartsWith("Opprettet") || tekst.StartsWith("Ticket opprettet") ? "plus"
        : "circle";

    private static string Initialer(string? navn) =>
        string.IsNullOrWhiteSpace(navn)
            ? "?"
            : string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));

    private static string Naar(DateTime t)
    {
        if (t.Date == DateTime.Today)
        {
            return $"i dag {t:HH:mm}";
        }
        if (t.Date == DateTime.Today.AddDays(-1))
        {
            return $"i går {t:HH:mm}";
        }
        return t.ToString("dd.MM HH:mm");
    }

    // Opprett prosjekt / tilbud rett fra ticketen. Uten prosjekt åpnes de vanlige
    // skjemaene ferdig utfylt (som før). Med prosjekt lages tilbudet direkte på
    // prosjektet, logges på ticketen og åpnes.
    private RenderFragment OpprettKnapper(string klasse) => __builder =>
    {
        if (_ticket!.ProsjektId is null)
        {
            <a class="@klasse" href="@ProsjektNyUrl()" target="_blank"><Icon Name="folder" />Opprett prosjekt</a>
            <a class="@klasse" href="@TilbudServiceNyUrl()" target="_blank"><Icon Name="file-text" />Opprett tilbud</a>
        }
        else
        {
            <button type="button" class="@klasse" @onclick="OpprettTilbud"><Icon Name="file-text" />Opprett tilbud</button>
        }
    };

    private async Task OpprettTilbud()
    {
        if (_ticket?.ProsjektId is not int prosjektId)
        {
            return;
        }

        var prosjekt = await Db.Prosjekter.Include(p => p.Kunde).FirstOrDefaultAsync(p => p.Id == prosjektId);
        if (prosjekt is null)
        {
            return;
        }

        var tilbud = new Tilbud
        {
            ProsjektId = prosjekt.Id,
            Tittel = _ticket.Tittel,
            ForesporselBeskrivelse = !string.IsNullOrWhiteSpace(_ticket.Foresporsel?.Innhold) ? _ticket.Foresporsel.Innhold : _ticket.Beskrivelse,
            KontaktpersonNavn = _ticket.Kontaktperson
        };

        // Samme prisoppsett som "Nytt tilbud" på en serviceavtale.
        if (prosjekt.Status == ProsjektStatus.Serviceavtale && prosjekt.Kunde is not null)
        {
            if (prosjekt.Kunde.FastPaslagProsent is decimal paslag)
            {
                tilbud.PrisType = TilbudPrisType.Paslag;
                tilbud.Prosentsats = paslag;
            }
            else if (await Db.KundeRabatter.AnyAsync(r => r.KundeId == prosjekt.Kunde.Id))
            {
                tilbud.PrisType = TilbudPrisType.Rabatt;
            }
        }

        Db.Tilbud.Add(tilbud);
        await Db.SaveChangesAsync();

        Db.TilbudHendelser.Add(new TilbudHendelse
        {
            TilbudId = tilbud.Id,
            Beskrivelse = $"Tilbudet ble opprettet fra ticket #{_ticket.Id}",
            UtfortAvBrukerId = _naverendeBrukerId
        });
        LoggHendelse($"Opprettet tilbud: {tilbud.Tittel}");
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/tilbud/{tilbud.Id}");
    }
