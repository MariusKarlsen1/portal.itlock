@page "/finn-min-side"
@layout PortalItlock.Web.Components.Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Finn min side - Full Kontroll</PageTitle>

<div class="login-card">
    <h1>Finn min side</h1>
    <p class="sett-passord-hint">Skriv inn e-posten din, så sender vi deg videre til riktig innlogging.</p>

    @if (IkkeFunnet == "1")
    {
        <p class="login-error">Fant ingen konto med den e-posten. Sjekk at du har skrevet den riktig, eller ta kontakt med den som opprettet kontoen din.</p>
    }
    @if (ForMange == "1")
    {
        <p class="login-error">For mange forsøk. Vent noen minutter og prøv igjen.</p>
    }

    <form method="post" action="/konto/finn-min-side">
        <label>
            E-post
            <input type="email" name="epost" required autofocus />
        </label>
        <button type="submit">Fortsett</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ikkeFunnet")]
    public string? IkkeFunnet { get; set; }

    [SupplyParameterFromQuery(Name = "forMange")]
    public string? ForMange { get; set; }
}
