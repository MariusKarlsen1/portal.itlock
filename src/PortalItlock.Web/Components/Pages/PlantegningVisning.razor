@page "/plantegning/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider TilgangAuth
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject PlantegningDorPdfService PdfService
@inject LagretPdfService LagretPdfService
@inject MobilVerktoylinjeService Verktoylinje

<PageTitle>@(_plantegning?.Navn ?? "Plantegning")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke plantegningen. Den kan være slettet.</p>
}
else if (_plantegning is not null)
{
    @if (!_erMobilvisning)
    {
        <a class="back-link" href="@TilbakeUrl">&larr; @(_erServiceavtale ? "Tilbake til serviceavtalen" : "Tilbake til prosjektet")</a>

        <div class="plan-header">
            <div class="plan-header-tekst">
                <div class="plan-header-tittel">
                    <span class="plan-header-ikon"><Icon Name="map" /></span>
                    <h1>@_plantegning.Navn</h1>
                </div>
                @if (!string.IsNullOrWhiteSpace(_plantegning.Byggetrinn))
                {
                    <p class="plan-subtitle">@_plantegning.Byggetrinn</p>
                }
            </div>
            <div class="plan-header-actions">
                @if (_harBrann)
                {
                    <div class="plan-rev-bytt plan-type-bytt" role="group" aria-label="Velg tegning">
                        <button type="button" class="@(!_visBrann ? "pa" : "")" @onclick="@(() => _visBrann = false)">Tegning</button>
                        <button type="button" class="@(_visBrann ? "pa pa-brann" : "")" @onclick="@(() => { _visBrann = true; _visRevisjonId = null; })">Branntegning</button>
                    </div>
                }
                <button type="button" class="plan-ny-rev kun-leder" @onclick="@(() => { _visNyRevisjon = true; _nyRevFeil = null; })" title="Erstatt tegningen med en ny versjon. Dører og utstyr står på samme plass.">
                    <Icon Name="upload" />Last opp ny revisjon
                </button>
                <button type="button" class="plan-finn-dorer kun-leder" @onclick="@(() => _visDorFinner = true)" title="Les dørmerker, høyre/venstre og rom fra PDF-en og opprett dørene">
                    <Icon Name="upload" />Les dører fra PDF
                </button>
                <button type="button" class="plan-brann-last kun-leder" @onclick="@(() => _visBranntegningDlg = true)" title="Last opp branntegning for denne plantegningen">
                    <Icon Name="upload" />@(_harBrann ? "Ny branntegning" : "Last opp branntegning")
                </button>
                @if (_revisjoner.Count > 0 && !_visBrann)
                {
                    <div class="plan-rev-bytt" role="group" aria-label="Revisjon av tegningen">
                        <button type="button" class="@(_visRevisjonId is null ? "pa" : "")" @onclick="@(() => _visRevisjonId = null)"
                                title="Gjeldende tegning, lastet opp @((_plantegning.RevidertDato ?? _plantegning.OpprettetDato).ToLocalTime().ToString("dd.MM.yyyy"))">
                            Rev. @_plantegning.Revisjon <small>gjeldende</small>
                        </button>
                        @foreach (var r in _revisjoner)
                        {
                            var rid = r.Id;
                            <button type="button" class="@(_visRevisjonId == rid ? "pa" : "")" @onclick="@(() => _visRevisjonId = rid)"
                                    title="Lastet opp @r.OpplastetDato.ToLocalTime().ToString("dd.MM.yyyy"), erstattet @r.ErstattetDato.ToLocalTime().ToString("dd.MM.yyyy")">
                                Rev. @r.Revisjon
                            </button>
                        }
                    </div>
                }
                <button type="button" class="add-button" @onclick="VisPdfForhandsvisning">Generer PDF</button>
                <button type="button" class="save-button kun-leder" @onclick="LagreAlt">Lagre</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="saved-hint">@_savedMessage</p>
        }

        @if (_visDorFinner)
        {
            <PlanDorFinner Plantegning="_plantegning" DorerPaTegningen="_dorer" OnLukk="@(() => _visDorFinner = false)" OnOpprettet="DorerFunnet" />
        }
        @if (!string.IsNullOrEmpty(_dorFinnerMelding))
        {
            <p class="plan-rev-hint"><Icon Name="check" />@_dorFinnerMelding <button type="button" @onclick="@(() => _dorFinnerMelding = null)">OK</button></p>
        }

        @if (_visNyRevisjon)
        {
            <div class="nr-bak" @onclick="LukkNyRevisjon"></div>
            <div class="nr-dlg" role="dialog" aria-modal="true" aria-label="Last opp ny revisjon">
                <h3>Last opp ny revisjon</h3>
                <p class="nr-hjelp">Erstatter tegningen «@_plantegning.Navn». Nå: Rev. @_plantegning.Revisjon.</p>
                <ul class="nr-liste">
                    <li><Icon Name="check" />Blir Rev. @(_plantegning.Revisjon + 1). Rev. @_plantegning.Revisjon arkiveres og kan åpnes igjen.</li>
                    <li><Icon Name="check" />Dører, utstyr og prikker står på samme plass.</li>
                    <li><Icon Name="check" />Tegningen lagres akkurat som du laster den opp. Filnavnet spiller ingen rolle.</li>
                </ul>
                @if (!string.IsNullOrEmpty(_nyRevFeil))
                {
                    <p class="form-error">@_nyRevFeil</p>
                }
                <div class="nr-knapper">
                    <button type="button" class="nr-kn" @onclick="LukkNyRevisjon" disabled="@_lasterNyRev">Avbryt</button>
                    <label class="nr-kn nr-kn-p @(_lasterNyRev ? "av" : "")">
                        <Icon Name="upload" />@(_lasterNyRev ? "Laster opp …" : $"Velg fil og last opp Rev. {_plantegning.Revisjon + 1}")
                        @if (!_lasterNyRev)
                        {
                            <InputFile OnChange="LastOppNyRevisjon" accept="image/*,.pdf,application/pdf" />
                        }
                    </label>
                </div>
            </div>
        }

        @if (_visBranntegningDlg)
        {
            <BranntegningDialog Plantegninger="@([_plantegning])" Valgt="_plantegning.Id"
                                MedBrann="@(_harBrann ? [_plantegning.Id] : [])"
                                OnLukk="@(() => _visBranntegningDlg = false)" OnLastetOpp="BranntegningLastetOpp" />
        }

        @if (_visBrann)
        {
            <p class="plan-rev-hint plan-brann-hint"><Icon Name="map" />Du ser branntegningen. Dørene står der de er plassert på plantegningen. <button type="button" @onclick="@(() => _visBrann = false)">Tilbake til tegningen</button></p>
        }

        @if (VistRevisjon is { } vist)
        {
            <p class="plan-rev-hint"><Icon Name="map" />Du ser rev. @vist.Revisjon fra @vist.OpplastetDato.ToLocalTime().ToString("dd.MM.yyyy"). Dørene står der de er plassert på gjeldende tegning, så du kan sammenligne. <button type="button" @onclick="@(() => _visRevisjonId = null)">Tilbake til gjeldende</button></p>
        }

        @if (_placingMode != PlacingMode.Ingen)
        {
            <p class="placing-hint placing-hint-aktiv">Klikk på tegningen der døren skal plasseres.</p>
        }
        else if (_redigerPosisjon)
        {
            <p class="placing-hint placing-hint-aktiv">Du kan nå dra dørene til ny posisjon.</p>
        }

        @if (_visDorVelger && !_velgerFraHoyreklikk)
        {
            <div class="dor-velger-panel">
                @DorVelgerInnhold
            </div>
        }

        @if (_visFilter)
        {
            <div class="dor-velger-panel">
                <div class="dor-velger-header">
                    <strong>Filtrer på dørfunksjon</strong>
                    <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
                </div>

                <ul class="funksjon-chip-list">
                    @foreach (var f in _alleFunksjoner)
                    {
                        <li @key="f.Id">
                            <label class="filter-option">
                                <input type="checkbox" checked="@_valgteFilterIds.Contains(f.Id)" @onchange="@(() => ToggleFilter(f.Id))" />
                                @f.Navn
                            </label>
                        </li>
                    }
                </ul>

                @if (_valgteFilterIds.Count > 0)
                {
                    <button type="button" class="cancel-button" @onclick="@(() => _valgteFilterIds.Clear())">Nullstill filter</button>
                }
            </div>
        }
    }
    else
    {
        <a class="back-link mobil-plan-back" href="@TilbakeUrl">
            <Icon Name="arrow-left" /> @_plantegning.Navn
        </a>
    }

    @* Rammen fyller resten av vinduet (høyden settes av plantegning.js), og
       verktøylinjen ligger flytende øverst over tegningen. *@
    <div class="plan-layout @(_erMobilvisning ? "" : "plan-full")">
      <div class="plan-ramme">
        @if (!_erMobilvisning)
        {
        <div class="plan-toolbar plan-toolbar-flytende">
            <div class="plan-toolbar-knapper">
                <button type="button" class="@(_placingMode == PlacingMode.NyDor ? "edit-button-active" : "add-button add-button-primer")" @onclick="ToggleNyDor">
                    @(_placingMode == PlacingMode.NyDor ? "Avbryt plassering" : "Ny dør her")
                </button>

                <button type="button" class="add-button kun-leder" @onclick="ApneDorVelger">Finn dører</button>

                <a class="add-button" href="@($"/plantegning/{Id}/utstyr")">Plassering utstyr og trekking</a>

                <button type="button" class="@(_redigerPosisjon ? "edit-button-active" : "add-button")" @onclick="TogglePosisjonRediger">
                    @(_redigerPosisjon ? "Lås posisjoner" : "Rediger posisjoner")
                </button>

                <button type="button" class="add-button" @onclick="ToggleMarkorStil">
                    @(_markorStil == "dorikon" ? "Vis som kule" : "Vis som dørikon")
                </button>

                @if (_alleFunksjoner.Count > 0)
                {
                    <button type="button" class="@(_valgteFilterIds.Count > 0 ? "edit-button-active" : "add-button")" @onclick="@(() => _visFilter = !_visFilter)">
                        Filtrer@(_valgteFilterIds.Count > 0 ? $" ({_valgteFilterIds.Count})" : "")
                    </button>
                }

                <button type="button" class="@(_visPdfSkuff ? "edit-button-active" : "add-button")" @onclick="@(() => _visPdfSkuff = !_visPdfSkuff)">
                    PDF (@_lagredePdfer.Count)
                </button>
            </div>

            <div class="plan-legend-rad">
                <span class="plan-legend"><span class="legend-dot legend-ferdig"></span> @MontasjeStatus.FerdigMontert.Visningsnavn()</span>
                <span class="plan-legend"><span class="legend-dot legend-montert"></span> @MontasjeStatus.Montert.Visningsnavn()</span>
                <span class="plan-legend"><span class="legend-dot legend-ikke-startet"></span> @MontasjeStatus.IkkeStartet.Visningsnavn()</span>
            </div>
        </div>
        <p class="plan-hint-flytende">Rull med musehjulet for å zoome · hold inne venstre museknapp og dra for å flytte · høyreklikk for å legge til en dør</p>
        }
        <div class="plan-canvas-wrap @(_erMobilvisning ? "mobil-plan-canvas-wrap" : "")" @ref="_canvasWrapRef">
            <div class="plan-canvas @(_redigerPosisjon ? "plan-canvas-rediger" : "")"
                 @ref="_canvasRef"
                 @onclick="OnCanvasClick">
                <img src="@BildeUrl" alt="@_plantegning.Navn" class="plan-image" />
                @foreach (var d in SynligeDorer)
                {
                    <div @key="d.Id" class="dor-marker @(_selectedDoor?.Id == d.Id ? "dor-marker-selected" : "")"
                         style="left:@(d.PosX!.Value.ToString(CultureInfo.InvariantCulture))%; top:@(d.PosY!.Value.ToString(CultureInfo.InvariantCulture))%;"
                         data-dorid="@d.Id">
                        @{ var forkortelser = FunksjonForkortelser(d); }
                        <span class="dor-marker-label">@d.Dornummer</span>
                        @if (_markorStil == "dorikon")
                        {
                            <svg class="dor-marker-dorikon @StatusClass(d.Status)" viewBox="0 0 40 56">
                                <rect class="dorikon-fill" x="2" y="2" width="36" height="52" rx="2" />
                                <rect class="dorikon-panel" x="8" y="7" width="24" height="18" rx="1.5" />
                                <rect class="dorikon-panel" x="8" y="30" width="24" height="18" rx="1.5" />
                                <circle class="dorikon-handle" cx="32" cy="29" r="1.6" />
                            </svg>
                        }
                        else
                        {
                            <span class="dor-marker-dot @StatusClass(d.Status)"></span>
                        }
                        @if (!string.IsNullOrEmpty(forkortelser))
                        {
                            <span class="dor-marker-funksjoner">@forkortelser</span>
                        }
                    </div>
                }

                @if (_visDorVelger && _velgerFraHoyreklikk)
                {
                    <div class="dor-velger-panel dor-velger-flytende"
                         style="left:@(_hoyreklikkX.ToString(CultureInfo.InvariantCulture))%; top:@(_hoyreklikkY.ToString(CultureInfo.InvariantCulture))%;">
                        @DorVelgerInnhold
                    </div>
                }
            </div>

            @if (_erMobilvisning)
            {
                <div class="plan-zoom-controls">
                    <button type="button" class="plan-zoom-btn" title="Tilbakestill zoom" @onclick="ResetZoom"><Icon Name="maximize" /></button>
                    <button type="button" class="plan-zoom-btn" title="Zoom ut" @onclick="ZoomOut"><Icon Name="minus" /></button>
                    <button type="button" class="plan-zoom-btn" title="Zoom inn" @onclick="ZoomIn"><Icon Name="plus" /></button>
                </div>
            }
        </div>
        @if (!_erMobilvisning)
        {
            <PlanPdfSkuff PlantegningId="_plantegning.Id" Aktiv="Plantegning" Apen="_visPdfSkuff" Versjon="_pdfVersjon"
                          OnLukk="@(() => _visPdfSkuff = false)" OnLagNy="VisPdfForhandsvisning" />
        }
      </div>
    </div>

    @if (_selectedDoor is not null)
    {
        <div class="dor-modal-overlay">
            <div class="dor-modal-panel">
                @if (!_erMobilvisning)
                {
                    // Dørvinduet er dørsiden (S13). En ny dør åpnes rett i redigering (Rediger), en eksisterende på Oversikt.
                    <DorDetalj Id="_selectedDoor.Id"
                               IModal="true"
                               MedRedigering="true"
                               StartFane="@(_selectedDoor.Id == _nyDorId ? "detaljer" : null)"
                               AlleDorer="_alleProsjektDorer"
                               OnLukk="@(() => { _selectedDoor = null; _nyDorId = null; })"
                               OnDeleted="OnDoorDeleted"
                               OnUnplaced="OnDoorUnplaced"
                               OnCloned="OnDoorsCloned"
                               OnSaved="StateHasChanged" />
                }
                else
                {
                    <DorRedigering Dor="_selectedDoor"
                                    AlleDorer="_alleProsjektDorer"
                                    ProsjektOverlevertDato="_prosjektOverlevertDato"
                                    ErMobilvisning="_erMobilvisning"
                                    OnClose="@(() => _selectedDoor = null)"
                                    OnDeleted="OnDoorDeleted"
                                    OnUnplaced="OnDoorUnplaced"
                                    OnCloned="OnDoorsCloned"
                                    OnSaved="StateHasChanged" />
                }
            </div>
        </div>
    }

    @if (!_erMobilvisning)
    {
        <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av dørplantegning" SaveMessage="@_pdfSavedMessage"
                          OnSave="LagrePlantegningPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private enum PlacingMode { Ingen, NyDor, EksisterendeDor }

    private Plantegning? _plantegning;
    private List<Dor> _dorer = [];
    private List<Dor> _alleProsjektDorer = [];
    private Dor? _selectedDoor;
    private PlacingMode _placingMode;
    private bool _notFound;
    private int? _loadedId;
    private int? _valgtEksisterendeDorId;
    private string? _savedMessage;
    private bool _redigerPosisjon;

    // Tidligere revisjoner av tegningen (uten filene). Null = vis gjeldende tegning.
    private sealed record RevisjonValg(int Id, int Revisjon, DateTime OpplastetDato, DateTime ErstattetDato);
    private List<RevisjonValg> _revisjoner = [];
    private int? _visRevisjonId;
    private RevisjonValg? VistRevisjon => _revisjoner.FirstOrDefault(r => r.Id == _visRevisjonId);
    private string BildeUrl => _visBrann && _harBrann
        ? $"/plantegningbrann/{_plantegning!.Id}?v={_brannVersjon}"
        : VistRevisjon is { } r
            ? $"/plantegningrevisjon/{r.Id}"
            : $"/plantegningbilde/{_plantegning!.Id}?r={_plantegning.Revisjon}";

    // Branntegning knyttet til plantegningen, vist med de samme dørene.
    private bool _harBrann;
    private bool _visBrann;
    private bool _visBranntegningDlg;

    // Ny revisjon lastet opp rett på denne tegningen (uavhengig av filnavn).
    private bool _visNyRevisjon;
    private bool _lasterNyRev;
    private string? _nyRevFeil;

    private void LukkNyRevisjon()
    {
        if (!_lasterNyRev)
        {
            _visNyRevisjon = false;
        }
    }

    private async Task LastOppNyRevisjon(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        if (_plantegning is null)
        {
            return;
        }
        _nyRevFeil = null;
        _lasterNyRev = true;
        try
        {
            var lest = await PlantegningOpplasting.LesAsync(e.File);
            if (lest.Data is null)
            {
                _nyRevFeil = lest.Feil;
                return;
            }
            await PlantegningOpplasting.NyRevisjonAsync(Db, _plantegning, e.File.Name, lest.ContentType, lest.Data);
            _revisjoner = await Db.PlantegningRevisjoner.AsNoTracking()
                .Where(r => r.PlantegningId == _plantegning.Id)
                .OrderByDescending(r => r.Revisjon)
                .Select(r => new RevisjonValg(r.Id, r.Revisjon, r.OpplastetDato, r.ErstattetDato))
                .ToListAsync();
            _visRevisjonId = null;
            _visBrann = false;
            _visNyRevisjon = false;
            _dorFinnerMelding = $"Rev. {_plantegning.Revisjon} er lastet opp. Dører og utstyr står på samme plass.";
        }
        catch (Exception)
        {
            _nyRevFeil = "Klarte ikke å lagre den nye revisjonen. Prøv igjen.";
        }
        finally
        {
            _lasterNyRev = false;
        }
    }
    private bool _visDorFinner;
    private string? _dorFinnerMelding;

    // Dører funnet og opprettet fra PDF-en (PlanDorFinner) vises med en gang.
    private void DorerFunnet(List<Dor> nye)
    {
        _visDorFinner = false;
        _dorer.AddRange(nye);
        _alleProsjektDorer.AddRange(nye);
        _dorFinnerMelding = $"{nye.Count} {(nye.Count == 1 ? "dør" : "dører")} opprettet fra tegningen. Sjekk plasseringen og flytt prikkene om noe er feil.";
    }
    private long _brannVersjon;

    private async Task BranntegningLastetOpp(int _)
    {
        _visBranntegningDlg = false;
        await LastBrannInfo();
        _visBrann = true;
        _visRevisjonId = null;
    }

    private async Task LastBrannInfo()
    {
        var dato = await Db.PlantegningBranntegninger.AsNoTracking()
            .Where(b => b.PlantegningId == Id)
            .Select(b => (DateTime?)b.OpplastetDato)
            .FirstOrDefaultAsync();
        _harBrann = dato is not null;
        _brannVersjon = dato?.Ticks ?? 0;
    }
    private bool _visDorsideIPopup;

    // En nettopp opprettet dør åpnes på fanen Detaljer, ellers Oversikt.
    private int? _nyDorId;
    private string _markorStil = "kule";
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private List<LagretPdf> _lagredePdfer = [];
    private bool _visPdfSkuff;
    private int _pdfVersjon;

    // Mobilvisning avgjøres sentralt (én gang per krets, av MainLayout via
    // MobilFilterKnapp) og leses herfra via delt tjeneste - egen JS-interop-
    // deteksjon per side viste seg upålitelig ved navigasjon internt i appen
    // (f.eks. fra en plantegningskort i Prosjekter-fanen hit), siden
    // HttpContext er null da og førsteinntrykket ble stående feil helt til -
    // om noensinne - JS-interop-kallet slo til.
    private bool _erMobilvisning => Verktoylinje.ErMobilvisning;

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    private bool _visDorVelger;
    private bool _velgerFraHoyreklikk;
    private double _hoyreklikkX;
    private double _hoyreklikkY;
    private string _dorVelgerSok = "";

    private sealed class FunksjonOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<FunksjonOption> _alleFunksjoner = [];
    private HashSet<int> _valgteFilterIds = [];
    private bool _visFilter;

    private List<Dor> SynligeDorer => _valgteFilterIds.Count == 0
        ? _dorer
        : _dorer.Where(d => d.Funksjoner.Any(f => _valgteFilterIds.Contains(f.Id))).ToList();

    private void VisPdfForhandsvisning()
    {
        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/plantegning/{Id}/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagrePlantegningPdf()
    {
        var bytes = await PdfService.GenerateAsync(Id);
        if (bytes is null || _plantegning is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "Plantegning", Id, $"Dørplantegning - {_plantegning.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Add(pdf);
        _pdfVersjon++;
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private void ToggleFilter(int funksjonId)
    {
        if (!_valgteFilterIds.Add(funksjonId))
        {
            _valgteFilterIds.Remove(funksjonId);
        }
    }

    // Plantegning på en serviceavtale: «Tilbake» går til avtalens «Dører og beslag».
    private bool _erServiceavtale;
    private string TilbakeUrl => _plantegning is null ? "/" : _erServiceavtale ? $"/serviceavtaler/{_plantegning.ProsjektId}?fane=dorer" : $"/prosjekter/{_plantegning.ProsjektId}";

    private List<Dor> _uplasserteDorer => _alleProsjektDorer.Where(d => d.PlantegningId is null).ToList();

    private List<Dor> FiltrerteDorer => string.IsNullOrWhiteSpace(_dorVelgerSok)
        ? _uplasserteDorer
        : _uplasserteDorer.Where(d => d.Dornummer.Contains(_dorVelgerSok.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private DateTime? _prosjektOverlevertDato;

    private ElementReference _canvasRef;
    private ElementReference _canvasWrapRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlantegningVisning>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedDoor = null;
        _placingMode = PlacingMode.Ingen;
        _redigerPosisjon = false;
        _visDorVelger = false;

        _plantegning = await Db.Plantegninger
            .Include(p => p.Dorer).ThenInclude(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .Include(p => p.Dorer).ThenInclude(d => d.Komponenter).ThenInclude(dk => dk.MontertAvBruker)
            .Include(p => p.Dorer).ThenInclude(d => d.Funksjoner)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_plantegning is null)
        {
            _notFound = true;
            return;
        }

        _erServiceavtale = await Db.Prosjekter.AsNoTracking().AnyAsync(x => x.Id == _plantegning.ProsjektId && x.Status == ProsjektStatus.Serviceavtale);
        _visRevisjonId = null;
        _visBrann = false;
        await LastBrannInfo();
        _revisjoner = await Db.PlantegningRevisjoner.AsNoTracking()
            .Where(r => r.PlantegningId == _plantegning.Id)
            .OrderByDescending(r => r.Revisjon)
            .Select(r => new RevisjonValg(r.Id, r.Revisjon, r.OpplastetDato, r.ErstattetDato))
            .ToListAsync();
        _lagredePdfer = await LagretPdfService.HentAsync("Plantegning", Id);

        _dorer = _plantegning.Dorer.Where(d => d.PosX.HasValue && d.PosY.HasValue).ToList();

        _alleProsjektDorer = await Db.Dorer
            .Where(d => d.ProsjektId == _plantegning.ProsjektId)
            .Include(d => d.Funksjoner)
            .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .OrderBy(d => d.Dornummer)
            .ToListAsync();

        _prosjektOverlevertDato = await Db.Prosjekter
            .Where(p => p.Id == _plantegning.ProsjektId)
            .Select(p => p.OverlevertDato)
            .FirstOrDefaultAsync();

        _alleFunksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .Select(f => new FunksjonOption { Id = f.Id, Navn = f.Navn })
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plantegning.js?v=20");
            _dotNetRef = DotNetObjectReference.Create(this);

            var lagretMarkorStil = await _module.InvokeAsync<string?>("getMarkorStil");
            if (!string.IsNullOrEmpty(lagretMarkorStil) && lagretMarkorStil != _markorStil)
            {
                _markorStil = lagretMarkorStil;
                StateHasChanged();
            }
        }

        if (_module is not null && _dotNetRef is not null && _plantegning is not null)
        {
            await _module.InvokeVoidAsync("attachMarkers", _canvasRef, _dotNetRef, !_redigerPosisjon);

            if (firstRender)
            {
                await _module.InvokeVoidAsync("initSaveShortcut", _dotNetRef);
                await _module.InvokeVoidAsync("initZoomPan", _canvasWrapRef, _canvasRef, _dotNetRef);
            }
        }
    }

    // Uten dette forblir plantegning.js sin klikk/dra-vurdering (12px terskel, se
    // pointerdown i plantegning.js) fullt aktiv selv når man står i "Ny dør her" e.l.,
    // eller når den flytende dørvelgeren fra høyreklikk er åpen - begge er DOM-elementer
    // inni selve .plan-canvas, så knappene i dem (velg dør fra liste, Lukk) fanges av
    // samme wrapEl-nivå klikk/dra-lytter. Et lett skjelvende klikk/trykk kan da bli
    // feiltolket som panorering og spist (capture-fase click-lytteren i plantegning.js
    // kaller stopPropagation FØR knappens egen onclick i det hele tatt rekker å kjøre),
    // slik at klikket virker trått/upålitelig eller ikke skjer i det hele tatt.
    // "setUtstyrPlacing" er samme generiske flagg PlantegningUtstyr.razor bruker for sin
    // plasseringsmodus - JS-funksjonen bryr seg bare om selve dataset-attributtet.
    private async Task OppdaterPlasseringsflaggAsync()
    {
        if (_module is not null)
        {
            var aktiv = _placingMode != PlacingMode.Ingen || (_visDorVelger && _velgerFraHoyreklikk);
            await _module.InvokeVoidAsync("setUtstyrPlacing", _canvasRef, aktiv);
        }
    }

    private static string StatusClass(MontasjeStatus status) => status switch
    {
        MontasjeStatus.FerdigMontert => "dor-marker-ferdig",
        MontasjeStatus.Montert => "dor-marker-montert",
        _ => "dor-marker-ikke-startet"
    };

    // Varsel når dørnummeret man skrev inn i velgeren finnes fra før.
    private string? _dorNrFeil;

    private static string FunksjonForkortelser(Dor d) => string.Join(", ",
        d.Funksjoner.IFastRekkefolge()
            .Where(f => !string.IsNullOrWhiteSpace(f.Forkortelse))
            .Select(f => f.Forkortelse));

    [JSInvokable]
    public async Task SaveNow()
    {
        await LagreAlt();
    }

    private async Task LagreAlt()
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
        _redigerPosisjon = false;
        StateHasChanged();
    }

    private void TogglePosisjonRediger()
    {
        _redigerPosisjon = !_redigerPosisjon;
    }

    private Task ZoomIn() => _module?.InvokeVoidAsync("planZoomIn", _canvasWrapRef).AsTask() ?? Task.CompletedTask;
    private Task ZoomOut() => _module?.InvokeVoidAsync("planZoomOut", _canvasWrapRef).AsTask() ?? Task.CompletedTask;
    private Task ResetZoom() => _module?.InvokeVoidAsync("planResetZoom", _canvasWrapRef).AsTask() ?? Task.CompletedTask;

    private async Task ToggleMarkorStil()
    {
        _markorStil = _markorStil == "dorikon" ? "kule" : "dorikon";

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setMarkorStil", _markorStil);
        }
    }

    [JSInvokable]
    public async Task OnDoorMoved(int dorId, double x, double y)
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        dor.PosX = x;
        dor.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public async Task OnDoorClicked(int dorId)
    {
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        await SelectDoor(dor);
        StateHasChanged();
    }

    private async Task ToggleNyDor()
    {
        _visDorVelger = false;
        _placingMode = _placingMode == PlacingMode.NyDor ? PlacingMode.Ingen : PlacingMode.NyDor;
        if (_placingMode == PlacingMode.NyDor)
        {
            _selectedDoor = null;
        }
        await OppdaterPlasseringsflaggAsync();
    }

    private async Task ApneDorVelger()
    {
        _placingMode = PlacingMode.Ingen;
        _selectedDoor = null;
        _dorVelgerSok = "";
        _velgerFraHoyreklikk = false;
        _visDorVelger = true;
        await OppdaterPlasseringsflaggAsync();
    }

    [JSInvokable]
    public async Task OnCanvasRightClicked(double x, double y)
    {
        if (_plantegning is null)
        {
            return;
        }

        _placingMode = PlacingMode.Ingen;
        _selectedDoor = null;
        _dorVelgerSok = "";
        _hoyreklikkX = x;
        _hoyreklikkY = y;
        _velgerFraHoyreklikk = true;
        _visDorVelger = true;
        await OppdaterPlasseringsflaggAsync();
        StateHasChanged();
    }

    private async Task LukkDorVelger()
    {
        _visDorVelger = false;
        await OppdaterPlasseringsflaggAsync();
    }

    // Innholdet i dørvelgeren - delt mellom "Finn dører"-knappen (fast plassering over
    // tegningen) og høyreklikk (flytende, plassert rett der man klikket, for raskere plassering
    // av flere dører etter hverandre uten å måtte lete etter panelet et annet sted på siden).
    private RenderFragment DorVelgerInnhold => @<text>
        <div class="dor-velger-header">
            <strong>@(_velgerFraHoyreklikk ? "Legg til dør her" : "Finn dører å plassere")</strong>
            <button type="button" class="cancel-button" @onclick="LukkDorVelger">Lukk</button>
        </div>
        <input class="dor-velger-search" @bind="_dorVelgerSok" @bind:event="oninput" placeholder="Søk dørnummer..." autofocus />

        @if (FiltrerteDorer.Count > 0 || string.IsNullOrWhiteSpace(_dorVelgerSok))
        {
            <ul class="dor-velger-list">
                @foreach (var d in FiltrerteDorer)
                {
                    <li @key="d.Id">
                        <button type="button" class="dor-velger-item kun-leder" @onclick="@(() => VelgDorFraListe(d))">@d.Dornummer</button>
                    </li>
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(_dorVelgerSok) && !FiltrerteDorer.Any(d => d.Dornummer.Equals(_dorVelgerSok.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            <button type="button" class="dor-velger-ny kun-leder" @onclick="OpprettNyDorFraVelger">+ Opprett ny dør "@_dorVelgerSok.Trim()"</button>
            @if (_dorNrFeil is not null)
            {
                <p class="dor-velger-feil" role="alert">@_dorNrFeil</p>
            }
        }

        @if (_uplasserteDorer.Count == 0 && string.IsNullOrWhiteSpace(_dorVelgerSok))
        {
            <p class="list-empty">Ingen uplasserte dører. Søk opp et dørnummer for å opprette en ny.</p>
        }
    </text>;

    private async Task VelgDorFraListe(Dor d)
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        if (_plantegning is null)
        {
            return;
        }

        if (_velgerFraHoyreklikk)
        {
            d.PlantegningId = _plantegning.Id;
            d.PosX = _hoyreklikkX;
            d.PosY = _hoyreklikkY;
            await Db.SaveChangesAsync();

            d.Komponenter = await Db.DorKomponenter
                .Where(dk => dk.DorId == d.Id)
                .Include(dk => dk.Component)
                .ToListAsync();

            _dorer.Add(d);
            _visDorVelger = false;
            await PlassertAsync();
        }
        else
        {
            _valgtEksisterendeDorId = d.Id;
            _placingMode = PlacingMode.EksisterendeDor;
            _visDorVelger = false;
            await OppdaterPlasseringsflaggAsync();
        }
    }

    private async Task OpprettNyDorFraVelger()
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        if (_plantegning is null || string.IsNullOrWhiteSpace(_dorVelgerSok))
        {
            return;
        }

        if (await PortalItlock.Web.Services.DorNummer.FinnesAsync(Db, _plantegning.ProsjektId, _dorVelgerSok))
        {
            _dorNrFeil = PortalItlock.Web.Services.DorNummer.Melding(_dorVelgerSok);
            return;
        }
        _dorNrFeil = null;
        var dor = new Dor
        {
            ProsjektId = _plantegning.ProsjektId,
            Dornummer = _dorVelgerSok.Trim()
        };

        if (_velgerFraHoyreklikk)
        {
            dor.PlantegningId = _plantegning.Id;
            dor.PosX = _hoyreklikkX;
            dor.PosY = _hoyreklikkY;
        }

        Db.Dorer.Add(dor);
        await Db.SaveChangesAsync();
        _alleProsjektDorer.Add(dor);

        if (_velgerFraHoyreklikk)
        {
            _dorer.Add(dor);
            _visDorVelger = false;
            _nyDorId = dor.Id;
            await PlassertAsync();
        }
        else
        {
            _valgtEksisterendeDorId = dor.Id;
            _placingMode = PlacingMode.EksisterendeDor;
            _visDorVelger = false;
            await OppdaterPlasseringsflaggAsync();
        }
    }

    private async Task OnCanvasClick(MouseEventArgs e)
    {
        if (!await PortalItlock.Web.Services.Tilgang.KanRedigereAsync(TilgangAuth, "prosjekter"))
        {
            return;
        }
        if (_plantegning is null || _module is null)
        {
            return;
        }

        if (_placingMode == PlacingMode.Ingen)
        {
            return;
        }

        var pos = await _module.InvokeAsync<PosResult>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);

        if (_placingMode == PlacingMode.NyDor)
        {
            var dor = new Dor
            {
                ProsjektId = _plantegning.ProsjektId,
                PlantegningId = _plantegning.Id,
                Dornummer = await PortalItlock.Web.Services.DorNummer.LedigAsync(Db, _plantegning.ProsjektId, "Ny dør"),
                PosX = pos.X,
                PosY = pos.Y
            };

            Db.Dorer.Add(dor);
            await Db.SaveChangesAsync();

            _dorer.Add(dor);
            _alleProsjektDorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            _nyDorId = dor.Id;
            await PlassertAsync();
        }
        else if (_placingMode == PlacingMode.EksisterendeDor && _valgtEksisterendeDorId.HasValue)
        {
            var dor = _alleProsjektDorer.FirstOrDefault(d => d.Id == _valgtEksisterendeDorId.Value);
            if (dor is null)
            {
                return;
            }

            dor.PlantegningId = _plantegning.Id;
            dor.PosX = pos.X;
            dor.PosY = pos.Y;
            await Db.SaveChangesAsync();

            dor.Komponenter = await Db.DorKomponenter
                .Where(dk => dk.DorId == dor.Id)
                .Include(dk => dk.Component)
                .ToListAsync();

            _dorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            _valgtEksisterendeDorId = null;
            await PlassertAsync();
        }
    }

    // Døren er plassert: bli på tegningen, ikke åpne dørsiden.
    private async Task PlassertAsync()
    {
        _selectedDoor = null;
        _placingMode = PlacingMode.Ingen;
        _visDorsideIPopup = false;
        await OppdaterPlasseringsflaggAsync();
    }

    private async Task SelectDoor(Dor d)
    {
        _selectedDoor = d;
        _placingMode = PlacingMode.Ingen;
        _visDorsideIPopup = false;
        await OppdaterPlasseringsflaggAsync();
    }

    private void OnDoorDeleted()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _alleProsjektDorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private void OnDoorUnplaced()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private void OnDoorsCloned(List<Dor> nyeDorer)
    {
        _alleProsjektDorer.AddRange(nyeDorer);
    }

    private sealed class PosResult
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
