@page "/plantegning/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>@(_plantegning?.Navn ?? "Plantegning")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke plantegningen. Den kan være slettet.</p>
}
else if (_plantegning is not null)
{
    <a class="back-link" href="@($"/prosjekter/{_plantegning.ProsjektId}")">&larr; Tilbake til prosjektet</a>

    <h1>@_plantegning.Navn</h1>
    @if (!string.IsNullOrWhiteSpace(_plantegning.Byggetrinn))
    {
        <p class="plan-subtitle">@_plantegning.Byggetrinn</p>
    }

    <div class="plan-toolbar">
        <button type="button" class="add-button" @onclick="ToggleNyDor">
            @(_placingMode == PlacingMode.NyDor ? "Avbryt plassering" : "Ny dør her")
        </button>

        @if (_uplasserteDorer.Count > 0)
        {
            <select @bind="_valgtEksisterendeDorId">
                <option value="">Plasser eksisterende dør...</option>
                @foreach (var d in _uplasserteDorer)
                {
                    <option value="@d.Id">@d.Dornummer</option>
                }
            </select>
            <button type="button" class="add-button" @onclick="TogglePlasserEksisterende" disabled="@(_valgtEksisterendeDorId is null)">
                @(_placingMode == PlacingMode.EksisterendeDor ? "Avbryt plassering" : "Plasser")
            </button>
        }

        <button type="button" class="save-button" @onclick="LagreAlt">Lagre</button>

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="saved-hint">@_savedMessage</span>
        }

        @if (_placingMode != PlacingMode.Ingen)
        {
            <span class="placing-hint">Klikk på tegningen der døren skal plasseres.</span>
        }
        <span class="plan-legend"><span class="legend-dot legend-ferdig"></span> Ferdig montert</span>
        <span class="plan-legend"><span class="legend-dot legend-montert"></span> Montert</span>
        <span class="plan-legend"><span class="legend-dot legend-ikke-startet"></span> Ikke startet</span>
    </div>

    <div class="plan-layout">
        <div class="plan-canvas-wrap">
            <div class="plan-canvas" @ref="_canvasRef" @onclick="OnCanvasClick">
                <img src="@($"/plantegningbilde/{_plantegning.Id}")" alt="@_plantegning.Navn" class="plan-image" />
                @foreach (var d in _dorer)
                {
                    <div @key="d.Id" class="dor-marker @StatusClass(d.Status) @(_selectedDoor?.Id == d.Id ? "dor-marker-selected" : "")"
                         style="left:@(d.PosX!.Value.ToString(CultureInfo.InvariantCulture))%; top:@(d.PosY!.Value.ToString(CultureInfo.InvariantCulture))%;"
                         data-dorid="@d.Id">
                        @d.Dornummer
                    </div>
                }
            </div>
        </div>

        @if (_selectedDoor is not null)
        {
            <DorRedigering Dor="_selectedDoor"
                            OnClose="@(() => _selectedDoor = null)"
                            OnDeleted="OnDoorDeleted"
                            OnUnplaced="OnDoorUnplaced"
                            OnSaved="StateHasChanged" />
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private enum PlacingMode { Ingen, NyDor, EksisterendeDor }

    private Plantegning? _plantegning;
    private List<Dor> _dorer = [];
    private List<Dor> _alleProsjektDorer = [];
    private Dor? _selectedDoor;
    private PlacingMode _placingMode;
    private bool _notFound;
    private int? _loadedId;
    private int? _valgtEksisterendeDorId;
    private string? _savedMessage;

    private List<Dor> _uplasserteDorer => _alleProsjektDorer.Where(d => d.PlantegningId is null).ToList();

    private ElementReference _canvasRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlantegningVisning>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedDoor = null;
        _placingMode = PlacingMode.Ingen;

        _plantegning = await Db.Plantegninger
            .Include(p => p.Dorer).ThenInclude(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_plantegning is null)
        {
            _notFound = true;
            return;
        }

        _dorer = _plantegning.Dorer.Where(d => d.PosX.HasValue && d.PosY.HasValue).ToList();

        _alleProsjektDorer = await Db.Dorer
            .Where(d => d.ProsjektId == _plantegning.ProsjektId)
            .OrderBy(d => d.Dornummer)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plantegning.js");
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (_module is not null && _dotNetRef is not null && _plantegning is not null)
        {
            await _module.InvokeVoidAsync("attachMarkers", _canvasRef, _dotNetRef);

            if (firstRender)
            {
                await _module.InvokeVoidAsync("initSaveShortcut", _dotNetRef);
            }
        }
    }

    private static string StatusClass(MontasjeStatus status) => status switch
    {
        MontasjeStatus.FerdigMontert => "dor-marker-ferdig",
        MontasjeStatus.Montert => "dor-marker-montert",
        _ => "dor-marker-ikke-startet"
    };

    [JSInvokable]
    public async Task SaveNow()
    {
        await LagreAlt();
    }

    private async Task LagreAlt()
    {
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDoorMoved(int dorId, double x, double y)
    {
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        dor.PosX = x;
        dor.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public void OnDoorClicked(int dorId)
    {
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        SelectDoor(dor);
        StateHasChanged();
    }

    private void ToggleNyDor()
    {
        _placingMode = _placingMode == PlacingMode.NyDor ? PlacingMode.Ingen : PlacingMode.NyDor;
        if (_placingMode == PlacingMode.NyDor)
        {
            _selectedDoor = null;
        }
    }

    private void TogglePlasserEksisterende()
    {
        _placingMode = _placingMode == PlacingMode.EksisterendeDor ? PlacingMode.Ingen : PlacingMode.EksisterendeDor;
        if (_placingMode == PlacingMode.EksisterendeDor)
        {
            _selectedDoor = null;
        }
    }

    private async Task OnCanvasClick(MouseEventArgs e)
    {
        if (_placingMode == PlacingMode.Ingen || _plantegning is null || _module is null)
        {
            return;
        }

        var pos = await _module.InvokeAsync<PosResult>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);

        if (_placingMode == PlacingMode.NyDor)
        {
            var dor = new Dor
            {
                ProsjektId = _plantegning.ProsjektId,
                PlantegningId = _plantegning.Id,
                Dornummer = "Ny dør",
                PosX = pos.X,
                PosY = pos.Y
            };

            Db.Dorer.Add(dor);
            await Db.SaveChangesAsync();

            _dorer.Add(dor);
            _alleProsjektDorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            SelectDoor(dor);
        }
        else if (_placingMode == PlacingMode.EksisterendeDor && _valgtEksisterendeDorId.HasValue)
        {
            var dor = _alleProsjektDorer.FirstOrDefault(d => d.Id == _valgtEksisterendeDorId.Value);
            if (dor is null)
            {
                return;
            }

            dor.PlantegningId = _plantegning.Id;
            dor.PosX = pos.X;
            dor.PosY = pos.Y;
            await Db.SaveChangesAsync();

            dor.Komponenter = await Db.DorKomponenter
                .Where(dk => dk.DorId == dor.Id)
                .Include(dk => dk.Component)
                .ToListAsync();

            _dorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            _valgtEksisterendeDorId = null;
            SelectDoor(dor);
        }
    }

    private void SelectDoor(Dor d)
    {
        _selectedDoor = d;
        _placingMode = PlacingMode.Ingen;
    }

    private void OnDoorDeleted()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _alleProsjektDorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private void OnDoorUnplaced()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private sealed class PosResult
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
