@page "/plantegning/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>@(_plantegning?.Navn ?? "Plantegning")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke plantegningen. Den kan være slettet.</p>
}
else if (_plantegning is not null)
{
    <a class="back-link" href="@($"/prosjekter/{_plantegning.ProsjektId}")">&larr; Tilbake til prosjektet</a>

    <h1>@_plantegning.Navn</h1>
    @if (!string.IsNullOrWhiteSpace(_plantegning.Byggetrinn))
    {
        <p class="plan-subtitle">@_plantegning.Byggetrinn</p>
    }

    <div class="plan-toolbar">
        <button type="button" class="add-button" @onclick="ToggleNyDor">
            @(_placingMode == PlacingMode.NyDor ? "Avbryt plassering" : "Ny dør her")
        </button>

        <button type="button" class="add-button" @onclick="ApneDorVelger">Finn dører</button>

        <div class="utstyr-toolbar-item">
            <button type="button" class="@(_utstyrPlacingType.HasValue ? "edit-button-active" : "add-button")" @onclick="ToggleUtstyrVelger">
                @(_utstyrPlacingType.HasValue ? $"Legger til: {_utstyrPlacingType.Value.Visningsnavn()}" : "Legg til utstyr")
            </button>

            @if (_visUtstyrVelger)
            {
                <div class="utstyr-velger-panel">
                    @foreach (var type in UtstyrTyper)
                    {
                        <button type="button" class="utstyr-velger-item" @onclick="@(() => VelgUtstyrType(type))">
                            <span class="utstyr-badge" style="background:@type.Farge()">@type.Kode()</span>
                            @type.Visningsnavn()
                        </button>
                    }
                </div>
            }
        </div>

        <button type="button" class="@(_redigerPosisjon ? "edit-button-active" : "add-button")" @onclick="TogglePosisjonRediger">
            @(_redigerPosisjon ? "Lås posisjoner" : "Rediger posisjoner")
        </button>

        @if (_alleFunksjoner.Count > 0)
        {
            <button type="button" class="@(_valgteFilterIds.Count > 0 ? "edit-button-active" : "add-button")" @onclick="@(() => _visFilter = !_visFilter)">
                Filtrer@(_valgteFilterIds.Count > 0 ? $" ({_valgteFilterIds.Count})" : "")
            </button>
        }

        <button type="button" class="save-button" @onclick="LagreAlt">Lagre</button>

        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <span class="saved-hint">@_savedMessage</span>
        }

        @if (_placingMode != PlacingMode.Ingen)
        {
            <span class="placing-hint">Klikk på tegningen der døren skal plasseres.</span>
        }
        else if (_utstyrPlacingType.HasValue)
        {
            <span class="placing-hint">Klikk på tegningen for å legge til flere. <button type="button" class="cancel-button" @onclick="AvbrytUtstyrPlassering">Avbryt plassering</button></span>
        }
        else if (_redigerPosisjon)
        {
            <span class="placing-hint">Du kan nå dra dørene til ny posisjon.</span>
        }

        <span class="plan-legend"><span class="legend-dot legend-ferdig"></span> @MontasjeStatus.FerdigMontert.Visningsnavn()</span>
        <span class="plan-legend"><span class="legend-dot legend-montert"></span> @MontasjeStatus.Montert.Visningsnavn()</span>
        <span class="plan-legend"><span class="legend-dot legend-ikke-startet"></span> @MontasjeStatus.IkkeStartet.Visningsnavn()</span>
    </div>

    <div class="utstyr-legend">
        @foreach (var type in UtstyrTyper)
        {
            <span class="utstyr-legend-item">
                <span class="utstyr-badge utstyr-badge-small" style="background:@type.Farge()">@type.Kode()</span>
                @type.Visningsnavn()
            </span>
        }
    </div>

    @if (_visDorVelger)
    {
        <div class="dor-velger-panel">
            <div class="dor-velger-header">
                <strong>@(_velgerFraHoyreklikk ? "Legg til dør her" : "Finn dører å plassere")</strong>
                <button type="button" class="cancel-button" @onclick="LukkDorVelger">Lukk</button>
            </div>
            <input class="dor-velger-search" @bind="_dorVelgerSok" @bind:event="oninput" placeholder="Søk dørnummer..." autofocus />

            @if (FiltrerteDorer.Count > 0 || string.IsNullOrWhiteSpace(_dorVelgerSok))
            {
                <ul class="dor-velger-list">
                    @foreach (var d in FiltrerteDorer)
                    {
                        <li @key="d.Id">
                            <button type="button" class="dor-velger-item" @onclick="@(() => VelgDorFraListe(d))">@d.Dornummer</button>
                        </li>
                    }
                </ul>
            }

            @if (!string.IsNullOrWhiteSpace(_dorVelgerSok) && !FiltrerteDorer.Any(d => d.Dornummer.Equals(_dorVelgerSok.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                <button type="button" class="dor-velger-ny" @onclick="OpprettNyDorFraVelger">+ Opprett ny dør "@_dorVelgerSok.Trim()"</button>
            }

            @if (_uplasserteDorer.Count == 0 && string.IsNullOrWhiteSpace(_dorVelgerSok))
            {
                <p class="list-empty">Ingen uplasserte dører. Søk opp et dørnummer for å opprette en ny.</p>
            }
        </div>
    }

    @if (_visFilter)
    {
        <div class="dor-velger-panel">
            <div class="dor-velger-header">
                <strong>Filtrer på dørfunksjon</strong>
                <button type="button" class="cancel-button" @onclick="@(() => _visFilter = false)">Lukk</button>
            </div>

            <ul class="funksjon-chip-list">
                @foreach (var f in _alleFunksjoner)
                {
                    <li @key="f.Id">
                        <label class="filter-option">
                            <input type="checkbox" checked="@_valgteFilterIds.Contains(f.Id)" @onchange="@(() => ToggleFilter(f.Id))" />
                            @f.Navn
                        </label>
                    </li>
                }
            </ul>

            @if (_valgteFilterIds.Count > 0)
            {
                <button type="button" class="cancel-button" @onclick="@(() => _valgteFilterIds.Clear())">Nullstill filter</button>
            }
        </div>
    }

    <p class="placing-hint">Rull med musehjulet for å zoome. Trykk og hold venstre museknapp på tegningen for å dra deg rundt. Høyreklikk for å legge til en dør.</p>

    <div class="plan-layout">
        <div class="plan-canvas-wrap" @ref="_canvasWrapRef">
            <div class="plan-canvas @(_redigerPosisjon ? "plan-canvas-rediger" : "")"
                 @ref="_canvasRef"
                 @onclick="OnCanvasClick">
                <img src="@($"/plantegningbilde/{_plantegning.Id}")" alt="@_plantegning.Navn" class="plan-image" />
                @foreach (var d in SynligeDorer)
                {
                    <div @key="d.Id" class="dor-marker @(_selectedDoor?.Id == d.Id ? "dor-marker-selected" : "")"
                         style="left:@(d.PosX!.Value.ToString(CultureInfo.InvariantCulture))%; top:@(d.PosY!.Value.ToString(CultureInfo.InvariantCulture))%;"
                         data-dorid="@d.Id">
                        @{ var forkortelser = FunksjonForkortelser(d); }
                        @if (!string.IsNullOrEmpty(forkortelser))
                        {
                            <span class="dor-marker-funksjoner">@forkortelser</span>
                        }
                        <span class="dor-marker-dot @StatusClass(d.Status)"></span>
                        <span class="dor-marker-label">@(string.IsNullOrWhiteSpace(d.Romnr) ? d.Dornummer : d.Romnr)</span>
                    </div>
                }
                @foreach (var u in _utstyr)
                {
                    <div @key="u.Id" class="utstyr-marker @(_selectedUtstyr?.Id == u.Id ? "utstyr-marker-selected" : "")"
                         style="left:@(u.PosX.ToString(CultureInfo.InvariantCulture))%; top:@(u.PosY.ToString(CultureInfo.InvariantCulture))%;"
                         data-utstyrid="@u.Id">
                        <span class="utstyr-badge" style="background:@u.Type.Farge()">@u.Type.Kode()</span>
                    </div>
                }
            </div>
        </div>

        @if (_selectedDoor is not null)
        {
            <DorRedigering Dor="_selectedDoor"
                            AlleDorer="_alleProsjektDorer"
                            OnClose="@(() => _selectedDoor = null)"
                            OnDeleted="OnDoorDeleted"
                            OnUnplaced="OnDoorUnplaced"
                            OnCloned="OnDoorsCloned"
                            OnSaved="StateHasChanged" />
        }
        else if (_selectedUtstyr is not null)
        {
            <div class="utstyr-panel">
                <div class="utstyr-panel-header">
                    <h2><span class="utstyr-badge" style="background:@_selectedUtstyr.Type.Farge()">@_selectedUtstyr.Type.Kode()</span> @_selectedUtstyr.Type.Visningsnavn()</h2>
                    <button type="button" class="cancel-button" @onclick="@(() => _selectedUtstyr = null)">Lukk</button>
                </div>
                <label class="utstyr-notat-label">
                    Notat
                    <textarea rows="3" @bind="_selectedUtstyr.Notat"></textarea>
                </label>
                <div class="utstyr-panel-actions">
                    <button type="button" class="save-button" @onclick="LagreUtstyr">Lagre</button>
                    <button type="button" class="delete-button" @onclick="SlettUtstyr">Slett</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private enum PlacingMode { Ingen, NyDor, EksisterendeDor }

    private Plantegning? _plantegning;
    private List<Dor> _dorer = [];
    private List<Dor> _alleProsjektDorer = [];
    private Dor? _selectedDoor;
    private PlacingMode _placingMode;
    private bool _notFound;
    private int? _loadedId;
    private int? _valgtEksisterendeDorId;
    private string? _savedMessage;
    private bool _redigerPosisjon;

    private bool _visDorVelger;
    private bool _velgerFraHoyreklikk;
    private double _hoyreklikkX;
    private double _hoyreklikkY;
    private string _dorVelgerSok = "";

    private sealed class FunksjonOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<FunksjonOption> _alleFunksjoner = [];
    private HashSet<int> _valgteFilterIds = [];
    private bool _visFilter;

    private static readonly PlanUtstyrType[] UtstyrTyper =
    [
        PlanUtstyrType.Kortleser,
        PlanUtstyrType.Kac,
        PlanUtstyrType.Apneknapp,
        PlanUtstyrType.Sentral,
        PlanUtstyrType.Stikkontakt,
        PlanUtstyrType.Ups
    ];

    private List<PlanUtstyr> _utstyr = [];
    private PlanUtstyr? _selectedUtstyr;
    private bool _visUtstyrVelger;
    private PlanUtstyrType? _utstyrPlacingType;

    private List<Dor> SynligeDorer => _valgteFilterIds.Count == 0
        ? _dorer
        : _dorer.Where(d => d.Funksjoner.Any(f => _valgteFilterIds.Contains(f.Id))).ToList();

    private void ToggleFilter(int funksjonId)
    {
        if (!_valgteFilterIds.Add(funksjonId))
        {
            _valgteFilterIds.Remove(funksjonId);
        }
    }

    private List<Dor> _uplasserteDorer => _alleProsjektDorer.Where(d => d.PlantegningId is null).ToList();

    private List<Dor> FiltrerteDorer => string.IsNullOrWhiteSpace(_dorVelgerSok)
        ? _uplasserteDorer
        : _uplasserteDorer.Where(d => d.Dornummer.Contains(_dorVelgerSok.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private ElementReference _canvasRef;
    private ElementReference _canvasWrapRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlantegningVisning>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _notFound = false;
        _selectedDoor = null;
        _placingMode = PlacingMode.Ingen;
        _redigerPosisjon = false;
        _visDorVelger = false;
        _selectedUtstyr = null;
        _visUtstyrVelger = false;
        _utstyrPlacingType = null;

        _plantegning = await Db.Plantegninger
            .Include(p => p.Dorer).ThenInclude(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .Include(p => p.Dorer).ThenInclude(d => d.Komponenter).ThenInclude(dk => dk.MontertAvBruker)
            .Include(p => p.Dorer).ThenInclude(d => d.Funksjoner)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_plantegning is null)
        {
            _notFound = true;
            return;
        }

        _dorer = _plantegning.Dorer.Where(d => d.PosX.HasValue && d.PosY.HasValue).ToList();

        _alleProsjektDorer = await Db.Dorer
            .Where(d => d.ProsjektId == _plantegning.ProsjektId)
            .Include(d => d.Funksjoner)
            .OrderBy(d => d.Dornummer)
            .ToListAsync();

        _alleFunksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .Select(f => new FunksjonOption { Id = f.Id, Navn = f.Navn })
            .ToListAsync();

        _utstyr = await Db.PlanUtstyr
            .Where(u => u.PlantegningId == Id)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plantegning.js?v=2");
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (_module is not null && _dotNetRef is not null && _plantegning is not null)
        {
            await _module.InvokeVoidAsync("attachMarkers", _canvasRef, _dotNetRef, !_redigerPosisjon);
            await _module.InvokeVoidAsync("attachUtstyrMarkers", _canvasRef, _dotNetRef, !_redigerPosisjon);

            if (firstRender)
            {
                await _module.InvokeVoidAsync("initSaveShortcut", _dotNetRef);
                await _module.InvokeVoidAsync("initZoomPan", _canvasWrapRef, _canvasRef, _dotNetRef);
            }
        }
    }

    private static string StatusClass(MontasjeStatus status) => status switch
    {
        MontasjeStatus.FerdigMontert => "dor-marker-ferdig",
        MontasjeStatus.Montert => "dor-marker-montert",
        _ => "dor-marker-ikke-startet"
    };

    private static string FunksjonForkortelser(Dor d) => string.Join(", ",
        d.Funksjoner
            .Where(f => !string.IsNullOrWhiteSpace(f.Forkortelse))
            .Select(f => f.Forkortelse));

    [JSInvokable]
    public async Task SaveNow()
    {
        await LagreAlt();
    }

    private async Task LagreAlt()
    {
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
        _redigerPosisjon = false;
        StateHasChanged();
    }

    private void TogglePosisjonRediger()
    {
        _redigerPosisjon = !_redigerPosisjon;
    }

    [JSInvokable]
    public async Task OnDoorMoved(int dorId, double x, double y)
    {
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        dor.PosX = x;
        dor.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public void OnDoorClicked(int dorId)
    {
        var dor = _dorer.FirstOrDefault(d => d.Id == dorId);
        if (dor is null)
        {
            return;
        }

        SelectDoor(dor);
        StateHasChanged();
    }

    private void ToggleNyDor()
    {
        _visDorVelger = false;
        _utstyrPlacingType = null;
        _placingMode = _placingMode == PlacingMode.NyDor ? PlacingMode.Ingen : PlacingMode.NyDor;
        if (_placingMode == PlacingMode.NyDor)
        {
            _selectedDoor = null;
        }
    }

    private void ApneDorVelger()
    {
        _placingMode = PlacingMode.Ingen;
        _utstyrPlacingType = null;
        _selectedDoor = null;
        _dorVelgerSok = "";
        _velgerFraHoyreklikk = false;
        _visDorVelger = true;
    }

    [JSInvokable]
    public void OnCanvasRightClicked(double x, double y)
    {
        if (_plantegning is null)
        {
            return;
        }

        _placingMode = PlacingMode.Ingen;
        _selectedDoor = null;
        _dorVelgerSok = "";
        _hoyreklikkX = x;
        _hoyreklikkY = y;
        _velgerFraHoyreklikk = true;
        _visDorVelger = true;
        StateHasChanged();
    }

    private void LukkDorVelger()
    {
        _visDorVelger = false;
    }

    private async Task VelgDorFraListe(Dor d)
    {
        if (_plantegning is null)
        {
            return;
        }

        if (_velgerFraHoyreklikk)
        {
            d.PlantegningId = _plantegning.Id;
            d.PosX = _hoyreklikkX;
            d.PosY = _hoyreklikkY;
            await Db.SaveChangesAsync();

            d.Komponenter = await Db.DorKomponenter
                .Where(dk => dk.DorId == d.Id)
                .Include(dk => dk.Component)
                .ToListAsync();

            _dorer.Add(d);
            _visDorVelger = false;
            SelectDoor(d);
        }
        else
        {
            _valgtEksisterendeDorId = d.Id;
            _placingMode = PlacingMode.EksisterendeDor;
            _visDorVelger = false;
        }
    }

    private async Task OpprettNyDorFraVelger()
    {
        if (_plantegning is null || string.IsNullOrWhiteSpace(_dorVelgerSok))
        {
            return;
        }

        var dor = new Dor
        {
            ProsjektId = _plantegning.ProsjektId,
            Dornummer = _dorVelgerSok.Trim()
        };

        if (_velgerFraHoyreklikk)
        {
            dor.PlantegningId = _plantegning.Id;
            dor.PosX = _hoyreklikkX;
            dor.PosY = _hoyreklikkY;
        }

        Db.Dorer.Add(dor);
        await Db.SaveChangesAsync();
        _alleProsjektDorer.Add(dor);

        if (_velgerFraHoyreklikk)
        {
            _dorer.Add(dor);
            _visDorVelger = false;
            SelectDoor(dor);
        }
        else
        {
            _valgtEksisterendeDorId = dor.Id;
            _placingMode = PlacingMode.EksisterendeDor;
            _visDorVelger = false;
        }
    }

    private async Task OnCanvasClick(MouseEventArgs e)
    {
        if (_plantegning is null || _module is null)
        {
            return;
        }

        if (_utstyrPlacingType.HasValue)
        {
            var posU = await _module.InvokeAsync<PosResult>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);
            var utstyr = new PlanUtstyr
            {
                PlantegningId = _plantegning.Id,
                Type = _utstyrPlacingType.Value,
                PosX = posU.X,
                PosY = posU.Y
            };
            Db.PlanUtstyr.Add(utstyr);
            await Db.SaveChangesAsync();
            _utstyr.Add(utstyr);
            return;
        }

        if (_placingMode == PlacingMode.Ingen)
        {
            return;
        }

        var pos = await _module.InvokeAsync<PosResult>("getClickPercent", _canvasRef, e.ClientX, e.ClientY);

        if (_placingMode == PlacingMode.NyDor)
        {
            var dor = new Dor
            {
                ProsjektId = _plantegning.ProsjektId,
                PlantegningId = _plantegning.Id,
                Dornummer = "Ny dør",
                PosX = pos.X,
                PosY = pos.Y
            };

            Db.Dorer.Add(dor);
            await Db.SaveChangesAsync();

            _dorer.Add(dor);
            _alleProsjektDorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            SelectDoor(dor);
        }
        else if (_placingMode == PlacingMode.EksisterendeDor && _valgtEksisterendeDorId.HasValue)
        {
            var dor = _alleProsjektDorer.FirstOrDefault(d => d.Id == _valgtEksisterendeDorId.Value);
            if (dor is null)
            {
                return;
            }

            dor.PlantegningId = _plantegning.Id;
            dor.PosX = pos.X;
            dor.PosY = pos.Y;
            await Db.SaveChangesAsync();

            dor.Komponenter = await Db.DorKomponenter
                .Where(dk => dk.DorId == dor.Id)
                .Include(dk => dk.Component)
                .ToListAsync();

            _dorer.Add(dor);
            _placingMode = PlacingMode.Ingen;
            _valgtEksisterendeDorId = null;
            SelectDoor(dor);
        }
    }

    private void SelectDoor(Dor d)
    {
        _selectedDoor = d;
        _selectedUtstyr = null;
        _placingMode = PlacingMode.Ingen;
    }

    private void OnDoorDeleted()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _alleProsjektDorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private void OnDoorUnplaced()
    {
        if (_selectedDoor is null)
        {
            return;
        }

        _dorer.Remove(_selectedDoor);
        _selectedDoor = null;
    }

    private void OnDoorsCloned(List<Dor> nyeDorer)
    {
        _alleProsjektDorer.AddRange(nyeDorer);
    }

    private void ToggleUtstyrVelger()
    {
        if (_utstyrPlacingType.HasValue)
        {
            AvbrytUtstyrPlassering();
            return;
        }

        _visUtstyrVelger = !_visUtstyrVelger;
    }

    private void VelgUtstyrType(PlanUtstyrType type)
    {
        _placingMode = PlacingMode.Ingen;
        _selectedDoor = null;
        _selectedUtstyr = null;
        _utstyrPlacingType = type;
        _visUtstyrVelger = false;
    }

    private void AvbrytUtstyrPlassering()
    {
        _utstyrPlacingType = null;
        _visUtstyrVelger = false;
    }

    [JSInvokable]
    public async Task OnUtstyrMoved(int utstyrId, double x, double y)
    {
        var utstyr = _utstyr.FirstOrDefault(u => u.Id == utstyrId);
        if (utstyr is null)
        {
            return;
        }

        utstyr.PosX = x;
        utstyr.PosY = y;
        await Db.SaveChangesAsync();
    }

    [JSInvokable]
    public void OnUtstyrClicked(int utstyrId)
    {
        var utstyr = _utstyr.FirstOrDefault(u => u.Id == utstyrId);
        if (utstyr is null)
        {
            return;
        }

        _selectedUtstyr = utstyr;
        _selectedDoor = null;
        _placingMode = PlacingMode.Ingen;
        StateHasChanged();
    }

    private async Task LagreUtstyr()
    {
        if (_selectedUtstyr is null)
        {
            return;
        }

        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SlettUtstyr()
    {
        if (_selectedUtstyr is null)
        {
            return;
        }

        Db.PlanUtstyr.Remove(_selectedUtstyr);
        await Db.SaveChangesAsync();
        _utstyr.Remove(_selectedUtstyr);
        _selectedUtstyr = null;
    }

    private sealed class PosResult
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
