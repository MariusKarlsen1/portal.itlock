@page "/kunder/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject BronnoysundClient Bronnoysund

<PageTitle>@(_kunde?.Navn ?? "Kunde")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke kunden. Den kan være slettet.</p>
}
else if (_kunde is not null)
{
    <a class="back-link" href="/kunder">← Tilbake til kunder</a>
    <h1>@_kunde.Navn</h1>

    <div class="kunde-fane-nav">
        <button type="button" class="@FaneClass(KundeFane.Detaljer)" @onclick="@(() => _fane = KundeFane.Detaljer)">Detaljer</button>
        <button type="button" class="@FaneClass(KundeFane.Ordrer)" @onclick="@(() => _fane = KundeFane.Ordrer)">Ordrer @if (_arbeidsordrer.Count > 0) { <span class="kunde-fane-teller">@_arbeidsordrer.Count</span> }</button>
        <button type="button" class="@FaneClass(KundeFane.Tilbud)" @onclick="@(() => _fane = KundeFane.Tilbud)">Tilbud @if (_tilbudListe.Count > 0) { <span class="kunde-fane-teller">@_tilbudListe.Count</span> }</button>
        <button type="button" class="@FaneClass(KundeFane.Tickets)" @onclick="@(() => _fane = KundeFane.Tickets)">Tickets @if (_tickets.Count > 0) { <span class="kunde-fane-teller">@_tickets.Count</span> }</button>
        <button type="button" class="@FaneClass(KundeFane.Rabatter)" @onclick="@(() => _fane = KundeFane.Rabatter)">Rabatter</button>
    </div>

    @if (_fane == KundeFane.Detaljer)
    {
        <p class="section-hint">Tripletex kundenummer må fylles ut for å kunne eksportere tilbud til Tripletex som CSV.</p>

        <section class="kunde-section">
            <div class="field-grid">
                <label>
                    Org.nr
                    <span class="orgnr-rad">
                        <input @bind="_kunde.OrgNr" @bind:event="oninput" placeholder="9 siffer" maxlength="9" />
                        <button type="button" class="orgnr-sok-button" title="Hent fra Brønnøysundregisteret" @onclick="SlaOppOrgNr" disabled="@_slarOppOrgNr">&rarr;</button>
                    </span>
                </label>
                <label class="span-2 kunde-navn-sok-wrap">
                    Navn
                    <input value="@_kunde.Navn" @oninput="SokBronnoysund"
                           @onfocus="@(() => _visNavnForslag = _navnForslag.Count > 0)"
                           @onblur="SkjulNavnForslagForsinket" autocomplete="off" placeholder="Skriv navn for å søke i Brønnøysundregistrene..." />
                    @if (_sokerNavn)
                    {
                        <span class="kunde-navn-sok-status">Søker...</span>
                    }
                    @if (_visNavnForslag)
                    {
                        <ul class="kunde-navn-forslag">
                            @foreach (var f in _navnForslag)
                            {
                                <li>
                                    <button type="button" @onclick="@(() => VelgFraBronnoysund(f))">
                                        <span class="kunde-navn-forslag-navn">@f.Navn <span class="kunde-navn-forslag-orgnr">(@f.OrgNr)</span></span>
                                        @if (!string.IsNullOrWhiteSpace(f.Adresse) || !string.IsNullOrWhiteSpace(f.Sted))
                                        {
                                            <span class="kunde-navn-forslag-adresse">@f.Adresse@(!string.IsNullOrWhiteSpace(f.Adresse) && (!string.IsNullOrWhiteSpace(f.Postnr) || !string.IsNullOrWhiteSpace(f.Sted)) ? ", " : "")@f.Postnr @f.Sted</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </label>
                @if (_orgNrFeil is not null)
                {
                    <span class="form-error span-2">@_orgNrFeil</span>
                }
                <label>Kontaktperson<input @bind="_kunde.Kontaktperson" /></label>
                <label>Telefon<input @bind="_kunde.Telefon" /></label>
                <label>E-post<input @bind="_kunde.Epost" /></label>
                <label>Adresse<input @bind="_kunde.Adresse" /></label>
                <label>Post nr<input @bind="_kunde.Postnr" /></label>
                <label>Sted<input @bind="_kunde.Sted" /></label>
                <label>
                    Tripletex kundenr.
                    <input @bind="_kunde.TripletexKundenummer" placeholder="F.eks. 10010" />
                </label>
                <label>
                    Neste oppfølging
                    <input type="date" @bind="_nesteOppfolgingsDato" />
                </label>
                <label class="span-2">
                    Notater
                    <textarea rows="3" @bind="_kunde.Notater"></textarea>
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <span class="form-error">@_error</span>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="save-success">@_savedMessage</span>
                }
            </div>
        </section>

        <section class="kunde-section">
            <h2>Prosjekter</h2>
            @if (_prosjekter.Count == 0)
            {
                <p class="list-empty">Ingen prosjekter knyttet til denne kunden ennå.</p>
            }
            else
            {
                <ul class="prosjekt-list">
                    @foreach (var p in _prosjekter)
                    {
                        <li><a href="@($"/prosjekter/{p.Id}")">@p.Navn</a></li>
                    }
                </ul>
            }
        </section>

        <section class="kunde-section">
            <h2>Oppfølgingslogg</h2>
            <p class="section-hint">Loggfør kontakt og avtaler med kunden, og sett en dato for når dere bør følge opp igjen.</p>

            <div class="notat-legg-til">
                <textarea rows="2" @bind="_nyttNotat" @bind:event="oninput" placeholder="F.eks. Ringte kunden, avtalte befaring i uke 40..."></textarea>
                <button type="button" class="save-button" @onclick="LeggTilNotat" disabled="@string.IsNullOrWhiteSpace(_nyttNotat)">Logg oppfølging</button>
            </div>

            @if (_notater.Count == 0)
            {
                <p class="list-empty">Ingen loggførte oppfølginger ennå.</p>
            }
            else
            {
                <ul class="notat-list">
                    @foreach (var n in _notater)
                    {
                        <li @key="n.Id">
                            <p class="notat-meta">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(n.OpprettetAvBruker is not null ? $"- {n.OpprettetAvBruker.Navn}" : "")</p>
                            <p>@n.Tekst</p>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="kunde-section">
            @if (_confirmingDelete)
            {
                <span class="delete-confirm">
                    Er du sikker? Prosjekter knyttet til kunden mister koblingen, men slettes ikke.
                    <button type="button" class="delete-confirm-button" @onclick="SlettKunde">Ja, slett</button>
                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                </span>
            }
            else
            {
                <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett kunde</button>
            }
        </section>
    }
    else if (_fane == KundeFane.Ordrer)
    {
        <section class="kunde-section">
            <div class="fane-filter-rad">
                <button type="button" class="@OrdreFilterClass("Alle")" @onclick='@(() => _ordreFilter = "Alle")'>Alle (@_arbeidsordrer.Count)</button>
                <button type="button" class="@OrdreFilterClass("Planlagt")" @onclick='@(() => _ordreFilter = "Planlagt")'>Planlagt (@_arbeidsordrer.Count(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar))</button>
                <button type="button" class="@OrdreFilterClass("IArbeid")" @onclick='@(() => _ordreFilter = "IArbeid")'>I arbeid (@_arbeidsordrer.Count(a => a.Status == ArbeidsordreStatus.Pagaende))</button>
                <button type="button" class="@OrdreFilterClass("Ferdigmeldt")" @onclick='@(() => _ordreFilter = "Ferdigmeldt")'>Ferdigmeldt (@_arbeidsordrer.Count(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert))</button>
            </div>

            @if (!FiltrerteOrdrer.Any())
            {
                <p class="list-empty">Ingen arbeidsordre i denne kategorien.</p>
            }
            else
            {
                <ul class="kunde-relatert-list">
                    @foreach (var a in FiltrerteOrdrer)
                    {
                        <li @key="a.Id">
                            <a href="@($"/arbeidsordre/{a.Id}")">@a.Tittel</a>
                            <span class="status-badge @OrdreStatusFarge(a.Status)">@a.Status.Visningsnavn()</span>
                            <span class="kunde-relatert-dato">@a.OpprettetDato.ToString("dd.MM.yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
    else if (_fane == KundeFane.Tilbud)
    {
        <section class="kunde-section">
            <div class="fane-filter-rad">
                <button type="button" class="@TilbudFilterClass("Alle")" @onclick='@(() => _tilbudFilter = "Alle")'>Alle (@_tilbudListe.Count)</button>
                <button type="button" class="@TilbudFilterClass("Utkast")" @onclick='@(() => _tilbudFilter = "Utkast")'>Utkast (@_tilbudListe.Count(t => t.Status == EndringsmeldingStatus.Utkast))</button>
                <button type="button" class="@TilbudFilterClass("SendtTilKunde")" @onclick='@(() => _tilbudFilter = "SendtTilKunde")'>Sendt til kunde (@_tilbudListe.Count(t => t.Status == EndringsmeldingStatus.SendtTilKunde))</button>
                <button type="button" class="@TilbudFilterClass("Godkjent")" @onclick='@(() => _tilbudFilter = "Godkjent")'>Godkjent (@_tilbudListe.Count(t => t.Status == EndringsmeldingStatus.Godkjent))</button>
                <button type="button" class="@TilbudFilterClass("Avslatt")" @onclick='@(() => _tilbudFilter = "Avslatt")'>Avslått (@_tilbudListe.Count(t => t.Status == EndringsmeldingStatus.Avslatt))</button>
            </div>

            @if (!FiltrerteTilbud.Any())
            {
                <p class="list-empty">Ingen tilbud i denne kategorien.</p>
            }
            else
            {
                <ul class="kunde-relatert-list">
                    @foreach (var t in FiltrerteTilbud)
                    {
                        <li @key="t.Id">
                            <a href="@($"/tilbud/{t.Id}")">@t.Tittel</a>
                            <span class="status-badge @TilbudStatusFarge(t.Status)">@t.Status.Visningsnavn()</span>
                            <span class="kunde-relatert-dato">@t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
    else if (_fane == KundeFane.Tickets)
    {
        <section class="kunde-section">
            <div class="ny-ticket-rad">
                <input @bind="_nyTicketTittel" @bind:event="oninput" placeholder="Tittel på ny ticket..." />
                <button type="button" class="add-button" @onclick="OpprettTicket" disabled="@string.IsNullOrWhiteSpace(_nyTicketTittel)">Opprett ticket</button>
            </div>

            <div class="fane-filter-rad">
                <label class="vis-lukkede-toggle">
                    <input type="checkbox" @bind="_visLukkedeTickets" />
                    Vis lukkede
                </label>
            </div>

            @if (!VisteTickets.Any())
            {
                <p class="list-empty">Ingen tickets å vise.</p>
            }
            else
            {
                <ul class="kunde-relatert-list">
                    @foreach (var t in VisteTickets)
                    {
                        <li @key="t.Id">
                            <a href="@($"/ticket/{t.Id}")">@t.Tittel</a>
                            <span class="status-badge @TicketStatusFarge(t.Status)">@t.Status.Visningsnavn()</span>
                            <span class="status-badge @TicketPrioritetFarge(t.Prioritet)">@t.Prioritet.Visningsnavn()</span>
                            <span class="kunde-relatert-dato">@t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
    else if (_fane == KundeFane.Rabatter)
    {
        <section class="kunde-section">
            <p class="section-hint">Sett fast rabatt per produktgruppe for denne kunden. Rabatten fylles automatisk inn når varer fra gruppen legges til på tilbud.</p>

            @if (_kundeRabatter.Count == 0)
            {
                <p class="list-empty">Ingen rabatter satt for denne kunden ennå.</p>
            }
            else
            {
                <table class="rabatt-table">
                    <thead>
                        <tr>
                            <th>Produktgruppe</th>
                            <th>Rabatt %</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _kundeRabatter)
                        {
                            <tr @key="r.Id">
                                <td>@r.Produktgruppe?.Navn</td>
                                <td><input type="number" step="0.1" min="0" max="100" @bind="r.RabattProsent" class="rabatt-prosent-input" /></td>
                                <td class="rabatt-actions">
                                    <button type="button" class="save-button" @onclick="@(() => LagreRabatt(r))">Lagre</button>
                                    <button type="button" class="remove-button" @onclick="@(() => SlettRabatt(r))">Slett</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (LedigeProduktgrupper.Count > 0)
            {
                <div class="ny-rabattgruppe">
                    <h2>Legg til rabatt</h2>
                    <div class="ny-rabattgruppe-form">
                        <select @bind="_nyRabattProduktgruppeId">
                            <option value="">Velg produktgruppe...</option>
                            @foreach (var p in LedigeProduktgrupper)
                            {
                                <option value="@p.Id">@p.Navn</option>
                            }
                        </select>
                        <input type="number" step="0.1" min="0" max="100" @bind="_nyRabattProsent" placeholder="Rabatt %" class="rabatt-prosent-input" />
                        <button type="button" class="add-button" @onclick="LeggTilRabatt">Legg til</button>
                    </div>
                </div>
            }
            else
            {
                <p class="section-hint">Alle produktgrupper er allerede lagt til. Opprett flere under <a href="/produktgrupper">Produktgrupper</a>.</p>
            }

            @if (_kundeRabatter.Count > 0 && _andreKunder.Count > 0)
            {
                <div class="ny-rabattgruppe">
                    <h2>Kopier rabatter til annen kunde</h2>
                    <div class="ny-rabattgruppe-form">
                        <select @bind="_kopierTilKundeId">
                            <option value="">Velg kunde...</option>
                            @foreach (var k in _andreKunder)
                            {
                                <option value="@k.Id">@k.Navn</option>
                            }
                        </select>
                        <button type="button" class="add-button" @onclick="KopierRabatterTilAnnenKunde">Kopier</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_rabattFeil))
            {
                <p class="form-error">@_rabattFeil</p>
            }
            @if (!string.IsNullOrEmpty(_rabattMelding))
            {
                <p class="save-success">@_rabattMelding</p>
            }
        </section>

        <section class="kunde-section">
            <h2>Fast påslag</h2>
            <p class="section-hint">Settes et fast påslag her, fylles alle varer automatisk med pristype "Påslag" og denne verdien når kunden velges på et service-tilbud.</p>
            <div class="ny-rabattgruppe-form">
                <input type="number" step="0.1" min="0" @bind="_kunde!.FastPaslagProsent" class="rabatt-prosent-input" placeholder="Påslag %" />
                <button type="button" class="save-button" @onclick="LagreFastPaslag">Lagre</button>
            </div>
            @if (!string.IsNullOrEmpty(_paslagMelding))
            {
                <p class="save-success">@_paslagMelding</p>
            }
        </section>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private enum KundeFane { Detaljer, Ordrer, Tilbud, Tickets, Rabatter }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private Kunde? _kunde;
    private bool _notFound;
    private bool _confirmingDelete;
    private string? _error;
    private string? _savedMessage;
    private bool _slarOppOrgNr;
    private string? _orgNrFeil;
    private List<ProsjektOption> _prosjekter = [];
    private int? _loadedId;
    private DateOnly? _nesteOppfolgingsDato;
    private List<KundeOppfolgingNotat> _notater = [];
    private string _nyttNotat = "";
    private List<BronnoysundClient.Sokeresultat> _navnForslag = [];
    private bool _visNavnForslag;
    private bool _sokerNavn;
    private int _sokGenerasjon;

    private KundeFane _fane = KundeFane.Detaljer;
    private List<Arbeidsordre> _arbeidsordrer = [];
    private string _ordreFilter = "Alle";
    private List<Tilbud> _tilbudListe = [];
    private string _tilbudFilter = "Alle";
    private List<Ticket> _tickets = [];
    private bool _visLukkedeTickets;
    private string _nyTicketTittel = "";
    private List<Produktgruppe> _produktgrupper = [];
    private List<KundeRabatt> _kundeRabatter = [];
    private int? _nyRabattProduktgruppeId;
    private decimal _nyRabattProsent;
    private string? _rabattFeil;
    private string? _rabattMelding;
    private string? _paslagMelding;
    private List<Kunde> _andreKunder = [];
    private int? _kopierTilKundeId;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;

    private string FaneClass(KundeFane f) => _fane == f ? "kunde-fane-knapp aktiv" : "kunde-fane-knapp";
    private string OrdreFilterClass(string f) => _ordreFilter == f ? "fane-filter-knapp aktiv" : "fane-filter-knapp";
    private string TilbudFilterClass(string f) => _tilbudFilter == f ? "fane-filter-knapp aktiv" : "fane-filter-knapp";

    private IEnumerable<Arbeidsordre> FiltrerteOrdrer => _ordreFilter switch
    {
        "Planlagt" => _arbeidsordrer.Where(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar),
        "IArbeid" => _arbeidsordrer.Where(a => a.Status == ArbeidsordreStatus.Pagaende),
        "Ferdigmeldt" => _arbeidsordrer.Where(a => a.Status is ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert),
        _ => _arbeidsordrer
    };

    private IEnumerable<Tilbud> FiltrerteTilbud => _tilbudFilter switch
    {
        "Utkast" => _tilbudListe.Where(t => t.Status == EndringsmeldingStatus.Utkast),
        "SendtTilKunde" => _tilbudListe.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde),
        "Godkjent" => _tilbudListe.Where(t => t.Status == EndringsmeldingStatus.Godkjent),
        "Avslatt" => _tilbudListe.Where(t => t.Status == EndringsmeldingStatus.Avslatt),
        _ => _tilbudListe
    };

    private IEnumerable<Ticket> VisteTickets => _visLukkedeTickets ? _tickets : _tickets.Where(t => t.Status != TicketStatus.Lukket);

    private List<Produktgruppe> LedigeProduktgrupper => _produktgrupper
        .Where(p => _kundeRabatter.All(r => r.ProduktgruppeId != p.Id))
        .ToList();

    private static string OrdreStatusFarge(ArbeidsordreStatus s) => s switch
    {
        ArbeidsordreStatus.Ny => "status-badge-grey",
        ArbeidsordreStatus.Klar => "status-badge-blue",
        ArbeidsordreStatus.Pagaende => "status-badge-amber",
        ArbeidsordreStatus.Ferdig => "status-badge-green",
        ArbeidsordreStatus.Fakturert => "status-badge-purple",
        _ => "status-badge-grey"
    };

    private static string TilbudStatusFarge(EndringsmeldingStatus s) => s switch
    {
        EndringsmeldingStatus.Utkast => "status-badge-grey",
        EndringsmeldingStatus.SendtTilKunde => "status-badge-blue",
        EndringsmeldingStatus.Godkjent => "status-badge-green",
        EndringsmeldingStatus.Avslatt => "status-badge-red",
        _ => "status-badge-grey"
    };

    private static string TicketStatusFarge(TicketStatus s) => s switch
    {
        TicketStatus.Ny => "status-badge-blue",
        TicketStatus.UnderBehandling => "status-badge-amber",
        TicketStatus.VenterGodkjenning => "status-badge-purple",
        TicketStatus.Lukket => "status-badge-green",
        _ => "status-badge-grey"
    };

    private static string TicketPrioritetFarge(TicketPrioritet p) => p switch
    {
        TicketPrioritet.Lav => "status-badge-grey",
        TicketPrioritet.Normal => "status-badge-teal",
        TicketPrioritet.Hoy => "status-badge-orange",
        TicketPrioritet.Kritisk => "status-badge-red",
        _ => "status-badge-grey"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null && _naverendeBrukerId is null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _error = null;
        _savedMessage = null;
        _nyttNotat = "";
        _fane = KundeFane.Detaljer;

        _kunde = await Db.Kunder.FirstOrDefaultAsync(k => k.Id == Id);
        _notFound = _kunde is null;

        if (_kunde is null)
        {
            return;
        }

        _nesteOppfolgingsDato = _kunde.NesteOppfolgingsDato.HasValue
            ? DateOnly.FromDateTime(_kunde.NesteOppfolgingsDato.Value)
            : null;

        _prosjekter = await Db.Prosjekter
            .Where(p => p.KundeId == Id)
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        _notater = await Db.KundeOppfolgingNotater
            .Where(n => n.KundeId == Id)
            .Include(n => n.OpprettetAvBruker)
            .OrderByDescending(n => n.OpprettetDato)
            .ToListAsync();

        _arbeidsordrer = await Db.Arbeidsordre
            .Where(a => a.Prosjekt!.KundeId == Id)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        _tilbudListe = await Db.Tilbud
            .Where(t => t.Prosjekt!.KundeId == Id)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();

        _tickets = await Db.Tickets
            .Where(t => t.KundeId == Id)
            .OrderByDescending(t => t.OpprettetDato)
            .ToListAsync();

        _produktgrupper = await Db.Produktgrupper.OrderBy(p => p.Navn).ToListAsync();
        _andreKunder = await Db.Kunder.Where(k => k.Id != Id).OrderBy(k => k.Navn).ToListAsync();
        await LastKundeRabatterAsync();
    }

    private async Task LastKundeRabatterAsync()
    {
        _kundeRabatter = await Db.KundeRabatter
            .Where(r => r.KundeId == Id)
            .Include(r => r.Produktgruppe)
            .OrderBy(r => r.Produktgruppe!.Navn)
            .ToListAsync();
    }

    private async Task LeggTilRabatt()
    {
        _rabattFeil = null;
        _rabattMelding = null;

        if (_nyRabattProduktgruppeId is null)
        {
            _rabattFeil = "Velg en produktgruppe.";
            return;
        }

        Db.KundeRabatter.Add(new KundeRabatt
        {
            KundeId = Id,
            ProduktgruppeId = _nyRabattProduktgruppeId.Value,
            RabattProsent = _nyRabattProsent
        });
        await Db.SaveChangesAsync();

        _nyRabattProduktgruppeId = null;
        _nyRabattProsent = 0;
        _rabattMelding = "Rabatt lagt til.";
        await LastKundeRabatterAsync();
    }

    private async Task LagreRabatt(KundeRabatt r)
    {
        var entitet = await Db.KundeRabatter.FirstOrDefaultAsync(x => x.Id == r.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.RabattProsent = r.RabattProsent;
        await Db.SaveChangesAsync();
        _rabattFeil = null;
        _rabattMelding = "Lagret.";
    }

    private async Task SlettRabatt(KundeRabatt r)
    {
        var entitet = await Db.KundeRabatter.FirstOrDefaultAsync(x => x.Id == r.Id);
        if (entitet is null)
        {
            return;
        }

        Db.KundeRabatter.Remove(entitet);
        await Db.SaveChangesAsync();
        _rabattMelding = "Rabatt fjernet.";
        await LastKundeRabatterAsync();
    }

    private async Task KopierRabatterTilAnnenKunde()
    {
        _rabattFeil = null;
        _rabattMelding = null;

        if (_kopierTilKundeId is null)
        {
            _rabattFeil = "Velg hvilken kunde rabattene skal kopieres til.";
            return;
        }

        var malKundeId = _kopierTilKundeId.Value;
        var eksisterende = await Db.KundeRabatter
            .Where(r => r.KundeId == malKundeId)
            .ToListAsync();

        foreach (var kilde in _kundeRabatter)
        {
            var treff = eksisterende.FirstOrDefault(r => r.ProduktgruppeId == kilde.ProduktgruppeId);
            if (treff is not null)
            {
                treff.RabattProsent = kilde.RabattProsent;
            }
            else
            {
                Db.KundeRabatter.Add(new KundeRabatt
                {
                    KundeId = malKundeId,
                    ProduktgruppeId = kilde.ProduktgruppeId,
                    RabattProsent = kilde.RabattProsent
                });
            }
        }

        await Db.SaveChangesAsync();
        var malNavn = _andreKunder.FirstOrDefault(k => k.Id == malKundeId)?.Navn ?? "kunden";
        _rabattMelding = $"Rabatter kopiert til {malNavn}.";
        _kopierTilKundeId = null;
    }

    private async Task LagreFastPaslag()
    {
        var entitet = await Db.Kunder.FirstOrDefaultAsync(k => k.Id == Id);
        if (entitet is null)
        {
            return;
        }

        entitet.FastPaslagProsent = _kunde!.FastPaslagProsent;
        await Db.SaveChangesAsync();
        _paslagMelding = "Fast påslag lagret.";
        _rabattFeil = null;
        await LastKundeRabatterAsync();
    }

    private async Task OpprettTicket()
    {
        var tittel = _nyTicketTittel.Trim();
        if (tittel.Length == 0)
        {
            return;
        }

        var ticket = new Ticket { Tittel = tittel, KundeId = Id };
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/ticket/{ticket.Id}");
    }

    private async Task SokBronnoysund(ChangeEventArgs e)
    {
        _kunde!.Navn = e.Value?.ToString() ?? "";
        var q = _kunde.Navn.Trim();

        if (q.Length < 2)
        {
            _navnForslag = [];
            _visNavnForslag = false;
            _sokerNavn = false;
            return;
        }

        var generasjon = ++_sokGenerasjon;
        _sokerNavn = true;
        await Task.Delay(300);
        if (generasjon != _sokGenerasjon)
        {
            return;
        }

        var treff = await Bronnoysund.SokAsync(q);
        if (generasjon != _sokGenerasjon)
        {
            return;
        }

        _navnForslag = treff;
        _visNavnForslag = _navnForslag.Count > 0;
        _sokerNavn = false;
    }

    private async Task SkjulNavnForslagForsinket()
    {
        await Task.Delay(150);
        _visNavnForslag = false;
        StateHasChanged();
    }

    private void VelgFraBronnoysund(BronnoysundClient.Sokeresultat resultat)
    {
        _kunde!.Navn = resultat.Navn;
        _kunde.OrgNr = resultat.OrgNr;
        if (!string.IsNullOrWhiteSpace(resultat.Adresse)) { _kunde.Adresse = resultat.Adresse; }
        if (!string.IsNullOrWhiteSpace(resultat.Postnr)) { _kunde.Postnr = resultat.Postnr; }
        if (!string.IsNullOrWhiteSpace(resultat.Sted)) { _kunde.Sted = resultat.Sted; }

        _navnForslag = [];
        _visNavnForslag = false;
    }

    private async Task SlaOppOrgNr()
    {
        _orgNrFeil = null;

        if (string.IsNullOrWhiteSpace(_kunde?.OrgNr))
        {
            _orgNrFeil = "Skriv inn et organisasjonsnummer først.";
            return;
        }

        _slarOppOrgNr = true;
        var resultat = await Bronnoysund.SlaOppAsync(_kunde.OrgNr);
        _slarOppOrgNr = false;

        if (resultat is null)
        {
            _orgNrFeil = "Fant ingen enhet med dette organisasjonsnummeret i Brønnøysundregisteret.";
            return;
        }

        _kunde.Navn = resultat.Navn;
        if (!string.IsNullOrWhiteSpace(resultat.Adresse)) { _kunde.Adresse = resultat.Adresse; }
        if (!string.IsNullOrWhiteSpace(resultat.Postnr)) { _kunde.Postnr = resultat.Postnr; }
        if (!string.IsNullOrWhiteSpace(resultat.Sted)) { _kunde.Sted = resultat.Sted; }
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_kunde!.Navn))
        {
            _error = "Kunden må ha et navn.";
            return;
        }

        _error = null;
        _kunde.NesteOppfolgingsDato = _nesteOppfolgingsDato?.ToDateTime(TimeOnly.MinValue);
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task LeggTilNotat()
    {
        if (string.IsNullOrWhiteSpace(_nyttNotat))
        {
            return;
        }

        var notat = new KundeOppfolgingNotat
        {
            KundeId = Id,
            Tekst = _nyttNotat.Trim(),
            OpprettetAvBrukerId = _naverendeBrukerId,
            OpprettetAvBruker = _naverendeBruker
        };
        Db.KundeOppfolgingNotater.Add(notat);
        await Db.SaveChangesAsync();

        _notater.Insert(0, notat);
        _nyttNotat = "";
    }

    private async Task SlettKunde()
    {
        Db.Kunder.Remove(_kunde!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/kunder");
    }
