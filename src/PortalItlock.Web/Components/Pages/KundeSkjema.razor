@page "/kunder/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VisningPreferanseService VisningPref
@inject BronnoysundClient Bronnoysund

<PageTitle>@(_kunde?.Navn ?? "Kunde")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke kunden. Den kan være slettet.</p>
}
else if (_kunde is not null)
{
    @* Kundekort K5 · faner på siden (oktober 2026). Ett hvitt kort: navn, merker og
       knapper øverst, infolinje, loddrette faner til venstre og innholdet til høyre. *@
    <a class="back-link" href="/kunder"><Icon Name="arrow-left" />Tilbake til kunder</a>

    <div class="kk @(_full ? "kk-full" : "")">
        <div class="kk-topp">
            <div class="k-logo-wrap">
                @if (_kunde.BildeData is not null)
                {
                    <img class="k-logo" src="@($"/kundebilde/{_kunde.Id}?v={_bildeVersjon}")" alt="@_kunde.Navn" />
                }
                else
                {
                    <span class="k-logo">@Initialer(_kunde.Navn)</span>
                }
                <label class="bilde-upload-knapp" title="Last opp logo/bilde">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M6 10l6-6 6 6"></path><path d="M4 20h16"></path></svg>
                    <InputFile OnChange="LastOppBilde" accept="image/*" style="display:none;" />
                </label>
            </div>
            <div class="k-navn">
                <div class="k-rad">
                    <h1>@_kunde.Navn</h1>
                    @if (_kunde.Type.HasValue)
                    {
                        <span class="k-pill s-bla">@_kunde.Type.Value.Visningsnavn()</span>
                    }
                    <span class="k-pill @(_kunde.Status == KundeStatus.Aktiv ? "s-ok" : "s-gra")">@_kunde.Status.Visningsnavn() kunde</span>
                </div>
                <div class="k-under">
                    <span>Kunde siden @_kunde.OpprettetDato.ToLocalTime().Year</span>
                    @if (!string.IsNullOrWhiteSpace(_kunde.TripletexKundenummer))
                    {
                        <span>· Tripletex @_kunde.TripletexKundenummer</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_kunde.OrgNr))
                    {
                        <span>· org.nr @FormaterOrgNr(_kunde.OrgNr)</span>
                    }
                </div>
            </div>
            <div class="k-handl">
                @if (!string.IsNullOrWhiteSpace(_kunde.Telefon))
                {
                    <a class="k-knapp" href="@($"tel:{_kunde.Telefon}")"><Icon Name="phone" />Ring</a>
                }
                @if (!string.IsNullOrWhiteSpace(_kunde.Epost))
                {
                    <a class="k-knapp" href="@($"mailto:{_kunde.Epost}")"><Icon Name="mail" />E-post</a>
                }
                <div class="k-meny-wrap">
                    <button type="button" class="k-knapp k-knapp-p" @onclick="@(() => _visNyttMeny = !_visNyttMeny)"><Icon Name="plus" />Nytt ▾</button>
                    @if (_visNyttMeny)
                    {
                        <div class="k-nedtrekk">
                            <button type="button" @onclick="NyOppfolgingFraMeny"><Icon Name="bell" />Ny oppfølging</button>
                            <a href="@($"/prosjekter/ny?KundeId={Id}")"><Icon Name="folder" />Nytt prosjekt</a>
                            <button type="button" @onclick="@(() => { _visNyttMeny = false; _fane = KundeFane.Tilbud; _visNyttTilbud = true; })"><Icon Name="file-text" />Nytt tilbud</button>
                            <button type="button" @onclick="NyArbeidsordre"><Icon Name="receipt" />Ny arbeidsordre</button>
                            <button type="button" @onclick="@(() => { _visNyttMeny = false; _fane = KundeFane.Tickets; _visNyTicket = true; })"><Icon Name="tag" />Ny ticket</button>
                        </div>
                    }
                </div>
                <button type="button" class="kk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_bildeFeil))
        {
            <p class="form-error k-pad">@_bildeFeil</p>
        }

        <div class="k-infolinje">
            @if (!string.IsNullOrWhiteSpace(_kunde.Kontaktperson))
            {
                <span><Icon Name="users" /><b>@_kunde.Kontaktperson</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_kunde.Telefon))
            {
                <span><Icon Name="phone" /><b>@_kunde.Telefon</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(_kunde.Epost))
            {
                <span><Icon Name="mail" /><b>@_kunde.Epost</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(KundeAdresse))
            {
                <span><Icon Name="map-pin" /><b>@KundeAdresse</b></span>
            }
            <span><Icon Name="calendar" />Neste oppfølging <b class="@(NesteFrist is not null ? "k-gul-tekst" : "")">@(NesteFrist?.ToString("d. MMM", Kultur) ?? "ikke satt")</b></span>
        </div>

        <div class="k-vk">
            <nav class="k-vmeny">
                @FaneKnapp(KundeFane.Oversikt, "grid", "Oversikt", null, "")
                @FaneKnapp(KundeFane.Oppfolging, "bell", "Oppfølging", ApneOppfolginger.Count, "g")
                @FaneKnapp(KundeFane.Prosjekter, "folder", "Prosjekter", _prosjekter.Count, "")
                @FaneKnapp(KundeFane.Tilbud, "file-text", "Tilbud", VenterSvar.Count, "")
                @FaneKnapp(KundeFane.Ordrer, "receipt", "Ordrer", _arbeidsordrer.Count, "")
                @FaneKnapp(KundeFane.Tickets, "tag", "Tickets", ApneTickets.Count, "r")
                <div class="k-skill"></div>
                @FaneKnapp(KundeFane.Avtaler, "clock", "Avtaler og lisenser", _serviceavtaler.Count + _kundeLisenser.Count, LisensNaermerSeg ? "g" : "")
                @FaneKnapp(KundeFane.Priser, "tag", "Priser og rabatter", null, "")
                <div class="k-skill"></div>
                @FaneKnapp(KundeFane.Kontaktpersoner, "users", "Kontaktpersoner", AntallKontakter, "")
                @FaneKnapp(KundeFane.Detaljer, "file-text", "Detaljer", null, "")
            </nav>

            <div class="k-hoved">
                @switch (_fane)
                {
                    case KundeFane.Oversikt:
                        @Oversikt()
                        break;
                    case KundeFane.Oppfolging:
                        @Oppfolging()
                        break;
                    case KundeFane.Prosjekter:
                        @Prosjekter()
                        break;
                    case KundeFane.Tilbud:
                        @TilbudFane()
                        break;
                    case KundeFane.Ordrer:
                        @Ordrer()
                        break;
                    case KundeFane.Tickets:
                        @Tickets()
                        break;
                    case KundeFane.Avtaler:
                        @Avtaler()
                        break;
                    case KundeFane.Priser:
                        @Priser()
                        break;
                    case KundeFane.Kontaktpersoner:
                        @Kontakter()
                        break;
                    default:
                        @Detaljer()
                        break;
                }
            </div>
        </div>
    </div>
}

@code {
    // ---------------- Faner ----------------

    private RenderFragment FaneKnapp(KundeFane f, string ikon, string tekst, int? teller, string farge) =>
        @<button type="button" class="k-vfane @(_fane == f ? "pa" : "")" @onclick="@(() => VelgFane(f))">
            <Icon Name="@ikon" /><span class="k-vfane-tekst">@tekst</span>
            @if (teller is > 0)
            {
                <em class="@farge">@teller</em>
            }
        </button>;

    private RenderFragment Oversikt() =>
        @<div class="k-fp">
            <div class="k-tall4">
                <button type="button" @onclick="@(() => VelgFane(KundeFane.Prosjekter))"><span class="k-lbl">Prosjekter</span><b>@_prosjekter.Count</b><small>@_prosjekter.Count(p => ProsjektGruppe(p.Status) == "pagar") pågår · @_prosjekter.Count(p => p.Status == ProsjektStatus.Tilbud) tilbud</small></button>
                <button type="button" @onclick="@(() => VelgFane(KundeFane.Tilbud))"><span class="k-lbl">Åpne tilbud</span><b>@Kr(VenterSvar.Sum(t => t.SendtSum ?? 0))</b><small>@VenterSvar.Count@(EldsteVenter is int d ? $" · eldste {d} dager" : "")</small></button>
                <button type="button" @onclick="@(() => VelgFane(KundeFane.Ordrer))"><span class="k-lbl">Fakturert i år</span><b>@Kr(_fakturertIAr)</b><small>@FakturertEndring</small></button>
                <button type="button" @onclick="@(() => VelgFane(KundeFane.Tickets))"><span class="k-lbl">Åpne saker</span><b class="@(ApneTickets.Count > 0 ? "k-rod-tekst" : "")">@ApneTickets.Count</b><small>@(ApneTickets.Count == 0 ? "ingen åpne" : $"ticket{(ApneTickets.Count == 1 ? "" : "s")} · {ApneTickets[0].Lokasjon ?? ApneTickets[0].Tittel}")</small></button>
            </div>
            <div class="k-to">
                <div class="k-seksjon">
                    <h4>Aktivitet</h4>
                    @if (Aktivitet.Count == 0)
                    {
                        <span class="k-smule">Ingen aktivitet registrert ennå.</span>
                    }
                    @foreach (var a in Aktivitet)
                    {
                        <div class="k-tli @(a.Lenke is not null ? "lenket" : "")" @onclick="@(() => { if (a.Lenke is not null) { Nav.NavigateTo(a.Lenke); } })">
                            <span class="k-ik" style="background:@a.Bakgrunn"><Icon Name="@a.Ikon" /></span>
                            <div><b>@a.Tittel</b>@if (!string.IsNullOrWhiteSpace(a.Tekst)) {<p>@a.Tekst</p>}<small>@a.Hvem@(string.IsNullOrEmpty(a.Hvem) ? "" : " · ")@KortDato(a.Dato)</small></div>
                            <span></span>
                        </div>
                    }
                </div>
                <div class="k-kol">
                    <div class="k-oppf" @onclick="@(() => VelgFane(KundeFane.Oppfolging))">
                        @if (NesteOppfolging is { } n)
                        {
                            <div class="k-d"><span class="k-kal"><small>@n.Frist.ToString("MMM", Kultur).TrimEnd('.')</small><b>@n.Frist.Day</b></span><div><b class="k-oppf-tittel">Neste oppfølging</b><div class="k-smule">@n.Frist.ToString("dddd", Kultur) · @RelativDato(n.Frist)</div></div></div>
                            <span class="k-smule k-ti"><Icon Name="@n.Type.Ikon()" />@n.Tittel</span>
                        }
                        else if (_kunde!.NesteOppfolgingsDato is { } gammel)
                        {
                            <div class="k-d"><span class="k-kal"><small>@gammel.ToString("MMM", Kultur).TrimEnd('.')</small><b>@gammel.Day</b></span><div><b class="k-oppf-tittel">Neste oppfølging</b><div class="k-smule">@gammel.ToString("dddd", Kultur) · @RelativDato(gammel)</div></div></div>
                        }
                        else
                        {
                            <div class="k-d"><span class="k-kal tom"><small>–</small><b>?</b></span><div><b class="k-oppf-tittel">Neste oppfølging</b><div class="k-smule">Ikke satt</div></div></div>
                            <span class="k-lenke">+ Ny oppfølging med varsel</span>
                        }
                    </div>
                    <div class="k-seksjon">
                        <h4>Prosjekter</h4>
                        @if (_prosjekter.Count == 0)
                        {
                            <span class="k-smule">Ingen prosjekter ennå.</span>
                        }
                        else
                        {
                            <div class="k-liste">
                                @foreach (var p in _prosjekter.Take(5))
                                {
                                    <a class="k-lr" href="@($"/prosjekter/{p.Id}")">
                                        <span class="k-ik" style="background:@ProsjektBakgrunn(p.Status)"><Icon Name="@ProsjektIkon(p.Status)" /></span>
                                        <div><b>@p.Navn</b><small>@ProsjektUndertekst(p)</small></div>
                                        <span class="k-pill @ProsjektPillKlasse(p.Status)">@ProsjektStatusTekst(p)</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>;

    private RenderFragment Oppfolging() =>
        @<div class="k-fp">
            <div class="k-of">
                <div class="k-ofskjema">
                    <h3>@(_ofRedigerId is null ? "Ny oppfølging" : "Endre oppfølging")</h3>
                    <label class="k-felt2">Hva skal gjøres<input class="k-inp" @bind="_ofTittel" @bind:event="oninput" placeholder="F.eks. Ring om tilbudet på Kvås kyrkje" /></label>
                    <div class="k-felt2">Type
                        <div class="k-valg">
                            @foreach (var t in Enum.GetValues<KundeOppfolgingType>())
                            {
                                var type = t;
                                <button type="button" class="@(_ofType == type ? "pa" : "")" @onclick="@(() => _ofType = type)"><Icon Name="@type.Ikon()" />@type.Visningsnavn()</button>
                            }
                        </div>
                    </div>
                    <div class="k-g2">
                        <label class="k-felt2">Dato<input class="k-inp" type="date" @bind="_ofDato" /></label>
                        <label class="k-felt2">Klokkeslett<input class="k-inp" type="time" @bind="_ofTid" /></label>
                    </div>
                    <div class="k-valg">
                        @foreach (var (tekst, dager) in Snarvalg)
                        {
                            var antall = dager;
                            <button type="button" class="@(_ofDato == DateOnly.FromDateTime(DateTime.Today.AddDays(antall)) ? "pa" : "")" @onclick="@(() => _ofDato = DateOnly.FromDateTime(DateTime.Today.AddDays(antall)))">@tekst</button>
                        }
                    </div>
                    <div class="k-g2">
                        <label class="k-felt2">Ansvarlig
                            <select class="k-inp" @bind="_ofAnsvarligId">
                                <option value="">Ingen</option>
                                @foreach (var b in _ansatte)
                                {
                                    <option value="@b.Id">@b.Navn</option>
                                }
                            </select>
                        </label>
                        <label class="k-felt2">Kontaktperson
                            <select class="k-inp" @bind="_ofKontakt">
                                <option value="">Ingen</option>
                                @foreach (var k in Kontaktnavn)
                                {
                                    <option value="@k">@k</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="k-varselboks">
                        <span class="k-felt2 k-gul-tekst k-ti"><Icon Name="bell" />Varsel</span>
                        <button type="button" class="k-bryt @(_ofPortal ? "pa" : "")" @onclick="@(() => _ofPortal = !_ofPortal)"><i></i><span>Varsel i portalen <small>(bjella øverst + Hjem)</small></span></button>
                        <button type="button" class="k-bryt @(_ofEpost ? "pa" : "")" @onclick="@(() => _ofEpost = !_ofEpost)"><i></i><span>E-post til ansvarlig <small>@(AnsvarligEpost ?? "velg ansvarlig")</small></span></button>
                        <button type="button" class="k-bryt" disabled title="SMS-varsling er ikke koblet til ennå"><i></i><span>SMS <small>til mobil · kommer</small></span></button>
                        <div class="k-felt2">Når
                            <div class="k-valg">
                                @foreach (var (tekst, dager) in VarselNar)
                                {
                                    var d = dager;
                                    <button type="button" class="@(_ofDagerFor == d ? "pa" : "")" @onclick="@(() => _ofDagerFor = d)">@tekst</button>
                                }
                            </div>
                        </div>
                        <div class="k-felt2">Gjenta
                            <div class="k-valg">
                                @foreach (var g in Enum.GetValues<KundeOppfolgingGjenta>())
                                {
                                    var gj = g;
                                    <button type="button" class="@(_ofGjenta == gj ? "pa" : "")" @onclick="@(() => _ofGjenta = gj)">@gj.Visningsnavn()</button>
                                }
                            </div>
                        </div>
                    </div>
                    <label class="k-felt2">Notat (valgfritt)<input class="k-inp" @bind="_ofNotat" placeholder="F.eks. de skulle ta det opp i rådsmøtet …" /></label>
                    @if (!string.IsNullOrEmpty(_ofFeil))
                    {
                        <span class="form-error">@_ofFeil</span>
                    }
                    <div class="k-rad k-hoyre">
                        <button type="button" class="k-knapp k-knapp-s" @onclick="NullstillOppfolgingSkjema">Avbryt</button>
                        <button type="button" class="k-knapp k-knapp-p" @onclick="LagreOppfolging"><Icon Name="bell" />Lagre oppfølging</button>
                    </div>
                </div>

                <div class="k-kol">
                    <div class="k-seksjon">
                        <h4>Planlagt <HvisModul Modul="@PortalItlock.Web.Models.TilleggsModuler.Timer"><a href="/kalender">Se i kalender</a></HvisModul></h4>
                        @if (!string.IsNullOrEmpty(_ofMelding))
                        {
                            <span class="save-success">@_ofMelding</span>
                        }
                        @if (ApneOppfolginger.Count == 0 && _kunde!.NesteOppfolgingsDato is null)
                        {
                            <span class="k-smule">Ingen planlagte oppfølginger.</span>
                        }
                        else
                        {
                            <div class="k-liste">
                                @if (ApneOppfolginger.Count == 0 && _kunde!.NesteOppfolgingsDato is { } gammel)
                                {
                                    <div class="k-ofl">
                                        <span class="k-kal"><small>@gammel.ToString("MMM", Kultur).TrimEnd('.')</small><b>@gammel.Day</b></span>
                                        <div><b>Følg opp kunden</b><small>@gammel.ToString("dd.MM.yyyy") <span class="k-vs"><Icon Name="bell" /></span></small></div>
                                        <span class="k-rad"><button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="FjernGammelOppfolging"><Icon Name="check" />Utført</button></span>
                                    </div>
                                }
                                @foreach (var o in ApneOppfolginger)
                                {
                                    var of = o;
                                    <div class="k-ofl @(of.Frist.Date < DateTime.Today ? "forfalt" : "")" @key="of.Id">
                                        <span class="k-kal"><small>@of.Frist.ToString("MMM", Kultur).TrimEnd('.')</small><b>@of.Frist.Day</b></span>
                                        <div>
                                            <b class="k-ti"><Icon Name="@of.Type.Ikon()" />@of.Tittel</b>
                                            <small>@FristTekst(of)@(of.AnsvarligBruker is null ? "" : $" · {of.AnsvarligBruker.Navn}")@(of.VarselDagerFor > 0 ? $" · varsel {VarselNarTekst(of.VarselDagerFor)}" : "")@(of.Gjenta != KundeOppfolgingGjenta.Ikke ? $" · gjentas {of.Gjenta.Visningsnavn().ToLower()}" : "") <span class="k-vs">@if (of.VarselPortal) {<Icon Name="bell" />}@if (of.VarselEpost) {<Icon Name="mail" />}</span></small>
                                        </div>
                                        <span class="k-rad">
                                            <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => RedigerOppfolging(of))">Endre</button>
                                            <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => UtsettOppfolging(of))">Utsett</button>
                                            <button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="@(() => FullforOppfolging(of))"><Icon Name="check" />Utført</button>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="k-seksjon">
                        <h4>Slik ser varselet ut</h4>
                        <div class="k-varselprev">
                            <div class="k-vh"><Icon Name="bell" />Varsler · @ForhandsvisVarselDato</div>
                            <div class="k-vb">
                                <span class="k-ik k-rund" style="background:var(--k-gul-l)"><Icon Name="@_ofType.Ikon()" /></span>
                                <div>
                                    <b>Følg opp @_kunde!.Navn</b>
                                    <span class="k-smule">@(string.IsNullOrWhiteSpace(_ofTittel) ? "Hva skal gjøres" : _ofTittel)@(string.IsNullOrWhiteSpace(_ofKontakt) ? "" : $" · {_ofKontakt}") · @ForhandsvisFrist</span>
                                    <div class="k-rad k-mt"><span class="k-knapp k-knapp-s k-knapp-p">Åpne kunde</span><span class="k-knapp k-knapp-s">Utsett 1 dag</span><span class="k-knapp k-knapp-s"><Icon Name="check" />Utført</span></div>
                                </div>
                            </div>
                        </div>
                        <span class="k-smule k-mt">Alle dine oppfølginger samles også på Hjem («Kunder å følge opp») og i varslene (bjella)@(_ofEpost ? ", og du får e-post kl. 08:00 på varseldagen" : "").</span>
                    </div>

                    <div class="k-seksjon">
                        <h4>Utført <button type="button" class="k-lenke" @onclick="@(() => _visLogg = !_visLogg)">+ Logg kontakt</button></h4>
                        @if (_visLogg)
                        {
                            <div class="k-logg">
                                <textarea rows="3" class="k-inp k-tekstfelt" @bind="_nyttNotat" @bind:event="oninput" placeholder="F.eks. Ringte kunden, avtalte befaring i uke 40..."></textarea>
                                <div class="k-rad k-hoyre"><button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="LeggTilNotat" disabled="@string.IsNullOrWhiteSpace(_nyttNotat)">Logg kontakt</button></div>
                            </div>
                        }
                        @if (UtfortLogg.Count == 0)
                        {
                            <span class="k-smule">Ingen utførte oppfølginger eller loggførte kontakter ennå.</span>
                        }
                        else
                        {
                            <div class="k-liste">
                                @foreach (var u in UtfortLogg)
                                {
                                    <div class="k-ofl ferdig">
                                        <span class="k-kal"><small>@u.Dato.ToString("MMM", Kultur).TrimEnd('.')</small><b>@u.Dato.Day</b></span>
                                        <div><b class="k-ti"><Icon Name="@u.Ikon" />@u.Tittel</b><small>@u.Hvem@(string.IsNullOrWhiteSpace(u.Tekst) ? "" : $" · «{u.Tekst}»")</small></div>
                                        <span class="k-pill s-ok">@(u.ErNotat ? "Logget" : "Utført")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>;

    private RenderFragment Prosjekter() =>
        @<div class="k-fp">
            <div class="k-fp-topp">
                @Chip("Alle", _prosjekter.Count, _prosjektFilter == "alle", () => _prosjektFilter = "alle")
                @Chip("Pågår", _prosjekter.Count(p => ProsjektGruppe(p.Status) == "pagar"), _prosjektFilter == "pagar", () => _prosjektFilter = "pagar")
                @Chip("Tilbud", _prosjekter.Count(p => ProsjektGruppe(p.Status) == "tilbud"), _prosjektFilter == "tilbud", () => _prosjektFilter = "tilbud")
                @Chip("Ferdig", _prosjekter.Count(p => ProsjektGruppe(p.Status) == "ferdig"), _prosjektFilter == "ferdig", () => _prosjektFilter = "ferdig")
                <a class="k-knapp k-knapp-s k-knapp-p k-auto" href="@($"/prosjekter/ny?KundeId={Id}")"><Icon Name="plus" />Nytt prosjekt</a>
            </div>
            @if (!FiltrerteProsjekter.Any())
            {
                <span class="k-smule">Ingen prosjekter i denne kategorien.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Prosjekt</th><th>Bygg</th><th>Fremdrift</th><th>Ansvarlig</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var p in FiltrerteProsjekter)
                        {
                            var pid = p.Id;
                            <tr @key="p.Id" @onclick="@(() => Nav.NavigateTo($"/prosjekter/{pid}"))">
                                <td><b>@p.Navn</b><small>@ProsjektUndertekst(p)</small></td>
                                <td>@(p.Adresse ?? "–")</td>
                                <td>
                                    @if (p.Dorer > 0)
                                    {
                                        var pst = p.Ferdige * 100 / p.Dorer;
                                        <span class="k-bar"><i style="width:@(pst)%;background:@(pst == 100 ? "var(--k-ok)" : "var(--k-bla)")"></i></span>
                                        <small>@pst % · @p.Ferdige av @p.Dorer dører</small>
                                    }
                                    else
                                    {
                                        <span class="k-smule">–</span>
                                    }
                                </td>
                                <td>@(p.Ansvarlig ?? "–")</td>
                                <td><span class="k-pill @ProsjektPillKlasse(p.Status)">@ProsjektKortStatus(p.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>;

    private RenderFragment TilbudFane() =>
        @<div class="k-fp">
            <div class="k-opps">
                <div><b>@Kr(VenterSvar.Sum(t => t.SendtSum ?? 0))</b><span>åpne tilbud (@VenterSvar.Count)</span></div>
                <div><b>@(Hitrate is int h ? $"{h} %" : "–")</b><span>hitrate · @TilbudIAr.Count(t => t.Status == EndringsmeldingStatus.Godkjent) av @TilbudIAr.Count(t => t.Status is EndringsmeldingStatus.Godkjent or EndringsmeldingStatus.Avslatt)@ArTekst</span></div>
                <div><b>@(SnittSvartid is int s ? $"{s} d" : "–")</b><span>snitt tid til svar</span></div>
                <div><b>@Kr(TilbudIAr.Where(t => t.Status == EndringsmeldingStatus.Godkjent).Sum(t => t.SendtSum ?? 0))</b><span>vunnet @(_tilbudAr == 0 ? "totalt" : $"i {_tilbudAr}")</span></div>
            </div>
            <div class="k-fp-topp">
                <select class="k-arsvelger" value="@_tilbudAr" @onchange="VelgTilbudAr" title="Velg år">
                    @foreach (var ar in TilbudAr)
                    {
                        <option value="@ar">@ar</option>
                    }
                    <option value="0">Alle år</option>
                </select>
                @Chip("Alle", TilbudIAr.Count, _tilbudFilter == "Alle", () => VelgTilbudFilter("Alle"))
                @Chip("Utkast", TilbudIAr.Count(t => t.Status == EndringsmeldingStatus.Utkast), _tilbudFilter == "Utkast", () => VelgTilbudFilter("Utkast"))
                @Chip("Venter svar", TilbudIAr.Count(t => t.Status == EndringsmeldingStatus.SendtTilKunde), _tilbudFilter == "SendtTilKunde", () => VelgTilbudFilter("SendtTilKunde"))
                @Chip("Vunnet", TilbudIAr.Count(t => t.Status == EndringsmeldingStatus.Godkjent), _tilbudFilter == "Godkjent", () => VelgTilbudFilter("Godkjent"))
                @Chip("Tapt", TilbudIAr.Count(t => t.Status == EndringsmeldingStatus.Avslatt), _tilbudFilter == "Avslatt", () => VelgTilbudFilter("Avslatt"))
                <div class="k-meny-wrap k-auto">
                    <button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="@(() => _visNyttTilbud = !_visNyttTilbud)"><Icon Name="plus" />Nytt tilbud</button>
                    @if (_visNyttTilbud)
                    {
                        <div class="k-nedtrekk">
                            <span class="k-nedtrekk-tittel">Tilbudet lages på et prosjekt</span>
                            @foreach (var p in _prosjekter.Take(8))
                            {
                                <a href="@($"/prosjekter/{p.Id}")"><Icon Name="folder" />@p.Navn</a>
                            }
                            <a href="@($"/prosjekter/ny?KundeId={Id}")"><Icon Name="plus" />Nytt prosjekt</a>
                        </div>
                    }
                </div>
            </div>

            @{
                var liste = FiltrerteTilbud.ToList();
                var antallSider = Math.Max(1, (int)Math.Ceiling(liste.Count / (double)TilbudPerSide));
                var side = Math.Clamp(_tilbudSide, 1, antallSider);
            }
            @if (liste.Count == 0)
            {
                <span class="k-smule">Ingen tilbud @(_tilbudAr > 0 ? $"i {_tilbudAr}" : "") i denne kategorien.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Tilbud</th><th>Sendt</th><th>Gyldig til</th><th class="h">Beløp</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var t in liste.Skip((side - 1) * TilbudPerSide).Take(TilbudPerSide))
                        {
                            var tid = t.Id;
                            var tilbud = t;
                            <tr @key="t.Id" @onclick="@(() => Nav.NavigateTo($"/tilbud/{tid}"))">
                                <td><b>@t.Tittel</b><small>@(t.Prosjekt?.Navn ?? "") · T-@t.OpprettetDato.ToLocalTime().Year-@t.Id.ToString("000")</small></td>
                                <td>@(t.SendtDato is { } sd ? KortDato(sd) : "–")</td>
                                <td>@(t.GyldigTil is { } g ? KortDato(g) : "–")</td>
                                <td class="h k-mono">@(t.SendtSum is { } sum ? Kr(sum) : "–")</td>
                                <td><span class="k-pill @TilbudPillKlasse(t.Status)">@TilbudStatusTekst(t)</span></td>
                                <td class="h">
                                    @if (t.Status == EndringsmeldingStatus.SendtTilKunde)
                                    {
                                        <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => FolgOppTilbud(tilbud))" @onclick:stopPropagation="true">Følg opp</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (antallSider > 1)
                {
                    <div class="k-sider">
                        <span class="k-smule">Viser @((side - 1) * TilbudPerSide + 1)–@Math.Min(side * TilbudPerSide, liste.Count) av @liste.Count</span>
                        <div class="k-rad">
                            <button type="button" class="k-chip" disabled="@(side == 1)" @onclick="@(() => _tilbudSide = side - 1)">‹ Forrige</button>
                            @for (var i = 1; i <= antallSider; i++)
                            {
                                var nr = i;
                                <button type="button" class="k-chip @(nr == side ? "pa" : "")" @onclick="@(() => _tilbudSide = nr)">@nr</button>
                            }
                            <button type="button" class="k-chip" disabled="@(side == antallSider)" @onclick="@(() => _tilbudSide = side + 1)">Neste ›</button>
                        </div>
                    </div>
                }
            }
        </div>;

    private RenderFragment Ordrer() =>
        @<div class="k-fp">
            <div class="k-fp-topp">
                @Chip("Alle", _arbeidsordrer.Count, _ordreFilter == "Alle", () => _ordreFilter = "Alle")
                @Chip("Planlagt", _arbeidsordrer.Count(a => a.Status is ArbeidsordreStatus.Ny or ArbeidsordreStatus.Klar), _ordreFilter == "Planlagt", () => _ordreFilter = "Planlagt")
                @Chip("Pågår", _arbeidsordrer.Count(a => a.Status == ArbeidsordreStatus.Pagaende), _ordreFilter == "IArbeid", () => _ordreFilter = "IArbeid")
                @Chip("Klar til faktura", _arbeidsordrer.Count(a => a.Status == ArbeidsordreStatus.Ferdig), _ordreFilter == "Ferdig", () => _ordreFilter = "Ferdig")
                @Chip("Fakturert", _arbeidsordrer.Count(a => a.Status == ArbeidsordreStatus.Fakturert), _ordreFilter == "Fakturert", () => _ordreFilter = "Fakturert")
                <button type="button" class="k-knapp k-knapp-s k-knapp-p k-auto" @onclick="NyArbeidsordre"><Icon Name="plus" />Ny arbeidsordre</button>
            </div>
            @if (!FiltrerteOrdrer.Any())
            {
                <span class="k-smule">Ingen arbeidsordre i denne kategorien.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Arbeidsordre</th><th>Prosjekt</th><th>Montør</th><th>Dato</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var a in FiltrerteOrdrer)
                        {
                            var aid = a.Id;
                            <tr @key="a.Id" @onclick="@(() => Nav.NavigateTo($"/arbeidsordre/{aid}"))">
                                <td><b>AO-@a.Id.ToString("0000") @a.Tittel</b>@if (a.Type is { } ty) {<small>@ty.Visningsnavn()</small>}</td>
                                <td>@(a.Prosjekt?.Navn ?? "–")</td>
                                <td>@(a.AnsvarligMontor?.Navn ?? "–")</td>
