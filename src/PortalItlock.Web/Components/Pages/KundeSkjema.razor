            @KontaktListe(true)
        </div>;

    private RenderFragment KontaktListe(bool redigerbar) =>
        @<div class="k-liste">
            @if (!string.IsNullOrWhiteSpace(_kunde!.Kontaktperson))
            {
                <div class="k-lr">
                    <span class="k-av" style="background:@AvatarFarge(_kunde.Kontaktperson)">@Initialer(_kunde.Kontaktperson)</span>
                    <div><b>@_kunde.Kontaktperson <span class="k-pill s-gra k-pill-liten">Hovedkontakt</span></b><small>@string.Join(" · ", new[] { _kunde.Telefon, _kunde.Epost }.Where(s => !string.IsNullOrWhiteSpace(s)))</small></div>
                    <span class="k-ikb">
                        @if (!string.IsNullOrWhiteSpace(_kunde.Telefon)) { <a href="@($"tel:{_kunde.Telefon}")" title="Ring"><Icon Name="phone" /></a> }
                        @if (!string.IsNullOrWhiteSpace(_kunde.Epost)) { <a href="@($"mailto:{_kunde.Epost}")" title="E-post"><Icon Name="mail" /></a> }
                        @if (redigerbar) { <button type="button" title="Endre i Detaljer" @onclick="@(() => { _redigerFirma = true; VelgFane(KundeFane.Detaljer); })"><Icon Name="edit" /></button> }
                    </span>
                </div>
            }
            @foreach (var k in _kontaktpersoner)
            {
                var kp = k;
                @if (redigerbar && _redigerKontaktId == kp.Id)
                {
                    <div class="k-lr k-lr-redig" @key="kp.Id">
                        <span class="k-av" style="background:@AvatarFarge(kp.Navn)">@Initialer(kp.Navn)</span>
                        <div class="k-redig-felt">
                            <input class="k-inp" @bind="kp.Navn" @bind:after="@(() => LagreKontaktperson(kp))" placeholder="Navn" />
                            <input class="k-inp" @bind="kp.Rolle" @bind:after="@(() => LagreKontaktperson(kp))" placeholder="Rolle (valgfritt)" />
                            <input class="k-inp" @bind="kp.Telefon" @bind:after="@(() => LagreKontaktperson(kp))" placeholder="Telefon" />
                            <input class="k-inp" @bind="kp.Epost" @bind:after="@(() => LagreKontaktperson(kp))" placeholder="E-post" />
                        </div>
                        <span class="k-rad">
                            <button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="@(() => _redigerKontaktId = null)">Ferdig</button>
                            <button type="button" class="k-knapp k-knapp-s k-rod-tekst" @onclick="@(() => SlettKontaktperson(kp))">Fjern</button>
                        </span>
                    </div>
                }
                else
                {
                    <div class="k-lr" @key="kp.Id">
                        <span class="k-av" style="background:@AvatarFarge(kp.Navn)">@Initialer(kp.Navn)</span>
                        <div><b>@kp.Navn @if (!string.IsNullOrWhiteSpace(kp.Rolle)) {<span class="k-pill s-gra k-pill-liten">@kp.Rolle</span>}</b><small>@string.Join(" · ", new[] { kp.Telefon, kp.Epost }.Where(s => !string.IsNullOrWhiteSpace(s)))</small></div>
                        <span class="k-ikb">
                            @if (!string.IsNullOrWhiteSpace(kp.Telefon)) { <a href="@($"tel:{kp.Telefon}")" title="Ring"><Icon Name="phone" /></a> }
                            @if (!string.IsNullOrWhiteSpace(kp.Epost)) { <a href="@($"mailto:{kp.Epost}")" title="E-post"><Icon Name="mail" /></a> }
                            @if (redigerbar) { <button type="button" title="Endre" @onclick="@(() => _redigerKontaktId = kp.Id)"><Icon Name="edit" /></button> }
                        </span>
                    </div>
                }
            }
            @if (AntallKontakter == 0)
            {
                <div class="k-lr"><span></span><span class="k-smule">Ingen kontaktpersoner lagt til ennå.</span><span></span></div>
            }
        </div>;

    private RenderFragment Detaljer() =>
        @<div class="k-fp">
            <div class="k-brreg">
                <span class="k-brreg-ik"><Icon Name="building" /></span>
                <span>
                    <b>Brønnøysundregistrene:</b>
                    @if (_orgNrFeil is not null)
                    {
                        <span class="k-rod-tekst"> @_orgNrFeil</span>
                    }
                    else if (_brregMelding is not null)
                    {
                        <span> @_brregMelding</span>
                    }
                    else if (string.IsNullOrWhiteSpace(_kunde!.OrgNr))
                    {
                        <span> legg inn org.nr for å hente navn og adresse fra registeret.</span>
                    }
                    else
                    {
                        <span> hent navn og adresse for org.nr @FormaterOrgNr(_kunde.OrgNr) fra registeret.</span>
                    }
                </span>
                <button type="button" class="k-knapp k-knapp-s k-auto" @onclick="OppdaterFraBrreg" disabled="@_slarOppOrgNr">@(_slarOppOrgNr ? "Henter..." : "Oppdater")</button>
            </div>

            <div class="k-seksjon">
                <h4>Firma <button type="button" class="k-lenke" @onclick="@(() => _redigerFirma = !_redigerFirma)">@(_redigerFirma ? "Lukk" : "Rediger")</button></h4>
                @if (_redigerFirma)
                {
                    <div class="k-skjemaboks">
                        <div class="field-grid">
                            <label>
                                Org.nr
                                <span class="orgnr-rad">
                                    <input @bind="_kunde!.OrgNr" @bind:event="oninput" placeholder="9 siffer" maxlength="9" />
                                    <button type="button" class="orgnr-sok-button" title="Hent fra Brønnøysundregisteret" @onclick="SlaOppOrgNr" disabled="@_slarOppOrgNr">&rarr;</button>
                                </span>
                            </label>
                            <label class="span-2 kunde-navn-sok-wrap">
                                Navn
                                <input value="@_kunde.Navn" @oninput="SokBronnoysund"
                                       @onfocus="@(() => _visNavnForslag = _navnForslag.Count > 0)"
                                       @onblur="SkjulNavnForslagForsinket" autocomplete="off" placeholder="Skriv navn for å søke i Brønnøysundregistrene..." />
                                @if (_sokerNavn)
                                {
                                    <span class="kunde-navn-sok-status">Søker...</span>
                                }
                                @if (_visNavnForslag)
                                {
                                    <ul class="kunde-navn-forslag">
                                        @foreach (var f in _navnForslag)
                                        {
                                            <li>
                                                <button type="button" @onclick="@(() => VelgFraBronnoysund(f))">
                                                    <span class="kunde-navn-forslag-navn">@f.Navn <span class="kunde-navn-forslag-orgnr">(@f.OrgNr)</span></span>
                                                    @if (!string.IsNullOrWhiteSpace(f.Adresse) || !string.IsNullOrWhiteSpace(f.Sted))
                                                    {
                                                        <span class="kunde-navn-forslag-adresse">@f.Adresse@(!string.IsNullOrWhiteSpace(f.Adresse) && (!string.IsNullOrWhiteSpace(f.Postnr) || !string.IsNullOrWhiteSpace(f.Sted)) ? ", " : "")@f.Postnr @f.Sted</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </label>
                            <label>Adresse<input @bind="_kunde.Adresse" /></label>
                            <label>Post nr<input @bind="_kunde.Postnr" /></label>
                            <label>Sted<input @bind="_kunde.Sted" /></label>
                            <label>
                                Kundetype
                                <select @bind="_kunde.Type">
                                    <option value="">Ikke satt</option>
                                    @foreach (var t in Enum.GetValues<KundeType>())
                                    {
                                        <option value="@t">@t.Visningsnavn()</option>
                                    }
                                </select>
                            </label>
                            <label>Hovedkontakt<input @bind="_kunde.Kontaktperson" /></label>
                            <label>Telefon<input @bind="_kunde.Telefon" /></label>
                            <label>E-post<input @bind="_kunde.Epost" /></label>
                        </div>
                        <div class="k-rad k-hoyre">
                            @if (!string.IsNullOrEmpty(_error))
                            {
                                <span class="form-error">@_error</span>
                            }
                            <button type="button" class="k-knapp k-knapp-p" @onclick="Lagre">Lagre</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="k-liste k-felt-grid">
                        @Felt("Navn", _kunde!.Navn)
                        @Felt("Org.nr", string.IsNullOrWhiteSpace(_kunde.OrgNr) ? null : FormaterOrgNr(_kunde.OrgNr))
                        @Felt("Adresse", _kunde.Adresse)
                        @Felt("Postnr / sted", $"{_kunde.Postnr} {_kunde.Sted}".Trim())
                        @Felt("Kundetype", _kunde.Type?.Visningsnavn())
                        @Felt("Hovedkontakt", _kunde.Kontaktperson)
                    </div>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <span class="save-success">@_savedMessage</span>
                }
            </div>

            <div class="k-seksjon">
                <h4>Kontaktpersoner <button type="button" class="k-lenke" @onclick="@(() => { _visNyKontakt = true; VelgFane(KundeFane.Kontaktpersoner); })">+ Legg til</button></h4>
                @KontaktListe(false)
            </div>

            <div class="k-seksjon">
                <h4>Faktura og Tripletex <button type="button" class="k-lenke" @onclick="@(() => _redigerFaktura = !_redigerFaktura)">@(_redigerFaktura ? "Lukk" : "Rediger")</button></h4>
                @if (_redigerFaktura)
                {
                    <div class="k-skjemaboks">
                        <p class="k-smule">Tripletex kundenummer må fylles ut for å kunne eksportere tilbud til Tripletex som CSV.</p>
                        <div class="field-grid">
                            <label>Tripletex kundenr.<input @bind="_kunde!.TripletexKundenummer" placeholder="F.eks. 10010" /></label>
                            <label>Faktura-e-post<input @bind="_kunde.Epost" /></label>
                            <label>Fast påslag %<input type="number" step="0.1" min="0" @bind="_kunde.FastPaslagProsent" /></label>
                        </div>
                        <div class="k-rad k-hoyre"><button type="button" class="k-knapp k-knapp-p" @onclick="Lagre">Lagre</button></div>
                    </div>
                }
                else
                {
                    <div class="k-liste k-felt-grid">
                        @Felt("Tripletex kundenr.", _kunde!.TripletexKundenummer)
                        @Felt("Faktura-e-post", _kunde.Epost)
                        @Felt("Telefon", _kunde.Telefon)
                        @Felt("Fast påslag", _kunde.FastPaslagProsent is { } fp ? $"{fp:0.#} %" : "0 %")
                    </div>
                }
            </div>

            <div class="k-seksjon">
                <h4>Interne notater</h4>
                <textarea class="k-inp k-tekstfelt" rows="3" @bind="_kunde!.Notater" @bind:after="AutoLagre" placeholder="F.eks. hvem som godkjenner innkjøp, hvor nøkler hentes ..."></textarea>
            </div>

            <div class="k-bunn">
                <span class="k-smule">Opprettet @_kunde.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</span>
                @if (_confirmingDelete)
                {
                    <span class="delete-confirm">
                        Er du sikker? Prosjekter knyttet til kunden mister koblingen, men slettes ikke.
                        <button type="button" class="delete-confirm-button" @onclick="SlettKunde">Ja, slett</button>
                        <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    </span>
                }
                else
                {
                    <button type="button" class="k-lenke k-rod-tekst" @onclick="@(() => _confirmingDelete = true)">Slett kunde</button>
                }
            </div>
        </div>;

    private RenderFragment Chip(string tekst, int antall, bool aktiv, Action klikk) =>
        @<button type="button" class="k-chip @(aktiv ? "pa" : "")" @onclick="@(() => { klikk(); })">@tekst <em>@antall</em></button>;

    private RenderFragment Felt(string etikett, string? verdi) =>
        @<div class="k-felt"><small>@etikett</small>@if (string.IsNullOrWhiteSpace(verdi)) {<b class="k-ikke-satt">Ikke satt</b>} else {<b>@verdi</b>}</div>;
}
