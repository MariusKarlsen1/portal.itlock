@page "/kunder/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_kunde?.Navn ?? "Kunde")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke kunden. Den kan være slettet.</p>
}
else if (_kunde is not null)
{
    <a class="back-link" href="/kunder">← Tilbake til kunder</a>
    <h1>@_kunde.Navn</h1>
    <p class="section-hint">Tripletex kundenummer må fylles ut for å kunne eksportere tilbud til Tripletex som CSV.</p>

    <section class="kunde-section">
        <div class="field-grid">
            <label class="span-2">
                Navn
                <input @bind="_kunde.Navn" @bind:event="oninput" />
            </label>
            <label>Kontaktperson<input @bind="_kunde.Kontaktperson" /></label>
            <label>Telefon<input @bind="_kunde.Telefon" /></label>
            <label>E-post<input @bind="_kunde.Epost" /></label>
            <label>Adresse<input @bind="_kunde.Adresse" /></label>
            <label>Post nr<input @bind="_kunde.Postnr" /></label>
            <label>Sted<input @bind="_kunde.Sted" /></label>
            <label>
                Tripletex kundenr.
                <input @bind="_kunde.TripletexKundenummer" placeholder="F.eks. 10010" />
            </label>
            <label>
                Neste oppfølging
                <input type="date" @bind="_nesteOppfolgingsDato" />
            </label>
            <label class="span-2">
                Notater
                <textarea rows="3" @bind="_kunde.Notater"></textarea>
            </label>
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="form-error">@_error</span>
            }
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>
    </section>

    <section class="kunde-section">
        <h2>Prosjekter</h2>
        @if (_prosjekter.Count == 0)
        {
            <p class="list-empty">Ingen prosjekter knyttet til denne kunden ennå.</p>
        }
        else
        {
            <ul class="prosjekt-list">
                @foreach (var p in _prosjekter)
                {
                    <li><a href="@($"/prosjekter/{p.Id}")">@p.Navn</a></li>
                }
            </ul>
        }
    </section>

    <section class="kunde-section">
        <h2>Oppfølgingslogg</h2>
        <p class="section-hint">Loggfør kontakt og avtaler med kunden, og sett en dato for når dere bør følge opp igjen.</p>

        <div class="notat-legg-til">
            <textarea rows="2" @bind="_nyttNotat" @bind:event="oninput" placeholder="F.eks. Ringte kunden, avtalte befaring i uke 40..."></textarea>
            <button type="button" class="save-button" @onclick="LeggTilNotat" disabled="@string.IsNullOrWhiteSpace(_nyttNotat)">Logg oppfølging</button>
        </div>

        @if (_notater.Count == 0)
        {
            <p class="list-empty">Ingen loggførte oppfølginger ennå.</p>
        }
        else
        {
            <ul class="notat-list">
                @foreach (var n in _notater)
                {
                    <li @key="n.Id">
                        <p class="notat-meta">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm") @(n.OpprettetAvBruker is not null ? $"- {n.OpprettetAvBruker.Navn}" : "")</p>
                        <p>@n.Tekst</p>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="kunde-section">
        @if (_confirmingDelete)
        {
            <span class="delete-confirm">
                Er du sikker? Prosjekter knyttet til kunden mister koblingen, men slettes ikke.
                <button type="button" class="delete-confirm-button" @onclick="SlettKunde">Ja, slett</button>
                <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
            </span>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett kunde</button>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private Kunde? _kunde;
    private bool _notFound;
    private bool _confirmingDelete;
    private string? _error;
    private string? _savedMessage;
    private List<ProsjektOption> _prosjekter = [];
    private int? _loadedId;
    private DateOnly? _nesteOppfolgingsDato;
    private List<KundeOppfolgingNotat> _notater = [];
    private string _nyttNotat = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null && _naverendeBrukerId is null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _error = null;
        _savedMessage = null;
        _nyttNotat = "";

        _kunde = await Db.Kunder.FirstOrDefaultAsync(k => k.Id == Id);
        _notFound = _kunde is null;

        if (_kunde is null)
        {
            return;
        }

        _nesteOppfolgingsDato = _kunde.NesteOppfolgingsDato.HasValue
            ? DateOnly.FromDateTime(_kunde.NesteOppfolgingsDato.Value)
            : null;

        _prosjekter = await Db.Prosjekter
            .Where(p => p.KundeId == Id)
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();

        _notater = await Db.KundeOppfolgingNotater
            .Where(n => n.KundeId == Id)
            .Include(n => n.OpprettetAvBruker)
            .OrderByDescending(n => n.OpprettetDato)
            .ToListAsync();
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_kunde!.Navn))
        {
            _error = "Kunden må ha et navn.";
            return;
        }

        _error = null;
        _kunde.NesteOppfolgingsDato = _nesteOppfolgingsDato?.ToDateTime(TimeOnly.MinValue);
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task LeggTilNotat()
    {
        if (string.IsNullOrWhiteSpace(_nyttNotat))
        {
            return;
        }

        var notat = new KundeOppfolgingNotat
        {
            KundeId = Id,
            Tekst = _nyttNotat.Trim(),
            OpprettetAvBrukerId = _naverendeBrukerId,
            OpprettetAvBruker = _naverendeBruker
        };
        Db.KundeOppfolgingNotater.Add(notat);
        await Db.SaveChangesAsync();

        _notater.Insert(0, notat);
        _nyttNotat = "";
    }

    private async Task SlettKunde()
    {
        Db.Kunder.Remove(_kunde!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/kunder");
    }
}
