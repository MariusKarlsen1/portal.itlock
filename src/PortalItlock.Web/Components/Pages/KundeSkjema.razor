                    </tbody>
                </table>
            }
        </div>;

    private RenderFragment Tickets() =>
        @<div class="k-fp">
            <div class="k-fp-topp">
                @Chip("Åpne", ApneTickets.Count, _ticketFilter == "apne", () => _ticketFilter = "apne")
                @Chip("Lukket", _tickets.Count(t => t.Status == TicketStatus.Lukket), _ticketFilter == "lukket", () => _ticketFilter = "lukket")
                @Chip("Alle", _tickets.Count, _ticketFilter == "alle", () => _ticketFilter = "alle")
                <button type="button" class="k-knapp k-knapp-s k-knapp-p k-auto" @onclick="@(() => _visNyTicket = !_visNyTicket)"><Icon Name="plus" />Ny ticket</button>
            </div>
            @if (_visNyTicket)
            {
                <div class="k-nyrad">
                    <input class="k-inp" @bind="_nyTicketTittel" @bind:event="oninput" placeholder="Tittel på ny ticket..." />
                    <button type="button" class="k-knapp k-knapp-p" @onclick="OpprettTicket" disabled="@string.IsNullOrWhiteSpace(_nyTicketTittel)">Opprett ticket</button>
                </div>
            }
            @if (!VisteTickets.Any())
            {
                <span class="k-smule">Ingen tickets å vise.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Ticket</th><th>Bygg / dør</th><th>Meldt av</th><th>Opprettet</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var t in VisteTickets)
                        {
                            var tid = t.Id;
                            <tr @key="t.Id" @onclick="@(() => Nav.NavigateTo($"/ticket/{tid}"))">
                                <td><b>#@t.Id @t.Tittel</b>@if (t.Prioritet is TicketPrioritet.Hoy or TicketPrioritet.Kritisk) {<small><span class="k-pill s-rod k-pill-liten">@(t.Prioritet == TicketPrioritet.Kritisk ? "Kritisk" : "Haster")</span></small>}</td>
                                <td>@TicketSted(t)</td>
                                <td>@(t.Kontaktperson ?? "–")</td>
                                <td>@KortDato(t.OpprettetDato.ToLocalTime())</td>
                                <td><span class="k-pill @TicketPillKlasse(t.Status)">@(t.Status == TicketStatus.Ny ? "Åpen" : t.Status.Visningsnavn())</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>;

    private RenderFragment Avtaler() =>
        @<div class="k-fp">
            <div class="k-seksjon">
                <h4>Serviceavtaler <a href="@($"/prosjekter/ny?KundeId={Id}")">+ Ny serviceavtale</a></h4>
                <div class="k-avtkort">
                    @foreach (var s in _serviceavtaler)
                    {
                        <a class="k-avk" href="@($"/serviceavtaler/{s.Id}")">
                            <div class="k-rad2"><b>@s.Navn</b><span class="k-pill s-ok">Aktiv</span></div>
                            <span class="k-smule">@(s.Dorer > 0 ? $"{s.Dorer} dører · " : "")@(s.SisteRunde is { } sr ? $"siste runde {sr:dd.MM.yyyy}" : "ingen runder ennå")</span>
                            <div class="k-rad2"><span>Neste service</span><b class="k-b13">@(s.NesteService?.ToString("MMMM yyyy", Kultur) ?? "ikke satt")</b></div>
                        </a>
                    }
                    <a class="k-avk k-avk-ny" href="@($"/prosjekter/ny?KundeId={Id}")">+ @(_serviceavtaler.Count == 0 ? "Opprett serviceavtale for kunden" : "Ny serviceavtale")</a>
                </div>
            </div>

            <div class="k-seksjon">
                <h4>Lisenser <button type="button" class="k-lenke" @onclick="@(() => _visNyLisens = !_visNyLisens)">+ Legg til lisens</button></h4>
                @if (_visNyLisens)
                {
                    <div class="k-nyrad">
                        <input class="k-inp" @bind="_nyLisensNavn" placeholder="Lisensnavn, f.eks. iLOQ Manager" />
                        <input class="k-inp" type="date" @bind="_nyLisensUtlopsDato" />
                        <button type="button" class="k-knapp k-knapp-p" @onclick="LeggTilLisens">Legg til</button>
                    </div>
                }
                @if (_kundeLisenser.Count == 0)
                {
                    <span class="k-smule">Ingen lisenser registrert for denne kunden ennå.</span>
                }
                else
                {
                    <table class="k-tab">
                        <thead><tr><th>Lisens</th><th>Utløper</th><th>Status</th><th>Notat</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var l in _kundeLisenser)
                            {
                                var lisens = l;
                                var dager = (l.UtlopsDato.Date - DateTime.Today).Days;
                                <tr @key="l.Id" class="k-redig">
                                    <td><input class="k-inp-flat k-fet" @bind="lisens.Navn" /></td>
                                    <td><input class="k-inp-flat" type="date" @bind="lisens.UtlopsDato" /></td>
                                    <td>
                                        @if (0 > dager)
                                        {
                                            <span class="k-pill s-rod">Utgått</span>
                                        }
                                        else if (l.UtlopsDato.Date <= DateTime.Today.Add(LisensVarselService.VarselFrist))
                                        {
                                            <span class="k-pill s-gul">Nærmer seg · @dager d</span>
                                        }
                                        else
                                        {
                                            <span class="k-pill s-ok">OK</span>
                                        }
                                    </td>
                                    <td><input class="k-inp-flat k-smule" @bind="lisens.Notat" placeholder="–" /></td>
                                    <td class="h k-nowrap"><button type="button" class="k-lenke" @onclick="@(() => LagreLisens(lisens))">Lagre</button> · <button type="button" class="k-lenke k-rod-tekst" @onclick="@(() => SlettLisens(lisens))">Slett</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (!string.IsNullOrEmpty(_lisensFeil))
                {
                    <span class="form-error">@_lisensFeil</span>
                }
                @if (!string.IsNullOrEmpty(_lisensMelding))
                {
                    <span class="save-success">@_lisensMelding</span>
                }
                <span class="k-hint">Det sendes automatisk varsel når en lisens er innen @LisensVarselService.VarselFrist.Days dager fra utløp.</span>
                @if (_kundeLisenser.Count > 0)
                {
                    <details class="k-arshjul">
                        <summary>Vis årshjul for lisensene</summary>
                        <KundeLisensArshjul Lisenser="_kundeLisenser" />
                    </details>
                }
            </div>

            <div class="k-seksjon">
                <h4>Kundeportal <a href="/brukere">Inviter bruker</a></h4>
                @if (_portalbrukere.Count == 0)
                {
                    <span class="k-smule">Ingen fra kunden har tilgang til kundeportalen ennå.</span>
                }
                else
                {
                    <div class="k-liste">
                        @foreach (var b in _portalbrukere)
                        {
                            <div class="k-lr">
                                <span class="k-av" style="background:@AvatarFarge(b.Navn)">@Initialer(b.Navn)</span>
                                <div><b>@b.Navn</b><small>@b.Epost</small></div>
                                <span class="k-pill @(b.Aktiv ? "s-ok" : "s-gra")">@(b.Aktiv ? "Aktiv" : "Deaktivert")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>;

    private RenderFragment Priser() =>
        @<div class="k-fp">
            <div class="k-opps k-opps3">
                <div><b>@(_kunde!.FastPaslagProsent is { } p ? $"{p:0.#} %" : "0 %")</b><span>fast påslag</span></div>
                <div><b>@_kundeRabatter.Count</b><span>rabatter</span></div>
                <div><b>@(_kunde.Type?.Visningsnavn() ?? "–")</b><span>prisgruppe</span></div>
            </div>
            <div class="k-fp-topp">
                <span class="k-smule">Rabatter brukes automatisk på tilbud og ordrer for kunden.</span>
                <button type="button" class="k-knapp k-knapp-s k-auto" @onclick="@(() => { _visKopier = !_visKopier; _visNyRabatt = false; })">Kopier til annen kunde</button>
                <button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="@(() => { _visNyRabatt = !_visNyRabatt; _visKopier = false; })"><Icon Name="plus" />Ny rabatt</button>
            </div>
            @if (_visNyRabatt)
            {
                @if (LedigeProduktgrupper.Count > 0)
                {
                    <div class="k-nyrad">
                        <select class="k-inp" @bind="_nyRabattProduktgruppeId">
                            <option value="">Velg produktgruppe...</option>
                            @foreach (var pg in LedigeProduktgrupper)
                            {
                                <option value="@pg.Id">@pg.Navn</option>
                            }
                        </select>
                        <input class="k-inp k-smal" type="number" step="0.1" min="0" max="100" @bind="_nyRabattProsent" placeholder="Rabatt %" />
                        <button type="button" class="k-knapp k-knapp-p" @onclick="LeggTilRabatt">Legg til</button>
                    </div>
                }
                else
                {
                    <span class="k-hint">Alle produktgrupper er allerede lagt til. Opprett flere under <a href="/produktgrupper">Produktgrupper</a>.</span>
                }
            }
            @if (_visKopier)
            {
                @if (_kundeRabatter.Count > 0 && _andreKunder.Count > 0)
                {
                    <div class="k-nyrad">
                        <select class="k-inp" @bind="_kopierTilKundeId">
                            <option value="">Velg kunde...</option>
                            @foreach (var k in _andreKunder)
                            {
                                <option value="@k.Id">@k.Navn</option>
                            }
                        </select>
                        <button type="button" class="k-knapp k-knapp-p" @onclick="KopierRabatterTilAnnenKunde">Kopier rabattene</button>
                    </div>
                }
                else
                {
                    <span class="k-hint">Legg inn minst én rabatt før du kopierer til en annen kunde.</span>
                }
            }
            @if (_kundeRabatter.Count == 0)
            {
                <span class="k-smule">Ingen rabatter satt for denne kunden ennå.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Varegruppe</th><th class="h">Rabatt</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in _kundeRabatter)
                        {
                            var rabatt = r;
                            <tr @key="r.Id" class="k-redig">
                                <td><b>@r.Produktgruppe?.Navn</b></td>
                                <td class="h k-mono"><input class="k-inp-flat k-tall" type="number" step="0.1" min="0" max="100" @bind="rabatt.RabattProsent" /> %</td>
                                <td class="h k-nowrap"><button type="button" class="k-lenke" @onclick="@(() => LagreRabatt(rabatt))">Lagre</button> · <button type="button" class="k-lenke k-rod-tekst" @onclick="@(() => SlettRabatt(rabatt))">Slett</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (!string.IsNullOrEmpty(_rabattFeil))
            {
                <span class="form-error">@_rabattFeil</span>
            }
            @if (!string.IsNullOrEmpty(_rabattMelding))
            {
                <span class="save-success">@_rabattMelding</span>
            }
            <div class="k-seksjon">
                <h4>Fast påslag</h4>
                <span class="k-smule">Settes et fast påslag her, fylles alle varer automatisk med pristype «Påslag» og denne verdien når kunden velges på et service-tilbud.</span>
                <div class="k-nyrad">
                    <input class="k-inp k-smal" type="number" step="0.1" min="0" @bind="_kunde.FastPaslagProsent" placeholder="Påslag %" />
                    <button type="button" class="k-knapp k-knapp-p" @onclick="LagreFastPaslag">Lagre påslag</button>
                    @if (!string.IsNullOrEmpty(_paslagMelding))
                    {
                        <span class="save-success">@_paslagMelding</span>
                    }
                </div>
            </div>
        </div>;

    private RenderFragment Kontakter() =>
        @<div class="k-fp">
            <div class="k-fp-topp">
                <span class="k-smule">@AntallKontakter kontaktperson@(AntallKontakter == 1 ? "" : "er")</span>
                <button type="button" class="k-knapp k-knapp-s k-knapp-p k-auto" @onclick="@(() => _visNyKontakt = !_visNyKontakt)"><Icon Name="plus" />Legg til</button>
            </div>
            @if (_visNyKontakt)
            {
                <div class="k-nyrad">
