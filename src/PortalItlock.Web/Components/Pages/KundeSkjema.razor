@page "/kunder/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_kunde?.Navn ?? "Kunde")</PageTitle>

@if (_notFound)
{
    <p class="form-error">Fant ikke kunden. Den kan være slettet.</p>
}
else if (_kunde is not null)
{
    <a class="back-link" href="/kunder">← Tilbake til kunder</a>
    <h1>@_kunde.Navn</h1>
    <p class="section-hint">Tripletex kundenummer må fylles ut for å kunne eksportere tilbud til Tripletex som CSV.</p>

    <section class="kunde-section">
        <div class="field-grid">
            <label class="span-2">
                Navn
                <input @bind="_kunde.Navn" @bind:event="oninput" />
            </label>
            <label>Kontaktperson<input @bind="_kunde.Kontaktperson" /></label>
            <label>Telefon<input @bind="_kunde.Telefon" /></label>
            <label>E-post<input @bind="_kunde.Epost" /></label>
            <label>Adresse<input @bind="_kunde.Adresse" /></label>
            <label>Post nr<input @bind="_kunde.Postnr" /></label>
            <label>Sted<input @bind="_kunde.Sted" /></label>
            <label>
                Tripletex kundenr.
                <input @bind="_kunde.TripletexKundenummer" placeholder="F.eks. 10010" />
            </label>
            <label class="span-2">
                Notater
                <textarea rows="3" @bind="_kunde.Notater"></textarea>
            </label>
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="form-error">@_error</span>
            }
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>
    </section>

    <section class="kunde-section">
        <h2>Prosjekter</h2>
        @if (_prosjekter.Count == 0)
        {
            <p class="list-empty">Ingen prosjekter knyttet til denne kunden ennå.</p>
        }
        else
        {
            <ul class="prosjekt-list">
                @foreach (var p in _prosjekter)
                {
                    <li><a href="@($"/prosjekter/{p.Id}")">@p.Navn</a></li>
                }
            </ul>
        }
    </section>

    <section class="kunde-section">
        @if (_confirmingDelete)
        {
            <span class="delete-confirm">
                Er du sikker? Prosjekter knyttet til kunden mister koblingen, men slettes ikke.
                <button type="button" class="delete-confirm-button" @onclick="SlettKunde">Ja, slett</button>
                <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
            </span>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett kunde</button>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class ProsjektOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private Kunde? _kunde;
    private bool _notFound;
    private bool _confirmingDelete;
    private string? _error;
    private string? _savedMessage;
    private List<ProsjektOption> _prosjekter = [];
    private int? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _error = null;
        _savedMessage = null;

        _kunde = await Db.Kunder.FirstOrDefaultAsync(k => k.Id == Id);
        _notFound = _kunde is null;

        if (_kunde is null)
        {
            return;
        }

        _prosjekter = await Db.Prosjekter
            .Where(p => p.KundeId == Id)
            .OrderBy(p => p.Navn)
            .Select(p => new ProsjektOption { Id = p.Id, Navn = p.Navn })
            .ToListAsync();
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_kunde!.Navn))
        {
            _error = "Kunden må ha et navn.";
            return;
        }

        _error = null;
        await Db.SaveChangesAsync();
        _savedMessage = "Lagret.";
    }

    private async Task SlettKunde()
    {
        Db.Kunder.Remove(_kunde!);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/kunder");
    }
}
