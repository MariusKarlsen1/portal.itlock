@page "/komponenter/{Id:int}/prishistorikk"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Prishistorikk</PageTitle>

<a class="back-link" href="/komponenter">← Tilbake til komponentregisteret</a>
<h1>Prishistorikk: @_navn</h1>

@if (_historikk.Count == 0)
{
    <p class="section-hint">Ingen prisendringer registrert for denne varen ennå.</p>
}
else
{
    <table class="import-table">
        <thead>
            <tr>
                <th>Dato</th>
                <th>Kilde</th>
                <th>Netto</th>
                <th>Veiledende</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in _historikk)
            {
                <tr>
                    <td>@h.Dato.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@h.Kilde</td>
                    <td>@FormatEndring(h.GammelPrisNetto, h.NyPrisNetto)</td>
                    <td>@FormatEndring(h.GammelPrisVeiledende, h.NyPrisVeiledende)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    [Parameter] public int Id { get; set; }

    private string _navn = "";
    private List<PortalItlock.Web.Models.PrisHistorikk> _historikk = [];

    protected override async Task OnInitializedAsync()
    {
        var comp = await Db.Components.FindAsync(Id);
        _navn = comp?.Navn ?? "";

        _historikk = await Db.PrisHistorikk
            .Where(h => h.ComponentId == Id)
            .OrderByDescending(h => h.Dato)
            .ToListAsync();
    }

    private static string FormatEndring(decimal? gammel, decimal? ny)
    {
        var g = gammel.HasValue ? gammel.Value.ToString("N2", Kultur) : "-";
        var n = ny.HasValue ? ny.Value.ToString("N2", Kultur) : "-";

        if (gammel == ny)
        {
            return $"{n} kr";
        }

        var prosent = "";
        if (gammel is > 0 && ny.HasValue)
        {
            var diff = (ny.Value - gammel.Value) / gammel.Value * 100m;
            prosent = $" ({(diff >= 0 ? "+" : "")}{diff.ToString("N1", Kultur)}%)";
        }

        return $"{g} kr → {n} kr{prosent}";
    }
}
