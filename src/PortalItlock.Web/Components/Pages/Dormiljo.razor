@page "/dormiljo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dørmiljø</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="box" /></span>
    <div>
        <h1>Dørmiljø</h1>
        <p class="section-hint">Tegninger av ulike dørmiljø. Trykk på et dørmiljø for å se tegningen. Du kan endre navnet på hvert dokument.</p>
    </div>
</div>

<div class="doc-list">
    @foreach (var doc in _documents)
    {
        <details class="doc-kort">
            <summary class="doc-summary">
                <span class="doc-summary-ikon"><Icon Name="file-text" /></span>
                @doc.Navn
                <span class="doc-chevron"><Icon Name="chevron-down" /></span>
            </summary>
            <div class="doc-body">
                <div class="doc-edit">
                    <input @bind="doc.Navn" @bind:event="oninput" />
                    <button type="button" class="knapp knapp-primaer" @onclick="@(() => Save(doc))"><Icon Name="check" />Lagre navn</button>
                    <a class="doc-open" href="@($"dormiljo/{doc.FileName}")" target="_blank"><Icon Name="maximize" />Åpne i ny fane</a>
                    @if (doc.Lagret)
                    {
                        <span class="lagret-tag"><Icon Name="check-circle" />Lagret</span>
                    }
                </div>
                <div class="doc-preview-boks">
                    <iframe src="@($"dormiljo/{doc.FileName}")" class="doc-preview" title="@doc.Navn"></iframe>
                </div>
            </div>
        </details>
    }
</div>

@code {
    private sealed class DocDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string FileName { get; set; } = "";
        public bool Lagret { get; set; }
    }

    private List<DocDraft> _documents = [];

    protected override async Task OnInitializedAsync()
    {
        var documents = await Db.DoorEnvironmentDocuments
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _documents = documents.Select(d => new DocDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            FileName = d.FileName
        }).ToList();
    }

    private async Task Save(DocDraft doc)
    {
        var entity = await Db.DoorEnvironmentDocuments.FirstAsync(d => d.Id == doc.Id);
        entity.Navn = doc.Navn.Trim();
        await Db.SaveChangesAsync();

        foreach (var d in _documents)
        {
            d.Lagret = false;
        }
        doc.Lagret = true;
    }
}
