@page "/dormiljo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dørmiljø</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="box" /></span>
    <div>
        <h1>Dørmiljø</h1>
        <p class="section-hint">Tegninger av ulike dørmiljø. Velg et dørmiljø i listen for å se tegningen. Du kan endre navnet på hvert dokument.</p>
    </div>
</div>

@if (_documents.Count == 0)
{
    <p class="list-empty">Ingen dørmiljø lagt inn ennå.</p>
}
else
{
    <div class="master-detail">
        <div class="master-panel">
            <div class="search-box">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" placeholder="Søk …" />
            </div>
            @foreach (var doc in _filtrerte)
            {
                <div @key="doc.Id" class="master-row @(doc.Id == _valgtId ? "master-row-valgt" : "")" @onclick="@(() => _valgtId = doc.Id)">
                    <span class="fil-type"><Icon Name="file-text" /></span>
                    <div class="master-row-tekst">
                        <span class="master-row-navn">@doc.Navn</span>
                    </div>
                </div>
            }
            @if (_filtrerte.Count == 0)
            {
                <p class="list-empty master-tomt-sok">Ingen treff.</p>
            }
        </div>

        <div class="detail-panel">
            @if (_valgt is null)
            {
                <div class="detail-tomt">
                    <Icon Name="file-text" />
                    <span>Velg et dørmiljø i listen</span>
                </div>
            }
            else
            {
                <div class="detail-innhold">
                    <div class="doc-preview-boks">
                        <iframe src="@($"dormiljo/{_valgt.FileName}")" class="doc-preview" title="@_valgt.Navn"></iframe>
                    </div>
                    <div class="doc-edit">
                        <input @bind="_valgt.Navn" @bind:event="oninput" />
                        <button type="button" class="knapp knapp-primaer" @onclick="@(() => Save(_valgt))"><Icon Name="check" />Lagre navn</button>
                        <a class="doc-open" href="@($"dormiljo/{_valgt.FileName}")" target="_blank"><Icon Name="maximize" />Åpne i ny fane</a>
                        @if (_valgt.Lagret)
                        {
                            <span class="lagret-tag"><Icon Name="check-circle" />Lagret</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private sealed class DocDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string FileName { get; set; } = "";
        public bool Lagret { get; set; }
    }

    private List<DocDraft> _documents = [];
    private int? _valgtId;
    private string _sok = "";

    private List<DocDraft> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _documents
        : _documents.Where(d => d.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private DocDraft? _valgt => _documents.FirstOrDefault(d => d.Id == _valgtId);

    protected override async Task OnInitializedAsync()
    {
        var documents = await Db.DoorEnvironmentDocuments
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _documents = documents.Select(d => new DocDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            FileName = d.FileName
        }).ToList();

        _valgtId = _documents.FirstOrDefault()?.Id;
    }

    private async Task Save(DocDraft doc)
    {
        var entity = await Db.DoorEnvironmentDocuments.FirstAsync(d => d.Id == doc.Id);
        entity.Navn = doc.Navn.Trim();
        await Db.SaveChangesAsync();

        foreach (var d in _documents)
        {
            d.Lagret = false;
        }
        doc.Lagret = true;
    }
}
