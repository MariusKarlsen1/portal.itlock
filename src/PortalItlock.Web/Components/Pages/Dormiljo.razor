@page "/dormiljo"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dørmiljø</PageTitle>

<h1>Dørmiljø</h1>
<p>Tegninger av ulike dørmiljø. Trykk på et dørmiljø for å se tegningen. Du kan endre navnet på hvert dokument.</p>

<div class="doc-list">
    @foreach (var doc in _documents)
    {
        <details class="doc-group">
            <summary>@doc.Navn</summary>
            <div class="doc-body">
                <div class="doc-edit">
                    <input @bind="doc.Navn" @bind:event="oninput" />
                    <button type="button" class="save-button" @onclick="@(() => Save(doc))">Lagre navn</button>
                    <a class="doc-open" href="@($"dormiljo/{doc.FileName}")" target="_blank">Åpne i ny fane</a>
                    @if (doc.Lagret)
                    {
                        <span class="save-success">Lagret.</span>
                    }
                </div>
                <iframe src="@($"dormiljo/{doc.FileName}")" class="doc-preview" title="@doc.Navn"></iframe>
            </div>
        </details>
    }
</div>

@code {
    private sealed class DocDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string FileName { get; set; } = "";
        public bool Lagret { get; set; }
    }

    private List<DocDraft> _documents = [];

    protected override async Task OnInitializedAsync()
    {
        var documents = await Db.DoorEnvironmentDocuments
            .OrderBy(d => d.Rekkefolge)
            .ToListAsync();

        _documents = documents.Select(d => new DocDraft
        {
            Id = d.Id,
            Navn = d.Navn,
            FileName = d.FileName
        }).ToList();
    }

    private async Task Save(DocDraft doc)
    {
        var entity = await Db.DoorEnvironmentDocuments.FirstAsync(d => d.Id == doc.Id);
        entity.Navn = doc.Navn.Trim();
        await Db.SaveChangesAsync();

        foreach (var d in _documents)
        {
            d.Lagret = false;
        }
        doc.Lagret = true;
    }
}
