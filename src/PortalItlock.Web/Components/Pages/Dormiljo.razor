@page "/dormiljo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Dørmiljø</PageTitle>

@* D1 (dormiljo-forslag): lista til venstre med annenhver grå og hvit rad, og
   tegningen til høyre med knappene over. Navn, opplasting og sletting ligger
   bak Rediger, som bare admin ser. *@
<div class="dm-side @(_full ? "dm-full" : "")">
    <div class="dm-kort">
        <header class="dm-hode">
            <span class="dm-hode-ikon"><Icon Name="box" /></span>
            <div class="dm-hode-tekst">
                <h1>Dørmiljø</h1>
                <p>Tegninger av ulike dørmiljø</p>
            </div>
            <AuthorizeView Roles="Admin">
                <button type="button" class="dm-knapp @(_redigerModus ? "dm-knapp-primaer" : "")" @onclick="ToggleRedigerModus"><Icon Name="@(_redigerModus ? "check" : "edit")" />@(_redigerModus ? "Ferdig" : "Rediger")</button>
            </AuthorizeView>
            <button type="button" class="dm-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </header>

        @if (_documents.Count == 0)
        {
            <div class="dm-tom">
                <b>Ingen dørmiljø lagt inn ennå</b>
                @if (_redigerModus)
                {
                    <FilOpplastingssone Laster="_laster" Feilmelding="_feilmelding" OnFilValgt="LastOppFil" />
                }
            </div>
        }
        else
        {
            <div class="dm-delt">
                <section class="dm-ramme">
                    <div class="dm-gra">Dørmiljø <small>@_documents.Count</small></div>
                    <label class="dm-sok">
                        <Icon Name="search" />
                        <input @bind="_sok" @bind:event="oninput" placeholder="Søk" aria-label="Søk etter dørmiljø" />
                    </label>
                    <div class="dm-rader">
                        @foreach (var doc in _filtrerte)
                        {
                            <button type="button" @key="doc.Id" class="@(doc.Id == _valgtId ? "valgt" : "")" aria-current="@(doc.Id == _valgtId ? "true" : "false")" @onclick="@(() => VelgDokument(doc.Id))">@doc.Navn</button>
                        }
                    </div>
                    @if (_filtrerte.Count == 0)
                    {
                        <p class="dm-ingen">Ingen treff.</p>
                    }
                    @if (_redigerModus)
                    {
                        <div class="dm-opplasting">
                            <FilOpplastingssone Laster="_laster" Feilmelding="_feilmelding" OnFilValgt="LastOppFil" Kompakt="true" />
                        </div>
                    }
                </section>

                <section class="dm-ramme">
                    @if (_valgt is null)
                    {
                        <div class="dm-gra">Tegning</div>
                        <p class="dm-ingen">Velg et dørmiljø i listen.</p>
                    }
                    else
                    {
                        <div class="dm-gra">
                            <span class="dm-tittel">@_valgt.Navn</span>
                            <span class="dm-valg">
                                <a class="dm-knapp dm-knapp-liten" href="@Filadresse(_valgt)" download="@Filnavn(_valgt)"><Icon Name="download" />Last ned</a>
                                @if (_valgt.ErBilde)
                                {
                                    <a class="dm-knapp dm-knapp-liten" href="@Filadresse(_valgt)" target="_blank" rel="noopener"><Icon Name="printer" />Skriv ut</a>
                                }
                                else
                                {
                                    <button type="button" class="dm-knapp dm-knapp-liten" onclick="var f=document.querySelector('.dm-fil');try{f.contentWindow.focus();f.contentWindow.print();}catch(e){window.open(f.src,'_blank');}"><Icon Name="printer" />Skriv ut</button>
                                }
                                <a class="dm-knapp dm-knapp-liten" href="@Filadresse(_valgt)" target="_blank" rel="noopener"><Icon Name="external-link" />Åpne i ny fane</a>
                            </span>
                        </div>

                        @if (_redigerModus)
                        {
                            <div class="dm-rediger">
                                <input @bind="_valgt.Navn" @bind:event="oninput" aria-label="Navn på dørmiljø" />
                                <button type="button" class="dm-knapp dm-knapp-liten dm-knapp-primaer" @onclick="@(() => Save(_valgt))"><Icon Name="check" />Lagre navn</button>
                                @if (_valgt.Lagret)
                                {
                                    <span class="dm-lagret">Lagret</span>
                                }
                                <span class="dm-slett">
                                    @if (_slettId == _valgt.Id)
                                    {
                                        <span>Slette «@_valgt.Navn»?</span>
                                        <button type="button" class="dm-knapp dm-knapp-liten dm-knapp-fare" @onclick="@(() => Slett(_valgt))">Ja, slett</button>
                                        <button type="button" class="dm-knapp dm-knapp-liten" @onclick="@(() => _slettId = null)">Avbryt</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="dm-slett-knapp" @onclick="@(() => _slettId = _valgt.Id)"><Icon Name="trash" />Slett</button>
                                    }
                                </span>
                            </div>
                        }

                        <div class="dm-tegning">
                            @if (_valgt.ErBilde)
                            {
                                <img src="@Filadresse(_valgt)" alt="@_valgt.Navn" />
                            }
                            else
                            {
                                <iframe @key="_valgt.Id" class="dm-fil" src="@($"{Filadresse(_valgt)}#toolbar=0&navpanes=0&view=Fit")" title="@_valgt.Navn"></iframe>
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </div>
</div>

@code {
    private sealed class DocDraft
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string FileName { get; set; } = "";
        public bool Lagret { get; set; }

        // Opplastede dokumenter ligger i databasen og hentes via
        // /dormiljofil/{id}; de opprinnelige ligger statisk i wwwroot.
        public bool Opplastet { get; set; }
        public string? ContentType { get; set; }

        public bool ErBilde => ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;
    }

    private List<DocDraft> _documents = [];
    private int? _valgtId;
    private string _sok = "";
    private bool _redigerModus;
    private bool _full;

    // Redigering av dørmiljøtegningene har alltid vært forbeholdt admin (se
    // AuthorizeView i markupen over). Her gjentas det på serveren, slik at
    // montører og prosjektledere avvises i metodene og ikke bare ser en
    // skjult knapp.
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private bool _kanRedigere;
    private int? _slettId;
    private bool _laster;
    private string? _feilmelding;

    private static string Filadresse(DocDraft doc) =>
        doc.Opplastet ? $"/dormiljofil/{doc.Id}" : $"dormiljo/{doc.FileName}";

    private List<DocDraft> _filtrerte => string.IsNullOrWhiteSpace(_sok)
        ? _documents
        : _documents.Where(d => d.Navn.Contains(_sok, StringComparison.OrdinalIgnoreCase)).ToList();

    private DocDraft? _valgt => _documents.FirstOrDefault(d => d.Id == _valgtId);

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _kanRedigere = state.User.IsInRole(nameof(BrukerRolle.Admin));
        }

        _full = await VisningPref.HentAsync("dormiljo-bredde", "normal") == "full";
        await LastDokumenterAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dormiljo-bredde", _full ? "full" : "normal");
    }

    private void VelgDokument(int id)
    {
        _valgtId = id;
        _slettId = null;
    }

    // Beholder filtypen, så nedlastingen får navnet fra lista.
    private static string Filnavn(DocDraft doc) => doc.Navn.Trim() + Path.GetExtension(doc.FileName);

    private async Task LastDokumenterAsync()
    {
        // Select-projeksjonen holder blob-dataen utenfor - vi trenger bare å
        // vite om den finnes, ikke selve innholdet.
        _documents = await Db.DoorEnvironmentDocuments
            .OrderBy(d => d.Rekkefolge)
            .Select(d => new DocDraft
            {
                Id = d.Id,
                Navn = d.Navn,
                FileName = d.FileName,
                Opplastet = PortalItlock.Web.Data.SqlFn.TypeOf(d.Data) != "null" && d.Data!.Length > 0,
                ContentType = d.ContentType
            })
            .ToListAsync();

        if (_valgtId is null || _documents.All(d => d.Id != _valgtId))
        {
            _valgtId = _documents.FirstOrDefault()?.Id;
        }
    }

    private void ToggleRedigerModus()
    {
        if (!_kanRedigere)
        {
            return;
        }

        _redigerModus = !_redigerModus;
        _slettId = null;
        _feilmelding = null;
    }

    private async Task LastOppFil(IBrowserFile file)
    {
        if (!_kanRedigere || _laster)
        {
            return;
        }

        _feilmelding = null;

        if (file.Size > 20_000_000)
        {
            _feilmelding = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        _laster = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var nesteRekkefolge = await Db.DoorEnvironmentDocuments.AnyAsync()
                ? await Db.DoorEnvironmentDocuments.MaxAsync(d => d.Rekkefolge) + 1
                : 1;

            var ny = new DoorEnvironmentDocument
            {
                Navn = Path.GetFileNameWithoutExtension(file.Name),
                FileName = file.Name,
                Rekkefolge = nesteRekkefolge,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType
            };

            Db.DoorEnvironmentDocuments.Add(ny);
            await Db.SaveChangesAsync();

            await LastDokumenterAsync();
            _valgtId = ny.Id;
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task Slett(DocDraft doc)
    {
        if (!_kanRedigere)
        {
            return;
        }

        await Db.DoorEnvironmentDocuments.Where(d => d.Id == doc.Id).ExecuteDeleteAsync();
        _documents.Remove(doc);
        _slettId = null;

        if (_valgtId == doc.Id)
        {
            _valgtId = _documents.FirstOrDefault()?.Id;
        }
    }

    private async Task Save(DocDraft doc)
    {
        if (!_kanRedigere)
        {
            return;
        }

        var entity = await Db.DoorEnvironmentDocuments.FirstAsync(d => d.Id == doc.Id);
        entity.Navn = doc.Navn.Trim();
        await Db.SaveChangesAsync();

        foreach (var d in _documents)
        {
            d.Lagret = false;
        }
        doc.Lagret = true;
    }
}
