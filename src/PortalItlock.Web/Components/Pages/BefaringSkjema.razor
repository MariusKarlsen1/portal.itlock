@page "/befaring/ny"
@page "/befaring/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using SkiaSharp
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject BefaringPdfService PdfService
@inject GeocodingService Geokoding
@inject IJSRuntime JS

<PageTitle>@(Id.HasValue ? "Rediger befaring" : "Ny befaring")</PageTitle>

<script>
    window.bsScrollOgFokuser = function (id) {
        var el = document.getElementById(id);
        if (!el) {
            return;
        }
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function () { el.focus(); }, 300);
    };
</script>

@if (_notFound)
{
    <a class="back-link" href="/befaringsliste"><Icon Name="arrow-left" />Til befaringsliste</a>
    <p class="form-error">Fant ikke befaringen. Den kan være slettet.</p>
}
else
{
    <header class="bs-topp">
        <div class="bs-topp-venstre">
            <span class="bs-merke"><Icon Name="eye" /></span>
            <div class="bs-topp-tekst">
                <h1>@(Id.HasValue ? "Rediger befaring" : "Ny befaring")</h1>
                <p>@(Id.HasValue ? $"BEF-{Id!.Value:0000}" : "Ny registrering")</p>
            </div>
        </div>
        <div class="bs-topp-knapper">
            <div class="bs-meny-wrap">
                <button type="button" class="bs-ikonknapp" title="Flere valg" @onclick="@(() => _visToppmeny = !_visToppmeny)"><Icon Name="more-vertical" /></button>
                @if (_visToppmeny)
                {
                    <div class="bs-meny">
                        <a href="/befaringsliste"><Icon Name="arrow-left" />Til befaringsliste</a>
                        @if (Id.HasValue)
                        {
                            <button type="button" @onclick="VisPdfForhandsvisning"><Icon Name="file-text" />Lagre som PDF</button>
                            <button type="button" class="bs-meny-fare" @onclick="@(() => { _confirmingDelete = true; _visToppmeny = false; _steg = 4; })"><Icon Name="trash" />Slett befaring</button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="bs-ikonknapp bs-ikonknapp-primaer" title="@(Id.HasValue ? "Lagre endringer" : "Lagre befaring")" @onclick="SaveBefaring"><Icon Name="check" /></button>
        </div>
    </header>

    <nav class="bs-stepper">
        @foreach (var (nr, navn) in Stegnavn)
        {
            <button type="button" class="bs-steg @(_steg == nr ? "bs-steg-aktiv" : "") @(_steg > nr ? "bs-steg-ferdig" : "")" @onclick="@(() => _steg = nr)">
                <span class="bs-steg-tall">@nr</span>@navn
            </button>
        }
    </nav>

    @if (_steg == 1)
    {
        <div class="bs-steg1">
            <div class="bs-kartkort">
                @if (_form.Latitude is not null && _form.Longitude is not null)
                {
                    <div id="befaring-kart-visning" class="bs-kart-visning"></div>
                }
                else
                {
                    <div class="bs-kart-placeholder"><Icon Name="map-pin" /></div>
                }
                @if (HarAdresse)
                {
                    <a class="bs-kart-knapp" href="@LokasjonKartUrl" target="_blank" rel="noopener"><Icon Name="map-pin" />Åpne i kart</a>
                }
                @if (_geokodingFeilet)
                {
                    <p class="bs-kart-feil">Fant ikke posisjon for denne adressen.</p>
                }
            </div>

        <section class="panel" id="grunninformasjon-seksjon">
            <div class="panel-header">
                <span class="panel-ikon"><Icon Name="users" /></span>
                <div>
                    <h2>Grunninformasjon</h2>
                </div>
            </div>
            <div class="field-grid field-grid-2">
                <label>
                    Navn på befaring *
                    <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Kvernaland omsorgsbolig - befaring" />
                </label>
                <label>
                    Kunde *
                    <select @bind="_form.Kundenavn">
                        <option value="">Velg kunde</option>
                        @foreach (var navn in KundeValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label class="span-2">
                    Prosjekt
                    <select @bind="_form.Bygg">
                        <option value="">Velg prosjekt (valgfritt)</option>
                        @foreach (var navn in ProsjektValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label>Dato *<input type="date" @bind="_form.Dato" /></label>
                <label>Tidspunkt *<input type="time" @bind="Tidspunkt" /></label>
                <label class="span-2">
                    Befart av *
                    <select @bind="_form.BefartAv">
                        <option value="">Velg</option>
                        @foreach (var navn in BefartAvValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label class="span-2 bs-adressefelt">
                    <span class="bs-adresse-merkelapp">Adresse</span>
                    <input @bind="_form.Adresse" @bind:after="GeokodLokasjonAsync" placeholder="Skriv adresse..." />
                </label>
            </div>

            @* Resten av grunninformasjonen - mindre brukt, men må fortsatt
               kunne fylles ut. *@
            <details class="bs-mer-felt">
                <summary><Icon Name="chevron-down" />Flere opplysninger</summary>
                <div class="field-grid field-grid-2">
                    <label>Postnr.<input @bind="_form.Postnr" @bind:after="GeokodLokasjonAsync" /></label>
                    <label>Sted<input @bind="_form.Sted" @bind:after="GeokodLokasjonAsync" /></label>
                    <label>Kontaktperson<input @bind="_form.Kontaktperson" /></label>
                    <label>Tlf./mobil<input @bind="_form.Tlf" /></label>
                    <label>E-post<input @bind="_form.Epost" /></label>
                    <label>System nr.<input @bind="_form.SystemNr" /></label>
                    <label class="span-2" id="oppdrag-felt">
                        Oppdrag / beskrivelse
                        <textarea id="oppdrag-tekstfelt" rows="2" maxlength="500" @bind="_form.Oppdrag" @bind:event="oninput" placeholder="Kort beskrivelse av befaringen, formål, spesielle forhold osv."></textarea>
                        <span class="bs-tegnteller">@((_form.Oppdrag?.Length ?? 0))/500</span>
                    </label>
                </div>
            </details>
        </section>
        </div>
    }

    @if (_steg == 2)
    {
        <section class="panel" id="dorfelt-seksjon">
            <div class="panel-header">
                <span class="panel-ikon"><Icon Name="box" /></span>
                <div>
                    <h2>Dørfelt@(_dorfelt.Count > 0 ? $" – {_dorfelt.Count} stk" : "")</h2>
                    <p class="section-hint">Registrer ett eller flere dørfelt som befares.</p>
                </div>
                <button type="button" class="knapp bs-panel-knapp" @onclick="AddDorfelt"><Icon Name="plus" />Legg til dørfelt</button>
            </div>

            @if (_dorfelt.Count == 0)
            {
                <p class="list-empty">Ingen dørfelt lagt til ennå.</p>
            }

            @if (_dorfelt.Count > 0)
            {
            <div class="dorfelt-liste">
            @foreach (var d in _dorfelt)
            {
                <details class="dorfelt-kort" open>
                    <summary>
                        <span class="dorfelt-chevron"><Icon Name="chevron-down" /></span>
                        <span class="dorfelt-ikon"><Icon Name="box" /></span>
                        <span class="dorfelt-tittel">
                            <strong>@(string.IsNullOrWhiteSpace(d.Dornavn) ? "Nytt dørfelt" : d.Dornavn) @(string.IsNullOrWhiteSpace(d.Dornr) ? "" : $"({d.Dornr})")</strong>
                            <span class="dorfelt-meta">
                                @if (!string.IsNullOrWhiteSpace(d.Dortype)) { <span>@d.Dortype</span> }
                                @if (!string.IsNullOrWhiteSpace(d.Floyer)) { <span>@d.Floyer</span> }
                                @if (!string.IsNullOrWhiteSpace(d.BxH)) { <span>@d.BxH</span> }
                            </span>
                        </span>
                    </summary>
                    <div class="dorfelt-body">
                        <div class="fane-chips">
                            @if (!string.IsNullOrWhiteSpace(d.Dortype)) { <span>@d.Dortype</span> }
                            @if (!string.IsNullOrWhiteSpace(d.Floyer)) { <span>@d.Floyer</span> }
                            @if (!string.IsNullOrWhiteSpace(d.BxH)) { <span>@d.BxH</span> }
                            @if (!string.IsNullOrWhiteSpace(d.Slagretning)) { <span>Slagretning: @d.Slagretning</span> }
                        </div>

                        <div class="fane-rad">
                            <button type="button" class="fane @(AktivFane(d) == "id" ? "aktiv" : "")" @onclick='() => SettFane(d, "id")'>Identifikasjon</button>
                            <button type="button" class="fane @(AktivFane(d) == "krav" ? "aktiv" : "")" @onclick='() => SettFane(d, "krav")'>Krav</button>
                            <button type="button" class="fane @(AktivFane(d) == "laser" ? "aktiv" : "")" @onclick='() => SettFane(d, "laser")'>Låser</button>
                            <button type="button" class="fane @(AktivFane(d) == "auto" ? "aktiv" : "")" @onclick='() => SettFane(d, "auto")'>Dørlukker og automatikk</button>
                            <button type="button" class="fane @(AktivFane(d) == "ovrig" ? "aktiv" : "")" @onclick='() => SettFane(d, "ovrig")'>Øvrig og bilder</button>
                        </div>

                        @if (AktivFane(d) == "id")
                        {
                        <div class="fane-panel">
                        <div class="field-grid">
                            <label>Dør nr<input @bind="d.Dornr" /></label>
                            <label>Dørnavn<input @bind="d.Dornavn" @bind:event="oninput" /></label>
                            <label>
                                Dørtype
                                <select @bind="d.Dortype">
                                    <option value="">Velg</option>
                                    <option value="Tre">Tre</option>
                                    <option value="Stål">Stål</option>
                                    <option value="Alu">Alu</option>
                                </select>
                            </label>
                            <label>
                                Fløyer
                                <select @bind="d.Floyer">
                                    <option value="">Velg</option>
                                    <option value="Enfløyet">Enfløyet</option>
                                    <option value="Tofløyet">Tofløyet</option>
                                    <option value="B gangdør">B gangdør</option>
                                </select>
                            </label>
                            <label>BxH<input @bind="d.BxH" /></label>
                            <label>
                                Slagretning
                                <select @bind="d.Slagretning">
                                    <option value="">Velg</option>
                                    <option value="Høyre">Høyre</option>
                                    <option value="Venstre">Venstre</option>
                                </select>
                            </label>
                            <label>Låssystemnr<input @bind="d.Lassystemnr" /></label>
                        </div>
                        </div>
                        }

                        @if (AktivFane(d) == "krav")
                        {
                        <div class="fane-panel">
                        <div class="field-grid">
                            <label>
                                Brannkrav
                                <select @bind="d.Brannkrav">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                            <label>Brannklasse<input @bind="d.Brannklasse" @bind:event="oninput" placeholder="F.eks. B1, EI30" /></label>
                            <label>FG/Beskytteklasse<input @bind="d.Fg" @bind:event="oninput" /></label>
                            <label>Sikringsklasse<input @bind="d.Sikringsklasse" @bind:event="oninput" /></label>
                            <label>Risikoklasse<input @bind="d.Risikoklasse" /></label>
                            <label>
                                Universell utforming
                                <select @bind="d.UniversellUtforming">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                            <label>
                                Åpnekraft maks 30N
                                <select @bind="d.ApnekraftMaks30N">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                        </div>
                        </div>
                        }

                        @if (AktivFane(d) == "laser")
                        {
                        <div class="fane-panel">
                        <div class="laser-2col">
                            <div class="skjema-seksjon">
                                <p class="skjema-seksjon-tittel">Daglås</p>
                                <LassystemFields Data="d.Daglas" OnEndret="StateHasChanged" />
                            </div>
                            <div class="skjema-seksjon">
                                <p class="skjema-seksjon-tittel">Nattlås</p>
                                <LassystemFields Data="d.Nattlas" OnEndret="StateHasChanged" />
                            </div>
                        </div>
                        </div>
                        }

                        @if (AktivFane(d) == "auto")
                        {
                        <div class="fane-panel">
                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Dørlukker</p>
                        <div class="field-grid">
                            <label>Dørlukker<input @bind="d.Dorlukker" /></label>
                            <label>Arm/Glideskinne<input @bind="d.ArmGlideskinne" /></label>
                            <label>VK/plate<input @bind="d.VkPlate" /></label>
                            <label>
                                Montasje side
                                <select @bind="d.MontasjeSideDorlukker">
                                    <option value="">Velg</option>
                                    <option value="HS">HS</option>
                                    <option value="KS">KS</option>
                                </select>
                            </label>
                            <label>Annet utstyr<input @bind="d.AnnetUtstyrDorlukker" /></label>
                        </div>
                        </div>

                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Automatikk</p>
                        <div class="field-grid">
                            <label>Automatikk<input @bind="d.Automatikk" /></label>
                            <label>Trekk/skyv.arm<input @bind="d.TrekkSkyvArm" /></label>
                            <label>Adapter<input @bind="d.Adapter" /></label>
                            <label>
                                Montasje side
                                <select @bind="d.MontasjeSideAutomatikk">
                                    <option value="">Velg</option>
                                    <option value="HS">HS</option>
                                    <option value="KS">KS</option>
                                </select>
                            </label>
                            <label>Albuekontakter<input @bind="d.Albuekontakter" /></label>
                            <label>Radar/Sensor<input @bind="d.RadarSensor" /></label>
                            <label>Kabel<input @bind="d.KabelAutomatikk" /></label>
                            <label>UPS/Nødstrøm<input @bind="d.UpsNodstrom" /></label>
                            <label>Sikkerhetssensor<input @bind="d.Sikkerhetssensor" /></label>
                        </div>
                        </div>
                        </div>
                        }

                        @if (AktivFane(d) == "ovrig")
                        {
                        <div class="fane-panel">
                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Øvrig beslag</p>
                        <div class="field-grid">
                            <label>Magnetlås<input @bind="d.Magnetlas" /></label>
                            <label>Brakett til ML<input @bind="d.BrakettMl" /></label>
                            <label>Panikkb./skåte<input @bind="d.Panikkbeslag" /></label>
                            <label>Håndtak<input @bind="d.Handtak" /></label>
                            <label>Annet utstyr<input @bind="d.AnnetUtstyrOvrig" /></label>
                        </div>
                        </div>

                        <label class="notes-field">
                            Anm./notater
                            <textarea rows="3" @bind="d.Notater" @bind:event="oninput"></textarea>
                        </label>

                        <div class="skjema-seksjon">
                            <p class="skjema-seksjon-tittel">Bilder</p>
                            @if (d.Id == 0)
                            {
                                <p class="bilder-hint">Lagre befaringen først for å kunne legge til bilder.</p>
                            }
                            else
                            {
                                @if (d.Bilder.Count > 0)
                                {
                                    <div class="bilder-grid">
                                        @foreach (var bilde in d.Bilder)
                                        {
                                            <div class="bilde-thumb">
                                                <img src="@($"/bilder/{bilde.Id}")" alt="@bilde.Filnavn" />
                                                <button type="button" class="bilde-remove" title="Fjern bilde" @onclick="@(() => RemoveBilde(d, bilde))">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                                <label class="dropzone">
                                    <span class="dropzone-ikon"><Icon Name="upload" /></span>
                                    <span class="dropzone-tekst">
                                        <strong>Legg til bilder</strong>
                                        <span>Dra og slipp, eller trykk for å velge</span>
                                    </span>
                                    <InputFile OnChange="@((e) => OnBilderSelected(d, e))" multiple accept="image/*" capture="environment" />
                                </label>
                                @if (_uploadingDorfeltId == d.Id)
                                {
                                    <p class="bilder-hint">Laster opp...</p>
                                }
                                @if (_bildeFeil.TryGetValue(d.Id, out var bildeFeilmelding) && !string.IsNullOrEmpty(bildeFeilmelding))
                                {
                                    <p class="form-error">@bildeFeilmelding</p>
                                }
                            }
                        </div>
                        </div>
                        }

                        <button type="button" class="knapp knapp-fare" @onclick="@(() => _dorfelt.Remove(d))"><Icon Name="trash" />Fjern dørfelt</button>
                    </div>
                </details>
            }
            </div>
            }

            <button type="button" class="legg-til-dorfelt" @onclick="AddDorfelt"><Icon Name="plus" />Legg til dørfelt</button>
        </section>
    }

    @if (_steg == 3)
    {
        <section class="panel" id="vedlegg-seksjon">
            <div class="panel-header">
                <span class="panel-ikon"><Icon Name="upload" /></span>
                <div>
                    <h2>Bilder og video</h2>
                    <p class="section-hint">Generelle bilder/videoer for hele befaringen (ikke knyttet til et spesifikt dørfelt).</p>
                </div>
            </div>

            @if (!Id.HasValue)
            {
                <p class="bilder-hint">Lagre befaringen først for å kunne laste opp bilder/video.</p>
            }
            else
            {
                @if (_form.Vedlegg.Count > 0)
                {
                    <div class="vedlegg-media-grid">
                        @foreach (var v in _form.Vedlegg)
                        {
                            <div class="vedlegg-media-thumb">
                                @if (v.ErVideo)
                                {
                                    <video src="@($"/befaringvedlegg/{v.Id}")" controls></video>
                                }
                                else
                                {
                                    <img src="@($"/befaringvedlegg/{v.Id}")" alt="@v.Filnavn" />
                                }
                                <button type="button" class="bilde-remove" title="Fjern" @onclick="@(() => RemoveVedlegg(v))">×</button>
                            </div>
                        }
                    </div>
                }
                <label class="dropzone" id="vedlegg-dropzone">
                    <span class="dropzone-ikon"><Icon Name="upload" /></span>
                    <span class="dropzone-tekst">
                        <strong>Legg til bilder eller video</strong>
                        <span>Dra og slipp, eller trykk for å velge</span>
                    </span>
                    <InputFile OnChange="OnVedleggValgt" multiple accept="image/*,video/*" capture="environment" />
                </label>
                @if (_lasterOppVedlegg)
                {
                    <p class="bilder-hint">Laster opp...</p>
                }
                @if (!string.IsNullOrEmpty(_vedleggFeil))
                {
                    <p class="form-error">@_vedleggFeil</p>
                }
            }
        </section>

        @if (Id.HasValue)
        {
            <section class="panel" id="lagrede-pdfer-seksjon">
                <div class="panel-header">
                    <span class="panel-ikon"><Icon Name="file-text" /></span>
                    <h2>Lagrede PDF-er</h2>
                </div>
                @if (_lagredePdfer.Count == 0)
                {
                    <p class="list-empty">Ingen PDF-er lagret ennå.</p>
                }
                else
                {
                    <ul class="vedlegg-list">
                        @foreach (var pdf in _lagredePdfer.OrderByDescending(p => p.OpprettetDato))
                        {
                            <li @key="pdf.Id" class="vedlegg-item">
                                <span class="vedlegg-ikon"><Icon Name="file-text" /></span>
                                <a href="@($"/befaringpdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                                <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }

    @if (_steg == 4)
    {
        <section class="panel">
            <div class="panel-header">
                <span class="panel-ikon"><Icon Name="check-circle" /></span>
                <div>
                    <h2>Oppsummering</h2>
                    <p class="section-hint">Kontroller opplysningene og lagre befaringen.</p>
                </div>
                <span class="bs-status-velger-wrap">
                    <select class="bs-status-velger" @bind="_form.Status">
                        @foreach (var verdi in StatusValg)
                        {
                            <option value="@verdi">@verdi.Visningsnavn()</option>
                        }
                    </select>
                    <Icon Name="chevron-down" />
                </span>
            </div>

            <div class="bs-oppsummering">
                <div class="bs-detalj-rad"><span>Befaringsnr.</span><span>@(Id.HasValue ? $"BEF-{Id!.Value:0000}" : "–")</span></div>
                <div class="bs-detalj-rad"><span>Navn</span><span>@(string.IsNullOrWhiteSpace(_form.Navn) ? "–" : _form.Navn)</span></div>
                <div class="bs-detalj-rad"><span>Kunde</span><span>@(string.IsNullOrWhiteSpace(_form.Kundenavn) ? "–" : _form.Kundenavn)</span></div>
                <div class="bs-detalj-rad"><span>Prosjekt</span><span>@(string.IsNullOrWhiteSpace(_form.Bygg) ? "–" : _form.Bygg)</span></div>
                <div class="bs-detalj-rad"><span>Dato</span><span>@(_form.Dato is { } d ? d.ToString("dd.MM.yyyy · HH:mm") : "–")</span></div>
                <div class="bs-detalj-rad"><span>Adresse</span><span>@(HarAdresse ? AdresseTekst : "–")</span></div>
                <div class="bs-detalj-rad">
                    <span>Befart av</span>
                    <span class="bs-avatar-rad">
                        @if (!string.IsNullOrWhiteSpace(_form.BefartAv))
                        {
                            <span class="bs-avatar">@Initialer(_form.BefartAv)</span>
                            <span>@_form.BefartAv</span>
                        }
                        else
                        {
                            <span>–</span>
                        }
                    </span>
                </div>
                <div class="bs-detalj-rad"><span>Dørfelt</span><span>@_dorfelt.Count stk</span></div>
                <div class="bs-detalj-rad"><span>Bilder og video</span><span>@_form.Vedlegg.Count stk</span></div>
                <div class="bs-detalj-rad"><span>Opprettet</span><span>@(Id.HasValue ? _form.OpprettetDato.ToString("dd.MM.yyyy · HH:mm") : "–")</span></div>
                <div class="bs-detalj-rad">
                    <span>Opprettet av</span>
                    <span class="bs-avatar-rad">
                        @if (!string.IsNullOrWhiteSpace(_opprettetAvNavn))
                        {
                            <span class="bs-avatar">@Initialer(_opprettetAvNavn)</span>
                            <span>@_opprettetAvNavn</span>
                        }
                        else
                        {
                            <span>–</span>
                        }
                    </span>
                </div>
            </div>

            @if (Id.HasValue)
            {
                <div class="bs-oppsummering-knapper">
                    <button type="button" class="knapp" @onclick="VisPdfForhandsvisning"><Icon Name="file-text" />Lagre som PDF</button>
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker?
                            <button type="button" class="knapp knapp-fare" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="knapp" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="knapp knapp-fare" @onclick="@(() => _confirmingDelete = true)"><Icon Name="trash" />Slett befaring</button>
                    }
                </div>
            }
        </section>

        @if (Id.HasValue)
        {
            <section class="panel" id="lagrede-pdfer-seksjon">
                <div class="panel-header">
                    <span class="panel-ikon"><Icon Name="file-text" /></span>
                    <h2>Lagrede PDF-er</h2>
                </div>
                @if (_lagredePdfer.Count == 0)
                {
                    <p class="list-empty">Ingen PDF-er lagret ennå.</p>
                }
                else
                {
                    <ul class="vedlegg-list">
                        @foreach (var pdf in _lagredePdfer.OrderByDescending(p => p.OpprettetDato))
                        {
                            <li @key="pdf.Id" class="vedlegg-item">
                                <span class="vedlegg-ikon"><Icon Name="file-text" /></span>
                                <a href="@($"/befaringpdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                                <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="form-error">@_error</p>
    }

    @if (!string.IsNullOrEmpty(_savedMessage))
    {
        <p class="save-success">@_savedMessage</p>
    }

    <div class="bs-bunnlinje">
        @if (_steg > 1)
        {
            <button type="button" class="bs-bunnknapp" @onclick="@(() => _steg--)"><Icon Name="arrow-left" />Tilbake</button>
        }
        else
        {
            <a class="bs-bunnknapp" href="/befaringsliste"><Icon Name="arrow-left" />Avbryt</a>
        }

        @if (_steg < 4)
        {
            <button type="button" class="bs-bunnknapp bs-bunnknapp-primaer" @onclick="@(() => _steg++)">Neste<Icon Name="arrow-right" /></button>
        }
        else
        {
            <button type="button" class="bs-bunnknapp bs-bunnknapp-primaer" @onclick="SaveBefaring"><Icon Name="check" />@(Id.HasValue ? "Lagre endringer" : "Lagre befaring")</button>
        }
    </div>


    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av befaring" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreBefaringPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Befaring _form = new() { Navn = "" };
    private List<BefaringDorfelt> _dorfelt = [];
    private bool _notFound;
    private bool _confirmingDelete;

    // Veiviseren: ett steg om gangen i stedet for én lang side.
    private int _steg = 1;
    private bool _visToppmeny;

    private static readonly (int Nr, string Navn)[] Stegnavn =
    [
        (1, "Grunninformasjon"),
        (2, "Detaljer"),
        (3, "Dokumentasjon"),
        (4, "Oppsummering")
    ];
    private bool _harLastet;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;
    private readonly Dictionary<int, string?> _bildeFeil = [];
    private int? _uploadingDorfeltId;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private List<BefaringPdf> _lagredePdfer = [];
    private bool _lasterOppVedlegg;
    private string? _vedleggFeil;
    private readonly Dictionary<BefaringDorfelt, string> _aktivFane = [];

    private List<string> _kundeNavn = [];
    private List<string> _prosjektNavn = [];
    private List<string> _brukerNavn = [];
    private string? _innloggetNavn;
    private string? _opprettetAvNavn;

    // Kunde/Prosjekt/Befart av er fortsatt rene tekstfelt på Befaring (ingen
    // FK/skjemaendring - bevisst, se samtale 2026-10-08) - nedtrekkene her
    // fylles fra de ekte kunde-/prosjekt-/brukerregistrene for enkel, riktig
    // utfylling, men skriver fortsatt bare navnet som tekst. Den lagrede
    // verdien legges alltid til i listen (selv om den ikke lenger finnes i
    // registeret), slik at gamle frittekst-verdier ikke forsvinner fra
    // nedtrekket når man redigerer en eksisterende befaring.
    private List<string> KundeValg => MedEksisterendeVerdi(_kundeNavn, _form.Kundenavn);
    private List<string> ProsjektValg => MedEksisterendeVerdi(_prosjektNavn, _form.Bygg);
    private List<string> BefartAvValg => MedEksisterendeVerdi(_brukerNavn, _form.BefartAv);

    private static List<string> MedEksisterendeVerdi(List<string> kilde, string? gjeldende)
    {
        if (string.IsNullOrWhiteSpace(gjeldende) || kilde.Contains(gjeldende))
        {
            return kilde;
        }

        return [gjeldende, .. kilde];
    }

    // Dato lagres som ett DateTime?-felt (dato+klokkeslett sammen) - "Tidspunkt"
    // i grunninformasjonen er bare en egen inputrute for klokkeslett-delen av
    // samme felt, ikke en ny kolonne.
    private TimeOnly? Tidspunkt
    {
        get => _form.Dato is { } dato ? TimeOnly.FromDateTime(dato) : null;
        set
        {
            if (value is not { } klokkeslett)
            {
                return;
            }

            var dato = (_form.Dato ?? DateTime.Today).Date;
            _form.Dato = dato + klokkeslett.ToTimeSpan();
        }
    }

    private static readonly BefaringStatus[] StatusValg =
    [
        BefaringStatus.Planlagt,
        BefaringStatus.Gjennomfort,
        BefaringStatus.Avlyst
    ];

    private bool HarAdresse => !string.IsNullOrWhiteSpace(_form.Adresse) || !string.IsNullOrWhiteSpace(_form.Sted);

    private string AdresseTekst => string.Join(", ", new[] { _form.Adresse, _form.Postnr, _form.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // "Åpne i kart" lenker til et adressesøk i Google Maps - selve
    // Lokasjon-kortet viser nå et ekte, geokodet Leaflet-kart (se
    // GeokodLokasjonAsync/OnAfterRenderAsync), men denne eksterne lenken er
    // nyttig i tillegg for faktisk å starte navigasjon på mobil.
    private string LokasjonKartUrl => $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(AdresseTekst)}";

    private bool _geokodingFeilet;
    private bool _kartInitialisert;
    private string? _sistGeokodetAdresse;

    private async Task GeokodLokasjonAsync()
    {
        if (!HarAdresse)
        {
            _form.Latitude = null;
            _form.Longitude = null;
            _geokodingFeilet = false;
            _kartInitialisert = false;
            return;
        }

        if (AdresseTekst == _sistGeokodetAdresse)
        {
            return;
        }

        _sistGeokodetAdresse = AdresseTekst;
        var treff = await Geokoding.GeocodeAsync(_form.Adresse ?? "", _form.Postnr, _form.Sted);
        if (treff is null)
        {
            _form.Latitude = null;
            _form.Longitude = null;
            _geokodingFeilet = true;
            _kartInitialisert = false;
            return;
        }

        _geokodingFeilet = false;
        _form.Latitude = treff.Value.Latitude;
        _form.Longitude = treff.Value.Longitude;
        _kartInitialisert = false;
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(deler.Select(d => char.ToUpperInvariant(d[0])));
    }

    private string AktivFane(BefaringDorfelt d)
    {
        if (!_aktivFane.TryGetValue(d, out var fane))
        {
            fane = "id";
            _aktivFane[d] = fane;
        }

        return fane;
    }

    private void SettFane(BefaringDorfelt d, string fane) => _aktivFane[d] = fane;

    protected override async Task OnInitializedAsync()
    {
        _kundeNavn = await Db.Kunder.OrderBy(k => k.Navn).Select(k => k.Navn).ToListAsync();
        _prosjektNavn = await Db.Prosjekter.OrderBy(p => p.Navn).Select(p => p.Navn).ToListAsync();
        _brukerNavn = await Db.Brukere.Where(b => b.Aktiv).OrderBy(b => b.Navn).Select(b => b.Navn).ToListAsync();

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _innloggetNavn = state.User.Identity?.Name;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_kartInitialisert && _form.Latitude is not null && _form.Longitude is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("kart.init", "befaring-kart-visning", new[]
                {
                    new { lat = _form.Latitude.Value, lng = _form.Longitude.Value, tittel = _form.Navn, undertekst = AdresseTekst, pin = true }
                });
                _kartInitialisert = true;
            }
            catch (JSException)
            {
                // Elementet kan ha rukket å forsvinne igjen (f.eks. adressen ble tømt rett etter) - prøver på nytt neste render.
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_harLastet && _loadedId == Id)
        {
            return;
        }

        _harLastet = true;
        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;

        if (Id.HasValue)
        {
            await LoadBefaringAsync(Id.Value);
        }
        else
        {
            ResetForm();
        }
    }

    private async Task LoadBefaringAsync(int id)
    {
        var existing = await Db.Befaringer
            .Include(b => b.Dorfelt)
                .ThenInclude(d => d.Lassystemer)
            .Include(b => b.Dorfelt)
                .ThenInclude(d => d.Bilder)
            .Include(b => b.Vedlegg)
            .FirstOrDefaultAsync(b => b.Id == id);

        if (existing is null)
        {
            _notFound = true;
            return;
        }

        _form = existing;
        _dorfelt = existing.Dorfelt;
        _opprettetAvNavn = null;
        _kartInitialisert = false;
        _sistGeokodetAdresse = HarAdresse ? AdresseTekst : null;
        _vedleggFeil = null;

        _lagredePdfer = await Db.BefaringPdfer
            .Where(p => p.BefaringId == id)
            .ToListAsync();

        // Eldre befaringer kan ha adresse registrert fra før kartstøtten kom
        // (2026-10-08) og mangler dermed lagrede koordinater - geokoder dem
        // da automatisk ved åpning, på samme måte som når man skriver inn en
        // ny adresse.
        if (HarAdresse && (_form.Latitude is null || _form.Longitude is null))
        {
            _sistGeokodetAdresse = null;
            await GeokodLokasjonAsync();
        }
    }

    private void ResetForm()
    {
        _dorfelt = [];
        _form = new Befaring { Navn = "", Dorfelt = _dorfelt, BefartAv = _innloggetNavn };
        _opprettetAvNavn = _innloggetNavn;
        _kartInitialisert = false;
        _sistGeokodetAdresse = null;
        _geokodingFeilet = false;
    }

    private void AddDorfelt()
    {
        _dorfelt.Add(new BefaringDorfelt());
    }

    private async Task OnBilderSelected(BefaringDorfelt d, InputFileChangeEventArgs e)
    {
        if (d.Id == 0)
        {
            return;
        }

        _bildeFeil[d.Id] = null;
        _uploadingDorfeltId = d.Id;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (!file.ContentType.StartsWith("image/"))
                {
                    _bildeFeil[d.Id] = $"\"{file.Name}\" er ikke et bilde og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }
                buffer.Position = 0;

                byte[] jpegBytes;
                try
                {
                    jpegBytes = ResizeToJpeg(buffer);
                }
                catch
                {
                    _bildeFeil[d.Id] = $"Kunne ikke lese \"{file.Name}\" som bilde.";
                    continue;
                }

                var bilde = new BefaringDorfeltBilde
                {
                    BefaringDorfeltId = d.Id,
                    Filnavn = file.Name,
                    ContentType = "image/jpeg",
                    Data = jpegBytes
                };

                Db.BefaringDorfeltBilder.Add(bilde);
            }

            await Db.SaveChangesAsync();
        }
        finally
        {
            _uploadingDorfeltId = null;
        }
    }

    private async Task RemoveBilde(BefaringDorfelt d, BefaringDorfeltBilde bilde)
    {
        Db.BefaringDorfeltBilder.Remove(bilde);
        await Db.SaveChangesAsync();
        d.Bilder.Remove(bilde);
    }

    private async Task FokuserNotatfelt()
    {
        try
        {
            await JS.InvokeVoidAsync("bsScrollOgFokuser", "oppdrag-tekstfelt");
        }
        catch (JSException)
        {
            // Ikke kritisk - feltet finnes uansett lenger ned på siden.
        }
    }

    // Må være en vanlig knapp med JS-basert scroll, ikke en <a href="#id">-
    // ankerlenke - på en InteractiveServer-side fanger Blazor sin enhanced
    // navigation opp slike lenkeklikk og navigerer til "/" + fragmentet i
    // stedet for bare å scrolle på gjeldende side (oppdaget som reell bug
    // 2026-10-08, "Last opp bilder"/"Lagrede" sendte brukeren til forsiden).
    private async Task ScrollTil(string elementId)
    {
        try
        {
            await JS.InvokeVoidAsync("bsScrollOgFokuser", elementId);
        }
        catch (JSException)
        {
            // Ikke kritisk.
        }
    }

    private static readonly string[] TilltateVideoTyper = ["video/mp4", "video/quicktime", "video/webm"];

    private async Task OnVedleggValgt(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        _vedleggFeil = null;
        _lasterOppVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                var erBilde = file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                var erVideo = TilltateVideoTyper.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase);

                if (!erBilde && !erVideo)
                {
                    _vedleggFeil = $"\"{file.Name}\" er verken et støttet bilde- eller videoformat, og ble hoppet over.";
                    continue;
                }

                if (erBilde)
                {
                    using var buffer = new MemoryStream();
                    await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                    {
                        await stream.CopyToAsync(buffer);
                    }
                    buffer.Position = 0;

                    byte[] jpegBytes;
                    try
                    {
                        jpegBytes = ResizeToJpeg(buffer);
                    }
                    catch
                    {
                        _vedleggFeil = $"Kunne ikke lese \"{file.Name}\" som bilde.";
                        continue;
                    }

                    Db.BefaringVedlegg.Add(new BefaringVedlegg
                    {
                        BefaringId = Id.Value,
                        Filnavn = file.Name,
                        ContentType = "image/jpeg",
                        Data = jpegBytes
                    });
                }
                else
                {
                    // Video lagres uendret (ingen komprimering/omkoding tilgjengelig server-side)
                    // - 200 MB tak for å unngå at en enkelt opplasting blir urimelig stor.
                    const int maxVideoBytes = 200_000_000;
                    using var buffer = new MemoryStream();
                    await using (var stream = file.OpenReadStream(maxAllowedSize: maxVideoBytes))
                    {
                        await stream.CopyToAsync(buffer);
                    }

                    Db.BefaringVedlegg.Add(new BefaringVedlegg
                    {
                        BefaringId = Id.Value,
                        Filnavn = file.Name,
                        ContentType = file.ContentType,
                        Data = buffer.ToArray()
                    });
                }
            }

            await Db.SaveChangesAsync();

            _form.Vedlegg = await Db.BefaringVedlegg
                .Where(v => v.BefaringId == Id.Value)
                .OrderByDescending(v => v.OpprettetDato)
                .ToListAsync();
        }
        finally
        {
            _lasterOppVedlegg = false;
        }
    }

    private async Task RemoveVedlegg(BefaringVedlegg vedlegg)
    {
        Db.BefaringVedlegg.Remove(vedlegg);
        await Db.SaveChangesAsync();
        _form.Vedlegg.Remove(vedlegg);
    }

    private static byte[] ResizeToJpeg(Stream input, int maxDimension = 1600, int quality = 82)
    {
        using var original = SKBitmap.Decode(input) ?? throw new InvalidOperationException("Ugyldig bildeformat.");

        var longestSide = Math.Max(original.Width, original.Height);
        SKBitmap? resized = null;

        if (longestSide > maxDimension)
        {
            var scale = (double)maxDimension / longestSide;
            var width = Math.Max(1, (int)(original.Width * scale));
            var height = Math.Max(1, (int)(original.Height * scale));
            resized = original.Resize(new SKImageInfo(width, height), SKSamplingOptions.Default);
        }

        using var _ = resized;
        var bitmapToEncode = resized ?? original;

        using var image = SKImage.FromBitmap(bitmapToEncode);
        using var data = image.Encode(SKEncodedImageFormat.Jpeg, quality);
        return data.ToArray();
    }

    private async Task SaveBefaring()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Befaringen må ha et navn.";
            return;
        }

        _error = null;
        _form.Dorfelt = _dorfelt;

        if (!Id.HasValue)
        {
            Db.Befaringer.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Befaringen \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Befaringen \"{_form.Navn}\" er lagret.";
            ResetForm();
        }
    }

    private void VisPdfForhandsvisning()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/befaring/{Id.Value}/pdf";
    }

    private async Task LagreBefaringPdf()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(Id.Value);
        if (bytes is null)
        {
            return;
        }

        var pdf = new BefaringPdf
        {
            BefaringId = Id.Value,
            Navn = $"Befaring - {_form.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf",
            Data = bytes
        };

        Db.BefaringPdfer.Add(pdf);
        await Db.SaveChangesAsync();

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Befaringer.FirstOrDefaultAsync(b => b.Id == Id.Value);
        if (existing is not null)
        {
            Db.Befaringer.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/befaringsliste");
    }
}
