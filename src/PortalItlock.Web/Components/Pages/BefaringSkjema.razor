@page "/befaring/ny"
@page "/befaring/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using SkiaSharp
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject BefaringPdfService PdfService
@inject GeocodingService Geokoding
@inject IJSRuntime JS
@inject VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? "Rediger befaring" : "Ny befaring")</PageTitle>

@if (_notFound)
{
    <a class="back-link" href="/befaringsliste"><Icon Name="arrow-left" />Til befaringsliste</a>
    <p class="form-error">Fant ikke befaringen. Den kan være slettet.</p>
}
else
{
    @* C1 + H2 (befaring-forslag): alt i ett kort med faner. Dørene er en tabell
       med annenhver grå og hvit rad; trykker man på en dør åpner den seg under
       raden, med delene under hverandre. *@
    <div class="bs-side @(_full ? "bs-full" : "")">
    <div class="bs-kort">
        <div class="bs-topplinje">
            <a class="back-link bs-tilbake" href="/befaringsliste"><Icon Name="arrow-left" />Til befaringsliste</a>
            <button type="button" class="bs-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
        </div>

        <header class="bs-topp">
            <div class="bs-topp-tekst">
                <h1>@Tittel</h1>
                <p>@Undertekst</p>
            </div>
            <div class="bs-topp-hoyre">
                <span class="bs-status-velger-wrap">
                    <select class="bs-status-velger" aria-label="Status" @bind="_form.Status">
                        @foreach (var verdi in StatusValg)
                        {
                            <option value="@verdi">@verdi.Visningsnavn()</option>
                        }
                    </select>
                    <Icon Name="chevron-down" />
                </span>
                @if (Id.HasValue)
                {
                    <button type="button" class="bs-knapp" title="Lagre som PDF" @onclick="VisPdfForhandsvisning"><Icon Name="file-text" />PDF</button>
                }
                <button type="button" class="bs-knapp bs-knapp-primaer" @onclick="SaveBefaring"><Icon Name="check" />Lagre</button>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="form-error bs-melding">@_error</p>
        }
        @if (!string.IsNullOrEmpty(_savedMessage))
        {
            <p class="save-success bs-melding">@_savedMessage</p>
        }

        <div class="bs-faner" role="tablist">
            <button type="button" role="tab" aria-selected="@(_hovedFane == "oversikt" ? "true" : "false")" class="@(_hovedFane == "oversikt" ? "aktiv" : "")" @onclick='() => VelgHovedFane("oversikt")'>Oversikt</button>
            <button type="button" role="tab" aria-selected="@(_hovedFane == "dorer" ? "true" : "false")" class="@(_hovedFane == "dorer" ? "aktiv" : "")" @onclick='() => VelgHovedFane("dorer")'>Dørfelt <small>@_dorfelt.Count</small></button>
            <button type="button" role="tab" aria-selected="@(_hovedFane == "bilder" ? "true" : "false")" class="@(_hovedFane == "bilder" ? "aktiv" : "")" @onclick='() => VelgHovedFane("bilder")'><span>Bilder<span class="bs-mobil-skjul"> og video</span></span> <small>@_form.Vedlegg.Count</small></button>
            @if (Id.HasValue)
            {
                <button type="button" role="tab" aria-selected="@(_hovedFane == "pdf" ? "true" : "false")" class="@(_hovedFane == "pdf" ? "aktiv" : "")" @onclick='() => VelgHovedFane("pdf")'>PDF-er <small>@_lagredePdfer.Count</small></button>
            }
        </div>

        @if (_hovedFane == "oversikt")
        {
            <div class="bs-to">
                <div class="bs-kolonne">
                    <section class="bs-ramme" id="grunninformasjon-seksjon">
                        <div class="bs-hode">Grunninformasjon</div>
                        <div class="bs-inn">
            <div class="field-grid field-grid-2">
                <label>
                    Navn på befaring *
                    <input @bind="_form.Navn" @bind:event="oninput" placeholder="F.eks. Kvernaland omsorgsbolig - befaring" />
                </label>
                <label>
                    Kunde *
                    <select @bind="_form.Kundenavn">
                        <option value="">Velg kunde</option>
                        @foreach (var navn in KundeValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label class="span-2">
                    Prosjekt
                    <select @bind="_form.Bygg">
                        <option value="">Velg prosjekt (valgfritt)</option>
                        @foreach (var navn in ProsjektValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label>Dato *<input type="date" @bind="_form.Dato" /></label>
                <label>Tidspunkt *<input type="time" @bind="Tidspunkt" /></label>
                <label class="span-2">
                    Befart av *
                    <select @bind="_form.BefartAv">
                        <option value="">Velg</option>
                        @foreach (var navn in BefartAvValg)
                        {
                            <option value="@navn">@navn</option>
                        }
                    </select>
                </label>
                <label class="span-2 bs-adressefelt">
                    <span class="bs-adresse-merkelapp">Adresse</span>
                    <input @bind="_form.Adresse" @bind:after="GeokodLokasjonAsync" placeholder="Skriv adresse..." />
                </label>
            </div>
                        </div>
                    </section>

                    @* Resten av grunninformasjonen - mindre brukt, men må fortsatt kunne fylles ut. *@
                    <details class="bs-ramme bs-mer-felt">
                        <summary class="bs-hode">Flere opplysninger<em class="bs-vis">Vis</em><em class="bs-skjul">Skjul</em></summary>
                        <div class="bs-inn">
                <div class="field-grid field-grid-2">
                    <label>Postnr.<input @bind="_form.Postnr" @bind:after="GeokodLokasjonAsync" /></label>
                    <label>Sted<input @bind="_form.Sted" @bind:after="GeokodLokasjonAsync" /></label>
                    <label>Kontaktperson<input @bind="_form.Kontaktperson" /></label>
                    <label>Tlf./mobil<input @bind="_form.Tlf" /></label>
                    <label>E-post<input @bind="_form.Epost" /></label>
                    <label>System nr.<input @bind="_form.SystemNr" /></label>
                    <label class="span-2" id="oppdrag-felt">
                        Oppdrag / beskrivelse
                        <textarea id="oppdrag-tekstfelt" rows="2" maxlength="500" @bind="_form.Oppdrag" @bind:event="oninput" placeholder="Kort beskrivelse av befaringen, formål, spesielle forhold osv."></textarea>
                        <span class="bs-tegnteller">@((_form.Oppdrag?.Length ?? 0))/500</span>
                    </label>
                </div>
                        </div>
                    </details>
                </div>

                <div class="bs-kolonne">
        <div class="bs-kartkort">
            @if (_form.Latitude is not null && _form.Longitude is not null)
            {
                <div id="befaring-kart-visning" class="bs-kart-visning"></div>
            }
            else
            {
                <div class="bs-kart-placeholder"><Icon Name="map-pin" /></div>
            }
            @if (HarAdresse)
            {
                <a class="bs-kart-knapp" href="@LokasjonKartUrl" target="_blank" rel="noopener"><Icon Name="map-pin" />Åpne i kart</a>
            }
        </div>
        @if (_geokodingFeilet)
        {
            <p class="bs-kart-feil">Fant ikke posisjon for denne adressen.</p>
        }

                    <section class="bs-ramme">
                        <div class="bs-hode">Oversikt</div>
                        <div class="bs-kv"><span>Dørfelt</span><span>@_dorfelt.Count</span></div>
                        <div class="bs-kv"><span>Bilder og video</span><span>@_form.Vedlegg.Count</span></div>
                        <div class="bs-kv"><span>Opprettet</span><span>@(Id.HasValue ? _form.OpprettetDato.ToString("dd.MM.yyyy") : "–")</span></div>
                        <div class="bs-kv"><span>Opprettet av</span><span>@(string.IsNullOrWhiteSpace(_opprettetAvNavn) ? "–" : _opprettetAvNavn)</span></div>
                    </section>

                    @if (Id.HasValue)
                    {
                        <div class="bs-slett">
                            @if (_confirmingDelete)
                            {
                                <span>Slette befaringen?</span>
                                <button type="button" class="bs-knapp bs-knapp-liten bs-knapp-fare" @onclick="ConfirmDelete">Ja, slett</button>
                                <button type="button" class="bs-knapp bs-knapp-liten" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                            }
                            else
                            {
                                <button type="button" class="bs-slett-knapp" @onclick="@(() => _confirmingDelete = true)"><Icon Name="trash" />Slett befaring</button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (_hovedFane == "dorer")
        {
            <section id="dorfelt-seksjon">
                <div class="bs-lin">
                    <b>@_dorfelt.Count dørfelt</b>
                    <button type="button" class="bs-knapp bs-knapp-liten" @onclick="AddDorfelt"><Icon Name="plus" />Legg til dørfelt</button>
                </div>

                @if (_dorfelt.Count == 0)
                {
                    <p class="list-empty">Ingen dørfelt lagt til ennå.</p>
                }
                else
                {
                    <div class="bs-ramme">
                        <table class="bs-dorer">
                            <thead>
                                <tr>
                                    <th>Dør nr</th>
                                    <th>Dørnavn</th>
                                    <th class="bs-mobil-skjul">Type</th>
                                    <th class="bs-mobil-skjul">BxH</th>
                                    <th class="bs-mobil-skjul">Brann</th>
                                    <th>Utfylt</th>
                                    <th></th>
                                </tr>
                            </thead>
                            @foreach (var d in _dorfelt)
                            {
                                var utfylt = AntallDelerUtfylt(d);
                                <tbody @key="d">
                                    <tr class="bs-dorrad" @onclick="@(() => VekslDor(d))">
                                        <td><b>@(string.IsNullOrWhiteSpace(d.Dornr) ? "–" : d.Dornr)</b></td>
                                        <td><b>@(string.IsNullOrWhiteSpace(d.Dornavn) ? "Nytt dørfelt" : d.Dornavn)</b></td>
                                        <td class="bs-mobil-skjul">@(string.IsNullOrWhiteSpace(d.Dortype) ? "–" : d.Dortype)</td>
                                        <td class="bs-mobil-skjul">@(string.IsNullOrWhiteSpace(d.BxH) ? "–" : d.BxH)</td>
                                        <td class="bs-mobil-skjul">@BrannTekst(d)</td>
                                        <td>
                                            <span class="bs-utfylt" title="@utfylt av 5 deler er fylt ut">
                                                @for (var i = 0; i < 5; i++)
                                                {
                                                    <i class="@(i < utfylt ? "fylt" : "")"></i>
                                                }
                                                <small>@utfylt av 5</small>
                                            </span>
                                        </td>
                                        <td class="bs-pil">
                                            <button type="button" aria-expanded="@(_apenDor == d ? "true" : "false")" aria-label="@(_apenDor == d ? "Lukk dørfelt" : "Åpne dørfelt")" @onclick="@(() => VekslDor(d))" @onclick:stopPropagation="true"><Icon Name="@(_apenDor == d ? "chevron-down" : "chevron-right")" /></button>
                                        </td>
                                    </tr>
                                    @if (_apenDor == d)
                                    {
                                        <tr class="bs-dor-apen">
                                            <td colspan="7">
                                                <div class="bs-seksjoner">
                                        <div class="bs-seksjon">
                                            <button type="button" class="bs-seksjon-hode" aria-expanded="@(DelApen(d, "id") ? "true" : "false")" @onclick='() => VekslDel(d, "id")'>
                                                <span>Identifikasjon</span><em>@(DelApen(d, "id") ? "Skjul" : "Vis")</em>
                                            </button>
                                            @if (DelApen(d, "id"))
                                            {
                                                <div class="bs-seksjon-inn">
                        <div class="field-grid">
                            <label>Dør nr<input @bind="d.Dornr" /></label>
                            <label>Dørnavn<input @bind="d.Dornavn" @bind:event="oninput" /></label>
                            <label>
                                Dørtype
                                <select @bind="d.Dortype">
                                    <option value="">Velg</option>
                                    <option value="Tre">Tre</option>
                                    <option value="Stål">Stål</option>
                                    <option value="Alu">Alu</option>
                                </select>
                            </label>
                            <label>
                                Fløyer
                                <select @bind="d.Floyer">
                                    <option value="">Velg</option>
                                    <option value="Enfløyet">Enfløyet</option>
                                    <option value="Tofløyet">Tofløyet</option>
                                    <option value="B gangdør">B gangdør</option>
                                </select>
                            </label>
                            <label>BxH<input @bind="d.BxH" /></label>
                            <label>
                                Slagretning
                                <select @bind="d.Slagretning">
                                    <option value="">Velg</option>
                                    <option value="Høyre">Høyre</option>
                                    <option value="Venstre">Venstre</option>
                                </select>
                            </label>
                            <label>Låssystemnr<input @bind="d.Lassystemnr" /></label>
                        </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="bs-seksjon">
                                            <button type="button" class="bs-seksjon-hode" aria-expanded="@(DelApen(d, "krav") ? "true" : "false")" @onclick='() => VekslDel(d, "krav")'>
                                                <span>Krav</span><em>@(DelApen(d, "krav") ? "Skjul" : "Vis")</em>
                                            </button>
                                            @if (DelApen(d, "krav"))
                                            {
                                                <div class="bs-seksjon-inn">
                        <div class="field-grid">
                            <label>
                                Brannkrav
                                <select @bind="d.Brannkrav">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                            <label>Brannklasse<input @bind="d.Brannklasse" @bind:event="oninput" placeholder="F.eks. B1, EI30" /></label>
                            <label>FG/Beskytteklasse<input @bind="d.Fg" @bind:event="oninput" /></label>
                            <label>Sikringsklasse<input @bind="d.Sikringsklasse" @bind:event="oninput" /></label>
                            <label>Risikoklasse<input @bind="d.Risikoklasse" /></label>
                            <label>
                                Universell utforming
                                <select @bind="d.UniversellUtforming">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                            <label>
                                Åpnekraft maks 30N
                                <select @bind="d.ApnekraftMaks30N">
                                    <option value="">Velg</option>
                                    <option value="Ja">Ja</option>
                                    <option value="Nei">Nei</option>
                                </select>
                            </label>
                        </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="bs-seksjon">
                                            <button type="button" class="bs-seksjon-hode" aria-expanded="@(DelApen(d, "laser") ? "true" : "false")" @onclick='() => VekslDel(d, "laser")'>
                                                <span>Låser</span><em>@(DelApen(d, "laser") ? "Skjul" : "Vis")</em>
                                            </button>
                                            @if (DelApen(d, "laser"))
                                            {
                                                <div class="bs-seksjon-inn">
                        <div class="laser-2col">
                            <div class="skjema-seksjon">
                                <p class="skjema-seksjon-tittel">Daglås</p>
                                <LassystemFields Data="d.Daglas" OnEndret="StateHasChanged" />
                            </div>
                            <div class="skjema-seksjon">
                                <p class="skjema-seksjon-tittel">Nattlås</p>
                                <LassystemFields Data="d.Nattlas" OnEndret="StateHasChanged" />
                            </div>
                        </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="bs-seksjon">
                                            <button type="button" class="bs-seksjon-hode" aria-expanded="@(DelApen(d, "auto") ? "true" : "false")" @onclick='() => VekslDel(d, "auto")'>
                                                <span>Dørlukker og automatikk</span><em>@(DelApen(d, "auto") ? "Skjul" : "Vis")</em>
                                            </button>
                                            @if (DelApen(d, "auto"))
                                            {
                                                <div class="bs-seksjon-inn">
                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Dørlukker</p>
                        <div class="field-grid">
                            <label>Dørlukker<input @bind="d.Dorlukker" /></label>
                            <label>Arm/Glideskinne<input @bind="d.ArmGlideskinne" /></label>
                            <label>VK/plate<input @bind="d.VkPlate" /></label>
                            <label>
                                Montasje side
                                <select @bind="d.MontasjeSideDorlukker">
                                    <option value="">Velg</option>
                                    <option value="HS">HS</option>
                                    <option value="KS">KS</option>
                                </select>
                            </label>
                            <label>Annet utstyr<input @bind="d.AnnetUtstyrDorlukker" /></label>
                        </div>
                        </div>

                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Automatikk</p>
                        <div class="field-grid">
                            <label>Automatikk<input @bind="d.Automatikk" /></label>
                            <label>Trekk/skyv.arm<input @bind="d.TrekkSkyvArm" /></label>
                            <label>Adapter<input @bind="d.Adapter" /></label>
                            <label>
                                Montasje side
                                <select @bind="d.MontasjeSideAutomatikk">
                                    <option value="">Velg</option>
                                    <option value="HS">HS</option>
                                    <option value="KS">KS</option>
                                </select>
                            </label>
                            <label>Albuekontakter<input @bind="d.Albuekontakter" /></label>
                            <label>Radar/Sensor<input @bind="d.RadarSensor" /></label>
                            <label>Kabel<input @bind="d.KabelAutomatikk" /></label>
                            <label>UPS/Nødstrøm<input @bind="d.UpsNodstrom" /></label>
                            <label>Sikkerhetssensor<input @bind="d.Sikkerhetssensor" /></label>
                        </div>
                        </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="bs-seksjon">
                                            <button type="button" class="bs-seksjon-hode" aria-expanded="@(DelApen(d, "ovrig") ? "true" : "false")" @onclick='() => VekslDel(d, "ovrig")'>
                                                <span>Øvrig og bilder</span><em>@(DelApen(d, "ovrig") ? "Skjul" : "Vis")</em>
                                            </button>
                                            @if (DelApen(d, "ovrig"))
                                            {
                                                <div class="bs-seksjon-inn">
                        <div class="skjema-seksjon">
                        <p class="skjema-seksjon-tittel">Øvrig beslag</p>
                        <div class="field-grid">
                            <label>Magnetlås<input @bind="d.Magnetlas" /></label>
                            <label>Brakett til ML<input @bind="d.BrakettMl" /></label>
                            <label>Panikkb./skåte<input @bind="d.Panikkbeslag" /></label>
                            <label>Håndtak<input @bind="d.Handtak" /></label>
                            <label>Annet utstyr<input @bind="d.AnnetUtstyrOvrig" /></label>
                        </div>
                        </div>

                        <label class="notes-field">
                            Anm./notater
                            <textarea rows="3" @bind="d.Notater" @bind:event="oninput"></textarea>
                        </label>

                        <div class="skjema-seksjon">
                            <p class="skjema-seksjon-tittel">Bilder</p>
                            @if (d.Id == 0)
                            {
                                <p class="bilder-hint">Lagre befaringen først for å kunne legge til bilder.</p>
                            }
                            else
                            {
                                @if (d.Bilder.Count > 0)
                                {
                                    <div class="bilder-grid">
                                        @foreach (var bilde in d.Bilder)
                                        {
                                            <div class="bilde-thumb">
                                                <img src="@($"/bilder/{bilde.Id}")" alt="@bilde.Filnavn" />
                                                <button type="button" class="bilde-remove" title="Fjern bilde" @onclick="@(() => RemoveBilde(d, bilde))">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                                <label class="dropzone">
                                    <span class="dropzone-ikon"><Icon Name="upload" /></span>
                                    <span class="dropzone-tekst">
                                        <strong>Legg til bilder</strong>
                                        <span>Dra og slipp, eller trykk for å velge</span>
                                    </span>
                                    <InputFile OnChange="@((e) => OnBilderSelected(d, e))" multiple accept="image/*" capture="environment" />
                                </label>
                                @if (_uploadingDorfeltId == d.Id)
                                {
                                    <p class="bilder-hint">Laster opp...</p>
                                }
                                @if (_bildeFeil.TryGetValue(d.Id, out var bildeFeilmelding) && !string.IsNullOrEmpty(bildeFeilmelding))
                                {
                                    <p class="form-error">@bildeFeilmelding</p>
                                }
                            }
                        </div>
                                                </div>
                                            }
                                        </div>
                                                </div>
                                                <button type="button" class="bs-fjern" @onclick="@(() => FjernDor(d))"><Icon Name="trash" />Fjern dørfelt</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                }
            </section>
        }
        else if (_hovedFane == "bilder")
        {
            <section id="vedlegg-seksjon">
                @if (!Id.HasValue)
                {
                    <p class="bilder-hint">Lagre befaringen først for å kunne laste opp bilder/video.</p>
                }
                else
                {
                    @if (_form.Vedlegg.Count > 0)
                    {
                        <div class="bs-lin">
                            <b>@VedleggTekst</b>
                            <label class="bs-knapp bs-knapp-liten bs-knapp-primaer bs-filknapp">
                                <Icon Name="plus" />Legg til bilder eller video
                                <InputFile OnChange="OnVedleggValgt" multiple accept="image/*,video/*" capture="environment" />
                            </label>
                        </div>

                        <div class="bs-media">
                            @foreach (var v in _form.Vedlegg.OrderByDescending(v => v.OpprettetDato))
                            {
                                <div class="bs-media-kort" @key="v.Id">
                                    <button type="button" class="bs-media-bilde" aria-label="@($"Vis {v.Filnavn}")" @onclick="@(() => _visVedlegg = v)">
                                        @if (v.ErVideo)
                                        {
                                            <video src="@($"/befaringvedlegg/{v.Id}")" preload="metadata" muted></video>
                                            <span class="bs-media-spill"><Icon Name="play" /></span>
                                        }
                                        else
                                        {
                                            <img src="@($"/befaringvedlegg/{v.Id}")" alt="@v.Filnavn" loading="lazy" />
                                        }
                                    </button>
                                    <button type="button" class="bilde-remove" title="Fjern" aria-label="@($"Fjern {v.Filnavn}")" @onclick="@(() => RemoveVedlegg(v))">×</button>
                                    <div class="bs-media-tekst">
                                        <b title="@v.Filnavn">@v.Filnavn</b>
                                        <small>@v.OpprettetDato.ToString("dd.MM.yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <label class="dropzone bs-media-tom" id="vedlegg-dropzone">
                            <span class="dropzone-ikon"><Icon Name="upload" /></span>
                            <span class="dropzone-tekst">
                                <strong>Ingen bilder eller video ennå</strong>
                                <span>Dra filer hit, eller trykk for å velge</span>
                            </span>
                            <InputFile OnChange="OnVedleggValgt" multiple accept="image/*,video/*" capture="environment" />
                        </label>
                    }

                    @if (_lasterOppVedlegg)
                    {
                        <p class="bilder-hint">Laster opp...</p>
                    }
                    @if (!string.IsNullOrEmpty(_vedleggFeil))
                    {
                        <p class="form-error">@_vedleggFeil</p>
                    }
                }
            </section>
        }
        else if (_hovedFane == "pdf" && Id.HasValue)
        {
            <section id="lagrede-pdfer-seksjon">
                @if (_lagredePdfer.Count == 0)
                {
                    <div class="bs-tom">
                        <span class="dropzone-ikon"><Icon Name="file-text" /></span>
                        <b>Ingen PDF-er ennå</b>
                        <span>Lag en PDF når befaringen er ferdig utfylt</span>
                        <button type="button" class="bs-knapp bs-knapp-liten bs-knapp-primaer" @onclick="VisPdfForhandsvisning"><Icon Name="plus" />Lag ny PDF</button>
                    </div>
                }
                else
                {
                    var nyesteId = _lagredePdfer.MaxBy(p => p.OpprettetDato)?.Id;
                    <div class="bs-lin">
                        <b>@(_lagredePdfer.Count == 1 ? "1 PDF" : $"{_lagredePdfer.Count} PDF-er")</b>
                        <button type="button" class="bs-knapp bs-knapp-liten bs-knapp-primaer" @onclick="VisPdfForhandsvisning"><Icon Name="plus" />Lag ny PDF</button>
                    </div>

                    <div class="bs-ramme">
                        <table class="bs-dorer bs-pdfer">
                            <thead>
                                <tr>
                                    <th>Navn</th>
                                    <th>Laget</th>
                                    <th class="bs-mobil-skjul">Klokka</th>
                                    <th class="bs-mobil-skjul">Størrelse</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pdf in _lagredePdfer.OrderByDescending(p => p.OpprettetDato))
                                {
                                    <tr @key="pdf.Id">
                                        <td>
                                            <b>@PdfVisningsnavn(pdf)</b>
                                            @if (pdf.Id == nyesteId)
                                            {
                                                <span class="bs-nyeste">Nyeste</span>
                                            }
                                        </td>
                                        <td>@pdf.OpprettetDato.ToString("dd.MM.yyyy")</td>
                                        <td class="bs-mobil-skjul">@pdf.OpprettetDato.ToString("HH:mm")</td>
                                        <td class="bs-mobil-skjul">@PdfStorrelse(pdf)</td>
                                        <td class="bs-pdf-valg">
                                            @if (_bekreftPdfId == pdf.Id)
                                            {
                                                <span class="bs-pdf-bekreft">
                                                    Fjerne PDF-en?
                                                    <button type="button" class="bs-knapp bs-knapp-liten bs-knapp-fare" @onclick="@(() => FjernPdf(pdf))">Ja, fjern</button>
                                                    <button type="button" class="bs-knapp bs-knapp-liten" @onclick="@(() => _bekreftPdfId = null)">Avbryt</button>
                                                </span>
                                            }
                                            else
                                            {
                                                <a href="@($"/befaringpdf/{pdf.Id}?visning=true")" target="_blank" rel="noopener" title="Åpne" aria-label="Åpne"><Icon Name="eye" /></a>
                                                <a href="@($"/befaringpdf/{pdf.Id}")" download="@pdf.Navn" title="Last ned" aria-label="Last ned"><Icon Name="download" /></a>
                                                <button type="button" title="Fjern" aria-label="Fjern" @onclick="@(() => _bekreftPdfId = pdf.Id)"><Icon Name="trash" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
    </div>

    @if (_visVedlegg is { } vis)
    {
        <div class="bs-lys" role="dialog" aria-modal="true" aria-label="@vis.Filnavn" @onclick="@(() => _visVedlegg = null)">
            <div class="bs-lys-kort" @onclick:stopPropagation="true">
                <div class="bs-lys-topp">
                    <b>@vis.Filnavn</b>
                    <small>@vis.OpprettetDato.ToString("dd.MM.yyyy")</small>
                    <button type="button" class="bs-knapp bs-knapp-liten" @onclick="@(() => _visVedlegg = null)">Lukk</button>
                </div>
                @if (vis.ErVideo)
                {
                    <video src="@($"/befaringvedlegg/{vis.Id}")" controls autoplay></video>
                }
                else
                {
                    <img src="@($"/befaringvedlegg/{vis.Id}")" alt="@vis.Filnavn" />
                }
            </div>
        </div>
    }

    <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="Forhåndsvisning av befaring" SaveMessage="@_pdfSavedMessage"
                      OnSave="LagreBefaringPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
}

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Befaring _form = new() { Navn = "" };
    private List<BefaringDorfelt> _dorfelt = [];
    private bool _notFound;
    private bool _confirmingDelete;

    // C1: fanene øverst. Feltene ligger i _form/_dorfelt, så ingenting går tapt ved fanebytte.
    private string _hovedFane = "oversikt";
    private bool _full;

    // H2: én dør åpen om gangen, og hvilke deler som er åpne på hver dør.
    private BefaringDorfelt? _apenDor;
    private readonly Dictionary<BefaringDorfelt, HashSet<string>> _apneDeler = [];

    private string Tittel => !string.IsNullOrWhiteSpace(_form.Navn) ? _form.Navn : Id.HasValue ? "Befaring" : "Ny befaring";

    private string Undertekst => string.Join(" · ", new[]
    {
        Id.HasValue ? $"BEF-{Id.Value:0000}" : "Ny registrering",
        _form.Kundenavn,
        HarAdresse ? AdresseTekst : null
    }.Where(t => !string.IsNullOrWhiteSpace(t)));

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("befaring-bredde", _full ? "full" : "normal");
    }

    private void VelgHovedFane(string fane)
    {
        if (fane == _hovedFane)
        {
            return;
        }

        _hovedFane = fane;
        _savedMessage = null;
        _confirmingDelete = false;

        // Kartet tegnes på nytt når Oversikt vises igjen.
        _kartInitialisert = false;
    }

    private void VekslDor(BefaringDorfelt d) => _apenDor = _apenDor == d ? null : d;

    private HashSet<string> ApneDeler(BefaringDorfelt d)
    {
        if (!_apneDeler.TryGetValue(d, out var deler))
        {
            deler = ["id", "krav"];
            _apneDeler[d] = deler;
        }

        return deler;
    }

    private bool DelApen(BefaringDorfelt d, string del) => ApneDeler(d).Contains(del);

    private void VekslDel(BefaringDorfelt d, string del)
    {
        var deler = ApneDeler(d);
        if (!deler.Remove(del))
        {
            deler.Add(del);
        }
    }

    private void FjernDor(BefaringDorfelt d)
    {
        _dorfelt.Remove(d);
        _apneDeler.Remove(d);
        if (_apenDor == d)
        {
            _apenDor = null;
        }
    }

    private static string BrannTekst(BefaringDorfelt d)
    {
        if (!string.IsNullOrWhiteSpace(d.Brannklasse))
        {
            return d.Brannklasse;
        }

        return string.IsNullOrWhiteSpace(d.Brannkrav) ? "–" : d.Brannkrav;
    }

    // En del teller som utfylt når minst ett felt i den er fylt ut.
    private static int AntallDelerUtfylt(BefaringDorfelt d)
    {
        bool[] deler =
        [
            NoeUtfylt(d.Dornr, d.Dornavn, d.Dortype, d.Floyer, d.BxH, d.Slagretning, d.Lassystemnr),
            NoeUtfylt(d.Brannkrav, d.Brannklasse, d.Fg, d.Sikringsklasse, d.Risikoklasse, d.UniversellUtforming, d.ApnekraftMaks30N),
            // Lassystemer direkte: d.Daglas/d.Nattlas oppretter raden om den mangler.
            d.Lassystemer.Any(LasUtfylt),
            NoeUtfylt(d.Dorlukker, d.ArmGlideskinne, d.VkPlate, d.MontasjeSideDorlukker, d.AnnetUtstyrDorlukker,
                d.Automatikk, d.TrekkSkyvArm, d.Adapter, d.MontasjeSideAutomatikk, d.Albuekontakter, d.RadarSensor,
                d.KabelAutomatikk, d.UpsNodstrom, d.Sikkerhetssensor),
            d.Bilder.Count > 0 || NoeUtfylt(d.Magnetlas, d.BrakettMl, d.Panikkbeslag, d.Handtak, d.AnnetUtstyrOvrig, d.Notater)
        ];

        return deler.Count(utfylt => utfylt);
    }

    private static bool LasUtfylt(BefaringLassystem l) => NoeUtfylt(
        l.Laskasse, l.MekSluttstykke, l.Mikrobryter, l.ElSluttstykke, l.Stolpe, l.Volt, l.Karmoverforing, l.Festelepper,
        l.Kabel, l.Dorvrider, l.Skilt, l.Overflate, l.Sylinder, l.DortykkelseAB, l.Magnetkontakt, l.Nodutstyr, l.AnnetUtstyr);

    private static bool NoeUtfylt(params string?[] felt) => felt.Any(f => !string.IsNullOrWhiteSpace(f));

    private bool _harLastet;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;
    private readonly Dictionary<int, string?> _bildeFeil = [];
    private int? _uploadingDorfeltId;
    private string? _pdfPreviewUrl;
    private string? _pdfSavedMessage;
    private List<BefaringPdf> _lagredePdfer = [];
    private bool _lasterOppVedlegg;
    private BefaringVedlegg? _visVedlegg;
    private int? _bekreftPdfId;
    private string? _vedleggFeil;

    private List<string> _kundeNavn = [];
    private List<string> _prosjektNavn = [];
    private List<string> _brukerNavn = [];
    private string? _innloggetNavn;
    private string? _opprettetAvNavn;

    // Kunde/Prosjekt/Befart av er fortsatt rene tekstfelt på Befaring (ingen
    // FK/skjemaendring - bevisst, se samtale 2026-10-08) - nedtrekkene her
    // fylles fra de ekte kunde-/prosjekt-/brukerregistrene for enkel, riktig
    // utfylling, men skriver fortsatt bare navnet som tekst. Den lagrede
    // verdien legges alltid til i listen (selv om den ikke lenger finnes i
    // registeret), slik at gamle frittekst-verdier ikke forsvinner fra
    // nedtrekket når man redigerer en eksisterende befaring.
    private List<string> KundeValg => MedEksisterendeVerdi(_kundeNavn, _form.Kundenavn);
    private List<string> ProsjektValg => MedEksisterendeVerdi(_prosjektNavn, _form.Bygg);
    private List<string> BefartAvValg => MedEksisterendeVerdi(_brukerNavn, _form.BefartAv);

    private static List<string> MedEksisterendeVerdi(List<string> kilde, string? gjeldende)
    {
        if (string.IsNullOrWhiteSpace(gjeldende) || kilde.Contains(gjeldende))
        {
            return kilde;
        }

        return [gjeldende, .. kilde];
    }

    // Dato lagres som ett DateTime?-felt (dato+klokkeslett sammen) - "Tidspunkt"
    // i grunninformasjonen er bare en egen inputrute for klokkeslett-delen av
    // samme felt, ikke en ny kolonne.
    private TimeOnly? Tidspunkt
    {
        get => _form.Dato is { } dato ? TimeOnly.FromDateTime(dato) : null;
        set
        {
            if (value is not { } klokkeslett)
            {
                return;
            }

            var dato = (_form.Dato ?? DateTime.Today).Date;
            _form.Dato = dato + klokkeslett.ToTimeSpan();
        }
    }

    private static readonly BefaringStatus[] StatusValg =
    [
        BefaringStatus.Planlagt,
        BefaringStatus.Gjennomfort,
        BefaringStatus.Avlyst
    ];

    private string VedleggTekst
    {
        get
        {
            var videoer = _form.Vedlegg.Count(v => v.ErVideo);
            var bilder = _form.Vedlegg.Count - videoer;
            var deler = new List<string>();
            if (bilder > 0)
            {
                deler.Add(bilder == 1 ? "1 bilde" : $"{bilder} bilder");
            }

            if (videoer > 0)
            {
                deler.Add(videoer == 1 ? "1 video" : $"{videoer} videoer");
            }

            return string.Join(" og ", deler);
        }
    }

    private bool HarAdresse => !string.IsNullOrWhiteSpace(_form.Adresse) || !string.IsNullOrWhiteSpace(_form.Sted);

    private string AdresseTekst => string.Join(", ", new[] { _form.Adresse, _form.Postnr, _form.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // "Åpne i kart" lenker til et adressesøk i Google Maps - selve
    // Lokasjon-kortet viser nå et ekte, geokodet Leaflet-kart (se
    // GeokodLokasjonAsync/OnAfterRenderAsync), men denne eksterne lenken er
    // nyttig i tillegg for faktisk å starte navigasjon på mobil.
    private string LokasjonKartUrl => $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(AdresseTekst)}";

    private bool _geokodingFeilet;
    private bool _kartInitialisert;
    private string? _sistGeokodetAdresse;

    private async Task GeokodLokasjonAsync()
    {
        if (!HarAdresse)
        {
            _form.Latitude = null;
            _form.Longitude = null;
            _geokodingFeilet = false;
            _kartInitialisert = false;
            return;
        }

        if (AdresseTekst == _sistGeokodetAdresse)
        {
            return;
        }

        _sistGeokodetAdresse = AdresseTekst;
        var treff = await Geokoding.GeocodeAsync(_form.Adresse ?? "", _form.Postnr, _form.Sted);
        if (treff is null)
        {
            _form.Latitude = null;
            _form.Longitude = null;
            _geokodingFeilet = true;
            _kartInitialisert = false;
            return;
        }

        _geokodingFeilet = false;
        _form.Latitude = treff.Value.Latitude;
        _form.Longitude = treff.Value.Longitude;
        _kartInitialisert = false;
    }

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(deler.Select(d => char.ToUpperInvariant(d[0])));
    }

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("befaring-bredde", "normal") == "full";
        _kundeNavn = await Db.Kunder.OrderBy(k => k.Navn).Select(k => k.Navn).ToListAsync();
        _prosjektNavn = await Db.Prosjekter.OrderBy(p => p.Navn).Select(p => p.Navn).ToListAsync();
        _brukerNavn = await Db.Brukere.Where(b => b.Aktiv).OrderBy(b => b.Navn).Select(b => b.Navn).ToListAsync();

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _innloggetNavn = state.User.Identity?.Name;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Kartet finnes bare på Oversikt-fanen.
        if (_hovedFane == "oversikt" && !_kartInitialisert && _form.Latitude is not null && _form.Longitude is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("kart.init", "befaring-kart-visning", new[]
                {
                    new { lat = _form.Latitude.Value, lng = _form.Longitude.Value, tittel = _form.Navn, undertekst = AdresseTekst, pin = true }
                });
                _kartInitialisert = true;
            }
            catch (JSException)
            {
                // Elementet kan ha rukket å forsvinne igjen (f.eks. adressen ble tømt rett etter) - prøver på nytt neste render.
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_harLastet && _loadedId == Id)
        {
            return;
        }

        _harLastet = true;
        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;
        _hovedFane = "oversikt";
        _apenDor = null;
        _apneDeler.Clear();

        if (Id.HasValue)
        {
            await LoadBefaringAsync(Id.Value);
        }
        else
        {
            ResetForm();
        }
    }

    private async Task LoadBefaringAsync(int id)
    {
        var existing = await Db.Befaringer
            .Include(b => b.Dorfelt)
                .ThenInclude(d => d.Lassystemer)
            .Include(b => b.Dorfelt)
                .ThenInclude(d => d.Bilder)
            .Include(b => b.Vedlegg)
            .FirstOrDefaultAsync(b => b.Id == id);

        if (existing is null)
        {
            _notFound = true;
            return;
        }

        _form = existing;
        _dorfelt = existing.Dorfelt;
        _opprettetAvNavn = null;
        _kartInitialisert = false;
        _sistGeokodetAdresse = HarAdresse ? AdresseTekst : null;
        _vedleggFeil = null;

        _lagredePdfer = await Db.BefaringPdfer
            .Where(p => p.BefaringId == id)
            .ToListAsync();

        // Eldre befaringer kan ha adresse registrert fra før kartstøtten kom
        // (2026-10-08) og mangler dermed lagrede koordinater - geokoder dem
        // da automatisk ved åpning, på samme måte som når man skriver inn en
        // ny adresse.
        if (HarAdresse && (_form.Latitude is null || _form.Longitude is null))
        {
            _sistGeokodetAdresse = null;
            await GeokodLokasjonAsync();
        }
    }

    private void ResetForm()
    {
        _dorfelt = [];
        _form = new Befaring { Navn = "", Dorfelt = _dorfelt, BefartAv = _innloggetNavn };
        _hovedFane = "oversikt";
        _apenDor = null;
        _apneDeler.Clear();
        _opprettetAvNavn = _innloggetNavn;
        _kartInitialisert = false;
        _sistGeokodetAdresse = null;
        _geokodingFeilet = false;
    }

    private void AddDorfelt()
    {
        var dor = new BefaringDorfelt();
        _dorfelt.Add(dor);
        _apenDor = dor;
    }

    private async Task OnBilderSelected(BefaringDorfelt d, InputFileChangeEventArgs e)
    {
        if (d.Id == 0)
        {
            return;
        }

        _bildeFeil[d.Id] = null;
        _uploadingDorfeltId = d.Id;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (!file.ContentType.StartsWith("image/"))
                {
                    _bildeFeil[d.Id] = $"\"{file.Name}\" er ikke et bilde og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }
                buffer.Position = 0;

                byte[] jpegBytes;
                try
                {
                    jpegBytes = ResizeToJpeg(buffer);
                }
                catch
                {
                    _bildeFeil[d.Id] = $"Kunne ikke lese \"{file.Name}\" som bilde.";
                    continue;
                }

                var bilde = new BefaringDorfeltBilde
                {
                    BefaringDorfeltId = d.Id,
                    Filnavn = file.Name,
                    ContentType = "image/jpeg",
                    Data = jpegBytes
                };

                Db.BefaringDorfeltBilder.Add(bilde);
            }

            await Db.SaveChangesAsync();
        }
        finally
        {
            _uploadingDorfeltId = null;
        }
    }

    private async Task RemoveBilde(BefaringDorfelt d, BefaringDorfeltBilde bilde)
    {
        Db.BefaringDorfeltBilder.Remove(bilde);
        await Db.SaveChangesAsync();
        d.Bilder.Remove(bilde);
    }

    private static readonly string[] TilltateVideoTyper = ["video/mp4", "video/quicktime", "video/webm"];

    private async Task OnVedleggValgt(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        _vedleggFeil = null;
        _lasterOppVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                var erBilde = file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                var erVideo = TilltateVideoTyper.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase);

                if (!erBilde && !erVideo)
                {
                    _vedleggFeil = $"\"{file.Name}\" er verken et støttet bilde- eller videoformat, og ble hoppet over.";
                    continue;
                }

                if (erBilde)
                {
                    using var buffer = new MemoryStream();
                    await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                    {
                        await stream.CopyToAsync(buffer);
                    }
                    buffer.Position = 0;

                    byte[] jpegBytes;
                    try
                    {
                        jpegBytes = ResizeToJpeg(buffer);
                    }
                    catch
                    {
                        _vedleggFeil = $"Kunne ikke lese \"{file.Name}\" som bilde.";
                        continue;
                    }

                    Db.BefaringVedlegg.Add(new BefaringVedlegg
                    {
                        BefaringId = Id.Value,
                        Filnavn = file.Name,
                        ContentType = "image/jpeg",
                        Data = jpegBytes
                    });
                }
                else
                {
                    // Video lagres uendret (ingen komprimering/omkoding tilgjengelig server-side)
                    // - 200 MB tak for å unngå at en enkelt opplasting blir urimelig stor.
                    const int maxVideoBytes = 200_000_000;
                    using var buffer = new MemoryStream();
                    await using (var stream = file.OpenReadStream(maxAllowedSize: maxVideoBytes))
                    {
                        await stream.CopyToAsync(buffer);
                    }

                    Db.BefaringVedlegg.Add(new BefaringVedlegg
                    {
                        BefaringId = Id.Value,
                        Filnavn = file.Name,
                        ContentType = file.ContentType,
                        Data = buffer.ToArray()
                    });
                }
            }

            await Db.SaveChangesAsync();

            _form.Vedlegg = await Db.BefaringVedlegg
                .Where(v => v.BefaringId == Id.Value)
                .OrderByDescending(v => v.OpprettetDato)
                .ToListAsync();
        }
        finally
        {
            _lasterOppVedlegg = false;
        }
    }

    private async Task RemoveVedlegg(BefaringVedlegg vedlegg)
    {
        Db.BefaringVedlegg.Remove(vedlegg);
        await Db.SaveChangesAsync();
        _form.Vedlegg.Remove(vedlegg);
    }

    private static byte[] ResizeToJpeg(Stream input, int maxDimension = 1600, int quality = 82)
    {
        using var original = SKBitmap.Decode(input) ?? throw new InvalidOperationException("Ugyldig bildeformat.");

        var longestSide = Math.Max(original.Width, original.Height);
        SKBitmap? resized = null;

        if (longestSide > maxDimension)
        {
            var scale = (double)maxDimension / longestSide;
            var width = Math.Max(1, (int)(original.Width * scale));
            var height = Math.Max(1, (int)(original.Height * scale));
            resized = original.Resize(new SKImageInfo(width, height), SKSamplingOptions.Default);
        }

        using var _ = resized;
        var bitmapToEncode = resized ?? original;

        using var image = SKImage.FromBitmap(bitmapToEncode);
        using var data = image.Encode(SKEncodedImageFormat.Jpeg, quality);
        return data.ToArray();
    }

    private async Task SaveBefaring()
    {
        if (string.IsNullOrWhiteSpace(_form.Navn))
        {
            _error = "Befaringen må ha et navn.";
            return;
        }

        _error = null;
        _form.Dorfelt = _dorfelt;

        if (!Id.HasValue)
        {
            Db.Befaringer.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (Id.HasValue)
        {
            _savedMessage = $"Befaringen \"{_form.Navn}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Befaringen \"{_form.Navn}\" er lagret.";
            ResetForm();
        }
    }

    private void VisPdfForhandsvisning()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _pdfSavedMessage = null;
        _pdfPreviewUrl = $"/befaring/{Id.Value}/pdf";
    }

    private async Task LagreBefaringPdf()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var bytes = await PdfService.GenerateAsync(Id.Value);
        if (bytes is null)
        {
            return;
        }

        var pdf = new BefaringPdf
        {
            BefaringId = Id.Value,
            Navn = $"Befaring - {_form.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf",
            Data = bytes
        };

        Db.BefaringPdfer.Add(pdf);
        await Db.SaveChangesAsync();

        _lagredePdfer.Add(pdf);
        _pdfSavedMessage = "PDF-en er lagret under fanen PDF-er.";
    }

    // Filnavnet er "Befaring - {navn} - {dato}.pdf". Tabellen har egne
    // kolonner for dato, så bare navnet vises. Navnet blir stående som da
    // PDF-en ble laget, selv om befaringen får nytt navn senere.
    private static string PdfVisningsnavn(BefaringPdf pdf)
    {
        const string forran = "Befaring - ";
        var slutt = pdf.Navn.LastIndexOf(" - ", StringComparison.Ordinal);
        return pdf.Navn.StartsWith(forran, StringComparison.Ordinal) && slutt > forran.Length
            ? pdf.Navn[forran.Length..slutt]
            : pdf.Navn;
    }

    private static string PdfStorrelse(BefaringPdf pdf) => pdf.Data.Length >= 1_000_000
        ? $"{pdf.Data.Length / 1_000_000d:0.0} MB"
        : $"{Math.Max(1, pdf.Data.Length / 1000)} kB";

    private async Task FjernPdf(BefaringPdf pdf)
    {
        Db.BefaringPdfer.Remove(pdf);
        await Db.SaveChangesAsync();
        _lagredePdfer.Remove(pdf);
        _bekreftPdfId = null;
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Befaringer.FirstOrDefaultAsync(b => b.Id == Id.Value);
        if (existing is not null)
        {
            Db.Befaringer.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/befaringsliste");
    }
}
