@page "/komponenter/leverandorer/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_leverandor?.Navn ?? "Leverandør") - Full Kontroll</PageTitle>

@if (_notFound)
{
    <a class="back-link" href="/komponenter/leverandorer">&larr; Tilbake til leverandører</a>
    <p class="form-error">Fant ikke leverandøren.</p>
}
else if (_leverandor is not null)
{
    <div class="leverandor-hero">
        <div class="leverandor-hero-toppRad">
            <a class="back-link" href="/komponenter/leverandorer">&larr; Tilbake til leverandører</a>
            <span class="status-badge"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"></circle></svg>Aktiv leverandør</span>
        </div>
        <div class="leverandor-hero-hovedRad">
            <div class="logo-rad">
                @if (_leverandor.LogoData is not null)
                {
                    <img class="logo-forhandsvisning" src="@($"/leverandorlogo/{_leverandor.Id}?v={_leverandor.Id}")" alt="@_leverandor.Navn" />
                }
                else
                {
                    <span class="logo-forhandsvisning logo-tom">Ingen logo</span>
                }
                <label class="logo-upload-knapp" title="Last opp logo">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M6 10l6-6 6 6"></path><path d="M4 20h16"></path></svg>
                    <InputFile OnChange="LastOppLogo" accept="image/*" style="display:none;" />
                </label>
            </div>
            <div class="leverandor-hero-navn">
                <h1>@_leverandor.Navn</h1>
                <span>Leverandør &middot; @(string.IsNullOrWhiteSpace(_leverandor.Kontaktperson) ? "ingen kontaktperson satt" : _leverandor.Kontaktperson)</span>
            </div>
            <button type="button" class="rediger-knapp" @onclick="ToggleRedigerModus">
                @if (!_redigerModus)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="m18.5 2.5 3 3L12 15l-4 1 1-4Z"></path></svg>
                }
                @(_redigerModus ? "Ferdig" : "Rediger")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_logoFeil))
        {
            <p class="form-error hero-feil">@_logoFeil</p>
        }
        <div class="leverandor-hero-stats">
            <div class="stat-pill"><strong>@_lenker.Count</strong><span>varer</span></div>
            <div class="stat-pill"><strong>@_lenker.Count(l => l.ErStandard)</strong><span>standardvalgt</span></div>
        </div>
    </div>

    <section class="leverandor-seksjon card">
        <div class="leverandor-seksjon-header">
            <h2>Kontaktinfo</h2>
            @if (!_redigerModus)
            {
                <span class="section-hint">Skrivebeskyttet &ndash; trykk Rediger for å endre</span>
            }
        </div>
        @if (_redigerModus)
        {
            <div class="field-grid">
                <label>
                    Navn
                    <input @bind="_leverandor.Navn" />
                </label>
                <label>
                    Kontaktperson
                    <input @bind="_leverandor.Kontaktperson" />
                </label>
                <label>
                    Telefon
                    <input @bind="_leverandor.Telefon" />
                </label>
                <label>
                    E-post
                    <input @bind="_leverandor.Epost" />
                </label>
                <label>
                    Adresse
                    <input @bind="_leverandor.Adresse" />
                </label>
                <label>
                    Postnr
                    <input @bind="_leverandor.Postnr" />
                </label>
                <label>
                    Sted
                    <input @bind="_leverandor.Sted" />
                </label>
                <label class="span-2">
                    Notater
                    <textarea rows="2" @bind="_leverandor.Notater"></textarea>
                </label>
            </div>
            <div class="lagre-rad">
                <button type="button" class="save-button" @onclick="LagreLeverandor">Lagre</button>
                @if (_lenker.Count == 0)
                {
                    <button type="button" class="remove-button" @onclick="SlettLeverandor">Slett leverandør</button>
                }
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <span class="save-success">@_melding</span>
                }
            </div>
        }
        else
        {
            <div class="field-grid felt-visning">
                <div><span class="felt-etikett">Navn</span><span class="felt-verdi">@_leverandor.Navn</span></div>
                <div><span class="felt-etikett">Kontaktperson</span><span class="felt-verdi">@(_leverandor.Kontaktperson ?? "Ikke satt")</span></div>
                <div><span class="felt-etikett">Telefon</span><span class="felt-verdi">@(_leverandor.Telefon ?? "Ikke satt")</span></div>
                <div><span class="felt-etikett">E-post</span><span class="felt-verdi">@(_leverandor.Epost ?? "Ikke satt")</span></div>
                <div><span class="felt-etikett">Adresse</span><span class="felt-verdi">@(_leverandor.Adresse ?? "Ikke satt")</span></div>
                <div><span class="felt-etikett">Postnr</span><span class="felt-verdi">@(_leverandor.Postnr ?? "Ikke satt")</span></div>
                <div><span class="felt-etikett">Sted</span><span class="felt-verdi">@(_leverandor.Sted ?? "Ikke satt")</span></div>
                <div class="span-2"><span class="felt-etikett">Notater</span><span class="felt-verdi">@(string.IsNullOrWhiteSpace(_leverandor.Notater) ? "Ingen notater" : _leverandor.Notater)</span></div>
            </div>
        }
    </section>

    <section class="leverandor-seksjon card">
        <h2>Varer fra @_leverandor.Navn (@_lenkerFiltrert.Count av @_lenker.Count)</h2>
        <p class="section-hint">Nye varer kobles til denne leverandøren fra varens egen side i Komponentregister (klikk på varenavnet), ikke herfra.</p>

        @if (_lenker.Count > 0)
        {
            @if (!_bekrefterSlettAlle)
            {
                <button type="button" class="remove-button" title="Sletter varene helt (ikke bare koblingen til leverandøren) - kun mulig for varer som ikke er brukt noe annet sted" @onclick="@(() => _bekrefterSlettAlle = true)">Slett alle @_lenker.Count varer fra @_leverandor.Navn</button>
            }
            else
            {
                <p class="form-error">Er du sikker? Dette sletter varene fra @_leverandor.Navn permanent (varer i bruk et annet sted blir ikke slettet, se melding etterpå).</p>
                <button type="button" class="remove-button" @onclick="SlettAlleVarerAsync" disabled="@_sletterAlle">@(_sletterAlle ? "Sletter..." : "Ja, slett alle")</button>
                <button type="button" class="cancel-button" @onclick="@(() => _bekrefterSlettAlle = false)">Avbryt</button>
            }
            @if (!string.IsNullOrEmpty(_slettAlleResultat))
            {
                <p class="save-success">@_slettAlleResultat</p>
            }
        }

        <input class="sok-input" @bind="_lenkeFilter" @bind:event="oninput" placeholder="Søk i varer fra denne leverandøren..." />
        @if (_lenker.Count == 0)
        {
            <p class="list-empty">Ingen varer koblet til denne leverandøren ennå.</p>
        }
        else if (_lenkerFiltrert.Count == 0)
        {
            <p class="list-empty">Ingen treff på "@_lenkeFilter".</p>
        }
        else
        {
            <table class="lenke-table">
                <thead>
                    <tr>
                        <th>Vare</th>
                        <th>Varenummer</th>
                        <th>Navn</th>
                        <th>Netto</th>
                        <th>Veiledende</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _lenkerFiltrert)
                    {
                        <tr @key="l.ComponentId">
                            <td>@l.ComponentNavn</td>
                            <td><input @bind="l.Varenummer" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input @bind="l.Navn" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisNetto" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisVeiledende" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><button type="button" class="remove-button" @onclick="@(() => FjernLenke(l))">Fjern</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class LenkeRad
    {
        public int ComponentId { get; set; }
        public string ComponentNavn { get; set; } = "";
        public string? Varenummer { get; set; }
        public string? Navn { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public bool ErStandard { get; set; }
    }

    private Leverandor? _leverandor;
    private bool _notFound;
    private bool _redigerModus;
    private string? _melding;
    private string? _logoFeil;
    private List<LenkeRad> _lenker = [];
    private string _lenkeFilter = "";
    private bool _bekrefterSlettAlle;
    private bool _sletterAlle;
    private string? _slettAlleResultat;

    private List<LenkeRad> _lenkerFiltrert => string.IsNullOrWhiteSpace(_lenkeFilter)
        ? _lenker
        : _lenker.Where(l =>
            l.ComponentNavn.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase)
            || (l.Varenummer?.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _bekrefterSlettAlle = false;
        _slettAlleResultat = null;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _leverandor = await Db.Leverandorer.FirstOrDefaultAsync(l => l.Id == Id);
        _notFound = _leverandor is null;
        if (_leverandor is null)
        {
            return;
        }

        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.LeverandorId == Id)
            .Include(cl => cl.Component)
            .OrderBy(cl => cl.Component!.Navn)
            .Select(cl => new LenkeRad
            {
                ComponentId = cl.ComponentId,
                ComponentNavn = cl.Component!.Navn,
                Varenummer = cl.Varenummer,
                Navn = cl.Navn,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();
    }

    private async Task LagreLeverandor()
    {
        await Db.SaveChangesAsync();
        _melding = "Lagret.";
    }

    private void ToggleRedigerModus()
    {
        _redigerModus = !_redigerModus;
    }

    private async Task LastOppLogo(InputFileChangeEventArgs e)
    {
        if (_leverandor is null)
        {
            return;
        }

        _logoFeil = null;
        var fil = e.File;
        if (fil.Size > 4_000_000)
        {
            _logoFeil = $"\"{fil.Name}\" er for stor (maks 4 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = fil.OpenReadStream(maxAllowedSize: 4_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _leverandor.LogoData = buffer.ToArray();
        _leverandor.LogoContentType = string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType;
        _leverandor.LogoFilnavn = fil.Name;
        await Db.SaveChangesAsync();
        _melding = "Logo lagret.";
    }

    private async Task FjernLogo()
    {
        if (_leverandor is null)
        {
            return;
        }

        _leverandor.LogoData = null;
        _leverandor.LogoContentType = null;
        _leverandor.LogoFilnavn = null;
        await Db.SaveChangesAsync();
        _melding = "Logo fjernet.";
    }

    private async Task SlettLeverandor()
    {
        if (_leverandor is null || _lenker.Count > 0)
        {
            return;
        }

        Db.Leverandorer.Remove(_leverandor);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/komponenter/leverandorer");
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.Navn = string.IsNullOrWhiteSpace(rad.Navn) ? null : rad.Navn.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            // Denne leverandøren er standard for varen - hold Component sine
            // egne felt (Produktkode/PrisNetto/PrisVeiledende/Leverandor) i
            // synk med de ferske verdiene.
            await LeverandorSync.SettStandardAsync(Db, rad.ComponentId, Id);
            await Db.SaveChangesAsync();
        }
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        await LastAsync();
    }

    // Sletter varene fra denne leverandøren helt (ikke bare koblingen) - for
    // å rydde opp etter en feilslått/gjentatt import, se Prisimport.razor.
    // Sjekker ALLE steder en Component kan være i bruk (samme mønster som
    // KomponentDuplikater.razor) før den regnes som trygg å slette - varer i
    // bruk et annet sted skippes og rapporteres, aldri slettet blindt.
    private async Task SlettAlleVarerAsync()
    {
        _sletterAlle = true;
        var alleIder = _lenker.Select(l => l.ComponentId).ToList();
        var brukt = new HashSet<int>();

        foreach (var bolk in alleIder.Chunk(500))
        {
            brukt.UnionWith(await Db.DorKomponenter.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.TilbudLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.ArbeidsordreVarer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.MonteringLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.ServiceMinuttLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.PlanlagtePrisendringer.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PlukklisteLinjer.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.NokkelSylindere.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.LasplanReserver.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PrisHistorikk.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PackageComponents.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
        }

        var trygge = alleIder.Where(id => !brukt.Contains(id)).ToList();
        foreach (var bolk in trygge.Chunk(200))
        {
            var komponenter = await Db.Components.Where(c => bolk.Contains(c.Id)).ToListAsync();
            Db.Components.RemoveRange(komponenter);
            await Db.SaveChangesAsync();
        }

        _slettAlleResultat = brukt.Count == 0
            ? $"Slettet {trygge.Count} vare(r)."
            : $"Slettet {trygge.Count} vare(r). {brukt.Count} vare(r) ble IKKE slettet fordi de er i bruk (dør, tilbud, arbeidsordre e.l.) - fjern koblingen manuelt om de likevel skal bort.";
        _bekrefterSlettAlle = false;
        _sletterAlle = false;
        await LastAsync();
    }
}
