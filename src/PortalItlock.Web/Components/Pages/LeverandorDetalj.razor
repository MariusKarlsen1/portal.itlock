@page "/komponenter/leverandorer/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VisningPreferanseService VisningPref

<PageTitle>@(_leverandor?.Navn ?? "Leverandør") - Full Kontroll</PageTitle>

@* LD2 (leverandor-detalj-forslag.html): kontaktkortet fast til venstre inni
   kortet og varetabellen til høyre, som ruller for seg og blas med 25/50/100
   per side. Farlige handlinger ligger i ⋯-menyen. *@
@if (_notFound)
{
    <a class="lv-tilbake" href="/komponenter/leverandorer">&larr; Leverandører</a>
    <p class="form-error">Fant ikke leverandøren.</p>
}
else if (_leverandor is not null)
{
    <div class="ld @(_full ? "ld-full" : "")">
    <a class="lv-tilbake" href="/komponenter/leverandorer">&larr; Leverandører</a>

    <div class="ld-kort">
        <section class="lv-kontakt ld-kontakt">
            <div class="lv-kontakt-topp">
                <span class="lv-logo">
                    @if (_leverandor.LogoData is not null)
                    {
                        <img src="@($"/leverandorlogo/{_leverandor.Id}?w=200&v={_logoVersjon}")" alt="@_leverandor.Navn" />
                    }
                    else
                    {
                        <span class="lv-logo-tom">@Initialer(_leverandor.Navn)</span>
                    }
                    <label class="lv-logo-bytt" title="@(_leverandor.LogoData is null ? "Last opp logo" : "Bytt logo")">
                        <Icon Name="upload" />
                        <InputFile OnChange="LastOppLogo" accept="image/*" style="display:none;" />
                    </label>
                </span>
                <div>
                    <h1>@_leverandor.Navn</h1>
                    <span class="lv-under">Leverandør</span>
                </div>
            </div>
            @if (!_redigerModus)
            {
                <div class="lv-handlinger">
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Telefon))
                    {
                        <a class="lv-knapp" href="@($"tel:{_leverandor.Telefon.Replace(" ", "")}")"><Icon Name="phone" />Ring</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Epost))
                    {
                        <a class="lv-knapp" href="@($"mailto:{_leverandor.Epost}")"><Icon Name="mail" />E-post</a>
                    }
                    <button type="button" class="lv-knapp" @onclick="@(() => _redigerModus = true)"><Icon Name="edit" />@(ManglerKontaktinfo ? "Legg inn kontaktinfo" : "Rediger")</button>
                </div>
            }
            @if (!string.IsNullOrEmpty(_logoFeil))
            {
                <p class="form-error">@_logoFeil</p>
            }

            @if (_redigerModus)
            {
                <div class="lv-skjema">
                    <label class="lv-felt lv-bred"><span>Navn</span><input @bind="_leverandor.Navn" /></label>
                    <label class="lv-felt lv-bred"><span>Kontaktperson</span><input @bind="_leverandor.Kontaktperson" /></label>
                    <label class="lv-felt lv-bred"><span>Telefon</span><input @bind="_leverandor.Telefon" /></label>
                    <label class="lv-felt lv-bred"><span>E-post</span><input @bind="_leverandor.Epost" /></label>
                    <label class="lv-felt lv-bred"><span>Adresse</span><input @bind="_leverandor.Adresse" /></label>
                    <div class="lv-to lv-bred">
                        <label class="lv-felt"><span>Postnr</span><input @bind="_leverandor.Postnr" /></label>
                        <label class="lv-felt"><span>Sted</span><input @bind="_leverandor.Sted" /></label>
                    </div>
                    <label class="lv-felt lv-bred"><span>Notater</span><textarea rows="3" @bind="_leverandor.Notater"></textarea></label>
                    <div class="lv-knapper lv-bred">
                        <button type="button" class="lv-knapp" @onclick="AvbrytRedigering">Avbryt</button>
                        <button type="button" class="lv-knapp primaer" @onclick="LagreLeverandor"><Icon Name="check" />Lagre</button>
                    </div>
                    @if (_leverandor.LogoData is not null)
                    {
                        <button type="button" class="lv-lenke lv-bred" @onclick="FjernLogo">Fjern logo</button>
                    }
                </div>
            }
            else
            {
                <div class="lv-info">
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Kontaktperson))
                    {
                        <div class="lv-rad"><span class="lv-ik"><Icon Name="users" /></span><span>@_leverandor.Kontaktperson<small>Kontaktperson</small></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Telefon))
                    {
                        <div class="lv-rad"><span class="lv-ik"><Icon Name="phone" /></span><span><a href="@($"tel:{_leverandor.Telefon.Replace(" ", "")}")">@_leverandor.Telefon</a><small>Telefon</small></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Epost))
                    {
                        <div class="lv-rad"><span class="lv-ik"><Icon Name="mail" /></span><span><a href="@($"mailto:{_leverandor.Epost}")">@_leverandor.Epost</a><small>E-post</small></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Adresse))
                    {
                        <div class="lv-rad"><span class="lv-ik"><Icon Name="map-pin" /></span><span>@Adresse<small>Adresse</small></span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_leverandor.Notater))
                    {
                        <div class="lv-notat">@_leverandor.Notater</div>
                    }
                    @if (ManglerKontaktinfo)
                    {
                        <p class="lv-tom-info">Ingen kontaktinfo lagt inn ennå.</p>
                    }
                </div>
            }

            <div class="ld-prisinfo">
                <span>Priser sist oppdatert</span>
                <b class="@(PriserGamle ? "ld-gammel" : "")">@(_sistOppdatert?.ToString("dd.MM.yyyy") ?? "Aldri")</b>
            </div>

            @if (!string.IsNullOrEmpty(_melding))
            {
                <p class="lv-ok">@_melding</p>
            }
        </section>

        <section class="lv-varer ld-varer">
            <div class="lv-varer-topp">
                <h2>Varer <span>@_lenker.Count.ToString("N0", Kultur)</span></h2>
                <label class="lv-sok">
                    <Icon Name="search" />
                    <input type="search" placeholder="Søk i varer …" @bind="_lenkeFilter" @bind:event="oninput" @bind:after="@(() => _side = 0)" />
                </label>
                <span class="lv-meny-wrap">
                    <button type="button" class="lv-mer" title="Flere valg" @onclick="@(() => _visMeny = !_visMeny)"><Icon Name="more-horizontal" /></button>
                    @if (_visMeny)
                    {
                        <span class="lv-meny-bakgrunn" @onclick="@(() => _visMeny = false)"></span>
                        <span class="lv-meny">
                            <button type="button" @onclick="@(() => { _visMeny = false; _redigerModus = true; })"><Icon Name="edit" />Rediger kontaktinfo</button>
                            <span class="lv-skille"></span>
                            <button type="button" class="farlig" disabled="@(_lenker.Count == 0)" @onclick="@(() => { _visMeny = false; _bekrefterSlettAlle = true; })"><Icon Name="trash" />Slett alle @_lenker.Count varer …</button>
                            <button type="button" class="farlig" disabled="@(_lenker.Count > 0)" title="@(_lenker.Count > 0 ? "Kan bare slettes når leverandøren ikke har varer" : "")" @onclick="SlettLeverandor"><Icon Name="trash" />Slett leverandør</button>
                        </span>
                    }
                </span>
                <button type="button" class="ld-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
            </div>

            @if (_bekrefterSlettAlle)
            {
                <div class="lv-bekreft">
                    <span><b>Slette alle @_lenker.Count varer fra @_leverandor.Navn?</b> Varene slettes permanent. Varer som er i bruk et annet sted (dør, tilbud, arbeidsordre o.l.) blir ikke slettet.</span>
                    <span class="lv-knapper">
                        <button type="button" class="lv-knapp" @onclick="@(() => _bekrefterSlettAlle = false)">Avbryt</button>
                        <button type="button" class="lv-knapp fare" disabled="@_sletterAlle" @onclick="SlettAlleVarerAsync">@(_sletterAlle ? "Sletter …" : "Ja, slett alle")</button>
                    </span>
                </div>
            }
            @if (!string.IsNullOrEmpty(_slettAlleResultat))
            {
                <p class="lv-ok lv-ok-boks">@_slettAlleResultat</p>
            }

            <div class="ld-rull" @key="@($"{_side}-{_perSide}")">
                @if (_lenker.Count == 0)
                {
                    <p class="lv-tom">Ingen varer koblet til denne leverandøren ennå. Varer kobles til fra varens egen side i komponentregisteret.</p>
                }
                else if (_lenkerFiltrert.Count == 0)
                {
                    <p class="lv-tom">Ingen treff på «@_lenkeFilter».</p>
                }
                else
                {
                    <div class="lv-tabell">
                        <table>
                            <thead>
                                <tr>
                                    <th>Vare</th>
                                    <th>Varenummer</th>
                                    <th class="n">Netto</th>
                                    <th class="n">Veiledende</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Side)
                                {
                                    var rad = l;
                                    var apen = _apenId == l.ComponentId;
                                    <tr @key="l.ComponentId" class="@(apen ? "apen" : "klikk")" @onclick="@(() => VelgRad(rad))">
                                        <td>
                                            <b>@l.ComponentNavn</b>
                                            @if (l.ErStandard)
                                            {
                                                <span class="lv-std">Standard</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(l.Navn) && !string.Equals(l.Navn, l.ComponentNavn, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <small>@l.Navn</small>
                                            }
                                        </td>
                                        <td class="lv-kode">@(string.IsNullOrWhiteSpace(l.Varenummer) ? "–" : l.Varenummer)</td>
                                        <td class="n">@Kr(l.PrisNetto)</td>
                                        <td class="n">@Kr(l.PrisVeiledende)</td>
                                        <td class="n lv-pil">@(apen ? "⌃" : "›")</td>
                                    </tr>
                                    @if (apen)
                                    {
                                        <tr class="lv-redig">
                                            <td colspan="5">
                                                <div class="lv-redig-grid">
                                                    <label class="lv-felt"><span>Varenummer</span><input @bind="rad.Varenummer" /></label>
                                                    <label class="lv-felt"><span>Leverandørens navn</span><input @bind="rad.Navn" /></label>
                                                    <label class="lv-felt"><span>Netto</span><input type="number" step="0.01" @bind="rad.PrisNetto" /></label>
                                                    <label class="lv-felt"><span>Veiledende</span><input type="number" step="0.01" @bind="rad.PrisVeiledende" /></label>
                                                </div>
                                                <div class="lv-redig-bunn">
                                                    <button type="button" class="lv-lenke farlig" @onclick="@(() => FjernLenke(rad))"><Icon Name="x" />Fjern fra leverandøren</button>
                                                    <span class="lv-knapper">
                                                        <button type="button" class="lv-knapp" @onclick="AvbrytRad">Avbryt</button>
                                                        <button type="button" class="lv-knapp primaer" @onclick="@(() => LagreRad(rad))"><Icon Name="check" />Lagre</button>
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (_lenkerFiltrert.Count > 0)
            {
                var fra = _side * _perSide + 1;
                var til = Math.Min(_lenkerFiltrert.Count, (_side + 1) * _perSide);
                <div class="ld-sidebunn">
                    <span>Viser @fra.ToString("N0", Kultur)–@til.ToString("N0", Kultur) av @_lenkerFiltrert.Count.ToString("N0", Kultur)</span>
                    <span class="ld-sider">
                        <button type="button" disabled="@(_side == 0)" title="Forrige side" @onclick="@(() => BytSide(-1))">‹</button>
                        <span>Side @(_side + 1) av @AntallSider</span>
                        <button type="button" disabled="@(_side + 1 >= AntallSider)" title="Neste side" @onclick="@(() => BytSide(1))">›</button>
                    </span>
                    <span class="ld-sider">
                        Per side
                        @foreach (var n in new[] { 25, 50, 100 })
                        {
                            var antall = n;
                            <button type="button" class="@(_perSide == antall ? "pa" : "")" @onclick="@(() => SettPerSide(antall))">@antall</button>
                        }
                    </span>
                </div>
            }
        </section>
    </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class LenkeRad
    {
        public int ComponentId { get; set; }
        public string ComponentNavn { get; set; } = "";
        public string? Varenummer { get; set; }
        public string? Navn { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public bool ErStandard { get; set; }
    }

    private Leverandor? _leverandor;
    private bool _notFound;
    private bool _redigerModus;
    private string? _melding;
    private string? _logoFeil;
    private List<LenkeRad> _lenker = [];
    private string _lenkeFilter = "";
    private bool _bekrefterSlettAlle;
    private bool _sletterAlle;
    private string? _slettAlleResultat;
    private bool _visMeny;
    private int? _apenId;
    private int _logoVersjon;
    private bool _full;
    private int _side;
    private int _perSide = 50;
    private DateTime? _sistOppdatert;

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private int AntallSider => Math.Max(1, (int)Math.Ceiling(_lenkerFiltrert.Count / (double)_perSide));

    private IEnumerable<LenkeRad> Side => _lenkerFiltrert.Skip(Math.Min(_side, AntallSider - 1) * _perSide).Take(_perSide);

    // Over ett år siden prislisten ble oppdatert (eller aldri, når det finnes varer).
    private bool PriserGamle => _lenker.Count > 0 && (_sistOppdatert is null || _sistOppdatert < DateTime.Today.AddYears(-1));

    private void BytSide(int delta) => _side = Math.Clamp(_side + delta, 0, AntallSider - 1);

    private async Task SettPerSide(int antall)
    {
        _perSide = antall;
        _side = 0;
        await VisningPref.SettAsync("leverandor-varer-per-side", antall.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("leverandor-bredde", _full ? "full" : "normal");
    }

    private string? Adresse => string.Join(", ", new[]
        {
            _leverandor?.Adresse,
            string.Join(" ", new[] { _leverandor?.Postnr, _leverandor?.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)))
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private bool ManglerKontaktinfo => _leverandor is not null
        && string.IsNullOrWhiteSpace(_leverandor.Kontaktperson)
        && string.IsNullOrWhiteSpace(_leverandor.Telefon)
        && string.IsNullOrWhiteSpace(_leverandor.Epost)
        && string.IsNullOrWhiteSpace(Adresse)
        && string.IsNullOrWhiteSpace(_leverandor.Notater);

    private static string Kr(decimal? v) => v is null ? "–" : v.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"));

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private async Task VelgRad(LenkeRad rad)
    {
        if (_apenId == rad.ComponentId)
        {
            return;
        }

        // Bytter man rad uten å lagre, forkastes endringene på den forrige.
        if (_apenId is not null)
        {
            await LastLenkerAsync();
        }

        _apenId = rad.ComponentId;
    }

    private async Task AvbrytRad()
    {
        _apenId = null;
        await LastLenkerAsync();
    }

    private async Task LagreRad(LenkeRad rad)
    {
        await LagreLenke(rad);
        _apenId = null;
    }

    private async Task AvbrytRedigering()
    {
        if (_leverandor is not null)
        {
            await Db.Entry(_leverandor).ReloadAsync();
        }

        _redigerModus = false;
    }

    private List<LenkeRad> _lenkerFiltrert => string.IsNullOrWhiteSpace(_lenkeFilter)
        ? _lenker
        : _lenker.Where(l =>
            l.ComponentNavn.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase)
            || (l.Varenummer?.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _full = await VisningPref.HentAsync("leverandor-bredde", "normal") == "full";
        if (int.TryParse(await VisningPref.HentAsync("leverandor-varer-per-side", "50"), out var perSide) && perSide is 25 or 50 or 100)
        {
            _perSide = perSide;
        }

        _side = 0;
        _bekrefterSlettAlle = false;
        _slettAlleResultat = null;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _leverandor = await Db.Leverandorer.FirstOrDefaultAsync(l => l.Id == Id);
        _notFound = _leverandor is null;
        if (_leverandor is null)
        {
            return;
        }

        // Når prislisten sist ble lastet opp (Prisimport lagrer leverandørnavnet).
        var navn = _leverandor.Navn.Trim().ToLower();
        _sistOppdatert = await Db.Importhistorikk
            .Where(h => h.Status == "Fullført" && h.Leverandor != null && h.Leverandor.ToLower() == navn && (h.Kilde == "Oppdater priser" || h.Kilde == "Prisimport"))
            .MaxAsync(h => (DateTime?)h.OpprettetDato);

        await LastLenkerAsync();
    }

    private async Task LastLenkerAsync()
    {
        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.LeverandorId == Id)
            .Include(cl => cl.Component)
            .OrderBy(cl => cl.Component!.Navn)
            .Select(cl => new LenkeRad
            {
                ComponentId = cl.ComponentId,
                ComponentNavn = cl.Component!.Navn,
                Varenummer = cl.Varenummer,
                Navn = cl.Navn,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();
    }

    private async Task LagreLeverandor()
    {
        await Db.SaveChangesAsync();
        _melding = "Kontaktinfo lagret.";
        _redigerModus = false;
    }

    private async Task LastOppLogo(InputFileChangeEventArgs e)
    {
        if (_leverandor is null)
        {
            return;
        }

        _logoFeil = null;
        var fil = e.File;
        if (fil.Size > 4_000_000)
        {
            _logoFeil = $"\"{fil.Name}\" er for stor (maks 4 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = fil.OpenReadStream(maxAllowedSize: 4_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _leverandor.LogoData = buffer.ToArray();
        _leverandor.LogoContentType = string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType;
        _leverandor.LogoFilnavn = fil.Name;
        await Db.SaveChangesAsync();
        _logoVersjon++;
        _melding = "Logo lagret.";
    }

    private async Task FjernLogo()
    {
        if (_leverandor is null)
        {
            return;
        }

        _leverandor.LogoData = null;
        _leverandor.LogoContentType = null;
        _leverandor.LogoFilnavn = null;
        await Db.SaveChangesAsync();
        _logoVersjon++;
        _melding = "Logo fjernet.";
    }

    private async Task SlettLeverandor()
    {
        if (_leverandor is null || _lenker.Count > 0)
        {
            return;
        }

        Db.Leverandorer.Remove(_leverandor);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/komponenter/leverandorer");
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.Navn = string.IsNullOrWhiteSpace(rad.Navn) ? null : rad.Navn.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            // Denne leverandøren er standard for varen - hold Component sine
            // egne felt (Produktkode/PrisNetto/PrisVeiledende/Leverandor) i
            // synk med de ferske verdiene.
            await LeverandorSync.SettStandardAsync(Db, rad.ComponentId, Id);
            await Db.SaveChangesAsync();
        }
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        await LastAsync();
    }

    // Sletter varene fra denne leverandøren helt (ikke bare koblingen) - for
    // å rydde opp etter en feilslått/gjentatt import, se Prisimport.razor.
    // Sjekker ALLE steder en Component kan være i bruk (samme mønster som
    // KomponentDuplikater.razor) før den regnes som trygg å slette - varer i
    // bruk et annet sted skippes og rapporteres, aldri slettet blindt.
    private async Task SlettAlleVarerAsync()
    {
        _sletterAlle = true;
        var alleIder = _lenker.Select(l => l.ComponentId).ToList();
        var brukt = new HashSet<int>();

        foreach (var bolk in alleIder.Chunk(500))
        {
            brukt.UnionWith(await Db.DorKomponenter.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.TilbudLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.ArbeidsordreVarer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.MonteringLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.ServiceMinuttLinjer.Where(x => x.ComponentId.HasValue && bolk.Contains(x.ComponentId.Value)).Select(x => x.ComponentId!.Value).ToListAsync());
            brukt.UnionWith(await Db.PlanlagtePrisendringer.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PlukklisteLinjer.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.NokkelSylindere.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.LasplanReserver.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PrisHistorikk.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
            brukt.UnionWith(await Db.PackageComponents.Where(x => bolk.Contains(x.ComponentId)).Select(x => x.ComponentId).ToListAsync());
        }

        var trygge = alleIder.Where(id => !brukt.Contains(id)).ToList();
        foreach (var bolk in trygge.Chunk(200))
        {
            var komponenter = await Db.Components.Where(c => bolk.Contains(c.Id)).ToListAsync();
            Db.Components.RemoveRange(komponenter);
            await Db.SaveChangesAsync();
        }

        _slettAlleResultat = brukt.Count == 0
            ? $"Slettet {trygge.Count} vare(r)."
            : $"Slettet {trygge.Count} vare(r). {brukt.Count} vare(r) ble IKKE slettet fordi de er i bruk (dør, tilbud, arbeidsordre e.l.) - fjern koblingen manuelt om de likevel skal bort.";
        _bekrefterSlettAlle = false;
        _sletterAlle = false;
        await LastAsync();
    }
}
