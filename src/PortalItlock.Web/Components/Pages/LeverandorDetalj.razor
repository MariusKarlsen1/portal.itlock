@page "/komponenter/leverandorer/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_leverandor?.Navn ?? "Leverandør") - itlock</PageTitle>

<a class="back-link" href="/komponenter/leverandorer">&larr; Tilbake til leverandører</a>

@if (_notFound)
{
    <p class="form-error">Fant ikke leverandøren.</p>
}
else if (_leverandor is not null)
{
    <h1>@_leverandor.Navn</h1>

    <section class="leverandor-seksjon">
        <h2>Kontaktinfo</h2>
        <div class="field-grid">
            <label>
                Navn
                <input @bind="_leverandor.Navn" />
            </label>
            <label>
                Kontaktperson
                <input @bind="_leverandor.Kontaktperson" />
            </label>
            <label>
                Telefon
                <input @bind="_leverandor.Telefon" />
            </label>
            <label>
                E-post
                <input @bind="_leverandor.Epost" />
            </label>
            <label>
                Adresse
                <input @bind="_leverandor.Adresse" />
            </label>
            <label>
                Postnr
                <input @bind="_leverandor.Postnr" />
            </label>
            <label>
                Sted
                <input @bind="_leverandor.Sted" />
            </label>
            <label class="span-2">
                Notater
                <textarea rows="2" @bind="_leverandor.Notater"></textarea>
            </label>
        </div>
        <button type="button" class="save-button" @onclick="LagreLeverandor">Lagre</button>
        @if (_lenker.Count == 0)
        {
            <button type="button" class="remove-button" @onclick="SlettLeverandor">Slett leverandør</button>
        }
        @if (!string.IsNullOrEmpty(_melding))
        {
            <span class="save-success">@_melding</span>
        }
    </section>

    <section class="leverandor-seksjon">
        <h2>Varer fra @_leverandor.Navn (@_lenkerFiltrert.Count av @_lenker.Count)</h2>
        <p class="section-hint">Nye varer kobles til denne leverandøren fra varens egen side i Komponentregister (klikk på varenavnet), ikke herfra.</p>
        <input class="sok-input" @bind="_lenkeFilter" @bind:event="oninput" placeholder="Søk i varer fra denne leverandøren..." />
        @if (_lenker.Count == 0)
        {
            <p class="list-empty">Ingen varer koblet til denne leverandøren ennå.</p>
        }
        else if (_lenkerFiltrert.Count == 0)
        {
            <p class="list-empty">Ingen treff på "@_lenkeFilter".</p>
        }
        else
        {
            <table class="lenke-table">
                <thead>
                    <tr>
                        <th>Vare</th>
                        <th>Varenummer</th>
                        <th>Navn</th>
                        <th>Netto</th>
                        <th>Veiledende</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _lenkerFiltrert)
                    {
                        <tr @key="l.ComponentId">
                            <td>@l.ComponentNavn</td>
                            <td><input @bind="l.Varenummer" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input @bind="l.Navn" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisNetto" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisVeiledende" @bind:after="@(() => LagreLenke(l))" /></td>
                            <td><button type="button" class="remove-button" @onclick="@(() => FjernLenke(l))">Fjern</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class LenkeRad
    {
        public int ComponentId { get; set; }
        public string ComponentNavn { get; set; } = "";
        public string? Varenummer { get; set; }
        public string? Navn { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public bool ErStandard { get; set; }
    }

    private Leverandor? _leverandor;
    private bool _notFound;
    private string? _melding;
    private List<LenkeRad> _lenker = [];
    private string _lenkeFilter = "";

    private List<LenkeRad> _lenkerFiltrert => string.IsNullOrWhiteSpace(_lenkeFilter)
        ? _lenker
        : _lenker.Where(l =>
            l.ComponentNavn.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase)
            || (l.Varenummer?.Contains(_lenkeFilter, StringComparison.OrdinalIgnoreCase) ?? false))
          .ToList();

    protected override async Task OnParametersSetAsync() => await LastAsync();

    private async Task LastAsync()
    {
        _leverandor = await Db.Leverandorer.FirstOrDefaultAsync(l => l.Id == Id);
        _notFound = _leverandor is null;
        if (_leverandor is null)
        {
            return;
        }

        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.LeverandorId == Id)
            .Include(cl => cl.Component)
            .OrderBy(cl => cl.Component!.Navn)
            .Select(cl => new LenkeRad
            {
                ComponentId = cl.ComponentId,
                ComponentNavn = cl.Component!.Navn,
                Varenummer = cl.Varenummer,
                Navn = cl.Navn,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();
    }

    private async Task LagreLeverandor()
    {
        await Db.SaveChangesAsync();
        _melding = "Lagret.";
    }

    private async Task SlettLeverandor()
    {
        if (_leverandor is null || _lenker.Count > 0)
        {
            return;
        }

        Db.Leverandorer.Remove(_leverandor);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/komponenter/leverandorer");
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.Navn = string.IsNullOrWhiteSpace(rad.Navn) ? null : rad.Navn.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            // Denne leverandøren er standard for varen - hold Component sine
            // egne felt (Produktkode/PrisNetto/PrisVeiledende/Leverandor) i
            // synk med de ferske verdiene.
            await LeverandorSync.SettStandardAsync(Db, rad.ComponentId, Id);
            await Db.SaveChangesAsync();
        }
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == rad.ComponentId && cl.LeverandorId == Id);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        await LastAsync();
    }
}
