@page "/dorfunksjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dørfunksjoner</PageTitle>

<h1>Dørfunksjoner</h1>
<p>Vedlikehold listen over dørfunksjoner som kan legges på dører og brukes til å filtrere på plantegninger.</p>

@if (_funksjoner.Count == 0)
{
    <p class="list-empty">Ingen dørfunksjoner opprettet ennå.</p>
}
else
{
    <ul class="funksjon-list">
        @foreach (var f in _funksjoner)
        {
            <li @key="f.Id" class="funksjon-row">
                <input @bind="f.Navn" @bind:event="oninput" placeholder="Navn" />
                <input @bind="f.Forkortelse" @bind:event="oninput" placeholder="Forkortelse" class="funksjon-forkortelse" />
                <span class="funksjon-count">@f.AntallDorer dør@(f.AntallDorer == 1 ? "" : "er")</span>
                <button type="button" class="save-button" @onclick="@(() => LagreNavn(f))">Lagre</button>
                <button type="button" class="remove-button" @onclick="@(() => SlettFunksjon(f))">Slett</button>
            </li>
        }
    </ul>
}

<div class="new-funksjon">
    <h2>Ny dørfunksjon</h2>
    <div class="new-funksjon-form">
        <input @bind="_nyNavn" @bind:event="oninput" placeholder="F.eks. Rømningsdør, Brannmotstand" />
        <button type="button" class="add-button" @onclick="OpprettFunksjon">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
</div>

@code {
    private sealed class FunksjonRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Forkortelse { get; set; }
        public int AntallDorer { get; set; }
    }

    private List<FunksjonRad> _funksjoner = [];
    private string _nyNavn = "";
    private string? _melding;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _funksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .Select(f => new FunksjonRad { Id = f.Id, Navn = f.Navn, Forkortelse = f.Forkortelse, AntallDorer = f.Dorer.Count })
            .ToListAsync();
    }

    private async Task OpprettFunksjon()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.DorFunksjoner.Add(new DorFunksjon { Navn = navn });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _melding = $"Dørfunksjonen \"{navn}\" er opprettet.";
        await LoadAsync();
    }

    private async Task LagreNavn(FunksjonRad rad)
    {
        var navn = rad.Navn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var funksjon = await Db.DorFunksjoner.FirstOrDefaultAsync(f => f.Id == rad.Id);
        if (funksjon is null)
        {
            return;
        }

        funksjon.Navn = navn;
        funksjon.Forkortelse = string.IsNullOrWhiteSpace(rad.Forkortelse) ? null : rad.Forkortelse.Trim();
        await Db.SaveChangesAsync();
        _melding = $"\"{navn}\" er lagret.";
    }

    private async Task SlettFunksjon(FunksjonRad rad)
    {
        var funksjon = await Db.DorFunksjoner.FirstOrDefaultAsync(f => f.Id == rad.Id);
        if (funksjon is null)
        {
            return;
        }

        Db.DorFunksjoner.Remove(funksjon);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Navn}\" er slettet.";
        await LoadAsync();
    }
}
