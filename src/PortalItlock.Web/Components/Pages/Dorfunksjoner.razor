@page "/dorfunksjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Dørfunksjoner</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="toggle-right" /></span>
    <div>
        <h1>Dørfunksjoner</h1>
        <p class="section-hint">Vedlikehold listen over dørfunksjoner som kan legges på dører og brukes til å filtrere på plantegninger.</p>
    </div>
</div>

<label class="sok-boks">
    <Icon Name="search" />
    <input @bind="_search" @bind:event="oninput" placeholder="Søk på navn eller forkortelse..." />
</label>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen dørfunksjoner funnet.</p>
}
else
{
    <div class="funksjon-kort">
        @foreach (var f in _filtrert)
        {
            <div @key="f.Id" class="funksjon-blokk">
                <button type="button" class="funksjon-rad" @onclick="@(() => ToggleAktiv(f.Id))">
                    <span class="forkortelse-tag">@(string.IsNullOrWhiteSpace(f.Forkortelse) ? "–" : f.Forkortelse)</span>
                    <span class="funksjon-navn">@f.Navn</span>
                    <span class="antall-tekst @(f.AntallDorer > 0 ? "i-bruk" : "")">@f.AntallDorer dør@(f.AntallDorer == 1 ? "" : "er")</span>
                </button>
                @if (_aktivId == f.Id)
                {
                    <div class="edit-felt-rad">
                        <input @bind="f.Navn" @bind:event="oninput" placeholder="Navn" />
                        <input @bind="f.Forkortelse" @bind:event="oninput" placeholder="Forkortelse" class="forkortelse-input" />
                        <button type="button" class="knapp knapp-primaer" @onclick="@(() => LagreNavn(f))">Lagre</button>
                        <button type="button" class="knapp knapp-fare" @onclick="@(() => SlettFunksjon(f))">Slett</button>
                    </div>
                }
            </div>
        }
    </div>
}

<div class="ny-funksjon-kort">
    <span class="ny-funksjon-tittel">Ny dørfunksjon</span>
    <div class="ny-funksjon-form">
        <input @bind="_nyNavn" @bind:event="oninput" placeholder="F.eks. Rømningsdør, Brannmotstand"
               @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettFunksjon(); } })" />
        <button type="button" class="knapp knapp-primaer" @onclick="OpprettFunksjon">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }
</div>

@code {
    private sealed class FunksjonRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Forkortelse { get; set; }
        public int AntallDorer { get; set; }
    }

    private List<FunksjonRad> _funksjoner = [];
    private string _search = "";
    private string _nyNavn = "";
    private string? _melding;
    private int? _aktivId;

    private List<FunksjonRad> _filtrert => string.IsNullOrWhiteSpace(_search)
        ? _funksjoner
        : _funksjoner.Where(f =>
                f.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (f.Forkortelse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _funksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .Select(f => new FunksjonRad { Id = f.Id, Navn = f.Navn, Forkortelse = f.Forkortelse, AntallDorer = f.Dorer.Count })
            .ToListAsync();
    }

    private void ToggleAktiv(int id)
    {
        _aktivId = _aktivId == id ? null : id;
    }

    private async Task OpprettFunksjon()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.DorFunksjoner.Add(new DorFunksjon { Navn = navn });
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _melding = $"Dørfunksjonen \"{navn}\" er opprettet.";
        await LoadAsync();
    }

    private async Task LagreNavn(FunksjonRad rad)
    {
        var navn = rad.Navn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var funksjon = await Db.DorFunksjoner.FirstOrDefaultAsync(f => f.Id == rad.Id);
        if (funksjon is null)
        {
            return;
        }

        funksjon.Navn = navn;
        funksjon.Forkortelse = string.IsNullOrWhiteSpace(rad.Forkortelse) ? null : rad.Forkortelse.Trim();
        await Db.SaveChangesAsync();
        _melding = $"\"{navn}\" er lagret.";
    }

    private async Task SlettFunksjon(FunksjonRad rad)
    {
        var funksjon = await Db.DorFunksjoner.FirstOrDefaultAsync(f => f.Id == rad.Id);
        if (funksjon is null)
        {
            return;
        }

        Db.DorFunksjoner.Remove(funksjon);
        await Db.SaveChangesAsync();
        _melding = $"\"{rad.Navn}\" er slettet.";
        _aktivId = null;
        await LoadAsync();
    }
}
