@page "/dorfunksjoner"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Dørfunksjoner</PageTitle>

@* DF9 (dorfunksjoner-mange-forslag.html): dashbord-kort med menyen inni, som
   Kravdimensjoner. Menyen har eget søk, er delt etter forbokstav og har fast
   høyde, så den tåler mange funksjoner. Panelet har bare forkortelse og navn. *@
<div class="df @(_full ? "df-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="toggle-right" /></span>
            <div>
                <h1>Dørfunksjoner</h1>
                <p class="section-hint">Merkene som legges på dører og pakker, og brukes til filter på plantegninger.</p>
            </div>
        </div>
        <span class="df-filter">
            <button type="button" class="@(_filter == "alle" ? "pa" : "")" @onclick="@(() => _filter = "alle")">Alle <small>@_funksjoner.Count</small></button>
            <button type="button" class="@(_filter == "bruk" ? "pa" : "")" @onclick="@(() => _filter = "bruk")">I bruk <small>@_funksjoner.Count(f => f.IBruk)</small></button>
            <button type="button" class="@(_filter == "ubrukt" ? "pa" : "")" @onclick="@(() => _filter = "ubrukt")">Ikke i bruk <small>@_funksjoner.Count(f => !f.IBruk)</small></button>
        </span>
    </div>

    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="df-ok">@_melding</p>
    }
    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }

    <div class="df-kort">
        <nav class="df-meny">
            <label class="df-sok">
                <Icon Name="search" />
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Søk i @_funksjoner.Count funksjoner" />
            </label>
            <div class="df-liste">
                @{
                    var forrigeBokstav = "";
                }
                @foreach (var f in _filtrert)
                {
                    var bokstav = Forbokstav(f.Navn);
                    if (bokstav != forrigeBokstav)
                    {
                        forrigeBokstav = bokstav;
                        <span class="df-bokstav">@bokstav</span>
                    }
                    var id = f.Id;
                    <button type="button" @key="f.Id" class="@(f.Id == _valgtId ? "pa" : "")" @onclick="@(() => Velg(id))">
                        <span class="df-kode @(string.IsNullOrWhiteSpace(f.Forkortelse) ? "tom" : "")">@(string.IsNullOrWhiteSpace(f.Forkortelse) ? "–" : f.Forkortelse)</span>
                        <span class="df-navn">@f.Navn</span>
                    </button>
                }
                @if (_filtrert.Count == 0)
                {
                    <p class="df-dempet">Ingen treff.</p>
                }
            </div>
            <div class="df-ny">
                <input @bind="_nyNavn" @bind:event="oninput" placeholder="＋ Ny dørfunksjon"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await OpprettFunksjon(); } })" />
                @if (!string.IsNullOrWhiteSpace(_nyNavn))
                {
                    <button type="button" class="df-knapp primaer" @onclick="OpprettFunksjon">Opprett</button>
                }
            </div>
        </nav>

        <section class="df-innhold">
            <button type="button" class="df-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>

            @if (_valgt is { } valgt)
            {
                <div class="df-topp">
                    <span class="df-kode stor @(string.IsNullOrWhiteSpace(valgt.Forkortelse) ? "tom" : "")">@(string.IsNullOrWhiteSpace(valgt.Forkortelse) ? "–" : valgt.Forkortelse)</span>
                    <h2>@valgt.Navn</h2>
                </div>

                <div class="df-skjema">
                    <label class="df-felt df-felt-kode">
                        <span>Forkortelse</span>
                        <input @bind="_redForkortelse" @bind:event="oninput" maxlength="8" placeholder="F.eks. KL" />
                    </label>
                    <label class="df-felt">
                        <span>Navn</span>
                        <input @bind="_redNavn" @bind:event="oninput" placeholder="F.eks. Kortleser"
                               @onkeydown="@(async e => { if (e.Key == "Enter") { await Lagre(); } })" />
                    </label>
                </div>

                <div class="df-bunn">
                    @if (valgt.IBruk)
                    {
                        <span class="df-dempet">Kan ikke slettes – den er i bruk.</span>
                    }
                    else if (_bekreftSlett)
                    {
                        <span class="df-dempet">Slette «@valgt.Navn»?</span>
                        <button type="button" class="df-knapp fare" @onclick="Slett">Ja, slett</button>
                        <button type="button" class="df-knapp" @onclick="@(() => _bekreftSlett = false)">Avbryt</button>
                    }
                    else
                    {
                        <button type="button" class="df-lenke" @onclick="@(() => _bekreftSlett = true)"><Icon Name="trash" />Slett</button>
                    }
                </div>
            }
            else
            {
                <p class="df-dempet">Velg en dørfunksjon i menyen.</p>
            }
        </section>
    </div>

    @if (Endret)
    {
        <div class="df-lagrebar">
            <span><Icon Name="edit" /><b>Endringer i «@_valgt!.Navn»</b> er ikke lagret</span>
            <span class="df-lagrebar-knapper">
                <button type="button" class="df-knapp" @onclick="Forkast">Forkast</button>
                <button type="button" class="df-knapp primaer" @onclick="Lagre"><Icon Name="check" />Lagre</button>
            </span>
        </div>
    }
</div>

@code {
    private sealed class FunksjonRad
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Forkortelse { get; set; }
        public bool IBruk { get; set; }
    }

    private List<FunksjonRad> _funksjoner = [];
    private string _search = "";
    private string _filter = "alle";
    private string _nyNavn = "";
    private string? _melding;
    private string? _feil;
    private int? _valgtId;
    private string _redNavn = "";
    private string _redForkortelse = "";
    private bool _bekreftSlett;
    private bool _full;

    private FunksjonRad? _valgt => _funksjoner.FirstOrDefault(f => f.Id == _valgtId);

    private bool Endret => _valgt is { } v
        && (_redNavn.Trim() != v.Navn || _redForkortelse.Trim() != (v.Forkortelse ?? ""));

    private List<FunksjonRad> _filtrert => _funksjoner
        .Where(f => _filter == "alle" || (_filter == "bruk") == f.IBruk)
        .Where(f => string.IsNullOrWhiteSpace(_search)
            || f.Navn.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (f.Forkortelse?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private static string Forbokstav(string navn) =>
        string.IsNullOrWhiteSpace(navn) ? "#" : char.IsLetter(navn.Trim()[0]) ? navn.Trim()[..1].ToUpperInvariant() : "#";

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("dorfunksjoner-bredde", "normal") == "full";
        await LoadAsync();
        if (_funksjoner.FirstOrDefault() is { } forste)
        {
            Velg(forste.Id);
        }
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("dorfunksjoner-bredde", _full ? "full" : "normal");
    }

    private async Task LoadAsync()
    {
        var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
        _funksjoner = (await Db.DorFunksjoner
            .Select(f => new FunksjonRad
            {
                Id = f.Id,
                Navn = f.Navn,
                Forkortelse = f.Forkortelse,
                IBruk = f.Dorer.Any() || f.Pakker.Any()
            })
            .ToListAsync())
            .OrderBy(f => f.Navn, StringComparer.Create(kultur, true))
            .ToList();
    }

    // Bytter man funksjon med ulagrede endringer, forkastes de (som å lukke).
    private void Velg(int id)
    {
        _valgtId = id;
        _bekreftSlett = false;
        _feil = null;
        var f = _valgt;
        _redNavn = f?.Navn ?? "";
        _redForkortelse = f?.Forkortelse ?? "";
    }

    private void Forkast()
    {
        if (_valgtId is int id)
        {
            Velg(id);
        }
    }

    private async Task Lagre()
    {
        if (_valgt is not { } rad)
        {
            return;
        }

        var navn = _redNavn.Trim();
        if (navn.Length == 0)
        {
            _feil = "Dørfunksjonen må ha et navn.";
            return;
        }

        var funksjon = await Db.DorFunksjoner.FirstOrDefaultAsync(f => f.Id == rad.Id);
        if (funksjon is null)
        {
            return;
        }

        funksjon.Navn = navn;
        funksjon.Forkortelse = string.IsNullOrWhiteSpace(_redForkortelse) ? null : _redForkortelse.Trim().ToUpperInvariant();
        await Db.SaveChangesAsync();

        _feil = null;
        _melding = $"«{navn}» er lagret.";
        await LoadAsync();
        Velg(rad.Id);
    }

    private async Task Slett()
    {
        if (_valgt is not { } rad)
        {
            return;
        }

        var funksjon = await Db.DorFunksjoner
            .Where(f => f.Id == rad.Id)
            .Select(f => new { Funksjon = f, IBruk = f.Dorer.Any() || f.Pakker.Any() })
            .FirstOrDefaultAsync();
        if (funksjon is null)
        {
            return;
        }

        // Sjekker på nytt - funksjonen kan ha blitt lagt på en dør siden siden ble lastet.
        if (funksjon.IBruk)
        {
            _feil = $"«{rad.Navn}» kan ikke slettes – den er i bruk.";
            await LoadAsync();
            return;
        }

        Db.DorFunksjoner.Remove(funksjon.Funksjon);
        await Db.SaveChangesAsync();
        _melding = $"«{rad.Navn}» er slettet.";
        await LoadAsync();
        if (_filtrert.FirstOrDefault() is { } forste)
        {
            Velg(forste.Id);
        }
        else
        {
            _valgtId = null;
        }
    }

    private async Task OpprettFunksjon()
    {
        var navn = _nyNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var ny = new DorFunksjon { Navn = navn };
        Db.DorFunksjoner.Add(ny);
        await Db.SaveChangesAsync();

        _nyNavn = "";
        _search = "";
        _filter = "alle";
        _melding = $"«{navn}» er opprettet. Legg inn forkortelsen til høyre.";
        await LoadAsync();
        Velg(ny.Id);
    }
}
