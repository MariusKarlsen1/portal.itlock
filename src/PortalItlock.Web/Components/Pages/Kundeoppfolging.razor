@page "/kundeoppfolging"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kundeoppfølging</PageTitle>

<div class="side-header">
    <div class="side-header-venstre">
        <span class="side-header-ikon"><Icon Name="clock" /></span>
        <div>
            <h1>Kundeoppfølging</h1>
            <p class="section-hint">Oversikt over kunder som bør følges opp, med logg over hva som er gjort og når dere bør ta kontakt igjen.</p>
        </div>
    </div>
    @if (AntallForfalt > 0)
    {
        <span class="forfalt-pill"><Icon Name="alert" />@AntallForfalt forfalt</span>
    }
</div>

<div class="sok-boks">
    <Icon Name="search" />
    <input @bind="_search" @bind:event="oninput" placeholder="Søk på navn, kontaktperson eller sted" />
</div>

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen kunder funnet.</p>
}
else
{
    <div class="oppfolging-liste">
        @foreach (var rad in _filtrert)
        {
            <div @key="rad.Kunde.Id" class="oppfolging-kort @(rad.ErForfalt ? "forfalt" : "")">
                <div class="oppfolging-header">
                    <div class="oppfolging-navn-rad">
                        <span class="oppfolging-avatar">@Initialer(rad.Kunde.Navn)</span>
                        <div>
                            <div class="oppfolging-navn">
                                @rad.Kunde.Navn
                                @if (!string.IsNullOrWhiteSpace(rad.Kunde.Kontaktperson))
                                {
                                    <span class="oppfolging-kontakt"> - @rad.Kunde.Kontaktperson</span>
                                }
                            </div>
                            <div class="oppfolging-kontaktinfo">
                                <span>📞 @(rad.Kunde.Telefon ?? "Ingen telefon")</span>
                                <span><Icon Name="mail" />@(rad.Kunde.Epost ?? "Ingen e-post")</span>
                            </div>
                        </div>
                    </div>
                    <a class="edit-link" href="@($"/kunder/{rad.Kunde.Id}")">Åpne kunde<Icon Name="arrow-left" /></a>
                </div>

                @if (rad.Notater.Count > 0)
                {
                    <div class="oppfolging-tidslinje">
                        @for (var i = 0; i < rad.Notater.Count; i++)
                        {
                            var notat = rad.Notater[i];
                            var erSiste = i == 0;
                            <div class="tidslinje-rad">
                                <div class="tidslinje-prikk-wrap">
                                    <span class="tidslinje-prikk @(erSiste ? "aktiv" : "")"></span>
                                    @if (i < rad.Notater.Count - 1)
                                    {
                                        <span class="tidslinje-linje"></span>
                                    }
                                </div>
                                <div class="tidslinje-tekst @(erSiste ? "" : "eldre")">
                                    @notat.Tekst
                                    <span class="tidslinje-dato">(@notat.OpprettetDato.ToString("dd.MM.yyyy"))</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (rad.VisLoggFelt)
                {
                    <div class="oppfolging-logg-felt">
                        <textarea rows="2" @bind="rad.NyttNotat" placeholder="Hva ble gjort/avtalt?"></textarea>
                        <div class="knapp-rad">
                            <button type="button" class="knapp knapp-primaer" @onclick="@(() => LeggTilNotat(rad))" disabled="@string.IsNullOrWhiteSpace(rad.NyttNotat)">Lagre</button>
                            <button type="button" class="knapp" @onclick="@(() => rad.VisLoggFelt = false)">Avbryt</button>
                        </div>
                    </div>
                }

                <div class="oppfolging-frist-rad">
                    @{ var frist = FristStatus(rad.NesteOppfolgingsDato); }
                    @if (frist is not null)
                    {
                        <span class="frist-pill @frist.Value.CssKlasse">@frist.Value.Tekst</span>
                    }
                    <label class="oppfolging-dato-felt">
                        Neste oppfølging
                        <input type="date" @bind="rad.NesteOppfolgingsDato" @bind:after="@(() => LagreDato(rad))" />
                    </label>
                    @if (!rad.VisLoggFelt)
                    {
                        <button type="button" class="knapp knapp-primaer knapp-frist" @onclick="@(() => rad.VisLoggFelt = true)">Logg oppfølging</button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private sealed class OppfolgingRad
    {
        public required Kunde Kunde { get; set; }
        public DateOnly? NesteOppfolgingsDato { get; set; }
        public List<KundeOppfolgingNotat> Notater { get; set; } = [];
        public bool ErForfalt { get; set; }
        public bool VisLoggFelt { get; set; }
        public string NyttNotat { get; set; } = "";
    }

    private List<OppfolgingRad> _alle = [];
    private string _search = "";
    private int AntallForfalt => _alle.Count(r => r.ErForfalt);

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private static (string CssKlasse, string Tekst)? FristStatus(DateOnly? neste)
    {
        if (!neste.HasValue)
        {
            return null;
        }

        var idag = DateOnly.FromDateTime(DateTime.Today);
        var dager = neste.Value.DayNumber - idag.DayNumber;
        if (dager < 0)
        {
            return ("frist-forfalt", dager == -1 ? "Forfalt 1 dag" : $"Forfalt {-dager} dager");
        }
        if (dager == 0)
        {
            return ("frist-snart", "I dag");
        }
        if (dager <= 7)
        {
            return ("frist-snart", dager == 1 ? "Om 1 dag" : $"Om {dager} dager");
        }
        return ("frist-senere", neste.Value.ToString("dd.MM.yyyy"));
    }

    private List<OppfolgingRad> _filtrert => (string.IsNullOrWhiteSpace(_search)
            ? _alle
            : _alle.Where(r =>
                    r.Kunde.Navn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (r.Kunde.Kontaktperson?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Kunde.Sted?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList())
        .OrderBy(r => r.NesteOppfolgingsDato ?? DateOnly.MaxValue)
        .ThenBy(r => r.Kunde.Navn)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LastInnAsync();
    }

    private async Task LastInnAsync()
    {
        var kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .ToListAsync();

        var kundeIder = kunder.Select(k => k.Id).ToList();
        var notater = await Db.KundeOppfolgingNotater
            .Where(n => kundeIder.Contains(n.KundeId))
            .OrderByDescending(n => n.OpprettetDato)
            .ToListAsync();

        var idag = DateOnly.FromDateTime(DateTime.Today);
        _alle = kunder.Select(k =>
        {
            var neste = k.NesteOppfolgingsDato.HasValue ? DateOnly.FromDateTime(k.NesteOppfolgingsDato.Value) : (DateOnly?)null;
            return new OppfolgingRad
            {
                Kunde = k,
                NesteOppfolgingsDato = neste,
                Notater = notater.Where(n => n.KundeId == k.Id).ToList(),
                ErForfalt = neste.HasValue && neste.Value <= idag
            };
        }).ToList();
    }

    private async Task LagreDato(OppfolgingRad rad)
    {
        var kunde = await Db.Kunder.FindAsync(rad.Kunde.Id);
        if (kunde is null)
        {
            return;
        }

        kunde.NesteOppfolgingsDato = rad.NesteOppfolgingsDato?.ToDateTime(TimeOnly.MinValue);
        await Db.SaveChangesAsync();

        var idag = DateOnly.FromDateTime(DateTime.Today);
        rad.ErForfalt = rad.NesteOppfolgingsDato.HasValue && rad.NesteOppfolgingsDato.Value <= idag;
    }

    private async Task LeggTilNotat(OppfolgingRad rad)
    {
        if (string.IsNullOrWhiteSpace(rad.NyttNotat))
        {
            return;
        }

        var notat = new KundeOppfolgingNotat
        {
            KundeId = rad.Kunde.Id,
            Tekst = rad.NyttNotat.Trim()
        };
        Db.KundeOppfolgingNotater.Add(notat);
        await Db.SaveChangesAsync();

        rad.Notater.Insert(0, notat);
        rad.NyttNotat = "";
        rad.VisLoggFelt = false;
    }
}
