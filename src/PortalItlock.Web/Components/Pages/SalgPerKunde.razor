@page "/rapporter/salg-per-kunde"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using PortalItlock.Web.Services
@inject TripletexService Tripletex

<PageTitle>Salg per kunde - itlock</PageTitle>

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="users" /></span>
    <div>
        <h1>Salg per kunde</h1>
        <p class="section-hint">
            Faktisk fakturert salg pr. kunde for valgt periode, hentet direkte fra
            Tripletex sine fakturaer (kreditnotaer trekkes fra). Dette er tallene som
            faktisk er sendt til kunden - se Rapporter &rarr; Kunde for portalens
            egen prognose basert på ferdigmeldte arbeidsordre.
        </p>
    </div>
</div>

<div class="kort filter-kort">
    <label class="felt">
        <span class="felt-label">Fra</span>
        <input type="date" @bind="_fraDato" />
    </label>
    <label class="felt">
        <span class="felt-label">Til</span>
        <input type="date" @bind="_tilDato" />
    </label>
    <button type="button" class="knapp-primaer" @onclick="HentRapport" disabled="@_lasterNa">
        @(_lasterNa ? "Henter..." : "Vis rapport")
    </button>
</div>

@if (_feil is not null)
{
    <p class="form-error">@_feil</p>
}

@if (_harHentet)
{
    @if (_rader.Count == 0)
    {
        <p class="list-empty">Ingen fakturert salg i denne perioden.</p>
    }
    else
    {
        <div class="kort stat-kort">
            <span class="stat-label">Total omsetning</span>
            <span class="stat-verdi">@_rader.Sum(r => r.Sum).ToString("N0", Kultur) kr</span>
        </div>

        <div class="kort tabell-kort">
            <table class="rapport-table">
                <thead>
                    <tr>
                        <th class="plass-cell">#</th>
                        <th>Kunde</th>
                        <th class="tall-cell">Antall fakturaer</th>
                        <th class="tall-cell">Omsetning</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var plass = 0; }
                    @foreach (var r in _rader)
                    {
                        plass++;
                        <tr>
                            <td class="plass-cell">@plass</td>
                            <td><span class="avatar">@Initialer(r.Navn)</span>@r.Navn</td>
                            <td class="tall-cell">@r.Antall</td>
                            <td class="tall-cell">@r.Sum.ToString("N0", Kultur) kr</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">Totalt</td>
                        <td></td>
                        <td class="tall-cell">@_rader.Sum(r => r.Sum).ToString("N0", Kultur) kr</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private DateTime _fraDato = new(DateTime.Today.Year, 1, 1);
    private DateTime _tilDato = DateTime.Today;
    private bool _lasterNa;
    private bool _harHentet;
    private string? _feil;

    private sealed record KundeRad(string Navn, int Antall, decimal Sum);
    private List<KundeRad> _rader = [];

    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }

        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0].Length >= 2 ? deler[0][..2].ToUpperInvariant() : deler[0][..1].ToUpperInvariant(),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpperInvariant()
        };
    }

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _lasterNa = true;
        _feil = null;
        try
        {
            var (fakturaer, feil) = await Tripletex.HentFakturaerAsync(_fraDato, _tilDato);
            if (feil is not null)
            {
                _feil = feil;
                _rader = [];
            }
            else
            {
                _rader = fakturaer
                    .Where(f => f.KundeNavn is not null)
                    .GroupBy(f => f.KundeNavn!)
                    .Select(g => new KundeRad(
                        g.Key,
                        g.Count(),
                        g.Sum(f => f.ErKreditnota ? -f.Belop : f.Belop)))
                    .OrderByDescending(r => r.Sum)
                    .ToList();
            }
            _harHentet = true;
        }
        finally
        {
            _lasterNa = false;
        }
    }
}
