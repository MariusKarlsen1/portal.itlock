@page "/rapporter/salg-per-kunde"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject TripletexService Tripletex
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Salg per kunde - Full Kontroll</PageTitle>

@* S3 (Prototype salg per kunde.html): samme kort som de andre rapportene. Salget deles i felt
   per kundetype (fra kundekortet, matchet på navn) som kan klikkes for å filtrere tabellen. *@
<RapportRamme Tittel="Salg per kunde" Undertittel="Fakturerte arbeidsordre og kassasalg, kreditnotaer trukket fra" Ikon="users" Kilde="portal"
              KildeTekst="Fra portalen – fakturerte ordre og kassa"
              Periode="_periode" OnPeriodeEndret="HentRapport" VisSammenlign="true" Laster="_laster" OnEksporter="Eksporter"
              SomKundekort="true" Gruppe="Salg og kunder">
    <Handlinger>
        <button type="button" class="rr-knapp" @onclick="HentRapport" disabled="@_laster">↻ Oppdater</button>
        <a class="rr-knapp" href="/rapporter/kunde">Kunderapport (portalen)</a>
    </Handlinger>
    <ChildContent>
        @if (_feil is not null)
        {
            <p class="rr-feil">@_feil</p>
        }
        else if (_harHentet && _rader.Count == 0)
        {
            <p class="rr-tom">Ingen fakturert salg i denne perioden.</p>
        }
        else if (_harHentet)
        {
            var total = _rader.Sum(r => r.Sum);
            var antallFakturaer = _rader.Sum(r => r.Antall);
            decimal? totalFor = Sml ? _forrige.Values.Sum(f => f.Sum) : null;
            var ikkeFakturert = _rader.Sum(IkkeFakturert) + _bareIPortalen.Values.Sum();
            var kunderIkkeFakturert = _rader.Count(r => IkkeFakturert(r) > 0) + _bareIPortalen.Count;
            var typer = _rader.GroupBy(r => r.Type)
                .Select(g => (Type: g.Key, Sum: g.Sum(r => r.Sum), Antall: g.Count()))
                .OrderBy(t => t.Type is null).ThenByDescending(t => t.Sum)
                .ToList();
            <div class="rr-kpis">
                <div class="rr-kpi"><small>Fakturert</small><b>@RapportPeriode.Kr(total)</b><span><RapportDelta Naa="total" For="totalFor" /> @(Sml ? $"mot {_periode.SmlTekst}" : "i perioden")</span></div>
                <div class="rr-kpi"><small>Kunder</small><b>@_rader.Count</b><span>med minst én faktura</span></div>
                <div class="rr-kpi"><small>Fakturaer</small><b>@antallFakturaer</b><span>snitt @RapportPeriode.Kr(antallFakturaer == 0 ? 0 : total / antallFakturaer)</span></div>
                <div class="rr-kpi @(ikkeFakturert > 0 ? "gul" : "")" title="Ferdigmeldte arbeidsordre i portalen i samme periode som er mer enn det som er fakturert, per kunde."><small>Ferdigmeldt, ikke fakturert</small><b>@RapportPeriode.Kr(ikkeFakturert)</b><span>på @kunderIkkeFakturert @(kunderIkkeFakturert == 1 ? "kunde" : "kunder")</span></div>
            </div>

            <div class="rr-tile">
                <div class="rr-tile-t"><h2>Per kundetype</h2><small>Klikk for å filtrere</small></div>
                <div class="spk-typer">
                    @foreach (var t in typer)
                    {
                        var type = t.Type;
                        <button type="button" class="spk-type @(ErValgt(type) ? "pa" : "")" @onclick="() => VelgType(type)">
                            <small>@TypeNavn(type) · @t.Antall @(t.Antall == 1 ? "kunde" : "kunder")</small>
                            <b>@RapportPeriode.Kr(t.Sum)</b>
                            <span class="spk-linje"><i style="width:@Pst(t.Sum, total)"></i></span>
                        </button>
                    }
                </div>
            </div>

            <div class="rr-tile">
                <div class="rr-tile-t">
                    <h2>Fakturert per kunde</h2>
                    <span class="spk-verktoy">
                        <span class="spk-chips">
                            <button type="button" class="spk-chip @(!_typeValgt ? "pa" : "")" @onclick="() => _typeValgt = false">Alle</button>
                            @foreach (var t in typer)
                            {
                                var type = t.Type;
                                <button type="button" class="spk-chip @(ErValgt(type) ? "pa" : "")" @onclick="() => { _typeValgt = true; _type = type; }">@TypeNavn(type)</button>
                            }
                        </span>
                        <label class="rr-sok"><Icon Name="search" /><input type="search" placeholder="Finn kunde …" @bind="_sok" @bind:event="oninput" /></label>
                    </span>
                </div>
                @{
                    var liste = _rader
                        .Where(r => !_typeValgt || r.Type == _type)
                        .Where(r => string.IsNullOrWhiteSpace(_sok) || r.Navn.Contains(_sok.Trim(), StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    var maks = _rader.Count == 0 ? 0 : _rader.Max(r => r.Sum);
                    var listeSum = liste.Sum(r => r.Sum);
                    var listeAntall = liste.Sum(r => r.Antall);
                    var listeFor = liste.Sum(ForrigeSum);
                }
                <div class="rr-tabwrap">
                    <table class="rr-tab">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Kunde</th>
                                <th>Kundetype</th>
                                <th>Andel</th>
                                <th class="n">Fakturaer</th>
                                <th class="n">Snitt</th>
                                <th class="n">Fakturert</th>
                                @if (Sml)
                                {
                                    <th class="n">@(char.ToUpper(_periode.SmlTekst[0]) + _periode.SmlTekst[1..])</th>
                                    <th class="n">Endring</th>
                                }
                                <th class="n" title="Ferdigmeldt i portalen, ikke fakturert">Ikke fakturert</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (r, i) in liste.Select((r, i) => (r, i)))
                            {
                                var ikke = IkkeFakturert(r);
                                var f = ForrigeSum(r);
                                <tr>
                                    <td class="plass">@(i + 1)</td>
                                    <td><span class="rr-navn spk-navn"><span class="rr-av">@RapportData.Initialer(r.Navn)</span><span>@r.Navn</span></span></td>
                                    <td><span class="spk-tp @(r.Type is KundeType.Privatperson or null ? "" : "b")">@TypeNavn(r.Type)</span></td>
                                    <td><span class="rr-andel"><span class="rr-bar"><i style="width:@Pst(r.Sum, maks)"></i></span><span>@RapportPeriode.Prosent(r.Sum, total)</span></span></td>
                                    <td class="n">@r.Antall</td>
                                    <td class="n">@RapportPeriode.Kr(r.Antall == 0 ? 0 : r.Sum / r.Antall)</td>
                                    <td class="n"><b>@RapportPeriode.Kr(r.Sum)</b></td>
                                    @if (Sml)
                                    {
                                        <td class="n dempet">@(f == 0 ? "–" : RapportPeriode.Kr(f))</td>
                                        <td class="n"><RapportDelta Naa="r.Sum" For="f" /></td>
                                    }
                                    <td class="n">@if (ikke > 0){<span class="rr-pille rr-p-gul">@RapportPeriode.Kr(ikke)</span>}else{<span class="dempet">–</span>}</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Totalt (@liste.Count @(liste.Count == 1 ? "kunde" : "kunder"))</td>
                                <td class="n">@listeAntall</td>
                                <td class="n">@RapportPeriode.Kr(listeAntall == 0 ? 0 : listeSum / listeAntall)</td>
                                <td class="n">@RapportPeriode.Kr(listeSum)</td>
                                @if (Sml)
                                {
                                    <td class="n dempet">@RapportPeriode.Kr(listeFor)</td>
                                    <td class="n"><RapportDelta Naa="listeSum" For="listeFor" /></td>
                                }
                                <td class="n">@RapportPeriode.Kr(liste.Sum(IkkeFakturert))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (_bareIPortalen.Count > 0)
            {
                <div class="rr-merk">
                    <span>⚠️</span>
                    <span>
                        <b>@_bareIPortalen.Count @(_bareIPortalen.Count == 1 ? "kunde har" : "kunder har") ferdigmeldte arbeidsordre for @RapportPeriode.Kr(_bareIPortalen.Values.Sum()), men ingen faktura i perioden:</b>
                        @string.Join(", ", _bareIPortalen.OrderByDescending(x => x.Value).Take(6).Select(x => x.Key))@(_bareIPortalen.Count > 6 ? " …" : "").
                    </span>
                </div>
            }
        }
    </ChildContent>
</RapportRamme>

@code {
    private readonly RapportPeriode _periode = new();
    private bool _laster;
    private bool _harHentet;
    private string? _feil;
    private DateTime? _hentet;
    private string _sok = "";
    private bool _typeValgt;
    private KundeType? _type;

    private sealed record KundeRad(string Navn, int Antall, decimal Sum, KundeType? Type = null);
    private List<KundeRad> _rader = [];
    private Dictionary<string, KundeRad> _forrige = [];
    // Portalens ferdigmeldte omsetning per kunde (samme periode), matchet på navn.
    private Dictionary<string, decimal> _portal = [];
    private Dictionary<string, decimal> _bareIPortalen = [];

    private bool Sml => _periode.Sammenlign;

    private static string Nokkel(string navn) => navn.Trim().ToLowerInvariant();

    private static string TypeNavn(KundeType? t) => t?.Visningsnavn() ?? "Ikke satt";

    private bool ErValgt(KundeType? t) => _typeValgt && _type == t;

    private void VelgType(KundeType? t)
    {
        if (ErValgt(t))
        {
            _typeValgt = false;
            return;
        }
        _typeValgt = true;
        _type = t;
    }

    private decimal ForrigeSum(KundeRad r) => _forrige.TryGetValue(Nokkel(r.Navn), out var f) ? f.Sum : 0;

    private decimal IkkeFakturert(KundeRad r) =>
        Math.Max(0, _portal.GetValueOrDefault(Nokkel(r.Navn)) - r.Sum);

    private static string Pst(decimal del, decimal total) =>
        (total == 0 ? 0 : Math.Max(0, del) / total * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static List<KundeRad> Grupper(List<TripletexService.TripletexFaktura> fakturaer) => fakturaer
        .Where(f => f.KundeNavn is not null)
        .GroupBy(f => f.KundeNavn!)
        .Select(g => new KundeRad(g.Key, g.Count(), g.Sum(f => f.ErKreditnota ? -f.Belop : f.Belop)))
        .OrderByDescending(r => r.Sum)
        .ToList();

    protected override async Task OnInitializedAsync() => await HentRapport();

    private async Task HentRapport()
    {
        _laster = true;
        _feil = null;
        try
        {
            var (fakturaer, feil) = await PortalFakturaer.HentAsync(Db, _periode.Fra, _periode.Til);
            if (feil is not null)
            {
                _feil = feil;
                _rader = [];
                _harHentet = true;
                return;
            }

            // Kundetypen settes på kundekortet og matches på navn.
            var typer = (await Db.Kunder.AsNoTracking().Select(k => new { k.Navn, k.Type }).ToListAsync())
                .GroupBy(k => Nokkel(k.Navn))
                .ToDictionary(g => g.Key, g => g.Select(k => k.Type).FirstOrDefault(t => t is not null));
            _rader = Grupper(fakturaer)
                .Select(r => r with { Type = typer.GetValueOrDefault(Nokkel(r.Navn)) })
                .ToList();
            if (_typeValgt && !_rader.Any(r => r.Type == _type))
            {
                _typeValgt = false;
            }
            _hentet = DateTime.Now;

            _forrige = [];
            if (Sml)
            {
                var (forrige, forrigeFeil) = await PortalFakturaer.HentAsync(Db, _periode.SmlFra, _periode.SmlTil);
                if (forrigeFeil is null)
                {
                    _forrige = Grupper(forrige).GroupBy(r => Nokkel(r.Navn)).ToDictionary(g => g.Key, g => g.First());
                }
            }

            var portalPerKunde = (await RapportData.HentAsync(Db, _periode.Fra, _periode.Til))
                .Where(o => o.Kunde is not null)
                .GroupBy(o => Nokkel(o.Kunde!.Navn))
                .ToList();
            _portal = portalPerKunde.ToDictionary(g => g.Key, g => g.Sum(o => o.Sum));
            var visningsnavn = portalPerKunde.ToDictionary(g => g.Key, g => g.First().Kunde!.Navn);

            var fakturerteNavn = _rader.Select(r => Nokkel(r.Navn)).ToHashSet();
            _bareIPortalen = _portal
                .Where(x => x.Value > 0 && !fakturerteNavn.Contains(x.Key))
                .ToDictionary(x => visningsnavn.GetValueOrDefault(x.Key, x.Key), x => x.Value);

            _harHentet = true;
        }
        finally
        {
            _laster = false;
        }
    }

    private async Task Eksporter()
    {
        var rader = new List<object?[]> { new object?[] { "Plass", "Kunde", "Kundetype", "Fakturaer", "Fakturert", Sml ? $"Sammenligning ({_periode.SmlTekst})" : null, "Ferdigmeldt, ikke fakturert" } };
        rader.AddRange(_rader.Select((r, i) => new object?[]
        {
            i + 1, r.Navn, TypeNavn(r.Type), r.Antall, r.Sum, Sml ? ForrigeSum(r) : null, IkkeFakturert(r)
        }));
        await JS.InvokeVoidAsync("rapport.lastNedCsv", $"Salg per kunde {_periode.Tekst}.csv", RapportData.Csv(rader));
    }
}
