@page "/oppsettmodul"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<PageTitle>Oppsett og maler - itlock</PageTitle>

<h1>Oppsett og maler</h1>
<p class="section-hint">Opprett og vedlikehold dørpakker, krav, sjekklister, tilvalg og dokumenter som brukes andre steder i portalen.</p>

<div class="modul-grid">
    <a href="/ny-pakke" class="modul-card">
        <Icon Name="box" />
        <span class="modul-card-title">Ny pakke</span>
        <span class="modul-card-desc">Sett sammen en ny dørpakke, eller rediger en eksisterende.</span>
    </a>
    <a href="/kravdimensjoner" class="modul-card">
        <Icon Name="check-circle" />
        <span class="modul-card-title">Kravdimensjoner</span>
        <span class="modul-card-desc">Vedlikehold kravkategoriene kravvelgeren bygger på.</span>
    </a>
    <a href="/dorfunksjoner" class="modul-card">
        <Icon Name="tool" />
        <span class="modul-card-title">Dørfunksjoner</span>
        <span class="modul-card-desc">Opprett og vedlikehold dørfunksjoner som kan legges på dører.</span>
    </a>
    <a href="/sjekklistemaler" class="modul-card">
        <Icon Name="alert" />
        <span class="modul-card-title">Sjekklistemaler</span>
        <span class="modul-card-desc">Digitale sjekklister per dørtype til bruk på arbeidsordre.</span>
    </a>
    <a href="/service-sjekklistemal" class="modul-card">
        <Icon Name="clock" />
        <span class="modul-card-title">Sjekkliste for servicerunder</span>
        <span class="modul-card-desc">Punktene som automatisk legges til hver servicerunde.</span>
    </a>
    <a href="/tilvalg" class="modul-card">
        <Icon Name="tag" />
        <span class="modul-card-title">Tilvalg</span>
        <span class="modul-card-desc">Publiserte og besvarte tilvalg på tvers av prosjekter.</span>
    </a>
    <a href="/tilvalgmaler" class="modul-card">
        <Icon Name="receipt" />
        <span class="modul-card-title">Tilvalgsmaler</span>
        <span class="modul-card-desc">Ferdige maler med alternativer, bilder og priser til gjenbruk.</span>
    </a>
    <a href="/forsider" class="modul-card">
        <Icon Name="folder" />
        <span class="modul-card-title">Forsider</span>
        <span class="modul-card-desc">Lag forside-/forbeholdstekster til bruk på tilbud.</span>
    </a>
    <a href="/timeoversikt" class="modul-card">
        <Icon Name="calendar" />
        <span class="modul-card-title">Timeoversikt</span>
        <span class="modul-card-desc">Sammendrag og eksport av timer til lønn.</span>
    </a>
    <a href="/hjemmesidetekster" class="modul-card">
        <Icon Name="users" />
        <span class="modul-card-title">Hjemmesidetekster</span>
        <span class="modul-card-desc">Rediger overskrift, ingress og rolle-tekstene på forsiden.</span>
    </a>
</div>
