@page "/tilbud-service"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Tilbud service</PageTitle>

@* Kanban-visningen er som før. Listevisningen er L1-G (tilbud-service-liste-forslag.html):
   ett kort med nøkkeltall i én ramme og tabell over utkast og tilbud sendt til kunde,
   med sum og "hos kunden" som en linje som fylles opp mot 30 dager. *@
@if (_visning == Visning.Kanban)
{
<div class="tilbud-service-side">
<div class="side-header">
    <span class="side-header-ikon"><Icon Name="file-text" /></span>
    <div>
        <h1>Tilbud</h1>
        <p class="section-hint">Tilbud for serviceavtaler - samme oppsett som et vanlig tilbud, men montasje-minuttene som fylles inn per vare hentes fra arbeidsordre-minuttene i komponentregisteret, siden det ikke finnes dører å beregne fra.</p>
    </div>
</div>

@if (_tilbud.Count > 0)
{
    <div class="stat-rad">
        <div class="stat-kort">
            <span class="stat-kort-ikon stat-kort-ikon-accent"><Icon Name="file-text" /></span>
            <div><span class="stat-kort-tall">@_tilbud.Count</span><span class="stat-kort-lbl">Totalt antall tilbud</span></div>
            <span class="stat-kort-spark"><svg viewBox="0 0 22 16"><rect x="0" y="9" width="3" height="7" rx="1" /><rect x="5" y="5" width="3" height="11" rx="1" /><rect x="10" y="7" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="16" rx="1" /></svg></span>
        </div>
        <div class="stat-kort">
            <span class="stat-kort-ikon stat-kort-ikon-noytral"><Icon Name="file-text" /></span>
            <div><span class="stat-kort-tall">@AntallMedStatus(EndringsmeldingStatus.Utkast)</span><span class="stat-kort-lbl">Utkast</span></div>
            <span class="stat-kort-spark"><svg viewBox="0 0 22 16"><rect x="0" y="9" width="3" height="7" rx="1" /><rect x="5" y="5" width="3" height="11" rx="1" /><rect x="10" y="7" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="16" rx="1" /></svg></span>
        </div>
        <div class="stat-kort">
            <span class="stat-kort-ikon stat-kort-ikon-gul"><Icon Name="mail" /></span>
            <div><span class="stat-kort-tall">@AntallMedStatus(EndringsmeldingStatus.SendtTilKunde)</span><span class="stat-kort-lbl">Sendt til kunde</span></div>
            <span class="stat-kort-spark"><svg viewBox="0 0 22 16"><rect x="0" y="9" width="3" height="7" rx="1" /><rect x="5" y="5" width="3" height="11" rx="1" /><rect x="10" y="7" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="16" rx="1" /></svg></span>
        </div>
        <div class="stat-kort">
            <span class="stat-kort-ikon stat-kort-ikon-gronn"><Icon Name="check-circle" /></span>
            <div><span class="stat-kort-tall">@AntallMedStatus(EndringsmeldingStatus.Godkjent)</span><span class="stat-kort-lbl">Godkjent</span></div>
            <span class="stat-kort-spark"><svg viewBox="0 0 22 16"><rect x="0" y="9" width="3" height="7" rx="1" /><rect x="5" y="5" width="3" height="11" rx="1" /><rect x="10" y="7" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="16" rx="1" /></svg></span>
        </div>
        <div class="stat-kort">
            <span class="stat-kort-ikon stat-kort-ikon-accent"><Icon Name="trend-up" /></span>
            <div><span class="stat-kort-tall">@VerdiSendtTilKunde.ToString("N0", Kultur) kr</span><span class="stat-kort-lbl">Verdi sendt til kunde</span></div>
            <span class="stat-kort-spark"><svg viewBox="0 0 22 16"><rect x="0" y="9" width="3" height="7" rx="1" /><rect x="5" y="5" width="3" height="11" rx="1" /><rect x="10" y="7" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="16" rx="1" /></svg></span>
        </div>
    </div>
}

<div class="kort">
    <h2>Ny tilbud service</h2>
    <div class="felt-grid">
        <label>
            Navn på avtalen/tilbudet
            <input @bind="_nyttNavn" @bind:event="oninput" placeholder="F.eks. Storgata 5 - service" />
        </label>
        <label>
            Kunde (valgfritt)
            <select @bind="_valgtKundeId">
                <option value="">Ingen kunde satt</option>
                @foreach (var k in _kunder)
                {
                    <option value="@k.Id">@k.Navn</option>
                }
            </select>
        </label>
        <label>
            Adresse (valgfritt)
            <input @bind="_nyAdresse" @bind:event="oninput" placeholder="F.eks. Storgata 5" />
        </label>
    </div>
    <button type="button" class="knapp knapp-primaer" @onclick="OpprettTilbudService" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Opprett tilbud service</button>
</div>

@if (_tilbud.Count > 0)
{
    <div class="verktoy-rad">
        <div class="sok-boks">
            <Icon Name="search" />
            <input @bind="_sok" @bind:event="oninput" placeholder="Søk på navn eller kunde..." />
        </div>
        <div class="visning-veksler">
            <button type="button" class="visning-knapp @(_visning == Visning.Kanban ? "visning-knapp-aktiv" : "")" @onclick="@(() => VelgVisning(Visning.Kanban))">
                <Icon Name="box" />Kanban
            </button>
            <button type="button" class="visning-knapp @(_visning == Visning.Liste ? "visning-knapp-aktiv" : "")" @onclick="@(() => VelgVisning(Visning.Liste))">
                <Icon Name="file-text" />Liste
            </button>
        </div>
        <a class="arkiv-lenke" href="/tilbud-service/godkjent"><Icon Name="check-circle" />Godkjente</a>
        <a class="arkiv-lenke" href="/tilbud-service/avslatt"><Icon Name="x" />Avslåtte</a>
        <span class="stat-chip"><span class="dot"></span>@_synlige.Count tilbud</span>
    </div>
}

@if (_tilbud.Count == 0)
{
    <p class="list-empty">Ingen tilbud service opprettet ennå.</p>
}
else if (_synlige.Count == 0)
{
    <p class="list-empty">Ingen treff.</p>
}
else
{
    <div class="tilbud-tavle">
        @foreach (var status in TavleStatuser)
        {
            var tilbudIKolonne = _synlige.Where(t => t.Status == status).ToList();
            <div class="tilbud-kolonne tilbud-kolonne-@status.PillFarge()">
                <div class="tilbud-kolonne-header">
                    <span class="tilbud-kolonne-tittel"><span class="tilbud-kolonne-prikk"></span>@status.Visningsnavn() <span class="tilbud-kolonne-antall">@tilbudIKolonne.Count</span></span>
                    @{ var sum = tilbudIKolonne.Sum(t => t.SendtSum ?? 0); }
                    @if (sum > 0)
                    {
                        <span class="tilbud-kolonne-sum">@sum.ToString("N0", Kultur) kr</span>
                    }
                </div>
                <div class="tilbud-kort-stabel">
                    @if (tilbudIKolonne.Count == 0)
                    {
                        <div class="tilbud-kolonne-tom">
                            <Icon Name="check-circle" />
                            <span>Ingen her akkurat nå</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in tilbudIKolonne)
                        {
                            <div @key="t.TilbudId" class="tilbud-kort-wrap">
                            <a class="tilbud-kort tilbud-kort-@status.PillFarge()" href="@($"/tilbud/{t.TilbudId}")">
                                <span class="tilbud-kort-tittel">@t.Tittel</span>
                                <span class="tilbud-kort-linje">
                                    <Icon Name="users" />
                                    <span>@(t.KundeNavn ?? "Ingen kunde satt")</span>
                                </span>
                                <div class="tilbud-kort-bunn">
                                    @if (t.SendtSum is { } sendtSum)
                                    {
                                        <span class="tilbud-kort-sum">@sendtSum.ToString("N0", Kultur) kr</span>
                                    }
                                    else
                                    {
                                        <span class="tilbud-kort-dato">Opprettet @t.OpprettetDato.ToString("dd.MM.yyyy")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.ProsjektlederNavn))
                                    {
                                        <span class="tilbud-kort-avatar" title="@t.ProsjektlederNavn">@Initialer(t.ProsjektlederNavn)</span>
                                    }
                                </div>
                            </a>
                            <span class="tilbud-kort-meny"><RadMeny Navn="@t.Tittel" RedigerHref="@($"/tilbud/{t.TilbudId}")" OnSlett="@(() => { _slettId = t.TilbudId; _slettNavn = t.Tittel; })" /></span>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
</div>
}
else
{
<div class="tilbud-service-side ts-kort @(_full ? "ts-full" : "")">
    <button type="button" class="ts-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>

    <div class="ts-topp">
        <div>
            <h1>Tilbud service</h1>
            <p>Tilbud for serviceavtaler. Montasje-minuttene hentes fra arbeidsordre-minuttene i komponentregisteret, siden det ikke finnes dører å beregne fra.</p>
        </div>
        <div class="ts-handl">
            <a class="ts-kn" href="/tilbud-service/godkjent"><Icon Name="check-circle" />Godkjente</a>
            <a class="ts-kn" href="/tilbud-service/avslatt"><Icon Name="x" />Avslåtte</a>
            <button type="button" class="ts-kn ts-kn-p" @onclick="@(() => _visNytt = !_visNytt)"><Icon Name="plus" />Nytt tilbud</button>
        </div>
    </div>

    @if (_visNytt)
    {
        <div class="ts-ny">
            <b>Nytt tilbud service</b>
            <div class="ts-ny-felt">
                <input @bind="_nyttNavn" @bind:event="oninput" placeholder="Navn, f.eks. Storgata 5 - service" />
                <select @bind="_valgtKundeId">
                    <option value="">Ingen kunde satt</option>
                    @foreach (var k in _kunder)
                    {
                        <option value="@k.Id">@k.Navn</option>
                    }
                </select>
                <input @bind="_nyAdresse" @bind:event="oninput" placeholder="Adresse (valgfritt)" />
                <button type="button" class="ts-kn ts-kn-p" @onclick="OpprettTilbudService" disabled="@string.IsNullOrWhiteSpace(_nyttNavn)">Opprett</button>
            </div>
        </div>
    }

    @if (_tilbud.Count > 0)
    {
        var sendt = Aktive.Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde).ToList();
        var utkast = Aktive.Where(t => t.Status == EndringsmeldingStatus.Utkast).ToList();
        var lenge = sendt.Where(t => t.DagerHosKunden > 14).OrderByDescending(t => t.DagerHosKunden).ToList();
        <div class="ts-kpi">
            <div class="ts-kpi-hoved">
                <span class="ts-lbl">Til oppfølging</span>
                <b>@Kr(sendt.Sum(t => t.Sum))</b>
                <small>@sendt.Count @(sendt.Count == 1 ? "tilbud" : "tilbud") sendt til kunde</small>
            </div>
            <div class="@(lenge.Count > 0 ? "rod" : "")">
                <span class="ts-lbl">Venter over 14 dager</span>
                <b>@lenge.Count</b>
                <small>@(lenge.FirstOrDefault() is { } eldst ? $"{eldst.Tittel} – {eldst.DagerHosKunden} dager" : "ingen venter lenge")</small>
            </div>
            <div>
                <span class="ts-lbl">Utkast</span>
                <b>@utkast.Count</b>
                <small>@Kr(utkast.Sum(t => t.Sum)) · ikke sendt ennå</small>
            </div>
            <div>
                <span class="ts-lbl">Snitt tid hos kunden</span>
                <b>@(sendt.Count == 0 ? "–" : $"{Math.Round(sendt.Average(t => t.DagerHosKunden ?? 0))} dager")</b>
                <small>for tilbud som venter på svar</small>
            </div>
        </div>

        <div class="ts-verktoy">
            <label class="ts-sok">
                <Icon Name="search" />
                <input @bind="_sok" @bind:event="oninput" placeholder="Søk på tilbud eller kunde..." />
            </label>
            @if (_visning == Visning.Liste)
            {
                <button type="button" class="ts-chip @(_filter == "alle" ? "pa" : "")" @onclick='@(() => _filter = "alle")'>Alle <i>@Aktive.Count</i></button>
                <button type="button" class="ts-chip @(_filter == "utkast" ? "pa" : "")" @onclick='@(() => _filter = "utkast")'>Utkast <i>@utkast.Count</i></button>
                <button type="button" class="ts-chip @(_filter == "sendt" ? "pa" : "")" @onclick='@(() => _filter = "sendt")'>Sendt til kunde <i>@sendt.Count</i></button>
            }
            <div class="ts-seg">
                <button type="button" class="@(_visning == Visning.Kanban ? "aktiv" : "")" @onclick="@(() => VelgVisning(Visning.Kanban))"><Icon Name="box" />Kanban</button>
                <button type="button" class="@(_visning == Visning.Liste ? "aktiv" : "")" @onclick="@(() => VelgVisning(Visning.Liste))"><Icon Name="file-text" />Liste</button>
            </div>
        </div>
    }

@if (_tilbud.Count == 0)
{
    <p class="list-empty">Ingen tilbud service opprettet ennå.</p>
}
else
{
    var liste = Listerader;
    if (liste.Count == 0)
    {
        <p class="list-empty">@(string.IsNullOrWhiteSpace(_sok) ? "Ingen utkast eller tilbud sendt til kunde." : "Ingen utkast eller tilbud sendt til kunde som passer søket.")</p>
    }
    else
    {
        <div class="ts-tabwrap">
            <table class="ts-tab">
                <thead>
                    <tr>
                        <th>Tilbud</th>
                        <th>Status</th>
                        <th>Sendt</th>
                        <th class="ts-hos">Hos kunden</th>
                        <th class="ts-h">Sum eks. mva</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in liste)
                    {
                        <tr @key="t.TilbudId" @onclick="@(() => Nav.NavigateTo($"/tilbud/{t.TilbudId}"))">
                            <td>
                                <span class="ts-tilbud">
                                    <span class="ts-av" style="background:@Farge(t.KundeNavn ?? t.Tittel)">@Initialer(t.KundeNavn ?? t.Tittel)</span>
                                    <span class="ts-tilbud-tekst">
                                        <b>@t.Tittel</b>
                                        <small>@(t.KundeNavn ?? "Ingen kunde satt") · #@t.TilbudId</small>
                                    </span>
                                </span>
                            </td>
                            <td><StatusPill Tekst="@t.Status.Visningsnavn()" Ikon="@t.Status.PillIkon()" Farge="@t.Status.PillFarge()" /></td>
                            <td>@(t.SendtDato?.ToLocalTime().ToString("dd.MM.yyyy") ?? "ikke sendt")</td>
                            <td class="ts-hos">
                                @if (t.DagerHosKunden is int dager)
                                {
                                    <span class="ts-vent ts-vent-@VentKlasse(dager)">
                                        <span class="ts-vent-linje"><i style="width:@Math.Min(100, dager * 100 / 30)%"></i></span>
                                        <b>@dager d</b>
                                    </span>
                                }
                                else
                                {
                                    <span class="ts-mut">–</span>
                                }
                            </td>
                            <td class="ts-h"><b>@(t.Sum > 0 ? Kr(t.Sum) : "–")</b></td>
                            <td class="ts-h">
                                <a class="ts-kn ts-kn-s @(t.Status == EndringsmeldingStatus.Utkast || t.DagerHosKunden > 14 ? "ts-kn-p" : "")" href="@($"/tilbud/{t.TilbudId}")" @onclick:stopPropagation="true">
                                    @(t.Status == EndringsmeldingStatus.Utkast ? "Send til kunde" : "Følg opp")
                                </a>
                                <span class="ts-meny" @onclick:stopPropagation="true"><RadMeny Navn="@t.Tittel" RedigerHref="@($"/tilbud/{t.TilbudId}")" OnSlett="@(() => { _slettId = t.TilbudId; _slettNavn = t.Tittel; })" /></span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Sum &ndash; @liste.Count tilbud</td>
                        <td class="ts-h">@Kr(liste.Sum(t => t.Sum))</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}
</div>
}

<SlettDialog Type="SletteType.Tilbud" Id="_slettId" Navn="@_slettNavn" OnLukk="@(() => _slettId = null)" OnSlettet="TilbudSlettet" />

@code {
    private sealed class KundeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private sealed class TilbudRad
    {
        public int TilbudId { get; set; }
        public string Tittel { get; set; } = "";
        public string? KundeNavn { get; set; }
        public DateTime OpprettetDato { get; set; }
        public EndringsmeldingStatus Status { get; set; }
        public decimal? SendtSum { get; set; }
        public string? ProsjektlederNavn { get; set; }
        public DateTime? AvslattDato { get; set; }
        public DateTime? SendtDato { get; set; }

        // Summen kunden fikk, eller for utkast det tilbudet står på nå.
        public decimal Sum { get; set; }

        // Hvor lenge tilbudet har ligget hos kunden (bare for sendte tilbud).
        public int? DagerHosKunden => Status == EndringsmeldingStatus.SendtTilKunde && SendtDato is { } d
            ? Math.Max(0, (DateTime.Today - d.ToLocalTime().Date).Days)
            : null;

        // Godkjent tilbud forsvinner fra denne siden og over til "Godkjente
        // tilbud" (/tilbud-service/godkjent) først når arbeidsordren som ble
        // laget av det er ferdigmeldt - se OnInitializedAsync. Før det skal
        // det fortsatt vises her i Godkjent-kolonnen, siden jobben ennå
        // pågår. Avslåtte tilbud vises her i Avslått-kolonnen i 7 dager etter
        // AvslattDato, deretter kun på /tilbud-service/avslatt - se _synlige.
        public bool ArbeidsordreFerdig { get; set; }
    }

    private enum Visning { Kanban, Liste }

    // Avslått vises på hovedsiden i 7 dager etter AvslattDato (deretter kun
    // på /tilbud-service/avslatt), og Godkjent vises her kun så lenge
    // arbeidsordren ikke er ferdigmeldt ennå - se TilbudRad.ArbeidsordreFerdig,
    // ErNyligAvslatt og _synlige under.
    private static readonly EndringsmeldingStatus[] TavleStatuser =
    [
        EndringsmeldingStatus.Utkast,
        EndringsmeldingStatus.SendtTilKunde,
        EndringsmeldingStatus.Godkjent,
        EndringsmeldingStatus.Avslatt
    ];

    private static readonly TimeSpan AvslattVinduILenKanban = TimeSpan.FromDays(7);

    // Nylig avslått = innenfor 7-dagers-vinduet der tilbudet fortsatt skal
    // vises i Avslått-kolonnen her. Tilbud avslått FØR dette feltet fantes
    // (AvslattDato er null) regnes IKKE som nylig avslått - de havner rett
    // i arkivet i stedet for å plutselig dukke opp i Kanban-tavlen.
    private static bool ErNyligAvslatt(TilbudRad t) =>
        t.AvslattDato is { } dato && DateTime.UtcNow - dato < AvslattVinduILenKanban;

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");

    private static string Initialer(string navn) => string.Concat(
        navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(d => char.ToUpperInvariant(d[0])));

    private List<TilbudRad> _tilbud = [];
    private List<KundeOption> _kunder = [];
    private string _nyttNavn = "";
    private int? _valgtKundeId;
    private string? _nyAdresse;
    private string _sok = "";
    private Visning _visning = Visning.Kanban;

    // Hovedsiden viser kun tilbud som fortsatt er "i arbeid": aldri avslåtte
    // (de ligger på egen side), og godkjente kun frem til arbeidsordren er
    // ferdigmeldt (deretter flyttes de til /tilbud-service/godkjent).

    // ---------- L1-G: listevisning med utkast og sendt til kunde ----------
    private bool _full;
    private bool _visNytt;
    private string _filter = "alle";


    // Utkast og tilbud sendt til kunde (etter søk). Godkjente og avslåtte har egne sider.
    private List<TilbudRad> Aktive => _tilbud
        .Where(t => t.Status is EndringsmeldingStatus.Utkast or EndringsmeldingStatus.SendtTilKunde)
        .Where(t => string.IsNullOrWhiteSpace(_sok)
            || t.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (t.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    // Sendte først, det som har ligget lengst hos kunden øverst - så utkastene, nyeste først.
    private List<TilbudRad> Listerader => Aktive
        .Where(t => _filter switch
        {
            "utkast" => t.Status == EndringsmeldingStatus.Utkast,
            "sendt" => t.Status == EndringsmeldingStatus.SendtTilKunde,
            _ => true
        })
        .OrderBy(t => t.Status == EndringsmeldingStatus.SendtTilKunde ? 0 : 1)
        .ThenByDescending(t => t.DagerHosKunden ?? -1)
        .ThenByDescending(t => t.OpprettetDato)
        .ToList();

    private static string VentKlasse(int dager) => dager > 14 ? "rod" : dager > 7 ? "gul" : "gronn";

    private static string Kr(decimal v) => v.ToString("N0", Kultur) + " kr";

    // Samme farge for alle kunder, så lista blir rolig.
    private static string Farge(string navn) => "#835e41";

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("tilbud-service-bredde", _full ? "full" : "normal");
    }

    private int AntallMedStatus(EndringsmeldingStatus status) => _tilbud.Count(t => t.Status == status);

    private decimal VerdiSendtTilKunde => _tilbud
        .Where(t => t.Status == EndringsmeldingStatus.SendtTilKunde)
        .Sum(t => t.SendtSum ?? 0);

    private List<TilbudRad> _synlige => _tilbud
        .Where(t => !(t.Status == EndringsmeldingStatus.Godkjent && t.ArbeidsordreFerdig))
        .Where(t => t.Status != EndringsmeldingStatus.Avslatt || ErNyligAvslatt(t))
        .Where(t => string.IsNullOrWhiteSpace(_sok)
            || t.Tittel.Contains(_sok, StringComparison.OrdinalIgnoreCase)
            || (t.KundeNavn?.Contains(_sok, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    [Inject] private NavigationManager Nav { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "navn")] private string? NavnFraQuery { get; set; }
    [SupplyParameterFromQuery(Name = "kundeId")] private int? KundeIdFraQuery { get; set; }
    [SupplyParameterFromQuery(Name = "adresse")] private string? AdresseFraQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _nyttNavn = NavnFraQuery ?? "";
        _valgtKundeId = KundeIdFraQuery;
        _nyAdresse = AdresseFraQuery;
        _visNytt = !string.IsNullOrWhiteSpace(NavnFraQuery);
        _full = await VisningPref.HentAsync("tilbud-service-bredde", "normal") == "full";

        var lagretVisning = await VisningPref.HentAsync("tilbud-service", _visning.ToString());
        if (Enum.TryParse<Visning>(lagretVisning, out var visning))
        {
            _visning = visning;
        }

        _kunder = await Db.Kunder
            .OrderBy(k => k.Navn)
            .Select(k => new KundeOption { Id = k.Id, Navn = k.Navn })
            .ToListAsync();

        _tilbud = await Db.Tilbud
            .Where(t => t.Prosjekt!.Status == ProsjektStatus.Serviceavtale)
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(t => t.Prosjekt).ThenInclude(p => p!.Prosjektleder)
            .OrderByDescending(t => t.OpprettetDato)
            .Select(t => new TilbudRad
            {
                TilbudId = t.Id,
                Tittel = t.Tittel,
                KundeNavn = t.Prosjekt!.Kunde != null ? t.Prosjekt.Kunde.Navn : null,
                OpprettetDato = t.OpprettetDato,
                Status = t.Status,
                SendtSum = t.SendtSum,
                AvslattDato = t.AvslattDato,
                ProsjektlederNavn = t.Prosjekt.Prosjektleder != null ? t.Prosjekt.Prosjektleder.Navn : null,
                SendtDato = t.SendtDato,
                ArbeidsordreFerdig = Db.Arbeidsordre.Any(a => a.TilbudId == t.Id
                    && (a.Status == ArbeidsordreStatus.Ferdig || a.Status == ArbeidsordreStatus.Fakturert))
            })
            .ToListAsync();

        // Summen: det kunden fikk (SendtSum), ellers regnet som på tilbudssiden.
        var utenSum = _tilbud.Where(t => t.SendtSum is null).Select(t => t.TilbudId).ToList();
        var beregnet = utenSum.Count == 0
            ? []
            : (await Db.Tilbud.Where(t => utenSum.Contains(t.Id)).Include(t => t.Linjer).ToListAsync())
                .ToDictionary(t => t.Id, TilbudBeregningHelper.BeregnTotaltUtenMva);
        foreach (var rad in _tilbud)
        {
            rad.Sum = rad.SendtSum ?? beregnet.GetValueOrDefault(rad.TilbudId);
        }
    }

    private async Task VelgVisning(Visning visning)
    {
        _visning = visning;
        await VisningPref.SettAsync("tilbud-service", visning.ToString());
    }

    private async Task OpprettTilbudService()
    {
        var navn = _nyttNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var prosjekt = new Prosjekt
        {
            Navn = navn,
            KundeId = _valgtKundeId,
            Adresse = string.IsNullOrWhiteSpace(_nyAdresse) ? null : _nyAdresse.Trim(),
            Status = ProsjektStatus.Serviceavtale
        };
        Db.Prosjekter.Add(prosjekt);
        await Db.SaveChangesAsync();

        var tilbud = new Tilbud
        {
            ProsjektId = prosjekt.Id,
            Tittel = navn,
            PrisType = TilbudPrisType.Veiledende
        };
        Db.Tilbud.Add(tilbud);
        await Db.SaveChangesAsync();

        Db.TilbudHendelser.Add(new TilbudHendelse
        {
            TilbudId = tilbud.Id,
            Beskrivelse = "Tilbudet ble opprettet"
        });
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/tilbud/{tilbud.Id}");
    }

    // Sletting fra ⋯-menyen (bekreftes i SlettDialog).
    private int? _slettId;
    private string? _slettNavn;

    private void TilbudSlettet(int id) => _tilbud.RemoveAll(t => t.TilbudId == id);
}
