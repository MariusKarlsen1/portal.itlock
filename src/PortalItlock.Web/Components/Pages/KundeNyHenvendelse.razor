@page "/kunde/ny"
@layout PortalItlock.Web.Components.Layout.KundeLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Kunde")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject EmailService Epost
@inject IJSRuntime JS

<PageTitle>Ny henvendelse - Full Kontroll</PageTitle>

@if (_ikkeAktiv)
{
    <p class="dp-feil">Tilgangen din er deaktivert. Ta kontakt med oss for å få den aktivert igjen.</p>
}
else if (_ikkeKoblet)
{
    <p class="dp-feil">Din bruker er ikke koblet til noen kunde ennå. Ta kontakt med oss.</p>
}
else if (_sendt)
{
    <div class="dp-kvittering">
        <div class="dp-hake"><Icon Name="check" /></div>
        <h1>Takk! Henvendelsen er sendt.</h1>
        <p>Vi ser på den og gir deg svar her i portalen.@(_haster ? " Du har merket den som haster – vi prioriterer den." : "")</p>
    </div>
    <div class="dp-knapperad" style="max-width:520px;margin:0 auto;width:100%">
        <a class="dp-knapp" style="flex:1;height:48px" href="/kunde"><Icon Name="home" />Til forsiden</a>
        <button type="button" class="dp-knapp" style="flex:1;height:48px" @onclick="Nullstill"><Icon Name="plus" />Send en til</button>
    </div>
}
else
{
    <div style="max-width:640px;width:100%;margin:0 auto;display:grid;gap:1rem">
        @if (_steg == 1)
        {
            <a class="dp-tilbake" href="/kunde"><Icon Name="arrow-left" />Avbryt</a>
        }
        else
        {
            <button type="button" class="dp-tilbake" style="background:none;border:none;padding:0;cursor:pointer;font:inherit;font-size:.85rem;font-weight:600" @onclick="@(() => GaTil(_steg - 1))"><Icon Name="arrow-left" />Tilbake</button>
        }

        <div class="dp-hei">
            <h1>@(_steg switch { 1 => "Hva kan vi hjelpe med?", 2 => "Når og hvor?", _ => "Se over og send" })</h1>
            <p>Steg @_steg av 3@(_steg == 1 ? " – tar under ett minutt" : "")</p>
        </div>
        <div class="dp-stegrad"><i class="pa"></i><i class="@(_steg >= 2 ? "pa" : "")"></i><i class="@(_steg >= 3 ? "pa" : "")"></i></div>

        <div class="dp-kort dp-skjema">
            @if (_steg == 1)
            {
                <span class="dp-lbl">Hvilken dør gjelder det?</span>
                <div class="dp-kategorier">
                    @foreach (var (navn, ikon) in Dortyper)
                    {
                        <button type="button" class="@(_dortype == navn ? "aktiv" : "")" @onclick="@(() => _dortype = navn)" @key="navn"><Icon Name="@ikon" />@navn</button>
                    }
                </div>

                <span class="dp-lbl">Beskriv kort</span>
                <textarea class="dp-tekstfelt" rows="4" @bind="_beskrivelse" @bind:event="oninput" placeholder="F.eks. hva som er galt, når det startet..."></textarea>

                <span class="dp-lbl">Bilder</span>
                <div class="dp-filer">
                    @foreach (var b in _bilder)
                    {
                        <div class="dp-fil" @key="b">
                            @if (b.Forhandsvisning is not null)
                            {
                                <img src="@b.Forhandsvisning" alt="@b.Fil.Name" />
                            }
                            else
                            {
                                <span><Icon Name="image" /><br />@b.Fil.Name</span>
                            }
                            <button type="button" title="Fjern" @onclick="@(() => _bilder.Remove(b))">&times;</button>
                        </div>
                    }
                    <label class="dp-fil-ny">
                        <Icon Name="camera" />
                        @(_lasterBilder ? "Laster..." : "Ta bilde / velg")
                        <InputFile OnChange="OnBilderValgt" accept="image/*" multiple />
                    </label>
                </div>
            }
            else if (_steg == 2)
            {
                <span class="dp-lbl">Adresse for jobben</span>
                <input class="dp-felt" @bind="_adresse" @bind:event="oninput" placeholder="Adresse for jobben" />

                <span class="dp-lbl">Ønsket dato for befaring/montering</span>
                <EnkelKalender SelectedDate="_onsketDato" SelectedDateChanged="@(d => _onsketDato = d)" TravleDager="_travleDager" />

                <span class="dp-lbl">Ønsket tid på dagen</span>
                <div class="dp-tider">
                    @foreach (var (verdi, navn, tid) in Tidsrom)
                    {
                        <button type="button" class="@(_onsketTidsrom == verdi ? "aktiv" : "")" @onclick="@(() => _onsketTidsrom = verdi)" @key="verdi">@navn<small>@tid</small></button>
                    }
                </div>

                <span class="dp-lbl">Info til montøren (valgfritt)</span>
                <textarea class="dp-tekstfelt" rows="2" style="min-height:70px" @bind="_infoTilMontor" @bind:event="oninput" placeholder="F.eks. hvor nøkkelen ligger, adkomst, parkering..."></textarea>

                <label class="dp-haster @(_haster ? "pa" : "")">
                    <span><b>Haster</b><small>Døren kan ikke låses, står åpen eller er til fare</small></span>
                    <input type="checkbox" @bind="_haster" />
                    <span class="dp-bryter"></span>
                </label>
            }
            else
            {
                <div class="dp-oppsummering">
                    <div class="dp-ln"><span>Gjelder</span><span>@_dortype</span></div>
                    @if (!string.IsNullOrWhiteSpace(_beskrivelse))
                    {
                        <div class="dp-ln"><span>Beskrivelse</span><span>@_beskrivelse</span></div>
                    }
                    <div class="dp-ln"><span>Adresse</span><span>@(string.IsNullOrWhiteSpace(_adresse) ? "Som tidligere oppgitt" : _adresse)</span></div>
                    <div class="dp-ln"><span>Ønsket tid</span><span>@(OnsketTidspunkt ?? "Første ledige")</span></div>
                    @if (!string.IsNullOrWhiteSpace(_infoTilMontor))
                    {
                        <div class="dp-ln"><span>Info til montøren</span><span>@_infoTilMontor</span></div>
                    }
                    <div class="dp-ln"><span>Bilder</span><span>@(_bilder.Count == 0 ? "Ingen" : $"{_bilder.Count} stk")</span></div>
                    @if (_haster)
                    {
                        <div class="dp-ln"><span>Haster</span><span><span class="dp-tag dp-t-rod"><Icon Name="alert-triangle" />Ja</span></span></div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_feil))
            {
                <p class="dp-feil">@_feil</p>
            }

            <div class="dp-send-rad">
                @if (_steg < 3)
                {
                    <button type="button" class="dp-send" style="@(_steg == 2 ? "background:var(--dp-brun)" : "")" @onclick="@(() => GaTil(_steg + 1))" disabled="@_lasterBilder">
                        @(_steg == 1 ? "Neste" : "Se over")<Icon Name="arrow-right" />
                    </button>
                }
                else
                {
                    <button type="button" class="dp-send" style="background:var(--dp-gronn)" @onclick="SendInn" disabled="@_uploading">
                        <Icon Name="send" />@(_uploading ? "Sender..." : "Send henvendelse")
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed class ValgtBilde
    {
        public required IBrowserFile Fil { get; init; }
        public string? Forhandsvisning { get; init; }
    }

    private static readonly (string Navn, string Ikon)[] Dortyper =
    [
        ("Ytterdør", "door"),
        ("Innerdør", "door"),
        ("Verandadør", "sun"),
        ("Verandaskyvedør", "maximize"),
        ("Garasjeport", "building"),
        ("Annet", "more-horizontal")
    ];

    private static readonly (string Verdi, string Navn, string Tid)[] Tidsrom =
    [
        ("Ingen preferanse", "Ingen preferanse", "Første ledige"),
        ("Morgen (08-11)", "Morgen", "08–11"),
        ("Formiddag (11-14)", "Formiddag", "11–14"),
        ("Ettermiddag (14-17)", "Ettermiddag", "14–17")
    ];

    private int? _kundeId;
    private string _kundeNavn = "";
    private bool _ikkeKoblet;
    private bool _ikkeAktiv;
    private string? _standardAdresse;

    private int _steg = 1;
    private bool _sendt;
    private string _dortype = "Ytterdør";
    private string _beskrivelse = "";
    private string _adresse = "";
    private DateTime? _onsketDato;
    private string _onsketTidsrom = "Ingen preferanse";
    private string _infoTilMontor = "";
    private bool _haster;
    private Dictionary<DateOnly, int>? _travleDager;
    private List<ValgtBilde> _bilder = [];
    private bool _lasterBilder;
    private bool _uploading;
    private string? _feil;

    private string? OnsketTidspunkt => _onsketDato.HasValue
        ? _onsketDato.Value.ToString("dd.MM.yyyy") + (_onsketTidsrom != "Ingen preferanse" ? $" ({_onsketTidsrom})" : "")
        : _onsketTidsrom != "Ingen preferanse" ? _onsketTidsrom : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // Ser man portalen som en annen bruker ("Vis som"), er dette den
        // brukerens id - se ForhandsvisningHelper.
        if (state.User.VisningsBrukerId() is not { } brukerId)
        {
            return;
        }

        var bruker = await Db.Brukere.Include(b => b.Kunde).FirstOrDefaultAsync(b => b.Id == brukerId);
        if (bruker?.KundeId is null)
        {
            _ikkeKoblet = true;
            return;
        }

        if (!bruker.Aktiv)
        {
            _ikkeAktiv = true;
            return;
        }

        _kundeId = bruker.KundeId;
        _kundeNavn = bruker.Kunde?.Navn ?? "";

        // Adressen fylles ut fra kunden, så de bare trenger å bekrefte den.
        var k = bruker.Kunde;
        if (!string.IsNullOrWhiteSpace(k?.Adresse))
        {
            var poststed = string.Join(" ", new[] { k.Postnr, k.Sted }.Where(s => !string.IsNullOrWhiteSpace(s)));
            _standardAdresse = string.IsNullOrWhiteSpace(poststed) ? k.Adresse : $"{k.Adresse}, {poststed}";
            _adresse = _standardAdresse;
        }

        var idag = DateTime.Today;
        var jobber = await Db.Arbeidsordre
            .Where(a => a.PlanlagtDato != null && a.PlanlagtDato.Value.Date >= idag && a.PlanlagtDato.Value.Date <= idag.AddDays(90))
            .Select(a => a.PlanlagtDato!.Value.Date)
            .ToListAsync();
        _travleDager = jobber
            .GroupBy(d => DateOnly.FromDateTime(d))
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private async Task GaTil(int steg)
    {
        _feil = null;
        _steg = Math.Clamp(steg, 1, 3);
        await JS.InvokeVoidAsync("scrollTo", 0, 0);
    }

    private void Nullstill()
    {
        _sendt = false;
        _steg = 1;
        _dortype = "Ytterdør";
        _beskrivelse = "";
        _adresse = _standardAdresse ?? "";
        _onsketDato = null;
        _onsketTidsrom = "Ingen preferanse";
        _infoTilMontor = "";
        _haster = false;
        _bilder = [];
    }

    private async Task VarsleAdmin(Servicehenvendelse henvendelse)
    {
        var adminEposter = await Db.Brukere
            .Where(b => b.Rolle == BrukerRolle.Admin && b.Aktiv)
            .Select(b => b.Epost)
            .ToListAsync();

        var html = "<p>Ny servicehenvendelse fra <strong>" + System.Net.WebUtility.HtmlEncode(_kundeNavn) + "</strong>:</p>"
            + (henvendelse.Haster ? "<p><strong style=\"color:#b23b22\">HASTER</strong> - døren kan ikke låses, står åpen eller er til fare.</p>" : "")
            + "<p><strong>Dørtype:</strong> " + System.Net.WebUtility.HtmlEncode(henvendelse.Dortype) + "</p>"
            + (string.IsNullOrWhiteSpace(henvendelse.Beskrivelse) ? "" : "<p><strong>Beskrivelse:</strong> " + System.Net.WebUtility.HtmlEncode(henvendelse.Beskrivelse) + "</p>")
            + (string.IsNullOrWhiteSpace(henvendelse.Adresse) ? "" : "<p><strong>Adresse:</strong> " + System.Net.WebUtility.HtmlEncode(henvendelse.Adresse) + "</p>")
            + (string.IsNullOrWhiteSpace(henvendelse.OnsketTidspunkt) ? "" : "<p><strong>Ønsket tidspunkt:</strong> " + System.Net.WebUtility.HtmlEncode(henvendelse.OnsketTidspunkt) + "</p>")
            + (string.IsNullOrWhiteSpace(henvendelse.InfoTilMontor) ? "" : "<p><strong>Info til montøren:</strong> " + System.Net.WebUtility.HtmlEncode(henvendelse.InfoTilMontor) + "</p>")
            + "<p>Se den under Serviceoppdrag i portalen.</p>";

        var emne = (henvendelse.Haster ? "HASTER: " : "") + "Ny servicehenvendelse - " + _kundeNavn;
        foreach (var adminEpost in adminEposter)
        {
            await Epost.SendAsync(adminEpost, emne, html);
        }
    }

    private async Task OnBilderValgt(InputFileChangeEventArgs e)
    {
        _lasterBilder = true;
        foreach (var fil in e.GetMultipleFiles(10))
        {
            string? forhandsvisning = null;
            try
            {
                var liten = await fil.RequestImageFileAsync("image/jpeg", 240, 240);
                using var ms = new MemoryStream();
                await using (var s = liten.OpenReadStream(maxAllowedSize: 5_000_000))
                {
                    await s.CopyToAsync(ms);
                }
                forhandsvisning = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            catch
            {
                // Formater nettleseren ikke kan skalere (f.eks. HEIC) vises bare med filnavn.
            }
            _bilder.Add(new ValgtBilde { Fil = fil, Forhandsvisning = forhandsvisning });
        }
        _lasterBilder = false;
    }

    private async Task SendInn()
    {
        if (_kundeId is null || _uploading)
        {
            return;
        }

        _feil = null;
        _uploading = true;

        try
        {
            var henvendelse = new Servicehenvendelse
            {
                KundeId = _kundeId.Value,
                Dortype = _dortype,
                Beskrivelse = string.IsNullOrWhiteSpace(_beskrivelse) ? null : _beskrivelse.Trim(),
                // Lagres bare når kunden har endret den - ellers er det kundens vanlige adresse.
                Adresse = string.IsNullOrWhiteSpace(_adresse) || _adresse.Trim() == _standardAdresse ? null : _adresse.Trim(),
                OnsketDato = _onsketDato,
                OnsketTidspunkt = OnsketTidspunkt,
                InfoTilMontor = string.IsNullOrWhiteSpace(_infoTilMontor) ? null : _infoTilMontor.Trim(),
                Haster = _haster
            };
            Db.Servicehenvendelser.Add(henvendelse);
            await Db.SaveChangesAsync();

            foreach (var b in _bilder)
            {
                var fil = b.Fil;
                if (fil.Size > 15_000_000)
                {
                    _feil = $"\"{fil.Name}\" er for stort (maks 15 MB) og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = fil.OpenReadStream(maxAllowedSize: 15_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }

                Db.ServicehenvendelseBilder.Add(new ServicehenvendelseBilde
                {
                    ServicehenvendelseId = henvendelse.Id,
                    Data = buffer.ToArray(),
                    ContentType = string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType,
                    Filnavn = fil.Name
                });
            }

            await Db.SaveChangesAsync();
            await VarsleAdmin(henvendelse);
            _sendt = true;
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        finally
        {
            _uploading = false;
        }
    }
}
