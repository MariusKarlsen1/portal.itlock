@page "/systemregister/ny"
@page "/systemregister/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Rediger system" : "Nytt system")</PageTitle>

<div class="sys-side">

<a class="back-link" href="/systemregister">&larr; Tilbake til systemregister</a>

@if (_notFound)
{
    <p class="form-error">Fant ikke systemet. Det kan være slettet.</p>
}
else
{
    <h1 class="sys-tittel">@(Id.HasValue ? "Rediger system" : "Nytt system")</h1>

    <div class="sys-layout">
        <aside class="sys-nav">
            <button type="button" class="sys-nav-rad @(_fane == "oversikt" ? "aktiv" : "")" @onclick='@(() => _fane = "oversikt")'>
                <span class="sys-nav-ikon"><Icon Name="lock" /></span>Oversikt
            </button>
            <button type="button" class="sys-nav-rad @(_fane == "info" ? "aktiv" : "")" @onclick='@(() => _fane = "info")'>
                <span class="sys-nav-ikon"><Icon Name="lock" /></span>Systeminformasjon
            </button>
            <button type="button" class="sys-nav-rad @(_fane == "rekvirenter" ? "aktiv" : "")" @onclick='@(() => _fane = "rekvirenter")'>
                <span class="sys-nav-ikon"><Icon Name="users" /></span>Rekvirenter<span class="sys-nav-badge">@_rekvirenter.Count</span>
            </button>
            <button type="button" class="sys-nav-rad @(_fane == "nokler" ? "aktiv" : "")" @onclick='@(() => _fane = "nokler")'>
                <span class="sys-nav-ikon"><Icon Name="tag" /></span>Nøkler<span class="sys-nav-badge">@TotaltAntallNokler</span>
            </button>
            <button type="button" class="sys-nav-rad @(_fane == "kvitteringer" ? "aktiv" : "")" @onclick='@(() => _fane = "kvitteringer")'>
                <span class="sys-nav-ikon"><Icon Name="receipt" /></span>Kvitteringsliste<span class="sys-nav-badge">@_kvitteringer.Count</span>
            </button>
            <button type="button" class="sys-nav-rad @(_fane == "vedlegg" ? "aktiv" : "")" @onclick='@(() => _fane = "vedlegg")'>
                <span class="sys-nav-ikon"><Icon Name="file-text" /></span>Vedlegg<span class="sys-nav-badge">@_vedlegg.Count</span>
            </button>
        </aside>

        <div class="sys-hoved">
            @if (_fane == "oversikt")
            {
                @if (!Id.HasValue)
                {
                    <p class="section-hint">Lagre systemet først for å se oversikten.</p>
                }
                else
                {
                    <div class="sys-id-kort">
                        <div class="sys-id-rad">
                            <span class="sys-id-ikon"><Icon Name="lock" /></span>
                            <div class="sys-id-tekst">
                                <span class="sys-id-nummer">@_form.Systemnummer</span>
                                <span class="sys-status-pille sys-status-@(_form.Status == NokkelsystemStatus.Aktiv ? "aktiv" : "inaktiv")">@_form.Status.Visningsnavn()</span>
                            </div>
                            <div class="sys-dropdown">
                                <button type="button" class="sys-dropdown-knapp" @onclick="@(() => _visHandlingerMeny = !_visHandlingerMeny)">Flere handlinger<Icon Name="chevron-down" /></button>
                                @if (_visHandlingerMeny)
                                {
                                    <div class="sys-dropdown-meny">
                                        <button type="button" @onclick='@(() => { _fane = "info"; _visHandlingerMeny = false; })'><Icon Name="edit" />Rediger systeminformasjon</button>
                                        <button type="button" class="sys-dropdown-fare" @onclick='@(() => { _confirmingDelete = true; _visHandlingerMeny = false; })'><Icon Name="trash" />Slett system</button>
                                    </div>
                                }
                            </div>
                        </div>
                        <span class="sys-id-kunde">@(_form.Kundenavn ?? "Ingen kunde satt")</span>
                        @if (FullAdresse is not null)
                        {
                            <span class="sys-id-adresse"><Icon Name="map" />@FullAdresse</span>
                        }

                        <label class="sys-bilde-upload-label">
                            @if (_form.BildeData is not null)
                            {
                                <img class="sys-bygningsbilde" src="@($"/nokkelsystem/{Id}/bilde?v={_bildeVersjon}")" alt="Bygningsbilde" />
                            }
                            else
                            {
                                <div class="sys-bygningsbilde sys-bygningsbilde-tom"><Icon Name="image" /><span>Last opp bilde</span></div>
                            }
                            <InputFile OnChange="OnBildeValgt" accept="image/*" />
                        </label>
                    </div>

                    <div class="sys-grid2">
                        <div class="sys-kort">
                            <h2>Systeminformasjon</h2>
                            <dl class="sys-infoliste">
                                <div><dt>Type</dt><dd>@(_form.Type ?? "-")</dd></div>
                                <div><dt>Fabrikat</dt><dd>@(_form.Fabrikat ?? "-")</dd></div>
                                <div><dt>Adresse</dt><dd>@(FullAdresse ?? "-")</dd></div>
                                <div><dt>Kontakt</dt><dd>@(_form.Kontaktperson ?? "-")</dd></div>
                                <div><dt>Telefon</dt><dd>@(_form.Telefon ?? "-")</dd></div>
                                <div><dt>E-post</dt><dd>@(_form.Epost ?? "-")</dd></div>
                            </dl>
                        </div>

                        <div class="sys-kort">
                            <h2>Statistikk</h2>
                            <div class="sys-statgrid">
                                <div class="sys-statkort"><span class="sys-stat-ikon"><Icon Name="users" /></span><span class="sys-stat-tall">@_rekvirenter.Count</span><span class="sys-stat-etikett">Rekvirenter</span></div>
                                <div class="sys-statkort"><span class="sys-stat-ikon"><Icon Name="tag" /></span><span class="sys-stat-tall">@TotaltAntallNokler</span><span class="sys-stat-etikett">Aktive nøkler</span></div>
                                <div class="sys-statkort"><span class="sys-stat-ikon"><Icon Name="receipt" /></span><span class="sys-stat-tall">@_kvitteringer.Count</span><span class="sys-stat-etikett">Kvitteringer</span></div>
                                <div class="sys-statkort"><span class="sys-stat-ikon"><Icon Name="file-text" /></span><span class="sys-stat-tall">@_vedlegg.Count</span><span class="sys-stat-etikett">Vedlegg</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="sys-grid2">
                        <div class="sys-kort">
                            <h2>Siste aktivitet</h2>
                            @if (_hendelser.Count == 0)
                            {
                                <p class="list-empty">Ingen aktivitet registrert ennå.</p>
                            }
                            else
                            {
                                <ul class="sys-aktivitet-liste">
                                    @foreach (var h in _hendelser.Take(6))
                                    {
                                        <li>
                                            <span class="sys-aktivitet-tekst">@h.Beskrivelse</span>
                                            <span class="sys-aktivitet-meta">av @(h.UtfortAvBruker?.Navn ?? "Ukjent") - @h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="sys-kort">
                            <h2>Hurtighandlinger</h2>
                            <div class="sys-hurtig-grid">
                                <button type="button" class="sys-hurtig-knapp" @onclick="HurtigLeggTilRekvirent"><Icon Name="users" />Legg til rekvirent</button>
                                <button type="button" class="sys-hurtig-knapp" @onclick="HurtigRegistrerNokkel"><Icon Name="tag" />Registrer nøkkel</button>
                                <button type="button" class="sys-hurtig-knapp" @onclick='@(() => _fane = "vedlegg")'><Icon Name="upload" />Last opp vedlegg</button>
                                <button type="button" class="sys-hurtig-knapp" @onclick='@(() => _fane = "info")'><Icon Name="edit" />Skriv notat</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_fane == "info")
            {
                <div class="sys-kort">
                    <h2>Systeminformasjon</h2>
                    <div class="field-grid">
                        <label>
                            Systemnummer
                            <input @bind="_form.Systemnummer" @bind:event="oninput" placeholder="F.eks. ITL1500" />
                        </label>
                        <label>
                            Status
                            <select @bind="_form.Status">
                                <option value="@NokkelsystemStatus.Aktiv">@NokkelsystemStatus.Aktiv.Visningsnavn()</option>
                                <option value="@NokkelsystemStatus.Inaktiv">@NokkelsystemStatus.Inaktiv.Visningsnavn()</option>
                            </select>
                        </label>
                        <label>Kunde/bedrift<input @bind="_form.Kundenavn" /></label>
                        <label>Type<input @bind="_form.Type" placeholder="F.eks. Sylinder, Elektronisk, Mekanisk" /></label>
                        <label>Fabrikat/system<input @bind="_form.Fabrikat" placeholder="F.eks. ASSA Twin, iLOQ" /></label>
                        <label>Adresse<input @bind="_form.Adresse" /></label>
                        <label>Post nr<input @bind="_form.Postnr" /></label>
                        <label>Sted<input @bind="_form.Sted" /></label>
                        <label>Kontaktperson<input @bind="_form.Kontaktperson" /></label>
                        <label>Telefon<input @bind="_form.Telefon" /></label>
                        <label>E-post<input @bind="_form.Epost" /></label>
                        <label class="span-2">
                            Notater
                            <textarea rows="3" @bind="_form.Notater"></textarea>
                        </label>
                    </div>
                </div>
            }
            else if (_fane == "rekvirenter")
            {
                <div class="sys-kort">
                    <h2>Rekvirenter</h2>
                    <p class="section-hint">Personer som kan rekvirere nøkler/kort for dette systemet.</p>

                    @if (_rekvirenter.Count == 0)
                    {
                        <p class="list-empty">Ingen rekvirenter lagt til ennå.</p>
                    }

                    @foreach (var r in _rekvirenter)
                    {
                        <div class="rekvirent-row">
                            <label>Navn<input @bind="r.Navn" /></label>
                            <label>Rolle<input @bind="r.Rolle" /></label>
                            <label>Telefon<input @bind="r.Telefon" /></label>
                            <label>E-post<input @bind="r.Epost" /></label>
                            <button type="button" class="remove-button" @onclick="@(() => _rekvirenter.Remove(r))">Fjern</button>
                        </div>
                    }

                    <button type="button" class="add-button" @onclick="LeggTilRekvirent">Legg til rekvirent</button>
                </div>
            }
            else if (_fane == "nokler")
            {
                <div class="sys-kort">
                    <h2>Nøkler</h2>
                    <p class="section-hint">Aggregert oversikt over utleverte nøkler/kort, basert på kvitteringslisten.</p>

                    @if (_kvitteringer.Count == 0)
                    {
                        <p class="list-empty">Ingen nøkler registrert ennå.</p>
                    }
                    else
                    {
                        <div class="sys-tabell-wrap">
                            <table class="sys-tabell">
                                <thead>
                                    <tr><th>Nøkkel/kort</th><th>Nøkkelnr</th><th>Totalt utlevert</th><th>Sist utlevert</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in NoklerGruppert)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(g.Betegnelse) ? "Ikke angitt" : g.Betegnelse)</td>
                                            <td class="mono">@(g.Nummer ?? "-")</td>
                                            <td class="mono">@g.Totalt</td>
                                            <td class="mono">@g.SistUtlevert.ToString("dd.MM.yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else if (_fane == "kvitteringer")
            {
                <div class="sys-kort">
                    <h2>Kvitteringsliste</h2>
                    <p class="section-hint">Registrer hvem som har mottatt nøkler/kort for dette systemet.</p>

                    @if (_kvitteringer.Count == 0 && _nyeKvitteringer.Count == 0)
                    {
                        <p class="list-empty">Ingen kvitteringer registrert ennå.</p>
                    }

                    @foreach (var k in _kvitteringer.Concat(_nyeKvitteringer))
                    {
                        <div class="kvittering-row">
                            <label>Dato<input type="date" @bind="k.Dato" /></label>
                            <label>Mottaker<input @bind="k.MottakerNavn" /></label>
                            <label>Nøkkel/kort<input @bind="k.NokkelBetegnelse" /></label>
                            <label>Nøkkelnr<input @bind="k.Nokkelnummer" placeholder="F.eks. K1, K4" /></label>
                            <label>Antall<input type="number" min="1" @bind="k.Antall" /></label>
                            <label>Rekvirert av<input @bind="k.RekvirertAv" /></label>
                            <button type="button" class="remove-button" @onclick="@(() => FjernKvitteringRad(k))">Fjern</button>

                            @if (k.Id > 0)
                            {
                                @if (k.Signatur is not null)
                                {
                                    <div class="signatur-visning">
                                        <img class="signatur-bilde" src="@($"/nokkelkvittering/{k.Id}/signatur.png?v={k.SignertDato?.Ticks}")" alt="Signatur" />
                                        <span class="signatur-dato">Signert @(k.SignertDato?.ToString("dd.MM.yyyy HH:mm"))</span>
                                        <button type="button" class="remove-button" @onclick="@(() => FjernSignatur(k))">Fjern signatur</button>
                                    </div>
                                }
                                else if (_signerendeKvitteringId == k.Id)
                                {
                                    <div class="signatur-pad-wrap">
                                        <canvas id="@($"sig-canvas-{k.Id}")" width="500" height="180" class="signatur-canvas"></canvas>
                                        <div class="signatur-actions">
                                            <button type="button" class="cancel-button" @onclick="@(() => RensSignatur(k))">Tøm</button>
                                            <button type="button" class="save-button" @onclick="@(() => LagreSignatur(k))">Lagre signatur</button>
                                            <button type="button" class="cancel-button" @onclick="AvbrytSigner">Avbryt</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="add-button" @onclick="@(() => StartSigner(k))">Signer</button>
                                }
                            }
                            else
                            {
                                <span class="signatur-hint">Lagre systemet først for å kunne signere.</span>
                            }
                        </div>
                    }

                    <button type="button" class="add-button" @onclick="LeggTilKvittering">Legg til kvittering</button>
                </div>
            }
            else if (_fane == "vedlegg")
            {
                <div class="sys-kort">
                    <h2>Vedlegg</h2>
                    <p class="section-hint">Sikkerhetsskjema, bestillingsskjema, låsplan og annen dokumentasjon som tilhører systemet.</p>

                    @if (!Id.HasValue)
                    {
                        <p class="list-empty">Lagre systemet først for å kunne legge til vedlegg.</p>
                    }
                    else
                    {
                        @if (_vedlegg.Count > 0)
                        {
                            <ul class="vedlegg-list">
                                @foreach (var v in _vedlegg)
                                {
                                    <li class="vedlegg-item">
                                        <a href="@($"/systemvedlegg/{v.Id}")" target="_blank">@v.Filnavn</a>
                                        <span class="vedlegg-type">@(string.IsNullOrWhiteSpace(v.Type) ? "Ukategorisert" : v.Type)</span>
                                        <button type="button" class="remove-button" @onclick="@(() => RemoveVedlegg(v))">Fjern</button>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="vedlegg-upload">
                            <select @bind="_valgtVedleggType">
                                <option value="">Velg type</option>
                                <option value="Sikkerhetsskjema">Sikkerhetsskjema</option>
                                <option value="Bestillingsskjema">Bestillingsskjema</option>
                                <option value="Låsplan">Låsplan</option>
                                <option value="Annet">Annet</option>
                            </select>
                            <InputFile OnChange="OnVedleggSelected" multiple />
                        </div>

                        @if (_uploadingVedlegg)
                        {
                            <p class="list-empty">Laster opp...</p>
                        }
                        @if (!string.IsNullOrEmpty(_vedleggFeil))
                        {
                            <p class="form-error">@_vedleggFeil</p>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <p class="save-success">@_savedMessage</p>
            }

            <div class="form-actions">
                <button type="button" class="save-button" @onclick="Lagre">
                    @(Id.HasValue ? "Lagre endringer" : "Lagre system")
                </button>

                @if (Id.HasValue && _fane != "oversikt")
                {
                    @if (_confirmingDelete)
                    {
                        <span class="delete-confirm">
                            Er du sikker?
                            <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett system</button>
                    }
                }
            </div>
        </div>
    </div>

    @if (_confirmingDelete && _fane == "oversikt")
    {
        <div class="confirm-overlay">
            <div class="confirm-box">
                <h3>Er du sikker på at du vil slette dette systemet?</h3>
                <p>Systemet, rekvirenter, kvitteringer og vedlegg slettes permanent.</p>
                <div class="confirm-actions">
                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                </div>
            </div>
        </div>
    }
}

</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Nokkelsystem _form = new() { Systemnummer = "" };
    private List<Rekvirent> _rekvirenter = [];
    private List<NokkelKvittering> _kvitteringer = [];
    private List<NokkelKvittering> _nyeKvitteringer = [];
    private List<SystemVedlegg> _vedlegg = [];
    private List<NokkelsystemHendelse> _hendelser = [];
    private string _valgtVedleggType = "";
    private bool _uploadingVedlegg;
    private string? _vedleggFeil;
    private bool _notFound;
    private bool _confirmingDelete;
    private bool _visHandlingerMeny;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;
    private string _fane = "oversikt";
    private string? _opprinneligNotater;
    private long _bildeVersjon = DateTime.Now.Ticks;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    private int? _signerendeKvitteringId;
    private int? _sisteInitialisertCanvasId;

    private sealed record NokkelGruppe(string? Betegnelse, string? Nummer, int Totalt, DateTime SistUtlevert);

    private List<NokkelGruppe> NoklerGruppert =>
        _kvitteringer
            .GroupBy(k => (k.NokkelBetegnelse, k.Nokkelnummer))
            .Select(g => new NokkelGruppe(g.Key.NokkelBetegnelse, g.Key.Nokkelnummer, g.Sum(x => x.Antall), g.Max(x => x.Dato)))
            .OrderByDescending(g => g.SistUtlevert)
            .ToList();

    private int TotaltAntallNokler => _kvitteringer.Sum(k => k.Antall);

    private string? FullAdresse
    {
        get
        {
            var deler = new[] { _form.Adresse, $"{_form.Postnr} {_form.Sted}".Trim() }
                .Where(d => !string.IsNullOrWhiteSpace(d));
            var tekst = string.Join(", ", deler);
            return string.IsNullOrWhiteSpace(tekst) ? null : tekst;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;
        _nyeKvitteringer = [];
        _fane = Id.HasValue ? "oversikt" : "info";

        if (Id.HasValue)
        {
            var existing = await Db.Nokkelsystemer
                .Include(s => s.Rekvirenter)
                .Include(s => s.Kvitteringer)
                .Include(s => s.Vedlegg)
                .FirstOrDefaultAsync(s => s.Id == Id.Value);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _form = existing;
            _rekvirenter = existing.Rekvirenter;
            _kvitteringer = existing.Kvitteringer;
            _vedlegg = existing.Vedlegg;
            _opprinneligNotater = existing.Notater;
            await LastHendelserAsync();
        }
        else
        {
            _rekvirenter = [];
            _kvitteringer = [];
            _vedlegg = [];
            _hendelser = [];
            _opprinneligNotater = null;
            _form = new Nokkelsystem
            {
                Systemnummer = "",
                Rekvirenter = _rekvirenter,
                Kvitteringer = _kvitteringer,
                Vedlegg = _vedlegg
            };
        }
    }

    private async Task LastHendelserAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _hendelser = await Db.NokkelsystemHendelser
            .Where(h => h.NokkelsystemId == Id.Value)
            .Include(h => h.UtfortAvBruker)
            .OrderByDescending(h => h.Tidspunkt)
            .Take(20)
            .ToListAsync();
    }

    private void LoggHendelse(string beskrivelse)
    {
        Db.NokkelsystemHendelser.Add(new NokkelsystemHendelse
        {
            NokkelsystemId = _form.Id,
            Beskrivelse = beskrivelse,
            Tidspunkt = DateTime.Now,
            UtfortAvBrukerId = _naverendeBrukerId
        });
    }

    private void HurtigLeggTilRekvirent()
    {
        _fane = "rekvirenter";
        LeggTilRekvirent();
    }

    private void HurtigRegistrerNokkel()
    {
        _fane = "kvitteringer";
        LeggTilKvittering();
    }

    private void LeggTilRekvirent()
    {
        _rekvirenter.Add(new Rekvirent { Navn = "" });
    }

    private void LeggTilKvittering()
    {
        // Legges i en egen, ikke-sporet liste til Lagre() trykkes, slik at en påbegynt
        // tom kvittering ikke blir lagret som bifangst når f.eks. en signatur lagres.
        _nyeKvitteringer.Add(new NokkelKvittering { MottakerNavn = "", Dato = DateTime.Today });
    }

    private void FjernKvitteringRad(NokkelKvittering k)
    {
        if (!_kvitteringer.Remove(k))
        {
            _nyeKvitteringer.Remove(k);
        }
    }

    private void StartSigner(NokkelKvittering k)
    {
        _signerendeKvitteringId = k.Id;
    }

    private void AvbrytSigner()
    {
        _signerendeKvitteringId = null;
        _sisteInitialisertCanvasId = null;
    }

    private async Task RensSignatur(NokkelKvittering k)
    {
        await JS.InvokeVoidAsync("signatur.clear", $"sig-canvas-{k.Id}");
    }

    private async Task LagreSignatur(NokkelKvittering k)
    {
        var canvasId = $"sig-canvas-{k.Id}";
        var tom = await JS.InvokeAsync<bool>("signatur.isEmpty", canvasId);
        if (tom)
        {
            return;
        }

        var base64 = await JS.InvokeAsync<string>("signatur.getPngBase64", canvasId);
        var entitet = await Db.NokkelKvitteringer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Signatur = Convert.FromBase64String(base64);
        entitet.SignertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        k.Signatur = entitet.Signatur;
        k.SignertDato = entitet.SignertDato;
        _signerendeKvitteringId = null;
        _sisteInitialisertCanvasId = null;
    }

    private async Task FjernSignatur(NokkelKvittering k)
    {
        var entitet = await Db.NokkelKvitteringer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Signatur = null;
        entitet.SignertDato = null;
        await Db.SaveChangesAsync();

        k.Signatur = null;
        k.SignertDato = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_signerendeKvitteringId.HasValue && _sisteInitialisertCanvasId != _signerendeKvitteringId)
        {
            await JS.InvokeVoidAsync("signatur.init", $"sig-canvas-{_signerendeKvitteringId}");
            _sisteInitialisertCanvasId = _signerendeKvitteringId;
        }
    }

    private async Task OnBildeValgt(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        var file = e.File;
        if (file.Size > 10_000_000)
        {
            _error = $"\"{file.Name}\" er for stort (maks 10 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _form.BildeData = buffer.ToArray();
        _form.BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        await Db.SaveChangesAsync();
        _bildeVersjon = DateTime.Now.Ticks;
    }

    private async Task OnVedleggSelected(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        _vedleggFeil = null;
        _uploadingVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > 20_000_000)
                {
                    _vedleggFeil = $"\"{file.Name}\" er for stor (maks 20 MB) og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }

                var vedlegg = new SystemVedlegg
                {
                    NokkelsystemId = Id.Value,
                    Filnavn = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    Data = buffer.ToArray(),
                    Type = string.IsNullOrWhiteSpace(_valgtVedleggType) ? null : _valgtVedleggType
                };

                Db.SystemVedlegg.Add(vedlegg);
                LoggHendelse($"Vedlegg lastet opp: {file.Name}");
            }

            await Db.SaveChangesAsync();
            await LastHendelserAsync();
        }
        finally
        {
            _uploadingVedlegg = false;
        }
    }

    private async Task RemoveVedlegg(SystemVedlegg v)
    {
        Db.SystemVedlegg.Remove(v);
        await Db.SaveChangesAsync();
        _vedlegg.Remove(v);
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_form.Systemnummer))
        {
            _error = "Systemet må ha et systemnummer.";
            return;
        }

        _error = null;
        var nyeRekvirenter = _rekvirenter.Where(r => r.Id == 0).ToList();
        _kvitteringer.AddRange(_nyeKvitteringer);
        var nyeKvitteringerLagt = _nyeKvitteringer.ToList();
        _nyeKvitteringer = [];
        _form.Rekvirenter = _rekvirenter;
        _form.Kvitteringer = _kvitteringer;

        var notaterEndret = !string.Equals(_form.Notater?.Trim(), _opprinneligNotater?.Trim(), StringComparison.Ordinal);
        var erNyttSystem = !Id.HasValue;

        if (erNyttSystem)
        {
            Db.Nokkelsystemer.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (!erNyttSystem)
        {
            foreach (var r in nyeRekvirenter)
            {
                LoggHendelse($"Rekvirent lagt til: {r.Navn}");
            }

            foreach (var k in nyeKvitteringerLagt)
            {
                LoggHendelse($"Ny nøkkel registrert: {(string.IsNullOrWhiteSpace(k.NokkelBetegnelse) ? "Nøkkel" : k.NokkelBetegnelse)} til {k.MottakerNavn}");
            }

            if (notaterEndret)
            {
                LoggHendelse("Notat oppdatert");
            }

            if (nyeRekvirenter.Count > 0 || nyeKvitteringerLagt.Count > 0 || notaterEndret)
            {
                await Db.SaveChangesAsync();
                await LastHendelserAsync();
            }
        }

        _opprinneligNotater = _form.Notater;

        if (Id.HasValue)
        {
            _savedMessage = $"Systemet \"{_form.Systemnummer}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Systemet \"{_form.Systemnummer}\" er lagret.";
            Nav.NavigateTo($"/systemregister/{_form.Id}");
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Nokkelsystemer.FirstOrDefaultAsync(s => s.Id == Id.Value);
        if (existing is not null)
        {
            Db.Nokkelsystemer.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/systemregister");
    }
}
