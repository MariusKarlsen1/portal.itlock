@page "/systemregister/ny"
@page "/systemregister/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? $"System {_form.Systemnummer}" : "Nytt system")</PageTitle>

@* Systemkort S1 (oktober 2026): samme oppsett som kundekortet - ett hvitt kort
   med systemnummer og knapper øverst, en infolinje og loddrette faner. Alle
   funksjoner fra før (rekvirenter, utleveringer med signatur, vedlegg, bilde,
   aktivitet, lagre/slett) er beholdt. *@
<a class="back-link" href="/systemregister"><Icon Name="arrow-left" />Tilbake til systemregister</a>

@if (_notFound)
{
    <p class="form-error">Fant ikke systemet. Det kan være slettet.</p>
}
else
{
    <div class="kk">
        <div class="kk-topp">
            <label class="k-logo-wrap" title="@(Id.HasValue ? "Last opp bilde av bygget" : "")">
                @if (_form.BildeData is not null)
                {
                    <img class="k-logo" src="@($"/nokkelsystem/{Id}/bilde?v={_bildeVersjon}")" alt="Bygningsbilde" />
                }
                else
                {
                    <span class="k-logo"><Icon Name="lock" /></span>
                }
                @if (Id.HasValue)
                {
                    <InputFile OnChange="OnBildeValgt" accept="image/*" style="display:none;" />
                }
            </label>
            <div class="k-navn">
                <div class="k-rad">
                    <h1>@(Id.HasValue ? _form.Systemnummer : "Nytt system")</h1>
                    @if (Id.HasValue)
                    {
                        <span class="k-pill @(_form.Status == NokkelsystemStatus.Aktiv ? "s-ok" : "s-gra")">@_form.Status.Visningsnavn()</span>
                        @if (!string.IsNullOrWhiteSpace(TypeOgFabrikat))
                        {
                            <span class="k-pill s-bla">@TypeOgFabrikat</span>
                        }
                    }
                </div>
                <div class="k-under">
                    @if (Id.HasValue)
                    {
                        <span>@(_form.Kundenavn ?? "Ingen kunde satt")</span>
                        <span>· registrert @_form.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span>Fyll ut systeminformasjonen og lagre for å komme i gang.</span>
                    }
                </div>
            </div>
            @if (Id.HasValue)
            {
                <div class="k-handl">
                    @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                    {
                        <a class="k-knapp" href="@($"tel:{_form.Telefon}")"><Icon Name="phone" />Ring kontakt</a>
                    }
                    @if (Lasplan is { } lp)
                    {
                        <a class="k-knapp" href="@($"/systemvedlegg/{lp.Id}")" target="_blank"><Icon Name="file-text" />Låsplan</a>
                    }
                    <button type="button" class="k-knapp k-knapp-p" @onclick="NyUtlevering"><Icon Name="plus" />Ny utlevering</button>
                </div>
            }
        </div>

        @if (Id.HasValue)
        {
            <div class="k-infolinje">
                @if (!string.IsNullOrWhiteSpace(_form.Kundenavn))
                {
                    <span><Icon Name="building" />Kunde <b>@_form.Kundenavn</b></span>
                }
                @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
                {
                    <span><Icon Name="users" /><b>@_form.Kontaktperson</b></span>
                }
                @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                {
                    <span><Icon Name="phone" /><b>@_form.Telefon</b></span>
                }
                @if (FullAdresse is not null)
                {
                    <span><Icon Name="map-pin" /><b>@FullAdresse</b></span>
                }
                <span><Icon Name="lock" /><b>@TotaltAntallNokler</b><span>nøkler utlevert</span>@if (AntallUsignert > 0) {<span>· <b class="k-gul-tekst">@AntallUsignert usignert</b></span>}</span>
            </div>
        }

        <div class="k-vk">
            <nav class="k-vmeny">
                @if (Id.HasValue)
                {
                    @FaneKnapp("oversikt", "grid", "Oversikt", null, "")
                    @FaneKnapp("nokler", "lock", "Nøkler", TotaltAntallNokler, "")
                    @FaneKnapp("kvitteringer", "receipt", "Utleveringer", AntallUsignert > 0 ? AntallUsignert : _kvitteringer.Count, AntallUsignert > 0 ? "g" : "")
                    @FaneKnapp("rekvirenter", "users", "Rekvirenter", _rekvirenter.Count, "")
                    <div class="k-skill"></div>
                    @FaneKnapp("vedlegg", "folder", "Vedlegg og låsplan", _vedlegg.Count, "")
                    @FaneKnapp("aktivitet", "clock", "Aktivitet", null, "")
                    <div class="k-skill"></div>
                }
                @FaneKnapp("info", "file-text", "Detaljer", null, "")
            </nav>

            <div class="k-hoved">
                @switch (Id.HasValue ? _fane : "info")
                {
                    case "oversikt":
                        @Oversikt()
                        break;
                    case "nokler":
                        @Nokler()
                        break;
                    case "kvitteringer":
                        @Utleveringer()
                        break;
                    case "rekvirenter":
                        @Rekvirenter()
                        break;
                    case "vedlegg":
                        @Vedlegg()
                        break;
                    case "aktivitet":
                        @Aktivitet()
                        break;
                    default:
                        @Detaljer()
                        break;
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="form-error">@_error</p>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <p class="save-success">@_savedMessage</p>
                }

                @if (HarUlagredeEndringer || _fane is "info" or "rekvirenter")
                {
                    <div class="k-lagrebar">
                        <span class="k-smule">@(Id.HasValue ? "Endringer i detaljer, rekvirenter og nye utleveringer lagres samlet." : "Systemet opprettes når du lagrer.")</span>
                        <button type="button" class="k-knapp k-knapp-p" @onclick="Lagre"><Icon Name="check" />@(Id.HasValue ? "Lagre endringer" : "Lagre system")</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_confirmingDelete)
    {
        <div class="confirm-overlay">
            <div class="confirm-box">
                <h3>Er du sikker på at du vil slette dette systemet?</h3>
                <p>Systemet, rekvirenter, kvitteringer og vedlegg slettes permanent.</p>
                <div class="confirm-actions">
                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    // ---------------- Systemkort S1: faner ----------------

    private bool _redigerInfo;
    private Rekvirent? _redigerRekvirent;
    private int? _redigerKvitteringId;
    private string _kvFilter = "alle";
    private string _kvSok = "";
    private string _vedleggFilter = "";

    private string? TypeOgFabrikat => string.Join(" · ", new[] { _form.Type, _form.Fabrikat }.Where(s => !string.IsNullOrWhiteSpace(s)));
    private int AntallUsignert => _kvitteringer.Count(k => k.Id > 0 && k.Signatur is null);
    private SystemVedlegg? Lasplan => _vedlegg.FirstOrDefault(v => string.Equals(v.Type, "Låsplan", StringComparison.OrdinalIgnoreCase));
    private bool HarUlagredeEndringer => _nyeKvitteringer.Count > 0 || !Id.HasValue || _redigerInfo || Db.ChangeTracker.HasChanges();

    private IEnumerable<NokkelKvittering> FiltrerteKvitteringer => _kvitteringer
        .Where(k => k.Id > 0)
        .Where(k => _kvFilter switch { "usignert" => k.Signatur is null, "signert" => k.Signatur is not null, _ => true })
        .Where(k => string.IsNullOrWhiteSpace(_kvSok)
            || k.MottakerNavn.Contains(_kvSok, StringComparison.OrdinalIgnoreCase)
            || (k.NokkelBetegnelse?.Contains(_kvSok, StringComparison.OrdinalIgnoreCase) ?? false)
            || (k.Nokkelnummer?.Contains(_kvSok, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(k => k.Dato);

    // «Hvem har hva»: mottakere som rader, nøkkelnummer som kolonner.
    private List<string> MatriseNokler => _kvitteringer
        .Where(k => k.Id > 0)
        .Select(NokkelNokkel)
        .Distinct()
        .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
        .Take(10)
        .ToList();

    private static string NokkelNokkel(NokkelKvittering k) => string.IsNullOrWhiteSpace(k.Nokkelnummer) ? (k.NokkelBetegnelse ?? "?") : k.Nokkelnummer!;

    private static readonly string[] AvatarFarger = ["#7a2b96", "#2054a3", "#2b7a4b", "#835e41", "#b0322a", "#9a5b12"];
    private static string AvatarFarge(string navn) => AvatarFarger[Math.Abs(navn.Sum(c => c)) % AvatarFarger.Length];

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    private static (string Emoji, string Bakgrunn) HendelseIkon(string beskrivelse) => beskrivelse switch
    {
        var b when b.Contains("Vedlegg", StringComparison.OrdinalIgnoreCase) => ("📎", "var(--k-bla-l)"),
        var b when b.Contains("Rekvirent", StringComparison.OrdinalIgnoreCase) => ("👤", "var(--k-lilla-l)"),
        var b when b.Contains("nøkkel", StringComparison.OrdinalIgnoreCase) => ("🔑", "var(--k-gul-l)"),
        var b when b.Contains("sign", StringComparison.OrdinalIgnoreCase) => ("✍️", "var(--k-ok-l)"),
        var b when b.Contains("Notat", StringComparison.OrdinalIgnoreCase) => ("📝", "var(--k-gra-l)"),
        _ => ("•", "var(--k-gra-l)")
    };

    private static (string Emoji, string Bakgrunn) VedleggIkon(string? type) => type switch
    {
        "Låsplan" => ("📐", "var(--k-bla-l)"),
        "Sikkerhetsskjema" => ("🛡️", "var(--k-ok-l)"),
        "Bestillingsskjema" => ("🧾", "var(--k-gul-l)"),
        _ => ("📄", "var(--k-gra-l)")
    };

    private static readonly System.Globalization.CultureInfo Kultur = new("nb-NO");

    private void VelgFane(string fane)
    {
        _fane = fane;
        _savedMessage = null;
    }

    private void NyUtlevering()
    {
        _fane = "kvitteringer";
        LeggTilKvittering();
    }

    private void SignerNa()
    {
        _fane = "kvitteringer";
        _kvFilter = "usignert";
    }

    private void NyRekvirent()
    {
        var r = new Rekvirent { Navn = "" };
        _rekvirenter.Add(r);
        _redigerRekvirent = r;
    }

    private async Task LagreOgSigner()
    {
        var nye = _nyeKvitteringer.ToList();
        await Lagre();
        if (_error is null && nye.Count > 0)
        {
            _kvFilter = "alle";
            StartSigner(nye[^1]);
        }
    }


    private RenderFragment FaneKnapp(string f, string ikon, string tekst, int? teller, string farge) =>
        @<button type="button" class="k-vfane @(_fane == f || (!Id.HasValue && f == "info") ? "pa" : "")" @onclick="@(() => VelgFane(f))">
            <Icon Name="@ikon" /><span class="k-vfane-tekst">@tekst</span>
            @if (teller is > 0)
            {
                <em class="@farge">@teller</em>
            }
        </button>;

    private RenderFragment Oversikt() =>
        @<div class="k-fp">
            <div class="k-tall4">
                <button type="button" @onclick='@(() => VelgFane("nokler"))'><span class="k-lbl">Nøkler utlevert</span><b>@TotaltAntallNokler</b><small>@NoklerGruppert.Count nøkkeltyper</small></button>
                <button type="button" @onclick="SignerNa"><span class="k-lbl">Mangler signatur</span><b class="@(AntallUsignert > 0 ? "k-gul-tekst" : "")">@AntallUsignert</b><small>@(AntallUsignert > 0 ? "trykk for å signere" : "alt er signert")</small></button>
                <button type="button" @onclick='@(() => VelgFane("rekvirenter"))'><span class="k-lbl">Rekvirenter</span><b>@_rekvirenter.Count</b><small>kan rekvirere nøkler</small></button>
                <button type="button" @onclick='@(() => VelgFane("vedlegg"))'><span class="k-lbl">Vedlegg</span><b>@_vedlegg.Count</b><small>@(Lasplan is null ? "ingen låsplan" : "låsplan lastet opp")</small></button>
            </div>
            <div class="k-to">
                <div class="k-seksjon">
                    <h4>Siste aktivitet <button type="button" class="k-lenke" @onclick='@(() => VelgFane("aktivitet"))'>Se alt</button></h4>
                    @if (_hendelser.Count == 0)
                    {
                        <span class="k-smule">Ingen aktivitet registrert ennå.</span>
                    }
                    @foreach (var h in _hendelser.Take(5))
                    {
                        var (emoji, bg) = HendelseIkon(h.Beskrivelse);
                        <div class="k-tli">
                            <span class="k-ik" style="background:@bg">@emoji</span>
                            <div><b>@h.Beskrivelse</b><small>@(h.UtfortAvBruker?.Navn ?? "Ukjent") · @h.Tidspunkt.ToString("d. MMM yyyy HH:mm", Kultur)</small></div>
                            <span></span>
                        </div>
                    }
                </div>
                <div class="k-kol">
                    @if (AntallUsignert > 0)
                    {
                        var usignert = _kvitteringer.Where(k => k.Id > 0 && k.Signatur is null).OrderByDescending(k => k.Dato).ToList();
                        <div class="k-varsel">
                            <b>✍️ @AntallUsignert utlevering@(AntallUsignert == 1 ? "" : "er") mangler signatur</b>
                            <span class="k-smule">@string.Join(", ", usignert.Take(3).Select(k => $"{k.MottakerNavn} ({NokkelNokkel(k)})"))@(usignert.Count > 3 ? " …" : "")</span>
                            <button type="button" class="k-knapp k-knapp-s k-knapp-p k-start" @onclick="SignerNa">Signer nå</button>
                        </div>
                    }
                    <label class="k-bygg">
                        @if (_form.BildeData is not null)
                        {
                            <img src="@($"/nokkelsystem/{Id}/bilde?v={_bildeVersjon}")" alt="Bygningsbilde" />
                            <span class="k-knapp k-knapp-s k-bygg-knapp">Bytt bilde</span>
                        }
                        else
                        {
                            <span class="k-bygg-tom"><Icon Name="image" />Last opp bilde av bygget</span>
                        }
                        <InputFile OnChange="OnBildeValgt" accept="image/*" style="display:none;" />
                    </label>
                    <div class="k-seksjon">
                        <h4>Nøkler <button type="button" class="k-lenke" @onclick='@(() => VelgFane("nokler"))'>Se alle</button></h4>
                        @if (NoklerGruppert.Count == 0)
                        {
                            <span class="k-smule">Ingen nøkler utlevert ennå.</span>
                        }
                        else
                        {
                            <div class="k-liste">
                                @foreach (var g in NoklerGruppert.Take(4))
                                {
                                    <div class="k-lr">
                                        <span class="k-ik" style="background:#f3e9dc"><Icon Name="lock" /></span>
                                        <div><b>@(g.Nummer is null ? "" : $"{g.Nummer} · ")@(string.IsNullOrWhiteSpace(g.Betegnelse) ? "Ikke angitt" : g.Betegnelse)</b><small>sist utlevert @g.SistUtlevert.ToString("dd.MM.yyyy")</small></div>
                                        <span class="k-pill s-gra">@g.Totalt ute</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>;

    private RenderFragment Nokler() =>
        @<div class="k-fp">
            <div class="k-opps k-opps3">
                <div><b>@TotaltAntallNokler</b><span>nøkler / kort utlevert</span></div>
                <div><b>@NoklerGruppert.Count</b><span>nøkkeltyper</span></div>
                <div><b>@_kvitteringer.Where(k => k.Id > 0).Select(k => k.MottakerNavn.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count()</b><span>mottakere</span></div>
            </div>
            <div class="k-fp-topp">
                <span class="k-smule">Oversikten regnes ut fra utleveringene.</span>
                <button type="button" class="k-knapp k-knapp-s k-knapp-p k-auto" @onclick="NyUtlevering"><Icon Name="plus" />Ny utlevering</button>
            </div>
            @if (NoklerGruppert.Count == 0)
            {
                <span class="k-smule">Ingen nøkler registrert ennå.</span>
            }
            else
            {
                <table class="k-tab">
                    <thead><tr><th>Nøkkel / kort</th><th>Nr</th><th class="c">Utlevert</th><th class="c">Mottakere</th><th>Sist utlevert</th></tr></thead>
                    <tbody>
                        @foreach (var g in NoklerGruppert)
                        {
                            var mottakere = _kvitteringer.Where(k => k.Id > 0 && k.NokkelBetegnelse == g.Betegnelse && k.Nokkelnummer == g.Nummer).Select(k => k.MottakerNavn).Distinct().Count();
                            <tr class="k-redig">
                                <td><b>@(string.IsNullOrWhiteSpace(g.Betegnelse) ? "Ikke angitt" : g.Betegnelse)</b></td>
                                <td class="k-mono">@(g.Nummer ?? "–")</td>
                                <td class="c"><b>@g.Totalt</b></td>
                                <td class="c">@mottakere</td>
                                <td class="k-mono">@g.SistUtlevert.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="k-seksjon">
                    <h4>Hvem har hva</h4>
                    <div class="k-nmat" style="grid-template-columns: 170px repeat(@MatriseNokler.Count, minmax(0, 1fr))">
                        <div class="hd rn">Mottaker</div>
                        @foreach (var n in MatriseNokler)
                        {
                            <div class="hd">@n</div>
                        }
                        @foreach (var mottaker in _kvitteringer.Where(k => k.Id > 0).GroupBy(k => k.MottakerNavn.Trim(), StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
                        {
                            <div class="rn">@mottaker.Key</div>
                            @foreach (var n in MatriseNokler)
                            {
                                var antall = mottaker.Where(k => NokkelNokkel(k) == n).Sum(k => k.Antall);
                                <div class="@(antall > 0 ? "x" : "o")">@(antall == 0 ? "–" : antall == 1 ? "✓" : $"{antall} stk")</div>
                            }
                        }
                    </div>
                </div>
            }
        </div>;

    private RenderFragment Utleveringer() =>
        @<div class="k-fp">
            <div class="k-fp-topp">
                <label class="k-sokf"><Icon Name="search" /><input @bind="_kvSok" @bind:event="oninput" placeholder="Søk mottaker eller nøkkel …" /></label>
                <button type="button" class="k-chip @(_kvFilter == "alle" ? "pa" : "")" @onclick='@(() => _kvFilter = "alle")'>Alle <em>@_kvitteringer.Count(k => k.Id > 0)</em></button>
                <button type="button" class="k-chip @(_kvFilter == "usignert" ? "pa" : "")" @onclick='@(() => _kvFilter = "usignert")'>Mangler signatur <em>@AntallUsignert</em></button>
                <button type="button" class="k-chip @(_kvFilter == "signert" ? "pa" : "")" @onclick='@(() => _kvFilter = "signert")'>Signert <em>@_kvitteringer.Count(k => k.Id > 0 && k.Signatur is not null)</em></button>
                <button type="button" class="k-knapp k-knapp-s k-knapp-p k-auto" @onclick="LeggTilKvittering"><Icon Name="plus" />Ny utlevering</button>
            </div>

            @foreach (var k in _nyeKvitteringer)
            {
                var kv = k;
                <div class="k-nykv">
                    <div class="k-rad"><b>Ny utlevering</b><span class="k-smule">– fyll ut, lagre, og la mottakeren signere på skjermen</span><button type="button" class="k-lenke k-rod-tekst k-auto" @onclick="@(() => FjernKvitteringRad(kv))">Fjern</button></div>
                    <div class="k-g6">
                        <label class="k-felt2">Dato<input class="k-inp" type="date" @bind="kv.Dato" /></label>
                        <label class="k-felt2">Mottaker<input class="k-inp" @bind="kv.MottakerNavn" placeholder="Navn på mottaker" /></label>
                        <label class="k-felt2">Nøkkel / kort<input class="k-inp" @bind="kv.NokkelBetegnelse" placeholder="F.eks. Hovednøkkel" /></label>
                        <label class="k-felt2">Nøkkelnr<input class="k-inp" @bind="kv.Nokkelnummer" placeholder="F.eks. K1, K4" /></label>
                        <label class="k-felt2">Antall<input class="k-inp" type="number" min="1" @bind="kv.Antall" /></label>
                        <label class="k-felt2">Rekvirert av<input class="k-inp" list="rekvirent-navn" @bind="kv.RekvirertAv" /></label>
                    </div>
                </div>
            }
            @if (_nyeKvitteringer.Count > 0)
            {
                <datalist id="rekvirent-navn">
                    @foreach (var r in _rekvirenter.Where(r => !string.IsNullOrWhiteSpace(r.Navn)))
                    {
                        <option value="@r.Navn"></option>
                    }
                </datalist>
                <div class="k-rad k-hoyre">
                    <button type="button" class="k-knapp k-knapp-s" @onclick="Lagre">Lagre</button>
                    <button type="button" class="k-knapp k-knapp-s k-knapp-p" @onclick="LagreOgSigner">✍️ Lagre og signer</button>
                </div>
            }

            @if (!FiltrerteKvitteringer.Any() && _nyeKvitteringer.Count == 0)
            {
                <span class="k-smule">Ingen utleveringer @(_kvFilter == "alle" ? "registrert ennå" : "i denne kategorien").</span>
            }
            else if (FiltrerteKvitteringer.Any())
            {
                <table class="k-tab">
                    <thead><tr><th>Dato</th><th>Mottaker</th><th>Nøkkel / kort</th><th>Nr</th><th class="c">Antall</th><th>Rekvirert av</th><th>Signatur</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var k in FiltrerteKvitteringer)
                        {
                            var kv = k;
                            @if (_redigerKvitteringId == kv.Id)
                            {
                                <tr class="k-redig k-redig-aktiv" @key="kv.Id">
                                    <td><input class="k-inp" type="date" @bind="kv.Dato" /></td>
                                    <td><input class="k-inp" @bind="kv.MottakerNavn" /></td>
                                    <td><input class="k-inp" @bind="kv.NokkelBetegnelse" /></td>
                                    <td><input class="k-inp k-smal" @bind="kv.Nokkelnummer" /></td>
                                    <td><input class="k-inp k-smal" type="number" min="1" @bind="kv.Antall" /></td>
