@page "/systemregister/ny"
@page "/systemregister/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>@(Id.HasValue ? $"System {_form.Systemnummer}" : "Nytt system")</PageTitle>

@* Systemkort S1 (oktober 2026): samme oppsett som kundekortet - ett hvitt kort
   med systemnummer og knapper øverst, en infolinje og loddrette faner. Alle
   funksjoner fra før (rekvirenter, utleveringer med signatur, vedlegg, bilde,
   aktivitet, lagre/slett) er beholdt. *@
<a class="back-link" href="/systemregister"><Icon Name="arrow-left" />Tilbake til systemregister</a>

@if (_notFound)
{
    <p class="form-error">Fant ikke systemet. Det kan være slettet.</p>
}
else
{
    <div class="kk @(_full ? "kk-full" : "")">
        <div class="kk-topp">
            <label class="k-logo-wrap" title="@(Id.HasValue ? "Last opp bilde av bygget" : "")">
                @if (_form.BildeData is not null)
                {
                    <img class="k-logo" src="@($"/nokkelsystem/{Id}/bilde?v={_bildeVersjon}")" alt="Bygningsbilde" />
                }
                else
                {
                    <span class="k-logo"><Icon Name="lock" /></span>
                }
                @if (Id.HasValue)
                {
                    <InputFile OnChange="OnBildeValgt" accept="image/*" style="display:none;" />
                }
            </label>
            <div class="k-navn">
                <div class="k-rad">
                    <h1>@(Id.HasValue ? _form.Systemnummer : "Nytt system")</h1>
                    @if (Id.HasValue)
                    {
                        <span class="k-pill @(_form.Status == NokkelsystemStatus.Aktiv ? "s-ok" : "s-gra")">@_form.Status.Visningsnavn()</span>
                        @if (!string.IsNullOrWhiteSpace(TypeOgFabrikat))
                        {
                            <span class="k-pill s-bla">@TypeOgFabrikat</span>
                        }
                    }
                </div>
                <div class="k-under">
                    @if (Id.HasValue)
                    {
                        <span>@(_form.Kundenavn ?? "Ingen kunde satt")</span>
                        <span>· registrert @_form.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span>Fyll ut systeminformasjonen og lagre for å komme i gang.</span>
                    }
                </div>
            </div>
            @if (Id.HasValue)
            {
                <div class="k-handl">
                    @if (Lasplan is { } toppPlan)
                    {
                        <button type="button" class="k-knapp" @onclick="@(() => AapneLasplan(toppPlan))"><Icon Name="file-text" />Låsplan</button>
                    }
                    <button type="button" class="k-knapp @(_fane == "info" ? "k-knapp-pa" : "")" @onclick='@(() => VelgFane("info"))'><Icon Name="edit" />Rediger</button>
                    <button type="button" class="k-knapp k-knapp-p" @onclick="NyUtlevering"><Icon Name="plus" />Ny utlevering</button>
                    <button type="button" class="kk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" aria-label="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull"><Icon Name="@(_full ? "minimize" : "maximize")" /></button>
                </div>
            }
        </div>

        @if (Id.HasValue)
        {
            <div class="k-infolinje">
                @if (!string.IsNullOrWhiteSpace(_form.Kundenavn))
                {
                    <span><Icon Name="building" />Kunde <b>@_form.Kundenavn</b></span>
                }
                @if (!string.IsNullOrWhiteSpace(_form.Kontaktperson))
                {
                    <span><Icon Name="users" /><b>@_form.Kontaktperson</b></span>
                }
                @if (!string.IsNullOrWhiteSpace(_form.Telefon))
                {
                    <span><Icon Name="phone" /><b>@_form.Telefon</b></span>
                }
                @if (FullAdresse is not null)
                {
                    <span><Icon Name="map-pin" /><b>@FullAdresse</b></span>
                }
                <span><Icon Name="lock" /><b>@TotaltAntallNokler</b><span>nøkler utlevert</span>@if (AntallUsignert > 0) {<span>· <b class="k-gul-tekst">@AntallUsignert usignert</b></span>}</span>
            </div>
        }

        <div class="k-vk">
            <nav class="k-vmeny">
                @if (Id.HasValue)
                {
                    @FaneKnapp("oversikt", "grid", "Oversikt", null, "")
                    @FaneKnapp("nokler", "lock", "Nøkler", TotaltAntallNokler, AntallUsignert > 0 ? "g" : "")
                    @FaneKnapp("rekvirenter", "users", "Rekvirenter", _rekvirenter.Count, "")
                    @FaneKnapp("vedlegg", "folder", "Vedlegg og låsplan", _vedlegg.Count, "")
                    @FaneKnapp("aktivitet", "clock", "Aktivitet", null, "")
                }
                else
                {
                    @FaneKnapp("info", "file-text", "Detaljer", null, "")
                }
            </nav>

            <div class="k-hoved">
                @switch (Id.HasValue ? _fane : "info")
                {
                    case "oversikt":
                        @Oversikt()
                        break;
                    case "nokler":
                        @Nokler()
                        break;
                    case "rekvirenter":
                        @Rekvirenter()
                        break;
                    case "vedlegg":
                        @Vedlegg()
                        break;
                    case "aktivitet":
                        @Aktivitet()
                        break;
                    default:
                        @Detaljer()
                        break;
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="form-error">@_error</p>
                }
                @if (!string.IsNullOrEmpty(_savedMessage))
                {
                    <p class="save-success">@_savedMessage</p>
                }

                @if (HarUlagredeEndringer || _fane == "info")
                {
                    <div class="k-lagrebar">
                        <span class="k-smule">@(Id.HasValue ? "Husk å lagre endringene." : "Systemet opprettes når du lagrer.")</span>
                        <button type="button" class="k-knapp k-knapp-p" @onclick="Lagre"><Icon Name="check" />@(Id.HasValue ? "Lagre endringer" : "Lagre system")</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_confirmingDelete)
    {
        <div class="confirm-overlay">
            <div class="confirm-box">
                <h3>Er du sikker på at du vil slette dette systemet?</h3>
                <p>Systemet, rekvirenter, kvitteringer og vedlegg slettes permanent.</p>
                <div class="confirm-actions">
                    <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
                    <button type="button" class="delete-confirm-button" @onclick="ConfirmDelete">Ja, slett</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    // ---------------- Systemkort S1: faner ----------------

    private bool _redigerInfo;
    private int? _redigerKvitteringId;
    private string _kvFilter = "alle";
    private string _kvSok = "";

    private string? TypeOgFabrikat => string.Join(" · ", new[] { _form.Type, _form.Fabrikat }.Where(s => !string.IsNullOrWhiteSpace(s)));
    private int AntallUsignert => _kvitteringer.Count(k => k.Id > 0 && k.Signatur is null);
    private SystemVedlegg? Lasplan => _vedlegg.FirstOrDefault(v => string.Equals(v.Type, "Låsplan", StringComparison.OrdinalIgnoreCase));
    private bool HarUlagredeEndringer => _nyeKvitteringer.Count > 0 || !Id.HasValue || _redigerInfo || Db.ChangeTracker.HasChanges();

    private IEnumerable<NokkelKvittering> FiltrerteKvitteringer => _kvitteringer
        .Where(k => k.Id > 0)
        .Where(k => _kvFilter switch { "usignert" => k.Signatur is null, "signert" => k.Signatur is not null, _ => true })
        .Where(k => string.IsNullOrWhiteSpace(_kvSok)
            || k.MottakerNavn.Contains(_kvSok, StringComparison.OrdinalIgnoreCase)
            || (k.NokkelBetegnelse?.Contains(_kvSok, StringComparison.OrdinalIgnoreCase) ?? false)
            || (k.Nokkelnummer?.Contains(_kvSok, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(k => k.Dato);

    private static string NokkelNokkel(NokkelKvittering k) => string.IsNullOrWhiteSpace(k.Nokkelnummer) ? (k.NokkelBetegnelse ?? "?") : k.Nokkelnummer!;

    private static readonly string[] AvatarFarger = ["#7a2b96", "#2054a3", "#2b7a4b", "#835e41", "#b0322a", "#9a5b12"];
    private static string AvatarFarge(string navn) => AvatarFarger[Math.Abs(navn.Sum(c => c)) % AvatarFarger.Length];

    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..Math.Min(2, deler[0].Length)].ToUpperInvariant(),
            _ => $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
        };
    }

    // Hendelsene er lagret som "Hva: detalj". Delt i to her, som Historikk på tilbud.
    private static (string Ikon, string Farge, string Tittel, string Detalj) HendelseVisning(string beskrivelse)
    {
        var skille = beskrivelse.IndexOf(':');
        var start = skille < 0 ? beskrivelse : beskrivelse[..skille];
        var detalj = skille < 0 ? "" : beskrivelse[(skille + 1)..].Trim();
        return start switch
        {
            "Ny nøkkel registrert" => ("lock", "blaa", "Nøkkel utlevert", detalj),
            "Rekvirent lagt til" => ("users", "teal", start, detalj),
            "Vedlegg lastet opp" => ("file-text", "gronn", start, detalj),
            "Låsplan byttet" => ("file-text", "gronn", start, detalj),
            "Notat oppdatert" => ("edit", "noytral", start, detalj),
            _ => ("clock", "noytral", start, detalj)
        };
    }

    private List<SystemVedlegg> AndreVedlegg => _vedlegg
        .Where(v => !ReferenceEquals(v, Lasplan))
        .OrderByDescending(v => v.OpprettetDato)
        .ToList();

    private static bool KanForhandsvises(SystemVedlegg v) =>
        v.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)
        || (v.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && !v.ContentType.Contains("svg", StringComparison.OrdinalIgnoreCase));

    private static string FilMerke(SystemVedlegg v) => v.ContentType.ToLowerInvariant() switch
    {
        "application/pdf" => "PDF",
        var t when t.StartsWith("image/") => "BILDE",
        var t when t.Contains("spreadsheet") || t.Contains("excel") => "XLS",
        var t when t.Contains("wordprocessing") || t.Contains("msword") => "DOC",
        _ => "FIL"
    };

    private static string FilFarge(SystemVedlegg v) => FilMerke(v) switch
    {
        "PDF" => "ky-rod",
        "XLS" => "ky-gronnfil",
        "DOC" => "ky-blafil",
        _ => "ky-grafil"
    };

    private static string Storrelse(SystemVedlegg v) => v.Data.Length >= 1_000_000
        ? $"{v.Data.Length / 1_000_000d:0.0} MB"
        : $"{Math.Max(1, v.Data.Length / 1000)} KB";

    private bool _visAlleHendelser;
    private int? _fjernVedleggId;
    private bool _lastOppApen;
    private bool _byttLasplan;
    private string? _vedleggVisUrl;
    private string _vedleggVisNavn = "";

    private void VisVedlegg(SystemVedlegg v)
    {
        _fane = "vedlegg";
        _vedleggVisNavn = v.Filnavn;
        _vedleggVisUrl = $"/systemvedlegg/{v.Id}?visning=true";
    }

    private void LastOppVedlegg(string type)
    {
        _fane = "vedlegg";
        _valgtVedleggType = type;
        _byttLasplan = false;
        _vedleggFeil = null;
        _lastOppApen = true;
    }

    private void ByttLasplan()
    {
        LastOppVedlegg("Låsplan");
        _byttLasplan = true;
    }

    private void AapneLasplan(SystemVedlegg plan)
    {
        _fane = "vedlegg";
        if (KanForhandsvises(plan))
        {
            VisVedlegg(plan);
        }
    }

    private void LukkLastOpp()
    {
        _lastOppApen = false;
        _byttLasplan = false;
        _vedleggFeil = null;
    }

    private static readonly System.Globalization.CultureInfo Kultur = new("nb-NO");

    private void VelgFane(string fane)
    {
        _fane = fane;
        _savedMessage = null;
    }

    // Ny utlevering og signering skjer i samme vindu. En ny utlevering er ikke
    // sporet før den lagres, så Lukk etterlater ingenting.
    private NokkelKvittering? _utlevering;
    private bool _utlBareSigner;
    private bool _signaturKlar;
    private bool _utlLagrer;
    private string? _utlFeil;
    private const string SignaturCanvas = "utlevering-signatur";

    private void NyUtlevering()
    {
        _fane = "nokler";
        _kvFilter = "alle";
        _utlevering = new NokkelKvittering { MottakerNavn = "", Dato = DateTime.Today };
        _utlBareSigner = false;
        _utlFeil = null;
        _signaturKlar = false;
    }

    private void SignerNa()
    {
        _fane = "nokler";
        _kvFilter = AntallUsignert > 0 ? "usignert" : "alle";
    }

    private void SignerRad(NokkelKvittering k)
    {
        _fane = "nokler";
        StartSigner(k);
    }

    private NokkelKvittering? SisteUtlevering => _kvitteringer
        .Where(k => k.Id > 0)
        .OrderByDescending(k => k.Dato)
        .ThenByDescending(k => k.Id)
        .FirstOrDefault();

    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("systemkort-bredde", "normal") == "full";
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("systemkort-bredde", _full ? "full" : "normal");
    }

    private void StartSigner(NokkelKvittering k)
    {
        _utlevering = k;
        _utlBareSigner = true;
        _utlFeil = null;
        _signaturKlar = false;
    }

    private void LukkUtlevering()
    {
        _utlevering = null;
        _utlFeil = null;
        _signaturKlar = false;
    }

    private async Task TomSignatur()
    {
        await JS.InvokeVoidAsync("signatur.clear", SignaturCanvas);
    }

    private async Task<byte[]?> HentSignatur()
    {
        if (await JS.InvokeAsync<bool>("signatur.isEmpty", SignaturCanvas))
        {
            return null;
        }

        return Convert.FromBase64String(await JS.InvokeAsync<string>("signatur.getPngBase64", SignaturCanvas));
    }

    private async Task Utlever(bool medSignatur)
    {
        if (_utlevering is not { } k || _utlLagrer)
        {
            return;
        }

        k.MottakerNavn = k.MottakerNavn.Trim();
        if (k.MottakerNavn.Length == 0)
        {
            _utlFeil = "Skriv hvem som får nøkkelen.";
            return;
        }

        if (k.Antall < 1)
        {
            _utlFeil = "Antall må være minst 1.";
            return;
        }

        byte[]? signatur = null;
        if (medSignatur)
        {
            signatur = await HentSignatur();
            if (signatur is null)
            {
                _utlFeil = "Mottakeren må signere, eller velg Signer senere.";
                return;
            }
        }

        _utlLagrer = true;
        try
        {
            _nyeKvitteringer.Add(k);
            await Lagre();
            if (_error is not null)
            {
                _nyeKvitteringer.Remove(k);
                _utlFeil = _error;
                _error = null;
                return;
            }

            if (signatur is not null)
            {
                k.Signatur = signatur;
                k.SignertDato = DateTime.Now;
                await Db.SaveChangesAsync();
            }

            _savedMessage = signatur is null
                ? $"Utlevert til {k.MottakerNavn}. Signatur mangler."
                : $"Utlevert til {k.MottakerNavn} og signert.";
            LukkUtlevering();
        }
        finally
        {
            _utlLagrer = false;
        }
    }

    private bool _rekApen;
    private Rekvirent? _rekEndrer;
    private string _rekNavn = "";
    private string? _rekRolle;
    private string? _rekTelefon;
    private string? _rekEpost;
    private string? _rekFeil;
    private bool _rekBekreftFjern;
    private bool _rekLagrer;

    private void NyRekvirent()
    {
        _rekEndrer = null;
        _rekNavn = "";
        _rekRolle = _rekTelefon = _rekEpost = null;
        _rekFeil = null;
        _rekBekreftFjern = false;
        _rekApen = true;
    }

    private void EndreRekvirent(Rekvirent r)
    {
        _rekEndrer = r;
        _rekNavn = r.Navn;
        _rekRolle = r.Rolle;
        _rekTelefon = r.Telefon;
        _rekEpost = r.Epost;
        _rekFeil = null;
        _rekBekreftFjern = false;
        _rekApen = true;
    }

    private void LukkRekvirent()
    {
        _rekApen = false;
        _rekEndrer = null;
        _rekFeil = null;
    }

    private static string? Rens(string? verdi) => string.IsNullOrWhiteSpace(verdi) ? null : verdi.Trim();

    private async Task LagreRekvirent()
    {
        if (_rekLagrer)
        {
            return;
        }

        var navn = _rekNavn.Trim();
        if (navn.Length == 0)
        {
            _rekFeil = "Rekvirenten må ha et navn.";
            return;
        }

        _rekLagrer = true;
        try
        {
            var ny = _rekEndrer is null;
            var r = _rekEndrer ?? new Rekvirent { Navn = navn };
            if (ny)
            {
                _rekvirenter.Add(r);
            }

            r.Navn = navn;
            r.Rolle = Rens(_rekRolle);
            r.Telefon = Rens(_rekTelefon);
            r.Epost = Rens(_rekEpost);

            await Lagre();
            if (_error is not null)
            {
                if (ny)
                {
                    _rekvirenter.Remove(r);
                }

                _rekFeil = _error;
                _error = null;
                return;
            }

            _savedMessage = ny ? $"{navn} er lagt til." : $"{navn} er oppdatert.";
            LukkRekvirent();
        }
        finally
        {
            _rekLagrer = false;
        }
    }

    private async Task FjernRekvirent()
    {
        if (_rekEndrer is not { } r || _rekLagrer)
        {
            return;
        }

        _rekLagrer = true;
        try
        {
            _rekvirenter.Remove(r);
            await Lagre();
            if (_error is not null)
            {
                _rekvirenter.Add(r);
                _rekFeil = _error;
                _error = null;
                return;
            }

            _savedMessage = $"{r.Navn} er fjernet.";
            LukkRekvirent();
        }
        finally
        {
            _rekLagrer = false;
        }
    }


    private RenderFragment FaneKnapp(string f, string ikon, string tekst, int? teller, string farge) =>
        @<button type="button" class="k-vfane @(_fane == f || (!Id.HasValue && f == "info") ? "pa" : "")" @onclick="@(() => VelgFane(f))">
            <Icon Name="@ikon" /><span class="k-vfane-tekst">@tekst</span>
            @if (teller is > 0)
            {
                <em class="@farge">@teller</em>
            }
        </button>;

    // O12: tallene i en lys grå stripe øverst, siste utleveringer til venstre og
    // rekvirenter og dokumentasjon til høyre.
    private RenderFragment Oversikt() =>
        @<div class="ky-flate">
            <div class="ky-stripe">
                <button type="button" @onclick='@(() => VelgFane("nokler"))'>
                    <span>Utlevert</span>
                    <b>@TotaltAntallNokler @(TotaltAntallNokler == 1 ? "nøkkel" : "nøkler")</b>
                    <small>@NoklerGruppert.Count @(NoklerGruppert.Count == 1 ? "nøkkeltype" : "nøkkeltyper")</small>
                </button>
                <button type="button" @onclick='@(() => VelgFane("rekvirenter"))'>
                    <span>Rekvirenter</span>
                    <b>@_rekvirenter.Count @(_rekvirenter.Count == 1 ? "rekvirent" : "rekvirenter")</b>
                    <small>kan bestille nøkler</small>
                </button>
                <button type="button" @onclick='@(() => VelgFane("nokler"))'>
                    <span>Sist utlevert</span>
                    <b>@(SisteUtlevering?.Dato.ToString("dd.MM.yyyy") ?? "–")</b>
                    <small>@(SisteUtlevering is { } siste ? $"til {siste.MottakerNavn}" : "ingen ennå")</small>
                </button>
                <button type="button" class="@(AntallUsignert > 0 ? "ky-stripe-gul" : "")" @onclick="SignerNa">
                    <span>Signatur</span>
                    <b class="@(AntallUsignert == 0 && SisteUtlevering is not null ? "ky-gronn" : "")">@(AntallUsignert > 0 ? $"{AntallUsignert} mangler" : SisteUtlevering is null ? "–" : "Alle signert")</b>
                    <small>@(AntallUsignert > 0 ? "trykk for å signere" : SisteUtlevering is null ? "ingen utleveringer" : "ingen venter")</small>
                </button>
            </div>

            <div class="ky-to">
                <section class="ky-kort">
                    <div class="ky-hode">Siste utleveringer <button type="button" @onclick='@(() => VelgFane("nokler"))'>Se alle</button></div>
                    @if (SisteUtlevering is null)
                    {
                        <p class="ky-tom">Ingen nøkler utlevert ennå.</p>
                    }
                    else
                    {
                        <table class="ky-tabell">
                            <thead>
                                <tr>
                                    <th>Utlevert til</th>
                                    <th class="ky-skjul">Nr</th>
                                    <th>Signatur</th>
                                    <th class="ky-skjul">Dato</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in _kvitteringer.Where(k => k.Id > 0).OrderByDescending(k => k.Dato).ThenByDescending(k => k.Id).Take(5))
                                {
                                    var kv = k;
                                    <tr class="@(kv.Signatur is null ? "ky-mangler" : "")" @key="kv.Id">
                                        <td>
                                            <span class="ky-celle">
                                                <span class="ky-av">@Initialer(kv.MottakerNavn)</span>
                                                <b>@kv.MottakerNavn</b>
                                            </span>
                                        </td>
                                        <td class="ky-skjul">
                                            @if (!string.IsNullOrWhiteSpace(kv.Nokkelnummer))
                                            {
                                                <span class="ky-nr">@kv.Nokkelnummer</span>
                                            }
                                            else
                                            {
                                                <text>–</text>
                                            }
                                        </td>
                                        <td>
                                            @if (kv.Signatur is not null)
                                            {
                                                <img class="k-sig" src="@($"/nokkelkvittering/{kv.Id}/signatur.png?v={kv.SignertDato?.Ticks}")" alt="Signatur fra @kv.MottakerNavn" title="@($"Signert {kv.SignertDato:dd.MM.yyyy HH:mm}")" />
                                            }
                                            else
                                            {
                                                <button type="button" class="ky-signer" @onclick="@(() => SignerRad(kv))">Signer</button>
                                            }
                                        </td>
                                        <td class="ky-skjul k-mono">@kv.Dato.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <div class="ky-kolonne">
                    <section class="ky-kort">
                        <div class="ky-hode">Rekvirenter <button type="button" @onclick='@(() => VelgFane("rekvirenter"))'>Se alle</button></div>
                        @if (_rekvirenter.Count == 0)
                        {
                            <p class="ky-tom">Ingen rekvirenter lagt til ennå.</p>
                        }
                        <div class="ky-rader">
                            @foreach (var r in _rekvirenter.Take(4))
                            {
                                <div class="ky-rad">
                                    <span class="ky-celle">
                                        <span class="ky-av">@Initialer(r.Navn)</span>
                                        <span><b>@r.Navn</b><small>@r.Rolle</small></span>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(r.Telefon))
                                    {
                                        <a href="@($"tel:{r.Telefon}")">@r.Telefon</a>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <section class="ky-kort">
                        <div class="ky-hode">Dokumentasjon</div>
                        <div class="ky-rader">
                            <div class="ky-rad">
                                <span><b>Låsplan</b><small>@(Lasplan is null ? "Ikke lastet opp" : Lasplan.Filnavn)</small></span>
                                @if (Lasplan is { } plan)
                                {
                                    <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => AapneLasplan(plan))">Åpne</button>
                                }
                                else
                                {
                                    <button type="button" class="k-knapp k-knapp-s" @onclick='@(() => LastOppVedlegg("Låsplan"))'>Last opp</button>
                                }
                            </div>
                            <div class="ky-rad">
                                <span><b>Vedlegg</b><small>@(_vedlegg.Count == 1 ? "1 fil" : $"{_vedlegg.Count} filer")</small></span>
                                <button type="button" class="k-knapp k-knapp-s" @onclick='@(() => VelgFane("vedlegg"))'>Åpne</button>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>;

    // Én fane for nøkler og utleveringer: hver rad er en utlevering med signaturen
    // i tabellen. Har mottakeren signert, er det ingen knapp på raden. Tallene
    // står på Oversikt.
    private RenderFragment Nokler() =>
        @<div class="ky-flate">
            @if (AntallUsignert > 0 || _kvitteringer.Count(k => k.Id > 0) > 5 || !string.IsNullOrWhiteSpace(_kvSok))
            {
                <div class="ky-topp">
                    <label class="k-sokf"><Icon Name="search" /><input @bind="_kvSok" @bind:event="oninput" placeholder="Søk etter nøkkel eller person" aria-label="Søk etter nøkkel eller person" /></label>
                    @if (AntallUsignert > 0 || _kvFilter == "usignert")
                    {
                        <button type="button" class="k-chip @(_kvFilter == "alle" ? "pa" : "")" @onclick='@(() => _kvFilter = "alle")'>Alle <em>@_kvitteringer.Count(k => k.Id > 0)</em></button>
                        <button type="button" class="k-chip @(_kvFilter == "usignert" ? "pa" : "")" @onclick='@(() => _kvFilter = "usignert")'>Mangler signatur <em>@AntallUsignert</em></button>
                    }
                </div>
            }

            <section class="ky-kort">
                <div class="ky-hode">Nøkler</div>
                @if (!FiltrerteKvitteringer.Any())
                {
                    <p class="ky-tom">@(_kvitteringer.Any(k => k.Id > 0) ? "Ingen treff." : "Ingen nøkler utlevert ennå. Trykk Ny utlevering for å starte.")</p>
                }
                else
                {
                    <table class="ky-tabell">
                        <thead>
                            <tr>
                                <th>Nøkkel</th>
                                <th class="ky-skjul">Nr</th>
                                <th class="ky-skjul">Antall</th>
                                <th>Utlevert til</th>
                                <th class="ky-skjul">Rekvirert av</th>
                                <th>Signatur</th>
                                <th class="ky-skjul">Dato</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in FiltrerteKvitteringer)
                            {
                                var kv = k;
                                @if (_redigerKvitteringId == kv.Id)
                                {
                                    <tr class="ky-endre" @key="kv.Id">
                                        <td colspan="8">
                                            <div class="ky-endre-felt">
                                                <label class="k-felt2">Nøkkel<input class="k-inp" @bind="kv.NokkelBetegnelse" /></label>
                                                <label class="k-felt2">Nr<input class="k-inp" @bind="kv.Nokkelnummer" /></label>
                                                <label class="k-felt2">Antall<input class="k-inp" type="number" min="1" @bind="kv.Antall" /></label>
                                                <label class="k-felt2">Utlevert til<input class="k-inp" @bind="kv.MottakerNavn" /></label>
                                                <label class="k-felt2">Rekvirert av<input class="k-inp" @bind="kv.RekvirertAv" /></label>
                                                <label class="k-felt2">Dato<input class="k-inp" type="date" @bind="kv.Dato" /></label>
                                            </div>
                                            <div class="ky-endre-valg">
                                                @if (kv.Signatur is not null)
                                                {
                                                    <button type="button" class="k-lenke k-rod-tekst" @onclick="@(() => FjernSignatur(kv))">Fjern signatur</button>
                                                }
                                                <button type="button" class="k-lenke k-rod-tekst" @onclick="@(() => FjernKvitteringRad(kv))">Fjern utlevering</button>
                                                <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => _redigerKvitteringId = null)">Ferdig</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="@(kv.Signatur is null ? "ky-mangler" : "")" @key="kv.Id">
                                        <td>
                                            <span class="ky-celle">
                                                <span class="ky-rute"><Icon Name="lock" /></span>
                                                <span>
                                                    <b>@(string.IsNullOrWhiteSpace(kv.NokkelBetegnelse) ? "Ikke angitt" : kv.NokkelBetegnelse)</b>
                                                    <small class="ky-smal">@kv.Nokkelnummer</small>
                                                </span>
                                            </span>
                                        </td>
                                        <td class="ky-skjul">
                                            @if (!string.IsNullOrWhiteSpace(kv.Nokkelnummer))
                                            {
                                                <span class="ky-nr">@kv.Nokkelnummer</span>
                                            }
                                            else
                                            {
                                                <text>–</text>
                                            }
                                        </td>
                                        <td class="ky-skjul">@kv.Antall stk</td>
                                        <td>
                                            <span class="ky-celle">
                                                <span class="ky-av">@Initialer(kv.MottakerNavn)</span>
                                                <b>@kv.MottakerNavn</b>
                                            </span>
                                        </td>
                                        <td class="ky-skjul">@(kv.RekvirertAv ?? "–")</td>
                                        <td>
                                            @if (kv.Signatur is not null)
                                            {
                                                <img class="k-sig" src="@($"/nokkelkvittering/{kv.Id}/signatur.png?v={kv.SignertDato?.Ticks}")" alt="Signatur fra @kv.MottakerNavn" title="@($"Signert {kv.SignertDato:dd.MM.yyyy HH:mm}")" />
                                            }
                                            else
                                            {
                                                <button type="button" class="ky-signer" @onclick="@(() => StartSigner(kv))">Signer</button>
                                            }
                                        </td>
                                        <td class="ky-skjul k-mono">@kv.Dato.ToString("dd.MM.yyyy")</td>
                                        <td class="ky-valg"><button type="button" title="Endre" aria-label="@($"Endre utlevering til {kv.MottakerNavn}")" @onclick="@(() => _redigerKvitteringId = kv.Id)"><Icon Name="edit" /></button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </section>

            @if (_utlevering is { } u)
            {
                <datalist id="rekvirent-navn">
                    @foreach (var r in _rekvirenter.Where(r => !string.IsNullOrWhiteSpace(r.Navn)))
                    {
                        <option value="@r.Navn"></option>
                    }
                </datalist>
                <div class="ky-lys">
                    <div class="ky-vindu" role="dialog" aria-modal="true" aria-label="@(_utlBareSigner ? "Signer utlevering" : "Ny utlevering")">
                        <div class="ky-vindu-hode">
                            <b>@(_utlBareSigner ? "Signer utlevering" : "Ny utlevering")</b>
                            <button type="button" title="Lukk" aria-label="Lukk" @onclick="LukkUtlevering"><Icon Name="x" /></button>
                        </div>
                        <div class="ky-vindu-innhold">
                            @if (_utlBareSigner)
                            {
                                <p class="ky-oppsummering"><b>@u.MottakerNavn</b> · @(u.NokkelBetegnelse ?? "Nøkkel") @u.Nokkelnummer · @u.Antall stk · @u.Dato.ToString("dd.MM.yyyy")</p>
                            }
                            else
                            {
                                <div class="ky-felt">
                                    <label class="k-felt2">Nøkkel<input class="k-inp" list="nokkel-navn" @bind="u.NokkelBetegnelse" placeholder="F.eks. Hovednøkkel" /></label>
                                    <label class="k-felt2">Nr<input class="k-inp" list="nokkel-nummer" @bind="u.Nokkelnummer" placeholder="F.eks. K1" /></label>
                                    <label class="k-felt2">Utlevert til<input class="k-inp" @bind="u.MottakerNavn" @bind:event="oninput" placeholder="Navn på mottaker" /></label>
                                    <label class="k-felt2">Rekvirert av<input class="k-inp" list="rekvirent-navn" @bind="u.RekvirertAv" /></label>
                                    <label class="k-felt2">Antall<input class="k-inp" type="number" min="1" @bind="u.Antall" /></label>
                                    <label class="k-felt2">Dato<input class="k-inp" type="date" @bind="u.Dato" /></label>
                                </div>
                                <datalist id="nokkel-navn">
                                    @foreach (var n in NoklerGruppert.Select(g => g.Betegnelse).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct())
                                    {
                                        <option value="@n"></option>
                                    }
                                </datalist>
                                <datalist id="nokkel-nummer">
                                    @foreach (var n in NoklerGruppert.Select(g => g.Nummer).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct())
                                    {
                                        <option value="@n"></option>
                                    }
                                </datalist>
                            }
                            <div class="ky-signatur">
                                <span>Signatur</span>
                                <canvas id="@SignaturCanvas" width="520" height="160" aria-label="Signaturfelt"></canvas>
                                <small>Signer med fingeren eller pennen</small>
                            </div>
                            @if (!string.IsNullOrEmpty(_utlFeil))
                            {
                                <p class="form-error ky-feil">@_utlFeil</p>
                            }
                        </div>
                        <div class="ky-vindu-fot">
                            <button type="button" class="k-knapp k-knapp-s ky-tom-knapp" @onclick="TomSignatur">Tøm</button>
                            @if (_utlBareSigner)
                            {
                                <button type="button" class="k-knapp k-knapp-s" @onclick="LukkUtlevering">Avbryt</button>
                                <button type="button" class="k-knapp k-knapp-s k-knapp-p" disabled="@_utlLagrer" @onclick="LagreSignatur">Lagre signatur</button>
                            }
                            else
                            {
                                <button type="button" class="k-knapp k-knapp-s" disabled="@_utlLagrer" @onclick="@(() => Utlever(false))">Signer senere</button>
                                <button type="button" class="k-knapp k-knapp-s k-knapp-p" disabled="@_utlLagrer" @onclick="@(() => Utlever(true))">Utlever og signer</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>;

    // R1 + R2: rekvirentene i samme tabell som Nøkler. Ny og Endre skjer i et
    // vindu som lagrer med en gang.
    private RenderFragment Rekvirenter() =>
        @<div class="ky-flate">
            <section class="ky-kort">
                <div class="ky-hode">Rekvirenter <button type="button" class="ky-ny" @onclick="NyRekvirent"><Icon Name="plus" />Legg til rekvirent</button></div>
                @if (_rekvirenter.Count == 0)
                {
                    <p class="ky-tom">Ingen rekvirenter lagt til ennå.</p>
                }
                else
                {
                    <table class="ky-tabell">
                        <thead>
                            <tr>
                                <th>Navn</th>
                                <th class="ky-skjul">Rolle</th>
                                <th>Telefon</th>
                                <th class="ky-skjul">E-post</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _rekvirenter)
                            {
                                var rk = r;
                                <tr @key="rk">
                                    <td>
                                        <span class="ky-celle">
                                            <span class="ky-av">@Initialer(rk.Navn)</span>
                                            <span>
                                                <b>@rk.Navn</b>
                                                <small class="ky-smal">@rk.Rolle</small>
                                            </span>
                                        </span>
                                    </td>
                                    <td class="ky-skjul">@(string.IsNullOrWhiteSpace(rk.Rolle) ? "–" : rk.Rolle)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(rk.Telefon))
                                        {
                                            <a class="ky-lenke" href="@($"tel:{rk.Telefon}")">@rk.Telefon</a>
                                        }
                                        else
                                        {
                                            <text>–</text>
                                        }
                                    </td>
                                    <td class="ky-skjul">
                                        @if (!string.IsNullOrWhiteSpace(rk.Epost))
                                        {
                                            <a class="ky-lenke" href="@($"mailto:{rk.Epost}")">@rk.Epost</a>
                                        }
                                        else
                                        {
                                            <text>–</text>
                                        }
                                    </td>
                                    <td class="ky-valg"><button type="button" title="Endre" aria-label="@($"Endre {rk.Navn}")" @onclick="@(() => EndreRekvirent(rk))"><Icon Name="edit" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @if (_rekApen)
            {
                <div class="ky-lys">
                    <div class="ky-vindu" role="dialog" aria-modal="true" aria-label="@(_rekEndrer is null ? "Ny rekvirent" : "Endre rekvirent")">
                        <div class="ky-vindu-hode">
                            <b>@(_rekEndrer is null ? "Ny rekvirent" : "Endre rekvirent")</b>
                            <button type="button" title="Lukk" aria-label="Lukk" @onclick="LukkRekvirent"><Icon Name="x" /></button>
                        </div>
                        <div class="ky-vindu-innhold">
                            <div class="ky-felt">
                                <label class="k-felt2">Navn<input class="k-inp" @bind="_rekNavn" @bind:event="oninput" placeholder="Navn" /></label>
                                <label class="k-felt2">Rolle<input class="k-inp" @bind="_rekRolle" placeholder="F.eks. Driftsleder" /></label>
                                <label class="k-felt2">Telefon<input class="k-inp" type="tel" @bind="_rekTelefon" placeholder="Telefon" /></label>
                                <label class="k-felt2">E-post<input class="k-inp" type="email" @bind="_rekEpost" placeholder="E-post" /></label>
                            </div>
                            @if (!string.IsNullOrEmpty(_rekFeil))
                            {
                                <p class="form-error ky-feil">@_rekFeil</p>
                            }
                        </div>
                        <div class="ky-vindu-fot">
                            @if (_rekEndrer is not null)
                            {
                                @if (_rekBekreftFjern)
                                {
                                    <span class="ky-fjern ky-tom-knapp">
                                        Fjerne rekvirenten?
                                        <button type="button" class="k-knapp k-knapp-s k-rod-tekst" disabled="@_rekLagrer" @onclick="FjernRekvirent">Ja, fjern</button>
                                        <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => _rekBekreftFjern = false)">Nei</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="k-knapp k-knapp-s k-rod-tekst ky-tom-knapp" @onclick="@(() => _rekBekreftFjern = true)">Fjern</button>
                                }
                            }
                            <button type="button" class="k-knapp k-knapp-s" @onclick="LukkRekvirent">Avbryt</button>
                            <button type="button" class="k-knapp k-knapp-s k-knapp-p" disabled="@_rekLagrer" @onclick="LagreRekvirent">@(_rekEndrer is null ? "Legg til" : "Lagre")</button>
                        </div>
                    </div>
                </div>
            }
        </div>;

    // L1: låsplanen stort øverst som Siste versjon på tilbud, og andre vedlegg i
    // listen under. PDF og bilder åpnes i forhåndsvisning.
    private RenderFragment Vedlegg() =>
        @<div class="ky-flate">
            @if (!Id.HasValue)
            {
                <span class="k-smule">Lagre systemet først for å kunne legge til vedlegg.</span>
            }
            else
            {
                <section class="ky-kort">
                    <div class="ky-hode">Låsplan</div>
                    @if (Lasplan is { } lp)
                    {
                        <div class="ky-hero">
                            @if (KanForhandsvises(lp))
                            {
                                <button type="button" class="ky-ark" title="Åpne" aria-label="@($"Åpne {lp.Filnavn}")" @onclick="@(() => VisVedlegg(lp))"><span></span><span></span><span class="k"></span><span></span><span class="k"></span><span></span><em class="@FilFarge(lp)">@FilMerke(lp)</em></button>
                            }
                            else
                            {
                                <span class="ky-ark"><span></span><span></span><span class="k"></span><span></span><span class="k"></span><span></span><em class="@FilFarge(lp)">@FilMerke(lp)</em></span>
                            }
                            <div class="ky-hero-tekst">
                                <b>@lp.Filnavn</b>
                                <dl>
                                    <div><dt>Lastet opp</dt><dd>@lp.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd></div>
                                    <div><dt>Størrelse</dt><dd>@Storrelse(lp)</dd></div>
                                </dl>
                                <div class="ky-hero-knapper">
                                    @if (KanForhandsvises(lp))
                                    {
                                        <button type="button" class="ky-kn ky-kn-p" @onclick="@(() => VisVedlegg(lp))"><Icon Name="file-text" />Åpne @(FilMerke(lp) == "PDF" ? "PDF" : "")</button>
                                    }
                                    <a class="ky-kn" href="@($"/systemvedlegg/{lp.Id}")" download="@lp.Filnavn"><Icon Name="download" />Last ned</a>
                                    <button type="button" class="ky-kn" @onclick="ByttLasplan"><Icon Name="upload" />Bytt</button>
                                    @if (_fjernVedleggId == lp.Id)
                                    {
                                        <span class="ky-fjern">
                                            Fjerne låsplanen?
                                            <button type="button" class="k-knapp k-knapp-s k-rod-tekst" @onclick="@(() => RemoveVedlegg(lp))">Ja, fjern</button>
                                            <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => _fjernVedleggId = null)">Nei</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="ky-kn ky-kn-fare" @onclick="@(() => _fjernVedleggId = lp.Id)"><Icon Name="trash" />Fjern</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="ky-hero ky-hero-tom">
                            <span class="ky-ark"><span></span><span></span><span class="k"></span><span></span><span class="k"></span><span></span></span>
                            <div class="ky-hero-tekst">
                                <b>Ingen låsplan lastet opp</b>
                                <span>Last opp låsplanen, så ligger den klar her og på Oversikt.</span>
                                <div class="ky-hero-knapper">
                                    <button type="button" class="ky-kn ky-kn-p" @onclick='@(() => LastOppVedlegg("Låsplan"))'><Icon Name="upload" />Last opp låsplan</button>
                                </div>
                            </div>
                        </div>
                    }
                </section>

                <section class="ky-kort">
                    <div class="ky-hode">
                        <span class="ky-hode-tittel">Andre vedlegg <em>@AndreVedlegg.Count</em></span>
                        <button type="button" class="ky-ny" @onclick='@(() => LastOppVedlegg("Annet"))'><Icon Name="upload" />Last opp</button>
                    </div>
                    @if (AndreVedlegg.Count == 0)
                    {
                        <p class="ky-tom">Ingen andre vedlegg ennå.</p>
                    }
                    <div class="ky-rader">
                        @foreach (var v in AndreVedlegg)
                        {
                            var vd = v;
                            <div class="ky-fil" @key="vd.Id">
                                <span class="ky-filik"><Icon Name="file-text" /><i class="@FilFarge(vd)">@FilMerke(vd)</i></span>
                                <span class="ky-filnavn">
                                    <b title="@vd.Filnavn">@vd.Filnavn</b>
                                    <small>@(string.IsNullOrWhiteSpace(vd.Type) ? "Ukategorisert" : vd.Type) · @vd.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Storrelse(vd)</small>
                                </span>
                                @if (_fjernVedleggId == vd.Id)
                                {
                                    <span class="ky-fjern">
                                        Fjerne filen?
                                        <button type="button" class="k-knapp k-knapp-s k-rod-tekst" @onclick="@(() => RemoveVedlegg(vd))">Ja, fjern</button>
                                        <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => _fjernVedleggId = null)">Nei</button>
                                    </span>
                                }
                                else
                                {
                                    <span class="ky-filvalg">
                                        @if (KanForhandsvises(vd))
                                        {
                                            <button type="button" title="Åpne" aria-label="@($"Åpne {vd.Filnavn}")" @onclick="@(() => VisVedlegg(vd))"><Icon Name="eye" /></button>
                                        }
                                        <a href="@($"/systemvedlegg/{vd.Id}")" download="@vd.Filnavn" title="Last ned" aria-label="@($"Last ned {vd.Filnavn}")"><Icon Name="download" /></a>
                                        <button type="button" title="Fjern" aria-label="@($"Fjern {vd.Filnavn}")" @onclick="@(() => _fjernVedleggId = vd.Id)"><Icon Name="trash" /></button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </section>

                @if (_lastOppApen)
                {
                    <div class="ky-lys">
                        <div class="ky-vindu" role="dialog" aria-modal="true" aria-label="@(_byttLasplan ? "Bytt låsplan" : "Last opp vedlegg")">
                            <div class="ky-vindu-hode">
                                <b>@(_byttLasplan ? "Bytt låsplan" : "Last opp vedlegg")</b>
                                <button type="button" title="Lukk" aria-label="Lukk" @onclick="LukkLastOpp"><Icon Name="x" /></button>
                            </div>
                            <div class="ky-vindu-innhold">
                                @if (!_byttLasplan)
                                {
                                    <label class="k-felt2">
                                        Type
                                        <select class="k-inp" @bind="_valgtVedleggType">
                                            <option value="Låsplan">Låsplan</option>
                                            <option value="Sikkerhetsskjema">Sikkerhetsskjema</option>
                                            <option value="Bestillingsskjema">Bestillingsskjema</option>
                                            <option value="Annet">Annet</option>
                                        </select>
                                    </label>
                                }
                                else
                                {
                                    <p class="ky-oppsummering">Den nye filen erstatter <b>@Lasplan?.Filnavn</b>.</p>
                                }
                                <label class="ky-drop">
                                    <Icon Name="upload" />
                                    <b>@(_uploadingVedlegg ? "Laster opp..." : "Dra filer hit, eller trykk for å velge")</b>
                                    <small>PDF, bilde, Word eller Excel, maks 20 MB</small>
                                    @if (_byttLasplan)
                                    {
                                        <InputFile OnChange="OnVedleggSelected" disabled="@_uploadingVedlegg" />
                                    }
                                    else
                                    {
                                        <InputFile OnChange="OnVedleggSelected" multiple disabled="@_uploadingVedlegg" />
                                    }
                                </label>
                                @if (!string.IsNullOrEmpty(_vedleggFeil))
                                {
                                    <p class="form-error ky-feil">@_vedleggFeil</p>
                                }
                            </div>
                            <div class="ky-vindu-fot">
                                <button type="button" class="k-knapp k-knapp-s" @onclick="LukkLastOpp">Avbryt</button>
                            </div>
                        </div>
                    </div>
                }

                <PdfPreviewModal Url="@_vedleggVisUrl" Tittel="@_vedleggVisNavn" OnClose="@(() => _vedleggVisUrl = null)" />
            }
        </div>;

    // A1: samme tidslinje som Historikk på tilbud. Er det mange hendelser vises
    // de nyeste, og resten ligger bak Se alle.
    private const int AktivitetVises = 10;

    private RenderFragment Aktivitet() =>
        @<div class="ky-flate">
            @if (_hendelser.Count == 0)
            {
                <p class="ky-tom">Ingen aktivitet registrert ennå.</p>
            }
            else
            {
                <div class="tidslinje">
                    @foreach (var h in _visAlleHendelser ? _hendelser : _hendelser.Take(AktivitetVises))
                    {
                        var (ikon, farge, tittel, detalj) = HendelseVisning(h.Beskrivelse);
                        <div class="hend" @key="h.Id">
                            <div class="hend-linje"></div>
                            <div class="hend-ikon hend-ikon-@farge"><Icon Name="@ikon" /></div>
                            <div class="hend-body">
                                <div>
                                    <div class="hend-tittel">@tittel</div>
                                    <div class="hend-meta">@(h.UtfortAvBruker?.Navn ?? "Ukjent bruker") · @h.Tidspunkt.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="hend-beskrivelse">@detalj</div>
                            </div>
                        </div>
                    }
                </div>
                @if (_hendelser.Count > AktivitetVises)
                {
                    <div class="ky-mer">
                        <button type="button" class="k-knapp k-knapp-s" @onclick="@(() => _visAlleHendelser = !_visAlleHendelser)">@(_visAlleHendelser ? "Vis færre" : $"Se alle ({_hendelser.Count})")</button>
                    </div>
                }
            }
        </div>;

