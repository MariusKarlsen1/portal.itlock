    private RenderFragment Felt(string etikett, string? verdi) =>
        @<div class="k-felt"><small>@etikett</small>@if (string.IsNullOrWhiteSpace(verdi)) {<b class="k-ikke-satt">Ikke satt</b>} else {<b>@verdi</b>}</div>;
    private Nokkelsystem _form = new() { Systemnummer = "" };
    private List<Rekvirent> _rekvirenter = [];
    private List<NokkelKvittering> _kvitteringer = [];
    private List<NokkelKvittering> _nyeKvitteringer = [];
    private List<SystemVedlegg> _vedlegg = [];
    private List<NokkelsystemHendelse> _hendelser = [];
    private string _valgtVedleggType = "";
    private bool _uploadingVedlegg;
    private string? _vedleggFeil;
    private bool _notFound;
    private bool _confirmingDelete;
    private bool _visHandlingerMeny;
    private int? _loadedId;
    private string? _error;
    private string? _savedMessage;
    private string _fane = "oversikt";
    private string? _opprinneligNotater;
    private long _bildeVersjon = DateTime.Now.Ticks;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    private int? _signerendeKvitteringId;
    private int? _sisteInitialisertCanvasId;

    private sealed record NokkelGruppe(string? Betegnelse, string? Nummer, int Totalt, DateTime SistUtlevert);

    private List<NokkelGruppe> NoklerGruppert =>
        _kvitteringer
            .GroupBy(k => (k.NokkelBetegnelse, k.Nokkelnummer))
            .Select(g => new NokkelGruppe(g.Key.NokkelBetegnelse, g.Key.Nokkelnummer, g.Sum(x => x.Antall), g.Max(x => x.Dato)))
            .OrderByDescending(g => g.SistUtlevert)
            .ToList();

    private int TotaltAntallNokler => _kvitteringer.Sum(k => k.Antall);

    private string? FullAdresse
    {
        get
        {
            var deler = new[] { _form.Adresse, $"{_form.Postnr} {_form.Sted}".Trim() }
                .Where(d => !string.IsNullOrWhiteSpace(d));
            var tekst = string.Join(", ", deler);
            return string.IsNullOrWhiteSpace(tekst) ? null : tekst;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _confirmingDelete = false;
        _savedMessage = null;
        _error = null;
        _notFound = false;
        _nyeKvitteringer = [];
        _fane = Id.HasValue ? "oversikt" : "info";

        if (Id.HasValue)
        {
            var existing = await Db.Nokkelsystemer
                .Include(s => s.Rekvirenter)
                .Include(s => s.Kvitteringer)
                .Include(s => s.Vedlegg)
                .FirstOrDefaultAsync(s => s.Id == Id.Value);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _form = existing;
            _rekvirenter = existing.Rekvirenter;
            _kvitteringer = existing.Kvitteringer;
            _vedlegg = existing.Vedlegg;
            _opprinneligNotater = existing.Notater;
            await LastHendelserAsync();
        }
        else
        {
            _rekvirenter = [];
            _kvitteringer = [];
            _vedlegg = [];
            _hendelser = [];
            _opprinneligNotater = null;
            _form = new Nokkelsystem
            {
                Systemnummer = "",
                Rekvirenter = _rekvirenter,
                Kvitteringer = _kvitteringer,
                Vedlegg = _vedlegg
            };
        }
    }

    private async Task LastHendelserAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _hendelser = await Db.NokkelsystemHendelser
            .Where(h => h.NokkelsystemId == Id.Value)
            .Include(h => h.UtfortAvBruker)
            .OrderByDescending(h => h.Tidspunkt)
            .Take(20)
            .ToListAsync();
    }

    private void LoggHendelse(string beskrivelse)
    {
        Db.NokkelsystemHendelser.Add(new NokkelsystemHendelse
        {
            NokkelsystemId = _form.Id,
            Beskrivelse = beskrivelse,
            Tidspunkt = DateTime.Now,
            UtfortAvBrukerId = _naverendeBrukerId
        });
    }

    private void HurtigLeggTilRekvirent()
    {
        _fane = "rekvirenter";
        LeggTilRekvirent();
    }

    private void HurtigRegistrerNokkel()
    {
        _fane = "kvitteringer";
        LeggTilKvittering();
    }

    private void LeggTilRekvirent()
    {
        _rekvirenter.Add(new Rekvirent { Navn = "" });
    }

    private void LeggTilKvittering()
    {
        // Legges i en egen, ikke-sporet liste til Lagre() trykkes, slik at en påbegynt
        // tom kvittering ikke blir lagret som bifangst når f.eks. en signatur lagres.
        _nyeKvitteringer.Add(new NokkelKvittering { MottakerNavn = "", Dato = DateTime.Today });
    }

    private void FjernKvitteringRad(NokkelKvittering k)
    {
        if (!_kvitteringer.Remove(k))
        {
            _nyeKvitteringer.Remove(k);
        }
    }

    private void StartSigner(NokkelKvittering k)
    {
        _signerendeKvitteringId = k.Id;
    }

    private void AvbrytSigner()
    {
        _signerendeKvitteringId = null;
        _sisteInitialisertCanvasId = null;
    }

    private async Task RensSignatur(NokkelKvittering k)
    {
        await JS.InvokeVoidAsync("signatur.clear", $"sig-canvas-{k.Id}");
    }

    private async Task LagreSignatur(NokkelKvittering k)
    {
        var canvasId = $"sig-canvas-{k.Id}";
        var tom = await JS.InvokeAsync<bool>("signatur.isEmpty", canvasId);
        if (tom)
        {
            return;
        }

        var base64 = await JS.InvokeAsync<string>("signatur.getPngBase64", canvasId);
        var entitet = await Db.NokkelKvitteringer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Signatur = Convert.FromBase64String(base64);
        entitet.SignertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        k.Signatur = entitet.Signatur;
        k.SignertDato = entitet.SignertDato;
        _signerendeKvitteringId = null;
        _sisteInitialisertCanvasId = null;
    }

    private async Task FjernSignatur(NokkelKvittering k)
    {
        var entitet = await Db.NokkelKvitteringer.FirstOrDefaultAsync(x => x.Id == k.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.Signatur = null;
        entitet.SignertDato = null;
        await Db.SaveChangesAsync();

        k.Signatur = null;
        k.SignertDato = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_signerendeKvitteringId.HasValue && _sisteInitialisertCanvasId != _signerendeKvitteringId)
        {
            await JS.InvokeVoidAsync("signatur.init", $"sig-canvas-{_signerendeKvitteringId}");
            _sisteInitialisertCanvasId = _signerendeKvitteringId;
        }
    }

    private async Task OnBildeValgt(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        var file = e.File;
        if (file.Size > 10_000_000)
        {
            _error = $"\"{file.Name}\" er for stort (maks 10 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _form.BildeData = buffer.ToArray();
        _form.BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        await Db.SaveChangesAsync();
        _bildeVersjon = DateTime.Now.Ticks;
    }

    private async Task OnVedleggSelected(InputFileChangeEventArgs e)
    {
        if (!Id.HasValue)
        {
            return;
        }

        _vedleggFeil = null;
        _uploadingVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > 20_000_000)
                {
                    _vedleggFeil = $"\"{file.Name}\" er for stor (maks 20 MB) og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }

                var vedlegg = new SystemVedlegg
                {
                    NokkelsystemId = Id.Value,
                    Filnavn = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    Data = buffer.ToArray(),
                    Type = string.IsNullOrWhiteSpace(_valgtVedleggType) ? null : _valgtVedleggType
                };

                Db.SystemVedlegg.Add(vedlegg);
                LoggHendelse($"Vedlegg lastet opp: {file.Name}");
            }

            await Db.SaveChangesAsync();
            await LastHendelserAsync();
        }
        finally
        {
            _uploadingVedlegg = false;
        }
    }

    private async Task RemoveVedlegg(SystemVedlegg v)
    {
        Db.SystemVedlegg.Remove(v);
        await Db.SaveChangesAsync();
        _vedlegg.Remove(v);
    }

    private async Task Lagre()
    {
        if (string.IsNullOrWhiteSpace(_form.Systemnummer))
        {
            _error = "Systemet må ha et systemnummer.";
            return;
        }

        _error = null;
        var nyeRekvirenter = _rekvirenter.Where(r => r.Id == 0).ToList();
        _kvitteringer.AddRange(_nyeKvitteringer);
        var nyeKvitteringerLagt = _nyeKvitteringer.ToList();
        _nyeKvitteringer = [];
        _form.Rekvirenter = _rekvirenter;
        _form.Kvitteringer = _kvitteringer;

        var notaterEndret = !string.Equals(_form.Notater?.Trim(), _opprinneligNotater?.Trim(), StringComparison.Ordinal);
        var erNyttSystem = !Id.HasValue;

        if (erNyttSystem)
        {
            Db.Nokkelsystemer.Add(_form);
        }

        await Db.SaveChangesAsync();

        if (!erNyttSystem)
        {
            foreach (var r in nyeRekvirenter)
            {
                LoggHendelse($"Rekvirent lagt til: {r.Navn}");
            }

            foreach (var k in nyeKvitteringerLagt)
            {
                LoggHendelse($"Ny nøkkel registrert: {(string.IsNullOrWhiteSpace(k.NokkelBetegnelse) ? "Nøkkel" : k.NokkelBetegnelse)} til {k.MottakerNavn}");
            }

            if (notaterEndret)
            {
                LoggHendelse("Notat oppdatert");
            }

            if (nyeRekvirenter.Count > 0 || nyeKvitteringerLagt.Count > 0 || notaterEndret)
            {
                await Db.SaveChangesAsync();
                await LastHendelserAsync();
            }
        }

        _opprinneligNotater = _form.Notater;
        _redigerInfo = false;
        _redigerRekvirent = null;
        _redigerKvitteringId = null;

        if (Id.HasValue)
        {
            _savedMessage = $"Systemet \"{_form.Systemnummer}\" er oppdatert.";
        }
        else
        {
            _savedMessage = $"Systemet \"{_form.Systemnummer}\" er lagret.";
            Nav.NavigateTo($"/systemregister/{_form.Id}");
        }
    }

    private async Task ConfirmDelete()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var existing = await Db.Nokkelsystemer.FirstOrDefaultAsync(s => s.Id == Id.Value);
        if (existing is not null)
        {
            Db.Nokkelsystemer.Remove(existing);
            await Db.SaveChangesAsync();
        }

        Nav.NavigateTo("/systemregister");
    }
}
