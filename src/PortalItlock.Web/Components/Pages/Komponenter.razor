    private async Task Save(ComponentDraft draft)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        var nyNetto = draft.IngenPris ? null : draft.PrisNetto;
        var nyVeil = draft.IngenPris ? null : draft.PrisVeiledende;
        PrisHistorikkLogger.Logg(Db, entity, nyNetto, nyVeil, "Manuell endring");

        entity.ComponentTypeId = draft.ComponentTypeId;
        entity.Navn = draft.Navn.Trim();
        entity.Navn2 = string.IsNullOrWhiteSpace(draft.Navn2) ? null : draft.Navn2.Trim();
        entity.Produsent = string.IsNullOrWhiteSpace(draft.Produsent) ? null : draft.Produsent.Trim();
        entity.Konsept = string.IsNullOrWhiteSpace(draft.Konsept) ? null : draft.Konsept.Trim();
        entity.ProdusentAdresse = string.IsNullOrWhiteSpace(draft.ProdusentAdresse) ? null : draft.ProdusentAdresse.Trim();
        entity.ProdusentPostnr = string.IsNullOrWhiteSpace(draft.ProdusentPostnr) ? null : draft.ProdusentPostnr.Trim();
        entity.ProdusentSted = string.IsNullOrWhiteSpace(draft.ProdusentSted) ? null : draft.ProdusentSted.Trim();
        entity.ProdusentLand = string.IsNullOrWhiteSpace(draft.ProdusentLand) ? null : draft.ProdusentLand.Trim();
        entity.ProdusentOrgnr = string.IsNullOrWhiteSpace(draft.ProdusentOrgnr) ? null : draft.ProdusentOrgnr.Trim();
        entity.Leverandor = string.IsNullOrWhiteSpace(draft.Leverandor) ? null : draft.Leverandor.Trim();
        entity.Produktkode = string.IsNullOrWhiteSpace(draft.Produktkode) ? null : draft.Produktkode.Trim();
        entity.Gtin = string.IsNullOrWhiteSpace(draft.Gtin) ? null : draft.Gtin.Trim();
        entity.Overflate = string.IsNullOrWhiteSpace(draft.Overflate) ? null : draft.Overflate.Trim();
        entity.PrisNetto = nyNetto;
        entity.PrisVeiledende = nyVeil;
        entity.RabattgruppeId = draft.RabattgruppeId;
        entity.MontasjeMinutterProsjekt = draft.MontasjeMinutterProsjekt;
        entity.MontasjeMinutterArbeidsordre = draft.MontasjeMinutterArbeidsordre;
        entity.MontasjeMinutterService = draft.MontasjeMinutterService;
        entity.GarantitidManeder = draft.GarantitidManeder;
        entity.Enhet = string.IsNullOrWhiteSpace(draft.Enhet) ? null : draft.Enhet.Trim();

        entity.InntektskontoId = draft.InntektskontoId;

        await Db.SaveChangesAsync();

        _editingId = null;
        await RefreshDraft(draft.Id);
    }

    private async Task SlettKomponent(ComponentDraft draft)
    {
        if (_slettBekreftelseTekst != "SLETT")
        {
            return;
        }

        await Db.TilbudLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));
        await Db.ServiceMinuttLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));
        await Db.MonteringLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));

        await Db.Components.Where(c => c.Id == draft.Id).ExecuteDeleteAsync();

        _slettendeId = null;
        _slettBekreftelseTekst = "";
        _editingId = null;
        await LoadAsync();
    }

    private async Task UploadFdv(ComponentDraft draft, InputFileChangeEventArgs e)
    {
        _fdvFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _fdvFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entity = await Db.LastFilerAsync(await Db.Components.FirstAsync(c => c.Id == draft.Id));
        entity.FdvData = buffer.ToArray();
        entity.FdvFilnavn = file.Name;
        entity.FdvContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();

        draft.HarFdv = true;
        draft.FdvFilnavn = file.Name;
    }

    private async Task RemoveFdv(ComponentDraft draft)
    {
        var entity = await Db.LastFilerAsync(await Db.Components.FirstAsync(c => c.Id == draft.Id));
