@page "/komponenter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject VisningPreferanseService VisningPref

<PageTitle>Komponentregister</PageTitle>

@* KR7 (komponenter-forslag.html): komponenttypene i en meny inni kortet, en smal
   tabell i midten og et varepanel til høyre. Hele varekortet (KomponentPanel)
   åpnes fra panelet. *@
<div class="kr @(_full ? "kr-full" : "")">
    <div class="side-header">
        <div class="side-header-venstre">
            <span class="side-header-ikon"><Icon Name="box" /></span>
            <div>
                <h1>Komponentregister</h1>
                <p class="section-hint">Velg komponenttype i menyen og klikk på en vare for å se den i panelet til høyre. Åpne varekortet for å endre alt om varen.</p>
            </div>
        </div>
        <div class="kr-hode-knapper">
            <span class="kr-nedtrekk">
                <button type="button" class="kr-knapp" @onclick="@(() => _visPrisMeny = !_visPrisMeny)"><Icon Name="trend-up" />Priser og import</button>
                @if (_visPrisMeny)
                {
                    <span class="kr-nedtrekk-bakgrunn" @onclick="@(() => _visPrisMeny = false)"></span>
                    <span class="kr-nedtrekk-boks">
                        <a href="/komponenter/prisimport"><Icon Name="upload" />Importer prisliste</a>
                        <a href="/komponenter/oppdater-priser"><Icon Name="trend-up" />Oppdater priser</a>
                        <a href="/rabattgrupper"><Icon Name="tag" />Rabattgrupper</a>
                    </span>
                }
            </span>
            <button type="button" class="kr-knapp primaer" @onclick="StartNyVare"><Icon Name="plus" />Ny vare</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_fdvFeil))
    {
        <p class="form-error">@_fdvFeil</p>
    }

    <div class="kr-kort @(_visTyperPanel ? "kr-uten-panel" : "")">
        <nav class="kr-meny">
            <label class="kr-minisok">
                <Icon Name="search" />
                <input type="search" @bind="_typeSok" @bind:event="oninput" placeholder="Finn komponenttype" />
            </label>
            <div class="kr-typeliste">
                @if (string.IsNullOrWhiteSpace(_typeSok))
                {
                    <button type="button" class="@(!_visTyperPanel && _selectedTypeId == 0 ? "pa" : "")" @onclick="@(() => VelgType(0))">
                        <span class="kr-meny-ikon"><Icon Name="box" /></span>
                        <span class="kr-navn">Alle typer</span>
                        <small>@_typeAntall.Values.Sum().ToString("N0", Nb)</small>
                    </button>
                }
                @foreach (var t in _types.Where(t => string.IsNullOrWhiteSpace(_typeSok) || t.Navn.Contains(_typeSok.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    var id = t.Id;
                    <button type="button" @key="t.Id" class="@(!_visTyperPanel && _selectedTypeId == id ? "pa" : "")" @onclick="@(() => VelgType(id))">
                        <span class="kr-meny-ikon"><Icon Name="box" /></span>
                        <span class="kr-navn">@t.Navn</span>
                        <small>@_typeAntall.GetValueOrDefault(id).ToString("N0", Nb)</small>
                    </button>
                }
                @if (_typeAntall.GetValueOrDefault(-1) > 0 && string.IsNullOrWhiteSpace(_typeSok))
                {
                    <button type="button" class="@(!_visTyperPanel && _selectedTypeId == -1 ? "pa" : "")" @onclick="@(() => VelgType(-1))">
                        <span class="kr-meny-ikon"><Icon Name="box" /></span>
                        <span class="kr-navn">Uten type</span>
                        <small>@_typeAntall[-1].ToString("N0", Nb)</small>
                    </button>
                }
            </div>
            <button type="button" class="kr-endre-typer @(_visTyperPanel ? "pa" : "")" @onclick="@(() => { _visTyperPanel = true; _typerPanelMessage = null; })">
                <Icon Name="edit" />Endre komponenttyper
            </button>
        </nav>

        @if (_visTyperPanel)
        {
            <section class="kr-innhold">
                <button type="button" class="kr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                    <Icon Name="@(_full ? "minimize" : "maximize")" />
                </button>
                <div class="kr-tittel">
                    <h2>Komponenttyper</h2>
                    <p>Navn og rekkefølge i nedtrekksmenyer (lavest tall først). Typer som er i bruk kan ikke slettes.</p>
                </div>
                @if (!string.IsNullOrEmpty(_typerPanelMessage))
                {
                    <p class="kr-ok">@_typerPanelMessage</p>
                }
                <div class="kr-tabell-ramme">
                    <table class="kr-tabell">
                        <thead>
                            <tr>
                                <th>Komponenttype</th>
                                <th class="kr-n">Varer</th>
                                <th class="kr-n">Rekkefølge</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _types)
                            {
                                var iBruk = _components.Count(c => c.ComponentTypeId == t.Id);
                                <tr @key="t.Id">
                                    <td><input class="kr-celle-input" @bind="t.Navn" @bind:event="oninput" /></td>
                                    <td class="kr-n">@iBruk.ToString("N0", Nb)</td>
                                    <td class="kr-n"><input class="kr-celle-input kr-tall" type="number" @bind="t.Sortering" /></td>
                                    <td class="kr-n kr-nowrap">
                                        <button type="button" class="kr-ikon" title="Lagre" @onclick="@(() => RenameComponentType(t))"><Icon Name="check" /></button>
                                        <button type="button" class="kr-ikon fare" disabled="@(iBruk > 0)" title="@(iBruk > 0 ? "Kan ikke slette - i bruk på komponenter" : "Slett")" @onclick="@(() => DeleteComponentType(t))"><Icon Name="trash" /></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="kr-ny-type">
                    <input @bind="_nyTypeNavn" @bind:event="oninput" placeholder="＋ Ny komponenttype"
                           @onkeydown="@(async e => { if (e.Key == "Enter") { await CreateComponentType(); } })" />
                    <input type="number" class="kr-tall" @bind="_nyTypeSortering" title="Rekkefølge i nedtrekksmenyer, lavest tall først" />
                    @if (!string.IsNullOrWhiteSpace(_nyTypeNavn))
                    {
                        <button type="button" class="kr-knapp primaer" @onclick="CreateComponentType">Opprett</button>
                    }
                </div>
            </section>
        }
        else
        {
            var markert = Markert;
            <section class="kr-innhold">
                <div class="kr-verktoy">
                    <label class="kr-sok">
                        <Icon Name="search" />
                        <input type="search" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Søk navn, leverandør, produktkode eller GTIN" />
                    </label>
                    <select class="kr-select" @bind="_selectedLeverandor" @bind:after="ResetPage">
                        <option value="">Alle leverandører</option>
                        @foreach (var l in _leverandorer)
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                    <span class="kr-filter">
                        <button type="button" class="@(_activeFilter == "active" ? "pa" : "")" @onclick="@(() => SettActiveFilter("active"))">Aktive</button>
                        <button type="button" class="@(_activeFilter == "inactive" ? "pa" : "")" @onclick="@(() => SettActiveFilter("inactive"))">Inaktive</button>
                        <button type="button" class="@(_activeFilter == "all" ? "pa" : "")" @onclick="@(() => SettActiveFilter("all"))">Alle</button>
                    </span>
                    <button type="button" class="kr-utvid kr-utvid-inline" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                        <Icon Name="@(_full ? "minimize" : "maximize")" />
                    </button>
                </div>

                @if (_etikettValgt.Count > 0)
                {
                    @* Valgte varer: lag etiketter med strekkode fra GTIN/EAN, som i Tripletex. *@
                    <div class="kr-etikett-linje">
                        <span><b>@_etikettValgt.Count</b> @(_etikettValgt.Count == 1 ? "vare" : "varer") valgt</span>
                        <button type="button" class="kr-knapp primaer" @onclick="@(() => _visEtikettDialog = true)"><Icon Name="tag" />Lag etikett</button>
                        <button type="button" class="kr-knapp" @onclick="@(() => _etikettValgt.Clear())">Fjern valg</button>
                    </div>
                }

                <div class="kr-tabell-ramme">
                    @* Fast høyde med egen rullefelt (som typemenyen), så 100 per side ikke gjør siden lang.
                       @key gjør at listen starter øverst igjen ved bytte av side, type eller antall. *@
                    <div class="kr-tabell-scroll" @key="@($"{_selectedTypeId}-{_page}-{_perSide}")">
                    <table class="kr-tabell kr-varer">
                        <thead>
                            <tr>
                                <th class="kr-cb">
                                    <input type="checkbox" title="Velg alle på siden for etikett"
                                           checked="@(PagedComponents.Any() && PagedComponents.All(c => _etikettValgt.Contains(c.Id)))" @onchange="VelgAlleForEtikett" />
                                </th>
                                <th>Vare</th>
                                <th class="kr-n">Netto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in PagedComponents)
                            {
                                var id = c.Id;
                                <tr @key="c.Id" class="@(markert?.Id == id ? "valgt" : "") @(c.Aktiv ? "" : "inaktiv")" @onclick="@(() => VelgVare(id))">
                                    <td class="kr-cb" @onclick:stopPropagation="true">
                                        <input type="checkbox" title="Velg for etikett" checked="@_etikettValgt.Contains(id)"
                                               @onchange="@(() => { if (!_etikettValgt.Remove(id)) _etikettValgt.Add(id); })" />
                                    </td>
                                    <td>
                                        <div class="kr-vare">
                                            <span class="kr-status @StatusKlasse(c)" title="@StatusTekst(c)"></span>
                                            <div>
                                                <b>@c.Navn</b>
                                                <span class="kr-under">
                                                    @if (_selectedTypeId == 0)
                                                    {
                                                        <text>@c.TypeName · </text>
                                                    }
                                                    @(c.Leverandor ?? c.Produsent ?? "Ingen leverandør")
                                                    @if (!string.IsNullOrWhiteSpace(c.Produktkode))
                                                    {
                                                        <text> · </text><span class="kr-kode">@c.Produktkode</span>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="kr-n">@FormatPrice(c.PrisNetto)</td>
                                </tr>
                            }
                            @if (_filteredCount == 0)
                            {
                                <tr><td colspan="3" class="kr-tom">Ingen varer passer søket.</td></tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <div class="kr-sidebunn">
                        <span>@(_filteredCount == 0 ? "Ingen varer" : $"Viser {_page * _perSide + 1:N0}–{Math.Min(_filteredCount, (_page + 1) * _perSide):N0} av {_filteredCount:N0}")</span>
                        <span class="kr-sider">
                            <button type="button" disabled="@(_page == 0)" title="Forrige side" @onclick="@(() => ChangePage(-1))">‹</button>
                            <span>Side @(_page + 1) av @Math.Max(1, TotalPages)</span>
                            <button type="button" disabled="@(_page + 1 >= TotalPages)" title="Neste side" @onclick="@(() => ChangePage(1))">›</button>
                        </span>
                        <span class="kr-sider">
                            Per side
                            @foreach (var n in new[] { 25, 50, 100 })
                            {
                                var antall = n;
                                <button type="button" class="@(_perSide == antall ? "pa" : "")" @onclick="@(() => SettPerSide(antall))">@antall</button>
                            }
                        </span>
                    </div>
                </div>
            </section>

            <aside class="kr-panel">
                @if (_nyVare)
                {
                    <div class="kr-tittel">
                        <h2>Ny vare</h2>
                        <p>Fyll ut resten i varekortet etterpå.</p>
                    </div>
                    <label class="kr-felt"><span>Komponenttype</span>
                        <select @bind="_draft.ComponentTypeId">
                            <option value="0">Ingen type</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Navn</option>
                            }
                        </select>
                    </label>
                    <label class="kr-felt"><span>Navn</span><input @bind="_draft.Navn" /></label>
                    <label class="kr-felt"><span>Leverandør (valgfritt)</span><input @bind="_draft.Leverandor" /></label>
                    <label class="kr-felt"><span>Produktkode (valgfritt)</span><input @bind="_draft.Produktkode" /></label>
                    @if (!string.IsNullOrEmpty(_addMessage))
                    {
                        <p class="form-error">@_addMessage</p>
                    }
                    <div class="kr-knapperad">
                        <button type="button" class="kr-knapp" @onclick="@(() => { _nyVare = false; _addMessage = null; })">Avbryt</button>
                        <button type="button" class="kr-knapp primaer" @onclick="AddComponent">Legg til</button>
                    </div>
                }
                else if (markert is null)
                {
                    <p class="kr-dempet">Velg en vare i listen.</p>
                }
                else if (_editingId == markert.Id)
                {
                    var c = markert;
                    <div class="kr-tittel">
                        <h2>Hurtigredigering</h2>
                        <p>@c.Navn</p>
                    </div>
                    <label class="kr-felt"><span>Komponenttype</span>
                        <select @bind="c.ComponentTypeId">
                            <option value="">Ikke satt</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Navn</option>
                            }
                        </select>
                    </label>
                    <label class="kr-felt"><span>Varenavn 1</span><input @bind="c.Navn" /></label>
                    <label class="kr-felt"><span>Varenavn 2</span><input @bind="c.Navn2" /></label>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Leverandør (produsent)</span><input @bind="c.Produsent" placeholder="F.eks. Dormakaba" /></label>
                        <label class="kr-felt"><span>Konsept</span><input @bind="c.Konsept" placeholder="F.eks. Connect" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Kjøpes inn av</span><input @bind="c.Leverandor" /></label>
                        <label class="kr-felt"><span>Produktkode</span><input @bind="c.Produktkode" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>GTIN/EAN</span><input @bind="c.Gtin" /></label>
                        <label class="kr-felt"><span>Overflate</span><input @bind="c.Overflate" placeholder="F.eks. Fkrm" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Netto</span><input @bind="c.PrisNetto" disabled="@c.IngenPris" /></label>
                        <label class="kr-felt"><span>Veiledende</span><input @bind="c.PrisVeiledende" disabled="@c.IngenPris" /></label>
                    </div>
                    <label class="kr-sjekk"><input type="checkbox" @bind="c.IngenPris" /> Ingen pris</label>
                    <label class="kr-felt"><span>Rabattgruppe</span>
                        <select @bind="c.RabattgruppeId">
                            <option value="">Ingen</option>
                            @foreach (var r in _rabattgrupper)
                            {
                                <option value="@r.Id">@r.Kode - @r.Leverandor (@r.RabattProsent%)</option>
                            }
                        </select>
                    </label>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Montasje prosjekt (min)</span><input @bind="c.MontasjeMinutterProsjekt" /></label>
                        <label class="kr-felt"><span>Montasje arbeidsordre (min)</span><input @bind="c.MontasjeMinutterArbeidsordre" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Tidsbruk service (min)</span><input @bind="c.MontasjeMinutterService" /></label>
                        <label class="kr-felt"><span>Garantitid (mnd)</span><input @bind="c.GarantitidManeder" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Enhet</span><input @bind="c.Enhet" placeholder="stk" /></label>
                        <label class="kr-felt"><span>Inntektskonto</span>
                            <select @bind="c.InntektskontoId">
                                <option value="">Ikke satt</option>
                                @foreach (var k in _inntektskontoer)
                                {
                                    <option value="@k.Id">@k.Nummer - @k.Navn</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="kr-seksjon">Produsentens firmaadresse (CE-egenerklæring)</div>
                    <label class="kr-felt"><span>Adresse</span><input @bind="c.ProdusentAdresse" /></label>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Postnr</span><input @bind="c.ProdusentPostnr" /></label>
                        <label class="kr-felt"><span>Sted</span><input @bind="c.ProdusentSted" /></label>
                    </div>
                    <div class="kr-to">
                        <label class="kr-felt"><span>Land</span><input @bind="c.ProdusentLand" /></label>
                        <label class="kr-felt"><span>Org.nr.</span><input @bind="c.ProdusentOrgnr" /></label>
                    </div>
                    <div class="kr-knapperad">
                        <button type="button" class="kr-knapp" @onclick="AvbrytRedigering">Avbryt</button>
                        <button type="button" class="kr-knapp primaer" @onclick="@(() => Save(c))"><Icon Name="check" />Lagre</button>
                    </div>
                    <div class="kr-slett">
                        @if (_slettendeId == c.Id)
                        {
                            <span class="kr-dempet">Skriv SLETT for å slette varen for godt.</span>
                            <span class="kr-knapperad">
                                <input class="kr-slett-input" @bind="_slettBekreftelseTekst" @bind:event="oninput" placeholder="SLETT" />
                                <button type="button" class="kr-knapp fare" disabled="@(_slettBekreftelseTekst != "SLETT")" @onclick="@(() => SlettKomponent(c))">Slett</button>
                                <button type="button" class="kr-knapp" @onclick="@(() => { _slettendeId = null; _slettBekreftelseTekst = ""; })">Avbryt</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="kr-lenke" @onclick="@(() => _slettendeId = c.Id)"><Icon Name="trash" />Slett vare</button>
                        }
                    </div>
                }
                else
                {
                    var c = markert;
                    <div class="kr-bilde">
                        @if (c.HarBilde)
                        {
                            <img src="@($"/komponent/{c.Id}/bilde?w=600&v={_bildeVersjon}")" alt="Bilde av varen" decoding="async" onerror="this.remove()" />
                        }
                        else
                        {
                            <Icon Name="image" />
                        }
                    </div>
                    <div class="kr-tittel">
                        <h2>@c.Navn</h2>
                        @if (!string.IsNullOrWhiteSpace(c.Navn2))
                        {
                            <p>@c.Navn2</p>
                        }
                        <p><span class="kr-status @StatusKlasse(c)"></span>@c.TypeName · @StatusTekst(c)</p>
                    </div>
                    <dl class="kr-kv">
                        <dt>Netto</dt><dd>@FormatPrice(c.PrisNetto)</dd>
                        <dt>Veiledende</dt><dd>@FormatPrice(c.PrisVeiledende)</dd>
                        <dt>Rabattgruppe</dt><dd>@(c.RabattgruppeKode ?? "-")</dd>
                        <dt>Produktkode</dt><dd class="kr-kode">@(c.Produktkode ?? "-")</dd>
                        @if (!string.IsNullOrWhiteSpace(c.Gtin))
                        {
                            <dt>GTIN/EAN</dt><dd class="kr-kode">@c.Gtin</dd>
                        }
                    </dl>

                    <div class="kr-seksjon">Leverandører</div>
                    @if (c.LeverandorNavn.Count == 0 && string.IsNullOrWhiteSpace(c.Leverandor))
                    {
                        <p class="kr-dempet">Ingen leverandør registrert.</p>
                    }
                    else
                    {
                        <div class="kr-levliste">
                            @foreach (var l in c.LeverandorNavn.DefaultIfEmpty(c.Leverandor!))
                            {
                                <span>@l</span>
                            }
                        </div>
                    }

                    <div class="kr-seksjon">Montasje og service</div>
                    <dl class="kr-kv">
                        <dt>Prosjekt</dt><dd>@FormatMinutter(c.MontasjeMinutterProsjekt)</dd>
                        <dt>Arbeidsordre</dt><dd>@FormatMinutter(c.MontasjeMinutterArbeidsordre)</dd>
                        <dt>Serviceavtale</dt><dd>@FormatMinutter(c.MontasjeMinutterService)</dd>
                        <dt>Garanti</dt><dd>@(c.GarantitidManeder.HasValue ? $"{c.GarantitidManeder} mnd" : "-")</dd>
                        <dt>Brukt i</dt><dd>@UsageLabel(c.PackageCount)</dd>
                    </dl>

                    <div class="kr-seksjon">Dokumentasjon</div>
                    <div class="kr-filer">
                        <div>
                            <span>FDV</span>
                            @if (c.HarFdv)
                            {
                                <span class="kr-fil"><a href="@($"/komponent/{c.Id}/fdv")" target="_blank">@c.FdvFilnavn</a><button type="button" class="kr-ikon" title="Fjern" @onclick="@(() => RemoveFdv(c))"><Icon Name="trash" /></button></span>
                            }
                            else
                            {
                                <label class="kr-last-opp"><Icon Name="upload" />Last opp<InputFile OnChange="@(e => UploadFdv(c, e))" accept=".pdf,application/pdf" /></label>
                            }
                        </div>
                        <div>
                            <span>Montasjeblad</span>
                            @if (c.HarMontasjeblad)
                            {
                                <span class="kr-fil"><a href="@($"/komponent/{c.Id}/montasjeblad")" target="_blank">@c.MontasjebladFilnavn</a><button type="button" class="kr-ikon" title="Fjern" @onclick="@(() => RemoveMontasjeblad(c))"><Icon Name="trash" /></button></span>
                            }
                            else
                            {
                                <label class="kr-last-opp"><Icon Name="upload" />Last opp<InputFile OnChange="@(e => UploadMontasjeblad(c, e))" accept=".pdf,application/pdf" /></label>
                            }
                        </div>
                    </div>

                    <div class="kr-brytere">
                        <label><input type="checkbox" checked="@c.Aktiv" @onchange="@(e => ToggleActive(c, (bool)e.Value!))" />Aktiv</label>
                        <label title="Vis denne varen i lagerstyring"><input type="checkbox" checked="@c.ILagerstyring" @onchange="@(e => ToggleLagerstyring(c, (bool)e.Value!))" />Lagerstyring</label>
                        <label title="Sperrer kunderabatt på denne varen i tilbud"><input type="checkbox" checked="@c.IngenRabattTilgjengelig" @onchange="@(e => ToggleIngenRabatt(c, (bool)e.Value!))" />Ingen rabatt</label>
                    </div>

                    <button type="button" class="kr-knapp primaer kr-bred" @onclick="@(() => _valgtVareId = c.Id)">Åpne varekortet<Icon Name="arrow-right" /></button>
                    <div class="kr-knapperad">
                        <button type="button" class="kr-lenke" @onclick="@(() => StartEdit(c))"><Icon Name="edit" />Hurtigredigering</button>
                        <a class="kr-lenke" href="@($"/komponenter/{c.Id}/prishistorikk")"><Icon Name="clock" />Prishistorikk</a>
                    </div>
                }
            </aside>
        }
    </div>
</div>

<KomponentPanel ComponentId="_valgtVareId" OnClose="@(() => _valgtVareId = null)" OnSaved="RefreshValgtVare" />

@if (_visEtikettDialog)
{
    var valgte = _components.Where(c => _etikettValgt.Contains(c.Id)).ToList();
    var utenStrekkode = valgte.Count(c => !Strekkode.HarEan(c.Gtin, c.Produktkode));
    var format = EtikettPdfService.Formater.First(f => f.Kode == _etikett.Format);
    <div class="etikett-overlay" @onclick="@(() => _visEtikettDialog = false)">
        <div class="etikett-dialog" @onclick:stopPropagation="true">
            <div class="etikett-topp">
                <div>
                    <h2>Lag etikett</h2>
                    <span class="etikett-mut">@valgte.Count @(valgte.Count == 1 ? "vare" : "varer") · @(valgte.Count * Math.Max(1, _etikett.AntallPerVare)) etiketter</span>
                </div>
                <button type="button" class="ikon-btn" title="Lukk" @onclick="@(() => _visEtikettDialog = false)">✕</button>
            </div>

            <label class="etikett-felt">
                <span>Størrelse</span>
                <select @bind="_etikett.Format">
                    @foreach (var f in EtikettPdfService.Formater)
                    {
                        <option value="@f.Kode">@f.Navn</option>
                    }
                </select>
            </label>

            <div class="etikett-felt">
                <span>Vis på etiketten</span>
                <div class="etikett-valg">
                    <label><input type="checkbox" @bind="_etikett.Navn" /> Varenavn</label>
                    <label><input type="checkbox" @bind="_etikett.Produktkode" /> Produktkode</label>
                    <label><input type="checkbox" @bind="_etikett.Leverandor" /> Leverandør</label>
                    <label><input type="checkbox" @bind="_etikett.PrisInklMva" /> Salgspris inkl. mva</label>
                    <label><input type="checkbox" @bind="_etikett.PrisEksMva" /> Salgspris eks. mva</label>
                    <label><input type="checkbox" @bind="_etikett.Strekkode" /> Strekkode (GTIN/EAN)</label>
                </div>
            </div>

            <div class="etikett-to">
                <label class="etikett-felt">
                    <span>Antall per vare</span>
                    <input type="number" min="1" max="500" @bind="_etikett.AntallPerVare" />
                </label>
                @if (!format.ErRull)
                {
                    <label class="etikett-felt">
                        <span>Start på etikett nr.</span>
                        <input type="number" min="1" max="@format.PerSide" @bind="_etikett.Start" title="For påbegynte ark: hopp over etiketter som allerede er brukt" />
                    </label>
                }
            </div>

            @if (_etikett.Strekkode && utenStrekkode > 0)
            {
                <p class="etikett-hint">@utenStrekkode @(utenStrekkode == 1 ? "vare mangler" : "varer mangler") gyldig GTIN/EAN &ndash; der brukes Code 128 av produktkoden i stedet@(valgte.Any(c => string.IsNullOrWhiteSpace(c.Gtin) && string.IsNullOrWhiteSpace(c.Produktkode)) ? ", eller ingen strekkode" : "").</p>
            }
            @if ((_etikett.PrisInklMva || _etikett.PrisEksMva) && valgte.Any(c => c.PrisVeiledende is null))
            {
                <p class="etikett-hint">Salgspris er veiledende pris på varen. Varer uten veiledende pris får ingen pris på etiketten.</p>
            }

            <div class="etikett-knapper">
                <button type="button" class="knapp" @onclick="@(() => _visEtikettDialog = false)">Avbryt</button>
                <button type="button" class="knapp knapp-primaer" @onclick="VisEtiketter"><Icon Name="file-text" />Vis etikett</button>
            </div>
        </div>
    </div>
}

<PdfPreviewModal Url="@_etikettUrl" Tittel="Etiketter" OnClose="@(() => _etikettUrl = null)" />

@code {
    private sealed class ComponentDraft
    {
        public int Id { get; set; }
        public int? ComponentTypeId { get; set; }
        public string TypeName { get; set; } = "";
        public string Navn { get; set; } = "";
        public string? Navn2 { get; set; }
        public string? Produsent { get; set; }
        public string? Konsept { get; set; }
        public string? ProdusentAdresse { get; set; }
        public string? ProdusentPostnr { get; set; }
        public string? ProdusentSted { get; set; }
        public string? ProdusentLand { get; set; }
        public string? ProdusentOrgnr { get; set; }
        public string? Leverandor { get; set; }
        public List<string> LeverandorNavn { get; set; } = [];
        public string? Produktkode { get; set; }
        public string? Gtin { get; set; }
        public string? Overflate { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public int? RabattgruppeId { get; set; }
        public string? RabattgruppeKode { get; set; }
        public bool IngenRabattTilgjengelig { get; set; }
        public string? ProduktgruppeNavn { get; set; }
        public int? MontasjeMinutterProsjekt { get; set; }
        public int? MontasjeMinutterArbeidsordre { get; set; }
        public int? MontasjeMinutterService { get; set; }
        public int? GarantitidManeder { get; set; }
        public string? Enhet { get; set; }
        public bool Aktiv { get; set; }
        public bool ILagerstyring { get; set; }
        public bool IngenPris { get; set; }
        public int PackageCount { get; set; }
        public bool HarFdv { get; set; }
        public string? FdvFilnavn { get; set; }
        public bool HarMontasjeblad { get; set; }
        public string? MontasjebladFilnavn { get; set; }
        public int? InntektskontoId { get; set; }
        public bool ErKomplett { get; set; }
        public bool TrengerDobbelsjekk { get; set; }
        public bool HarBilde { get; set; }
    }

    private sealed class NewComponentDraft
    {
        public int ComponentTypeId { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
    }

    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private int _perSide = 50;
    private bool _full;
    private bool _visPrisMeny;
    private bool _nyVare;
    private string _typeSok = "";
    private int? _markertId;
    private int _bildeVersjon;

    // Antall varer per komponenttype (-1 = uten type) med gjeldende søk og filtre.
    private Dictionary<int, int> _typeAntall = [];

    private List<ComponentDraft> _components = [];
    private List<ComponentType> _types = [];
    private List<Rabattgruppe> _rabattgrupper = [];
    private List<string> _leverandorer = [];
    private string _search = "";
    private int _selectedTypeId;
    private string _selectedLeverandor = "";
    private string _activeFilter = "active";
    private int _page;
    private int _filteredCount;
    private int? _editingId;
    private int? _valgtVareId;

    // ---------- Etiketter (som "Lag etikett" i Tripletex) ----------
    private readonly List<int> _etikettValgt = [];
    private bool _visEtikettDialog;
    private string? _etikettUrl;
    private EtikettPdfService.Valg _etikett = new();
    private const string EtikettPrefNokkel = "etikett-valg";

    private void VelgAlleForEtikett(ChangeEventArgs e)
    {
        var side = PagedComponents.Select(c => c.Id).ToList();
        if (e.Value is true)
        {
            _etikettValgt.AddRange(side.Where(id => !_etikettValgt.Contains(id)));
        }
        else
        {
            _etikettValgt.RemoveAll(side.Contains);
        }
    }

    private async Task VisEtiketter()
    {
        static string B(bool v) => v ? "1" : "0";
        var e = _etikett;
        e.AntallPerVare = Math.Clamp(e.AntallPerVare, 1, 500);
        e.Start = Math.Max(1, e.Start);
        _etikettUrl = $"/komponenter/etiketter/pdf?ider={string.Join(',', _etikettValgt)}&format={e.Format}" +
            $"&navn={B(e.Navn)}&kode={B(e.Produktkode)}&lev={B(e.Leverandor)}&inkl={B(e.PrisInklMva)}&eks={B(e.PrisEksMva)}&strek={B(e.Strekkode)}" +
            $"&antall={e.AntallPerVare}&start={e.Start}&v={DateTime.UtcNow.Ticks}";
        _visEtikettDialog = false;

        // Husk valgene til neste gang (per bruker).
        await VisningPref.SettAsync(EtikettPrefNokkel, string.Join('|', e.Format, B(e.Navn), B(e.Produktkode), B(e.Leverandor), B(e.PrisInklMva), B(e.PrisEksMva), B(e.Strekkode)));
    }

    private async Task HentEtikettValg()
    {
        var deler = (await VisningPref.HentAsync(EtikettPrefNokkel, "")).Split('|');
        if (deler.Length == 7 && EtikettPdfService.Formater.Any(f => f.Kode == deler[0]))
        {
            _etikett = new EtikettPdfService.Valg
            {
                Format = deler[0],
                Navn = deler[1] == "1",
                Produktkode = deler[2] == "1",
                Leverandor = deler[3] == "1",
                PrisInklMva = deler[4] == "1",
                PrisEksMva = deler[5] == "1",
                Strekkode = deler[6] == "1"
            };
        }
    }
    private int? _slettendeId;
    private string _slettBekreftelseTekst = "";
    private NewComponentDraft _draft = new();
    private string? _addMessage;
    private string _nyTypeNavn = "";
    private int _nyTypeSortering;
    private bool _visTyperPanel;
    private string? _typerPanelMessage;
    private string? _fdvFeil;

    private int TotalPages => (int)Math.Ceiling(_filteredCount / (double)_perSide);

    private List<ComponentDraft> _filtered = [];

    private IEnumerable<ComponentDraft> PagedComponents =>
        _filtered.Skip(_page * _perSide).Take(_perSide);

    // Varen som vises i panelet til høyre: den som er klikket, ellers første på siden.
    private ComponentDraft? Markert =>
        (_markertId is int id ? PagedComponents.FirstOrDefault(c => c.Id == id) : null) ?? PagedComponents.FirstOrDefault();

    private void RefreshFiltered()
    {
        var utenType = _components.Where(c => MatchesFilter(c, medType: false)).ToList();
        _typeAntall = utenType.GroupBy(c => c.ComponentTypeId ?? -1).ToDictionary(g => g.Key, g => g.Count());
        _filtered = utenType.Where(MatchesType).OrderBy(c => c.TypeName).ThenBy(c => c.Navn).ToList();
        _filteredCount = _filtered.Count;
        _page = Math.Clamp(_page, 0, Math.Max(0, TotalPages - 1));
    }

    private bool MatchesType(ComponentDraft c) => _selectedTypeId switch
    {
        0 => true,
        -1 => c.ComponentTypeId is null,
        var id => c.ComponentTypeId == id
    };

    private bool MatchesFilter(ComponentDraft c, bool medType = true)
    {
        if (_activeFilter == "active" && !c.Aktiv)
        {
            return false;
        }

        if (_activeFilter == "inactive" && c.Aktiv)
        {
            return false;
        }

        if (medType && !MatchesType(c))
        {
            return false;
        }

        if (!string.IsNullOrEmpty(_selectedLeverandor) && !c.LeverandorNavn.Contains(_selectedLeverandor))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();
        return Contains(c.Navn, term) || Contains(c.Leverandor, term) || Contains(c.Produktkode, term) || Contains(c.Gtin, term);
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string UsageLabel(int count) => count switch
    {
        0 => "Ikke i bruk",
        1 => "1 pakke",
        _ => $"{count} pakker"
    };

    private string InntektskontoLabel(int? id)
    {
        var k = _inntektskontoer.FirstOrDefault(x => x.Id == id);
        return k is not null ? $"{k.Nummer} - {k.Navn}" : "-";
    }

    private static string FormatPrice(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", CultureInfo.GetCultureInfo("nb-NO")) + " kr" : "-";

    private static string FormatMinutter(int? value) =>
        value.HasValue ? $"{value.Value} min" : "-";

    private void ResetPage()
    {
        _page = 0;
        _markertId = null;
        RefreshFiltered();
    }

    private void SettActiveFilter(string filter)
    {
        _activeFilter = filter;
        ResetPage();
    }

    private void ChangePage(int delta)
    {
        _page = Math.Clamp(_page + delta, 0, Math.Max(0, TotalPages - 1));
        _markertId = null;
    }

    private async Task SettPerSide(int antall)
    {
        _perSide = antall;
        _page = 0;
        _markertId = null;
        await VisningPref.SettAsync("komponenter-per-side", antall.ToString(CultureInfo.InvariantCulture));
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("komponenter-bredde", _full ? "full" : "normal");
    }

    private void VelgType(int typeId)
    {
        _visTyperPanel = false;
        _selectedTypeId = typeId;
        _markertId = null;
        _editingId = null;
        ResetPage();
    }

    private void VelgVare(int id)
    {
        if (_markertId != id)
        {
            _editingId = null;
            _slettendeId = null;
        }

        _markertId = id;
        _nyVare = false;
    }

    private void StartNyVare()
    {
        _visTyperPanel = false;
        _editingId = null;
        _addMessage = null;
        _draft = new NewComponentDraft { ComponentTypeId = Math.Max(0, _selectedTypeId) };
        _nyVare = true;
    }

    private async Task AvbrytRedigering()
    {
        // Henter varen på nytt så halvferdige endringer forkastes.
        var id = _editingId;
        _editingId = null;
        _slettendeId = null;
        if (id is int vareId)
        {
            await RefreshDraft(vareId);
        }
    }

    private static string StatusKlasse(ComponentDraft c) =>
        c.TrengerDobbelsjekk ? "dobbelsjekk" : c.ErKomplett ? "komplett" : "";

    private static string StatusTekst(ComponentDraft c) =>
        c.TrengerDobbelsjekk ? "Dobbelsjekk" : c.ErKomplett ? "Komplett" : "Ikke kontrollert";

    private void StartEdit(ComponentDraft c)
    {
        c.IngenPris = c.PrisNetto is null && c.PrisVeiledende is null;
        _editingId = c.Id;
        _slettendeId = null;
    }

    private List<Inntektskonto> _inntektskontoer = [];

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("komponenter-bredde", "normal") == "full";
        if (int.TryParse(await VisningPref.HentAsync("komponenter-per-side", "50"), out var perSide) && perSide is 25 or 50 or 100)
        {
            _perSide = perSide;
        }

        await LoadAsync();
        await HentEtikettValg();
        _inntektskontoer = await Db.Inntektskontoer.OrderBy(k => k.Nummer).ToListAsync();
    }

    // Component har flere store byte[]-kolonner (FdvData, MontasjebladData,
    // BildeData, DatabladData - hele PDF-er/bilder lagret direkte i
    // databasen). Å laste inn fulle Component-entiteter for hele registeret
    // (slik denne siden gjorde før) henter ALLE disse kolonnene for alle
    // ~25000 radene på hver eneste last, selv om tabellen bare trenger et
    // par bool-flagg - potensielt mange MB per last, og mer for hver PDF/
    // bilde som legges til. Dette var hovedårsaken til at siden ble treg og
    // ustabil (minnepress/lange spørringer). Projiserer derfor rett til en
    // lett rad-type i selve SQL-spørringen i stedet for å laste inn hele
    // Component-objektet. "Har fil"-flaggene hentes for seg med
    // KomponenterMedFilAsync - c.Filer.X her ville gitt en join som leser alle
    // filene i databasen for hver rad (se KomponentFilerExtensions).
    private sealed class ComponentRow
    {
        public int Id { get; set; }
        public int? ComponentTypeId { get; set; }
        public string TypeName { get; set; } = "";
        public string Navn { get; set; } = "";
        public string? Navn2 { get; set; }
        public string? Produsent { get; set; }
        public string? Konsept { get; set; }
        public string? ProdusentAdresse { get; set; }
        public string? ProdusentPostnr { get; set; }
        public string? ProdusentSted { get; set; }
        public string? ProdusentLand { get; set; }
        public string? ProdusentOrgnr { get; set; }
        public string? Leverandor { get; set; }
        public List<string> LeverandorNavn { get; set; } = [];
        public string? Produktkode { get; set; }
        public string? Gtin { get; set; }
        public string? Overflate { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public int? RabattgruppeId { get; set; }
        public string? RabattgruppeKode { get; set; }
        public bool IngenRabattTilgjengelig { get; set; }
        public List<string> ProduktgruppeNavnListe { get; set; } = [];
        public int? MontasjeMinutterProsjekt { get; set; }
        public int? MontasjeMinutterArbeidsordre { get; set; }
        public int? MontasjeMinutterService { get; set; }
        public int? GarantitidManeder { get; set; }
        public string? Enhet { get; set; }
        public bool Aktiv { get; set; }
        public bool ILagerstyring { get; set; }
        public int PackageCount { get; set; }
        public bool HarFdv { get; set; }
        public string? FdvFilnavn { get; set; }
        public bool HarMontasjeblad { get; set; }
        public string? MontasjebladFilnavn { get; set; }
        public int? InntektskontoId { get; set; }
        public bool ErKomplett { get; set; }
        public bool TrengerDobbelsjekk { get; set; }
        public bool HarBilde { get; set; }
    }

    private IQueryable<ComponentRow> ComponentRowsQuery() => Db.Components.Select(c => new ComponentRow
    {
        Id = c.Id,
        ComponentTypeId = c.ComponentTypeId,
        TypeName = c.Type != null ? c.Type.Navn : "Ikke satt",
        Navn = c.Navn,
        Navn2 = c.Navn2,
        Produsent = c.Produsent,
        Konsept = c.Konsept,
        ProdusentAdresse = c.ProdusentAdresse,
        ProdusentPostnr = c.ProdusentPostnr,
        ProdusentSted = c.ProdusentSted,
        ProdusentLand = c.ProdusentLand,
        ProdusentOrgnr = c.ProdusentOrgnr,
        Leverandor = c.Leverandor,
        Produktkode = c.Produktkode,
        Gtin = c.Gtin,
        Overflate = c.Overflate,
        PrisNetto = c.PrisNetto,
        PrisVeiledende = c.PrisVeiledende,
        RabattgruppeId = c.RabattgruppeId,
        RabattgruppeKode = c.Rabattgruppe != null ? c.Rabattgruppe.Kode : null,
        IngenRabattTilgjengelig = c.IngenRabattTilgjengelig,
        MontasjeMinutterProsjekt = c.MontasjeMinutterProsjekt,
        MontasjeMinutterArbeidsordre = c.MontasjeMinutterArbeidsordre,
        MontasjeMinutterService = c.MontasjeMinutterService,
        GarantitidManeder = c.GarantitidManeder,
        Enhet = c.Enhet,
        Aktiv = c.Aktiv,
        ILagerstyring = c.ILagerstyring,
        PackageCount = c.Pakker.Count,
        FdvFilnavn = c.FdvFilnavn,
        MontasjebladFilnavn = c.MontasjebladFilnavn,
        InntektskontoId = c.InntektskontoId,
        ErKomplett = c.ErKomplett,
        TrengerDobbelsjekk = c.TrengerDobbelsjekk
    });

    private static ComponentDraft MapToDraft(ComponentRow r) => new()
    {
        Id = r.Id,
        ComponentTypeId = r.ComponentTypeId,
        TypeName = r.TypeName,
        Navn = r.Navn,
        Navn2 = r.Navn2,
        Produsent = r.Produsent,
        Konsept = r.Konsept,
        ProdusentAdresse = r.ProdusentAdresse,
        ProdusentPostnr = r.ProdusentPostnr,
        ProdusentSted = r.ProdusentSted,
        ProdusentLand = r.ProdusentLand,
        ProdusentOrgnr = r.ProdusentOrgnr,
        Leverandor = r.Leverandor,
        LeverandorNavn = r.LeverandorNavn,
        Produktkode = r.Produktkode,
        Gtin = r.Gtin,
        Overflate = r.Overflate,
        PrisNetto = r.PrisNetto,
        PrisVeiledende = r.PrisVeiledende,
        RabattgruppeId = r.RabattgruppeId,
        RabattgruppeKode = r.RabattgruppeKode,
        IngenRabattTilgjengelig = r.IngenRabattTilgjengelig,
        ProduktgruppeNavn = r.ProduktgruppeNavnListe.Count == 0 ? null : string.Join(", ", r.ProduktgruppeNavnListe),
        MontasjeMinutterProsjekt = r.MontasjeMinutterProsjekt,
        MontasjeMinutterArbeidsordre = r.MontasjeMinutterArbeidsordre,
        MontasjeMinutterService = r.MontasjeMinutterService,
        GarantitidManeder = r.GarantitidManeder,
        Enhet = r.Enhet,
        Aktiv = r.Aktiv,
        ILagerstyring = r.ILagerstyring,
        PackageCount = r.PackageCount,
        HarFdv = r.HarFdv,
        FdvFilnavn = r.FdvFilnavn,
        HarMontasjeblad = r.HarMontasjeblad,
        MontasjebladFilnavn = r.MontasjebladFilnavn,
        InntektskontoId = r.InntektskontoId,
        ErKomplett = r.ErKomplett,
        TrengerDobbelsjekk = r.TrengerDobbelsjekk,
        HarBilde = r.HarBilde
    };

    // Leverandørnavn og produktgruppenavn hentes som egne, flate spørringer
    // (ikke korrelerte underspørringer inne i ComponentRowsQuery) fordi
    // SQLite-driveren til EF Core ikke støtter SQL APPLY - noe en korrelert
    // collection-projeksjon per rad (f.eks. c.Leverandorer.Select(...).ToList()
    // inne i en større Select) krever. Kobles sammen i minnet etterpå.
    private async Task<Dictionary<int, List<string>>> LoadLeverandorNavnLookupAsync(IReadOnlyCollection<int>? ids)
    {
        var query = Db.ComponentLeverandorer.Where(l => l.Leverandor != null);
        if (ids is not null)
        {
            query = query.Where(l => ids.Contains(l.ComponentId));
        }

        var par = await query
            .Select(l => new { l.ComponentId, Navn = l.Leverandor!.Navn })
            .Distinct()
            .ToListAsync();

        return par
            .GroupBy(x => x.ComponentId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Navn).OrderBy(n => n).ToList());
    }

    private async Task<Dictionary<int, List<string>>> LoadProduktgruppeNavnLookupAsync(IReadOnlyCollection<int>? ids)
    {
        var query = Db.Components.AsQueryable();
        if (ids is not null)
        {
            query = query.Where(c => ids.Contains(c.Id));
        }

        var par = await query
            .SelectMany(c => c.Produktgrupper, (c, p) => new { ComponentId = c.Id, p.Navn })
            .ToListAsync();

        return par
            .GroupBy(x => x.ComponentId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Navn).OrderBy(n => n).ToList());
    }

    private async Task LoadAsync()
    {
        _types = await Db.ComponentTypes.OrderBy(t => t.Sortering).ThenBy(t => t.Navn).ToListAsync();
        _rabattgrupper = await Db.Rabattgrupper.Where(r => r.Aktiv).OrderBy(r => r.Leverandor).ThenBy(r => r.Kode).ToListAsync();

        var rows = await ComponentRowsQuery().ToListAsync();

        var leverandorLookup = await LoadLeverandorNavnLookupAsync(null);
        var produktgruppeLookup = await LoadProduktgruppeNavnLookupAsync(null);
        var medFdv = await Db.KomponenterMedFilAsync("FdvData");
        var medMontasjeblad = await Db.KomponenterMedFilAsync("MontasjebladData");
        var medBilde = await Db.KomponenterMedFilAsync("BildeData");
        foreach (var r in rows)
        {
            r.LeverandorNavn = leverandorLookup.GetValueOrDefault(r.Id) ?? [];
            r.ProduktgruppeNavnListe = produktgruppeLookup.GetValueOrDefault(r.Id) ?? [];
            r.HarFdv = medFdv.Contains(r.Id);
            r.HarMontasjeblad = medMontasjeblad.Contains(r.Id);
            r.HarBilde = medBilde.Contains(r.Id);
        }

        _components = rows.Select(MapToDraft).ToList();

        _leverandorer = _components
            .SelectMany(c => c.LeverandorNavn)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

        _draft.ComponentTypeId = 0;
        RefreshFiltered();
    }

    // Oppdaterer kun raden for ÉN vare i stedet for å kjøre hele LoadAsync -
    // varekortet lagrer/oppdaterer seg selv veldig ofte nå (Komplett/
    // Dobbelsjekk, lim inn bilde, dra-og-slipp-filer o.l.).
    private async Task RefreshDraft(int id)
    {
        var r = await ComponentRowsQuery().FirstOrDefaultAsync(x => x.Id == id);
        if (r is null)
        {
            return;
        }

        var leverandorLookup = await LoadLeverandorNavnLookupAsync([id]);
        var produktgruppeLookup = await LoadProduktgruppeNavnLookupAsync([id]);
        r.LeverandorNavn = leverandorLookup.GetValueOrDefault(r.Id) ?? [];
        r.ProduktgruppeNavnListe = produktgruppeLookup.GetValueOrDefault(r.Id) ?? [];
        r.HarFdv = (await Db.KomponenterMedFilAsync("FdvData", [id])).Count > 0;
        r.HarMontasjeblad = (await Db.KomponenterMedFilAsync("MontasjebladData", [id])).Count > 0;
        r.HarBilde = (await Db.KomponenterMedFilAsync("BildeData", [id])).Count > 0;

        var index = _components.FindIndex(d => d.Id == r.Id);
        if (index >= 0)
        {
            _components[index] = MapToDraft(r);
        }

        _leverandorer = _components
            .SelectMany(cd => cd.LeverandorNavn)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

        RefreshFiltered();
    }

    // Kalles fra KomponentPanel sin OnSaved.
    private async Task RefreshValgtVare()
    {
        _bildeVersjon++;
        if (_valgtVareId is not null)
        {
            await RefreshDraft(_valgtVareId.Value);
        }
    }

