    private async Task AddComponent()
    {
        if (string.IsNullOrWhiteSpace(_draft.Navn))
        {
            _addMessage = "Skriv inn et navn.";
            return;
        }

        Db.Components.Add(new Component
        {
            ComponentTypeId = _draft.ComponentTypeId == 0 ? null : _draft.ComponentTypeId,
            Navn = _draft.Navn.Trim(),
            Leverandor = string.IsNullOrWhiteSpace(_draft.Leverandor) ? null : _draft.Leverandor.Trim(),
            Produktkode = string.IsNullOrWhiteSpace(_draft.Produktkode) ? null : _draft.Produktkode.Trim()
        });
        await Db.SaveChangesAsync();

        _addMessage = $"\"{_draft.Navn.Trim()}\" er lagt til.";
        _draft = new NewComponentDraft();
        await LoadAsync();
    }

    private async Task CreateComponentType()
    {
        var navn = _nyTypeNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.ComponentTypes.Add(new ComponentType { Navn = navn });
        await Db.SaveChangesAsync();

        _nyTypeMessage = $"Komponenttypen \"{navn}\" er opprettet.";
        _nyTypeNavn = "";
        await LoadAsync();
    }

    private async Task RenameComponentType(ComponentType t)
    {
        var navn = t.Navn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var entity = await Db.ComponentTypes.FindAsync(t.Id);
        if (entity is null)
        {
            return;
        }

        entity.Navn = navn;
        await Db.SaveChangesAsync();
        _typerPanelMessage = $"\"{navn}\" er lagret.";
        await LoadAsync();
    }

    private async Task DeleteComponentType(ComponentType t)
    {
        if (_components.Any(c => c.ComponentTypeId == t.Id))
        {
            _typerPanelMessage = $"Kan ikke slette \"{t.Navn}\" - i bruk på {_components.Count(c => c.ComponentTypeId == t.Id)} komponent(er).";
            return;
        }

        var entity = await Db.ComponentTypes.FindAsync(t.Id);
        if (entity is null)
        {
            return;
        }

        Db.ComponentTypes.Remove(entity);
        await Db.SaveChangesAsync();
        _typerPanelMessage = $"\"{t.Navn}\" er slettet.";
        await LoadAsync();
    }
}
