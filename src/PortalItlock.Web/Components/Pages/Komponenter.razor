@page "/komponenter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Komponentregister</PageTitle>

<h1>Komponentregister</h1>
<p>Søk og bla i alle komponenter. Trykk "Rediger" for å endre navn, leverandør, produktkode eller pris. Kryss av "Aktiv" for varer dere faktisk bruker.</p>
<a class="add-button" href="/komponenter/prisimport">Importer prisliste (Excel)</a>
<a class="add-button" href="/rabattgrupper">Rabattgrupper</a>

<div class="filters">
    <input @bind="_search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Søk på navn, leverandør eller produktkode" class="search-input" />
    <select @bind="_selectedTypeId" @bind:after="ResetPage">
        <option value="0">Alle komponenttyper</option>
        @foreach (var t in _types)
        {
            <option value="@t.Id">@t.Navn</option>
        }
    </select>
    <select @bind="_selectedLeverandor" @bind:after="ResetPage">
        <option value="">Alle leverandører</option>
        @foreach (var l in _leverandorer)
        {
            <option value="@l">@l</option>
        }
    </select>
    <select @bind="_activeFilter" @bind:after="ResetPage" aria-label="Aktiv-status">
        <option value="active">Kun aktive</option>
        <option value="inactive">Kun inaktive</option>
        <option value="all">Alle</option>
    </select>
</div>

<p class="result-count">@_filteredCount av @_components.Count komponenter</p>
@if (!string.IsNullOrEmpty(_fdvFeil))
{
    <p class="form-error">@_fdvFeil</p>
}

<div class="table-wrap">
    <table class="component-table">
        <thead>
            <tr>
                <th>Aktiv</th>
                <th>Komponenttype</th>
                <th>Navn</th>
                <th>Leverandør</th>
                <th>Produktkode</th>
                <th>Overflate</th>
                <th>Netto</th>
                <th>Veiledende</th>
                <th>Rabattgruppe</th>
                <th>Montasjetid</th>
                <th>Enhet</th>
                <th>FDV</th>
                <th>Brukt i</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in PagedComponents)
            {
                <tr class="@(c.Aktiv ? "" : "inactive-row")">
                    <td>
                        <input type="checkbox" checked="@c.Aktiv" @onchange="@(e => ToggleActive(c, (bool)e.Value!))" />
                    </td>
                    @if (_editingId == c.Id)
                    {
                        <td>
                            <select @bind="c.ComponentTypeId">
                                <option value="">Ikke satt</option>
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id">@t.Navn</option>
                                }
                            </select>
                        </td>
                        <td><input @bind="c.Navn" /></td>
                        <td><input @bind="c.Leverandor" /></td>
                        <td><input @bind="c.Produktkode" /></td>
                        <td><input @bind="c.Overflate" placeholder="F.eks. Fkrm" /></td>
                        <td>
                            <input @bind="c.PrisNetto" class="price-input" disabled="@c.IngenPris" />
                        </td>
                        <td>
                            <input @bind="c.PrisVeiledende" class="price-input" disabled="@c.IngenPris" />
                            <label class="no-price-toggle">
                                <input type="checkbox" @bind="c.IngenPris" /> Ingen pris
                            </label>
                        </td>
                        <td>
                            <select @bind="c.RabattgruppeId">
                                <option value="">Ingen</option>
                                @foreach (var r in _rabattgrupper)
                                {
                                    <option value="@r.Id">@r.Kode - @r.Leverandor (@r.RabattProsent%)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input @bind="c.MontasjeMinutter" class="price-input" placeholder="min" />
                        </td>
                        <td>
                            <input @bind="c.Enhet" class="price-input" placeholder="stk" />
                        </td>
                        <td class="fdv-cell">
                            @if (c.HarFdv)
                            {
                                <a href="@($"/komponent/{c.Id}/fdv")" target="_blank">@c.FdvFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveFdv(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadFdv(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td>@UsageLabel(c.PackageCount)</td>
                        <td class="actions">
                            <button type="button" class="save-button" @onclick="@(() => Save(c))">Lagre</button>
                            <button type="button" class="cancel-button" @onclick="@(() => _editingId = null)">Avbryt</button>
                        </td>
                    }
                    else
                    {
                        <td>@c.TypeName</td>
                        <td>@c.Navn</td>
                        <td>@c.Leverandor</td>
                        <td>@c.Produktkode</td>
                        <td>@c.Overflate</td>
                        <td class="price-cell">@FormatPrice(c.PrisNetto)</td>
                        <td class="price-cell">@FormatPrice(c.PrisVeiledende)</td>
                        <td>@(c.RabattgruppeKode ?? "-")</td>
                        <td class="price-cell">@FormatMinutter(c.MontasjeMinutter)</td>
                        <td>@c.Enhet</td>
                        <td class="fdv-cell">
                            @if (c.HarFdv)
                            {
                                <a href="@($"/komponent/{c.Id}/fdv")" target="_blank">@c.FdvFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveFdv(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadFdv(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td>@UsageLabel(c.PackageCount)</td>
                        <td class="actions">
                            <button type="button" class="edit-button" @onclick="@(() => StartEdit(c))">Rediger</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination">
    <button type="button" class="page-button" disabled="@(_page == 0)" @onclick="@(() => ChangePage(-1))">Forrige</button>
    <span>Side @(_page + 1) av @Math.Max(1, TotalPages)</span>
    <button type="button" class="page-button" disabled="@(_page + 1 >= TotalPages)" @onclick="@(() => ChangePage(1))">Neste</button>
</div>

<div class="new-component">
    <h2>Legg til komponent</h2>
    <div class="new-component-form">
        <select @bind="_draft.ComponentTypeId">
            <option value="0">Ingen type</option>
            @foreach (var t in _types)
            {
                <option value="@t.Id">@t.Navn</option>
            }
        </select>
        <input @bind="_draft.Navn" placeholder="Navn" />
        <input @bind="_draft.Leverandor" placeholder="Leverandør (valgfritt)" />
        <input @bind="_draft.Produktkode" placeholder="Produktkode (valgfritt)" />
        <button type="button" class="add-button" @onclick="AddComponent">Legg til</button>
    </div>
    @if (!string.IsNullOrEmpty(_addMessage))
    {
        <p class="save-success">@_addMessage</p>
    }
</div>

<div class="new-component">
    <h2>Opprett ny komponenttype</h2>
    <p>Bruk dette hvis en vare ikke passer inn i noen av de eksisterende komponenttypene.</p>
    <div class="new-component-form">
        <input @bind="_nyTypeNavn" @bind:event="oninput" placeholder="Navn på ny komponenttype" />
        <button type="button" class="add-button" @onclick="CreateComponentType">Opprett</button>
    </div>
    @if (!string.IsNullOrEmpty(_nyTypeMessage))
    {
        <p class="save-success">@_nyTypeMessage</p>
    }
</div>

@code {
    private sealed class ComponentDraft
    {
        public int Id { get; set; }
        public int? ComponentTypeId { get; set; }
        public string TypeName { get; set; } = "";
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
        public string? Overflate { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public int? RabattgruppeId { get; set; }
        public string? RabattgruppeKode { get; set; }
        public int? MontasjeMinutter { get; set; }
        public string? Enhet { get; set; }
        public bool Aktiv { get; set; }
        public bool IngenPris { get; set; }
        public int PackageCount { get; set; }
        public bool HarFdv { get; set; }
        public string? FdvFilnavn { get; set; }
    }

    private sealed class NewComponentDraft
    {
        public int ComponentTypeId { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
    }

    private const int PageSize = 50;

    private List<ComponentDraft> _components = [];
    private List<ComponentType> _types = [];
    private List<Rabattgruppe> _rabattgrupper = [];
    private List<string> _leverandorer = [];
    private string _search = "";
    private int _selectedTypeId;
    private string _selectedLeverandor = "";
    private string _activeFilter = "active";
    private int _page;
    private int _filteredCount;
    private int? _editingId;
    private NewComponentDraft _draft = new();
    private string? _addMessage;
    private string _nyTypeNavn = "";
    private string? _nyTypeMessage;
    private string? _fdvFeil;

    private int TotalPages => (int)Math.Ceiling(_filteredCount / (double)PageSize);

    private List<ComponentDraft> _filtered = [];

    private IEnumerable<ComponentDraft> PagedComponents =>
        _filtered.Skip(_page * PageSize).Take(PageSize);

    private void RefreshFiltered()
    {
        _filtered = _components.Where(MatchesFilter).OrderBy(c => c.TypeName).ThenBy(c => c.Navn).ToList();
        _filteredCount = _filtered.Count;
    }

    private bool MatchesFilter(ComponentDraft c)
    {
        if (_activeFilter == "active" && !c.Aktiv)
        {
            return false;
        }

        if (_activeFilter == "inactive" && c.Aktiv)
        {
            return false;
        }

        if (_selectedTypeId != 0 && c.ComponentTypeId != _selectedTypeId)
        {
            return false;
        }

        if (!string.IsNullOrEmpty(_selectedLeverandor) && c.Leverandor != _selectedLeverandor)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();
        return Contains(c.Navn, term) || Contains(c.Leverandor, term) || Contains(c.Produktkode, term);
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string UsageLabel(int count) => count switch
    {
        0 => "Ikke i bruk",
        1 => "1 pakke",
        _ => $"{count} pakker"
    };

    private static string FormatPrice(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", CultureInfo.GetCultureInfo("nb-NO")) + " kr" : "-";

    private static string FormatMinutter(int? value) =>
        value.HasValue ? $"{value.Value} min" : "-";

    private void ResetPage()
    {
        _page = 0;
        RefreshFiltered();
    }

    private void ChangePage(int delta) => _page = Math.Max(0, _page + delta);

    private void StartEdit(ComponentDraft c)
    {
        c.IngenPris = c.PrisNetto is null && c.PrisVeiledende is null;
        _editingId = c.Id;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _types = await Db.ComponentTypes.OrderBy(t => t.Navn).ToListAsync();
        _rabattgrupper = await Db.Rabattgrupper.Where(r => r.Aktiv).OrderBy(r => r.Leverandor).ThenBy(r => r.Kode).ToListAsync();

        var components = await Db.Components
            .Include(c => c.Type)
            .Include(c => c.Pakker)
            .Include(c => c.Rabattgruppe)
            .ToListAsync();

        _components = components.Select(c => new ComponentDraft
        {
            Id = c.Id,
            ComponentTypeId = c.ComponentTypeId,
            TypeName = c.Type?.Navn ?? "Ikke satt",
            Navn = c.Navn,
            Leverandor = c.Leverandor,
            Produktkode = c.Produktkode,
            Overflate = c.Overflate,
            PrisNetto = c.PrisNetto,
            PrisVeiledende = c.PrisVeiledende,
            RabattgruppeId = c.RabattgruppeId,
            RabattgruppeKode = c.Rabattgruppe?.Kode,
            MontasjeMinutter = c.MontasjeMinutter,
            Enhet = c.Enhet,
            Aktiv = c.Aktiv,
            PackageCount = c.Pakker.Count,
            HarFdv = c.FdvData != null,
            FdvFilnavn = c.FdvFilnavn
        }).ToList();

        _leverandorer = _components
            .Select(c => c.Leverandor)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .Select(l => l!)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

        _draft.ComponentTypeId = 0;
        RefreshFiltered();
    }

    private async Task ToggleActive(ComponentDraft draft, bool aktiv)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.Aktiv = aktiv;
        await Db.SaveChangesAsync();
        draft.Aktiv = aktiv;
        RefreshFiltered();
    }

    private async Task Save(ComponentDraft draft)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.ComponentTypeId = draft.ComponentTypeId;
        entity.Navn = draft.Navn.Trim();
        entity.Leverandor = string.IsNullOrWhiteSpace(draft.Leverandor) ? null : draft.Leverandor.Trim();
        entity.Produktkode = string.IsNullOrWhiteSpace(draft.Produktkode) ? null : draft.Produktkode.Trim();
        entity.Overflate = string.IsNullOrWhiteSpace(draft.Overflate) ? null : draft.Overflate.Trim();
        entity.PrisNetto = draft.IngenPris ? null : draft.PrisNetto;
        entity.PrisVeiledende = draft.IngenPris ? null : draft.PrisVeiledende;
        entity.RabattgruppeId = draft.RabattgruppeId;
        entity.MontasjeMinutter = draft.MontasjeMinutter;
        entity.Enhet = string.IsNullOrWhiteSpace(draft.Enhet) ? null : draft.Enhet.Trim();
        await Db.SaveChangesAsync();

        _editingId = null;
        await LoadAsync();
    }

    private async Task UploadFdv(ComponentDraft draft, InputFileChangeEventArgs e)
    {
        _fdvFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _fdvFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.FdvData = buffer.ToArray();
        entity.FdvFilnavn = file.Name;
        entity.FdvContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();

        draft.HarFdv = true;
        draft.FdvFilnavn = file.Name;
    }

    private async Task RemoveFdv(ComponentDraft draft)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.FdvData = null;
        entity.FdvFilnavn = null;
        entity.FdvContentType = null;
        await Db.SaveChangesAsync();

        draft.HarFdv = false;
        draft.FdvFilnavn = null;
    }

    private async Task AddComponent()
    {
        if (string.IsNullOrWhiteSpace(_draft.Navn))
        {
            _addMessage = "Skriv inn et navn.";
            return;
        }

        Db.Components.Add(new Component
        {
            ComponentTypeId = _draft.ComponentTypeId == 0 ? null : _draft.ComponentTypeId,
            Navn = _draft.Navn.Trim(),
            Leverandor = string.IsNullOrWhiteSpace(_draft.Leverandor) ? null : _draft.Leverandor.Trim(),
            Produktkode = string.IsNullOrWhiteSpace(_draft.Produktkode) ? null : _draft.Produktkode.Trim()
        });
        await Db.SaveChangesAsync();

        _addMessage = $"\"{_draft.Navn.Trim()}\" er lagt til.";
        _draft = new NewComponentDraft();
        await LoadAsync();
    }

    private async Task CreateComponentType()
    {
        var navn = _nyTypeNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        Db.ComponentTypes.Add(new ComponentType { Navn = navn });
        await Db.SaveChangesAsync();

        _nyTypeMessage = $"Komponenttypen \"{navn}\" er opprettet.";
        _nyTypeNavn = "";
        await LoadAsync();
    }
}
