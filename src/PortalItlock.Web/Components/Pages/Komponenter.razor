@page "/komponenter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Komponentregister</PageTitle>

<h1>Komponentregister</h1>
<p>Søk og bla i alle komponenter. Trykk "Rediger" for å endre navn, leverandør, produktkode eller pris. Kryss av "Aktiv" for varer dere faktisk bruker.</p>
<a class="add-button" href="/komponenter/prisimport">Importer prisliste (Excel)</a>
<a class="add-button" href="/komponenter/oppdater-priser">Oppdater priser</a>
<a class="add-button" href="/rabattgrupper">Rabattgrupper</a>

<div class="ny-komponenttype-rad">
    <input @bind="_nyTypeNavn" @bind:event="oninput" placeholder="Navn på ny komponenttype" />
    <button type="button" class="add-button" @onclick="CreateComponentType">Opprett ny komponenttype</button>
    <button type="button" class="cancel-button" @onclick="@(() => _visTyperPanel = !_visTyperPanel)">@(_visTyperPanel ? "Skjul komponenttyper" : "Endre komponenttyper")</button>
    @if (!string.IsNullOrEmpty(_nyTypeMessage))
    {
        <span class="save-success">@_nyTypeMessage</span>
    }
</div>

@if (_visTyperPanel)
{
    <div class="komponenttype-panel">
        @foreach (var t in _types)
        {
            <div class="komponenttype-rad" @key="t.Id">
                <input @bind="t.Navn" @bind:event="oninput" />
                <button type="button" class="save-button" @onclick="@(() => RenameComponentType(t))">Lagre</button>
                <button type="button" class="cancel-button" disabled="@_components.Any(c => c.ComponentTypeId == t.Id)" title="@(_components.Any(c => c.ComponentTypeId == t.Id) ? "Kan ikke slette - i bruk på komponenter" : null)" @onclick="@(() => DeleteComponentType(t))">Slett</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_typerPanelMessage))
        {
            <p class="save-success">@_typerPanelMessage</p>
        }
    </div>
}

<div class="filters">
    <input @bind="_search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Søk på navn, leverandør eller produktkode" class="search-input" />
    <select @bind="_selectedTypeId" @bind:after="ResetPage">
        <option value="0">Alle komponenttyper</option>
        @foreach (var t in _types)
        {
            <option value="@t.Id">@t.Navn</option>
        }
    </select>
    <select @bind="_selectedLeverandor" @bind:after="ResetPage">
        <option value="">Alle leverandører</option>
        @foreach (var l in _leverandorer)
        {
            <option value="@l">@l</option>
        }
    </select>
    <select @bind="_activeFilter" @bind:after="ResetPage" aria-label="Aktiv-status">
        <option value="active">Kun aktive</option>
        <option value="inactive">Kun inaktive</option>
        <option value="all">Alle</option>
    </select>
</div>

<p class="result-count">@_filteredCount av @_components.Count komponenter</p>
@if (!string.IsNullOrEmpty(_fdvFeil))
{
    <p class="form-error">@_fdvFeil</p>
}

<div class="pagination">
    <button type="button" class="page-button" disabled="@(_page == 0)" @onclick="@(() => ChangePage(-1))">Forrige</button>
    <span>Side @(_page + 1) av @Math.Max(1, TotalPages)</span>
    <button type="button" class="page-button" disabled="@(_page + 1 >= TotalPages)" @onclick="@(() => ChangePage(1))">Neste</button>
</div>

<div id="komponenter-scroll-top" class="table-scroll-top">
    <div class="table-scroll-top-inner"></div>
</div>
<div class="table-wrap" id="komponenter-table-wrap">
    <table class="component-table">
        <thead>
            <tr>
                <th></th>
                <th>Aktiv</th>
                <th>Lager</th>
                <th>Komponenttype</th>
                <th>Varenavn 1</th>
                <th>Varenavn 2</th>
                <th>Produsent</th>
                <th>Leverandør</th>
                <th>Produktkode</th>
                <th>GTIN/EAN</th>
                <th>Overflate</th>
                <th>Netto</th>
                <th>Veiledende</th>
                <th>Rabattgruppe</th>
                <th>Produktgruppe</th>
                <th>Montasjetid prosjekt</th>
                <th>Montasjetid arbeidsordre</th>
                <th>Montasjetid service</th>
                <th>Enhet</th>
                <th>FDV</th>
                <th>Montasjeblad</th>
                <th>Brukt i</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in PagedComponents)
            {
                <tr class="@(c.Aktiv ? "" : "inactive-row")">
                    @if (_editingId == c.Id)
                    {
                        <td class="actions">
                            @if (_slettendeId == c.Id)
                            {
                                <span class="delete-confirm">
                                    <input @bind="_slettBekreftelseTekst" @bind:event="oninput" placeholder="SLETT" class="kode-input" />
                                    <button type="button" class="delete-confirm-button" disabled="@(_slettBekreftelseTekst != "SLETT")" @onclick="@(() => SlettKomponent(c))">Slett</button>
                                    <button type="button" class="cancel-button" @onclick="@(() => { _slettendeId = null; _slettBekreftelseTekst = ""; })">Avbryt</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="save-button" @onclick="@(() => Save(c))">Lagre</button>
                                <button type="button" class="cancel-button" @onclick="@(() => _editingId = null)">Avbryt</button>
                                <button type="button" class="delete-button" @onclick="@(() => _slettendeId = c.Id)">Slett</button>
                            }
                        </td>
                    }
                    else
                    {
                        <td class="actions">
                            <button type="button" class="edit-button" @onclick="@(() => StartEdit(c))">Rediger</button>
                            <a href="@($"/komponenter/{c.Id}/prishistorikk")">Historikk</a>
                        </td>
                    }
                    <td>
                        <input type="checkbox" checked="@c.Aktiv" @onchange="@(e => ToggleActive(c, (bool)e.Value!))" />
                    </td>
                    <td>
                        <input type="checkbox" title="Vis denne varen i lagerstyring" checked="@c.ILagerstyring" @onchange="@(e => ToggleLagerstyring(c, (bool)e.Value!))" />
                    </td>
                    @if (_editingId == c.Id)
                    {
                        <td>
                            <select @bind="c.ComponentTypeId">
                                <option value="">Ikke satt</option>
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id">@t.Navn</option>
                                }
                            </select>
                        </td>
                        <td><input @bind="c.Navn" /></td>
                        <td><input @bind="c.Navn2" placeholder="Varenavn 2 (valgfritt)" /></td>
                        <td><input @bind="c.Produsent" placeholder="F.eks. Dormakaba" /></td>
                        <td><input @bind="c.Leverandor" /></td>
                        <td><input @bind="c.Produktkode" /></td>
                        <td><input @bind="c.Gtin" placeholder="GTIN/EAN" /></td>
                        <td><input @bind="c.Overflate" placeholder="F.eks. Fkrm" /></td>
                        <td>
                            <input @bind="c.PrisNetto" class="price-input" disabled="@c.IngenPris" />
                        </td>
                        <td>
                            <input @bind="c.PrisVeiledende" class="price-input" disabled="@c.IngenPris" />
                            <label class="no-price-toggle">
                                <input type="checkbox" @bind="c.IngenPris" /> Ingen pris
                            </label>
                        </td>
                        <td>
                            <select @bind="c.RabattgruppeId">
                                <option value="">Ingen</option>
                                @foreach (var r in _rabattgrupper)
                                {
                                    <option value="@r.Id">@r.Kode - @r.Leverandor (@r.RabattProsent%)</option>
                                }
                            </select>
                        </td>
                        <td title="Produktgrupper redigeres fra selve produktgruppen (Admin → Produktgrupper), en vare kan ligge i flere.">@(c.ProduktgruppeNavn ?? "-")</td>
                        <td>
                            <input @bind="c.MontasjeMinutterProsjekt" class="price-input" placeholder="min" /> min
                        </td>
                        <td>
                            <input @bind="c.MontasjeMinutterArbeidsordre" class="price-input" placeholder="min" /> min
                        </td>
                        <td>
                            <input @bind="c.MontasjeMinutterService" class="price-input" placeholder="min" /> min
                        </td>
                        <td>
                            <input @bind="c.Enhet" class="price-input" placeholder="stk" />
                        </td>
                        <td class="fdv-cell">
                            @if (c.HarFdv)
                            {
                                <a href="@($"/komponent/{c.Id}/fdv")" target="_blank">@c.FdvFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveFdv(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadFdv(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td class="fdv-cell">
                            @if (c.HarMontasjeblad)
                            {
                                <a href="@($"/komponent/{c.Id}/montasjeblad")" target="_blank">@c.MontasjebladFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveMontasjeblad(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadMontasjeblad(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td>@UsageLabel(c.PackageCount)</td>
                    }
                    else
                    {
                        <td>@c.TypeName</td>
                        <td>@c.Navn</td>
                        <td>@c.Navn2</td>
                        <td>@c.Produsent</td>
                        <td>@c.Leverandor</td>
                        <td>@c.Produktkode</td>
                        <td>@c.Gtin</td>
                        <td>@c.Overflate</td>
                        <td class="price-cell">@FormatPrice(c.PrisNetto)</td>
                        <td class="price-cell">@FormatPrice(c.PrisVeiledende)</td>
                        <td>@(c.RabattgruppeKode ?? "-")</td>
                        <td>@(c.ProduktgruppeNavn ?? "-")</td>
                        <td class="price-cell">@FormatMinutter(c.MontasjeMinutterProsjekt)</td>
                        <td class="price-cell">@FormatMinutter(c.MontasjeMinutterArbeidsordre)</td>
                        <td class="price-cell">@FormatMinutter(c.MontasjeMinutterService)</td>
                        <td>@c.Enhet</td>
                        <td class="fdv-cell">
                            @if (c.HarFdv)
                            {
                                <a href="@($"/komponent/{c.Id}/fdv")" target="_blank">@c.FdvFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveFdv(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadFdv(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td class="fdv-cell">
                            @if (c.HarMontasjeblad)
                            {
                                <a href="@($"/komponent/{c.Id}/montasjeblad")" target="_blank">@c.MontasjebladFilnavn</a>
                                <button type="button" class="remove-button" @onclick="@(() => RemoveMontasjeblad(c))">Fjern</button>
                            }
                            else
                            {
                                <InputFile OnChange="@(e => UploadMontasjeblad(c, e))" accept=".pdf,application/pdf" />
                            }
                        </td>
                        <td>@UsageLabel(c.PackageCount)</td>
                    }
                </tr>
                @if (_editingId == c.Id)
                {
                    <tr @key="@($"{c.Id}-produsentadresse")" class="produsentadresse-row">
                        <td colspan="15">
                            <div class="produsentadresse-form">
                                <span class="produsentadresse-tittel">Produsentens firmaadresse (til CE-egenerklæring)</span>
                                <input @bind="c.ProdusentAdresse" placeholder="Adresse" />
                                <input @bind="c.ProdusentPostnr" placeholder="Postnr" class="price-input" />
                                <input @bind="c.ProdusentSted" placeholder="Sted" />
                                <input @bind="c.ProdusentLand" placeholder="Land" class="price-input" />
                                <input @bind="c.ProdusentOrgnr" placeholder="Org.nr." class="price-input" />
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="pagination">
    <button type="button" class="page-button" disabled="@(_page == 0)" @onclick="@(() => ChangePage(-1))">Forrige</button>
    <span>Side @(_page + 1) av @Math.Max(1, TotalPages)</span>
    <button type="button" class="page-button" disabled="@(_page + 1 >= TotalPages)" @onclick="@(() => ChangePage(1))">Neste</button>
</div>

<div class="new-component">
    <h2>Legg til komponent</h2>
    <div class="new-component-form">
        <select @bind="_draft.ComponentTypeId">
            <option value="0">Ingen type</option>
            @foreach (var t in _types)
            {
                <option value="@t.Id">@t.Navn</option>
            }
        </select>
        <input @bind="_draft.Navn" placeholder="Navn" />
        <input @bind="_draft.Leverandor" placeholder="Leverandør (valgfritt)" />
        <input @bind="_draft.Produktkode" placeholder="Produktkode (valgfritt)" />
        <button type="button" class="add-button" @onclick="AddComponent">Legg til</button>
    </div>
    @if (!string.IsNullOrEmpty(_addMessage))
    {
        <p class="save-success">@_addMessage</p>
    }
</div>

@code {
    private sealed class ComponentDraft
    {
        public int Id { get; set; }
        public int? ComponentTypeId { get; set; }
        public string TypeName { get; set; } = "";
        public string Navn { get; set; } = "";
        public string? Navn2 { get; set; }
        public string? Produsent { get; set; }
        public string? ProdusentAdresse { get; set; }
        public string? ProdusentPostnr { get; set; }
        public string? ProdusentSted { get; set; }
        public string? ProdusentLand { get; set; }
        public string? ProdusentOrgnr { get; set; }
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
        public string? Gtin { get; set; }
        public string? Overflate { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public int? RabattgruppeId { get; set; }
        public string? RabattgruppeKode { get; set; }
        public string? ProduktgruppeNavn { get; set; }
        public int? MontasjeMinutterProsjekt { get; set; }
        public int? MontasjeMinutterArbeidsordre { get; set; }
        public int? MontasjeMinutterService { get; set; }
        public string? Enhet { get; set; }
        public bool Aktiv { get; set; }
        public bool ILagerstyring { get; set; }
        public bool IngenPris { get; set; }
        public int PackageCount { get; set; }
        public bool HarFdv { get; set; }
        public string? FdvFilnavn { get; set; }
        public bool HarMontasjeblad { get; set; }
        public string? MontasjebladFilnavn { get; set; }
    }

    private sealed class NewComponentDraft
    {
        public int ComponentTypeId { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
        public string? Produktkode { get; set; }
    }

    private const int PageSize = 50;

    private List<ComponentDraft> _components = [];
    private List<ComponentType> _types = [];
    private List<Rabattgruppe> _rabattgrupper = [];
    private List<string> _leverandorer = [];
    private string _search = "";
    private int _selectedTypeId;
    private string _selectedLeverandor = "";
    private string _activeFilter = "active";
    private int _page;
    private int _filteredCount;
    private int? _editingId;
    private int? _slettendeId;
    private string _slettBekreftelseTekst = "";
    private NewComponentDraft _draft = new();
    private string? _addMessage;
    private string _nyTypeNavn = "";
    private string? _nyTypeMessage;
    private bool _visTyperPanel;
    private string? _typerPanelMessage;
    private string? _fdvFeil;

    private int TotalPages => (int)Math.Ceiling(_filteredCount / (double)PageSize);

    private List<ComponentDraft> _filtered = [];

    private IEnumerable<ComponentDraft> PagedComponents =>
        _filtered.Skip(_page * PageSize).Take(PageSize);

    private void RefreshFiltered()
    {
        _filtered = _components.Where(MatchesFilter).OrderBy(c => c.TypeName).ThenBy(c => c.Navn).ToList();
        _filteredCount = _filtered.Count;
    }

    private bool MatchesFilter(ComponentDraft c)
    {
        if (_activeFilter == "active" && !c.Aktiv)
        {
            return false;
        }

        if (_activeFilter == "inactive" && c.Aktiv)
        {
            return false;
        }

        if (_selectedTypeId != 0 && c.ComponentTypeId != _selectedTypeId)
        {
            return false;
        }

        if (!string.IsNullOrEmpty(_selectedLeverandor) && c.Leverandor != _selectedLeverandor)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();
        return Contains(c.Navn, term) || Contains(c.Leverandor, term) || Contains(c.Produktkode, term) || Contains(c.Gtin, term);
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string UsageLabel(int count) => count switch
    {
        0 => "Ikke i bruk",
        1 => "1 pakke",
        _ => $"{count} pakker"
    };

    private static string FormatPrice(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", CultureInfo.GetCultureInfo("nb-NO")) + " kr" : "-";

    private static string FormatMinutter(int? value) =>
        value.HasValue ? $"{value.Value} min" : "-";

    private void ResetPage()
    {
        _page = 0;
        RefreshFiltered();
    }

    private void ChangePage(int delta) => _page = Math.Max(0, _page + delta);

    private void StartEdit(ComponentDraft c)
    {
        c.IngenPris = c.PrisNetto is null && c.PrisVeiledende is null;
        _editingId = c.Id;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private bool _scrollSynkKoblet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_scrollSynkKoblet)
        {
            _scrollSynkKoblet = true;
            await JS.InvokeVoidAsync("tabellscroll.koble", "komponenter-scroll-top", "komponenter-table-wrap");
        }
    }

    private async Task LoadAsync()
    {
        _types = await Db.ComponentTypes.OrderBy(t => t.Navn).ToListAsync();
        _rabattgrupper = await Db.Rabattgrupper.Where(r => r.Aktiv).OrderBy(r => r.Leverandor).ThenBy(r => r.Kode).ToListAsync();

        var components = await Db.Components
            .Include(c => c.Type)
            .Include(c => c.Pakker)
            .Include(c => c.Rabattgruppe)
            .Include(c => c.Produktgrupper)
            .ToListAsync();

        _components = components.Select(c => new ComponentDraft
        {
            Id = c.Id,
            ComponentTypeId = c.ComponentTypeId,
            TypeName = c.Type?.Navn ?? "Ikke satt",
            Navn = c.Navn,
            Navn2 = c.Navn2,
            Produsent = c.Produsent,
            ProdusentAdresse = c.ProdusentAdresse,
            ProdusentPostnr = c.ProdusentPostnr,
            ProdusentSted = c.ProdusentSted,
            ProdusentLand = c.ProdusentLand,
            ProdusentOrgnr = c.ProdusentOrgnr,
            Leverandor = c.Leverandor,
            Produktkode = c.Produktkode,
            Gtin = c.Gtin,
            Overflate = c.Overflate,
            PrisNetto = c.PrisNetto,
            PrisVeiledende = c.PrisVeiledende,
            RabattgruppeId = c.RabattgruppeId,
            RabattgruppeKode = c.Rabattgruppe?.Kode,
            ProduktgruppeNavn = c.Produktgrupper.Count == 0 ? null : string.Join(", ", c.Produktgrupper.OrderBy(p => p.Navn).Select(p => p.Navn)),
            MontasjeMinutterProsjekt = c.MontasjeMinutterProsjekt,
            MontasjeMinutterArbeidsordre = c.MontasjeMinutterArbeidsordre,
            MontasjeMinutterService = c.MontasjeMinutterService,
            Enhet = c.Enhet,
            Aktiv = c.Aktiv,
            ILagerstyring = c.ILagerstyring,
            PackageCount = c.Pakker.Count,
            HarFdv = c.FdvData != null,
            FdvFilnavn = c.FdvFilnavn,
            HarMontasjeblad = c.MontasjebladData != null,
            MontasjebladFilnavn = c.MontasjebladFilnavn
        }).ToList();

        _leverandorer = _components
            .Select(c => c.Leverandor)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .Select(l => l!)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

        _draft.ComponentTypeId = 0;
        RefreshFiltered();
    }

    private async Task ToggleActive(ComponentDraft draft, bool aktiv)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.Aktiv = aktiv;
        await Db.SaveChangesAsync();
        draft.Aktiv = aktiv;
        RefreshFiltered();
    }

    private async Task ToggleLagerstyring(ComponentDraft draft, bool iLagerstyring)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.ILagerstyring = iLagerstyring;
        await Db.SaveChangesAsync();
        draft.ILagerstyring = iLagerstyring;
    }

    private async Task Save(ComponentDraft draft)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        var nyNetto = draft.IngenPris ? null : draft.PrisNetto;
        var nyVeil = draft.IngenPris ? null : draft.PrisVeiledende;
        PrisHistorikkLogger.Logg(Db, entity, nyNetto, nyVeil, "Manuell endring");

        entity.ComponentTypeId = draft.ComponentTypeId;
        entity.Navn = draft.Navn.Trim();
        entity.Navn2 = string.IsNullOrWhiteSpace(draft.Navn2) ? null : draft.Navn2.Trim();
        entity.Produsent = string.IsNullOrWhiteSpace(draft.Produsent) ? null : draft.Produsent.Trim();
        entity.ProdusentAdresse = string.IsNullOrWhiteSpace(draft.ProdusentAdresse) ? null : draft.ProdusentAdresse.Trim();
        entity.ProdusentPostnr = string.IsNullOrWhiteSpace(draft.ProdusentPostnr) ? null : draft.ProdusentPostnr.Trim();
        entity.ProdusentSted = string.IsNullOrWhiteSpace(draft.ProdusentSted) ? null : draft.ProdusentSted.Trim();
        entity.ProdusentLand = string.IsNullOrWhiteSpace(draft.ProdusentLand) ? null : draft.ProdusentLand.Trim();
        entity.ProdusentOrgnr = string.IsNullOrWhiteSpace(draft.ProdusentOrgnr) ? null : draft.ProdusentOrgnr.Trim();
        entity.Leverandor = string.IsNullOrWhiteSpace(draft.Leverandor) ? null : draft.Leverandor.Trim();
        entity.Produktkode = string.IsNullOrWhiteSpace(draft.Produktkode) ? null : draft.Produktkode.Trim();
        entity.Gtin = string.IsNullOrWhiteSpace(draft.Gtin) ? null : draft.Gtin.Trim();
        entity.Overflate = string.IsNullOrWhiteSpace(draft.Overflate) ? null : draft.Overflate.Trim();
        entity.PrisNetto = nyNetto;
        entity.PrisVeiledende = nyVeil;
        entity.RabattgruppeId = draft.RabattgruppeId;
        entity.MontasjeMinutterProsjekt = draft.MontasjeMinutterProsjekt;
        entity.MontasjeMinutterArbeidsordre = draft.MontasjeMinutterArbeidsordre;
        entity.MontasjeMinutterService = draft.MontasjeMinutterService;
        entity.Enhet = string.IsNullOrWhiteSpace(draft.Enhet) ? null : draft.Enhet.Trim();
        await Db.SaveChangesAsync();

        _editingId = null;
        await LoadAsync();
    }

    private async Task SlettKomponent(ComponentDraft draft)
    {
        if (_slettBekreftelseTekst != "SLETT")
        {
            return;
        }

        await Db.TilbudLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));
        await Db.ServiceMinuttLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));
        await Db.MonteringLinjer.Where(t => t.ComponentId == draft.Id).ExecuteUpdateAsync(s => s.SetProperty(t => t.ComponentId, (int?)null));

        await Db.Components.Where(c => c.Id == draft.Id).ExecuteDeleteAsync();

        _slettendeId = null;
        _slettBekreftelseTekst = "";
        _editingId = null;
        await LoadAsync();
    }

    private async Task UploadFdv(ComponentDraft draft, InputFileChangeEventArgs e)
    {
        _fdvFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _fdvFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.FdvData = buffer.ToArray();
        entity.FdvFilnavn = file.Name;
        entity.FdvContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();

        draft.HarFdv = true;
        draft.FdvFilnavn = file.Name;
    }

    private async Task RemoveFdv(ComponentDraft draft)
    {
        var entity = await Db.Components.FirstAsync(c => c.Id == draft.Id);
        entity.FdvData = null;
        entity.FdvFilnavn = null;
        entity.FdvContentType = null;
        await Db.SaveChangesAsync();

        draft.HarFdv = false;
        draft.FdvFilnavn = null;
    }

