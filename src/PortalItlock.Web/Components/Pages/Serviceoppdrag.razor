@page "/serviceoppdrag"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject EmailService Epost
@inject NavigationManager Nav

<PageTitle>Serviceoppdrag</PageTitle>

<p class="section-hint">Henvendelser sendt inn av kunder via "For kunden".</p>

@if (_henvendelser.Count > 0)
{
    <div class="nokkeltall">
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Nye</span>
            <span class="nokkel-verdi blaa">@_henvendelser.Count(h => h.Status == ServicehenvendelseStatus.Ny)</span>
            <span class="nokkel-under">venter på vurdering</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Venter på svar</span>
            <span class="nokkel-verdi gul">@_henvendelser.Count(h => h.Status is ServicehenvendelseStatus.UnderVurdering or ServicehenvendelseStatus.PrisGitt or ServicehenvendelseStatus.VarerBestilt)</span>
            <span class="nokkel-under">under vurdering / pris gitt / varer bestilt</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Fullført</span>
            <span class="nokkel-verdi gronn">@_henvendelser.Count(h => h.Status == ServicehenvendelseStatus.Fullfort)</span>
            <span class="nokkel-under">dokumentasjon sendt</span>
        </div>
        <div class="nokkel-kort">
            <span class="nokkel-etikett">Totalt</span>
            <span class="nokkel-verdi">@_henvendelser.Count</span>
            <span class="nokkel-under">henvendelser</span>
        </div>
    </div>

    <div class="oppdrag-hurtigfilter">
        <button type="button" class="flis @(_hurtigfilter == "alle" ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter("alle"))'>
            <span class="flis-tall">@_henvendelser.Count</span>
            <span class="flis-etikett">Alle</span>
        </button>
        @foreach (var status in ServicehenvendelseStatusExtensions.Rekkefolge)
        {
            <button type="button" class="flis @(_hurtigfilter == status.ToString() ? "aktiv" : "")" @onclick='@(() => SettHurtigfilter(status.ToString()))'>
                <span class="flis-tall">@_henvendelser.Count(h => h.Status == status)</span>
                <span class="flis-etikett">@status.Visningsnavn()</span>
            </button>
        }
    </div>

    <label class="sok-felt oppdrag-sok">
        <Icon Name="search" />
        <input @bind="_search" @bind:event="oninput" placeholder="Søk på kunde, dørtype eller adresse" />
    </label>

    <p class="result-count">@_filtrert.Count av @_henvendelser.Count henvendelser</p>
}

@if (_filtrert.Count == 0)
{
    <p class="list-empty">Ingen henvendelser funnet.</p>
}
else
{
    <div class="henvendelse-liste">
        @foreach (var h in _filtrert)
        {
            <div @key="h.Id" class="henvendelse-kort">
                <div class="henvendelse-header">
                    <div class="henvendelse-kunde">
                        <span class="avatar" style="background:@PersonFarge(h.Kunde?.Navn ?? "?")">@PersonInitialer(h.Kunde?.Navn ?? "?")</span>
                        <div class="henvendelse-kunde-info">
                            <strong>@h.Kunde?.Navn</strong>
                            <span class="sub">@h.Dortype · @h.OpprettetDato.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="henvendelse-status-rad">
                        <select class="status-select @StatusKlasse(h.Status)" @bind="h.Status" @bind:after="@(() => LagreStatus(h))">
                            @foreach (var status in ServicehenvendelseStatusExtensions.Rekkefolge)
                            {
                                <option value="@status">@status.Visningsnavn()</option>
                            }
                        </select>
                        <button type="button" class="filter-button" @onclick="@(() => OpprettTicket(h))">Opprett ticket</button>
                    </div>
                </div>

                <div class="henvendelse-body">
                    @if (!string.IsNullOrWhiteSpace(h.Adresse))
                    {
                        <p><span class="felt-label">Adresse</span>@h.Adresse</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(h.Beskrivelse))
                    {
                        <p>@h.Beskrivelse</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(h.OnsketTidspunkt))
                    {
                        <p><span class="felt-label">Ønsket tidspunkt</span>@h.OnsketTidspunkt</p>
                    }
                </div>

                @if (_kundeBilder.TryGetValue(h.Id, out var kundeBilder) && kundeBilder.Count > 0)
                {
                    <p class="bilde-etikett">Bilder fra kunde:</p>
                    <div class="henvendelse-bilder">
                        @foreach (var bildeId in kundeBilder)
                        {
                            <a href="@($"/servicehenvendelse/bilde/{bildeId}")" target="_blank">
                                <img src="@($"/servicehenvendelse/bilde/{bildeId}")" alt="Bilde" />
                            </a>
                        }
                    </div>
                }

                <div class="henvendelse-seksjon">
                    <p class="henvendelse-seksjon-tittel">Svar til kunde (pris o.l. – sendes på e-post til kunden)</p>
                    <label class="svar-felt">
                        <textarea @bind="h.SvarFraItlock" @bind:event="oninput" rows="2"></textarea>
                    </label>
                    <label class="leveringsdato-felt">
                        Antatt leveringstid (vises til kunden)
                        <input type="date" @bind="h.AntattLeveringsdato" />
                    </label>
                    <button type="button" class="save-button" @onclick="@(() => LagreSvar(h))">Lagre svar/leveringstid</button>
                </div>

                <div class="henvendelse-seksjon">
                    <p class="henvendelse-seksjon-tittel">Dokumentasjonsbilder (vises og sendes til kunde)</p>
                    @if (_dokBilder.TryGetValue(h.Id, out var dokBilder) && dokBilder.Count > 0)
                    {
                        <div class="henvendelse-bilder">
                            @foreach (var bildeId in dokBilder)
                            {
                                <a href="@($"/servicehenvendelse/bilde/{bildeId}")" target="_blank">
                                    <img src="@($"/servicehenvendelse/bilde/{bildeId}")" alt="Dokumentasjonsbilde" />
                                </a>
                            }
                        </div>
                    }
                    <InputFile OnChange="@(e => LastOppDokBilder(h, e))" accept="image/*" multiple />
                </div>

                <div class="henvendelse-actions">
                    <button type="button" class="add-button" @onclick="@(() => SendDokumentasjon(h))" disabled="@(h.Kunde?.Epost is null)">
                        Send dokumentasjon til kunde
                    </button>
                    @if (h.Kunde?.Epost is null)
                    {
                        <span class="form-error">Kunden mangler e-postadresse.</span>
                    }
                    @if (h.EpostSendtDato is not null)
                    {
                        <span class="epost-sendt">
                            <Icon Name="check" />Sendt @h.EpostSendtDato.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </span>
                    }
                    @if (_sendFeil.TryGetValue(h.Id, out var feil))
                    {
                        <span class="form-error">@feil</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Servicehenvendelse> _henvendelser = [];
    private Dictionary<int, List<int>> _kundeBilder = [];
    private Dictionary<int, List<int>> _dokBilder = [];
    private Dictionary<int, string> _sendFeil = [];
    private string _search = "";
    private string _hurtigfilter = "alle";

    private static readonly string[] PersonPaletten = ["#835e41", "#2054a3", "#a1690a", "#2b7a4b", "#7a2b96", "#a32020"];

    private List<Servicehenvendelse> _filtrert => _henvendelser
        .Where(h => _hurtigfilter == "alle" || h.Status.ToString() == _hurtigfilter)
        .Where(h => string.IsNullOrWhiteSpace(_search)
            || (h.Kunde?.Navn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || h.Dortype.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (h.Adresse?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _henvendelser = await Db.Servicehenvendelser
            .Include(h => h.Kunde)
            .OrderByDescending(h => h.OpprettetDato)
            .ToListAsync();

        var henvendelseIder = _henvendelser.Select(h => h.Id).ToList();
        var bilder = await Db.ServicehenvendelseBilder
            .Where(b => henvendelseIder.Contains(b.ServicehenvendelseId))
            .Select(b => new { b.Id, b.ServicehenvendelseId, b.ErDokumentasjon })
            .ToListAsync();

        _kundeBilder = bilder
            .Where(b => !b.ErDokumentasjon)
            .GroupBy(b => b.ServicehenvendelseId)
            .ToDictionary(g => g.Key, g => g.Select(b => b.Id).ToList());

        _dokBilder = bilder
            .Where(b => b.ErDokumentasjon)
            .GroupBy(b => b.ServicehenvendelseId)
            .ToDictionary(g => g.Key, g => g.Select(b => b.Id).ToList());
    }

    private void SettHurtigfilter(string filter)
    {
        _hurtigfilter = _hurtigfilter == filter ? "alle" : filter;
    }

    private static string StatusKlasse(ServicehenvendelseStatus status) => status switch
    {
        ServicehenvendelseStatus.Ny => "status-ny",
        ServicehenvendelseStatus.UnderVurdering => "status-vurdering",
        ServicehenvendelseStatus.PrisGitt => "status-pris",
        ServicehenvendelseStatus.VarerBestilt => "status-pris",
        ServicehenvendelseStatus.Fullfort => "status-fullfort",
        ServicehenvendelseStatus.Avslatt => "status-avslatt",
        _ => ""
    };

    private static string PersonFarge(string navn) => PersonPaletten[Math.Abs(navn.GetHashCode()) % PersonPaletten.Length];

    private static string PersonInitialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length > 1
            ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
            : navn.Length >= 2 ? navn[..2].ToUpperInvariant() : navn.ToUpperInvariant();
    }

    private async Task LagreStatus(Servicehenvendelse h)
    {
        await Db.SaveChangesAsync();
    }

    private async Task LagreSvar(Servicehenvendelse h)
    {
        await Db.SaveChangesAsync();
    }

    private async Task LastOppDokBilder(Servicehenvendelse h, InputFileChangeEventArgs e)
    {
        foreach (var fil in e.GetMultipleFiles(10))
        {
            if (fil.Size > 15_000_000)
            {
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = fil.OpenReadStream(maxAllowedSize: 15_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            Db.ServicehenvendelseBilder.Add(new ServicehenvendelseBilde
            {
                ServicehenvendelseId = h.Id,
                Data = buffer.ToArray(),
                ContentType = string.IsNullOrWhiteSpace(fil.ContentType) ? "application/octet-stream" : fil.ContentType,
                Filnavn = fil.Name,
                ErDokumentasjon = true
            });
        }

        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task SendDokumentasjon(Servicehenvendelse h)
    {
        _sendFeil.Remove(h.Id);

        if (h.Kunde?.Epost is null)
        {
            return;
        }

        var dokBilder = await Db.ServicehenvendelseBilder
            .Where(b => b.ServicehenvendelseId == h.Id && b.ErDokumentasjon)
            .ToListAsync();

        var svarHtml = System.Net.WebUtility.HtmlEncode(h.SvarFraItlock ?? "").Replace("\n", "<br>");
        var html = "<p>Hei " + h.Kunde.Navn + ",</p>"
            + "<p>Her er dokumentasjon fra jobben på " + h.Dortype.ToLowerInvariant() + ":</p>"
            + "<p>" + svarHtml + "</p>"
            + "<p>Mvh itlock AS</p>";

        var vedlegg = dokBilder.Select(b => (b.Filnavn, b.Data));
        var ok = await Epost.SendAsync(h.Kunde.Epost, $"Dokumentasjon - {h.Dortype}", html, vedlegg);

        if (!ok)
        {
            _sendFeil[h.Id] = "Kunne ikke sende e-post. Sjekk at Resend er riktig satt opp.";
            return;
        }

        h.EpostSendtDato = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task OpprettTicket(Servicehenvendelse h)
    {
        var ticket = new Ticket
        {
            Tittel = $"{h.Dortype} - {h.Kunde?.Navn}",
            Beskrivelse = h.Beskrivelse,
            KundeId = h.KundeId,
            Lokasjon = h.Adresse,
            ServicehenvendelseId = h.Id
        };
        Db.Tickets.Add(ticket);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/ticket/{ticket.Id}");
    }
}
