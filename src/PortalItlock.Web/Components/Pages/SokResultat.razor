@page "/sok"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Søk</PageTitle>

<h1>Søkeresultater</h1>
<p class="section-hint">Søk: "@Q"</p>

@if (string.IsNullOrWhiteSpace(Q))
{
    <p class="list-empty">Skriv inn et søkeord i feltet øverst til venstre.</p>
}
else if (_kunder.Count == 0 && _prosjekter.Count == 0 && _tickets.Count == 0 && _foresporsler.Count == 0)
{
    <p class="list-empty">Ingen treff.</p>
}
else
{
    @if (_kunder.Count > 0)
    {
        <h2>Kunder (@_kunder.Count)</h2>
        <ul class="sok-liste">
            @foreach (var k in _kunder)
            {
                <li><a href="@($"/kunder/{k.Id}")">@k.Navn</a> <span class="sok-detalj">@k.Epost @k.Sted</span></li>
            }
        </ul>
    }

    @if (_prosjekter.Count > 0)
    {
        <h2>Prosjekter (@_prosjekter.Count)</h2>
        <ul class="sok-liste">
            @foreach (var p in _prosjekter)
            {
                <li><a href="@($"/prosjekter/{p.Id}")">@p.Navn</a> <span class="sok-detalj">@(p.Kunde?.Navn)</span></li>
            }
        </ul>
    }

    @if (_tickets.Count > 0)
    {
        <h2>Tickets (@_tickets.Count)</h2>
        <ul class="sok-liste">
            @foreach (var t in _tickets)
            {
                <li><a href="@($"/ticket/{t.Id}")">#@t.Id @t.Tittel</a> <span class="sok-detalj">@(t.Kunde?.Navn) - @t.Status.Visningsnavn()</span></li>
            }
        </ul>
    }

    @if (_foresporsler.Count > 0)
    {
        <h2>Forespørsler (@_foresporsler.Count)</h2>
        <ul class="sok-liste">
            @foreach (var f in _foresporsler)
            {
                <li><a href="/foresporsler">@f.Emne</a> <span class="sok-detalj">@(f.FraNavn ?? f.FraEpost)</span></li>
            }
        </ul>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    private List<Kunde> _kunder = [];
    private List<Prosjekt> _prosjekter = [];
    private List<Ticket> _tickets = [];
    private List<Foresporsel> _foresporsler = [];

    protected override async Task OnParametersSetAsync()
    {
        var q = Q?.Trim() ?? "";
        if (q.Length == 0)
        {
            _kunder = [];
            _prosjekter = [];
            _tickets = [];
            _foresporsler = [];
            return;
        }

        _kunder = await Db.Kunder
            .Where(k => k.Navn.Contains(q) || (k.Epost != null && k.Epost.Contains(q)) || (k.Telefon != null && k.Telefon.Contains(q)))
            .OrderBy(k => k.Navn)
            .Take(30)
            .ToListAsync();

        _prosjekter = await Db.Prosjekter
            .Include(p => p.Kunde)
            .Where(p => p.Navn.Contains(q) || (p.Adresse != null && p.Adresse.Contains(q)))
            .OrderBy(p => p.Navn)
            .Take(30)
            .ToListAsync();

        _tickets = await Db.Tickets
            .Include(t => t.Kunde)
            .Where(t => t.Tittel.Contains(q) || (t.Beskrivelse != null && t.Beskrivelse.Contains(q)))
            .OrderByDescending(t => t.OpprettetDato)
            .Take(30)
            .ToListAsync();

        _foresporsler = await Db.Foresporsler
            .Where(f => f.Emne.Contains(q) || (f.Innhold != null && f.Innhold.Contains(q)) || f.FraEpost.Contains(q))
            .OrderByDescending(f => f.MottattDato)
            .Take(30)
            .ToListAsync();
    }
}
