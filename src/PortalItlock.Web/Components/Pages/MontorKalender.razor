@page "/app/kalender"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Kalender</PageTitle>

@* Kalenderen i montørappen.
   «Meg»: dagen som tidslinje (jobber, planer, ledige hull og nå-strek), eller uka som agenda.
   «Teamet»: hvor er alle i dag, eller en ukeoversikt per person; trykk på en person for dagen deres.
   Fravær vises bare som «Fravær» for andre enn deg, så typen (for eksempel sykdom) ikke deles. *@
<div class="mk">
    <header class="mk-topp">
        <div class="mk-rad">
            <a class="mk-tilbake" href="/app" aria-label="Til forsiden"><Icon Name="chevron-left" /></a>
            <div class="mk-tittel">
                <b>@(_person is { } vp && vp != _brukerId ? Navn(vp) : "Kalender")</b>
                <small>Uke @ISOWeek.GetWeekOfYear(_mandag) · @Periode()</small>
            </div>
            @if (_mandag != MontorApp.Mandag(NorskTid.Idag))
            {
                <button type="button" class="mk-idag" @onclick="TilIdag">I dag</button>
            }
            <button type="button" class="mk-pil" @onclick="@(() => FlyttUke(-1))" aria-label="Forrige uke"><Icon Name="chevron-left" /></button>
            <button type="button" class="mk-pil" @onclick="@(() => FlyttUke(1))" aria-label="Neste uke"><Icon Name="chevron-right" /></button>
        </div>

        <div class="mk-velger" role="tablist">
            <button type="button" role="tab" aria-selected="@(!_team)" class="@(!_team ? "aktiv" : "")" @onclick="@(() => { _team = false; _person = null; })">Meg</button>
            <button type="button" role="tab" aria-selected="@_team" class="@(_team ? "aktiv" : "")" @onclick="@(() => { _team = true; _person = null; })"><Icon Name="users" />Teamet</button>
        </div>

        <div class="mk-uke">
            @for (var i = 0; i < 7; i++)
            {
                var dag = _mandag.AddDays(i);
                var typer = Poster(dag, _team && _person is null ? null : AktivPerson).Select(p => p.Type).Distinct().Take(3).ToList();
                <button type="button" class="mk-dag @(dag == _valgt ? "valgt" : "") @(dag == NorskTid.Idag ? "idag" : "") @(i > 4 ? "helg" : "")" @onclick="@(() => _valgt = dag)" aria-label="@DagTekst(dag)">
                    <small>@dag.ToString("ddd", Kultur).TrimEnd('.')</small><b>@dag.Day</b>
                    <span class="mk-prikker">@foreach (var t in typer) {<i class="mk-f-@t"></i>}</span>
                </button>
            }
        </div>
    </header>

    @if (!_lastet)
    {
        <p class="mk-tom">Laster …</p>
    }
    else if (_team && _person is null)
    {
        <div class="mk-sum">
            <h2>@(_teamUke ? "Uka for teamet" : "Hvor er alle?")<small>@(_teamUke ? $"Uke {ISOWeek.GetWeekOfYear(_mandag)}" : DagTekst(_valgt))</small></h2>
            <div class="mk-vis">
                <button type="button" class="@(!_teamUke ? "paa" : "")" @onclick="@(() => _teamUke = false)">Nå</button>
                <button type="button" class="@(_teamUke ? "paa" : "")" @onclick="@(() => _teamUke = true)">Uke</button>
            </div>
        </div>

        @if (_teamUke)
        {
            @* Personer nedover, dager bortover. Ruta viser jobben og timene; ledige dager er grønne og stiplede. *@
            var ledigTimer = _personer.Sum(b => Enumerable.Range(0, 5).Sum(i => Borte(b.Id, _mandag.AddDays(i)) ? 0 : Math.Max(0, Arbeidsdag - Timer(b.Id, _mandag.AddDays(i)))));
            <div class="mk-ku-sum">
                <span class="mk-ku-ik"><Icon Name="clock" /></span>
                <span><b>@TimerT(ledigTimer) ledig denne uka</b><small>Grønne ruter er dager uten jobb. Trykk for å se dagen.</small></span>
            </div>
            <div class="mk-ku">
                <span></span>
                @for (var i = 0; i < 5; i++)
                {
                    var dag = _mandag.AddDays(i);
                    var ledige = _personer.Count(b => Poster(dag, b.Id).Count == 0);
                    <button type="button" class="mk-ku-h @(dag == NorskTid.Idag ? "idag" : "") @(dag == _valgt ? "mk-ku-kol" : "")" @onclick="@(() => _valgt = dag)">
                        <b>@dag.ToString("ddd", Kultur).TrimEnd('.') @dag.Day</b><small class="@(ledige == 0 ? "full" : "")">@(ledige == 0 ? "Fullt" : $"{ledige} ledig")</small>
                    </button>
                }
                @foreach (var b in _personer)
                {
                    var bid = b.Id;
                    var sum = Enumerable.Range(0, 5).Sum(i => Timer(b.Id, _mandag.AddDays(i)));
                    <span class="mk-ku-n">
                        <span class="mk-ku-r"><span class="mk-av mk-av-liten" style="background:@Farge(b.Id)">@Initialer(b.Navn)</span><b>@(b.Id == _brukerId ? "Deg" : Fornavn(b.Navn))</b></span>
                        <small class="@(sum > 5 * Arbeidsdag ? "over" : "")">@TimerT(sum)</small>
                    </span>
                    @for (var i = 0; i < 5; i++)
                    {
                        var dag = _mandag.AddDays(i);
                        var liste = Poster(dag, b.Id);
                        var fravar = liste.FirstOrDefault(p => p.Type == "fravar");
                        var forste = liste.FirstOrDefault(p => p.Type != "fravar");
                        var t = Timer(b.Id, dag);
                        <span class="mk-ku-c @(dag == _valgt ? "mk-ku-kol" : "")">
                            @if (fravar is not null)
                            {
                                <button type="button" class="mk-ku-b mk-ku-borte" title="@fravar.Tittel" @onclick="@(() => VisPerson(bid, dag))"><span>@(fravar.Tittel == "Ferie" ? "Ferie" : "Borte")</span></button>
                            }
                            else if (forste is null)
                            {
                                <button type="button" class="mk-ku-b mk-ku-ledig" @onclick="@(() => VisPerson(bid, dag))"><span>Ledig</span></button>
                            }
                            else
                            {
                                <button type="button" class="mk-ku-b mk-b-@forste.Type" title="@forste.Tittel" @onclick="@(() => VisPerson(bid, dag))">
                                    <span>@KortNavn(forste.Tittel)@(liste.Count > 1 ? $" +{liste.Count - 1}" : "")</span>
                                    <small>@(t > 0 ? TimerT(t) : "")</small>
                                    <i class="mk-f-@forste.Type" style="width:@(Math.Min(100, t * 100 / Arbeidsdag).ToString("0", CultureInfo.InvariantCulture))%"></i>
                                </button>
                            }
                        </span>
                    }
                }
            </div>
            <div class="mk-tegn"><span><i class="mk-f-jobb"></i>Jobb</span><span><i class="mk-f-plan"></i>Plan</span><span><i class="mk-f-fravar"></i>Ferie/borte</span><span><i class="mk-tegn-ledig"></i>Ledig</span></div>
        }
        else
        {
            @* Én rad per person: hva de gjør nå og hva som kommer etterpå. *@
            <div class="mk-team">
                @foreach (var (b, s) in _personer.Select(b => (b, Status(b.Id))).OrderBy(x => x.Item2.Rekke).ThenByDescending(x => x.b.Id == _brukerId))
                {
                    var bid = b.Id;
                    <button type="button" class="mk-person" @onclick="@(() => VisPerson(bid, _valgt))">
                        <span class="mk-av mk-av-ring" style="background:@Farge(b.Id);--ring:@s.Farge">@Initialer(b.Navn)</span>
                        <span class="mk-person-tekst">
                            <span class="mk-person-navn"><b>@(b.Id == _brukerId ? "Deg" : b.Navn)</b><span class="mk-st" style="color:@s.Farge;background:color-mix(in srgb, @s.Farge 13%, transparent)">@s.Navn</span></span>
                            <span class="mk-hva">@if (s.Post is { } a && s.Navn != "Fravær") {<text>@(s.Navn == "På jobb" ? "Nå" : a.Fra is { } f ? f.ToString(@"hh\:mm") : "I dag"): <b>@a.Tittel</b>@if (Sted(a) is { } st) {<small> · @st</small>}</text>} else {@s.Tekst}</span>
                            @if (s.Etterpa is { Length: > 0 } e)
                            {
                                <small>@e</small>
                            }
                        </span>
                        <span class="mk-pilk"><Icon Name="chevron-right" /></span>
                    </button>
                }
            </div>
        }
    }
    else
    {
        var person = AktivPerson;
        var dagens = Poster(_valgt, person);
        @if (_person is not null && _person != _brukerId)
        {
            <div class="mk-tilbake-team"><button type="button" class="mk-chip-knapp" @onclick="@(() => _person = null)"><Icon Name="chevron-left" />Hele teamet</button></div>
        }
        <div class="mk-sum">
            @if (_uke)
            {
                <h2>Uke @ISOWeek.GetWeekOfYear(_mandag)<small>Alle jobber denne uka</small></h2>
            }
            else
            {
                var jobber = dagens.Where(p => p.Type != "fravar").ToList();
                var min = jobber.Where(p => p.Fra is not null).Sum(Varighet);
                <h2>@DagTekst(_valgt)<small>@(jobber.Count == 0 ? "Ingen jobber" : $"{jobber.Count} {(jobber.Count == 1 ? "jobb" : "jobber")}{(min > 0 ? " · " + TimerTekst(min) + " planlagt" : "")}")</small></h2>
            }
            <div class="mk-vis">
                <button type="button" class="@(!_uke ? "paa" : "")" @onclick="@(() => _uke = false)">Dag</button>
                <button type="button" class="@(_uke ? "paa" : "")" @onclick="@(() => _uke = true)">Uke</button>
            </div>
        </div>

        @if (_uke)
        {
            @for (var i = 0; i < 7; i++)
            {
                var dag = _mandag.AddDays(i);
                var liste = Poster(dag, person);
                if (i > 4 && liste.Count == 0) continue;
                var sum = liste.Where(p => p.Type != "fravar" && p.Fra is not null).Sum(Varighet);
                <div class="mk-agenda-dag @(dag == NorskTid.Idag ? "idag" : "")"><span>@DagTekst(dag)@(dag == NorskTid.Idag ? " · i dag" : "")</span><span>@(sum > 0 ? TimerTekst(sum) : "")</span></div>
                @if (liste.Count == 0)
                {
                    <p class="mk-tom mk-tom-liten">Ingen jobber</p>
                }
                @foreach (var p in liste)
                {
                    @Rad(p)
                }
            }
        }
        else if (dagens.FirstOrDefault(p => p.Type == "fravar" && p.Fra is null) is { } fravar)
        {
            <div class="mk-fravar"><Icon Name="sun" /><span>@fravar.Tittel<small>Hele dagen</small></span></div>
        }
        else if (dagens.Count == 0)
        {
            <p class="mk-tom">@(_valgt.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "Helg – ingen planlagte jobber." : "Ingen jobber eller planer denne dagen.")</p>
        }
        else
        {
            var utenTid = dagens.Where(p => p.Fra is null).ToList();
            var medTid = dagens.Where(p => p.Fra is not null).ToList();
            @foreach (var p in utenTid)
            {
                @Rad(p)
            }
            @if (medTid.Count > 0)
            {
                var start = Math.Min(DagStart, (int)medTid.Min(p => p.Fra!.Value.TotalMinutes) / 60 * 60);
                var slutt = Math.Max(DagSlutt, (int)Math.Ceiling(medTid.Max(p => p.Fra!.Value.TotalMinutes + Varighet(p)) / 60.0) * 60);
                <div class="mk-tl" style="height:@Px(slutt - start + 10)">
                    @for (var t = start; t <= slutt; t += 60)
                    {
                        <div class="mk-time" style="top:@Px(t - start)"><span>@($"{t / 60:00}:00")</span></div>
                    }
                    @foreach (var (fra, til) in Hull(medTid, start + 30, slutt - 30))
                    {
                        <div class="mk-ledig" style="top:@Px(fra - start + 3);height:@Px(til - fra - 6)">Ledig @Kl(fra)–@Kl(til)</div>
                    }
                    @foreach (var p in medTid)
                    {
                        var topp = p.Fra!.Value.TotalMinutes - start;
                        var hoyde = Varighet(p) * PxMin - 4;
                        var stil = $"top:{Px(topp + 2)};height:{hoyde.ToString("0", CultureInfo.InvariantCulture)}px";
                        var innhold = Blokk(p, hoyde);
                        @if (p.Href is not null)
                        {
                            <a class="mk-blokk mk-b-@p.Type" href="@p.Href" style="@stil">@innhold</a>
                        }
                        else
                        {
                            <div class="mk-blokk mk-b-@p.Type" style="@stil">@innhold</div>
                        }
                    }
                    @if (_valgt == NorskTid.Idag && NorskTid.Na.TimeOfDay.TotalMinutes is var na && na >= start && na <= slutt)
                    {
                        <div class="mk-na" style="top:@Px(na - start)"></div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Farger = ["#7b4a26", "#2f5f8a", "#2f7a3a", "#6a4c9c", "#a3620c", "#b4372b", "#1f7a7a", "#8a3f6f"];

    // Tidslinja går fra 07 til 16, men utvides hvis noe ligger utenfor.
    private const int DagStart = 7 * 60;
    private const int DagSlutt = 16 * 60;
    private const double PxMin = 0.95;

    // Én ting i kalenderen: en jobb (arbeidsordre), en plan fra ressurskalenderen eller fravær.
    // Fra er null når det ikke er satt klokkeslett (eller fravær hele dagen).
    private sealed record Post(int BrukerId, DateTime Dato, TimeSpan? Fra, double Minutter, string Tittel, string? Adresse,
        string Type, string? Href, ArbeidsordreStatus? Status, string? Kontakt);

    private sealed record PersonStatus(string Navn, string Farge, string Tekst, int Rekke, Post? Post, string? Etterpa);

    private bool _lastet;
    private bool _team;
    private bool _uke;
    private bool _teamUke;
    private int _brukerId;
    private int? _person;
    private DateTime _mandag = MontorApp.Mandag(NorskTid.Idag);
    private DateTime _valgt = NorskTid.Idag;
    private List<Post> _poster = [];
    private List<Bruker> _personer = [];

    private int AktivPerson => _person ?? _brukerId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            _brukerId = id;
        }

        await LastAsync();
    }

    private async Task FlyttUke(int uker)
    {
        _mandag = _mandag.AddDays(7 * uker);
        _valgt = _mandag.AddDays(Math.Min(4, ((int)_valgt.DayOfWeek + 6) % 7));
        await LastAsync();
    }

    private async Task TilIdag()
    {
        _mandag = MontorApp.Mandag(NorskTid.Idag);
        _valgt = NorskTid.Idag;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        var fra = _mandag;
        var til = _mandag.AddDays(7);

        var ordre = await Db.Arbeidsordre.AsNoTracking().Include(a => a.Kunde).Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Where(a => a.AnsvarligMontorId != null && a.PlanlagtDato != null && a.PlanlagtDato >= fra && a.PlanlagtDato < til && a.Status != ArbeidsordreStatus.Fakturert)
            .ToListAsync();
        var planer = await Db.Ressursplaner.AsNoTracking().Where(r => r.Dato >= fra && r.Dato < til).ToListAsync();
        var fravar = await Db.FravarSoknader.AsNoTracking()
            .Where(f => f.Status == FravarStatus.Godkjent && f.FraDato < til && f.TilDato >= fra)
            .ToListAsync();

        var poster = new List<Post>();
        foreach (var a in ordre)
        {
            var d = a.PlanlagtDato!.Value;
            TimeSpan? kl = d.TimeOfDay > TimeSpan.Zero ? d.TimeOfDay : null;
            // Varighet: til planlagt slutt samme dag, ellers estimerte timer, ellers én time.
            var minutter = a.PlanlagtSlutt is { } s && s > d && s.Date == d.Date ? (s - d).TotalMinutes
                : a.EstimerteTimer is { } e && e > 0 ? (double)Math.Min(e, 10m) * 60 : 60;
            var kunde = a.Kunde ?? a.Prosjekt?.Kunde;
            var navn = !string.IsNullOrWhiteSpace(a.Prosjekt?.Kontaktperson) ? a.Prosjekt.Kontaktperson : kunde?.Kontaktperson;
            var tlf = !string.IsNullOrWhiteSpace(a.Prosjekt?.Telefon) ? a.Prosjekt.Telefon : kunde?.Telefon;
            var kontakt = string.Join(" · ", new[] { navn, tlf }.Where(x => !string.IsNullOrWhiteSpace(x)));
            poster.Add(new(a.AnsvarligMontorId!.Value, d.Date, kl, minutter, $"{a.Id} {a.Tittel}", MontorApp.Adresse(a), "jobb",
                $"/app/ordre/{a.Id}", a.Status, kontakt.Length > 0 ? kontakt : null));
        }

        foreach (var r in planer)
        {
            poster.Add(new(r.MontorId, r.Dato.Date, r.Fra > TimeSpan.Zero ? r.Fra : null, Math.Max(30, (r.Til - r.Fra).TotalMinutes), r.Tittel, null, "plan", null, null, null));
        }

        foreach (var f in fravar)
        {
            for (var d = f.FraDato.Date < fra ? fra : f.FraDato.Date; d <= f.TilDato.Date && d < til; d = d.AddDays(1))
            {
                // Typen fravær vises bare for deg selv.
                poster.Add(new(f.BrukerId, d, null, 0, f.BrukerId == _brukerId ? f.Type.Visningsnavn() : "Fravær", null, "fravar", null, null, null));
            }
        }

        _poster = poster;

        var ider = poster.Select(p => p.BrukerId).Append(_brukerId).ToHashSet();
        _personer = (await Db.Brukere.AsNoTracking()
                .Where(b => b.Aktiv && b.SlettetDato == null && (b.Rolle == BrukerRolle.Montor || ider.Contains(b.Id)))
                .Where(b => b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
                .ToListAsync())
            .OrderByDescending(b => b.Id == _brukerId).ThenBy(b => b.Navn).ToList();
        _lastet = true;
    }

    // Postene for en dag, for én person (eller alle når person er null). Fravær først, så etter klokkeslett.
    private List<Post> Poster(DateTime dag, int? person) => _poster
        .Where(p => p.Dato == dag && (person is null || p.BrukerId == person))
        .OrderBy(p => p.Type == "fravar" ? 0 : 1).ThenBy(p => p.Fra ?? TimeSpan.Zero).ToList();

    private static double Varighet(Post p) => p.Fra is { } f ? Math.Min(p.Minutter, 24 * 60 - f.TotalMinutes) : 0;

    // Ledige hull på minst en time mellom jobbene (innenfor arbeidsdagen).
    private static IEnumerable<(double Fra, double Til)> Hull(List<Post> poster, double start, double slutt)
    {
        var forrige = start;
        foreach (var p in poster.OrderBy(p => p.Fra))
        {
            var f = p.Fra!.Value.TotalMinutes;
            if (f - forrige >= 60) yield return (forrige, f);
            forrige = Math.Max(forrige, f + Varighet(p));
        }

        if (slutt - forrige >= 60) yield return (forrige, slutt);
    }

    private PersonStatus Status(int brukerId)
    {
        var l = Poster(_valgt, brukerId);
        if (l.FirstOrDefault(p => p.Type == "fravar") is { } f) return new("Fravær", "#b7791f", f.BrukerId == _brukerId ? $"{f.Tittel} hele dagen" : "Borte hele dagen", 3, f, null);
        if (l.Count == 0) return new("Ledig", "#4f9a5a", "Ingen jobber – kan ta oppdrag", 2, null, null);
        var idag = _valgt == NorskTid.Idag;
        var na = NorskTid.Na.TimeOfDay.TotalMinutes;
        var slutt = (Post p) => p.Fra is { } fr ? fr.TotalMinutes + Varighet(p) : 24 * 60;
        if (!idag)
        {
            return new("Planlagt", "#3b78b5", "", 1, l[0], l.Count > 1 ? $"Så {Klokke(l[1])}{l[1].Tittel}" : null);
        }

        var naa = l.FirstOrDefault(p => p.Fra is { } fr && fr.TotalMinutes <= na && slutt(p) > na);
        if (naa is not null)
        {
            var neste = l.FirstOrDefault(p => p != naa && p.Fra is { } fr && fr.TotalMinutes >= slutt(naa));
            return new("På jobb", "#2f8a45", "", 0, naa, $"Til {Kl(slutt(naa))}{(neste is null ? "" : $" · så {Klokke(neste)}{neste.Tittel}")}");
        }

        var senere = l.FirstOrDefault(p => p.Fra is null || p.Fra.Value.TotalMinutes > na);
        if (senere is not null)
        {
            var neste = l.SkipWhile(p => p != senere).Skip(1).FirstOrDefault();
            return new("Senere i dag", "#3b78b5", "", 1, senere, neste is null ? null : $"Så {Klokke(neste)}{neste.Tittel}");
        }

        return new("Ledig", "#4f9a5a", "Ferdig med dagens jobber", 2, null, null);
    }

    private static string Klokke(Post p) => p.Fra is { } f ? f.ToString(@"hh\:mm") + " " : "";

    private static string? Sted(Post p) => p.Adresse?.Split(',').Last().Trim() is { Length: > 0 } s ? s : null;

    private void VisPerson(int brukerId, DateTime dag)
    {
        _person = brukerId;
        _valgt = dag;
        _uke = false;
    }

    // Timer planlagt på en dag (jobber og planer), og om personen er borte.
    private double Timer(int brukerId, DateTime dag) => Poster(dag, brukerId).Where(p => p.Type != "fravar" && p.Fra is not null).Sum(Varighet) / 60.0;

    private bool Borte(int brukerId, DateTime dag) => Poster(dag, brukerId).Any(p => p.Type == "fravar");

    private const double Arbeidsdag = 7.5;

    // Korte navn i ukeruta: «Kontorhotellet – ARX» blir «Kontorh…», «Kvartal 11» får stå.
    private static string KortNavn(string tittel)
    {
        var n = UtenNummer(tittel).Split(" – ")[0];
        if (n.Length <= 9) return n;
        var f = n.Split(' ')[0];
        return f.Length <= 8 ? f : f[..7] + "…";
    }

    private string Navn(int id) => _personer.FirstOrDefault(b => b.Id == id)?.Navn ?? "Kalender";

    private string Periode()
    {
        var son = _mandag.AddDays(6);
        return _mandag.Month == son.Month
            ? $"{_mandag.Day}.–{son.Day}. {son.ToString("MMM", Kultur).TrimEnd('.')}"
            : $"{_mandag.Day}. {_mandag.ToString("MMM", Kultur).TrimEnd('.')} – {son.Day}. {son.ToString("MMM", Kultur).TrimEnd('.')}";
    }

    private static string Px(double minutter) => (minutter * PxMin).ToString("0", CultureInfo.InvariantCulture) + "px";

    private static string Pst(double minutter) => Math.Clamp(minutter * 100.0 / (DagSlutt - DagStart), 0, 100).ToString("0.#", CultureInfo.InvariantCulture);

    private static string Kl(double minutter) => TimeSpan.FromMinutes(minutter).ToString(@"hh\:mm");

    private static string TimerTekst(double minutter) => (Math.Round(minutter / 30) / 2).ToString("0.#", Kultur) + " t";

    private static string TimerT(double timer) => (Math.Round(timer * 2) / 2).ToString("0.#", Kultur) + " t";

    private static string Initialer(string navn) =>
        string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));

    private static string Fornavn(string navn) => navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? navn;

    private static string Farge(int id) => Farger[Math.Abs(id) % Farger.Length];

    private static string DagTekst(DateTime d)
    {
        var t = d.ToString("dddd d. MMMM", Kultur);
        return char.ToUpper(t[0]) + t[1..];
    }

    // Ukeoversikten er trang: ordrenummeret foran tittelen tas bort.
    private static string UtenNummer(string tittel) => System.Text.RegularExpressions.Regex.Replace(tittel, @"^\d+\s+", "");

    private static string TypeNavn(Post p) => p.Type switch { "jobb" => "Jobb", "plan" => "Plan", _ => "Fravær" };

    private static RenderFragment Blokk(Post p, double hoyde) => @<text>
        @if (p.Status is { } st)
        {
            <span class="mk-merke mk-s-@MontorApp.StatusKlasse(st)">@st.Visningsnavn()</span>
        }
        <small class="mk-blokk-tid">@p.Fra!.Value.ToString(@"hh\:mm")–@p.Fra.Value.Add(TimeSpan.FromMinutes(Varighet(p))).ToString(@"hh\:mm") · @TypeNavn(p)</small>
        <b>@p.Tittel</b>
        @if (hoyde > 66 && p.Adresse is not null)
        {
            <small><Icon Name="map-pin" />@p.Adresse</small>
        }
        @if (hoyde > 90 && p.Kontakt is not null)
        {
            <small><Icon Name="phone" />@p.Kontakt</small>
        }
    </text>;

    private static RenderFragment Rad(Post p) => p.Href is not null
        ? @<a class="mk-arad" href="@p.Href">@RadInnhold(p)</a>
        : @<div class="mk-arad">@RadInnhold(p)</div>;

    private static RenderFragment RadInnhold(Post p) => @<text>
        <span class="mk-kl">@(p.Fra is { } f ? f.ToString(@"hh\:mm") : p.Type == "fravar" ? "Hele" : "–")<small>@(p.Fra is not null ? TimerTekst(Varighet(p)) : p.Type == "fravar" ? "dagen" : "")</small></span>
        <span class="mk-strek mk-f-@p.Type"></span>
        <span class="mk-arad-tekst">
            <b>@p.Tittel</b>
            <small>@TypeNavn(p)@(p.Adresse is null ? "" : " · " + p.Adresse)</small>
        </span>
        @if (p.Status is { } st)
        {
            <span class="mk-merke mk-s-@MontorApp.StatusKlasse(st)" style="position:static;align-self:center">@st.Visningsnavn()</span>
        }
    </text>;
}
