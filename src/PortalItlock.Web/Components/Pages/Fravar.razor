@page "/fravar"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.VisningPreferanseService VisningPref

<PageTitle>Fravær</PageTitle>

<div class="mobil-soknader-wrap">
    <div class="mobil-underfaner">
        <button type="button" class="mobil-underfane @(_mobilFane == "dashboard" ? "aktiv" : "")" @onclick='@(() => _mobilFane = "dashboard")'>Dashboard</button>
        <button type="button" class="mobil-underfane @(_mobilFane == "soknader" ? "aktiv" : "")" @onclick='@(() => _mobilFane = "soknader")'>Søknader</button>
    </div>

    @if (_mobilFane == "dashboard")
    {
        @if (_mineStats is not null)
        {
            <div class="ferie-kort">
                <div class="ferie-kort-header">
                    <Icon Name="sun" />
                    <span>Ferie</span>
                </div>
                <div class="ferie-kort-body">
                    <ul class="ferie-legende">
                        <li>
                            <span class="ferie-dot ferie-dot-gronn"></span>
                            <span class="ferie-legende-navn">Tilgjengelige dager</span>
                            <span class="ferie-legende-tall">@FerieTilgjengelig(_mineStats)</span>
                        </li>
                        <li>
                            <span class="ferie-dot ferie-dot-oransje"></span>
                            <span class="ferie-legende-navn">Planlagte dager</span>
                            <span class="ferie-legende-tall">@_mineStats.FerieKommende</span>
                        </li>
                        <li>
                            <span class="ferie-dot ferie-dot-gra"></span>
                            <span class="ferie-legende-navn">Dager tatt ut</span>
                            <span class="ferie-legende-tall">@_mineStats.FerieBrukt</span>
                        </li>
                    </ul>
                    <div class="ferie-ring" style="background: @FerieRingGradient(_mineStats)"></div>
                </div>
            </div>

            <p class="annen-statistikk-label">Annen statistikk:</p>
            <div class="annen-statistikk-kort">
                <div class="annen-statistikk-rad">
                    <Icon Name="clock" />
                    <div class="annen-statistikk-tekst">
                        <div class="annen-statistikk-topp">
                            <strong>Timebank</strong>
                            <span>0 t</span>
                        </div>
                        <span class="annen-statistikk-sub">Din timebank saldo for perioden</span>
                    </div>
                </div>
                <div class="annen-statistikk-rad">
                    <Icon Name="cross-medical" />
                    <div class="annen-statistikk-tekst">
                        <div class="annen-statistikk-topp">
                            <strong>Egenmelding</strong>
                            <span>@_mineStats.EgenmeldingBrukt @Dagtekst(_mineStats.EgenmeldingBrukt)</span>
                        </div>
                        <span class="annen-statistikk-sub">Eget fravær eller sykdom</span>
                    </div>
                </div>
                <div class="annen-statistikk-rad">
                    <Icon Name="users" />
                    <div class="annen-statistikk-tekst">
                        <div class="annen-statistikk-topp">
                            <strong>Egenmelding - sykt barn</strong>
                            <span>@_mineStats.SyktBarnBrukt @Dagtekst(_mineStats.SyktBarnBrukt)</span>
                        </div>
                        <span class="annen-statistikk-sub">Fravær pga sykdom hos barn eller barnepasser</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        @if (_mineSoknader.Count == 0)
        {
            <div class="mobil-soknad-tom">
                <svg class="mobil-tom-figur" viewBox="0 0 120 100" width="120" height="100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 60 L30 60 L40 74 L80 74 L90 60 L110 60 L110 86 Q110 92 104 92 L16 92 Q10 92 10 86 Z" fill="#f4f0e9" stroke="#ddd6cb" stroke-width="3" />
                    <rect x="42" y="18" width="36" height="48" rx="4" fill="#ffffff" stroke="#835e41" stroke-width="3" />
                    <line x1="50" y1="30" x2="70" y2="30" stroke="#e4e0d5" stroke-width="3" stroke-linecap="round" />
                    <line x1="50" y1="41" x2="70" y2="41" stroke="#e4e0d5" stroke-width="3" stroke-linecap="round" />
                    <line x1="50" y1="52" x2="62" y2="52" stroke="#e4e0d5" stroke-width="3" stroke-linecap="round" />
                    <circle cx="88" cy="24" r="13" fill="#2b7a4b" />
                    <line x1="88" y1="18" x2="88" y2="30" stroke="#fff" stroke-width="3" stroke-linecap="round" />
                    <line x1="82" y1="24" x2="94" y2="24" stroke="#fff" stroke-width="3" stroke-linecap="round" />
                </svg>
                <p><strong>Ingen søknader</strong></p>
                <span>Bruk plussknappen for å opprette en ny søknad</span>
            </div>
        }
        else
        {
            <div class="soknad-liste">
                @foreach (var s in _mineSoknader)
                {
                    <div @key="@($"mobil-{s.Id}")" class="soknad-kort">
                        <div class="soknad-header">
                            <strong>@s.Type.Visningsnavn()</strong>
                            <span class="soknad-status soknad-status-@s.Status">@s.Status.Visningsnavn()</span>
                        </div>
                        <p class="soknad-periode">@s.FraDato.ToString("dd.MM.yyyy") &ndash; @s.TilDato.ToString("dd.MM.yyyy")</p>
                    </div>
                }
            </div>
        }

        <button type="button" class="mobil-soknad-fab" title="Ny søknad" @onclick="@(() => _visMobilSoknadForm = !_visMobilSoknadForm)">+</button>

        @if (_visMobilSoknadForm)
        {
            <div class="mobil-soknad-modal">
                <div class="mobil-soknad-modal-innhold">
                    <div class="mobil-soknad-modal-header">
                        <strong>Ny søknad</strong>
                        <button type="button" class="cancel-button" @onclick="@(() => _visMobilSoknadForm = false)">Lukk</button>
                    </div>
                    <div class="soknad-form">
                        <label class="span-full">
                            Beskrivelse
                            <textarea rows="2" @bind="_nyKommentar" placeholder="Beskriv årsak eller annen info"></textarea>
                        </label>
                        <label class="span-full">
                            Type
                            <select @bind="_nyType">
                                @foreach (var t in Enum.GetValues<FravarType>())
                                {
                                    <option value="@t">@t.Visningsnavn()</option>
                                }
                            </select>
                        </label>
                        <label class="span-full">
                            Til oppfølging hos
                            <select @bind="_nyTilOppfolgingHosId">
                                <option value="">Ingen valgt</option>
                                @foreach (var a in _personer.Where(p => p.Rolle == BrukerRolle.Admin))
                                {
                                    <option value="@a.Id">@a.Navn</option>
                                }
                            </select>
                        </label>

                        <label class="span-full">
                            Varighet
                            <select value="@(_nyHeleDagen ? "hel" : "egen")" @onchange="@(e => VelgVarighet((string)e.Value!))">
                                <option value="hel">Hele dagen</option>
                                <option value="egen">Egendefinert</option>
                            </select>
                        </label>

                        <label>
                            Start
                            <input type="time" @bind="_nyStartTid" disabled="@_nyHeleDagen" />
                        </label>
                        <label>
                            Slutt
                            <input type="time" @bind="_nySluttTid" disabled="@_nyHeleDagen" />
                        </label>

                        <label class="span-full">
                            Dager
                            <input type="text" readonly value="@DagerTekst()" placeholder="Velg datoer i kalenderen under" />
                        </label>

                        <div class="span-full ny-soknad-kalender">
                            <div class="ny-soknad-kalender-header">
                                <span class="ny-soknad-kalender-manednavn">
                                    @Kultur.TextInfo.ToTitleCase(_nySoknadKalenderManed.ToString("MMM yyyy", Kultur))
                                    <span class="ny-soknad-kalender-caret">&#9662;</span>
                                </span>
                                <div class="ny-soknad-kalender-nav">
                                    <button type="button" title="Forrige måned" @onclick="@(() => _nySoknadKalenderManed = _nySoknadKalenderManed.AddMonths(-1))">&lsaquo;</button>
                                    <button type="button" title="Neste måned" @onclick="@(() => _nySoknadKalenderManed = _nySoknadKalenderManed.AddMonths(1))">&rsaquo;</button>
                                </div>
                            </div>
                            <div class="ny-soknad-kalender-ukedager">
                                @foreach (var d in Ukedagnavn)
                                {
                                    <span>@d[0]</span>
                                }
                            </div>
                            <div class="ny-soknad-kalender-grid">
                                @foreach (var dag in KalenderCeller(_nySoknadKalenderManed))
                                {
                                    var iRange = _nyFraDato.HasValue && _nyTilDato.HasValue && dag >= _nyFraDato.Value && dag <= _nyTilDato.Value;
                                    var erValgt = dag == _nyFraDato || dag == _nyTilDato;
                                    var erIDag = dag == DateOnly.FromDateTime(DateTime.Today);
                                    var erHelg = dag.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                    <button type="button" @key="dag"
                                            class="ny-soknad-kalender-dag @(dag.Month != _nySoknadKalenderManed.Month ? "utenfor-maned" : "") @(erHelg ? "helg" : "") @(iRange ? "i-range" : "") @(erIDag ? "i-dag" : "") @(erValgt ? "valgt" : "")"
                                            @onclick="@(() => VelgKalenderDato(dag))">
                                        @dag.Day
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <button type="button" class="save-button" @onclick="SendSoknadMobil">Opprett</button>
                    @if (!string.IsNullOrEmpty(_soknadFeil))
                    {
                        <p class="form-error">@_soknadFeil</p>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="fravar-side">

<div class="side-header">
    <span class="side-header-ikon"><Icon Name="sun" /></span>
    <div class="side-header-tekst">
        <h1>Fravær</h1>
        <p class="section-hint">Send inn søknad om ferie, sykdom eller annet fravær, og følg status på søknadene dine.</p>
    </div>
    <div class="side-header-knapper">
        <a class="knapp" href="#fravar-kalender"><Icon Name="calendar" />Fraværskalender</a>
        <a class="knapp knapp-primaer" href="#fravar-ny-soknad"><Icon Name="plus" />Ny søknad</a>
    </div>
</div>

<div class="layout">
    <div class="venstre">
        <div class="kort form-kort" id="fravar-ny-soknad">
            <h2>Ny søknad</h2>
            <div class="type-pills">
                <button type="button" class="type-pill @(_nyType == FravarType.Ferie ? "aktiv" : "")" @onclick="@(() => _nyType = FravarType.Ferie)">Ferie</button>
                <button type="button" class="type-pill @(_nyType == FravarType.Egenmelding ? "aktiv" : "")" @onclick="@(() => _nyType = FravarType.Egenmelding)">Sykdom</button>
                <button type="button" class="type-pill @(_nyType == FravarType.Annet ? "aktiv" : "")" @onclick="@(() => _nyType = FravarType.Annet)">Annet</button>
            </div>
            <div class="soknad-form">
                <label>
                    Fra dato
                    <input type="date" @bind="_nyFraDato" />
                </label>
                <label>
                    Til dato
                    <input type="date" @bind="_nyTilDato" />
                </label>
                <label class="span-full">
                    Kommentar (valgfritt)
                    <textarea rows="2" @bind="_nyKommentar" placeholder="F.eks. grunn eller annen info"></textarea>
                </label>
            </div>
            <button type="button" class="save-button save-button-full" @onclick="SendSoknad">Send inn søknad</button>
            @if (!string.IsNullOrEmpty(_soknadFeil))
            {
                <p class="form-error">@_soknadFeil</p>
            }
            @if (!string.IsNullOrEmpty(_soknadMelding))
            {
                <p class="save-success">@_soknadMelding</p>
            }
        </div>
    </div>

    <div class="hoyre">
        @if (_mineStats is not null)
        {
            <div class="kort saldo-kort">
                <h2>Min saldo @_mineStats.Ar</h2>
                <div class="saldo-rad">
                    <div class="ferie-donut" style="background: @FerieRingGradient(_mineStats)">
                        <div class="ferie-donut-indre">
                            <span class="ferie-donut-tall">@FerieTilgjengelig(_mineStats)</span>
                            <span class="ferie-donut-av">av @_mineStats.FerieKvote</span>
                        </div>
                    </div>
                    <ul class="ferie-legende">
                        <li>
                            <span class="ferie-dot ferie-dot-gronn"></span>
                            <span class="ferie-legende-navn">Tilgjengelige dager</span>
                            <span class="ferie-legende-tall">@FerieTilgjengelig(_mineStats)</span>
                        </li>
                        <li>
                            <span class="ferie-dot ferie-dot-oransje"></span>
                            <span class="ferie-legende-navn">Planlagte dager</span>
                            <span class="ferie-legende-tall">@_mineStats.FerieKommende</span>
                        </li>
                        <li>
                            <span class="ferie-dot ferie-dot-gra"></span>
                            <span class="ferie-legende-navn">Dager tatt ut</span>
                            <span class="ferie-legende-tall">@_mineStats.FerieBrukt</span>
                        </li>
                    </ul>
                </div>
            </div>
        }

        <div class="kort soknader-kort">
            <div class="soknader-header">
                <h2>Mine søknader</h2>
                @if (_mineSoknader.Count > 5)
                {
                    <button type="button" class="se-alle-knapp" @onclick="@(() => _visAlleSoknader = !_visAlleSoknader)">@(_visAlleSoknader ? "Vis færre" : "Se alle")</button>
                }
            </div>
            @if (_mineSoknader.Count == 0)
            {
                <p class="list-empty">Ingen søknader sendt inn ennå.</p>
            }
            else
            {
                <div class="soknad-tabell-wrap">
                    <table class="soknad-tabell">
                        <thead>
                            <tr><th>Periode</th><th>Type</th><th>Status</th><th>Søkt</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in (_visAlleSoknader ? _mineSoknader : _mineSoknader.Take(5)))
                            {
                                <tr @key="s.Id">
                                    <td class="mono">@s.FraDato.ToString("dd.MM.yyyy") &ndash; @s.TilDato.ToString("dd.MM.yyyy")</td>
                                    <td>@s.Type.Visningsnavn()</td>
                                    <td><span class="soknad-status soknad-status-@s.Status">@s.Status.Visningsnavn()</span></td>
                                    <td class="mono">@s.OpprettetDato.ToString("dd.MM.yyyy")</td>
                                    <td class="soknad-handling">
                                        <button type="button" class="ikon-btn" title="Vis detaljer" @onclick="@(() => ToggleDetaljer(s.Id))"><Icon Name="eye" /></button>
                                        @if (s.Status == FravarStatus.Venter)
                                        {
                                            <button type="button" class="ikon-btn" title="Rediger" @onclick="@(() => StartRediger(s))"><Icon Name="edit" /></button>
                                            <button type="button" class="ikon-btn ikon-btn-fare" title="Slett" @onclick="@(() => _slettSoknadId = s.Id)"><Icon Name="trash" /></button>
                                        }
                                    </td>
                                </tr>
                                @if (_apneDetaljerId == s.Id)
                                {
                                    <tr class="soknad-under-rad">
                                        <td colspan="5">
                                            @if (!string.IsNullOrWhiteSpace(s.Kommentar))
                                            {
                                                <p><strong>Kommentar:</strong> @s.Kommentar</p>
                                            }
                                            @if (s.Status == FravarStatus.Avslatt && !string.IsNullOrWhiteSpace(s.AvslagsBegrunnelse))
                                            {
                                                <p><strong>Begrunnelse:</strong> @s.AvslagsBegrunnelse</p>
                                            }
                                            @if (string.IsNullOrWhiteSpace(s.Kommentar) && (s.Status != FravarStatus.Avslatt || string.IsNullOrWhiteSpace(s.AvslagsBegrunnelse)))
                                            {
                                                <p class="list-empty">Ingen ytterligere detaljer.</p>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (_redigerendeSoknadId == s.Id)
                                {
                                    <tr class="soknad-under-rad">
                                        <td colspan="5">
                                            <div class="soknad-form">
                                                <label>Fra dato<input type="date" @bind="_redigerFraDato" /></label>
                                                <label>Til dato<input type="date" @bind="_redigerTilDato" /></label>
                                                <label class="span-full">Kommentar<textarea rows="2" @bind="_redigerKommentar"></textarea></label>
                                            </div>
                                            <div class="rediger-knapperad">
                                                <button type="button" class="save-button" @onclick="@(() => LagreRediger(s))">Lagre</button>
                                                <button type="button" class="cancel-button" @onclick="AvbrytRediger">Avbryt</button>
                                            </div>
                                            @if (!string.IsNullOrEmpty(_redigerFeil))
                                            {
                                                <p class="form-error">@_redigerFeil</p>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="kort kalender-kort" id="fravar-kalender">
    <div class="kalender-header-rad">
        <h2>Fraværskalender</h2>
        <div class="kalender-visningsvalg">
            <button type="button" class="visning-pill @(_kalVisning == "maned" ? "aktiv" : "")" @onclick='@(() => SettKalVisning("maned"))'>Måned</button>
            <button type="button" class="visning-pill @(_kalVisning == "uke" ? "aktiv" : "")" @onclick='@(() => SettKalVisning("uke"))'>Uke</button>
            <button type="button" class="visning-pill @(_kalVisning == "liste" ? "aktiv" : "")" @onclick='@(() => SettKalVisning("liste"))'>Liste</button>
        </div>
        <ul class="kalender-legend">
            <li><span class="legend-dot legend-ferie"></span>Ferie</li>
            <li><span class="legend-dot legend-sykdom"></span>Sykdom</li>
            <li><span class="legend-dot legend-annet"></span>Annet</li>
            <li><span class="legend-dot legend-planlagt"></span>Planlagt</li>
        </ul>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <label class="kalender-filter">
                Person
                <select @bind="_valgtPersonId" @bind:after="LastKalenderAsync">
                    @foreach (var p in _personer)
                    {
                        <option value="@p.Id">@p.Navn</option>
                    }
                </select>
            </label>
        </Authorized>
    </AuthorizeView>

    @if (_valgtPersonId is null)
    {
        <p class="list-empty">Velg en person for å se fraværskalenderen.</p>
    }
    else
    {
        @if (_valgtPersonStats is not null)
        {
            <div class="stat-grid">
                <div class="stat-boks">
                    <Icon Name="sun" />
                    <span class="stat-tall">@_valgtPersonStats.FerieBrukt/@_valgtPersonStats.FerieKvote</span>
                    <span class="stat-label">Feriedager brukt @_valgtPersonStats.Ar</span>
                </div>
                <div class="stat-boks">
                    <Icon Name="calendar" />
                    <span class="stat-tall">@_valgtPersonStats.FerieKommende</span>
                    <span class="stat-label">Godkjente feriedager som kommer</span>
                </div>
                <div class="stat-boks">
                    <Icon Name="cross-medical" />
                    <span class="stat-tall">@_valgtPersonStats.EgenmeldingBrukt</span>
                    <span class="stat-label">Egenmeldingsdager</span>
                </div>
                <div class="stat-boks">
                    <Icon Name="heart" />
                    <span class="stat-tall">@_valgtPersonStats.SyktBarnBrukt</span>
                    <span class="stat-label">Sykt barn-dager</span>
                </div>
            </div>
        }

        @if (_kalVisning == "liste")
        {
            @if (_listeSoknader.Count == 0)
            {
                <p class="list-empty">Ingen fravær registrert.</p>
            }
            else
            {
                <ul class="kal-liste">
                    @foreach (var s in _listeSoknader)
                    {
                        <li @key="s.Id" class="kal-liste-rad">
                            <span class="fravar-blokk fravar-blokk-@KalenderFarge(s)">@s.Type.Visningsnavn()</span>
                            <span class="kal-liste-periode">@s.FraDato.ToString("dd.MM.yyyy") &ndash; @s.TilDato.ToString("dd.MM.yyyy")</span>
                            <span class="soknad-status soknad-status-@s.Status">@s.Status.Visningsnavn()</span>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="kalender-nav">
                <button type="button" class="knapp knapp-ikon" @onclick="KalForrige" aria-label="Forrige"><Icon Name="arrow-left" /></button>
                <span class="kalender-manednavn">@KalNavTekst()</span>
                <button type="button" class="knapp knapp-ikon kalender-neste" @onclick="KalNeste" aria-label="Neste"><Icon Name="arrow-left" /></button>
            </div>

            <div class="fravar-kort-kal">
                <div class="kalender-ukedager">
                    @foreach (var dagnavn in Ukedagnavn)
                    {
                        <div class="kalender-ukedag">@dagnavn</div>
                    }
                </div>
                <div class="kalender-grid">
                    @foreach (var dag in _kalenderDager)
                    {
                        <div class="kalender-dag @(_kalVisning == "maned" && dag.Dato.Month != _visningsManed.Month ? "kalender-dag-annen-maned" : "") @(dag.Dato.Date == DateTime.Today ? "kalender-dag-i-dag" : "")">
                            <span class="kalender-dagnummer">@dag.Dato.Day</span>
                            @foreach (var s in dag.Soknader)
                            {
                                <span class="fravar-blokk fravar-blokk-@KalenderFarge(s)">@s.Type.Visningsnavn()</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (_slettSoknadId is not null)
{
    <div class="confirm-overlay">
        <div class="confirm-box">
            <h3>Slette søknaden?</h3>
            <p>Søknaden fjernes permanent.</p>
            <div class="confirm-actions">
                <button type="button" class="cancel-button" @onclick="@(() => _slettSoknadId = null)">Avbryt</button>
                <button type="button" class="delete-confirm-button" @onclick="BekreftSlettSoknad">Ja, slett</button>
            </div>
        </div>
    </div>
}

</div>

@code {
    private sealed class PersonOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public int FerieKvote { get; set; }
        public BrukerRolle Rolle { get; set; }
    }

    private sealed class FravarStats
    {
        public int Ar { get; set; }
        public int FerieBrukt { get; set; }
        public int FerieKommende { get; set; }
        public int FerieKvote { get; set; }
        public int EgenmeldingBrukt { get; set; }
        public int SyktBarnBrukt { get; set; }
    }

    private sealed class KalenderDag
    {
        public required DateTime Dato { get; set; }
        public List<FravarSoknad> Soknader { get; set; } = [];
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Ukedagnavn = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private string _mobilFane = "dashboard";
    private bool _visMobilSoknadForm;

    private FravarType _nyType = FravarType.Ferie;
    private DateOnly? _nyFraDato = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _nyTilDato = DateOnly.FromDateTime(DateTime.Today);
    private string _nyKommentar = "";
    private int? _nyTilOppfolgingHosId;
    private bool _nyHeleDagen = true;
    private TimeOnly? _nyStartTid = new(7, 0);
    private TimeOnly? _nySluttTid = new(15, 0);
    private DateOnly _nySoknadKalenderManed = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string? _soknadFeil;
    private string? _soknadMelding;

    private List<FravarSoknad> _mineSoknader = [];
    private bool _visAlleSoknader;
    private int? _apneDetaljerId;
    private int? _redigerendeSoknadId;
    private DateOnly? _redigerFraDato;
    private DateOnly? _redigerTilDato;
    private string? _redigerKommentar;
    private string? _redigerFeil;
    private int? _slettSoknadId;

    private List<PersonOption> _personer = [];
    private int? _valgtPersonId;
    private string _kalVisning = "maned";
    private DateTime _visningsManed = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _ukeStart = FinnForrigeMandag(DateTime.Today);
    private List<KalenderDag> _kalenderDager = [];
    private List<FravarSoknad> _listeSoknader = [];
    private FravarStats? _mineStats;
    private FravarStats? _valgtPersonStats;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var idClaim = state.User.FindFirst("BrukerId")?.Value;
            if (idClaim is not null && int.TryParse(idClaim, out var id))
            {
                _naverendeBrukerId = id;
            }
        }

        await LastMineSoknaderAsync();

        _personer = await Db.Brukere
            .Where(b => b.Rolle != BrukerRolle.Kunde)
            .OrderBy(b => b.Navn)
            .Select(b => new PersonOption
            {
                Id = b.Id,
                Navn = b.Navn,
                FerieKvote = b.FerieKvote,
                Rolle = b.Rolle
            })
            .ToListAsync();

        if (_naverendeBrukerId is not null)
        {
            var meg = _personer.FirstOrDefault(p => p.Id == _naverendeBrukerId);
            if (meg is not null)
            {
                _mineStats = await BeregnStatsAsync(meg.Id, meg.FerieKvote);
            }
        }

        _valgtPersonId = _naverendeBrukerId;
        _kalVisning = await VisningPref.HentAsync("fravar", _kalVisning);
        await LastKalenderAsync();
    }

    private static int FerieTilgjengelig(FravarStats s) => Math.Max(s.FerieKvote - s.FerieBrukt - s.FerieKommende, 0);

    private static string Dagtekst(int antall) => antall == 1 ? "dag" : "dager";

    private static string FerieRingGradient(FravarStats s)
    {
        var tilgjengelig = FerieTilgjengelig(s);
        var planlagt = s.FerieKommende;
        var tattUt = s.FerieBrukt;
        var total = tilgjengelig + planlagt + tattUt;

        if (total <= 0)
        {
            return "#e4e0d5";
        }

        var p1 = tilgjengelig * 100.0 / total;
        var p2 = p1 + planlagt * 100.0 / total;
        return string.Format(CultureInfo.InvariantCulture,
            "conic-gradient(#2b7a4b 0% {0:0.##}%, #d9a520 {0:0.##}% {1:0.##}%, #c7c2b6 {1:0.##}% 100%)",
            p1, p2);
    }

    private static string KalenderFarge(FravarSoknad s)
    {
        if (s.Status == FravarStatus.Venter)
        {
            return "planlagt";
        }

        return s.Type switch
        {
            FravarType.Ferie => "ferie",
            FravarType.Egenmelding or FravarType.Sykemelding or FravarType.SyktBarn => "sykdom",
            _ => "annet"
        };
    }

    private async Task<FravarStats> BeregnStatsAsync(int brukerId, int ferieKvote)
    {
        var ar = DateTime.Today.Year;
        var arStart = new DateTime(ar, 1, 1);
        var arSlutt = new DateTime(ar, 12, 31);

        var soknader = await Db.FravarSoknader
            .Where(f => f.BrukerId == brukerId && f.Status == FravarStatus.Godkjent
                && f.FraDato.Date <= arSlutt && f.TilDato.Date >= arStart)
            .ToListAsync();

        var stats = new FravarStats
        {
            Ar = ar,
            FerieKvote = ferieKvote
        };

        foreach (var s in soknader)
        {
            var fra = s.FraDato.Date < arStart ? arStart : s.FraDato.Date;
            var til = s.TilDato.Date > arSlutt ? arSlutt : s.TilDato.Date;

            for (var dato = fra; dato <= til; dato = dato.AddDays(1))
            {
                var erKommende = dato > DateTime.Today;
                switch (s.Type)
                {
                    case FravarType.Ferie when erKommende:
                        stats.FerieKommende++;
                        break;
                    case FravarType.Ferie:
                        stats.FerieBrukt++;
                        break;
                    case FravarType.Egenmelding:
                        stats.EgenmeldingBrukt++;
                        break;
                    case FravarType.SyktBarn:
                        stats.SyktBarnBrukt++;
                        break;
                }
            }
        }

        return stats;
    }

    private async Task LastMineSoknaderAsync()
    {
        if (_naverendeBrukerId is null)
        {
            return;
        }

        _mineSoknader = await Db.FravarSoknader
            .Where(f => f.BrukerId == _naverendeBrukerId)
            .OrderByDescending(f => f.OpprettetDato)
            .ToListAsync();
    }

    private async Task SendSoknad()
    {
        _soknadFeil = null;
        _soknadMelding = null;

        if (_naverendeBrukerId is null || !_nyFraDato.HasValue || !_nyTilDato.HasValue)
        {
            _soknadFeil = "Fyll ut fra- og til-dato.";
            return;
        }

        if (_nyTilDato.Value < _nyFraDato.Value)
        {
            _soknadFeil = "Til dato kan ikke være før fra dato.";
            return;
        }

        if (!_nyHeleDagen && (!_nyStartTid.HasValue || !_nySluttTid.HasValue || _nySluttTid.Value <= _nyStartTid.Value))
        {
            _soknadFeil = "Fyll ut gyldig start- og sluttidspunkt, eller velg hele dagen.";
            return;
        }

        var soknad = new FravarSoknad
        {
            BrukerId = _naverendeBrukerId.Value,
            Type = _nyType,
            FraDato = _nyFraDato.Value.ToDateTime(TimeOnly.MinValue),
            TilDato = _nyTilDato.Value.ToDateTime(TimeOnly.MinValue),
            Kommentar = string.IsNullOrWhiteSpace(_nyKommentar) ? null : _nyKommentar.Trim(),
            TilOppfolgingHosBrukerId = _nyTilOppfolgingHosId,
            HeleDagen = _nyHeleDagen,
            StartTid = _nyHeleDagen ? null : _nyStartTid,
            SluttTid = _nyHeleDagen ? null : _nySluttTid
        };
        Db.FravarSoknader.Add(soknad);
        await Db.SaveChangesAsync();

        _mineSoknader.Insert(0, soknad);
        _nyKommentar = "";
        _nyTilOppfolgingHosId = null;
        _nyHeleDagen = true;
        _nyStartTid = new TimeOnly(7, 0);
        _nySluttTid = new TimeOnly(15, 0);
        _soknadMelding = "Søknad sendt inn.";

        if (soknad.BrukerId == _valgtPersonId)
        {
            await LastKalenderAsync();
        }
    }

    private void VelgVarighet(string verdi)
    {
        _nyHeleDagen = verdi == "hel";
        if (_nyHeleDagen)
        {
            _nyStartTid = new TimeOnly(7, 0);
            _nySluttTid = new TimeOnly(15, 0);
        }
    }

    private void VelgKalenderDato(DateOnly dato)
    {
        if (_nyFraDato is null || _nyTilDato is not null)
        {
            _nyFraDato = dato;
            _nyTilDato = null;
        }
        else if (dato < _nyFraDato.Value)
        {
            _nyTilDato = _nyFraDato;
            _nyFraDato = dato;
        }
        else
        {
            _nyTilDato = dato;
        }
    }

    private static List<DateOnly> KalenderCeller(DateOnly manedStart)
    {
        var forsteUkedag = ((int)manedStart.DayOfWeek + 6) % 7;
        var start = manedStart.AddDays(-forsteUkedag);
        return Enumerable.Range(0, 42).Select(i => start.AddDays(i)).ToList();
    }

    private string DagerTekst()
    {
        if (_nyFraDato is null)
        {
            return "";
        }

        if (_nyTilDato is null || _nyTilDato == _nyFraDato)
        {
            return _nyFraDato.Value.ToString("dd.MM.yyyy");
        }

        return $"{_nyFraDato.Value:dd.MM.yyyy} - {_nyTilDato.Value:dd.MM.yyyy}";
    }

    private async Task SendSoknadMobil()
    {
        await SendSoknad();
        if (string.IsNullOrEmpty(_soknadFeil))
        {
            _visMobilSoknadForm = false;
        }
    }

    private void ToggleDetaljer(int id)
    {
        _apneDetaljerId = _apneDetaljerId == id ? null : id;
        _redigerendeSoknadId = null;
    }

    private void StartRediger(FravarSoknad s)
    {
        _redigerendeSoknadId = s.Id;
        _apneDetaljerId = null;
        _redigerFraDato = DateOnly.FromDateTime(s.FraDato);
        _redigerTilDato = DateOnly.FromDateTime(s.TilDato);
        _redigerKommentar = s.Kommentar;
        _redigerFeil = null;
    }

    private void AvbrytRediger()
    {
        _redigerendeSoknadId = null;
        _redigerFeil = null;
    }

    private async Task LagreRediger(FravarSoknad s)
    {
        if (!_redigerFraDato.HasValue || !_redigerTilDato.HasValue || _redigerTilDato.Value < _redigerFraDato.Value)
        {
            _redigerFeil = "Fyll ut gyldig fra- og til-dato.";
            return;
        }

        var entitet = await Db.FravarSoknader.FirstOrDefaultAsync(f => f.Id == s.Id);
        if (entitet is null)
        {
            return;
        }

        entitet.FraDato = _redigerFraDato.Value.ToDateTime(TimeOnly.MinValue);
        entitet.TilDato = _redigerTilDato.Value.ToDateTime(TimeOnly.MinValue);
        entitet.Kommentar = string.IsNullOrWhiteSpace(_redigerKommentar) ? null : _redigerKommentar.Trim();
        await Db.SaveChangesAsync();

        s.FraDato = entitet.FraDato;
        s.TilDato = entitet.TilDato;
        s.Kommentar = entitet.Kommentar;
        _redigerendeSoknadId = null;

        if (s.BrukerId == _valgtPersonId)
        {
            await LastKalenderAsync();
        }
    }

    private async Task BekreftSlettSoknad()
    {
        if (_slettSoknadId is null)
        {
            return;
        }

        var entitet = await Db.FravarSoknader.FirstOrDefaultAsync(f => f.Id == _slettSoknadId.Value);
        if (entitet is not null)
        {
            Db.FravarSoknader.Remove(entitet);
            await Db.SaveChangesAsync();
            _mineSoknader.RemoveAll(f => f.Id == _slettSoknadId.Value);
        }

        _slettSoknadId = null;
        await LastKalenderAsync();
    }

    private async Task SettKalVisning(string visning)
    {
        _kalVisning = visning;
        await VisningPref.SettAsync("fravar", visning);
        await LastKalenderAsync();
    }

    private async Task KalForrige()
    {
        if (_kalVisning == "uke")
        {
            _ukeStart = _ukeStart.AddDays(-7);
        }
        else
        {
            _visningsManed = _visningsManed.AddMonths(-1);
        }

        await LastKalenderAsync();
    }

    private async Task KalNeste()
    {
        if (_kalVisning == "uke")
        {
            _ukeStart = _ukeStart.AddDays(7);
        }
        else
        {
            _visningsManed = _visningsManed.AddMonths(1);
        }

        await LastKalenderAsync();
    }

    private string KalNavTekst() => _kalVisning switch
    {
        "uke" => $"{_ukeStart:dd.MM} - {_ukeStart.AddDays(6):dd.MM.yyyy}",
        _ => Kultur.TextInfo.ToTitleCase(_visningsManed.ToString("MMMM yyyy", Kultur))
    };

    private async Task LastKalenderAsync()
    {
        if (_valgtPersonId is null)
        {
            _kalenderDager = [];
            _listeSoknader = [];
            _valgtPersonStats = null;
            return;
        }

        var valgtPerson = _personer.FirstOrDefault(p => p.Id == _valgtPersonId);
        if (valgtPerson is not null)
        {
            _valgtPersonStats = await BeregnStatsAsync(valgtPerson.Id, valgtPerson.FerieKvote);
        }

        if (_kalVisning == "liste")
        {
            _listeSoknader = await Db.FravarSoknader
                .Where(f => f.BrukerId == _valgtPersonId && f.Status != FravarStatus.Avslatt)
                .OrderByDescending(f => f.FraDato)
                .Take(20)
                .ToListAsync();
            _kalenderDager = [];
            return;
        }

        DateTime forsteIGrid;
        DateTime sisteIGrid;
        if (_kalVisning == "uke")
        {
            forsteIGrid = _ukeStart;
            sisteIGrid = _ukeStart.AddDays(6);
        }
        else
        {
            forsteIGrid = FinnForrigeMandag(_visningsManed);
            var sisteIManed = _visningsManed.AddMonths(1).AddDays(-1);
            sisteIGrid = FinnNesteSondag(sisteIManed);
        }

        var soknader = await Db.FravarSoknader
            .Where(f => f.BrukerId == _valgtPersonId
                && f.Status != FravarStatus.Avslatt
                && f.FraDato.Date <= sisteIGrid && f.TilDato.Date >= forsteIGrid)
            .ToListAsync();

        var dager = new List<KalenderDag>();
        for (var dato = forsteIGrid; dato <= sisteIGrid; dato = dato.AddDays(1))
        {
            dager.Add(new KalenderDag
            {
                Dato = dato,
                Soknader = soknader.Where(s => s.FraDato.Date <= dato && s.TilDato.Date >= dato).ToList()
            });
        }

        _kalenderDager = dager;
    }

    private static DateTime FinnForrigeMandag(DateTime dato)
    {
        var diff = ((int)dato.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return dato.AddDays(-diff);
    }

    private static DateTime FinnNesteSondag(DateTime dato)
    {
        var diff = ((int)DayOfWeek.Sunday - (int)dato.DayOfWeek + 7) % 7;
        return dato.AddDays(diff);
    }
}
