@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Services
@inject VisningPreferanseService VisningPref
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

@* «Hva er nytt» (forslag A1): vises én gang per bruker etter hver oppdatering.
   Hvilken versjon brukeren har sett lagres på brukeren, så det gjelder både PC
   og mobil. Innholdet ligger i Services/Oppdateringer.cs. *@
@if (_vis)
{
    var v = Oppdateringer.Siste;
    <div class="hen-bak" @onclick="Lukk"></div>
    <div class="hen" role="dialog" aria-modal="true" aria-labelledby="hen-tittel" @onkeydown="Tast" tabindex="-1" @ref="_dlg">
        <div class="hen-topp">
            <button type="button" class="hen-lukk" aria-label="Lukk" @onclick="Lukk"><Icon Name="x" /></button>
            <span class="hen-merke"><Icon Name="sparkle" />Oppdatering · versjon @v.Nummer</span>
            <h2 id="hen-tittel">Hva er nytt</h2>
            <p>@v.Dato.ToString("d. MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))</p>
        </div>
        <ul class="hen-liste">
            @foreach (var p in v.Punkter)
            {
                <li class="@Oppdateringer.Klasse(p.Type)">
                    <span class="hen-ik"><Icon Name="@p.Ikon" /></span>
                    <div>
                        <b>@p.Tittel<span class="hen-tag">@Oppdateringer.Navn(p.Type)</span></b>
                        <span class="hen-tekst">@p.Tekst</span>
                    </div>
                </li>
            }
        </ul>
        <div class="hen-bunn">
            <button type="button" class="hen-historikk" @onclick="TilHistorikk"><Icon Name="history" />Tidligere oppdateringer</button>
            <button type="button" class="hen-ok" @onclick="Lukk">Supert, takk!</button>
        </div>
    </div>
}

@code {
    private const string Nokkel = "sett-oppdatering";
    private bool _vis;
    private ElementReference _dlg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                if (state.User.FindFirst("BrukerId") is null)
                {
                    return;
                }

                // Ikke midt i en side som vises inni en annen (embed) eller på selve historikken.
                var sti = new Uri(Nav.Uri);
                if (sti.Query.Contains("embed=true", StringComparison.OrdinalIgnoreCase)
                    || sti.AbsolutePath.StartsWith("/oppdateringer", StringComparison.OrdinalIgnoreCase))
                {
                    return;
                }

                if (await VisningPref.HentAsync(Nokkel, "") != Oppdateringer.Siste.Nummer)
                {
                    _vis = true;
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                // Vinduet skal aldri stoppe portalen.
            }
        }
        else if (_vis)
        {
            try
            {
                await _dlg.FocusAsync();
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task Lukk()
    {
        _vis = false;
        try
        {
            await VisningPref.SettAsync(Nokkel, Oppdateringer.Siste.Nummer);
        }
        catch (Exception)
        {
        }
    }

    private async Task TilHistorikk()
    {
        await Lukk();
        Nav.NavigateTo("/oppdateringer");
    }

    private async Task Tast(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Lukk();
        }
    }
}
