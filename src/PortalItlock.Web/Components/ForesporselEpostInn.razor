@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject PlatformDbContext PlatformDb
@inject ITenantContext TenantContext
@inject IJSRuntime JS

@* Forespørsler → E-post inn: adressen e-post sendes til, og hvordan man får e-post
   fra den vanlige innboksen hit (videresending én og én, eller en regel i Outlook). *@
<div class="fp-oppsett">
    <section class="fp-oppsett-kort">
        <div class="fp-oppsett-hode"><Icon Name="mail" />Adressen til Forespørsler</div>
        <div class="fp-oppsett-innhold">
            @if (Adresse is null)
            {
                <p class="fp-tom">Organisasjonen har ingen adresse i Full Kontroll ennå. Ta kontakt med Full Kontroll for å få den satt opp.</p>
            }
            else
            {
                <p>All e-post som sendes til denne adressen, blir en forespørsel med vedlegg.</p>
                <div class="fp-kode"><code>@Adresse</code><button type="button" class="ol-ri" @onclick="Kopier"><Icon Name="copy" />@(_kopiert ? "Kopiert" : "Kopier")</button></div>
            }
            <div class="fp-auto">
                <b>Dette gjør portalen av seg selv</b>
                <p><Icon Name="check" /><span><b>Finner opprinnelig avsender.</b> Videresender du fra Outlook, leses «Fra:» i e-posten, og kunden står som avsender i stedet for deg.</span></p>
                <p><Icon Name="check" /><span><b>Kobler til kunde.</b> Treff på e-postadressen til kunden eller en kontaktperson, eller på firmadomenet når bare én kunde har det.</span></p>
                <p><Icon Name="check" /><span><b>Hopper over automatiske svar.</b> «Fraværende» og «Automatisk svar» havner ikke i innboksen.</span></p>
            </div>
        </div>
    </section>
    <section class="fp-oppsett-kort">
        <div class="fp-oppsett-hode"><Icon Name="send" />Sende e-post hit fra vanlig innboks</div>
        <div class="fp-oppsett-innhold">
            <b class="fp-oppsett-under">Én og én e-post</b>
            <div class="fp-steg"><span>1</span><div>Trykk <b>Videresend</b> i Outlook og send til @(Adresse ?? "adressen til venstre").</div></div>
            <div class="fp-steg"><span>2</span><div>Den legger seg i Forespørsler med kunden som avsender, og havner også i mappen «Videresendt».</div></div>

            <b class="fp-oppsett-under">Alt fra post@@-adressen automatisk</b>
            <div class="fp-steg"><span>1</span><div>Outlook på nett: <b>Innstillinger → E-post → Regler → Legg til ny regel</b>.</div></div>
            <div class="fp-steg"><span>2</span><div>Betingelse: <b>Mottatt på</b> post@@-adressen deres. Handling: <b>Videresend til</b> @(Adresse ?? "adressen til venstre").</div></div>
            <div class="fp-steg"><span>3</span><div>E-posten blir også liggende i Outlook som før.</div></div>
            <p class="fp-hint">Noen Microsoft 365-oppsett stopper videresending til adresser utenfor firmaet. Da må den som styrer e-posten tillate det for denne adressen.</p>
        </div>
    </section>
</div>

@code {
    private string? _epostNavn;
    private bool _kopiert;

    private string? Adresse => string.IsNullOrWhiteSpace(_epostNavn) ? null : OrganisasjonOppsett.Adresse(_epostNavn);

    protected override async Task OnInitializedAsync()
    {
        if (TenantContext.Current is { } t)
        {
            _epostNavn = await PlatformDb.TenantInnstillinger.AsNoTracking()
                .Where(i => i.TenantId == t.Id)
                .Select(i => i.EpostNavn)
                .FirstOrDefaultAsync();
        }
    }

    private async Task Kopier()
    {
        if (Adresse is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Adresse);
            _kopiert = true;
        }
        catch (JSException)
        {
        }
    }
}
