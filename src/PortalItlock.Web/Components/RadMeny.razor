@* ⋯-meny på en rad i en liste: «Rediger» og «Slett». Slett åpner
   SlettDialog på siden (via OnSlett), så selve slettingen alltid bekreftes. *@
<div class="rm" @onclick:stopPropagation="true" @onclick:preventDefault="false">
    <button type="button" class="rm-knapp @(_apen ? "apen" : "")" title="Flere valg" aria-label="Flere valg for @Navn" aria-expanded="@(_apen ? "true" : "false")"
            @onclick="Veksle" @onclick:stopPropagation="true">
        <Icon Name="more-horizontal" />
    </button>
    @if (_apen)
    {
        <div class="rm-bak" @onclick="Lukk" @onclick:stopPropagation="true"></div>
        <div class="rm-meny" role="menu">
            @if (!string.IsNullOrEmpty(RedigerHref))
            {
                <a class="rm-valg" role="menuitem" href="@RedigerHref" @onclick:stopPropagation="true"><Icon Name="edit" />Rediger</a>
            }
            else if (OnRediger.HasDelegate)
            {
                <button type="button" class="rm-valg" role="menuitem" @onclick="Rediger" @onclick:stopPropagation="true"><Icon Name="edit" />Rediger</button>
            }
            <button type="button" class="rm-valg rm-slett" role="menuitem" @onclick="Slett" @onclick:stopPropagation="true"><Icon Name="trash" />Slett</button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Navn { get; set; }
    [Parameter] public string? RedigerHref { get; set; }
    [Parameter] public EventCallback OnRediger { get; set; }
    [Parameter] public EventCallback OnSlett { get; set; }

    private bool _apen;

    private void Veksle() => _apen = !_apen;
    private void Lukk() => _apen = false;

    private async Task Rediger()
    {
        _apen = false;
        await OnRediger.InvokeAsync();
    }

    private async Task Slett()
    {
        _apen = false;
        await OnSlett.InvokeAsync();
    }
}
