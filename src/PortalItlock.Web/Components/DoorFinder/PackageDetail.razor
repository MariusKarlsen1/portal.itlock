@namespace PortalItlock.Web.Components.DoorFinder
@using System.Globalization
@using PortalItlock.Web.Models

<div class="panel">
    <div class="panel-header">
        <h2>Detaljer</h2>
    </div>
    @if (Package is null)
    {
        <div class="package-detail-empty">
            <Icon Name="box" />
            <p>Velg en pakke i listen for å se komponentene.</p>
        </div>
    }
    else
    {
        <div class="package-detail">
            <div class="package-detail-header">
                <h3>@Package.Navn</h3>
                <a class="rediger-btn" href="@($"rediger-pakke/{Package.Id}")"><Icon Name="edit" />Rediger</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(Package.Beskrivelse))
            {
                <p class="package-beskrivelse">@Package.Beskrivelse</p>
            }

            <p class="oppfyller-tittel">Oppfyller</p>
            <div class="oppfyller-rad">
                @foreach (var krav in Package.Krav.Where(k => k.RequirementValue is not null))
                {
                    <span class="oppfyller-pille"><Icon Name="check" />@krav.RequirementValue!.Dimensjon?.Navn: @krav.RequirementValue.Verdi</span>
                }
            </div>

            <p class="oppfyller-tittel">Komponenter</p>
            <div class="komponent-tabell-kort">
                <table>
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Navn</th>
                            <th class="tall-kolonne">Antall</th>
                            <th class="tall-kolonne">Netto</th>
                            <th class="tall-kolonne">Veiledende</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pc in Package.Komponenter)
                        {
                            <tr>
                                <td>@pc.Component?.Type?.Navn</td>
                                <td>@pc.Component?.Navn</td>
                                <td class="tall-kolonne">@pc.Antall</td>
                                <td class="tall-kolonne price-cell">@FormatPrice(pc.Component?.PrisNetto * pc.Antall)</td>
                                <td class="tall-kolonne price-cell">@FormatPrice(pc.Component?.PrisVeiledende * pc.Antall)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3">Sum@(MissingPriceCount > 0 ? $" ({MissingPriceCount} uten pris)" : "")</td>
                            <td class="tall-kolonne price-cell">@FormatPrice(SumNetto)</td>
                            <td class="tall-kolonne price-cell">@FormatPrice(SumVeiledende)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Package? Package { get; set; }

    private decimal? SumNetto
    {
        get
        {
            var priced = Package?.Komponenter.Where(pc => pc.Component?.PrisNetto is not null).ToList();
            return priced is null or { Count: 0 } ? null : priced.Sum(pc => pc.Component!.PrisNetto!.Value * pc.Antall);
        }
    }

    private decimal? SumVeiledende
    {
        get
        {
            var priced = Package?.Komponenter.Where(pc => pc.Component?.PrisVeiledende is not null).ToList();
            return priced is null or { Count: 0 } ? null : priced.Sum(pc => pc.Component!.PrisVeiledende!.Value * pc.Antall);
        }
    }

    private int MissingPriceCount =>
        Package?.Komponenter.Count(pc => pc.Component?.PrisNetto is null) ?? 0;

    private static string FormatPrice(decimal? value) =>
        value.HasValue ? value.Value.ToString("N2", CultureInfo.GetCultureInfo("nb-NO")) + " kr" : "-";
}
