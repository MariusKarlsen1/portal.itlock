@namespace PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Models

<div class="panel">
    <div class="panel-header">
        <h2>Krav</h2>
        @if (SelectedValueIds.Count > 0)
        {
            <button class="nullstill-link" type="button" @onclick="NullstillAlle">Nullstill alle</button>
        }
    </div>
    @foreach (var dimension in Dimensions)
    {
        var selectedCount = dimension.Verdier.Count(v => SelectedValueIds.Contains(v.Id));

        <div class="krav-gruppe">
            <div class="krav-gruppe-header">
                <span class="krav-gruppe-navn">@dimension.Navn</span>
                @if (selectedCount > 0)
                {
                    <span class="krav-gruppe-antall">@selectedCount valgt</span>
                }
            </div>
            <div class="krav-chip-rad">
                @foreach (var value in dimension.Verdier.OrderBy(v => v.Rekkefolge))
                {
                    var erValgt = SelectedValueIds.Contains(value.Id);
                    <button type="button" class="krav-chip @(erValgt ? "valgt" : "")" @onclick="@(() => OnToggle(value.Id, !erValgt))">
                        @if (erValgt)
                        {
                            <Icon Name="check" />
                        }
                        @value.Verdi
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<RequirementDimension> Dimensions { get; set; } = [];

    [Parameter, EditorRequired]
    public HashSet<int> SelectedValueIds { get; set; } = [];

    [Parameter]
    public EventCallback<HashSet<int>> SelectedValueIdsChanged { get; set; }

    private async Task OnToggle(int valueId, bool skalVaereValgt)
    {
        if (skalVaereValgt)
        {
            SelectedValueIds.Add(valueId);
        }
        else
        {
            SelectedValueIds.Remove(valueId);
        }

        await SelectedValueIdsChanged.InvokeAsync(SelectedValueIds);
    }

    private async Task NullstillAlle()
    {
        SelectedValueIds.Clear();
        await SelectedValueIdsChanged.InvokeAsync(SelectedValueIds);
    }
}
