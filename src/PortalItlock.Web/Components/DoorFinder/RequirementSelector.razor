@namespace PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Models

<div class="requirement-selector">
    @foreach (var dimension in Dimensions)
    {
        <fieldset class="requirement-group">
            <legend>@dimension.Navn</legend>
            @foreach (var value in dimension.Verdier.OrderBy(v => v.Rekkefolge))
            {
                <label class="requirement-option">
                    <input type="checkbox"
                           checked="@SelectedValueIds.Contains(value.Id)"
                           @onchange="@(e => OnToggle(value.Id, e.Value))" />
                    @value.Verdi
                </label>
            }
        </fieldset>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<RequirementDimension> Dimensions { get; set; } = [];

    [Parameter, EditorRequired]
    public HashSet<int> SelectedValueIds { get; set; } = [];

    [Parameter]
    public EventCallback<HashSet<int>> SelectedValueIdsChanged { get; set; }

    private async Task OnToggle(int valueId, object? isChecked)
    {
        if (isChecked is true)
        {
            SelectedValueIds.Add(valueId);
        }
        else
        {
            SelectedValueIds.Remove(valueId);
        }

        await SelectedValueIdsChanged.InvokeAsync(SelectedValueIds);
    }
}
