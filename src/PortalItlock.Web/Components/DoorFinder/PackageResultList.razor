@namespace PortalItlock.Web.Components.DoorFinder
@using PortalItlock.Web.Models

<div class="panel">
    <div class="panel-header">
        <h2>Resultater</h2>
        <span>@Packages.Count pakke@(Packages.Count == 1 ? "" : "r") matcher</span>
    </div>
    @if (Packages.Count == 0)
    {
        <div class="no-results">
            <Icon Name="box" />
            <p>Ingen pakke oppfyller alle valgte krav.</p>
            <p class="no-results-hint">Manuell sammensetning av pakke kommer som egen side.</p>
        </div>
    }
    else
    {
        <div class="package-results">
            @foreach (var package in Packages)
            {
                var erValgt = package.Id == SelectedPackageId;
                <button type="button" class="package-result @(erValgt ? "is-selected" : "")" @onclick="@(() => OnSelect.InvokeAsync(package.Id))">
                    <span class="package-ikon"><Icon Name="box" /></span>
                    <span class="package-tekst">
                        <span class="package-name">@package.Navn</span>
                        <span class="package-requirements">
                            @foreach (var verdi in package.Krav
                                .Where(k => k.RequirementValue is not null)
                                .OrderBy(k => k.RequirementValue!.Dimensjon?.Rekkefolge)
                                .Select(k => k.RequirementValue!.Verdi))
                            {
                                <span class="package-krav-tag">@verdi</span>
                            }
                        </span>
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<Package> Packages { get; set; } = [];

    [Parameter]
    public int? SelectedPackageId { get; set; }

    [Parameter]
    public EventCallback<int> OnSelect { get; set; }
}
