@page "/app/timer/ny"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Legg til timer</PageTitle>

@* «Legg til timer»: ansatt og dato øverst, og timetypene gruppert under.
   Valgt timetype åpner skjemaet. *@
<div class="ma">
    <AppHode Ikon="clock" Tittel="Legg til timer" Under="@_navn" Tilbake="@(Ordre is { } o ? $"/app/timer?ordre={o}" : "/app/timer")" />
    <div class="ma-felt ma-felt-rad" style="border-left:1px solid var(--itlock-border);border-right:1px solid var(--itlock-border)">
        <b>Ansatt</b><select disabled style="flex:1"><option>@_navn</option></select>
    </div>
    <div class="ma-felt ma-felt-rad" style="border-left:1px solid var(--itlock-border);border-right:1px solid var(--itlock-border)">
        <b>Dato</b>
        <span class="ma-stepper">
            <button type="button" @onclick="@(() => _dato = _dato.AddDays(-1))" aria-label="Dagen før">−</button>
            <span>@MontorApp.Dato(_dato)</span>
            <button type="button" @onclick="@(() => _dato = _dato.AddDays(1))" aria-label="Dagen etter">+</button>
        </span>
    </div>
    <div class="ma-liste">
        @foreach (var g in _typer.GroupBy(t => t.Gruppe))
        {
            <div class="ma-gruppe">@MontorApp.GruppeNavn(g.Key)@(g.Key == MontorApp.TimetypeGruppe.Jobb && Ordre is { } oj ? $" · ordre {oj}" : "")</div>
            @foreach (var t in g)
            {
                <a class="ma-rad" href="@($"/app/timer/skjema?type={t.Id}&dato={_dato:yyyy-MM-dd}{(Ordre is { } oo ? $"&ordre={oo}" : "")}")">
                    <Icon Name="clock" />
                    <span class="ma-rad-tekst"><b>@t.Visning</b></span>
                    <span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ordre")] public int? Ordre { get; set; }
    [SupplyParameterFromQuery(Name = "dato")] public string? DatoTekst { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private string _navn = "";
    private DateTime _dato = DateTime.Today;
    private List<MontorApp.Timetype> _typer = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            _navn = await Db.Brukere.Where(b => b.Id == id).Select(b => b.Navn).FirstOrDefaultAsync() ?? "";
        }

        if (DateTime.TryParse(DatoTekst, out var d))
        {
            _dato = d.Date;
        }

        _typer = MontorApp.Timetyper(await Db.PrisKoder.AsNoTracking().ToListAsync());
    }
}
