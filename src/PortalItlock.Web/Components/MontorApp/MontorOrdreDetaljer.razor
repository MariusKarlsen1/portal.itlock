@page "/app/ordre/{Id:int}/detaljer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

<PageTitle>Ordredetaljer</PageTitle>

@* Ordredetaljer i montørappen: når, hva, hvor og hvem, lest fra
   arbeidsordren. Endringer gjøres fortsatt på arbeidsordren i portalen. *@
<div class="ma">
    <AppHode Ikon="file-text" Sand="true" Tittel="Ordredetaljer" Under="@(_a is null ? "" : $"{_a.Id} {_a.Tittel}")" Tilbake="@($"/app/ordre/{Id}")" />

    @if (_a is null)
    {
        <div class="ma-liste"><p class="ma-tom">@(_lastet ? "Fant ikke arbeidsordren." : "Laster …")</p></div>
    }
    else
    {
        var a = _a;
        var adr = MontorApp.Adresse(a);
        var kunde = a.Kunde ?? a.Prosjekt?.Kunde;
        var telefon = !string.IsNullOrWhiteSpace(kunde?.Telefon) ? kunde.Telefon : a.Prosjekt?.Telefon;
        var kontakt = !string.IsNullOrWhiteSpace(kunde?.Kontaktperson) ? kunde.Kontaktperson : a.Prosjekt?.Kontaktperson;
        <div class="ma-liste mod">
            <div class="mod-status">
                <span class="ma-merke @StatusMerke(a.Status)">@a.Status.Visningsnavn()</span>
                @if (a.Type is { } t)
                {
                    <span class="ma-merke gra">@t.Visningsnavn()</span>
                }
                @if (a.Prioritet is ArbeidsordrePrioritet.Hoy or ArbeidsordrePrioritet.Kritisk)
                {
                    <span class="ma-merke rod">@a.Prioritet.Visningsnavn()</span>
                }
            </div>

            <div class="mod-rutenett">
                <div><small>Dato</small><b>@(a.PlanlagtDato is { } d ? MontorApp.DagKort(d) : "Ikke satt")</b></div>
                <div><small>Tid</small><b>@Tid(a)</b></div>
                <div><small>Estimert</small><b>@(a.EstimerteTimer is { } e ? MontorApp.Timer(e) + " t" : "–")</b></div>
                <div><small>Ordrenr.</small><b>@a.Id</b></div>
            </div>

            <div class="ma-gruppe">Oppgave</div>
            <div class="mod-tekst">@(string.IsNullOrWhiteSpace(a.Beskrivelse) ? a.Tittel : RikTekst.TilTekst(a.Beskrivelse))</div>

            @if (!string.IsNullOrWhiteSpace(a.KundeInfoForJobb))
            {
                <div class="mod-merknad"><Icon Name="alert-triangle" /><span><b>Info til jobben</b>@RikTekst.TilTekst(a.KundeInfoForJobb)</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(a.Hentehylle))
            {
                <div class="mod-merknad mod-bla"><Icon Name="box" /><span><b>Varene ligger klare</b>Hentehylle @a.Hentehylle</span></div>
            }

            <div class="ma-gruppe">Sted og kontakt</div>
            @if (adr is not null)
            {
                <a class="ma-rad" href="@MontorApp.KartLenke(adr)" target="_blank" rel="noopener">
                    <Icon Name="map-pin" /><span class="ma-rad-tekst"><b>@adr</b><small>Naviger hit</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
            @if (kunde is not null || kontakt is not null)
            {
                <a class="ma-rad" href="@(string.IsNullOrWhiteSpace(telefon) ? null : $"tel:{telefon}")">
                    <Icon Name="phone" /><span class="ma-rad-tekst"><b>@(kontakt ?? kunde?.Navn)</b><small>@string.Join(" · ", new[] { kontakt is null ? null : kunde?.Navn, telefon }.Where(s => !string.IsNullOrWhiteSpace(s)))</small></span>
                    @if (!string.IsNullOrWhiteSpace(telefon)) {<span class="ma-pil"><Icon Name="chevron-right" /></span>}
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(kunde?.Epost))
            {
                <a class="ma-rad" href="@($"mailto:{kunde.Epost}")">
                    <Icon Name="mail" /><span class="ma-rad-tekst"><b>@kunde.Epost</b><small>E-post</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }

            <div class="ma-gruppe">Jobben</div>
            @if (a.Prosjekt is { } p)
            {
                <a class="ma-rad" href="@($"/app/prosjekt/{p.Id}")">
                    <Icon Name="folder" /><span class="ma-rad-tekst"><b>@p.Navn</b><small>Prosjekt</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
            @if (a.Prosjekt?.Prosjektleder is { } pl)
            {
                <div class="ma-rad" style="cursor:default"><Icon Name="users" /><span class="ma-rad-tekst"><b>@pl.Navn</b><small>Prosjektleder</small></span></div>
            }
            <div class="ma-rad" style="cursor:default"><Icon Name="tool" /><span class="ma-rad-tekst"><b>@(a.AnsvarligMontor?.Navn ?? "Ikke tildelt")</b><small>Ansvarlig montør</small></span></div>
        </div>

    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool _lastet;
    private Arbeidsordre? _a;

    protected override async Task OnParametersSetAsync()
    {
        _a = await Db.Arbeidsordre.AsNoTracking()
            .Include(a => a.Kunde).Include(a => a.AnsvarligMontor)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(a => a.Prosjekt).ThenInclude(p => p!.Prosjektleder)
            .FirstOrDefaultAsync(a => a.Id == Id);
        _lastet = true;
    }

    private static string Tid(Arbeidsordre a)
    {
        if (a.PlanlagtDato is not { } fra || fra.TimeOfDay == TimeSpan.Zero)
        {
            return "Hele dagen";
        }

        return a.PlanlagtSlutt is { } til && til > fra ? $"{fra:HH:mm}–{til:HH:mm}" : $"Fra {fra:HH:mm}";
    }

    private static string StatusMerke(ArbeidsordreStatus s) => s switch
    {
        ArbeidsordreStatus.Pagaende => "gul",
        ArbeidsordreStatus.Ferdig or ArbeidsordreStatus.Fakturert => "gronn",
        _ => "gra"
    };
}
