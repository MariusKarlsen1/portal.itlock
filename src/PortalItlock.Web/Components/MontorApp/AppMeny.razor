@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject MobilVerktoylinjeService Verktoylinje

@* Personknappen i montørappen. Åpner et ark med Synkroniser, Gå til
   fullversjon, Bytt passord og Logg ut. Toppfeltet i portalen er skjult i
   appen, så denne erstatter brukermenyen der. *@
<button type="button" class="ma-person @Klasse" @onclick="@(() => _apen = true)" aria-label="Meny for @_navn" aria-haspopup="dialog">@_initialer</button>

@if (_apen)
{
    <div class="ma-ark-bak" @onclick="@(() => _apen = false)">
        <div class="ma-ark" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Meny">
            <div class="ma-ark-handtak"></div>
            <div class="ma-rad" style="cursor:default;border:0;padding-left:0">
                <span class="ma-person stor">@_initialer</span>
                <span class="ma-rad-tekst"><b>@_navn</b><small>@_epost</small></span>
            </div>
            <div class="ma-liste" style="border:1px solid var(--itlock-border);border-radius:14px;overflow:hidden">
                <button type="button" class="ma-rad" @onclick="Synkroniser">
                    <Icon Name="refresh" /><span class="ma-rad-tekst"><b>Synkroniser</b><small>Hent siste endringer fra kontoret</small></span>
                </button>
                <button type="button" class="ma-rad" @onclick="Fullversjon">
                    <Icon Name="grid" /><span class="ma-rad-tekst"><b>Gå til fullversjon</b><small>Hele portalen med alle valg, tilpasset mobilen</small></span>
                </button>
                <a class="ma-rad" href="/sett-passord">
                    <Icon Name="lock" /><span class="ma-rad-tekst"><b>Bytt passord</b></span>
                </a>
            </div>
            <form method="post" action="/account/logout" class="ma-under">
                <button type="submit" class="ma-knapp sek" style="color:var(--ma-rod)"><Icon Name="log-out" />Logg ut</button>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public string? Klasse { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private bool _apen;
    private string _navn = "";
    private string? _epost;
    private string _initialer = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            var b = await Db.Brukere.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
            _navn = b?.Navn ?? "";
            _epost = b?.Epost;
            _initialer = b?.Initialer ?? "";
        }
    }

    private void Synkroniser() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    // Samme som «Gå til fullversjon» i brukermenyen (TopBar).
    private async Task Fullversjon()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "itlock-fullversjon", "1");
        Verktoylinje.SettMobilvisning(false);
        Verktoylinje.SettFullversjon(true);
        Nav.NavigateTo("/?fullversjon=1", forceLoad: true);
    }
}
