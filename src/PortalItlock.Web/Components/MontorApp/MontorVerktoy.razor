@page "/app/verktoy"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>Verktøy</PageTitle>

@* Verktøyene montøren bruker ute hos kunden, samlet på ett sted i appen:
   to grupper, hver i ett kort med rader. Hver rad åpner verktøyet. *@
<div class="ma mv">
    <AppHode Ikon="tool" Sand="true" Tittel="Verktøy" Under="Alt du trenger ute hos kunden" />
    <div class="mv-sok-ramme">
        <input type="search" class="mv-sok" placeholder="Søk i verktøy" aria-label="Søk i verktøy" @bind="_sok" @bind:event="oninput" />
    </div>

    @foreach (var gruppe in Verktoy.Where(Passer).GroupBy(v => v.Gruppe))
    {
        <h2 class="mv-gruppe">@gruppe.Key</h2>
        <div class="mv-kort">
            @foreach (var v in gruppe)
            {
                <a class="mv-rad" href="@v.Lenke">
                    <span class="mv-ik"><Icon Name="@v.Ikon" /></span>
                    <span class="mv-tekst"><b>@v.Navn</b><small>@v.Under</small></span>
                    <span class="mv-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
        </div>
    }
    @if (!Verktoy.Any(Passer))
    {
        <p class="ma-tom">Ingen verktøy passer søket.</p>
    }
</div>

@code {
    private sealed record Verktoyet(string Gruppe, string Navn, string Under, string Ikon, string Lenke);

    private static readonly List<Verktoyet> Verktoy =
    [
        new("Ute hos kunden", "Befaring", "Dører, behov, bilder og notater", "clipboard", "/befaringsliste"),
        new("Ute hos kunden", "Utskifting av lås", "Mål opp døra og få forslag", "lock", "/lasutskifting"),
        new("Ute hos kunden", "Utskifting av låskasse", "Hva passer i stedet?", "box", "/lasekasse-utskiftning"),
        new("Ute hos kunden", "ABC-kalkulator", "Sylinder, forlenger og skilt", "check-circle", "/abc-kalkulator"),
        new("System og dokumentasjon", "Systemregister", "Låssystemer og nøkler", "shield", "/systemregister"),
        new("System og dokumentasjon", "Koblingsskjema", "Skjema per system", "trend-up", "/guide/kobling"),
        new("System og dokumentasjon", "Oppsett adgangskontroll", "Steg-for-steg guider", "list", "/guide/oppsett-adgangskontroll"),
        new("System og dokumentasjon", "Dørmiljø", "Skisser av vanlige dørløsninger", "door", "/dormiljo")
    ];

    private string _sok = "";

    private bool Passer(Verktoyet v) =>
        string.IsNullOrWhiteSpace(_sok) || $"{v.Navn} {v.Under}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase);
}
