@page "/app/oppsett"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@inject ApplicationDbContext Db

<PageTitle>Oppsett adgangskontroll</PageTitle>

@* Guiden «Oppsett adgangskontroll» i montørappen. Hver linje i guiden blir
   et steg man kan hake av mens man jobber (lagres ikke – bare til hjelp på
   stedet). Overskrifter (linjer som slutter med kolon) blir mellomtitler.
   Innholdet redigeres i portalen. *@
<div class="ma mv">
    <AppHode Ikon="list" Sand="true" Tittel="Oppsett adgangskontroll" Under="@(_linjer.Count(l => !l.Overskrift) is var n && n > 0 ? $"{_ferdig.Count} av {n} steg gjort" : "Steg-for-steg guide")" Tilbake="/app/verktoy" />

    @if (!_lastet)
    {
        <p class="ma-tom">Laster …</p>
    }
    else if (_linjer.Count == 0)
    {
        <p class="ma-tom">Guiden er ikke skrevet ennå. Den legges inn under Guider i portalen.</p>
    }
    else
    {
        <div class="mv-kort" style="margin-top:0.9rem">
            @for (var i = 0; i < _linjer.Count; i++)
            {
                var nr = i;
                var l = _linjer[i];
                if (l.Overskrift)
                {
                    <div class="mop-overskrift">@l.Tekst</div>
                }
                else
                {
                    var ok = _ferdig.Contains(nr);
                    <button type="button" class="mv-rad mop-steg @(ok ? "ok" : "")" aria-pressed="@ok" @onclick="@(() => { if (!_ferdig.Remove(nr)) _ferdig.Add(nr); })">
                        <span class="ma-hake @(ok ? "paa" : "")">@if (ok) {<Icon Name="check" />}</span>
                        <span class="mop-tekst">@l.Tekst</span>
                    </button>
                }
            }
        </div>
        @if (_ferdig.Count > 0)
        {
            <div style="margin:0.9rem 0.75rem"><button type="button" class="ma-knapp sek" style="width:100%" @onclick="@(() => _ferdig.Clear())">Start på nytt</button></div>
        }
        @if (_sistOppdatert is { } d)
        {
            <p class="mop-meta">Sist oppdatert @d.ToLocalTime().ToString("dd.MM.yyyy")</p>
        }
    }
</div>

@code {
    private sealed record Linje(string Tekst, bool Overskrift);

    private bool _lastet;
    private DateTime? _sistOppdatert;
    private List<Linje> _linjer = [];
    private readonly HashSet<int> _ferdig = [];

    protected override async Task OnInitializedAsync()
    {
        var side = await Db.GuideSider.AsNoTracking().FirstOrDefaultAsync(g => g.Nokkel == "oppsett-adgangskontroll");
        _sistOppdatert = side?.SistOppdatert;
        _linjer = (side?.Innhold ?? "")
            .Split('\n')
            .Select(l => l.Trim().TrimStart('-', '*', '•').Trim())
            .Where(l => l.Length > 0)
            .Select(l => new Linje(l.TrimEnd(':'), l.EndsWith(':')))
            .ToList();
        _lastet = true;
    }
}
