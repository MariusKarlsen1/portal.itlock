@page "/app/kobling"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Koblingsskjema</PageTitle>

@* Koblingsskjemaene i montørappen, gruppert per kategori (system).
   Trykk på et skjema for å åpne det. *@
<div class="ma mv">
    <AppHode Ikon="trend-up" Sand="true" Tittel="Koblingsskjema" Under="Skjema per system" Tilbake="/app/verktoy" />
    <div class="mv-sok-ramme"><input type="search" class="mv-sok" placeholder="Søk skjema eller system" aria-label="Søk" @bind="_sok" @bind:event="oninput" /></div>

    @if (!_lastet)
    {
        <p class="ma-tom">Laster …</p>
    }
    else if (!Kategorier.Any())
    {
        <p class="ma-tom">@(string.IsNullOrWhiteSpace(_sok) ? "Ingen koblingsskjema er lagt inn ennå." : "Ingen skjema passer søket.")</p>
    }
    else
    {
        @foreach (var k in Kategorier)
        {
            <h2 class="mv-gruppe">@k.Navn@(string.IsNullOrWhiteSpace(k.Produsent) ? "" : " · " + k.Produsent)</h2>
            <div class="mv-kort">
                @foreach (var s in k.Skjemaer.Where(Passer).OrderBy(s => s.Navn))
                {
                    <a class="mv-rad" href="@($"/koblingsskjema/{s.Id}")">
                        <span class="mv-ik"><Icon Name="trend-up" /></span>
                        <span class="mv-tekst"><b>@s.Navn</b><small>@(string.IsNullOrWhiteSpace(s.Beskrivelse) ? (s.Versjon is { Length: > 0 } v ? "Versjon " + v : "Koblingsskjema") : s.Beskrivelse)</small></span>
                        <span class="mv-pil"><Icon Name="chevron-right" /></span>
                    </a>
                }
            </div>
        }
    }
</div>

@code {
    private bool _lastet;
    private string _sok = "";
    private List<KoblingsKategori> _kategorier = [];

    private IEnumerable<KoblingsKategori> Kategorier => _kategorier.Where(k => k.Skjemaer.Any(Passer));

    private bool Passer(KoblingsSkjema s) =>
        string.IsNullOrWhiteSpace(_sok) || $"{s.Navn} {s.Beskrivelse} {s.Kategori?.Navn} {s.Kategori?.Produsent}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // Bare de generelle skjemaene (ikke de som hører til en bestemt dør eller et prosjekt).
        _kategorier = await Db.KoblingsKategorier.AsNoTracking()
            .Include(k => k.Skjemaer.Where(s => s.ProsjektId == null && s.DorId == null))
            .OrderBy(k => k.Rekkefolge).ThenBy(k => k.Navn).ToListAsync();
        foreach (var k in _kategorier)
        {
            foreach (var s in k.Skjemaer)
            {
                s.Kategori = k;
            }
        }

        _lastet = true;
    }
}
