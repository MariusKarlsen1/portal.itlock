@page "/app/prosjekter"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Prosjekter</PageTitle>

@* Pågående prosjekter i samme oppsett som ordrelista: mine eller alle, søk,
   gruppering og sortering, «i» for info og kart. «Mine» er prosjekter der
   montøren er ansvarlig eller har en åpen ordre. *@
<div class="ma">
    <AppHode Ikon="folder" Sand="true" Tittel="Prosjekter" Under="@(_alle ? "Alle pågående prosjekter" : "Mine prosjekter")">
        <span class="ma-skille"></span>
        <a class="ma-ikonknapp" href="@($"/app/kart?prosjekter=1{(_alle ? "&alle=1" : "")}")" aria-label="Vis prosjektene på kart"><Icon Name="map" /></a>
    </AppHode>

    <div class="ma-sok">
        <button type="button" class="ma-modus @(!_alle ? "aktiv" : "")" @onclick="@(() => _alle = false)" aria-pressed="@(!_alle)" title="Mine prosjekter"><Icon Name="users" /></button>
        <button type="button" class="ma-modus @(_alle ? "aktiv" : "")" @onclick="@(() => _alle = true)" aria-pressed="@_alle" title="Alle prosjekter"><Icon Name="list" /></button>
        <input type="search" placeholder="Søk" aria-label="Søk" @bind="_sok" @bind:event="oninput" />
    </div>

    <div class="ma-filter">
        <span class="ma-trakt"><Icon Name="filter" /></span>
        <label><span>Grupper etter</span>
            <select @bind="_grupper">
                <option value="ingen">Ingen gruppering</option>
                <option value="status">Status</option>
                <option value="kunde">Kunde</option>
                <option value="leder">Prosjektleder</option>
            </select>
        </label>
        <label><span>Sorter etter</span>
            <select @bind="_sorter">
                <option value="frist">Frist</option>
                <option value="navn">Navn</option>
                <option value="fremdrift">Fremdrift</option>
            </select>
        </label>
    </div>

    <div class="ma-liste">
        @if (!_lastet)
        {
            <p class="ma-tom">Laster …</p>
        }
        else if (Liste.Count == 0)
        {
            <p class="ma-tom">@(_alle ? "Ingen pågående prosjekter passer søket." : "Du er ikke satt på noen pågående prosjekter. Trykk på listeikonet for å se alle.")</p>
        }
        else if (_grupper == "ingen")
        {
            @foreach (var p in Liste)
            {
                @Kort(p)
            }
        }
        else
        {
            @foreach (var g in Liste.GroupBy(Gruppe))
            {
                <div class="ma-gruppe">@g.Key · @g.Count()</div>
                @foreach (var p in g)
                {
                    @Kort(p)
                }
            }
        }
    </div>
    <div class="ma-bunnlinje">@Liste.Count prosjekter</div>

    @if (_info is { } i)
    {
        var rad = _prosjekter.First(r => r.Id == i.Id);
        var kontakt = !string.IsNullOrWhiteSpace(i.Kontaktperson) ? i.Kontaktperson : i.Kunde?.Kontaktperson;
        var telefon = !string.IsNullOrWhiteSpace(i.Telefon) ? i.Telefon : i.Kunde?.Telefon;
        var epost = !string.IsNullOrWhiteSpace(i.Epost) ? i.Epost : i.Kunde?.Epost;
        var adr = MontorApp.Adresse(i);
        <div class="ma-ark-bak" @onclick="@(() => _info = null)">
            <div class="ma-ark moi" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="@($"Info om prosjekt {i.Navn}")">
                <div class="ma-ark-handtak"></div>
                <h2 style="margin-bottom:.1rem">@i.Navn</h2>
                @if (adr is not null) {<p class="moi-under">@adr</p>}
                <div class="moi-innhold">
                    <section>
                        <h3>Prosjekt</h3>
                        <div class="moi-linje"><span>Status</span><b><span class="ma-merke @(i.Status == ProsjektStatus.UnderArbeid ? "gul" : "gra")">@MontorApp.ProsjektStatusKort(i.Status)</span></b></div>
                        @if (i.Prosjektleder is { } pl) {<div class="moi-linje"><span>Prosjektleder</span><b>@pl.Navn</b></div>}
                        @if (i.AnsvarligMontor is { } am) {<div class="moi-linje"><span>Ansvarlig montør</span><b>@am.Navn</b></div>}
                        @if (i.OverleveringsfristDato is { } f) {<div class="moi-linje"><span>Overlevering</span><b>@MontorApp.Dato(f)</b></div>}
                    </section>
                    <section>
                        <h3>Fremdrift</h3>
                        <div class="moi-linje"><span>Dører ferdig</span><b>@rad.Ferdige av @rad.Dorer</b></div>
                        @if (rad.Dorer > 0) {<span class="ma-fremdrift" style="display:block;margin:.2rem 0 .5rem"><i style="width:@(rad.Ferdige * 100 / rad.Dorer)%"></i></span>}
                        <div class="moi-linje"><span>Beslag montert</span><b>@_infoBeslag.Montert av @_infoBeslag.Totalt</b></div>
                        <div class="moi-linje"><span>Åpne avvik</span><b>@(rad.Avvik == 0 ? "Ingen" : rad.Avvik.ToString())</b></div>
                    </section>
                    @if (kontakt is not null || !string.IsNullOrWhiteSpace(telefon) || !string.IsNullOrWhiteSpace(epost))
                    {
                        <section>
                            <h3>Kontakt</h3>
                            @if (kontakt is not null) {<div class="moi-linje"><span>Navn</span><b>@kontakt</b></div>}
                            @if (!string.IsNullOrWhiteSpace(telefon)) {<div class="moi-linje"><span>Telefon</span><b>@telefon</b><a class="moi-knapp" href="@($"tel:{telefon}")" aria-label="Ring"><Icon Name="phone" /></a></div>}
                            @if (!string.IsNullOrWhiteSpace(epost)) {<div class="moi-linje"><span>E-post</span><b>@epost</b><a class="moi-knapp" href="@($"mailto:{epost}")" aria-label="Send e-post"><Icon Name="mail" /></a></div>}
                        </section>
                    }
                    @if (i.Kunde is { } kunde)
                    {
                        <section>
                            <h3>Kunde</h3>
                            @if (!string.IsNullOrWhiteSpace(kunde.TripletexKundenummer)) {<div class="moi-linje"><span>Kundenummer</span><b>@kunde.TripletexKundenummer</b></div>}
                            <div class="moi-linje"><span>Navn</span><b>@kunde.Navn</b></div>
                        </section>
                    }
                    @if (adr is not null)
                    {
                        <section><h3>Arbeidssted</h3><div class="moi-linje"><span>Adresse</span><b>@adr</b><a class="moi-knapp" href="@MontorApp.KartLenke(adr)" target="_blank" rel="noopener" aria-label="Naviger"><Icon Name="map-pin" /></a></div></section>
                    }
                    @if (!string.IsNullOrWhiteSpace(i.System) || !string.IsNullOrWhiteSpace(i.LasplanSystemnr))
                    {
                        <section>
                            <h3>Låssystem</h3>
                            @if (!string.IsNullOrWhiteSpace(i.System)) {<div class="moi-linje"><span>System</span><b>@i.System</b></div>}
                            @if (!string.IsNullOrWhiteSpace(i.LasplanSystemnr)) {<div class="moi-linje"><span>Systemnr.</span><b>@i.LasplanSystemnr</b></div>}
                        </section>
                    }
                    <section>
                        <h3>Arbeidsordre (@_infoOrdre.Count)</h3>
                        @if (_infoOrdre.Count == 0) {<p class="moi-tekst" style="color:var(--itlock-ink-muted)">Ingen åpne arbeidsordre på prosjektet.</p>}
                        @foreach (var a in _infoOrdre)
                        {
                            <a class="moi-vare" href="@($"/app/ordre/{a.Id}")" style="color:inherit;text-decoration:none">
                                <span><small><i class="ma-prikk ma-prikk-@MontorApp.StatusKlasse(a.Status)"></i> @a.Status.Visningsnavn()@(a.PlanlagtDato is { } d ? " · " + MontorApp.DagKort(d) : "")</small><b>@a.Id @a.Tittel</b></span>
                                <Icon Name="chevron-right" />
                            </a>
                        }
                    </section>
                </div>
                <div class="ma-under" style="grid-template-columns:1fr 1fr">
                    <button type="button" class="ma-knapp sek" @onclick="@(() => _info = null)">Lukk</button>
                    <a class="ma-knapp" href="@($"/app/prosjekt/{i.Id}")">Åpne prosjektet</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "alle")] public int? AlleQuery { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private sealed record Rad(int Id, string Navn, string? Kunde, string? Adresse, DateTime? Frist, ProsjektStatus? Status,
        string? Leder, int Dorer, int Ferdige, int Avvik, bool Min);

    private bool _lastet;
    private bool _alle;
    private string _sok = "";
    private string _grupper = "ingen";
    private string _sorter = "frist";
    private List<Rad> _prosjekter = [];
    private Prosjekt? _info;
    private List<Arbeidsordre> _infoOrdre = [];
    private (int Montert, int Totalt) _infoBeslag;

    private List<Rad> Liste
    {
        get
        {
            IEnumerable<Rad> l = _alle ? _prosjekter : _prosjekter.Where(p => p.Min);
            if (_sok.Trim() is { Length: > 0 } s)
            {
                l = l.Where(p => $"{p.Navn} {p.Kunde} {p.Adresse} {p.Leder}".Contains(s, StringComparison.CurrentCultureIgnoreCase));
            }

            l = _sorter switch
            {
                "navn" => l.OrderBy(p => p.Navn, StringComparer.CurrentCultureIgnoreCase),
                "fremdrift" => l.OrderBy(p => p.Dorer == 0 ? 1.0 : (double)p.Ferdige / p.Dorer).ThenBy(p => p.Navn),
                _ => l.OrderBy(p => p.Frist ?? DateTime.MaxValue).ThenBy(p => p.Navn)
            };
            return l.ToList();
        }
    }

    private string Gruppe(Rad p) => _grupper switch
    {
        "status" => MontorApp.ProsjektStatusKort(p.Status),
        "kunde" => p.Kunde ?? "Uten kunde",
        _ => p.Leder ?? "Uten prosjektleder"
    };

    protected override async Task OnInitializedAsync()
    {
        var brukerId = 0;
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            brukerId = id;
        }

        var medOrdre = await Db.Arbeidsordre.AsNoTracking()
            .Where(a => a.ProsjektId != null && a.AnsvarligMontorId == brukerId
                && (a.Status == ArbeidsordreStatus.Ny || a.Status == ArbeidsordreStatus.Klar || a.Status == ArbeidsordreStatus.Pagaende))
            .Select(a => a.ProsjektId!.Value).Distinct().ToListAsync();

        var liste = await Db.Prosjekter.AsNoTracking()
            .Where(p => p.Status == ProsjektStatus.UnderArbeid || p.Status == ProsjektStatus.Aktiv || p.Status == ProsjektStatus.Registrert || medOrdre.Contains(p.Id))
            .Select(p => new
            {
                p.Id, p.Navn, Kunde = p.Kunde != null ? p.Kunde.Navn : null, p.Adresse, p.Postnr, p.Sted,
                p.OverleveringsfristDato, p.AnsvarligMontorId, p.Status,
                Leder = p.Prosjektleder != null ? p.Prosjektleder.Navn : null,
                Dorer = p.Dorer.Count, Ferdige = p.Dorer.Count(d => d.Status == MontasjeStatus.FerdigMontert)
            })
            .ToListAsync();

        // Åpne avvik per prosjekt (avvik henger på dørene).
        var ider = liste.Select(p => p.Id).ToList();
        var avvik = (await Db.Avvik.AsNoTracking()
                .Where(a => a.Status == AvvikStatus.Apent && ider.Contains(a.Dor!.ProsjektId))
                .Select(a => a.Dor!.ProsjektId).ToListAsync())
            .GroupBy(x => x).ToDictionary(g => g.Key, g => g.Count());

        _prosjekter = liste
            .Select(p => new Rad(p.Id, p.Navn, p.Kunde,
                string.Join(", ", new[] { p.Adresse, $"{p.Postnr} {p.Sted}".Trim() }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } a ? a : null,
                p.OverleveringsfristDato, p.Status, p.Leder, p.Dorer, p.Ferdige, avvik.GetValueOrDefault(p.Id),
                p.AnsvarligMontorId == brukerId || medOrdre.Contains(p.Id)))
            .ToList();
        _alle = AlleQuery == 1 || !_prosjekter.Any(p => p.Min);
        _lastet = true;
    }

    // Henter det som bare trengs i info-arket: kontakt, folk, beslag og ordre.
    private async Task VisInfo(Rad r)
    {
        var p = await Db.Prosjekter.AsNoTracking().Include(x => x.Kunde).Include(x => x.Prosjektleder).Include(x => x.AnsvarligMontor)
            .FirstOrDefaultAsync(x => x.Id == r.Id);
        if (p is null)
        {
            return;
        }

        _infoOrdre = await Db.Arbeidsordre.AsNoTracking()
            .Where(a => a.ProsjektId == r.Id && (a.Status == ArbeidsordreStatus.Ny || a.Status == ArbeidsordreStatus.Klar || a.Status == ArbeidsordreStatus.Pagaende))
            .OrderBy(a => a.PlanlagtDato ?? DateTime.MaxValue).ToListAsync();
        var beslag = await Db.Dorer.AsNoTracking().Where(d => d.ProsjektId == r.Id).SelectMany(d => d.Komponenter)
            .Select(k => new { k.Antall, k.Montert }).ToListAsync();
        _infoBeslag = (beslag.Where(k => k.Montert).Sum(k => k.Antall), beslag.Sum(k => k.Antall));
        _info = p;
    }

    // «i» ligger ved siden av lenken, som på ordrelista, så trykket åpner arket.
    private RenderFragment Kort(Rad p) => @<div class="ma-kort-ramme"><a class="ma-kort" href="@($"/app/prosjekt/{p.Id}")">
        <span class="ma-kort-tekst">
            <h3>@p.Navn<em>Prosjekt</em></h3>
            <span class="ma-linje dempet"><i class="ma-prikk ma-prikk-@MontorApp.ProsjektStatusKlasse(p.Status)"></i><span>@MontorApp.ProsjektStatusKort(p.Status)@(p.Frist is { } f ? " · frist " + MontorApp.Dato(f) : "")@if (p.Avvik > 0) {<b class="ma-status-rod"> · @p.Avvik avvik</b>}</span></span>
            <span class="ma-linje"><Icon Name="users" /><span>@(p.Kunde ?? "Uten kunde")</span></span>
            @if (p.Adresse is not null)
            {
                <span class="ma-linje"><Icon Name="map-pin" /><span>@p.Adresse</span></span>
            }
            @if (p.Dorer > 0)
            {
                <span class="ma-linje dempet"><Icon Name="door" /><span>@p.Ferdige av @p.Dorer dører ferdig</span></span>
                <span class="ma-fremdrift" style="display:block"><i style="width:@(p.Ferdige * 100 / p.Dorer)%"></i></span>
            }
        </span>
    </a><button type="button" class="ma-info" @onclick="@(() => VisInfo(p))" aria-label="@($"Info om prosjekt {p.Navn}")">i</button></div>;
}
