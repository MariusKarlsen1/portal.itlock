@* Toppfeltet i montørappen: tilbake, ikon, tittel og handlinger til høyre. *@
<div class="ma-hode">
    @if (Tilbake is not null)
    {
        <a class="ma-ikonknapp" href="@Tilbake" aria-label="Tilbake"><Icon Name="chevron-left" /></a>
    }
    <span class="ma-hode-ikon"><Icon Name="@Ikon" /></span>
    <span class="ma-hode-tekst"><b>@Tittel</b>@if (!string.IsNullOrEmpty(Under)) {<small>@Under</small>}</span>
    @ChildContent
</div>

@code {
    [Parameter] public string Ikon { get; set; } = "home";
    [Parameter] public string Tittel { get; set; } = "";
    [Parameter] public string? Under { get; set; }
    [Parameter] public string? Tilbake { get; set; } = "/app";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
