@page "/app/laskasse"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services

<PageTitle>Utskifting av låskasse</PageTitle>

@* Hva passer i stedet for låsen som sitter i døra? Tast nummeret som står
   på låskassen, og se ny låskasse, skilt og sylinder. Samme tabell som i
   portalen (LasOvergangData). *@
<div class="ma mv">
    <AppHode Ikon="box" Sand="true" Tittel="Utskifting av låskasse" Under="Skriv nummeret som står på låsen" Tilbake="/app/verktoy" />

    <div class="mlk-kode">
        <span class="mlk-ik"><Icon Name="lock" /></span>
        <input type="search" inputmode="text" autocomplete="off" placeholder="F.eks. 1341 eller 565" aria-label="Nummer på låsen" @bind="_sok" @bind:event="oninput" />
    </div>

    @if (string.IsNullOrWhiteSpace(_sok))
    {
        <h2 class="mv-seksjon">Vanlige</h2>
        <div class="mv-chips" style="padding-top:0">
            @foreach (var k in new[] { "1341", "565", "2002", "4565", "D22" })
            {
                var kode = k;
                <button type="button" @onclick="@(() => _sok = kode)">@k</button>
            }
        </div>
        <p class="ma-tom" style="text-align:left;padding:1rem">Nummeret står som regel på stolpen (forkanten) av låskassen. Skriv de første tegnene, så kommer treffene.</p>
    }
    else if (Treff.Count == 0)
    {
        <p class="ma-tom">Fant ingen lås som inneholder «@_sok.Trim()». Ta bilde av låsen og send til prosjektleder.</p>
    }
    else
    {
        @foreach (var r in Treff.Take(20))
        {
            <div class="mv-resultat">
                <div class="mv-resultat-tittel">Du har @r.DuHarLas · @r.Kategori</div>
                <div class="mv-res-rad"><span>Ny låskasse</span><b>@Verdi(r.Laskasse)</b></div>
                @if (!string.IsNullOrWhiteSpace(r.Utskiftningsskilt))
                {
                    <div class="mv-res-rad"><span>Utskiftningsskilt</span><b>@r.Utskiftningsskilt</b></div>
                }
                <div class="mv-res-rad"><span>Sylinder</span><b>@Verdi(r.Sylinder)</b></div>
                @if (!string.IsNullOrWhiteSpace(r.Annet))
                {
                    <div class="mv-res-rad"><span>Annet</span><b>@r.Annet</b></div>
                }
                @if (!string.IsNullOrWhiteSpace(r.Alternativt))
                {
                    <div class="mv-res-rad"><span>Alternativt</span><b>@r.Alternativt</b></div>
                }
                @if ((r.Merknad ?? LasOvergangData.MerknadForKategori(r.Kategori)) is { } merknad)
                {
                    <p class="mlk-merknad">@merknad</p>
                }
            </div>
        }
        @if (Treff.Count > 20)
        {
            <p class="ma-tom">Viser 20 av @Treff.Count treff. Skriv flere tegn for å snevre inn.</p>
        }
    }
</div>

@code {
    private string _sok = "";

    private List<LasOvergangRad> Treff => LasOvergangData.Sok(_sok.Trim());

    private static string Verdi(string? v) => string.IsNullOrWhiteSpace(v) || v == "-" ? "–" : v;
}
