@page "/app/befaring"
@page "/app/befaring/ny"
@page "/app/befaring/{Id:int}"
@rendermode InteractiveServer
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Befaring</PageTitle>

@* Befaring i montørappen: lista over befaringer, og en enkel befaring med
   kunde, adresse og dørfelt med bilder tatt rett fra kameraet. Hele skjemaet
   (lassystem, brann, automatikk osv.) ligger i portalen. *@
<div class="ma mv">
    @if (_visListe)
    {
        <AppHode Ikon="clipboard" Sand="true" Tittel="Befaring" Under="@($"{_liste.Count(b => b.Status == BefaringStatus.Planlagt)} planlagte")" Tilbake="/app/verktoy">
            <span class="ma-skille"></span>
            <a class="ma-ikonknapp" href="/app/befaring/ny" aria-label="Ny befaring"><Icon Name="plus" /></a>
        </AppHode>
        <div class="mv-sok-ramme"><input type="search" class="mv-sok" placeholder="Søk kunde, adresse eller navn" aria-label="Søk" @bind="_sok" @bind:event="oninput" /></div>
        <div class="mv-chips">
            <button type="button" class="@(_filter == "planlagt" ? "paa" : "")" @onclick="@(() => _filter = "planlagt")">Planlagte</button>
            <button type="button" class="@(_filter == "gjennomfort" ? "paa" : "")" @onclick="@(() => _filter = "gjennomfort")">Gjennomførte</button>
            <button type="button" class="@(_filter == "alle" ? "paa" : "")" @onclick="@(() => _filter = "alle")">Alle</button>
        </div>
        @if (!_lastet)
        {
            <p class="ma-tom">Laster …</p>
        }
        else if (Filtrert.Count == 0)
        {
            <p class="ma-tom">Ingen befaringer her. Trykk + for å starte en ny.</p>
        }
        else
        {
            <div class="mv-kort" style="margin-top:0.75rem">
                @foreach (var b in Filtrert)
                {
                    <a class="mv-rad" href="@($"/app/befaring/{b.Id}")">
                        <span class="mv-ik"><Icon Name="clipboard" /></span>
                        <span class="mv-tekst">
                            <b>@(string.IsNullOrWhiteSpace(b.Kundenavn) ? b.Navn : b.Kundenavn)</b>
                            <small>@Adresse(b)</small>
                            <small>@(b.Dato is { } d ? MontorApp.DagKort(d) : "Uten dato") · @b.Dorfelt.Count dører</small>
                        </span>
                        <span class="ma-merke @(b.Status == BefaringStatus.Gjennomfort ? "gronn" : b.Status == BefaringStatus.Avlyst ? "rod" : "gra")">@b.Status.Visningsnavn()</span>
                    </a>
                }
            </div>
        }
    }
    else if (_b is not null)
    {
        <AppHode Ikon="clipboard" Sand="true" Tittel="@(Id is null ? "Ny befaring" : (string.IsNullOrWhiteSpace(_b.Kundenavn) ? _b.Navn : _b.Kundenavn))" Under="@(Adresse(_b) is { Length: > 0 } a ? a : "Fyll inn mens du går rundt")" Tilbake="/app/befaring" />

        <h2 class="mv-seksjon">Kunde og sted</h2>
        <label class="mv-felt"><span>Navn på befaringen *</span><input @bind="_b.Navn" placeholder="F.eks. Langgata 12 – adgangskontroll" /></label>
        <label class="mv-felt"><span>Kunde</span><input @bind="_b.Kundenavn" placeholder="Firma eller navn" /></label>
        <label class="mv-felt"><span>Adresse</span><input @bind="_b.Adresse" placeholder="Gate og nummer" /></label>
        <div class="mv-to">
            <label class="mv-felt"><span>Postnr</span><input @bind="_b.Postnr" inputmode="numeric" /></label>
            <label class="mv-felt"><span>Sted</span><input @bind="_b.Sted" /></label>
        </div>
        <div class="mv-to">
            <label class="mv-felt"><span>Kontaktperson</span><input @bind="_b.Kontaktperson" /></label>
            <label class="mv-felt"><span>Telefon</span><input @bind="_b.Tlf" inputmode="tel" /></label>
        </div>
        <div class="mv-to">
            <label class="mv-felt"><span>Dato</span><input type="date" @bind="_b.Dato" /></label>
            <label class="mv-felt"><span>Status</span>
                <select @bind="_b.Status">
                    <option value="@BefaringStatus.Planlagt">Planlagt</option>
                    <option value="@BefaringStatus.Gjennomfort">Gjennomført</option>
                    <option value="@BefaringStatus.Avlyst">Avlyst</option>
                </select>
            </label>
        </div>
        <label class="mv-felt"><span>Hva ønsker kunden?</span><textarea rows="3" @bind="_b.Oppdrag" placeholder="Oppdrag, ønsker og spesielle forhold"></textarea></label>

        <h2 class="mv-seksjon"><span>Dører (@_b.Dorfelt.Count)</span></h2>
        @foreach (var d in _b.Dorfelt.OrderBy(x => x.Id))
        {
            var dor = d;
            <div class="mv-kort mb-dor">
                <div class="mv-to" style="margin:0.8rem 0.8rem 0">
                    <label class="mv-felt"><span>Dør nr</span><input @bind="dor.Dornr" placeholder="F.eks. 101" /></label>
                    <label class="mv-felt"><span>Navn</span><input @bind="dor.Dornavn" placeholder="F.eks. Hovedinngang" /></label>
                </div>
                <div class="mv-to" style="margin:0 0.8rem">
                    <label class="mv-felt"><span>Dørtype</span><input @bind="dor.Dortype" placeholder="Tre, stål, alu/glass" /></label>
                    <label class="mv-felt"><span>B×H</span><input @bind="dor.BxH" placeholder="1000×2100" /></label>
                </div>
                <div class="mv-to" style="margin:0 0.8rem">
                    <label class="mv-felt"><span>Brannklasse</span><input @bind="dor.Brannklasse" placeholder="EI30, EI60 …" /></label>
                    <label class="mv-felt"><span>Slagretning</span><input @bind="dor.Slagretning" placeholder="H / V" /></label>
                </div>
                <label class="mv-felt" style="margin:0 0.8rem 0.6rem"><span>Behov og notater</span><textarea rows="2" @bind="dor.Notater" placeholder="Kortleser, motorlås, dørlukker …"></textarea></label>
                <div style="margin:0 0.8rem 0.8rem">
                    <label class="ma-knapp sek mb-kamera">
                        <Icon Name="camera" />@(_lasterBildeFor == dor.Id ? "Laster opp …" : "Ta bilde")
                        <InputFile OnChange="@(e => LastOppBilder(dor, e))" accept="image/*" capture="environment" multiple class="mb-skjult" disabled="@(dor.Id == 0)" />
                    </label>
                    @if (dor.Id == 0)
                    {
                        <small class="mb-hint">Lagre først, så kan du ta bilder av døra.</small>
                    }
                    @if (dor.Bilder.Count > 0)
                    {
                        <div class="mv-bilder">
                            @foreach (var bilde in dor.Bilder)
                            {
                                <img src="@($"/bilder/{bilde.Id}")" alt="Bilde av døra" loading="lazy" />
                            }
                        </div>
                    }
                </div>
            </div>
        }
        <div style="margin:0.75rem 0.75rem 0"><button type="button" class="ma-knapp sek" style="width:100%" @onclick="LeggTilDor"><Icon Name="plus" />Legg til dør</button></div>

        @if (_feil is not null)
        {
            <p class="ma-feil" role="alert" style="margin:0.75rem">@_feil</p>
        }
        @if (Id is not null)
        {
            <p style="margin:0.9rem 1rem 0;font-size:0.82rem"><a href="@($"/befaring/{Id}")">Åpne hele skjemaet i portalen</a> – lassystem, brann og automatikk.</p>
        }
        <div class="mv-bunn to">
            <button type="button" class="ma-knapp sek" disabled="@_lagrer" @onclick="@(() => Lagre(false))">Lagre</button>
            <button type="button" class="ma-knapp" disabled="@_lagrer" @onclick="@(() => Lagre(true))"><Icon Name="check" />Ferdig</button>
        </div>
    }
    else
    {
        <AppHode Ikon="clipboard" Sand="true" Tittel="Befaring" Tilbake="/app/befaring" />
        <p class="ma-tom">@(_lastet ? "Fant ikke befaringen." : "Laster …")</p>
    }
</div>

@code {
    // Lista og «ny» er samme side. Blazor setter ikke parametrene på nytt når
    // bare adressen endres, så vi lytter på navigeringen selv.
    protected override void OnInitialized() => Nav.LocationChanged += VedNavigering;

    private void VedNavigering(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await OnParametersSetAsync();
            StateHasChanged();
        });

    public void Dispose() => Nav.LocationChanged -= VedNavigering;

    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private bool _lastet;
    private bool _lagrer;
    private bool _visListe;
    private string _sok = "";
    private string _filter = "planlagt";
    private string? _feil;
    private string? _brukerNavn;
    private int? _lasterBildeFor;
    private List<Befaring> _liste = [];
    private Befaring? _b;

    private List<Befaring> Filtrert => _liste
        .Where(b => _filter == "alle" || (_filter == "planlagt" ? b.Status == BefaringStatus.Planlagt : b.Status == BefaringStatus.Gjennomfort))
        .Where(b => string.IsNullOrWhiteSpace(_sok) || $"{b.Navn} {b.Kundenavn} {Adresse(b)}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    private static string Adresse(Befaring b) =>
        string.Join(", ", new[] { b.Adresse, $"{b.Postnr} {b.Sted}".Trim() }.Where(s => !string.IsNullOrWhiteSpace(s)));

    protected override async Task OnParametersSetAsync()
    {
        _feil = null;
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            _brukerNavn = await Db.Brukere.Where(b => b.Id == id).Select(b => b.Navn).FirstOrDefaultAsync();
        }

        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        _visListe = Id is null && !path.EndsWith("/ny");
        if (_visListe)
        {
            _liste = await Db.Befaringer.AsNoTracking().Include(b => b.Dorfelt)
                .OrderByDescending(b => b.Dato ?? b.OpprettetDato).ToListAsync();
        }
        else if (Id is { } bid)
        {
            _b = await Db.Befaringer.Include(b => b.Dorfelt).ThenInclude(d => d.Bilder).FirstOrDefaultAsync(b => b.Id == bid);
        }
        else
        {
            _b = new Befaring { Navn = "", Dato = DateTime.Today, BefartAv = _brukerNavn, Status = BefaringStatus.Planlagt };
        }

        _lastet = true;
    }

    private void LeggTilDor()
    {
        _b?.Dorfelt.Add(new BefaringDorfelt { Dornr = (_b.Dorfelt.Count + 1).ToString() });
    }

    private async Task Lagre(bool ferdig)
    {
        if (_b is null || _lagrer)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_b.Navn))
        {
            _b.Navn = string.IsNullOrWhiteSpace(_b.Kundenavn) ? "" : $"{_b.Kundenavn} – befaring";
        }

        if (string.IsNullOrWhiteSpace(_b.Navn))
        {
            _feil = "Gi befaringen et navn eller fyll inn kunde.";
            return;
        }

        _lagrer = true;
        if (ferdig)
        {
            _b.Status = BefaringStatus.Gjennomfort;
        }

        if (_b.Id == 0)
        {
            Db.Befaringer.Add(_b);
        }

        await Db.SaveChangesAsync();
        _lagrer = false;
        if (ferdig)
        {
            Nav.NavigateTo("/app/befaring");
        }
        else if (Id is null)
        {
            Nav.NavigateTo($"/app/befaring/{_b.Id}", replace: true);
        }
    }

    // Bildene skaleres ned på serveren, som i portalen, så de ikke blir for store.
    private async Task LastOppBilder(BefaringDorfelt d, InputFileChangeEventArgs e)
    {
        _lasterBildeFor = d.Id;
        _feil = null;
        try
        {
            foreach (var fil in e.GetMultipleFiles(10))
            {
                if (!fil.ContentType.StartsWith("image/"))
                {
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var strom = fil.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await strom.CopyToAsync(buffer);
                }

                var skalert = BildeMiniatyr.Lag(buffer.ToArray(), 1600);
                if (skalert is not { } s)
                {
                    _feil = $"Kunne ikke lese «{fil.Name}» som bilde.";
                    continue;
                }

                var bilde = new BefaringDorfeltBilde { BefaringDorfeltId = d.Id, Filnavn = fil.Name, ContentType = s.ContentType, Data = s.Data };
                Db.BefaringDorfeltBilder.Add(bilde);
                d.Bilder.Add(bilde);
            }

            await Db.SaveChangesAsync();
        }
        catch (IOException)
        {
            _feil = "Bildet er for stort (maks 20 MB).";
        }
        finally
        {
            _lasterBildeFor = null;
        }
    }
}
