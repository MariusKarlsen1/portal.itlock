@page "/app/befaring"
@page "/app/befaring/ny"
@page "/app/befaring/{Id:int}"
@rendermode InteractiveServer
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Befaring</PageTitle>

@* Befaring i montørappen: lista, befaringen (kunde, sted, dato, status) og
   dørene. Hver dør har alle feltene fra portalen – dør, krav, låser (daglås
   og nattlås), dørlukker, automatikk, øvrig utstyr, bilder og notater – som
   seksjoner man åpner og lukker i stedet for faner. *@
<div class="ma mv">
    @if (_visListe)
    {
        <AppHode Ikon="clipboard" Sand="true" Tittel="Befaring" Under="@($"{_liste.Count(b => b.Status == BefaringStatus.Planlagt)} planlagte")" Tilbake="/app/verktoy">
            <span class="ma-skille"></span>
            <a class="ma-ikonknapp" href="/app/befaring/ny" aria-label="Ny befaring"><Icon Name="plus" /></a>
        </AppHode>
        <div class="mv-sok-ramme"><input type="search" class="mv-sok" placeholder="Søk kunde, adresse eller navn" aria-label="Søk" @bind="_sok" @bind:event="oninput" /></div>
        <div class="mv-chips">
            <button type="button" class="@(_filter == "planlagt" ? "paa" : "")" @onclick="@(() => _filter = "planlagt")">Planlagte</button>
            <button type="button" class="@(_filter == "gjennomfort" ? "paa" : "")" @onclick="@(() => _filter = "gjennomfort")">Gjennomførte</button>
            <button type="button" class="@(_filter == "alle" ? "paa" : "")" @onclick="@(() => _filter = "alle")">Alle</button>
        </div>
        @if (!_lastet)
        {
            <p class="ma-tom">Laster …</p>
        }
        else if (Filtrert.Count == 0)
        {
            <p class="ma-tom">Ingen befaringer her. Trykk + for å starte en ny.</p>
        }
        else
        {
            <div class="mv-kort" style="margin-top:0.75rem">
                @foreach (var b in Filtrert)
                {
                    <a class="mv-rad" href="@($"/app/befaring/{b.Id}")">
                        <span class="mv-ik"><Icon Name="clipboard" /></span>
                        <span class="mv-tekst">
                            <b>@(string.IsNullOrWhiteSpace(b.Kundenavn) ? b.Navn : b.Kundenavn)</b>
                            <small>@Adresse(b)</small>
                            <small>@(b.Dato is { } d ? MontorApp.DagKort(d) : "Uten dato") · @b.Dorfelt.Count dører</small>
                        </span>
                        <span class="ma-merke @(b.Status == BefaringStatus.Gjennomfort ? "gronn" : b.Status == BefaringStatus.Avlyst ? "rod" : "gra")">@b.Status.Visningsnavn()</span>
                    </a>
                }
            </div>
        }
    }
    else if (_b is not null && _dor is { } dor)
    {
        @* ---------- Én dør ---------- *@
        <AppHode Ikon="door" Sand="true" Tittel="@DorTittel(dor)" Under="@(string.IsNullOrWhiteSpace(_b.Kundenavn) ? _b.Navn : _b.Kundenavn)" Tilbake="@null" />
        <button type="button" class="mdm-tilbake" @onclick="LukkDor"><Icon Name="chevron-left" />Tilbake til befaringen</button>

        <details class="mbd-seksjon" open>
            <summary><span>Dør</span><small>@Utfylt(dor.Dornr, dor.Dornavn, dor.Dortype, dor.Floyer, dor.BxH, dor.Slagretning, dor.Lassystemnr) av 7</small></summary>
            <div class="mv-to">
                <label class="mv-felt"><span>Dør nr</span><input @bind="dor.Dornr" placeholder="F.eks. 101" /></label>
                <label class="mv-felt"><span>Dørnavn</span><input @bind="dor.Dornavn" placeholder="F.eks. Hovedinngang" /></label>
            </div>
            @Valg("Dørtype", dor.Dortype, v => dor.Dortype = v, "Tre", "Stål", "Alu")
            @Valg("Fløyer", dor.Floyer, v => dor.Floyer = v, "Enfløyet", "Tofløyet", "B gangdør")
            <div class="mv-to">
                <label class="mv-felt"><span>B×H</span><input @bind="dor.BxH" placeholder="1000×2100" /></label>
                <label class="mv-felt"><span>Låssystemnr</span><input @bind="dor.Lassystemnr" /></label>
            </div>
            @Valg("Slagretning", dor.Slagretning, v => dor.Slagretning = v, "Høyre", "Venstre")
        </details>

        <details class="mbd-seksjon">
            <summary><span>Krav</span><small>@Utfylt(dor.Brannkrav, dor.Brannklasse, dor.Fg, dor.Sikringsklasse, dor.Risikoklasse, dor.UniversellUtforming, dor.ApnekraftMaks30N) av 7</small></summary>
            @Valg("Brannkrav", dor.Brannkrav, v => dor.Brannkrav = v, "Ja", "Nei")
            <div class="mv-to">
                <label class="mv-felt"><span>Brannklasse</span><input @bind="dor.Brannklasse" placeholder="F.eks. B1, EI30" /></label>
                <label class="mv-felt"><span>FG/Beskytteklasse</span><input @bind="dor.Fg" /></label>
                <label class="mv-felt"><span>Sikringsklasse</span><input @bind="dor.Sikringsklasse" /></label>
                <label class="mv-felt"><span>Risikoklasse</span><input @bind="dor.Risikoklasse" /></label>
            </div>
            @Valg("Universell utforming", dor.UniversellUtforming, v => dor.UniversellUtforming = v, "Ja", "Nei")
            @Valg("Åpnekraft maks 30 N", dor.ApnekraftMaks30N, v => dor.ApnekraftMaks30N = v, "Ja", "Nei")
        </details>

        @foreach (var las in new[] { dor.Daglas, dor.Nattlas })
        {
            var l = las;
            <details class="mbd-seksjon">
                <summary><span>@l.Type</span><small>@Utfylt(l.Laskasse, l.MekSluttstykke, l.Mikrobryter, l.ElSluttstykke, l.Stolpe, l.Volt, l.Karmoverforing, l.Festelepper, l.Kabel, l.Dorvrider, l.Skilt, l.Overflate, l.Sylinder, l.DortykkelseAB, l.Magnetkontakt, l.Nodutstyr, l.AnnetUtstyr) av 17</small></summary>
                <div class="mv-to">
                    <label class="mv-felt"><span>Låskasse</span><input @bind="l.Laskasse" /></label>
                    <label class="mv-felt"><span>Sylinder</span><input @bind="l.Sylinder" /></label>
                    <label class="mv-felt"><span>Mek. sluttstykke</span><input @bind="l.MekSluttstykke" /></label>
                    <label class="mv-felt"><span>El. sluttstykke</span><input @bind="l.ElSluttstykke" /></label>
                    <label class="mv-felt"><span>Mikrobryter</span><input @bind="l.Mikrobryter" /></label>
                    <label class="mv-felt"><span>Stolpe</span><input @bind="l.Stolpe" /></label>
                    <label class="mv-felt"><span>Volt</span><input @bind="l.Volt" /></label>
                    <label class="mv-felt"><span>Karmoverføring</span><input @bind="l.Karmoverforing" /></label>
                    <label class="mv-felt"><span>Festelepper</span><input @bind="l.Festelepper" /></label>
                    <label class="mv-felt"><span>Kabel</span><input @bind="l.Kabel" /></label>
                    <label class="mv-felt"><span>Dørvrider</span><input @bind="l.Dorvrider" /></label>
                    <label class="mv-felt"><span>Skilt</span><input @bind="l.Skilt" /></label>
                    <label class="mv-felt"><span>Overflate</span><input @bind="l.Overflate" /></label>
                    <label class="mv-felt"><span>Dørtykkelse A/B</span><input @bind="l.DortykkelseAB" /></label>
                    <label class="mv-felt"><span>Magnetkontakt</span><input @bind="l.Magnetkontakt" /></label>
                    <label class="mv-felt"><span>Nødutstyr</span><input @bind="l.Nodutstyr" /></label>
                </div>
                <label class="mv-felt"><span>Annet utstyr</span><input @bind="l.AnnetUtstyr" /></label>
            </details>
        }

        <details class="mbd-seksjon">
            <summary><span>Dørlukker</span><small>@Utfylt(dor.Dorlukker, dor.ArmGlideskinne, dor.VkPlate, dor.MontasjeSideDorlukker, dor.AnnetUtstyrDorlukker) av 5</small></summary>
            <div class="mv-to">
                <label class="mv-felt"><span>Dørlukker</span><input @bind="dor.Dorlukker" /></label>
                <label class="mv-felt"><span>Arm/Glideskinne</span><input @bind="dor.ArmGlideskinne" /></label>
                <label class="mv-felt"><span>VK/plate</span><input @bind="dor.VkPlate" /></label>
                <label class="mv-felt"><span>Annet utstyr</span><input @bind="dor.AnnetUtstyrDorlukker" /></label>
            </div>
            @Valg("Montasjeside", dor.MontasjeSideDorlukker, v => dor.MontasjeSideDorlukker = v, "HS", "KS")
        </details>

        <details class="mbd-seksjon">
            <summary><span>Automatikk</span><small>@Utfylt(dor.Automatikk, dor.TrekkSkyvArm, dor.Adapter, dor.MontasjeSideAutomatikk, dor.Albuekontakter, dor.RadarSensor, dor.KabelAutomatikk, dor.UpsNodstrom, dor.Sikkerhetssensor) av 9</small></summary>
            <div class="mv-to">
                <label class="mv-felt"><span>Automatikk</span><input @bind="dor.Automatikk" /></label>
                <label class="mv-felt"><span>Trekk/skyv.arm</span><input @bind="dor.TrekkSkyvArm" /></label>
                <label class="mv-felt"><span>Adapter</span><input @bind="dor.Adapter" /></label>
                <label class="mv-felt"><span>Albuekontakter</span><input @bind="dor.Albuekontakter" /></label>
                <label class="mv-felt"><span>Radar/Sensor</span><input @bind="dor.RadarSensor" /></label>
                <label class="mv-felt"><span>Kabel</span><input @bind="dor.KabelAutomatikk" /></label>
                <label class="mv-felt"><span>UPS/Nødstrøm</span><input @bind="dor.UpsNodstrom" /></label>
                <label class="mv-felt"><span>Sikkerhetssensor</span><input @bind="dor.Sikkerhetssensor" /></label>
            </div>
            @Valg("Montasjeside", dor.MontasjeSideAutomatikk, v => dor.MontasjeSideAutomatikk = v, "HS", "KS")
        </details>

        <details class="mbd-seksjon">
            <summary><span>Øvrig utstyr</span><small>@Utfylt(dor.Magnetlas, dor.BrakettMl, dor.Panikkbeslag, dor.Handtak, dor.AnnetUtstyrOvrig) av 5</small></summary>
            <div class="mv-to">
                <label class="mv-felt"><span>Magnetlås</span><input @bind="dor.Magnetlas" /></label>
                <label class="mv-felt"><span>Brakett til ML</span><input @bind="dor.BrakettMl" /></label>
                <label class="mv-felt"><span>Panikkb./skåte</span><input @bind="dor.Panikkbeslag" /></label>
                <label class="mv-felt"><span>Håndtak</span><input @bind="dor.Handtak" /></label>
            </div>
            <label class="mv-felt"><span>Annet utstyr</span><input @bind="dor.AnnetUtstyrOvrig" /></label>
        </details>

        <details class="mbd-seksjon" open>
            <summary><span>Bilder og notater</span><small>@dor.Bilder.Count bilder</small></summary>
            <div style="margin:0 0.75rem 0.75rem">
                <label class="ma-knapp sek mb-kamera">
                    <Icon Name="camera" />@(_lasterBilder ? "Laster opp …" : "Ta bilde")
                    <InputFile OnChange="@(e => LastOppBilder(dor, e))" accept="image/*" capture="environment" multiple class="mb-skjult" />
                </label>
                @if (dor.Bilder.Count > 0)
                {
                    <div class="mv-bilder">
                        @foreach (var bilde in dor.Bilder)
                        {
                            <img src="@($"/bilder/{bilde.Id}")" alt="Bilde av døra" loading="lazy" />
                        }
                    </div>
                }
            </div>
            <label class="mv-felt"><span>Notater</span><textarea rows="3" @bind="dor.Notater" placeholder="Hva skal gjøres med døra?"></textarea></label>
        </details>

        @if (_feil is not null)
        {
            <p class="ma-feil" role="alert" style="margin:0.75rem">@_feil</p>
        }
        <div class="mv-bunn to">
            <button type="button" class="ma-knapp sek msk-rod" disabled="@_lagrer" @onclick="SlettDor">Slett døra</button>
            <button type="button" class="ma-knapp" disabled="@_lagrer" @onclick="LukkDor"><Icon Name="check" />Ferdig med døra</button>
        </div>
    }
    else if (_b is not null)
    {
        @* ---------- Befaringen ---------- *@
        <AppHode Ikon="clipboard" Sand="true" Tittel="@(_b.Id == 0 ? "Ny befaring" : (string.IsNullOrWhiteSpace(_b.Kundenavn) ? _b.Navn : _b.Kundenavn))" Under="@(Adresse(_b) is { Length: > 0 } a ? a : "Fyll inn mens du går rundt")" Tilbake="/app/befaring" />

        <h2 class="mv-seksjon">Kunde og sted</h2>
        <label class="mv-felt"><span>Navn på befaringen *</span><input @bind="_b.Navn" placeholder="F.eks. Langgata 12 – adgangskontroll" /></label>
        <label class="mv-felt"><span>Kunde</span><input @bind="_b.Kundenavn" placeholder="Firma eller navn" /></label>
        <label class="mv-felt"><span>Bygg</span><input @bind="_b.Bygg" placeholder="F.eks. Blokk A" /></label>
        <label class="mv-felt"><span>Adresse</span><input @bind="_b.Adresse" placeholder="Gate og nummer" /></label>
        <div class="mv-to">
            <label class="mv-felt"><span>Postnr</span><input @bind="_b.Postnr" inputmode="numeric" /></label>
            <label class="mv-felt"><span>Sted</span><input @bind="_b.Sted" /></label>
        </div>
        <div class="mv-to">
            <label class="mv-felt"><span>Kontaktperson</span><input @bind="_b.Kontaktperson" /></label>
            <label class="mv-felt"><span>Telefon</span><input @bind="_b.Tlf" inputmode="tel" /></label>
        </div>
        <label class="mv-felt"><span>E-post</span><input type="email" @bind="_b.Epost" /></label>
        <label class="mv-felt"><span>System nr</span><input @bind="_b.SystemNr" /></label>

        <h2 class="mv-seksjon">Når og status</h2>
        <label class="mv-felt"><span>Dato</span><input type="date" @bind="_b.Dato" /></label>
        <div class="mbd-valg" style="margin:0 0.75rem 0.75rem">
            <button type="button" class="@(_b.Status == BefaringStatus.Planlagt ? "paa" : "")" @onclick="@(() => _b.Status = BefaringStatus.Planlagt)">Planlagt</button>
            <button type="button" class="@(_b.Status == BefaringStatus.Gjennomfort ? "paa" : "")" @onclick="@(() => _b.Status = BefaringStatus.Gjennomfort)">Gjennomført</button>
            <button type="button" class="@(_b.Status == BefaringStatus.Avlyst ? "paa" : "")" @onclick="@(() => _b.Status = BefaringStatus.Avlyst)">Avlyst</button>
        </div>
        <label class="mv-felt"><span>Hva ønsker kunden?</span><textarea rows="3" @bind="_b.Oppdrag" placeholder="Oppdrag, ønsker og spesielle forhold"></textarea></label>

        <h2 class="mv-seksjon"><span>Dører (@_b.Dorfelt.Count)</span></h2>
        @if (_b.Dorfelt.Count > 0)
        {
            <div class="mv-kort">
                @foreach (var d in _b.Dorfelt.OrderBy(x => x.Id == 0 ? int.MaxValue : x.Id))
                {
                    var df = d;
                    <button type="button" class="mv-rad" @onclick="@(() => ApneDor(df))">
                        <span class="mv-ik"><Icon Name="door" /></span>
                        <span class="mv-tekst"><b>@DorTittel(d)</b><small>@DorUnder(d)</small></span>
                        <span class="mv-pil"><Icon Name="chevron-right" /></span>
                    </button>
                }
            </div>
        }
        <div style="margin:0.75rem 0.75rem 0"><button type="button" class="ma-knapp sek" style="width:100%" disabled="@_lagrer" @onclick="LeggTilDor"><Icon Name="plus" />Legg til dør</button></div>

        @if (_feil is not null)
        {
            <p class="ma-feil" role="alert" style="margin:0.75rem">@_feil</p>
        }
        @if (_b.Id != 0)
        {
            <p style="margin:0.9rem 1rem 0;font-size:0.82rem"><a href="@($"/befaring/{_b.Id}")">Åpne befaringen i portalen</a> – vedlegg og PDF.</p>
        }
        <div class="mv-bunn to">
            <button type="button" class="ma-knapp sek" disabled="@_lagrer" @onclick="@(() => Lagre(false))">Lagre</button>
            <button type="button" class="ma-knapp" disabled="@_lagrer" @onclick="@(() => Lagre(true))"><Icon Name="check" />Ferdig</button>
        </div>
    }
    else
    {
        <AppHode Ikon="clipboard" Sand="true" Tittel="Befaring" Tilbake="/app/befaring" />
        <p class="ma-tom">@(_lastet ? "Fant ikke befaringen." : "Laster …")</p>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    // Lista og «ny» er samme side. Blazor setter ikke parametrene på nytt når
    // bare adressen endres, så vi lytter på navigeringen selv.
    protected override void OnInitialized() => Nav.LocationChanged += VedNavigering;

    private void VedNavigering(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await OnParametersSetAsync();
            StateHasChanged();
        });

    public void Dispose() => Nav.LocationChanged -= VedNavigering;

    private bool _lastet;
    private bool _lagrer;
    private bool _lasterBilder;
    private bool _visListe;
    private string _sok = "";
    private string _filter = "planlagt";
    private string? _feil;
    private string? _brukerNavn;
    private List<Befaring> _liste = [];
    private Befaring? _b;
    private BefaringDorfelt? _dor;

    private List<Befaring> Filtrert => _liste
        .Where(b => _filter == "alle" || (_filter == "planlagt" ? b.Status == BefaringStatus.Planlagt : b.Status == BefaringStatus.Gjennomfort))
        .Where(b => string.IsNullOrWhiteSpace(_sok) || $"{b.Navn} {b.Kundenavn} {Adresse(b)}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    private static string Adresse(Befaring b) =>
        string.Join(", ", new[] { b.Adresse, $"{b.Postnr} {b.Sted}".Trim() }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private static string DorTittel(BefaringDorfelt d) =>
        string.Join(" · ", new[] { d.Dornr is { Length: > 0 } nr ? "Dør " + nr : null, d.Dornavn }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } t ? t : "Ny dør";

    private static string DorUnder(BefaringDorfelt d)
    {
        var deler = new[] { d.Dortype, d.Floyer, d.BxH, d.Brannklasse is { Length: > 0 } bk ? bk : null, d.Bilder.Count > 0 ? $"{d.Bilder.Count} bilder" : null }
            .Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        return deler.Count > 0 ? string.Join(" · ", deler) : "Trykk for å fylle ut";
    }

    private static int Utfylt(params string?[] verdier) => verdier.Count(v => !string.IsNullOrWhiteSpace(v));

    // Faste valg (som nedtrekkslistene i portalen) som knapper; trykk igjen for å fjerne.
    private RenderFragment Valg(string tittel, string? verdi, Action<string?> sett, params string[] valg) => @<div class="mv-felt">
        <span>@tittel</span>
        <div class="mbd-valg">
            @foreach (var v in valg)
            {
                var alt = v;
                <button type="button" class="@(verdi == v ? "paa" : "")" @onclick="@(() => sett(verdi == alt ? null : alt))">@v</button>
            }
        </div>
    </div>;

    protected override async Task OnParametersSetAsync()
    {
        _feil = null;
        _dor = null;
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            _brukerNavn = await Db.Brukere.Where(b => b.Id == id).Select(b => b.Navn).FirstOrDefaultAsync();
        }

        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        _visListe = Id is null && !path.EndsWith("/ny");
        if (_visListe)
        {
            _liste = await Db.Befaringer.AsNoTracking().Include(b => b.Dorfelt)
                .OrderByDescending(b => b.Dato ?? b.OpprettetDato).ToListAsync();
        }
        else if (Id is { } bid)
        {
            _b = await Db.Befaringer.Include(b => b.Dorfelt).ThenInclude(d => d.Bilder)
                .Include(b => b.Dorfelt).ThenInclude(d => d.Lassystemer)
                .AsSplitQuery().FirstOrDefaultAsync(b => b.Id == bid);
        }
        else
        {
            _b = new Befaring { Navn = "", Dato = DateTime.Today, BefartAv = _brukerNavn, Status = BefaringStatus.Planlagt };
        }

        _lastet = true;
    }

    // Lagrer befaringen (og dørene). En ny befaring uten navn får navn etter kunden eller datoen.
    private async Task<bool> LagreAsync()
    {
        if (_b is null)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_b.Navn))
        {
            _b.Navn = !string.IsNullOrWhiteSpace(_b.Kundenavn) ? $"{_b.Kundenavn} – befaring"
                : !string.IsNullOrWhiteSpace(_b.Adresse) ? $"{_b.Adresse} – befaring"
                : $"Befaring {(_b.Dato ?? DateTime.Today):dd.MM.yyyy}";
        }

        if (_b.Id == 0)
        {
            Db.Befaringer.Add(_b);
        }

        await Db.SaveChangesAsync();
        return true;
    }

    private async Task Lagre(bool ferdig)
    {
        if (_b is null || _lagrer)
        {
            return;
        }

        _lagrer = true;
        var ny = _b.Id == 0;
        if (ferdig)
        {
            _b.Status = BefaringStatus.Gjennomfort;
        }

        await LagreAsync();
        _lagrer = false;
        if (ferdig)
        {
            Nav.NavigateTo("/app/befaring");
        }
        else if (ny)
        {
            Nav.NavigateTo($"/app/befaring/{_b.Id}", replace: true);
        }
    }

    // Ny dør: befaringen lagres først, så kan man ta bilder av døra med en gang.
    private async Task LeggTilDor()
    {
        if (_b is null || _lagrer)
        {
            return;
        }

        _lagrer = true;
        var dor = new BefaringDorfelt { Dornr = (_b.Dorfelt.Count + 1).ToString() };
        _b.Dorfelt.Add(dor);
        await LagreAsync();
        _lagrer = false;
        _dor = dor;
        if (Id is null)
        {
            // Befaringen er lagret: adressen oppdateres uten å laste siden på nytt,
            // så døra man nettopp la til, blir stående åpen.
            await JS.InvokeVoidAsync("history.replaceState", null, "", $"/app/befaring/{_b.Id}");
        }
    }

    private void ApneDor(BefaringDorfelt d)
    {
        _feil = null;
        _dor = d;
    }

    private async Task LukkDor()
    {
        if (_lagrer)
        {
            return;
        }

        _lagrer = true;
        await LagreAsync();
        _lagrer = false;
        _dor = null;
    }

    private async Task SlettDor()
    {
        if (_b is null || _dor is null || _lagrer)
        {
            return;
        }

        _lagrer = true;
        _b.Dorfelt.Remove(_dor);
        if (_dor.Id != 0)
        {
            Db.BefaringDorfelt.Remove(_dor);
        }

        await Db.SaveChangesAsync();
        _lagrer = false;
        _dor = null;
    }

    // Bildene skaleres ned på serveren, som i portalen, så de ikke blir for store.
    private async Task LastOppBilder(BefaringDorfelt d, InputFileChangeEventArgs e)
    {
        _lasterBilder = true;
        _feil = null;
        try
        {
            if (d.Id == 0)
            {
                await LagreAsync();
            }

            foreach (var fil in e.GetMultipleFiles(10))
            {
                if (!fil.ContentType.StartsWith("image/"))
                {
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var strom = fil.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await strom.CopyToAsync(buffer);
                }

                var skalert = BildeMiniatyr.Lag(buffer.ToArray(), 1600);
                if (skalert is not { } s)
                {
                    _feil = $"Kunne ikke lese «{fil.Name}» som bilde.";
                    continue;
                }

                d.Bilder.Add(new BefaringDorfeltBilde { BefaringDorfeltId = d.Id, Filnavn = fil.Name, ContentType = s.ContentType, Data = s.Data });
            }

            await Db.SaveChangesAsync();
        }
        catch (IOException)
        {
            _feil = "Bildet er for stort (maks 20 MB).";
        }
        finally
        {
            _lasterBilder = false;
        }
    }
}
