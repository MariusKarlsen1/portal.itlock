@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Components.Pages
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Koblingsskjemaet tegnet som i portalen, men bare til å se på: ingen
   redigering, ingen tilkoblingspunkter og ingen kabeljournal. Brukes i
   montørappen. Strekene og kablene tegnes på samme måte som i
   KoblingsSkjemaVisning, og symbolene med samme KoblingsSymbolElement. *@
@if (_skjema is not null)
{
    <div class="kl-lerret @(_skjema.VisRutenett ? "kl-rutenett" : "")" @ref="_lerret">
        <svg class="kl-streker" viewBox="0 0 100 100" preserveAspectRatio="none">
            @StrekLag("kl-km-")
            @((MarkupString)KoblingsKryss.Svg(KoblingsKryss.Linjer(_streker, KabelVifte, p => System.Text.Json.JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(p) ?? []), LerretAspekt, breddeFaktor: LinjeSkala, pxPerProsent: _pxPerProsent / _skala))
        </svg>

        @foreach (var s in _streker.Where(s => !s.ErKabel && (s.TekstStart is not null || s.TekstSlutt is not null)))
        {
            @foreach (var t in KoblingsStrekTekst.For(s, System.Text.Json.JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [], LerretAspekt))
            {
                <div class="ks-strek-tekst @t.Klasse @(KoblingsStrekTekst.ErHvit(s.Farge) ? "ks-st-hvit" : "")" style="left:@Inv(t.X)%; top:@Inv(t.Y)%; color:@KoblingsStrekTekst.Farge(s)">@t.Tekst</div>
            }
        }

        @foreach (var s in _streker.Where(KoblingsStrekTekst.HarLederTekst))
        {
            @foreach (var t in KoblingsStrekTekst.ForLedere(s, KabelVifte(s), LerretAspekt))
            {
                <div class="ks-strek-tekst @t.P.Klasse @(t.Hvit ? "ks-st-hvit" : "")" style="left:@Inv(t.P.X)%; top:@Inv(t.P.Y)%; color:@t.Farge">@t.P.Tekst</div>
            }
        }

        @foreach (var s in _streker.Where(s => s.ErKabel && !string.IsNullOrWhiteSpace(s.Navn) && !s.SkjulNavn))
        {
            if (KabelVifte(s)?.Merke is { } merke)
            {
                <div class="kl-kabel-merke" style="left:@Inv(merke.X)%; top:@Inv(merke.Y)%">@KabelEtikett(s)</div>
            }
        }

        @foreach (var symbol in _symboler)
        {
            <KoblingsSymbolElement @key="symbol.Id" Symbol="symbol" VisNavn="@_skjema.VisKomponentnavn" />
        }

        @* Kabler som skal vises helt inn til punktet tegnes oppå de komponentene. *@
        @if (_symboler.Any(x => x.KablerOver))
        {
            <svg class="kl-streker kl-over" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                    <clipPath id="kl-over-klipp" clipPathUnits="userSpaceOnUse">
                        @foreach (var k in _symboler.Where(x => x.KablerOver))
                        {
                            <rect x="@Inv(k.PosX)" y="@Inv(k.PosY)" width="@Inv(k.Bredde)" height="@Inv(k.Hoyde)" />
                        }
                    </clipPath>
                </defs>
                <g clip-path="url(#kl-over-klipp)">@StrekLag("kl-kmo-")</g>
            </svg>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int SkjemaId { get; set; }

    // Samme forhold som lerretet i portalen (16:13).
    private const double LerretAspekt = 13.0 / 16.0;

    private KoblingsSkjema? _skjema;

    // Som i editoren: størrelsen på halvmåner, prikker og linjer følger hvor
    // bred tegningen er på skjermen (zoom), så de ikke vokser når man zoomer inn.
    private ElementReference _lerret;
    private IJSObjectReference? _modul;
    private DotNetObjectReference<KoblingsLesevisning>? _ref;
    private double _pxPerProsent = KoblingsKryss.StandardPxPerProsent;
    private double _skala = 1;
    private double LinjeSkala => Math.Max(0.4, _skala);

    [JSInvokable]
    public void OnLerretBredde(double bredde)
    {
        var ny = bredde / 100;
        if (ny > 0 && Math.Abs(ny - _pxPerProsent) > _pxPerProsent * 0.03)
        {
            _pxPerProsent = ny;
            _skala = Math.Round(Math.Clamp(bredde / 1200, 0.2, 1), 3);
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_skjema is null || _ref is not null)
        {
            return;
        }
        try
        {
            _modul = await JS.InvokeAsync<IJSObjectReference>("import", "./js/koblingsskjema.js?v=36");
            _ref = DotNetObjectReference.Create(this);
            await _modul.InvokeVoidAsync("observerLerretBredde", _lerret, _ref);
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        if (_modul is not null)
        {
            try
            {
                await _modul.InvokeVoidAsync("stoppObserverLerret", _lerret);
                await _modul.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
    private List<KoblingsSymbol> _symboler = [];
    private List<KoblingsStrek> _streker = [];

    protected override async Task OnParametersSetAsync()
    {
        _skjema = await Db.KoblingsSkjemaer.AsNoTracking().FirstOrDefaultAsync(s => s.Id == SkjemaId);
        _symboler = await Db.KoblingsSymboler.AsNoTracking().Where(s => s.KoblingsSkjemaId == SkjemaId)
            .OrderBy(s => s.ZIndex).ThenBy(s => s.Id).ToListAsync();
        _streker = await Db.KoblingsStreker.AsNoTracking().Where(s => s.KoblingsSkjemaId == SkjemaId).ToListAsync();
        KoblingsTilpasning.TilpassSkjema(_symboler, _streker);
    }

    private RenderFragment StrekLag(string maskPrefiks) => __builder =>
    {
    @foreach (var s in _streker)
    {
        var vifte = KabelVifte(s);
        var maskId = maskPrefiks + s.Id;
        <g @key="s.Id">
            @if (vifte is not null)
            {
                <mask id="@maskId" maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
                    <rect x="-10" y="-10" width="120" height="120" fill="#fff" />
                    @foreach (var e in new[] { vifte.Start, vifte.Slutt })
                    {
                        <ellipse cx="@Inv(e.Senter.X)" cy="@Inv(e.Senter.Y)" rx="@Inv(e.Rx)" ry="@Inv(e.Ry)" fill="#000" />
                    }
                </mask>
                <polyline points="@Punkter(s.PunkterJson)" fill="none" stroke="@KoblingsKabel.KabelFarge" stroke-width="@Inv(7 * LinjeSkala)"
                          stroke-linejoin="round" stroke-linecap="round" mask="@($"url(#{maskId})")" vector-effect="non-scaling-stroke" />
                @foreach (var l in vifte.Ledere)
                {
                    var pts = Pts(l.Punkter);
                    @if (l.Leder.Farge == "Hvit")
                    {
                        <polyline points="@pts" fill="none" stroke="#9a948c" stroke-width="@Inv(3.6 * LinjeSkala)" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                    }
                    <polyline points="@pts" fill="none" stroke="@KoblingsKabel.Hex(l.Leder.Farge)" stroke-width="@Inv(2.2 * LinjeSkala)"
                              stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="@(l.Leder.Stiplet ? "4,3" : null)" vector-effect="non-scaling-stroke" />
                }
            }
            else
            {
                @if (KoblingsStrekTekst.ErHvit(s.Farge))
                {
                    <polyline points="@Punkter(s.PunkterJson)" fill="none" stroke="@KoblingsStrekTekst.HvitKant" stroke-width="@Inv(Math.Max(0.6, s.Tykkelse * LinjeSkala) + 1.6)"
                              stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                }
                <polyline points="@Punkter(s.PunkterJson)" fill="none" stroke="@s.Farge" stroke-width="@Inv(Math.Max(0.6, s.Tykkelse * LinjeSkala))"
                          stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="@(s.Stiplet ? "6,4" : null)" vector-effect="non-scaling-stroke" />
            }
        </g>
    }
    };

    private static string Inv(double v) => Math.Round(v, 3).ToString(CultureInfo.InvariantCulture);

    private static string Pts(List<KoblingsStrekPunkt> punkter) => string.Join(" ", punkter.Select(p => $"{Inv(p.X)},{Inv(p.Y)}"));

    private static string Punkter(string punkterJson) =>
        Pts(JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? []);

    private static KoblingsKabel.Vifte? KabelVifte(KoblingsStrek s)
    {
        if (!s.ErKabel)
        {
            return null;
        }

        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(s.PunkterJson) ?? [];
        return KoblingsKabel.LagVifte(punkter, KoblingsKabel.Les(s.LedereJson), LerretAspekt, s.LederAvstand, s.LederLengde, s.KabelMerkePlass);
    }

    private static string KabelEtikett(KoblingsStrek s) =>
        $"{s.Navn} · {(string.IsNullOrWhiteSpace(s.KabelType) ? KoblingsKabel.MalNavn(KoblingsKabel.Les(s.LedereJson)) : s.KabelType)}";
}
