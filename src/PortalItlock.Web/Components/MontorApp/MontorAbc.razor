@page "/app/abc"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]

<PageTitle>ABC-kalkulator</PageTitle>

@* ABC-kalkulatoren i montørappen. Selve kalkulatoren er den samme som i
   portalen, så tabellene for forlenger og skilt finnes bare ett sted. *@
<div class="ma mv">
    <AppHode Ikon="check-circle" Sand="true" Tittel="ABC-kalkulator" Under="Sylinder, forlenger og skilt" Tilbake="/app/verktoy" />
    <div class="mabc">
        <AbcKalkulator />
    </div>
</div>
