@page "/app/lasutskifting"
@page "/app/lasutskifting/ny"
@page "/app/lasutskifting/{Id:int}"
@rendermode InteractiveServer
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Utskifting av lås</PageTitle>

@* Sjekkliste for utskifting av lås i montørappen: samme felter og målskisse
   som i portalen. Feltet du står i lyser opp som punkt på tegningen. *@
<div class="ma mv">
    @if (_visListe)
    {
        <AppHode Ikon="lock" Sand="true" Tittel="Utskifting av lås" Under="Sjekklister med mål" Tilbake="/app/verktoy">
            <span class="ma-skille"></span>
            <a class="ma-ikonknapp" href="/app/lasutskifting/ny" aria-label="Ny sjekkliste"><Icon Name="plus" /></a>
        </AppHode>
        <div class="mv-sok-ramme"><input type="search" class="mv-sok" placeholder="Søk" aria-label="Søk" @bind="_sok" @bind:event="oninput" /></div>
        @if (!_lastet)
        {
            <p class="ma-tom">Laster …</p>
        }
        else if (Filtrert.Count == 0)
        {
            <p class="ma-tom">Ingen sjekklister ennå. Trykk + for å måle opp en dør.</p>
        }
        else
        {
            <div class="mv-kort" style="margin-top:0.9rem">
                @foreach (var l in Filtrert)
                {
                    <a class="mv-rad" href="@($"/app/lasutskifting/{l.Id}")">
                        <span class="mv-ik"><Icon Name="lock" /></span>
                        <span class="mv-tekst"><b>@l.Navn</b><small>@(l.Dato is { } d ? MontorApp.Dato(d) : "Uten dato")@(string.IsNullOrWhiteSpace(l.DorFabrikat) ? "" : $" · {l.DorFabrikat} {l.DorNummer}")</small></span>
                        <span class="ma-merke @(l.ErArkivert ? "gra" : "gronn")">@(l.ErArkivert ? "Arkivert" : "Ny")</span>
                    </a>
                }
            </div>
        }
    }
    else if (_l is not null)
    {
        <AppHode Ikon="lock" Sand="true" Tittel="@(Id is null ? "Ny sjekkliste" : _l.Navn)" Under="Mål opp døra – punktet lyser på tegningen" Tilbake="/app/lasutskifting" />

        <div class="mlu-tegning"><div class="mlu-indre">
            <img src="lasutskifting-diagram.png" alt="Målskisse: dør, karm og hengsling med punktene 1A–9 markert" />
            @foreach (var p in Punkter)
            {
                <button type="button" class="mlu-punkt @(_punkt == p.Felt ? "aktiv" : "")" style="left:@(p.X.ToString(CultureInfo.InvariantCulture))%;top:@(p.Y.ToString(CultureInfo.InvariantCulture))%" title="@p.Navn" @onclick="@(() => _punkt = p.Felt)"></button>
            }
        </div></div>
        @if (Punkter.FirstOrDefault(p => p.Felt == _punkt) is { } valgt)
        {
            <p class="mlu-valgt">@valgt.Navn</p>
        }

        <div class="mv-to" style="margin-top:0.9rem">
            <label class="mv-felt"><span>Navn *</span><input @bind="_l.Navn" placeholder="Kunde eller adresse" /></label>
            <label class="mv-felt"><span>Dato</span><input type="date" @bind="_l.Dato" /></label>
        </div>

        <h2 class="mv-seksjon">Dør</h2>
        <div class="mv-to">
            @Felt("1A", "Total (mm)", () => _l.TotalMm, v => _l.TotalMm = v, "decimal")
            @Felt("1B", "Utside (mm)", () => _l.UtsideMm, v => _l.UtsideMm = v, "decimal")
            @Felt("1C", "Innside (mm)", () => _l.InnsideMm, v => _l.InnsideMm = v, "decimal")
            @Felt("2", "Dørkant–senter skilt (mm)", () => _l.AvstandDorkantTilSkiltMm, v => _l.AvstandDorkantTilSkiltMm = v, "decimal")
            @Felt("3", "Fabrikat (lås)", () => _l.DorFabrikat, v => _l.DorFabrikat = v, "text")
            @Felt("3", "Nummer (lås)", () => _l.DorNummer, v => _l.DorNummer = v, "text")
            @Felt("4", "Stolpehøyde", () => _l.Stolpehoyde, v => _l.Stolpehoyde = v, "text")
            @Felt("5", "Stolpebredde", () => _l.Stolpebredde, v => _l.Stolpebredde = v, "text")
        </div>
        <label class="mv-felt" @onfocusin="@(() => _punkt = "6")"><span>6 · Overflatebehandling</span>
            <select @bind="_l.Overflatebehandling">
                <option value="">Velg</option>
                <option value="Forniklet">Forniklet</option>
                <option value="Messing">Messing</option>
                <option value="Oksidert">Oksidert</option>
                <option value="Annet">Annet</option>
            </select>
        </label>
        @if (_l.Overflatebehandling == "Annet")
        {
            <label class="mv-felt"><span>Spesifiser overflatebehandling</span><input @bind="_l.OverflatebehandlingAnnet" /></label>
        }

        <h2 class="mv-seksjon">Karm</h2>
        <div class="mv-to">
            @Felt("7", "Fabrikat (karm)", () => _l.KarmFabrikat, v => _l.KarmFabrikat = v, "text")
            @Felt("7", "Nummer (karm)", () => _l.KarmNummer, v => _l.KarmNummer = v, "text")
            @Felt("8", "Avstand", () => _l.KarmAvstand, v => _l.KarmAvstand = v, "text")
            <label class="mv-felt" @onfocusin="@(() => _punkt = "9")"><span>9 · Skruer?</span>
                <select @bind="_l.Skruer"><option value="">Velg</option><option value="Ja">Ja</option><option value="Nei">Nei</option></select>
            </label>
        </div>

        <h2 class="mv-seksjon">Hengsling av dør</h2>
        <div style="margin:0 0.75rem 0.75rem" @onfocusin="@(() => _punkt = "side")">
            <div class="mv-segment">
                <button type="button" class="@(_l.HengslingSide == "Venstre" ? "paa" : "")" @onclick="@(() => { _l.HengslingSide = "Venstre"; _punkt = "side"; })">Venstre</button>
                <button type="button" class="@(_l.HengslingSide == "Høyre" ? "paa" : "")" @onclick="@(() => { _l.HengslingSide = "Høyre"; _punkt = "side"; })">Høyre</button>
            </div>
        </div>
        <div style="margin:0 0.75rem 0.75rem">
            <div class="mv-segment">
                <button type="button" class="@(_l.Slagretning == "Utadslående" ? "paa" : "")" @onclick="@(() => { _l.Slagretning = "Utadslående"; _punkt = "slag"; })">Utadslående</button>
                <button type="button" class="@(_l.Slagretning == "Innadslående" ? "paa" : "")" @onclick="@(() => { _l.Slagretning = "Innadslående"; _punkt = "slag"; })">Innadslående</button>
            </div>
        </div>
        <label class="mv-felt"><span>Merknad</span><textarea rows="3" @bind="_l.Merknad"></textarea></label>

        @if (_feil is not null)
        {
            <p class="ma-feil" role="alert" style="margin:0 0.75rem">@_feil</p>
        }
        <div class="mv-bunn">
            <button type="button" class="ma-knapp" disabled="@_lagrer" @onclick="Lagre"><Icon Name="check" />Lagre sjekkliste</button>
        </div>
    }
    else
    {
        <AppHode Ikon="lock" Sand="true" Tittel="Utskifting av lås" Tilbake="/app/lasutskifting" />
        <p class="ma-tom">@(_lastet ? "Fant ikke sjekklisten." : "Laster …")</p>
    }
</div>

@code {
    // Lista og «ny» er samme side. Blazor setter ikke parametrene på nytt når
    // bare adressen endres, så vi lytter på navigeringen selv.
    protected override void OnInitialized() => Nav.LocationChanged += VedNavigering;

    private void VedNavigering(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await OnParametersSetAsync();
            StateHasChanged();
        });

    public void Dispose() => Nav.LocationChanged -= VedNavigering;

    [Parameter] public int? Id { get; set; }

    private sealed record Punkt(string Felt, string Navn, double X, double Y);

    // Samme punkter som på målskissen i portalen (prosent av bildet).
    private static readonly Punkt[] Punkter =
    [
        new("1A", "1A · Total", 21.4, 5.3),
        new("1B", "1B · Utside", 16.2, 7.95),
        new("1C", "1C · Innside", 26.5, 7.95),
        new("2", "2 · Fra dørkant til senter på skilt", 43.9, 13.2),
        new("3", "3 · Fabrikat og nummer (lås)", 21.0, 18.25),
        new("4", "4 · Stolpehøyde", 3.6, 25.65),
        new("5", "5 · Stolpebredde", 21.3, 34.5),
        new("6", "6 · Overflatebehandling", 49.7, 40.25),
        new("7", "7 · Fabrikat og nummer (karm)", 20.4, 68.35),
        new("8", "8 · Avstand", 13.9, 75.55),
        new("9", "9 · Skruer?", 20.2, 83.75),
        new("side", "Hengsling – side", 53.1, 65.15),
        new("side", "Hengsling – side", 53.1, 83.5),
        new("slag", "Slagretning", 50.8, 90.1),
        new("slag", "Slagretning", 50.8, 92.5)
    ];

    private bool _lastet;
    private bool _lagrer;
    private bool _visListe;
    private string _sok = "";
    private string? _punkt = "1A";
    private string? _feil;
    private List<LasUtskifting> _liste = [];
    private LasUtskifting? _l;

    private List<LasUtskifting> Filtrert => _liste
        .Where(l => string.IsNullOrWhiteSpace(_sok) || $"{l.Navn} {l.DorFabrikat} {l.DorNummer}".Contains(_sok.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        _visListe = Id is null && !path.EndsWith("/ny");
        if (_visListe)
        {
            _liste = await Db.LasUtskiftinger.AsNoTracking().OrderByDescending(l => l.Dato ?? l.OpprettetDato).ToListAsync();
        }
        else if (Id is { } id)
        {
            _l = await Db.LasUtskiftinger.FirstOrDefaultAsync(l => l.Id == id);
        }
        else
        {
            _l = new LasUtskifting { Navn = "", Dato = DateTime.Today };
        }

        _lastet = true;
    }

    private RenderFragment Felt(string punkt, string navn, Func<string?> hent, Action<string?> sett, string type) =>
        @<label class="mv-felt" @onfocusin="@(() => _punkt = punkt)"><span>@punkt · @navn</span><input inputmode="@type" value="@hent()" @onchange="@(e => sett(e.Value?.ToString()))" /></label>;

    private async Task Lagre()
    {
        if (_l is null || _lagrer)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_l.Navn))
        {
            _feil = "Gi sjekklisten et navn, for eksempel kunden eller adressen.";
            return;
        }

        _lagrer = true;
        if (_l.Id == 0)
        {
            Db.LasUtskiftinger.Add(_l);
        }

        await Db.SaveChangesAsync();
        _lagrer = false;
        Nav.NavigateTo("/app/lasutskifting");
    }
}
