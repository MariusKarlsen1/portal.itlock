@page "/app/ordre/{Id:int}/skjema"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Skjema</PageTitle>

@* Sjekklista på arbeidsordren i montørappen: hak av punktene som på PC.
   Avhakingen lagres med en gang, med navn og tid, og følger samme regel
   som sjekklista på arbeidsordren (LagreSjekkpunkt i ArbeidsordreSkjema). *@
<div class="ma">
    <AppHode Ikon="clipboard" Sand="true" Tittel="Skjema" Under="@(_a is null ? "" : $"{_a.Id} {_a.Tittel}")" Tilbake="@($"/app/ordre/{Id}")" />

    @if (!_lastet)
    {
        <div class="ma-liste"><p class="ma-tom">Laster …</p></div>
    }
    else if (_punkter.Count == 0)
    {
        <div class="ma-liste"><p class="ma-tom">Ordren har ingen sjekkliste. Prosjektleder legger den på i portalen.</p></div>
    }
    else
    {
        var ferdig = _punkter.Count(p => p.Fullfort);
        <div class="ma-sum" style="display:block">
            <div style="display:flex;justify-content:space-between"><span>Sjekkliste</span><span>@ferdig av @_punkter.Count</span></div>
            <span class="ma-fremdrift" style="display:block"><i style="width:@(ferdig * 100 / _punkter.Count)%"></i></span>
        </div>
        <div class="ma-liste">
            @foreach (var p in _punkter)
            {
                var punkt = p;
                <button type="button" class="ma-rad msj-rad" disabled="@(!_kanEndre)" aria-pressed="@p.Fullfort" @onclick="@(() => Veksle(punkt))">
                    <span class="ma-hake @(p.Fullfort ? "paa" : "")">@if (p.Fullfort) {<Icon Name="check" />}</span>
                    <span class="ma-rad-tekst">
                        <b>@p.Tekst</b>
                        @if (p.Fullfort && p.FullfortDato is { } d)
                        {
                            <small>@(p.FullfortAvBruker is { } b ? MontorApp.Initialer(b.Navn) + " " : "")@d.ToString("dd.MM HH:mm")</small>
                        }
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private bool _lastet;
    private bool _kanEndre;
    private int _brukerId;
    private Bruker? _bruker;
    private Arbeidsordre? _a;
    private List<ArbeidsordreSjekkpunkt> _punkter = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var u = (await AuthStateTask).User;
            if (int.TryParse(u.FindFirst("BrukerId")?.Value, out var id)) _brukerId = id;
            var rolle = Enum.TryParse<BrukerRolle>(u.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, out var r) ? r : (BrukerRolle?)null;
            _kanEndre = ModulRettigheter.KanFerdigmelde(rolle);
        }

        _bruker = await Db.Brukere.FirstOrDefaultAsync(b => b.Id == _brukerId);
        _a = await Db.Arbeidsordre.AsNoTracking().FirstOrDefaultAsync(a => a.Id == Id);
        _punkter = await Db.ArbeidsordreSjekkpunkter.Include(p => p.FullfortAvBruker)
            .Where(p => p.ArbeidsordreId == Id).OrderBy(p => p.Rekkefolge).ThenBy(p => p.Id).ToListAsync();
        _lastet = true;
    }

    private async Task Veksle(ArbeidsordreSjekkpunkt p)
    {
        if (!_kanEndre)
        {
            return;
        }

        p.Fullfort = !p.Fullfort;
        p.Resultat = p.Fullfort ? SjekkpunktResultat.Ok : null;
        p.FullfortDato = p.Fullfort ? DateTime.Now : null;
        p.FullfortAvBrukerId = p.Fullfort ? _brukerId : null;
        p.FullfortAvBruker = p.Fullfort ? _bruker : null;
        await Db.SaveChangesAsync();
    }
}
