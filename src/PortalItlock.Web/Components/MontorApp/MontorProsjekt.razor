@page "/app/prosjekt/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Prosjekt</PageTitle>

@* Ett prosjekt i montørappen: fremdrift, adresse og kontakt, og snarveier til
   dører (avhaking), arbeidsordre, plukkliste og prosjektkortet. *@
<div class="ma">
    <AppHode Ikon="folder" Tittel="@(_p?.Navn ?? "Prosjekt")" Under="@_p?.Kunde?.Navn" Tilbake="/app/prosjekter" />

    @if (!_lastet)
    {
        <div class="ma-liste"><p class="ma-tom">Laster …</p></div>
    }
    else if (_p is null)
    {
        <div class="ma-liste"><p class="ma-tom">Fant ikke prosjektet.</p></div>
    }
    else
    {
        var pst = _dorer == 0 ? 0 : _ferdige * 100 / _dorer;
        <div class="ma-sum"><span><Icon Name="door" />Ferdig montert</span><span>@_ferdige av @_dorer (@pst %)</span></div>
        <div style="background:var(--itlock-surface);padding:0 .9rem .8rem;border:1px solid var(--itlock-border);border-top:0">
            <span class="ma-fremdrift" style="display:block;margin-top:0"><i style="width:@(pst)%"></i></span>
        </div>

        <div class="ma-liste">
            @if (MontorApp.Adresse(_p) is { } adr)
            {
                <a class="ma-rad" href="@MontorApp.KartLenke(adr)" target="_blank" rel="noopener">
                    <Icon Name="map-pin" /><span class="ma-rad-tekst"><small>Adresse</small><b>@adr</b></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
            @if (_p.OverleveringsfristDato is { } f)
            {
                <div class="ma-rad" style="cursor:default">
                    <Icon Name="calendar" /><span class="ma-rad-tekst"><small>Overleveringsfrist</small><b class="@(f < DateTime.Today ? "ma-status-rod" : "")">@MontorApp.Dato(f)</b></span>
                </div>
            }

            <div class="ma-gruppe">Jobben</div>
            <a class="ma-rad" href="@($"/app/dorer/{Id}?tilbake=/app/prosjekt/{Id}")">
                <Icon Name="door" /><span class="ma-rad-tekst"><b>Dører</b><small>Huk av ferdig monterte dører</small></span><span class="ma-boks">@_dorer</span><span class="ma-pil"><Icon Name="chevron-right" /></span>
            </a>
            @foreach (var a in _ordre)
            {
                <a class="ma-rad" href="@($"/app/ordre/{a.Id}")">
                    <Icon Name="tool" /><span class="ma-rad-tekst"><b>@a.Id @a.Tittel</b><small><i class="ma-prikk ma-prikk-@MontorApp.StatusKlasse(a.Status)"></i> @a.Status.Visningsnavn()@(a.PlanlagtDato is { } d ? " · " + MontorApp.DagKort(d) : "")</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
                </a>
            }
            @if (_ordre.Count == 0)
            {
                <div class="ma-rad" style="cursor:default"><Icon Name="tool" /><span class="ma-rad-tekst"><b>Arbeidsordre</b><small>Ingen åpne ordre på prosjektet</small></span></div>
            }
            <a class="ma-rad" href="@($"/prosjekt/{Id}/plukkliste")">
                <Icon Name="box" /><span class="ma-rad-tekst"><b>Plukkliste</b><small>Varer til prosjektet</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
            </a>
            <a class="ma-rad" href="@($"/prosjekter/{Id}")">
                <Icon Name="file-text" /><span class="ma-rad-tekst"><b>Prosjektkortet</b><small>Tegninger, dokumenter, CE og avvik</small></span><span class="ma-pil"><Icon Name="chevron-right" /></span>
            </a>

            <div class="ma-gruppe">Kontakt</div>
            @if (_p.Prosjektleder is { } pl)
            {
                <div class="ma-rad" style="cursor:default">
                    <span class="ma-boks" style="border-radius:50%">@MontorApp.Initialer(pl.Navn)</span>
                    <span class="ma-rad-tekst"><b>@pl.Navn</b><small>Prosjektleder@(string.IsNullOrWhiteSpace(pl.Stilling) || pl.Stilling == "Prosjektleder" ? "" : " · " + pl.Stilling)</small></span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_p.Kontaktperson) || !string.IsNullOrWhiteSpace(_p.Telefon))
            {
                <div class="ma-rad" style="cursor:default">
                    <span class="ma-boks" style="border-radius:50%">@MontorApp.Initialer(_p.Kontaktperson ?? "K")</span>
                    <span class="ma-rad-tekst"><b>@(_p.Kontaktperson ?? "Kontakt")</b><small>Kontaktperson hos kunden@(string.IsNullOrWhiteSpace(_p.Telefon) ? "" : " · " + _p.Telefon)</small></span>
                    @if (!string.IsNullOrWhiteSpace(_p.Telefon))
                    {
                        <a class="ma-pilknapp" href="@($"tel:{_p.Telefon}")" aria-label="Ring"><Icon Name="phone" /></a>
                    }
                </div>
            }
            @if (_p.Prosjektleder is null && string.IsNullOrWhiteSpace(_p.Kontaktperson) && string.IsNullOrWhiteSpace(_p.Telefon))
            {
                <p class="ma-tom">Ingen kontaktpersoner registrert.</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool _lastet;
    private Prosjekt? _p;
    private int _dorer;
    private int _ferdige;
    private List<Arbeidsordre> _ordre = [];

    protected override async Task OnParametersSetAsync()
    {
        _p = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder).FirstOrDefaultAsync(p => p.Id == Id);
        _dorer = await Db.Dorer.CountAsync(d => d.ProsjektId == Id);
        _ferdige = await Db.Dorer.CountAsync(d => d.ProsjektId == Id && d.Status == MontasjeStatus.FerdigMontert);
        _ordre = await Db.Arbeidsordre.AsNoTracking()
            .Where(a => a.ProsjektId == Id && (a.Status == ArbeidsordreStatus.Ny || a.Status == ArbeidsordreStatus.Klar || a.Status == ArbeidsordreStatus.Pagaende))
            .OrderBy(a => a.PlanlagtDato ?? DateTime.MaxValue).ToListAsync();
        _lastet = true;
    }
}
