@page "/app/prosjekt/{Id:int}/modell"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>3D-modell</PageTitle>

@* Prosjektets BIM-modell i montørappen: last opp IFC-fila, se bygget i 3D
   og hent dørlisten fra modellen. Samme panel som fanen «3D-modell» på
   prosjektsiden i portalen. *@
<div class="ma mv">
    <AppHode Ikon="box" Sand="true" Tittel="3D-modell" Under="@_navn" Tilbake="@($"/app/prosjekt/{Id}")" />
    <div style="padding:0.75rem">
        <BimModellPanel ProsjektId="Id" KanEndre="_kanEndre" BrukerId="_brukerId" BrukerNavn="@_brukerNavn" Hoyde="55vh"
                        OnDorValgt="@(id => Nav.NavigateTo($"/app/prosjekt/{Id}?dor={id}"))" />
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private string? _navn;
    private bool _kanEndre;
    private int? _brukerId;
    private string? _brukerNavn;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var bruker = (await AuthStateTask).User;
            _brukerId = int.TryParse(bruker.FindFirst("BrukerId")?.Value, out var id) ? id : null;
            _kanEndre = ModulRettigheter.KanEndreBimModell(
                Enum.TryParse<BrukerRolle>(bruker.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, out var rolle) ? rolle : null);
        }

        _brukerNavn = _brukerId is { } bid ? await Db.Brukere.AsNoTracking().Where(b => b.Id == bid).Select(b => b.Navn).FirstOrDefaultAsync() : null;
        _navn = await Db.Prosjekter.AsNoTracking().Where(p => p.Id == Id).Select(p => p.Navn).FirstOrDefaultAsync();
    }
}
