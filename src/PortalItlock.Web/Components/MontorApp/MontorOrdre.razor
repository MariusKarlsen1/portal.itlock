@page "/app/ordre"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Prosjektleder,Montor")]
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Ordre</PageTitle>

@* Ordrelisten i montørappen: mine eller alle åpne arbeidsordre, søk,
   gruppering og sortering. Den aktive ordren ligger øverst. *@
<div class="ma">
    <AppHode Ikon="tool" Sand="true" Tittel="Ordre" Under="@(_alle ? "Alle åpne arbeidsordre" : "Mine arbeidsordre")">
        <span class="ma-skille"></span>
        <a class="ma-ikonknapp" href="@($"/app/kart{(_alle ? "?alle=1" : "")}")" aria-label="Vis ordrene på kart"><Icon Name="map" /></a>
    </AppHode>

    <div class="ma-sok">
        <button type="button" class="ma-modus @(!_alle ? "aktiv" : "")" @onclick="@(() => _alle = false)" aria-pressed="@(!_alle)" title="Mine ordre"><Icon Name="users" /></button>
        <button type="button" class="ma-modus @(_alle ? "aktiv" : "")" @onclick="@(() => _alle = true)" aria-pressed="@_alle" title="Alle ordre"><Icon Name="list" /></button>
        <input type="search" placeholder="Søk" aria-label="Søk" @bind="_sok" @bind:event="oninput" />
    </div>

    <div class="ma-filter">
        <span class="ma-trakt"><Icon Name="filter" /></span>
        <label><span>Grupper etter</span>
            <select @bind="_grupper">
                <option value="ingen">Ingen gruppering</option>
                <option value="status">Status</option>
                <option value="kunde">Kunde</option>
                <option value="prosjekt">Prosjekt</option>
            </select>
        </label>
        <label><span>Sorter etter</span>
            <select @bind="_sorter">
                <option value="dato">Dato</option>
                <option value="adresse">Adresse</option>
                <option value="nr">Ordrenr</option>
            </select>
        </label>
    </div>

    <div class="ma-liste">
        @if (!_lastet)
        {
            <p class="ma-tom">Laster …</p>
        }
        else if (Liste.Count == 0)
        {
            <p class="ma-tom">@(_alle ? "Ingen åpne arbeidsordre passer søket." : "Ingen arbeidsordre er tildelt deg. Trykk på listeikonet for å se alle.")</p>
        }
        else if (_grupper == "ingen")
        {
            @foreach (var a in Liste)
            {
                @Kort(a)
            }
        }
        else
        {
            @foreach (var g in Liste.GroupBy(Gruppe))
            {
                <div class="ma-gruppe">@g.Key · @g.Count()</div>
                @foreach (var a in g)
                {
                    @Kort(a)
                }
            }
        }
    </div>
    <div class="ma-bunnlinje">@Liste.Count ordre</div>

    @if (_info is { } i)
    {
        var kunde = i.Kunde ?? i.Prosjekt?.Kunde;
        var kontakt = !string.IsNullOrWhiteSpace(kunde?.Kontaktperson) ? kunde.Kontaktperson : i.Prosjekt?.Kontaktperson ?? kunde?.Navn;
        var telefon = !string.IsNullOrWhiteSpace(kunde?.Telefon) ? kunde.Telefon : i.Prosjekt?.Telefon;
        var epost = !string.IsNullOrWhiteSpace(kunde?.Epost) ? kunde.Epost : i.Prosjekt?.Epost;
        var adr = MontorApp.Adresse(i);
        <div class="ma-ark-bak" @onclick="@(() => _info = null)">
            <div class="ma-ark moi" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="@($"Info om ordre {i.Id}")">
                <div class="ma-ark-handtak"></div>
                <h2 style="margin-bottom:.1rem">@i.Id @i.Tittel</h2>
                @if (adr is not null) {<p class="moi-under">@adr</p>}
                <div class="moi-innhold">
                    <section>
                        <h3>Ordre</h3>
                        <div class="moi-linje"><span>Status</span><b><span class="ma-merke @(i.Status == ArbeidsordreStatus.Pagaende ? "gul" : "gra")">@i.Status.Visningsnavn()</span></b></div>
                        @if (i.Type is { } t) {<div class="moi-linje"><span>Ordretype</span><b>@t.Visningsnavn()</b></div>}
                        <div class="moi-linje"><span>Jobbansvarlig</span><b>@(i.AnsvarligMontor?.Navn ?? "Ikke tildelt")</b></div>
                        @if (i.Prosjekt?.Prosjektleder is { } pl) {<div class="moi-linje"><span>Saksbehandler</span><b>@pl.Navn</b></div>}
                        @if (i.Prosjekt is { } p) {<div class="moi-linje"><span>Prosjekt</span><b>@p.Navn</b></div>}
                    </section>
                    @if (!string.IsNullOrWhiteSpace(i.Beskrivelse))
                    {
                        <section><h3>Jobbeskrivelse</h3><p class="moi-tekst">@RikTekst.TilTekst(i.Beskrivelse)</p></section>
                    }
                    @if (kontakt is not null || telefon is not null || epost is not null)
                    {
                        <section>
                            <h3>Kontakt</h3>
                            @if (kontakt is not null) {<div class="moi-linje"><span>Navn</span><b>@kontakt</b></div>}
                            @if (!string.IsNullOrWhiteSpace(telefon)) {<div class="moi-linje"><span>Telefon</span><b>@telefon</b><a class="moi-knapp" href="@($"tel:{telefon}")" aria-label="Ring"><Icon Name="phone" /></a></div>}
                            @if (!string.IsNullOrWhiteSpace(epost)) {<div class="moi-linje"><span>E-post</span><b>@epost</b><a class="moi-knapp" href="@($"mailto:{epost}")" aria-label="Send e-post"><Icon Name="mail" /></a></div>}
                        </section>
                    }
                    @if (kunde is not null)
                    {
                        <section>
                            <h3>Kunde</h3>
                            @if (!string.IsNullOrWhiteSpace(kunde.TripletexKundenummer)) {<div class="moi-linje"><span>Kundenummer</span><b>@kunde.TripletexKundenummer</b></div>}
                            <div class="moi-linje"><span>Navn</span><b>@kunde.Navn</b></div>
                        </section>
                    }
                    @if (adr is not null)
                    {
                        <section><h3>Arbeidssted</h3><div class="moi-linje"><span>Adresse</span><b>@adr</b><a class="moi-knapp" href="@MontorApp.KartLenke(adr)" target="_blank" rel="noopener" aria-label="Naviger"><Icon Name="map-pin" /></a></div></section>
                    }
                    <section>
                        <h3>Dato og tid</h3>
                        <div class="moi-linje"><span>Fra</span><b>@(i.PlanlagtDato is { } fra ? MontorApp.DagKort(fra) + (fra.TimeOfDay > TimeSpan.Zero ? " kl. " + fra.ToString("HH:mm") : "") : "Ikke satt")</b></div>
                        @if (i.PlanlagtSlutt is { } til) {<div class="moi-linje"><span>Til</span><b>@MontorApp.DagKort(til)@(til.TimeOfDay > TimeSpan.Zero ? " kl. " + til.ToString("HH:mm") : "")</b></div>}
                        @if (i.EstimerteTimer is { } est) {<div class="moi-linje"><span>Estimert</span><b>@MontorApp.Timer(est) t</b></div>}
                    </section>
                    <section>
                        <h3>Produkter (@_infoVarer.Count)</h3>
                        @if (_infoVarer.Count == 0) {<p class="moi-tekst" style="color:var(--itlock-ink-muted)">Ingen produkter på ordren.</p>}
                        @foreach (var v in _infoVarer)
                        {
                            <div class="moi-vare"><span><small>@v.Kode</small><b>@v.Navn</b></span><span class="ma-merke @(v.Plukket ? "gronn" : "gra")">@v.Antall stk</span></div>
                        }
                    </section>
                </div>
                <div class="ma-under" style="grid-template-columns:1fr 1fr">
                    <button type="button" class="ma-knapp sek" @onclick="@(() => _info = null)">Lukk</button>
                    <a class="ma-knapp" href="@($"/app/ordre/{i.Id}")">Åpne ordren</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "alle")] public int? AlleQuery { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private bool _lastet;
    private bool _alle;
    private string _sok = "";
    private string _grupper = "ingen";
    private string _sorter = "dato";
    private int _brukerId;
    private int? _aktivId;
    private List<Arbeidsordre> _ordre = [];
    private Arbeidsordre? _info;
    private List<InfoVare> _infoVarer = [];

    private sealed record InfoVare(string? Kode, string Navn, int Antall, bool Plukket);

    // Henter det som bare trengs i info-arket: montør, prosjektleder og varer.
    private async Task VisInfo(Arbeidsordre a)
    {
        var full = await Db.Arbeidsordre.AsNoTracking()
            .Include(x => x.Kunde).Include(x => x.AnsvarligMontor)
            .Include(x => x.Prosjekt).ThenInclude(p => p!.Kunde)
            .Include(x => x.Prosjekt).ThenInclude(p => p!.Prosjektleder)
            .FirstOrDefaultAsync(x => x.Id == a.Id);
        if (full is null)
        {
            return;
        }

        var linjer = full.TilbudId is { } tid
            ? await Db.TilbudLinjer.AsNoTracking().Where(l => l.TilbudId == tid && !l.ErGruppering && l.LevertAv == LevertAv.F)
                .OrderBy(l => l.Rekkefolge).Select(l => new InfoVare(l.Component != null ? l.Component.Produktkode : null, l.Navn, l.Antall, l.Plukket)).ToListAsync()
            : [];
        var varer = await Db.ArbeidsordreVarer.AsNoTracking().Where(v => v.ArbeidsordreId == a.Id).OrderBy(v => v.Id)
            .Select(v => new InfoVare(v.Component != null ? v.Component.Produktkode : null, v.Navn, v.Antall, v.Plukket)).ToListAsync();
        _infoVarer = linjer.Concat(varer).ToList();
        _info = full;
    }

    protected override async Task OnInitializedAsync()
    {
        _alle = AlleQuery == 1;
        if (AuthStateTask is not null && int.TryParse((await AuthStateTask).User.FindFirst("BrukerId")?.Value, out var id))
        {
            _brukerId = id;
        }

        _ordre = await Db.Arbeidsordre.AsNoTracking().Include(a => a.Kunde).Include(a => a.Prosjekt).ThenInclude(p => p!.Kunde)
            .Where(a => a.Status == ArbeidsordreStatus.Ny || a.Status == ArbeidsordreStatus.Klar || a.Status == ArbeidsordreStatus.Pagaende)
            .ToListAsync();

        var mine = _ordre.Where(a => a.AnsvarligMontorId == _brukerId).ToList();
        var idag = DateTime.Today;
        _aktivId = (mine.FirstOrDefault(a => a.Status == ArbeidsordreStatus.Pagaende && a.PlanlagtDato?.Date == idag)
            ?? mine.Where(a => a.PlanlagtDato?.Date == idag).OrderBy(a => a.PlanlagtDato).FirstOrDefault()
            ?? mine.FirstOrDefault(a => a.Status == ArbeidsordreStatus.Pagaende))?.Id;
        _lastet = true;
    }

    private List<Arbeidsordre> Liste
    {
        get
        {
            IEnumerable<Arbeidsordre> l = _alle ? _ordre : _ordre.Where(a => a.AnsvarligMontorId == _brukerId);
            if (!string.IsNullOrWhiteSpace(_sok))
            {
                var s = _sok.Trim();
                l = l.Where(a => $"{a.Id} {a.Tittel} {a.Kunde?.Navn} {a.Prosjekt?.Navn} {MontorApp.Adresse(a)}".Contains(s, StringComparison.CurrentCultureIgnoreCase));
            }

            l = _sorter switch
            {
                "adresse" => l.OrderBy(a => MontorApp.Adresse(a) ?? "~"),
                "nr" => l.OrderByDescending(a => a.Id),
                _ => l.OrderBy(a => a.PlanlagtDato ?? DateTime.MaxValue).ThenByDescending(a => a.Id)
            };
            var liste = l.ToList();
            if (_aktivId is { } aktiv && liste.FirstOrDefault(a => a.Id == aktiv) is { } forst)
            {
                liste.Remove(forst);
                liste.Insert(0, forst);
            }

            return liste;
        }
    }

    private string Gruppe(Arbeidsordre a) => _grupper switch
    {
        "status" => a.Status.Visningsnavn(),
        "kunde" => a.Kunde?.Navn ?? a.Prosjekt?.Kunde?.Navn ?? "Uten kunde",
        _ => a.Prosjekt?.Navn ?? "Uten prosjekt"
    };

    // «i» ligger ved siden av lenken, ikke inni den: et trykk inne i en lenke
    // ble fanget av navigeringen og åpnet ordren i stedet for info-arket.
    private RenderFragment Kort(Arbeidsordre a) => @<div class="ma-kort-ramme"><a class="ma-kort @(a.Id == _aktivId ? "aktiv" : "")" href="@($"/app/ordre/{a.Id}")">
        <span class="ma-kort-tekst">
            <h3>@a.Id @a.Tittel<em>Ordre</em></h3>
            <span class="ma-linje dempet"><i class="ma-prikk ma-prikk-@MontorApp.StatusKlasse(a.Status)"></i><span>@a.Status.Visningsnavn()@(a.Id == _aktivId ? " · aktiv" : "")@(a.PlanlagtDato is { } d ? " · " + MontorApp.DagKort(d) + (d.TimeOfDay > TimeSpan.Zero ? " " + d.ToString("HH:mm") : "") : "")</span></span>
            <span class="ma-linje"><Icon Name="users" /><span>@(a.Kunde?.Navn ?? a.Prosjekt?.Kunde?.Navn ?? "Uten kunde")</span></span>
            @if (MontorApp.Adresse(a) is { } adr)
            {
                <span class="ma-linje"><Icon Name="map-pin" /><span>@adr</span></span>
            }
        </span>
    </a><button type="button" class="ma-info" @onclick="@(() => VisInfo(a))" aria-label="@($"Info om ordre {a.Id}")">i</button></div>;
}
