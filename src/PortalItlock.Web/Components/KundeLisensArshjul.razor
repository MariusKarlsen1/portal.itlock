@using PortalItlock.Web.Models
@using PortalItlock.Web.Services

@if (Lisenser.Count == 0)
{
    <p class="arshjul-tom">Ingen lisenser å vise i årshjulet ennå.</p>
}
else
{
    <div class="arshjul-wrap">
        <svg viewBox="0 0 220 220" class="arshjul-svg" role="img" aria-label="Årshjul for kundens lisenser">
            <circle cx="110" cy="110" r="80" class="arshjul-ring" />

            @ManedMerkerSvg()

            @{
                var (dagX1, dagY1) = PunktPa(72, VinkelForDato(DateTime.Today));
                var (dagX2, dagY2) = PunktPa(88, VinkelForDato(DateTime.Today));
            }
            <line x1="@Fmt(dagX1)" y1="@Fmt(dagY1)" x2="@Fmt(dagX2)" y2="@Fmt(dagY2)" class="arshjul-idag">
                <title>I dag (@DateTime.Today.ToString("dd.MM.yyyy"))</title>
            </line>

            @foreach (var lisens in Lisenser)
            {
                var (px, py) = PunktPa(80, VinkelForDato(lisens.UtlopsDato));
                <circle cx="@Fmt(px)" cy="@Fmt(py)" r="6" class="@("arshjul-punkt " + FargeKlasse(lisens.UtlopsDato))">
                    <title>@lisens.Navn - @lisens.UtlopsDato.ToString("dd.MM.yyyy")</title>
                </circle>
            }
        </svg>

        <ul class="arshjul-forklaring">
            <li><span class="arshjul-prikk arshjul-punkt-ok"></span> OK</li>
            <li><span class="arshjul-prikk arshjul-punkt-varsel"></span> Går ut innen @LisensVarselService.VarselFrist.Days dager</li>
            <li><span class="arshjul-prikk arshjul-punkt-utgatt"></span> Utgått</li>
        </ul>
    </div>
}

@code {
    [Parameter] public List<KundeLisens> Lisenser { get; set; } = [];

    private static readonly string[] Manednavn = ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Des"];

    private static string Fmt(double verdi) => verdi.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Bygges som rå markup fordi Razor reserverer <text>-tagnavnet for sin egen
    // literal-syntaks og ikke tillater attributter på det - SVG sin <text> må
    // derfor skrives ut som en streng i stedet for vanlig Razor-markup.
    private static MarkupString ManedMerkerSvg()
    {
        var sb = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++)
        {
            var vinkel = m * 30.0 - 90;
            var (ix, iy) = PunktPa(80, vinkel);
            var (yx, yy) = PunktPa(88, vinkel);
            var (lx, ly) = PunktPa(100, vinkel);
            sb.Append($"<line x1=\"{Fmt(ix)}\" y1=\"{Fmt(iy)}\" x2=\"{Fmt(yx)}\" y2=\"{Fmt(yy)}\" class=\"arshjul-tikk\" />");
            sb.Append($"<text x=\"{Fmt(lx)}\" y=\"{Fmt(ly)}\" class=\"arshjul-manednavn\" text-anchor=\"middle\" dominant-baseline=\"middle\">{Manednavn[m]}</text>");
        }
        return new MarkupString(sb.ToString());
    }

    // Plasserer datoen på hjulet etter måned/dag (år-uavhengig - et årshjul viser
    // hvor i året noe skjer, ikke hvilket år), med 1. januar øverst og medurs derfra.
    private static double VinkelForDato(DateTime dato)
    {
        var dagerIAret = DateTime.IsLeapYear(dato.Year) ? 366.0 : 365.0;
        var andelAvAret = (dato.DayOfYear - 1) / dagerIAret;
        return andelAvAret * 360.0 - 90.0;
    }

    private static (double X, double Y) PunktPa(double radius, double vinkelGrader)
    {
        var vinkelRad = vinkelGrader * Math.PI / 180.0;
        return (110 + radius * Math.Cos(vinkelRad), 110 + radius * Math.Sin(vinkelRad));
    }

    private static string FargeKlasse(DateTime utlopsDato) => utlopsDato.Date switch
    {
        var d when d < DateTime.Today => "arshjul-punkt-utgatt",
        var d when d <= DateTime.Today.Add(LisensVarselService.VarselFrist) => "arshjul-punkt-varsel",
        _ => "arshjul-punkt-ok"
    };
}
