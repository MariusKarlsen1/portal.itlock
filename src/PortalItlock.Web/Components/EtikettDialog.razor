@using PortalItlock.Web.Models
@inject VisningPreferanseService VisningPref

@* Lag etiketter for valgte varer (som «Lag etikett» i Tripletex). Brukes i
   komponentregisteret og i lageret. Med Beholdning kan man velge å skrive ut
   like mange etiketter som det er på lager av hver vare. *@
@if (_url is null)
{
    var utenStrekkode = Varer.Count(c => !Strekkode.HarEan(c.Gtin, c.Produktkode));
    var format = EtikettPdfService.Formater.First(f => f.Kode == _valg.Format);
    <div class="etikett-overlay" @onclick="Lukk">
        <div class="etikett-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Lag etikett">
            <div class="etikett-topp">
                <div>
                    <h2>Lag etikett</h2>
                    <span class="etikett-mut">@Varer.Count @(Varer.Count == 1 ? "vare" : "varer") · @AntallEtiketter etiketter</span>
                </div>
                <button type="button" class="ikon-btn" title="Lukk" @onclick="Lukk">✕</button>
            </div>

            <label class="etikett-felt">
                <span>Størrelse</span>
                <select @bind="_valg.Format">
                    @foreach (var f in EtikettPdfService.Formater)
                    {
                        <option value="@f.Kode">@f.Navn</option>
                    }
                </select>
            </label>

            <div class="etikett-felt">
                <span>Vis på etiketten</span>
                <div class="etikett-valg">
                    <label><input type="checkbox" @bind="_valg.Navn" /> Varenavn</label>
                    <label><input type="checkbox" @bind="_valg.Produktkode" /> Produktkode</label>
                    <label><input type="checkbox" @bind="_valg.Leverandor" /> Leverandør</label>
                    <label><input type="checkbox" @bind="_valg.PrisInklMva" /> Salgspris inkl. mva</label>
                    <label><input type="checkbox" @bind="_valg.PrisEksMva" /> Salgspris eks. mva</label>
                    <label><input type="checkbox" @bind="_valg.Strekkode" /> Strekkode (GTIN/EAN)</label>
                </div>
            </div>

            @if (Beholdning is not null)
            {
                <div class="etikett-felt">
                    <span>Antall</span>
                    <div class="etikett-valg" style="grid-template-columns:1fr">
                        <label><input type="radio" name="etikett-antall" checked="@_somPaLager" @onchange="@(() => _somPaLager = true)" /> Like mange som på lager (én per vare)</label>
                        <label><input type="radio" name="etikett-antall" checked="@(!_somPaLager)" @onchange="@(() => _somPaLager = false)" /> Fast antall per vare</label>
                    </div>
                </div>
            }

            <div class="etikett-to">
                @if (Beholdning is null || !_somPaLager)
                {
                    <label class="etikett-felt">
                        <span>Antall per vare</span>
                        <input type="number" min="1" max="500" @bind="_valg.AntallPerVare" />
                    </label>
                }
                @if (!format.ErRull)
                {
                    <label class="etikett-felt">
                        <span>Start på etikett nr.</span>
                        <input type="number" min="1" max="@format.PerSide" @bind="_valg.Start" title="For påbegynte ark: hopp over etiketter som allerede er brukt" />
                    </label>
                }
            </div>

            @if (Beholdning is not null && _somPaLager && Varer.Any(v => Beholdning.GetValueOrDefault(v.Id) <= 0))
            {
                <p class="etikett-hint">@Varer.Count(v => Beholdning.GetValueOrDefault(v.Id) <= 0) av varene har ingenting på lager og får ingen etikett.</p>
            }
            @if (_valg.Strekkode && utenStrekkode > 0)
            {
                <p class="etikett-hint">@utenStrekkode @(utenStrekkode == 1 ? "vare mangler" : "varer mangler") gyldig GTIN/EAN &ndash; der brukes Code 128 av produktkoden i stedet@(Varer.Any(c => string.IsNullOrWhiteSpace(c.Gtin) && string.IsNullOrWhiteSpace(c.Produktkode)) ? ", eller ingen strekkode" : "").</p>
            }
            @if ((_valg.PrisInklMva || _valg.PrisEksMva) && Varer.Any(c => !c.HarPris))
            {
                <p class="etikett-hint">Salgspris er veiledende pris på varen. Varer uten veiledende pris får ingen pris på etiketten.</p>
            }

            <div class="etikett-knapper">
                <button type="button" class="knapp" @onclick="Lukk">Avbryt</button>
                <button type="button" class="knapp knapp-primaer" disabled="@(AntallEtiketter == 0)" @onclick="Vis"><Icon Name="file-text" />Vis etiketter</button>
            </div>
        </div>
    </div>
}

<PdfPreviewModal Url="@_url" Tittel="Etiketter" OnClose="Lukk" />

@code {
    // Det dialogen trenger å vite om hver vare.
    public sealed record Vare(int Id, string? Gtin, string? Produktkode, bool HarPris);

    [Parameter, EditorRequired] public IReadOnlyList<Vare> Varer { get; set; } = [];
    // Antall på lager per vare-id. Når satt, kan man velge én etikett per vare på lager.
    [Parameter] public IReadOnlyDictionary<int, int>? Beholdning { get; set; }
    [Parameter] public EventCallback OnLukk { get; set; }

    private const string PrefNokkel = "etikett-valg";
    private EtikettPdfService.Valg _valg = new();
    private bool _somPaLager = true;
    private string? _url;

    private int AntallEtiketter => Beholdning is not null && _somPaLager
        ? Varer.Sum(v => Math.Clamp(Beholdning.GetValueOrDefault(v.Id), 0, 500))
        : Varer.Count * Math.Clamp(_valg.AntallPerVare, 1, 500);

    // Valgene huskes per bruker (samme nøkkel som før i komponentregisteret).
    protected override async Task OnInitializedAsync()
    {
        var deler = (await VisningPref.HentAsync(PrefNokkel, "")).Split('|');
        if (deler.Length == 7 && EtikettPdfService.Formater.Any(f => f.Kode == deler[0]))
        {
            _valg = new EtikettPdfService.Valg
            {
                Format = deler[0],
                Navn = deler[1] == "1",
                Produktkode = deler[2] == "1",
                Leverandor = deler[3] == "1",
                PrisInklMva = deler[4] == "1",
                PrisEksMva = deler[5] == "1",
                Strekkode = deler[6] == "1"
            };
        }
    }

    private Task Lukk()
    {
        _url = null;
        return OnLukk.InvokeAsync();
    }

    private async Task Vis()
    {
        static string B(bool v) => v ? "1" : "0";
        var e = _valg;
        e.AntallPerVare = Math.Clamp(e.AntallPerVare, 1, 500);
        e.Start = Math.Max(1, e.Start);
        var per = Beholdning is not null && _somPaLager
            ? "&per=" + string.Join(',', Varer.Select(v => $"{v.Id}:{Math.Clamp(Beholdning.GetValueOrDefault(v.Id), 0, 500)}"))
            : "";
        _url = $"/komponenter/etiketter/pdf?ider={string.Join(',', Varer.Select(v => v.Id))}&format={e.Format}" +
            $"&navn={B(e.Navn)}&kode={B(e.Produktkode)}&lev={B(e.Leverandor)}&inkl={B(e.PrisInklMva)}&eks={B(e.PrisEksMva)}&strek={B(e.Strekkode)}" +
            $"&antall={e.AntallPerVare}&start={e.Start}{per}&v={DateTime.UtcNow.Ticks}";
        await VisningPref.SettAsync(PrefNokkel, string.Join('|', e.Format, B(e.Navn), B(e.Produktkode), B(e.Leverandor), B(e.PrisInklMva), B(e.PrisEksMva), B(e.Strekkode)));
    }
}
