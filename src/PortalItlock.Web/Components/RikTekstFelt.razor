@using PortalItlock.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Tekstfelt med enkel formatering (sluttrapporten). Innholdet styres av
   riktekst.js etter første visning, så komponenten tegnes ikke på nytt. *@
<div class="rt @(Lav ? "rt-lav" : "")">
    @if (!Skrivebeskyttet)
    {
        <div class="rt-verktoy" role="toolbar" aria-label="Formatering">
            <button type="button" class="rt-k" title="Fet" aria-label="Fet" @onmousedown:preventDefault @onclick="@(() => Kjor("bold"))"><b>F</b></button>
            <button type="button" class="rt-k" title="Kursiv" aria-label="Kursiv" @onmousedown:preventDefault @onclick="@(() => Kjor("italic"))"><i>K</i></button>
            <button type="button" class="rt-k" title="Understrek" aria-label="Understrek" @onmousedown:preventDefault @onclick="@(() => Kjor("underline"))"><u>U</u></button>
            <span class="rt-skille"></span>
            <button type="button" class="rt-k rt-str" title="Normal tekst" @onmousedown:preventDefault @onclick="@(() => Kjor("formatBlock", "p"))">Tekst</button>
            <button type="button" class="rt-k rt-str" title="Stor tekst" @onmousedown:preventDefault @onclick="@(() => Kjor("formatBlock", "h4"))">Stor</button>
            <button type="button" class="rt-k rt-str" title="Overskrift" @onmousedown:preventDefault @onclick="@(() => Kjor("formatBlock", "h3"))">Overskrift</button>
            <span class="rt-skille"></span>
            <button type="button" class="rt-k" title="Punktliste" aria-label="Punktliste" @onmousedown:preventDefault @onclick="@(() => Kjor("insertUnorderedList"))"><Icon Name="list" /></button>
            <button type="button" class="rt-k" title="Nummerert liste" aria-label="Nummerert liste" @onmousedown:preventDefault @onclick="@(() => Kjor("insertOrderedList"))">1.</button>
        </div>
    }
    <div @ref="_felt" class="rt-felt" contenteditable="@(Skrivebeskyttet ? "false" : "true")" role="textbox" aria-multiline="true"
         aria-label="@Plassholder" data-plassholder="@Plassholder"></div>
</div>

@code {
    [Parameter] public string? Verdi { get; set; }
    [Parameter] public EventCallback<string?> VerdiChanged { get; set; }
    [Parameter] public string? Plassholder { get; set; }
    [Parameter] public bool Lav { get; set; }
    [Parameter] public bool Skrivebeskyttet { get; set; }

    private ElementReference _felt;
    private DotNetObjectReference<RikTekstFelt>? _ref;
    private bool _klar;

    protected override bool ShouldRender() => !_klar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("rikTekst.init", _felt, _ref, RikTekst.TilHtml(Verdi));
        _klar = true;
    }

    private async Task Kjor(string kommando, string? verdi = null) =>
        await JS.InvokeVoidAsync("rikTekst.kommando", _felt, kommando, verdi);

    [JSInvokable]
    public async Task Endret(string html)
    {
        var renset = RikTekst.Rens(html);
        if (renset == Verdi)
        {
            return;
        }

        Verdi = renset;
        await VerdiChanged.InvokeAsync(renset);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("rikTekst.fjern", _felt);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Siden ble bare forhåndsvist på serveren - da finnes det ikke noe JS å rydde.
        }

        _ref?.Dispose();
    }
}
