    private static readonly (string Bg, string Fg)[] Paletter =
        [("#f7ede2", "#a36a3e"), ("#e9eef6", "#2b5c8a"), ("#efeae4", "#5d4a3a"), ("#e6f1ea", "#2d7a46"), ("#f6efdf", "#a8691f"), ("#f2e8f0", "#7a4a6e")];

    public static (string Bg, string Fg) Farge(string? kategori)
    {
        var h = 0;
        foreach (var c in kategori ?? "")
        {
            h = (h * 31 + c) & 0x7fffffff;
        }

        return Paletter[h % Paletter.Length];
    }
