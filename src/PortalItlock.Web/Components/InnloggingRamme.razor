@* Felles todelt ramme for innlogging og passordsidene (/login, /sett-passord,
   /glemt-passord, /tilbakestill-passord): papirbakgrunn med hilsen og en liten
   animert scene til venstre, skjemaet (ChildContent) på hvitt til høyre.
   Scene "dor" = dør med kortleser (innlogging), "nokkel" = nøkkel som kuttes
   (passordflyten, Steg 1-3). Stil og oppførsel ligger i wwwroot/innlogging.css
   og wwwroot/innlogging.js, siden skjemaene kommer fra sidene som bruker rammen. *@

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Caveat:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="innlogging.css?v=4" />
</HeadContent>

<div class="li-side li-papir" id="liSide" data-scene="@Scene" data-steg="@Steg" data-feil="@(Feil ? "1" : null)" data-utlopt="@(Utlopt ? "1" : null)" data-enhance-nav="false">
    <div class="li-venstre">
        <a class="li-merke li-inn" href="/">
            <svg role="img" aria-label="Full Kontroll" viewBox="0 0 232 40" class="li-logo"><rect x="0" y="20" width="8" height="16" rx="2" fill="#c98a4b" /><rect x="12" y="12" width="8" height="24" rx="2" fill="#a86a3a" /><rect x="24" y="4" width="8" height="32" rx="2" fill="#7a4f33" /><text x="42" y="30" font-family="DM Sans, Arial, sans-serif" font-size="25" font-weight="700" fill="currentColor" letter-spacing="-0.5">Full Kontroll</text></svg>
            <small>Portalen for låssmed og adgangskontroll</small>
        </a>

        <div class="li-midt">
            <div class="li-hilsen">
                <h1 class="li-inn li-d1" id="liHilsen" data-tid="@(Tittel is null ? "1" : null)">@(Tittel ?? "God dag.")</h1>
                <p class="li-inn li-d2">@Ingress</p>
            </div>

            @if (Scene == "dor")
            {
                <div class="li-scene ds li-inn li-d3" id="liScene" aria-hidden="true">
                    <div class="li-status" id="dsStatus"><i></i><span id="dsStatusTekst">Låst</span></div>

                    <div class="ds-dor">
                        <div class="ds-aapning"><span class="ds-lys"></span></div>
                        <div class="ds-blad"><span class="ds-panel"></span><span class="ds-panel"></span><span class="ds-handtak"></span></div>
                    </div>
                    <div class="ds-leser"><i class="ds-led"></i></div>
                    <span class="ds-gulv"></span>

                    <div class="ds-kort" id="dsKort">
                        <span class="ds-brikke"></span>
                        <small>Nøkkelkort</small>
                        <b id="dsNavn">Velkommen</b>
                    </div>
                </div>
            }
            else
            {
                <div class="li-scene ns li-inn li-d3" id="liScene" aria-hidden="true">
                    <div class="ns-nokkel" id="nsNokkel">
                        <svg viewBox="0 0 330 130">
                            @for (var i = 0; i < 6; i++)
                            {
                                var x = 150 + i * 26;
                                var dybde = new[] { 22, 14, 28, 18, 26, 12 }[i];
                                <path class="ns-tann" data-i="@i" d="M@(x) 70 l4 @(dybde + 4) h10 l4 -@(dybde + 4)z" />
                            }
                            <path class="ns-skaft" d="M98 50 H314 a6 6 0 0 1 0 24 H98z" />
                            <circle class="ns-hode" cx="62" cy="62" r="42" />
                            <circle class="ns-hull" cx="44" cy="62" r="11" />
                        </svg>
                    </div>

                    <ol class="ns-steg">
                        <li class="@StegKlasse(1)"><i></i>Skriv inn e-posten din</li>
                        <li class="@StegKlasse(2)"><i></i>Trykk på lenken i e-posten</li>
                        <li class="@StegKlasse(3)"><i></i>Velg passord – så er du inne</li>
                    </ol>
                </div>
            }
        </div>

        <div class="li-bunn">Full Kontroll © @DateTime.Now.Year</div>
    </div>

    <div class="li-hoyre">
        <div class="li-verktoy">
            <button type="button" id="liTema" title="Bytt mellom lys og mørk modus" aria-label="Bytt tema">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            </button>
        </div>

        <div class="li-skjema li-inn li-d1">
            @if (Scene == "nokkel")
            {
                <div class="li-stegbar" aria-label="Steg @Steg av 3">
                    <span class="@(Steg >= 1 ? "paa" : null)"></span><span class="@(Steg >= 2 ? "paa" : null)"></span><span class="@(Steg >= 3 ? "paa" : null)"></span>
                    <small>Steg @Steg av 3</small>
                </div>
            }
            @ChildContent
        </div>
    </div>
</div>

<script src="innlogging.js?v=4"></script>

@code {
    /// <summary>"dor" (innlogging) eller "nokkel" (passordflyten).</summary>
    [Parameter] public string Scene { get; set; } = "dor";

    /// <summary>Hvor langt i passordflyten man er (1-3). Brukes bare av nøkkelscenen.</summary>
    [Parameter] public int Steg { get; set; } = 1;

    /// <summary>Overskrift til venstre. Null = hilsen etter tid på døgnet.</summary>
    [Parameter] public string? Tittel { get; set; }

    [Parameter] public string? Ingress { get; set; }


    /// <summary>Feil innlogging - kortleseren blinker rødt én gang.</summary>
    [Parameter] public bool Feil { get; set; }

    /// <summary>Lenken i e-posten er ugyldig eller utløpt.</summary>
    [Parameter] public bool Utlopt { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? StegKlasse(int n) => n < Steg ? "ferdig" : n == Steg ? "na" : null;
}
