@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject LagretPdfService LagretPdfService
@inject CeGodkjenningPdfService PdfService
@inject GeocodingService Geokoding
@inject IJSRuntime JS

@* CE-sertifiseringen som en rolig flyt i 9 steg: ett spørsmål per rad (spørsmål
   til venstre, svar til høyre), Ja/Nei som knapper, grensen ved hvert mål, og
   lagring hver gang noe endres. *@
@if (_notFound)
{
    <p class="form-error">Fant ikke CE-sertifiseringen. Den kan ha blitt slettet.</p>
}
else if (_ce is null)
{
    <p>Laster...</p>
}
else
{
    <div class="cw">
        <div class="cw-hode">
        <div class="cw-topp">
            <div>
                <div class="cw-eb">CE-sertifisering · NS-EN 16005</div>
                <h2>Dør @(_ce.Dornummer ?? _ce.Dor?.Dornummer)@(string.IsNullOrWhiteSpace(_ce.DorTil) ? "" : $" · {_ce.DorTil}")</h2>
                <small>@_ce.ProsjektNavn · @_ce.Sertifiseringsnummer</small>
            </div>
            <div class="cw-topp-h">
                @if (!_kanRedigereCe)
                {
                    <span class="cw-p cw-gra">Kun lesetilgang</span>
                }
                <span class="cw-p @StatusKlasse(_ce.Status)">@_ce.Status.Visningsnavn()</span>
                <button type="button" class="cw-x" title="Lukk" @onclick="Lukk"><Icon Name="x" /></button>
            </div>
        </div>

        <nav class="cw-steg">
            @for (var i = 1; i <= StegNavn.Length; i++)
            {
                var steg = i;
                var klasse = StegKlasse(steg);
                <button type="button" class="cw-s @klasse" @onclick="@(() => GaTil(steg))">
                    <i>@(klasse == "ferdig" ? "✓" : klasse == "feil" ? "!" : steg.ToString())</i>
                    <span>@StegNavn[steg - 1]</span>
                </button>
            }
        </nav>
        </div>

        <div class="cw-kropp">
            <div class="cw-inn">
                <div class="cw-tit">
                    <h3>@StegNavn[_steg - 1]</h3>
                    <p>@StegTekst[_steg - 1]</p>
                </div>

                @if (!string.IsNullOrEmpty(_feil))
                {
                    <div class="cw-varsel cw-ro"><Icon Name="alert-triangle" /><span>@_feil</span></div>
                }

                @switch (_steg)
                {
                    case 1:
                        <div class="cw-gr">
                            <h4>Kunde og prosjekt</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Kunde</span><div class="cw-k"><input class="cw-f" @bind="_ce.KundeNavn" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Kontaktperson</span><div class="cw-k"><input class="cw-f" @bind="_ce.Kontaktperson" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Prosjekt</span><div class="cw-k"><input class="cw-f" @bind="_ce.ProsjektNavn" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Arbeidsordre</span><div class="cw-k"><input class="cw-f" @bind="_ce.Arbeidsordre" @bind:after="Lagre" disabled="@Låst" placeholder="Valgfritt" /></div></div>
                                <div class="cw-r"><span class="cw-l">Serviceavtale</span><div class="cw-k">@JaNei(_ce.Serviceavtale, v => _ce.Serviceavtale = v, laast: Låst)</div></div>
                            </div>
                        </div>

                        <div class="cw-gr">
                            <h4>Bygget</h4>
                            <div class="cw-kart">
                                <div class="cw-rader cw-uten-ramme">
                                    <div class="cw-r"><span class="cw-l">Adresse</span><div class="cw-k"><input class="cw-f" @bind="_ce.Adresse" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                    <div class="cw-r"><span class="cw-l">Etasje / bygg</span><div class="cw-k"><input class="cw-f cw-kort" @bind="_ce.Etasje" @bind:after="Lagre" disabled="@Låst" placeholder="Etasje" /><input class="cw-f cw-kort" @bind="_ce.Bygg" @bind:after="Lagre" disabled="@Låst" placeholder="Bygg" /></div></div>
                                    <div class="cw-r">
                                        <span class="cw-l">Bygningskategori</span>
                                        <div class="cw-k">
                                            <select class="cw-f" @bind="_ce.Byggkategori" @bind:after="Lagre" disabled="@Låst">
                                                <option value="">Velg …</option>
                                                @foreach (var k in CeAlternativer.Byggkategorier)
                                                {
                                                    <option value="@k">@k</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="cw-r">
                                        <span class="cw-l">Risikoklasse</span>
                                        <div class="cw-k">
                                            <select class="cw-f" @bind="_ce.Risikoklasse" @bind:after="Lagre" disabled="@Låst">
                                                <option value="">Velg …</option>
                                                @foreach (var r in CeAlternativer.Risikoklasser)
                                                {
                                                    <option value="@r">@r</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="cw-kartflate">
                                    @if (_ce.Latitude.HasValue && _ce.Longitude.HasValue)
                                    {
                                        <div id="@MapElementId" class="cw-kartboks"></div>
                                    }
                                    else
                                    {
                                        <div class="cw-kart-tom">
                                            <Icon Name="map-pin" />
                                            <span>Fant ikke adressen på kartet</span>
                                            <button type="button" class="cw-kn cw-liten" @onclick="@(() => GeokodAdresseAsync())">Finn på kart</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="cw-gr">
                            <h4>Døren og gyldighet</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Dør til</span><div class="cw-k"><input class="cw-f" @bind="_ce.DorTil" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Dørnummer</span><div class="cw-k"><input class="cw-f" @bind="_ce.Dornummer" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Dør-ID<small>Hentes fra døren</small></span><div class="cw-k"><input class="cw-f cw-las" value="@(_ce.DorIdKode ?? "-")" disabled /></div></div>
                                <div class="cw-r">
                                    <span class="cw-l">Gyldig i<small>Gyldig til @_ce.GyldigTil.ToString("dd.MM.yyyy")</small></span>
                                    <div class="cw-k">
                                        <span class="cw-valg">
                                            @foreach (var m in CeAlternativer.GyldighetMånederAlternativer)
                                            {
                                                var maaneder = m;
                                                <button type="button" class="@(_ce.GyldighetMåneder == maaneder ? "cw-valgt" : "")" disabled="@Låst" @onclick="@(() => SettGyldighet(maaneder))">@maaneder mnd</button>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        break;

                    case 2:
                        <div class="cw-gr">
                            <h4>Produkt</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Produsent</span><div class="cw-k"><input class="cw-f" @bind="_ce.Produsent" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Varenavn</span><div class="cw-k"><input class="cw-f" @bind="_ce.ItemNavn" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Serienummer</span><div class="cw-k"><input class="cw-f" @bind="_ce.Serienummer" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                <div class="cw-r"><span class="cw-l">Antall / produksjonsår</span><div class="cw-k"><input class="cw-f cw-kort" type="number" @bind="_ce.Antall" @bind:after="Lagre" disabled="@Låst" placeholder="Antall" /><input class="cw-f cw-kort" type="number" @bind="_ce.ProduksjonsAar" @bind:after="Lagre" disabled="@Låst" placeholder="År" /></div></div>
                            </div>
                        </div>

                        @if (_visProdusentFelt || string.IsNullOrWhiteSpace(ProdusentLinje))
                        {
                            <div class="cw-gr">
                                <h4>Produsentens firmaopplysninger</h4>
                                <p class="cw-hint">Brukes på samsvarssertifikatet. Sett dem som standard på automatikk-varen i komponentregisteret, så slipper du å fylle inn på nytt.</p>
                                <div class="cw-rader">
                                    <div class="cw-r"><span class="cw-l">Adresse</span><div class="cw-k"><input class="cw-f" @bind="_ce.ProdusentAdresse" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                    <div class="cw-r"><span class="cw-l">Postnr / sted</span><div class="cw-k"><input class="cw-f cw-kort" @bind="_ce.ProdusentPostnr" @bind:after="Lagre" disabled="@Låst" placeholder="Postnr" /><input class="cw-f cw-kort" @bind="_ce.ProdusentSted" @bind:after="Lagre" disabled="@Låst" placeholder="Sted" /></div></div>
                                    <div class="cw-r"><span class="cw-l">Land</span><div class="cw-k"><input class="cw-f" @bind="_ce.ProdusentLand" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                    <div class="cw-r"><span class="cw-l">Org.nr</span><div class="cw-k"><input class="cw-f" @bind="_ce.ProdusentOrgnr" @bind:after="Lagre" disabled="@Låst" /></div></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="cw-varsel cw-bl">
                                <Icon Name="file-text" />
                                <span><b>Produsentens firmaopplysninger</b>@ProdusentLinje</span>
                                @if (!Låst)
                                {
                                    <button type="button" class="cw-lenke" @onclick="@(() => _visProdusentFelt = true)">Endre</button>
                                }
                            </div>
                        }

                        @TilbehorTabell("Sikkerhetstilbehør på døren", Sikkerhet, "Ingen komponenter er kategorisert som sikkerhetstilbehør på denne døren.")
                        @TilbehorTabell("Annet tilbehør", Annet, "Ingen komponenter er kategorisert som annet tilbehør på denne døren.")
                        <p class="cw-hint">Mangler noe? Sett CE-kategori på beslagstypen under CE-oppsett.</p>
                        break;

                    case 3:
                        <div class="cw-gr">
                            <h4>Mål</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Bredde hoveddør</span><div class="cw-k">@Tall(() => _ce.BreddeMm, v => _ce.BreddeMm = (int?)v, "mm", Låst)</div></div>
                                <div class="cw-r"><span class="cw-l">Dørbladhøyde</span><div class="cw-k">@Tall(() => _ce.HoydeMm, v => _ce.HoydeMm = (int?)v, "mm", Låst)</div></div>
                                <div class="cw-r"><span class="cw-l">Vekt hoveddør</span><div class="cw-k">@Tall(() => _ce.VektKg, v => _ce.VektKg = v, "kg", Låst)</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Konstruksjon</h4>
                            <div class="cw-rader">
                                <div class="cw-r">
                                    <span class="cw-l">Dørkonstruksjon</span>
                                    <div class="cw-k">
                                        <select class="cw-f" @bind="_ce.Dorkonstruksjon" @bind:after="Lagre" disabled="@Låst">
                                            <option value="">Velg …</option>
                                            @foreach (var k in CeAlternativer.Konstruksjoner)
                                            {
                                                <option value="@k">@k</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="cw-r">
                                    <span class="cw-l">Karmkonstruksjon</span>
                                    <div class="cw-k">
                                        <select class="cw-f" @bind="_ce.Karmkonstruksjon" @bind:after="Lagre" disabled="@Låst">
                                            <option value="">Velg …</option>
                                            @foreach (var k in CeAlternativer.Konstruksjoner)
                                            {
                                                <option value="@k">@k</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="cw-r"><span class="cw-l">Brannklassifisering</span><div class="cw-k"><input class="cw-f" @bind="_ce.Brannklasse" @bind:after="Lagre" disabled="@Låst" placeholder="F.eks. EI60C" /></div></div>
                                <div class="cw-r">
                                    <span class="cw-l">Glass i dør</span>
                                    <div class="cw-k">
                                        <span class="cw-valg">
                                            @foreach (var g in CeAlternativer.GlassIDorAlternativer)
                                            {
                                                var glass = g;
                                                <button type="button" class="@(_ce.GlassIDor == glass ? "cw-valgt" : "")" disabled="@Låst" @onclick="@(() => SettGlass(glass))">@glass</button>
                                            }
                                        </span>
                                    </div>
                                </div>
                                @if (_ce.GlassIDor == "Med glass")
                                {
                                    <div class="cw-r">
                                        <span class="cw-l">Glasstype</span>
                                        <div class="cw-k">
                                            <select class="cw-f" @bind="_ce.TypeAvGlass" @bind:after="Lagre" disabled="@Låst">
                                                <option value="">Velg …</option>
                                                @foreach (var g in CeAlternativer.TypeAvGlassAlternativer)
                                                {
                                                    <option value="@g">@g</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="cw-r"><span class="cw-l">Glasset har synlighetstiltak</span><div class="cw-k">@JaNei(_ce.GlassSynligTiltak, v => _ce.GlassSynligTiltak = v, feilVed: false, laast: Låst)</div></div>
                                    <div class="cw-r"><span class="cw-l">Fare for kutt og skade fra glasset</span><div class="cw-k">@JaNei(_ce.GlassFareKuttSkade, v => _ce.GlassFareKuttSkade = v, feilVed: true, laast: Låst)</div></div>
                                }
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Krav</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Fri passasjebredde minst 0,86 m</span><div class="cw-k">@JaNei(_ce.FriBredde086, v => _ce.FriBredde086 = v, feilVed: false, laast: Låst)</div></div>
                                <div class="cw-r"><span class="cw-l">Terskelhøyde under 25 mm</span><div class="cw-k">@JaNei(_ce.TerskelUnder25mm, v => _ce.TerskelUnder25mm = v, feilVed: false, laast: Låst)</div></div>
                                <div class="cw-r"><span class="cw-l">Fare for kuttskade i dørmiljøet</span><div class="cw-k">@JaNei(_ce.KuttskadeRisiko, v => _ce.KuttskadeRisiko = v, feilVed: true, laast: Låst)</div></div>
                            </div>
                        </div>
                        break;

                    case 4:
                        @foreach (var tekst in MalOverGrensen())
                        {
                            <div class="cw-varsel cw-ro"><Icon Name="alert-triangle" /><span><b>@tekst</b>Juster døren og mål på nytt, eller registrer det som avvik.</span></div>
                        }
                        <div class="cw-gr">
                            <h4>Tider og kraft</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Åpningsvinkel hoveddørblad</span><div class="cw-k">@Tall(() => _ce.Apningsvinkel, v => _ce.Apningsvinkel = v, "°")</div></div>
                                <div class="cw-r"><span class="cw-l">Åpningstid 0–80°</span><div class="cw-k">@Tall(() => _ce.ApningstidSek, v => _ce.ApningstidSek = v, "s", feil: OverGrense(_ce.ApningstidSek, _grenser.MaksApningstidSek, false))@Grense(_ce.ApningstidSek, _grenser.MaksApningstidSek, "s")</div></div>
                                <div class="cw-r"><span class="cw-l">Lukketid 90–10°</span><div class="cw-k">@Tall(() => _ce.LukketidHoySek, v => _ce.LukketidHoySek = v, "s", feil: OverGrense(_ce.LukketidHoySek, _grenser.MaksLukketidHoySek, false))@Grense(_ce.LukketidHoySek, _grenser.MaksLukketidHoySek, "s")</div></div>
                                <div class="cw-r"><span class="cw-l">Lukketid 10–0°</span><div class="cw-k">@Tall(() => _ce.LukketidLavSek, v => _ce.LukketidLavSek = v, "s", feil: OverGrense(_ce.LukketidLavSek, _grenser.MaksLukketidLavSek, false))@Grense(_ce.LukketidLavSek, _grenser.MaksLukketidLavSek, "s")</div></div>
                                <div class="cw-r"><span class="cw-l">Åpningskraft</span><div class="cw-k">@Tall(() => _ce.ApningskraftN, v => _ce.ApningskraftN = v, "N", feil: OverGrense(_ce.ApningskraftN, _grenser.MaksApningskraftN, false))@Grense(_ce.ApningskraftN, _grenser.MaksApningskraftN, "N")</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Avstander på hengselsiden</h4>
                            <div class="cw-rader">
                                <div class="cw-r">
                                    <span class="cw-l">Avstand til trapp</span>
                                    <div class="cw-k">
                                        @Tall(() => _ce.AvstandTrappCm, v => _ce.AvstandTrappCm = v, "cm", _ce.AvstandTrappUnntatt)
                                        <label class="cw-avkrysning"><input type="checkbox" @bind="_ce.AvstandTrappUnntatt" @bind:after="Lagre" /> Unntatt CE-krav</label>
                                    </div>
                                </div>
                                <div class="cw-r">
                                    <span class="cw-l">Avstand til vegg</span>
                                    <div class="cw-k">
                                        @Tall(() => _ce.AvstandVeggCm, v => _ce.AvstandVeggCm = v, "cm", _ce.AvstandVeggUnntatt)
                                        <label class="cw-avkrysning"><input type="checkbox" @bind="_ce.AvstandVeggUnntatt" @bind:after="Lagre" /> Unntatt CE-krav</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Sikkerhet ved lukking</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Dødgang etter stopp under 50 cm</span><div class="cw-k">@JaNei(_ce.DodlasEtterStopp, v => _ce.DodlasEtterStopp = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Forsinkelse før lukking minst 3 s</span><div class="cw-k">@JaNei(_ce.ForsinkelseForLukking, v => _ce.ForsinkelseForLukking = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Åpnes mot område med gjennomgangstrafikk</span><div class="cw-k">@JaNei(_ce.ApnesMotGjennomgangstrafikk, v => _ce.ApnesMotGjennomgangstrafikk = v)</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Kommentar</h4>
                            <textarea class="cw-f cw-tekst" @bind="_ce.MalKommentar" @bind:after="Lagre" placeholder="Valgfritt"></textarea>
                        </div>
                        break;

                    case 5:
                        @if (KontrollUbesvart() is var ubesvart and > 0)
                        {
                            <div class="cw-varsel cw-gu"><Icon Name="alert-triangle" /><span><b>@ubesvart @(ubesvart == 1 ? "punkt mangler" : "punkter mangler") svar</b>Svar på alle punktene før døren kan godkjennes.</span></div>
                        }
                        <div class="cw-gr">
                            <h4>Sensorer</h4>
                            <div class="cw-rader">
                                <div class="cw-r">
                                    <span class="cw-l">Dekningsområde hoveddørblad</span>
                                    <div class="cw-k">
                                        <select class="cw-f" @bind="_ce.DekningsomradeHovedDorblad" @bind:after="DekningsomradeEndret">
                                            <option value="">Velg …</option>
                                            @foreach (var alt in CeAlternativer.DekningsomradeAlternativer)
                                            {
                                                <option value="@alt">@alt</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                @if (_ce.DekningsomradeHovedDorblad == "I henhold til vedlegg G")
                                {
                                    <div class="cw-r"><span class="cw-l">Beskyttet bredde hoveddørblad</span><div class="cw-k">@Tall(() => _ce.BeskyttetBreddeHovedDorbladMm, v => _ce.BeskyttetBreddeHovedDorbladMm = v, "mm")</div></div>
                                }
                                <div class="cw-r"><span class="cw-l">Sensorplassering korrekt iht. instruksjoner</span><div class="cw-k">@JaNei(_ce.SensorplasseringKorrekt, v => _ce.SensorplasseringKorrekt = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Reaksjonstid tilfredsstillende, ingen forsinkelse</span><div class="cw-k">@JaNei(_ce.ReaksjonstidOk, v => _ce.ReaksjonstidOk = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Har impulssensor IR eller laser</span><div class="cw-k">@JaNei(_ce.HarImpulssensorIrLaser, v => _ce.HarImpulssensorIrLaser = v)</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Brann og nødåpning</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Sikkerhetssensor kobles ut ved brannalarm</span><div class="cw-k">@JaNei(_ce.SikkerhetssensorUtkoblingBrannalarm, v => _ce.SikkerhetssensorUtkoblingBrannalarm = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Nødåpning ved brannalarm testet</span><div class="cw-k">@JaNei(_ce.NodapningTestet, v => _ce.NodapningTestet = v)</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Betjening og merking</h4>
                            <div class="cw-rader">
                                <div class="cw-r"><span class="cw-l">Impulsgivere i riktig høyde og tilgjengelige</span><div class="cw-k">@JaNei(_ce.ImpulsbryterKorrektHoyde, v => _ce.ImpulsbryterKorrektHoyde = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Betjeningsbrytere med fri sideplass</span><div class="cw-k">@JaNei(_ce.AktiveringsbryterFriPlass, v => _ce.AktiveringsbryterFriPlass = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Klar merking for alle brukergrupper</span><div class="cw-k">@JaNei(_ce.TydeligSkilting, v => _ce.TydeligSkilting = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Beskyttelse av hengselareal</span><div class="cw-k">@JaNei(_ce.HengselsideBeskyttet, v => _ce.HengselsideBeskyttet = v, feilVed: false)</div></div>
                                <div class="cw-r"><span class="cw-l">Elektronisk låskobling testet</span><div class="cw-k">@JaNei(_ce.ElektroniskLasKoblingTestet, v => _ce.ElektroniskLasKoblingTestet = v, feilVed: false)</div></div>
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Andre funksjoner</h4>
                            <input class="cw-f cw-bred" @bind="_ce.EkstraFunksjonerKommentar" @bind:after="Lagre" placeholder="Valgfritt – skriv kort hva som er testet og logget" />
                        </div>
                        break;

                    case 6:
                        <label class="cw-r cw-bryterrad">
                            <span class="cw-l">Fotografering ikke tillatt<small>Sikret område – bildene hoppes over</small></span>
                            <span class="cw-bryter"><input type="checkbox" @bind="_ce.FotograferingIkkeTillatt" @bind:after="Lagre" /><i></i></span>
                        </label>
                        @if (!_ce.FotograferingIkkeTillatt)
                        {
                            <div class="cw-bilder">
                                @foreach (var gruppe in new[] { CeGodkjenningMediaPlassering.Hengselside, CeGodkjenningMediaPlassering.Karmside, CeGodkjenningMediaPlassering.Video })
                                {
                                    var plassering = gruppe;
                                    var filer = _ce.Media.Where(m => m.Plassering == plassering).ToList();
                                    <div class="cw-bk">
                                        <h5>@plassering.Visningsnavn()<span class="cw-p @(filer.Count > 0 ? "cw-gronn" : "cw-gul")">@(filer.Count > 0 ? $"{filer.Count} lagt til" : "mangler")</span></h5>
                                        <div class="cw-bk-g">
                                            @foreach (var m in filer)
                                            {
                                                <div @key="m.Id" class="cw-b">
                                                    @if (m.ContentType.StartsWith("video/"))
                                                    {
                                                        <video controls src="@($"/cegodkjenningmedia/{m.Id}")"></video>
                                                    }
                                                    else
                                                    {
                                                        <img src="@($"/cegodkjenningmedia/{m.Id}")" alt="@m.Filnavn" />
                                                    }
                                                    <button type="button" class="cw-b-fjern" title="Fjern" @onclick="@(() => SlettMedia(m))"><Icon Name="x" /></button>
                                                </div>
                                            }
                                            <label class="cw-ny">
                                                <Icon Name="@(plassering == CeGodkjenningMediaPlassering.Video ? "play" : "camera")" />
                                                <span>@(plassering == CeGodkjenningMediaPlassering.Video ? "Ta opp video" : "Ta bilde")</span>
                                                <InputFile OnChange="@(e => LastOppMediaTil(e, plassering))" accept="@(plassering == CeGodkjenningMediaPlassering.Video ? "video/*" : "image/*")" />
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        break;

                    case 7:
                        <div class="cw-gr">
                            <h4>Bekreft døren</h4>
                            <div class="cw-rader">
                                <div class="cw-r">
                                    <span class="cw-l">QR-kode fra dørskiltet<small>Skann eller lim inn koden for å bekrefte at du står ved riktig dør</small></span>
                                    <div class="cw-k">
                                        <input class="cw-f" @bind="_ce.QrKodeSkann" @bind:after="Lagre" placeholder="Skann eller lim inn kode" />
                                        <a class="cw-kn cw-liten" href="@($"/dor/{_ce.DorId}/qr.png")" target="_blank"><Icon Name="qr" />Dørens kode</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="cw-sign">
                            <div class="cw-sk">
                                <div class="cw-sk-t">Utført av<small>@(_ce.UtfortAvNavn ?? "-") · fra innloggingen</small></div>
                                <canvas id="@UtfortCanvasId" width="400" height="150" class="cw-sk-flate"></canvas>
                                <div class="cw-sk-fot"><span>Signer i feltet over</span><button type="button" class="cw-kn cw-liten" @onclick="@(() => RensSignaturAsync(UtfortCanvasId))">Tøm</button></div>
                            </div>
                            <div class="cw-sk">
                                <div class="cw-sk-t">Verifisert av<input class="cw-f cw-sk-navn" @bind="_ce.VerifisertAvNavn" @bind:after="Lagre" placeholder="Navn på verifisør" /></div>
                                <canvas id="@VerifisertCanvasId" width="400" height="150" class="cw-sk-flate"></canvas>
                                <div class="cw-sk-fot"><span>Signer i feltet over</span><button type="button" class="cw-kn cw-liten" @onclick="@(() => RensSignaturAsync(VerifisertCanvasId))">Tøm</button></div>
                            </div>
                        </div>
                        break;

                    case 8:
                        <div class="cw-dok">
                            <i><Icon Name="file-text" /></i>
                            <div><b>CE-samsvarssertifikat</b><small>Lages av det som er fylt ut i stegene</small></div>
                            <div class="cw-dok-h"><button type="button" class="cw-kn cw-p" @onclick="VisPdfForhandsvisning">Forhåndsvis og lagre</button></div>
                        </div>
                        @if (!string.IsNullOrEmpty(_pdfMelding))
                        {
                            <div class="cw-varsel cw-gronn"><Icon Name="check" /><span>@_pdfMelding</span></div>
                        }
                        <LagredePdfListe Pdfer="@_lagredePdfer" />
                        <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="CE-sertifisering" SaveButtonText="Lagre PDF" SaveMessage="@_pdfMelding"
                                         OnSave="LagreArkivPdf" OnClose="@(() => _pdfPreviewUrl = null)" />
                        <div class="cw-gr">
                            <h4>Tilbehørets dokumentasjon</h4>
                            <div class="cw-rader">
                                <table class="cw-tab">
                                    <thead><tr><th>Vare</th><th>Kategori</th><th>Dokument</th></tr></thead>
                                    <tbody>
                                        @foreach (var k in Sikkerhet.Concat(Annet))
                                        {
                                            <tr @key="k.ComponentId">
                                                <td><b>@k.Component?.Navn</b></td>
                                                <td>@(k.Component?.Type?.CeKategori is { } kat ? kat.Visningsnavn() : "Ikke satt")</td>
                                                <td>@DokumentLenke(k)</td>
                                            </tr>
                                        }
                                        @if (Sikkerhet.Count + Annet.Count == 0)
                                        {
                                            <tr><td colspan="3" class="cw-tom-rad">Ingen tilbehør med CE-kategori på denne døren.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        break;

                    case 9:
                        var bestatt = _valideringsresultater.Count(v => v.Bestatt);
                        var ikkeBestatt = _valideringsresultater.Where(v => !v.Bestatt).ToList();
                        <div class="cw-res @(_valideringGodkjent ? "cw-res-ok" : "cw-res-feil")">
                            <span class="cw-ring">@bestatt/@_valideringsresultater.Count</span>
                            <div>
                                <b>@(_valideringGodkjent ? "Alle krav er oppfylt" : $"{ikkeBestatt.Count} {(ikkeBestatt.Count == 1 ? "krav er" : "krav er")} ikke oppfylt")</b>
                                <small>@(_valideringGodkjent ? "Døren kan godkjennes." : "Døren kan ikke godkjennes før det er rettet.")</small>
                            </div>
                        </div>
                        @if (ikkeBestatt.Count > 0)
                        {
                            <div class="cw-gr">
                                <h4>Må rettes</h4>
                                <div class="cw-rader">
                                    @foreach (var v in ikkeBestatt)
                                    {
                                        <div class="cw-r"><span class="cw-l">@v.Tekst</span><div class="cw-k"><span class="cw-p cw-rod"><Icon Name="x" />Ikke oppfylt</span></div></div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="cw-gr">
                            <h4>Oppfylt · @bestatt</h4>
                            <div class="cw-rader">
                                @foreach (var v in _visAlleBestatt ? _valideringsresultater.Where(v => v.Bestatt) : _valideringsresultater.Where(v => v.Bestatt).Take(5))
                                {
                                    <div class="cw-r"><span class="cw-l">@v.Tekst</span><div class="cw-k"><span class="cw-p cw-gronn"><Icon Name="check" />Oppfylt</span></div></div>
                                }
                                @if (bestatt > 5)
                                {
                                    <button type="button" class="cw-flere" @onclick="@(() => _visAlleBestatt = !_visAlleBestatt)">@(_visAlleBestatt ? "Vis færre" : $"Vis alle {bestatt}")</button>
                                }
                            </div>
                        </div>
                        <div class="cw-gr">
                            <h4>Status</h4>
                            <div class="cw-rader">
                                <div class="cw-r">
                                    <span class="cw-l">Status på sertifiseringen@(!_valideringGodkjent ? new MarkupString("<small>«Godkjent» kan velges når alle krav er oppfylt</small>") : new MarkupString(""))</span>
                                    <div class="cw-k">
                                        <span class="cw-valg">
                                            @foreach (var s in Enum.GetValues<CeGodkjenningStatus>())
                                            {
                                                var status = s;
                                                <button type="button" class="@(_ce.Status == status ? "cw-valgt" : "")"
                                                        disabled="@(status == CeGodkjenningStatus.Godkjent && !_valideringGodkjent && _ce.Status != status)"
                                                        @onclick="@(() => SettStatus(status))">@status.Visningsnavn()</button>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        break;
                }
            </div>
        </div>

        <div class="cw-fot">
            @if (_steg > 1)
            {
                <button type="button" class="cw-kn" @onclick="Forrige"><Icon Name="arrow-left" />@StegNavn[_steg - 2]</button>
            }
            else
            {
                <button type="button" class="cw-kn" @onclick="Lukk"><Icon Name="arrow-left" />Lukk</button>
            }
            <span class="cw-fot-m">Steg @_steg av @StegNavn.Length@if (!string.IsNullOrEmpty(_melding)) {<b><Icon Name="check" />Lagret</b>}</span>
            @if (_steg < StegNavn.Length)
            {
                <button type="button" class="cw-kn cw-p" @onclick="Neste">@StegNavn[_steg]<Icon Name="arrow-right" /></button>
            }
            else
            {
                <button type="button" class="cw-kn cw-p" @onclick="LagreOgLukk"><Icon Name="check" />Ferdig</button>
            }
        </div>
    </div>
}

@code {
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public int Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool StartRedigerbar { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StegNavn =
    [
        "Oppdrag", "Automatikk", "Døren", "Mål og tider", "Sikkerhet",
        "Bilder", "Bekreftelse", "Sertifikat", "Resultat"
    ];

    // Én setning under overskriften på hvert steg.
    private static readonly string[] StegTekst =
    [
        "Kunde, bygg og dør hentes fra prosjektet. Sjekk at det stemmer – du kan endre alt her.",
        "Dørautomatikken som sertifiseres, og tilbehøret som sitter på døren.",
        "Mål, konstruksjon og krav til døren. Svar som ikke oppfyller kravene blir markert med en gang.",
        "Mål døren i vanlig drift. Grensene står ved hvert felt.",
        "Gå gjennom sensorer, brann og betjening. Ett trykk per punkt.",
        "Dokumenter døren med bilder fra begge sider og en kort video av åpning og lukking.",
        "Bekreft at du står ved riktig dør, og signer.",
        "Samsvarssertifikatet lages av det som er fylt ut. Tilbehørets dokumenter legges ved.",
        "Alle krav er sjekket. Rett det som står igjen, og sett status."
    ];

    private bool _visProdusentFelt;
    private bool _visAlleBestatt;

    private CeGodkjenning? _ce;
    private bool _notFound;
    private List<DorKomponent> _dorKomponenter = [];
    private CeMaleGrenseverdier _grenser = new();
    private int _steg = 1;
    private string? _feil;
    private string? _melding;
    private string? _pdfMelding;
    private string? _pdfPreviewUrl;
    private CeGodkjenningMediaPlassering _nyMediaPlassering = CeGodkjenningMediaPlassering.Hengselside;
    private List<LagretPdf> _lagredePdfer = [];
    private List<CeValideringsResultat> _valideringsresultater = [];
    private bool _valideringGodkjent;
    private string? _postnr;
    private string? _sted;
    private string? _geokodetAdresse;
    private bool _kartMaOppdateres;
    private bool _signaturMaInitialiseres;
    private bool _redigerbar;
    private bool _redigerbarInitFraParam;

    // CE er lesetilgang for montører. Brukes både til å åpne panelet låst og
    // til å skjule "Aktiver felt"-knappen, slik at de ikke kan låse opp selv.
    private async Task<bool> KanRedigereCeAsync()
    {
        if (AuthStateTask is null)
        {
            return false;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var rolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var r) ? r : (BrukerRolle?)null;
        return ModulRettigheter.KanRedigere(rolle, "ce-godkjenninger");
    }

    private bool _kanRedigereCe;

    private bool Låst => !_redigerbar;

    private string MapElementId => $"ce-location-map-{Id}";
    private string UtfortCanvasId => $"ce-sig-utfort-{Id}";
    private string VerifisertCanvasId => $"ce-sig-verifisert-{Id}";

    // Samme regler som farger enkeltfelt gult og som avgjør Validation-resultatet (CeValideringsService),
    // brukt til å sette grønn hake/rødt kryss på step-indikatoren slik at "utfylt og riktig" alltid betyr det samme uansett hvor det vises.
    private bool StegOk(int steg)
    {
        if (_ce is null)
        {
            return false;
        }

        return steg switch
        {
            1 => !string.IsNullOrWhiteSpace(_ce.KundeNavn) && !string.IsNullOrWhiteSpace(_ce.ProsjektNavn) && !string.IsNullOrWhiteSpace(_ce.Adresse),
            2 => !string.IsNullOrWhiteSpace(_ce.Produsent) && !string.IsNullOrWhiteSpace(_ce.ItemNavn),
            3 => !string.IsNullOrWhiteSpace(_ce.GlassIDor) && _ce.FriBredde086.HasValue && _ce.TerskelUnder25mm.HasValue && _ce.KuttskadeRisiko.HasValue
                 && !string.IsNullOrWhiteSpace(_ce.Dorkonstruksjon) && !string.IsNullOrWhiteSpace(_ce.Karmkonstruksjon)
                 && CeValideringsService.ErGlassOk(_ce) && CeValideringsService.ErFriBreddeOk(_ce)
                 && CeValideringsService.ErTerskelOk(_ce) && CeValideringsService.ErKuttskaderisikoOk(_ce),
            4 => _ce.Apningsvinkel.HasValue && _ce.ApningstidSek.HasValue && _ce.LukketidHoySek.HasValue && _ce.LukketidLavSek.HasValue && _ce.ApningskraftN.HasValue
                 && _ce.DodlasEtterStopp.HasValue && _ce.ForsinkelseForLukking.HasValue && _ce.ApnesMotGjennomgangstrafikk.HasValue
                 && CeValideringsService.ErApningstidOk(_ce, _grenser) && CeValideringsService.ErLukketidHoyOk(_ce, _grenser)
                 && CeValideringsService.ErLukketidLavOk(_ce, _grenser) && CeValideringsService.ErApningskraftOk(_ce, _grenser)
                 && CeValideringsService.ErDodlasOk(_ce) && CeValideringsService.ErForsinkelseOk(_ce),
            5 => _ce.NodapningTestet.HasValue
                 && CeValideringsService.ErHengselsideOk(_ce) && CeValideringsService.ErBrannalarmUtkoblingOk(_ce)
                 && CeValideringsService.ErAktiveringsbryterOk(_ce) && CeValideringsService.ErImpulsbryterOk(_ce)
                 && CeValideringsService.ErLaskoblingOk(_ce) && CeValideringsService.ErSkiltingOk(_ce)
                 && Sikkerhet.Count > 0 && CeValideringsService.ErSensorplasseringOk(_ce) && CeValideringsService.ErReaksjonstidOk(_ce),
            6 => _ce.Media.Count > 0 || _ce.FotograferingIkkeTillatt,
            7 => !string.IsNullOrWhiteSpace(_ce.UtfortAvNavn),
            8 => true,
            9 => _valideringGodkjent,
            _ => true
        };
    }

    private List<DorKomponent> Sikkerhet => _dorKomponenter.Where(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.SikkerhetsTilbehor).ToList();
    private List<DorKomponent> Annet => _dorKomponenter.Where(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.AnnetTilbehor).ToList();

    protected override async Task OnParametersSetAsync()
    {
        _ce = await Db.CeGodkjenninger
            .Include(c => c.Dor).ThenInclude(d => d!.Prosjekt)
            .Include(c => c.Media)
            .FirstOrDefaultAsync(c => c.Id == Id);

        if (_ce is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;

        if (!_redigerbarInitFraParam)
        {
            _redigerbarInitFraParam = true;

            // Montører har lesetilgang til CE: panelet åpner alltid i
            // visningsmodus for dem, uansett om lenken ba om redigering
            // (?rediger=true). Se ModulRettigheter.
            _kanRedigereCe = await KanRedigereCeAsync();
            _redigerbar = _kanRedigereCe;
        }

        _postnr = _ce.Dor?.Prosjekt?.Postnr;
        _sted = _ce.Dor?.Prosjekt?.Sted;
        _geokodetAdresse = _ce.Adresse;

        if (string.IsNullOrWhiteSpace(_ce.UtfortAvNavn) && AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var brukerId))
            {
                var navn = await Db.Brukere.Where(b => b.Id == brukerId).Select(b => b.Navn).FirstOrDefaultAsync();
                if (!string.IsNullOrWhiteSpace(navn))
                {
                    _ce.UtfortAvNavn = navn;
                    _ce.UtfortAvDato = DateTime.Now;
                    await Db.SaveChangesAsync();
                }
            }
        }

        _dorKomponenter = await Db.DorKomponenter
            .Where(k => k.DorId == _ce.DorId)
            .Include(k => k.Component).ThenInclude(c => c!.Type)
            .ToListAsync();

        _grenser = await Db.CeMaleGrenseverdier.FirstOrDefaultAsync() ?? new CeMaleGrenseverdier();
        _lagredePdfer = await LagretPdfService.HentAsync("CeGodkjenning", Id);

        _kartMaOppdateres = _steg == 1 && _ce.Latitude.HasValue;
        _signaturMaInitialiseres = _steg == 7;
        OppdaterValidering();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ce is not null && !_ce.Latitude.HasValue && !string.IsNullOrWhiteSpace(_ce.Adresse))
        {
            // Geokodes etter første rendering slik at et tregt/utilgjengelig eksternt kalt ikke blokkerer sideåpningen.
            await GeokodAdresseAsync(lagre: false);
            if (_ce.Latitude.HasValue)
            {
                _kartMaOppdateres = _steg == 1;
                StateHasChanged();
            }
            return;
        }

        if (_kartMaOppdateres && _ce is { Latitude: not null, Longitude: not null })
        {
            _kartMaOppdateres = false;
            var data = new[] { new { lat = _ce.Latitude.Value, lng = _ce.Longitude.Value, tittel = _ce.Adresse ?? "", undertekst = "" } };
            await JS.InvokeVoidAsync("kart.init", MapElementId, data);
        }

        if (_signaturMaInitialiseres && _steg == 7)
        {
            _signaturMaInitialiseres = false;
            await JS.InvokeVoidAsync("signatur.init", UtfortCanvasId);
            await JS.InvokeVoidAsync("signatur.init", VerifisertCanvasId);
        }
    }

    private async Task RensSignaturAsync(string canvasId)
    {
        await JS.InvokeVoidAsync("signatur.clear", canvasId);
    }

    private async Task LagreSignaturerAsync()
    {
        if (_ce is null)
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("signatur.isEmpty", UtfortCanvasId))
        {
            var b64 = await JS.InvokeAsync<string>("signatur.getPngBase64", UtfortCanvasId);
            _ce.UtfortAvSignatur = Convert.FromBase64String(b64);
        }

        if (!await JS.InvokeAsync<bool>("signatur.isEmpty", VerifisertCanvasId))
        {
            var b64 = await JS.InvokeAsync<string>("signatur.getPngBase64", VerifisertCanvasId);
            _ce.VerifisertAvSignatur = Convert.FromBase64String(b64);
        }
    }

    private void OppdaterValidering()
    {
        _valideringsresultater = CeValideringsService.Evaluer(_ce!, _dorKomponenter);
        _valideringGodkjent = _valideringsresultater.All(v => v.Bestatt);
    }

    private async Task OppdaterGyldighetAsync(ChangeEventArgs e)
    {
        if (_ce is null || !int.TryParse(e.Value?.ToString(), out var måneder))
        {
            return;
        }

        _ce.GyldighetMåneder = måneder;
        _ce.GyldigTil = _ce.GyldigFra.AddMonths(måneder);
        await Db.SaveChangesAsync();
    }

    private async Task GeokodAdresseAsync(bool lagre = true)
    {
        if (_ce is null || string.IsNullOrWhiteSpace(_ce.Adresse))
        {
            return;
        }

        var treff = await Geokoding.GeocodeAsync(_ce.Adresse, _postnr, _sted);
        if (treff is null)
        {
            _ce.Latitude = null;
            _ce.Longitude = null;
            return;
        }

        _ce.Latitude = treff.Value.Latitude;
        _ce.Longitude = treff.Value.Longitude;
        _geokodetAdresse = _ce.Adresse;
        _kartMaOppdateres = true;

        if (lagre)
        {
            await Db.SaveChangesAsync();
        }
    }

    private void OnDekningsomradeEndret()
    {
        if (_ce!.DekningsomradeHovedDorblad == "I henhold til vedlegg G" && _ce.BeskyttetBreddeHovedDorbladMm is null)
        {
            _ce.BeskyttetBreddeHovedDorbladMm = 0.7;
        }
    }

    private static bool OverGrense(double? verdi, double grense, bool unntatt) =>
        !unntatt && verdi > grense;

    private async Task Neste()
    {
        await Lagre();
        if (_steg < StegNavn.Length)
        {
            _steg++;
            if (_steg == 1)
            {
                _kartMaOppdateres = _ce?.Latitude.HasValue == true;
            }
            else if (_steg == 7)
            {
                _signaturMaInitialiseres = true;
            }
        }
    }

    private async Task Forrige()
    {
        await Lagre();
        if (_steg > 1)
        {
            _steg--;
            if (_steg == 7)
            {
                _signaturMaInitialiseres = true;
            }
        }
    }

    private async Task Lagre()
    {
        if (_ce is null)
        {
            return;
        }

        if (_steg == 1 && !string.IsNullOrWhiteSpace(_ce.Adresse) && _ce.Adresse != _geokodetAdresse)
        {
            await GeokodAdresseAsync(lagre: false);
        }

        if (_steg == 7 && !_signaturMaInitialiseres)
        {
            await LagreSignaturerAsync();
        }

        if (!string.IsNullOrWhiteSpace(_ce.UtfortAvNavn) && _ce.UtfortAvDato is null)
        {
            _ce.UtfortAvDato = DateTime.Now;
        }
        if (!string.IsNullOrWhiteSpace(_ce.VerifisertAvNavn) && _ce.VerifisertAvDato is null)
        {
            _ce.VerifisertAvDato = DateTime.Now;
        }

        _ce.OppdatertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        OppdaterValidering();
        _melding = "Lagret.";
    }

    private Task LastOppMediaTil(InputFileChangeEventArgs e, CeGodkjenningMediaPlassering plassering)
    {
        _nyMediaPlassering = plassering;
        return LastOppMedia(e);
    }

    private async Task LastOppMedia(InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;

        if (file.Size > 50_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 50 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var media = new CeGodkjenningMedia
        {
            CeGodkjenningId = Id,
            Data = buffer.ToArray(),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            Filnavn = file.Name,
            Plassering = _nyMediaPlassering
        };
        Db.CeGodkjenningMedia.Add(media);
        await Db.SaveChangesAsync();

        _ce!.Media.Add(media);
        OppdaterValidering();
    }

    private async Task SlettMedia(CeGodkjenningMedia media)
    {
        var entitet = await Db.CeGodkjenningMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.CeGodkjenningMedia.Remove(entitet);
        await Db.SaveChangesAsync();

        _ce!.Media.Remove(media);
        OppdaterValidering();
    }

    private void VisPdfForhandsvisning()
    {
        _pdfMelding = null;
        _pdfPreviewUrl = $"/ce/{Id}/pdf";
    }

    private async Task LagreArkivPdf()
    {
        var bytes = await PdfService.GenerateAsync(Id);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "CeGodkjenning", Id, $"CE-sertifisering - {_ce?.Sertifiseringsnummer} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Insert(0, pdf);
        _pdfMelding = "PDF-en er lagret i arkivet.";
    }

    private async Task Lukk()
    {
        await OnClose.InvokeAsync();
    }

    private async Task LagreOgLukk()
    {
        await Lagre();
        await Lukk();
    }

    // ---------- Flyten: stegene, Ja/Nei-knapper, tallfelt og grenser ----------

    private async Task GaTil(int steg)
    {
        if (steg == _steg)
        {
            return;
        }

        await Lagre();
        _steg = steg;
        _feil = null;
        if (_steg == 1)
        {
            _kartMaOppdateres = _ce?.Latitude.HasValue == true;
        }
        else if (_steg == 7)
        {
            _signaturMaInitialiseres = true;
        }
    }

    // Aktivt steg, ferdig (grønn hake), feil på et steg man har vært forbi (rødt !), ellers bare nummeret.
    private string StegKlasse(int steg) =>
        steg == _steg ? "pa"
        : StegOk(steg) ? "ferdig"
        : steg < _steg ? "feil"
        : "";

    private static string StatusKlasse(CeGodkjenningStatus status) => status switch
    {
        CeGodkjenningStatus.Godkjent => "cw-gronn",
        CeGodkjenningStatus.Avvist => "cw-rod",
        CeGodkjenningStatus.TilGjennomgang => "cw-gul",
        _ => "cw-bla"
    };

    private string ProdusentLinje => _ce is null ? "" : string.Join(" · ", new[]
    {
        _ce.Produsent,
        _ce.ProdusentAdresse,
        string.Join(" ", new[] { _ce.ProdusentPostnr, _ce.ProdusentSted }.Where(x => !string.IsNullOrWhiteSpace(x))),
        _ce.ProdusentLand,
        string.IsNullOrWhiteSpace(_ce.ProdusentOrgnr) ? null : $"Org.nr {_ce.ProdusentOrgnr}"
    }.Where(x => !string.IsNullOrWhiteSpace(x) && x != _ce.Produsent));

    private async Task SettGyldighet(int maaneder)
    {
        if (_ce is null)
        {
            return;
        }

        _ce.GyldighetMåneder = maaneder;
        _ce.GyldigTil = _ce.GyldigFra.AddMonths(maaneder);
        await Lagre();
    }

    private async Task SettGlass(string glass)
    {
        _ce!.GlassIDor = _ce.GlassIDor == glass ? null : glass;
        await Lagre();
    }

    private async Task SettStatus(CeGodkjenningStatus status)
    {
        _ce!.Status = status;
        await Lagre();
    }

    private async Task DekningsomradeEndret()
    {
        OnDekningsomradeEndret();
        await Lagre();
    }

    private async Task VelgJaNei(Action<bool?> sett, bool? verdi)
    {
        sett(verdi);
        await Lagre();
    }

    // Ja/Nei som knapper. feilVed = svaret som gjør at kravet ikke er oppfylt (blir rødt).
    // Trykker man på svaret som allerede er valgt, nullstilles det.
    private RenderFragment JaNei(bool? verdi, Action<bool?> sett, bool? feilVed = null, bool laast = false) => __builder =>
    {
        var jaKlasse = verdi == true ? (feilVed == true ? "cw-nei" : "cw-ja") : "";
        var neiKlasse = verdi == false ? (feilVed == false ? "cw-nei" : "cw-nok") : "";
        <span class="cw-jn @(verdi is null ? "cw-jn-tom" : "")">
            <button type="button" class="@jaKlasse" disabled="@laast" @onclick="@(() => VelgJaNei(sett, verdi == true ? null : true))">@if (verdi == true) {<Icon Name="check" />}Ja</button>
            <button type="button" class="@neiKlasse" disabled="@laast" @onclick="@(() => VelgJaNei(sett, verdi == false ? null : false))">@if (verdi == false) {<Icon Name="x" />}Nei</button>
        </span>
    };

    // Tallfelt med enheten inne i feltet. Komma og punktum godtas.
    private RenderFragment Tall(Func<double?> hent, Action<double?> sett, string enhet, bool laast = false, bool feil = false) => __builder =>
    {
        var verdi = hent();
        <span class="cw-tall @(feil ? "cw-tall-feil" : "")">
            <input type="text" inputmode="decimal" value="@(verdi?.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")))" disabled="@laast"
                   @onchange="@(e => SettTall(sett, e.Value?.ToString()))" />
            <em>@enhet</em>
        </span>
    };

    private async Task SettTall(Action<double?> sett, string? tekst)
    {
        var renset = (tekst ?? "").Trim().Replace(" ", "").Replace(',', '.');
        sett(double.TryParse(renset, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var tall) ? tall : null);
        await Lagre();
    }

    private static RenderFragment Grense(double? verdi, double maks, string enhet) => __builder =>
    {
        var klasse = verdi is null ? "cw-grense-n" : verdi <= maks ? "cw-grense-ok" : "cw-grense-feil";
        <span class="cw-grense @klasse">@if (verdi is not null) {<Icon Name="@(verdi <= maks ? "check" : "x")" />}maks @maks.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")) @enhet</span>
    };

    private IEnumerable<string> MalOverGrensen()
    {
        var kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
        string Tekst(string navn, double v, double maks, string enhet) =>
            $"{navn} er {v.ToString("0.##", kultur)} {enhet} – maks {maks.ToString("0.##", kultur)} {enhet}.";

        if (_ce!.ApningstidSek is { } a && a > _grenser.MaksApningstidSek) yield return Tekst("Åpningstid 0–80°", a, _grenser.MaksApningstidSek, "s");
        if (_ce.LukketidHoySek is { } h && h > _grenser.MaksLukketidHoySek) yield return Tekst("Lukketid 90–10°", h, _grenser.MaksLukketidHoySek, "s");
        if (_ce.LukketidLavSek is { } l && l > _grenser.MaksLukketidLavSek) yield return Tekst("Lukketid 10–0°", l, _grenser.MaksLukketidLavSek, "s");
        if (_ce.ApningskraftN is { } k && k > _grenser.MaksApningskraftN) yield return Tekst("Åpningskraft", k, _grenser.MaksApningskraftN, "N");
    }

    private int KontrollUbesvart() => new[]
    {
        _ce!.SensorplasseringKorrekt, _ce.ReaksjonstidOk, _ce.HarImpulssensorIrLaser, _ce.SikkerhetssensorUtkoblingBrannalarm,
        _ce.NodapningTestet, _ce.ImpulsbryterKorrektHoyde, _ce.AktiveringsbryterFriPlass, _ce.TydeligSkilting,
        _ce.HengselsideBeskyttet, _ce.ElektroniskLasKoblingTestet
    }.Count(v => v is null);

    private RenderFragment TilbehorTabell(string tittel, List<DorKomponent> liste, string tom) => __builder =>
    {
        <div class="cw-gr">
            <h4>@tittel</h4>
            @if (liste.Count == 0)
            {
                <p class="cw-hint">@tom</p>
            }
            else
            {
                <div class="cw-rader">
                    <table class="cw-tab">
                        <thead><tr><th>Vare</th><th>Antall</th><th>Plassering</th></tr></thead>
                        <tbody>
                            @foreach (var k in liste)
                            {
                                <tr @key="k.ComponentId">
                                    <td><b>@k.Component?.Navn</b><small>@(k.Component?.Type?.Navn ?? "-") · @(k.Component?.Produktkode ?? "-")</small></td>
                                    <td>@k.Antall @k.Enhet</td>
                                    <td>@(k.Plassering?.Kode() ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    };

    private RenderFragment DokumentLenke(DorKomponent k) => builder =>
    {
        if (k.Component?.FdvFilnavn is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/komponent/{k.Component.Id}/fdv");
            builder.AddAttribute(2, "target", "_blank");
            builder.AddAttribute(3, "class", "cw-p cw-gronn");
            builder.AddContent(4, "Vis dokument");
            builder.CloseElement();
        }
        else if (k.Component?.Type?.CeDokumentData is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/komponenttype/{k.Component.Type.Id}/ce-dokument");
            builder.AddAttribute(2, "target", "_blank");
            builder.AddAttribute(3, "class", "cw-p cw-gronn");
            builder.AddContent(4, "Standarddokument");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "cw-p cw-gul");
            builder.AddContent(2, "Mangler");
            builder.CloseElement();
        }
    };
}
