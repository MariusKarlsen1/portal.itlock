@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject LagretPdfService LagretPdfService
@inject CeGodkjenningPdfService PdfService
@inject GeocodingService Geokoding
@inject IJSRuntime JS

@if (_notFound)
{
    <p class="form-error">Fant ikke CE-sertifiseringen. Den kan ha blitt slettet.</p>
}
else if (_ce is null)
{
    <p>Laster...</p>
}
else
{
    <div class="ce-panel-header">
        <div>
            <h2>CE-sertifisering @_ce.Sertifiseringsnummer</h2>
            <p class="ce-sub">@_ce.ProsjektNavn - Dør @(_ce.Dornummer ?? _ce.Dor?.Dornummer) - @_ce.Status.Visningsnavn()</p>
        </div>
        <div class="ce-panel-header-actions">
            @if (_steg is 1 or 2 or 3)
            {
                <button type="button" class="page-button" @onclick="@(() => _redigerbar = !_redigerbar)">
                    @(_redigerbar ? "Lås felt" : "Aktiver felt")
                </button>
            }
            <button type="button" class="page-button" @onclick="Lukk">Lukk</button>
        </div>
    </div>

    <div class="ce-stegindikator">
        @for (var i = 1; i <= StegNavn.Length; i++)
        {
            var steg = i;
            <div class="ce-steg @(steg == _steg ? "ce-steg-aktiv" : "")">
                <span class="ce-steg-tall @(steg != _steg ? (StegOk(steg) ? "ce-steg-tall-ok" : "ce-steg-tall-feil") : "")">
                    @(steg == _steg ? steg.ToString() : (StegOk(steg) ? "✓" : "✕"))
                </span>
                <span class="ce-steg-navn">@StegNavn[steg - 1]</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_feil))
    {
        <p class="form-error">@_feil</p>
    }
    @if (!string.IsNullOrEmpty(_melding))
    {
        <p class="save-success">@_melding</p>
    }

    <div class="ce-stegpanel">
        @switch (_steg)
        {
            case 1:
                <div class="field-grid">
                    <label>Kunde <input @bind="_ce.KundeNavn" disabled="@Låst" /></label>
                    <label>Kontaktperson <input @bind="_ce.Kontaktperson" disabled="@Låst" /></label>
                    <label>Prosjektnavn <input @bind="_ce.ProsjektNavn" disabled="@Låst" /></label>
                    <label>Arbeidsordre <input @bind="_ce.Arbeidsordre" disabled="@Låst" /></label>
                    <label>
                        Serviceavtale
                        <select value="@(_ce.Serviceavtale.HasValue ? _ce.Serviceavtale.Value.ToString() : "")" @onchange="@(e => _ce.Serviceavtale = e.Value as string switch { "True" => true, "False" => false, _ => null })" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            <option value="True">Ja</option>
                            <option value="False">Nei</option>
                        </select>
                    </label>
                    <label>Bygningsadresse <input @bind="_ce.Adresse" disabled="@Låst" /></label>

                    <label class="ce-location-field">
                        Lokasjon
                        @if (_ce.Latitude.HasValue && _ce.Longitude.HasValue)
                        {
                            <div id="@MapElementId" class="ce-location-map"></div>
                        }
                        else
                        {
                            <p class="list-empty">Ingen lokasjon funnet for denne adressen ennå.</p>
                        }
                        <button type="button" class="page-button ce-locate-button" @onclick="@(() => GeokodAdresseAsync())">Finn på kart</button>
                    </label>

                    <label>Etasje <input @bind="_ce.Etasje" disabled="@Låst" /></label>
                    <label>Bygg <input @bind="_ce.Bygg" disabled="@Låst" /></label>
                    <label>
                        Bygningskategori
                        <select @bind="_ce.Byggkategori" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            @foreach (var k in CeAlternativer.Byggkategorier)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </label>
                    <label>
                        Bygningens risikoklasse
                        <select @bind="_ce.Risikoklasse" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            @foreach (var r in CeAlternativer.Risikoklasser)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </label>
                    <label>
                        Gyldighetsperiode
                        <select value="@_ce.GyldighetMåneder" @onchange="OppdaterGyldighetAsync" disabled="@Låst">
                            @foreach (var m in CeAlternativer.GyldighetMånederAlternativer)
                            {
                                <option value="@m">@m måneder</option>
                            }
                        </select>
                    </label>
                    <label>Dør til <input @bind="_ce.DorTil" disabled="@Låst" /></label>
                    <label>Dørnummer <input @bind="_ce.Dornummer" disabled="@Låst" /></label>
                    <label>Dør-ID <input value="@(_ce.DorIdKode ?? "-")" disabled /></label>
                </div>
                break;

            case 2:
                <h3>Produktdetaljer</h3>
                <div class="field-grid">
                    <label>Produsent <input @bind="_ce.Produsent" disabled="@Låst" /></label>
                    <label>Varenavn <input @bind="_ce.ItemNavn" disabled="@Låst" /></label>
                    <label>Serienummer <input @bind="_ce.Serienummer" disabled="@Låst" /></label>
                    <label>Antall <input @bind="_ce.Antall" type="number" disabled="@Låst" /></label>
                    <label>Produksjonsår <input @bind="_ce.ProduksjonsAar" type="number" disabled="@Låst" /></label>
                </div>

                <h3>Produsentens firmaopplysninger</h3>
                <p class="section-hint">Brukes på CE-egenerklæringen. Sett som standard på automatikk-varen i komponentregisteret for å slippe å fylle inn på nytt.</p>
                <div class="field-grid">
                    <label>Adresse <input @bind="_ce.ProdusentAdresse" disabled="@Låst" /></label>
                    <label>Postnr <input @bind="_ce.ProdusentPostnr" disabled="@Låst" /></label>
                    <label>Sted <input @bind="_ce.ProdusentSted" disabled="@Låst" /></label>
                    <label>Land <input @bind="_ce.ProdusentLand" disabled="@Låst" /></label>
                    <label>Org.nr <input @bind="_ce.ProdusentOrgnr" disabled="@Låst" /></label>
                </div>

                <h3>Sikkerhetstilbehør</h3>
                @if (Sikkerhet.Count == 0)
                {
                    <p class="list-empty">Ingen komponenter kategorisert som sikkerhetstilbehør på denne døren.</p>
                }
                else
                {
                    <table class="dor-table">
                        <thead><tr><th>Varenummer</th><th>Navn</th><th>Antall</th><th>Beslagsplassering</th><th>Beslag</th></tr></thead>
                        <tbody>
                            @foreach (var k in Sikkerhet)
                            {
                                <tr @key="k.ComponentId">
                                    <td>@(k.Component?.Produktkode ?? "-")</td>
                                    <td>@k.Component?.Navn</td>
                                    <td>@k.Antall @k.Enhet</td>
                                    <td>@(k.Plassering?.Kode() ?? "-")</td>
                                    <td>@(k.Component?.Type?.Navn ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h3>Annet tilbehør</h3>
                @if (Annet.Count == 0)
                {
                    <p class="list-empty">Ingen komponenter kategorisert som annet tilbehør på denne døren.</p>
                }
                else
                {
                    <table class="dor-table">
                        <thead><tr><th>Varenummer</th><th>Navn</th><th>Antall</th><th>Beslagsplassering</th><th>Beslag</th></tr></thead>
                        <tbody>
                            @foreach (var k in Annet)
                            {
                                <tr @key="k.ComponentId">
                                    <td>@(k.Component?.Produktkode ?? "-")</td>
                                    <td>@k.Component?.Navn</td>
                                    <td>@k.Antall @k.Enhet</td>
                                    <td>@(k.Plassering?.Kode() ?? "-")</td>
                                    <td>@(k.Component?.Type?.Navn ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <p class="section-hint">Sett CE-kategori på beslagstype under CE-oppsett dersom tilbehør mangler her.</p>
                break;

            case 3:
                <div class="field-grid">
                    <label>Bredde hoveddør (mm) <input @bind="_ce.BreddeMm" type="number" disabled="@Låst" /></label>
                    <label>
                        Dørkonstruksjon
                        <select @bind="_ce.Dorkonstruksjon" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            @foreach (var k in CeAlternativer.Konstruksjoner)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </label>
                    <label>Dørbladhøyde (mm) <input @bind="_ce.HoydeMm" type="number" disabled="@Låst" /></label>
                    <label>
                        Karmkonstruksjon
                        <select @bind="_ce.Karmkonstruksjon" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            @foreach (var k in CeAlternativer.Konstruksjoner)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </label>
                    <label>Vekt hoveddør (kg) <input @bind="_ce.VektKg" type="number" step="0.1" disabled="@Låst" /></label>
                    <label>
                        Glass i dør
                        <select @bind="_ce.GlassIDor" disabled="@Låst">
                            <option value="">Ikke satt</option>
                            @foreach (var g in CeAlternativer.GlassIDorAlternativer)
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </label>
                    <TriStateSelect Label="Fri passasjebredde (min. 0,86 m)" @bind-Value="_ce.FriBredde086" Disabled="Låst" Warn="@(_ce.FriBredde086 == false)" />
                    <TriStateSelect Label="Terskelhøyde under 25mm" @bind-Value="_ce.TerskelUnder25mm" Disabled="Låst" Warn="@(_ce.TerskelUnder25mm == false)" />
                    <label>Brannklassifisering <input @bind="_ce.Brannklasse" placeholder="F.eks. EI60C" disabled="@Låst" /></label>
                    <TriStateSelect Label="Fare for kuttskade i dørmiljø" @bind-Value="_ce.KuttskadeRisiko" Disabled="Låst" Warn="@(_ce.KuttskadeRisiko == true)" />
                    @if (_ce.GlassIDor == "Med glass")
                    {
                        <label>
                            Glasstype
                            <select @bind="_ce.TypeAvGlass" disabled="@Låst">
                                <option value="">Ikke satt</option>
                                @foreach (var g in CeAlternativer.TypeAvGlassAlternativer)
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        </label>
                        <TriStateSelect Label="Glass har synlighetstiltak" @bind-Value="_ce.GlassSynligTiltak" Disabled="Låst" Warn="@(_ce.GlassSynligTiltak == false)" />
                        <TriStateSelect Label="Glass fare for kutt og skade" @bind-Value="_ce.GlassFareKuttSkade" Disabled="Låst" Warn="@(_ce.GlassFareKuttSkade == true)" />
                    }
                </div>
                break;

            case 4:
                <div class="field-grid">
                    <label>Åpningsvinkel hoveddørblad (°) <input @bind="_ce.Apningsvinkel" type="number" step="0.1" /></label>
                    <label>
                        Åpningstid 0-80° (sek)
                        <input @bind="_ce.ApningstidSek" type="number" step="0.1" class="@(OverGrense(_ce.ApningstidSek, _grenser.MaksApningstidSek, false) ? "ce-input-warn" : "")" />
                        <span class="ce-grense">Maks @_grenser.MaksApningstidSek sek</span>
                    </label>
                    <label>
                        Lukketid 90-10° (sek)
                        <input @bind="_ce.LukketidHoySek" type="number" step="0.1" class="@(OverGrense(_ce.LukketidHoySek, _grenser.MaksLukketidHoySek, false) ? "ce-input-warn" : "")" />
                        <span class="ce-grense">Maks @_grenser.MaksLukketidHoySek sek</span>
                    </label>
                    <label>
                        Lukketid 10-0° (sek)
                        <input @bind="_ce.LukketidLavSek" type="number" step="0.1" class="@(OverGrense(_ce.LukketidLavSek, _grenser.MaksLukketidLavSek, false) ? "ce-input-warn" : "")" />
                        <span class="ce-grense">Maks @_grenser.MaksLukketidLavSek sek</span>
                    </label>
                    <label>
                        Åpningskraft (N)
                        <input @bind="_ce.ApningskraftN" type="number" step="0.1" class="@(OverGrense(_ce.ApningskraftN, _grenser.MaksApningskraftN, false) ? "ce-input-warn" : "")" />
                        <span class="ce-grense">Maks @_grenser.MaksApningskraftN N</span>
                    </label>
                    <TriStateSelect Label="Dødgang etter stopp (< 50cm)" @bind-Value="_ce.DodlasEtterStopp" Warn="@(_ce.DodlasEtterStopp == false)" />
                    <TriStateSelect Label="Forsinkelsestid før lukking (≥ 3 sek)" @bind-Value="_ce.ForsinkelseForLukking" Warn="@(_ce.ForsinkelseForLukking == false)" />
                    <label>
                        Avstand til trapp, hengselside (cm) <input @bind="_ce.AvstandTrappCm" type="number" step="0.1" disabled="@_ce.AvstandTrappUnntatt" />
                        <span class="ce-unntak"><input type="checkbox" @bind="_ce.AvstandTrappUnntatt" /> Unntatt CE-krav</span>
                    </label>
                    <label>
                        Avstand til vegg, hengselside (cm) <input @bind="_ce.AvstandVeggCm" type="number" step="0.1" disabled="@_ce.AvstandVeggUnntatt" />
                        <span class="ce-unntak"><input type="checkbox" @bind="_ce.AvstandVeggUnntatt" /> Unntatt CE-krav</span>
                    </label>
                    <TriStateSelect Label="Åpnes mot område med gjennomgangstrafikk" @bind-Value="_ce.ApnesMotGjennomgangstrafikk" />
                </div>
                <label class="ce-kommentar">Kommentarer <textarea @bind="_ce.MalKommentar"></textarea></label>
                break;

            case 5:
                <div class="field-grid">
                    <TriStateSelect Label="Sensorplassering korrekt iht. instruksjoner" @bind-Value="_ce.SensorplasseringKorrekt" Warn="@(_ce.SensorplasseringKorrekt == false)" />
                    <label>
                        Dekningsområde hoveddørblad
                        <select @bind="_ce.DekningsomradeHovedDorblad" @bind:after="OnDekningsomradeEndret">
                            <option value="">Ikke satt</option>
                            @foreach (var alt in CeAlternativer.DekningsomradeAlternativer)
                            {
                                <option value="@alt">@alt</option>
                            }
                        </select>
                    </label>
                    @if (_ce.DekningsomradeHovedDorblad == "I henhold til vedlegg G")
                    {
                        <label>Beskyttet bredde hoveddørblad (mm) <input @bind="_ce.BeskyttetBreddeHovedDorbladMm" type="number" step="0.1" /></label>
                    }
                    <TriStateSelect Label="Reaksjonstid tilfredsstillende, ingen forsinkelse" @bind-Value="_ce.ReaksjonstidOk" Warn="@(_ce.ReaksjonstidOk == false)" />
                    <TriStateSelect Label="Sikkerhetssensor kobles ut ved brannalarm" @bind-Value="_ce.SikkerhetssensorUtkoblingBrannalarm" Warn="@(_ce.SikkerhetssensorUtkoblingBrannalarm == false)" />
                    <TriStateSelect Label="Nødåpningsfunksjon ved brannalarm testet" @bind-Value="_ce.NodapningTestet" />
                    <TriStateSelect Label="Har impulssensor IR eller laser" @bind-Value="_ce.HarImpulssensorIrLaser" />
                    <TriStateSelect Label="Impulsgivere plassert i riktig høyde og tilgjengelighet" @bind-Value="_ce.ImpulsbryterKorrektHoyde" Warn="@(_ce.ImpulsbryterKorrektHoyde == false)" />
                    <TriStateSelect Label="Betjeningsbrytere med tilstrekkelig fri sideplass" @bind-Value="_ce.AktiveringsbryterFriPlass" Warn="@(_ce.AktiveringsbryterFriPlass == false)" />
                    <TriStateSelect Label="Klar merking for alle brukergrupper" @bind-Value="_ce.TydeligSkilting" Warn="@(_ce.TydeligSkilting == false)" />
                    <TriStateSelect Label="Beskyttelse av hengselareal" @bind-Value="_ce.HengselsideBeskyttet" Warn="@(_ce.HengselsideBeskyttet == false)" />
                    <TriStateSelect Label="Elektronisk låskobling testet" @bind-Value="_ce.ElektroniskLasKoblingTestet" Warn="@(_ce.ElektroniskLasKoblingTestet == false)" />
                    <label>Eventuelle ekstra funksjoner testet og logget <input @bind="_ce.EkstraFunksjonerKommentar" placeholder="Skriv inn notater" /></label>
                </div>
                break;

            case 6:
                <label class="ce-checkbox"><input type="checkbox" @bind="_ce.FotograferingIkkeTillatt" /> Fotografering ikke tillatt (Sikret område)</label>

                @if (!_ce.FotograferingIkkeTillatt)
                {
                    <div class="media-upload">
                        <select @bind="_nyMediaPlassering">
                            <option value="@CeGodkjenningMediaPlassering.Hengselside">Hengselside</option>
                            <option value="@CeGodkjenningMediaPlassering.Karmside">Karmside</option>
                            <option value="@CeGodkjenningMediaPlassering.Video">Video</option>
                        </select>
                        <InputFile OnChange="LastOppMedia" accept="image/*,video/*" />
                    </div>

                    @foreach (var gruppe in new[] { CeGodkjenningMediaPlassering.Hengselside, CeGodkjenningMediaPlassering.Karmside, CeGodkjenningMediaPlassering.Video })
                    {
                        var filer = _ce.Media.Where(m => m.Plassering == gruppe).ToList();
                        <h3 class="media-gruppe-tittel">@gruppe.Visningsnavn()</h3>
                        @if (filer.Count == 0)
                        {
                            <p class="list-empty">Ingen filer lagt til.</p>
                        }
                        else
                        {
                            <div class="media-grid">
                                @foreach (var m in filer)
                                {
                                    <div @key="m.Id" class="media-item">
                                        @if (m.ContentType.StartsWith("video/"))
                                        {
                                            <video controls src="@($"/cegodkjenningmedia/{m.Id}")"></video>
                                        }
                                        else
                                        {
                                            <img src="@($"/cegodkjenningmedia/{m.Id}")" alt="@m.Filnavn" />
                                        }
                                        <button type="button" class="remove-button" @onclick="@(() => SlettMedia(m))">Fjern</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
                break;

            case 7:
                <div class="field-grid">
                    <label>
                        QR-kode fra dørskilt
                        <input @bind="_ce.QrKodeSkann" placeholder="Skann eller lim inn kode" />
                    </label>
                </div>
                <a class="qr-link" href="@($"/dor/{_ce.DorId}/qr.png")" target="_blank">Vis dørens QR-kode</a>

                <div class="field-grid ce-signering">
                    <label>
                        Utført av
                        <input value="@(_ce.UtfortAvNavn ?? "-")" disabled />
                        <span class="ce-grense">Hentet fra din itlock Full Kontroll-innlogging</span>
                    </label>
                    <label>Verifisert av <input @bind="_ce.VerifisertAvNavn" placeholder="Navn på verifisør" /></label>
                </div>

                <div class="ce-signatur-rad">
                    <div class="signatur-pad-wrap">
                        <span class="ce-grense">Utførers signatur</span>
                        <canvas id="@UtfortCanvasId" width="400" height="150" class="signatur-canvas"></canvas>
                        <div class="signatur-actions">
                            <button type="button" class="page-button" @onclick="@(() => RensSignaturAsync(UtfortCanvasId))">Tøm</button>
                        </div>
                    </div>
                    <div class="signatur-pad-wrap">
                        <span class="ce-grense">Verifisørens signatur</span>
                        <canvas id="@VerifisertCanvasId" width="400" height="150" class="signatur-canvas"></canvas>
                        <div class="signatur-actions">
                            <button type="button" class="page-button" @onclick="@(() => RensSignaturAsync(VerifisertCanvasId))">Tøm</button>
                        </div>
                    </div>
                </div>
                break;

            case 8:
                <p>
                    <button type="button" class="add-button" @onclick="VisPdfForhandsvisning">Forhåndsvis CE-samsvarssertifikat (PDF)</button>
                </p>
                @if (!string.IsNullOrEmpty(_pdfMelding))
                {
                    <p class="save-success">@_pdfMelding</p>
                }
                <LagredePdfListe Pdfer="@_lagredePdfer" />
                <PdfPreviewModal Url="@_pdfPreviewUrl" Tittel="CE-sertifisering" SaveButtonText="Lagre PDF" SaveMessage="@_pdfMelding"
                                  OnSave="LagreArkivPdf" OnClose="@(() => _pdfPreviewUrl = null)" />

                <h3>Tilbehørsdokumentasjon</h3>
                <table class="dor-table">
                    <thead><tr><th>Navn</th><th>Kategori</th><th>Dokument</th></tr></thead>
                    <tbody>
                        @foreach (var k in Sikkerhet.Concat(Annet))
                        {
                            <tr @key="k.ComponentId">
                                <td>@k.Component?.Navn</td>
                                <td>@(k.Component?.Type?.CeKategori is { } kat ? kat.Visningsnavn() : "Ikke satt")</td>
                                <td>@DokumentLenke(k)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case 9:
                <div class="ce-valideringsresultat @(_valideringGodkjent ? "ce-valid-ok" : "ce-valid-feil")">
                    @(_valideringGodkjent ? "Alle vilkår er oppfylt" : "Ett eller flere vilkår er ikke oppfylt")
                </div>
                <table class="dor-table">
                    <tbody>
                        @foreach (var v in _valideringsresultater)
                        {
                            <tr>
                                <td>@v.Tekst</td>
                                <td class="@(v.Bestatt ? "ce-valid-ok" : "ce-valid-feil")">@(v.Bestatt ? "Godkjent" : "Ikke godkjent")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="field-grid">
                    <label>
                        Status
                        <select @bind="_ce.Status">
                            @foreach (var s in Enum.GetValues<CeGodkjenningStatus>())
                            {
                                <option value="@s">@s.Visningsnavn()</option>
                            }
                        </select>
                    </label>
                </div>
                break;
        }
    </div>

    <div class="ce-navigasjon">
        <button type="button" class="page-button" disabled="@(_steg == 1)" @onclick="Forrige">&larr; Forrige</button>
        <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
        @if (_steg < StegNavn.Length)
        {
            <button type="button" class="page-button" @onclick="Neste">Neste &rarr;</button>
        }
    </div>
}

@code {
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public int Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool StartRedigerbar { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StegNavn =
    [
        "Kundeinfo", "Maskindetaljer", "Dørdesign", "Målinger", "Kontroll",
        "Funksjonstest", "Signering", "Generell dokumentasjon", "Validering"
    ];

    private CeGodkjenning? _ce;
    private bool _notFound;
    private List<DorKomponent> _dorKomponenter = [];
    private CeMaleGrenseverdier _grenser = new();
    private int _steg = 1;
    private string? _feil;
    private string? _melding;
    private string? _pdfMelding;
    private string? _pdfPreviewUrl;
    private CeGodkjenningMediaPlassering _nyMediaPlassering = CeGodkjenningMediaPlassering.Hengselside;
    private List<LagretPdf> _lagredePdfer = [];
    private List<CeValideringsResultat> _valideringsresultater = [];
    private bool _valideringGodkjent;
    private string? _postnr;
    private string? _sted;
    private string? _geokodetAdresse;
    private bool _kartMaOppdateres;
    private bool _signaturMaInitialiseres;
    private bool _redigerbar;
    private bool _redigerbarInitFraParam;

    private bool Låst => !_redigerbar;

    private string MapElementId => $"ce-location-map-{Id}";
    private string UtfortCanvasId => $"ce-sig-utfort-{Id}";
    private string VerifisertCanvasId => $"ce-sig-verifisert-{Id}";

    // Samme regler som farger enkeltfelt gult og som avgjør Validation-resultatet (CeValideringsService),
    // brukt til å sette grønn hake/rødt kryss på step-indikatoren slik at "utfylt og riktig" alltid betyr det samme uansett hvor det vises.
    private bool StegOk(int steg)
    {
        if (_ce is null)
        {
            return false;
        }

        return steg switch
        {
            1 => !string.IsNullOrWhiteSpace(_ce.KundeNavn) && !string.IsNullOrWhiteSpace(_ce.ProsjektNavn) && !string.IsNullOrWhiteSpace(_ce.Adresse),
            2 => !string.IsNullOrWhiteSpace(_ce.Produsent) && !string.IsNullOrWhiteSpace(_ce.ItemNavn),
            3 => !string.IsNullOrWhiteSpace(_ce.GlassIDor) && _ce.FriBredde086.HasValue && _ce.TerskelUnder25mm.HasValue && _ce.KuttskadeRisiko.HasValue
                 && !string.IsNullOrWhiteSpace(_ce.Dorkonstruksjon) && !string.IsNullOrWhiteSpace(_ce.Karmkonstruksjon)
                 && CeValideringsService.ErGlassOk(_ce) && CeValideringsService.ErFriBreddeOk(_ce)
                 && CeValideringsService.ErTerskelOk(_ce) && CeValideringsService.ErKuttskaderisikoOk(_ce),
            4 => _ce.Apningsvinkel.HasValue && _ce.ApningstidSek.HasValue && _ce.LukketidHoySek.HasValue && _ce.LukketidLavSek.HasValue && _ce.ApningskraftN.HasValue
                 && _ce.DodlasEtterStopp.HasValue && _ce.ForsinkelseForLukking.HasValue && _ce.ApnesMotGjennomgangstrafikk.HasValue
                 && CeValideringsService.ErApningstidOk(_ce, _grenser) && CeValideringsService.ErLukketidHoyOk(_ce, _grenser)
                 && CeValideringsService.ErLukketidLavOk(_ce, _grenser) && CeValideringsService.ErApningskraftOk(_ce, _grenser)
                 && CeValideringsService.ErDodlasOk(_ce) && CeValideringsService.ErForsinkelseOk(_ce),
            5 => _ce.NodapningTestet.HasValue
                 && CeValideringsService.ErHengselsideOk(_ce) && CeValideringsService.ErBrannalarmUtkoblingOk(_ce)
                 && CeValideringsService.ErAktiveringsbryterOk(_ce) && CeValideringsService.ErImpulsbryterOk(_ce)
                 && CeValideringsService.ErLaskoblingOk(_ce) && CeValideringsService.ErSkiltingOk(_ce)
                 && Sikkerhet.Count > 0 && CeValideringsService.ErSensorplasseringOk(_ce) && CeValideringsService.ErReaksjonstidOk(_ce),
            6 => _ce.Media.Count > 0 || _ce.FotograferingIkkeTillatt,
            7 => !string.IsNullOrWhiteSpace(_ce.UtfortAvNavn),
            8 => true,
            9 => _valideringGodkjent,
            _ => true
        };
    }

    private List<DorKomponent> Sikkerhet => _dorKomponenter.Where(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.SikkerhetsTilbehor).ToList();
    private List<DorKomponent> Annet => _dorKomponenter.Where(k => k.Component?.Type?.CeKategori == CeTilbehorKategori.AnnetTilbehor).ToList();

    protected override async Task OnParametersSetAsync()
    {
        _ce = await Db.CeGodkjenninger
            .Include(c => c.Dor).ThenInclude(d => d!.Prosjekt)
            .Include(c => c.Media)
            .FirstOrDefaultAsync(c => c.Id == Id);

        if (_ce is null)
        {
            _notFound = true;
            return;
        }

        _notFound = false;

        if (!_redigerbarInitFraParam)
        {
            _redigerbarInitFraParam = true;
            _redigerbar = StartRedigerbar;
        }

        _postnr = _ce.Dor?.Prosjekt?.Postnr;
        _sted = _ce.Dor?.Prosjekt?.Sted;
        _geokodetAdresse = _ce.Adresse;

        if (string.IsNullOrWhiteSpace(_ce.UtfortAvNavn) && AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var brukerId))
            {
                var navn = await Db.Brukere.Where(b => b.Id == brukerId).Select(b => b.Navn).FirstOrDefaultAsync();
                if (!string.IsNullOrWhiteSpace(navn))
                {
                    _ce.UtfortAvNavn = navn;
                    _ce.UtfortAvDato = DateTime.Now;
                    await Db.SaveChangesAsync();
                }
            }
        }

        _dorKomponenter = await Db.DorKomponenter
            .Where(k => k.DorId == _ce.DorId)
            .Include(k => k.Component).ThenInclude(c => c!.Type)
            .ToListAsync();

        _grenser = await Db.CeMaleGrenseverdier.FirstOrDefaultAsync() ?? new CeMaleGrenseverdier();
        _lagredePdfer = await LagretPdfService.HentAsync("CeGodkjenning", Id);

        _kartMaOppdateres = _steg == 1 && _ce.Latitude.HasValue;
        _signaturMaInitialiseres = _steg == 7;
        OppdaterValidering();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ce is not null && !_ce.Latitude.HasValue && !string.IsNullOrWhiteSpace(_ce.Adresse))
        {
            // Geokodes etter første rendering slik at et tregt/utilgjengelig eksternt kalt ikke blokkerer sideåpningen.
            await GeokodAdresseAsync(lagre: false);
            if (_ce.Latitude.HasValue)
            {
                _kartMaOppdateres = _steg == 1;
                StateHasChanged();
            }
            return;
        }

        if (_kartMaOppdateres && _ce is { Latitude: not null, Longitude: not null })
        {
            _kartMaOppdateres = false;
            var data = new[] { new { lat = _ce.Latitude.Value, lng = _ce.Longitude.Value, tittel = _ce.Adresse ?? "", undertekst = "" } };
            await JS.InvokeVoidAsync("kart.init", MapElementId, data);
        }

        if (_signaturMaInitialiseres && _steg == 7)
        {
            _signaturMaInitialiseres = false;
            await JS.InvokeVoidAsync("signatur.init", UtfortCanvasId);
            await JS.InvokeVoidAsync("signatur.init", VerifisertCanvasId);
        }
    }

    private async Task RensSignaturAsync(string canvasId)
    {
        await JS.InvokeVoidAsync("signatur.clear", canvasId);
    }

    private async Task LagreSignaturerAsync()
    {
        if (_ce is null)
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("signatur.isEmpty", UtfortCanvasId))
        {
            var b64 = await JS.InvokeAsync<string>("signatur.getPngBase64", UtfortCanvasId);
            _ce.UtfortAvSignatur = Convert.FromBase64String(b64);
        }

        if (!await JS.InvokeAsync<bool>("signatur.isEmpty", VerifisertCanvasId))
        {
            var b64 = await JS.InvokeAsync<string>("signatur.getPngBase64", VerifisertCanvasId);
            _ce.VerifisertAvSignatur = Convert.FromBase64String(b64);
        }
    }

    private void OppdaterValidering()
    {
        _valideringsresultater = CeValideringsService.Evaluer(_ce!, _dorKomponenter);
        _valideringGodkjent = _valideringsresultater.All(v => v.Bestatt);
    }

    private async Task OppdaterGyldighetAsync(ChangeEventArgs e)
    {
        if (_ce is null || !int.TryParse(e.Value?.ToString(), out var måneder))
        {
            return;
        }

        _ce.GyldighetMåneder = måneder;
        _ce.GyldigTil = _ce.GyldigFra.AddMonths(måneder);
        await Db.SaveChangesAsync();
    }

    private async Task GeokodAdresseAsync(bool lagre = true)
    {
        if (_ce is null || string.IsNullOrWhiteSpace(_ce.Adresse))
        {
            return;
        }

        var treff = await Geokoding.GeocodeAsync(_ce.Adresse, _postnr, _sted);
        if (treff is null)
        {
            _ce.Latitude = null;
            _ce.Longitude = null;
            return;
        }

        _ce.Latitude = treff.Value.Latitude;
        _ce.Longitude = treff.Value.Longitude;
        _geokodetAdresse = _ce.Adresse;
        _kartMaOppdateres = true;

        if (lagre)
        {
            await Db.SaveChangesAsync();
        }
    }

    private void OnDekningsomradeEndret()
    {
        if (_ce!.DekningsomradeHovedDorblad == "I henhold til vedlegg G" && _ce.BeskyttetBreddeHovedDorbladMm is null)
        {
            _ce.BeskyttetBreddeHovedDorbladMm = 0.7;
        }
    }

    private static bool OverGrense(double? verdi, double grense, bool unntatt) =>
        !unntatt && verdi > grense;

    private bool ValiderMalSteg()
    {
        _feil = null;
        var feilmeldinger = new List<string>();

        if (_ce!.ApningstidSek > _grenser.MaksApningstidSek)
        {
            feilmeldinger.Add($"Åpningstid ({_ce.ApningstidSek} sek) overstiger maks {_grenser.MaksApningstidSek} sek.");
        }
        if (_ce.LukketidHoySek > _grenser.MaksLukketidHoySek)
        {
            feilmeldinger.Add($"Lukketid 90-10° ({_ce.LukketidHoySek} sek) overstiger maks {_grenser.MaksLukketidHoySek} sek.");
        }
        if (_ce.LukketidLavSek > _grenser.MaksLukketidLavSek)
        {
            feilmeldinger.Add($"Lukketid 10-0° ({_ce.LukketidLavSek} sek) overstiger maks {_grenser.MaksLukketidLavSek} sek.");
        }
        if (_ce.ApningskraftN > _grenser.MaksApningskraftN)
        {
            feilmeldinger.Add($"Åpningskraft ({_ce.ApningskraftN} N) overstiger maks {_grenser.MaksApningskraftN} N.");
        }

        if (feilmeldinger.Count == 0)
        {
            return true;
        }

        _feil = string.Join(" ", feilmeldinger) + " Korriger verdien for å fortsette.";
        return false;
    }

    private async Task Neste()
    {
        if (_steg == 4 && !ValiderMalSteg())
        {
            return;
        }

        await Lagre();
        if (_steg < StegNavn.Length)
        {
            _steg++;
            if (_steg == 1)
            {
                _kartMaOppdateres = _ce?.Latitude.HasValue == true;
            }
            else if (_steg == 7)
            {
                _signaturMaInitialiseres = true;
            }
        }
    }

    private async Task Forrige()
    {
        await Lagre();
        if (_steg > 1)
        {
            _steg--;
            if (_steg == 7)
            {
                _signaturMaInitialiseres = true;
            }
        }
    }

    private async Task Lagre()
    {
        if (_ce is null)
        {
            return;
        }

        if (_steg == 1 && !string.IsNullOrWhiteSpace(_ce.Adresse) && _ce.Adresse != _geokodetAdresse)
        {
            await GeokodAdresseAsync(lagre: false);
        }

        if (_steg == 7 && !_signaturMaInitialiseres)
        {
            await LagreSignaturerAsync();
        }

        if (!string.IsNullOrWhiteSpace(_ce.UtfortAvNavn) && _ce.UtfortAvDato is null)
        {
            _ce.UtfortAvDato = DateTime.Now;
        }
        if (!string.IsNullOrWhiteSpace(_ce.VerifisertAvNavn) && _ce.VerifisertAvDato is null)
        {
            _ce.VerifisertAvDato = DateTime.Now;
        }

        _ce.OppdatertDato = DateTime.Now;
        await Db.SaveChangesAsync();

        OppdaterValidering();
        _melding = "Lagret.";
    }

    private async Task LastOppMedia(InputFileChangeEventArgs e)
    {
        _feil = null;
        var file = e.File;

        if (file.Size > 50_000_000)
        {
            _feil = $"\"{file.Name}\" er for stor (maks 50 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 50_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var media = new CeGodkjenningMedia
        {
            CeGodkjenningId = Id,
            Data = buffer.ToArray(),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
            Filnavn = file.Name,
            Plassering = _nyMediaPlassering
        };
        Db.CeGodkjenningMedia.Add(media);
        await Db.SaveChangesAsync();

        _ce!.Media.Add(media);
        OppdaterValidering();
    }

    private async Task SlettMedia(CeGodkjenningMedia media)
    {
        var entitet = await Db.CeGodkjenningMedia.FindAsync(media.Id);
        if (entitet is null)
        {
            return;
        }

        Db.CeGodkjenningMedia.Remove(entitet);
        await Db.SaveChangesAsync();

        _ce!.Media.Remove(media);
        OppdaterValidering();
    }

    private void VisPdfForhandsvisning()
    {
        _pdfMelding = null;
        _pdfPreviewUrl = $"/ce/{Id}/pdf";
    }

    private async Task LagreArkivPdf()
    {
        var bytes = await PdfService.GenerateAsync(Id);
        if (bytes is null)
        {
            return;
        }

        var pdf = await LagretPdfService.LagreAsync(
            "CeGodkjenning", Id, $"CE-sertifisering - {_ce?.Sertifiseringsnummer} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredePdfer.Insert(0, pdf);
        _pdfMelding = "PDF-en er lagret i arkivet.";
    }

    private async Task Lukk()
    {
        await OnClose.InvokeAsync();
    }

    private RenderFragment DokumentLenke(DorKomponent k) => builder =>
    {
        if (k.Component?.FdvData is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/komponent/{k.Component.Id}/fdv");
            builder.AddAttribute(2, "target", "_blank");
            builder.AddContent(3, "Vis dokument");
            builder.CloseElement();
        }
        else if (k.Component?.Type?.CeDokumentData is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/komponenttype/{k.Component.Type.Id}/ce-dokument");
            builder.AddAttribute(2, "target", "_blank");
            builder.AddContent(3, "Vis standarddokument (beslagstype)");
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(0, "Ingen dokumentasjon");
        }
    };
}
