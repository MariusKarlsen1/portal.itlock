            </select>
        </div>
        <div class="sdp-sok-res">
            @if (_register is null)
            {
                <p class="sdp-sok-tom">Laster komponentregisteret …</p>
            }
            else if (grupper.Count == 0)
            {
                <div class="sdp-sok-tom">
                    Ingen varer i komponentregisteret passer@(string.IsNullOrWhiteSpace(_sok) ? " filteret" : $" «{_sok.Trim()}»").
