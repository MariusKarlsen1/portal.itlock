            <select class="sdp-sok-lev" value="@_sokLev" @onchange="@(e => { _sokLev = (string)e.Value!; _fokus = 0; })">
                <option value="">Alle leverandører</option>
                @foreach (var l in Leverandorer)
                {
                    <option value="@l">@l</option>
