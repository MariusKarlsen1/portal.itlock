@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

@* Serviceavtale → «Dører og beslag» D8 (Prototype serviceavtalemodul komplett PC.html):
   enkel tabell Dør · Rom · Etasje · Status. Trykk på en dør åpner dørkortet K1 som
   forhåndsvisning – man blir værende i serviceavtalen og havner ikke i prosjektet. *@
@* M1 (Prototype etter ny serviceavtale enkel.html): nye dører skrives rett inn nederst
   i tabellen – dørtype eller avkrysning av beslagene, og kategori og pris kommer fra
   prisreglene med en gang. *@
<section class="sdp">
    <div class="sdp-topp">
        <b>Dører og beslag</b>
        <span class="sdp-mini">@_dorer.Count @(_dorer.Count == 1 ? "dør" : "dører")</span>
        <span class="sdp-sp"></span>
        @if (KanRedigere)
        {
            @* E1 «Rett i listen» og E3 «Avkrysning» (Prototype serviceavtale rediger dorer.html) *@
            <span class="sdp-seg">
                <button type="button" class="@(_visning == "liste" ? "pa" : "")" @onclick="@(() => _visning = "liste")">Liste</button>
                <button type="button" class="@(_visning == "kryss" ? "pa" : "")" @onclick="@(() => { _visning = "kryss"; _red = false; _valgte.Clear(); })">Avkrysning</button>
            </span>
            @if (_visning == "liste")
            {
                <button type="button" class="sdp-knapp @(_red ? "sdp-knapp-gronn" : "")" @onclick="@(() => { _red = !_red; _valgte.Clear(); })"><Icon Name="@(_red ? "check" : "edit")" />@(_red ? "Ferdig" : "Rediger dører")</button>
            }
            <button type="button" class="sdp-knapp" @onclick="OnPlantegninger"><Icon Name="map" />Plantegninger</button>
            <button type="button" class="sdp-knapp" @onclick="OnImporter"><Icon Name="upload" />Importer fra Excel</button>
        }
    </div>

    @if (_lastet && KanRedigere && _dorer.Count(d => d.PlantegningId is null || d.PosX is null) is var uplassert and > 0)
    {
        <div class="sdp-plass">
            <Icon Name="map" />
            <span><b>@uplassert @(uplassert == 1 ? "dør er" : "dører er") ikke plassert på plantegning.</b> Plasser dem, så kommer de opp på tegningen i servicerunden.</span>
            <span class="sdp-sp"></span>
            @if (_tegningIder.Count == 1)
            {
                <a class="sdp-knapp sdp-liten" href="@($"/plantegning/{_tegningIder[0]}")">Plasser på tegningen</a>
            }
            else
            {
                <button type="button" class="sdp-knapp sdp-liten" @onclick="OnPlantegninger">@(_tegningIder.Count == 0 ? "Last opp plantegning" : "Velg plantegning")</button>
            }
        </div>
    }

    @if (!_lastet)
    {
        <p class="sdp-tom">Laster dører …</p>
    }
    else if (_dorer.Count == 0 && !KanRedigere)
    {
        <p class="sdp-tom">Avtalen har ingen dører ennå.</p>
    }
    else
    {
        @if (_visning == "kryss" && KanRedigere)
        {
            @Avkrysning()
        }
        else
        {
        @if (_red)
        {
            <p class="sdp-hjelp">Trykk på et beslag for å velge vare · × fjerner · «+ Beslag» legger til. Kryss av flere dører for å legge til på alle.</p>
        }
        <div class="sdp-wrap">
            <table class="sdp-tb sdp-m1">
                <thead><tr>@if (_red) {<th class="sdp-k-cb"><input type="checkbox" checked="@(_dorer.Count > 0 && _valgte.Count == _dorer.Count)" @onchange="VelgAlle" /></th>}<th class="sdp-k-nr">Dør</th><th class="sdp-k-rom">Rom</th><th class="sdp-k-etg">Etasje</th><th>Beslag</th>@if (VisPriser) {<th class="n">Kategori · per runde</th>}<th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in _dorer)
                    {
                        var res = _res.GetValueOrDefault(d.Id);
                        <tr @key="d.Id" class="@(_valgte.Contains(d.Id) ? "sdp-valgt" : "")" @onclick="@(() => { if (!_red) { _valgt = d; } })">
                            @if (_red)
                            {
                                <td class="sdp-k-cb" @onclick:stopPropagation="true"><input type="checkbox" checked="@_valgte.Contains(d.Id)" @onchange="@(() => { if (!_valgte.Remove(d.Id)) { _valgte.Add(d.Id); } })" /></td>
                            }
                            <td class="sdp-nr"><i class="sdp-dot @d.Farge"></i><b>@d.Dornummer</b></td>
                            <td>@(d.Rom ?? "–")</td>
                            <td>@(d.Etasje ?? "–")</td>
                            @if (_red)
                            {
                                <td>
                                    <div class="sdp-bcs">
                                        @foreach (var b in d.Beslag)
                                        {
                                            <span class="sdp-bc @(b.ErPlassholder ? "ps" : "")" title="Trykk for å velge vare" @onclick="@(() => ApneVare(d, b))">
                                                @b.Type<small>@(b.ErPlassholder ? "velg vare" : b.Produkt)@(b.Antall > 1 ? $" × {b.Antall}" : "")</small>
                                                <button type="button" class="sdp-bc-x" title="Fjern" @onclick="@(() => FjernBeslag(d, b))" @onclick:stopPropagation="true">×</button>
                                            </span>
                                        }
                                        <button type="button" class="sdp-legg" @onclick="@(() => ApneLeggTil(d.Id))">+ Beslag</button>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td>@foreach (var t in d.Beslag.Select(b => b.Type).Distinct()) {<span class="sdp-tag">@t</span>}</td>
                            }
                            @if (VisPriser)
                            {
                                <td class="n sdp-pris">@if (res is not null) {<span class="sdp-kat">@res.Kategori</span><b>@(res.Regel is null ? "–" : Kr(ServiceRegelMotor.PrisForKategori(res.Regel, _kp)))</b>}</td>
                            }
                            <td><StatusPill Tekst="@StatusTekst(d.Farge)" Ikon="@StatusIkon(d.Farge)" Farge="@d.Farge" /></td>
                            <td class="n"><button type="button" class="sdp-knapp sdp-liten" @onclick="@(() => _valgt = d)" @onclick:stopPropagation="true">Dørkort</button></td>
                        </tr>
                    }
                    @if (KanRedigere && !_red)
                    {
                        var ny = NyResultat();
                        <tr class="sdp-ny">
                            <td><input class="sdp-in" @bind="_nyNr" /></td>
                            <td><input class="sdp-in" @bind="_nyRom" placeholder="Rom" /></td>
                            <td><input class="sdp-in" @bind="_nyEtg" placeholder="Etasje" /></td>
                            <td>
                                <select class="sdp-in" @onchange="VelgMal">
                                    <option value="">Dørtype …</option>
                                    @foreach (var m in ServiceBefaring.Maler)
                                    {
                                        <option value="@m.Navn">@m.Navn</option>
                                    }
                                </select>
                            </td>
                            @if (VisPriser)
                            {
                                <td class="n sdp-pris">@if (ny is not null) {<span class="sdp-kat">@ny.Kategori</span><b>@(ny.Regel is null ? "–" : Kr(ServiceRegelMotor.PrisForKategori(ny.Regel, _kp)))</b>}</td>
                            }
                            <td colspan="2"></td>
                        </tr>
                        <tr class="sdp-ny sdp-ny2">
                            <td></td>
                            <td colspan="@(VisPriser ? 6 : 5)">
                                <div class="sdp-chips">
                                    @foreach (var t in ServiceRegelMotor.Servicetyper)
                                    {
                                        <button type="button" class="sdp-chip @(_nyTyper.Contains(t) ? "pa" : "")" @onclick="@(() => VekslNy(t))">@t</button>
                                    }
                                    <span class="sdp-sp"></span>
                                    @if (_melding is not null)
                                    {
                                        <span class="sdp-mini">@_melding</span>
                                    }
                                    <button type="button" class="sdp-knapp sdp-knapp-p" @onclick="LeggTilDor" disabled="@(_lagrer || string.IsNullOrWhiteSpace(_nyNr))">Legg til dør</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_red && _valgte.Count > 0)
        {
            <div class="sdp-bulk">
                <b>@_valgte.Count @(_valgte.Count == 1 ? "dør" : "dører") valgt</b>
                <span class="sdp-sp"></span>
                <button type="button" class="sdp-knapp sdp-liten" @onclick="@(() => ApneLeggTil(null))">+ Legg til beslag på alle</button>
                <button type="button" class="sdp-knapp sdp-liten" @onclick="@(() => _valgte.Clear())">Avbryt</button>
            </div>
        }
        }
        @if (VisPriser && _dorer.Count > 0 && _beregning is { } be)
        {
            <div class="sdp-sum"><span>@_dorer.Count @(_dorer.Count == 1 ? "dør" : "dører")</span><span>·</span><span>Pris per år</span><b>@Kr(be.Arspris)</b></div>
        }
    }
</section>

@if (_pop is { } pop)
{
    <div class="sdp-bak" @onclick="LukkPop">
        <div class="sdp-pop" @onclick:stopPropagation="true">
            <div class="sdp-pop-h">
                <b>@PopTittel(pop)</b>
                <span class="sdp-sp"></span>
                <button type="button" class="sdp-x" title="Lukk" @onclick="LukkPop">×</button>
            </div>
            <div class="sdp-pop-b">
                @if (pop.Modus == "leggtil")
                {
                    <span class="sdp-mini">Typen legges til som «ikke spesifisert». Velg vare nå eller senere.</span>
                    <div class="sdp-typer">
                        @foreach (var st in ServiceRegelMotor.Servicetyper)
                        {
                            <button type="button" class="sdp-chip" @onclick="@(() => LeggTilServicetype(st))">@st</button>
                        }
                        @foreach (var t in EgneTyper)
                        {
                            <button type="button" class="sdp-chip" @onclick="@(() => LeggTilType(t))">@t.Navn</button>
                        }
                        <button type="button" class="sdp-chip sdp-chip-ny" @onclick="@(() => { _pop = pop with { Modus = "nytype" }; _nyTypeNavn = ""; _nyTypeService = ""; })">+ Ny type</button>
                    </div>
                }
                else if (pop.Modus == "nytype")
                {
                    <label class="sdp-felt"><span>Navn på komponenttypen</span><input class="sdp-in" @bind="_nyTypeNavn" @bind:event="oninput" placeholder="F.eks. Holdemagnet" /></label>
                    <label class="sdp-felt">
                        <span>Prises og sjekkes som</span>
                        <select class="sdp-in" @bind="_nyTypeService">
                            <option value="">Egen type</option>
                            @foreach (var st in ServiceRegelMotor.Servicetyper)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </label>
                    @if (_typeFeil is not null)
                    {
                        <span class="sdp-feil">@_typeFeil</span>
                    }
                    <div class="sdp-pop-f">
                        <button type="button" class="sdp-knapp sdp-liten" @onclick="@(() => _pop = pop with { Modus = "leggtil" })">Tilbake</button>
                        <button type="button" class="sdp-knapp sdp-liten sdp-knapp-p" disabled="@string.IsNullOrWhiteSpace(_nyTypeNavn)" @onclick="OpprettType">Opprett og legg til</button>
                    </div>
                }
                else if (pop.Modus == "vare")
                {
                    <input class="sdp-in" placeholder="Søk vare eller varenr …" value="@_vareSok" @oninput="SokVare" />
                    <div class="sdp-varer">
                        @foreach (var c in _vareTreff)
                        {
                            <button type="button" class="@(c.Id == pop.ComponentId ? "pa" : "")" @onclick="@(() => VelgVare(c.Id))">@c.Navn<small>@(c.Produktkode ?? "")</small></button>
                        }
                        @if (_vareTreff.Count == 0)
                        {
                            <span class="sdp-mini">Ingen varer av denne typen@(string.IsNullOrWhiteSpace(_vareSok) ? "" : " med det søket")</span>
                        }
                        @if (pop.PlassholderId is { } plId)
                        {
                            <button type="button" class="@(pop.ErPlassholder ? "pa" : "")" @onclick="@(() => VelgVare(plId))">Ikke spesifisert<small>velg senere</small></button>
                        }
                    </div>
                    <div class="sdp-pop-f">
                        <label class="sdp-ant">Antall <input type="number" min="1" value="@pop.Antall" @onchange="SettAntall" /></label>
                        <span class="sdp-sp"></span>
                        <button type="button" class="sdp-knapp sdp-liten sdp-fjern" @onclick="FjernFraPop">Fjern fra døren</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (_valgt is { } v)
{
    var historikk = Historikk(v);
    var dok = Dokumenter(v);
    <div class="sdp-bak" @onclick="@(() => _valgt = null)">
        <div class="sdp-dlg" @onclick:stopPropagation="true">
            <div class="sdp-dh">
                <i class="sdp-dot stor @v.Farge"></i>
                <span class="sdp-dh-t">Dørkort @v.Dornummer</span>
                <span class="sdp-mini">@(v.Rom ?? "")@(v.Etasje is null ? "" : $" · {v.Etasje}")</span>
                @if (!string.IsNullOrWhiteSpace(v.Kategori))
                {
                    <StatusPill Tekst="@v.Kategori" Ikon="tag" Farge="blaa" />
                }
                <StatusPill Tekst="@StatusTekst(v.Farge)" Ikon="@StatusIkon(v.Farge)" Farge="@v.Farge" />
                <span class="sdp-sp"></span>
                <span class="sdp-forh">Forhåndsvisning</span>
                <button type="button" class="sdp-x" title="Lukk" @onclick="@(() => _valgt = null)">×</button>
            </div>
            <div class="sdp-info">
                <span>Montert <b>@(v.MontertDato?.ToString("dd.MM.yyyy") ?? "–")</b></span>
                <span>Beslag <b>@v.Beslag.Count</b></span>
                <span>Sist kontrollert <b>@(v.SistKontrollert?.ToString("dd.MM.yyyy") ?? "ikke ennå")</b></span>
                <span>Åpne saker <b class="@(v.Saker.Count > 0 ? "sdp-rod" : "")">@v.Saker.Count</b></span>
            </div>
            <div class="sdp-db">
                <div class="sdp-kol">
                    @if (v.PlantegningId is { } pid && v.TegningErBilde && v.PosX is { } px && v.PosY is { } py)
                    {
                        <div class="sdp-plan">
                            <img src="@($"/plantegningbilde/{pid}")" alt="Plantegning" />
                            <span class="sdp-pin" style="left:@px.ToString(CultureInfo.InvariantCulture)%;top:@py.ToString(CultureInfo.InvariantCulture)%"><i class="@v.Farge"></i><span>@v.Dornummer</span></span>
                        </div>
                    }
                    else
                    {
                        <div class="sdp-plan sdp-plan-tom"><Icon Name="map" /><span>Døren er ikke plassert på en plantegning.</span></div>
                    }
                    <div class="sdp-s">
                        <div class="sdp-sh"><b>Funksjoner</b></div>
                        <div class="sdp-chips">
                            @if (v.Funksjoner.Count == 0)
                            {
                                <span class="sdp-mini">Ingen registrert</span>
                            }
                            @foreach (var f in v.Funksjoner)
                            {
                                <span class="sdp-chip">@f</span>
                            }
                        </div>
                    </div>
                    <div class="sdp-s">
                        <div class="sdp-sh"><b>Dørdata</b></div>
                        @foreach (var (navn, verdi) in Dordata(v))
                        {
                            <div class="sdp-rad"><span class="sdp-mini sdp-lbl">@navn</span><b>@verdi</b></div>
                        }
                    </div>
                </div>
                <div class="sdp-kol">
                    <div class="sdp-s">
                        <div class="sdp-sh"><b>Beslag på døren</b><small>@v.Beslag.Count stk</small></div>
                        @if (v.Beslag.Count == 0)
                        {
                            <div class="sdp-rad sdp-mini">Ingen beslag registrert på døren.</div>
                        }
                        else
                        {
                            <table class="sdp-tb">
                                <thead><tr><th>Beslag</th><th>Produkt</th><th>Leverandør · varenr</th><th class="n">Ant.</th><th>Montert</th></tr></thead>
                                <tbody>
                                    @foreach (var b in v.Beslag)
                                    {
                                        <tr>
                                            <td><b>@b.Type</b></td>
                                            <td>
                                                @if (b.ErPlassholder)
                                                {
                                                    <span class="sdp-gul">Ikke spesifisert</span>
                                                }
                                                else
                                                {
                                                    @b.Produkt
                                                }
                                            </td>
                                            <td class="sdp-mini">@(b.Leverandor ?? "–") · @(b.Varenr ?? "–")</td>
                                            <td class="n">@b.Antall</td>
                                            <td>@(b.MontertDato?.ToString("dd.MM.yyyy") ?? "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="sdp-to">
                        <div class="sdp-s">
                            <div class="sdp-sh"><b>Historikk</b></div>
                            @if (historikk.Count == 0)
                            {
                                <div class="sdp-rad sdp-mini">Ingen hendelser ennå.</div>
                            }
                            @foreach (var h in historikk)
                            {
                                <div class="sdp-rad">
                                    <span class="sdp-mini sdp-dato">@h.Dato.ToString("dd.MM.yyyy")</span>
                                    <span class="sdp-t"><b>@h.Tittel</b>@if (!string.IsNullOrWhiteSpace(h.Tekst)) {<small>@h.Tekst</small>}</span>
                                    <i class="sdp-dot @h.Farge"></i>
                                </div>
                            }
                        </div>
                        <div class="sdp-s">
                            <div class="sdp-sh"><b>Dokumenter og bilder</b></div>
                            @if (dok.Count == 0)
                            {
                                <div class="sdp-rad sdp-mini">Ingen dokumenter eller bilder.</div>
                            }
                            @foreach (var x in dok)
                            {
                                <div class="sdp-rad">
                                    <span class="sdp-ik @(x.Type == "IMG" ? "bla" : "rod")">@x.Type</span>
                                    <span class="sdp-t"><b>@x.Navn</b><small>@x.Kilde</small></span>
                                    <a class="sdp-knapp sdp-liten" href="@x.Url" target="_blank">Vis</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="sdp-df">
                <span class="sdp-mini">Dørkortet vises her – du blir værende i serviceavtalen.</span>
                <span class="sdp-sp"></span>
                <a class="sdp-knapp" href="@($"/dor/{v.Id}/etikett.pdf")" target="_blank"><Icon Name="printer" />Etikett</a>
                @if (KanRedigere)
                {
                    <a class="sdp-knapp" href="@($"/dor/{v.Id}")"><Icon Name="edit" />Rediger</a>
                }
                <button type="button" class="sdp-knapp sdp-knapp-p" @onclick="@(() => _valgt = null)">Lukk</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ProsjektId { get; set; }
    [Parameter] public bool KanRedigere { get; set; } = true;
    [Parameter] public EventCallback OnPlantegninger { get; set; }
    [Parameter] public EventCallback OnImporter { get; set; }
    [Parameter] public bool VisPriser { get; set; } = true;
    [Parameter] public EventCallback OnEndret { get; set; }

    // M1: prisregler og plassholdere for å legge inn dører med beslagstyper.
    private Prosjekt? _prosjekt;
    private List<ServicePrisRegel> _regler = [];
    private Dictionary<int, string?> _typeKart = [];
    private List<ServiceKategoriPris> _kp = [];
    private Dictionary<string, Component> _plass = [];
    private Dictionary<int, ServiceRegelMotor.Resultat> _res = [];
    private ServiceRegelMotor.Beregning? _beregning;
    private string _nyNr = "1";
    private string? _nyRom, _nyEtg;
    private List<string> _nyTyper = ["Dørvrider", "Mekanisk lås", "Sylinder"];
    private string? _melding;
    private bool _lagrer;
    private List<int> _tegningIder = [];

    private static string Kr(decimal v) => "kr " + v.ToString("#,##0", CultureInfo.GetCultureInfo("nb-NO"));

    private ServiceRegelMotor.Resultat? NyResultat() => _regler.Count == 0 ? null : ServiceRegelMotor.Klassifiser(new Dor
    {
        Dornummer = "",
        Komponenter = _nyTyper.Where(_plass.ContainsKey).Select(t => new DorKomponent { Component = _plass[t], ComponentId = _plass[t].Id }).ToList()
    }, _regler, _typeKart);

    private void VekslNy(string t)
    {
        if (!_nyTyper.Remove(t))
        {
            _nyTyper.Add(t);
        }
    }

    private void VelgMal(ChangeEventArgs e)
    {
        if (ServiceBefaring.Maler.FirstOrDefault(m => m.Navn == e.Value?.ToString()) is { } mal)
        {
            _nyTyper = mal.Typer.ToList();
        }
    }

    private async Task LastPriser()
    {
        await ServiceRegelMotor.SikreStandardregler(Db);
        if (KanRedigere)
        {
            _plass = await ServiceBefaring.SikrePlassholdere(Db);
        }
        _regler = await ServiceRegelMotor.HentRegler(Db);
        _typeKart = await ServiceRegelMotor.HentTypeKart(Db);
        _typer = await Db.ComponentTypes.AsNoTracking().OrderBy(t => t.Sortering).ThenBy(t => t.Navn).ToListAsync();
        _kp = await Db.ServiceKategoriPriser.AsNoTracking().Where(k => k.ProsjektId == ProsjektId).ToListAsync();
        _prosjekt = await Db.Prosjekter.AsNoTracking().FirstOrDefaultAsync(p => p.Id == ProsjektId);
        var ent = await ServiceRegelMotor.HentDorer(Db, ProsjektId);
        _res = ent.ToDictionary(d => d.Id, d => ServiceRegelMotor.Klassifiser(d, _regler, _typeKart));
        var treff = _res.Values.Where(r => r.Regel is not null).ToList();
        _beregning = _prosjekt is null ? null : ServiceRegelMotor.Beregn(_prosjekt,
            treff.Sum(r => ServiceRegelMotor.PrisForKategori(r.Regel!, _kp)), treff.Sum(r => r.Regel!.Minutter), _kp);
        _nyNr = ServiceBefaring.NesteDornummer(ent.Select(d => d.Dornummer));
        _tegningIder = await Db.Plantegninger.AsNoTracking()
            .Where(p => p.ProsjektId == ProsjektId && p.ContentType.StartsWith("image/"))
            .OrderBy(p => p.Navn).Select(p => p.Id).ToListAsync();
    }

    private async Task LeggTilDor()
    {
        var nr = _nyNr.Trim();
        if (nr.Length == 0 || _lagrer)
        {
            return;
        }
        if (_dorer.Any(d => string.Equals(d.Dornummer, nr, StringComparison.OrdinalIgnoreCase)))
        {
            _melding = $"Dør {nr} finnes allerede.";
            return;
        }
        _lagrer = true;
        try
        {
            var dor = new Dor
            {
                ProsjektId = ProsjektId,
                Dornummer = nr,
                Romnr = string.IsNullOrWhiteSpace(_nyRom) ? null : _nyRom.Trim(),
                Etasje = string.IsNullOrWhiteSpace(_nyEtg) ? null : _nyEtg.Trim()
            };
            foreach (var t in _nyTyper.Distinct().Where(_plass.ContainsKey))
            {
                dor.Komponenter.Add(new DorKomponent { ComponentId = _plass[t].Id, Antall = 1, Montert = true });
            }
            Db.Dorer.Add(dor);
            Db.LoggMerknad = "Befaring";
            await Db.SaveChangesAsync();
            Db.LoggMerknad = null;
            _melding = $"Dør {nr} er lagt til.";
            _nyRom = null;
            await LastAsync();
            await OnEndret.InvokeAsync();
        }
        finally
        {
            _lagrer = false;
        }
    }

    private sealed record BeslagRad(int ComponentId, string Type, string Produkt, string? Leverandor, string? Varenr, int Antall, DateTime? MontertDato, bool ErPlassholder, int? TypeId = null);

    // ---- E1 «Rett i listen» og E3 «Avkrysning» ----
    private string _visning = "liste";
    private bool _red;
    private readonly HashSet<int> _valgte = [];
    private List<ComponentType> _typer = [];
    private sealed record Pop(string Modus, int? DorId, int ComponentId = 0, int? TypeId = null, string? Servicetype = null, int? PlassholderId = null, bool ErPlassholder = false, int Antall = 1, string? Tittel = null);
    private Pop? _pop;
    private string _vareSok = "";
    private List<Component> _vareTreff = [];
    private string _nyTypeNavn = "", _nyTypeService = "";
    private string? _typeFeil;
    private sealed record Kol(string Navn, string? Servicetype, int? TypeId);

    // Komponenttyper som ikke hører til en standard servicetype (lagt til av brukeren).
    private List<ComponentType> EgneTyper => _typer.Where(t => ServiceRegelMotor.Servicetype(t) is null).OrderBy(t => t.Navn).ToList();

    private string? ServicetypeFor(int? typeId) => typeId is { } id ? _typeKart.GetValueOrDefault(id) : null;

    private List<Kol> Kolonner()
    {
        var brukt = _dorer.SelectMany(d => d.Beslag).Select(b => b.TypeId).Where(i => i is not null).Select(i => i!.Value).ToHashSet();
        var kol = ServiceRegelMotor.Servicetyper.Select(st => new Kol(st, st, null)).ToList();
        kol.AddRange(EgneTyper.Where(t => brukt.Contains(t.Id)).Select(t => new Kol(t.Navn, null, t.Id)));
        return kol;
    }

    private List<BeslagRad> IKolonne(DorRad d, Kol k) => d.Beslag
        .Where(b => k.Servicetype is { } st ? string.Equals(ServicetypeFor(b.TypeId), st, StringComparison.OrdinalIgnoreCase) : b.TypeId == k.TypeId).ToList();

    private RenderFragment Avkrysning() => __builder =>
    {
        var kol = Kolonner();
        <p class="sdp-hjelp">Kryss av hvilke beslag hver dør har. Blått = vare valgt, gult = ikke spesifisert. Trykk på et blått kryss for å bytte vare.</p>
        <div class="sdp-wrap sdp-mx-wrap">
            <table class="sdp-tb sdp-mx">
                <thead>
                    <tr>
                        <th class="sdp-mx-dor">Dør</th>
                        @foreach (var k in kol)
                        {
                            <th class="sdp-mx-t"><span>@k.Navn</span></th>
                        }
                        @if (VisPriser) {<th class="n">Kategori · per runde</th>}
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _dorer)
                    {
                        var res = _res.GetValueOrDefault(d.Id);
                        <tr @key="d.Id">
                            <td class="sdp-mx-dor"><b>@d.Dornummer</b><small>@(d.Rom ?? "")</small></td>
                            @foreach (var k in kol)
                            {
                                var har = IKolonne(d, k);
                                var kl = har.Count == 0 ? "" : har.All(b => b.ErPlassholder) ? "ps" : "pa";
                                <td class="sdp-mx-c">
                                    <button type="button" class="sdp-cb @kl" title="@(har.Count == 0 ? $"Legg til {k.Navn}" : string.Join(", ", har.Select(b => b.ErPlassholder ? "Ikke spesifisert" : b.Produkt)))"
                                            disabled="@_jobber" @onclick="@(() => Kryss(d, k))">@(har.Count > 0 ? "✓" : "")</button>
                                </td>
                            }
                            @if (VisPriser)
                            {
                                <td class="n sdp-pris">@if (res is not null) {<span class="sdp-kat">@res.Kategori</span><b>@(res.Regel is null ? "–" : Kr(ServiceRegelMotor.PrisForKategori(res.Regel, _kp)))</b>}</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sdp-mx-bunn">
            <span><i class="pa"></i>Vare valgt</span><span><i class="ps"></i>Ikke spesifisert</span><span><i></i>Har ikke</span>
            <span class="sdp-sp"></span>
            <button type="button" class="sdp-knapp sdp-liten" @onclick="@(() => { _pop = new Pop("nytype", null, Tittel: "Ny komponenttype"); _nyTypeNavn = ""; _nyTypeService = ""; _typeFeil = null; })">+ Ny komponenttype</button>
        </div>
    };

    private bool _jobber;

    private async Task Kryss(DorRad d, Kol k)
    {
        if (_jobber) return;
        var har = IKolonne(d, k);
        if (har.Count == 0)
        {
            await Jobb(async () =>
            {
                var komp = k.Servicetype is { } st && _plass.TryGetValue(st, out var p) ? p
                    : k.TypeId is { } tid && _typer.FirstOrDefault(t => t.Id == tid) is { } type ? await DorBeslagEndring.PlassholderFor(Db, type) : null;
                if (komp is not null)
                {
                    await DorBeslagEndring.LeggTil(Db, [d.Id], komp.Id);
                }
            });
        }
        else if (har.All(b => b.ErPlassholder))
        {
            await Jobb(() => DorBeslagEndring.Fjern(Db, d.Id, har.Select(b => b.ComponentId)));
        }
        else
        {
            // Har døren en vare her, fjernes den ikke ved et uhell – velg vare eller fjern i vinduet.
            await ApneVare(d, har.First(b => !b.ErPlassholder));
        }
    }

    private async Task Jobb(Func<Task> handling)
    {
        _jobber = true;
        try
        {
            await handling();
            await LastAsync();
            await OnEndret.InvokeAsync();
        }
        finally
        {
            _jobber = false;
        }
    }

    private void VelgAlle(ChangeEventArgs e)
    {
        _valgte.Clear();
        if (e.Value is true)
        {
            foreach (var d in _dorer) _valgte.Add(d.Id);
        }
    }

    private void ApneLeggTil(int? dorId)
    {
        var navn = dorId is { } id ? _dorer.FirstOrDefault(d => d.Id == id)?.Dornummer : null;
        _pop = new Pop("leggtil", dorId, Tittel: dorId is null ? $"Legg til på {_valgte.Count} valgte dører" : $"Legg til beslag på {navn}");
        _typeFeil = null;
    }

    private IEnumerable<int> Mal(Pop p) => p.DorId is { } id ? [id] : _valgte.ToList();

    private async Task LeggTilServicetype(string st)
    {
        if (_pop is not { } p || !_plass.TryGetValue(st, out var komp)) return;
        _pop = null;
        await Jobb(() => DorBeslagEndring.LeggTil(Db, Mal(p), komp.Id));
    }

    private async Task LeggTilType(ComponentType t)
    {
        if (_pop is not { } p) return;
        _pop = null;
        await Jobb(async () => await DorBeslagEndring.LeggTil(Db, Mal(p), (await DorBeslagEndring.PlassholderFor(Db, t)).Id));
    }

    private async Task OpprettType()
    {
        if (_pop is not { } p) return;
        var navn = _nyTypeNavn.Trim();
        if (navn.Length == 0) return;
        if (_typer.Any(t => string.Equals(t.Navn, navn, StringComparison.OrdinalIgnoreCase)))
        {
            _typeFeil = $"Typen «{navn}» finnes allerede.";
            return;
        }
        var type = new ComponentType { Navn = navn, Servicetype = string.IsNullOrWhiteSpace(_nyTypeService) ? null : _nyTypeService, Sortering = 900 };
        Db.ComponentTypes.Add(type);
        await Db.SaveChangesAsync();
        Db.Entry(type).State = EntityState.Detached;
        _pop = null;
        if (p.DorId is not null || _valgte.Count > 0)
        {
            await Jobb(async () => await DorBeslagEndring.LeggTil(Db, Mal(p), (await DorBeslagEndring.PlassholderFor(Db, type)).Id));
        }
        else
        {
            await Jobb(() => Task.CompletedTask);
        }
    }

    private async Task ApneVare(DorRad d, BeslagRad b)
    {
        var st = ServicetypeFor(b.TypeId);
        int? plassId = st is not null && _plass.TryGetValue(st, out var pl) ? pl.Id
            : b.ErPlassholder ? b.ComponentId : null;
        _pop = new Pop("vare", d.Id, b.ComponentId, b.TypeId, st, plassId, b.ErPlassholder, b.Antall, $"{b.Type} på {d.Dornummer}");
        _vareSok = "";
        await HentVarer();
    }

    private async Task SokVare(ChangeEventArgs e)
    {
        _vareSok = e.Value?.ToString() ?? "";
        await HentVarer();
    }

    private async Task HentVarer()
    {
        if (_pop is not { } p) return;
        var typeIder = p.Servicetype is { } st
            ? _typeKart.Where(kv => string.Equals(kv.Value, st, StringComparison.OrdinalIgnoreCase)).Select(kv => kv.Key).ToList()
            : p.TypeId is { } tid ? [tid] : new List<int>();
        var q = Db.Components.AsNoTracking().Where(c => !c.ErPlassholder && c.Aktiv && c.ComponentTypeId != null && typeIder.Contains(c.ComponentTypeId.Value));
        var sok = _vareSok.Trim();
        if (sok.Length > 0)
        {
            q = q.Where(c => c.Navn.Contains(sok) || (c.Produktkode != null && c.Produktkode.Contains(sok)));
        }
        _vareTreff = await q.OrderBy(c => c.Navn).Take(40).ToListAsync();
        if (p.ComponentId != 0 && !p.ErPlassholder && _vareTreff.All(c => c.Id != p.ComponentId)
            && await Db.Components.AsNoTracking().FirstOrDefaultAsync(c => c.Id == p.ComponentId) is { } naa)
        {
            _vareTreff.Insert(0, naa);
        }
    }

    private async Task VelgVare(int componentId)
    {
        if (_pop is not { DorId: { } dorId } p) return;
        _pop = null;
        await Jobb(() => DorBeslagEndring.Bytt(Db, dorId, p.ComponentId, componentId));
    }

    private async Task SettAntall(ChangeEventArgs e)
    {
        if (_pop is not { DorId: { } dorId } p || !int.TryParse(e.Value?.ToString(), out var n)) return;
        _pop = p with { Antall = Math.Max(1, n) };
        await DorBeslagEndring.SettAntall(Db, dorId, p.ComponentId, n);
        await LastAsync();
        await OnEndret.InvokeAsync();
    }

    private async Task FjernFraPop()
    {
        if (_pop is not { DorId: { } dorId } p) return;
        _pop = null;
        await Jobb(() => DorBeslagEndring.Fjern(Db, dorId, [p.ComponentId]));
    }

    private async Task FjernBeslag(DorRad d, BeslagRad b) =>
        await Jobb(() => DorBeslagEndring.Fjern(Db, d.Id, [b.ComponentId]));

    private void LukkPop()
    {
        _pop = null;
        _typeFeil = null;
    }

    private static string PopTittel(Pop p) => p.Tittel ?? p.Modus switch
    {
        "nytype" => "Ny komponenttype",
        "vare" => "Velg vare",
        _ => "Legg til beslag"
    };
    private sealed record SakRad(string Tittel, string Status, bool ErAvvik, DateTime Dato);
    private sealed record HistRad(DateTime Dato, string Tittel, string? Tekst, string Farge);
    private sealed record DokRad(string Type, string Navn, string Kilde, string Url);

    private sealed class DorRad
    {
        public int Id { get; init; }
        public string Dornummer { get; init; } = "";
        public string? Rom { get; init; }
        public string? Etasje { get; init; }
        public string? Kategori { get; init; }
        public string Farge { get; set; } = "gronn";
        public int? PlantegningId { get; init; }
        public bool TegningErBilde { get; set; }
        public double? PosX { get; init; }
        public double? PosY { get; init; }
        public DateTime? MontertDato { get; init; }
        public string? Dortype { get; init; }
        public string? Brann { get; init; }
        public string? Slagretning { get; init; }
        public string? Mal { get; init; }
        public List<string> Funksjoner { get; init; } = [];
        public List<BeslagRad> Beslag { get; init; } = [];
        public List<SakRad> Saker { get; set; } = [];
        public DateTime? SistKontrollert { get; set; }
        public List<(DateTime Dato, string Status)> Runder { get; set; } = [];
        public List<(DateTime Dato, string Tekst)> Hendelser { get; set; } = [];
        public List<(int Id, string Navn)> Bilder { get; set; } = [];
        public List<DokRad> Dokumenter { get; set; } = [];
    }

    private List<DorRad> _dorer = [];
    private DorRad? _valgt;
    private bool _lastet;
    private int? _lastetFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastetFor == ProsjektId)
        {
            return;
        }
        _lastetFor = ProsjektId;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        var dorer = await Db.Dorer.AsNoTracking()
            .Where(d => d.ProsjektId == ProsjektId)
            .Select(d => new
            {
                d.Id, d.Dornummer, Rom = d.Romnr ?? d.DorTil, d.Etasje, d.PlantegningId, d.PosX, d.PosY, d.MontertDato,
                d.Dortype, d.Brann, d.Slagretning, d.Bredde, d.Hoyde, d.BxH,
                Funksjoner = d.Funksjoner.Select(f => f.Navn).ToList(),
                Beslag = d.Komponenter.Select(k => new
                {
                    k.ComponentId,
                    Type = k.Component!.Type != null ? k.Component.Type.Navn : k.Component.Navn,
                    Produkt = k.Component.Navn,
                    Leverandor = k.Component.Leverandor ?? k.Component.Produsent,
                    k.Component.Produktkode, k.Antall, k.MontertDato, k.Component.ErPlassholder, k.Component.ComponentTypeId
                }).ToList()
            })
            .ToListAsync();

        var tegningIder = dorer.Where(d => d.PlantegningId.HasValue).Select(d => d.PlantegningId!.Value).Distinct().ToList();
        var bildeTegninger = (await Db.Plantegninger.AsNoTracking()
                .Where(p => tegningIder.Contains(p.Id))
                .Select(p => new { p.Id, p.ContentType })
                .ToListAsync())
            .Where(p => p.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            .Select(p => p.Id)
            .ToHashSet();

        var avvik = await Db.Avvik.AsNoTracking()
            .Where(a => a.Dor!.ProsjektId == ProsjektId && a.Status != AvvikStatus.Godkjent)
            .Select(a => new { a.DorId, a.Beskrivelse, a.Status, a.OpprettetDato })
            .ToListAsync();
        var meldinger = (await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.Dor!.ProsjektId == ProsjektId)))
            .Where(m => m.ErApen)
            .ToList();

        var runder = await Db.ServicerundeDorer.AsNoTracking()
            .Where(x => x.Servicerunde!.ProsjektId == ProsjektId && x.Servicerunde.FullfortDato != null)
            .Select(x => new { x.DorId, x.Status, x.Servicerunde!.Dato })
            .ToListAsync();

        _dorer = dorer
            .OrderBy(d => d.Dornummer)
            .Select(d =>
            {
                var rad = new DorRad
                {
                    Id = d.Id, Dornummer = d.Dornummer, Rom = d.Rom, Etasje = string.IsNullOrWhiteSpace(d.Etasje) ? null : int.TryParse(d.Etasje, out _) ? $"{d.Etasje}. etasje" : d.Etasje, PlantegningId = d.PlantegningId,
                    PosX = d.PosX, PosY = d.PosY, MontertDato = d.MontertDato, Dortype = d.Dortype, Brann = d.Brann,
                    Slagretning = d.Slagretning,
                    Mal = d.Bredde is not null || d.Hoyde is not null ? $"{d.Bredde?.ToString() ?? "?"} × {d.Hoyde?.ToString() ?? "?"}" : d.BxH,
                    Funksjoner = d.Funksjoner,
                    Beslag = d.Beslag.Select(b => new BeslagRad(b.ComponentId, b.Type, b.Produkt, b.Leverandor, b.Produktkode, b.Antall, b.MontertDato, b.ErPlassholder, b.ComponentTypeId)).ToList(),
                    TegningErBilde = d.PlantegningId is { } pid && bildeTegninger.Contains(pid)
                };
                var dm = meldinger.Where(m => m.Melding.DorId == d.Id).ToList();
                var da = avvik.Where(a => a.DorId == d.Id).ToList();
                rad.Farge = da.Count > 0 || dm.Any(m => m.Steg != DriftHelper.Steg.UnderArbeid) ? "rod" : dm.Count > 0 ? "gul" : "gronn";
                rad.Saker = da.Select(a => new SakRad(a.Beskrivelse, a.Status.Visningsnavn(), true, a.OpprettetDato))
                    .Concat(dm.Select(m => new SakRad(string.IsNullOrWhiteSpace(m.Melding.Tittel) ? m.Melding.Tekst : m.Melding.Tittel, m.Navn, false, m.Melding.OpprettetDato)))
                    .OrderByDescending(s => s.Dato).ToList();
                rad.Runder = runder.Where(r => r.DorId == d.Id).OrderByDescending(r => r.Dato).Select(r => (r.Dato, r.Status)).ToList();
                rad.SistKontrollert = rad.Runder.Count > 0 ? rad.Runder[0].Dato : null;
                return rad;
            })
            .ToList();
        await LastPriser();
        _lastet = true;
    }

    // Historikk og dokumenter hentes når dørkortet åpnes – ikke for alle dørene på en gang.
    private readonly HashSet<int> _detaljerLastet = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_valgt is { } v && _detaljerLastet.Add(v.Id))
        {
            v.Hendelser = (await Db.DorHendelser.AsNoTracking()
                    .Where(h => h.DorId == v.Id)
                    .OrderByDescending(h => h.Tidspunkt)
                    .Take(10)
                    .Select(h => new { h.Tidspunkt, h.Beskrivelse })
                    .ToListAsync())
                .Select(h => (h.Tidspunkt, h.Beskrivelse)).ToList();
            v.Bilder = (await Db.DorMedia.AsNoTracking()
                    .Where(m => m.DorId == v.Id && m.ContentType.StartsWith("image/"))
                    .OrderByDescending(m => m.OpprettetDato)
                    .Take(6)
                    .Select(m => new { m.Id, m.Filnavn })
                    .ToListAsync())
                .Select(m => (m.Id, m.Filnavn)).ToList();
            var kompIder = v.Beslag.Where(b => !b.ErPlassholder).Select(b => b.ComponentId).Distinct().ToList();
            var navn = v.Beslag.GroupBy(b => b.ComponentId).ToDictionary(g => g.Key, g => g.First().Produkt);
            var fdv = await Db.ComponentFdvDokumenter.AsNoTracking()
                .Where(x => kompIder.Contains(x.ComponentId))
                .Select(x => new { x.Id, x.ComponentId, x.Filnavn })
                .ToListAsync();
            var datablad = await Db.ComponentDatabladDokumenter.AsNoTracking()
                .Where(x => kompIder.Contains(x.ComponentId))
                .Select(x => new { x.Id, x.ComponentId, x.Filnavn })
                .ToListAsync();
            v.Dokumenter = fdv.Select(x => new DokRad("PDF", $"FDV – {navn.GetValueOrDefault(x.ComponentId)}", x.Filnavn, $"/komponent/fdvdokument/{x.Id}"))
                .Concat(datablad.Select(x => new DokRad("PDF", $"Produktdatablad – {navn.GetValueOrDefault(x.ComponentId)}", x.Filnavn, $"/komponent/databladdokument/{x.Id}")))
                .ToList();
            StateHasChanged();
        }
    }

    private static List<HistRad> Historikk(DorRad v) =>
        v.Runder.Select(r => new HistRad(r.Dato, "Servicerunde", r.Status == ServicerundeDorStatus.Avvik ? "Avvik registrert" : "OK",
                r.Status == ServicerundeDorStatus.Avvik ? "rod" : "gronn"))
            .Concat(v.Hendelser.Select(h => new HistRad(h.Dato, h.Tekst, null, "gra")))
            .Concat(v.MontertDato is { } md ? new[] { new HistRad(md, "Montert", null, "gra") } : Array.Empty<HistRad>())
            .OrderByDescending(h => h.Dato)
            .Take(8)
            .ToList();

    private static List<DokRad> Dokumenter(DorRad v) =>
        v.Dokumenter.Concat(v.Bilder.Select(b => new DokRad("IMG", "Bilde", b.Navn, $"/dormedia/{b.Id}"))).ToList();

    private static IEnumerable<(string, string)> Dordata(DorRad v)
    {
        yield return ("Dørtype", string.IsNullOrWhiteSpace(v.Dortype) ? "–" : v.Dortype);
        yield return ("Brannklasse", string.IsNullOrWhiteSpace(v.Brann) ? "–" : v.Brann);
        yield return ("Slagretning", string.IsNullOrWhiteSpace(v.Slagretning) ? "–" : v.Slagretning);
        yield return ("Mål", string.IsNullOrWhiteSpace(v.Mal) ? "–" : v.Mal);
    }

    private static string StatusTekst(string farge) => farge switch
    {
        "rod" => "Åpen sak",
        "gul" => "Under arbeid",
        _ => "I orden"
    };

    private static string StatusIkon(string farge) => farge switch
    {
        "rod" => "alert",
        "gul" => "tool",
        _ => "check"
    };
}
