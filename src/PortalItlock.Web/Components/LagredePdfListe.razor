@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (Pdfer.Count == 0)
{
    <p class="list-empty">Ingen PDF-er lagret ennå.</p>
}
else
{
    @if (Versjonsvisning)
    {
        @* Q5: siste versjon stort med faktaliste, tidligere versjoner under. *@
        var sortert = Pdfer.OrderByDescending(p => p.OpprettetDato).ToList();
        var nyeste = sortert[0];
        <section class="lp-kort">
            <header class="lp-hode"><h3>Siste versjon</h3></header>
            <div class="lp-hero">
                <button type="button" class="lp-ark" @onclick="@(() => VisPdf(nyeste))" title="Åpne PDF">
                    <span></span><span></span><span class="k"></span><span></span><span class="k"></span><span></span><em>PDF</em>
                </button>
                <div class="lp-hero-tekst">
                    <b class="lp-tittel">@(Tittel ?? nyeste.Navn)</b>
                    <dl class="lp-fakta">
                        <div><dt>Versjon</dt><dd>v@(sortert.Count) <span class="lp-ny">Nyeste</span></dd></div>
                        <div><dt>Laget</dt><dd>@nyeste.OpprettetDato.ToString("dd.MM.yyyy HH:mm", Kultur)</dd></div>
                    </dl>
                    <div class="lp-knapper">
                        <button type="button" class="lp-kn lp-kn-p" @onclick="@(() => VisPdf(nyeste))"><Icon Name="file-text" />Åpne PDF</button>
                        <a class="lp-kn" href="@($"/lagretpdf/{nyeste.Id}")" download="@nyeste.Navn"><Icon Name="download" />Last ned</a>
                        <button type="button" class="lp-kn" @onclick="@(() => KopierLenke(nyeste))"><Icon Name="link-ikon" />@(_kopiertId == nyeste.Id ? "Lenke kopiert" : "Kopier lenke")</button>
                    </div>
                    @if (TillatSammenligning && sortert.Count > 1)
                    {
                        <label class="lp-velg"><input type="checkbox" checked="@_valgte.Contains(nyeste.Id)" @onchange="@(e => VelgForSammenligning(nyeste.Id, (bool)e.Value!))" />Ta med i sammenligning</label>
                    }
                </div>
            </div>
        </section>

        @if (sortert.Count > 1)
        {
            <section class="lp-kort">
                <header class="lp-hode"><h3>Tidligere versjoner <span class="lp-ant">@(sortert.Count - 1)</span></h3></header>
                <ul class="lp-liste">
                    @for (var i = 1; i < sortert.Count; i++)
                    {
                        var pdf = sortert[i];
                        var versjon = sortert.Count - i;
                        <li @key="pdf.Id">
                            @if (TillatSammenligning)
                            {
                                <input type="checkbox" checked="@_valgte.Contains(pdf.Id)" @onchange="@(e => VelgForSammenligning(pdf.Id, (bool)e.Value!))" aria-label="Velg versjon @versjon for sammenligning" />
                            }
                            <span class="lp-pdfik"><Icon Name="file-text" /><i>PDF</i></span>
                            <span class="lp-navn"><b>@(Tittel ?? pdf.Navn) <span class="lp-ver">v@(versjon)</span></b><small>@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm", Kultur)</small></span>
                            <button type="button" class="lp-ikn" @onclick="@(() => VisPdf(pdf))" title="Åpne"><Icon Name="file-text" /></button>
                            <a class="lp-ikn" href="@($"/lagretpdf/{pdf.Id}")" download="@pdf.Navn" title="Last ned"><Icon Name="download" /></a>
                        </li>
                    }
                </ul>
                @if (TillatSammenligning)
                {
                    <div class="lp-fot">
                        <span>Huk av to versjoner for å se hva som er endret.</span>
                        <button type="button" class="lp-kn" disabled="@(_valgte.Count != 2)" @onclick="VisSammenligning">Sammenlign (@_valgte.Count/2)</button>
                    </div>
                }
            </section>
        }
    }
        <PdfPreviewModal Url="@_visUrl" Tittel="@_visTittel" OnClose="@(() => _visUrl = null)" />
    }
    else
    {
        <ul class="vedlegg-list">
            @foreach (var pdf in Pdfer.OrderByDescending(p => p.OpprettetDato))
            {
                <li @key="pdf.Id" class="vedlegg-item">
                    @if (TillatSammenligning)
                    {
                        <input type="checkbox" checked="@_valgte.Contains(pdf.Id)" @onchange="@(e => VelgForSammenligning(pdf.Id, (bool)e.Value!))" />
                    }
                    <a href="@($"/lagretpdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                    <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                </li>
            }
        </ul>

        @if (TillatSammenligning)
        {
            <button type="button" class="add-button" disabled="@(_valgte.Count != 2)" @onclick="VisSammenligning">
                Sammenlign valgte (@_valgte.Count/2)
            </button>
        }
    }

    @if (_endringer is not null && _gammelPdf is not null && _nyPdf is not null)
    {
        @* C4: svaret øverst (oppsummering), nøkkeltall med før/etter, og endrede varer i en bred tabell. *@
        var gammelNr = VersjonNr(_gammelPdf);
        var nyNr = VersjonNr(_nyPdf);
        var total = _nokkeltallEndringer?.FirstOrDefault(n => n.Navn == "Totalt uten mva");
        <div class="c-rot">
            <div class="c-tittel">
                <small>Sammenligning</small>
                <h2>Hva er endret mellom versjonene?</h2>
            </div>

            <div class="c-topp">
                <div class="c-ver">
                    <span class="c-vchip"><b>Versjon @gammelNr</b><small>@_gammelPdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm", Kultur)</small></span>
                    <span class="c-pil"><Icon Name="arrow-right" /></span>
                    <span class="c-vchip c-vchip-ny">
                        <b>Versjon @nyNr @if (nyNr == Pdfer.Count) { <em>Nyeste</em> }</b>
                        <small>@_nyPdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm", Kultur)</small>
                    </span>
                </div>
                <button type="button" class="c-lukk" @onclick="LukkSammenligning"><Icon Name="x" />Lukk</button>
            </div>

            <div class="c-banner">
                <span class="c-bik"><Icon Name="@(NettoRetning < 0 ? "arrow-down" : "arrow-up")" /></span>
                <div>
                    <b>@BannerTittel(gammelNr, nyNr, total)</b>
                    <span>@BannerUnder(total)</span>
                </div>
            </div>

            @if (_nokkeltallEndringer is { Count: > 0 })
            {
                <div class="c-kpi">
                    @foreach (var n in _nokkeltallEndringer.OrderBy(n => n.Navn == "Totalt uten mva" ? 0 : 1))
                    {
                        <div class="@(n.Navn == "Totalt uten mva" ? "c-kpi-hoved" : "")">
                            <small>@(n.Navn == "Totalt uten mva" ? "Totalt eks. mva" : n.Navn)</small>
                            <b>@n.NyVerdi</b>
                            <span class="c-fra">fra @n.GammelVerdi</span>
                            @if (n.Retning != 0)
                            {
                                <em class="c-delta"><Icon Name="@(n.Retning < 0 ? "arrow-down" : "arrow-up")" />@n.DeltaTekst</em>
                            }
                        </div>
                    }
                </div>
            }

            <section class="c-k">
                <header>
                    <h3>Endrede varer</h3>
                    <div class="c-filter">
                        <button type="button" class="@(_aktivKategori is null ? "pa" : "")" @onclick="@(() => _aktivKategori = null)">Alle <i>@AntallForKategori(null)</i></button>
                        <button type="button" class="@(_aktivKategori == LagretPdfEndringType.LagtTil ? "pa" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.LagtTil)">Lagt til <i>@AntallForKategori(LagretPdfEndringType.LagtTil)</i></button>
                        <button type="button" class="@(_aktivKategori == LagretPdfEndringType.Endret ? "pa" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.Endret)">Endret <i>@AntallForKategori(LagretPdfEndringType.Endret)</i></button>
                        <button type="button" class="@(_aktivKategori == LagretPdfEndringType.Fjernet ? "pa" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.Fjernet)">Fjernet <i>@AntallForKategori(LagretPdfEndringType.Fjernet)</i></button>
                    </div>
                    <label class="c-sok">
                        <Icon Name="search" />
                        <input type="text" placeholder="Søk i varer" @bind="_sokTekst" @bind:event="oninput" />
                    </label>
                </header>

                @if (_endringer.Count == 0)
                {
                    <p class="list-empty c-tom">Ingen endringer i utstyr eller pris mellom de valgte versjonene.</p>
                }
                else if (FiltrerteEndringer.Count == 0)
                {
                    <p class="list-empty c-tom">Ingen treff for filteret eller søket.</p>
                }
                else
                {
                    <table class="c-tab">
                        <thead>
                            <tr><th>Vare</th><th>Endring</th><th class="c-h">Antall</th><th class="c-h">Enhetspris</th><th class="c-h">Beløp</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in GrupperteEndringer.SelectMany(g => g))
                            {
                                <tr @key="e.Navn + e.Type">
                                    <td class="c-navn">@e.Navn</td>
                                    <td><span class="c-type c-type-@KategoriKlasse(e.Type)"><Icon Name="@KategoriIkon(e.Type)" />@KategoriTekst(e.Type)</span></td>
                                    <td class="c-h">
                                        @if (e.Type == LagretPdfEndringType.Endret && e.GammelAntall != e.NyAntall)
                                        {
                                            <span class="c-gml">@e.GammelAntall</span><span class="c-pil-liten"><Icon Name="arrow-right" /></span><b>@e.NyAntall</b>
                                        }
                                        else
                                        {
                                            @AntallTekst(e)
                                        }
                                    </td>
                                    <td class="c-h">@PrisTekst(e)</td>
                                    <td class="c-h c-sum">@Kostnad(e).Tekst</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td colspan="4">Sum varer</td><td class="c-h">@FormatKr(FiltrerteEndringer.Sum(e => Kostnad(e).Delta), medFortegn: true)</td></tr>
                        </tfoot>
                    </table>
                }
            </section>
        </div>
    }
}

@code {
    [Parameter] public List<LagretPdf> Pdfer { get; set; } = [];
    [Parameter] public bool TillatSammenligning { get; set; }

    // Versjonsvisning (tilbud): siste versjon stort, tidligere versjoner under.
    [Parameter] public bool Versjonsvisning { get; set; }
    [Parameter] public string? Tittel { get; set; }

    private int? _kopiertId;

    // «Åpne PDF» viser PDF-en i forhåndsvisning på siden i stedet for i ny fane.
    private string? _visUrl;
    private string _visTittel = "";

    private void VisPdf(LagretPdf pdf)
    {
        _visUrl = $"/lagretpdf/{pdf.Id}?vis=1";
        _visTittel = pdf.Navn;
    }

    private async Task KopierLenke(LagretPdf pdf)
    {
        var lenke = Nav.ToAbsoluteUri($"/lagretpdf/{pdf.Id}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", lenke);
            _kopiertId = pdf.Id;
        }
        catch (JSException)
        {
        }
    }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private readonly List<int> _valgte = [];
    private List<LagretPdfEndring>? _endringer;
    private List<LagretPdfNokkeltallEndring>? _nokkeltallEndringer;
    private LagretPdf? _gammelPdf;
    private LagretPdf? _nyPdf;
    private LagretPdfEndringType? _aktivKategori;
    private string _sokTekst = "";

    private void VelgForSammenligning(int id, bool valgt)
    {
        LukkSammenligning();

        if (valgt)
        {
            if (_valgte.Count >= 2)
            {
                _valgte.RemoveAt(0);
            }
            _valgte.Add(id);
        }
        else
        {
            _valgte.Remove(id);
        }
    }

    private void VisSammenligning()
    {
        if (_valgte.Count != 2)
        {
            return;
        }

        var sortert = Pdfer.Where(p => _valgte.Contains(p.Id)).OrderBy(p => p.OpprettetDato).ToList();
        if (sortert.Count != 2)
        {
            return;
        }

        _gammelPdf = sortert[0];
        _nyPdf = sortert[1];
        _endringer = LagretPdfService.Sammenlign(sortert[0], sortert[1]);
        _nokkeltallEndringer = LagretPdfService.SammenlignNokkeltall(sortert[0], sortert[1]);
    }

    private void LukkSammenligning()
    {
        _endringer = null;
        _nokkeltallEndringer = null;
        _gammelPdf = null;
        _nyPdf = null;
        _aktivKategori = null;
        _sokTekst = "";
    }

    // Endringer filtrert på søketekst alene (ikke aktiv kategori) - brukes til
    // badge-tallene på rail-knappene, slik at de reflekterer søket men ikke
    // "forsvinner" avhengig av hvilken kategori som er valgt akkurat nå.
    private List<LagretPdfEndring> SokFiltrerteEndringer =>
        (_endringer ?? [])
            .Where(e => string.IsNullOrWhiteSpace(_sokTekst) || e.Navn.Contains(_sokTekst, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<LagretPdfEndring> FiltrerteEndringer =>
        SokFiltrerteEndringer
            .Where(e => _aktivKategori is null || e.Type == _aktivKategori)
            .ToList();

    private int AntallForKategori(LagretPdfEndringType? type) =>
        type is null ? SokFiltrerteEndringer.Count : SokFiltrerteEndringer.Count(e => e.Type == type);

    private IEnumerable<IGrouping<LagretPdfEndringType, LagretPdfEndring>> GrupperteEndringer =>
        FiltrerteEndringer
            .GroupBy(e => e.Type)
            .OrderBy(g => KategoriRekkefolge(g.Key));

    private static int KategoriRekkefolge(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => 0,
        LagretPdfEndringType.Endret => 1,
        _ => 2
    };

    private static string KategoriTekst(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "Lagt til",
        LagretPdfEndringType.Fjernet => "Fjernet",
        _ => "Endret"
    };

    private static string KategoriIkon(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "plus",
        LagretPdfEndringType.Fjernet => "minus",
        _ => "edit"
    };

    // Fast kategori-farge per endringstype (uavhengig av kostnadsretning på gruppen) -
    // skiller "hva slags endring" visuelt fra "ble det dyrere/billigere" som vises på
    // selve delsummen og radene.
    private static string KategoriFarge(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "#b5502d",
        LagretPdfEndringType.Fjernet => "#2b7a4b",
        _ => "#8a6d1f"
    };

    private static string KategoriBakgrunn(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "rgba(181, 80, 45, 0.07)",
        LagretPdfEndringType.Fjernet => "rgba(43, 122, 75, 0.08)",
        _ => "rgba(138, 109, 31, 0.09)"
    };

    // Ensrettet fargespråk for hele sammenligningen: rødt = dyrere/mer, grønt = billigere/mindre, nøytralt = uendret.
    private static string RetningFarge(int retning) => retning switch
    {
        > 0 => "#b5502d",
        < 0 => "#2b7a4b",
        _ => "var(--itlock-ink-muted)"
    };

    private int NettoRetning => _nokkeltallEndringer?.FirstOrDefault(n => n.Navn == "Totalt uten mva")?.Retning
        ?? (_endringer?.Sum(e => Kostnad(e).Delta) is { } d ? (d > 0 ? 1 : d < 0 ? -1 : 0) : 0);

    private string NettoTekst => _nokkeltallEndringer?.FirstOrDefault(n => n.Navn == "Totalt uten mva") is { } n
        ? Kapitaliser(n.DeltaTekst)
        : FormatKr(_endringer?.Sum(e => Kostnad(e).Delta) ?? 0, medFortegn: true);

    private static string Kapitaliser(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];

    private static string AntallTekst(LagretPdfEndring e) => e.Type switch
    {
        LagretPdfEndringType.LagtTil => e.NyAntall.ToString(),
        LagretPdfEndringType.Fjernet => e.GammelAntall.ToString(),
        _ when e.GammelAntall == e.NyAntall => e.NyAntall.ToString(),
        _ => $"{e.GammelAntall} → {e.NyAntall}"
    };

    private static string PrisTekst(LagretPdfEndring e)
    {
        var g = e.GammelPris ?? 0;
        var n = e.NyPris ?? 0;
        return e.Type switch
        {
            LagretPdfEndringType.LagtTil => FormatKr(n),
            LagretPdfEndringType.Fjernet => FormatKr(g),
            _ when g == n => FormatKr(n),
            _ => $"{FormatKr(g)} → {FormatKr(n)}"
        };
    }

    private static string FormatKr(decimal verdi, bool medFortegn = false)
    {
        if (!medFortegn)
        {
            return verdi.ToString("N2", Kultur) + " kr";
        }

        if (verdi == 0)
        {
            return "±0 kr";
        }

        var fortegn = verdi > 0 ? "+" : "−";
        return $"{fortegn}{Math.Abs(verdi):N0} kr";
    }

    /// Linjens totale kostnad (antall × pris), ikke stykkpris - slik at en antallsendring også slår ut i beløpet.
    private static (string Tekst, int Retning, decimal Delta) Kostnad(LagretPdfEndring e)
    {
        var gammelTotal = e.Type == LagretPdfEndringType.LagtTil ? 0 : e.GammelAntall * (e.GammelPris ?? 0);
        var nyTotal = e.Type == LagretPdfEndringType.Fjernet ? 0 : e.NyAntall * (e.NyPris ?? 0);
        var delta = nyTotal - gammelTotal;

        if (delta == 0)
        {
            return ("±0 kr", 0, 0);
        }

        var retning = delta > 0 ? 1 : -1;
        var fortegn = delta > 0 ? "+" : "−";

        var tekst = e.Type switch
        {
            LagretPdfEndringType.LagtTil => $"{nyTotal:N2} kr",
            LagretPdfEndringType.Fjernet => $"{gammelTotal:N2} kr",
            _ => $"{fortegn}{Math.Abs(delta):N2} kr"
        };

        return (tekst, retning, delta);
    }

    // ---------- C4: oppsummering og versjonsnummer ----------
    private int VersjonNr(LagretPdf pdf) =>
        Pdfer.OrderBy(p => p.OpprettetDato).ToList().FindIndex(p => p.Id == pdf.Id) + 1;

    private static string KategoriKlasse(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "ny",
        LagretPdfEndringType.Fjernet => "fjern",
        _ => "endr"
    };

    private static decimal? Tall(string verdi)
    {
        var renset = new string(verdi.Where(c => char.IsDigit(c) || c == ',' || c == '-').ToArray());
        return decimal.TryParse(renset, NumberStyles.Number, Kultur, out var d) ? d : null;
    }

    private string BannerTittel(int gammelNr, int nyNr, LagretPdfNokkeltallEndring? total)
    {
        if (_endringer is { Count: 0 } && (total is null || total.Retning == 0))
        {
            return $"Ingen endringer mellom versjon {gammelNr} og versjon {nyNr}";
        }

        if (total is null || total.Retning == 0)
        {
            var antall = _endringer?.Count ?? 0;
            return $"{antall} {(antall == 1 ? "endring" : "endringer")} fra versjon {gammelNr} til versjon {nyNr}";
        }

        var belop = total.DeltaTekst.TrimStart('+', '-', '−').Trim();
        return $"Versjon {nyNr} er {belop} {(total.Retning > 0 ? "høyere" : "lavere")} enn versjon {gammelNr}";
    }

    private string BannerUnder(LagretPdfNokkeltallEndring? total)
    {
        var deler = new List<string>();
        if (total is not null && Tall(total.GammelVerdi) is { } gml && gml != 0 && Tall(total.NyVerdi) is { } ny)
        {
            var prosent = (ny - gml) / gml * 100;
            deler.Add($"{(prosent >= 0 ? "+" : "")}{prosent.ToString("0.0", Kultur)} %");
        }

        var varer = _endringer?.Count ?? 0;
        deler.Add($"{varer} {(varer == 1 ? "vare" : "varer")} endret");

        if (_nokkeltallEndringer?.FirstOrDefault(n => n.Navn.Contains("timer", StringComparison.OrdinalIgnoreCase)) is { Retning: not 0 } timer)
        {
            deler.Add($"montasjetid {timer.DeltaTekst}");
        }

        return string.Join(" · ", deler);
    }
}
