@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@using System.Globalization

@if (Pdfer.Count == 0)
{
    <p class="list-empty">Ingen PDF-er lagret ennå.</p>
}
else
{
    <ul class="vedlegg-list">
        @foreach (var pdf in Pdfer.OrderByDescending(p => p.OpprettetDato))
        {
            <li @key="pdf.Id" class="vedlegg-item">
                @if (TillatSammenligning)
                {
                    <input type="checkbox" checked="@_valgte.Contains(pdf.Id)" @onchange="@(e => VelgForSammenligning(pdf.Id, (bool)e.Value!))" />
                }
                <a href="@($"/lagretpdf/{pdf.Id}")" target="_blank">@pdf.Navn</a>
                <span class="vedlegg-type">@pdf.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
            </li>
        }
    </ul>

    @if (TillatSammenligning)
    {
        <button type="button" class="add-button" disabled="@(_valgte.Count != 2)" @onclick="VisSammenligning">
            Sammenlign valgte (@_valgte.Count/2)
        </button>
    }

    @if (_endringer is not null && _gammelPdf is not null && _nyPdf is not null)
    {
        <div class="sml-root kort">
            <div class="sml-topprad">
                <div>
                    <div class="sml-brodsmule">Lagrede versjoner</div>
                    <h3 class="sml-tittel">Sammenligning av versjoner</h3>
                </div>
                <button type="button" class="lukk-btn" @onclick="LukkSammenligning">
                    <Icon Name="x" />
                    Lukk sammenligning
                </button>
            </div>

            <div class="sml-hero">
                <div class="sml-versjoner">
                    <div class="sml-chip">
                        <span class="sml-chip-ikon"><Icon Name="file-text" /></span>
                        <span>
                            <div class="sml-chip-navn">@_gammelPdf.Navn</div>
                            <div class="sml-chip-dato">@_gammelPdf.OpprettetDato.ToString("dd.MM.yyyy · HH:mm", Kultur)</div>
                        </span>
                    </div>
                    <span class="sml-pil"><Icon Name="trend-up" /></span>
                    <div class="sml-chip sml-chip-aktiv">
                        <span class="sml-chip-ikon sml-chip-ikon-aktiv"><Icon Name="file-text" /></span>
                        <span>
                            <div class="sml-chip-navn">@_nyPdf.Navn</div>
                            <div class="sml-chip-dato">@_nyPdf.OpprettetDato.ToString("dd.MM.yyyy · HH:mm", Kultur)</div>
                        </span>
                    </div>
                </div>
                <div class="sml-netto">
                    <div class="sml-netto-label">Netto endring, eks. mva</div>
                    <div class="sml-netto-tall mono" style="color:@RetningFarge(NettoRetning)">
                        @if (NettoRetning != 0)
                        {
                            <span class="sml-trend @(NettoRetning < 0 ? "sml-trend-ned" : "")"><Icon Name="trend-up" /></span>
                        }
                        @NettoTekst
                    </div>
                </div>
            </div>

            <div class="sml-body">
                <div class="sml-tabellkort kort">
                    @if (_endringer.Count == 0)
                    {
                        <p class="list-empty sml-tom">Ingen endringer i utstyr eller pris mellom de valgte versjonene.</p>
                    }
                    else if (FiltrerteEndringer.Count == 0)
                    {
                        <p class="list-empty sml-tom">Ingen treff for filteret/søket.</p>
                    }
                    else
                    {
                        <table class="sml-tabell">
                            <thead>
                                <tr><th>Vare</th><th>Antall</th><th>Pris</th><th>Totalt</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var gruppe in GrupperteEndringer)
                                {
                                    var subtotal = gruppe.Sum(e => Kostnad(e).Delta);
                                    var subtotalRetning = subtotal > 0 ? 1 : subtotal < 0 ? -1 : 0;
                                    <tr class="sml-gruppe-row" style="background:@KategoriBakgrunn(gruppe.Key)">
                                        <td colspan="3">
                                            <div class="sml-gruppe-label" style="color:@KategoriFarge(gruppe.Key)">
                                                <span class="sml-gruppe-ikon"><Icon Name="@KategoriIkon(gruppe.Key)" /></span>
                                                @KategoriTekst(gruppe.Key) &middot; @gruppe.Count() @(gruppe.Count() == 1 ? "vare" : "varer")
                                            </div>
                                        </td>
                                        <td class="sml-gruppe-subtotal" style="color:@RetningFarge(subtotalRetning)">@FormatKr(subtotal, medFortegn: true)</td>
                                    </tr>
                                    @foreach (var e in gruppe)
                                    {
                                        var kost = Kostnad(e);
                                        <tr @key="e.Navn + gruppe.Key" class="sml-vare-row">
                                            <td class="sml-vare-navn">@e.Navn</td>
                                            <td class="sml-antall mono">@AntallTekst(e)</td>
                                            <td class="sml-antall mono">@PrisTekst(e)</td>
                                            <td class="sml-totalt mono" style="color:@RetningFarge(kost.Retning)">@kost.Tekst</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="sml-rail kort">
                    <label class="sml-sok">
                        <Icon Name="search" />
                        <input type="text" placeholder="Søk i varer..." @bind="_sokTekst" @bind:event="oninput" />
                    </label>

                    <div class="sml-rail-liste">
                        <button type="button" class="sml-rail-item @(_aktivKategori is null ? "sml-rail-item-aktiv" : "")" @onclick="@(() => _aktivKategori = null)">
                            <span>Alle endringer</span>
                            <span class="sml-rail-badge">@AntallForKategori(null)</span>
                        </button>
                        <button type="button" class="sml-rail-item @(_aktivKategori == LagretPdfEndringType.LagtTil ? "sml-rail-item-aktiv" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.LagtTil)">
                            <span><Icon Name="plus" />Lagt til</span>
                            <span class="sml-rail-badge" style="color:@(_aktivKategori == LagretPdfEndringType.LagtTil ? "" : KategoriFarge(LagretPdfEndringType.LagtTil))">@AntallForKategori(LagretPdfEndringType.LagtTil)</span>
                        </button>
                        <button type="button" class="sml-rail-item @(_aktivKategori == LagretPdfEndringType.Endret ? "sml-rail-item-aktiv" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.Endret)">
                            <span><Icon Name="edit" />Endret</span>
                            <span class="sml-rail-badge" style="color:@(_aktivKategori == LagretPdfEndringType.Endret ? "" : KategoriFarge(LagretPdfEndringType.Endret))">@AntallForKategori(LagretPdfEndringType.Endret)</span>
                        </button>
                        <button type="button" class="sml-rail-item @(_aktivKategori == LagretPdfEndringType.Fjernet ? "sml-rail-item-aktiv" : "")" @onclick="@(() => _aktivKategori = LagretPdfEndringType.Fjernet)">
                            <span><Icon Name="minus" />Fjernet</span>
                            <span class="sml-rail-badge" style="color:@(_aktivKategori == LagretPdfEndringType.Fjernet ? "" : KategoriFarge(LagretPdfEndringType.Fjernet))">@AntallForKategori(LagretPdfEndringType.Fjernet)</span>
                        </button>
                    </div>

                    @if (_nokkeltallEndringer is { Count: > 0 })
                    {
                        <div class="sml-rail-divider"></div>
                        <div class="sml-rail-sum-liste">
                            @foreach (var n in _nokkeltallEndringer)
                            {
                                <div class="sml-rail-sum">
                                    <div class="sml-rail-sum-navn">@n.Navn</div>
                                    <div class="sml-rail-sum-tall" style="color:@RetningFarge(n.Retning)">@Kapitaliser(n.DeltaTekst)</div>
                                    <div class="sml-rail-sum-fratil mono">@n.GammelVerdi <span class="sml-pil-liten">&rarr;</span> @n.NyVerdi</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public List<LagretPdf> Pdfer { get; set; } = [];
    [Parameter] public bool TillatSammenligning { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private readonly List<int> _valgte = [];
    private List<LagretPdfEndring>? _endringer;
    private List<LagretPdfNokkeltallEndring>? _nokkeltallEndringer;
    private LagretPdf? _gammelPdf;
    private LagretPdf? _nyPdf;
    private LagretPdfEndringType? _aktivKategori;
    private string _sokTekst = "";

    private void VelgForSammenligning(int id, bool valgt)
    {
        LukkSammenligning();

        if (valgt)
        {
            if (_valgte.Count >= 2)
            {
                _valgte.RemoveAt(0);
            }
            _valgte.Add(id);
        }
        else
        {
            _valgte.Remove(id);
        }
    }

    private void VisSammenligning()
    {
        if (_valgte.Count != 2)
        {
            return;
        }

        var sortert = Pdfer.Where(p => _valgte.Contains(p.Id)).OrderBy(p => p.OpprettetDato).ToList();
        if (sortert.Count != 2)
        {
            return;
        }

        _gammelPdf = sortert[0];
        _nyPdf = sortert[1];
        _endringer = LagretPdfService.Sammenlign(sortert[0], sortert[1]);
        _nokkeltallEndringer = LagretPdfService.SammenlignNokkeltall(sortert[0], sortert[1]);
    }

    private void LukkSammenligning()
    {
        _endringer = null;
        _nokkeltallEndringer = null;
        _gammelPdf = null;
        _nyPdf = null;
        _aktivKategori = null;
        _sokTekst = "";
    }

    // Endringer filtrert på søketekst alene (ikke aktiv kategori) - brukes til
    // badge-tallene på rail-knappene, slik at de reflekterer søket men ikke
    // "forsvinner" avhengig av hvilken kategori som er valgt akkurat nå.
    private List<LagretPdfEndring> SokFiltrerteEndringer =>
        (_endringer ?? [])
            .Where(e => string.IsNullOrWhiteSpace(_sokTekst) || e.Navn.Contains(_sokTekst, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<LagretPdfEndring> FiltrerteEndringer =>
        SokFiltrerteEndringer
            .Where(e => _aktivKategori is null || e.Type == _aktivKategori)
            .ToList();

    private int AntallForKategori(LagretPdfEndringType? type) =>
        type is null ? SokFiltrerteEndringer.Count : SokFiltrerteEndringer.Count(e => e.Type == type);

    private IEnumerable<IGrouping<LagretPdfEndringType, LagretPdfEndring>> GrupperteEndringer =>
        FiltrerteEndringer
            .GroupBy(e => e.Type)
            .OrderBy(g => KategoriRekkefolge(g.Key));

    private static int KategoriRekkefolge(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => 0,
        LagretPdfEndringType.Endret => 1,
        _ => 2
    };

    private static string KategoriTekst(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "Lagt til",
        LagretPdfEndringType.Fjernet => "Fjernet",
        _ => "Endret"
    };

    private static string KategoriIkon(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "plus",
        LagretPdfEndringType.Fjernet => "minus",
        _ => "edit"
    };

    // Fast kategori-farge per endringstype (uavhengig av kostnadsretning på gruppen) -
    // skiller "hva slags endring" visuelt fra "ble det dyrere/billigere" som vises på
    // selve delsummen og radene.
    private static string KategoriFarge(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "#b5502d",
        LagretPdfEndringType.Fjernet => "#2b7a4b",
        _ => "#8a6d1f"
    };

    private static string KategoriBakgrunn(LagretPdfEndringType type) => type switch
    {
        LagretPdfEndringType.LagtTil => "rgba(181, 80, 45, 0.07)",
        LagretPdfEndringType.Fjernet => "rgba(43, 122, 75, 0.08)",
        _ => "rgba(138, 109, 31, 0.09)"
    };

    // Ensrettet fargespråk for hele sammenligningen: rødt = dyrere/mer, grønt = billigere/mindre, nøytralt = uendret.
    private static string RetningFarge(int retning) => retning switch
    {
        > 0 => "#b5502d",
        < 0 => "#2b7a4b",
        _ => "var(--itlock-ink-muted)"
    };

    private int NettoRetning => _nokkeltallEndringer?.FirstOrDefault(n => n.Navn == "Totalt uten mva")?.Retning
        ?? (_endringer?.Sum(e => Kostnad(e).Delta) is { } d ? (d > 0 ? 1 : d < 0 ? -1 : 0) : 0);

    private string NettoTekst => _nokkeltallEndringer?.FirstOrDefault(n => n.Navn == "Totalt uten mva") is { } n
        ? Kapitaliser(n.DeltaTekst)
        : FormatKr(_endringer?.Sum(e => Kostnad(e).Delta) ?? 0, medFortegn: true);

    private static string Kapitaliser(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];

    private static string AntallTekst(LagretPdfEndring e) => e.Type switch
    {
        LagretPdfEndringType.LagtTil => e.NyAntall.ToString(),
        LagretPdfEndringType.Fjernet => e.GammelAntall.ToString(),
        _ when e.GammelAntall == e.NyAntall => e.NyAntall.ToString(),
        _ => $"{e.GammelAntall} → {e.NyAntall}"
    };

    private static string PrisTekst(LagretPdfEndring e)
    {
        var g = e.GammelPris ?? 0;
        var n = e.NyPris ?? 0;
        return e.Type switch
        {
            LagretPdfEndringType.LagtTil => FormatKr(n),
            LagretPdfEndringType.Fjernet => FormatKr(g),
            _ when g == n => FormatKr(n),
            _ => $"{FormatKr(g)} → {FormatKr(n)}"
        };
    }

    private static string FormatKr(decimal verdi, bool medFortegn = false)
    {
        if (!medFortegn)
        {
            return verdi.ToString("N2", Kultur) + " kr";
        }

        if (verdi == 0)
        {
            return "±0 kr";
        }

        var fortegn = verdi > 0 ? "+" : "−";
        return $"{fortegn}{Math.Abs(verdi):N0} kr";
    }

    /// Linjens totale kostnad (antall × pris), ikke stykkpris - slik at en antallsendring også slår ut i beløpet.
    private static (string Tekst, int Retning, decimal Delta) Kostnad(LagretPdfEndring e)
    {
        var gammelTotal = e.Type == LagretPdfEndringType.LagtTil ? 0 : e.GammelAntall * (e.GammelPris ?? 0);
        var nyTotal = e.Type == LagretPdfEndringType.Fjernet ? 0 : e.NyAntall * (e.NyPris ?? 0);
        var delta = nyTotal - gammelTotal;

        if (delta == 0)
        {
            return ("±0 kr", 0, 0);
        }

        var retning = delta > 0 ? 1 : -1;
        var fortegn = delta > 0 ? "+" : "−";

        var tekst = e.Type switch
        {
            LagretPdfEndringType.LagtTil => $"{nyTotal:N2} kr",
            LagretPdfEndringType.Fjernet => $"{gammelTotal:N2} kr",
            _ => $"{fortegn}{Math.Abs(delta):N2} kr"
        };

        return (tekst, retning, delta);
    }
}
