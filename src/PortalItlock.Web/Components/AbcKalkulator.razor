@using System.Globalization

<div class="panel">
    <div class="panel-rad">
        <div class="diagram-svg-wrap">
            <svg viewBox="0 0 460 190">
                <defs>
                    <linearGradient id="silGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--itlock-surface)" />
                        <stop offset="100%" stop-color="var(--itlock-bg)" />
                    </linearGradient>
                </defs>

                <line x1="40" y1="26" x2="420" y2="26" stroke="var(--itlock-accent)" stroke-width="1.6" />
                <path d="M40,26 l9,-4.5 v9 Z M420,26 l-9,-4.5 v9 Z" fill="var(--itlock-accent)" />
                <text x="230" y="18" text-anchor="middle" font-family="Inter Tight, sans-serif" font-weight="800" font-size="16" fill="var(--itlock-ink)">A</text>

                <line x1="40" y1="46" x2="210" y2="46" stroke="var(--itlock-ink-muted)" stroke-width="1.3" />
                <path d="M40,46 l7,-3.5 v7 Z M210,46 l-7,-3.5 v7 Z" fill="var(--itlock-ink-muted)" />
                <text x="125" y="60" text-anchor="middle" font-family="Inter Tight, sans-serif" font-weight="700" font-size="13" fill="var(--itlock-ink-muted)">B</text>

                <line x1="210" y1="46" x2="420" y2="46" stroke="var(--itlock-ink-muted)" stroke-width="1.3" />
                <path d="M210,46 l7,-3.5 v7 Z M420,46 l-7,-3.5 v7 Z" fill="var(--itlock-ink-muted)" />
                <text x="315" y="60" text-anchor="middle" font-family="Inter Tight, sans-serif" font-weight="700" font-size="13" fill="var(--itlock-ink-muted)">C</text>

                <rect x="42" y="68" width="378" height="72" rx="36" fill="rgba(41,41,39,.08)" transform="translate(0,4)" />
                <rect x="40" y="66" width="378" height="72" rx="36" fill="url(#silGrad)" stroke="var(--itlock-ink)" stroke-width="2.5" />
                <line x1="210" y1="58" x2="210" y2="148" stroke="var(--itlock-ink-muted)" stroke-width="1.3" stroke-dasharray="4 4" />

                <circle cx="115" cy="102" r="12" fill="none" stroke="var(--itlock-accent)" stroke-width="3" />
                <path d="M115,113 l-7,16 h14 Z" fill="var(--itlock-accent)" />

                <circle cx="345" cy="102" r="19" fill="none" stroke="var(--itlock-accent)" stroke-width="3" />
                <line x1="345" y1="87" x2="345" y2="117" stroke="var(--itlock-accent)" stroke-width="3" />
                <line x1="330" y1="102" x2="360" y2="102" stroke="var(--itlock-accent)" stroke-width="3" />

                <text x="115" y="174" text-anchor="middle" font-family="Inter Tight, sans-serif" font-weight="700" font-size="14" fill="var(--itlock-ink)">Sylinderside</text>
                <text x="345" y="174" text-anchor="middle" font-family="Inter Tight, sans-serif" font-weight="700" font-size="14" fill="var(--itlock-ink)">Knappside</text>
            </svg>
        </div>

        <div class="input-rad">
            <div class="input-gruppe">
                <span class="input-label">A-mål</span>
                <input type="number" min="0" max="100" placeholder="0" @bind="_a" @bind:event="onchange" @bind:after="Beregn" />
            </div>
            <div class="input-gruppe">
                <span class="input-label">B-mål</span>
                <input type="number" min="0" max="58" placeholder="0" @bind="_b" @bind:event="onchange" @bind:after="Beregn" />
            </div>
            <div class="input-gruppe">
                <span class="input-label">C-mål</span>
                <input value="@_cVisning" readonly placeholder="0" />
            </div>
        </div>
    </div>
</div>

<p class="resultat-tittel">Resultat</p>
<div class="panel">
    <ul class="resultat-liste">
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="14" height="8" rx="4" /><circle cx="9" cy="12" r="2" /><path d="M16 10h4a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-4" /></svg>
            </span>
            <span class="resultat-navn">Sylinder xx37</span>
            <span class="resultat-antall">× 1</span>
            <span class="resultat-verdi">@_sylinder<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="14" height="8" rx="4" /><circle cx="15" cy="12" r="2" /><path d="M8 10H4a2 2 0 0 0-2 2 2 2 0 0 0 2 2h4" /></svg>
            </span>
            <span class="resultat-navn">Knappvrider/xx47</span>
            <span class="resultat-antall">× 1</span>
            <span class="resultat-verdi">@_knappvrider<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h6" /><path d="M15 12h6" /><path d="M6 8v8" /><path d="M18 8v8" /><path d="m9 12 2-2M9 12l2 2" /></svg>
            </span>
            <span class="resultat-navn">Forlenger sylinderside</span>
            <span class="resultat-antall">@((MarkupString)_forlengerSylA)</span>
            <span class="resultat-verdi">@_forlengerSylS<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h6" /><path d="M15 12h6" /><path d="M6 8v8" /><path d="M18 8v8" /><path d="m9 12 2-2M9 12l2 2" /></svg>
            </span>
            <span class="resultat-navn">Forlenger knappvriderside</span>
            <span class="resultat-antall">@((MarkupString)_forlengerKnappA)</span>
            <span class="resultat-verdi">@_forlengerKnappS<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="3" /><circle cx="9" cy="8" r="1" fill="currentColor" stroke="none" /><circle cx="15" cy="16" r="1" fill="currentColor" stroke="none" /></svg>
            </span>
            <span class="resultat-navn">Skilt utv.</span>
            <span class="resultat-antall">× 1</span>
            <span class="resultat-verdi">@_skiltUtv<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="3" /><circle cx="9" cy="8" r="1" fill="currentColor" stroke="none" /><circle cx="15" cy="16" r="1" fill="currentColor" stroke="none" /></svg>
            </span>
            <span class="resultat-navn">Skilt innv.</span>
            <span class="resultat-antall">× 1</span>
            <span class="resultat-verdi">@_skiltInnv<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8.5 8.5 7 7" /><path d="M19 5l-3 1 1-3 3.5 3.5a2.12 2.12 0 0 1 0 3L11 19l-4-1-1-4L15.5 3.5a2.12 2.12 0 0 1 3 0Z" /></svg>
            </span>
            <span class="resultat-navn">Sylinderskruer</span>
            <span class="resultat-antall">× 2</span>
            <span class="resultat-verdi">@_sylSkruer<span>mm</span></span>
        </li>
        <li class="resultat-rad">
            <span class="resultat-ikon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8.5 8.5 7 7" /><path d="M19 5l-3 1 1-3 3.5 3.5a2.12 2.12 0 0 1 0 3L11 19l-4-1-1-4L15.5 3.5a2.12 2.12 0 0 1 3 0Z" /></svg>
            </span>
            <span class="resultat-navn">Skiltskruer</span>
            <span class="resultat-antall">× 2</span>
            <span class="resultat-verdi">@_skiltSkruer<span>mm</span></span>
        </li>
    </ul>
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private int? _a;
    private int? _b;
    private string _cVisning = "0";

    private string _sylinder = "0";
    private string _knappvrider = "0";
    private string _forlengerSylS = "0";
    private string _forlengerSylA = "-";
    private string _forlengerKnappS = "0";
    private string _forlengerKnappA = "-";
    private string _skiltUtv = "0";
    private string _skiltInnv = "0";
    private string _sylSkruer = "0";
    private string _skiltSkruer = "0";

    private void Beregn()
    {
        var a = _a ?? 0;
        var b = _b ?? 0;

        if (a < 0) a = 0;
        else if (a > 100) a = 100;

        if (b < 0) b = 0;
        else if (b > 58) b = 58;

        _a = a;
        _b = b;

        bool feil = a <= b || a == 0 || b == 0 || b > 58;
        if (feil)
        {
            _cVisning = "Feil";
            _sylinder = _knappvrider = _forlengerSylS = _forlengerKnappS = _skiltUtv = _skiltInnv = _sylSkruer = _skiltSkruer = "Feil";
            _forlengerSylA = _forlengerKnappA = "-";
            return;
        }

        var c = a - b;
        _cVisning = c.ToString(Inv);

        _sylinder = "32";
        _knappvrider = "32";

        var (sylStorrelse, sylHuman) = KalkulerForl(b);
        _forlengerSylS = FormatStorrelse(sylStorrelse);
        _forlengerSylA = sylHuman;

        var (knappStorrelse, knappHuman) = KalkulerForl(c);
        _forlengerKnappS = FormatStorrelse(knappStorrelse);
        _forlengerKnappA = knappHuman;

        var skiltUtvVerdi = KalkulerSkilt(b);
        var skiltInnvVerdi = KalkulerSkilt(c);
        _skiltUtv = skiltUtvVerdi.ToString(Inv);
        _skiltInnv = skiltInnvVerdi.ToString(Inv);

        _sylSkruer = KalkulerSylSkruer(sylStorrelse + knappStorrelse);
        _skiltSkruer = KalkulerSkiltSkruer(a + skiltUtvVerdi + skiltInnvVerdi - 6);
    }

    private static string FormatStorrelse(double verdi) => verdi.ToString(Inv);

    // Samme trinntabell som ABC-kalkulatoren fra Boyesen & Munthe (keyman.no) -
    // sylinderforlenger fås kun i 8mm og 12,5mm biter, så dette er de faste
    // kombinasjonene for hvor mye som må dekkes utover standard 32mm halvdel.
    private static (double Storrelse, string Human) KalkulerForl(double x)
    {
        if (x >= 59) return (8 + 8 + 12.5, "2x8 mm. <br> 1x12.5 mm.");
        if (x >= 55) return (12.5 + 12.5, "2x12.5 mm.");
        if (x >= 48) return (12.5 + 8, "1x8 mm. <br> 1x12.5 mm.");
        if (x >= 44) return (12.5, "1x12.5 mm.");
        if (x >= 36) return (8, "1x8 mm.");
        return (0, "-");
    }

    private static int KalkulerSkilt(double x)
    {
        if (x >= 56) return 8;
        if (x >= 53) return 11;
        if (x >= 50) return 13;
        if (x >= 47) return 8;
        if (x >= 44) return 11;
        if (x >= 42) return 6;
        if (x >= 39) return 8;
        if (x >= 36) return 11;
        if (x >= 34) return 6;
        if (x >= 31) return 8;
        if (x >= 29) return 11;
        if (x >= 26) return 13;
        if (x >= 24) return 16;
        if (x >= 21) return 18;
        return 21;
    }

    private static string KalkulerSylSkruer(double x)
    {
        if (x == 0) return "55";
        if (x == 8) return "65";
        if (x == 12.5 || x == 16) return "70";
        if (x == 20.5) return "75";
        if (x == 25 || x == 28.5 || x == 33) return "85";
        if (x == 37.5) return "95";
        return "Feil";
    }

    // Ingen fallback-verdi i kildeverktøyet for x < 55 her - replikerer det
    // avviket bevisst siden dette skal teste 1:1 mot originalen på keyman.no.
    private static string KalkulerSkiltSkruer(double x)
    {
        if (x >= 120) return "120";
        if (x >= 110) return "110";
        if (x >= 90) return "90";
        if (x >= 85) return "85";
        if (x >= 80) return "80";
        if (x >= 75) return "75";
        if (x >= 70) return "70";
        if (x >= 65) return "65";
        if (x >= 60) return "60";
        if (x >= 55) return "55";
        return "undefined";
    }
}
