@using System.Globalization

<div id="ABCKalkulatorHeader" class="abc-header">
    <div class="abc-input-form">
        <label class="abc-input-group">
            <span class="abc-input-label">A-Mål</span>
            <input type="number" min="0" max="100" placeholder="0" @bind="_a" @bind:event="onchange" @bind:after="Beregn" />
        </label>
        <label class="abc-input-group">
            <span class="abc-input-label">B-Mål</span>
            <input type="number" min="0" max="58" placeholder="0" @bind="_b" @bind:event="onchange" @bind:after="Beregn" />
        </label>
        <label class="abc-input-group">
            <span class="abc-input-label">C-Mål</span>
            <input value="@_cVisning" readonly placeholder="0" />
        </label>
    </div>
    <div class="abc-img-container">
        <img src="img/abc-kalkulator-mal.jpg" alt="Bilde av låsmekanisme" class="abc-img" />
    </div>
</div>

<table class="abc-table">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Størrelse</th>
            <th></th>
            <th>Antall</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Sylinder xx37</td>
            <td>@_sylinder</td>
            <td>mm.</td>
            <td class="abc-center">1</td>
        </tr>
        <tr>
            <td>Knappvrider/xx47</td>
            <td>@_knappvrider</td>
            <td>mm.</td>
            <td class="abc-center">1</td>
        </tr>
        <tr>
            <td>Forlenger Sylinderside</td>
            <td>@_forlengerSylS</td>
            <td colspan="2" class="abc-center">@((MarkupString)_forlengerSylA)</td>
        </tr>
        <tr>
            <td>Forlenger Knappvriderside</td>
            <td>@_forlengerKnappS</td>
            <td colspan="2" class="abc-center">@((MarkupString)_forlengerKnappA)</td>
        </tr>
        <tr>
            <td>Skilt utv.</td>
            <td>@_skiltUtv</td>
            <td>mm.</td>
            <td class="abc-center">1</td>
        </tr>
        <tr>
            <td>Skilt innv.</td>
            <td>@_skiltInnv</td>
            <td>mm.</td>
            <td class="abc-center">1</td>
        </tr>
        <tr>
            <td>Sylinderskruer</td>
            <td>@_sylSkruer</td>
            <td>mm.</td>
            <td class="abc-center">2</td>
        </tr>
        <tr>
            <td>Skiltskruer</td>
            <td>@_skiltSkruer</td>
            <td>mm.</td>
            <td class="abc-center">2</td>
        </tr>
    </tbody>
</table>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private int? _a;
    private int? _b;
    private string _cVisning = "0";

    private string _sylinder = "0";
    private string _knappvrider = "0";
    private string _forlengerSylS = "0";
    private string _forlengerSylA = "-";
    private string _forlengerKnappS = "0";
    private string _forlengerKnappA = "-";
    private string _skiltUtv = "0";
    private string _skiltInnv = "0";
    private string _sylSkruer = "0";
    private string _skiltSkruer = "0";

    private void Beregn()
    {
        var a = _a ?? 0;
        var b = _b ?? 0;

        if (a < 0) a = 0;
        else if (a > 100) a = 100;

        if (b < 0) b = 0;
        else if (b > 58) b = 58;

        _a = a;
        _b = b;

        bool feil = a <= b || a == 0 || b == 0 || b > 58;
        if (feil)
        {
            _cVisning = "Feil";
            _sylinder = _knappvrider = _forlengerSylS = _forlengerKnappS = _skiltUtv = _skiltInnv = _sylSkruer = _skiltSkruer = "Feil";
            _forlengerSylA = _forlengerKnappA = "-";
            return;
        }

        var c = a - b;
        _cVisning = c.ToString(Inv);

        _sylinder = "32";
        _knappvrider = "32";

        var (sylStorrelse, sylHuman) = KalkulerForl(b);
        _forlengerSylS = FormatStorrelse(sylStorrelse);
        _forlengerSylA = sylHuman;

        var (knappStorrelse, knappHuman) = KalkulerForl(c);
        _forlengerKnappS = FormatStorrelse(knappStorrelse);
        _forlengerKnappA = knappHuman;

        var skiltUtvVerdi = KalkulerSkilt(b);
        var skiltInnvVerdi = KalkulerSkilt(c);
        _skiltUtv = skiltUtvVerdi.ToString(Inv);
        _skiltInnv = skiltInnvVerdi.ToString(Inv);

        _sylSkruer = KalkulerSylSkruer(sylStorrelse + knappStorrelse);
        _skiltSkruer = KalkulerSkiltSkruer(a + skiltUtvVerdi + skiltInnvVerdi - 6);
    }

    private static string FormatStorrelse(double verdi) => verdi.ToString(Inv);

    // Samme trinntabell som ABC-kalkulatoren fra Boyesen & Munthe (keyman.no) -
    // sylinderforlenger fås kun i 8mm og 12,5mm biter, så dette er de faste
    // kombinasjonene for hvor mye som må dekkes utover standard 32mm halvdel.
    private static (double Storrelse, string Human) KalkulerForl(double x)
    {
        if (x >= 59) return (8 + 8 + 12.5, "2x8 mm. <br> 1x12.5 mm.");
        if (x >= 55) return (12.5 + 12.5, "2x12.5 mm.");
        if (x >= 48) return (12.5 + 8, "1x8 mm. <br> 1x12.5 mm.");
        if (x >= 44) return (12.5, "1x12.5 mm.");
        if (x >= 36) return (8, "1x8 mm.");
        return (0, "-");
    }

    private static int KalkulerSkilt(double x)
    {
        if (x >= 56) return 8;
        if (x >= 53) return 11;
        if (x >= 50) return 13;
        if (x >= 47) return 8;
        if (x >= 44) return 11;
        if (x >= 42) return 6;
        if (x >= 39) return 8;
        if (x >= 36) return 11;
        if (x >= 34) return 6;
        if (x >= 31) return 8;
        if (x >= 29) return 11;
        if (x >= 26) return 13;
        if (x >= 24) return 16;
        if (x >= 21) return 18;
        return 21;
    }

    private static string KalkulerSylSkruer(double x)
    {
        if (x == 0) return "55";
        if (x == 8) return "65";
        if (x == 12.5 || x == 16) return "70";
        if (x == 20.5) return "75";
        if (x == 25 || x == 28.5 || x == 33) return "85";
        if (x == 37.5) return "95";
        return "Feil";
    }

    // Ingen fallback-verdi i kildeverktøyet for x < 55 her - replikerer det
    // avviket bevisst siden dette skal teste 1:1 mot originalen på keyman.no.
    private static string KalkulerSkiltSkruer(double x)
    {
        if (x >= 120) return "120";
        if (x >= 110) return "110";
        if (x >= 90) return "90";
        if (x >= 85) return "85";
        if (x >= 80) return "80";
        if (x >= 75) return "75";
        if (x >= 70) return "70";
        if (x >= 65) return "65";
        if (x >= 60) return "60";
        if (x >= 55) return "55";
        return "undefined";
    }
}
