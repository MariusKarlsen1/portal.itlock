@* «Tilbake til …»-knapp øverst til venstre inne i kortet på underlister
   (ferdigmeldte, fakturerte, godkjente tilbud osv.). Kommer i tillegg til
   tilbakeknappen i toppfeltet. *@
<div class="kort-tilbake-rad">
    <a class="kort-tilbake" href="@Href"><Icon Name="arrow-left" />@Tekst</a>
</div>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";
    [Parameter, EditorRequired] public string Tekst { get; set; } = "Tilbake";
}
