@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Services
@implements IDisposable
@inject BrukerTilgang Tilgang
@inject NavigationManager Nav

@* Usynlig. Står i layoutene, og sender brukeren til innloggingen med en gang
   brukeren deaktiveres eller slettes, også midt i en åpen side. Selve
   utloggingen skjer når innloggingssiden lastes (OnValidatePrincipal). *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _tenantId;
    private int _brukerId;
    private int? _adminBrukerId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var bruker = (await AuthStateTask).User;
        if (int.TryParse(bruker.FindFirst("TenantId")?.Value, out var tenantId)
            && int.TryParse(bruker.FindFirst("BrukerId")?.Value, out var brukerId))
        {
            _tenantId = tenantId;
            _brukerId = brukerId;
            _adminBrukerId = int.TryParse(bruker.FindFirst("AdminBrukerId")?.Value, out var adminId) ? adminId : null;
            Tilgang.Utlogget += VedUtlogging;
        }
    }

    private void VedUtlogging(int tenantId, int brukerId)
    {
        if (tenantId != _tenantId || (brukerId != _brukerId && brukerId != _adminBrukerId))
        {
            return;
        }

        _ = InvokeAsync(() => Nav.NavigateTo("/login?utlogget=1", forceLoad: true));
    }

    public void Dispose() => Tilgang.Utlogget -= VedUtlogging;
}
