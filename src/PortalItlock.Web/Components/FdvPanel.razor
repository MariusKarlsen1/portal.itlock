@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject FdvPdfService FdvPdfService
@inject LagretPdfService LagretPdfService

<div class="prosjekt-layout">
    <p class="section-hint">Samler FDV-dokumentasjonen for alle varer som er lagt på dørene, i én PDF. Hver vare kommer med kun én gang selv om den er brukt på flere dører.</p>

    @if (_prosjekt is not null)
    {
        <div class="field-grid">
            <label class="span-2">
                Forside-mal
                <div class="forside-mal-rad">
                    <select @bind="_valgtFdvForsideMalId">
                        <option value="">Velg forside...</option>
                        @foreach (var f in _forsideMaler)
                        {
                            <option value="@f.Id">@f.Navn</option>
                        }
                    </select>
                    <button type="button" class="cancel-button" @onclick="BrukFdvForsideMal" disabled="@(_valgtFdvForsideMalId is null)">Bruk</button>
                </div>
            </label>

            <label class="span-2">
                Forside / forbehold
                <ForsideTekstRedigering @bind-Value="_prosjekt.FdvForside" Rows="8" Placeholder="Tekst til forsiden av FDV-samlingen." />
            </label>
        </div>

        <div class="form-actions">
            <button type="button" class="save-button" @onclick="LagreFdvForside">Lagre forside</button>
            @if (!string.IsNullOrEmpty(_savedMessage))
            {
                <span class="save-success">@_savedMessage</span>
            }
        </div>
    }

    <div class="fdv-vedlegg-section">
        <h3>Ekstra PDF-vedlegg</h3>
        <p class="section-hint">Legg til en PDF (f.eks. for en vare uten registrert FDV) som blir med når du genererer FDV.</p>

        @if (_fdvVedlegg.Count > 0)
        {
            <ul class="vedlegg-list">
                @foreach (var v in _fdvVedlegg)
                {
                    <li @key="v.Id" class="vedlegg-item">
                        <span>@v.Navn</span>
                        <button type="button" class="remove-button" @onclick="@(() => RemoveFdvVedlegg(v))">Fjern</button>
                    </li>
                }
            </ul>
        }

        <div class="vedlegg-upload">
            <InputFile OnChange="OnFdvVedleggSelected" accept="application/pdf" multiple />
        </div>
        @if (_uploadingFdvVedlegg)
        {
            <p class="list-empty">Laster opp...</p>
        }
        @if (!string.IsNullOrEmpty(_fdvVedleggFeil))
        {
            <p class="form-error">@_fdvVedleggFeil</p>
        }
    </div>

    @if (_byggetrinnListe.Count > 1)
    {
        <div class="byggetrinn-velger">
            <span>Byggetrinn</span>
            <label class="checkbox-row">
                <input type="checkbox" checked="@(_valgteByggetrinn.Count == 0)" @onchange="@(e => VelgAlleByggetrinn((bool)e.Value!))" /> Alle
            </label>
            @foreach (var b in _byggetrinnListe)
            {
                <label class="checkbox-row">
                    <input type="checkbox" checked="@_valgteByggetrinn.Contains(b)" @onchange="@(e => ToggleByggetrinn(b, (bool)e.Value!))" /> @b
                </label>
            }
        </div>
    }

    @if (FdvKomponenterFiltrert.Count > 0)
    {
        <ul class="vedlegg-list">
            @foreach (var k in FdvKomponenterFiltrert)
            {
                <li @key="k.Id" class="vedlegg-item">
                    <span>@k.Navn</span>
                    <span class="vedlegg-type">@k.Produktkode</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="list-empty">Ingen av varene på dørene har FDV-dokumentasjon registrert ennå.</p>
    }

    @if (FdvKomponenterFiltrert.Count > 0 || _fdvVedlegg.Count > 0)
    {
        <button type="button" class="add-button" @onclick="GenererFdv">Generer FDV</button>
    }

    <h2>Lagrede PDF-er</h2>
    <LagredePdfListe Pdfer="_lagredeFdvPdfer" />

    <PdfPreviewModal Url="@_fdvPreviewUrl" Tittel="Forhåndsvisning av FDV" SaveMessage="@_fdvPdfSavedMessage"
                      OnSave="LagreFdvPdf" OnClose="@(() => _fdvPreviewUrl = null)" />
</div>

@code {
    [Parameter, EditorRequired] public int ProsjektId { get; set; }

    private int? _loadedProsjektId;
    private Prosjekt? _prosjekt;
    private List<Dor> _dorer = [];
    private List<string> _byggetrinnListe = [];
    private HashSet<string> _valgteByggetrinn = [];
    private List<FdvVedlegg> _fdvVedlegg = [];
    private bool _uploadingFdvVedlegg;
    private string? _fdvVedleggFeil;
    private List<LagretPdf> _lagredeFdvPdfer = [];
    private string? _fdvPreviewUrl;
    private string? _fdvPdfSavedMessage;
    private string? _savedMessage;
    private List<TilbudForside> _forsideMaler = [];
    private int? _valgtFdvForsideMalId;

    private List<Component> FdvKomponenterFiltrert => _dorer
        .Where(d => _valgteByggetrinn.Count == 0 || (d.Plantegning?.Byggetrinn is not null && _valgteByggetrinn.Contains(d.Plantegning.Byggetrinn)))
        .SelectMany(d => d.Komponenter)
        .Select(dk => dk.Component!)
        .Where(c => c.FdvData != null)
        .DistinctBy(c => c.Id)
        .OrderBy(c => c.Navn)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProsjektId == ProsjektId)
        {
            return;
        }

        _loadedProsjektId = ProsjektId;
        _savedMessage = null;

        _prosjekt = await Db.Prosjekter.FirstOrDefaultAsync(p => p.Id == ProsjektId);

        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .Include(d => d.Plantegning)
            .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .ToListAsync();

        _byggetrinnListe = ByggetrinnHelper.Sorter(_dorer
            .Where(d => !string.IsNullOrWhiteSpace(d.Plantegning?.Byggetrinn))
            .Select(d => d.Plantegning!.Byggetrinn!.Trim())
            .Distinct()).ToList();

        _fdvVedlegg = await Db.FdvVedlegg
            .Where(v => v.ProsjektId == ProsjektId)
            .OrderBy(v => v.Navn)
            .ToListAsync();

        _forsideMaler = await Db.TilbudForsider.OrderBy(f => f.Navn).ToListAsync();
        _lagredeFdvPdfer = await LagretPdfService.HentAsync("Fdv", ProsjektId);
    }

    private void GenererFdv()
    {
        var byggetrinnParam = _valgteByggetrinn.Count == 0 ? "" : $"&byggetrinn={Uri.EscapeDataString(string.Join(",", _valgteByggetrinn))}";
        _fdvPdfSavedMessage = null;
        _fdvPreviewUrl = $"/prosjekt/{ProsjektId}/fdv/pdf?v={DateTime.UtcNow.Ticks}{byggetrinnParam}";
    }

    private async Task LagreFdvPdf()
    {
        var byggetrinn = _valgteByggetrinn.Count == 0 ? null : string.Join(",", _valgteByggetrinn);
        var bytes = await FdvPdfService.GenerateAsync(ProsjektId, byggetrinn);
        if (bytes is null)
        {
            return;
        }

        var etikett = _valgteByggetrinn.Count == 0 ? "" : $" ({string.Join(", ", _valgteByggetrinn)})";
        var pdf = await LagretPdfService.LagreAsync(
            "Fdv", ProsjektId, $"FDV - {_prosjekt?.Navn}{etikett} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);

        _lagredeFdvPdfer.Add(pdf);
        _fdvPdfSavedMessage = "PDF-en er lagret nedenfor.";
    }

    private void VelgAlleByggetrinn(bool valgt)
    {
        if (valgt)
        {
            _valgteByggetrinn.Clear();
        }
    }

    private void ToggleByggetrinn(string byggetrinn, bool valgt)
    {
        if (valgt)
        {
            _valgteByggetrinn.Add(byggetrinn);
        }
        else
        {
            _valgteByggetrinn.Remove(byggetrinn);
        }
    }

    private void BrukFdvForsideMal()
    {
        if (_valgtFdvForsideMalId is null || _prosjekt is null)
        {
            return;
        }

        var mal = _forsideMaler.FirstOrDefault(f => f.Id == _valgtFdvForsideMalId);
        if (mal is null)
        {
            return;
        }

        _prosjekt.FdvForside = mal.Innhold;
    }

    private async Task LagreFdvForside()
    {
        await Db.SaveChangesAsync();
        _savedMessage = "Forside lagret.";
    }

    private async Task OnFdvVedleggSelected(InputFileChangeEventArgs e)
    {
        if (_uploadingFdvVedlegg)
        {
            return;
        }

        _fdvVedleggFeil = null;
        _uploadingFdvVedlegg = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > 20_000_000)
                {
                    _fdvVedleggFeil = $"\"{file.Name}\" er for stor (maks 20 MB) og ble hoppet over.";
                    continue;
                }

                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
                {
                    await stream.CopyToAsync(buffer);
                }

                var vedlegg = new FdvVedlegg
                {
                    ProsjektId = ProsjektId,
                    Navn = Path.GetFileNameWithoutExtension(file.Name),
                    Filnavn = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType,
                    Data = buffer.ToArray()
                };

                Db.FdvVedlegg.Add(vedlegg);
            }

            await Db.SaveChangesAsync();
            _fdvVedlegg = await Db.FdvVedlegg
                .Where(v => v.ProsjektId == ProsjektId)
                .OrderBy(v => v.Navn)
                .ToListAsync();
        }
        finally
        {
            _uploadingFdvVedlegg = false;
        }
    }

    private async Task RemoveFdvVedlegg(FdvVedlegg v)
    {
        Db.FdvVedlegg.Remove(v);
        await Db.SaveChangesAsync();
        _fdvVedlegg.Remove(v);
    }
}
