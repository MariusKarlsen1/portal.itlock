<button type="button" class="theme-toggle" data-biler-toggle
        data-label-start="🚐 Kjør biler" data-label-stopp="⏸ Stopp biler"
        title="Start/stopp servicebilene på forsiden"
        onclick="biler.toggle(); this.textContent = biler.erAktiv() ? this.dataset.labelStopp : this.dataset.labelStart;">
    🚐 Kjør biler
</button>
