@using PortalItlock.Web.Services
@inject TilleggsmodulService Tilleggsmoduler

@* Viser innholdet bare når organisasjonen har tilleggsmodulen, for eksempel
   kort, lenker og kolonner som hører til Timer og fravær. *@
@if (_har)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public string Modul { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _har;

    protected override async Task OnParametersSetAsync() => _har = await Tilleggsmoduler.HarAsync(Modul);
}
