@using System.Globalization
@using System.Text.Json
@using PortalItlock.Web.Models

@if (Symboler.Count == 0 && Streker.Count == 0)
{
    <span class="mini-preview-tom"><Icon Name="file-text" /></span>
}
else
{
    <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" class="mini-preview-svg">
        @foreach (var strek in Streker)
        {
            <polyline points="@PunkterTilSvgPoints(strek.PunkterJson)" fill="none"
                      stroke="@strek.Farge" stroke-width="1"
                      stroke-dasharray="@(strek.Stiplet ? "3,2" : null)" />
        }
        @foreach (var sym in Symboler.OrderBy(sy => sy.ZIndex))
        {
            @if (sym.ElementType == KoblingsElementType.Bilde && sym.SymbolBibliotekId.HasValue)
            {
                <image href="@($"/koblingsbibliotek/{sym.SymbolBibliotekId}")"
                       x="@Pos(sym.PosX)" y="@Pos(sym.PosY)" width="@Pos(sym.Bredde)" height="@Pos(sym.Hoyde)"
                       preserveAspectRatio="xMidYMid slice" />
            }
            else if (sym.ElementType == KoblingsElementType.Rektangel)
            {
                <rect x="@Pos(sym.PosX)" y="@Pos(sym.PosY)" width="@Pos(sym.Bredde)" height="@Pos(sym.Hoyde)"
                      fill="@(sym.Fylt ? sym.Farge : "none")" stroke="@sym.Farge" stroke-width="1" />
            }
            else if (sym.ElementType == KoblingsElementType.Sirkel)
            {
                <ellipse cx="@Pos(sym.PosX + sym.Bredde / 2)" cy="@Pos(sym.PosY + sym.Hoyde / 2)"
                         rx="@Pos(sym.Bredde / 2)" ry="@Pos(sym.Hoyde / 2)"
                         fill="@(sym.Fylt ? sym.Farge : "none")" stroke="@sym.Farge" stroke-width="1" />
            }
            else if (sym.ElementType is KoblingsElementType.Linje or KoblingsElementType.Pil)
            {
                <line x1="@Pos(sym.PosX)" y1="@Pos(sym.PosY)" x2="@Pos(sym.PosX + sym.Bredde)" y2="@Pos(sym.PosY + sym.Hoyde)"
                      stroke="@sym.Farge" stroke-width="1" />
            }
            else if (sym.ElementType == KoblingsElementType.Punkt)
            {
                <circle cx="@Pos(sym.PosX + sym.Bredde / 2)" cy="@Pos(sym.PosY + sym.Hoyde / 2)" r="1.6" fill="@sym.Farge" />
            }
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public List<KoblingsSymbol> Symboler { get; set; } = [];
    [Parameter, EditorRequired] public List<KoblingsStrek> Streker { get; set; } = [];

    private static string Pos(double verdi) => verdi.ToString(CultureInfo.InvariantCulture);

    private static string PunkterTilSvgPoints(string punkterJson)
    {
        var punkter = JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(punkterJson) ?? [];
        return string.Join(" ", punkter.Select(p => $"{Pos(p.X)},{Pos(p.Y)}"));
    }
}
