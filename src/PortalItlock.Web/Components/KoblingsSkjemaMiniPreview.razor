@using System.Globalization
@using System.Text.Json
@using PortalItlock.Web.Models

@* Forhåndsvisning av et koblingsskjema. Tegningen beskjæres til det som faktisk
   er tegnet, og skaleres likt i begge retninger (ikke strukket), så den fyller
   rammen og er lett å lese. Strekene har fast tykkelse på skjermen. *@
@if (Symboler.Count == 0 && Streker.Count == 0)
{
    <span class="mini-preview-tom"><Icon Name="file-text" /></span>
}
else
{
    var (vx, vy, vb, vh) = Ramme();
    // Omtrent hvor mange skjermpiksler én enhet blir (rammen er ca. 800 px bred stor, 64 px liten).
    var pxPerEnhet = (VisNavn ? 800.0 : 64.0) / vb;
    <svg viewBox="@($"{Pos(vx)} {Pos(vy)} {Pos(vb)} {Pos(vh)}")" preserveAspectRatio="xMidYMid meet" class="mini-preview-svg">
        @foreach (var strek in Streker)
        {
            @if (!strek.ErKabel && KoblingsStrekTekst.ErHvit(strek.Farge))
            {
                <polyline points="@Punkter(strek.PunkterJson)" fill="none" stroke="@KoblingsStrekTekst.HvitKant" stroke-width="@Pos(VisNavn ? 3.2 : 1.8)"
                          stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            }
            <polyline points="@Punkter(strek.PunkterJson)" fill="none"
                      stroke="@(strek.ErKabel ? KoblingsKabel.KabelFarge : strek.Farge)" stroke-width="@Pos(VisNavn ? (strek.ErKabel ? 4 : 1.8) : 1)"
                      stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"
                      stroke-dasharray="@(strek.Stiplet ? "4,3" : null)" />
        }
        @if (VisNavn)
        {
            @((MarkupString)KoblingsKryss.Svg(KoblingsKryss.Linjer(Streker, _ => null, p => JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(p) ?? []),
                Aspekt, yFaktor: Aspekt, breddeFaktor: 0.9, pxPerProsent: pxPerEnhet))
        }
        @foreach (var sym in Symboler.OrderBy(sy => sy.ZIndex))
        {
            var x = sym.PosX;
            var y = sym.PosY * Aspekt;
            var b = sym.Bredde;
            var h = sym.Hoyde * Aspekt;
            @if (sym.ElementType == KoblingsElementType.Bilde && sym.SymbolBibliotekId.HasValue)
            {
                <image href="@($"/koblingsbibliotek/{sym.SymbolBibliotekId}")" x="@Pos(x)" y="@Pos(y)" width="@Pos(b)" height="@Pos(h)" preserveAspectRatio="xMidYMid meet" />
            }
            else if (sym.ElementType == KoblingsElementType.Komponent && KoblingsKomponentKatalog.Finn(sym.KomponentNokkel)?.Bilde is { } tegning)
            {
                <image href="@tegning" x="@Pos(x)" y="@Pos(y)" width="@Pos(b)" height="@Pos(h)" preserveAspectRatio="xMidYMid meet" />
            }
            else if (sym.ElementType == KoblingsElementType.Rektangel)
            {
                <rect x="@Pos(x)" y="@Pos(y)" width="@Pos(b)" height="@Pos(h)" fill="@(sym.Fylt ? sym.Farge : "none")" stroke="@sym.Farge" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            }
            else if (sym.ElementType == KoblingsElementType.Sirkel)
            {
                <ellipse cx="@Pos(x + b / 2)" cy="@Pos(y + h / 2)" rx="@Pos(b / 2)" ry="@Pos(h / 2)" fill="@(sym.Fylt ? sym.Farge : "none")" stroke="@sym.Farge" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            }
            else if (sym.ElementType is KoblingsElementType.Linje or KoblingsElementType.Pil)
            {
                <line x1="@Pos(x)" y1="@Pos(y)" x2="@Pos(x + b)" y2="@Pos(y + h)" stroke="@sym.Farge" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            }
            else if (sym.ElementType == KoblingsElementType.Punkt)
            {
                <ellipse cx="@Pos(x + b / 2)" cy="@Pos(y + h / 2)" rx="@Pos(b / 2)" ry="@Pos(h / 2)" fill="@sym.Farge" />
            }
        }
        @if (Symboler.Any(s => s.KablerOver))
        {
            <defs>
                <clipPath id="@($"mp-over-{GetHashCode()}")" clipPathUnits="userSpaceOnUse">
                    @foreach (var k in Symboler.Where(s => s.KablerOver))
                    {
                        <rect x="@Pos(k.PosX)" y="@Pos(k.PosY * Aspekt)" width="@Pos(k.Bredde)" height="@Pos(k.Hoyde * Aspekt)" />
                    }
                </clipPath>
            </defs>
            <g clip-path="@($"url(#mp-over-{GetHashCode()})")">
                @foreach (var strek in Streker)
                {
                    <polyline points="@Punkter(strek.PunkterJson)" fill="none"
                              stroke="@(strek.ErKabel ? KoblingsKabel.KabelFarge : strek.Farge)" stroke-width="@Pos(VisNavn ? (strek.ErKabel ? 4 : 1.8) : 1)"
                              stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                }
            </g>
        }
        @if (VisNavn)
        {
            var fontStr = 10.5 / pxPerEnhet;
            @foreach (var sym in Symboler.Where(s => !s.SkjulNavn && !string.IsNullOrWhiteSpace(s.Navn) && s.ElementType is not (KoblingsElementType.Tekstboks or KoblingsElementType.Punkt or KoblingsElementType.Linje or KoblingsElementType.Pil)))
            {
                @((MarkupString)KoblingsSvg.Tekst(sym.PosX + sym.Bredde / 2, sym.PosY * Aspekt - fontStr * 0.45, fontStr, "#14213D", sym.Navn!, midt: false))
            }
        }
    </svg>
}

@code {
    [Parameter, EditorRequired] public List<KoblingsSymbol> Symboler { get; set; } = [];
    [Parameter, EditorRequired] public List<KoblingsStrek> Streker { get; set; } = [];

    // Navn og tekst (i den store forhåndsvisningen, ikke i miniatyrene).
    [Parameter] public bool VisNavn { get; set; }

    // Lerretet er 16:13. Y regnes om så én enhet er like lang begge veier.
    private const double Aspekt = 13.0 / 16.0;

    private static string Pos(double verdi) => Math.Round(verdi, 3).ToString(CultureInfo.InvariantCulture);

    private static List<KoblingsStrekPunkt> Les(string json) => JsonSerializer.Deserialize<List<KoblingsStrekPunkt>>(json) ?? [];

    private static string Punkter(string json) => string.Join(" ", Les(json).Select(p => $"{Pos(p.X)},{Pos(p.Y * Aspekt)}"));

    // Utsnittet rundt alt som er tegnet, med litt luft (og plass til navnene over).
    private (double X, double Y, double B, double H) Ramme()
    {
        var xs = new List<double>();
        var ys = new List<double>();
        foreach (var s in Symboler)
        {
            xs.Add(s.PosX);
            xs.Add(s.PosX + s.Bredde);
            ys.Add(s.PosY * Aspekt - (VisNavn && !string.IsNullOrWhiteSpace(s.Navn) ? 2.5 : 0));
            ys.Add((s.PosY + s.Hoyde) * Aspekt);
        }
        foreach (var p in Streker.SelectMany(s => Les(s.PunkterJson)))
        {
            xs.Add(p.X);
            ys.Add(p.Y * Aspekt);
        }
        if (xs.Count == 0)
        {
            return (0, 0, 100, 100 * Aspekt);
        }
        var luft = VisNavn ? 2.5 : 1.5;
        double x0 = xs.Min() - luft, x1 = xs.Max() + luft, y0 = ys.Min() - luft, y1 = ys.Max() + luft;
        return (x0, y0, Math.Max(5, x1 - x0), Math.Max(5, y1 - y0));
    }
}
