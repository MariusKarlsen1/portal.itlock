@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProsjektOppfolgingService OppfolgingSvc
@inject TripletexSyncService TripletexSync
@inject TripletexService Tripletex
@inject NavigationManager Nav

@* Ett pågående prosjekt under Prosjektøkonomi: det som var arket
   «Kalkulering og økonomi», med fanene Oversikt, Fremdriftsplan, Budsjett og
   timer, Endringer og Fakturering. Tallene regnes ut av seg selv; feltene
   med stiplet grønn ramme fylles inn, som de grønne cellene i arket.
   Etterkalkylen ligger som før under Etterkalkyle. *@
@if (_f is null || _p is null)
{
    <p class="pf-tom">Regner ut …</p>
}
else
{
    var f = _f;
    var o = f.O;
    <div class="pf">
        <div class="pf-topp">
            <div>
                <button type="button" class="pf-lenke pf-tilbake" @onclick="Tilbake"><Icon Name="arrow-left" />Til pågående prosjekter</button>
                <h2>@_p.Navn</h2>
                <p>@(_p.Kunde?.Navn ?? "Ingen kunde")@(_p.Prosjektleder is { } pl ? $" · PL {pl.Navn}" : "")</p>
            </div>
            <span class="pf-topp-hoyre">
                <span class="pf-chip pf-chip-bla">@(_p.Status?.Visningsnavn() ?? "Aktiv")</span>
                <a class="pf-knapp" href="@($"/prosjekter/{_p.Id}")"><Icon Name="folder" />Åpne prosjektet</a>
            </span>
        </div>

        <nav class="pf-faner" role="tablist" aria-label="Prosjektøkonomi">
            @Fane("oversikt", "Oversikt", null, "")
            @Fane("budsjett", "Økonomi i detalj", null, "")
            @Fane("endringer", "Tilbud og endringer", f.EndringerVenter > 0 ? $"{f.EndringerVenter} venter" : f.Endringsmeldinger.Count > 0 ? f.Endringsmeldinger.Count.ToString() : null, f.EndringerVenter > 0 ? "gul" : "")
            @Fane("plan", "Fremdriftsplan", f.ForsinkedeAktiviteter > 0 ? $"{f.ForsinkedeAktiviteter} forsinket" : f.HarPlan ? $"{Math.Round(f.PlanAndel * 100):0} %" : "mangler", f.ForsinkedeAktiviteter > 0 ? "rod" : f.HarPlan ? "" : "gul")
            @Fane("faktura", "Fakturering", f.KlarAkonto is not null || f.UtfortIkkeFakturert > f.Prosjektsum * 0.05m ? "klar" : null, "gul")
        </nav>

        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="pf-melding @(_meldingFeil ? "pf-melding-feil" : "")">@_melding</p>
        }

        @switch (_fane)
        {
            case "plan":
                @PlanFane()
                break;
            case "budsjett":
                @BudsjettFane()
                break;
            case "endringer":
                @EndringerFane()
                break;
            case "faktura":
                @FakturaFane()
                break;
            default:
                @OversiktFane()
                break;
        }
    </div>
}

@code {
    [Parameter] public int ProsjektId { get; set; }

    // All databasebruk går gjennom siden rundt, så den ikke kolliderer med
    // oppdateringen i bakgrunnen.
    [Parameter] public Func<Func<Task>, Task> Kjor { get; set; } = arbeid => arbeid();

    // Settes av siden rundt hver gang tallene er regnet ut på nytt.
    [Parameter] public DateTime Oppdatert { get; set; }
    [Parameter] public string? BrukerNavn { get; set; }

    // Lenken tilbake til lista over pågående prosjekter.
    [Parameter] public EventCallback Tilbake { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    // Det som mangler før prosjektet følges opp fullt ut, med fanen det gjøres i.
    private List<(string Tekst, string Fane)> KomIGang()
    {
        var liste = new List<(string, string)>();
        if (_f is null)
        {
            return liste;
        }

        if (_f.O is null) liste.Add(("Sett tilbudet på prosjektet til Godkjent", "tilbud"));
        if (_f.Frister is null) liste.Add(("Legg inn montasjestart og overlevering", "plan"));
        if (!_f.HarPlan) liste.Add(("Lag fremdriftsplan", "plan"));
        if (_f.Akontoer.Count == 0 && _f.Gjenstar > 1) liste.Add(("Lag faktureringsplan", "faktura"));
        if (_f.HarPlan && !_roller.Values.Any(v => v is not null)) liste.Add(("Velg personer til rollene", "plan"));
        return liste;
    }

    // Et steg i «Kom i gang»: en fane her, eller tilbudene på selve prosjektet.
    private void GaTil(string fane)
    {
        if (fane == "tilbud")
        {
            Nav.NavigateTo($"/prosjekter/{ProsjektId}");
            return;
        }

        _fane = fane;
        _melding = null;
    }

    private ProsjektOppfolgingService.Oppfolging? _f;
    private Prosjekt? _p;
    private List<ProsjektplanAktivitet> _aktiviteter = [];
    private Dictionary<string, int?> _roller = [];
    private List<(int Id, string Navn)> _brukere = [];
    private Dictionary<BudsjettPost, decimal> _justering = [];
    private List<(TimeAktivitet Aktivitet, decimal Timer)> _timerPerAktivitet = [];
    private string _fane = "oversikt";
    private string? _melding;
    private bool _meldingFeil;
    private int _lastetFor;
    private DateTime _lastetTid;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastetFor != ProsjektId || _lastetTid != Oppdatert)
        {
            if (_lastetFor != ProsjektId)
            {
                _fane = "oversikt";
                _melding = null;
                _apne.Clear();
            }

            _lastetFor = ProsjektId;
            _lastetTid = Oppdatert;
            await Kjor(LastAsync);
        }
    }


    private async Task LastAsync()
    {
        _f = await OppfolgingSvc.HentAsync(ProsjektId);
        _p = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder).FirstOrDefaultAsync(p => p.Id == ProsjektId);
        _aktiviteter = await Db.ProsjektplanAktiviteter.AsNoTracking().Include(a => a.Oppgaver)
            .Where(a => a.ProsjektId == ProsjektId).OrderBy(a => a.Fase).ThenBy(a => a.Rekkefolge).ToListAsync();
        _roller = await Db.ProsjektRoller.AsNoTracking().Where(r => r.ProsjektId == ProsjektId).ToDictionaryAsync(r => r.Rolle, r => r.BrukerId);
        _brukere = (await Db.Brukere.AsNoTracking()
                .Where(b => b.Aktiv && b.SlettetDato == null && b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
                .OrderBy(b => b.Navn).Select(b => new { b.Id, b.Navn }).ToListAsync())
            .Select(b => (b.Id, b.Navn)).ToList();
        _justering = await Db.ProsjektBudsjettJusteringer.AsNoTracking().Where(j => j.ProsjektId == ProsjektId).ToDictionaryAsync(j => j.Post, j => j.Belop);
        _timerPerAktivitet = (await Db.Timeregistreringer.AsNoTracking()
                .Where(t => t.Arbeidsordre!.ProsjektId == ProsjektId && t.Status != TimeregistreringStatus.Avslatt)
                .Select(t => new { t.Aktivitet, t.Start, t.Slutt, t.PauseMinutter }).ToListAsync())
            .GroupBy(t => t.Aktivitet)
            .Select(g => (g.Key, Math.Round(g.Sum(t => Math.Max(0, (decimal)(t.Slutt - t.Start).TotalHours - t.PauseMinutter / 60m)), 1)))
            .OrderByDescending(x => x.Item2).ToList();
    }

    private async Task Lagre(Func<Task> endring, string? melding = null)
    {
        await Kjor(async () =>
        {
            try
            {
                await endring();
                await Db.SaveChangesAsync();
                _melding = melding;
                _meldingFeil = false;
            }
            catch (Exception ex) when (ex is DbUpdateException or InvalidOperationException)
            {
                _melding = "Kunne ikke lagre. Prøv igjen.";
                _meldingFeil = true;
            }

            await LastAsync();
        });
    }

    private Task EndreProsjekt(Action<Prosjekt> endring, string? melding = null) =>
        Lagre(async () => endring(await Db.Prosjekter.FirstAsync(p => p.Id == ProsjektId)), melding);

    // ---------- Hjelpere ----------
    private static string Kr(decimal v) => v.ToString("#,##0", Kultur) + " kr";
    private static string KrKort(decimal v) => v.ToString("#,##0", Kultur);
    private static string Pst(decimal v) => Math.Round(v * 100).ToString("0", Kultur) + " %";
    private static string DG(decimal? v) => v is { } d ? (d * 100).ToString("0.0", Kultur) + " %" : "–";
    private static string Css(double v) => Math.Clamp(v, 0, 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    private static string Dato(DateTime d) => d.ToString("dd.MM", Kultur);
    private static string? DatoVerdi(DateTime? d) => d?.ToString("yyyy-MM-dd");
    private static DateTime? LesDato(ChangeEventArgs e) => DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d.Date : null;
    private static decimal? LesTall(ChangeEventArgs e) => decimal.TryParse(e.Value?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;
    private static string? LesTekst(ChangeEventArgs e) => string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();

    private static string NivaKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gronn => "gronn",
        ProsjektOppfolgingService.Niva.Gul => "gul",
        ProsjektOppfolgingService.Niva.Rod => "rod",
        _ => "noytral"
    };

    private string PersonFor(string? rolle) =>
        rolle is not null && _roller.GetValueOrDefault(rolle) is int id && _brukere.FirstOrDefault(b => b.Id == id) is { Navn: { } navn } ? navn : "";

    private RenderFragment Fane(string id, string tekst, string? teller, string tellerKlasse) => @<button type="button" role="tab" aria-selected="@(_fane == id ? "true" : "false")" class="@(_fane == id ? "aktiv" : "")" @onclick="@(() => { _fane = id; _melding = null; })">
        @tekst
        @if (teller is not null)
        {
            <small class="pf-teller @(string.IsNullOrEmpty(tellerKlasse) ? "" : "pf-teller-" + tellerKlasse)">@teller</small>
        }
    </button>;

    // ======================================================================
    // Oversikt
    private sealed record Oppgave(string Ikon, string Klasse, string Tittel, string Tekst, string Knapp, Func<Task> Handling);

    private bool _alleOppgaver;

    // Det prosjektlederen bør gjøre nå, det viktigste først.
    private List<Oppgave> Oppgaver()
    {
        var liste = new List<Oppgave>();
        if (_f is not { } f)
        {
            return liste;
        }

        Task GaFane(string fane) { _fane = fane; _melding = null; return Task.CompletedTask; }
        Task Til(string adresse) { Nav.NavigateTo(adresse); return Task.CompletedTask; }
        var o = f.O;

        if (f.KlarAkonto is { } klar)
        {
            liste.Add(new("file-text", "gul", $"Send akonto {klar.Akonto.Nr} · {Kr(klar.Netto)}", $"{klar.Akonto.Milepael} er nådd.", "Til faktureringen", () => GaFane("faktura")));
        }
        else if (f.UtfortIkkeFakturert > f.Prosjektsum * 0.05m)
        {
            liste.Add(new("file-text", "gul", $"Fakturer {Kr(f.UtfortIkkeFakturert)}", $"{Pst(f.Fremdrift)} er utført, {Pst(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0)} er fakturert.", "Til faktureringen", () => GaFane("faktura")));
        }

        if (o is { OverTimer: > 0 })
        {
            liste.Add(new("clock", "rod", $"Timene er {(o.FaktiskTimer - o.BudsjettTimer).ToString("0.#", Kultur)} t over tilbudet",
                $"{o.FaktiskTimer.ToString("0.#", Kultur)} t brukt av {o.BudsjettTimer.ToString("0.#", Kultur)} t. Er noe av det ekstraarbeid, skal kunden betale for det.", "Åpne prosjektet", () => Til($"/prosjekter/{ProsjektId}")));
        }

        if (o is { OverVarer: > 0 })
        {
            liste.Add(new("box", "rod", $"Varene er {Kr(o.OverVarer)} over tilbudet", "Ekstra varer bør faktureres som endringsmelding.", "Åpne prosjektet", () => Til($"/prosjekter/{ProsjektId}")));
        }

        if (f.ForsinkedeAktiviteter > 0)
        {
            liste.Add(new("calendar", "rod", $"{f.ForsinkedeAktiviteter} aktivitet{(f.ForsinkedeAktiviteter == 1 ? " er" : "er er")} forsinket", "Oppdater oppgavene eller flytt datoene i fremdriftsplanen.", "Se planen", () => GaFane("plan")));
        }

        foreach (var e in f.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.SendtTilKunde && e.DagerVentet >= 7))
        {
            liste.Add(new("send", "bla", $"E{e.Nr} har ventet på kunden i {e.DagerVentet} dager", $"{Kr(e.Belop)} kommer i tillegg når kunden godkjenner.", "Følg opp", () => GaFane("endringer")));
        }

        if (o is { FaktiskTimerVenter: > 0 })
        {
            liste.Add(new("check", "bla", $"Godkjenn {o.FaktiskTimerVenter.ToString("0.#", Kultur)} t", "Timene er ført, men ikke godkjent.", "Til godkjenning", () => Til("/timegodkjenning")));
        }

        if (o is { AntallIkkeFakturert: > 0 })
        {
            liste.Add(new("receipt", "gul", $"{o.AntallIkkeFakturert} ferdigmeldte arbeidsordre er ikke fakturert", $"{Kr(o.IkkeFakturert)} venter på faktura.", "Til arbeidsordre", () => Til("/arbeidsordre")));
        }

        foreach (var (tekst, fane) in KomIGang())
        {
            var til = fane;
            liste.Add(new("check-circle", "bla", tekst, "Gjør prosjektet klart til å følges opp fullt ut.", "Gjør det nå", () => { GaTil(til); return Task.CompletedTask; }));
        }

        if (p_BankgarantiSnart() is { } bg)
        {
            liste.Add(new("alert-triangle", "gul", $"Bankgarantien går ut {bg:dd.MM}", "Forny eller avslutt garantien.", "Til faktureringen", () => GaFane("faktura")));
        }

        return liste;
    }

    private DateTime? p_BankgarantiSnart() => _p?.BankgarantiTil is { } bg && bg.Date <= DateTime.Today.AddDays(14) ? bg : null;

    // Én rad per post: det kunden betaler, kosten i tilbudet og det som er brukt.
    private RenderFragment PostRad(string navn, decimal salg, decimal ramme, decimal brukt, string linje, string forklaring) => @<tr>
        @{
            var igjen = salg - Math.Max(ramme, brukt);
            var (klasse, ord) = salg <= 0 && brukt > 0 ? ("gul", "Ikke priset") : brukt > salg ? ("rod", "Taper penger") : brukt > ramme ? ("gul", "Over tilbudet") : ("gronn", "Innenfor");
        }
        <td title="@forklaring"><b>@navn</b><small>@linje</small></td>
        <td class="n @(salg > 0 ? "" : "pf-mut")">@(salg > 0 ? Kr(salg) : "–")</td>
        <td class="n">@Kr(ramme)</td>
        <td class="n">@Kr(brukt)</td>
        <td class="n"><b class="@(igjen < 0 ? "pf-rod" : "pf-gronn")">@Kr(igjen)</b></td>
        <td><span class="pf-chip pf-chip-@klasse">@ord</span></td>
    </tr>;

    private RenderFragment OversiktFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var o = f.O;
            var oppgaver = Oppgaver();
            var synlige = _alleOppgaver ? oppgaver : oppgaver.Take(3).ToList();
        }
        @if (o is not { Inntekt: > 0 })
        {
            <div class="pf-tomboks"><b>Ingen budsjett ennå</b><p>Tallene kommer når et tilbud på prosjektet settes til Godkjent. Da låses budsjettet, og det som brukes underveis sammenlignes med det.</p></div>
        }
        else
        {
            var nullTimer = o.Timesats > 0 ? o.SalgArbeid / o.Timesats : 0;
            var paslag = o.RammeVarer > 0 && o.SalgVarer > 0 ? o.SalgVarer / o.BudsjettVarer - 1 : 0;
            var timer = $"{o.FaktiskTimer.ToString("0.#", Kultur)} t brukt av {o.BudsjettTimer.ToString("0.#", Kultur)} t";
            <div>
                <div class="pf-liste-ramme">
                    <table class="pf-liste">
                        <thead><tr><th>Post</th><th class="n">Kunden betaler</th><th class="n">Kost i tilbud</th><th class="n">Brukt</th><th class="n">Fortjeneste igjen</th><th>Status</th></tr></thead>
                        <tbody>
                            @PostRad("Arbeid", o.SalgArbeid, o.RammeTimer, o.FaktiskTimekost, timer + (o.FaktiskTimerVenter > 0 ? $" · {o.FaktiskTimerVenter.ToString("0.#", Kultur)} t venter godkjenning" : ""),
                                (o.SalgArbeid <= 0 ? "Ikke priset i tilbudet, så timene er bare kostnad." : "") + (nullTimer > 0 ? $" Går i null ved {nullTimer.ToString("0.#", Kultur)} t." : ""))
                            @PostRad("Varer", o.SalgVarer, o.RammeVarer, o.FaktiskVarer, o.VarerAnslatt ? "Anslått etter fremdriften" : paslag > 0 ? $"Påslag {DG(paslag)}" : "",
                                paslag > 0 ? $"{Kr(Math.Min(o.FaktiskVarer, o.RammeVarer) * paslag)} opptjent på brukte varer." : "")
                            @if (o.SalgAndre > 0 || o.BudsjettAndre > 0 || o.FaktiskAndre > 0)
                            {
                                @PostRad("Kjøring og tillegg", o.SalgAndre, o.RammeAndre, o.FaktiskAndre, o.SalgAndre <= 0 ? "Ikke i tilbudet" : o.AndreAnslatt ? "Anslått etter fremdriften" : "Ført på arbeidsordrene",
                                    o.SalgAndre <= 0 ? "Ikke priset i tilbudet. Husk det i neste tilbud." : "")
                            }
                        </tbody>
                        <tfoot><tr><td>Sum</td><td class="n">@Kr(o.Inntekt)</td><td class="n">@Kr(o.JustertKost)</td><td class="n">@Kr(o.FaktiskKost)</td><td class="n">@Kr(f.FortjenesteIgjen)</td><td></td></tr></tfoot>
                    </table>
                </div>
                <div class="pf-liste-lenke"><button type="button" class="pf-lenke" @onclick="@(() => _fane = "budsjett")">Se all utregning →</button></div>
            </div>
        }

        <div class="pf-halv">
            <div class="pf-liste-ramme">
                <table class="pf-liste pf-liste-smal">
                    <thead><tr><th colspan="2">Gjør nå@(oppgaver.Count > 0 ? $" · {oppgaver.Count}" : "")</th></tr></thead>
                    <tbody>
                        @if (oppgaver.Count == 0)
                        {
                            <tr><td colspan="2">Alt er i orden. Portalen sier fra når noe trenger deg.</td></tr>
                        }
                        @for (var i = 0; i < synlige.Count; i++)
                        {
                            var x = synlige[i];
                            <tr>
                                <td><b>@x.Tittel</b><small>@x.Tekst</small></td>
                                <td class="n"><button type="button" class="pf-knapp @(i == 0 ? "pf-knapp-p" : "")" @onclick="x.Handling">@x.Knapp</button></td>
                            </tr>
                        }
                        @if (oppgaver.Count > 3)
                        {
                            <tr class="pf-liste-valg"><td colspan="2"><button type="button" class="pf-lenke" @onclick="@(() => _alleOppgaver = !_alleOppgaver)">@(_alleOppgaver ? "Vis færre" : $"Vis {oppgaver.Count - 3} til")</button></td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pf-liste-ramme">
                <table class="pf-liste pf-liste-smal">
                    <thead><tr><th colspan="2">Denne uken · uke @FremdriftsplanBeregner.Ukenr(DateTime.Today)</th></tr></thead>
                    <tbody>
                        @if (!f.HarPlan)
                        {
                            <tr><td colspan="2">Oppgavene fra fremdriftsplanen vises her. <button type="button" class="pf-lenke" @onclick="@(() => _fane = "plan")">Lag fremdriftsplanen</button></td></tr>
                        }
                        else if (f.AapneOppgaver.Count == 0)
                        {
                            <tr><td colspan="2">Ingen åpne oppgaver denne uken.</td></tr>
                        }
                        else
                        {
                            @foreach (var x in f.AapneOppgaver.OrderByDescending(x => x.Forsinket).ThenBy(x => x.Frist).Take(3))
                            {
                                <tr>
                                    <td><b>@x.Oppgave.Tekst</b><small>@(PersonFor(x.Oppgave.Rolle) is { Length: > 0 } n ? n : x.Oppgave.Rolle)</small></td>
                                    <td class="n"><span class="pf-chip @(x.Forsinket || x.Oppgave.Status == PlanOppgaveStatus.Utfordring ? "pf-chip-rod" : "")">@(x.Forsinket ? "Forsinket" : x.Oppgave.Status == PlanOppgaveStatus.Utfordring ? "Utfordring" : $"innen {Dato(x.Frist)}")</span></td>
                                </tr>
                            }
                            <tr class="pf-liste-valg"><td colspan="2"><button type="button" class="pf-lenke" @onclick="@(() => _fane = "plan")">@(f.AapneOppgaver.Count > 3 ? $"Se alle {f.AapneOppgaver.Count} i fremdriftsplanen →" : "Åpne fremdriftsplanen →")</button></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>;

    // ======================================================================
    // Fremdriftsplan
    private readonly HashSet<int> _apne = [];
    private string _planVisning = "tabell";
    private readonly Dictionary<int, string> _nyOppgave = [];

    private Task LagPlan()
    {
        return Lagre(() => OppfolgingSvc.LagPlanFraMalAsync(ProsjektId), "Fremdriftsplanen er laget fra malen. Oppgaver i aktiviteter som allerede er passert, er satt til avsluttet. Sjekk datoene, og velg personer til rollene nederst.");
    }

    private Task SettStatus(int oppgaveId, ChangeEventArgs e) => Lagre(async () =>
    {
        var t = await Db.ProsjektplanOppgaver.FirstAsync(x => x.Id == oppgaveId);
        t.Status = Enum.TryParse<PlanOppgaveStatus>(e.Value?.ToString(), out var s) ? s : t.Status;
        t.Endret = DateTime.Now;
        t.EndretAv = BrukerNavn;
    });

    private Task LeggTilOppgave(ProsjektplanAktivitet a)
    {
        if (!_nyOppgave.TryGetValue(a.Id, out var tekst) || string.IsNullOrWhiteSpace(tekst))
        {
            return Task.CompletedTask;
        }

        _nyOppgave.Remove(a.Id);
        return Lagre(() =>
        {
            Db.ProsjektplanOppgaver.Add(new ProsjektplanOppgave
            {
                AktivitetId = a.Id,
                Tekst = tekst.Trim(),
                Rolle = a.Rolle,
                Rekkefolge = a.Oppgaver.Count == 0 ? 0 : a.Oppgaver.Max(x => x.Rekkefolge) + 1
            });
            return Task.CompletedTask;
        });
    }

    private Task SlettOppgave(int oppgaveId) => Lagre(async () =>
        Db.ProsjektplanOppgaver.Remove(await Db.ProsjektplanOppgaver.FirstAsync(x => x.Id == oppgaveId)));

    private Task SettRolle(string rolle, ChangeEventArgs e) => Lagre(async () =>
    {
        int? brukerId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        var r = await Db.ProsjektRoller.FirstOrDefaultAsync(x => x.ProsjektId == ProsjektId && x.Rolle == rolle);
        if (r is null)
        {
            Db.ProsjektRoller.Add(new ProsjektRolle { ProsjektId = ProsjektId, Rolle = rolle, BrukerId = brukerId });
        }
        else
        {
            r.BrukerId = brukerId;
        }
    });

    private RenderFragment PlanFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var p = _p!;
            var fr = f.Frister;
            var idag = DateTime.Today;
            var valgteRoller = _roller.Values.Count(v => v is not null);
        }
        @if (f.HarPlan && fr is not null)
        {
            var inn = FremdriftsplanBeregner.UkerMellom(fr.Start, idag) + 1;
            var igjen = FremdriftsplanBeregner.UkerMellom(idag, fr.Overlevering);
            <div class="pf-plan-linje">
                <p class="pf-svarlinje"><b>Uke @inn av @(FremdriftsplanBeregner.UkerMellom(fr.Start, fr.Overlevering) + 1)</b>, @(igjen >= 0 ? $"{igjen} uker til overlevering." : $"{-igjen} uker over fristen.")@(f.ForsinkedeAktiviteter > 0 ? " " : "")@if (f.ForsinkedeAktiviteter > 0) {<b class="pf-rod">@f.ForsinkedeAktiviteter @(f.ForsinkedeAktiviteter == 1 ? "aktivitet" : "aktiviteter")</b>@(" er forsinket.")}</p>
                <span class="pf-seg" role="group" aria-label="Visning">
                    <button type="button" class="@(_planVisning == "tabell" ? "aktiv" : "")" aria-pressed="@(_planVisning == "tabell" ? "true" : "false")" @onclick="@(() => _planVisning = "tabell")">Tabell</button>
                    <button type="button" class="@(_planVisning == "tid" ? "aktiv" : "")" aria-pressed="@(_planVisning == "tid" ? "true" : "false")" @onclick="@(() => _planVisning = "tid")">Tidslinje</button>
                </span>
            </div>
            @if (_planVisning == "tid")
            {
                @PlanTidslinje(fr)
            }
            else
            {
                @PlanTabell(fr)
            }
        }
        else if (!f.HarPlan)
        {
            <div class="pf-tomboks">
                <b>Ingen fremdriftsplan ennå</b>
                <p>Malen har fasene fra sjekklisten etter at kontrakten er signert: planlegging, gjennomføring og avslutning, med aktiviteter, oppgaver og roller. Datoer som mangler, fylles inn med forslag.</p>
                <span><button type="button" class="pf-knapp pf-knapp-p" @onclick="LagPlan">Lag fremdriftsplan fra malen</button></span>
            </div>
        }

        <div class="pf-foldrute">
            <details class="pf-info" open="@(fr is null)">
                <summary><Icon Name="calendar" />Datoer@(fr is not null ? $" · start {Dato(fr.Start)} · montasje {Dato(fr.Montasjestart)} · overlevering {Dato(fr.Overlevering)}" : "")</summary>
                <div class="pf-fold-inni">
                    <p class="pf-dempet">Fasene regnes fra de tre datoene. Flytt en dato, så flytter fasene og oppgavene seg. Godkjent fristforlengelse på endringene legges til overleveringen.</p>
                    <div class="pf-frister">
                        <label class="pf-felt">Prosjektstart (registrert)
                            <input type="date" class="pf-inn" value="@DatoVerdi(p.StartDato ?? fr?.Start)" @onchange="@(e => EndreProsjekt(x => x.StartDato = LesDato(e)))" />
                            <small>@(fr is not null ? $"uke {FremdriftsplanBeregner.Ukenr(fr.Start)}" : "")</small>
                        </label>
                        <label class="pf-felt">Montasjestart
                            <input type="date" class="pf-inn" value="@DatoVerdi(p.MontasjestartDato)" @onchange="@(e => EndreProsjekt(x => x.MontasjestartDato = LesDato(e)))" />
                            <small>@(fr is not null ? $"uke {FremdriftsplanBeregner.Ukenr(fr.Montasjestart)}" : "")</small>
                        </label>
                        <label class="pf-felt">Overleveringsfrist
                            <input type="date" class="pf-inn" value="@DatoVerdi(p.OverleveringsfristDato)" @onchange="@(e => EndreProsjekt(x => x.OverleveringsfristDato = LesDato(e)))" />
                            <small>@(fr is not null ? $"uke {FremdriftsplanBeregner.Ukenr(fr.Overlevering)}{(f.Fristforlengelse > 0 ? $" · +{f.Fristforlengelse} d fra endringer" : "")}" : "")</small>
                        </label>
                    </div>
                </div>
            </details>
            @if (f.HarPlan)
            {
                <details class="pf-info">
                    <summary><Icon Name="list" />Roller · @valgteRoller av @FremdriftsplanBeregner.Roller.Length er valgt</summary>
                    <div class="pf-fold-inni">
                        <p class="pf-dempet">Velg en person per rolle, så vises oppgavene for rollen hos personen.</p>
                        <div class="pf-roller">
                            @foreach (var r in FremdriftsplanBeregner.Roller)
                            {
                                var rolle = r;
                                var valgt = _roller.GetValueOrDefault(r);
                                <label class="pf-felt">@r
                                    <select class="pf-inn" @onchange="@(e => SettRolle(rolle, e))">
                                        <option value="" selected="@(valgt is null)">Ingen valgt</option>
                                        @foreach (var b in _brukere)
                                        {
                                            <option value="@b.Id" selected="@(valgt == b.Id)">@b.Navn</option>
                                        }
                                    </select>
                                </label>
                            }
                        </div>
                    </div>
                </details>
            }
        </div>
    </div>;

    // Status på en aktivitet: forsinket når perioden er over og noe gjenstår.
    private static (string Tekst, string Klasse) AktivitetStatus(DateTime fra, DateTime til, decimal andel)
    {
        var idag = DateTime.Today;
        return andel >= 1 ? ("Ferdig", "gronn") : til < idag ? ("Forsinket", "rod") : fra <= idag || andel > 0 ? ("Pågår", "bla") : ("Ikke startet", "");
    }

    private RenderFragment PlanTabell(FremdriftsplanBeregner.Frister fr) => @<div class="pf-liste-ramme">
        <table class="pf-liste pf-plan">
            <thead><tr><th>Aktivitet</th><th>Ansvarlig</th><th>Periode</th><th class="n">Oppgaver</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var fase in FremdriftsplanBeregner.Faser(fr))
                {
                    var akter = _aktiviteter.Where(a => Math.Clamp(a.Fase, 0, 2) == fase.Nr).ToList();
                    if (akter.Count == 0)
                    {
                        continue;
                    }

                    <tr class="pf-plan-fase"><td colspan="5"><b>@fase.Navn</b> <small>uke @FremdriftsplanBeregner.Ukenr(fase.Fra)–@FremdriftsplanBeregner.Ukenr(fase.Til)</small></td></tr>
                    @foreach (var x in akter)
                    {
                        var a = x;
                        var akt = a;
                        var (fra, til) = FremdriftsplanBeregner.AktivitetDatoer(fase, a.DelFra, a.DelTil);
                        var andel = FremdriftsplanBeregner.Andel(a.Oppgaver.Select(t => t.Status));
                        var (tekst, klasse) = AktivitetStatus(fra, til, andel);
                        var apen = _apne.Contains(a.Id);
                        <tr class="pf-plan-rad @(apen ? "apen" : "")" tabindex="0" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VekslAktivitet(akt.Id))" @onkeydown="@(e => { if (e.Key == "Enter") VekslAktivitet(akt.Id); })">
                            <td><Icon Name="@(apen ? "chevron-down" : "chevron-right")" /><b>@a.Navn</b></td>
                            <td>@(PersonFor(a.Rolle) is { Length: > 0 } n ? n : a.Rolle)</td>
                            <td>@Dato(fra)–@Dato(til)</td>
                            <td class="n">@a.Oppgaver.Count(t => t.Status.ErFerdig()) av @a.Oppgaver.Count</td>
                            <td><span class="pf-chip @(klasse.Length > 0 ? "pf-chip-" + klasse : "")">@tekst</span></td>
                        </tr>
                        @if (apen)
                        {
                            <tr class="pf-plan-apen">
                                <td colspan="5">
                                    <div class="pf-oppgaver">
                @foreach (var t in a.Oppgaver.OrderBy(x => x.Rekkefolge))
                {
                    var oppg = t;
                    <div class="pf-oppg @(t.Status.ErFerdig() ? "ferdig" : "")">
                        <select class="pf-status pf-status-@((int)t.Status)" aria-label="Status" value="@t.Status" @onchange="@(e => SettStatus(oppg.Id, e))">
                            @foreach (var s in Enum.GetValues<PlanOppgaveStatus>())
                            {
                                <option value="@s" selected="@(s == t.Status)">@s.Visningsnavn()</option>
                            }
                        </select>
                        <span class="pf-oppg-tekst">@t.Tekst</span>
                        <span class="pf-oppg-hvem">@(t.Rolle)@(PersonFor(t.Rolle) is { Length: > 0 } navn ? " · " + navn : "")</span>
                        <button type="button" class="pf-x" title="Fjern oppgaven" @onclick="@(() => SlettOppgave(oppg.Id))">×</button>
                    </div>
                }
                <div class="pf-oppg-ny">
                    <input class="pf-inn" placeholder="Ny oppgave i @a.Navn" value="@_nyOppgave.GetValueOrDefault(a.Id)" @oninput="@(e => _nyOppgave[akt.Id] = e.Value?.ToString() ?? "")" @onkeydown="@(e => e.Key == "Enter" ? LeggTilOppgave(akt) : Task.CompletedTask)" />
                    <button type="button" class="pf-knapp" @onclick="@(() => LeggTilOppgave(akt))">Legg til</button>
                </div>
            </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>;

    private void VekslAktivitet(int id)
    {
        if (!_apne.Remove(id))
        {
            _apne.Add(id);
        }
    }

    // Hele prosjektet på én skjerm: rødt er forsinket, blått pågår og grått kommer.
    private RenderFragment PlanTidslinje(FremdriftsplanBeregner.Frister fr) => @<div class="pf-tid">
        @{
            var dager = Math.Max(1, (fr.Overlevering - fr.Start).TotalDays + 1);
            double X(DateTime d) => (d - fr.Start).TotalDays / dager * 100;
            var maneder = new List<DateTime> { fr.Start };
            for (var m = new DateTime(fr.Start.Year, fr.Start.Month, 1).AddMonths(1); m <= fr.Overlevering; m = m.AddMonths(1))
            {
                maneder.Add(m);
            }
        }
        <div class="pf-tid-hode">
            <span>Aktivitet</span>
            <div class="pf-tid-akse">
                @foreach (var m in maneder)
                {
                    <i style="left:@Css(X(m))">@m.ToString("MMM", Kultur).TrimEnd('.')</i>
                }
            </div>
        </div>
        @foreach (var fase in FremdriftsplanBeregner.Faser(fr))
        {
            @foreach (var a in _aktiviteter.Where(a => Math.Clamp(a.Fase, 0, 2) == fase.Nr))
            {
                var (fra, til) = FremdriftsplanBeregner.AktivitetDatoer(fase, a.DelFra, a.DelTil);
                var andel = FremdriftsplanBeregner.Andel(a.Oppgaver.Select(t => t.Status));
                var (tekst, klasse) = AktivitetStatus(fra, til, andel);
                <div class="pf-tid-rad">
                    <span>@a.Navn<small>@(PersonFor(a.Rolle) is { Length: > 0 } n ? n : a.Rolle) · @a.Oppgaver.Count(t => t.Status.ErFerdig()) av @a.Oppgaver.Count</small></span>
                    <div class="pf-tid-spor">
                        @if (DateTime.Today >= fr.Start && DateTime.Today <= fr.Overlevering)
                        {
                            <em style="left:@Css(X(DateTime.Today))" title="I dag"></em>
                        }
                        <b class="pf-tid-bar @(klasse.Length > 0 ? "pf-tid-" + klasse : "")" style="left:@Css(X(fra));width:@Css(Math.Max(1.2, X(til.AddDays(1)) - X(fra)))" title="@Dato(fra)–@Dato(til) · @tekst"></b>
                    </div>
                </div>
            }
        }
    </div>;

    // ======================================================================
    // Budsjett og timer
    private Task SettJustering(BudsjettPost post, ChangeEventArgs e) => Lagre(async () =>
    {
        var belop = LesTall(e) ?? 0;
        var j = await Db.ProsjektBudsjettJusteringer.FirstOrDefaultAsync(x => x.ProsjektId == ProsjektId && x.Post == post);
        if (j is null)
        {
            Db.ProsjektBudsjettJusteringer.Add(new ProsjektBudsjettJustering { ProsjektId = ProsjektId, Post = post, Belop = belop });
        }
        else
        {
            j.Belop = belop;
        }
    });

    private RenderFragment BudsjettFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var o = f.O;
        }
        @if (o is null)
        {
            <div class="pf-tomboks"><b>Ingen budsjett ennå</b><p>Budsjettet låses når et tilbud på prosjektet settes til Godkjent.</p></div>
        }
        else
        {
            var jV = _justering.GetValueOrDefault(BudsjettPost.Varer);
            var jT = _justering.GetValueOrDefault(BudsjettPost.Timer);
            var jU = _justering.GetValueOrDefault(BudsjettPost.Uforutsett);
            var harAndre = o.SalgAndre > 0 || o.BudsjettAndre != 0 || o.FaktiskAndre != 0;
            var effSats = o.FaktiskTimer > 0 && o.FaktiskTimekost > 0 ? o.FaktiskTimekost / o.FaktiskTimer : o.Timesats;
            var timepris = o.BudsjettTimer > 0 ? o.SalgArbeid / o.BudsjettTimer : 0;
            var nullTimer = effSats > 0 ? o.SalgArbeid / effSats : 0;
            var paslag = o.BudsjettVarer > 0 && o.SalgVarer > 0 ? o.SalgVarer / o.BudsjettVarer - 1 : 0;
            var spist = new[] { (Navn: "Timene", Belop: o.OverTimer), (Navn: "Varene", Belop: o.OverVarer), (Navn: "Kjøring", Belop: o.OverAndre) }.Where(x => x.Belop >= 1).ToList();
            <p class="pf-svarlinje"><b class="@(f.FortjenesteIgjen < 0 ? "pf-rod" : "")">@Kr(f.FortjenesteIgjen)</b> av @Kr(f.TilbudtFortjeneste) i fortjeneste er igjen.@(spist.Count == 0 ? " Ingenting er brukt mer enn tilbudt." : "")@for (var i = 0; i < spist.Count; i++)
                {
                    @(i == 0 ? $" {spist[i].Navn} har tatt " : $"{(i == spist.Count - 1 ? " og " : ", ")}{spist[i].Navn.ToLowerInvariant()} ")<b class="pf-rod">@Kr(spist[i].Belop)</b>
                }@(spist.Count > 0 ? "." : "")</p>
            @if (o.ManglerTimesats)
            {
                <p class="pf-dempet pf-rod">Timer regnes ikke som kostnad ennå: sett intern timekost under <a href="/prosjektokonomi/innstillinger">Innstillinger → Timekost</a>, eller montasje-innpris i tilbudet.</p>
            }
            <div class="pf-liste-ramme">
                <table class="pf-liste">
                    <thead><tr><th>Post</th><th class="n">Kunden betaler</th><th class="n">Kost i tilbud</th><th class="n">Brukt</th><th class="n">Igjen / over</th><th>Status</th></tr></thead>
                    <tbody>
                        @BudsjettRad("Arbeid", $"{o.FaktiskTimer.ToString("0.#", Kultur)} t brukt av {o.BudsjettTimer.ToString("0.#", Kultur)} t", o.SalgArbeid, o.BudsjettTimekost, jT, o.FaktiskTimekost)
                        @BudsjettRad("Varer", o.VarerFraLager ? "Faktisk forbruk fra lageret" : o.VarerManuell ? "Faktisk varekost lagt inn for hånd" : "Ingen uttak registrert, anslått etter fremdriften", o.SalgVarer, o.BudsjettVarer, jV, o.FaktiskVarer)
                        @if (harAndre)
                        {
                            @BudsjettRad("Kjøring og tillegg", o.AndreRegistrert ? "Ført på arbeidsordrene" : "Fra kodelinjene i tilbudet, anslått etter fremdriften", o.SalgAndre, o.BudsjettAndre, 0, o.FaktiskAndre)
                        }
                        @if (jU != 0)
                        {
                            @BudsjettRad("Uforutsett", "Reserve til det uforutsette", 0, 0, jU, 0)
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Sum</td>
                            <td class="n">@Kr(o.Inntekt)</td>
                            <td class="n">@Kr(o.JustertKost)</td>
                            <td class="n">@Kr(o.FaktiskKost)</td>
                            <td class="n">@(o.FaktiskKost > o.JustertKost ? $"{Kr(o.FaktiskKost - o.JustertKost)} over" : $"{Kr(o.JustertKost - o.FaktiskKost)} igjen")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="pf-foldrute">
                <details class="pf-info">
                    <summary><Icon Name="list" />Hvor ble fortjenesten av?</summary>
                    <div class="pf-fold-inni">
                    <div class="pf-sumboks">
                        <div><span>Fortjeneste i tilbudet</span><b>@Kr(f.TilbudtFortjeneste)</b></div>
                        <div><span>Dekningsgrad i tilbudet</span><b>@DG(o.BudsjettDekningsgrad)</b></div>
                        <div><span>Brukt mer enn tilbudt</span><b class="@(f.BruktOver > 0 ? "pf-rod" : "")">@(f.BruktOver > 0 ? "−" + Kr(f.BruktOver) : "0 kr")</b></div>
                        <div class="pf-sum"><span>Fortjeneste igjen</span><span class="@(f.FortjenesteIgjen < 0 ? "pf-rod" : f.FortjenesteNiva == ProsjektOppfolgingService.Niva.Gronn ? "pf-gronn" : "")">@Kr(f.FortjenesteIgjen)</span></div>
                        <div><span>Fortjeneste per time i tilbudet</span><b>@(o.BudsjettTimer > 0 ? Kr(f.TilbudtFortjeneste / o.BudsjettTimer) : "–")</b></div>
                    </div>
                        @Bro(f, o, jV + jT + jU)
                    </div>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="edit" />Juster budsjett · @Kr(o.Justering)</summary>
                    <div class="pf-fold-inni">
                        <p class="pf-dempet">Kost i tilbudet er låst fra godkjente tilbud og endringer. Her justerer du rammen underveis, og Uforutsett er reserven til det uforutsette.</p>
                        <div class="pf-liste-ramme">
                            <table class="pf-liste">
                                <thead><tr><th>Post</th><th class="n">Justering (kr)</th></tr></thead>
                                <tbody>
                                    @foreach (var (navn, post, belop) in new[] { ("Arbeid", BudsjettPost.Timer, jT), ("Varer", BudsjettPost.Varer, jV), ("Uforutsett", BudsjettPost.Uforutsett, jU) })
                                    {
                                        <tr>
                                            <td>@navn</td>
                                            <td class="n"><input class="pf-inn pf-tal" inputmode="decimal" value="@(belop != 0 ? belop.ToString("0", CultureInfo.InvariantCulture) : "")" placeholder="0" @onchange="@(e => SettJustering(post, e))" aria-label="Justering @navn" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="file-text" />Inntekt · prosjektsum @Kr(f.Prosjektsum)</summary>
                    <div class="pf-fold-inni">
                    <div class="pf-sumboks">
                        <div><span>Kontraktsum eks. mva</span><b>@Kr(f.Kontrakt)</b></div>
                        <div><span>Godkjente endringer</span><b>@Kr(f.Endringer)</b></div>
                        <div><span>Indeksregulering</span><input class="pf-inn pf-tal" inputmode="decimal" value="@(_p!.Indeksregulering?.ToString("0", CultureInfo.InvariantCulture))" placeholder="0" @onchange="@(e => EndreProsjekt(x => x.Indeksregulering = LesTall(e)))" aria-label="Indeksregulering" /></div>
                        <div class="pf-sum"><span>Prosjektsum</span><span>@Kr(f.Prosjektsum)</span></div>
                    </div>
                    </div>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="clock" />Arbeid · @o.FaktiskTimer.ToString("0.#", Kultur) t av @o.BudsjettTimer.ToString("0.#", Kultur) t</summary>
                    <div class="pf-fold-inni">
                    @if (timepris > 0 && effSats > 0)
                    {
                        <p class="pf-merknad">Kunden betaler <b>@Kr(timepris)</b> per time, og en time koster <b>@Kr(effSats)</b>. Hver time i tilbudet gir @Kr(timepris - effSats) i fortjeneste.</p>
                    }
                    <div class="pf-timer">
                        <div><span>I tilbudet</span><b>@o.BudsjettTimer.ToString("0.#", Kultur) t</b></div>
                        <div><span>Medgått</span><b>@o.FaktiskTimer.ToString("0.#", Kultur) t</b>@if (o.FaktiskTimerVenter > 0) {<small>@o.FaktiskTimerVenter.ToString("0.#", Kultur) t venter på godkjenning</small>}</div>
                        <div class="@(o.FaktiskTimer > o.BudsjettTimer ? "pf-tall-gul" : "")"><span>@(o.FaktiskTimer > o.BudsjettTimer ? "Over tilbudet" : "Igjen av tilbudet")</span><b>@Math.Abs(o.BudsjettTimer - o.FaktiskTimer).ToString("0.#", Kultur) t</b></div>
                        @if (nullTimer > 0)
                        {
                            <div><span>Nullpunkt <span class="pf-hjelp" tabindex="0" title="Antall timer dere kan bruke før arbeidet går i null: det kunden betaler for arbeidet delt på timekosten.">?</span></span><b>@nullTimer.ToString("0.#", Kultur) t</b><small>@(o.FaktiskTimer <= nullTimer ? $"{(nullTimer - o.FaktiskTimer).ToString("0.#", Kultur)} t igjen før null" : "passert")</small></div>
                        }
                    </div>
                    @if (nullTimer > 0)
                    {
                        <p class="pf-statuslinje pf-statuslinje-@(o.FaktiskTimer <= o.BudsjettTimer ? "gronn" : o.FaktiskTimer <= nullTimer ? "gul" : "rod")">
                            @(o.FaktiskTimer <= o.BudsjettTimer ? "Innenfor timene i tilbudet." : o.FaktiskTimer <= nullTimer ? "Over timene i tilbudet, men arbeidet tjener fortsatt." : $"Arbeidet går med {Kr((o.FaktiskTimer - nullTimer) * effSats)} i tap.")
                        </p>
                    }
                    @if (_timerPerAktivitet.Count > 0)
                    {
                        <div class="pf-aktiviteter">
                            @foreach (var (akt, t) in _timerPerAktivitet)
                            {
                                <span class="pf-chip">@akt.Visningsnavn() @t.ToString("0.#", Kultur) t</span>
                            }
                        </div>
                    }
                    <p class="pf-dempet">Timekosten kommer fra <a href="/prosjektokonomi/innstillinger">Innstillinger → Timekost</a>: årslønn × sosiale kostnader + overhead, delt på fakturerbare timer, per ansatt.</p>
                    </div>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="box" />Varer · @Kr(o.FaktiskVarer) av @Kr(o.RammeVarer)</summary>
                    <div class="pf-fold-inni">
                    @if (paslag > 0)
                    {
                        <p class="pf-merknad">Kjøpt inn for <b>@Kr(o.BudsjettVarer)</b>, solgt for <b>@Kr(o.SalgVarer)</b> i tilbudet. Påslaget er <b>@DG(paslag)</b>.</p>
                    }
                    <div class="pf-sumboks">
                        <div><span>Fortjeneste på varer i tilbudet</span><b>@Kr(o.SalgVarer - o.BudsjettVarer)</b></div>
                        <div><span>Brukt så langt (innkjøpspris)</span><b>@Kr(o.FaktiskVarer)</b></div>
                        @if (paslag > 0)
                        {
                            <div><span>Opptjent på brukte varer</span><b class="pf-gronn">@Kr(Math.Min(o.FaktiskVarer, o.RammeVarer) * paslag)</b></div>
                        }
                    </div>
                    <p class="pf-statuslinje pf-statuslinje-@(o.FaktiskVarer <= o.RammeVarer ? "gronn" : "gul")">
                        @(o.FaktiskVarer <= o.RammeVarer ? "Varene er innenfor tilbudet." : $"{Kr(o.FaktiskVarer - o.RammeVarer)} mer varer enn tilbudt. Bør faktureres som endringsmelding.")
                    </p>
                    @if (o.VarerAnslatt)
                    {
                        <p class="pf-dempet">Ingen varer er tatt ut fra lageret på prosjektet ennå, så brukt er anslått som tilbudets varer × utført. Ta ut varene på prosjektet i Lager, eller legg inn faktisk varekost ved overlevering.</p>
                    }
                    </div>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="help-circle" />Slik regnes tallene</summary>
                    <ul>
                        <li><b>Kunden betaler</b> og <b>kost i tilbudet</b> er summen av alle godkjente tilbud og endringsmeldinger på prosjektet, låst da de ble godkjent.</li>
                        <li><b>Brukt</b> er faktiske tall: godkjente og førte timer × timekost, varer tatt ut fra lageret på prosjektet eller lagt på arbeidsordrene, og kjøring ført på arbeidsordrene. Står det «anslått», er ingenting registrert ennå.</li>
                        <li><b>Fortjeneste igjen</b> er fortjenesten i tilbudet minus det som allerede er brukt mer enn tilbudt. Portalen gjetter ikke på hva resten vil koste.</li>
                        <li><b>Utført</b> er ferdig monterte dører av alle dører (ellers ferdige arbeidsordre). Utført og ikke fakturert er utført andel av prosjektsummen minus det som er fakturert.</li>
                    </ul>
                </details>

                <details class="pf-info">
                    <summary><Icon Name="list" />Per arbeidsordre og grunnlag</summary>
                    <ProsjektOkonomiPanel ProsjektId="@ProsjektId" Data="@o" Etterkalkyle="true" UtenNokkeltall="true" />
                </details>
            </div>
        }
    </div>;

    // Regnestykket: tilbudt fortjeneste, pluss og minus underveis, og det som er igjen.
    private RenderFragment Bro(ProsjektOppfolgingService.Oppfolging f, ProsjektOkonomiService.Okonomi o, decimal justeringer) => @<div class="pf-liste-ramme">
        @{
            var steg = new List<(string Navn, decimal Verdi, string Merknad)>();
            if (f.Indeks != 0) steg.Add(("Indeksregulering", f.Indeks, "Ekstra inntekt"));
            if (justeringer != 0) steg.Add(("Justeringer", -justeringer, "Lagt inn underveis"));
            steg.Add(("Timer", -o.OverTimer, o.OverTimer > 0 ? "Over tilbudet" : "Innenfor tilbudet"));
            steg.Add(("Varer", -o.OverVarer, o.OverVarer > 0 ? "Over tilbudet" : "Innenfor tilbudet"));
            if (o.SalgAndre > 0 || o.BudsjettAndre != 0 || o.FaktiskAndre != 0) steg.Add(("Kjøring og tillegg", -o.OverAndre, o.OverAndre > 0 ? "Over tilbudet" : "Innenfor tilbudet"));
            var igjen = f.TilbudtFortjeneste + steg.Sum(x => x.Verdi);
        }
        <table class="pf-liste">
            <thead><tr><th>Post</th><th>Hvorfor</th><th class="n">Beløp</th></tr></thead>
            <tbody>
                <tr><td><b>Fortjeneste i tilbudet</b></td><td></td><td class="n">@Kr(f.TilbudtFortjeneste)</td></tr>
                @foreach (var (navn, verdi, merknad) in steg)
                {
                    <tr><td>@navn</td><td>@merknad</td><td class="n @(verdi < 0 ? "pf-rod" : "")">@(verdi > 0 ? "+" : verdi < 0 ? "−" : "")@Kr(Math.Abs(verdi))</td></tr>
                }
            </tbody>
            <tfoot><tr><td>Fortjeneste igjen</td><td></td><td class="n @(igjen < 0 ? "pf-rod" : "")">@Kr(igjen)</td></tr></tfoot>
        </table>
    </div>;

    private RenderFragment BudsjettRad(string navn, string merknad, decimal salg, decimal kontrakt, decimal justering, decimal brukt) => @<tr>
        @{
            var ramme = kontrakt + justering;
            var over = brukt - ramme;
        }
        <td><b>@navn</b><small>@merknad@(justering != 0 ? " · justert" : "")</small></td>
        <td class="n @(salg != 0 ? "" : "pf-mut")">@(salg != 0 ? Kr(salg) : "–")</td>
        <td class="n">@Kr(ramme)</td>
        <td class="n">@Kr(brukt)</td>
        <td class="n"><b class="@(over >= 1 ? "pf-rod" : over <= -1 ? "pf-gronn" : "")">@(Math.Abs(over) < 1 ? "0 kr" : over > 0 ? $"{Kr(over)} over" : $"{Kr(-over)} igjen")</b></td>
        <td><span class="pf-chip @(over >= 1 ? "pf-chip-rod" : "pf-chip-gronn")">@(over >= 1 ? "Over tilbudet" : "Innenfor")</span></td>
    </tr>;

    // ======================================================================
    // Endringer
    private Task EndreTilbud(int tilbudId, Action<Tilbud> endring) => Lagre(async () =>
        endring(await Db.Tilbud.FirstAsync(t => t.Id == tilbudId)));

    private static (string Tekst, string Klasse) EndringStatus(ProsjektOppfolgingService.Endring e) => e.Tilbud.Status switch
    {
        EndringsmeldingStatus.Godkjent => ("Godkjent", "gronn"),
        EndringsmeldingStatus.Avslatt => ("Avslått", "rod"),
        EndringsmeldingStatus.SendtTilKunde => (e.DagerVentet > 0 ? $"Venter, {e.DagerVentet} dager" : "Sendt til kunde", e.DagerVentet >= 7 ? "gul" : "bla"),
        _ => ("Utkast", "")
    };

    // Samme tall som sammendraget nederst i tilbudet, summert for prosjektet.
    // Montering er arbeid pluss kjøring og tillegg, som i tilbudet.
    private RenderFragment Sammendrag(ProsjektOkonomiService.Okonomi o) => @<div class="pf-liste-ramme">
        @{
            var mKost = o.BudsjettTimekost + o.BudsjettAndre;
            var mSalg = o.SalgArbeid + o.SalgAndre;
            var kost = o.BudsjettVarer + mKost;
        }
        <table class="pf-liste">
            <thead><tr><th>Slik er tilbudet satt sammen</th><th class="n">Varer</th><th class="n">Montering · @o.BudsjettTimer.ToString("0.#", Kultur) t</th><th class="n">Totalt</th></tr></thead>
            <tbody>
                <tr><td>Kost</td><td class="n">@Kr(o.BudsjettVarer)</td><td class="n">@Kr(mKost)</td><td class="n">@Kr(kost)</td></tr>
                <tr><td>Utpris eks. mva</td><td class="n">@Kr(o.SalgVarer)</td><td class="n">@Kr(mSalg)</td><td class="n">@Kr(o.Inntekt)</td></tr>
                <tr><td>Utpris inkl. mva</td><td class="n pf-mut">–</td><td class="n pf-mut">–</td><td class="n">@Kr(o.Inntekt * 1.25m)</td></tr>
                <tr><td>Dekningsgrad</td><td class="n">@DG(o.SalgVarer > 0 ? (o.SalgVarer - o.BudsjettVarer) / o.SalgVarer : null)</td><td class="n">@DG(mSalg > 0 ? (mSalg - mKost) / mSalg : null)</td><td class="n">@DG(o.BudsjettDekningsgrad)</td></tr>
            </tbody>
            <tfoot><tr><td>Fortjeneste</td><td class="n">@Kr(o.SalgVarer - o.BudsjettVarer)</td><td class="n">@Kr(mSalg - mKost)</td><td class="n">@Kr(o.Inntekt - kost)</td></tr></tfoot>
        </table>
    </div>;

    // Tilbud og endringsmeldinger lages inne på prosjektet og havner her.
    private RenderFragment EndringerFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var o = f.O;
            var tilbud = o?.Tilbud.Where(t => !t.ErEndring).ToList() ?? [];
            var venter = f.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.SendtTilKunde).Sum(e => e.Belop);
        }
        @if (tilbud.Count == 0 && f.Endringsmeldinger.Count == 0)
        {
            <div class="pf-tomboks"><b>Ingen tilbud ennå</b><p>Tilbud og endringsmeldinger lages inne på prosjektet, og havner her med beløp og status.</p></div>
        }
        else
        {
            <p class="pf-svarlinje"><b>@Kr(o?.Inntekt ?? 0)</b> er godkjent på prosjektet.@(venter != 0 ? " " : "")@if (venter != 0) {<b class="pf-gul">@Kr(venter)</b>@(" venter på svar.")}</p>
            <div class="pf-liste-ramme">
                <table class="pf-liste">
                    <thead><tr><th>Tilbud og endringer</th><th>Status</th><th class="n">Kunden betaler</th><th class="n">Fortjeneste</th></tr></thead>
                    <tbody>
                        @foreach (var t in tilbud)
                        {
                            <tr>
                                <td><a class="pf-rad-lenke" href="@($"/tilbud/{t.Id}")">@t.Tittel</a><small>Tilbud · låst @t.Laast.ToString("dd.MM.yyyy")</small></td>
                                <td><span class="pf-chip pf-chip-gronn">Godkjent</span></td>
                                <td class="n">@Kr(t.Salgssum)</td>
                                <td class="n @(t.Salgssum - t.Kost < 0 ? "pf-rod" : "")">@Kr(t.Salgssum - t.Kost)<small>DG @DG(t.Salgssum > 0 ? (t.Salgssum - t.Kost) / t.Salgssum : null)</small></td>
                            </tr>
                        }
                        @foreach (var e in f.Endringsmeldinger)
                        {
                            var t = e.Tilbud;
                            var (tekst, klasse) = EndringStatus(e);
                            var godkjent = o?.Tilbud.FirstOrDefault(x => x.Id == t.Id);
                            <tr>
                                <td><a class="pf-rad-lenke" href="@($"/tilbud/{t.Id}")">E@(e.Nr) @t.Tittel</a><small>Endringsmelding@(t.SendtDato is { } s ? $" · sendt {Dato(s)}" : "")@(string.IsNullOrWhiteSpace(t.BerorteFag) ? "" : $" · {t.BerorteFag}")@(t.FristforlengelseDager is > 0 ? $" · frist + {t.FristforlengelseDager} dager" : "")</small></td>
                                <td><span class="pf-chip @(klasse.Length > 0 ? "pf-chip-" + klasse : "")">@tekst</span></td>
                                <td class="n">@Kr(e.Belop)</td>
                                @if (godkjent is not null)
                                {
                                    <td class="n @(godkjent.Salgssum - godkjent.Kost < 0 ? "pf-rod" : "")">@Kr(godkjent.Salgssum - godkjent.Kost)<small>DG @DG(godkjent.Salgssum > 0 ? (godkjent.Salgssum - godkjent.Kost) / godkjent.Salgssum : null)</small></td>
                                }
                                else
                                {
                                    <td class="n pf-mut">–</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><td>Godkjent</td><td></td><td class="n">@Kr(o?.Inntekt ?? 0)</td><td class="n">@Kr(o?.TilbudtFortjeneste ?? 0)</td></tr></tfoot>
                </table>
            </div>

            <div class="pf-foldrute">
                @if (o is { Tilbud.Count: > 0 })
                {
                    var visAndre = o.Tilbud.Any(t => t.SalgAndre != 0 || t.AndreKost != 0);
                    <details class="pf-info">
                        <summary><Icon Name="list" />Slik er tilbudet satt sammen · fortjeneste @Kr(o.TilbudtFortjeneste)</summary>
                        <div class="pf-fold-inni">
                            @Sammendrag(o)
                            <div class="pf-liste-ramme">
                                <table class="pf-liste">
                                    <thead><tr><th>Per tilbud</th><th class="n">Varer</th><th class="n">Arbeid</th>@if (visAndre) {<th class="n">Kjøring og tillegg</th>}<th class="n">Kunden betaler</th></tr></thead>
                                    <tbody>
                                        @foreach (var t in o.Tilbud)
                                        {
                                            <tr>
                                                <td>@t.Tittel</td>
                                                <td class="n">@Kr(t.SalgVarer)<small>kost @Kr(t.Varekost)</small></td>
                                                <td class="n">@Kr(t.SalgArbeid)<small>@t.Timer.ToString("0.#", Kultur) t · kost @Kr(t.Timekost)</small></td>
                                                @if (visAndre)
                                                {
                                                    <td class="n">@Kr(t.SalgAndre)<small>kost @Kr(t.AndreKost)</small></td>
                                                }
                                                <td class="n">@Kr(t.Salgssum)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                }
                @if (f.Endringsmeldinger.Count > 0)
                {
                    <details class="pf-info">
                        <summary><Icon Name="calendar" />Frist og berørte fag · @f.Endringsmeldinger.Count @(f.Endringsmeldinger.Count == 1 ? "endringsmelding" : "endringsmeldinger")</summary>
                        <div class="pf-fold-inni">
                            <p class="pf-dempet">Fristforlengelse flytter overleveringsfristen i fremdriftsplanen.</p>
                            <div class="pf-liste-ramme">
                                <table class="pf-liste">
                                    <thead><tr><th>Endringsmelding</th><th class="n">Frist + dager</th><th>Berørte fag</th></tr></thead>
                                    <tbody>
                                        @foreach (var e in f.Endringsmeldinger)
                                        {
                                            var t = e.Tilbud;
                                            <tr>
                                                <td><b>E@(e.Nr)</b> @t.Tittel</td>
                                                <td class="n"><input class="pf-inn pf-tal pf-smal" inputmode="numeric" value="@t.FristforlengelseDager" placeholder="0" @onchange="@(ev => EndreTilbud(t.Id, x => x.FristforlengelseDager = LesTall(ev) is { } d && d > 0 ? (int)d : null))" aria-label="Fristforlengelse i dager" /></td>
                                                <td><input class="pf-inn" value="@t.BerorteFag" placeholder="F.eks. elektro" @onchange="@(ev => EndreTilbud(t.Id, x => x.BerorteFag = LesTekst(ev)))" aria-label="Berørte fag" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot><tr><td>Sum godkjent</td><td class="n">@(f.Fristforlengelse > 0 ? $"{f.Fristforlengelse} dager" : "–")</td><td></td></tr></tfoot>
                                </table>
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
    </div>;

    // ======================================================================
    // Fakturering
    private int? _bekreftSend;
    private bool _sender;

    private Task ForeslaPlan() => Lagre(() => OppfolgingSvc.ForeslaAkontoplanAsync(ProsjektId), "Faktureringsplanen er lagt inn. Juster milepæler og prosent ved behov.");

    private Task NyAkonto() => Lagre(async () =>
    {
        var nr = (await Db.ProsjektAkontoer.Where(a => a.ProsjektId == ProsjektId).MaxAsync(a => (int?)a.Nr) ?? 0) + 1;
        Db.ProsjektAkontoer.Add(new ProsjektAkonto { ProsjektId = ProsjektId, Nr = nr, Milepael = $"Akonto {nr}", Prosent = 10, InnestaaendeProsent = _f?.Akontoer.LastOrDefault()?.Akonto.InnestaaendeProsent });
    });

    private Task EndreAkonto(int id, Action<ProsjektAkonto> endring) => Lagre(async () =>
        endring(await Db.ProsjektAkontoer.FirstAsync(a => a.Id == id)));

    private Task SlettAkonto(int id) => Lagre(async () =>
    {
        var a = await Db.ProsjektAkontoer.FirstAsync(x => x.Id == id);
        if (a.Status == AkontoStatus.Planlagt)
        {
            Db.ProsjektAkontoer.Remove(a);
        }
    });

    private Task MarkerFakturert(ProsjektOppfolgingService.AkontoRad r) => EndreAkonto(r.Akonto.Id, a =>
    {
        a.Status = AkontoStatus.Sendt;
        a.SendtDato = DateTime.Now;
        a.SendtBelop = r.Netto;
        a.SendtInnestaaende = r.Innestaaende > 0 ? r.Innestaaende : null;
    });

    // Velger om akontoen er prosent av kontrakten eller et fast beløp.
    private Task SettAkontoType(ProsjektOppfolgingService.AkontoRad r, ChangeEventArgs e) => EndreAkonto(r.Akonto.Id, x =>
    {
        if (e.Value?.ToString() == "kr")
        {
            x.Belop = r.Belop;
            x.Prosent = null;
        }
        else
        {
            x.Prosent = _f is { Kontrakt: > 0 } f ? Math.Round(r.Belop / f.Kontrakt * 100, 2) : 0;
            x.Belop = null;
        }
    });

    // Samme innestående på alle akontoene som ikke er fakturert ennå.
    private Task SettInnestaaendeAlle(ChangeEventArgs e) => Lagre(async () =>
    {
        var prosent = LesProsent(e);
        foreach (var a in await Db.ProsjektAkontoer.Where(a => a.ProsjektId == ProsjektId && a.Status == AkontoStatus.Planlagt).ToListAsync())
        {
            a.InnestaaendeProsent = prosent;
        }
    });

    private static decimal? LesProsent(ChangeEventArgs e) => LesTall(e) is { } v && v > 0 ? Math.Min(v, 100) : null;

    private Task SendTilTripletex(ProsjektOppfolgingService.AkontoRad r) => Kjor(async () =>
    {
        _sender = true;
        try
        {
            var (ok, feil) = await TripletexSync.PushAkontoTilTripletexAsync(r.Akonto.Id, r.Netto, r.Innestaaende);
            _melding = ok ? $"Akonto {r.Akonto.Nr} på {Kr(r.Netto)} er sendt til Tripletex som ordre. Fakturer den der." : $"Tripletex: {feil}";
            _meldingFeil = !ok;
        }
        finally
        {
            _sender = false;
            _bekreftSend = null;
        }

        await LastAsync();
    });

    private RenderFragment FakturaFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var p = _p!;
            var harTripletex = Tripletex.ErKonfigurert;
            var klare = f.Akontoer.Count(a => a.Klar);
            var plan = f.Akontoer.Where(a => a.Akonto.Status == AkontoStatus.Planlagt).Select(a => a.Akonto.InnestaaendeProsent).Distinct().ToList();
        }
        <p class="pf-svarlinje"><b class="@(f.UtfortIkkeFakturert > 0 ? "pf-gul" : "")">@Kr(f.UtfortIkkeFakturert)</b> er utført og ikke fakturert.@(klare == 0 ? "" : klare == 1 ? " 1 akonto er klar til å faktureres." : $" {klare} akontoer er klare til å faktureres.")@(f.HoldtTilbake > 0 ? $" {Kr(f.HoldtTilbake)} er holdt tilbake som innestående." : "")</p>
        @if (f.Akontoer.Count == 0 && f.Kontrakt <= 0)
        {
            <div class="pf-tomboks">
                <b>Ingen kontraktsum ennå</b>
                <p>Faktureringsplanen regnes ut fra kontraktsummen, som kommer fra det godkjente tilbudet. Sett tilbudet på prosjektet til Godkjent, så kan du lage planen her.</p>
                <span><button type="button" class="pf-knapp" @onclick="@(() => GaTil("tilbud"))">Gå til tilbudene på prosjektet</button></span>
            </div>
        }
        else if (f.Akontoer.Count == 0)
        {
            <div class="pf-tomboks">
                <b>Ingen faktureringsplan</b>
                <p>Lag planen én gang ved kontrakt. Forslaget er 20, 30, 25 og 15 % av kontraktsummen, og resten i sluttoppgjøret. Alt kan endres. Hver akonto blir «klar» når fremdriften når milepælen eller datoen.</p>
                <span><button type="button" class="pf-knapp pf-knapp-p" @onclick="ForeslaPlan">Foreslå plan</button> <button type="button" class="pf-knapp" @onclick="NyAkonto">Legg til én akonto</button></span>
            </div>
        }
        else
        {
            <div class="pf-liste-ramme">
                <table class="pf-liste pf-akontoer">
                    <thead><tr><th>Akonto</th><th class="n">Beløp</th><th class="n">Innestående</th><th class="n">Til faktura</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in f.Akontoer)
                        {
                            var rad = r;
                            var a = r.Akonto;
                            <tr>
                                <td><b>@a.Nr</b> @a.Milepael<small>@(a.Prosent is { } pst ? $"{pst.ToString("0.##", Kultur)} % av kontrakt" : "Fast beløp")@(a.FremdriftProsent is { } fp ? $" · klar ved {fp} % utført" : "")@(a.PlanlagtDato is { } pd ? $" · {Dato(pd)}" : "")</small></td>
                                <td class="n">@Kr(r.Belop)</td>
                                <td class="n @(r.Innestaaende > 0 ? "" : "pf-mut")">@(r.Innestaaende > 0 ? Kr(r.Innestaaende) : "–")@if (a.InnestaaendeProsent is { } ip && r.Innestaaende > 0) {<small>@ip.ToString("0.##", Kultur) %</small>}</td>
                                <td class="n"><b>@Kr(r.Netto)</b></td>
                                <td>
                                    @switch (a.Status)
                                    {
                                        case AkontoStatus.Betalt:
                                            <span class="pf-chip pf-chip-gronn">Betalt @(a.BetaltDato is { } bd ? Dato(bd) : "")</span>
                                            break;
                                        case AkontoStatus.Sendt:
                                            <span class="pf-chip pf-chip-bla">@(a.TripletexOrdreNummer is { } nr ? $"Ordre {nr}" : "Fakturert") @(a.SendtDato is { } sd ? Dato(sd) : "")</span>
                                            break;
                                        default:
                                            <span class="pf-chip @(r.Klar ? "pf-chip-gul" : "")">@(r.Klar ? "Klar" : "Planlagt")</span>
                                            break;
                                    }
                                </td>
                                <td class="n">
                                    @if (a.Status == AkontoStatus.Sendt)
                                    {
                                        <button type="button" class="pf-lenke" @onclick="@(() => EndreAkonto(a.Id, x => { x.Status = AkontoStatus.Betalt; x.BetaltDato = DateTime.Today; }))">Marker betalt</button>
                                    }
                                    else if (a.Status == AkontoStatus.Planlagt && _bekreftSend == a.Id)
                                    {
                                        <span class="pf-bekreft">Send @Kr(r.Netto) til Tripletex?
                                            <button type="button" class="pf-knapp pf-knapp-ok" disabled="@_sender" @onclick="@(() => SendTilTripletex(rad))">@(_sender ? "Sender …" : "Ja, send")</button>
                                            <button type="button" class="pf-lenke" @onclick="@(() => _bekreftSend = null)">Avbryt</button>
                                        </span>
                                    }
                                    else if (a.Status == AkontoStatus.Planlagt && r.Klar)
                                    {
                                        <span class="pf-akonto-valg">
                                            @if (harTripletex && r.Netto > 0)
                                            {
                                                <button type="button" class="pf-knapp @(r.Akonto.Id == f.KlarAkonto?.Akonto.Id ? "pf-knapp-p" : "")" @onclick="@(() => _bekreftSend = a.Id)">Send til Tripletex</button>
                                            }
                                            <button type="button" class="pf-lenke" @onclick="@(() => MarkerFakturert(rad))">Marker fakturert</button>
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(a.TripletexFeil))
                                    {
                                        <small class="pf-rod">@a.TripletexFeil</small>
                                    }
                                </td>
                            </tr>
                        }
                        <tr>
                            <td>Sluttoppgjør<small>Resten av prosjektsummen@(f.Innestaaende > 0 ? " og innestående" : "")@(f.Frister is { } fr ? $" · {Dato(fr.Overlevering)}" : "")</small></td>
                            <td class="n">@Kr(f.Prosjektsum - f.Akontoer.Sum(a => a.Belop))</td>
                            <td class="n @(f.Innestaaende > 0 ? "" : "pf-mut")">@(f.Innestaaende > 0 ? "+" + Kr(f.Innestaaende) : "–")</td>
                            <td class="n"><b>@Kr(f.Sluttoppgjor)</b></td>
                            <td><span class="pf-chip">Planlagt</span></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot><tr><td>Sum</td><td class="n">@Kr(f.Prosjektsum)</td><td></td><td class="n">@Kr(f.Akontoer.Sum(a => a.Netto) + f.Sluttoppgjor)</td><td></td><td></td></tr></tfoot>
                </table>
            </div>
            @if (!harTripletex)
            {
                <p class="pf-dempet">Tripletex er ikke koblet til. Fakturer akontoen der du pleier, og trykk «Marker fakturert».</p>
            }
        }

        <div class="pf-foldrute">
            @if (f.Akontoer.Count > 0)
            {
                <details class="pf-info">
                    <summary><Icon Name="edit" />Endre planen · @f.Akontoer.Count @(f.Akontoer.Count == 1 ? "akonto" : "akontoer")</summary>
                    <div class="pf-fold-inni">
                        <div class="pf-plan-valg">
                            <label class="pf-akonto-alle">Innestående på alle
                                <input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(plan.Count == 1 ? plan[0]?.ToString("0.##", CultureInfo.InvariantCulture) : "")" placeholder="0" @onchange="SettInnestaaendeAlle" aria-label="Innestående på alle akontoer i prosent" /> %
                            </label>
                            <button type="button" class="pf-knapp" @onclick="NyAkonto">+ Akonto</button>
                        </div>
                        <div class="pf-liste-ramme">
                            <table class="pf-liste">
                                <thead><tr><th>Nr</th><th>Milepæl</th><th>Beløp som</th><th class="n">Verdi</th><th class="n">Innestående %</th><th class="n">Klar ved utført %</th><th>Eller dato</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var r in f.Akontoer)
                                    {
                                        var rad = r;
                                        var a = r.Akonto;
                                        var laast = a.Status != AkontoStatus.Planlagt;
                                        <tr>
                                            <td><b>@a.Nr</b></td>
                                            <td><input class="pf-inn" value="@a.Milepael" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Milepael = LesTekst(e) ?? x.Milepael))" aria-label="Milepæl" /></td>
                                            <td>
                                                <select class="pf-inn" disabled="@laast" @onchange="@(e => SettAkontoType(rad, e))" aria-label="Prosent eller beløp">
                                                    <option value="pst" selected="@(a.Prosent is not null)">% av kontrakt</option>
                                                    <option value="kr" selected="@(a.Prosent is null)">Fast beløp</option>
                                                </select>
                                            </td>
                                            <td class="n">
                                                @if (a.Prosent is not null)
                                                {
                                                    <input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(a.Prosent?.ToString("0.##", CultureInfo.InvariantCulture))" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Prosent = LesTall(e) ?? 0))" aria-label="Prosent av kontrakt" />
                                                }
                                                else
                                                {
                                                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(a.Belop?.ToString("0", CultureInfo.InvariantCulture))" placeholder="Beløp" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Belop = LesTall(e)))" aria-label="Fast beløp" />
                                                }
                                            </td>
                                            <td class="n"><input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(a.InnestaaendeProsent?.ToString("0.##", CultureInfo.InvariantCulture))" placeholder="0" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.InnestaaendeProsent = LesProsent(e)))" aria-label="Innestående i prosent" /></td>
                                            <td class="n"><input class="pf-inn pf-tal pf-smal" inputmode="numeric" value="@a.FremdriftProsent" placeholder="–" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.FremdriftProsent = LesTall(e) is { } v ? (int)Math.Clamp(v, 0, 100) : null))" aria-label="Klar når så mange prosent er utført" /></td>
                                            <td><input type="date" class="pf-inn" value="@DatoVerdi(a.PlanlagtDato)" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.PlanlagtDato = LesDato(e)))" aria-label="Planlagt dato" /></td>
                                            <td class="n">@if (!laast) {<button type="button" class="pf-x" title="Fjern akontoen" @onclick="@(() => SlettAkonto(a.Id))">×</button>}</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </details>
            }
            <details class="pf-info">
                <summary><Icon Name="file-text" />Prosjektsum · gjenstår @Kr(f.Gjenstar)</summary>
                <div class="pf-fold-inni">
                    <div class="pf-sumboks">
                            <div><span>Kontraktsum eks. mva</span><b>@Kr(f.Kontrakt)</b></div>
                            <div><span>Godkjente endringer</span><b>@Kr(f.Endringer)</b></div>
                            <div><span>Indeksregulering</span><b>@Kr(f.Indeks)</b></div>
                            <div class="pf-sum"><span>Sum eks. mva</span><span>@Kr(f.Prosjektsum)</span></div>
                            <div><span>Fakturert</span><b>@Kr(f.Fakturert)</b></div>
                            <div><span>Holdt tilbake som innestående</span><b>@Kr(f.HoldtTilbake)</b></div>
                            <div><span>Utført, ikke fakturert</span><b class="@(f.UtfortIkkeFakturert > 0 ? "pf-gul" : "")">@Kr(f.UtfortIkkeFakturert)</b></div>
                            <div class="pf-rest"><span>Gjenstår å fakturere</span><span>@Kr(f.Gjenstar)</span></div>
                        </div>
                </div>
            </details>
            <details class="pf-info">
                <summary><Icon Name="shield" />Bankgaranti · @(p.BankgarantiBelop is { } bg ? Kr(bg) + (p.BankgarantiTil is { } til ? $" til {Dato(til)}" : "") : "ikke lagt inn")</summary>
                <div class="pf-fold-inni">
                    <div class="pf-sumboks">
                            <div><span>Beløp</span><input class="pf-inn pf-tal" inputmode="decimal" value="@(p.BankgarantiBelop?.ToString("0", CultureInfo.InvariantCulture))" placeholder="@(f.Kontrakt > 0 ? Math.Round(f.Kontrakt * 0.1m).ToString("0", CultureInfo.InvariantCulture) : "")" @onchange="@(e => EndreProsjekt(x => x.BankgarantiBelop = LesTall(e)))" aria-label="Bankgaranti beløp" /></div>
                            <div><span>Gyldig til</span><input type="date" class="pf-inn" value="@DatoVerdi(p.BankgarantiTil)" @onchange="@(e => EndreProsjekt(x => x.BankgarantiTil = LesDato(e)))" aria-label="Bankgaranti gyldig til" /></div>
                        </div>
                        <p class="pf-dempet">Vanlig er 10 % av kontraktsummen i byggetiden og 3 % i reklamasjonstiden. To uker før datoen vises den under «Venter noe på oss?».</p>
                </div>
            </details>
        </div>
    </div>;
}
