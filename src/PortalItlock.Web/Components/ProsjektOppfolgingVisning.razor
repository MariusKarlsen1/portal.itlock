@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProsjektOppfolgingService OppfolgingSvc
@inject TripletexSyncService TripletexSync
@inject TripletexService Tripletex
@inject NavigationManager Nav

@* Ett pågående prosjekt under Prosjektøkonomi: det som var arket
   «Kalkulering og økonomi», med fanene Oversikt, Fremdriftsplan, Budsjett og
   timer, Endringer og Fakturering. Tallene regnes ut av seg selv; feltene
   med stiplet grønn ramme fylles inn, som de grønne cellene i arket.
   Etterkalkylen ligger som før under Etterkalkyle. *@
@if (_f is null || _p is null)
{
    <p class="pf-tom">Regner ut …</p>
}
else
{
    var f = _f;
    var o = f.O;
    <div class="pf">
        <div class="pf-topp">
            <div>
                <button type="button" class="pf-lenke pf-tilbake" @onclick="Tilbake"><Icon Name="arrow-left" />Til pågående prosjekter</button>
                <h2>@_p.Navn</h2>
                <p>@(_p.Kunde?.Navn ?? "Ingen kunde")@(_p.Prosjektleder is { } pl ? $" · PL {pl.Navn}" : "")</p>
            </div>
            <span class="pf-topp-hoyre">
                <span class="pf-chip pf-chip-bla">@(_p.Status?.Visningsnavn() ?? "Aktiv")</span>
                <a class="pf-knapp" href="@($"/prosjekter/{_p.Id}")"><Icon Name="folder" />Åpne prosjektet</a>
            </span>
        </div>

        <nav class="pf-faner" role="tablist" aria-label="Prosjektøkonomi">
            @Fane("oversikt", "Oversikt", null, "")
            @Fane("budsjett", "Økonomi", null, "")
            @Fane("faktura", "Fakturering", f.KlarAkonto is not null || f.UtfortIkkeFakturert > f.Prosjektsum * 0.05m ? $"{KrKort(f.UtfortIkkeFakturert)} klar" : null, "gul")
            @Fane("plan", "Fremdrift", f.ForsinkedeAktiviteter > 0 ? $"{f.ForsinkedeAktiviteter} forsinket" : f.HarPlan ? null : "mangler plan", f.ForsinkedeAktiviteter > 0 ? "rod" : "gul")
        </nav>

        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="pf-melding @(_meldingFeil ? "pf-melding-feil" : "")">@_melding</p>
        }

        @switch (_fane)
        {
            case "plan":
                @PlanFane()
                break;
            case "budsjett":
            case "endringer":
                @OkonomiFane()
                break;
            case "faktura":
                @FakturaFane()
                break;
            default:
                @OversiktFane()
                break;
        }
    </div>
}

@code {
    [Parameter] public int ProsjektId { get; set; }

    // All databasebruk går gjennom siden rundt, så den ikke kolliderer med
    // oppdateringen i bakgrunnen.
    [Parameter] public Func<Func<Task>, Task> Kjor { get; set; } = arbeid => arbeid();

    // Settes av siden rundt hver gang tallene er regnet ut på nytt.
    [Parameter] public DateTime Oppdatert { get; set; }
    [Parameter] public string? BrukerNavn { get; set; }

    // Lenken tilbake til lista over pågående prosjekter.
    [Parameter] public EventCallback Tilbake { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    // Det som mangler før prosjektet følges opp fullt ut, med fanen det gjøres i.
    private List<(string Tekst, string Fane)> KomIGang()
    {
        var liste = new List<(string, string)>();
        if (_f is null)
        {
            return liste;
        }

        if (_f.O is null) liste.Add(("Sett tilbudet på prosjektet til Godkjent", "tilbud"));
        if (_f.Frister is null) liste.Add(("Legg inn montasjestart og overlevering", "plan"));
        if (!_f.HarPlan) liste.Add(("Lag fremdriftsplan", "plan"));
        if (_f.Akontoer.Count == 0 && _f.Gjenstar > 1) liste.Add(("Lag faktureringsplan", "faktura"));
        if (_f.HarPlan && !_roller.Values.Any(v => v is not null)) liste.Add(("Velg personer til rollene", "plan"));
        return liste;
    }

    // Et steg i «Kom i gang»: en fane her, eller tilbudene på selve prosjektet.
    private void GaTil(string fane)
    {
        if (fane == "tilbud")
        {
            Nav.NavigateTo($"/prosjekter/{ProsjektId}");
            return;
        }

        _fane = fane;
        _melding = null;
    }

    private ProsjektOppfolgingService.Oppfolging? _f;
    private Prosjekt? _p;
    private List<ProsjektplanAktivitet> _aktiviteter = [];
    private Dictionary<string, int?> _roller = [];
    private List<(int Id, string Navn)> _brukere = [];
    private Dictionary<BudsjettPost, decimal> _justering = [];
    private List<(TimeAktivitet Aktivitet, decimal Timer)> _timerPerAktivitet = [];
    private string _fane = "oversikt";
    private string? _melding;
    private bool _meldingFeil;
    private int _lastetFor;
    private DateTime _lastetTid;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastetFor != ProsjektId || _lastetTid != Oppdatert)
        {
            if (_lastetFor != ProsjektId)
            {
                _fane = "oversikt";
                _melding = null;
                _apne.Clear();
            }

            _lastetFor = ProsjektId;
            _lastetTid = Oppdatert;
            await Kjor(LastAsync);
        }
    }


    private async Task LastAsync()
    {
        _f = await OppfolgingSvc.HentAsync(ProsjektId);
        _p = await Db.Prosjekter.AsNoTracking().Include(p => p.Kunde).Include(p => p.Prosjektleder).FirstOrDefaultAsync(p => p.Id == ProsjektId);
        _aktiviteter = await Db.ProsjektplanAktiviteter.AsNoTracking().Include(a => a.Oppgaver)
            .Where(a => a.ProsjektId == ProsjektId).OrderBy(a => a.Fase).ThenBy(a => a.Rekkefolge).ToListAsync();
        _roller = await Db.ProsjektRoller.AsNoTracking().Where(r => r.ProsjektId == ProsjektId).ToDictionaryAsync(r => r.Rolle, r => r.BrukerId);
        _brukere = (await Db.Brukere.AsNoTracking()
                .Where(b => b.Aktiv && b.SlettetDato == null && b.Rolle != BrukerRolle.Kunde && b.Rolle != BrukerRolle.Driftslisens)
                .OrderBy(b => b.Navn).Select(b => new { b.Id, b.Navn }).ToListAsync())
            .Select(b => (b.Id, b.Navn)).ToList();
        _justering = await Db.ProsjektBudsjettJusteringer.AsNoTracking().Where(j => j.ProsjektId == ProsjektId).ToDictionaryAsync(j => j.Post, j => j.Belop);
        _timerPerAktivitet = (await Db.Timeregistreringer.AsNoTracking()
                .Where(t => t.Arbeidsordre!.ProsjektId == ProsjektId && t.Status != TimeregistreringStatus.Avslatt)
                .Select(t => new { t.Aktivitet, t.Start, t.Slutt, t.PauseMinutter }).ToListAsync())
            .GroupBy(t => t.Aktivitet)
            .Select(g => (g.Key, Math.Round(g.Sum(t => Math.Max(0, (decimal)(t.Slutt - t.Start).TotalHours - t.PauseMinutter / 60m)), 1)))
            .OrderByDescending(x => x.Item2).ToList();
    }

    private async Task Lagre(Func<Task> endring, string? melding = null)
    {
        await Kjor(async () =>
        {
            try
            {
                await endring();
                await Db.SaveChangesAsync();
                _melding = melding;
                _meldingFeil = false;
            }
            catch (Exception ex) when (ex is DbUpdateException or InvalidOperationException)
            {
                _melding = "Kunne ikke lagre. Prøv igjen.";
                _meldingFeil = true;
            }

            await LastAsync();
        });
    }

    private Task EndreProsjekt(Action<Prosjekt> endring, string? melding = null) =>
        Lagre(async () => endring(await Db.Prosjekter.FirstAsync(p => p.Id == ProsjektId)), melding);

    // ---------- Hjelpere ----------
    private static string Kr(decimal v) => v.ToString("#,##0", Kultur) + " kr";
    private static string KrKort(decimal v) => v.ToString("#,##0", Kultur);
    private static string Pst(decimal v) => Math.Round(v * 100).ToString("0", Kultur) + " %";
    private static string DG(decimal? v) => v is { } d ? (d * 100).ToString("0.0", Kultur) + " %" : "–";
    private static string Css(double v) => Math.Clamp(v, 0, 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    private static string Dato(DateTime d) => d.ToString("dd.MM", Kultur);
    private static string? DatoVerdi(DateTime? d) => d?.ToString("yyyy-MM-dd");
    private static DateTime? LesDato(ChangeEventArgs e) => DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d.Date : null;
    private static decimal? LesTall(ChangeEventArgs e) => decimal.TryParse(e.Value?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;
    private static string? LesTekst(ChangeEventArgs e) => string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();

    private static string NivaKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Gronn => "gronn",
        ProsjektOppfolgingService.Niva.Gul => "gul",
        ProsjektOppfolgingService.Niva.Rod => "rod",
        _ => "noytral"
    };

    private string PersonFor(string? rolle) =>
        rolle is not null && _roller.GetValueOrDefault(rolle) is int id && _brukere.FirstOrDefault(b => b.Id == id) is { Navn: { } navn } ? navn : "";

    private RenderFragment Fane(string id, string tekst, string? teller, string tellerKlasse) => @<button type="button" role="tab" aria-selected="@(_fane == id ? "true" : "false")" class="@(_fane == id ? "aktiv" : "")" @onclick="@(() => { _fane = id; _melding = null; })">
        @tekst
        @if (teller is not null)
        {
            <small class="pf-teller @(string.IsNullOrEmpty(tellerKlasse) ? "" : "pf-teller-" + tellerKlasse)">@teller</small>
        }
    </button>;

    // ======================================================================
    // Oversikt
    private sealed record Oppgave(string Ikon, string Klasse, string Tittel, string Tekst, string Knapp, Func<Task> Handling);

    private bool _alleOppgaver;

    // Det prosjektlederen bør gjøre nå, det viktigste først.
    private List<Oppgave> Oppgaver()
    {
        var liste = new List<Oppgave>();
        if (_f is not { } f)
        {
            return liste;
        }

        Task GaFane(string fane) { _fane = fane; _melding = null; return Task.CompletedTask; }
        Task Til(string adresse) { Nav.NavigateTo(adresse); return Task.CompletedTask; }
        var o = f.O;

        if (f.KlarAkonto is { } klar)
        {
            liste.Add(new("file-text", "gul", $"Send akonto {klar.Akonto.Nr} · {Kr(klar.Netto)}", $"{klar.Akonto.Milepael} er nådd.", "Til faktureringen", () => GaFane("faktura")));
        }
        else if (f.UtfortIkkeFakturert > f.Prosjektsum * 0.05m)
        {
            liste.Add(new("file-text", "gul", $"Fakturer {Kr(f.UtfortIkkeFakturert)}", $"{Pst(f.Fremdrift)} er utført, {Pst(f.Prosjektsum > 0 ? f.Fakturert / f.Prosjektsum : 0)} er fakturert.", "Til faktureringen", () => GaFane("faktura")));
        }

        if (o is { OverTimer: > 0 })
        {
            liste.Add(new("clock", "rod", $"Timene er {(o.FaktiskTimer - o.BudsjettTimer).ToString("0.#", Kultur)} t over tilbudet",
                $"{o.FaktiskTimer.ToString("0.#", Kultur)} t brukt av {o.BudsjettTimer.ToString("0.#", Kultur)} t. Er noe av det ekstraarbeid, skal kunden betale for det.", "Åpne prosjektet", () => Til($"/prosjekter/{ProsjektId}")));
        }

        if (o is { OverVarer: > 0 })
        {
            liste.Add(new("box", "rod", $"Varene er {Kr(o.OverVarer)} over tilbudet", "Ekstra varer bør faktureres som endringsmelding.", "Åpne prosjektet", () => Til($"/prosjekter/{ProsjektId}")));
        }

        if (f.ForsinkedeAktiviteter > 0)
        {
            liste.Add(new("calendar", "rod", $"{f.ForsinkedeAktiviteter} aktivitet{(f.ForsinkedeAktiviteter == 1 ? " er" : "er er")} forsinket", "Oppdater oppgavene eller flytt datoene i fremdriftsplanen.", "Se planen", () => GaFane("plan")));
        }

        foreach (var e in f.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.SendtTilKunde && e.DagerVentet >= 7))
        {
            liste.Add(new("send", "bla", $"E{e.Nr} har ventet på kunden i {e.DagerVentet} dager", $"{Kr(e.Belop)} kommer i tillegg når kunden godkjenner.", "Åpne endringen", () => Til($"/tilbud/{e.Tilbud.Id}")));
        }

        if (o is { FaktiskTimerVenter: > 0 })
        {
            liste.Add(new("check", "bla", $"Godkjenn {o.FaktiskTimerVenter.ToString("0.#", Kultur)} t", "Timene er ført, men ikke godkjent.", "Til godkjenning", () => Til("/timegodkjenning")));
        }

        if (o is { AntallIkkeFakturert: > 0 })
        {
            liste.Add(new("receipt", "gul", $"{o.AntallIkkeFakturert} ferdigmeldte arbeidsordre er ikke fakturert", $"{Kr(o.IkkeFakturert)} venter på faktura.", "Til arbeidsordre", () => Til("/arbeidsordre")));
        }

        foreach (var (tekst, fane) in KomIGang())
        {
            var til = fane;
            liste.Add(new("check-circle", "bla", tekst, "Gjør prosjektet klart til å følges opp fullt ut.", "Gjør det nå", () => { GaTil(til); return Task.CompletedTask; }));
        }

        if (p_BankgarantiSnart() is { } bg)
        {
            liste.Add(new("alert-triangle", "gul", $"Bankgarantien går ut {bg:dd.MM}", "Forny eller avslutt garantien.", "Til faktureringen", () => GaFane("faktura")));
        }

        return liste;
    }

    private DateTime? p_BankgarantiSnart() => _p?.BankgarantiTil is { } bg && bg.Date <= DateTime.Today.AddDays(14) ? bg : null;

    // Én rad per post: det kunden betaler, kosten i tilbudet og det som er brukt.

    // Oversikt (forslag prosjektokonomi-ny.html): status i klartekst, fire nøkkeltall,
    // veien fra tilbudt til fortjeneste per post, timer per arbeidsordre, og til høyre
    // det som må gjøres, fakturering, kontrakt og fremdrift.
    private RenderFragment OversiktFane() => @<div class="pf-fane">
        @{
            var f = _f!;
            var o = f.O;
            var oppgaver = Oppgaver();
            var synlige = _alleOppgaver ? oppgaver : oppgaver.Take(3).ToList();
        }
        @if (o is not { Inntekt: > 0 })
        {
            <div class="pf-tomboks"><b>Ingen budsjett ennå</b><p>Tallene kommer når et tilbud på prosjektet settes til Godkjent. Da låses budsjettet, og det som brukes underveis sammenlignes med det.</p></div>
        }
        else
        {
            var niva = BannerNiva(f);
            var kostAndel = o.JustertKost > 0 ? o.FaktiskKost / o.JustertKost : 0;
            var prognoseFortjeneste = f.Prosjektsum - o.PrognoseKost - o.JusteringUforutsett;
            <div class="pf-banner pf-banner-@NivaNavn(niva)">
                <span class="pf-banner-ik"><Icon Name="@(niva == ProsjektOppfolgingService.Niva.Gronn ? "check" : "alert-triangle")" /></span>
                <div>
                    <b>@BannerTittel(f, niva)</b>
                    <span>@BannerTekst(f, kostAndel)</span>
                </div>
                <button type="button" class="pf-knapp" @onclick="@(() => _fane = "budsjett")">Se all utregning</button>
            </div>

            <div class="pf-kpi">
                <div>
                    <span>Tilbudt</span>
                    <b>@Kr(f.Prosjektsum)</b>
                    <small>@(f.Endringer != 0 ? $"inkl. endringer {Kr(f.Endringer)}" : $"{o.Tilbud.Count} {(o.Tilbud.Count == 1 ? "godkjent tilbud" : "godkjente tilbud")}")</small>
                </div>
                <div>
                    <span>Kost hittil</span>
                    <b>@Kr(o.FaktiskKost)</b>
                    <small>av @Kr(o.JustertKost) i budsjett (@Pst(kostAndel))</small>
                </div>
                <div class="@(f.FortjenesteIgjen < 0 || niva == ProsjektOppfolgingService.Niva.Rod ? "pf-kpi-rod" : niva == ProsjektOppfolgingService.Niva.Gul ? "pf-kpi-gul" : "")">
                    <span>Fortjeneste igjen</span>
                    <b>@Kr(f.FortjenesteIgjen)</b>
                    <small>tilbudt @Kr(f.TilbudtFortjeneste) · prognose ved ferdig @Kr(prognoseFortjeneste)</small>
                </div>
                <div class="@(o.PrognoseDekningsgrad < o.BudsjettDekningsgrad - 0.03m ? "pf-kpi-rod" : "")">
                    <span>Dekningsgrad</span>
                    <b>@DG(o.PrognoseDekningsgrad)</b>
                    <small>tilbudt @DG(o.BudsjettDekningsgrad) · prognose ved ferdig</small>
                </div>
            </div>

            <div class="pf-to">
                <div class="pf-kol">
                    <section class="pf-boks">
                        <div class="pf-boks-hode">Fra tilbudt til fortjeneste</div>
                        <div class="pf-boks-innhold">
                            @{
                                var skala = Math.Max(f.Prosjektsum, Math.Max(o.RammeTimer, o.FaktiskTimekost) + Math.Max(o.RammeVarer, o.FaktiskVarer) + Math.Max(o.RammeAndre, o.FaktiskAndre));
                            }
                            <div class="pf-foss">
                                <div class="pf-foss-rad">
                                    <span>Tilbudt</span>
                                    <span class="pf-spor"><i class="pf-spor-salg" style="width:@Bredde(f.Prosjektsum, skala)"></i></span>
                                    <span class="n">@KrKort(f.Prosjektsum)</span>
                                </div>
                                @FossRad("− Timer", o.RammeTimer, o.FaktiskTimekost, o.Fremdrift, skala)
                                @FossRad("− Varer", o.RammeVarer, o.FaktiskVarer, o.Fremdrift, skala)
                                @if (o.RammeAndre != 0 || o.FaktiskAndre != 0)
                                {
                                    @FossRad("− Kjøring og tillegg", o.RammeAndre, o.FaktiskAndre, o.Fremdrift, skala)
                                }
                                <div class="pf-foss-rad pf-foss-sum">
                                    <span>Fortjeneste igjen</span>
                                    <span class="pf-spor">
                                        <i class="pf-spor-ramme" style="width:@Bredde(Math.Max(0, f.TilbudtFortjeneste), skala)"></i>
                                        <i class="pf-spor-brukt pf-spor-@(f.FortjenesteIgjen < 0 || niva == ProsjektOppfolgingService.Niva.Rod ? "rod" : niva == ProsjektOppfolgingService.Niva.Gul ? "gul" : "gronn")" style="width:@Bredde(Math.Max(0, f.FortjenesteIgjen), skala)"></i>
                                    </span>
                                    <span class="n @(f.FortjenesteIgjen < 0 ? "pf-rod" : "")">@KrKort(f.FortjenesteIgjen)</span>
                                </div>
                            </div>
                            <div class="pf-legende">
                                <span><i class="pf-spor-ramme"></i>Budsjett i tilbudet</span>
                                <span><i class="pf-spor-gronn"></i>Brukt hittil</span>
                                <span><i class="pf-spor-rod"></i>Brukt over plan</span>
                                <span><i class="pf-merke"></i>Der vi burde være nå (@Pst(o.Fremdrift) ferdig)</span>
                            </div>
                            @if (f.FortjenesteArsak is { } arsak)
                            {
                                <p class="pf-dempet pf-hjelp">@arsak.</p>
                            }
                        </div>
                    </section>

                    <div class="pf-liste-ramme">
                        <table class="pf-liste">
                            <thead><tr><th>Post</th><th class="n">Budsjett</th><th class="n">Brukt</th><th class="n">Prognose</th><th class="n">Avvik</th></tr></thead>
                            <tbody>
                                @PostPrognose("Timer", o.RammeTimer, o.FaktiskTimekost, o.PrognoseTimekost,
                                    $"{o.FaktiskTimer.ToString("0.#", Kultur)} t av {o.BudsjettTimer.ToString("0.#", Kultur)} t" + (o.FaktiskTimerVenter > 0 ? $" · {o.FaktiskTimerVenter.ToString("0.#", Kultur)} t venter godkjenning" : ""))
                                @PostPrognose("Varer", o.RammeVarer, o.FaktiskVarer, o.PrognoseVarer, o.VarerAnslatt ? "Anslått etter fremdriften, ingenting plukket ennå" : o.VarerFraLager ? "Plukket fra lager" : "Lagt inn for hånd")
                                @if (o.RammeAndre != 0 || o.FaktiskAndre != 0)
                                {
                                    @PostPrognose("Kjøring og tillegg", o.RammeAndre, o.FaktiskAndre, o.PrognoseAndre, o.AndreAnslatt ? "Anslått etter fremdriften" : "Ført på arbeidsordrene")
                                }
                            </tbody>
                            <tfoot><tr><td>Sum</td><td class="n">@KrKort(o.JustertKost)</td><td class="n">@KrKort(o.FaktiskKost)</td><td class="n">@KrKort(o.PrognoseKost)</td><td class="n @(o.JustertKost - o.PrognoseKost < 0 ? "pf-rod" : "pf-gronn")">@Fortegn(o.JustertKost - o.PrognoseKost)</td></tr></tfoot>
                        </table>
                    </div>

                    @if (o.Arbeidsordre.Count > 0)
                    {
                        var totalTimer = o.Arbeidsordre.Sum(a => a.Timer);
                        <section class="pf-boks">
                            <div class="pf-boks-hode">Timer per arbeidsordre <small>· der timene går</small></div>
                            @foreach (var a in o.Arbeidsordre.OrderByDescending(a => a.Timer).Take(_alleAo ? 100 : 5))
                            {
                                <a class="pf-ao" href="@($"/arbeidsordre/{a.Id}")">
                                    <span class="pf-ao-m"><b>@a.Tittel</b><small>@a.Status.Visningsnavn()@(a.TimerVenter > 0 ? $" · {a.TimerVenter.ToString("0.#", Kultur)} t venter godkjenning" : "")@(a.IkkeFakturert is not null ? " · ikke fakturert" : "")</small></span>
                                    <span class="pf-ao-bar"><i style="width:@Bredde(a.Timer, Math.Max(1, totalTimer))"></i></span>
                                    <span class="n"><b>@a.Timer.ToString("0.#", Kultur) t</b><small>@KrKort(a.Timekost)</small></span>
                                </a>
                            }
                            @if (o.Arbeidsordre.Count > 5)
                            {
                                <button type="button" class="pf-lenke pf-ao-flere" @onclick="@(() => _alleAo = !_alleAo)">@(_alleAo ? "Vis færre" : $"Vis alle {o.Arbeidsordre.Count}")</button>
                            }
                        </section>
                    }
                </div>

                <div class="pf-kol">
                    <div class="pf-liste-ramme">
                        <table class="pf-liste pf-liste-smal">
                            <thead><tr><th colspan="2">Gjør nå@(oppgaver.Count > 0 ? $" · {oppgaver.Count}" : "")</th></tr></thead>
                            <tbody>
                                @if (oppgaver.Count == 0)
                                {
                                    <tr><td colspan="2">Alt er i orden. Portalen sier fra når noe trenger deg.</td></tr>
                                }
                                @for (var i = 0; i < synlige.Count; i++)
                                {
                                    var x = synlige[i];
                                    <tr>
                                        <td><b>@x.Tittel</b><small>@x.Tekst</small></td>
                                        <td class="n"><button type="button" class="pf-knapp @(i == 0 ? "pf-knapp-p" : "")" @onclick="x.Handling">@x.Knapp</button></td>
                                    </tr>
                                }
                                @if (oppgaver.Count > 3)
                                {
                                    <tr class="pf-liste-valg"><td colspan="2"><button type="button" class="pf-lenke" @onclick="@(() => _alleOppgaver = !_alleOppgaver)">@(_alleOppgaver ? "Vis færre" : $"Vis {oppgaver.Count - 3} til")</button></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <section class="pf-boks">
                        <div class="pf-boks-hode">Fakturering</div>
                        <div class="pf-boks-innhold pf-fakt">
                            @{
                                var rest = Math.Max(0, f.Gjenstar - f.UtfortIkkeFakturert);
                                var sum = Math.Max(1, f.Fakturert + f.UtfortIkkeFakturert + rest);
                            }
                            <div class="pf-fakt-bar">
                                <i class="pf-fakt-sendt" style="width:@Bredde(f.Fakturert, sum)"></i>
                                <i class="pf-fakt-klar" style="width:@Bredde(f.UtfortIkkeFakturert, sum)"></i>
                            </div>
                            <div class="pf-fakt-rad"><span><i class="pf-fakt-sendt"></i>Fakturert</span><b>@Kr(f.Fakturert)</b></div>
                            <div class="pf-fakt-rad"><span><i class="pf-fakt-klar"></i>Utført, ikke fakturert</span><b>@Kr(f.UtfortIkkeFakturert)</b></div>
                            <div class="pf-fakt-rad"><span><i></i>Gjenstår av kontrakt</span><b>@Kr(rest)</b></div>
                            <button type="button" class="pf-knapp @(f.UtfortIkkeFakturert > 0 ? "pf-knapp-p" : "")" @onclick="@(() => _fane = "faktura")"><Icon Name="receipt" />@(f.UtfortIkkeFakturert > 0 ? $"Fakturer {Kr(f.UtfortIkkeFakturert)}" : "Til fakturering")</button>
                        </div>
                    </section>

                    <section class="pf-boks">
                        <div class="pf-boks-hode">Kontrakt</div>
                        @foreach (var t in o.Tilbud)
                        {
                            <a class="pf-linje" href="@($"/tilbud/{t.Id}")">
                                <span><b>@t.Tittel</b><small>@(t.ErEndring ? "Endringsmelding" : "Tilbud") · godkjent, budsjett låst @t.Laast.ToString("dd.MM.yyyy")</small></span>
                                <span class="n">@KrKort(t.Salgssum)</span>
                            </a>
                        }
                        @foreach (var e in f.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.SendtTilKunde))
                        {
                            <a class="pf-linje pf-linje-venter" href="@($"/tilbud/{e.Tilbud.Id}")">
                                <span><b>@e.Tilbud.Tittel</b><small>Endringsmelding sendt til kunde · venter i @e.DagerVentet @(e.DagerVentet == 1 ? "dag" : "dager") · ikke med i tallene</small></span>
                                <span class="n">(@KrKort(e.Belop))</span>
                            </a>
                        }
                        @if (f.Indeks != 0)
                        {
                            <div class="pf-linje"><span><b>Indeksregulering</b></span><span class="n">@KrKort(f.Indeks)</span></div>
                        }
                        <div class="pf-linje pf-linje-sum"><span>Prosjektsum</span><span class="n">@KrKort(f.Prosjektsum)</span></div>
                    </section>

                    <section class="pf-boks">
                        <div class="pf-boks-hode">Fremdrift</div>
                        <div class="pf-boks-innhold">
                            @FremdriftRad("Ferdig", o.Fremdrift, "pf-bar-ferdig")
                            @if (f.Tidsandel is decimal tid)
                            {
                                @FremdriftRad("Tid brukt", tid, tid > o.Fremdrift + 0.1m ? "pf-bar-gul" : "pf-bar-gronn")
                            }
                            @FremdriftRad("Kost brukt", kostAndel, kostAndel > o.Fremdrift + 0.1m ? "pf-bar-rod" : kostAndel > o.Fremdrift ? "pf-bar-gul" : "pf-bar-gronn")
                            <p class="pf-dempet pf-hjelp">@o.FremdriftTekst@(f.Frister is { } fr ? $" · overlevering {fr.Overlevering:dd.MM.yyyy}" : "")</p>
                        </div>
                    </section>

                    <div class="pf-liste-ramme">
                        <table class="pf-liste pf-liste-smal">
                            <thead><tr><th colspan="2">Denne uken · uke @FremdriftsplanBeregner.Ukenr(DateTime.Today)</th></tr></thead>
                            <tbody>
                                @if (!f.HarPlan)
                                {
                                    <tr><td colspan="2">Oppgavene fra fremdriftsplanen vises her. <button type="button" class="pf-lenke" @onclick="@(() => _fane = "plan")">Lag fremdriftsplanen</button></td></tr>
                                }
                                else if (f.AapneOppgaver.Count == 0)
                                {
                                    <tr><td colspan="2">Ingen åpne oppgaver denne uken.</td></tr>
                                }
                                else
                                {
                                    @foreach (var x in f.AapneOppgaver.OrderByDescending(x => x.Forsinket).ThenBy(x => x.Frist).Take(3))
                                    {
                                        <tr>
                                            <td><b>@x.Oppgave.Tekst</b><small>@(PersonFor(x.Oppgave.Rolle) is { Length: > 0 } n ? n : x.Oppgave.Rolle)</small></td>
                                            <td class="n"><span class="pf-chip @(x.Forsinket || x.Oppgave.Status == PlanOppgaveStatus.Utfordring ? "pf-chip-rod" : "")">@(x.Forsinket ? "Forsinket" : x.Oppgave.Status == PlanOppgaveStatus.Utfordring ? "Utfordring" : $"innen {Dato(x.Frist)}")</span></td>
                                        </tr>
                                    }
                                    <tr class="pf-liste-valg"><td colspan="2"><button type="button" class="pf-lenke" @onclick="@(() => _fane = "plan")">@(f.AapneOppgaver.Count > 3 ? $"Se alle {f.AapneOppgaver.Count} i fremdriftsplanen →" : "Åpne fremdriftsplanen →")</button></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>;

    private bool _alleAo;

    private static string NivaNavn(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Rod => "rod",
        ProsjektOppfolgingService.Niva.Gul => "gul",
        ProsjektOppfolgingService.Niva.Gronn => "gronn",
        _ => "noytral"
    };

    // Grønn fortjeneste så langt, men prognosen gir mer enn 3 poeng lavere
    // dekningsgrad enn tilbudt: da er det likevel «følg med».
    private static ProsjektOppfolgingService.Niva BannerNiva(ProsjektOppfolgingService.Oppfolging f) =>
        f.FortjenesteNiva == ProsjektOppfolgingService.Niva.Gronn && PrognoseSvak(f) ? ProsjektOppfolgingService.Niva.Gul : f.FortjenesteNiva;

    private static bool PrognoseSvak(ProsjektOppfolgingService.Oppfolging f) =>
        f.O is { PrognoseDekningsgrad: decimal p, BudsjettDekningsgrad: decimal b } && p < b - 0.03m;

    private static string BannerTittel(ProsjektOppfolgingService.Oppfolging f, ProsjektOppfolgingService.Niva niva) => niva switch
    {
        ProsjektOppfolgingService.Niva.Rod when f.FortjenesteIgjen < 0 => "Prosjektet går med tap",
        ProsjektOppfolgingService.Niva.Rod => "Taper fortjeneste",
        ProsjektOppfolgingService.Niva.Gul when f.FortjenesteNiva == ProsjektOppfolgingService.Niva.Gronn => "Følg med: kostnadene går raskere enn jobben",
        ProsjektOppfolgingService.Niva.Gul => "Følg med: noe av fortjenesten er spist opp",
        _ => "I rute: innenfor tilbudet så langt"
    };

    private static string BannerTekst(ProsjektOppfolgingService.Oppfolging f, decimal kostAndel)
    {
        var o = f.O!;
        var deler = new List<string> { $"{Pst(o.Fremdrift)} ferdig, {Pst(kostAndel)} av kostbudsjettet brukt." };
        if (f.FortjenesteArsak is { } arsak)
        {
            deler.Add(arsak + ".");
        }
        if (o.PrognoseDekningsgrad is decimal p && o.BudsjettDekningsgrad is decimal b && p < b - 0.01m)
        {
            deler.Add($"Fortsetter det slik, ender prosjektet på DG {DG(p)} i stedet for {DG(b)}.");
        }
        else if (!string.IsNullOrWhiteSpace(f.NesteSteg) && f.FortjenesteNiva == ProsjektOppfolgingService.Niva.Gronn)
        {
            deler.Add(f.NesteSteg);
        }
        return string.Join(" ", deler);
    }

    private static string Bredde(decimal verdi, decimal skala) =>
        Css(skala <= 0 ? 0 : (double)(Math.Max(0, verdi) / skala * 100));

    private static string Fortegn(decimal v) => (v > 0 ? "+ " : v < 0 ? "− " : "") + KrKort(Math.Abs(v));

    // Én post i «Fra tilbudt til fortjeneste»: rammen i lys grå, brukt i farge, og en strek der
    // brukt burde vært ut fra fremdriften.
    private RenderFragment FossRad(string navn, decimal ramme, decimal brukt, decimal fremdrift, decimal skala) => @<div class="pf-foss-rad">
        @{
            var farge = brukt > ramme ? "rod" : fremdrift > 0.05m && brukt > ramme * fremdrift * 1.1m ? "gul" : "gronn";
        }
        <span>@navn</span>
        <span class="pf-spor">
            <i class="pf-spor-ramme" style="width:@Bredde(ramme, skala)"></i>
            <i class="pf-spor-brukt pf-spor-@farge" style="width:@Bredde(brukt, skala)"></i>
            @if (fremdrift > 0 && ramme > 0)
            {
                <em class="pf-merke" style="left:@Bredde(ramme * fremdrift, skala)" title="Der vi burde være nå"></em>
            }
        </span>
        <span class="n @(farge == "rod" ? "pf-rod" : "")">− @KrKort(Math.Max(ramme, brukt))</span>
    </div>;

    private RenderFragment PostPrognose(string navn, decimal budsjett, decimal brukt, decimal prognose, string under) => @<tr>
        @{
            var avvik = budsjett - prognose;
        }
        <td><b>@navn</b><small>@under</small></td>
        <td class="n">@KrKort(budsjett)</td>
        <td class="n">@KrKort(brukt)</td>
        <td class="n">@KrKort(prognose)</td>
        <td class="n"><b class="@(avvik < -0.5m ? "pf-rod" : avvik > 0.5m ? "pf-gronn" : "")">@Fortegn(avvik)</b></td>
    </tr>;

    private RenderFragment FremdriftRad(string navn, decimal andel, string klasse) => @<div class="pf-frem">
        <span>@navn</span>
        <span class="pf-frem-bar"><i class="@klasse" style="width:@Css((double)(andel * 100))"></i></span>
        <span class="n">@Pst(andel)</span>
    </div>;

    // ======================================================================
    // Fremdriftsplan
    private readonly HashSet<int> _apne = [];
    private readonly Dictionary<int, string> _nyOppgave = [];

    private Task LagPlan()
    {
        return Lagre(() => OppfolgingSvc.LagPlanFraMalAsync(ProsjektId), "Fremdriftsplanen er laget fra malen. Oppgaver i aktiviteter som allerede er passert, er satt til avsluttet. Sjekk datoene, og velg personer til rollene nederst.");
    }

    private Task SettStatus(int oppgaveId, ChangeEventArgs e) => Lagre(async () =>
    {
        var t = await Db.ProsjektplanOppgaver.FirstAsync(x => x.Id == oppgaveId);
        t.Status = Enum.TryParse<PlanOppgaveStatus>(e.Value?.ToString(), out var s) ? s : t.Status;
        t.Endret = DateTime.Now;
        t.EndretAv = BrukerNavn;
    });

    private Task LeggTilOppgave(ProsjektplanAktivitet a)
    {
        if (!_nyOppgave.TryGetValue(a.Id, out var tekst) || string.IsNullOrWhiteSpace(tekst))
        {
            return Task.CompletedTask;
        }

        _nyOppgave.Remove(a.Id);
        return Lagre(() =>
        {
            Db.ProsjektplanOppgaver.Add(new ProsjektplanOppgave
            {
                AktivitetId = a.Id,
                Tekst = tekst.Trim(),
                Rolle = a.Rolle,
                Rekkefolge = a.Oppgaver.Count == 0 ? 0 : a.Oppgaver.Max(x => x.Rekkefolge) + 1
            });
            return Task.CompletedTask;
        });
    }

    private Task SlettOppgave(int oppgaveId) => Lagre(async () =>
        Db.ProsjektplanOppgaver.Remove(await Db.ProsjektplanOppgaver.FirstAsync(x => x.Id == oppgaveId)));

    private Task SettRolle(string rolle, ChangeEventArgs e) => Lagre(async () =>
    {
        int? brukerId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        var r = await Db.ProsjektRoller.FirstOrDefaultAsync(x => x.ProsjektId == ProsjektId && x.Rolle == rolle);
        if (r is null)
        {
            Db.ProsjektRoller.Add(new ProsjektRolle { ProsjektId = ProsjektId, Rolle = rolle, BrukerId = brukerId });
        }
        else
        {
            r.BrukerId = brukerId;
        }
    });

    // Fremdrift (forslag prosjektokonomi-enkel.html): aktivitetene som en liste, trykk for å
    // krysse av oppgavene. Datoer og roller står på én linje hver, med «Endre».
    private bool _visDatoer;
    private bool _visRoller;

    private RenderFragment PlanFane() => @<div class="pf-fane pf-fane-smal">
        @{
            var f = _f!;
            var p = _p!;
            var fr = f.Frister;
            var idag = DateTime.Today;
        }
        @if (f.HarPlan && fr is not null)
        {
            var inn = FremdriftsplanBeregner.UkerMellom(fr.Start, idag) + 1;
            var totalt = FremdriftsplanBeregner.UkerMellom(fr.Start, fr.Overlevering) + 1;
            var igjen = FremdriftsplanBeregner.UkerMellom(idag, fr.Overlevering);
            var rader = FremdriftsplanBeregner.Faser(fr)
                .SelectMany(fase => _aktiviteter.Where(a => Math.Clamp(a.Fase, 0, 2) == fase.Nr).Select(a => (Fase: fase, Aktivitet: a)))
                .Select(x =>
                {
                    var (fra, til) = FremdriftsplanBeregner.AktivitetDatoer(x.Fase, x.Aktivitet.DelFra, x.Aktivitet.DelTil);
                    var andel = FremdriftsplanBeregner.Andel(x.Aktivitet.Oppgaver.Select(t => t.Status));
                    return (x.Aktivitet, Fra: fra, Til: til, Andel: andel, Status: AktivitetStatus(fra, til, andel));
                })
                .ToList();
            var forsinket = rader.Where(r => r.Status.Klasse == "rod").Select(r => r.Aktivitet.Navn).ToList();

            <p class="pf-svar"><b>Uke @(Math.Clamp(inn, 1, totalt)) av @totalt</b>. @(igjen >= 0 ? $"{igjen} {(igjen == 1 ? "uke" : "uker")} til overlevering {Dato(fr.Overlevering)}." : $"{-igjen} uker over fristen.")
                @if (forsinket.Count > 0)
                {
                    <b class="pf-rod">@(forsinket.Count == 1 ? $"{forsinket[0]} er forsinket." : $"{forsinket.Count} aktiviteter er forsinket.")</b>
                }
            </p>

            <div class="pf-rader">
                @foreach (var r in rader)
                {
                    var a = r.Aktivitet;
                    var akt = a;
                    var apen = _apne.Contains(a.Id);
                    var ferdige = a.Oppgaver.Count(t => t.Status.ErFerdig());
                    <div class="pf-rad pf-akt @(apen ? "apen" : "")" role="button" tabindex="0" aria-expanded="@(apen ? "true" : "false")" @onclick="@(() => VekslAktivitet(akt.Id))" @onkeydown="@(e => { if (e.Key == "Enter") VekslAktivitet(akt.Id); })">
                        <span class="pf-prikk pf-prikk-@(r.Status.Klasse.Length > 0 ? r.Status.Klasse : "gra")"></span>
                        <div class="pf-rad-m">
                            <b>@a.Navn</b>
                            <small>@(PersonFor(a.Rolle) is { Length: > 0 } n ? n : a.Rolle) · uke @FremdriftsplanBeregner.Ukenr(r.Fra)@(FremdriftsplanBeregner.Ukenr(r.Til) != FremdriftsplanBeregner.Ukenr(r.Fra) ? $"–{FremdriftsplanBeregner.Ukenr(r.Til)}" : "")</small>
                        </div>
                        <span class="pf-mini"><i class="pf-mini-@(r.Status.Klasse == "rod" ? "rod" : "gronn")" style="width:@Css((double)(r.Andel * 100))"></i></span>
                        <span class="pf-handling"><span class="pf-chip @(r.Status.Klasse.Length > 0 ? "pf-chip-" + r.Status.Klasse : "")">@r.Status.Tekst @ferdige/@a.Oppgaver.Count</span></span>
                    </div>
                    @if (apen)
                    {
                        <div class="pf-oppgaver-liste">
                            @foreach (var t in a.Oppgaver.OrderBy(x => x.Rekkefolge))
                            {
                                var oppg = t;
                                var ferdig = t.Status.ErFerdig();
                                var frist = r.Til;
                                <div class="pf-oppgave @(ferdig ? "ferdig" : "")">
                                    <input type="checkbox" checked="@ferdig" @onchange="@(e => SettOppgaveStatus(oppg.Id, e.Value is true ? PlanOppgaveStatus.Avsluttet : PlanOppgaveStatus.IkkeStartet))" aria-label="Ferdig: @t.Tekst" />
                                    <span class="pf-oppgave-tekst">@t.Tekst</span>
                                    @if (t.Status == PlanOppgaveStatus.Utfordring)
                                    {
                                        <span class="pf-flagg">Utfordring</span>
                                    }
                                    else if (!ferdig && frist < idag)
                                    {
                                        <span class="pf-flagg">frist @Dato(frist) passert</span>
                                    }
                                    <small>@(PersonFor(t.Rolle) is { Length: > 0 } navn ? navn : t.Rolle)</small>
                                    @if (!ferdig)
                                    {
                                        <button type="button" class="pf-lenke pf-oppgave-valg" @onclick="@(() => SettOppgaveStatus(oppg.Id, oppg.Status == PlanOppgaveStatus.Utfordring ? PlanOppgaveStatus.Pabegynt : PlanOppgaveStatus.Utfordring))">@(t.Status == PlanOppgaveStatus.Utfordring ? "Løst" : "Meld utfordring")</button>
                                    }
                                    <button type="button" class="pf-x" title="Fjern oppgaven" @onclick="@(() => SlettOppgave(oppg.Id))">×</button>
                                </div>
                            }
                            <div class="pf-oppg-ny">
                                <input class="pf-inn" placeholder="Ny oppgave i @a.Navn" value="@_nyOppgave.GetValueOrDefault(a.Id)" @oninput="@(e => _nyOppgave[akt.Id] = e.Value?.ToString() ?? "")" @onkeydown="@(e => e.Key == "Enter" ? LeggTilOppgave(akt) : Task.CompletedTask)" />
                                <button type="button" class="pf-knapp" @onclick="@(() => LeggTilOppgave(akt))">Legg til</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (!f.HarPlan)
        {
            <div class="pf-tomboks">
                <b>Ingen fremdriftsplan ennå</b>
                <p>Malen har fasene planlegging, gjennomføring og avslutning, med aktiviteter, oppgaver og roller. Datoer som mangler, fylles inn med forslag.</p>
                <span><button type="button" class="pf-knapp pf-knapp-p" @onclick="LagPlan">Lag fremdriftsplan fra malen</button></span>
            </div>
        }

        <div class="pf-fot">
            <span>@if (fr is not null) {<text>Start <b>@Dato(fr.Start)</b> · montasje <b>@Dato(fr.Montasjestart)</b> · overlevering <b>@Dato(fr.Overlevering)</b>@(f.Fristforlengelse > 0 ? $" (+ {f.Fristforlengelse} dager fra endringer)" : "")</text>} else {<text>Datoer er ikke lagt inn</text>}</span>
            <button type="button" class="pf-lenke" @onclick="@(() => _visDatoer = !_visDatoer)">@(_visDatoer ? "Lukk" : "Endre")</button>
        </div>
        @if (_visDatoer || fr is null)
        {
            var endringer = f.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.Godkjent).ToList();
            <div class="pf-endre">
                <label class="pf-felt">Prosjektstart
                    <input type="date" class="pf-inn" value="@DatoVerdi(p.StartDato ?? fr?.Start)" @onchange="@(e => EndreProsjekt(x => x.StartDato = LesDato(e)))" />
                </label>
                <label class="pf-felt">Montasjestart
                    <input type="date" class="pf-inn" value="@DatoVerdi(p.MontasjestartDato)" @onchange="@(e => EndreProsjekt(x => x.MontasjestartDato = LesDato(e)))" />
                </label>
                <label class="pf-felt">Overleveringsfrist
                    <input type="date" class="pf-inn" value="@DatoVerdi(p.OverleveringsfristDato)" @onchange="@(e => EndreProsjekt(x => x.OverleveringsfristDato = LesDato(e)))" />
                </label>
                @foreach (var e in endringer)
                {
                    var t = e.Tilbud;
                    <label class="pf-felt">E@(e.Nr) @t.Tittel, dager ekstra
                        <input class="pf-inn pf-tal pf-smal" inputmode="numeric" value="@t.FristforlengelseDager" placeholder="0" @onchange="@(ev => EndreTilbud(t.Id, x => x.FristforlengelseDager = LesTall(ev) is { } v ? (int)Math.Max(0, v) : null))" />
                    </label>
                }
                <p class="pf-dempet">Fasene regnes fra datoene. Flytt en dato, så flytter oppgavene seg. Dager ekstra fra godkjente endringer legges til overleveringen.</p>
            </div>
        }

        @if (f.HarPlan)
        {
            var valgte = FremdriftsplanBeregner.Roller.Select(r => (Rolle: r, Navn: PersonFor(r))).Where(x => !string.IsNullOrEmpty(x.Navn)).ToList();
            <div class="pf-fot">
                <span>Roller: @if (valgte.Count == 0) {<text>ingen er valgt ennå</text>} else {@for (var i = 0; i < valgte.Count; i++) {@(i > 0 ? " · " : "")@valgte[i].Rolle.ToLowerInvariant() <b>@valgte[i].Navn</b>}}</span>
                <button type="button" class="pf-lenke" @onclick="@(() => _visRoller = !_visRoller)">@(_visRoller ? "Lukk" : "Endre")</button>
            </div>
            @if (_visRoller)
            {
                <div class="pf-endre">
                    @foreach (var r in FremdriftsplanBeregner.Roller)
                    {
                        var rolle = r;
                        var valgt = _roller.GetValueOrDefault(r);
                        <label class="pf-felt">@r
                            <select class="pf-inn" @onchange="@(e => SettRolle(rolle, e))">
                                <option value="" selected="@(valgt is null)">Ingen valgt</option>
                                @foreach (var b in _brukere)
                                {
                                    <option value="@b.Id" selected="@(valgt == b.Id)">@b.Navn</option>
                                }
                            </select>
                        </label>
                    }
                    <p class="pf-dempet">Oppgavene for en rolle vises hos personen som har den.</p>
                </div>
            }
        }
    </div>;

    private Task SettOppgaveStatus(int oppgaveId, PlanOppgaveStatus status) => Lagre(async () =>
    {
        var t = await Db.ProsjektplanOppgaver.FirstAsync(x => x.Id == oppgaveId);
        t.Status = status;
        t.Endret = DateTime.Now;
        t.EndretAv = BrukerNavn;
    });

    // Status på en aktivitet: forsinket når perioden er over og noe gjenstår.
    private static (string Tekst, string Klasse) AktivitetStatus(DateTime fra, DateTime til, decimal andel)
    {
        var idag = DateTime.Today;
        return andel >= 1 ? ("Ferdig", "gronn") : til < idag ? ("Forsinket", "rod") : fra <= idag || andel > 0 ? ("Pågår", "bla") : ("Ikke startet", "");
    }


    private void VekslAktivitet(int id)
    {
        if (!_apne.Remove(id))
        {
            _apne.Add(id);
        }
    }

    // Hele prosjektet på én skjerm: rødt er forsinket, blått pågår og grått kommer.

    // ======================================================================
    // Budsjett og timer
    private Task SettJustering(BudsjettPost post, ChangeEventArgs e) => Lagre(async () =>
    {
        var belop = LesTall(e) ?? 0;
        var j = await Db.ProsjektBudsjettJusteringer.FirstOrDefaultAsync(x => x.ProsjektId == ProsjektId && x.Post == post);
        if (j is null)
        {
            Db.ProsjektBudsjettJusteringer.Add(new ProsjektBudsjettJustering { ProsjektId = ProsjektId, Post = post, Belop = belop });
        }
        else
        {
            j.Belop = belop;
        }
    });

    // Økonomi (forslag prosjektokonomi-enkel.html): svaret i én setning, og ett kort per
    // post som forklarer i klartekst hva som skjer, med justering av rammen i kortet.
    private RenderFragment OkonomiFane() => @<div class="pf-fane pf-fane-smal">
        @{
            var f = _f!;
            var o = f.O;
        }
        @if (o is null)
        {
            <div class="pf-tomboks"><b>Ingen budsjett ennå</b><p>Budsjettet låses når et tilbud på prosjektet settes til Godkjent. Hvert tilbud og hver endringsmelding som godkjennes senere, legges til av seg selv.</p></div>
        }
        else
        {
            var jV = _justering.GetValueOrDefault(BudsjettPost.Varer);
            var jT = _justering.GetValueOrDefault(BudsjettPost.Timer);
            var jU = _justering.GetValueOrDefault(BudsjettPost.Uforutsett);
            var prognose = f.Prosjektsum - o.PrognoseKost - o.JusteringUforutsett;
            var verst = new[] { (Navn: "timene", Over: o.PrognoseTimekost - o.RammeTimer), (Navn: "varene", Over: o.PrognoseVarer - o.RammeVarer), (Navn: "kjøring og tillegg", Over: o.PrognoseAndre - o.RammeAndre) }.MaxBy(x => x.Over);
            var effSats = o.FaktiskTimer > 0 && o.FaktiskTimekost > 0 ? o.FaktiskTimekost / o.FaktiskTimer : o.Timesats;
            var timepris = o.BudsjettTimer > 0 ? o.SalgArbeid / o.BudsjettTimer : 0;
            var nullTimer = effSats > 0 ? o.SalgArbeid / effSats : 0;
            var burdeTimer = o.BudsjettTimer * o.Fremdrift;
            var paslag = o.BudsjettVarer > 0 && o.SalgVarer > 0 ? o.SalgVarer / o.BudsjettVarer - 1 : 0;
            var (tKlasse, tOrd) = nullTimer > 0 && o.PrognoseTimer > nullTimer ? ("rod", "Taper på arbeidet")
                : o.PrognoseTimer > o.BudsjettTimer + 0.5m || o.OverTimer > 0 ? ("gul", "Går over") : ("gronn", "Innenfor");
            var vOver = o.PrognoseVarer > o.RammeVarer + 1 || o.OverVarer > 0;
            var harAndre = o.SalgAndre > 0 || o.BudsjettAndre != 0 || o.FaktiskAndre != 0;

            <p class="pf-svar">Prognosen er <b class="@(prognose < f.TilbudtFortjeneste * 0.75m ? "pf-rod" : prognose < f.TilbudtFortjeneste * 0.95m ? "pf-gul" : "pf-gronn")">@Kr(prognose)</b> i fortjeneste ved ferdig, mot <b>@Kr(f.TilbudtFortjeneste)</b> i tilbudet. @(verst.Over > 1 ? $"Det er {verst.Navn} som drar ned." : "Alle postene holder seg innenfor tilbudet.")</p>
            @if (o.ManglerTimesats)
            {
                <p class="pf-dempet pf-rod">Timer regnes ikke som kostnad ennå: sett intern timekost under <a href="/prosjektokonomi/innstillinger">Innstillinger → Timekost</a>.</p>
            }

            <section class="pf-post">
                <div class="pf-post-topp"><h3>Arbeid</h3><span class="pf-chip pf-chip-@tKlasse">@tOrd</span></div>
                <div class="pf-tre">
                    <div><span>I tilbudet</span><b>@T(o.BudsjettTimer)</b></div>
                    <div><span>Brukt hittil</span><b>@T(o.FaktiskTimer)</b></div>
                    <div><span>Blir trolig</span><b class="@(tKlasse == "gronn" ? "" : "pf-" + tKlasse)">@T(o.PrognoseTimer)</b></div>
                </div>
                @if (o.BudsjettTimer > 0)
                {
                    <p>Med @Pst(o.Fremdrift) ferdig burde dere brukt rundt @T(burdeTimer).
                        @if (o.PrognoseTimer > o.BudsjettTimer + 0.5m)
                        {
                            <text>Fortsetter det slik, blir det <b>@T(o.PrognoseTimer - o.BudsjettTimer) mer enn tilbudt</b></text>@(nullTimer > 0 ? $", og arbeidet går i null ved {T(nullTimer)}." : ".")
                        }
                        else
                        {
                            <text>Det holder seg innenfor timene i tilbudet.</text>
                        }
                    </p>
                }
                else
                {
                    <p>Tilbudet har ingen montasjetimer, så alle timer er kostnad.</p>
                }
                <p class="pf-post-ekstra">
                    @if (timepris > 0 && effSats > 0)
                    {
                        <text>Kunden betaler @Kr(timepris) per time, en time koster @Kr(effSats). </text>
                    }
                    @if (o.FaktiskTimerVenter > 0)
                    {
                        <text>@T(o.FaktiskTimerVenter) venter på godkjenning og er ikke med ennå.</text>
                    }
                </p>
                @if (_timerPerAktivitet.Count > 0)
                {
                    <div class="pf-aktiviteter">
                        @foreach (var (akt, t) in _timerPerAktivitet)
                        {
                            <span class="pf-chip">@akt.Visningsnavn() @T(t)</span>
                        }
                    </div>
                }
                <label class="pf-juster">Juster rammen
                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(jT != 0 ? jT.ToString("0", CultureInfo.InvariantCulture) : "")" placeholder="0 kr" @onchange="@(e => SettJustering(BudsjettPost.Timer, e))" aria-label="Juster rammen for arbeid i kroner" />
                    <span>kr, f.eks. når dere avtaler ekstra timer med kunden</span>
                </label>
            </section>

            <section class="pf-post">
                <div class="pf-post-topp"><h3>Varer</h3><span class="pf-chip pf-chip-@(vOver ? "gul" : "gronn")">@(vOver ? "Går over" : "Innenfor")</span></div>
                <div class="pf-tre">
                    <div><span>I tilbudet</span><b>@Kr(o.RammeVarer)</b></div>
                    <div><span>Brukt hittil</span><b>@Kr(o.FaktiskVarer)</b></div>
                    <div><span>Blir trolig</span><b class="@(vOver ? "pf-gul" : "")">@Kr(o.PrognoseVarer)</b></div>
                </div>
                <p>
                    @if (vOver)
                    {
                        <text>Varene går over tilbudet. Ekstra varer bør faktureres som endringsmelding.</text>
                    }
                    else
                    {
                        <text>Varene følger planen.</text>
                    }
                    @if (paslag > 0)
                    {
                        <text> Påslaget er @DG(paslag), og dere har tjent <b class="pf-gronn">@Kr(Math.Min(o.FaktiskVarer, o.RammeVarer) * paslag)</b> på varene som er brukt.</text>
                    }
                </p>
                @if (o.VarerAnslatt)
                {
                    <p class="pf-post-ekstra">Ingen varer er tatt ut fra lageret ennå, så «brukt» er anslått etter fremdriften. Ta ut varene på prosjektet, så blir tallet riktig.</p>
                }
                <label class="pf-juster">Juster rammen
                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(jV != 0 ? jV.ToString("0", CultureInfo.InvariantCulture) : "")" placeholder="0 kr" @onchange="@(e => SettJustering(BudsjettPost.Varer, e))" aria-label="Juster rammen for varer i kroner" />
                    <span>kr</span>
                </label>
            </section>

            @if (harAndre)
            {
                var aOver = o.PrognoseAndre > o.RammeAndre + 1;
                <section class="pf-post">
                    <div class="pf-post-topp"><h3>Kjøring og tillegg</h3><span class="pf-chip pf-chip-@(aOver ? "gul" : "gronn")">@(aOver ? "Går over" : "Innenfor")</span></div>
                    <div class="pf-tre">
                        <div><span>I tilbudet</span><b>@Kr(o.RammeAndre)</b></div>
                        <div><span>Brukt hittil</span><b>@Kr(o.FaktiskAndre)</b></div>
                        <div><span>Blir trolig</span><b class="@(aOver ? "pf-gul" : "")">@Kr(o.PrognoseAndre)</b></div>
                    </div>
                    <p>@(o.AndreRegistrert ? "Ført av montørene på arbeidsordrene." : "Anslått etter fremdriften, fra kodelinjene i tilbudet.")@(o.SalgAndre <= 0 ? " Det er ikke priset i tilbudet, så husk det i neste tilbud." : "")</p>
                </section>
            }

            <section class="pf-post pf-post-liten">
                <div class="pf-post-topp"><h3>Reserve og indeks</h3></div>
                <label class="pf-juster">Reserve til det uforutsette
                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(jU != 0 ? jU.ToString("0", CultureInfo.InvariantCulture) : "")" placeholder="0 kr" @onchange="@(e => SettJustering(BudsjettPost.Uforutsett, e))" aria-label="Reserve til det uforutsette i kroner" />
                    <span>kr, trekkes fra fortjenesten så tallene ikke ser bedre ut enn de er</span>
                </label>
                <label class="pf-juster">Indeksregulering
                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(_p!.Indeksregulering?.ToString("0", CultureInfo.InvariantCulture))" placeholder="0 kr" @onchange="@(e => EndreProsjekt(x => x.Indeksregulering = LesTall(e)))" aria-label="Indeksregulering i kroner" />
                    <span>kr, legges til prosjektsummen</span>
                </label>
            </section>

            <details class="pf-slik">
                <summary>Slik regnes tallene</summary>
                <ul>
                    <li><b>I tilbudet</b> er summen av alle godkjente tilbud og endringsmeldinger på prosjektet. Settes et nytt tilbud eller en endringsmelding til Godkjent, kommer timene, varene og beløpet med av seg selv.</li>
                    <li><b>Brukt hittil</b> er faktiske tall: godkjente timer × timekost, varer tatt ut fra lageret eller lagt på arbeidsordrene, og kjøring ført på arbeidsordrene.</li>
                    <li><b>Blir trolig</b> regnes ut fra hvor langt jobben er kommet (ferdigmeldte dører, ellers ferdige arbeidsordre).</li>
                    <li><b>Timekost</b> settes under <a href="/prosjektokonomi/innstillinger">Prosjektøkonomi → Innstillinger</a>.</li>
                </ul>
            </details>
        }
    </div>;

    private static string T(decimal timer) => timer.ToString("0.#", Kultur) + " t";


    // Regnestykket: tilbudt fortjeneste, pluss og minus underveis, og det som er igjen.


    // ======================================================================
    // Endringer
    private Task EndreTilbud(int tilbudId, Action<Tilbud> endring) => Lagre(async () =>
        endring(await Db.Tilbud.FirstAsync(t => t.Id == tilbudId)));

    private static (string Tekst, string Klasse) EndringStatus(ProsjektOppfolgingService.Endring e) => e.Tilbud.Status switch
    {
        EndringsmeldingStatus.Godkjent => ("Godkjent", "gronn"),
        EndringsmeldingStatus.Avslatt => ("Avslått", "rod"),
        EndringsmeldingStatus.SendtTilKunde => (e.DagerVentet > 0 ? $"Venter, {e.DagerVentet} dager" : "Sendt til kunde", e.DagerVentet >= 7 ? "gul" : "bla"),
        _ => ("Utkast", "")
    };

    // Samme tall som sammendraget nederst i tilbudet, summert for prosjektet.
    // Montering er arbeid pluss kjøring og tillegg, som i tilbudet.

    // Tilbud og endringsmeldinger lages inne på prosjektet og havner her.

    // ======================================================================
    // Fakturering
    private int? _bekreftSend;
    private bool _sender;

    private Task ForeslaPlan() => Lagre(() => OppfolgingSvc.ForeslaAkontoplanAsync(ProsjektId), "Faktureringsplanen er lagt inn. Juster milepæler og prosent ved behov.");

    private Task NyAkonto() => Lagre(async () =>
    {
        var nr = (await Db.ProsjektAkontoer.Where(a => a.ProsjektId == ProsjektId).MaxAsync(a => (int?)a.Nr) ?? 0) + 1;
        Db.ProsjektAkontoer.Add(new ProsjektAkonto { ProsjektId = ProsjektId, Nr = nr, Milepael = $"Akonto {nr}", Prosent = 10, InnestaaendeProsent = _f?.Akontoer.LastOrDefault()?.Akonto.InnestaaendeProsent });
    });

    private Task EndreAkonto(int id, Action<ProsjektAkonto> endring) => Lagre(async () =>
        endring(await Db.ProsjektAkontoer.FirstAsync(a => a.Id == id)));

    private Task SlettAkonto(int id) => Lagre(async () =>
    {
        var a = await Db.ProsjektAkontoer.FirstAsync(x => x.Id == id);
        if (a.Status == AkontoStatus.Planlagt)
        {
            Db.ProsjektAkontoer.Remove(a);
        }
    });

    private Task MarkerFakturert(ProsjektOppfolgingService.AkontoRad r) => EndreAkonto(r.Akonto.Id, a =>
    {
        a.Status = AkontoStatus.Sendt;
        a.SendtDato = DateTime.Now;
        a.SendtBelop = r.Netto;
        a.SendtInnestaaende = r.Innestaaende > 0 ? r.Innestaaende : null;
    });

    // Velger om akontoen er prosent av kontrakten eller et fast beløp.
    private Task SettAkontoType(ProsjektOppfolgingService.AkontoRad r, ChangeEventArgs e) => EndreAkonto(r.Akonto.Id, x =>
    {
        if (e.Value?.ToString() == "kr")
        {
            x.Belop = r.Belop;
            x.Prosent = null;
        }
        else
        {
            x.Prosent = _f is { Kontrakt: > 0 } f ? Math.Round(r.Belop / f.Kontrakt * 100, 2) : 0;
            x.Belop = null;
        }
    });

    // Samme innestående på alle akontoene som ikke er fakturert ennå.
    private Task SettInnestaaendeAlle(ChangeEventArgs e) => Lagre(async () =>
    {
        var prosent = LesProsent(e);
        foreach (var a in await Db.ProsjektAkontoer.Where(a => a.ProsjektId == ProsjektId && a.Status == AkontoStatus.Planlagt).ToListAsync())
        {
            a.InnestaaendeProsent = prosent;
        }
    });

    private static decimal? LesProsent(ChangeEventArgs e) => LesTall(e) is { } v && v > 0 ? Math.Min(v, 100) : null;

    private Task SendTilTripletex(ProsjektOppfolgingService.AkontoRad r) => Kjor(async () =>
    {
        _sender = true;
        try
        {
            var (ok, feil) = await TripletexSync.PushAkontoTilTripletexAsync(r.Akonto.Id, r.Netto, r.Innestaaende);
            _melding = ok ? $"Akonto {r.Akonto.Nr} på {Kr(r.Netto)} er sendt til Tripletex som ordre. Fakturer den der." : $"Tripletex: {feil}";
            _meldingFeil = !ok;
        }
        finally
        {
            _sender = false;
            _bekreftSend = null;
        }

        await LastAsync();
    });

    // Fakturering (forslag prosjektokonomi-enkel.html): svaret og én knapp øverst,
    // akontoene som en enkel liste, og plan og bankgaranti bak «Endre».
    private bool _visPlanEndre;
    private bool _visBankgaranti;

    private RenderFragment FakturaFane() => @<div class="pf-fane pf-fane-smal">
        @{
            var f = _f!;
            var p = _p!;
            var harTripletex = Tripletex.ErKonfigurert;
            var klar = f.KlarAkonto;
            var plan = f.Akontoer.Where(a => a.Akonto.Status == AkontoStatus.Planlagt).Select(a => a.Akonto.InnestaaendeProsent).Distinct().ToList();
            var rest = Math.Max(0, f.Gjenstar - f.UtfortIkkeFakturert);
            var sum = Math.Max(1, f.Fakturert + f.UtfortIkkeFakturert + rest);
        }
        <div class="pf-svar-rad">
            <p class="pf-svar"><b class="@(f.UtfortIkkeFakturert > 0 ? "pf-gul" : "")">@Kr(f.UtfortIkkeFakturert)</b> er utført og ikke fakturert.@(klar is not null ? $" Akonto {klar.Akonto.Nr} er klar." : "")</p>
            @if (klar is not null && klar.Akonto.Status == AkontoStatus.Planlagt)
            {
                @if (_bekreftSend == klar.Akonto.Id)
                {
                    <span class="pf-bekreft">Send @Kr(klar.Netto) til Tripletex?
                        <button type="button" class="pf-knapp pf-knapp-ok" disabled="@_sender" @onclick="@(() => SendTilTripletex(klar))">@(_sender ? "Sender …" : "Ja, send")</button>
                        <button type="button" class="pf-lenke" @onclick="@(() => _bekreftSend = null)">Avbryt</button>
                    </span>
                }
                else if (harTripletex && klar.Netto > 0)
                {
                    <button type="button" class="pf-knapp pf-knapp-p pf-knapp-stor" @onclick="@(() => _bekreftSend = klar.Akonto.Id)"><Icon Name="send" />Send akonto @klar.Akonto.Nr til Tripletex</button>
                }
                else
                {
                    <button type="button" class="pf-knapp pf-knapp-p pf-knapp-stor" @onclick="@(() => MarkerFakturert(klar))"><Icon Name="check" />Marker akonto @klar.Akonto.Nr som fakturert</button>
                }
            }
        </div>

        @if (f.Prosjektsum > 0)
        {
            <div>
                <div class="pf-fakt-bar">
                    <i class="pf-fakt-sendt" style="width:@Bredde(f.Fakturert, sum)"></i>
                    <i class="pf-fakt-klar" style="width:@Bredde(f.UtfortIkkeFakturert, sum)"></i>
                </div>
                <div class="pf-legende">
                    <span><i class="pf-fakt-sendt"></i>Fakturert @KrKort(f.Fakturert)</span>
                    <span><i class="pf-fakt-klar"></i>Klar @KrKort(f.UtfortIkkeFakturert)</span>
                    <span><i class="pf-legende-tom"></i>Gjenstår @KrKort(rest)</span>
                    <span>av @Kr(f.Prosjektsum)@(f.HoldtTilbake > 0 ? $" · {Kr(f.HoldtTilbake)} holdt tilbake" : "")</span>
                </div>
            </div>
        }

        @if (f.Akontoer.Count == 0 && f.Kontrakt <= 0)
        {
            <div class="pf-tomboks">
                <b>Ingen kontraktsum ennå</b>
                <p>Faktureringsplanen regnes ut fra kontraktsummen, som kommer fra det godkjente tilbudet. Sett tilbudet på prosjektet til Godkjent, så kan du lage planen her.</p>
                <span><button type="button" class="pf-knapp" @onclick="@(() => GaTil("tilbud"))">Gå til tilbudene på prosjektet</button></span>
            </div>
        }
        else if (f.Akontoer.Count == 0)
        {
            <div class="pf-tomboks">
                <b>Ingen faktureringsplan</b>
                <p>Lag planen én gang ved kontrakt. Forslaget er 20, 30, 25 og 15 % av kontraktsummen, og resten i sluttoppgjøret. Hver akonto blir klar når fremdriften når milepælen eller datoen.</p>
                <span><button type="button" class="pf-knapp pf-knapp-p" @onclick="ForeslaPlan">Foreslå plan</button> <button type="button" class="pf-knapp" @onclick="NyAkonto">Legg til én akonto</button></span>
            </div>
        }
        else
        {
            <div class="pf-rader">
                @foreach (var r in f.Akontoer)
                {
                    var rad = r;
                    var a = r.Akonto;
                    var nrKlasse = a.Status != AkontoStatus.Planlagt ? "ok" : r.Klar ? "klar" : "";
                    <div class="pf-rad">
                        <span class="pf-nr @nrKlasse">@a.Nr</span>
                        <div class="pf-rad-m">
                            <b>@a.Milepael</b>
                            <small>@(a.Prosent is { } pst ? $"{pst.ToString("0.##", Kultur)} % av kontrakten" : "Fast beløp")@(r.Innestaaende > 0 ? $" · {Kr(r.Innestaaende)} holdes tilbake" : "")@(a.Status == AkontoStatus.Planlagt && !r.Klar ? (a.FremdriftProsent is { } fp ? $" · klar ved {fp} % utført" : a.PlanlagtDato is { } pd ? $" · klar {Dato(pd)}" : "") : "")</small>
                            @if (!string.IsNullOrEmpty(a.TripletexFeil))
                            {
                                <small class="pf-rod">@a.TripletexFeil</small>
                            }
                        </div>
                        <span class="pf-belop @(a.Status == AkontoStatus.Planlagt && !r.Klar ? "pf-mut" : "")">@KrKort(r.Netto)</span>
                        <span class="pf-handling">
                            @switch (a.Status)
                            {
                                case AkontoStatus.Betalt:
                                    <span class="pf-chip pf-chip-gronn">Betalt @(a.BetaltDato is { } bd ? Dato(bd) : "")</span>
                                    break;
                                case AkontoStatus.Sendt:
                                    <span class="pf-chip pf-chip-bla">@(a.TripletexOrdreNummer is { } nr ? $"Ordre {nr}" : "Fakturert")</span>
                                    <button type="button" class="pf-lenke" @onclick="@(() => EndreAkonto(a.Id, x => { x.Status = AkontoStatus.Betalt; x.BetaltDato = DateTime.Today; }))">Marker betalt</button>
                                    break;
                                default:
                                    @if (r.Klar && a.Id != klar?.Akonto.Id)
                                    {
                                        @if (harTripletex && r.Netto > 0)
                                        {
                                            <button type="button" class="pf-knapp" @onclick="@(() => _bekreftSend = a.Id)">Send til Tripletex</button>
                                        }
                                        <button type="button" class="pf-lenke" @onclick="@(() => MarkerFakturert(rad))">Marker fakturert</button>
                                    }
                                    else
                                    {
                                        <span class="pf-chip @(r.Klar ? "pf-chip-gul" : "")">@(r.Klar ? "Klar" : "Senere")</span>
                                    }
                                    break;
                            }
                        </span>
                    </div>
                    @if (_bekreftSend == a.Id && a.Id != klar?.Akonto.Id)
                    {
                        <div class="pf-rad pf-rad-bekreft">
                            <span class="pf-bekreft">Send @Kr(r.Netto) til Tripletex?
                                <button type="button" class="pf-knapp pf-knapp-ok" disabled="@_sender" @onclick="@(() => SendTilTripletex(rad))">@(_sender ? "Sender …" : "Ja, send")</button>
                                <button type="button" class="pf-lenke" @onclick="@(() => _bekreftSend = null)">Avbryt</button>
                            </span>
                        </div>
                    }
                }
                <div class="pf-rad pf-rad-sum">
                    <span class="pf-nr">=</span>
                    <div class="pf-rad-m"><b>Sluttoppgjør</b><small>Resten av prosjektsummen@(f.Innestaaende > 0 ? ", med innestående" : "")@(f.Frister is { } fr ? $" · {Dato(fr.Overlevering)}" : "")</small></div>
                    <span class="pf-belop">@KrKort(f.Sluttoppgjor)</span>
                    <span class="pf-handling"></span>
                </div>
            </div>
            @if (!harTripletex)
            {
                <p class="pf-dempet">Tripletex er ikke koblet til. Fakturer akontoen der du pleier, og trykk «Marker fakturert».</p>
            }
        }

        <div class="pf-fot">
            @if (f.Akontoer.Count > 0)
            {
                <button type="button" class="pf-lenke" @onclick="@(() => _visPlanEndre = !_visPlanEndre)">@(_visPlanEndre ? "Ferdig med å endre planen" : "Endre faktureringsplanen")</button>
                <span>·</span>
            }
            <span>Bankgaranti @if (p.BankgarantiBelop is { } bg) {<b>@Kr(bg)</b>@(p.BankgarantiTil is { } til ? " til " : "")@if (p.BankgarantiTil is { } til2) {<b>@til2.ToString("dd.MM.yyyy")</b>}} else {<text>ikke lagt inn</text>}</span>
            <button type="button" class="pf-lenke" @onclick="@(() => _visBankgaranti = !_visBankgaranti)">@(_visBankgaranti ? "Lukk" : "Endre")</button>
        </div>

        @if (_visBankgaranti)
        {
            <div class="pf-endre">
                <label class="pf-felt">Beløp
                    <input class="pf-inn pf-tal" inputmode="decimal" value="@(p.BankgarantiBelop?.ToString("0", CultureInfo.InvariantCulture))" placeholder="@(f.Kontrakt > 0 ? Math.Round(f.Kontrakt * 0.1m).ToString("0", CultureInfo.InvariantCulture) : "")" @onchange="@(e => EndreProsjekt(x => x.BankgarantiBelop = LesTall(e)))" />
                </label>
                <label class="pf-felt">Gyldig til
                    <input type="date" class="pf-inn" value="@DatoVerdi(p.BankgarantiTil)" @onchange="@(e => EndreProsjekt(x => x.BankgarantiTil = LesDato(e)))" />
                </label>
                <p class="pf-dempet">Vanlig er 10 % av kontraktsummen i byggetiden og 3 % i reklamasjonstiden. Du får påminnelse to uker før datoen.</p>
            </div>
        }

        @if (_visPlanEndre && f.Akontoer.Count > 0)
        {
            <div class="pf-endre pf-endre-plan">
                <div class="pf-plan-valg">
                    <label class="pf-akonto-alle">Innestående på alle
                        <input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(plan.Count == 1 ? plan[0]?.ToString("0.##", CultureInfo.InvariantCulture) : "")" placeholder="0" @onchange="SettInnestaaendeAlle" aria-label="Innestående på alle akontoer i prosent" /> %
                    </label>
                    <button type="button" class="pf-knapp" @onclick="NyAkonto">+ Akonto</button>
                </div>
                <div class="pf-liste-ramme">
                    <table class="pf-liste">
                        <thead><tr><th>Nr</th><th>Milepæl</th><th>Beløp som</th><th class="n">Verdi</th><th class="n">Innestående %</th><th class="n">Klar ved utført %</th><th>Eller dato</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in f.Akontoer)
                            {
                                var rad = r;
                                var a = r.Akonto;
                                var laast = a.Status != AkontoStatus.Planlagt;
                                <tr>
                                    <td><b>@a.Nr</b></td>
                                    <td><input class="pf-inn" value="@a.Milepael" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Milepael = LesTekst(e) ?? x.Milepael))" aria-label="Milepæl" /></td>
                                    <td>
                                        <select class="pf-inn" disabled="@laast" @onchange="@(e => SettAkontoType(rad, e))" aria-label="Prosent eller beløp">
                                            <option value="pst" selected="@(a.Prosent is not null)">% av kontrakt</option>
                                            <option value="kr" selected="@(a.Prosent is null)">Fast beløp</option>
                                        </select>
                                    </td>
                                    <td class="n">
                                        @if (a.Prosent is not null)
                                        {
                                            <input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(a.Prosent?.ToString("0.##", CultureInfo.InvariantCulture))" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Prosent = LesTall(e) ?? 0))" aria-label="Prosent av kontrakt" />
                                        }
                                        else
                                        {
                                            <input class="pf-inn pf-tal" inputmode="decimal" value="@(a.Belop?.ToString("0", CultureInfo.InvariantCulture))" placeholder="Beløp" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.Belop = LesTall(e)))" aria-label="Fast beløp" />
                                        }
                                    </td>
                                    <td class="n"><input class="pf-inn pf-tal pf-smal" inputmode="decimal" value="@(a.InnestaaendeProsent?.ToString("0.##", CultureInfo.InvariantCulture))" placeholder="0" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.InnestaaendeProsent = LesProsent(e)))" aria-label="Innestående i prosent" /></td>
                                    <td class="n"><input class="pf-inn pf-tal pf-smal" inputmode="numeric" value="@a.FremdriftProsent" placeholder="–" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.FremdriftProsent = LesTall(e) is { } v ? (int)Math.Clamp(v, 0, 100) : null))" aria-label="Klar når så mange prosent er utført" /></td>
                                    <td><input type="date" class="pf-inn" value="@DatoVerdi(a.PlanlagtDato)" disabled="@laast" @onchange="@(e => EndreAkonto(a.Id, x => x.PlanlagtDato = LesDato(e)))" aria-label="Planlagt dato" /></td>
                                    <td class="n">@if (!laast) {<button type="button" class="pf-x" title="Fjern akontoen" @onclick="@(() => SlettAkonto(a.Id))">×</button>}</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>;
}
