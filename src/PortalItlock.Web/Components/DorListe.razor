    private List<Dor> MalDorer
    {
        get
        {
            var v = OmfangDorer;
            if (ErVarevalg)
            {
                v = _fraId is int f ? v.Where(d => d.Komponenter.Any(k => k.ComponentId == f)).ToList() : [];
            }
            return v.Where(d => !_utenfor.Contains(d.Id)).ToList();
        }
    }

    private sealed record VareIBruk(int Id, string Navn, int Antall);

    private List<VareIBruk> VarerPaDorene() => OmfangDorer
        .SelectMany(d => d.Komponenter.Where(k => k.Component is not null).Select(k => (d.Id, k.ComponentId, k.Component!.Navn)))
        .GroupBy(x => x.ComponentId)
        .Select(g => new VareIBruk(g.Key, g.First().Navn, g.Select(x => x.Id).Distinct().Count()))
        .OrderByDescending(v => v.Antall).ThenBy(v => v.Navn)
        .ToList();

    private async Task FraEndret(ChangeEventArgs e)
    {
        _fraId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _utenfor.Clear();
        _sammeType = [];
        if (_oppgave == "bytt" && _fraId is int fid)
        {
            var typeId = Dorer.SelectMany(d => d.Komponenter).FirstOrDefault(k => k.ComponentId == fid)?.Component?.ComponentTypeId;
            if (typeId is not null)
            {
                _sammeType = await Db.Components.AsNoTracking()
                    .Where(c => c.Aktiv && c.ComponentTypeId == typeId && c.Id != fid)
                    .OrderBy(c => c.Navn).Take(5).ToListAsync();
            }
        }
    }

