    private async Task SokVare(string felt, string q)
    {
        if (felt == "til") { _tilSok = q; _tilComp = null; _tilId = null; } else { _vareSok = q; _vareComp = null; _vareId = null; }
        var term = q.Trim();
        List<Component> treff = [];
        if (term.Length >= 2)
        {
            treff = await Db.Components.AsNoTracking().Include(c => c.Type)
                .Where(c => c.Aktiv && (EF.Functions.Like(c.Navn, $"%{term}%") || (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%")) || (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%"))))
                .OrderBy(c => c.Navn).Take(8).ToListAsync();
        }
        if (felt == "til") { _tilTreff = treff; } else { _vareTreff = treff; }
    }

    private void VelgVare(string felt, Component c)
    {
        if (felt == "til") { _tilComp = c; _tilId = c.Id; _tilSok = c.Navn; _tilTreff = []; }
        else { _vareComp = c; _vareId = c.Id; _vareSok = c.Navn; _vareTreff = []; }
    }

    private List<string> InfoForslag(string felt)
    {
        IEnumerable<string?> v = felt switch
        {
            "brann" => [.. Dorer.Select(d => d.Brann), "Ingen"],
            "lyd" => Dorer.Select(d => d.Lyd),
            "etasje" => Dorer.Select(d => d.Etasje),
            "sone" => Dorer.Select(d => d.Sone),
            "dortype" => Dorer.Select(d => d.Dortype),
            "slag" => ["H", "V", .. Dorer.Select(d => d.Slagretning)],
            "dortil" => Dorer.Select(d => d.DorTil),
            _ => []
        };
        return v.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()).Distinct().OrderBy(x => x, NaturligSammenligner.Instans).Take(10).ToList();
    }

    private bool Klar => _oppgave switch
    {
        "bytt" => _fraId is not null && _tilId is not null && _fraId != _tilId,
        "info" => _infoFelt is not null && !string.IsNullOrWhiteSpace(_infoVerdi),
        "fun" => _funValgt.Count > 0,
        "leggvare" => _vareId is not null && _antall > 0,
        "fjern" => _fraId is not null,
        "pakke" => _pakkeId is not null,
        "status" => _nyStatus is not null,
        _ => false
    };

    private int AntallEndres => MalDorer.Count(d => Endringer(d).Count > 0);

    private sealed record Endring(string Felt, string? Fra, string? Til);

    private string? InfoNaa(Dor d, string felt) => felt switch
    {
        "brann" => d.Brann, "lyd" => d.Lyd, "etasje" => d.Etasje, "rom" => d.Romnr, "dortil" => d.DorTil,
        "sone" => d.Sone, "dortype" => d.Dortype, "slag" => d.Slagretning, "notat" => d.Notater,
        "dorid" => _dorIdMaler.FirstOrDefault(m => m.Id == d.DorIdMalId)?.Kode,
        _ => null
    };

    private string? InfoNy(Dor d)
    {
        var v = _infoVerdi?.Trim();
        return _infoFelt switch
        {
            "brann" when v == "Ingen" => null,
            "notat" => string.IsNullOrWhiteSpace(d.Notater) ? v : $"{d.Notater}\n{v}",
            "dorid" => v == "0" ? null : _dorIdMaler.FirstOrDefault(m => m.Id.ToString() == v)?.Kode,
            _ => v
        };
    }

    private List<Endring> Endringer(Dor d)
    {
        var ut = new List<Endring>();
        switch (_oppgave)
        {
            case "info":
                {
                    var naa = InfoNaa(d, _infoFelt!);
                    var ny = InfoNy(d);
                    if ((naa ?? "") != (ny ?? ""))
                    {
                        ut.Add(new(InfoFelt.First(x => x.Key == _infoFelt).Navn, naa, _infoFelt == "notat" ? $"+ {_infoVerdi}" : ny));
                    }
                    break;
                }
            case "fun":
                foreach (var id in _funValgt)
                {
                    var f = _funksjoner.First(x => x.Id == id);
                    var har = d.Funksjoner.Any(x => x.Id == id);
                    if (!_funFjern && !har) ut.Add(new("Dørfunksjon", null, "+ " + FunKort(f)));
                    if (_funFjern && har) ut.Add(new("Dørfunksjon", "− " + FunKort(f), null));
                }
                break;
            case "leggvare":
                {
                    var finnes = d.Komponenter.FirstOrDefault(k => k.ComponentId == _vareId);
                    if (finnes is null) ut.Add(new("Vare", null, $"+ {_antall} × {_vareComp?.Navn}{(_somOpsjon ? " (opsjon)" : "")}"));
                    else if (finnes.ErOpsjon == _somOpsjon && finnes.Antall != _antall) ut.Add(new($"Antall {finnes.Component?.Navn}", finnes.Antall.ToString(), _antall.ToString()));
                    break;
                }
            case "fjern":
                foreach (var k in d.Komponenter.Where(k => k.ComponentId == _fraId))
                {
                    ut.Add(new("Vare", "− " + k.Component?.Navn + (k.ErOpsjon ? " (opsjon)" : ""), null));
                }
                break;
            case "bytt":
                if (d.Komponenter.Any(k => k.ComponentId == _fraId))
                {
                    ut.Add(new("Vare", d.Komponenter.First(k => k.ComponentId == _fraId).Component?.Navn, _tilComp?.Navn));
                }
                break;
            case "pakke":
                {
                    var naa = PakkeFor(d);
                    var ny = _pakker.First(p => p.Id == _pakkeId);
                    ut.Add(new("Pakke", naa?.Navn, naa?.Id == ny.Id ? $"{ny.Navn} (oppdateres)" : ny.Navn));
                    break;
                }
            case "status":
                if (d.Status != _nyStatus) ut.Add(new("Status", StatusTekst(d.Status), StatusTekst(_nyStatus!.Value)));
                break;
        }
        return ut;
    }

    private string Setning(int n)
    {
        var dd = $"<b>{n} {(n == 1 ? "dør" : "dører")}</b>";
        string E(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
        return _oppgave switch
        {
            "bytt" => $"Bytter {E(VarerPaDorene().FirstOrDefault(v => v.Id == _fraId)?.Navn)} med <b>{E(_tilComp?.Navn)}</b> på {dd}.",
            "info" => _infoFelt == "notat" ? $"Legger til merknaden <b>«{E(_infoVerdi)}»</b> på {dd}."
                : $"Setter {E(InfoFelt.First(x => x.Key == _infoFelt).Navn.ToLowerInvariant())} til <b>{E(_infoFelt == "dorid" ? (_infoVerdi == "0" ? "ingen" : _dorIdMaler.FirstOrDefault(m => m.Id.ToString() == _infoVerdi)?.Kode) : _infoFelt == "brann" && _infoVerdi == "Ingen" ? "ingen" : _infoVerdi)}</b> på {dd}.",
            "fun" => $"{(_funFjern ? "Fjerner" : "Legger til")} <b>{E(string.Join(", ", _funksjoner.Where(f => _funValgt.Contains(f.Id)).Select(FunKort)))}</b> på {dd}.",
            "leggvare" => $"Legger til <b>{_antall} × {E(_vareComp?.Navn)}</b>{(_somOpsjon ? " som opsjon" : "")} på {dd}.",
            "fjern" => $"Fjerner <b>{E(VarerPaDorene().FirstOrDefault(v => v.Id == _fraId)?.Navn)}</b> fra {dd}.",
            "pakke" => $"Setter pakken <b>{E(_pakker.FirstOrDefault(p => p.Id == _pakkeId)?.Navn)}</b> på {dd}.",
            "status" => $"Setter status <b>{StatusTekst(_nyStatus!.Value)}</b> på {dd}.",
            _ => ""
        };
    }

    private string? Advarsel()
    {
        var v = MalDorer;
        if (_oppgave == "bytt" && !_behold)
        {
            var m = v.Count(d => d.Komponenter.Any(k => k.ComponentId == _fraId && k.Montert));
            if (m > 0) return $"{m} av dørene har den gamle varen montert – den nye må monteres.";
        }
        if (_oppgave == "fjern")
        {
            var m = v.Count(d => d.Komponenter.Any(k => k.ComponentId == _fraId && k.Montert));
            if (m > 0) return $"{m} av dørene har varen montert. Det logges i komponenthistorikken.";
        }
        if (_oppgave == "pakke")
        {
            var m = v.Count(d => PakkeFor(d) is { } p && p.Id != _pakkeId);
            if (m > 0) return $"{m} {(m == 1 ? "dør bytter" : "dører bytter")} pakke – varene fra den gamle pakken fjernes.";
        }
        if (_oppgave == "info" && _infoFelt == "brann" && _infoVerdi == "Ingen")
        {
            var m = v.Count(d => !string.IsNullOrWhiteSpace(d.Brann));
            if (m > 0) return $"Brannklasse fjernes på {m} branndører.";
        }
        if (_oppgave == "status" && _nyStatus == MontasjeStatus.IkkeStartet)
        {
            var m = v.Count(d => d.Komponenter.Any(k => k.Montert));
            if (m > 0) return $"Montert-hakene fjernes på {m} dører.";
        }
        return null;
    }

    // ---------- Utføre, logg og angre ----------
    public sealed record KompSnap(int ComponentId, int Antall, string? Enhet, DorKomponentPlassering? Plassering, LevertAv LevertAv, bool Montert, DateTime? MontertDato, int? MontertAvBrukerId, bool ErOpsjon);
    public sealed record DorSnap(int DorId, string? Brann, string? Lyd, string? Etasje, string? Romnr, string? DorTil, string? Sone, string? Dortype, string? Slagretning,
        int? DorIdMalId, string? Notater, MontasjeStatus Status, DateTime? MontertDato, int? MontertAvBrukerId, int? PakkeId, string? PakkeKomponentIder, string? PakkeFunksjonIder,
        List<int> FunksjonIder, List<KompSnap> Komp);

    private static DorSnap Ta(Dor d) => new(d.Id, d.Brann, d.Lyd, d.Etasje, d.Romnr, d.DorTil, d.Sone, d.Dortype, d.Slagretning, d.DorIdMalId, d.Notater,
        d.Status, d.MontertDato, d.MontertAvBrukerId, d.PakkeId, d.PakkeKomponentIder, d.PakkeFunksjonIder,
        d.Funksjoner.Select(f => f.Id).ToList(),
        d.Komponenter.Select(k => new KompSnap(k.ComponentId, k.Antall, k.Enhet, k.Plassering, k.LevertAv, k.Montert, k.MontertDato, k.MontertAvBrukerId, k.ErOpsjon)).ToList());

    private void Logg(Dor d, string tekst) =>
        Db.DorHendelser.Add(new DorHendelse { DorId = d.Id, Beskrivelse = tekst, UtfortAvBrukerId = BrukerId });

    private static (int Mont, int Tot) Tall(Dor d) =>
        (d.Komponenter.Where(k => k.MonteresAvOss && k.Montert).Sum(k => k.BeslagAntall), d.Komponenter.Where(k => k.MonteresAvOss).Sum(k => k.BeslagAntall));

    // Statusen følger beslagene bare når endringen faktisk flytter montert-tallene:
    // en montert vare er tatt bort/byttet, eller en ferdig dør har fått nye beslag.
    // En dør som er satt ferdig for hånd uten avhukede beslag, beholder statusen.
    private void JusterStatus(Dor d, (int Mont, int Tot) foer)
    {
        var etter = Tall(d);
        if (etter.Mont != foer.Mont || (d.Status == MontasjeStatus.FerdigMontert && etter.Tot > foer.Tot && etter.Mont < etter.Tot))
        {
            OppdaterStatusFraBeslag(d);
        }
    }

    private void OppdaterStatusFraBeslag(Dor d)
    {
        var tot = d.Komponenter.Where(k => k.MonteresAvOss).Sum(k => k.BeslagAntall);
        if (tot == 0)
        {
            return;
        }
        var mont = d.Komponenter.Where(k => k.MonteresAvOss && k.Montert).Sum(k => k.BeslagAntall);
        var status = mont == 0 ? MontasjeStatus.IkkeStartet : mont < tot ? MontasjeStatus.Montert : MontasjeStatus.FerdigMontert;
        if (d.Status != status)
        {
            SettDorStatus(d, status);
        }
    }

    private void SettMontert(DorKomponent k, bool montert)
    {
        k.Montert = montert;
        k.MontertDato = montert ? DateTime.Now : null;
        k.MontertAvBrukerId = montert ? BrukerId : null;
        k.MontertAvBruker = montert ? Bruker : null;
    }

    private async Task Utfor()
    {
        if (!Klar || _lagrer)
        {
            return;
        }
        if (_oppgave == "status" ? !KanSetteStatus : !KanRedigere)
        {
            return;
        }
        _lagrer = true;
        try
        {
            var mal = MalDorer.Where(d => Endringer(d).Count > 0).ToList();
            var tekst = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(Setning(mal.Count), "<[^>]+>", ""));
            var snapshot = mal.Select(Ta).ToList();
            var berort = new HashSet<int>();
            Package? pakke = null;
            Component? til = null, vare = null;
            if (_oppgave == "pakke")
            {
                pakke = await Db.Packages.Include(p => p.Komponenter).ThenInclude(pc => pc.Component).ThenInclude(c => c!.Type)
                    .Include(p => p.DorFunksjoner).FirstAsync(p => p.Id == _pakkeId);
            }
            if (_oppgave == "bytt")
            {
                til = await Db.Components.Include(c => c.Type).FirstAsync(c => c.Id == _tilId);
            }
            if (_oppgave == "leggvare")
            {
                vare = await Db.Components.Include(c => c.Type).FirstAsync(c => c.Id == _vareId);
            }

            foreach (var d in mal)
            {
                var foer = Tall(d);
                switch (_oppgave)
                {
                    case "info":
                        var ny = InfoNy(d);
                        switch (_infoFelt)
                        {
                            case "brann": d.Brann = ny; break;
                            case "lyd": d.Lyd = ny; break;
                            case "etasje": d.Etasje = ny; break;
                            case "rom": d.Romnr = ny; break;
                            case "dortil": d.DorTil = ny; break;
                            case "sone": d.Sone = ny; break;
                            case "dortype": d.Dortype = ny; break;
                            case "slag": d.Slagretning = ny; break;
                            case "notat": d.Notater = ny; break;
                            case "dorid": d.DorIdMalId = _infoVerdi == "0" ? null : int.Parse(_infoVerdi!); break;
                        }
                        break;
                    case "fun":
                        foreach (var f in _funksjoner.Where(f => _funValgt.Contains(f.Id)))
                        {
                            var har = d.Funksjoner.FirstOrDefault(x => x.Id == f.Id);
                            if (_funFjern && har is not null) d.Funksjoner.Remove(har);
                            if (!_funFjern && har is null) d.Funksjoner.Add(f);
                        }
                        break;
                    case "leggvare":
                        {
                            var finnes = d.Komponenter.FirstOrDefault(k => k.ComponentId == vare!.Id);
                            if (finnes is null)
                            {
                                var dk = new DorKomponent { DorId = d.Id, ComponentId = vare!.Id, Component = vare, Antall = _antall, Enhet = vare.Enhet, ErOpsjon = _somOpsjon };
                                d.Komponenter.Add(dk);
                                Db.DorKomponenter.Add(dk);
                            }
                            else if (finnes.ErOpsjon == _somOpsjon)
                            {
                                finnes.Antall = _antall;
                            }
                            berort.Add(vare!.Id);
                            JusterStatus(d, foer);
                            break;
                        }
                    case "fjern":
                        foreach (var k in d.Komponenter.Where(k => k.ComponentId == _fraId).ToList())
                        {
                            d.Komponenter.Remove(k);
                            Db.DorKomponenter.Remove(k);
                        }
                        berort.Add(_fraId!.Value);
                        JusterStatus(d, foer);
                        break;
                    case "bytt":
                        {
                            var gammel = d.Komponenter.First(k => k.ComponentId == _fraId);
                            var finnesNy = d.Komponenter.FirstOrDefault(k => k.ComponentId == til!.Id);
                            if (finnesNy is not null)
                            {
                                finnesNy.Antall += gammel.Antall;
                            }
                            else
                            {
                                var dk = new DorKomponent
                                {
                                    DorId = d.Id, ComponentId = til!.Id, Component = til, Antall = gammel.Antall, Enhet = gammel.Enhet ?? til.Enhet,
                                    LevertAv = gammel.LevertAv, Plassering = gammel.Plassering, ErOpsjon = gammel.ErOpsjon
                                };
                                if (_behold && gammel.Montert)
                                {
                                    dk.Montert = true;
                                    dk.MontertDato = gammel.MontertDato;
                                    dk.MontertAvBrukerId = gammel.MontertAvBrukerId;
                                }
                                d.Komponenter.Add(dk);
                                Db.DorKomponenter.Add(dk);
                            }
                            d.Komponenter.Remove(gammel);
                            Db.DorKomponenter.Remove(gammel);
                            berort.Add(_fraId!.Value);
                            berort.Add(til!.Id);
                            JusterStatus(d, foer);
                            break;
                        }
                    case "pakke":
                        var r = DorPakkeService.Bruk(Db, d, pakke!, _pakker);
                        berort.UnionWith(r.Berort);
                        JusterStatus(d, foer);
                        break;
                    case "status":
                        foreach (var k in d.Komponenter.Where(k => k.MonteresAvOss))
                        {
                            if (_nyStatus == MontasjeStatus.FerdigMontert && !k.Montert) SettMontert(k, true);
                            if (_nyStatus == MontasjeStatus.IkkeStartet && k.Montert) SettMontert(k, false);
                        }
                        SettDorStatus(d, _nyStatus!.Value);
                        break;
                }
                Logg(d, "Masseoppdatert: " + tekst);
            }

            await Db.SaveChangesAsync();
            foreach (var id in berort)
            {
                await TilbudSync.SyncSylinderAsync(ProsjektId, id);
            }
            _angre = snapshot;
            _sistEndret = mal.Select(d => d.Id).ToHashSet();
            _melding = tekst.Replace("Bytter", "Byttet").Replace("Setter", "Satte").Replace("Legger til", "La til").Replace("Fjerner", "Fjernet");
            _dlg = null;
            await OnEndret.InvokeAsync();
        }
        finally
        {
            _lagrer = false;
        }
    }

    private async Task Angre()
    {
        if (_angre is null || _lagrer)
        {
            return;
        }
        _lagrer = true;
        try
        {
            foreach (var s in _angre)
            {
                var d = Dorer.FirstOrDefault(x => x.Id == s.DorId);
                if (d is null)
                {
                    continue;
                }
                d.Brann = s.Brann; d.Lyd = s.Lyd; d.Etasje = s.Etasje; d.Romnr = s.Romnr; d.DorTil = s.DorTil; d.Sone = s.Sone;
                d.Dortype = s.Dortype; d.Slagretning = s.Slagretning; d.DorIdMalId = s.DorIdMalId; d.Notater = s.Notater;
                d.PakkeId = s.PakkeId; d.PakkeKomponentIder = s.PakkeKomponentIder; d.PakkeFunksjonIder = s.PakkeFunksjonIder;
                if (d.Status != s.Status || d.MontertAvBrukerId != s.MontertAvBrukerId)
                {
                    d.MontertAvBruker = s.MontertAvBrukerId is int bid ? await Db.Brukere.FindAsync(bid) : null;
                    d.MontertAvBrukerId = s.MontertAvBrukerId;
                }
                d.Status = s.Status;
                d.MontertDato = s.MontertDato;

                foreach (var f in d.Funksjoner.Where(f => !s.FunksjonIder.Contains(f.Id)).ToList())
                {
                    d.Funksjoner.Remove(f);
                }
                foreach (var f in _funksjoner.Where(f => s.FunksjonIder.Contains(f.Id) && d.Funksjoner.All(x => x.Id != f.Id)))
                {
                    d.Funksjoner.Add(f);
                }

                foreach (var k in d.Komponenter.Where(k => s.Komp.All(x => x.ComponentId != k.ComponentId)).ToList())
                {
                    d.Komponenter.Remove(k);
                    Db.DorKomponenter.Remove(k);
                }
                foreach (var ks in s.Komp)
                {
                    var k = d.Komponenter.FirstOrDefault(x => x.ComponentId == ks.ComponentId);
                    if (k is null)
                    {
                        k = new DorKomponent { DorId = d.Id, ComponentId = ks.ComponentId, Component = await Db.Components.Include(c => c.Type).FirstOrDefaultAsync(c => c.Id == ks.ComponentId) };
                        d.Komponenter.Add(k);
                        Db.DorKomponenter.Add(k);
                    }
                    k.Antall = ks.Antall; k.Enhet = ks.Enhet; k.Plassering = ks.Plassering; k.LevertAv = ks.LevertAv; k.ErOpsjon = ks.ErOpsjon;
                    if (k.Montert != ks.Montert || k.MontertAvBrukerId != ks.MontertAvBrukerId)
                    {
                        k.MontertAvBruker = ks.MontertAvBrukerId is int mb ? await Db.Brukere.FindAsync(mb) : null;
                        k.MontertAvBrukerId = ks.MontertAvBrukerId;
                    }
                    k.Montert = ks.Montert;
                    k.MontertDato = ks.MontertDato;
                }
                Logg(d, "Angret masseoppdatering");
            }
            await Db.SaveChangesAsync();
            foreach (var id in _angre.SelectMany(s => s.Komp.Select(k => k.ComponentId)).Distinct())
            {
                await TilbudSync.SyncSylinderAsync(ProsjektId, id);
            }
            _sistEndret = _angre.Select(s => s.DorId).ToHashSet();
            _angre = null;
            _melding = "Endringen er angret.";
            await OnEndret.InvokeAsync();
        }
        finally
        {
            _lagrer = false;
        }
    }
}
