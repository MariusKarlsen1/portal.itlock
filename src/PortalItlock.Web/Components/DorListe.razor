    private RenderFragment Celle(string key, Dor d) => __builder =>
    {
        var dor = d;
        if (key == "dor")
        {
            <b>@d.Dornummer</b>
            if (Brannavvik.Contains(d.Id))
            {
                <span class="dl-varsel" title="Brannavvik - se Brannkontroll"><Icon Name="alert-triangle" /></span>
            }
            if (d.Komponenter.Any(k => k.ErOpsjon))
            {
                <span class="dl-ops">Opsjon</span>
            }
        }
        else if (key == "brann")
        {
            if (string.IsNullOrWhiteSpace(d.Brann))
            {
                <span class="dl-svak">–</span>
            }
            else
            {
                <span class="dl-brannpill dl-klikk" title="Filtrer på @d.Brann" @onclick:stopPropagation="true" @onclick='@(() => FiltrerPa("brann", dor.Brann!.Trim()))'>@d.Brann</span>
            }
        }
        else if (key == "fun")
        {
            foreach (var f in d.Funksjoner.IFastRekkefolge())
            {
                var kort = FunKort(f);
                <span class="dl-fun dl-klikk" title="@f.Navn – klikk for å filtrere" @onclick:stopPropagation="true" @onclick='@(() => FiltrerPa("fun", kort))'>@kort</span>
            }
        }
        else if (key == "beslag")
        {
            var tot = d.Komponenter.Where(k => k.MonteresAvOss).Sum(k => k.BeslagAntall);
            var mont = d.Komponenter.Where(k => k.MonteresAvOss && k.Montert).Sum(k => k.BeslagAntall);
            var farge = d.Status switch { MontasjeStatus.FerdigMontert => "#2e7d4f", MontasjeStatus.Montert => "#d4892b", _ => "#c9bda9" };
            <span class="dl-rad"><span class="dl-bar"><i style="width:@(tot == 0 ? 0 : mont * 100 / tot)%;background:@farge"></i></span><span class="dl-svak">@mont/@tot</span></span>
        }
        else if (key == "status")
        {
            <select class="dl-status @(d.Status switch { MontasjeStatus.FerdigMontert => "f", MontasjeStatus.Montert => "p", _ => "i" })" value="@d.Status" disabled="@(!KanSetteStatus)" @onclick:stopPropagation="true" @onchange="@(e => EndreStatus(dor, e))">
                <option value="@MontasjeStatus.IkkeStartet">Ikke startet</option>
                <option value="@MontasjeStatus.Montert">Pågår</option>
                <option value="@MontasjeStatus.FerdigMontert">Ferdig</option>
            </select>
        }
        else if (key.StartsWith("bs:"))
        {
            var type = key[3..];
            var liste = d.Komponenter.Where(k => k.Component is not null && string.Equals(TypeNavn(k), type, StringComparison.OrdinalIgnoreCase)).ToList();
            if (liste.Count == 0)
            {
                <span class="dl-svak">–</span>
            }
            foreach (var k in liste)
            {
                <div class="dl-bs">
                    <b title="@k.Component!.Navn">@k.Component.Navn</b>
                    <small>@k.Antall@(string.IsNullOrWhiteSpace(k.Enhet) ? "" : " " + k.Enhet) · @k.LevertAv · @(k.ErOpsjon ? "opsjon" : !k.MonteresAvOss ? "levert av andre" : k.Montert ? "✓ montert" : "ikke montert")</small>
                </div>
            }
        }
        else
        {
            var v = Verdier(key, d).ToList();
            var tekst = string.Join(", ", v.Where(x => x != Tom));
            if (tekst == "")
            {
                <span class="dl-svak">–</span>
            }
            else if (key is "etasje" or "sone" or "pakke" or "dortype" or "byggetrinn" or "dorid")
            {
                <span class="dl-klikk" title="Filtrer på @tekst" @onclick:stopPropagation="true" @onclick="@(() => FiltrerPa(key, v[0]))">@tekst</span>
            }
            else
            {
                @tekst
            }
        }
    };

