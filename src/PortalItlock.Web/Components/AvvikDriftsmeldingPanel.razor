@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

@* Driftsmeldinger og avvik A1 «Én liste» (Prototype driftsmeldinger og avvik enkel.html):
   driftsmeldinger og avvik i én liste med type, dør, hvor saken kom fra, dato og status.
   Filter Åpne/Alle, og knapper for ny driftsmelding og nytt avvik. *@
<div class="da">
    <div class="da-topp">
        <b>Driftsmeldinger og avvik</b>
        <button type="button" class="da-knapp" @onclick="@(() => { _visNyMelding = true; _meldingFeil = null; })" disabled="@(_dorer.Count == 0)"><Icon Name="plus" />Driftsmelding</button>
        <button type="button" class="da-knapp da-knapp-p" @onclick="@(() => _visMeldAvvik = true)" disabled="@(_dorer.Count == 0)"><Icon Name="plus" />Meld avvik</button>
    </div>

    @if (_visMeldAvvik)
    {
        <MeldAvvikDialog ProsjektId="ProsjektId" Dorer="_dorer" OnLukk="@(() => _visMeldAvvik = false)" OnMeldt="AvvikMeldt" />
    }

    @if (_visNyMelding)
    {
        <div class="da-ny">
            <b>Ny driftsmelding</b>
            <div class="da-ny-felt">
                <select @bind="_nyDorId">
                    <option value="">Velg dør …</option>
                    @foreach (var d in _dorer)
                    {
                        <option value="@d.Id">@d.Dornummer@(string.IsNullOrWhiteSpace(d.Romnr) ? "" : $" · {d.Romnr}")</option>
                    }
                </select>
                <input placeholder="Hva er feil? F.eks. «Kunden ringte: døren lukker ikke helt»" @bind="_nyTekst" @bind:event="oninput" />
            </div>
            @if (_meldingFeil is not null)
            {
                <span class="da-feil">@_meldingFeil</span>
            }
            <div class="da-ny-kn">
                <button type="button" class="da-knapp" @onclick="@(() => _visNyMelding = false)">Avbryt</button>
                <button type="button" class="da-knapp da-knapp-p" @onclick="LagreMelding" disabled="@(_nyDorId is null || string.IsNullOrWhiteSpace(_nyTekst))">Registrer</button>
            </div>
        </div>
    }

    <div class="da-filt">
        <button type="button" class="@(_visAlle ? "" : "pa")" @onclick="@(() => _visAlle = false)">Åpne (@Saker.Count(s => s.Apen))</button>
        <button type="button" class="@(_visAlle ? "pa" : "")" @onclick="@(() => _visAlle = true)">Alle (@Saker.Count)</button>
    </div>

    @{ var liste = Saker.Where(s => _visAlle || s.Apen).ToList(); }
    @if (liste.Count == 0)
    {
        <p class="da-tom">@(Saker.Count == 0 ? "Ingen driftsmeldinger eller avvik på avtalen ennå." : "Ingen åpne saker.")</p>
    }
    else
    {
        <div class="da-liste">
            @foreach (var s in liste)
            {
                <a @key="s.Nokkel" class="da-rad @(s.Apen ? "" : "lukket")" href="@s.Lenke">
                    <span class="da-type @(s.ErAvvik ? "av" : "dm")">@(s.ErAvvik ? "Avvik" : "Driftsmelding")</span>
                    <span class="da-dor">@s.Dor</span>
                    <span class="da-t">
                        <b>@s.Tittel</b>
                        <small>@(string.IsNullOrWhiteSpace(s.Rom) ? "" : $"{s.Rom} · ")@s.Kilde · @s.Dato.ToString("dd.MM.yyyy")</small>
                    </span>
                    <span class="da-st @s.Farge">@s.Status</span>
                    <span class="da-knapp">Åpne</span>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public int ProsjektId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private int? _naverendeBrukerId;

    private int? _loadedProsjektId;
    private List<Dor> _dorer = [];
    private List<Avvik> _avvik = [];
    private List<DriftHelper.MeldingStatus> _meldinger = [];
    private Dictionary<int, string> _rundeNavn = [];
    private bool _visAlle, _visMeldAvvik, _visNyMelding;
    private int? _nyDorId;
    private string _nyTekst = "";
    private string? _meldingFeil;

    private sealed record Sak(string Nokkel, bool ErAvvik, string Dor, string? Rom, string Tittel, string Kilde, DateTime Dato, string Status, string Farge, bool Apen, string Lenke);

    private List<Sak> Saker =>
        _avvik.Select(a => new Sak($"a{a.Id}", true, a.Dor?.Dornummer ?? "", a.Dor?.Romnr,
                a.Overskrift, AvvikKilde(a), a.OpprettetDato, a.Status.Visningsnavn(),
                a.Status == AvvikStatus.Apent ? "rod" : a.Status == AvvikStatus.SendtTilKunde ? "gul" : "gronn",
                a.Status != AvvikStatus.Godkjent && a.Status != AvvikStatus.Lukket, $"/avvik/{a.Id}"))
        .Concat(_meldinger.Select(m => new Sak($"m{m.Melding.Id}", false, m.Melding.Dor?.Dornummer ?? "", m.Melding.Dor?.Romnr,
                m.Melding.Tittel ?? m.Melding.Tekst, m.Melding.InnmeldtAvBruker is { } b ? $"Meldt av {b.Navn}" : "Driftsportalen",
                m.Melding.OpprettetDato, m.Navn, m.Steg == DriftHelper.Steg.Sendt ? "rod" : m.ErApen ? "gul" : "gronn",
                m.ErApen, $"/driftsmelding/{m.Melding.Id}")))
        .OrderByDescending(s => s.Apen).ThenByDescending(s => s.Dato)
        .ToList();

    private string AvvikKilde(Avvik a) =>
        a.ServicerundeDorId is { } id && _rundeNavn.TryGetValue(id, out var n) ? $"Fra servicerunden {n}" : "Registrert manuelt";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
            }
        }

        if (_loadedProsjektId == ProsjektId)
        {
            return;
        }

        _loadedProsjektId = ProsjektId;
        await LastAsync();
    }

    private async Task LastAsync()
    {
        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .OrderBy(d => d.Dornummer)
            .ToListAsync();

        _avvik = await Db.Avvik
            .Where(a => a.Dor!.ProsjektId == ProsjektId)
            .Include(a => a.Dor)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        var rdIder = _avvik.Where(a => a.ServicerundeDorId != null).Select(a => a.ServicerundeDorId!.Value).ToList();
        _rundeNavn = (await Db.ServicerundeDorer.AsNoTracking()
                .Where(d => rdIder.Contains(d.Id))
                .Select(d => new { d.Id, d.Servicerunde!.Dato })
                .ToListAsync())
            .ToDictionary(x => x.Id, x => $"{(x.Dato.Month <= 6 ? "Vår" : "Høst")} {x.Dato.Year}");

        _meldinger = await DriftHelper.HentMeldinger(Db, Db.Driftsmeldinger.Where(m => m.Dor!.ProsjektId == ProsjektId));
    }

    private async Task LagreMelding()
    {
        if (_nyDorId is not { } dorId || string.IsNullOrWhiteSpace(_nyTekst))
        {
            _meldingFeil = "Velg dør og skriv hva som er feil.";
            return;
        }
        // Registrert av en ansatt (f.eks. kunden ringte) – derfor allerede lest.
        Db.Driftsmeldinger.Add(new Driftsmelding
        {
            DorId = dorId,
            Tekst = _nyTekst.Trim(),
            InnmeldtAvBrukerId = _naverendeBrukerId,
            LestAvAnsatt = true,
            LestDato = DateTime.Now
        });
        await Db.SaveChangesAsync();
        _visNyMelding = false;
        _nyTekst = "";
        _nyDorId = null;
        await LastAsync();
    }

    private void AvvikMeldt(Avvik avvik)
    {
        _visMeldAvvik = false;
        avvik.Dor = _dorer.FirstOrDefault(d => d.Id == avvik.DorId);
        _avvik.Insert(0, avvik);
    }
}
