@using PortalItlock.Web.Services
@inject VisningPreferanseService VisningPref
@inject IJSRuntime JS

@* Felles ramme for alle rapportene under /rapporter (rapporter-forslag.html):
   tittel med datakilde, handlinger (eksport/utskrift), ett stort
   kort med periodevalg (hurtigvalg, år, egne datoer, sammenligning), valgfrie
   faner og utvid-knapp. Innholdet styles med rr-*-klassene herfra. *@
<div class="rr @(_full ? "rr-full" : "")">
    <div class="rr-topp">
        <div class="rr-topp-v">
            <span class="rr-ikon"><Icon Name="@Ikon" /></span>
            <div>
                <h1>@Tittel</h1>
                @if (!string.IsNullOrWhiteSpace(Undertittel))
                {
                    <p>@Undertittel</p>
                }
                @if (Kilde is not null)
                {
                    <span class="rr-kilde @(Kilde == "tripletex" ? "rr-kilde-tt" : "rr-kilde-portal")">
                        ● @(KildeTekst ?? (Kilde == "tripletex" ? "Fra Tripletex – fakturert" : "Fra portalen – ferdigmeldte arbeidsordre"))
                    </span>
                }
            </div>
        </div>
        <div class="rr-handl">
            @Handlinger
            @if (OnEksporter.HasDelegate)
            {
                <button type="button" class="rr-knapp" @onclick="OnEksporter"><Icon Name="download" />Eksporter</button>
            }
            @if (VisSkrivUt)
            {
                <button type="button" class="rr-knapp" @onclick="SkrivUt"><Icon Name="printer" />Skriv ut / PDF</button>
            }
        </div>
    </div>

    @if (UtenKort)
    {
        <div class="rr-uten-kort">@ChildContent</div>
    }
    else
    {
        <div class="rr-kort">
            <button type="button" class="rr-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="VekslFull">
                <Icon Name="@(_full ? "minimize" : "maximize")" />
            </button>

            @if (Periode is not null)
            {
                <div class="rr-periode">
                    <div class="rr-seg" role="group" aria-label="Periode">
                        <button type="button" class="@Pa(RapportPeriodeValg.DenneMaaned)" @onclick="@(() => Velg(RapportPeriodeValg.DenneMaaned))">Denne mnd</button>
                        <button type="button" class="@Pa(RapportPeriodeValg.ForrigeMaaned)" @onclick="@(() => Velg(RapportPeriodeValg.ForrigeMaaned))">Forrige mnd</button>
                        <button type="button" class="@Pa(RapportPeriodeValg.HittilIAr)" @onclick="@(() => Velg(RapportPeriodeValg.HittilIAr))">Hittil i år</button>
                        <label class="rr-ar @Pa(RapportPeriodeValg.Ar)">
                            <span>År</span>
                            <select value="@(Periode.Valg == RapportPeriodeValg.Ar ? Periode.Ar.ToString() : "")" @onchange="VelgAr" aria-label="Velg år">
                                <option value="">–</option>
                                @foreach (var ar in RapportPeriode.ValgbareAr())
                                {
                                    <option value="@ar">@ar</option>
                                }
                            </select>
                        </label>
                        @if (VisAlleValg)
                        {
                            <button type="button" class="@Pa(RapportPeriodeValg.Alle)" @onclick="@(() => Velg(RapportPeriodeValg.Alle))">Alle</button>
                        }
                        <button type="button" class="@Pa(RapportPeriodeValg.Egendefinert)" @onclick="@(() => Velg(RapportPeriodeValg.Egendefinert))">Egendefinert</button>
                    </div>

                    @if (Periode.Valg == RapportPeriodeValg.Egendefinert)
                    {
                        <span class="rr-datoer">
                            <input type="date" value="@Periode.Fra.ToString("yyyy-MM-dd")" @onchange="SettFra" aria-label="Fra dato" />
                            <span>–</span>
                            <input type="date" value="@Periode.Til.ToString("yyyy-MM-dd")" @onchange="SettTil" aria-label="Til dato" />
                        </span>
                    }
                    else
                    {
                        <span class="rr-dato">@Periode.Tekst</span>
                    }

                    @Filtre

                    @if (VisSammenlign && !Periode.ErAlle)
                    {
                        <label class="rr-sml">
                            <input type="checkbox" checked="@Periode.Sammenlign" @onchange="VekslSammenlign" />
                            <i></i>
                            Sammenlign med @Periode.SmlTekst
                        </label>
                    }

                    @if (Laster)
                    {
                        <span class="rr-laster">Henter …</span>
                    }
                </div>
            }

            @Faner

            <div class="rr-inn">
                @ChildContent
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Tittel { get; set; } = "";
    [Parameter] public string? Undertittel { get; set; }
    [Parameter] public string Ikon { get; set; } = "receipt";
    [Parameter] public string? Kilde { get; set; }
    [Parameter] public string? KildeTekst { get; set; }
    // Tilbakelenken til Rapporter er tatt bort - «Til hjem» øverst holder.
    [Parameter] public string Tilbake { get; set; } = "";
    [Parameter] public string TilbakeTekst { get; set; } = "Rapporter";
    [Parameter] public RenderFragment? Handlinger { get; set; }
    [Parameter] public RenderFragment? Filtre { get; set; }
    [Parameter] public RenderFragment? Faner { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RapportPeriode? Periode { get; set; }
    [Parameter] public EventCallback OnPeriodeEndret { get; set; }
    [Parameter] public EventCallback OnEksporter { get; set; }
    [Parameter] public bool VisSammenlign { get; set; }
    [Parameter] public bool VisAlleValg { get; set; }
    [Parameter] public bool VisSkrivUt { get; set; } = true;
    [Parameter] public bool UtenKort { get; set; }
    [Parameter] public bool Laster { get; set; }

    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync("rapport-bredde", "normal") == "full";
    }

    private string Pa(RapportPeriodeValg valg) => Periode?.Valg == valg ? "pa" : "";

    private async Task Velg(RapportPeriodeValg valg)
    {
        if (Periode is null)
        {
            return;
        }

        Periode.Sett(valg);
        if (valg != RapportPeriodeValg.Egendefinert)
        {
            await OnPeriodeEndret.InvokeAsync();
        }
    }

    private async Task VelgAr(ChangeEventArgs e)
    {
        if (Periode is null || !int.TryParse(e.Value?.ToString(), out var ar))
        {
            return;
        }

        Periode.Sett(RapportPeriodeValg.Ar, ar);
        await OnPeriodeEndret.InvokeAsync();
    }

    private async Task SettFra(ChangeEventArgs e)
    {
        if (Periode is not null && DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Periode.Fra = d;
            await OnPeriodeEndret.InvokeAsync();
        }
    }

    private async Task SettTil(ChangeEventArgs e)
    {
        if (Periode is not null && DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Periode.Til = d;
            await OnPeriodeEndret.InvokeAsync();
        }
    }

    private async Task VekslSammenlign(ChangeEventArgs e)
    {
        if (Periode is null)
        {
            return;
        }

        Periode.Sammenlign = e.Value is true;
        await OnPeriodeEndret.InvokeAsync();
    }

    private async Task VekslFull()
    {
        _full = !_full;
        await VisningPref.SettAsync("rapport-bredde", _full ? "full" : "normal");
    }

    private async Task SkrivUt() => await JS.InvokeVoidAsync("rapport.skrivUt");
}
