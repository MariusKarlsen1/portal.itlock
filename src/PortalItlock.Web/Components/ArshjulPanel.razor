@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ServiceVarselService VarselService

@* Årshjul "Hjul + måned" (oktober 2026): hver måned er et segment i hjulet
   (grønt = utført, rødt = forfalt, brunt/beige = gjenstår, tykkelse =
   estimerte timer) med en «i dag»-viser. Klikk en måned for rundene i
   listen ved siden av. Nøkkeltall, årvelger, varsel-e-post og tabellen over
   alle avtaler er beholdt. *@
<div class="aj-topp">
    <div class="arshjul-arsvelger">
        <button type="button" class="arshjul-arspil" title="Forrige år" @onclick="@(() => ByttAr(-1))" disabled="@(_valgtAr <= TidligsteAr)">
            <Icon Name="chevron-left" />
        </button>
        <select class="arshjul-arsvalg" @bind="_valgtAr" @bind:after="Beregn">
            @foreach (var ar in TilgjengeligeAr)
            {
                <option value="@ar">@ar</option>
            }
        </select>
        <button type="button" class="arshjul-arspil" title="Neste år" @onclick="@(() => ByttAr(1))" disabled="@(_valgtAr >= SenesteAr)">
            <Icon Name="chevron-right" />
        </button>
        @if (_valgtAr != DateTime.Today.Year)
        {
            <button type="button" class="arshjul-iar" @onclick="@(() => { _valgtAr = DateTime.Today.Year; _valgtManed = DateTime.Today.Month; Beregn(); })">I år</button>
        }
    </div>

    @if (Montorer.Count > 0)
    {
        <label class="aj-montor">
            <span>Montør</span>
            <select value="@(_montor ?? "")" @onchange="@(e => VelgMontor(string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()))">
                <option value="">Alle montører</option>
                @foreach (var m in Montorer)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </label>
    }

    @if (_erAdmin)
    {
        <button type="button" class="aj-knapp" @onclick="SendVarselNaa" disabled="@_sender"><Icon Name="mail" />@(_sender ? "Sender …" : "Send varsel-e-post nå")</button>
    }
</div>

@* Å3 (service-forslag.html): tallene i én ramme - utført, gjenstår, forfalt og
   varsel på e-post - og hjulet med statusfarger ved siden av måneden. *@
<div class="aj-kpi">
    <div class="aj-kpi-hoved">
        <span class="aj-lbl">Utført i @_valgtAr</span>
        <b>@_rader.Count(r => r.UtfortIAr) @(_rader.Count(r => r.UtfortIAr) == 1 ? "avtale" : "avtaler")</b>
        <small>@FormatTimer(TimerGjortIAr) estimert</small>
    </div>
    <div class="gul">
        <span class="aj-lbl">Gjenstår i @_valgtAr</span>
        <b>@_rader.Count(r => r.GjenstarIAr) @(_rader.Count(r => r.GjenstarIAr) == 1 ? "avtale" : "avtaler")</b>
        <small>@FormatTimer(TimerGjenstarIAr) estimert</small>
    </div>
    <div class="@(AntallForfalt > 0 ? "rod" : "")">
        <span class="aj-lbl">Forfalt</span>
        <b>@AntallForfalt @(AntallForfalt == 1 ? "runde" : "runder")</b>
        <small>@(AntallForfalt > 0 ? "må planlegges" : "ingenting forfalt")</small>
    </div>
    <div title="Varsel om avtaler som forfaller innen 14 dager sendes automatisk til mottakerne av påminnelser hver dag det er noe å varsle om.">
        <span class="aj-lbl">Varsel på e-post</span>
        <b class="aj-pa"><i></i>På</b>
        <small>avtaler som forfaller innen 14 dager</small>
    </div>
</div>
@if (_varselMelding is not null)
{
    <p class="save-success">@_varselMelding</p>
}

@if (_rader.Count == 0)
{
    <p class="list-empty">Ingen serviceavtaler registrert ennå.</p>
}
else
{
    var valgt = _maneder[_valgtManed - 1];
    <div class="aj-grid">
        <div class="aj-kort aj-hjul">
            <svg viewBox="0 0 400 400" role="img" aria-label="Årshjul @_valgtAr">
                @for (var i = 0; i < 12; i++)
                {
                    var m = _maneder[i];
                    var mnr = i + 1;
                    foreach (var s in Segmenter(i))
                    {
                        <path d="@s.Sti" fill="@s.Farge" class="aj-seg @(mnr == _valgtManed ? "valgt" : "")" @onclick="@(() => _valgtManed = mnr)"><title>@Kultur.DateTimeFormat.GetMonthName(mnr): @m.Hendelser.Count runder · @FormatTimer(m.Timer)</title></path>
                    }
                    var (lx, ly) = Punkt(76, Midtvinkel(i));
                    <g @onclick="@(() => _valgtManed = mnr)"><text x="@F(lx)" y="@F(ly + 4)" text-anchor="middle" class="aj-mnd @(mnr == _valgtManed ? "valgt" : "")">@ManedKort(mnr)</text></g>
                    @if (m.Timer > 0)
                    {
                        var (tx, ty) = Punkt(YtreRadius(m.Timer) + 13, Midtvinkel(i));
                        <g><text x="@F(tx)" y="@F(ty + 4)" text-anchor="middle" class="aj-timer">@KortTimer(m.Timer)</text></g>
                    }
                }
                @if (_valgtAr == DateTime.Today.Year)
                {
                    var v = (DateTime.Today.Month - 1 + (DateTime.Today.Day - 1) / (double)DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month)) / 12 * 2 * Math.PI - Math.PI / 2;
                    var (x1, y1) = Punkt(86, v);
                    var (x2, y2) = Punkt(192, v);
                    <line x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)" class="aj-idag" />
                }
                <circle cx="200" cy="200" r="60" class="aj-sentrum" />
                <text x="200" y="190" text-anchor="middle" class="aj-s1">@Kultur.TextInfo.ToTitleCase(Kultur.DateTimeFormat.GetMonthName(_valgtManed))</text>
                <text x="200" y="213" text-anchor="middle" class="aj-s2">@valgt.Hendelser.Count @(valgt.Hendelser.Count == 1 ? "runde" : "runder")</text>
                <text x="200" y="230" text-anchor="middle" class="aj-s3">@FormatTimer(valgt.Timer)</text>
            </svg>
            <div class="aj-legende">
                <span><i style="background:#2e7d4f"></i>Utført</span>
                <span><i style="background:#d9a520"></i>Gjenstår</span>
                <span><i style="background:#b23b22"></i>Forfalt</span>
                <span>Tykkelse = estimerte timer · klikk en måned</span>
            </div>
        </div>

        <div class="aj-kort">
            <div class="aj-mhode">
                <div>
                    <b>@Kultur.TextInfo.ToTitleCase(Kultur.DateTimeFormat.GetMonthName(_valgtManed)) @_valgtAr</b>
                    <span>@valgt.Hendelser.Count @(valgt.Hendelser.Count == 1 ? "runde" : "runder") · @valgt.Hendelser.Sum(h => h.Dorer) dører · @FormatTimer(valgt.Timer) estimert</span>
                </div>
                <div class="aj-pilknapper">
                    <button type="button" title="Forrige måned" @onclick="@(() => ByttManed(-1))"><Icon Name="chevron-left" /></button>
                    <button type="button" title="Neste måned" @onclick="@(() => ByttManed(1))"><Icon Name="chevron-right" /></button>
                </div>
            </div>
            @if (valgt.Hendelser.Count == 0)
            {
                <p class="aj-tom">Ingen servicerunder i denne måneden.</p>
            }
            @foreach (var h in valgt.Hendelser.OrderBy(h => h.Dato))
            {
                <a class="aj-rad" href="@($"/serviceavtaler/{h.ProsjektId}")" @key="@($"{h.ProsjektId}-{h.Dato:yyyyMMdd}-{h.Type}")">
                    <span class="aj-dato"><small>@ManedKort(h.Dato.Month)</small><b>@h.Dato.Day</b></span>
                    <span class="aj-navn"><b>@h.Navn</b><small>@(h.Dorer > 0 ? $"{h.Dorer} dører · " : "")@(h.Montor ?? "ingen montør")</small></span>
                    <span class="aj-tid">@(h.Timer > 0 ? FormatTimer(h.Timer) : "–")</span>
                    <span class="aj-status aj-st-@h.Type">@StatusTekst(h.Type)</span>
                </a>
            }
        </div>
    </div>

    <details class="aj-alle">
        <summary>Alle serviceavtaler i @_valgtAr (@_rader.Count)</summary>
        <div class="arshjul-tabell-kort">
            <table class="arshjul-tabell">
                <thead>
                    <tr>
                        <th>Avtale</th>
                        <th>Status i @_valgtAr</th>
                        <th>Neste planlagte service</th>
                        <th class="tall-kolonne">Estimerte timer pr besøk</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rader.OrderBy(r => r.NesteServiceDato ?? DateTime.MaxValue))
                    {
                        <tr @key="r.ProsjektId">
                            <td><a href="@($"/serviceavtaler/{r.ProsjektId}")">@r.Navn</a></td>
                            <td>
                                @if (r.UtfortIAr)
                                {
                                    <span class="arshjul-status arshjul-status-utfort">Utført i @_valgtAr</span>
                                }
                                else if (r.GjenstarIAr)
                                {
                                    <span class="arshjul-status arshjul-status-gjenstar">Gjenstår i @_valgtAr</span>
                                }
                                else
                                {
                                    <span class="arshjul-status arshjul-status-ingen">Ingen dato satt</span>
                                }
                            </td>
                            <td class="mono">@(r.NesteServiceDato?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td class="tall-kolonne mono">@FormatTimer(r.EstimerteTimer)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _erAdmin;
    private bool _sender;
    private string? _varselMelding;

    private sealed class AvtaleRad
    {
        public int ProsjektId { get; set; }
        public string Navn { get; set; } = "";
        public DateTime? NesteServiceDato { get; set; }
        public bool UtfortIAr { get; set; }
        public bool GjenstarIAr { get; set; }
        public decimal EstimerteTimer { get; set; }
    }

    // En runde i hjulet: utført ("u"), planlagt/gjenstår ("p") eller forfalt ("f").
    private sealed record Hendelse(int ProsjektId, string Navn, DateTime Dato, string Type, decimal Timer, int Dorer, string? Montor);

    private sealed class Maned
    {
        public List<Hendelse> Hendelser { get; } = [];
        public decimal Timer => Hendelser.Sum(h => h.Timer);
        public decimal Utfort => Hendelser.Where(h => h.Type == "u").Sum(h => h.Timer);
        public bool HarForfalt => Hendelser.Any(h => h.Type == "f");
    }

    private List<AvtaleRad> _rader = [];
    private Maned[] _maneder = Enumerable.Range(0, 12).Select(_ => new Maned()).ToArray();

    // Avtalene, rundene og minuttlinjene hentes én gang. Årsbyttet regnes om i
    // minnet - det er ingen grunn til å gå til databasen bare fordi man blar
    // ett år tilbake.
    private List<Prosjekt> _avtaler = [];
    private List<Servicerunde> _runder = [];
    private List<ServiceMinuttLinje> _minuttLinjer = [];
    private Dictionary<int, int> _dorer = [];

    private int _valgtAr = DateTime.Today.Year;
    private int _valgtManed = DateTime.Today.Month;
    private string? _montor;

    private decimal TimerGjortIAr => _rader.Where(r => r.UtfortIAr).Sum(r => r.EstimerteTimer);
    private decimal TimerGjenstarIAr => _rader.Where(r => r.GjenstarIAr).Sum(r => r.EstimerteTimer);
    private int AntallForfalt => _maneder.Sum(m => m.Hendelser.Count(h => h.Type == "f"));

    // Ansvarlig montør på avtalen, ellers den som utførte siste runde.
    private string? MontorFor(Prosjekt p) => p.AnsvarligMontor?.Navn
        ?? _runder.Where(r => r.ProsjektId == p.Id && !r.ErPlanlagt).OrderByDescending(r => r.Dato).FirstOrDefault()?.UtfortAvBruker?.Navn;

    private List<string> Montorer => _avtaler.Select(MontorFor).Where(n => n is not null).Select(n => n!).Distinct().OrderBy(n => n).ToList();

    // Årslista dekker fra den eldste registrerte servicerunden til ett år fram
    // i tid, slik at planlagt service neste år også er synlig.
    private int TidligsteAr => _runder.Count == 0
        ? DateTime.Today.Year
        : Math.Min(_runder.Min(r => r.Dato.Year), DateTime.Today.Year);

    private int SenesteAr
    {
        get
        {
            var fraNesteService = _runder
                .Where(r => r.NesteServiceDato.HasValue)
                .Select(r => r.NesteServiceDato!.Value.Year)
                .DefaultIfEmpty(DateTime.Today.Year)
                .Max();

            return Math.Max(DateTime.Today.Year + 1, fraNesteService);
        }
    }

    private List<int> TilgjengeligeAr =>
        Enumerable.Range(TidligsteAr, Math.Max(1, SenesteAr - TidligsteAr + 1)).Reverse().ToList();

    private void ByttAr(int steg)
    {
        _valgtAr = Math.Clamp(_valgtAr + steg, TidligsteAr, SenesteAr);
        Beregn();
    }

    private void ByttManed(int steg)
    {
        var m = _valgtManed + steg;
        if (m < 1 && _valgtAr > TidligsteAr) { _valgtAr--; m = 12; Beregn(); }
        else if (m > 12 && _valgtAr < SenesteAr) { _valgtAr++; m = 1; Beregn(); }
        _valgtManed = Math.Clamp(m, 1, 12);
    }

    private void VelgMontor(string? navn)
    {
        _montor = navn;
        Beregn();
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _erAdmin = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value is "Admin";
        }

        _avtaler = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .Include(p => p.AnsvarligMontor)
            .ToListAsync();

        var avtaleIder = _avtaler.Select(p => p.Id).ToList();

        _runder = await Db.Servicerunder
            .Where(r => avtaleIder.Contains(r.ProsjektId))
            .Include(r => r.UtfortAvBruker)
            .OrderByDescending(r => r.Dato)
            .ToListAsync();

        _minuttLinjer = await Db.ServiceMinuttLinjer
            .Where(l => avtaleIder.Contains(l.ProsjektId))
            .ToListAsync();

        _dorer = await Db.Dorer
            .Where(d => avtaleIder.Contains(d.ProsjektId))
            .GroupBy(d => d.ProsjektId)
            .Select(g => new { g.Key, Antall = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Antall);

        Beregn();
    }

    private void Beregn()
    {
        var avtaler = _avtaler.Where(p => _montor is null || MontorFor(p) == _montor).ToList();
        _maneder = Enumerable.Range(0, 12).Select(_ => new Maned()).ToArray();

        _rader = avtaler.Select(p =>
        {
            var proRunder = _runder.Where(r => r.ProsjektId == p.Id).ToList();
            var utforte = proRunder.Where(r => !r.ErPlanlagt).ToList();

            // "Neste planlagte service" er den ferskeste som er satt. Står man
            // i et tidligere år, er det datoen som ble planlagt den gangen som
            // er interessant - derfor den første som ikke ligger etter året.
            var nesteServiceDato = proRunder
                .Where(r => r.NesteServiceDato.HasValue && r.Dato.Year <= _valgtAr)
                .Select(r => r.NesteServiceDato)
                .FirstOrDefault()
                ?? proRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

            // Planlagte (ikke utførte) runder teller ikke som utført.
            var utfortIAr = utforte.Any(r => r.Dato.Year == _valgtAr);
            var gjenstarIAr = !utfortIAr && nesteServiceDato.HasValue && nesteServiceDato.Value.Year == _valgtAr
                && !utforte.Any(r => r.Dato >= nesteServiceDato.Value);

            var minutter = _minuttLinjer.Where(l => l.ProsjektId == p.Id).Sum(l => (l.Minutter ?? 0) * l.Antall);
            var timer = minutter / 60m;
            var dorer = _dorer.GetValueOrDefault(p.Id);
            var montor = MontorFor(p);

            // Hendelser til hjulet: utførte og planlagte runder i året, og neste
            // service dersom den faller i året og ikke allerede er dekket.
            foreach (var r in utforte.Where(r => r.Dato.Year == _valgtAr))
            {
                _maneder[r.Dato.Month - 1].Hendelser.Add(new Hendelse(p.Id, p.Navn, r.Dato, "u", timer, dorer, r.UtfortAvBruker?.Navn ?? montor));
            }
            foreach (var r in proRunder.Where(r => r.ErPlanlagt && r.Dato.Year == _valgtAr))
            {
                _maneder[r.Dato.Month - 1].Hendelser.Add(new Hendelse(p.Id, p.Navn, r.Dato, r.Dato.Date < DateTime.Today ? "f" : "p", timer, dorer, r.UtfortAvBruker?.Navn ?? montor));
            }
            if (nesteServiceDato is { } n && n.Year == _valgtAr
                && !utforte.Any(r => r.Dato >= n.AddDays(-20))
                && !proRunder.Any(r => r.ErPlanlagt && Math.Abs((r.Dato - n).TotalDays) < 20))
            {
                _maneder[n.Month - 1].Hendelser.Add(new Hendelse(p.Id, p.Navn, n, n.Date < DateTime.Today ? "f" : "p", timer, dorer, montor));
            }

            return new AvtaleRad
            {
                ProsjektId = p.Id,
                Navn = p.Navn,
                NesteServiceDato = nesteServiceDato,
                UtfortIAr = utfortIAr,
                GjenstarIAr = gjenstarIAr,
                EstimerteTimer = timer
            };
        }).ToList();
    }

    // ---------- hjulet ----------

    private sealed record Segment(string Sti, string Farge);

    private const double IndreRadius = 92;
    private decimal MaksTimer => Math.Max(1, _maneder.Max(m => m.Timer));

    private double YtreRadius(decimal timer) => timer <= 0 ? IndreRadius + 8 : IndreRadius + 14 + (double)(timer / MaksTimer) * 78;

    private static double Startvinkel(int i) => i / 12.0 * 2 * Math.PI - Math.PI / 2 + 0.025;
    private static double Sluttvinkel(int i) => (i + 1) / 12.0 * 2 * Math.PI - Math.PI / 2 - 0.025;
    private static double Midtvinkel(int i) => (Startvinkel(i) + Sluttvinkel(i)) / 2;
    private static (double X, double Y) Punkt(double r, double v) => (200 + r * Math.Cos(v), 200 + r * Math.Sin(v));
    private static string F(double d) => d.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Bue(double ra, double rb, double a0, double a1)
    {
        var (x1, y1) = Punkt(ra, a0);
        var (x2, y2) = Punkt(rb, a0);
        var (x3, y3) = Punkt(rb, a1);
        var (x4, y4) = Punkt(ra, a1);
        return $"M{F(x1)},{F(y1)} L{F(x2)},{F(y2)} A{F(rb)},{F(rb)} 0 0 1 {F(x3)},{F(y3)} L{F(x4)},{F(y4)} A{F(ra)},{F(ra)} 0 0 0 {F(x1)},{F(y1)} Z";
    }

    private List<Segment> Segmenter(int i)
    {
        var m = _maneder[i];
        var a0 = Startvinkel(i);
        var a1 = Sluttvinkel(i);
        var valgt = i + 1 == _valgtManed;

        if (m.Timer <= 0)
        {
            var r = m.Hendelser.Count > 0 ? IndreRadius + 14 : IndreRadius + 8;
            var farge = m.Hendelser.Count == 0 ? "#efe8dc" : m.HarForfalt ? "#b23b22" : m.Hendelser.All(h => h.Type == "u") ? "#2e7d4f" : "#d9a520";
            return [new Segment(Bue(IndreRadius, r, a0, a1), valgt && m.Hendelser.Count == 0 ? "#d9cbb6" : farge)];
        }

        var ytre = YtreRadius(m.Timer);
        var delt = IndreRadius + (ytre - IndreRadius) * (double)(m.Utfort / m.Timer);
        var segmenter = new List<Segment>();
        if (m.Utfort > 0)
        {
            segmenter.Add(new Segment(Bue(IndreRadius, delt, a0, a1), "#2e7d4f"));
        }
        if (m.Timer > m.Utfort)
        {
            segmenter.Add(new Segment(Bue(delt, ytre, a0, a1), m.HarForfalt ? "#b23b22" : "#d9a520"));
        }
        return segmenter;
    }

    private static string ManedKort(int m) => Kultur.DateTimeFormat.GetAbbreviatedMonthName(m).TrimEnd('.');

    private static string KortTimer(decimal t) => t >= 1 ? $"{Math.Round(t, 1).ToString("0.#", Kultur)} t" : $"{(int)Math.Round(t * 60)} m";

    private static string StatusTekst(string type) => type switch
    {
        "u" => "Utført",
        "f" => "Forfalt",
        _ => "Planlagt"
    };

    private async Task SendVarselNaa()
    {
        _sender = true;
        _varselMelding = null;
        try
        {
            var (sendt, antall) = await VarselService.SjekkOgSendVarselAsync(tvingSending: true);
            _varselMelding = sendt
                ? $"Varsel sendt til mottakerne av påminnelser ({antall} avtale(r) nærmer seg forfall)."
                : antall > 0
                    ? "Fant avtaler som nærmer seg forfall, men sending feilet - sjekk Resend-oppsettet."
                    : "Ingen avtaler nærmer seg forfall akkurat nå - ingen e-post sendt.";
        }
        finally
        {
            _sender = false;
        }
    }

    private static string FormatTimer(decimal timer)
    {
        var totaltMinutt = (int)Math.Round(timer * 60);
        var t = totaltMinutt / 60;
        var m = totaltMinutt % 60;
        return t > 0 ? $"{t}t {m}min" : $"{m}min";
    }
}
