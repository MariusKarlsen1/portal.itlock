@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ServiceVarselService VarselService

<p class="section-hint">Oversikt over alle serviceavtaler basert på "Neste planlagte service"-datoen som fylles ut når en servicerunde registreres, og estimerte timer fra Service-minutter på hver avtale.</p>

@if (_erAdmin)
{
    <div class="arshjul-varsel-banner">
        <button type="button" class="save-button" @onclick="SendVarselNaa" disabled="@_sender">Send varsel-epost nå</button>
        <span class="varsel-tekst">E-postvarsel om avtaler som nærmer seg forfall (innen 14 dager) sendes automatisk til marius&#64;itlock.no hver dag det er noe å varsle om. Denne knappen sender med en gang, uavhengig av om det er sendt i dag.</span>
        @if (_varselMelding is not null)
        {
            <p class="save-success">@_varselMelding</p>
        }
    </div>
}

@* Årshjulet viste bare inneværende år. Velgeren her lar deg se tidligere år
   også - alt på siden regnes om til det valgte året. *@
<div class="arshjul-arsvelger">
    <button type="button" class="arshjul-arspil" title="Forrige år" @onclick="@(() => ByttAr(-1))" disabled="@(_valgtAr <= TidligsteAr)">
        <Icon Name="chevron-left" />
    </button>
    <select class="arshjul-arsvalg" @bind="_valgtAr" @bind:after="Beregn">
        @foreach (var ar in TilgjengeligeAr)
        {
            <option value="@ar">@ar</option>
        }
    </select>
    <button type="button" class="arshjul-arspil" title="Neste år" @onclick="@(() => ByttAr(1))" disabled="@(_valgtAr >= SenesteAr)">
        <Icon Name="chevron-right" />
    </button>
    @if (_valgtAr != DateTime.Today.Year)
    {
        <button type="button" class="arshjul-iar" @onclick="@(() => { _valgtAr = DateTime.Today.Year; Beregn(); })">I år</button>
    }
</div>

<div class="nokkeltall">
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Utført i @_valgtAr</span>
        <span class="nokkel-verdi gronn">@_rader.Count(r => r.UtfortIAr)</span>
        <span class="nokkel-under">serviceavtaler</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Gjenstår i @_valgtAr</span>
        <span class="nokkel-verdi gul">@_rader.Count(r => r.GjenstarIAr)</span>
        <span class="nokkel-under">serviceavtaler</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Timer gjort i @_valgtAr</span>
        <span class="nokkel-verdi">@FormatTimer(TimerGjortIAr)</span>
        <span class="nokkel-under">estimert fra service-minutter</span>
    </div>
    <div class="nokkel-kort">
        <span class="nokkel-etikett">Timer gjenstående i @_valgtAr</span>
        <span class="nokkel-verdi">@FormatTimer(TimerGjenstarIAr)</span>
        <span class="nokkel-under">estimert fra service-minutter</span>
    </div>
</div>

@if (_rader.Count == 0)
{
    <p class="list-empty">Ingen serviceavtaler registrert ennå.</p>
}
else
{
    <div class="arshjul-tabell-kort">
        <table class="arshjul-tabell">
            <thead>
                <tr>
                    <th>Avtale</th>
                    <th>Status i @_valgtAr</th>
                    <th>Neste planlagte service</th>
                    <th class="tall-kolonne">Estimerte timer pr besøk</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rader.OrderBy(r => r.NesteServiceDato ?? DateTime.MaxValue))
                {
                    <tr @key="r.ProsjektId">
                        <td><a href="@($"/serviceavtaler/{r.ProsjektId}")">@r.Navn</a></td>
                        <td>
                            @if (r.UtfortIAr)
                            {
                                <span class="arshjul-status arshjul-status-utfort">Utført i @_valgtAr</span>
                            }
                            else if (r.GjenstarIAr)
                            {
                                <span class="arshjul-status arshjul-status-gjenstar">Gjenstår i @_valgtAr</span>
                            }
                            else
                            {
                                <span class="arshjul-status arshjul-status-ingen">Ingen dato satt</span>
                            }
                        </td>
                        <td class="mono">@(r.NesteServiceDato?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td class="tall-kolonne mono">@FormatTimer(r.EstimerteTimer)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _erAdmin;
    private bool _sender;
    private string? _varselMelding;

    private sealed class AvtaleRad
    {
        public int ProsjektId { get; set; }
        public string Navn { get; set; } = "";
        public DateTime? NesteServiceDato { get; set; }
        public bool UtfortIAr { get; set; }
        public bool GjenstarIAr { get; set; }
        public decimal EstimerteTimer { get; set; }
    }

    private List<AvtaleRad> _rader = [];

    // Avtalene, rundene og minuttlinjene hentes én gang. Årsbyttet regnes om i
    // minnet - det er ingen grunn til å gå til databasen bare fordi man blar
    // ett år tilbake.
    private List<Prosjekt> _avtaler = [];
    private List<Servicerunde> _runder = [];
    private List<ServiceMinuttLinje> _minuttLinjer = [];

    private int _valgtAr = DateTime.Today.Year;

    private decimal TimerGjortIAr => _rader.Where(r => r.UtfortIAr).Sum(r => r.EstimerteTimer);
    private decimal TimerGjenstarIAr => _rader.Where(r => r.GjenstarIAr).Sum(r => r.EstimerteTimer);

    // Årslista dekker fra den eldste registrerte servicerunden til ett år fram
    // i tid, slik at planlagt service neste år også er synlig.
    private int TidligsteAr => _runder.Count == 0
        ? DateTime.Today.Year
        : Math.Min(_runder.Min(r => r.Dato.Year), DateTime.Today.Year);

    private int SenesteAr
    {
        get
        {
            var fraNesteService = _runder
                .Where(r => r.NesteServiceDato.HasValue)
                .Select(r => r.NesteServiceDato!.Value.Year)
                .DefaultIfEmpty(DateTime.Today.Year)
                .Max();

            return Math.Max(DateTime.Today.Year + 1, fraNesteService);
        }
    }

    private List<int> TilgjengeligeAr =>
        Enumerable.Range(TidligsteAr, Math.Max(1, SenesteAr - TidligsteAr + 1)).Reverse().ToList();

    private void ByttAr(int steg)
    {
        _valgtAr = Math.Clamp(_valgtAr + steg, TidligsteAr, SenesteAr);
        Beregn();
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _erAdmin = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value is "Admin";
        }

        _avtaler = await Db.Prosjekter
            .Where(p => p.Status == ProsjektStatus.Serviceavtale)
            .ToListAsync();

        var avtaleIder = _avtaler.Select(p => p.Id).ToList();

        _runder = await Db.Servicerunder
            .Where(r => avtaleIder.Contains(r.ProsjektId))
            .OrderByDescending(r => r.Dato)
            .ToListAsync();

        _minuttLinjer = await Db.ServiceMinuttLinjer
            .Where(l => avtaleIder.Contains(l.ProsjektId))
            .ToListAsync();

        Beregn();
    }

    private void Beregn()
    {
        _rader = _avtaler.Select(p =>
        {
            var proRunder = _runder.Where(r => r.ProsjektId == p.Id).ToList();

            // "Neste planlagte service" er den ferskeste som er satt. Står man
            // i et tidligere år, er det datoen som ble planlagt den gangen som
            // er interessant - derfor den første som ikke ligger etter året.
            var nesteServiceDato = proRunder
                .Where(r => r.NesteServiceDato.HasValue && r.Dato.Year <= _valgtAr)
                .Select(r => r.NesteServiceDato)
                .FirstOrDefault()
                ?? proRunder.FirstOrDefault(r => r.NesteServiceDato.HasValue)?.NesteServiceDato;

            var utfortIAr = proRunder.Any(r => r.Dato.Year == _valgtAr);
            var gjenstarIAr = !utfortIAr && nesteServiceDato.HasValue && nesteServiceDato.Value.Year == _valgtAr
                && !proRunder.Any(r => r.Dato >= nesteServiceDato.Value);

            var minutter = _minuttLinjer.Where(l => l.ProsjektId == p.Id).Sum(l => (l.Minutter ?? 0) * l.Antall);

            return new AvtaleRad
            {
                ProsjektId = p.Id,
                Navn = p.Navn,
                NesteServiceDato = nesteServiceDato,
                UtfortIAr = utfortIAr,
                GjenstarIAr = gjenstarIAr,
                EstimerteTimer = minutter / 60m
            };
        }).ToList();
    }

    private async Task SendVarselNaa()
    {
        _sender = true;
        _varselMelding = null;
        try
        {
            var (sendt, antall) = await VarselService.SjekkOgSendVarselAsync(tvingSending: true);
            _varselMelding = sendt
                ? $"Varsel sendt til marius@itlock.no ({antall} avtale(r) nærmer seg forfall)."
                : antall > 0
                    ? "Fant avtaler som nærmer seg forfall, men sending feilet - sjekk Resend-oppsettet."
                    : "Ingen avtaler nærmer seg forfall akkurat nå - ingen e-post sendt.";
        }
        finally
        {
            _sender = false;
        }
    }

    private static string FormatTimer(decimal timer)
    {
        var totaltMinutt = (int)Math.Round(timer * 60);
        var t = totaltMinutt / 60;
        var m = totaltMinutt % 60;
        return t > 0 ? $"{t}t {m}min" : $"{m}min";
    }
}
