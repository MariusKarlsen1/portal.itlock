@* Full Kontroll-logoen: fire ruter (modulene) med hake i den siste, og
   ordmerket «Full» over «Kontroll». Fargene styres av CSS-variabler
   (--fk-r1..r4, --fk-hake, --fk-k) i app.css, så samme logo fungerer på lys
   bakgrunn og i mørk sidemeny/mørk modus. *@
<span class="fk-logo @Klasse" role="img" aria-label="Full Kontroll">
    <svg class="fk-logo-merke" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="5" y="5" width="25" height="25" rx="7" fill="var(--fk-r1)" />
        <rect x="34" y="5" width="25" height="25" rx="7" fill="var(--fk-r2)" />
        <rect x="5" y="34" width="25" height="25" rx="7" fill="var(--fk-r3)" />
        <rect x="34" y="34" width="25" height="25" rx="7" fill="var(--fk-r4)" />
        <path d="M40 46.5l4.5 4.5 8.5-9" fill="none" stroke="var(--fk-hake)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    @if (!BareMerke)
    {
        <span class="fk-ord"><b>Full</b><b class="fk-k">Kontroll</b></span>
    }
</span>

@code {
    [Parameter] public string? Klasse { get; set; }
    [Parameter] public bool BareMerke { get; set; }
}
