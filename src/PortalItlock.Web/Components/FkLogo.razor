@* Full Kontroll-logoen: ring i tre blå buer + ordmerke. Fargene styres av
   CSS-variabler (--fk-a1/2/3) og currentColor i app.css, så samme logo
   fungerer både på lys bakgrunn og i mørk sidemeny/mørk modus. *@
<span class="fk-logo @Klasse" role="img" aria-label="Full Kontroll">
    <svg class="fk-logo-merke" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="none" stroke-width="5" stroke-linecap="round">
            <path d="M16 3.5a12.5 12.5 0 0 1 10.8 6.25" stroke="var(--fk-a1)" />
            <path d="M27.8 14.2a12.5 12.5 0 0 1-8.2 13.7" stroke="var(--fk-a2)" />
            <path d="M14.8 28.4A12.5 12.5 0 0 1 4.2 11.7" stroke="var(--fk-a3)" />
        </g>
        <circle cx="16" cy="16" r="3.5" fill="currentColor" />
    </svg>
    @if (!BareMerke)
    {
        <b>Full Kontroll</b>
    }
</span>

@code {
    [Parameter] public string? Klasse { get; set; }
    [Parameter] public bool BareMerke { get; set; }
}
