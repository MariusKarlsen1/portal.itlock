@using PortalItlock.Web.Services
@inject SletteService Slette

@* Bekreftelse før sletting fra en liste. Viser hva som slettes sammen med
   oppføringen og hva som bare mister koblingen, lest fra datamodellen. *@
@if (Id is int id)
{
    <div class="sd-bak" @onclick="Avbryt">
        <div class="sd" role="alertdialog" aria-modal="true" aria-labelledby="sd-tittel" @onclick:stopPropagation="true">
            <div class="sd-ikon"><Icon Name="trash" /></div>
            <h2 id="sd-tittel">Slette @SletteService.Tittel(Type)?</h2>
            <p class="sd-navn">«@Navn»</p>
            @if (_konsekvens is null)
            {
                <p class="sd-tekst">Sjekker hva som henger sammen med @SletteService.Tittel(Type) …</p>
            }
            else
            {
                @if (_konsekvens.SlettesOgsa.Count > 0)
                {
                    <div class="sd-boks sd-rod">
                        <b>Dette slettes også:</b>
                        <span>@string.Join(", ", _konsekvens.SlettesOgsa)</span>
                    </div>
                }
                @if (_konsekvens.MisterKobling.Count > 0)
                {
                    <div class="sd-boks">
                        <b>Beholdes, men mister koblingen:</b>
                        <span>@string.Join(", ", _konsekvens.MisterKobling)</span>
                    </div>
                }
                <p class="sd-tekst">Slettingen kan ikke angres.</p>
            }
            @if (_feil is not null)
            {
                <p class="sd-feil">@_feil</p>
            }
            <div class="sd-knapper">
                <button type="button" class="sd-avbryt" @onclick="Avbryt">Avbryt</button>
                <button type="button" class="sd-slett" disabled="@(_sletter || _konsekvens is null)" @onclick="Bekreft">
                    @(_sletter ? "Sletter …" : "Slett for godt")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public SletteType Type { get; set; }
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Navn { get; set; }
    [Parameter] public EventCallback OnLukk { get; set; }
    [Parameter] public EventCallback<int> OnSlettet { get; set; }

    private SletteKonsekvens? _konsekvens;
    private int? _lastetFor;
    private bool _sletter;
    private string? _feil;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _lastetFor)
        {
            return;
        }
        _lastetFor = Id;
        _konsekvens = null;
        _feil = null;
        _sletter = false;
        if (Id is int id)
        {
            _konsekvens = await Slette.KonsekvensAsync(Type, id);
        }
    }

    private async Task Avbryt()
    {
        if (_sletter)
        {
            return;
        }
        await OnLukk.InvokeAsync();
    }

    private async Task Bekreft()
    {
        if (Id is not int id)
        {
            return;
        }
        _sletter = true;
        _feil = await Slette.SlettAsync(Type, id);
        _sletter = false;
        if (_feil is null)
        {
            await OnSlettet.InvokeAsync(id);
            await OnLukk.InvokeAsync();
        }
    }
}
