@if (Url is not null)
{
    <div class="pdf-modal-overlay" @onclick="Lukk">
        <div class="pdf-modal" @onclick:stopPropagation="true">
            <div class="pdf-modal-header">
                <span>@Tittel</span>
                <div class="pdf-modal-actions">
                    @if (OnSave.HasDelegate)
                    {
                        <button type="button" class="pdf-modal-save" disabled="@_lagrer" @onclick="Lagre">
                            @(_lagrer ? "Lagrer..." : SaveButtonText)
                        </button>
                    }
                    <button type="button" class="pdf-modal-close" @onclick="Lukk">✕</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(SaveMessage))
            {
                <p class="pdf-modal-message">@SaveMessage</p>
            }
            <iframe class="pdf-modal-frame" src="@Url" title="@Tittel"></iframe>
        </div>
    </div>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Tittel { get; set; } = "Forhåndsvisning";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public string SaveButtonText { get; set; } = "Lagre PDF";
    [Parameter] public string? SaveMessage { get; set; }

    private bool _lagrer;

    private async Task Lukk() => await OnClose.InvokeAsync();

    private async Task Lagre()
    {
        _lagrer = true;
        await OnSave.InvokeAsync();
        _lagrer = false;
    }
}
