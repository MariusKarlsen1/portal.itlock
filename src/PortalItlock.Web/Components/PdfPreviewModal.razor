@if (Url is not null)
{
    <div class="pdf-modal-overlay" @onclick="Lukk">
        <div class="pdf-modal" @onclick:stopPropagation="true">
            <div class="pdf-modal-header">
                <span>@Tittel</span>
                <button type="button" class="pdf-modal-close" @onclick="Lukk">✕</button>
            </div>
            <iframe class="pdf-modal-frame" src="@Url" title="@Tittel"></iframe>
        </div>
    </div>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Tittel { get; set; } = "Forhåndsvisning";
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Lukk() => await OnClose.InvokeAsync();
}
