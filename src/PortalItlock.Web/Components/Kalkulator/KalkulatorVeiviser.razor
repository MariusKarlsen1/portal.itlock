@* Felles veiviser for kalkulatorene (ARX og StepLock): ett spørsmål om gangen,
   fremdrift øverst, Tilbake/Neste og en bunnlinje med prisene. Hele
   kalkulatoren er ett kort med hvit topp og bunn og grå midt (forslag 2). *@
<div class="kv-side">
    <div class="kv-topp">
        <span></span>
        <div class="kv-tittel"><h1>@Tittel</h1><small>@Undertittel</small></div>
        <div class="kv-topp-h">
            <button type="button" class="kv-btn" @onclick="LeggTilTilbud">@TilbudTekst</button>
        </div>
    </div>

    @if (Merknad is not null && VisMerknad)
    {
        <div class="kv-merknad">@Merknad</div>
    }

    <div class="kv-sentrum">
        <div class="kv-linje"><i style="width:@(((Aktivt + 1) * 100.0 / Math.Max(1, Steg.Count)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
        <div class="kv-stegnavn">
            @for (var i = 0; i < Steg.Count; i++)
            {
                var nr = i;
                <button type="button" class="@(nr == Aktivt ? "aktiv" : nr < Aktivt ? "ferdig" : "")" @onclick="@(() => GaaTil(nr))">@(nr < Aktivt ? "✓ " : "")@Steg[nr]</button>
            }
        </div>

        <section class="kv-kort">
            <div class="kv-kort-h">
                <small>Steg @(Aktivt + 1) av @Steg.Count</small>
                <h2>@Sporsmal</h2>
                @if (!string.IsNullOrEmpty(Forklaring))
                {
                    <p>@Forklaring</p>
                }
            </div>
            <div class="kv-kort-b">@ChildContent</div>
            <div class="kv-nav">
                <button type="button" class="kv-btn kv-lys" style="visibility:@(Aktivt == 0 ? "hidden" : "visible")" @onclick="@(() => GaaTil(Aktivt - 1))">← Tilbake</button>
                @if (Aktivt < Steg.Count - 1)
                {
                    <button type="button" class="kv-btn" @onclick="@(() => GaaTil(Aktivt + 1))">@(Aktivt == Steg.Count - 2 ? "Se resultat →" : "Neste →")</button>
                }
                else
                {
                    <button type="button" class="kv-btn" @onclick="LeggTilTilbud">@TilbudTekst</button>
                }
            </div>
        </section>
    </div>

    <div class="kv-bunn">
        <span class="kv-bunn-tekst">@BunnTekst</span>
        <div class="kv-bunn-tall">@Tall</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Tittel { get; set; } = "";
    [Parameter] public string Undertittel { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<string> Steg { get; set; } = [];
    [Parameter] public int Aktivt { get; set; }
    [Parameter] public EventCallback<int> AktivtChanged { get; set; }
    [Parameter] public string Sporsmal { get; set; } = "";
    [Parameter] public string? Forklaring { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Merknad { get; set; }
    [Parameter] public bool VisMerknad { get; set; } = true;
    [Parameter] public string BunnTekst { get; set; } = "";
    [Parameter] public RenderFragment? Tall { get; set; }
    [Parameter] public string TilbudTekst { get; set; } = "Legg til i tilbud";
    [Parameter] public EventCallback OnLeggTilTilbud { get; set; }

    private async Task GaaTil(int i)
    {
        var ny = Math.Clamp(i, 0, Steg.Count - 1);
        if (ny == Aktivt) return;
        Aktivt = ny;
        await AktivtChanged.InvokeAsync(ny);
    }

    private Task LeggTilTilbud() => OnLeggTilTilbud.InvokeAsync();
}
