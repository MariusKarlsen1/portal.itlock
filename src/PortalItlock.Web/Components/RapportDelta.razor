@* Viser endring mot sammenligningsperioden: ▲ 12 % / ▼ 4 % (eller i kroner). *@
@if (For is decimal f)
{
    var diff = Naa - f;
    var opp = diff >= 0;
    <span class="rapport-delta @(opp ? "opp" : "ned")" title="@($"Mot {PortalItlock.Web.Services.RapportPeriode.Kr(f)}")">
        @(opp ? "▲" : "▼")
        @if (IKroner)
        {
            @PortalItlock.Web.Services.RapportPeriode.Tall(Math.Abs(diff))<text> kr</text>
        }
        else if (f == 0)
        {
            <text>ny</text>
        }
        else
        {
            @(Math.Abs(diff / f * 100).ToString("0", System.Globalization.CultureInfo.GetCultureInfo("nb-NO")))<text> %</text>
        }
    </span>
}

@code {
    [Parameter] public decimal Naa { get; set; }
    [Parameter] public decimal? For { get; set; }
    [Parameter] public bool IKroner { get; set; }
}
