@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject LagretPdfService LagretPdfService

@* L2 (plantegning-PDF-forslag): skuff over tegningen med lagrede PDF-er for både
   dørplantegningen og utstyr og kabeltrekk, i samme oppsett som PDF-fanen på
   tilbud (siste versjon + tidligere versjoner). PDF-ene åpnes i forhåndsvisning. *@
@if (Apen)
{
    <aside class="pps" aria-label="PDF-er">
        <div class="pps-topp">
            <h3>PDF-er</h3>
            <span class="pps-hoyre">
                <button type="button" class="pps-kn pps-kn-p" @onclick="OnLagNy"><Icon Name="plus" />Lag ny</button>
                <button type="button" class="pps-kn pps-kn-i" title="Lukk" aria-label="Lukk" @onclick="OnLukk"><Icon Name="x" /></button>
            </span>
        </div>
        <div class="pps-faner" role="tablist">
            @foreach (var (type, navn) in new[] { ("Plantegning", "Dørplantegning"), ("PlanUtstyr", "Kabeltrekk") })
            {
                var liste = type == "Plantegning" ? _dorPdfer : _utstyrPdfer;
                <button type="button" role="tab" class="@(_fane == type ? "pa" : "")" aria-selected="@(_fane == type ? "true" : "false")" @onclick="@(() => _fane = type)">
                    @navn <em>@liste.Count</em>
                </button>
            }
        </div>
        <div class="pps-innhold">
            <LagredePdfListe Pdfer="@(_fane == "Plantegning" ? _dorPdfer : _utstyrPdfer)" Versjonsvisning="true"
                             Tittel="@(_fane == "Plantegning" ? "Dørplantegning" : "Utstyr og kabeltrekk")" />
        </div>
    </aside>
}

@code {
    [Parameter] public int PlantegningId { get; set; }
    // "Plantegning" eller "PlanUtstyr" - siden skuffen åpnes fra.
    [Parameter] public string Aktiv { get; set; } = "Plantegning";
    [Parameter] public bool Apen { get; set; }
    // Økes av siden når en ny PDF er lagret, så listene hentes på nytt.
    [Parameter] public int Versjon { get; set; }
    [Parameter] public EventCallback OnLukk { get; set; }
    [Parameter] public EventCallback OnLagNy { get; set; }

    private List<LagretPdf> _dorPdfer = [];
    private List<LagretPdf> _utstyrPdfer = [];
    private string _fane = "Plantegning";
    private bool _varApen;
    private int _hentetVersjon = -1;

    // Listene hentes når skuffen åpnes og når siden har lagret en ny PDF.
    protected override async Task OnParametersSetAsync()
    {
        if (!Apen)
        {
            _varApen = false;
            return;
        }

        if (!_varApen || _hentetVersjon != Versjon)
        {
            if (!_varApen)
            {
                _fane = Aktiv;
            }
            _dorPdfer = await LagretPdfService.HentAsync("Plantegning", PlantegningId);
            _utstyrPdfer = await LagretPdfService.HentAsync("PlanUtstyr", PlantegningId);
            _hentetVersjon = Versjon;
        }
        _varApen = true;
    }
}
