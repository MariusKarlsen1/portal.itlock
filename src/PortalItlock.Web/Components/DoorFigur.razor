<img class="dor-figur" src="@Bilde" alt="Dørfigur" loading="lazy" />

@code {
    [Parameter]
    public string? AntallFloyer { get; set; }

    private string Bilde => AntallFloyer switch
    {
        "2-fløyet" => "/img/dorfigur-dobbel.png",
        "Skyvedør" => "/img/dorfigur-skyve.png",
        "Automatisk skyvedør" => "/img/dorfigur-auto-skyve.png",
        _ => "/img/dorfigur.png"
    };
}
