@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject ProsjektOppfolgingService OppfolgingSvc

@* Etterkalkylen på et overlevert prosjekt (G5): svaret i en setning, om tallene
   er komplette, og hva vi regnet med mot det det ble. Vurderingen og signeringen
   kommer fra siden rundt. *@
@if (!_lastet)
{
    <p class="ekv-tom">Regner ut …</p>
}
else if (_ek is null)
{
    <div class="ekv">
        <div class="ekv-tomboks"><b>Ingen kalkyle å sammenligne med</b><p>Prosjektet har ikke noe godkjent tilbud med beløp, så det finnes ingen kalkyle. Gjennomgangen kan likevel fylles ut, eller prosjektet kan avsluttes uten etterkalkyle.</p></div>
        <div class="ekv-to">
            <div class="ekv-fold">
                <details class="ekv-info">
                    <summary><Icon Name="list" />Per arbeidsordre og grunnlag</summary>
                    <div class="ekv-info-inni">@Grunnlag</div>
                </details>
            </div>
            @Vurdering
        </div>
        @Bunn
    </div>
}
else
{
    var ek = _ek;
    var (avvikTekst, avvikNiva) = ek.StorsteAvvik;
    var mangler = ek.Mangler;
    var maaSjekkes = mangler.Count(m => m.Kode is "timer" or "varer" or "faktura");
    var visSjekk = _visSjekk ?? maaSjekkes > 0;
    var (resultatTekst, resultatKlasse) = Forskjell(ek.ResultatAvvik, true);
    <div class="ekv">
        <p class="ekv-svar">@(ek.ManglerData ? "Timer eller varer er ikke registrert, så tallene under er ikke til å stole på ennå. Rett opp før du signerer." : ek.Forklaring)</p>

        <div class="ekv-oklinje">
            <span class="ekv-chip @(maaSjekkes == 0 ? "ekv-chip-gronn" : "ekv-chip-gul")"><span aria-hidden="true">@(maaSjekkes == 0 ? "✓" : "!")</span> @(maaSjekkes == 0 ? "Tallene er komplette" : maaSjekkes == 1 ? "1 ting må sjekkes" : $"{maaSjekkes} ting må sjekkes")</span>
            <span>Timer, varer og fakturering@(maaSjekkes == 0 ? " er sjekket" : "")</span>
            <button type="button" class="ekv-lenke" aria-expanded="@(visSjekk ? "true" : "false")" @onclick="@(() => _visSjekk = !visSjekk)">@(visSjekk ? "Skjul" : "Se og rett") ›</button>
        </div>
        @if (visSjekk)
        {
            <div class="ekv-sjekk">
                @if (mangler.FirstOrDefault(m => m.Kode == "timer") is { } mt)
                {
                    @Sjekk(false, mt.Tittel, mt.Tekst, @<a class="ekv-knapp" href="/timegodkjenning">Til timeføring</a>)
                }
                else if (ek.O.FaktiskTimerVenter > 0)
                {
                    @Sjekk(true, $"{ek.O.FaktiskTimer.ToString("0.#", Kultur)} t er ført, {ek.O.FaktiskTimerVenter.ToString("0.#", Kultur)} t venter på godkjenning", "Timer som ikke er godkjent, kan bli endret.", @<a class="ekv-knapp" href="/timegodkjenning">Godkjenn timer</a>)
                }
                else if (ek.O.FaktiskTimer > 0)
                {
                    @Sjekk(true, $"{ek.O.FaktiskTimer.ToString("0.#", Kultur)} t er ført og godkjent", null, null)
                }
                else
                {
                    @Sjekk(true, "Ingen timer i kalkylen og ingen ført", null, null)
                }

                @if (ek.O.VarerFraLager)
                {
                    @Sjekk(true, $"Varer er tatt ut fra lageret ({KrKort(ek.FaktiskVarer)})", null, null)
                }
                else if (ek.KalkVarer > 0 || ek.O.VarerManuell)
                {
                    var anslatt = mangler.Any(m => m.Kode == "varer");
                    @Sjekk(!anslatt,
                        anslatt ? "Varene er anslått fra tilbudet" : $"Faktisk varekost er lagt inn for hånd ({KrKort(ek.FaktiskVarer)})",
                        anslatt ? "Ingen uttak fra lageret er registrert, så varene ser ut til å treffe kalkylen. Legg inn det varene faktisk kostet, for eksempel fra prosjektrapporten i Tripletex." : "Tøm feltet og lagre for å gå tilbake til anslaget fra tilbudet.",
                        @<span class="ekv-varsel-felt">
                            <input class="ekv-inn" inputmode="decimal" placeholder="Faktisk varekost" value="@(_varekost?.ToString("0", CultureInfo.InvariantCulture))" @onchange="@(e => _varekost = LesTall(e))" aria-label="Faktisk varekost" />
                            <button type="button" class="ekv-knapp @(anslatt ? "ekv-knapp-p" : "")" @onclick="LagreVarekost">Lagre</button>
                        </span>)
                }
                else
                {
                    @Sjekk(true, "Ingen varer i kalkylen", null, null)
                }

                @if (mangler.FirstOrDefault(m => m.Kode == "faktura") is { } mf)
                {
                    @Sjekk(false, mf.Tittel, mf.Tekst, @<a class="ekv-knapp" href="@($"/prosjekter/{ProsjektId}")">Til prosjektet</a>)
                }
                else
                {
                    @Sjekk(true, "Alt er fakturert", null, null)
                }
            </div>
        }

        <div class="ekv-to">
            <div class="ekv-venstre">
                <div class="ekv-liste-ramme">
                    <table class="ekv-liste">
                        <thead><tr><th></th><th class="n">Vi regnet med</th><th class="n">Det ble</th><th class="n">Forskjell</th></tr></thead>
                        <tbody>
                            @RadEnkel("Kunden betalte", ek.Endringer != 0 || ek.Indeks != 0 ? $"Med endringer {KrKort(ek.Endringer)}{(ek.Indeks != 0 ? $" og indeks {KrKort(ek.Indeks)}" : "")}" : null, ek.KalkInntekt, ek.FaktiskInntekt, true)
                            @RadEnkel("Varer kostet", ek.O.VarerFraLager ? "Uttak fra lageret" : ek.O.VarerManuell ? "Lagt inn for hånd" : "Anslått, ikke registrert", ek.KalkVarer, ek.FaktiskVarer, false)
                            @RadEnkel("Arbeid kostet", $"{ek.O.BudsjettTimer.ToString("0.#", Kultur)} t kalkulert, {ek.O.FaktiskTimer.ToString("0.#", Kultur)} t faktisk", ek.KalkLonn, ek.FaktiskLonn, false)
                            @if (ek.KalkAndre != 0 || ek.FaktiskAndre != 0)
                            {
                                @RadEnkel("Kjøring og tillegg kostet", ek.O.AndreRegistrert ? "Ført på arbeidsordrene" : "Anslått etter fremdriften", ek.KalkAndre, ek.FaktiskAndre, false)
                            }
                        </tbody>
                        <tfoot>
                            <tr><td>Vi tjente</td><td class="n">@KrKort(ek.KalkResultat)</td><td class="n">@KrKort(ek.FaktiskResultat)</td><td class="n @resultatKlasse">@resultatTekst</td></tr>
                            <tr><td>Dekningsgrad</td><td class="n">@DG(ek.KalkDG)</td><td class="n">@DG(ek.FaktiskDG)</td><td class="n @Farge(ek.DgPoeng)">@(Math.Abs(ek.DgPoeng) < 0.05m ? "0 poeng" : $"{Math.Abs(ek.DgPoeng).ToString("0.0", Kultur)} poeng {(ek.DgPoeng > 0 ? "høyere" : "lavere")}")</td></tr>
                        </tfoot>
                    </table>
                </div>

                <div class="ekv-fold">
                    <details class="ekv-info">
                        <summary><Icon Name="list" />Hvor ble avviket av?</summary>
                        <div class="ekv-info-inni">
                            <div class="ekv-liste-ramme">
                                <table class="ekv-liste">
                                    <tbody>
                                        @foreach (var x in ek.Bidrag)
                                        {
                                            <tr>
                                                <td>@if (x.Total) {<b>@x.Tekst</b>} else {@x.Tekst}</td>
                                                <td class="n @(x.Total ? "" : Farge(x.Belop))">@(x.Total ? KrKort(x.Belop) : Fortegn(x.Belop) + " kr")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="ekv-fot">Største avvik: <b class="ekv-@NivaKlasse(avvikNiva)">@avvikTekst</b>.</p>
                        </div>
                    </details>
                    <details class="ekv-info">
                        <summary><Icon Name="file-text" />Mer om prosjektet</summary>
                        <div class="ekv-info-inni">
                            <div class="ekv-liste-ramme">
                                <table class="ekv-liste">
                                    <thead><tr><th>Per post</th><th class="n">Kunden betalte</th><th class="n">Kost vi regnet med</th><th class="n">Kost det ble</th><th class="n">Fortjeneste</th></tr></thead>
                                    <tbody>
                                        @if (ek.SalgArbeid != 0 || ek.KalkLonn != 0 || ek.FaktiskLonn != 0)
                                        {
                                            @Post("Arbeid", ek.SalgArbeid, ek.KalkLonn, ek.FaktiskLonn)
                                        }
                                        @Post("Varer", ek.SalgVarer, ek.KalkVarer, ek.FaktiskVarer)
                                        @if (ek.KalkAndre != 0 || ek.FaktiskAndre != 0 || ek.SalgAndre != 0)
                                        {
                                            @Post("Kjøring og tillegg", ek.SalgAndre, ek.KalkAndre, ek.FaktiskAndre)
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="ekv-liste-ramme">
                                <table class="ekv-liste">
                                    <tbody>
                                        <tr><td>Overlevert</td><td class="n">@(ek.Overlevert?.ToString("dd.MM.yyyy", Kultur) ?? "–")@if (ek.DagerOverFrist is { } dager) {<small class="@(dager > 0 ? "ekv-rod" : "ekv-gronn")">@(dager > 0 ? $"{dager} dager over fristen" : dager == 0 ? "på fristen" : $"{-dager} dager før fristen")</small>} else {<small>ingen frist lagt inn</small>}</td></tr>
                                        <tr><td>Timer</td><td class="n">@ek.O.FaktiskTimer.ToString("0.#", Kultur) t av @ek.O.BudsjettTimer.ToString("0.#", Kultur) t</td></tr>
                                        <tr><td>Fakturert</td><td class="n">@KrKort(ek.Fakturert)@if (ek.FaktiskInntekt > 0) {<small>@Math.Round(ek.Fakturert / ek.FaktiskInntekt * 100).ToString("0", Kultur) % av prosjektsummen</small>}</td></tr>
                                        <tr><td>Fremdriftsplanen</td><td class="n">@(ek.PlanTotal > 0 ? $"{ek.PlanFerdig} av {ek.PlanTotal} oppgaver avsluttet" : "Ingen plan")</td></tr>
                                        <tr><td>Godkjente endringer</td><td class="n">@ek.Endringsmeldinger.Count(e => e.Tilbud.Status == EndringsmeldingStatus.Godkjent) · @KrKort(ek.Endringer)@(ek.Endringsmeldinger.Where(e => e.Tilbud.Status == EndringsmeldingStatus.Godkjent).Sum(e => e.Tilbud.FristforlengelseDager ?? 0) is > 0 and var d ? $" · +{d} dager" : "")</td></tr>
                                        @if (_timer.Count > 0)
                                        {
                                            <tr><td>Timer per aktivitet</td><td class="n">@string.Join(" · ", _timer.Take(4).Select(t => $"{t.Aktivitet.Visningsnavn()} {t.Timer:0} t"))</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                    <details class="ekv-info">
                        <summary><Icon Name="list" />Per arbeidsordre og grunnlag</summary>
                        <div class="ekv-info-inni">@Grunnlag</div>
                    </details>
                </div>
            </div>
            @Vurdering
        </div>
        @Bunn
    </div>
}

@code {
    [Parameter] public int ProsjektId { get; set; }
    [Parameter] public Func<Func<Task>, Task> Kjor { get; set; } = arbeid => arbeid();
    [Parameter] public DateTime Oppdatert { get; set; }

    // Kalles når tallene er endret her (faktisk varekost), så siden rundt kan regne om.
    [Parameter] public EventCallback Endret { get; set; }

    // Vurderingen til høyre, linjen med signering nederst og grunnlaget per arbeidsordre.
    [Parameter] public RenderFragment? Vurdering { get; set; }
    [Parameter] public RenderFragment? Bunn { get; set; }
    [Parameter] public RenderFragment? Grunnlag { get; set; }

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private ProsjektOppfolgingService.Etterkalkyle? _ek;
    private List<(TimeAktivitet Aktivitet, decimal Timer)> _timer = [];
    private decimal? _varekost;
    private bool _lastet;
    private bool? _visSjekk;
    private int _lastetFor;
    private DateTime _lastetTid;

    public ProsjektOppfolgingService.Etterkalkyle? Tall => _ek;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastetFor != ProsjektId || _lastetTid != Oppdatert)
        {
            _lastetFor = ProsjektId;
            _lastetTid = Oppdatert;
            await Kjor(LastAsync);
        }
    }

    private async Task LastAsync()
    {
        _ek = await OppfolgingSvc.EtterkalkyleAsync(ProsjektId);
        _varekost = (await Db.Prosjekter.AsNoTracking().Where(p => p.Id == ProsjektId).Select(p => p.FaktiskVarekost).FirstOrDefaultAsync());
        _timer = (await Db.Timeregistreringer.AsNoTracking()
                .Where(t => t.Arbeidsordre!.ProsjektId == ProsjektId && t.Status != TimeregistreringStatus.Avslatt)
                .Select(t => new { t.Aktivitet, t.Start, t.Slutt, t.PauseMinutter }).ToListAsync())
            .GroupBy(t => t.Aktivitet)
            .Select(g => (g.Key, g.Sum(t => Math.Max(0, (decimal)(t.Slutt - t.Start).TotalHours - t.PauseMinutter / 60m))))
            .OrderByDescending(x => x.Item2).ToList();
        _lastet = true;
    }

    private async Task LagreVarekost()
    {
        await Kjor(async () =>
        {
            await OppfolgingSvc.SettFaktiskVarekostAsync(ProsjektId, _varekost);
            await LastAsync();
        });
        await Endret.InvokeAsync();
    }

    private static decimal? LesTall(ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;

    private static string KrKort(decimal v) => v.ToString("#,##0", Kultur) + " kr";
    private static string Fortegn(decimal v) => Math.Abs(v) < 1 ? "0" : (v > 0 ? "+" : "−") + Math.Abs(v).ToString("#,##0", Kultur);
    private static string DG(decimal? v) => v is { } d ? (d * 100).ToString("0.0", Kultur) + " %" : "–";
    private static string Farge(decimal v) => Math.Abs(v) < 0.5m ? "" : v > 0 ? "ekv-gronn" : "ekv-rod";
    private static string Css(double v) => Math.Clamp(v, 0, 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string NivaKlasse(ProsjektOppfolgingService.Niva n) => n switch
    {
        ProsjektOppfolgingService.Niva.Rod => "rod",
        ProsjektOppfolgingService.Niva.Gul => "gul",
        _ => "gronn"
    };

    // Forskjellen i vanlige ord. For inntekter og fortjeneste er mer bra, for kostnader dårlig.
    private static (string Tekst, string Klasse) Forskjell(decimal avvik, bool merErBra) =>
        Math.Abs(avvik) < 1 ? ("0 kr", "") : (KrKort(Math.Abs(avvik)) + (avvik > 0 ? " mer" : " mindre"), avvik > 0 == merErBra ? "ekv-gronn" : "ekv-rod");

    private RenderFragment RadEnkel(string navn, string? merknad, decimal kalkyle, decimal faktisk, bool merErBra) => @<tr>
        @{
            var (tekst, klasse) = Forskjell(faktisk - kalkyle, merErBra);
        }
        <td><b>@navn</b>@if (merknad is not null) {<small>@merknad</small>}</td>
        <td class="n">@KrKort(kalkyle)</td>
        <td class="n">@KrKort(faktisk)</td>
        <td class="n @klasse">@tekst</td>
    </tr>;

    // En linje i «Er tallene komplette?»: grønn hake eller gult utropstegn, med en handling.
    private static RenderFragment Sjekk(bool ok, string tittel, string? tekst, RenderFragment? handling) => @<div class="ekv-sjekk-rad">
        <span class="ekv-sjekk-ik @(ok ? "ok" : "nei")">@(ok ? "✓" : "!")</span>
        <span class="ekv-sjekk-tekst"><b>@tittel</b>@if (!string.IsNullOrEmpty(tekst)) {<small>@tekst</small>}</span>
        @if (handling is not null)
        {
            <span class="ekv-sjekk-handling">@handling</span>
        }
    </div>;

    private static RenderFragment Post(string navn, decimal salg, decimal kalk, decimal faktisk) => @<tr>
        <td>@navn</td>
        <td class="n">@(salg > 0 ? KrKort(salg) : "–")</td>
        <td class="n">@KrKort(kalk)</td>
        <td class="n">@KrKort(faktisk)</td>
        <td class="n @(salg - faktisk < 0 ? "ekv-rod" : "")">@KrKort(salg - faktisk)</td>
    </tr>;
}
