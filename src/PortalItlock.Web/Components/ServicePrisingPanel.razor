    // Hele kroner med mellomrom, som ellers i portalen: «kr 6 360».
    private static string Kr(decimal v) => "kr " + Math.Round(v).ToString("#,##0", Kultur);

    private static string KatFarge(string navn)
    {
        var n = navn.ToLowerInvariant();
        return n.Contains("automatikk") ? "#B42318" : n.Contains("rømning") ? "#D99A0B" : n.Contains("elektrisk") || n.Contains("adgang") ? "#1F4E8C" : "#7A818A";
    }

    private string FormatKr(decimal verdi) => $"{verdi.ToString("N2", Kultur)} kr";
