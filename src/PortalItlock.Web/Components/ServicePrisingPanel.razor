    private async Task LagreTilbud()
    {
        if (_prosjekt is null)
        {
            return;
        }
        _prosjekt.ServiceavtaleTekst = string.IsNullOrWhiteSpace(_avtaleTekst) ? null : _avtaleTekst;
        _prosjekt.ServicePrislinjer = System.Text.Json.JsonSerializer.Serialize(_prislinjer
            .Where(l => !string.IsNullOrWhiteSpace(l.Tjeneste))
            .Select(l => new ServiceavtalePris.Prislinje(l.Tjeneste.Trim(), l.Pris.Trim())));
        await Db.SaveChangesAsync();
        _tilbudMelding = "Lagret.";
    }

    private async Task ForhandsvisTilbud()
    {
        await LagreTilbud();
        _tilbudLagretMelding = null;
        _tilbudUrl = $"/serviceavtale/{ProsjektId}/tilbud/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreTilbudPdf()
    {
        var bytes = await TilbudPdf.GenerateAsync(ProsjektId);
        if (bytes is null || _prosjekt is null)
        {
            return;
        }
        var pdf = await LagretPdfService.LagreAsync("Serviceavtaletilbud", ProsjektId,
            $"Tilbud serviceavtale - {_prosjekt.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);
        _lagredeTilbud.Insert(0, pdf);
        _tilbudLagretMelding = "PDF-en er lagret under Lagrede tilbud.";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProsjektId == ProsjektId)
        {
            return;
        }

        _loadedProsjektId = ProsjektId;
        _syncMessage = null;

        _prosjekt = await Db.Prosjekter.Include(p => p.Kunde).FirstOrDefaultAsync(p => p.Id == ProsjektId);
        if (_prosjekt is not null)
        {
            _avtaleTekst = _prosjekt.ServiceavtaleTekst;
            _prislinjer = ServiceavtalePris.Prislinjer(_prosjekt).Select(l => new PrislinjeRad { Tjeneste = l.Tjeneste, Pris = l.Pris }).ToList();
        }
        _forsideMaler = await Db.TilbudForsider.AsNoTracking().OrderBy(f => f.Navn).ToListAsync();
        _lagredeTilbud = await LagretPdfService.HentAsync("Serviceavtaletilbud", ProsjektId);

        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .Include(d => d.Funksjoner)
            .ToListAsync();

        _serviceMinuttLinjer = await Db.ServiceMinuttLinjer
            .Where(l => l.ProsjektId == ProsjektId)
            .Include(l => l.Component)
            .OrderBy(l => l.Rekkefolge)
            .ToListAsync();

        _kategoriPriser = await Db.ServiceKategoriPriser
            .Where(k => k.ProsjektId == ProsjektId)
            .ToListAsync();

        await ServiceRegelMotor.SikreStandardregler(Db);
        _regler = await ServiceRegelMotor.HentRegler(Db);
        _typeKart = await ServiceRegelMotor.HentTypeKart(Db);
        _resultater = null;
    }

    private async Task SynkServiceMinutter()
    {
        var gruppert = _dorer.SelectMany(d => d.Komponenter)
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall) })
            .ToList();

        foreach (var g in gruppert)
        {
            var linje = _serviceMinuttLinjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);
            if (linje is null)
            {
                linje = new ServiceMinuttLinje
                {
                    ProsjektId = ProsjektId,
                    ComponentId = g.ComponentId,
                    Component = g.Component,
                    Navn = g.Component.Navn,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    Minutter = g.Component.MontasjeMinutterService,
                    Rekkefolge = _serviceMinuttLinjer.Count
                };
                _serviceMinuttLinjer.Add(linje);
                Db.ServiceMinuttLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Enhet = g.Component.Enhet;
            }
        }

        await Db.SaveChangesAsync();
        _syncMessage = $"{gruppert.Count} varetyper synkronisert fra avtalens dører.";
    }

