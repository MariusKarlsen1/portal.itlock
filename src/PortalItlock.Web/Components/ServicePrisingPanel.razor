@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject LagretPdfService LagretPdfService
@inject ServiceavtaleTilbudPdfService TilbudPdf
@inject ITenantContext TenantCtx
@using Microsoft.AspNetCore.Components.Authorization

<div class="prosjekt-layout prising-layout">
    <div class="prising-header">
        <span class="prising-header-ikon"><Icon Name="receipt" /></span>
        <h1>Prising</h1>
    </div>

    @* Velg hvordan årsprisen regnes ut. Service-minutter er standard. *@
    <div class="pr-topp">
        <label class="pr-modell">
            <span>Prismodell</span>
            <select value="@_prosjekt!.ServicePrismodell" @onchange="ByttPrismodell">
                <option value="@ServiceavtalePris.Minutter">Estimat fra varer (service-minutter)</option>
                <option value="@ServiceavtalePris.Kategorisert">Kategorier etter prisregler</option>
            </select>
        </label>
        <div class="pr-arspris">
            <small>Årspris eks. mva</small>
            <b>@FormatKr(Arspris)</b>
            <span>@FormatKr(Beregning.PerRunde) per runde × @Runder @(Runder == 1 ? "runde" : "runder") i året</span>
        </div>
        <span class="pr-sp"></span>
        <button type="button" class="knapp knapp-primaer" @onclick="ForhandsvisTilbud"><Icon Name="file-text" />Lag tilbud (PDF)</button>
    </div>

    @if (!ErKategorisert)
    {
    <section class="prising-panel">
        <div class="prising-panel-header">
            <span class="prising-panel-ikon"><Icon Name="clock" /></span>
            <h2>Service-minutter</h2>
        </div>
        <p class="section-hint">Henter serviceestimatet fra varene på dørene. Minuttene kan endres.</p>

        <div class="varer-toolbar">
            <button type="button" class="knapp knapp-primaer" @onclick="SynkServiceMinutter"><Icon Name="trend-up" />Synk</button>
        </div>
        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <p class="save-success">@_syncMessage</p>
        }

        @if (_serviceMinuttLinjer.Count == 0)
        {
            <p class="list-empty">Ingen varer lagt til ennå. Trykk "Synk" for å hente inn alt som er registrert på dørene i avtalen.</p>
        }
        else
        {
            <div class="dorer-table-wrap">
                <table class="dorer-table">
                    <thead>
                        <tr><th>Navn</th><th>Antall</th><th>Enhet</th><th>Minutter</th><th></th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _serviceMinuttLinjer)
                        {
                            <tr @key="l.Id">
                                <td>@l.Navn</td>
                                <td><input class="antall-input" @bind="l.Antall" @bind:after="LagreServiceMinutt" /></td>
                                <td>@l.Enhet</td>
                                <td><input class="antall-input" @bind="l.Minutter" @bind:after="LagreServiceMinutt" placeholder="min" /></td>
                                <td>
                                    @if (l.ComponentId.HasValue)
                                    {
                                        <button type="button" class="knapp" @onclick="@(() => HentMinuttFraVare(l))">Hent minutt fra vare</button>
                                    }
                                </td>
                                <td><button type="button" class="icon-button" title="Fjern" @onclick="@(() => FjernServiceMinuttLinje(l))"><Icon Name="x" /></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="prising-sum-rad">
            <span>Totalt: <strong>@FormatTid(TotaltServiceMinutter)</strong></span>
            <label class="timepris-felt">
                Timepris
                <span class="input-suffix-wrap">
                    <input class="antall-input" @bind="_prosjekt!.ServiceTimepris" @bind:after="LagreTimepris" />
                    <span class="input-suffix">kr/t</span>
                </span>
            </label>
            <span>Pris per runde: <strong>@FormatKr(ServiceMinutterPris)</strong></span>
            <span>Årspris (@Runder @(Runder == 1 ? "runde" : "runder")): <strong>@FormatKr(Arspris)</strong></span>
        </div>
    </section>
    }
    else
    {
    <section class="prising-panel">
        <div class="prising-panel-header">
            <span class="prising-panel-ikon"><Icon Name="tag" /></span>
            <h2>Kategorier etter prisregler</h2>
            <a class="pr-regellenke" href="/service-prisregler">Prisregler →</a>
        </div>
        <p class="section-hint">Dørene får kategori automatisk ut fra komponenttypene som er registrert på dem. Prisen kommer fra prisreglene – skriv inn en egen pris her for å overstyre den på denne avtalen.</p>

        @if (Resultater.Count(x => x.Res.HarKonflikt) is var kon && kon > 0)
        {
            <p class="pr-varsel">@kon @(kon == 1 ? "dør treffer" : "dører treffer") to regler med samme prioritet. Første regel brukes – løs det under Prisregler.</p>
        }

        <div class="dorer-table-wrap">
        <table class="kategori-tabell">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Antall dører</th>
                    <th>Pris pr dør pr runde</th>
                    <th>Sum per runde</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Grupper)
                {
                    var r = g.Regel;
                    var egen = _kategoriPriser.FirstOrDefault(k => !k.ErEgendefinert && k.Kategori == r.Navn);
                    var apen = _apneKategorier.Contains(r.Id);
                    <tr @key="r.Id" class="pr-katrad">
                        <td>
                            <button type="button" class="pr-utvid" @onclick="@(() => VekslKategori(r.Id))"><span class="@(apen ? "apen" : "")">›</span>@r.Navn</button>
                            @if (!string.IsNullOrWhiteSpace(r.Undertekst))
                            {
                                <span class="kategori-undertekst">@r.Undertekst</span>
                            }
                        </td>
                        <td>@g.Dorer.Count</td>
                        <td>
                            <span class="input-suffix-wrap">
                                <input class="antall-input" value="@(egen?.Pris?.ToString("0.##", Kultur))" placeholder="@r.Pris.ToString("0.##", Kultur)" @onchange="@(e => SettKategoriPris(r, e.Value?.ToString()))" />
                                <span class="input-suffix">kr</span>
                            </span>
                        </td>
                        <td class="kategori-sum">@FormatKr(g.Dorer.Count * ServiceRegelMotor.PrisForKategori(r, _kategoriPriser))</td>
                    </tr>
                    @if (apen)
                    {
                        @foreach (var x in g.Dorer)
                        {
                            <tr class="pr-dorrad" @key="@($"d{x.Dor.Id}")">
                                <td colspan="2"><b>@x.Dor.Dornummer</b> @x.Dor.DorTil<small>@(x.Res.Typer.Count == 0 ? "Ingen komponenter med servicetype" : string.Join(", ", x.Res.Typer))</small></td>
                                <td colspan="2">Regel: @r.Navn (prioritet @r.Prioritet)@(x.Res.HarKonflikt ? " · konflikt" : "")</td>
                            </tr>
                        }
                    }
                }
                @if (Resultater.Where(x => x.Res.Regel is null).ToList() is { Count: > 0 } ikke)
                {
                    <tr class="pr-ikke">
                        <td>Ikke kategorisert<span class="kategori-undertekst">@string.Join(", ", ikke.Select(x => x.Dor.Dornummer))</span></td>
                        <td>@ikke.Count</td>
                        <td>–</td>
                        <td class="kategori-sum">@FormatKr(0)</td>
                    </tr>
                }
                @foreach (var kp in _kategoriPriser.Where(k => k.ErEgendefinert))
                {
                    <tr @key="kp.Id">
                        <td>
                            <input class="kategori-egendefinert-navn" @bind="kp.Kategori" @bind:after="@(() => LagreKategoriPris(kp))" />
                            <span class="kategori-undertekst">egen linje · pris × antall × ganger i året</span>
                        </td>
                        <td>
                            <input class="antall-input" @bind="kp.ManueltAntall" @bind:after="@(() => LagreKategoriPris(kp))" placeholder="1" />
                        </td>
                        <td>
                            <span class="input-suffix-wrap">
                                <input class="antall-input" @bind="kp.Pris" @bind:after="@(() => LagreKategoriPris(kp))" />
                                <span class="input-suffix">kr</span>
                            </span>
                            <span class="input-suffix-wrap">
                                <input class="antall-input" @bind="kp.KravServicePrAar" @bind:after="@(() => LagreKategoriPris(kp))" placeholder="1" />
                                <span class="input-suffix">g/år</span>
                            </span>
                        </td>
                        <td class="kategori-sum">
                            @FormatKr(SumRad(kp, kp.ManueltAntall ?? 0))
                            <button type="button" class="icon-button" title="Fjern" @onclick="@(() => FjernKategoriLinje(kp))"><Icon Name="x" /></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="egen-linje-rad">
            <input @bind="_nyEgenLinjeNavn" @bind:event="oninput" placeholder="Navn på egen linje, f.eks. Batteriskifte Salto" />
            <button type="button" class="knapp" @onclick="LeggTilEgenLinje" disabled="@string.IsNullOrWhiteSpace(_nyEgenLinjeNavn)"><Icon Name="plus" />Legg til egen linje</button>
        </div>
    </section>
    }

    @* Tillegg per runde og beregnet pris - gjelder begge prismodellene. *@
    <section class="prising-panel">
        <div class="prising-panel-header">
            <span class="prising-panel-ikon"><Icon Name="receipt" /></span>
            <h2>Tillegg og avtalepris</h2>
        </div>
        <p class="section-hint">Tilleggene legges på hver servicerunde, uansett prismodell. Alle beløp er eks. mva.</p>
        <div class="pr-tillegg">
            <label>Kjøring / oppmøte per runde<span class="input-suffix-wrap"><input class="antall-input" value="@Tall(_prosjekt!.ServiceOppmote)" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceOppmote = v, e.Value))" /><span class="input-suffix">kr</span></span></label>
            <label>Reise / bompenger per runde<span class="input-suffix-wrap"><input class="antall-input" value="@Tall(_prosjekt!.ServiceReise)" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceReise = v, e.Value))" /><span class="input-suffix">kr</span></span></label>
            <label>Fast tillegg per runde<span class="input-suffix-wrap"><input class="antall-input" value="@Tall(_prosjekt!.ServiceFastTillegg)" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceFastTillegg = v, e.Value))" /><span class="input-suffix">kr</span></span></label>
            <label>Minstepris per runde<span class="input-suffix-wrap"><input class="antall-input" value="@Tall(_prosjekt!.ServiceMinstepris)" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceMinstepris = v, e.Value))" /><span class="input-suffix">kr</span></span></label>
            <label>Avtalerabatt<span class="input-suffix-wrap"><input class="antall-input" value="@Tall(_prosjekt!.ServiceRabattProsent)" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceRabattProsent = v is > 100 ? 100 : v, e.Value))" /><span class="input-suffix">%</span></span></label>
        </div>

        <table class="pr-sum">
            <tbody>
                <tr><td>@(ErKategorisert ? "Dører etter kategori" : "Service-minutter × timepris") per runde</td><td>@FormatKr(Beregning.Grunnlag)</td></tr>
                <tr><td>Tillegg per runde</td><td>@FormatKr(Beregning.Tillegg)</td></tr>
                @if (Beregning.MinsteprisBrukt)
                {
                    <tr><td>Minstepris brukt</td><td>@FormatKr(_prosjekt!.ServiceMinstepris ?? 0)</td></tr>
                }
                @if (_prosjekt!.ServiceRabattProsent is > 0)
                {
                    <tr><td>Avtalerabatt</td><td>−@(_prosjekt.ServiceRabattProsent?.ToString("0.##", Kultur)) %</td></tr>
                }
                <tr class="pr-sterk"><td>Pris per servicerunde</td><td>@FormatKr(Beregning.PerRunde)</td></tr>
                <tr><td>× @Runder @(Runder == 1 ? "runde" : "runder") i året@(Beregning.EgneLinjer > 0 ? " + egne linjer" : "")</td><td>@(Beregning.EgneLinjer > 0 ? "+ " + FormatKr(Beregning.EgneLinjer) : "")</td></tr>
                <tr class="pr-sterk"><td>Årlig avtaleverdi eks. mva</td><td>@FormatKr(Beregning.Arspris)</td></tr>
                <tr><td>Årlig avtaleverdi inkl. mva</td><td>@FormatKr(Beregning.ArsprisInklMva)</td></tr>
                <tr><td>Estimert tid per runde</td><td>@FormatTid(Beregning.MinutterPerRunde)</td></tr>
            </tbody>
        </table>

        @{ var endringer = KategoriEndringer; }
        <div class="pr-godkjent @(TrengerGodkjenning ? "avvik" : "")">
            <div>
                @if (_prosjekt!.ServiceGodkjentArspris is { } godkjent)
                {
                    <b>Godkjent avtalepris: @FormatKr(godkjent) per år</b>
                    <span>@_prosjekt.ServiceGodkjentDato?.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(_prosjekt.ServiceGodkjentAv) ? "" : $" · {_prosjekt.ServiceGodkjentAv}")@(_prosjekt.ServiceGodkjentRegelversjon is { } rv ? $" · prisregler v{rv}" : "")@(TrengerGodkjenning ? $" · ny beregning avviker med {FormatKr(Beregning.Arspris - godkjent)} per år" : " · stemmer med beregningen")</span>
                }
                else
                {
                    <b>Avtaleprisen er ikke godkjent ennå</b>
                    <span>Godkjenn når prisen er avtalt med kunden. Senere endringer på dørene eller reglene endrer ikke den godkjente prisen.</span>
                }
                @if (endringer.Count > 0)
                {
                    <ul class="pr-endringer">
                        @foreach (var e in endringer.Take(8))
                        {
                            <li><b>@e.Dor</b> @e.Tekst</li>
                        }
                    </ul>
                }
            </div>
            @if (TrengerGodkjenning)
            {
                <button type="button" class="knapp knapp-primaer" @onclick="GodkjennPris"><Icon Name="check" />Godkjenn @FormatKr(Beregning.Arspris)</button>
            }
        </div>
    </section>

    @* Tilbud på serviceavtalen: avtaleteksten som kommer med i PDF-en. *@
    <section class="prising-panel">
        <div class="prising-panel-header">
            <span class="prising-panel-ikon"><Icon Name="file-text" /></span>
            <h2>Tilbud på serviceavtalen</h2>
        </div>
        <p class="section-hint">PDF-en viser avtaleteksten med kunde, antall besøk og dører øverst. Hver overskrift i teksten blir en egen seksjon. Priser og signaturer kommer ikke med.</p>

        <div class="pr-felt">
            <div class="pr-felt-topp">
                <b>Avtaletekst</b>
                @if (_forsideMaler.Count > 0)
                {
                    <select @bind="_valgtMalId">
                        <option value="">Hent fra mal …</option>
                        @foreach (var m in _forsideMaler)
                        {
                            <option value="@m.Id">@m.Navn</option>
                        }
                    </select>
                    <button type="button" class="knapp" @onclick="BrukMal" disabled="@(_valgtMalId is null)">Bruk</button>
                }
                <button type="button" class="knapp" @onclick="BrukStandardtekst">Bruk standardtekst</button>
            </div>
            <ForsideTekstRedigering @bind-Value="_avtaleTekst" Rows="14" Placeholder="Tom = standardteksten brukes" />
        </div>

        <div class="pr-lagre">
            @if (!string.IsNullOrEmpty(_tilbudMelding))
            {
                <span class="save-success">@_tilbudMelding</span>
            }
            <button type="button" class="knapp" @onclick="LagreTilbud">Lagre</button>
            <button type="button" class="knapp knapp-primaer" @onclick="ForhandsvisTilbud"><Icon Name="file-text" />Lagre og forhåndsvis PDF</button>
        </div>

        @if (_lagredeTilbud.Count > 0)
        {
            <div class="pr-felt">
                <b>Lagrede tilbud</b>
                <LagredePdfListe Pdfer="_lagredeTilbud" />
            </div>
        }
    </section>

    <PdfPreviewModal Url="@_tilbudUrl" Tittel="Tilbud på serviceavtale" SaveMessage="@_tilbudLagretMelding"
                     OnSave="LagreTilbudPdf" OnClose="@(() => _tilbudUrl = null)" />
</div>

@code {
    [Parameter, EditorRequired] public int ProsjektId { get; set; }

    private int? _loadedProsjektId;
    private Prosjekt? _prosjekt;
    private List<Dor> _dorer = [];
    private List<ServiceMinuttLinje> _serviceMinuttLinjer = [];
    private List<ServiceKategoriPris> _kategoriPriser = [];
    private string? _syncMessage;

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private int TotaltServiceMinutter => _serviceMinuttLinjer.Sum(l => (l.Minutter ?? 0) * l.Antall);
    private decimal ServiceMinutterTimer => TotaltServiceMinutter / 60m;
    private decimal ServiceMinutterPris => (_prosjekt?.ServiceTimepris ?? 0) * ServiceMinutterTimer;


    private static decimal SumRad(ServiceKategoriPris kp, int antall) =>
        (kp.Pris ?? 0) * antall * (kp.KravServicePrAar ?? 0);

    private bool ErKategorisert => _prosjekt?.ServicePrismodell == ServiceavtalePris.Kategorisert;
    private int Runder => _prosjekt is null ? 1 : ServiceavtalePris.RunderPerAr(_prosjekt);
    private decimal Arspris => Beregning.Arspris;

    // ---- Prisregler (Kategorier etter prisregler) ----
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private List<ServicePrisRegel> _regler = [];
    private Dictionary<int, string?> _typeKart = [];
    private List<(Dor Dor, ServiceRegelMotor.Resultat Res)>? _resultater;
    private readonly HashSet<int> _apneKategorier = [];

    private List<(Dor Dor, ServiceRegelMotor.Resultat Res)> Resultater =>
        _resultater ??= _dorer.Select(d => (d, ServiceRegelMotor.Klassifiser(d, _regler, _typeKart))).ToList();

    private sealed record KategoriGruppe(ServicePrisRegel Regel, List<(Dor Dor, ServiceRegelMotor.Resultat Res)> Dorer);

    // Alle aktive regler som har dører, pluss regler med egen pris på avtalen.
    private List<KategoriGruppe> Grupper => _regler
        .Select(r => new KategoriGruppe(r, Resultater.Where(x => x.Res.Regel?.Id == r.Id).ToList()))
        .Where(g => g.Dorer.Count > 0)
        .ToList();

    private decimal RegelGrunnlag => Resultater.Where(x => x.Res.Regel is not null).Sum(x => ServiceRegelMotor.PrisForKategori(x.Res.Regel!, _kategoriPriser));
    private int RegelMinutter => Resultater.Where(x => x.Res.Regel is not null).Sum(x => x.Res.Regel!.Minutter);

    private ServiceRegelMotor.Beregning Beregning => _prosjekt is null
        ? new ServiceRegelMotor.Beregning(0, 0, 0, 1, 0, 0, 0, false)
        : ErKategorisert
            ? ServiceRegelMotor.Beregn(_prosjekt, RegelGrunnlag, RegelMinutter, _kategoriPriser)
            : ServiceRegelMotor.Beregn(_prosjekt, ServiceMinutterPris, TotaltServiceMinutter, []);

    private bool TrengerGodkjenning => _prosjekt is not null &&
        (_prosjekt.ServiceGodkjentArspris is not { } g || Math.Abs(g - Beregning.Arspris) >= 0.5m);

    private sealed record KategoriEndring(string Dor, string Tekst);

    // Dører som har fått annen kategori (eller er nye) siden prisen ble godkjent.
    private List<KategoriEndring> KategoriEndringer
    {
        get
        {
            if (_prosjekt?.ServiceGodkjentGrunnlag is not { } json || !ErKategorisert)
            {
                return [];
            }
            var forrige = ServiceRegelMotor.LesGrunnlag(json);
            var liste = new List<KategoriEndring>();
            foreach (var (dor, res) in Resultater)
            {
                if (!forrige.TryGetValue(dor.Id, out var gml))
                {
                    liste.Add(new(dor.Dornummer, $"er ny siden godkjenningen – {res.Kategori}"));
                }
                else if (gml != res.Kategori)
                {
                    liste.Add(new(dor.Dornummer, $"{gml} → {res.Kategori}"));
                }
            }
            var fjernet = forrige.Keys.Except(_dorer.Select(d => d.Id)).Count();
            if (fjernet > 0)
            {
                liste.Add(new("", $"{fjernet} {(fjernet == 1 ? "dør" : "dører")} er fjernet siden godkjenningen"));
            }
            return liste;
        }
    }

    private void VekslKategori(int regelId)
    {
        if (!_apneKategorier.Remove(regelId))
        {
            _apneKategorier.Add(regelId);
        }
    }

    private async Task SettKategoriPris(ServicePrisRegel r, string? verdi)
    {
        var pris = LesTall(verdi);
        var kp = _kategoriPriser.FirstOrDefault(k => !k.ErEgendefinert && k.Kategori == r.Navn);
        if (kp is null)
        {
            if (pris is null)
            {
                return;
            }
            kp = new ServiceKategoriPris { ProsjektId = ProsjektId, Kategori = r.Navn };
            Db.ServiceKategoriPriser.Add(kp);
            _kategoriPriser.Add(kp);
        }
        kp.Pris = pris;
        await Db.SaveChangesAsync();
    }

    private static string Tall(decimal? v) => v?.ToString("0.##", Kultur) ?? "";

    private static decimal? LesTall(object? v)
    {
        var t = v?.ToString()?.Replace(" ", "").Replace(" ", "").Replace(',', '.');
        return decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d >= 0 ? d : null;
    }

    private async Task SettTillegg(Action<decimal?> sett, object? verdi)
    {
        sett(LesTall(verdi));
        await Db.SaveChangesAsync();
    }

    private async Task GodkjennPris()
    {
        if (_prosjekt is null)
        {
            return;
        }
        var navn = AuthStateTask is null ? null : (await AuthStateTask).User.Identity?.Name;
        _prosjekt.ServiceGodkjentArspris = Beregning.Arspris;
        _prosjekt.ServiceGodkjentDato = DateTime.Now;
        _prosjekt.ServiceGodkjentAv = navn;
        _prosjekt.ServiceGodkjentGrunnlag = ErKategorisert ? ServiceRegelMotor.LagGrunnlag(Resultater.Select(x => (x.Dor.Id, x.Res.Kategori))) : null;
        _prosjekt.ServiceGodkjentRegelversjon = ErKategorisert ? await ServiceRegelMotor.GjeldendeVersjon(Db) : null;
        await Db.SaveChangesAsync();
    }


    // Tilbud på serviceavtalen
    private sealed class PrislinjeRad
    {
        public string Tjeneste { get; set; } = "";
        public string Pris { get; set; } = "";
    }

    private string? _avtaleTekst;
    private List<PrislinjeRad> _prislinjer = [];
    private List<TilbudForside> _forsideMaler = [];
    private int? _valgtMalId;
    private string? _tilbudMelding;
    private string? _tilbudUrl;
    private string? _tilbudLagretMelding;
    private List<LagretPdf> _lagredeTilbud = [];

    private async Task ByttPrismodell(ChangeEventArgs e)
    {
        if (_prosjekt is null || !int.TryParse(e.Value?.ToString(), out var modell))
        {
            return;
        }
        _prosjekt.ServicePrismodell = modell;
        await Db.SaveChangesAsync();
    }

    private void BrukMal()
    {
        if (_forsideMaler.FirstOrDefault(m => m.Id == _valgtMalId) is { } mal)
        {
            _avtaleTekst = mal.Innhold;
        }
    }

    private void BrukStandardtekst()
    {
        _avtaleTekst = ServiceavtalePris.StandardTekst(RapportProfil.Fra(TenantCtx.Current).Navn, _prosjekt?.Kunde?.Navn ?? "kunden", Runder);
    }

    private async Task LagreTilbud()
    {
        if (_prosjekt is null)
        {
            return;
        }
        _prosjekt.ServiceavtaleTekst = string.IsNullOrWhiteSpace(_avtaleTekst) ? null : _avtaleTekst;
        _prosjekt.ServicePrislinjer = System.Text.Json.JsonSerializer.Serialize(_prislinjer
            .Where(l => !string.IsNullOrWhiteSpace(l.Tjeneste))
            .Select(l => new ServiceavtalePris.Prislinje(l.Tjeneste.Trim(), l.Pris.Trim())));
        await Db.SaveChangesAsync();
        _tilbudMelding = "Lagret.";
    }

    private async Task ForhandsvisTilbud()
    {
        await LagreTilbud();
        _tilbudLagretMelding = null;
        _tilbudUrl = $"/serviceavtale/{ProsjektId}/tilbud/pdf?v={DateTime.UtcNow.Ticks}";
    }

    private async Task LagreTilbudPdf()
    {
        var bytes = await TilbudPdf.GenerateAsync(ProsjektId);
        if (bytes is null || _prosjekt is null)
        {
            return;
        }
        var pdf = await LagretPdfService.LagreAsync("Serviceavtaletilbud", ProsjektId,
            $"Tilbud serviceavtale - {_prosjekt.Navn} - {DateTime.Now:dd.MM.yyyy HH.mm}.pdf", bytes);
        _lagredeTilbud.Insert(0, pdf);
        _tilbudLagretMelding = "PDF-en er lagret under Lagrede tilbud.";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProsjektId == ProsjektId)
        {
            return;
        }

        _loadedProsjektId = ProsjektId;
        _syncMessage = null;

        _prosjekt = await Db.Prosjekter.Include(p => p.Kunde).FirstOrDefaultAsync(p => p.Id == ProsjektId);
        if (_prosjekt is not null)
        {
            _avtaleTekst = _prosjekt.ServiceavtaleTekst;
            _prislinjer = ServiceavtalePris.Prislinjer(_prosjekt).Select(l => new PrislinjeRad { Tjeneste = l.Tjeneste, Pris = l.Pris }).ToList();
        }
        _forsideMaler = await Db.TilbudForsider.AsNoTracking().OrderBy(f => f.Navn).ToListAsync();
        _lagredeTilbud = await LagretPdfService.HentAsync("Serviceavtaletilbud", ProsjektId);

        _dorer = await Db.Dorer
            .Where(d => d.ProsjektId == ProsjektId)
            .Include(d => d.Komponenter).ThenInclude(dk => dk.Component)
            .Include(d => d.Funksjoner)
            .ToListAsync();

        _serviceMinuttLinjer = await Db.ServiceMinuttLinjer
            .Where(l => l.ProsjektId == ProsjektId)
            .Include(l => l.Component)
            .OrderBy(l => l.Rekkefolge)
            .ToListAsync();

        _kategoriPriser = await Db.ServiceKategoriPriser
            .Where(k => k.ProsjektId == ProsjektId)
            .ToListAsync();

        await ServiceRegelMotor.SikreStandardregler(Db);
        _regler = await ServiceRegelMotor.HentRegler(Db);
        _typeKart = await ServiceRegelMotor.HentTypeKart(Db);
        _resultater = null;
    }

    private async Task SynkServiceMinutter()
    {
        var gruppert = _dorer.SelectMany(d => d.Komponenter)
            .Where(dk => dk.Component is not null)
            .GroupBy(dk => dk.ComponentId)
            .Select(g => new { ComponentId = g.Key, Component = g.First().Component!, Antall = g.Sum(x => x.Antall) })
            .ToList();

        foreach (var g in gruppert)
        {
            var linje = _serviceMinuttLinjer.FirstOrDefault(l => l.ComponentId == g.ComponentId);
            if (linje is null)
            {
                linje = new ServiceMinuttLinje
                {
                    ProsjektId = ProsjektId,
                    ComponentId = g.ComponentId,
                    Component = g.Component,
                    Navn = g.Component.Navn,
                    Antall = g.Antall,
                    Enhet = g.Component.Enhet,
                    Minutter = g.Component.MontasjeMinutterService,
                    Rekkefolge = _serviceMinuttLinjer.Count
                };
                _serviceMinuttLinjer.Add(linje);
                Db.ServiceMinuttLinjer.Add(linje);
            }
            else
            {
                linje.Antall = g.Antall;
                linje.Enhet = g.Component.Enhet;
            }
        }

        await Db.SaveChangesAsync();
        _syncMessage = $"{gruppert.Count} varetyper synkronisert fra avtalens dører.";
    }

    private async Task HentMinuttFraVare(ServiceMinuttLinje linje)
    {
        if (linje.Component is null)
        {
            return;
        }

        linje.Minutter = linje.Component.MontasjeMinutterService;
        await Db.SaveChangesAsync();
    }

