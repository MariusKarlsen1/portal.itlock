    private string _nyEgenLinjeNavn = "";

    private async Task LeggTilEgenLinje()
    {
        var navn = _nyEgenLinjeNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var kp = new ServiceKategoriPris
        {
            ProsjektId = ProsjektId,
            Kategori = navn,
            ErEgendefinert = true,
            ManueltAntall = 1
        };
        Db.ServiceKategoriPriser.Add(kp);
        await Db.SaveChangesAsync();

        _kategoriPriser.Add(kp);
        _nyEgenLinjeNavn = "";
    }

    private async Task FjernKategoriLinje(ServiceKategoriPris kp)
    {
        Db.ServiceKategoriPriser.Remove(kp);
        await Db.SaveChangesAsync();
        _kategoriPriser.Remove(kp);
    }

    private static string FormatTid(int minutter)
    {
        if (minutter <= 0)
        {
            return "0 min";
        }

        var timer = minutter / 60;
        var rest = minutter % 60;
        return timer > 0 ? $"{timer}t {rest}min" : $"{rest} min";
    }

    private string FormatKr(decimal verdi) => $"{verdi.ToString("N2", Kultur)} kr";
