@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject LagretPdfService LagretPdfService
@inject ServiceavtaleTilbudPdfService TilbudPdf
@inject ITenantContext TenantCtx
@using Microsoft.AspNetCore.Components.Authorization

<div class="pz">
    @* Prising P4 (Prototype serviceavtalemodul komplett PC.html): alt på én side – grå
       linje med tallene og runder i året, tabell med kategoriene og tilleggene der prisene
       endres rett i tabellen. Tilbud og historikk ligger bak egne knapper. *@
    @{ var endringer = KategoriEndringer; var godkjent = _prosjekt!.ServiceGodkjentArspris; }
    <section class="pz-s">
        <div class="pz-stripe">
            <span class="pz-st-hoved">Pris per år <b>@Kr(Beregning.Arspris)</b></span>
            <span>Per runde <b>@Kr(Beregning.PerRunde)</b></span>
            <span class="pz-runder">Runder i året
                <select value="@(_prosjekt!.ServiceGangerPerAr?.ToString() ?? "")" @onchange="EndreRunder">
                    <option value="">1</option>
                    @foreach (var g in new[] { 1, 2, 3, 4, 6, 12 })
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </span>
            <span>Tid per runde <b>@FormatTid(Beregning.MinutterPerRunde)</b></span>
            @if (godkjent is null)
            {
                <span class="pz-pill gul">Ikke godkjent</span>
            }
            else if (TrengerGodkjenning)
            {
                <span class="pz-pill gul">Endret @(Beregning.Arspris > godkjent ? "+" : "−")@Kr(Math.Abs(Beregning.Arspris - godkjent.Value))</span>
            }
            else
            {
                <span class="pz-pill ok"><Icon Name="check" />Godkjent</span>
            }
            <span class="pz-sp"></span>
            @if (TrengerGodkjenning)
            {
                <button type="button" class="pz-knapp pz-knapp-p" @onclick="GodkjennPris"><Icon Name="check" />Godkjenn @Kr(Beregning.Arspris)</button>
            }
            <button type="button" class="pz-knapp @(TrengerGodkjenning ? "" : "pz-knapp-p")" @onclick="ForhandsvisTilbud"><Icon Name="file-text" />Tilbud (PDF)</button>
        </div>
        @if (godkjent is not null && TrengerGodkjenning)
        {
            <div class="pz-endring">
                <span>Godkjent @Kr(godkjent.Value) @_prosjekt.ServiceGodkjentDato?.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(_prosjekt.ServiceGodkjentAv) ? "" : $" av {_prosjekt.ServiceGodkjentAv}"). Ny beregning er @Kr(Beregning.Arspris) – avtaleprisen endres ikke før du godkjenner.</span>
                @if (endringer.Count > 0)
                {
                    <ul>
                        @foreach (var e in endringer.Take(6))
                        {
                            <li><b>@e.Dor</b> @e.Tekst</li>
                        }
                    </ul>
                }
            </div>
        }
        @if (_pzFane != "pris")
        {
            <div class="pz-verktoy">
                <button type="button" class="pz-knapp" @onclick="@(() => _pzFane = "pris")">&larr; Prising</button>
                <b>@(_pzFane == "tilbud" ? "Avtaletekst og tilbud" : "Historikk")</b>
            </div>
        }

        @if (_pzFane == "pris")
        {
        <div class="pz-verktoy">
            <span class="pz-seg">
                <button type="button" class="@(ErKategorisert ? "pa" : "")" @onclick="@(() => SettPrismodell(ServiceavtalePris.Kategorisert))">Prisregler</button>
                <button type="button" class="@(ErKategorisert ? "" : "pa")" @onclick="@(() => SettPrismodell(ServiceavtalePris.Minutter))">Estimat fra varer</button>
            </span>
            <small>@Kr(Beregning.ArsprisInklMva) per år inkl. mva</small>
            <span class="pz-sp"></span>
            <button type="button" class="pz-knapp" @onclick="@(() => _pzFane = "tilbud")"><Icon Name="edit" />Avtaletekst og tilbud@(_lagredeTilbud.Count > 0 ? $" ({_lagredeTilbud.Count})" : "")</button>
            <button type="button" class="pz-knapp" @onclick="@(() => _pzFane = "hist")"><Icon Name="clock" />Historikk</button>
        </div>
        @if (ErKategorisert)
        {
            <p class="pz-hint">Dørene får kategori ut fra komponenttypene. Prisen per dør kommer fra <a href="/service-prisregler">prisreglene</a> – skriv en egen pris for å overstyre den på denne avtalen.</p>
            @if (Resultater.Count(x => x.Res.HarKonflikt) is var kon && kon > 0)
            {
                <p class="pz-varsel">@kon @(kon == 1 ? "dør treffer" : "dører treffer") to regler med samme prioritet. Første regel brukes – løs det under Prisregler.</p>
            }
            <div class="pz-tabwrap">
                <table class="pz-tab">
                    <thead>
                        <tr><th>Kategori</th><th class="n">Dører</th><th class="n">Min per dør</th><th class="n">Pris per dør</th><th class="n">Per runde</th><th class="n">Per år</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Grupper)
                        {
                            var r = g.Regel;
                            var egen = _kategoriPriser.FirstOrDefault(k => !k.ErEgendefinert && k.Kategori == r.Navn);
                            var pris = ServiceRegelMotor.PrisForKategori(r, _kategoriPriser);
                            var apen = _apneKategorier.Contains(r.Id);
                            <tr @key="r.Id">
                                <td>
                                    <button type="button" class="pz-kat" @onclick="@(() => VekslKategori(r.Id))"><span class="pz-pil @(apen ? "apen" : "")">›</span><i style="background:@KatFarge(r.Navn)"></i>@r.Navn</button>
                                    @if (!string.IsNullOrWhiteSpace(r.Undertekst)) {<small>@r.Undertekst</small>}
                                </td>
                                <td class="n">@g.Dorer.Count</td>
                                <td class="n">@r.Minutter</td>
                                <td class="n">
                                    <span class="pz-inp @(egen?.Pris is not null ? "egen" : "")">
                                        <input value="@(egen?.Pris?.ToString("0.##", Kultur))" placeholder="@r.Pris.ToString("0.##", Kultur)" @onchange="@(e => SettKategoriPris(r, e.Value?.ToString()))" />
                                        <em>kr</em>
                                    </span>
                                </td>
                                <td class="n">@Kr(g.Dorer.Count * pris)</td>
                                <td class="n"><b>@Kr(g.Dorer.Count * pris * Runder)</b></td>
                                <td class="n">
                                    @if (egen?.Pris is not null)
                                    {
                                        <button type="button" class="pz-lenke" title="Bruk prisen fra prisreglene (@Kr(r.Pris))" @onclick="@(() => SettKategoriPris(r, null))">Standard</button>
                                    }
                                </td>
                            </tr>
                            @if (apen)
                            {
                                @foreach (var x in g.Dorer)
                                {
                                    <tr class="pz-dor" @key="@($"d{x.Dor.Id}")">
                                        <td colspan="7"><b>@x.Dor.Dornummer</b>@(string.IsNullOrWhiteSpace(x.Dor.Romnr) ? "" : $" · {x.Dor.Romnr}") <small>@(x.Res.Typer.Count == 0 ? "Ingen komponenter med servicetype" : string.Join(", ", x.Res.Typer))@(x.Res.HarKonflikt ? " · konflikt" : "")</small></td>
                                    </tr>
                                }
                            }
                        }
                        @if (Resultater.Where(x => x.Res.Regel is null).ToList() is { Count: > 0 } ikke)
                        {
                            <tr class="pz-ikke">
                                <td><span class="pz-kat"><i style="background:#C7C7C6"></i>Ikke kategorisert</span><small>@string.Join(", ", ikke.Select(x => x.Dor.Dornummer).Take(12)) – får ingen pris</small></td>
                                <td class="n">@ikke.Count</td>
                                <td class="n">–</td>
                                <td class="n">–</td>
                                <td class="n">–</td>
                                <td class="n">–</td>
                                <td></td>
                            </tr>
                        }
                        @foreach (var kp in _kategoriPriser.Where(k => k.ErEgendefinert))
                        {
                            <tr @key="kp.Id" class="pz-egen">
                                <td>
                                    <input class="pz-navn" @bind="kp.Kategori" @bind:after="@(() => LagreKategoriPris(kp))" />
                                    <small>Egen linje · pris × antall × ganger i året</small>
                                </td>
                                <td class="n"><span class="pz-inp smal"><input @bind="kp.ManueltAntall" @bind:after="@(() => LagreKategoriPris(kp))" placeholder="1" /></span></td>
                                <td class="n">–</td>
                                <td class="n"><span class="pz-inp"><input @bind="kp.Pris" @bind:after="@(() => LagreKategoriPris(kp))" /><em>kr</em></span></td>
                                <td class="n"><span class="pz-inp smal"><input @bind="kp.KravServicePrAar" @bind:after="@(() => LagreKategoriPris(kp))" placeholder="1" /><em>g/år</em></span></td>
                                <td class="n"><b>@Kr(SumRad(kp, kp.ManueltAntall ?? 0))</b></td>
                                <td class="n"><button type="button" class="pz-x" title="Fjern linjen" @onclick="@(() => FjernKategoriLinje(kp))">×</button></td>
                            </tr>
                        }
                        @TilleggRader(7)
                    </tbody>
                    <tfoot>
                        <tr><td>Sum</td><td class="n">@Resultater.Count(x => x.Res.Regel is not null)</td><td></td><td></td><td class="n">@Kr(Beregning.PerRunde)</td><td class="n">@Kr(Beregning.Arspris)</td><td></td></tr>
                    </tfoot>
                </table>
            </div>
            <div class="pz-fot">
                <input @bind="_nyEgenLinjeNavn" @bind:event="oninput" placeholder="Egen linje, f.eks. «Batteriskifte Salto»" />
                <button type="button" class="pz-knapp" @onclick="LeggTilEgenLinje" disabled="@string.IsNullOrWhiteSpace(_nyEgenLinjeNavn)"><Icon Name="plus" />Legg til linje</button>
            </div>
        }
        else
        {
            <p class="pz-hint">Servicetiden hentes fra varene på dørene og ganges med timeprisen. Minuttene kan endres.</p>
            @if (!string.IsNullOrEmpty(_syncMessage))
            {
                <p class="pz-ok">@_syncMessage</p>
            }
            @if (_serviceMinuttLinjer.Count == 0)
            {
                <p class="pz-tom">Ingen varer hentet ennå. Trykk «Hent fra dørene» for å hente alt som er registrert på dørene.</p>
            }
            else
            {
                <div class="pz-tabwrap">
                    <table class="pz-tab">
                        <thead><tr><th>Vare</th><th class="n">Antall</th><th>Enhet</th><th class="n">Minutter</th><th class="n">Sum</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var l in _serviceMinuttLinjer)
                            {
                                <tr @key="l.Id">
                                    <td>@l.Navn@if (l.ComponentId.HasValue) {<button type="button" class="pz-lenke" @onclick="@(() => HentMinuttFraVare(l))">hent minutter fra varen</button>}</td>
                                    <td class="n"><span class="pz-inp smal"><input @bind="l.Antall" @bind:after="LagreServiceMinutt" /></span></td>
                                    <td>@l.Enhet</td>
                                    <td class="n"><span class="pz-inp smal"><input @bind="l.Minutter" @bind:after="LagreServiceMinutt" placeholder="0" /><em>min</em></span></td>
                                    <td class="n">@FormatTid((l.Minutter ?? 0) * l.Antall)</td>
                                    <td class="n"><button type="button" class="pz-x" title="Fjern" @onclick="@(() => FjernServiceMinuttLinje(l))">×</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td>Sum per runde</td><td></td><td></td><td></td><td class="n">@FormatTid(TotaltServiceMinutter)</td><td></td></tr>
                        </tfoot>
                    </table>
                </div>
            }
            <div class="pz-tabwrap">
                <table class="pz-tab">
                    <thead><tr><th>Tillegg</th><th></th><th></th><th class="n">Beløp</th><th class="n">Per runde</th><th class="n">Per år</th><th></th></tr></thead>
                    <tbody>@TilleggRader(7, false)</tbody>
                    <tfoot><tr><td>Sum</td><td></td><td></td><td></td><td class="n">@Kr(Beregning.PerRunde)</td><td class="n">@Kr(Beregning.Arspris)</td><td></td></tr></tfoot>
                </table>
            </div>
            <div class="pz-fot">
                <button type="button" class="pz-knapp" @onclick="SynkServiceMinutter"><Icon Name="trend-up" />Hent fra dørene</button>
                <span class="pz-sp"></span>
                <label class="pz-tp">Timepris <span class="pz-inp"><input @bind="_prosjekt!.ServiceTimepris" @bind:after="LagreTimepris" /><em>kr/t</em></span></label>
            </div>
        }
        }
        else if (_pzFane == "till")
        {
        <p class="pz-hint">Tilleggene legges på hver runde, uansett prismodell. Alle beløp eks. mva.</p>
        <div class="pz-felt">
            <label><span>Runder i året</span>
                <select value="@(_prosjekt!.ServiceGangerPerAr?.ToString() ?? "")" @onchange="EndreRunder">
                    <option value="">Ikke satt (1)</option>
                    @foreach (var g in new[] { 1, 2, 3, 4, 6, 12 })
                    {
                        <option value="@g">@g @(g == 1 ? "runde" : "runder") i året</option>
                    }
                </select>
            </label>
            <label><span>Oppmøte / kjøring per runde</span><span class="pz-inp bred"><input value="@Tall(_prosjekt!.ServiceOppmote)" placeholder="0" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceOppmote = v, e.Value))" /><em>kr</em></span></label>
            <label><span>Reise / bompenger per runde</span><span class="pz-inp bred"><input value="@Tall(_prosjekt!.ServiceReise)" placeholder="0" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceReise = v, e.Value))" /><em>kr</em></span></label>
            <label><span>Fast tillegg per runde</span><span class="pz-inp bred"><input value="@Tall(_prosjekt!.ServiceFastTillegg)" placeholder="0" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceFastTillegg = v, e.Value))" /><em>kr</em></span></label>
            <label><span>Minstepris per runde</span><span class="pz-inp bred"><input value="@Tall(_prosjekt!.ServiceMinstepris)" placeholder="Ingen" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceMinstepris = v, e.Value))" /><em>kr</em></span></label>
            <label><span>Avtalerabatt</span><span class="pz-inp bred"><input value="@Tall(_prosjekt!.ServiceRabattProsent)" placeholder="0" @onchange="@(e => SettTillegg(v => _prosjekt!.ServiceRabattProsent = v is > 100 ? 100 : v, e.Value))" /><em>%</em></span></label>
        </div>
        }
        else if (_pzFane == "tilbud")
        {
        <div class="pz-verktoy">
            <span>PDF-en viser kunde, antall besøk og dører, så avtaleteksten.</span>
            <span class="pz-sp"></span>
            <button type="button" class="pz-knapp" @onclick="@(() => _visAvtaletekst = !_visAvtaletekst)"><Icon Name="edit" />@(_visAvtaletekst ? "Skjul avtaletekst" : "Rediger avtaletekst")</button>
            <button type="button" class="pz-knapp pz-knapp-p" @onclick="ForhandsvisTilbud"><Icon Name="file-text" />Lag tilbud (PDF)</button>
        </div>
        @if (_visAvtaletekst)
        {
            <div class="pz-tekst">
                <div class="pz-tekst-topp">
                    <span>PDF-en viser kunde, antall besøk og dører øverst, så avtaleteksten. Hver overskrift blir en seksjon.</span>
                    @if (_forsideMaler.Count > 0)
                    {
                        <select @bind="_valgtMalId">
                            <option value="">Hent fra mal …</option>
                            @foreach (var m in _forsideMaler)
                            {
                                <option value="@m.Id">@m.Navn</option>
                            }
                        </select>
                        <button type="button" class="pz-knapp" @onclick="BrukMal" disabled="@(_valgtMalId is null)">Bruk</button>
                    }
                    <button type="button" class="pz-knapp" @onclick="BrukStandardtekst">Standardtekst</button>
                </div>
                <ForsideTekstRedigering @bind-Value="_avtaleTekst" Rows="12" Placeholder="Tom = standardteksten brukes" />
                <div class="pz-tekst-kn">
                    @if (!string.IsNullOrEmpty(_tilbudMelding))
                    {
                        <span class="pz-ok">@_tilbudMelding</span>
                    }
                    <button type="button" class="pz-knapp" @onclick="LagreTilbud">Lagre teksten</button>
                </div>
            </div>
        }
        @if (_lagredeTilbud.Count > 0)
        {
            <div class="pz-tilbud"><LagredePdfListe Pdfer="_lagredeTilbud" /></div>
        }
        else
        {
            <p class="pz-tom">Ingen tilbud laget ennå. «Lag tilbud (PDF)» lager tilbudet med avtaleteksten@(string.IsNullOrWhiteSpace(_avtaleTekst) ? " (standardteksten)" : "").</p>
        }
        }
        else
        {
            <div class="pz-tabwrap">
                <table class="pz-tab">
                    <thead><tr><th>Dato</th><th>Hendelse</th><th class="n">Pris per år</th><th>Av</th></tr></thead>
                    <tbody>
                        @if (godkjent is not null && TrengerGodkjenning)
                        {
                            <tr><td>Nå</td><td>Ny beregning – ikke godkjent</td><td class="n">@Kr(Beregning.Arspris)</td><td>–</td></tr>
                        }
                        @if (godkjent is { } gj)
                        {
                            <tr><td>@_prosjekt.ServiceGodkjentDato?.ToString("dd.MM.yyyy")</td><td>Pris godkjent@(_prosjekt.ServiceGodkjentRegelversjon is { } rv2 ? $" (prisregler v{rv2})" : "")</td><td class="n">@Kr(gj)</td><td>@(_prosjekt.ServiceGodkjentAv ?? "–")</td></tr>
                        }
                        @foreach (var t in _lagredeTilbud)
                        {
                            <tr><td>@t.OpprettetDato.ToString("dd.MM.yyyy")</td><td>Tilbud laget: <a href="@($"/lagretpdf/{t.Id}?vis=1")" target="_blank">@t.Navn</a></td><td class="n">–</td><td>–</td></tr>
                        }
                        @if (godkjent is null && _lagredeTilbud.Count == 0)
                        {
                            <tr><td colspan="4" class="pz-tom">Ingen historikk ennå. Godkjente priser og tilbud vises her.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <PdfPreviewModal Url="@_tilbudUrl" Tittel="Tilbud på serviceavtale" SaveMessage="@_tilbudLagretMelding"
                     OnSave="LagreTilbudPdf" OnClose="@(() => _tilbudUrl = null)" />
</div>

@code {
    [Parameter, EditorRequired] public int ProsjektId { get; set; }

    private int? _loadedProsjektId;
    private Prosjekt? _prosjekt;
    private List<Dor> _dorer = [];
    private List<ServiceMinuttLinje> _serviceMinuttLinjer = [];
    private List<ServiceKategoriPris> _kategoriPriser = [];
    private string? _syncMessage;

    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");

    private int TotaltServiceMinutter => _serviceMinuttLinjer.Sum(l => (l.Minutter ?? 0) * l.Antall);
    private decimal ServiceMinutterTimer => TotaltServiceMinutter / 60m;
    private decimal ServiceMinutterPris => (_prosjekt?.ServiceTimepris ?? 0) * ServiceMinutterTimer;


    private static decimal SumRad(ServiceKategoriPris kp, int antall) =>
        (kp.Pris ?? 0) * antall * (kp.KravServicePrAar ?? 0);

    private bool ErKategorisert => _prosjekt?.ServicePrismodell == ServiceavtalePris.Kategorisert;
    private int Runder => _prosjekt is null ? 1 : ServiceavtalePris.RunderPerAr(_prosjekt);
    private decimal Arspris => Beregning.Arspris;

    // ---- Prisregler (Kategorier etter prisregler) ----
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private List<ServicePrisRegel> _regler = [];
    private Dictionary<int, string?> _typeKart = [];
    private List<(Dor Dor, ServiceRegelMotor.Resultat Res)>? _resultater;
    private readonly HashSet<int> _apneKategorier = [];

    private List<(Dor Dor, ServiceRegelMotor.Resultat Res)> Resultater =>
        _resultater ??= _dorer.Select(d => (d, ServiceRegelMotor.Klassifiser(d, _regler, _typeKart))).ToList();

    private sealed record KategoriGruppe(ServicePrisRegel Regel, List<(Dor Dor, ServiceRegelMotor.Resultat Res)> Dorer);

    // Alle aktive regler som har dører, pluss regler med egen pris på avtalen.
    private List<KategoriGruppe> Grupper => _regler
        .Select(r => new KategoriGruppe(r, Resultater.Where(x => x.Res.Regel?.Id == r.Id).ToList()))
        .Where(g => g.Dorer.Count > 0)
        .ToList();

    private decimal RegelGrunnlag => Resultater.Where(x => x.Res.Regel is not null).Sum(x => ServiceRegelMotor.PrisForKategori(x.Res.Regel!, _kategoriPriser));
    private int RegelMinutter => Resultater.Where(x => x.Res.Regel is not null).Sum(x => x.Res.Regel!.Minutter);

    private ServiceRegelMotor.Beregning Beregning => _prosjekt is null
        ? new ServiceRegelMotor.Beregning(0, 0, 0, 1, 0, 0, 0, false)
        : ErKategorisert
            ? ServiceRegelMotor.Beregn(_prosjekt, RegelGrunnlag, RegelMinutter, _kategoriPriser)
            : ServiceRegelMotor.Beregn(_prosjekt, ServiceMinutterPris, TotaltServiceMinutter, []);

    private bool TrengerGodkjenning => _prosjekt is not null &&
        (_prosjekt.ServiceGodkjentArspris is not { } g || Math.Abs(g - Beregning.Arspris) >= 0.5m);

    private sealed record KategoriEndring(string Dor, string Tekst);

    // Dører som har fått annen kategori (eller er nye) siden prisen ble godkjent.
    private List<KategoriEndring> KategoriEndringer
    {
        get
        {
            if (_prosjekt?.ServiceGodkjentGrunnlag is not { } json || !ErKategorisert)
            {
                return [];
            }
            var forrige = ServiceRegelMotor.LesGrunnlag(json);
            var liste = new List<KategoriEndring>();
            foreach (var (dor, res) in Resultater)
            {
                if (!forrige.TryGetValue(dor.Id, out var gml))
                {
                    liste.Add(new(dor.Dornummer, $"er ny siden godkjenningen – {res.Kategori}"));
                }
                else if (gml != res.Kategori)
                {
                    liste.Add(new(dor.Dornummer, $"{gml} → {res.Kategori}"));
                }
            }
            var fjernet = forrige.Keys.Except(_dorer.Select(d => d.Id)).Count();
            if (fjernet > 0)
            {
                liste.Add(new("", $"{fjernet} {(fjernet == 1 ? "dør" : "dører")} er fjernet siden godkjenningen"));
            }
            return liste;
        }
    }

    private void VekslKategori(int regelId)
    {
        if (!_apneKategorier.Remove(regelId))
        {
            _apneKategorier.Add(regelId);
        }
    }

    private async Task SettKategoriPris(ServicePrisRegel r, string? verdi)
    {
        var pris = LesTall(verdi);
        var kp = _kategoriPriser.FirstOrDefault(k => !k.ErEgendefinert && k.Kategori == r.Navn);
        if (kp is null)
        {
            if (pris is null)
            {
                return;
            }
            kp = new ServiceKategoriPris { ProsjektId = ProsjektId, Kategori = r.Navn };
            Db.ServiceKategoriPriser.Add(kp);
            _kategoriPriser.Add(kp);
        }
        kp.Pris = pris;
        await Db.SaveChangesAsync();
    }

    private static string Tall(decimal? v) => v?.ToString("0.##", Kultur) ?? "";

    private static decimal? LesTall(object? v)
    {
        var t = v?.ToString()?.Replace(" ", "").Replace(" ", "").Replace(',', '.');
        return decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d >= 0 ? d : null;
    }

    private async Task EndreRunder(ChangeEventArgs e)
    {
        if (_prosjekt is null) return;
        _prosjekt.ServiceGangerPerAr = int.TryParse(e.Value?.ToString(), out var g) && g > 0 ? g : null;
        await Db.SaveChangesAsync();
    }

    // P4: tilleggene står som rader i samme tabell, under en grå «TILLEGG»-linje.
    private RenderFragment TilleggRader(int kolonner, bool medOverskrift = true) => __builder =>
    {
        if (medOverskrift)
        {
            <tr class="pz-grp"><td colspan="@kolonner">TILLEGG</td></tr>
        }
        @TilleggRad("Oppmøte / kjøring per runde", _prosjekt!.ServiceOppmote, "kr", v => _prosjekt!.ServiceOppmote = v, true)
        @TilleggRad("Reise / bompenger per runde", _prosjekt!.ServiceReise, "kr", v => _prosjekt!.ServiceReise = v, true)
        @TilleggRad("Fast tillegg per runde", _prosjekt!.ServiceFastTillegg, "kr", v => _prosjekt!.ServiceFastTillegg = v, true)
        @TilleggRad("Minstepris per runde", _prosjekt!.ServiceMinstepris, "kr", v => _prosjekt!.ServiceMinstepris = v, false)
        @TilleggRad("Avtalerabatt", _prosjekt!.ServiceRabattProsent, "%", v => _prosjekt!.ServiceRabattProsent = v is > 100 ? 100 : v, false)
    };

    private RenderFragment TilleggRad(string navn, decimal? verdi, string enhet, Action<decimal?> sett, bool sum) => __builder =>
    {
        <tr>
            <td>@navn</td>
            <td></td>
            <td></td>
            <td class="n"><span class="pz-inp"><input value="@Tall(verdi)" placeholder="@(enhet == "%" ? "0" : navn.StartsWith("Minste") ? "Ingen" : "0")" @onchange="@(e => SettTillegg(sett, e.Value))" /><em>@enhet</em></span></td>
            <td class="n">@(sum && verdi is { } v1 ? Kr(v1) : "–")</td>
            <td class="n">@(sum && verdi is { } v2 ? Kr(v2 * Runder) : "–")</td>
            <td></td>
        </tr>
    };

    private async Task SettTillegg(Action<decimal?> sett, object? verdi)
    {
        sett(LesTall(verdi));
        await Db.SaveChangesAsync();
    }

    private async Task GodkjennPris()
    {
        if (_prosjekt is null)
        {
            return;
        }
        var navn = AuthStateTask is null ? null : (await AuthStateTask).User.Identity?.Name;
        _prosjekt.ServiceGodkjentArspris = Beregning.Arspris;
        _prosjekt.ServiceGodkjentDato = DateTime.Now;
        _prosjekt.ServiceGodkjentAv = navn;
        _prosjekt.ServiceGodkjentGrunnlag = ErKategorisert ? ServiceRegelMotor.LagGrunnlag(Resultater.Select(x => (x.Dor.Id, x.Res.Kategori))) : null;
        _prosjekt.ServiceGodkjentRegelversjon = ErKategorisert ? await ServiceRegelMotor.GjeldendeVersjon(Db) : null;
        await Db.SaveChangesAsync();
    }


