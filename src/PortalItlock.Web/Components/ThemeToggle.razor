<button type="button" class="theme-toggle" data-theme-toggle
        data-label-dark="🌙 Mørk modus" data-label-light="☀️ Lys modus"
        title="Bytt fargemodus"
        onclick="theme.toggle(); this.textContent = theme.isDark() ? this.dataset.labelLight : this.dataset.labelDark;">
    🌙 Mørk modus
</button>
