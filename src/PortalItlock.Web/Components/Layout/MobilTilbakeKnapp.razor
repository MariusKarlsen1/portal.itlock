@rendermode InteractiveServer
@implements IDisposable
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject IJSRuntime JS

@* Vises kun i "Gå til fullversjon" (se TopBar.razor) - uten venstre sidemeny
   trenger man en enkel måte å komme seg tilbake i sidehistorikken på når man
   har trykket seg innover i skrivebordsinnholdet. *@
@if (Verktoylinje.FullversjonAktiv)
{
    <button type="button" class="mobil-tilbake-knapp" title="Tilbake" @onclick="GaTilbake">
        <Icon Name="arrow-left" />
    </button>
}

@code {
    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    private async Task GaTilbake()
    {
        await JS.InvokeVoidAsync("appNavigasjon.tilbake");
    }

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
