@rendermode InteractiveServer
@implements IDisposable
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject NavigationManager Nav

@* Vises kun i "Gå til fullversjon" (se TopBar.razor) - uten venstre sidemeny
   trenger man en enkel måte å navigere tilbake på når man har trykket seg
   innover i modulene. Egen historikk (samme oppskrift som NavMenu.razor sin
   GaTilbake()) i stedet for window.history.back(), slik at "tilbake" ALDRI
   kan navigere forbi modul-oversikten og ut til siden man sto på FØR
   fullversjon ble aktivert - står man allerede på roten gjør knappen
   ingenting. *@
@if (Verktoylinje.FullversjonAktiv)
{
    <button type="button" class="mobil-tilbake-knapp" title="Tilbake" @onclick="GaTilbake">
        <Icon Name="arrow-left" />
    </button>
    <button type="button" class="mobil-tilbake-knapp" title="Hjem (modul-oversikten)" @onclick="GaHjem">
        <Icon Name="home" />
    </button>
}

@code {
    private readonly List<string> _historikk = [];
    private bool _gikkTilbake;
    private string _naverendeUrl = "";

    protected override void OnInitialized()
    {
        _naverendeUrl = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Dette ER selve navigasjonen inn i fullversjon (se
        // TopBar.razor.GaTilFullversjon) - start historikken helt blank her,
        // uansett hva som lå der fra før.
        if (e.Location.Contains("fullversjon=1", StringComparison.Ordinal))
        {
            _historikk.Clear();
            _naverendeUrl = e.Location;
            return;
        }

        if (!Verktoylinje.FullversjonAktiv)
        {
            _naverendeUrl = e.Location;
            return;
        }

        if (_gikkTilbake)
        {
            _gikkTilbake = false;
        }
        else
        {
            _historikk.Add(_naverendeUrl);
        }

        _naverendeUrl = e.Location;
    }

    private void GaTilbake()
    {
        if (_historikk.Count == 0)
        {
            // Allerede på modul-oversikten (roten) - ingenting å gå tilbake til.
            return;
        }

        var forrige = _historikk[^1];
        _historikk.RemoveAt(_historikk.Count - 1);
        _gikkTilbake = true;
        Nav.NavigateTo(forrige);
    }

    // Hopper rett til modul-oversikten uansett hvor mange nivåer man har
    // trykket seg inn i - "fullversjon=1" gjør at OnLocationChanged
    // nullstiller historikken helt, akkurat som ved første innlogging.
    private void GaHjem()
    {
        Nav.NavigateTo("/?fullversjon=1");
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
