@rendermode InteractiveServer
@implements IDisposable
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject NavigationManager Nav

@* Vises kun i "Gå til fullversjon" (se TopBar.razor) - uten venstre sidemeny
   trenger man en enkel måte å navigere tilbake på når man har trykket seg
   innover i modulene. "Tilbake" regner ut foreldre-stien ut fra selve URL-en
   (se NavigasjonHjelper) i stedet for faktisk navigasjonshistorikk, slik at
   den alltid går ett steg mot modul-oversikten uansett hvor man kom fra -
   aldri til en helt annen side man tilfeldigvis besøkte tidligere. *@
@if (Verktoylinje.FullversjonAktiv)
{
    <button type="button" class="mobil-tilbake-knapp" title="Tilbake" @onclick="GaTilbake">
        <Icon Name="arrow-left" />
    </button>
    <button type="button" class="mobil-tilbake-knapp" title="Hjem (modul-oversikten)" @onclick="GaHjem">
        <Icon Name="home" />
    </button>
}

@code {
    protected override void OnInitialized()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    private void GaTilbake()
    {
        var relativSti = Nav.ToBaseRelativePath(Nav.Uri);
        var forelder = PortalItlock.Web.Services.NavigasjonHjelper.FinnForelderSti(relativSti);
        Nav.NavigateTo(forelder == "/" ? "/?fullversjon=1" : forelder);
    }

    // Hopper rett til modul-oversikten uansett hvor mange nivåer man har
    // trykket seg inn i.
    private void GaHjem()
    {
        Nav.NavigateTo("/?fullversjon=1");
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
