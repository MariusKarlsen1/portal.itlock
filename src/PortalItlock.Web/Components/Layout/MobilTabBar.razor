@rendermode InteractiveServer
@implements IDisposable
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje

@* Skjules i "Gå til fullversjon" (TopBar.razor) - de fem faste fanene gir
   ikke mening når man i stedet trykker seg gjennom hele modul-oversikten. *@
@if (!Verktoylinje.FullversjonAktiv)
{
    <nav class="mobil-tabbar">
        @foreach (var lenke in Lenker)
        {
            <NavLink class="mobil-tab" href="@lenke.Href" Match="NavLinkMatch.Prefix">
                <Icon Name="@lenke.Ikon" />
                <span>@lenke.Tittel</span>
            </NavLink>
        }
    </nav>
}

@code {
    private sealed record TabLenke(string Tittel, string Href, string Ikon);

    // Samme fem faner for alle roller - Admin, Prosjektleder og Montør har alle tilgang
    // til disse fem sidene, så det er ingen grunn til å variere innholdet på mobil.
    private static readonly List<TabLenke> Lenker =
    [
        new("Oppgaver", "/min-dag", "calendar"),
        new("Arbeidsordre", "/arbeidsordre", "tool"),
        new("Alle prosjekter", "/prosjekter", "folder"),
        new("Timeføring", "/timeregistrering", "clock"),
        new("Søknader", "/fravar", "edit")
    ];

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
