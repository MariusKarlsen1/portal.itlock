@rendermode InteractiveServer
@implements IDisposable
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject PortalItlock.Web.Services.TilleggsmodulService Tilleggsmoduler

@* Skjules i "Gå til fullversjon" (TopBar.razor) - de fem faste fanene gir
   ikke mening når man i stedet trykker seg gjennom hele modul-oversikten. *@
@if (!Verktoylinje.FullversjonAktiv)
{
    <nav class="mobil-tabbar">
        @foreach (var lenke in Lenker.Where(l => l.KreverModul is null || _moduler is null || _moduler.Contains(l.KreverModul)))
        {
            <NavLink class="mobil-tab" href="@lenke.Href" Match="NavLinkMatch.Prefix">
                <Icon Name="@lenke.Ikon" />
                <span>@lenke.Tittel</span>
            </NavLink>
        }
    </nav>
}

@code {
    private sealed record TabLenke(string Tittel, string Href, string Ikon, string? KreverModul = null);

    // Null til modulene er lest, så fanene ikke blinker bort og tilbake.
    private IReadOnlySet<string>? _moduler;

    // Samme fem faner for alle roller - Admin, Prosjektleder og Montør har alle tilgang
    // til disse fem sidene, så det er ingen grunn til å variere innholdet på mobil.
    // Prosjekter, Kalender og Bilen min nås fra montørforsiden (Hjem).
    private static readonly List<TabLenke> Lenker =
    [
        new("Hjem", "/app", "home"),
        new("Oppgaver", "/min-dag", "calendar"),
        new("Arbeidsordre", "/arbeidsordre", "tool"),
        new("Timeføring", "/timeregistrering", "clock", PortalItlock.Web.Models.TilleggsModuler.Timer),
        new("Søknader", "/fravar", "edit", PortalItlock.Web.Models.TilleggsModuler.Timer)
    ];

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        Verktoylinje.Endret += OnVerktoylinjeEndret;
        _moduler = await Tilleggsmoduler.AktiveAsync();
    }

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
