@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Models

<nav class="mobil-tabbar">
    @foreach (var lenke in _lenker)
    {
        <NavLink class="mobil-tab" href="@lenke.Href" Match="@(lenke.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
            <Icon Name="@lenke.Ikon" />
            <span>@lenke.Tittel</span>
        </NavLink>
    }
</nav>

@code {
    private sealed record TabLenke(string Tittel, string Href, string Ikon);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<TabLenke> _lenker =
    [
        new("Min dag", "/min-dag", "calendar"),
        new("Kart", "/kart", "map"),
        new("Prosjekt", "/prosjektmodul", "folder"),
        new("Timer", "/timerfravarmodul", "clock"),
        new("Kalender", "/kalender", "calendar")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle) && rolle != BrukerRolle.Montor)
        {
            _lenker =
            [
                new("Hjem", "/", "folder"),
                new("Prosjekt", "/prosjekteringmodul", "folder"),
                new("Tickets", "/tickets", "tag"),
                new("Ressurser", "/ressursplanlegger", "calendar"),
                new("Kontrolltårn", "/kontrolltarn", "shield")
            ];
        }
    }
}
