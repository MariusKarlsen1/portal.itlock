@* Vises bare når en faktisk Admin ser portalen som en annen bruker, via
   "Vis som" (se TopBar og /account/vis-som).

   Banneret er VIKTIG: dette er ekte impersonering - alt man gjør lagres på
   brukeren man ser portalen som. Derfor står det synlig i alle tre layoutene
   (MainLayout, KundeLayout, DriftLayout), ikke bare i kundeportalen, og det
   sier hvem man er innlogget som akkurat nå.

   Rollen leses fra EkteRolle-claimen, som settes av vis-som-endepunktet. En
   vanlig bruker har den ikke, og ser derfor ingenting her. *@
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db

@* Alt - inkludert stilene - ligger inne i testen, slik at helt vanlige
   sidevisninger ikke drar med seg noe ekstra. *@
@if (_serSomAnnen)
{
    <div class="vis-som-banner">
        <span class="vis-som-banner-tekst">
            <strong>@_navn</strong> &middot; @_rollenavn
            <span class="vis-som-banner-advarsel">alt du gjør lagres på denne brukeren</span>
        </span>

        @if (_kandidater.Count > 1)
        {
            @* Bytt til en annen bruker med samme rolle. Postes som et vanlig
               skjema, samme som rollebryteren, slik at den nye cookien slår
               inn med en gang. *@
            <form class="vis-som-banner-form" method="post" action="/account/vis-som">
                <input type="hidden" name="rolle" value="@_rolle" />
                <input type="hidden" name="returUrl" value="/" />
                <select name="visSomBrukerId" class="vis-som-banner-velg">
                    @foreach (var k in _kandidater)
                    {
                        <option value="@k.Id" selected="@(k.Id == _naverendeId)">@k.Navn</option>
                    }
                </select>
                <button type="submit" class="vis-som-banner-knapp">Bytt bruker</button>
            </form>
        }

        <form method="post" action="/account/vis-som">
            <input type="hidden" name="rolle" value="@nameof(BrukerRolle.Admin)" />
            <input type="hidden" name="returUrl" value="/" />
            <button type="submit" class="vis-som-banner-knapp vis-som-banner-knapp-primaer">Tilbake til meg selv</button>
        </form>
    </div>

    <style>
    .vis-som-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding: 0.4rem 1rem;
        background: #f4e3c7;
        color: #6b4a0a;
        font-size: 0.8rem;
        border-bottom: 1px solid #c79a3a;
    }

    .vis-som-banner-tekst {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .vis-som-banner-advarsel {
        font-size: 0.72rem;
        opacity: 0.85;
    }

    .vis-som-banner-form {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .vis-som-banner-velg {
        border: 1px solid #c79a3a;
        background: #fff;
        color: #6b4a0a;
        border-radius: 7px;
        padding: 0.15rem 0.4rem;
        font: inherit;
        font-size: 0.76rem;
        max-width: 200px;
    }

    .vis-som-banner-knapp {
        border: 1px solid #c79a3a;
        background: #fff;
        color: #6b4a0a;
        border-radius: 7px;
        padding: 0.18rem 0.65rem;
        font: inherit;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }

        .vis-som-banner-knapp:hover {
            background: #fffaf0;
        }

    .vis-som-banner-knapp-primaer {
        background: #6b4a0a;
        border-color: #6b4a0a;
        color: #fff;
    }

        .vis-som-banner-knapp-primaer:hover {
            background: #553a08;
            color: #fff;
        }
    </style>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private sealed record Kandidat(int Id, string Navn);

    private bool _serSomAnnen;
    private string _rolle = "";
    private string _rollenavn = "";
    private string _navn = "";
    private int? _naverendeId;
    private List<Kandidat> _kandidater = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;

        // AdminBrukerId settes bare når man faktisk ser portalen som en annen
        // bruker - er den der OG den ekte rollen er Admin, er vi i gang.
        var adminId = state.User.FindFirst("AdminBrukerId")?.Value;
        var ekte = state.User.FindFirst("EkteRolle")?.Value;
        _serSomAnnen = adminId is not null && ekte == nameof(BrukerRolle.Admin);

        if (!_serSomAnnen)
        {
            return;
        }

        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _navn = state.User.Identity?.Name ?? "Ukjent bruker";
        _naverendeId = int.TryParse(state.User.FindFirst("BrukerId")?.Value, out var id) ? id : null;

        if (rolleClaim is null || !Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle))
        {
            return;
        }

        _rolle = rolleClaim;
        _rollenavn = rolle.Visningsnavn();

        // Hvem man kan bytte til: alle aktive brukere med samme rolle.
        _kandidater = await Db.Brukere
            .AsNoTracking()
            .Where(b => b.Aktiv && b.Rolle == rolle)
            .OrderBy(b => b.Navn)
            .Select(b => new Kandidat(b.Id, b.Navn))
            .ToListAsync();
    }
}
