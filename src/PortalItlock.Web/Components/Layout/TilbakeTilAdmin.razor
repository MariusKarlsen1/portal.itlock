@* Vises bare når en faktisk Admin ser portalen gjennom "Vis som" (se TopBar og
   /account/vis-som). Kunde- og driftsportalen har ikke toppfeltet med
   rollebryteren, så uten denne ville man blitt sittende fast i rollen til man
   logget ut og inn igjen.

   Rollen leses fra EkteRolle-claimen, som settes av vis-som-endepunktet. En
   vanlig kunde eller vaktmester har den ikke, og ser derfor ingenting her. *@
@using Microsoft.AspNetCore.Components.Authorization
@using PortalItlock.Web.Models

@if (_erAdminSomSerSomAnnenRolle)
{
    <form class="tilbake-til-admin" method="post" action="/account/vis-som">
        <input type="hidden" name="rolle" value="@nameof(BrukerRolle.Admin)" />
        <input type="hidden" name="returUrl" value="/" />
        <span class="tilbake-til-admin-tekst">Du ser portalen som @Rollenavn</span>
        <button type="submit" class="tilbake-til-admin-knapp">Tilbake til admin</button>
    </form>
}

<style>
    .tilbake-til-admin {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        padding: 0.45rem 1rem;
        background: #f4e3c7;
        color: #6b4a0a;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .tilbake-til-admin-knapp {
        border: 1px solid #c79a3a;
        background: #fff;
        color: #6b4a0a;
        border-radius: 7px;
        padding: 0.2rem 0.7rem;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
    }

        .tilbake-til-admin-knapp:hover {
            background: #fffaf0;
        }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _erAdminSomSerSomAnnenRolle;
    private string Rollenavn { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var ekte = state.User.FindFirst("EkteRolle")?.Value;
        var naa = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        _erAdminSomSerSomAnnenRolle = ekte == nameof(BrukerRolle.Admin) && naa != ekte;

        Rollenavn = naa is not null && Enum.TryParse<BrukerRolle>(naa, out var rolle)
            ? rolle.Visningsnavn().ToLowerInvariant()
            : "en annen rolle";
    }
}
