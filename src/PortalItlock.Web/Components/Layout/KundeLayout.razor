@inherits LayoutComponentBase
@using PortalItlock.Web.Services
@inject ITenantContext TenantCtx

@* Kundeportalen bruker samme oppsett og stil som driftsportalen (wwwroot/drift.css). *@
<div class="kunde-page dp">
    <TilbakeTilAdmin />
    <header class="dp-header">
        <a class="dp-merke" href="/kunde">
            @if (TenantCtx.Current?.LogoData is not null)
            {
                <img src="organisasjon/logo" alt="@Firmanavn" class="dp-logo logo-adaptive" />
            }
            else
            {
                <img src="fk-logo-mark.png?v=2" alt="Full Kontroll" class="dp-logo logo-adaptive" />
            }
            <span class="dp-merke-tekst">@Firmanavn<small>Kundeportal</small></span>
        </a>

        <nav class="dp-toppnav">
            <NavLink href="/kunde" Match="NavLinkMatch.All">Oversikt</NavLink>
            <NavLink href="/kunde/jobber">Jobber</NavLink>
            <NavLink href="/kunde/saker">Saker</NavLink>
        </nav>

        <div class="dp-header-handlinger">
            <a class="dp-knapp dp-knapp-meld dp-kun-pc" href="/kunde/ny"><Icon Name="plus" />Ny henvendelse</a>
            <ThemeToggle />
            <form method="post" action="/account/logout" class="drift-logout-form">
                <button type="submit" class="dp-rundknapp" title="Logg ut"><Icon Name="log-out" /></button>
            </form>
        </div>
    </header>

    <main class="dp-innhold">
        @Body
    </main>

    <nav class="dp-tabbar dp-tabbar-4">
        <NavLink href="/kunde" Match="NavLinkMatch.All"><Icon Name="home" />Hjem</NavLink>
        <NavLink href="/kunde/jobber"><Icon Name="calendar" />Jobber</NavLink>
        <NavLink href="/kunde/ny" class="dp-tab-midt"><span><Icon Name="plus" /></span>Ny</NavLink>
        <NavLink href="/kunde/saker"><Icon Name="mail" />Saker</NavLink>
    </nav>
</div>
<UtloggingVakt @rendermode="InteractiveServer" />

@code {
    private string Firmanavn => TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn ?? "Full Kontroll";
}
