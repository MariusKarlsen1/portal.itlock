@inherits LayoutComponentBase
@using PortalItlock.Web.Services
@inject ITenantContext TenantCtx

<div class="kunde-page">
    <header class="kunde-header">
        @if (TenantCtx.Current?.LogoData is not null)
        {
            <img src="organisasjon/logo" alt="@(TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn)" class="kunde-logo logo-adaptive" />
        }
        else
        {
            <img src="fk-logo-mark.png?v=2" alt="Full Kontroll" class="kunde-logo logo-adaptive" />
        }
        <div class="kunde-header-actions">
            <ThemeToggle />
            <form method="post" action="/account/logout" class="kunde-logout-form">
                <button type="submit" class="kunde-logout-button">Logg ut</button>
            </form>
        </div>
    </header>

    <main class="kunde-content">
        @Body
    </main>
</div>
