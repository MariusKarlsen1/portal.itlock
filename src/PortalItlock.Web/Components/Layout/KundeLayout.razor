@inherits LayoutComponentBase

<div class="kunde-page">
    <header class="kunde-header">
        <img src="proxima-logo.png" alt="Proxima" class="kunde-logo logo-adaptive" />
        <div class="kunde-header-actions">
            <ThemeToggle />
            <form method="post" action="/account/logout" class="kunde-logout-form">
                <button type="submit" class="kunde-logout-button">Logg ut</button>
            </form>
        </div>
    </header>

    <main class="kunde-content">
        @Body
    </main>
</div>
