@inherits LayoutComponentBase
@using PortalItlock.Web.Components.Kassa
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject NavigationManager Nav
@inject ITenantContext TenantCtx
@inject KassaService Kassa
@inject TilleggsmodulService Tilleggsmoduler

@* Kassa i fullskjerm: sort sidemeny med butikknavnet øverst, og innholdet til
   høyre. Salgsskjermen (/kassa) har sin egen toppstripe med søk, de andre
   sidene får en enkel stripe med tittel og dato. Laget for PC og nettbrett
   ved skranken (se wwwroot/kassa.css). *@
<div class="ks">
    <nav class="ks-meny">
        <a class="ks-logo" href="/kassa"><i><KassaIkon Navn="las" /></i><div><b>@_butikk</b><small>Kassa</small></div></a>
        <NavLink class="ks-lenke" href="/kassa" Match="NavLinkMatch.All"><KassaIkon Navn="kurv" /><span>Kasse</span></NavLink>
        @if (_leder)
        {
            <NavLink class="ks-lenke" href="/kassa/varer"><KassaIkon Navn="boks" /><span>Produkter</span></NavLink>
        }
        <NavLink class="ks-lenke" href="/kassa/journal"><KassaIkon Navn="kvittering" /><span>Salg i dag</span></NavLink>
        @if (_harLager)
        {
            <a class="ks-lenke" href="/lager"><KassaIkon Navn="skap" /><span>Lager</span></a>
        }
        <NavLink class="ks-lenke" href="/kassa/dagsoppgjor"><KassaIkon Navn="kalender" /><span>Dagsoppgjør</span></NavLink>
        @if (_leder)
        {
            <NavLink class="ks-lenke" href="/kassa/maned"><KassaIkon Navn="rapport" /><span>Rapporter</span></NavLink>
            <NavLink class="ks-lenke" href="/kassa/bank"><KassaIkon Navn="bank" /><span>Bankavstemming</span></NavLink>
        }
        <div class="ks-bunn">
            <span class="ks-avatar">@Initialer</span>
            <div><b>@_navn</b><small>@_kasseNavn</small></div>
            <a href="/" title="Tilbake til portalen" aria-label="Tilbake til portalen"><KassaIkon Navn="tilbake" /></a>
        </div>
    </nav>
    <div class="ks-hoved">
        @if (ErSalg)
        {
            <main class="ks-innhold ks-innhold-salg">@Body</main>
        }
        else
        {
            <header class="ks-stripe">
                <h1>@Tittel</h1>
                <span class="ks-sti">@NorskTid.Idag.ToString("dddd d. MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("nb-NO"))</span>
                <div class="ks-hoyre"><span class="ks-status">Kassen er åpen</span></div>
            </header>
            <main class="ks-innhold">@Body</main>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private string _navn = "";
    private string _kasseNavn = "Kasse";
    private string _butikk = "Kassa";
    private bool _leder;
    private bool _harLager;

    private string Initialer => string.Concat(_navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));

    private string Sti => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private bool ErSalg => Sti is "/kassa" or "";

    private string Tittel => Sti switch
    {
        "/kassa/journal" => "Salg i dag",
        "/kassa/dagsoppgjor" => "Dagsoppgjør",
        "/kassa/maned" => "Månedsoppgjør",
        "/kassa/bank" => "Bankavstemming",
        "/kassa/varer" => "Produkter",
        _ => "Kasse"
    };

    protected override async Task OnInitializedAsync()
    {
        _butikk = RapportProfil.Fra(TenantCtx.Current).Navn;
        _kasseNavn = (await Kassa.OppsettAsync()).KasseNavn;
        _harLager = await Tilleggsmoduler.HarAsync(TilleggsModuler.Lager);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var bruker = (await AuthStateTask).User;
            _navn = bruker.FindFirst("Navn")?.Value ?? bruker.Identity?.Name ?? "";
            _leder = bruker.IsInRole(nameof(BrukerRolle.Admin)) || bruker.IsInRole(nameof(BrukerRolle.Prosjektleder));
        }
    }
}
