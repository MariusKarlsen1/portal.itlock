@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="pfl-shell">
    <div class="pfl-main">
        <header class="pfl-topbar">
            <label class="pfl-sok">
                <Icon Name="search" />
                <input type="search" class="pfl-sok-input" placeholder="Søk etter organisasjoner, domener, brukere, prosjekter, fakturaer..." />
                <span class="pfl-sok-kbd">⌘K</span>
            </label>
            <div class="pfl-topbar-actions">
                <button type="button" class="pfl-bjelle" aria-label="Varsler">
                    <Icon Name="bell" />
                    <span class="pfl-bjelle-dot"></span>
                </button>
                <details class="pfl-bruker-wrap">
                    <summary class="pfl-bruker">
                        <span class="pfl-bruker-avatar">@Initialer</span>
                        <span class="pfl-bruker-tekst">
                            <span class="pfl-bruker-navn">@BrukerNavn</span>
                            <span class="pfl-bruker-rolle">Admin</span>
                        </span>
                        <Icon Name="chevron-down" />
                    </summary>
                    <div class="pfl-brukermeny">
                        <form method="post" action="/plattform/konto/logout" class="pfl-logout-form">
                            <button type="submit" class="pfl-logout-button"><Icon Name="log-out" /> Logg ut</button>
                        </form>
                    </div>
                </details>
            </div>
        </header>
        <main class="pfl-content">
            @Body
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string BrukerNavn = "Admin";
    private string Initialer = "A";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var navn = state.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            if (!string.IsNullOrWhiteSpace(navn))
            {
                BrukerNavn = navn;
                var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                Initialer = deler.Length >= 2
                    ? $"{deler[0][0]}{deler[^1][0]}".ToUpperInvariant()
                    : navn[..Math.Min(2, navn.Length)].ToUpperInvariant();
            }
        }
    }
}
