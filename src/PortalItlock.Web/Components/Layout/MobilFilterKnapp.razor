@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Http
@using PortalItlock.Web.Services
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject PersistentComponentState PersistentState
@inject IJSRuntime JS

@if (Verktoylinje.ErMobilvisning && Verktoylinje.HarFilter)
{
    <button type="button" class="mobil-filter-knapp @(Verktoylinje.FilterErAktivt ? "aktiv" : "")" title="Filtrer" @onclick="() => Verktoylinje.UtlosFilter()">
        <Icon Name="filter" />
    </button>
}

@code {
    // MainLayout er en Layout-komponent og kan ikke selv ha @rendermode -
    // et forsøk på det kastet en serverfeil i prod (se commit-historikk).
    // Ekte Blazor-interaktivitet (@onclick, IJSRuntime) må derfor skje i en
    // egen "øy" akkurat som TopBar.razor allerede gjør - denne komponenten er
    // den øya for filterknappen og mobilvisning-deteksjonen den styres av.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private const string PersistNokkel = "erMobilvisning";
    private PersistingComponentStateSubscription _persistAbonnement;

    protected override void OnInitialized()
    {
        // Prerendering og den interaktive kretsen er to HELT SEPARATE
        // komponent-instanser (ulik DI-scope) - et førsteinntrykk satt her
        // under prerendering (via HttpContext/UA) påvirker BARE den statiske
        // HTML-en som males aller først. Når den interaktive kretsen så
        // kobler til og bygger SIN EGEN, ferske instans, startet den
        // tidligere alltid på nytt fra "skrivebord" (false) igjen inntil
        // JS-interop-kallet under rakk å bekrefte ekte vindusbredde - selve
        // omkoblingen fra prerendret HTML til denne ferske, midlertidig
        // feilaktige tilstanden var det synlige blaffet som kom "av og til"
        // (varigheten varierte med hvor raskt JS-interop-rundturen gikk).
        //
        // PersistentComponentState løser dette ordentlig: verdien fra
        // prerenderingen lagres i en skjult del av HTML-responsen og hentes
        // rett ut igjen når den interaktive instansen starter, uten noen ny
        // nettverksrunde og uten noe mellomliggende feil-blaff.
        if (PersistentState.TryTakeFromJson<bool>(PersistNokkel, out var gjenopprettet))
        {
            Verktoylinje.SettMobilvisning(gjenopprettet);
        }
        else if (HttpContext is not null)
        {
            Verktoylinje.SettMobilvisning(MobilDeteksjon.GjettFraUserAgent(HttpContext.Request.Headers.UserAgent.ToString()));
        }

        _persistAbonnement = PersistentState.RegisterOnPersisting(() =>
        {
            PersistentState.PersistAsJson(PersistNokkel, Verktoylinje.ErMobilvisning);
            return Task.CompletedTask;
        });

        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // "Gå til fullversjon" (TopBar.razor) huskes i localStorage og
            // skal vinne over den vanlige bredde-deteksjonen ved en helt ny
            // sideinnlasting - ellers ville denne (og TopBar sin egen
            // tilsvarende gjenoppretting) kunne kappes om hvem som "vinner"
            // avhengig av rekkefølgen de to øy-komponentene rendres i.
            var fullversjonAktiv = await JS.InvokeAsync<string?>("localStorage.getItem", "itlock-fullversjon") == "1";
            if (fullversjonAktiv)
            {
                Verktoylinje.SettMobilvisning(false);
                Verktoylinje.SettFullversjon(true);
            }
            else
            {
                Verktoylinje.SettMobilvisning(await JS.InvokeAsync<bool>("erMobilvisning"));
            }
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _persistAbonnement.Dispose();
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
