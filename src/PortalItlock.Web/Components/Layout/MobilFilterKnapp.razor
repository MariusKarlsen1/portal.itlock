@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Http
@using PortalItlock.Web.Services
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject IJSRuntime JS

@if (Verktoylinje.ErMobilvisning && Verktoylinje.HarFilter)
{
    <button type="button" class="mobil-filter-knapp @(Verktoylinje.FilterErAktivt ? "aktiv" : "")" title="Filtrer" @onclick="() => Verktoylinje.UtlosFilter()">
        <Icon Name="filter" />
    </button>
}

@code {
    // MainLayout er en Layout-komponent og kan ikke selv ha @rendermode -
    // et forsøk på det kastet en serverfeil i prod (se commit-historikk).
    // Ekte Blazor-interaktivitet (@onclick, IJSRuntime) må derfor skje i en
    // egen "øy" akkurat som TopBar.razor allerede gjør - denne komponenten er
    // den øya for filterknappen og mobilvisning-deteksjonen den styres av.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Se tilsvarende kommentar i MobilDeteksjon.cs - kun et førsteinntrykk
        // for prerenderingen, for å unngå at gammel skrivebordsmarkup blafrer
        // synlig på ekte telefoner før JS-interop (OnAfterRenderAsync under)
        // bekrefter faktisk vindusbredde.
        if (HttpContext is not null)
        {
            Verktoylinje.SettMobilvisning(MobilDeteksjon.GjettFraUserAgent(HttpContext.Request.Headers.UserAgent.ToString()));
        }

        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Verktoylinje.SettMobilvisning(await JS.InvokeAsync<bool>("erMobilvisning"));
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
