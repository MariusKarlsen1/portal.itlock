@inherits LayoutComponentBase
@using PortalItlock.Web.Services
@inject ITenantContext TenantCtx
@inject AuthenticationStateProvider AuthState
@using Microsoft.AspNetCore.Components.Authorization

<div class="drift-page dp">
    <TilbakeTilAdmin />
    <header class="dp-header">
        <a class="dp-merke" href="/drift">
            @if (TenantCtx.Current?.LogoData is not null)
            {
                <img src="organisasjon/logo" alt="@Firmanavn" class="dp-logo logo-adaptive" />
            }
            else
            {
                <FkLogo Klasse="fk-logo-dp" />
            }
            <span class="dp-merke-tekst">@Firmanavn<small>Driftsportal</small></span>
        </a>

        <nav class="dp-toppnav">
            <NavLink href="/drift" Match="NavLinkMatch.All">Mine bygg</NavLink>
            <NavLink href="/drift/meldinger">Meldinger</NavLink>
        </nav>

        <div class="dp-header-handlinger">
            <a class="dp-knapp dp-knapp-meld dp-kun-pc" href="/drift/meld"><Icon Name="plus" />Meld inn en feil</a>
            @* Driftsportalen har bare lys modus (forslag driftsportal-ny.html). *@
            <a class="dp-profil" href="/drift/konto" title="Min konto">
                <span class="dp-profil-av">@_initialer</span>
                <span class="dp-kun-pc">Min konto</span>
            </a>
        </div>
    </header>

    <main class="dp-innhold">
        @Body
    </main>

    <nav class="dp-tabbar dp-tabbar-4">
        <NavLink href="/drift" Match="NavLinkMatch.All"><Icon Name="home" />Bygg</NavLink>
        <NavLink href="/drift/meld" class="dp-tab-midt"><span><Icon Name="plus" /></span>Meld feil</NavLink>
        <NavLink href="/drift/meldinger"><Icon Name="bell" />Meldinger</NavLink>
        <NavLink href="/drift/konto"><Icon Name="user" />Konto</NavLink>
    </nav>
</div>
<UtloggingVakt @rendermode="InteractiveServer" />

@code {
    private string _initialer = "";

    protected override async Task OnInitializedAsync()
    {
        var navn = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        _initialer = string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));
    }

    private string Firmanavn => TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn ?? "Full Kontroll";
}
