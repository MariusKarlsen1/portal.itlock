@inherits LayoutComponentBase
@using PortalItlock.Web.Services
@inject ITenantContext TenantCtx

<div class="drift-page dp">
    <TilbakeTilAdmin />
    <header class="dp-header">
        <a class="dp-merke" href="/drift">
            @if (TenantCtx.Current?.LogoData is not null)
            {
                <img src="organisasjon/logo" alt="@Firmanavn" class="dp-logo logo-adaptive" />
            }
            else
            {
                <img src="fk-logo-mark.png?v=2" alt="Full Kontroll" class="dp-logo logo-adaptive" />
            }
            <span class="dp-merke-tekst">@Firmanavn<small>Driftsportal</small></span>
        </a>

        <nav class="dp-toppnav">
            <NavLink href="/drift" Match="NavLinkMatch.All">Oversikt</NavLink>
            <NavLink href="/drift/meldinger">Meldinger</NavLink>
        </nav>

        <div class="dp-header-handlinger">
            <a class="dp-knapp dp-knapp-meld dp-kun-pc" href="/drift/meld"><Icon Name="plus" />Meld inn en feil</a>
            <ThemeToggle />
            <form method="post" action="/account/logout" class="drift-logout-form">
                <button type="submit" class="dp-rundknapp" title="Logg ut"><Icon Name="log-out" /></button>
            </form>
        </div>
    </header>

    <main class="dp-innhold">
        @Body
    </main>

    <nav class="dp-tabbar">
        <NavLink href="/drift" Match="NavLinkMatch.All"><Icon Name="home" />Hjem</NavLink>
        <NavLink href="/drift/meld" class="dp-tab-midt"><span><Icon Name="plus" /></span>Meld feil</NavLink>
        <NavLink href="/drift/meldinger"><Icon Name="bell" />Meldinger</NavLink>
    </nav>
</div>

@code {
    private string Firmanavn => TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn ?? "Full Kontroll";
}
