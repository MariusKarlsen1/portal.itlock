@inherits LayoutComponentBase
@using PortalItlock.Web.Services
@inject ITenantContext TenantCtx

<div class="drift-page">
    <header class="drift-header">
        @if (TenantCtx.Current?.LogoData is not null)
        {
            <img src="organisasjon/logo" alt="@(TenantCtx.Current?.PortalVisningsnavn ?? TenantCtx.Current?.Navn)" class="drift-logo logo-adaptive" />
        }
        else
        {
            <img src="fk-logo-mark.png?v=2" alt="Full Kontroll" class="drift-logo logo-adaptive" />
        }
        <div class="drift-header-actions">
            <ThemeToggle />
            <form method="post" action="/account/logout" class="drift-logout-form">
                <button type="submit" class="drift-logout-button">Logg ut</button>
            </form>
        </div>
    </header>

    <main class="drift-content">
        @Body
    </main>
</div>
