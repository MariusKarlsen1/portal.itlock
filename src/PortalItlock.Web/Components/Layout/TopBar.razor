    private const string SettLagringsNokkel = "itlock-varsler-sett";
    private Dictionary<string, int> _sett = [];

    private static string Nokkel(Varselpunkt p) => p.Href + "|" + p.Tittel.Split(' ')[0];

    private int UsetteVarsler => Varselpunkter.Sum(p => Math.Max(0, p.Antall - _sett.GetValueOrDefault(Nokkel(p))));

