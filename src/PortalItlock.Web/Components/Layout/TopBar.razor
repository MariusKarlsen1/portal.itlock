    // Flat pool av BÅDE modul-hubene og deres undermoduler (f.eks.
    // "Arbeidsordre" inni "Prosjekt modul") - brukes til snarvei-listen øverst,
    // slik at en fastnålet undermodul også kan vises som snarvei ved navnet,
    // ikke bare selve huben.
    private List<Lenke> AlleLenkerInklUndermoduler => TilgjengeligeLenker
        .SelectMany(hub => new[] { hub }.Concat(hub.Undermoduler ?? []))
        .ToList();

    // Grupperer Tilpass meny PER MODUL (hub) i stedet for per rolle, slik at
    // f.eks. "Arbeidsordre" dukker opp som egen rad under "Prosjekt modul" -
    // ikke bare som ett samlet av/på-valg for hele huben. Modulen selv beholder
    // opt-out-oppførselen (vist med mindre den er skjult), mens undermodulene
    // er opt-in (skjult med mindre eksplisitt lagt til) siden det ville blitt
    // altfor mange lenker i sidemenyen om alle vistes som standard.
    private List<(Lenke Modul, List<Lenke> Undermoduler)> ModulGrupper
    {
        get
        {
            return TilgjengeligeLenker
                .DistinctBy(hub => hub.Href)
                .Select(hub => (hub, hub.Undermoduler ?? []))
                .ToList();
        }
    }

    private List<Lenke> Snarveier => AlleLenkerInklUndermoduler.Where(l => _snarveier.Contains(l.Href)).ToList();

    // Tilleggsmoduler organisasjonen har (styrer f.eks. om Lager vises).
    private IReadOnlySet<string> _aktiveModuler = new HashSet<string>();

    protected override async Task OnInitializedAsync()
    {
        _aktiveModuler = await Tilleggsmoduler.AktiveAsync();
        // Fanger opp FullversjonAktiv når MobilFilterKnapp (som gjenoppretter
        // fullversjon-tilstanden ved sideinnlasting, se der) setter den EFTER
        // at denne komponentens egen OnAfterRenderAsync allerede har lest den
        // - rekkefølgen de to øy-komponentene rendres i er ikke garantert.
        Verktoylinje.Endret += OnVerktoylinjeEndret;

        if (AuthStateTask is null)
        {
            return;
        }

        var state = await AuthStateTask;
        var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _visUtvidetVarsel = rolleClaim is "Admin" or "Prosjektleder";
        _erAdmin = rolleClaim is "Admin";
        _naverendeRolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle) ? rolle : null;

        _visningsRolle = _naverendeRolle;

        var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
        if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
        {
            _naverendeBrukerId = bid;
            _naverendeBruker = await Db.Brukere.FindAsync(bid);

            // Den ekte rollen leses fra databasen, ikke fra cookien. Ser man
            // portalen som en ANNEN bruker ("Vis som"), er BrukerId over den
            // brukerens - da ligger administratorens egen id i AdminBrukerId,
            // og det er den som avgjør om rollebryteren skal vises. Uten dette
            // ville bryteren forsvunnet så snart man byttet, og man kom seg
            // ikke tilbake.
            var adminIdClaim = state.User.FindFirst("AdminBrukerId")?.Value;
            if (int.TryParse(adminIdClaim, out var adminId))
            {
                _ekteRolle = (await Db.Brukere.FindAsync(adminId))?.Rolle;
            }
            else
            {
                _ekteRolle = _naverendeBruker?.Rolle;
            }

            if (_ekteRolle == BrukerRolle.Admin)
            {
                _rollerMedAktivBruker = await Db.Brukere
                    .AsNoTracking()
                    .Where(b => b.Aktiv)
                    .Select(b => b.Rolle)
                    .Distinct()
                    .ToListAsync();

                if (await Tilleggsmoduler.HarAsync(PortalItlock.Web.Models.TilleggsModuler.Lager))
                {
                    _harLager = true;
                    _reserverAuto = await Db.LagerInnstillinger.AsNoTracking().Select(i => (bool?)i.ReserverAutomatisk).FirstOrDefaultAsync() ?? true;
                }
            }

            var skjult = _naverendeBruker?.SkjulteNavLenker;
            _skjulteLenker = string.IsNullOrWhiteSpace(skjult)
                ? []
                : skjult.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();

            var snarveier = _naverendeBruker?.TopplinjeSnarveier;
            _snarveier = string.IsNullOrWhiteSpace(snarveier)
                ? []
                : snarveier.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();

            var ekstra = _naverendeBruker?.EkstraNavLenker;
            _ekstraLenker = string.IsNullOrWhiteSpace(ekstra)
                ? []
                : ekstra.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();

            _hjemLayoutValg = _naverendeBruker?.HjemLayoutValg ?? HjemLayout.Fjord;

            Presence.Registrer(_oktId, _naverendeBrukerId.Value, _naverendeBruker?.Navn ?? "Ukjent bruker");
        }

        Teller = await VarselTellerSvc.HentAsync(_visUtvidetVarsel, _erAdmin);

        if (_naverendeBrukerId.HasValue)
        {
            _notater = await Db.Notater
                .Where(n => n.BrukerId == _naverendeBrukerId.Value)
                .OrderByDescending(n => n.OpprettetDato)
                .ToListAsync();
        }
    }

    private void OnVerktoylinjeEndret()
    {
        _fullversjonAktiv = Verktoylinje.FullversjonAktiv;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Presence.Fjern(_oktId);
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
        _selvRef?.Dispose();
    }

    // ---------- Lukk nedtrekkene ved klikk utenfor ----------
    //
    // Nedtrekkene i toppfeltet krevde tidligere at man traff samme knapp en
    // gang til. Nå lytter vi på klikk ellers på siden mens noe er åpent (se
    // wwwroot/js/utenforklikk.js) og lukker alt. Lytteren legges bare på mens
    // noe faktisk er åpent, så vi ikke sender et kall for hvert klikk.
    private DotNetObjectReference<TopBar>? _selvRef;
    private bool _lytterPaUtenforKlikk;

    private bool NoeErApent => _visBrukerMeny || _visVarslerTopp || _visNotater || _visSok;

    [JSInvokable]
    public async Task LukkAlleNedtrekk()
    {
        if (!NoeErApent)
        {
            await OppdaterUtenforKlikk();
            return;
        }

        _visBrukerMeny = false;
        _visInnstillinger = false;
        _visVarslerTopp = false;
        _visNotater = false;
        _visSok = false;
        _visAktiveBrukere = false;
        StateHasChanged();

        // Stopp lytteren også - ellers blir den hengende og lukker neste
        // nedtrekk i samme øyeblikk som det åpnes.
        await OppdaterUtenforKlikk();
    }

    // Kalles etter hver toggle. Starter eller stopper lytteren avhengig av om
    // det er noe åpent å lukke.
    private async Task OppdaterUtenforKlikk()
    {
        if (NoeErApent == _lytterPaUtenforKlikk)
        {
            return;
        }

        _lytterPaUtenforKlikk = NoeErApent;

        try
        {
            if (_lytterPaUtenforKlikk)
            {
                _selvRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("utenforKlikk.lytt", _selvRef);
            }
            else
            {
                await JS.InvokeVoidAsync("utenforKlikk.stopp");
            }
        }
        catch (JSDisconnectedException)
        {
            // Kretsen er borte - ingenting å lukke.
        }
    }

    private async Task ToggleSok()
    {
        _visSok = !_visSok;
        await OppdaterUtenforKlikk();
    }

