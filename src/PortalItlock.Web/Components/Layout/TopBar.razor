@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject PortalItlock.Web.Services.TilleggsmodulService Tilleggsmoduler
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VarselTellerService VarselTellerSvc
@inject PortalItlock.Web.Services.PresenceService Presence
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject IJSRuntime JS

<div class="topbar">
    @* "Vis som" - bare for den som faktisk er Admin i databasen. Skjemaet
       postes til /account/vis-som, som sjekker den ekte rollen på nytt der;
       denne menyen er bare bekvemmelighet, ikke sikkerheten. *@
    @if (_ekteRolle == BrukerRolle.Admin && !_erMobilvisning)
    {
        @* Vanlig skjema-post, samme som utloggingsknappen - da laster siden
           på nytt og den nye cookien slår inn med en gang. *@
        <form class="visSom" method="post" action="/account/vis-som">
            <input type="hidden" name="returUrl" value="@NaverendeSti" />
            <span class="visSom-merke" title="Du ser portalen som denne rollen">Vis som</span>
            @foreach (var rolle in TilgjengeligeVisSomRoller)
            {
                <button type="submit" name="rolle" value="@rolle"
                        class="visSom-knapp @(_visningsRolle == rolle ? "aktiv" : "")">
                    @rolle.Visningsnavn()
                </button>
            }
        </form>
    }

    @if (Snarveier.Count > 0 && !_erMobilvisning)
    {
        <div class="topplinje-snarveier">
            @foreach (var lenke in Snarveier)
            {
                <NavLink class="topplinje-snarvei" href="@lenke.Href">@lenke.Tittel</NavLink>
            }
        </div>
    }

    @if (_visUtvidetVarsel && _snarveier.Contains("ai-assistent") && !_erMobilvisning)
    {
        <NavLink class="topplinje-snarvei topbar-snarvei-ikonlenke" href="ai-assistent">
            <Icon Name="sparkle" /> AI
        </NavLink>
    }

    @* AI-knapp ved bjella - vises bare på forsiden i Layout 3 (se MainLayout.razor.css),
       for de samme rollene som har AI ellers (Admin og Prosjektleder). *@
    @if (_visUtvidetVarsel)
    {
        <a class="topbar-ai" href="ai-assistent" title="AI-assistent"><Icon Name="sparkle" /> AI</a>
    }

    @if (_snarveier.Contains("varsler"))
    {
        <div class="varsel-wrap" @onclick:stopPropagation="true">
            <button type="button" class="varsel-ikon-knapp @(_visVarslerTopp ? "apen" : "")" title="Varsler" @onclick="ToggleVarslerTopp">
                <Icon Name="bell" />
                @if (UsetteVarsler > 0)
                {
                    <span class="varsel-badge">@UsetteVarsler</span>
                }
            </button>

            @* VB1 (varsel-forslag): ryddig og gruppert. Hvert varsel har eget ikon
               og farge, tittel, en kort forklaring og tallet til høyre (rødt når
               det haster). «Merk alle som sett» tar bort tallet på bjella til
               noe nytt kommer. *@
            @if (_visVarslerTopp)
            {
                var punkter = Varselpunkter;
                <div class="vb-panel">
                    <div class="vb-topp">
                        <h3>Varsler</h3>
                        @if (Teller.Totalt > 0)
                        {
                            <span class="vb-antall">@Teller.Totalt</span>
                        }
                        <span class="vb-topp-hoyre">
                            @if (UsetteVarsler > 0)
                            {
                                <button type="button" class="vb-lenkeknapp" @onclick="MerkAlleSomSett">Merk alle som sett</button>
                            }
                            <button type="button" class="vb-lukk" title="Lukk" @onclick="ToggleVarslerTopp"><Icon Name="x" /></button>
                        </span>
                    </div>

                    <div class="vb-innhold">
                        @if (punkter.Count == 0)
                        {
                            <div class="vb-tom">
                                <span class="vb-tom-ikon"><Icon Name="check" /></span>
                                <b>Alt er i orden</b>
                                <span>Ingen varsler akkurat nå. Nye ting dukker opp her.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var (gruppe, tittel) in new[] { ("handling", "Krever handling"), ("oppdatering", "Oppdateringer") })
                            {
                                var iGruppe = punkter.Where(p => p.Gruppe == gruppe).ToList();
                                if (iGruppe.Count == 0)
                                {
                                    continue;
                                }
                                <p class="vb-gruppe">@tittel · @iGruppe.Sum(p => p.Antall)</p>
                                @foreach (var p in iGruppe)
                                {
                                    <a class="vb-rad" href="@p.Href" @onclick="LukkVarslerTopp">
                                        <span class="vb-ikon vb-ikon-@p.Farge"><Icon Name="@p.Ikon" /></span>
                                        <span class="vb-tekst">
                                            <b>@p.Tittel</b>
                                            <small>@p.Forklaring</small>
                                        </span>
                                        <span class="vb-tall @(p.Haster ? "haster" : p.Farge == "gul" ? "middels" : "")">@p.Antall</span>
                                        <span class="vb-pil"><Icon Name="chevron-right" /></span>
                                    </a>
                                }
                            }
                        }
                    </div>

                    <div class="vb-fot">
                        <button type="button" class="vb-lenkeknapp" @onclick="AapneVarselinnstillinger"><Icon Name="settings" />Varselinnstillinger</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="sok-wrap" @onclick:stopPropagation="true">
        @if (_visSok)
        {
            <input class="top-sok-input" @bind="_sokTekst" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") { await UtforSok(); } if (e.Key == "Escape") { _visSok = false; } })"
                   placeholder="Søk kunder, prosjekter, tickets..." />
        }
        <button type="button" class="sok-ikon-knapp" title="Søk" @onclick="ToggleSok"><Icon Name="search" /></button>
    </div>

    <div class="notater-wrap" @onclick:stopPropagation="true">
        <button type="button" class="notater-ikon-knapp" title="Notater" @onclick="ToggleNotater"><Icon Name="file-text" /></button>

        @if (_visNotater)
        {
            <div class="notater-panel">
                <p class="notater-hint">Egne notater - kun synlig for deg.</p>
                <textarea class="notater-tekstfelt" @bind="_nyttNotat" @bind:event="oninput" placeholder="Skriv et notat..."></textarea>
                <button type="button" class="save-button notater-legg-til" @onclick="LeggTilNotat" disabled="@string.IsNullOrWhiteSpace(_nyttNotat)">Legg til</button>

                @if (_notater.Count > 0)
                {
                    <ul class="notater-liste">
                        @foreach (var n in _notater)
                        {
                            <li>
                                <span class="notat-dato">@n.OpprettetDato.ToString("dd.MM.yyyy HH:mm")</span>
                                <p class="notat-tekst">@n.Tekst</p>
                                <button type="button" class="notat-slett" title="Slett notat" @onclick="@(() => SlettNotat(n))"><Icon Name="x" /></button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    <div class="bruker-meny-wrap" @onclick:stopPropagation="true">
        <button type="button" class="bruker-avatar" @onclick="ToggleBrukerMeny" title="@_naverendeBruker?.Navn">
            @(_naverendeBruker?.Initialer ?? "?")
        </button>
        @* Navn og rolle ved siden av initialene - vises bare i Layout 3 (se MainLayout.razor.css). *@
        <button type="button" class="topbar-brukernavn" @onclick="ToggleBrukerMeny">
            <span class="topbar-brukernavn-tekst">
                <strong>@(_naverendeBruker?.Navn ?? "Ukjent bruker")</strong>
                <small>@(_visningsRolle?.Visningsnavn() ?? "")</small>
            </span>
            <Icon Name="chevron-down" />
        </button>

        @* BM1 (brukermeny-forslag): profilkort øverst, så Konto, Utseende og
           meny (Tilpass meny + tema) og Logg ut nederst. Tilpass meny åpner et
           eget vindu i stedet for den lange lista som foldet seg ut før. *@
        @if (_visBrukerMeny)
        {
            <div class="bm-panel">
                <div class="bm-profil">
                    <span class="bm-avatar">@(_naverendeBruker?.Initialer ?? "?")</span>
                    <span class="bm-profil-tekst">
                        <b>@(_naverendeBruker?.Navn ?? "Ukjent bruker")</b>
                        @if (!string.IsNullOrWhiteSpace(_naverendeBruker?.Epost))
                        {
                            <small>@_naverendeBruker.Epost</small>
                        }
                        @if (_visningsRolle is not null)
                        {
                            <span class="bm-rolle">@_visningsRolle.Value.Visningsnavn()</span>
                        }
                    </span>
                </div>

                <div class="bm-seksjon">
                    <p class="bm-seksjon-tittel">Konto</p>
                    @if (_erMobilvisning || _fullversjonAktiv)
                    {
                        <button type="button" class="bm-rad" @onclick="Synkroniser">
                            <span class="bm-ikon"><Icon Name="refresh" /></span>
                            <span class="bm-rad-tekst">Synkroniser<small>Hent siste endringer fra kontoret</small></span>
                        </button>
                        <button type="button" class="bm-rad ga-til-fullversjon-knapp @(_fullversjonAktiv ? "aktiv" : "")" @onclick="GaTilFullversjon">
                            <span class="bm-ikon"><Icon Name="@(_fullversjonAktiv ? "toggle-right" : "toggle-left")" /></span>
                            <span class="bm-rad-tekst">@(_fullversjonAktiv ? "Tilbake til mobilvisning" : "Gå til fullversjon")</span>
                        </button>
                    }
                    <a class="bm-rad bytt-passord-lenke" href="/sett-passord">
                        <span class="bm-ikon"><Icon Name="lock" /></span>
                        <span class="bm-rad-tekst">Bytt passord</span>
                    </a>
                </div>

                @if (!_erMobilvisning)
                {
                    <div class="bm-seksjon">
                        <p class="bm-seksjon-tittel">Utseende og meny</p>
                        <button type="button" class="bm-rad tilpass-meny-knapp" @onclick="AapneTilpass">
                            <span class="bm-ikon"><Icon Name="grid" /></span>
                            <span class="bm-rad-tekst">Tilpass meny<small>Venstremeny, snarveier og Hjem</small></span>
                            <span class="bm-pil"><Icon Name="chevron-right" /></span>
                        </button>
                        <p class="bm-seksjon-tittel bm-tema-tittel">Tema</p>
                        <div class="bm-tema" role="group" aria-label="Tema">
                            <button type="button" class="@(_tema == "light" ? "aktiv" : "")" aria-pressed="@(_tema == "light" ? "true" : "false")" @onclick='@(() => SettTema("light"))'><Icon Name="sun" />Lys</button>
                            <button type="button" class="@(_tema == "dark" ? "aktiv" : "")" aria-pressed="@(_tema == "dark" ? "true" : "false")" @onclick='@(() => SettTema("dark"))'><Icon Name="circle" />Mørk</button>
                            <button type="button" class="@(_tema == "auto" ? "aktiv" : "")" aria-pressed="@(_tema == "auto" ? "true" : "false")" @onclick='@(() => SettTema("auto"))'><Icon Name="settings" />Auto</button>
                        </div>
                        <p class="bm-seksjon-tittel bm-tema-tittel">Skrifttype</p>
                        <div class="bm-tema" role="group" aria-label="Skrifttype">
                            <button type="button" class="bm-font-standard @(_font == "standard" ? "aktiv" : "")" aria-pressed="@(_font == "standard" ? "true" : "false")" @onclick='@(() => SettFont("standard"))'>Portal</button>
                            <button type="button" class="bm-font-vanlig @(_font == "vanlig" ? "aktiv" : "")" aria-pressed="@(_font == "vanlig" ? "true" : "false")" @onclick='@(() => SettFont("vanlig"))'>Vanlig</button>
                        </div>
                    </div>
                }

                @if (_ekteRolle == BrukerRolle.Admin && _harLager)
                {
                    <div class="bm-seksjon">
                        <p class="bm-seksjon-tittel">Lager</p>
                        <div class="bm-bryterrad bm-lager">
                            <span><b>Reserver varer automatisk</b><small>@(_reserverAuto ? "Varene på arbeidsordren settes av på lageret med en gang." : "Varene reserveres med «Reserver» på arbeidsordren.")</small></span>
                            <button type="button" class="bm-bryter" role="switch" aria-label="Reserver varer automatisk" aria-checked="@(_reserverAuto ? "true" : "false")" @onclick="VekslReserverAuto"></button>
                        </div>
                    </div>
                }

                @if (ErMarius)
                {
                    <div class="bm-seksjon" @onclick:stopPropagation="true">
                        <div class="tilstede-rad">
                            <button type="button" class="tilstede-dot @(AndreAktive.Count > 0 ? "tilstede-gronn" : "tilstede-rod")"
                                    title="@(AndreAktive.Count > 0 ? "Andre er pålogget - trykk for å se hvem" : "Ingen andre er pålogget nå")"
                                    @onclick="@(() => _visAktiveBrukere = !_visAktiveBrukere)"></button>
                            <span class="tilstede-tekst">@(AndreAktive.Count > 0 ? "Andre pålogget" : "Bare deg pålogget")</span>
                        </div>
                        @if (_visAktiveBrukere)
                        {
                            <div class="tilstede-panel">
                                @if (AndreAktive.Count == 0)
                                {
                                    <p class="tilstede-tom">Ingen andre er pålogget nå.</p>
                                }
                                else
                                {
                                    <ul class="tilstede-liste">
                                        @foreach (var b in AndreAktive)
                                        {
                                            <li @key="b.BrukerId">@b.Navn</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="bm-seksjon">
                    <form method="post" action="/account/logout" class="bruker-meny-logout-form">
                        <button type="submit" class="bm-rad bm-loggut">
                            <span class="bm-ikon"><Icon Name="log-out" /></span>
                            <span class="bm-rad-tekst">Logg ut</span>
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (_visInnstillinger)
        {
            var sok = _tilpassSok.Trim();
            <div class="bm-bakteppe" @onclick="LukkTilpass">
                <div class="bm-modal" role="dialog" aria-modal="true" aria-label="Tilpass" @onclick:stopPropagation="true">
                    <div class="bm-modal-topp">
                        <span>
                            <h3>Tilpass</h3>
                            <p>Velg hva du ser i venstremenyen, som snarvei øverst og på Hjem. Endringene lagres med en gang.</p>
                        </span>
                        <button type="button" class="vb-lukk" title="Lukk" @onclick="LukkTilpass"><Icon Name="x" /></button>
                    </div>

                    <div class="bm-faner" role="tablist">
                        <button type="button" role="tab" class="@(_tilpassFane == "meny" ? "aktiv" : "")" @onclick='@(() => _tilpassFane = "meny")'>Venstremeny</button>
                        <button type="button" role="tab" class="@(_tilpassFane == "topp" ? "aktiv" : "")" @onclick='@(() => _tilpassFane = "topp")'>Snarveier øverst</button>
                        <button type="button" role="tab" class="@(_tilpassFane == "hjem" ? "aktiv" : "")" @onclick='@(() => _tilpassFane = "hjem")'>Hjem-side</button>
                    </div>

                    @if (_tilpassFane == "hjem")
                    {
                        <div class="bm-hjem">
                            <b>Dashboard-stil</b>
                            <div class="bm-layoutvalg">
                                @foreach (var (layout, nr, navn) in HjemLayoutValg)
                                {
                                    <button type="button" class="bm-layout @(_hjemLayoutValg == layout ? "aktiv" : "")" @onclick="@(() => SettHjemLayout(layout))">
                                        <span class="bm-layout-mini bm-layout-@nr"><i></i><i></i><i></i><i></i><i></i><i></i></span>
                                        Layout @nr<small>@navn</small>
                                    </button>
                                }
                            </div>
                            <div class="bm-bryterrad">
                                <span><b>Mine hurtigvalg</b><small>Snarveiene øverst på Hjem</small></span>
                                <button type="button" class="bm-knapp" @onclick="TilpassHurtigvalg">Tilpass</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        var erMeny = _tilpassFane == "meny";
                        <div class="bm-modal-kropp">
                            <div class="bm-liste">
                                <input class="bm-sok" @bind="_tilpassSok" @bind:event="oninput" placeholder="Søk etter modul …" />

                                @if (string.IsNullOrEmpty(sok) || "Varsler AI".Contains(sok, StringComparison.OrdinalIgnoreCase))
                                {
                                    <p class="bm-gruppe">System</p>
                                    @if (string.IsNullOrEmpty(sok) || "Varsler".Contains(sok, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="bm-bryterrad">
                                            <span>Varsler</span>
                                            <button type="button" class="bm-bryter" role="switch" aria-checked="@((erMeny ? !_skjulteLenker.Contains("varsler") : _snarveier.Contains("varsler")) ? "true" : "false")"
                                                    @onclick='@(() => erMeny ? ToggleLenke("varsler", _skjulteLenker.Contains("varsler")) : ToggleSnarvei("varsler", !_snarveier.Contains("varsler")))'></button>
                                        </div>
                                    }
                                    @if (_visUtvidetVarsel && (string.IsNullOrEmpty(sok) || "AI".Contains(sok, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div class="bm-bryterrad">
                                            <span>AI-assistent</span>
                                            <button type="button" class="bm-bryter" role="switch" aria-checked="@((erMeny ? !_skjulteLenker.Contains("ai-assistent") : _snarveier.Contains("ai-assistent")) ? "true" : "false")"
                                                    @onclick='@(() => erMeny ? ToggleLenke("ai-assistent", _skjulteLenker.Contains("ai-assistent")) : ToggleSnarvei("ai-assistent", !_snarveier.Contains("ai-assistent")))'></button>
                                        </div>
                                    }
                                }

                                @* Moduler uten undermoduler samles i én gruppe. *@
                                @{
                                    var enkle = ModulGrupper.Where(g => g.Undermoduler.Count == 0)
                                        .Select(g => g.Modul)
                                        .Where(m => string.IsNullOrEmpty(sok) || m.Tittel.Contains(sok, StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                }
                                @if (enkle.Count > 0)
                                {
                                    <p class="bm-gruppe">Moduler</p>
                                    @foreach (var modul in enkle)
                                    {
                                        <div class="bm-bryterrad">
                                            <span>@modul.Tittel</span>
                                            <button type="button" class="bm-bryter" role="switch" aria-label="@modul.Tittel" aria-checked="@((erMeny ? !_skjulteLenker.Contains(modul.Href) : _snarveier.Contains(modul.Href)) ? "true" : "false")"
                                                    @onclick="@(() => erMeny ? ToggleLenke(modul.Href, _skjulteLenker.Contains(modul.Href)) : ToggleSnarvei(modul.Href, !_snarveier.Contains(modul.Href)))"></button>
                                        </div>
                                    }
                                }

                                @foreach (var (modul, undermoduler) in ModulGrupper.Where(g => g.Undermoduler.Count > 0))
                                {
                                    var treff = string.IsNullOrEmpty(sok) || modul.Tittel.Contains(sok, StringComparison.OrdinalIgnoreCase);
                                    var underTreff = undermoduler.Where(u => treff || u.Tittel.Contains(sok, StringComparison.OrdinalIgnoreCase)).ToList();
                                    if (!treff && underTreff.Count == 0)
                                    {
                                        continue;
                                    }
                                    <p class="bm-gruppe">
                                        @modul.Tittel
                                        <button type="button" class="bm-alle" @onclick="@(() => VekslHeleGruppen(modul, undermoduler, erMeny))">@(ErHeleGruppenPa(modul, undermoduler, erMeny) ? "Ingen" : "Alle")</button>
                                    </p>
                                    <div class="bm-bryterrad">
                                        <span>Hele modulen</span>
                                        <button type="button" class="bm-bryter" role="switch" aria-checked="@((erMeny ? !_skjulteLenker.Contains(modul.Href) : _snarveier.Contains(modul.Href)) ? "true" : "false")"
                                                @onclick="@(() => erMeny ? ToggleLenke(modul.Href, _skjulteLenker.Contains(modul.Href)) : ToggleSnarvei(modul.Href, !_snarveier.Contains(modul.Href)))"></button>
                                    </div>
                                    @foreach (var under in underTreff)
                                    {
                                        <div class="bm-bryterrad bm-under">
                                            <span>@under.Tittel</span>
                                            <button type="button" class="bm-bryter" role="switch" aria-checked="@((erMeny ? _ekstraLenker.Contains(under.Href) : _snarveier.Contains(under.Href)) ? "true" : "false")"
                                                    @onclick="@(() => erMeny ? ToggleEkstraLenke(under.Href, !_ekstraLenker.Contains(under.Href)) : ToggleSnarvei(under.Href, !_snarveier.Contains(under.Href)))"></button>
                                        </div>
                                    }
                                }
                            </div>

                            <aside class="bm-forhand">
                                <p class="bm-gruppe">Forhåndsvisning</p>
                                @if (erMeny)
                                {
                                    @foreach (var (modul, undermoduler) in ModulGrupper)
                                    {
                                        <span class="bm-forhand-rad @(_skjulteLenker.Contains(modul.Href) ? "av" : "")"><Icon Name="@modul.IconNavn" />@modul.Tittel</span>
                                        @foreach (var under in undermoduler.Where(u => _ekstraLenker.Contains(u.Href)))
                                        {
                                            <span class="bm-forhand-rad bm-under"><Icon Name="@under.IconNavn" />@under.Tittel</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <small>Ved navnet ditt øverst:</small>
                                    @if (Snarveier.Count == 0 && !_snarveier.Contains("varsler"))
                                    {
                                        <small>Ingen snarveier valgt.</small>
                                    }
                                    <div class="bm-forhand-chips">
                                        @if (_snarveier.Contains("varsler"))
                                        {
                                            <span class="bm-forhand-rad"><Icon Name="bell" />Varsler</span>
                                        }
                                        @foreach (var s in Snarveier)
                                        {
                                            <span class="bm-forhand-rad"><Icon Name="@s.IconNavn" />@s.Tittel</span>
                                        }
                                    </div>
                                }
                            </aside>
                        </div>
                    }

                    <div class="bm-modal-fot">
                        <small>Lagres automatisk</small>
                        <button type="button" class="bm-knapp bm-knapp-p" @onclick="LukkTilpass">Ferdig</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private BrukerRolle? _naverendeRolle;

    // Rollen brukeren faktisk har i databasen, og rollen portalen vises som nå.
    // De er like helt til man bruker "Vis som".
    private BrukerRolle? _ekteRolle;
    private BrukerRolle? _visningsRolle;

    // Alle fem rollene, slik at admin kan se kunde- og driftsportalen også.
    private static readonly BrukerRolle[] VisSomRoller =
        [BrukerRolle.Admin, BrukerRolle.Prosjektleder, BrukerRolle.Montor, BrukerRolle.Kunde, BrukerRolle.Driftslisens];

    // Rollene det faktisk finnes en aktiv bruker å logge inn som. Uten dette
    // sto det knapper der som tilsynelatende ikke gjorde noe: endepunktet
