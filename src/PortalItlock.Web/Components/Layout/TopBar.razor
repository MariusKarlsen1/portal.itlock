    private async Task LeggTilNotat()
    {
        var tekst = _nyttNotat.Trim();
        if (tekst.Length == 0 || !_naverendeBrukerId.HasValue)
        {
            return;
        }

        var notat = new Notat { BrukerId = _naverendeBrukerId.Value, Tekst = tekst };
        Db.Notater.Add(notat);
        await Db.SaveChangesAsync();

        _notater.Insert(0, notat);
        _nyttNotat = "";
    }

    private async Task SlettNotat(Notat notat)
    {
        Db.Notater.Remove(notat);
        await Db.SaveChangesAsync();
        _notater.Remove(notat);
    }

