    // skal vises - pålitelig uansett hvilken CSS-versjon nettleseren har
    // liggende i cache. Se samme mønster i ArbeidsordreSkjema/ProsjektSkjema.
    private bool _erMobilvisning;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // _erMobilvisning styrer kun toppfeltets EGNE elementer (søk,
            // varsler, AI/Kontrolltårn-snarveier, Tilpass meny) - disse skal
            // holde seg enkle/mobile uansett fullversjon, siden brukeren
            // eksplisitt ba om å beholde den vanlige mobile topplinjen (☰ +
            // tittel + avatar) i stedet for skrivebordets fulle topprad.
            _erMobilvisning = await JS.InvokeAsync<bool>("erMobilvisning");

            // Selve gjenopprettingen av "fullversjon" fra forrige besøk gjøres
            // sentralt i MobilFilterKnapp (unngår at to øy-komponenter kappes
            // om å sette Verktoylinje sin tilstand hver for seg). Leses her
            // rett fra Verktoylinje - dersom MobilFilterKnapp ikke har rukket
            // å sette den ennå, fanges det opp like etterpå via
            // Endret-abonnementet (se OnVerktoylinjeEndret).
            _fullversjonAktiv = Verktoylinje.FullversjonAktiv;
            await HentSettAsync();
            await HentTemaAsync();
            StateHasChanged();
        }
    }

