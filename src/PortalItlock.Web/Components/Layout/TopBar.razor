        ? !_skjulteLenker.Contains(modul.Href) && undermoduler.All(u => _ekstraLenker.Contains(u.Href))
        : _snarveier.Contains(modul.Href) && undermoduler.All(u => _snarveier.Contains(u.Href));

    // «Alle» / «Ingen» per gruppe i Tilpass-vinduet.
    private async Task VekslHeleGruppen(Lenke modul, List<Lenke> undermoduler, bool erMeny)
    {
        var pa = !ErHeleGruppenPa(modul, undermoduler, erMeny);
        if (erMeny)
        {
            await ToggleLenke(modul.Href, pa);
            foreach (var u in undermoduler)
            {
                await ToggleEkstraLenke(u.Href, pa);
            }
        }
        else
        {
            await ToggleSnarvei(modul.Href, pa);
            foreach (var u in undermoduler)
            {
                await ToggleSnarvei(u.Href, pa);
            }
        }
    }
