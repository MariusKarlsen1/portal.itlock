    private const string FullversjonLagringsNokkel = "itlock-fullversjon";
    private bool _fullversjonAktiv;

    // Viser skrivebordsinnholdet (alle felt/sider/handlinger som på PC) mens
    // man fortsatt er på ekte mobilbredde - IKKE et nedskalert vindu (det ga
    // for lite tekst, og viste skrivebordets venstre sidemeny, som brukeren
    // eksplisitt ikke ønsket). Selve sidemenyen trenger ingen egen skjuling
    // her - den er allerede usynlig på smale skjermer via sin egen CSS
    // (NavMenu.razor.css), helt uavhengig av dette. Setter
    // Verktoylinje.ErMobilvisning=false, som alle sider/komponenter som
    // abonnerer på den (ProsjektSkjema, Prosjekter, DorRedigering, MinDag
    // m.fl.) reagerer på med det samme og bytter til sitt fulle
    // skrivebordsinnhold. Toppfeltet (☰ + tittel + avatar) og bunn-fanen
    // forblir uendret siden de styres av den ekte, fysiske vindusbredden.
    //
    // Naviger i tillegg til "/" (modul-oversikten - samme side og samme
    // rolle-inndelte modul-registrer som PC-forsiden bruker), siden brukeren
    // eksplisitt ba om å lande på en helt ny side der man trykker seg
    // innover i modulene, ikke bare får skrivebordsinnhold på siden man
    // allerede sto på. ?fullversjon=1 er et unntak fra server-omdirigeringen
    // som ellers alltid sender mobil-User-Agents videre til /min-dag.
    //
    // forceLoad: true - en ekte, fullstendig sidelasting, IKKE Blazor sin
    // egen SPA-aktige navigasjon. Uten dette måtte man av og til trykke
    // knappen to ganger før den faktisk slo om: en SPA-navigasjon race'r
    // mot at Verktoylinje-tilstanden akkurat satt over rekker å nå fram til
    // alle abonnentene på det nye siden. En ekte sidelasting garanterer i
    // stedet en helt fersk, korrekt tilstand hver gang (samme robuste
    // gjenopprettings-mekanisme som allerede brukes ved kaldstart, se
    // MobilFilterKnapp.razor).
    // Henter siden på nytt, så alt som er endret på kontoret kommer med.
    private void Synkroniser() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    private async Task GaTilFullversjon()
    {
        // Lokal kopi: SettMobilvisning varsler abonnentene med en gang, og
        // OnVerktoylinjeEndret leser da tilbake den gamle fullversjon-verdien
        // til _fullversjonAktiv - så «Tilbake til mobilvisning» sendte en
        // rett tilbake til fullversjon.
        var full = !_fullversjonAktiv;
        _fullversjonAktiv = full;
        await JS.InvokeVoidAsync("localStorage.setItem", FullversjonLagringsNokkel, full ? "1" : "0");

        Verktoylinje.SettFullversjon(full);
        Verktoylinje.SettMobilvisning(!full);

        Nav.NavigateTo(full ? "/?fullversjon=1" : "/app", forceLoad: true);
    }

    private async Task ToggleLenke(string key, bool vis)
    {
        if (vis)
        {
            _skjulteLenker.Remove(key);
        }
        else
        {
            _skjulteLenker.Add(key);
        }

        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.SkjulteNavLenker = _skjulteLenker.Count == 0 ? null : string.Join(",", _skjulteLenker);
                await Db.SaveChangesAsync();
            }
        }
    }

    private async Task ToggleSnarvei(string key, bool vis)
    {
        if (vis)
        {
            _snarveier.Add(key);
        }
        else
        {
            _snarveier.Remove(key);
        }

        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.TopplinjeSnarveier = _snarveier.Count == 0 ? null : string.Join(",", _snarveier);
                await Db.SaveChangesAsync();
            }
        }
    }

    // "Dashboard-stil" i Tilpass meny - lar brukeren selv sykle mellom Hjem-
    // layoutene (se Home.razor sin AktivLayout): 1 Klassisk, 2 Dashboard3.
    // "Bilde"-layouten er tatt ut av bryteren (ikke lenger valgbar), men selve
    // rendringen i Home.razor er bevisst beholdt urørt - noen brukere kan
    // fortsatt ha den liggende lagret som sitt HjemLayoutValg fra før, og skal
    // ikke miste layouten sin uten selv å ha byttet bort fra den. Laster hele
    // siden på nytt etterpå (ikke bare StateHasChanged) fordi Home.razor er en
    // helt egen komponentinstans som allerede har lest sin egen kopi av
    // Bruker ved oppstart - den oppdager ikke endringen uten en ny
    // sideinnlasting.
    private async Task SyklHjemLayout()
    {
        // 1 Klassisk → 2 Dashboard3 → 3 Fjord (ny forside med bilde) → 1 ...
        _hjemLayoutValg = _hjemLayoutValg switch
        {
            HjemLayout.Klassisk => HjemLayout.Dashboard3,
            HjemLayout.Fjord => HjemLayout.Klassisk,
            _ => HjemLayout.Fjord
        };

        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.HjemLayoutValg = _hjemLayoutValg;
                await Db.SaveChangesAsync();
            }
        }

        Nav.NavigateTo("/", forceLoad: true);
    }

    // Selve stjernemerkingen skjer på forsiden, der flisene ligger. Herfra
    // navigerer vi dit med tilpassingen allerede slått på, slik at man ikke må
    // finne fram til knappen der også.
    private void TilpassHurtigvalg()
    {
        _visInnstillinger = false;
        _visBrukerMeny = false;
        Nav.NavigateTo("/?tilpassHurtigvalg=1", forceLoad: true);
    }

    private static int LayoutNummer(HjemLayout layout) => layout switch
    {
        HjemLayout.Klassisk => 1,
        HjemLayout.Fjord => 3,
        _ => 2
    };

    // Fastnåler en undermodul (f.eks. "Arbeidsordre") i venstremenyen - se
    // NavMenu.razor sin bruk av samme Bruker.EkstraNavLenker. Motsatt av
    // ToggleLenke/SkjulteNavLenker: undermoduler er skjult med mindre de er
    // lagt til her (opt-in), ellers ville sidemenyen blitt full av alle
    // undermoduler for alle roller med det samme.
    private async Task ToggleEkstraLenke(string key, bool vis)
    {
        if (vis)
        {
            _ekstraLenker.Add(key);
        }
        else
        {
            _ekstraLenker.Remove(key);
        }

        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.EkstraNavLenker = _ekstraLenker.Count == 0 ? null : string.Join(",", _ekstraLenker);
                await Db.SaveChangesAsync();
            }
        }
    }

    private Task UtforSok()
    {
        var tekst = _sokTekst.Trim();
        if (tekst.Length == 0)
        {
            return Task.CompletedTask;
        }

        _sokTekst = "";
        Nav.NavigateTo($"/sok?q={Uri.EscapeDataString(tekst)}");
        return Task.CompletedTask;
    }

    // Lager: automatisk eller manuell reservasjon av varene på arbeidsordrene.
    private bool _harLager;
    private bool _reserverAuto = true;

    private async Task VekslReserverAuto()
    {
        if (_ekteRolle != BrukerRolle.Admin)
        {
            return;
        }

        var inn = await Db.LagerInnstillinger.FirstOrDefaultAsync();
        if (inn is null)
        {
            inn = new PortalItlock.Web.Models.LagerInnstillinger();
            Db.LagerInnstillinger.Add(inn);
        }

        inn.ReserverAutomatisk = !_reserverAuto;
        await Db.SaveChangesAsync();
        _reserverAuto = inn.ReserverAutomatisk;
    }
}
