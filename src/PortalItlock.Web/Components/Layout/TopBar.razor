        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.SkjulteNavLenker = null;
                bruker.EkstraNavLenker = null;
                await Db.SaveChangesAsync();
            }
        }
    }

    private async Task LagreMenyvalg()
    {
        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.SkjulteNavLenker = string.Join(",", _skjulteLenker);
