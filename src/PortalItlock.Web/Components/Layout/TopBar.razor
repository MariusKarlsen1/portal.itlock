    private static string Initialer(string navn)
    {
        var deler = navn.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return deler.Length switch
        {
            0 => "?",
            1 => deler[0][..1].ToUpperInvariant(),
            _ => (deler[0][..1] + deler[^1][..1]).ToUpperInvariant()
        };
    }

    // Telleren nederst i Tilpass-vinduet: alt som kan vises i venstremenyen.
    private int AntallMulige =>
        1 + (_visUtvidetVarsel ? 1 : 0) + ModulGrupper.Sum(g => 1 + g.Undermoduler.Count);

    private int AntallIMeny =>
        (_skjulteLenker.Contains("varsler") ? 0 : 1)
        + (_visUtvidetVarsel && !_skjulteLenker.Contains("ai-assistent") ? 1 : 0)
        + ModulGrupper.Sum(g => (_skjulteLenker.Contains(g.Modul.Href) ? 0 : 1) + g.Undermoduler.Count(u => _ekstraLenker.Contains(u.Href)));

    // «Vis alle / Skjul alle» for modulene uten undermoduler.
    private async Task VekslEnkle(List<Lenke> enkle)
    {
        var vis = !enkle.All(m => !_skjulteLenker.Contains(m.Href));
        foreach (var m in enkle)
        {
            if (vis) _skjulteLenker.Remove(m.Href); else _skjulteLenker.Add(m.Href);
        }
        await LagreMenyvalg();
    }

