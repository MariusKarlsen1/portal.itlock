    {
        _sett = Varselpunkter.ToDictionary(Nokkel, p => p.Antall);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SettLagringsNokkel, System.Text.Json.JsonSerializer.Serialize(_sett));
        }
        catch (JSException)
        {
            // Ikke kritisk - tallet kommer bare tilbake ved neste innlasting.
        }
    }

    private async Task HentSettAsync()
    {
        try
        {
            var lagret = await JS.InvokeAsync<string?>("localStorage.getItem", SettLagringsNokkel);
            if (!string.IsNullOrWhiteSpace(lagret))
            {
                _sett = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(lagret) ?? [];
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException or InvalidOperationException)
        {
            _sett = [];
        }
    }

