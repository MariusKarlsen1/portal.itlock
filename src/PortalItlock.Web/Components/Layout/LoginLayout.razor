@inherits LayoutComponentBase

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="login-page">
    <button type="button" class="login-theme-toggle" title="Bytt fargemodus" onclick="theme.toggle(); this.textContent = theme.isDark() ? '☀️' : '🌙';">🌙</button>

    <div class="login-wordmark">
        <img src="fk-logo-mark.png?v=2" alt="" class="login-wordmark-icon" />
        <span>Full Kontroll</span>
    </div>

    <div class="login-form-panel">
        @Body
    </div>

    <span class="login-footnote">© 2026 Full Kontroll</span>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var btn = document.querySelector('.login-theme-toggle');
        if (btn && window.theme) {
            btn.textContent = theme.isDark() ? '☀️' : '🌙';
        }
    });
</script>
