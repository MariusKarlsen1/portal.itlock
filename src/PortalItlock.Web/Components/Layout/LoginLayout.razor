@inherits LayoutComponentBase

<div class="login-page">
    <button type="button" class="login-theme-toggle" title="Bytt fargemodus" onclick="theme.toggle(); this.textContent = theme.isDark() ? '☀️' : '🌙';">🌙</button>

    <div class="login-brand-panel">
        <svg class="login-brand-keyhole" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="38" r="22" fill="currentColor" />
            <path d="M38 50 L62 50 L70 88 L30 88 Z" fill="currentColor" />
        </svg>

        <div class="login-particles" aria-hidden="true">
            <span style="left:6%; width:5px; height:5px; animation-duration:19s; animation-delay:0s;"></span>
            <span style="left:16%; width:7px; height:7px; animation-duration:24s; animation-delay:3s;"></span>
            <span style="left:27%; width:4px; height:4px; animation-duration:16s; animation-delay:7s;"></span>
            <span style="left:38%; width:6px; height:6px; animation-duration:22s; animation-delay:1s;"></span>
            <span style="left:49%; width:5px; height:5px; animation-duration:18s; animation-delay:10s;"></span>
            <span style="left:60%; width:8px; height:8px; animation-duration:26s; animation-delay:5s;"></span>
            <span style="left:70%; width:4px; height:4px; animation-duration:15s; animation-delay:13s;"></span>
            <span style="left:80%; width:6px; height:6px; animation-duration:21s; animation-delay:8s;"></span>
            <span style="left:90%; width:5px; height:5px; animation-duration:17s; animation-delay:2s;"></span>
            <span style="left:12%; width:6px; height:6px; animation-duration:23s; animation-delay:15s;"></span>
        </div>

        <div class="login-brand-content">
            <img src="itlock-logo.svg" alt="Itlock" class="login-brand-logo" />
            <h2 class="login-brand-tittel">Full Kontroll</h2>
            <p class="login-brand-tekst">Prosjektering, befaring og montasje av dørpakker – samlet på ett sted.</p>
        </div>
    </div>

    <div class="login-form-panel">
        @Body
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var btn = document.querySelector('.login-theme-toggle');
        if (btn && window.theme) {
            btn.textContent = theme.isDark() ? '☀️' : '🌙';
        }

        var panel = document.querySelector('.login-brand-panel');
        var keyhole = document.querySelector('.login-brand-keyhole');
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (panel && keyhole && !reduceMotion) {
            panel.addEventListener('mousemove', function (e) {
                var rect = panel.getBoundingClientRect();
                var x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
                var y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
                keyhole.style.transform = 'translate(-38%, -55%) rotate(-8deg) translate(' + (x * 14) + 'px, ' + (y * 14) + 'px)';
            });
            panel.addEventListener('mouseleave', function () {
                keyhole.style.transform = 'translate(-38%, -55%) rotate(-8deg)';
            });
        }
    });
</script>
