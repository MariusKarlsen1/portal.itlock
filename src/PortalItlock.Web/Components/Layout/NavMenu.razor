@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.VarselTellerService VarselTellerSvc

<div class="top-row ps-3 navbar">
    <div class="container-fluid top-row-inner">
        <button type="button" class="sidebar-toggle" title="Vis/skjul full meny" onclick="sidebarMeny.toggle()">
            ☰
        </button>
        <a class="navbar-brand" href="">
            <img src="itlock-full-kontroll-logo-transparent.png" alt="Itlock Full Kontroll" class="brand-logo logo-adaptive" />
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="sidebar-org">
            <span class="sidebar-org-label">Organisasjon</span>
            <span class="sidebar-org-navn">itlock AS</span>
        </div>

        @if (!_skjulteLenker.Contains("varsler"))
        {
        <div class="nav-item px-3 varsel-wrap" @onclick:stopPropagation="true">
            <button type="button" class="nav-link varsel-knapp" @onclick="ToggleVarsler">
                <Icon Name="bell" />
                <span>Varsler</span>
                @if (TotaltAntallVarsler > 0)
                {
                    <span class="varsel-badge">@TotaltAntallVarsler</span>
                }
            </button>

            @if (_visVarsler)
            {
                <div class="varsel-panel">
                    @if (TotaltAntallVarsler == 0)
                    {
                        <p class="varsel-tom">Ingen varsler akkurat nå.</p>
                    }
                    else
                    {
                        @if (_avvikSomVenter > 0)
                        {
                            <span class="varsel-rad">
                                <span class="varsel-tall">@_avvikSomVenter</span>
                                <span>Avvik som venter på godkjenning</span>
                            </span>
                        }
                        @if (_serviceavtalerVarsel > 0)
                        {
                            <a class="varsel-rad" href="/service" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_serviceavtalerVarsel</span>
                                <span>Serviceavtaler som nærmer seg forfall</span>
                            </a>
                        }
                        @if (_kunderTrengerOppfolging > 0)
                        {
                            <a class="varsel-rad" href="/kundeoppfolging" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_kunderTrengerOppfolging</span>
                                <span>Kunder som trenger oppfølging</span>
                            </a>
                        }
                        @if (_varerLavBeholdning > 0)
                        {
                            <a class="varsel-rad" href="/lager" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_varerLavBeholdning</span>
                                <span>Varer med lav lagerbeholdning</span>
                            </a>
                        }
                        @if (_fravarSoknaderVenter > 0)
                        {
                            <a class="varsel-rad" href="/fravar" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_fravarSoknaderVenter</span>
                                <span>Fraværssøknader som venter på godkjenning</span>
                            </a>
                        }
                        @if (_tilvalgVarsel > 0)
                        {
                            <a class="varsel-rad" href="/tilvalg" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_tilvalgVarsel</span>
                                <span>Nye tilvalg fra kunder</span>
                            </a>
                        }
                        @if (_driftsmeldingerVarsel > 0)
                        {
                            <a class="varsel-rad" href="/driftsmeldinger" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_driftsmeldingerVarsel</span>
                                <span>Nye driftsmeldinger</span>
                            </a>
                        }
                        @if (_ticketerVarsel > 0)
                        {
                            <a class="varsel-rad" href="/tickets" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_ticketerVarsel</span>
                                <span>Tickets uten ansvarlig</span>
                            </a>
                        }
                        @if (_ceGodkjenningerVarsel > 0)
                        {
                            <a class="varsel-rad" href="/ce-godkjenninger" @onclick="LukkVarsler">
                                <span class="varsel-tall">@_ceGodkjenningerVarsel</span>
                                <span>CE-sertifiseringer som nærmer seg eller har gått ut på dato</span>
                            </a>
                        }
                    }
                </div>
            }
        </div>
        }

        <div class="nav-item px-3">
            <button type="button" class="nav-link nav-link-button" @onclick="GaTilbake">
                <span class="nav-back-arrow" aria-hidden="true">←</span> Tilbake
            </button>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Hjem
            </NavLink>
        </div>

        @if (_visUtvidetVarsel && !_skjulteLenker.Contains("kontrolltarn"))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kontrolltarn">
                    <Icon Name="shield" /> Kontrolltårn
                </NavLink>
            </div>
        }

        @foreach (var lenke in TilgjengeligeLenker)
        {
            @if (!_skjulteLenker.Contains(lenke.Href))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@lenke.Href">
                        <Icon Name="@lenke.IconNavn" /> @lenke.Tittel
                    </NavLink>
                </div>
            }
        }

        @if (_visUtvidetVarsel)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="driftsmeldinger">
                    <Icon Name="mail" /> Driftsmeldinger
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <ThemeToggle />
        </div>

        @if (VisBiler)
        {
            <div class="nav-item px-3">
                <BilerToggle />
            </div>
        }
    </nav>
</div>

@code {
    // Sett til true igjen for å vise av/på-knappen for de kjørende servicebilene på forsiden.
    private const bool VisBiler = false;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private BrukerRolle? _naverendeRolle;

    private List<Lenke> TilgjengeligeLenker
    {
        get
        {
            var nokler = _naverendeRolle switch
            {
                BrukerRolle.Admin => new[] { "montorer", "prosjektledere", "admin" },
                BrukerRolle.Prosjektleder => new[] { "montorer", "prosjektledere" },
                BrukerRolle.Montor => new[] { "montorer" },
                _ => []
            };

            return PortalModulRegister.Roller
                .Where(r => nokler.Contains(r.Nokkel))
                .SelectMany(r => r.Grupper)
                .SelectMany(g => g.Lenker)
                .ToList();
        }
    }

    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;
    private HashSet<string> _skjulteLenker = [];
    private bool _visUtvidetVarsel;
    private bool _erAdmin;
    private bool _visVarsler;
    private int _avvikSomVenter;
    private int _serviceavtalerVarsel;
    private int _kunderTrengerOppfolging;
    private int _varerLavBeholdning;
    private int _fravarSoknaderVenter;
    private int _tilvalgVarsel;
    private int _driftsmeldingerVarsel;
    private int _ticketerVarsel;
    private int _ceGodkjenningerVarsel;

    private readonly List<string> _historikk = [];
    private bool _gikkTilbake;
    private string _naverendeUrl = "";

    private int TotaltAntallVarsler => _avvikSomVenter + _serviceavtalerVarsel + _kunderTrengerOppfolging + _varerLavBeholdning + _fravarSoknaderVenter + _tilvalgVarsel + _driftsmeldingerVarsel + _ceGodkjenningerVarsel + _ticketerVarsel;

    protected override async Task OnInitializedAsync()
    {
        _naverendeUrl = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var rolleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            _visUtvidetVarsel = rolleClaim is "Admin" or "Prosjektleder";
            _erAdmin = rolleClaim is "Admin";
            _naverendeRolle = rolleClaim is not null && Enum.TryParse<BrukerRolle>(rolleClaim, out var rolle) ? rolle : null;

            var brukerClaim = state.User.FindFirst("BrukerId")?.Value;
            if (brukerClaim is not null && int.TryParse(brukerClaim, out var bid))
            {
                _naverendeBrukerId = bid;
                _naverendeBruker = await Db.Brukere.FindAsync(bid);
                var skjult = _naverendeBruker?.SkjulteNavLenker;
                _skjulteLenker = string.IsNullOrWhiteSpace(skjult)
                    ? []
                    : skjult.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();
            }
        }

        await LastVarslerAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_gikkTilbake)
        {
            _gikkTilbake = false;
        }
        else
        {
            _historikk.Add(_naverendeUrl);
        }

        _naverendeUrl = e.Location;
        _visVarsler = false;
        await LastVarslerAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LastVarslerAsync()
    {
        var teller = await VarselTellerSvc.HentAsync(_visUtvidetVarsel, _erAdmin);
        _avvikSomVenter = teller.AvvikSomVenter;
        _serviceavtalerVarsel = teller.ServiceavtalerVarsel;
        _kunderTrengerOppfolging = teller.KunderTrengerOppfolging;
        _varerLavBeholdning = teller.VarerLavBeholdning;
        _fravarSoknaderVenter = teller.FravarSoknaderVenter;
        _tilvalgVarsel = teller.TilvalgVarsel;
        _driftsmeldingerVarsel = teller.DriftsmeldingerVarsel;
        _ticketerVarsel = teller.TicketerVarsel;
        _ceGodkjenningerVarsel = teller.CeGodkjenningerVarsel;
    }

    private void ToggleVarsler()
    {
        _visVarsler = !_visVarsler;
    }

    private async Task ToggleLenke(string key, bool vis)
    {
        if (vis)
        {
            _skjulteLenker.Remove(key);
        }
        else
        {
            _skjulteLenker.Add(key);
        }

        if (_naverendeBrukerId.HasValue)
        {
            var bruker = await Db.Brukere.FindAsync(_naverendeBrukerId.Value);
            if (bruker is not null)
            {
                bruker.SkjulteNavLenker = _skjulteLenker.Count == 0 ? null : string.Join(",", _skjulteLenker);
                await Db.SaveChangesAsync();
            }
        }
    }

    private void LukkVarsler()
    {
        _visVarsler = false;
    }

    private void GaTilbake()
    {
        if (_historikk.Count == 0)
        {
            Nav.NavigateTo("/");
            return;
        }

        var forrige = _historikk[^1];
        _historikk.RemoveAt(_historikk.Count - 1);
        _gikkTilbake = true;
        Nav.NavigateTo(forrige);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
