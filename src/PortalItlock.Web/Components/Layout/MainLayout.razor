@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Http
@inject NavigationManager Nav

@if (ErEmbedVisning)
{
    <article class="content content-embed">
        @Body
    </article>
}
else
{
    <div class="page @(ErKompaktModul ? "kompakt-modul" : "")">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <MobilTilbakeKnapp />
                <button type="button" class="sidebar-toggle-top" title="Vis/skjul full meny" onclick="sidebarMeny.toggleMeny()">
                    ☰
                </button>
                <span id="mobil-topptittel" class="mobil-topptittel"></span>
                <TopBar />
                <MobilFilterKnapp />
            </div>

            <article id="side-innhold" class="content px-4 @(ErFullversjon ? "content-fullversjon" : "")">
                @if (ErKompaktModul)
                {
                    <div class="content-kompakt-indre">
                        @Body
                    </div>
                }
                else
                {
                    @Body
                }
            </article>
        </main>
    </div>
    <MobilTabBar />
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Brukes til å vise en side "bar" - uten sidemeny/toppfelt - f.eks. når den lastes i en
    // iframe inni et popup-vindu et annet sted i appen (se Plantegning).
    private bool ErEmbedVisning =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query)
            .TryGetValue("embed", out var verdi) && verdi == "true";

    // MainLayout er statisk (ikke @rendermode) og rendres kun én gang pr. sideinnlasting -
    // leser derfor query-strengen direkte her (samme oppskrift som MobilFilterKnapp), i
    // stedet for å stole på at MobilVerktoylinjeService allerede har rukket å bli satt av en
    // interaktiv søsterkomponent. "Gå til fullversjon" bruker alltid forceLoad, så denne
    // klassen blir riktig på hver eneste veksling og består uendret gjennom vanlig
    // SPA-navigasjon innad i samme fullversjon-økt.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool ErFullversjon =>
        HttpContext is not null && HttpContext.Request.Query.ContainsKey("fullversjon");

    // Modul-verktøy som Lasutskifting skal vises uten sidemeny/toppfelt på
    // skrivebord - kun selve innholdet sentrert, med en tilbake-pil i siden
    // selv i stedet. Skjules kun via CSS på skrivebordsbredder (se
    // MainLayout.razor.css) slik at mobilvisningen (hamburger-meny +
    // bunn-fane) forblir helt uendret.
    private bool ErKompaktModul
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return path.Equals("/lasutskifting", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("/lasutskifting/", StringComparison.OrdinalIgnoreCase);
        }
    }
}
