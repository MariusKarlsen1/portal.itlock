@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Http
@using PortalItlock.Web.Models
@inject NavigationManager Nav

@if (ErEmbedVisning)
{
    <article class="content content-embed">
        @Body
    </article>
}
else
{
    <div class="page @(ErKompaktModul ? "kompakt-modul" : "")">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <MobilTilbakeKnapp />
                <button type="button" class="sidebar-toggle-top" title="Vis/skjul full meny" onclick="sidebarMeny.toggleMeny()">
                    ☰
                </button>
                <span id="mobil-topptittel" class="mobil-topptittel"></span>
                <TopBar />
                <MobilFilterKnapp />
            </div>

            <article id="side-innhold" class="content px-4 @(ErFullversjon ? "content-fullversjon" : "")">
                @if (ErKompaktModul)
                {
                    <div class="content-kompakt-indre">
                        <a class="content-kompakt-tilbake" href="@GeneriskTilbakeMal.Href">
                            <Icon Name="arrow-left" />Til @GeneriskTilbakeMal.Tekst
                        </a>
                        @Body
                    </div>
                }
                else
                {
                    @Body
                }
            </article>
        </main>
    </div>
    <MobilTabBar />
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Brukes til å vise en side "bar" - uten sidemeny/toppfelt - f.eks. når den lastes i en
    // iframe inni et popup-vindu et annet sted i appen (se Plantegning).
    private bool ErEmbedVisning =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query)
            .TryGetValue("embed", out var verdi) && verdi == "true";

    // MainLayout er statisk (ikke @rendermode) og rendres kun én gang pr. sideinnlasting -
    // leser derfor query-strengen direkte her (samme oppskrift som MobilFilterKnapp), i
    // stedet for å stole på at MobilVerktoylinjeService allerede har rukket å bli satt av en
    // interaktiv søsterkomponent. "Gå til fullversjon" bruker alltid forceLoad, så denne
    // klassen blir riktig på hver eneste veksling og består uendret gjennom vanlig
    // SPA-navigasjon innad i samme fullversjon-økt.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool ErFullversjon =>
        HttpContext is not null && HttpContext.Request.Query.ContainsKey("fullversjon");

    // Alle sluttdestinasjoner i portalen (alt utenom forsiden "/") vises uten
    // sidemeny/toppfelt på skrivebord - kun innholdet sentrert, med en
    // tilbake-pil (se GeneriskTilbakeMal under). Forsiden beholder full
    // sidemeny siden den er selve "hjem"-startpunktet. Skjules kun via CSS på
    // skrivebordsbredder (se MainLayout.razor.css) slik at mobilvisningen
    // (hamburger-meny + bunn-fane) forblir helt uendret.
    private bool ErKompaktModul
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return path.Length > 0;
        }
    }

    // "Ett steg tilbake mot hjem": hvis siden er en kjent undermodul av en
    // hub (f.eks. Befaringsliste under Befaring), gå dit først i stedet for
    // rett hjem - fra hub-siden går man videre hjem via dens egen tilbakepil.
    // Ukjente sider (uten registrert forelder) går rett til forsiden. Denne
    // lenken vises alltid i markup, men CSS skjuler den automatisk (via
    // :has(.back-link)) på sider som allerede har sin egen tilbakepil fra før
    // - unngår å måtte holde styr på hvilke sider det gjelder her i C#.
    private (string Href, string Tekst) GeneriskTilbakeMal
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            var forelder = PortalModulRegister.FinnForelderHub(path);
            return forelder is { } f ? ("/" + f.Href.TrimStart('/'), f.Tittel) : ("/", "hjem");
        }
    }
}
