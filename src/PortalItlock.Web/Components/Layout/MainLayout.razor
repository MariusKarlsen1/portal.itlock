@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject IJSRuntime JS

@if (ErEmbedVisning)
{
    <article class="content content-embed">
        @Body
    </article>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <button type="button" class="sidebar-toggle-top" title="Vis/skjul full meny" onclick="sidebarMeny.toggleMeny()">
                    ☰
                </button>
                <span id="mobil-topptittel" class="mobil-topptittel"></span>
                <TopBar />
                @if (_erMobilvisning && Verktoylinje.HarFilter)
                {
                    <button type="button" class="mobil-filter-knapp @(Verktoylinje.FilterErAktivt ? "aktiv" : "")" title="Filtrer" @onclick="() => Verktoylinje.UtlosFilter()">
                        <Icon Name="filter" />
                    </button>
                }
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
    <MobilTabBar />
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Brukes til å vise en side "bar" - uten sidemeny/toppfelt - f.eks. når den lastes i en
    // iframe inni et popup-vindu et annet sted i appen (se Plantegning).
    private bool ErEmbedVisning =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query)
            .TryGetValue("embed", out var verdi) && verdi == "true";

    private bool _erMobilvisning;

    protected override void OnInitialized()
    {
        // MainLayout er et layout og lever gjennom hele sesjonen (gjenskapes
        // ikke per side), så dette er riktig sted å lytte på tjenesten som
        // sider (f.eks. Prosjekter) registrerer filter-knappen sin i.
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _erMobilvisning = await JS.InvokeAsync<bool>("erMobilvisning");
            StateHasChanged();
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
