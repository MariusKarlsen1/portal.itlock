@inherits LayoutComponentBase
@implements IDisposable
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Http
@using PortalItlock.Web.Services
@inject NavigationManager Nav
@inject PortalItlock.Web.Services.MobilVerktoylinjeService Verktoylinje
@inject IJSRuntime JS

@if (ErEmbedVisning)
{
    <article class="content content-embed">
        @Body
    </article>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <button type="button" class="sidebar-toggle-top" title="Vis/skjul full meny" onclick="sidebarMeny.toggleMeny()">
                    ☰
                </button>
                <span id="mobil-topptittel" class="mobil-topptittel"></span>
                <TopBar />
                @if (Verktoylinje.ErMobilvisning && Verktoylinje.HarFilter)
                {
                    <button type="button" class="mobil-filter-knapp @(Verktoylinje.FilterErAktivt ? "aktiv" : "")" title="Filtrer" @onclick="() => Verktoylinje.UtlosFilter()">
                        <Icon Name="filter" />
                    </button>
                }
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
    <MobilTabBar />
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Brukes til å vise en side "bar" - uten sidemeny/toppfelt - f.eks. når den lastes i en
    // iframe inni et popup-vindu et annet sted i appen (se Plantegning).
    private bool ErEmbedVisning =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query)
            .TryGetValue("embed", out var verdi) && verdi == "true";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // HttpContext er kun tilgjengelig under server-prerendering (statisk
        // HTML-en som vises aller først), ikke i den interaktive kretsen -
        // brukes derfor bare som et førsteinntrykk for å unngå at prerendret
        // skrivebordsmarkup blafrer synlig på ekte telefoner før JS-interop
        // (OnAfterRenderAsync under) bekrefter faktisk vindusbredde. MainLayout
        // er eneste sted dette avgjøres - sider leser Verktoylinje.ErMobilvisning
        // i stedet for å gjøre sin egen deteksjon, siden MainLayout (i
        // motsetning til sidene) lever gjennom hele kretsens levetid og derfor
        // slipper å gjenta deteksjonen ved hver navigasjon.
        if (HttpContext is not null)
        {
            Verktoylinje.SettMobilvisning(MobilDeteksjon.GjettFraUserAgent(HttpContext.Request.Headers.UserAgent.ToString()));
        }

        // MainLayout er et layout og lever gjennom hele sesjonen (gjenskapes
        // ikke per side), så dette er riktig sted å lytte på tjenesten som
        // sider (f.eks. Prosjekter) registrerer filter-knappen sin i, og som
        // ErMobilvisning-avgjørelsen over publiseres gjennom.
        Verktoylinje.Endret += OnVerktoylinjeEndret;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Verktoylinje.SettMobilvisning(await JS.InvokeAsync<bool>("erMobilvisning"));
        }
    }

    private void OnVerktoylinjeEndret() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Verktoylinje.Endret -= OnVerktoylinjeEndret;
    }
}
