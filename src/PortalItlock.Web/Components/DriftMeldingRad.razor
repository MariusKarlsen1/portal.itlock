@using PortalItlock.Web.Services

@* Én driftsmelding i en liste i driftsportalen - fører til saken med tidslinjen. *@
<a class="dp-melding" href="@($"/drift/melding/{Status.Melding.Id}")">
    <span class="dp-ik dp-t-@Status.Farge"><Icon Name="@Status.Ikon" /></span>
    <span>
        <b>@Tittel</b>
        <small>@Sted · @DriftHelper.Siden(Status.Melding.OpprettetDato)@(Status.Melding.Haster ? " · Haster" : "")</small>
        <span class="dp-tag dp-t-@Status.Farge">@Status.Navn@(Status.Steg is DriftHelper.Steg.UnderArbeid or DriftHelper.Steg.Lost ? $" – {Status.Undertekst}" : "")</span>
    </span>
    <Icon Name="chevron-right" />
</a>

@code {
    [Parameter, EditorRequired] public required DriftHelper.MeldingStatus Status { get; set; }
    [Parameter] public bool VisBygg { get; set; } = true;

    private string Tittel
    {
        get
        {
            var m = Status.Melding;
            var hva = !string.IsNullOrWhiteSpace(m.Kategori) && m.Kategori != "Annet" ? m.Kategori
                : !string.IsNullOrWhiteSpace(m.Tittel) ? m.Tittel
                : m.Tekst.Length > 48 ? m.Tekst[..48].TrimEnd() + "…" : m.Tekst;
            return $"Dør {m.Dor?.Dornummer} – {hva}";
        }
    }

    private string Sted => VisBygg ? Status.Melding.Dor?.Prosjekt?.Navn ?? "" : (Status.Melding.InnmeldtAvBruker?.Navn ?? "Ukjent");
}
