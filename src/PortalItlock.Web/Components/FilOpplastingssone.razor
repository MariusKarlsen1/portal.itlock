<div class="fil-opplasting @(Kompakt ? "fil-opplasting-kompakt" : "")">
    <label class="fil-opplasting-label">
        <Icon Name="upload" />
        <span>@(Laster ? "Laster opp..." : (Kompakt ? "Last opp fil" : "Slipp filer her, eller klikk for å velge"))</span>
        <InputFile OnChange="HandleChange" disabled="@Laster" />
    </label>
    @if (Feilmelding is not null)
    {
        <span class="fil-feil">@Feilmelding</span>
    }
</div>

@code {
    [Parameter] public bool Laster { get; set; }
    [Parameter] public string? Feilmelding { get; set; }
    [Parameter] public bool Kompakt { get; set; }
    [Parameter] public EventCallback<IBrowserFile> OnFilValgt { get; set; }

    private async Task HandleChange(InputFileChangeEventArgs e)
    {
        await OnFilValgt.InvokeAsync(e.File);
    }
}
