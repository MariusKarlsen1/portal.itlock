<span class="status-pill status-pill-@Farge">
    <Icon Name="@Ikon" />
    <span>@Tekst</span>
</span>

@code {
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public string Tekst { get; set; } = "";
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public string Ikon { get; set; } = "";

    // gronn, blaa, gul, lilla, rod eller noytral - samme fargespråk overalt i portalen.
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public string Farge { get; set; } = "noytral";
}
