<div class="kalender">
    <div class="kalender-header">
        <button type="button" class="kalender-nav" @onclick="ForrigeManed" disabled="@ErForrigeManedFortid">&larr;</button>
        <strong>@_visningsManed.ToString("MMMM yyyy", Kultur)</strong>
        <button type="button" class="kalender-nav" @onclick="NesteManed">&rarr;</button>
    </div>

    <div class="kalender-ukedager">
        @foreach (var dag in Ukedager)
        {
            <span>@dag</span>
        }
    </div>

    <div class="kalender-dager">
        @foreach (var dag in DagerIVisning())
        {
            @if (dag is null)
            {
                <span class="kalender-tom"></span>
            }
            else
            {
                var d = dag.Value;
                var erValgt = SelectedDate.HasValue && DateOnly.FromDateTime(SelectedDate.Value) == d;
                var erFortid = d < DateOnly.FromDateTime(DateTime.Today);
                var travelhet = TravleDager is not null && TravleDager.TryGetValue(d, out var antall) ? antall : 0;

                <button type="button"
                        class="kalender-dag @(erValgt ? "kalender-dag-valgt" : "") @(erFortid ? "kalender-dag-fortid" : "")"
                        disabled="@erFortid"
                        title="@(travelhet >= 3 ? "Flere jobber denne dagen" : "")"
                        @onclick="@(() => VelgDag(d))">
                    @d.Day
                    @if (travelhet >= 3 && !erFortid)
                    {
                        <span class="kalender-prikk"></span>
                    }
                </button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SelectedDateChanged { get; set; }
    [Parameter] public Dictionary<DateOnly, int>? TravleDager { get; set; }

    private static readonly System.Globalization.CultureInfo Kultur = System.Globalization.CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] Ukedager = ["Ma", "Ti", "On", "To", "Fr", "Lø", "Sø"];

    private DateOnly _visningsManed = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private bool ErForrigeManedFortid => _visningsManed <= new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);

    private void ForrigeManed()
    {
        if (!ErForrigeManedFortid)
        {
            _visningsManed = _visningsManed.AddMonths(-1);
        }
    }

    private void NesteManed()
    {
        _visningsManed = _visningsManed.AddMonths(1);
    }

    private List<DateOnly?> DagerIVisning()
    {
        var forsteIManeden = _visningsManed;
        var forskyvning = ((int)forsteIManeden.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        var dagerIManeden = DateTime.DaysInMonth(forsteIManeden.Year, forsteIManeden.Month);

        var liste = new List<DateOnly?>();
        for (var i = 0; i < forskyvning; i++)
        {
            liste.Add(null);
        }

        for (var dag = 1; dag <= dagerIManeden; dag++)
        {
            liste.Add(new DateOnly(forsteIManeden.Year, forsteIManeden.Month, dag));
        }

        return liste;
    }

    private async Task VelgDag(DateOnly dag)
    {
        SelectedDate = dag.ToDateTime(TimeOnly.MinValue);
        await SelectedDateChanged.InvokeAsync(SelectedDate);
    }
}
