@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject IJSRuntime JS

@if (ComponentId.HasValue)
{
    <div class="vare-panel-overlay" @onclick="Lukk">
        <div class="vare-panel" @onclick:stopPropagation="true">
            @if (_entity is not null)
            {
                <div class="hero">
                    <div class="hero-bilde-slot" id="bilde-omrade" tabindex="0" title="Klikk her og lim inn et bilde med Ctrl+V">
                        @if (_entity.BildeData is not null)
                        {
                            <img src="@($"/komponent/{_entity.Id}/bilde")" alt="Bilde av varen" class="hero-bilde"
                                 title="Høyreklikk for å fjerne eller justere størrelse"
                                 @oncontextmenu="@(() => _visFjernBildeKnapp = true)" @oncontextmenu:preventDefault="true" />
                            @if (_bekrefterFjernBilde)
                            {
                                <div class="hero-bilde-overlay">
                                    <span>Er du sikker?</span>
                                    <button type="button" class="knapp knapp-farlig knapp-liten" @onclick="FjernBilde">Ja</button>
                                    <button type="button" class="knapp knapp-liten" @onclick="@(() => { _bekrefterFjernBilde = false; _visFjernBildeKnapp = false; })">Avbryt</button>
                                </div>
                            }
                            else if (_visFjernBildeKnapp)
                            {
                                <div class="hero-bilde-overlay">
                                    <label class="bilde-storrelse-label">
                                        Størrelse
                                        <input type="range" min="60" max="400" step="10" value="@(_entity.BildeStorrelse ?? 144)" @oninput="JusterBildeStorrelse" />
                                    </label>
                                    <button type="button" class="knapp knapp-farlig knapp-liten" @onclick="@(() => _bekrefterFjernBilde = true)">Fjern</button>
                                    <button type="button" class="knapp knapp-liten" @onclick="@(() => _visFjernBildeKnapp = false)">Lukk</button>
                                </div>
                            }
                        }
                        else
                        {
                            <label class="hero-bilde-tom">
                                <Icon Name="image" />
                                Last opp bilde
                                <InputFile OnChange="LastOppBilde" accept="image/*" />
                            </label>
                        }
                    </div>
                    <div class="hero-info">
                        <div class="hero-topp-rad">
                            <div>
                                <input class="hero-navn-input" @bind="_entity.Navn" />
                                <div class="hero-meta">@MetaLinje()</div>
                            </div>
                            <div class="panel-toggle-rad">
                                <button type="button" class="toggle-pille @(_entity.ErKomplett ? "aktiv-gronn" : "")" @onclick="ToggleKomplett"><Icon Name="check-circle" />Komplett</button>
                                <button type="button" class="toggle-pille @(_entity.TrengerDobbelsjekk ? "aktiv-gul" : "")" @onclick="ToggleDobbelsjekk"><Icon Name="alert" />Dobbelsjekk</button>
                                <button type="button" class="panel-close" @onclick="Lukk"><Icon Name="x" /></button>
                            </div>
                        </div>
                        <div class="hero-pris-rad">
                            <div class="hero-pris">
                                <span class="hero-pris-label">Netto</span>
                                <input class="hero-pris-verdi aksent" @bind="_entity.PrisNetto" disabled="@_ingenPris" />
                            </div>
                            <div class="hero-pris">
                                <span class="hero-pris-label">Veiledende</span>
                                <input class="hero-pris-verdi" @bind="_entity.PrisVeiledende" disabled="@_ingenPris" />
                            </div>
                            <div class="hero-pris">
                                <span class="hero-pris-label">Rabattgruppe</span>
                                <select class="hero-pris-verdi" @bind="_entity.RabattgruppeId">
                                    <option value="">Ingen</option>
                                    @foreach (var r in _rabattgrupper)
                                    {
                                        <option value="@r.Id">@r.Kode - @r.Leverandor (@r.RabattProsent%)</option>
                                    }
                                </select>
                            </div>
                            <div class="hero-pris">
                                <span class="hero-pris-label">Garantitid</span>
                                <input class="hero-pris-verdi" @bind="_entity.GarantitidManeder" placeholder="mnd" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="spec-liste">
                    <div class="spec-rad">
                        <label>Komponenttype</label>
                        <select @bind="_entity.ComponentTypeId">
                            <option value="">Ikke satt</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Navn</option>
                            }
                        </select>
                    </div>
                    <div class="spec-rad"><label>Varenavn 2</label><input @bind="_entity.Navn2" /></div>
                    <div class="spec-rad"><label>Leverandør (produsent)</label><input @bind="_entity.Produsent" placeholder="F.eks. Dormakaba" /></div>
                    <div class="spec-rad"><label>Konsept</label><input @bind="_entity.Konsept" placeholder="F.eks. Connect" /></div>
                    <div class="spec-rad"><label>Kjøpes inn av</label><input @bind="_entity.Leverandor" /></div>
                    <div class="spec-rad"><label>Produktkode</label><input @bind="_entity.Produktkode" /></div>
                    <div class="spec-rad"><label>GTIN/EAN</label><input @bind="_entity.Gtin" /></div>
                    <div class="spec-rad"><label>Overflate</label><input @bind="_entity.Overflate" placeholder="F.eks. Fkrm" /></div>
                    <div class="spec-rad">
                        <label>Enhet</label>
                        <select @bind="_entity.Enhet">
                            <option value="">Ikke satt</option>
                            <option value="Stk">Stk</option>
                            <option value="Sett">Sett</option>
                            <option value="Par">Par</option>
                            <option value="M">M</option>
                        </select>
                    </div>
                    <div class="spec-rad">
                        <label>Inntektskonto</label>
                        <select @bind="_entity.InntektskontoId" title="Bestemmer hvilken inntektskonto salg av varen grupperes på i Resultatrapporten">
                            <option value="">Ikke satt</option>
                            @foreach (var k in _inntektskontoer)
                            {
                                <option value="@k.Id">@k.Nummer - @k.Navn</option>
                            }
                        </select>
                    </div>
                    <div class="spec-rad"><label>Montasjetid prosjekt (min)</label><input @bind="_entity.MontasjeMinutterProsjekt" /></div>
                    <div class="spec-rad"><label>Montasjetid arbeidsordre (min)</label><input @bind="_entity.MontasjeMinutterArbeidsordre" /></div>
                    <div class="spec-rad"><label>Tidsbruk serviceavtale (min)</label><input @bind="_entity.MontasjeMinutterService" /></div>
                    @if (_entity.ProgrammeringstidMinutter.HasValue || _visProgrammeringstidFelt)
                    {
                        <div class="spec-rad"><label>Estimert programmeringstid (min)</label><input @bind="_entity.ProgrammeringstidMinutter" /></div>
                    }
                    else
                    {
                        <div class="spec-rad">
                            <label></label>
                            <button type="button" class="knapp-liten" title="Kun for varer med programmerbar elektronikk" @onclick="@(() => _visProgrammeringstidFelt = true)">+ Legg til estimert programmeringstid</button>
                        </div>
                    }
                    @if (_entity.KreverBatterier)
                    {
                        <div class="spec-rad">
                            <label>Batteritype</label>
                            <select @bind="_entity.Batteritype">
                                <option value="">Velg type...</option>
                                <option value="AA">AA</option>
                                <option value="AAA">AAA</option>
                                <option value="9V">9V (blokk)</option>
                                <option value="CR123A">CR123A</option>
                                <option value="CR2">CR2</option>
                                <option value="CR2032">CR2032</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                                <option value="Annet">Annet</option>
                            </select>
                        </div>
                        <div class="spec-rad"><label>Antall batterier</label><input type="number" min="1" @bind="_entity.AntallBatterier" /></div>
                    }
                </div>

                <div class="toggle-rad">
                    <label class="sjekk-pille"><input type="checkbox" @bind="_ingenPris" />Ingen pris</label>
                    <label class="sjekk-pille" title="Sperrer kunderabatt på denne varen i tilbud"><input type="checkbox" @bind="_entity.IngenRabattTilgjengelig" />Ingen rabatt tilgjengelig</label>
                    <label class="sjekk-pille"><input type="checkbox" @bind="_entity.ILagerstyring" />Lagervare</label>
                    <label class="sjekk-pille"><input type="checkbox" @bind="_entity.Aktiv" />Aktiv</label>
                    <label class="sjekk-pille"><input type="checkbox" @bind="_entity.KreverBatterier" />Krever batterier</label>
                </div>

                <div class="spec-underoverskrift">Dokumenter</div>
                <div class="fil-grid" id="fil-rad">
                    <div class="fil-sone @(_entity.FdvData is not null || _entity.FdvDokumenter.Count > 0 ? "har-fil" : "")" id="fdv-omrade" @ondragover="@(() => {})" @ondragover:preventDefault="true" @ondrop="@(() => SlippPa("fdv"))" @ondrop:preventDefault="true">
                        <span class="fil-label">FDV</span>
                        @if (_entity.FdvData is not null || _entity.FdvDokumenter.Count > 0)
                        {
                            <div class="fil-liste">
                                @if (_entity.FdvData is not null)
                                {
                                    <span class="fil-chip">
                                        <a href="@($"/komponent/{_entity.Id}/fdv")" target="_blank" draggable="true" title="Dra over til Monteringsanvisning eller Datablad for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "fdv"; _dragDokumentId = null; })">@_entity.FdvFilnavn</a>
                                        @if (_bekrefterFjernFdv)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="FjernFdv">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _bekrefterFjernFdv = false)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _bekrefterFjernFdv = true)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                                @foreach (var d in _entity.FdvDokumenter)
                                {
                                    <span class="fil-chip" @key="d.Id">
                                        <a href="@($"/komponent/fdvdokument/{d.Id}")" target="_blank" draggable="true" title="Dra over til Monteringsanvisning eller Datablad for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "fdv"; _dragDokumentId = d.Id; })">@d.Filnavn</a>
                                        @if (_fjernerFdvDokumentId == d.Id)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="@(() => FjernFdvDokument(d))">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _fjernerFdvDokumentId = null)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _fjernerFdvDokumentId = d.Id)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        <label class="fil-legg-til">
                            <Icon Name="upload" />Last opp
                            <InputFile id="fdv-fil-input" multiple OnChange="LastOppFdv" accept=".pdf,application/pdf" />
                        </label>
                    </div>
                    <div class="fil-sone @(_entity.MontasjebladData is not null || _entity.MontasjebladDokumenter.Count > 0 ? "har-fil" : "")" id="montering-omrade" @ondragover="@(() => {})" @ondragover:preventDefault="true" @ondrop="@(() => SlippPa("montasjeblad"))" @ondrop:preventDefault="true">
                        <span class="fil-label">Monteringsanvisning</span>
                        @if (_entity.MontasjebladData is not null || _entity.MontasjebladDokumenter.Count > 0)
                        {
                            <div class="fil-liste">
                                @if (_entity.MontasjebladData is not null)
                                {
                                    <span class="fil-chip">
                                        <a href="@($"/komponent/{_entity.Id}/montasjeblad")" target="_blank" draggable="true" title="Dra over til FDV eller Datablad for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "montasjeblad"; _dragDokumentId = null; })">@_entity.MontasjebladFilnavn</a>
                                        @if (_bekrefterFjernMontasjeblad)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="FjernMontasjeblad">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _bekrefterFjernMontasjeblad = false)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _bekrefterFjernMontasjeblad = true)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                                @foreach (var d in _entity.MontasjebladDokumenter)
                                {
                                    <span class="fil-chip" @key="d.Id">
                                        <a href="@($"/komponent/montasjebladdokument/{d.Id}")" target="_blank" draggable="true" title="Dra over til FDV eller Datablad for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "montasjeblad"; _dragDokumentId = d.Id; })">@d.Filnavn</a>
                                        @if (_fjernerMontasjebladDokumentId == d.Id)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="@(() => FjernMontasjebladDokument(d))">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _fjernerMontasjebladDokumentId = null)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _fjernerMontasjebladDokumentId = d.Id)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        <label class="fil-legg-til">
                            <Icon Name="upload" />Last opp
                            <InputFile id="montering-fil-input" multiple OnChange="LastOppMontasjeblad" accept=".pdf,application/pdf" />
                        </label>
                    </div>
                    <div class="fil-sone @(_entity.DatabladData is not null || _entity.DatabladDokumenter.Count > 0 ? "har-fil" : "")" id="datablad-omrade" @ondragover="@(() => {})" @ondragover:preventDefault="true" @ondrop="@(() => SlippPa("datablad"))" @ondrop:preventDefault="true">
                        <span class="fil-label">Datablad</span>
                        @if (_entity.DatabladData is not null || _entity.DatabladDokumenter.Count > 0)
                        {
                            <div class="fil-liste">
                                @if (_entity.DatabladData is not null)
                                {
                                    <span class="fil-chip">
                                        <a href="@($"/komponent/{_entity.Id}/datablad")" target="_blank" draggable="true" title="Dra over til FDV eller Monteringsanvisning for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "datablad"; _dragDokumentId = null; })">@_entity.DatabladFilnavn</a>
                                        @if (_bekrefterFjernDatablad)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="FjernDatablad">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _bekrefterFjernDatablad = false)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _bekrefterFjernDatablad = true)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                                @foreach (var d in _entity.DatabladDokumenter)
                                {
                                    <span class="fil-chip" @key="d.Id">
                                        <a href="@($"/komponent/databladdokument/{d.Id}")" target="_blank" draggable="true" title="Dra over til FDV eller Monteringsanvisning for å flytte"
                                           @ondragstart="@(() => { _dragKategori = "datablad"; _dragDokumentId = d.Id; })">@d.Filnavn</a>
                                        @if (_fjernerDatabladDokumentId == d.Id)
                                        {
                                            <span class="fjern-bekreft">
                                                <button type="button" class="knapp-liten" @onclick="@(() => FjernDatabladDokument(d))">Ja</button>
                                                <button type="button" class="knapp-liten" @onclick="@(() => _fjernerDatabladDokumentId = null)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _fjernerDatabladDokumentId = d.Id)"><Icon Name="trash" /></button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        <label class="fil-legg-til">
                            <Icon Name="upload" />Last opp
                            <InputFile id="datablad-fil-input" multiple OnChange="LastOppDatablad" accept=".pdf,application/pdf" />
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_filFeil))
                {
                    <p class="form-error">@_filFeil</p>
                }

                <div class="spec-underoverskrift">
                    Leverandører (@_lenker.Count)
                </div>
                <div class="seksjon-pad">
                    <p class="section-hint">Flere leverandører kan ha samme vare, med ulik pris - huk av hvilken som er standard.</p>
                    @if (_lenker.Count == 0)
                    {
                        <p class="list-empty">Ingen leverandører koblet til denne varen ennå.</p>
                    }
                    else
                    {
                        <div class="lenke-tabell-wrap">
                            <table class="lenke-table">
                                <thead>
                                    <tr>
                                        <th>Leverandør</th>
                                        <th>Varenummer</th>
                                        <th>Varenavn 1</th>
                                        <th>Netto</th>
                                        <th>Veiledende</th>
                                        <th>Standard</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in _lenker)
                                    {
                                        <tr @key="l.LeverandorId">
                                            <td>@l.LeverandorNavn</td>
                                            <td><input @bind="l.Varenummer" @bind:after="@(() => LagreLenke(l))" /></td>
                                            <td><input @bind="l.Navn" @bind:after="@(() => LagreLenke(l))" /></td>
                                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisNetto" @bind:after="@(() => LagreLenke(l))" /></td>
                                            <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisVeiledende" @bind:after="@(() => LagreLenke(l))" /></td>
                                            <td>
                                                @if (l.ErStandard)
                                                {
                                                    <span class="standard-pille">Standard</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="knapp-liten" @onclick="@(() => SettStandard(l))">Sett som standard</button>
                                                }
                                            </td>
                                            <td>
                                                @if (_fjernerLeverandorId == l.LeverandorId)
                                                {
                                                    <span class="fjern-bekreft">
                                                        <button type="button" class="knapp-liten" @onclick="@(() => FjernLenke(l))">Ja</button>
                                                        <button type="button" class="knapp-liten" @onclick="@(() => _fjernerLeverandorId = null)">Avbryt</button>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="ikon-btn" title="Fjern" @onclick="@(() => _fjernerLeverandorId = l.LeverandorId)"><Icon Name="trash" /></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_visNyLenkeRad)
                    {
                        <div class="ny-lenke-rad">
                            <select @bind="_valgtLeverandorId" @bind:after="SokEksisterendeLenke">
                                <option value="">Velg leverandør...</option>
                                @foreach (var l in _alleLeverandorer)
                                {
                                    <option value="@l.Id">@l.Navn</option>
                                }
                            </select>
                            <input @bind="_nyttVarenummer" @bind:after="SokEksisterendeLenke" placeholder="Varenummer" />
                            <input @bind="_nyttNavn" placeholder="Varenavn 1 (valgfritt)" />
                            <input type="number" step="0.01" @bind="_nyPrisNetto" placeholder="Netto" />
                            <input type="number" step="0.01" @bind="_nyPrisVeiledende" placeholder="Veiledende" />
                            <button type="button" class="knapp knapp-primaer knapp-liten-btn" @onclick="LeggTilLeverandor">Legg til</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_nyLenkeFunnetHint))
                        {
                            <p class="section-hint">@_nyLenkeFunnetHint</p>
                        }
                        @if (!string.IsNullOrEmpty(_leggTilFeil))
                        {
                            <p class="form-error">@_leggTilFeil</p>
                        }
                    }
                    else
                    {
                        <button type="button" class="knapp-liten" @onclick="@(() => _visNyLenkeRad = true)">+ Ny rad</button>
                    }
                </div>

                <div class="spec-underoverskrift">Produktgrupper</div>
                <div class="seksjon-pad">
                    @if (_entity.Produktgrupper.Count == 0)
                    {
                        <p class="list-empty">Varen ligger ikke i noen produktgruppe ennå.</p>
                    }
                    else
                    {
                        <div class="pille-liste">
                            @foreach (var p in _entity.Produktgrupper.OrderBy(p => p.Navn))
                            {
                                <span class="gruppe-pille">@p.Navn</span>
                            }
                        </div>
                    }
                    <button type="button" class="knapp-liten" @onclick="ApneProduktgruppeVelger">Legg produktet til i en produktgruppe</button>
                </div>

                <div class="panel-footer">
                    <button type="button" class="knapp knapp-primaer" @onclick="Lagre">Lagre</button>
                    @if (!string.IsNullOrEmpty(_melding))
                    {
                        <span class="save-success">@_melding</span>
                    }
                </div>

                @if (_visProduktgruppeVelger)
                {
                    <div class="vare-panel-overlay produktgruppe-overlay" @onclick="LukkProduktgruppeVelger">
                        <div class="vare-panel produktgruppe-modal" @onclick:stopPropagation="true">
                            <div class="produktgruppe-modal-header">
                                <h2>Legg til i produktgruppe</h2>
                                <button type="button" class="panel-close" @onclick="LukkProduktgruppeVelger"><Icon Name="x" /></button>
                            </div>
                            <div class="seksjon-pad">
                                @if (_alleProduktgrupper.Count == 0)
                                {
                                    <p class="list-empty">Ingen produktgrupper opprettet ennå.</p>
                                }
                                else
                                {
                                    <div class="produktgruppe-velger">
                                        @foreach (var p in _alleProduktgrupper)
                                        {
                                            <label class="sjekk-pille">
                                                <input type="checkbox" checked="@_valgteProduktgruppeIder.Contains(p.Id)" @onchange="@(e => TogglProduktgruppeValg(p.Id, (bool)e.Value!))" />
                                                @p.Navn
                                            </label>
                                        }
                                    </div>
                                }
                                <button type="button" class="knapp knapp-primaer" style="margin-top:1rem;" @onclick="LagreProduktgruppeVelger">Lagre og lukk</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? ComponentId { get; set; }
