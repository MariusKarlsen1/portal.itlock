    private string MetaLinje()
    {
        if (_entity is null)
        {
            return "";
        }

        var typeNavn = _types.FirstOrDefault(t => t.Id == _entity.ComponentTypeId)?.Navn;
        var deler = new List<string>();
        if (!string.IsNullOrWhiteSpace(typeNavn))
        {
            deler.Add(typeNavn);
        }
        if (!string.IsNullOrWhiteSpace(_entity.Produsent))
        {
            deler.Add(_entity.Produsent);
        }
        if (!string.IsNullOrWhiteSpace(_entity.Produktkode))
        {
            deler.Add(_entity.Produktkode);
        }

        return deler.Count == 0 ? "" : string.Join(" · ", deler);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ComponentId != _lastetForId)
        {
            _lastetForId = ComponentId;
            if (ComponentId.HasValue)
            {
                await LastAsync(ComponentId.Value);
            }
            else
            {
                _entity = null;
                _limKoblet = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_limKoblet && _entity is not null)
        {
            _limKoblet = true;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vareBilde.kobleLim", "bilde-omrade", _dotNetRef);
            await JS.InvokeVoidAsync("vareBilde.kobleDrop", "fdv-omrade", "fdv-fil-input");
            await JS.InvokeVoidAsync("vareBilde.kobleDrop", "montering-omrade", "montering-fil-input");
            await JS.InvokeVoidAsync("vareBilde.kobleDrop", "datablad-omrade", "datablad-fil-input");
            await JS.InvokeVoidAsync("vareBilde.kobleDragKlikkFiks", "fil-rad");
        }
    }

    // Kalles fra vareBilde.js når brukeren limer inn et bilde (Ctrl+V) rett
    // fra utklippstavlen mens Bilde-feltet har fokus - raskere enn å måtte
    // bla frem en fil på disk hver gang.
    [JSInvokable]
    public async Task MottaLimtInnBilde(string base64Data, string contentType)
    {
        if (_entity is null)
        {
            return;
        }

        _filFeil = null;
        var innhold = Convert.FromBase64String(base64Data);
        if (innhold.Length > 20_000_000)
        {
            _filFeil = "Bildet er for stort (maks 20 MB).";
            StateHasChanged();
            return;
        }

        var extension = contentType.Split('/').Last();
        _entity.BildeData = innhold;
        _entity.BildeFilnavn = $"limt-inn-bilde.{extension}";
        _entity.BildeContentType = contentType;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task LastAsync(int id)
    {
        _melding = null;
        _filFeil = null;
        _leggTilFeil = null;
        _nyLenkeFunnetHint = null;
        _visNyLenkeRad = false;
        _visProduktgruppeVelger = false;
        _fjernerLeverandorId = null;
        _bekrefterFjernFdv = false;
        _bekrefterFjernMontasjeblad = false;
        _bekrefterFjernBilde = false;
        _visFjernBildeKnapp = false;
        _fjernerFdvDokumentId = null;
        _fjernerMontasjebladDokumentId = null;
        _bekrefterFjernDatablad = false;
        _fjernerDatabladDokumentId = null;
        _visProgrammeringstidFelt = false;
        _dragKategori = null;
        _dragDokumentId = null;
        _entity = await Db.Components.Include(c => c.Produktgrupper).Include(c => c.FdvDokumenter).Include(c => c.MontasjebladDokumenter).Include(c => c.DatabladDokumenter).FirstOrDefaultAsync(c => c.Id == id);
        if (_entity is null)
        {
            return;
        }

        _ingenPris = _entity.PrisNetto is null && _entity.PrisVeiledende is null;
        _nyttNavn = _entity.Navn;
        _types = await Db.ComponentTypes.OrderBy(t => t.Sortering).ThenBy(t => t.Navn).ToListAsync();
        _rabattgrupper = await Db.Rabattgrupper.Where(r => r.Aktiv).OrderBy(r => r.Leverandor).ThenBy(r => r.Kode).ToListAsync();
        _inntektskontoer = await Db.Inntektskontoer.OrderBy(k => k.Nummer).ToListAsync();
        _alleLeverandorer = await Db.Leverandorer.OrderBy(l => l.Navn).ToListAsync();
        _alleProduktgrupper = await Db.Produktgrupper.OrderBy(p => p.Navn).ToListAsync();

        await LastLenkerAsync();
    }

    private async Task LastLenkerAsync()
    {
        if (_entity is null)
        {
            return;
        }

        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.ComponentId == _entity.Id)
            .Include(cl => cl.Leverandor)
            .OrderBy(cl => cl.Leverandor!.Navn)
            .Select(cl => new LenkeRad
            {
                LeverandorId = cl.LeverandorId,
                LeverandorNavn = cl.Leverandor!.Navn,
                Varenummer = cl.Varenummer,
                Navn = cl.Navn,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();
    }

    private async Task Lagre()
    {
        if (_entity is null)
        {
            return;
        }

        var nyNetto = _ingenPris ? null : _entity.PrisNetto;
        var nyVeil = _ingenPris ? null : _entity.PrisVeiledende;
        PrisHistorikkLogger.Logg(Db, _entity, nyNetto, nyVeil, "Manuell endring");
        _entity.PrisNetto = nyNetto;
        _entity.PrisVeiledende = nyVeil;
        _entity.Navn = _entity.Navn.Trim();

        await Db.SaveChangesAsync();
        _melding = "Lagret.";
        await OnSaved.InvokeAsync();
    }

