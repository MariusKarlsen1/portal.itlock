    private FlyttbartDokument? HentOgFjernFraKategori(string kategori, int? dokumentId) => kategori switch
    {
        "fdv" => HentOgFjernFraFdv(dokumentId),
        "montasjeblad" => HentOgFjernFraMonteringsanvisning(dokumentId),
        "datablad" => HentOgFjernFraDatablad(dokumentId),
        _ => null
    };

    private void LeggTilKategori(string kategori, FlyttbartDokument d)
    {
        switch (kategori)
        {
            case "fdv":
                LeggTilFdv(d);
                break;
            case "montasjeblad":
                LeggTilMonteringsanvisning(d);
                break;
            case "datablad":
                LeggTilDatablad(d);
                break;
        }
    }

    private async Task SlippPa(string malKategori)
    {
        if (_dragKategori is not null && _dragKategori != malKategori)
        {
            var dokument = HentOgFjernFraKategori(_dragKategori, _dragDokumentId);
            if (dokument is not null)
            {
                LeggTilKategori(malKategori, dokument);
                await Db.SaveChangesAsync();
                await OnSaved.InvokeAsync();
            }
        }

        _dragKategori = null;
        _dragDokumentId = null;
    }

