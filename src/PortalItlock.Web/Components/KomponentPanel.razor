    // Lar brukeren dra et fdv/montasjeblad/datablad-dokument (hoveddokument
    // eller ett av de ekstra) over til en av de andre kategoriene for å
    // flytte det dit, hvis det ble lagt i feil kategori - se @ondragstart på
    // lenkene og @ondrop/@ondragover på fil-blokk-containerne over.
    private sealed record FlyttbartDokument(byte[] Data, string Filnavn, string ContentType);

    private FlyttbartDokument? HentOgFjernFraFdv(int? dokumentId)
    {
        if (_entity is null)
        {
            return null;
        }

        if (dokumentId is null)
        {
            if (_entity.FdvData is null)
            {
                return null;
            }

            var hoved = new FlyttbartDokument(_entity.FdvData, _entity.FdvFilnavn!, _entity.FdvContentType!);
            _entity.FdvData = null;
            _entity.FdvFilnavn = null;
            _entity.FdvContentType = null;
            return hoved;
        }

        var dokument = _entity.FdvDokumenter.FirstOrDefault(d => d.Id == dokumentId);
        if (dokument is null)
        {
            return null;
        }

        var flyttet = new FlyttbartDokument(dokument.Data, dokument.Filnavn, dokument.ContentType);
        Db.ComponentFdvDokumenter.Remove(dokument);
        _entity.FdvDokumenter.Remove(dokument);
        return flyttet;
    }

