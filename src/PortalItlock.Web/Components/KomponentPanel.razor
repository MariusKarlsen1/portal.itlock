@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db

@if (ComponentId.HasValue)
{
    <div class="vare-panel-overlay" @onclick="Lukk">
        <div class="vare-panel" @onclick:stopPropagation="true">
            <div class="vare-panel-header">
                <h2>@(_entity?.Navn ?? "Vare")</h2>
                <button type="button" class="vare-panel-close" @onclick="Lukk">✕</button>
            </div>

            @if (_entity is not null)
            {
                <div class="field-grid">
                    <label>
                        Komponenttype
                        <select @bind="_entity.ComponentTypeId">
                            <option value="">Ikke satt</option>
                            @foreach (var t in _types)
                            {
                                <option value="@t.Id">@t.Navn</option>
                            }
                        </select>
                    </label>
                    <label>
                        Varenavn 1
                        <input @bind="_entity.Navn" />
                    </label>
                    <label>
                        Varenavn 2
                        <input @bind="_entity.Navn2" />
                    </label>
                    <label>
                        Leverandør
                        <input @bind="_entity.Produsent" placeholder="F.eks. Dormakaba" />
                    </label>
                    <label>
                        Konsept
                        <input @bind="_entity.Konsept" placeholder="F.eks. Connect" />
                    </label>
                    <label>
                        Kjøpes inn av
                        <input @bind="_entity.Leverandor" />
                    </label>
                    <label>
                        Produktkode
                        <input @bind="_entity.Produktkode" />
                    </label>
                    <label>
                        GTIN/EAN
                        <input @bind="_entity.Gtin" />
                    </label>
                    <label>
                        Overflate
                        <input @bind="_entity.Overflate" placeholder="F.eks. Fkrm" />
                    </label>
                    <label>
                        Rabattgruppe
                        <select @bind="_entity.RabattgruppeId">
                            <option value="">Ingen</option>
                            @foreach (var r in _rabattgrupper)
                            {
                                <option value="@r.Id">@r.Kode - @r.Leverandor (@r.RabattProsent%)</option>
                            }
                        </select>
                    </label>
                    <label>
                        Veiledende
                        <input @bind="_entity.PrisVeiledende" disabled="@_ingenPris" />
                    </label>
                    <label>
                        Netto
                        <input @bind="_entity.PrisNetto" disabled="@_ingenPris" />
                    </label>
                    <label>
                        Garantitid (mnd)
                        <input @bind="_entity.GarantitidManeder" />
                    </label>
                    <label>
                        Montasjetid arbeidsordre (min)
                        <input @bind="_entity.MontasjeMinutterArbeidsordre" />
                    </label>
                    <label>
                        Tidsbruk serviceavtale (min)
                        <input @bind="_entity.MontasjeMinutterService" />
                    </label>
                    <label>
                        Montasjetid prosjekt (min)
                        <input @bind="_entity.MontasjeMinutterProsjekt" />
                    </label>
                    <label>
                        Enhet
                        <select @bind="_entity.Enhet">
                            <option value="">Ikke satt</option>
                            <option value="Stk">Stk</option>
                            <option value="Sett">Sett</option>
                            <option value="Par">Par</option>
                            <option value="M">M</option>
                        </select>
                    </label>
                    <label>
                        Inntektskonto
                        <select @bind="_entity.InntektskontoId">
                            <option value="">Ikke satt</option>
                            @foreach (var k in _inntektskontoer)
                            {
                                <option value="@k.Id">@k.Nummer - @k.Navn</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="checkbox-rad">
                    <label class="checkbox-felt">
                        <input type="checkbox" @bind="_ingenPris" />
                        Ingen pris
                    </label>
                    <label class="checkbox-felt" title="Sperrer kunderabatt på denne varen i tilbud">
                        <input type="checkbox" @bind="_entity.IngenRabattTilgjengelig" />
                        Ingen rabatt tilgjengelig
                    </label>
                    <label class="checkbox-felt">
                        <input type="checkbox" @bind="_entity.ILagerstyring" />
                        Lagervare
                    </label>
                    <label class="checkbox-felt">
                        <input type="checkbox" @bind="_entity.Aktiv" />
                        Aktiv
                    </label>
                </div>

                <div class="fil-rad">
                    <div class="fil-blokk">
                        <span class="fil-label">FDV</span>
                        @if (_entity.FdvData is not null || _entity.FdvDokumenter.Count > 0)
                        {
                            <ul class="fil-liste">
                                @if (_entity.FdvData is not null)
                                {
                                    <li>
                                        <a href="@($"/komponent/{_entity.Id}/fdv")" target="_blank">@_entity.FdvFilnavn</a>
                                        @if (_bekrefterFjernFdv)
                                        {
                                            <span class="fjern-bekreft">
                                                Er du sikker?
                                                <button type="button" class="remove-button" @onclick="FjernFdv">Ja</button>
                                                <button type="button" class="cancel-button" @onclick="@(() => _bekrefterFjernFdv = false)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="remove-button" @onclick="@(() => _bekrefterFjernFdv = true)">Fjern</button>
                                        }
                                    </li>
                                }
                                @foreach (var d in _entity.FdvDokumenter)
                                {
                                    <li @key="d.Id">
                                        <a href="@($"/komponent/fdvdokument/{d.Id}")" target="_blank">@d.Filnavn</a>
                                        @if (_fjernerFdvDokumentId == d.Id)
                                        {
                                            <span class="fjern-bekreft">
                                                Er du sikker?
                                                <button type="button" class="remove-button" @onclick="@(() => FjernFdvDokument(d))">Ja</button>
                                                <button type="button" class="cancel-button" @onclick="@(() => _fjernerFdvDokumentId = null)">Avbryt</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="remove-button" @onclick="@(() => _fjernerFdvDokumentId = d.Id)">Fjern</button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <InputFile OnChange="LastOppFdv" accept=".pdf,application/pdf" />
                    </div>
                    <div class="fil-blokk">
                        <span class="fil-label">Montasjeblad</span>
                        @if (_entity.MontasjebladData is not null)
                        {
                            <div class="fil-linje">
                                <a href="@($"/komponent/{_entity.Id}/montasjeblad")" target="_blank">@_entity.MontasjebladFilnavn</a>
                                @if (_bekrefterFjernMontasjeblad)
                                {
                                    <span class="fjern-bekreft">
                                        Er du sikker?
                                        <button type="button" class="remove-button" @onclick="FjernMontasjeblad">Ja</button>
                                        <button type="button" class="cancel-button" @onclick="@(() => _bekrefterFjernMontasjeblad = false)">Avbryt</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="remove-button" @onclick="@(() => _bekrefterFjernMontasjeblad = true)">Fjern</button>
                                }
                            </div>
                        }
                        else
                        {
                            <InputFile OnChange="LastOppMontasjeblad" accept=".pdf,application/pdf" />
                        }
                    </div>
                    <div class="fil-blokk">
                        <span class="fil-label">Bilde</span>
                        @if (_entity.BildeData is not null)
                        {
                            <div class="fil-linje">
                                <img src="@($"/komponent/{_entity.Id}/bilde")" alt="Bilde av varen" class="vare-bilde-forhandsvisning" />
                                @if (_bekrefterFjernBilde)
                                {
                                    <span class="fjern-bekreft">
                                        Er du sikker?
                                        <button type="button" class="remove-button" @onclick="FjernBilde">Ja</button>
                                        <button type="button" class="cancel-button" @onclick="@(() => _bekrefterFjernBilde = false)">Avbryt</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="remove-button" @onclick="@(() => _bekrefterFjernBilde = true)">Fjern</button>
                                }
                            </div>
                        }
                        else
                        {
                            <InputFile OnChange="LastOppBilde" accept="image/*" />
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_filFeil))
                {
                    <p class="form-error">@_filFeil</p>
                }

                <button type="button" class="save-button" @onclick="Lagre">Lagre</button>
                @if (!string.IsNullOrEmpty(_melding))
                {
                    <span class="save-success">@_melding</span>
                }

                <section class="leverandor-seksjon">
                    <h3>Leverandører (@_lenker.Count)</h3>
                    <p class="section-hint">Flere leverandører kan ha samme vare, med ulik pris - huk av hvilken som er standard.</p>
                    @if (_lenker.Count == 0)
                    {
                        <p class="list-empty">Ingen leverandører koblet til denne varen ennå.</p>
                    }
                    else
                    {
                        <table class="lenke-table">
                            <thead>
                                <tr>
                                    <th>Leverandør</th>
                                    <th>Varenummer</th>
                                    <th>Varenavn 1</th>
                                    <th>Netto</th>
                                    <th>Veiledende</th>
                                    <th>Standard</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in _lenker)
                                {
                                    <tr @key="l.LeverandorId">
                                        <td>@l.LeverandorNavn</td>
                                        <td><input @bind="l.Varenummer" @bind:after="@(() => LagreLenke(l))" /></td>
                                        <td><input @bind="l.Navn" @bind:after="@(() => LagreLenke(l))" /></td>
                                        <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisNetto" @bind:after="@(() => LagreLenke(l))" /></td>
                                        <td><input type="number" step="0.01" class="pris-input" @bind="l.PrisVeiledende" @bind:after="@(() => LagreLenke(l))" /></td>
                                        <td>
                                            @if (l.ErStandard)
                                            {
                                                <span class="standard-merke">Standard</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="cancel-button" @onclick="@(() => SettStandard(l))">Sett som standard</button>
                                            }
                                        </td>
                                        <td>
                                            @if (_fjernerLeverandorId == l.LeverandorId)
                                            {
                                                <span class="fjern-bekreft">
                                                    Er du sikker?
                                                    <button type="button" class="remove-button" @onclick="@(() => FjernLenke(l))">Ja</button>
                                                    <button type="button" class="cancel-button" @onclick="@(() => _fjernerLeverandorId = null)">Avbryt</button>
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" class="remove-button" @onclick="@(() => _fjernerLeverandorId = l.LeverandorId)">Fjern</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (_visNyLenkeRad)
                    {
                        <div class="ny-lenke-rad">
                            <select @bind="_valgtLeverandorId" @bind:after="SokEksisterendeLenke">
                                <option value="">Velg leverandør...</option>
                                @foreach (var l in _alleLeverandorer)
                                {
                                    <option value="@l.Id">@l.Navn</option>
                                }
                            </select>
                            <input @bind="_nyttVarenummer" @bind:after="SokEksisterendeLenke" placeholder="Varenummer" />
                            <input @bind="_nyttNavn" placeholder="Varenavn 1 (valgfritt)" />
                            <input type="number" step="0.01" @bind="_nyPrisNetto" placeholder="Netto" />
                            <input type="number" step="0.01" @bind="_nyPrisVeiledende" placeholder="Veiledende" />
                            <button type="button" class="add-button" @onclick="LeggTilLeverandor">Legg til</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_nyLenkeFunnetHint))
                        {
                            <p class="section-hint">@_nyLenkeFunnetHint</p>
                        }
                        @if (!string.IsNullOrEmpty(_leggTilFeil))
                        {
                            <p class="form-error">@_leggTilFeil</p>
                        }
                    }
                    else
                    {
                        <button type="button" class="cancel-button" @onclick="@(() => _visNyLenkeRad = true)">Ny rad</button>
                    }
                </section>

                <section class="leverandor-seksjon">
                    <h3>Produktgrupper</h3>
                    <p class="section-hint">Varen kan ligge i flere produktgrupper.</p>
                    @if (_entity.Produktgrupper.Count == 0)
                    {
                        <p class="list-empty">Varen ligger ikke i noen produktgruppe ennå.</p>
                    }
                    else
                    {
                        <ul class="produktgruppe-liste">
                            @foreach (var p in _entity.Produktgrupper.OrderBy(p => p.Navn))
                            {
                                <li>@p.Navn</li>
                            }
                        </ul>
                    }
                    <button type="button" class="cancel-button" @onclick="ApneProduktgruppeVelger">Legg produktet til i en produktgruppe</button>
                </section>

                @if (_visProduktgruppeVelger)
                {
                    <div class="vare-panel-overlay produktgruppe-overlay" @onclick="LukkProduktgruppeVelger">
                        <div class="vare-panel produktgruppe-modal" @onclick:stopPropagation="true">
                            <div class="vare-panel-header">
                                <h2>Legg til i produktgruppe</h2>
                                <button type="button" class="vare-panel-close" @onclick="LukkProduktgruppeVelger">✕</button>
                            </div>
                            @if (_alleProduktgrupper.Count == 0)
                            {
                                <p class="list-empty">Ingen produktgrupper opprettet ennå.</p>
                            }
                            else
                            {
                                <div class="produktgruppe-velger">
                                    @foreach (var p in _alleProduktgrupper)
                                    {
                                        <label class="checkbox-felt">
                                            <input type="checkbox" checked="@_valgteProduktgruppeIder.Contains(p.Id)" @onchange="@(e => TogglProduktgruppeValg(p.Id, (bool)e.Value!))" />
                                            @p.Navn
                                        </label>
                                    }
                                </div>
                            }
                            <button type="button" class="save-button" @onclick="LagreProduktgruppeVelger">Lagre og lukk</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? ComponentId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class LenkeRad
    {
        public int LeverandorId { get; set; }
        public string LeverandorNavn { get; set; } = "";
        public string? Varenummer { get; set; }
        public string? Navn { get; set; }
        public decimal? PrisNetto { get; set; }
        public decimal? PrisVeiledende { get; set; }
        public bool ErStandard { get; set; }
    }

    private Component? _entity;
    private bool _ingenPris;
    private List<ComponentType> _types = [];
    private List<Rabattgruppe> _rabattgrupper = [];
    private List<Inntektskonto> _inntektskontoer = [];
    private List<Leverandor> _alleLeverandorer = [];
    private List<LenkeRad> _lenker = [];
    private List<Produktgruppe> _alleProduktgrupper = [];
    private bool _visProduktgruppeVelger;
    private HashSet<int> _valgteProduktgruppeIder = [];
    private string? _melding;
    private string? _filFeil;

    private int? _valgtLeverandorId;
    private bool _visNyLenkeRad;
    private string _nyttVarenummer = "";
    private string _nyttNavn = "";
    private decimal? _nyPrisNetto;
    private decimal? _nyPrisVeiledende;
    private string? _leggTilFeil;
    private string? _nyLenkeFunnetHint;

    private int? _lastetForId;
    private int? _fjernerLeverandorId;
    private bool _bekrefterFjernFdv;
    private bool _bekrefterFjernMontasjeblad;
    private bool _bekrefterFjernBilde;
    private int? _fjernerFdvDokumentId;

    protected override async Task OnParametersSetAsync()
    {
        if (ComponentId != _lastetForId)
        {
            _lastetForId = ComponentId;
            if (ComponentId.HasValue)
            {
                await LastAsync(ComponentId.Value);
            }
            else
            {
                _entity = null;
            }
        }
    }

    private async Task LastAsync(int id)
    {
        _melding = null;
        _filFeil = null;
        _leggTilFeil = null;
        _nyLenkeFunnetHint = null;
        _visNyLenkeRad = false;
        _visProduktgruppeVelger = false;
        _fjernerLeverandorId = null;
        _bekrefterFjernFdv = false;
        _bekrefterFjernMontasjeblad = false;
        _bekrefterFjernBilde = false;
        _fjernerFdvDokumentId = null;
        _entity = await Db.Components.Include(c => c.Produktgrupper).Include(c => c.FdvDokumenter).FirstOrDefaultAsync(c => c.Id == id);
        if (_entity is null)
        {
            return;
        }

        _ingenPris = _entity.PrisNetto is null && _entity.PrisVeiledende is null;
        _nyttNavn = _entity.Navn;
        _types = await Db.ComponentTypes.OrderBy(t => t.Sortering).ThenBy(t => t.Navn).ToListAsync();
        _rabattgrupper = await Db.Rabattgrupper.Where(r => r.Aktiv).OrderBy(r => r.Leverandor).ThenBy(r => r.Kode).ToListAsync();
        _inntektskontoer = await Db.Inntektskontoer.OrderBy(k => k.Nummer).ToListAsync();
        _alleLeverandorer = await Db.Leverandorer.OrderBy(l => l.Navn).ToListAsync();
        _alleProduktgrupper = await Db.Produktgrupper.OrderBy(p => p.Navn).ToListAsync();

        await LastLenkerAsync();
    }

    private async Task LastLenkerAsync()
    {
        if (_entity is null)
        {
            return;
        }

        _lenker = await Db.ComponentLeverandorer
            .Where(cl => cl.ComponentId == _entity.Id)
            .Include(cl => cl.Leverandor)
            .OrderBy(cl => cl.Leverandor!.Navn)
            .Select(cl => new LenkeRad
            {
                LeverandorId = cl.LeverandorId,
                LeverandorNavn = cl.Leverandor!.Navn,
                Varenummer = cl.Varenummer,
                Navn = cl.Navn,
                PrisNetto = cl.PrisNetto,
                PrisVeiledende = cl.PrisVeiledende,
                ErStandard = cl.ErStandard
            })
            .ToListAsync();
    }

    private async Task Lagre()
    {
        if (_entity is null)
        {
            return;
        }

        var nyNetto = _ingenPris ? null : _entity.PrisNetto;
        var nyVeil = _ingenPris ? null : _entity.PrisVeiledende;
        PrisHistorikkLogger.Logg(Db, _entity, nyNetto, nyVeil, "Manuell endring");
        _entity.PrisNetto = nyNetto;
        _entity.PrisVeiledende = nyVeil;
        _entity.Navn = _entity.Navn.Trim();

        await Db.SaveChangesAsync();
        _melding = "Lagret.";
        await OnSaved.InvokeAsync();
    }

    private async Task LastOppFdv(InputFileChangeEventArgs e)
    {
        if (_entity is null)
        {
            return;
        }

        _filFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _filFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        var innhold = buffer.ToArray();
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;

        // Hoveddokumentet (FdvData) fylles først - alt deretter blir egne,
        // ekstra dokumenter, siden en vare kan ha flere.
        if (_entity.FdvData is null)
        {
            _entity.FdvData = innhold;
            _entity.FdvFilnavn = file.Name;
            _entity.FdvContentType = contentType;
        }
        else
        {
            Db.ComponentFdvDokumenter.Add(new ComponentFdvDokument
            {
                ComponentId = _entity.Id,
                Filnavn = file.Name,
                ContentType = contentType,
                Data = innhold
            });
        }

        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernFdv()
    {
        if (_entity is null)
        {
            return;
        }

        _entity.FdvData = null;
        _entity.FdvFilnavn = null;
        _entity.FdvContentType = null;
        _bekrefterFjernFdv = false;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernFdvDokument(ComponentFdvDokument dokument)
    {
        if (_entity is null)
        {
            return;
        }

        var entitet = await Db.ComponentFdvDokumenter.FirstOrDefaultAsync(d => d.Id == dokument.Id);
        if (entitet is not null)
        {
            Db.ComponentFdvDokumenter.Remove(entitet);
            await Db.SaveChangesAsync();
        }

        _fjernerFdvDokumentId = null;
        await OnSaved.InvokeAsync();
    }

    private async Task LastOppMontasjeblad(InputFileChangeEventArgs e)
    {
        if (_entity is null)
        {
            return;
        }

        _filFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _filFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _entity.MontasjebladData = buffer.ToArray();
        _entity.MontasjebladFilnavn = file.Name;
        _entity.MontasjebladContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernMontasjeblad()
    {
        if (_entity is null)
        {
            return;
        }

        _entity.MontasjebladData = null;
        _entity.MontasjebladFilnavn = null;
        _entity.MontasjebladContentType = null;
        _bekrefterFjernMontasjeblad = false;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task LastOppBilde(InputFileChangeEventArgs e)
    {
        if (_entity is null)
        {
            return;
        }

        _filFeil = null;
        var file = e.File;
        if (file.Size > 20_000_000)
        {
            _filFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
            return;
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
        {
            await stream.CopyToAsync(buffer);
        }

        _entity.BildeData = buffer.ToArray();
        _entity.BildeFilnavn = file.Name;
        _entity.BildeContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernBilde()
    {
        if (_entity is null)
        {
            return;
        }

        _entity.BildeData = null;
        _entity.BildeFilnavn = null;
        _entity.BildeContentType = null;
        _bekrefterFjernBilde = false;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private void ApneProduktgruppeVelger()
    {
        if (_entity is null)
        {
            return;
        }

        _valgteProduktgruppeIder = _entity.Produktgrupper.Select(p => p.Id).ToHashSet();
        _visProduktgruppeVelger = true;
    }

    private void LukkProduktgruppeVelger()
    {
        _visProduktgruppeVelger = false;
    }

    private void TogglProduktgruppeValg(int produktgruppeId, bool medlem)
    {
        if (medlem)
        {
            _valgteProduktgruppeIder.Add(produktgruppeId);
        }
        else
        {
            _valgteProduktgruppeIder.Remove(produktgruppeId);
        }
    }

    private async Task LagreProduktgruppeVelger()
    {
        if (_entity is null)
        {
            return;
        }

        _entity.Produktgrupper.RemoveAll(p => !_valgteProduktgruppeIder.Contains(p.Id));
        foreach (var id in _valgteProduktgruppeIder)
        {
            if (_entity.Produktgrupper.All(p => p.Id != id))
            {
                var gruppe = _alleProduktgrupper.FirstOrDefault(p => p.Id == id);
                if (gruppe is not null)
                {
                    _entity.Produktgrupper.Add(gruppe);
                }
            }
        }

        await Db.SaveChangesAsync();
        _visProduktgruppeVelger = false;
        await OnSaved.InvokeAsync();
    }

    // Søker opp om denne leverandøren/varenummer-kombinasjonen allerede
    // finnes på en ANNEN vare i registeret (typisk en vare som bevisst er
    // satt inaktiv fordi den er en duplikat-import av samme produkt fra en
    // annen leverandør, med billigere pris) - fyller da inn Navn/Netto/
    // Veiledende automatisk i stedet for at man må skrive alt på nytt.
    // Ser bevisst IKKE bort fra inaktive varer her - det er ofte akkurat de
    // som har dataene man er ute etter.
    private async Task SokEksisterendeLenke()
    {
        _nyLenkeFunnetHint = null;
        if (_entity is null || _valgtLeverandorId is null || string.IsNullOrWhiteSpace(_nyttVarenummer))
        {
            return;
        }

        var varenummer = _nyttVarenummer.Trim();
        var funnet = await Db.ComponentLeverandorer
            .Include(cl => cl.Component)
            .Where(cl => cl.LeverandorId == _valgtLeverandorId
                && cl.ComponentId != _entity.Id
                && cl.Varenummer != null && cl.Varenummer.Trim().ToLower() == varenummer.ToLower())
            .FirstOrDefaultAsync();

        if (funnet is null)
        {
            return;
        }

        _nyttNavn = funnet.Navn ?? funnet.Component?.Navn ?? _nyttNavn;
        _nyPrisNetto = funnet.PrisNetto;
        _nyPrisVeiledende = funnet.PrisVeiledende;
        _nyLenkeFunnetHint = funnet.Component is null
            ? "Fant eksisterende varenummer hos denne leverandøren - fylt inn automatisk."
            : $"Fant eksisterende varenummer på \"{funnet.Component.Navn}\"{(funnet.Component.Aktiv ? "" : " (inaktiv)")} - fylt inn automatisk.";
    }

    private async Task LeggTilLeverandor()
    {
        _leggTilFeil = null;
        if (_entity is null || _valgtLeverandorId is null)
        {
            _leggTilFeil = "Velg en leverandør.";
            return;
        }

        if (_lenker.Any(l => l.LeverandorId == _valgtLeverandorId))
        {
            _leggTilFeil = "Varen er allerede koblet til denne leverandøren.";
            return;
        }

        Db.ComponentLeverandorer.Add(new ComponentLeverandor
        {
            ComponentId = _entity.Id,
            LeverandorId = _valgtLeverandorId.Value,
            Varenummer = string.IsNullOrWhiteSpace(_nyttVarenummer) ? null : _nyttVarenummer.Trim(),
            Navn = string.IsNullOrWhiteSpace(_nyttNavn) ? null : _nyttNavn.Trim(),
            PrisNetto = _nyPrisNetto,
            PrisVeiledende = _nyPrisVeiledende,
            ErStandard = _lenker.Count == 0
        });
        await Db.SaveChangesAsync();

        _valgtLeverandorId = null;
        _nyttVarenummer = "";
        _nyttNavn = _entity.Navn;
        _nyLenkeFunnetHint = null;
        _nyPrisNetto = null;
        _nyPrisVeiledende = null;
        _visNyLenkeRad = false;
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == _entity.Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.Navn = string.IsNullOrWhiteSpace(rad.Navn) ? null : rad.Navn.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            await LeverandorSync.SettStandardAsync(Db, _entity.Id, rad.LeverandorId);
            await Db.SaveChangesAsync();
        }
        await OnSaved.InvokeAsync();
    }

    private async Task SettStandard(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        await LeverandorSync.SettStandardAsync(Db, _entity.Id, rad.LeverandorId);
        await Db.SaveChangesAsync();
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == _entity.Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        _fjernerLeverandorId = null;
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task Lukk()
    {
        await OnClose.InvokeAsync();
    }
}
