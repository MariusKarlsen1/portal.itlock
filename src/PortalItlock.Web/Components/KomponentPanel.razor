    private async Task LastOppFdv(InputFileChangeEventArgs e)
    {
        if (_entity is null)
        {
            return;
        }

        _filFeil = null;
        foreach (var file in e.GetMultipleFiles(50))
        {
            if (file.Size > 20_000_000)
            {
                _filFeil = $"\"{file.Name}\" er for stor (maks 20 MB).";
                continue;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxAllowedSize: 20_000_000))
            {
                await stream.CopyToAsync(buffer);
            }

            var innhold = buffer.ToArray();
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;

            // Hoveddokumentet (FdvData) fylles først - alt deretter blir egne,
            // ekstra dokumenter, siden en vare kan ha flere.
            if (_entity.FdvData is null)
            {
                _entity.FdvData = innhold;
                _entity.FdvFilnavn = file.Name;
                _entity.FdvContentType = contentType;
            }
            else
            {
                Db.ComponentFdvDokumenter.Add(new ComponentFdvDokument
                {
                    ComponentId = _entity.Id,
                    Filnavn = file.Name,
                    ContentType = contentType,
                    Data = innhold
                });
            }
        }

        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernFdv()
