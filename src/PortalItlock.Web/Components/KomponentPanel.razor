    private void LukkProduktgruppeVelger()
    {
        _visProduktgruppeVelger = false;
    }

    private void TogglProduktgruppeValg(int produktgruppeId, bool medlem)
    {
        if (medlem)
        {
            _valgteProduktgruppeIder.Add(produktgruppeId);
        }
        else
        {
            _valgteProduktgruppeIder.Remove(produktgruppeId);
        }
    }

    private async Task LagreProduktgruppeVelger()
    {
        if (_entity is null)
        {
            return;
        }

        _entity.Produktgrupper.RemoveAll(p => !_valgteProduktgruppeIder.Contains(p.Id));
        foreach (var id in _valgteProduktgruppeIder)
        {
            if (_entity.Produktgrupper.All(p => p.Id != id))
            {
                var gruppe = _alleProduktgrupper.FirstOrDefault(p => p.Id == id);
                if (gruppe is not null)
                {
                    _entity.Produktgrupper.Add(gruppe);
                }
            }
        }

        await Db.SaveChangesAsync();
        _visProduktgruppeVelger = false;
        await OnSaved.InvokeAsync();
    }

    // Søker opp om denne leverandøren/varenummer-kombinasjonen allerede
    // finnes på en ANNEN vare i registeret (typisk en vare som bevisst er
    // satt inaktiv fordi den er en duplikat-import av samme produkt fra en
    // annen leverandør, med billigere pris) - fyller da inn Navn/Netto/
    // Veiledende automatisk i stedet for at man må skrive alt på nytt.
    // Ser bevisst IKKE bort fra inaktive varer her - det er ofte akkurat de
    // som har dataene man er ute etter.
    private async Task SokEksisterendeLenke()
    {
        _nyLenkeFunnetHint = null;
        if (_entity is null || _valgtLeverandorId is null || string.IsNullOrWhiteSpace(_nyttVarenummer))
        {
            return;
        }

        var varenummer = _nyttVarenummer.Trim();
        var funnet = await Db.ComponentLeverandorer
            .Include(cl => cl.Component)
            .Where(cl => cl.LeverandorId == _valgtLeverandorId
                && cl.ComponentId != _entity.Id
                && cl.Varenummer != null && cl.Varenummer.Trim().ToLower() == varenummer.ToLower())
            .FirstOrDefaultAsync();

        if (funnet is null)
        {
            return;
        }

        _nyttNavn = funnet.Navn ?? funnet.Component?.Navn ?? _nyttNavn;
        _nyPrisNetto = funnet.PrisNetto;
        _nyPrisVeiledende = funnet.PrisVeiledende;
        _nyLenkeFunnetHint = funnet.Component is null
            ? "Fant eksisterende varenummer hos denne leverandøren - fylt inn automatisk."
            : $"Fant eksisterende varenummer på \"{funnet.Component.Navn}\"{(funnet.Component.Aktiv ? "" : " (inaktiv)")} - fylt inn automatisk.";
    }

    private async Task LeggTilLeverandor()
    {
        _leggTilFeil = null;
        if (_entity is null || _valgtLeverandorId is null)
        {
            _leggTilFeil = "Velg en leverandør.";
            return;
        }

        if (_lenker.Any(l => l.LeverandorId == _valgtLeverandorId))
        {
            _leggTilFeil = "Varen er allerede koblet til denne leverandøren.";
            return;
        }

        Db.ComponentLeverandorer.Add(new ComponentLeverandor
        {
            ComponentId = _entity.Id,
            LeverandorId = _valgtLeverandorId.Value,
            Varenummer = string.IsNullOrWhiteSpace(_nyttVarenummer) ? null : _nyttVarenummer.Trim(),
            Navn = string.IsNullOrWhiteSpace(_nyttNavn) ? null : _nyttNavn.Trim(),
            PrisNetto = _nyPrisNetto,
            PrisVeiledende = _nyPrisVeiledende,
            ErStandard = _lenker.Count == 0
        });
        await Db.SaveChangesAsync();

        _valgtLeverandorId = null;
        _nyttVarenummer = "";
        _nyttNavn = _entity.Navn;
        _nyLenkeFunnetHint = null;
        _nyPrisNetto = null;
        _nyPrisVeiledende = null;
        _visNyLenkeRad = false;
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task LagreLenke(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == _entity.Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        entitet.Varenummer = string.IsNullOrWhiteSpace(rad.Varenummer) ? null : rad.Varenummer.Trim();
        entitet.Navn = string.IsNullOrWhiteSpace(rad.Navn) ? null : rad.Navn.Trim();
        entitet.PrisNetto = rad.PrisNetto;
        entitet.PrisVeiledende = rad.PrisVeiledende;
        await Db.SaveChangesAsync();

        if (rad.ErStandard)
        {
            await LeverandorSync.SettStandardAsync(Db, _entity.Id, rad.LeverandorId);
            await Db.SaveChangesAsync();
        }
        await OnSaved.InvokeAsync();
    }

    private async Task SettStandard(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        await LeverandorSync.SettStandardAsync(Db, _entity.Id, rad.LeverandorId);
        await Db.SaveChangesAsync();
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task FjernLenke(LenkeRad rad)
    {
        if (_entity is null)
        {
            return;
        }

        var entitet = await Db.ComponentLeverandorer
            .FirstOrDefaultAsync(cl => cl.ComponentId == _entity.Id && cl.LeverandorId == rad.LeverandorId);
        if (entitet is null)
        {
            return;
        }

        Db.ComponentLeverandorer.Remove(entitet);
        await Db.SaveChangesAsync();
        _fjernerLeverandorId = null;
        await LastLenkerAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task Lukk()
    {
        await OnClose.InvokeAsync();
    }
}
