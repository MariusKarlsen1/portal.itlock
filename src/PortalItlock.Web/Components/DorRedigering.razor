@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject TilbudSyncService TilbudSync

@if (ErMobilvisning)
{
    <div class="dor-panel mobil-dor-panel">
        <div class="mobil-dor-topp">
            <button type="button" class="mobil-dor-tilbake" @onclick="Close"><Icon Name="arrow-left" /></button>
            <span class="mobil-dor-tittel">@Dor.Dornummer</span>
        </div>

        <div class="mobil-dor-faner">
            <button type="button" class="mobil-dor-fane @(_mobilFane == "detaljer" ? "aktiv" : "")" @onclick="@(() => _mobilFane = "detaljer")">Detaljer</button>
            <button type="button" class="mobil-dor-fane @(_mobilFane == "beslag" ? "aktiv" : "")" @onclick="@(() => _mobilFane = "beslag")">Beslag</button>
            <button type="button" class="mobil-dor-fane @(_mobilFane == "avvik" ? "aktiv" : "")" @onclick="@(() => _mobilFane = "avvik")">Avvik</button>
            <button type="button" class="mobil-dor-fane @(_mobilFane == "lassystem" ? "aktiv" : "")" @onclick="@(() => _mobilFane = "lassystem")">Låssystem</button>
        </div>

        @if (_mobilFane == "detaljer")
        {
            <div class="mobil-dor-innhold">
                <p class="mobil-dor-gruppetittel">Tegninger:</p>
                @if (Dor.PlantegningId.HasValue)
                {
                    <a class="mobil-dor-lenkekort" href="@($"/plantegning/{Dor.PlantegningId}")">
                        <Icon Name="map" /> <span>Plantegning</span>
                        <span class="mobil-dor-lenkekort-pil"><Icon Name="chevron-down" /></span>
                    </a>
                }
                else
                {
                    <p class="list-empty">Ikke plassert på noen tegning.</p>
                }

                <p class="mobil-dor-gruppetittel">Dørdetaljer:</p>
                <div class="mobil-dor-kort-liste">
                    <div class="mobil-dor-rad"><span>Dør ID</span><span>@(Dor.DorIdMal?.Kode ?? "-")</span></div>
                    <div class="mobil-dor-rad"><span>Dørnummer</span><span>@Dor.Dornummer</span></div>
                    <div class="mobil-dor-rad"><span>Dør til</span><span>@(Dor.DorTil ?? "-")</span></div>
                    <div class="mobil-dor-rad"><span>Etasje</span><span>@(Dor.Etasje ?? "-")</span></div>
                    <div class="mobil-dor-rad">
                        <span>Dørfunk.</span>
                        <span>
                            @if (Dor.Funksjoner.Count == 0)
                            {
                                <text>-</text>
                            }
                            else
                            {
                                @string.Join(", ", Dor.Funksjoner.Select(f => f.Navn))
                            }
                        </span>
                    </div>
                    <div class="mobil-dor-rad"><span>Sone</span><span>@(Dor.Sone ?? "-")</span></div>
                    <div class="mobil-dor-rad">
                        <span>Status</span>
                        <span><StatusPill Tekst="@Dor.Status.Visningsnavn()" Ikon="@Dor.Status.PillIkon()" Farge="@Dor.Status.PillFarge()" /></span>
                    </div>
                </div>
            </div>
        }
        else if (_mobilFane == "beslag")
        {
            <div class="mobil-dor-innhold">
                <p class="mobil-dor-gruppetittel">Tegninger:</p>
                @if (Dor.PlantegningId.HasValue)
                {
                    <a class="mobil-dor-lenkekort" href="@($"/plantegning/{Dor.PlantegningId}")">
                        <Icon Name="map" /> <span>Plantegning</span>
                        <span class="mobil-dor-lenkekort-pil"><Icon Name="chevron-down" /></span>
                    </a>
                }
                else
                {
                    <p class="list-empty">Ikke plassert på noen tegning.</p>
                }

                <p class="mobil-dor-gruppetittel">Beslagsliste:</p>
                @if (Dor.Komponenter.Count == 0)
                {
                    <p class="list-empty">Ingen beslag lagt til ennå.</p>
                }
                else
                {
                    <div class="mobil-beslag-liste">
                        @foreach (var dk in Dor.Komponenter)
                        {
                            <div @key="dk.ComponentId" class="mobil-beslag-kort">
                                <button type="button" class="mobil-beslag-montert-knapp @(dk.Montert ? "montert" : "")" title="@(dk.Montert ? "Montert - trykk for å angre" : "Ikke montert - trykk for å markere som montert")" @onclick="@(() => ToggleBeslagMontert(dk))">
                                    @if (dk.Montert)
                                    {
                                        <Icon Name="check-circle" />
                                    }
                                </button>
                                <button type="button" class="mobil-beslag-info" @onclick="@(() => _mobilValgtBeslag = dk)">
                                    <span class="mobil-beslag-navn">@dk.Component?.Navn</span>
                                    <span class="mobil-beslag-meta">@dk.Antall @dk.Enhet@(dk.Plassering.HasValue ? $" · {dk.Plassering}" : "")</span>
                                </button>
                                <span class="mobil-beslag-kode">@(dk.Component?.Produktkode ?? "")</span>
                                <button type="button" class="mobil-dor-lenkekort-pil" @onclick="@(() => _mobilValgtBeslag = dk)"><Icon Name="chevron-down" /></button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_mobilValgtBeslag is not null)
            {
                <div class="mobil-beslag-detalj-overlay" @onclick="@(() => _mobilValgtBeslag = null)">
                    <div class="mobil-beslag-detalj-panel" @onclick:stopPropagation="true">
                        <div class="mobil-dor-topp">
                            <button type="button" class="mobil-dor-tilbake" @onclick="@(() => _mobilValgtBeslag = null)"><Icon Name="arrow-left" /></button>
                            <span class="mobil-dor-tittel">@_mobilValgtBeslag.Component?.Navn</span>
                        </div>
                        <div class="mobil-dor-innhold">
                            <p class="mobil-dor-gruppetittel">Dørmonteringsdetaljer:</p>
                            <div class="mobil-dor-kort-liste">
                                <div class="mobil-dor-rad"><span>Beskrivelse</span><span>@(_mobilValgtBeslag.Component?.Produktkode ?? _mobilValgtBeslag.Component?.Beskrivelse ?? "-")</span></div>
                                <div class="mobil-dor-rad"><span>Dørnummer</span><span>@Dor.Dornummer</span></div>
                                <div class="mobil-dor-rad"><span>Plantegning</span><span>@(Dor.Plantegning?.Navn ?? "-")</span></div>
                                <div class="mobil-dor-rad"><span>Overflate</span><span>@(_mobilValgtBeslag.Component?.Overflate ?? "-")</span></div>
                                <div class="mobil-dor-rad"><span>Antall</span><span>@_mobilValgtBeslag.Antall</span></div>
                                <div class="mobil-dor-rad"><span>Enhet</span><span>@(_mobilValgtBeslag.Enhet ?? "-")</span></div>
                                <div class="mobil-dor-rad"><span>Levering</span><span>@_mobilValgtBeslag.LevertAv</span></div>
                                <div class="mobil-dor-rad">
                                    <span>Status</span>
                                    <span>@(_mobilValgtBeslag.Montert ? "Montert" : "Ikke montert")</span>
                                </div>
                                @if (_mobilValgtBeslag.Montert)
                                {
                                    <div class="mobil-dor-rad"><span>Ferdigstilt av</span><span>@(_mobilValgtBeslag.MontertAvBruker?.Navn ?? "-")</span></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (_mobilFane == "avvik")
        {
            <div class="mobil-dor-innhold">
                @if (_avvikListe.Count == 0 && !_visMobilAvvikForm)
                {
                    <div class="mobil-avvik-tom">
                        <svg class="mobil-tom-figur" viewBox="0 0 110 100" width="110" height="100" xmlns="http://www.w3.org/2000/svg">
                            <rect x="20" y="8" width="70" height="86" rx="4" fill="#ffffff" stroke="#ddd6cb" stroke-width="3" />
                            <line x1="34" y1="28" x2="76" y2="28" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                            <line x1="34" y1="42" x2="76" y2="42" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                            <line x1="34" y1="56" x2="60" y2="56" stroke="#e4e0d5" stroke-width="4" stroke-linecap="round" />
                            <circle cx="55" cy="76" r="15" fill="#2b7a4b" />
                            <path d="M48 76 l5 5 l10 -11" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <p><strong>Ingen avvik rapportert</strong></p>
                    </div>
                }
                else
                {
                    <ul class="avvik-liste">
                        @foreach (var a in _avvikListe)
                        {
                            <li @key="a.Id" class="avvik-kort">
                                <div class="avvik-header">
                                    <span class="avvik-status avvik-status-@a.Status">@a.Status.Visningsnavn()</span>
                                    <span class="avvik-dato">@a.OpprettetDato.ToString("dd.MM.yyyy")</span>
                                </div>
                                <p class="avvik-tekst">@a.Beskrivelse</p>
                            </li>
                        }
                    </ul>
                }

                @if (_visMobilAvvikForm)
                {
                    <div class="mobil-avvik-form">
                        <textarea @bind="_nyAvvikBeskrivelse" @bind:event="oninput" placeholder="Beskriv avviket..." autofocus></textarea>
                        @if (!string.IsNullOrEmpty(_avvikFeil))
                        {
                            <p class="form-error">@_avvikFeil</p>
                        }
                        <div class="mobil-avvik-form-knapper">
                            <button type="button" class="cancel-button" @onclick="@(() => { _visMobilAvvikForm = false; _avvikFeil = null; })">Avbryt</button>
                            <button type="button" class="save-button" @onclick="MeldAvvikMobil">Meld avvik</button>
                        </div>
                    </div>
                }
            </div>

            @if (!_visMobilAvvikForm)
            {
                <button type="button" class="mobil-avvik-fab" title="Meld avvik" @onclick="@(() => _visMobilAvvikForm = true)"><Icon Name="plus" /></button>
            }
        }
        else
        {
            <div class="mobil-dor-innhold">
                @if (_mobilSylinderRader.Count == 0)
                {
                    <p class="list-empty">Ingen låssystem tilknyttet</p>
                }
                else
                {
                    <div class="mobil-dor-kort-liste">
                        @foreach (var rad in _mobilSylinderRader)
                        {
                            <div class="mobil-dor-rad">
                                <span>@rad.Navn</span>
                                <span>@(rad.Nokler.Count > 0 ? string.Join(", ", rad.Nokler) : "Ingen nøkler registrert")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
<div class="dor-panel">
    <div class="dor-panel-header">
        <h2>Dør</h2>
        <div class="dor-panel-header-actions">
            @if (OnVisDorside.HasDelegate)
            {
                <button type="button" class="cancel-button" @onclick="@(() => OnVisDorside.InvokeAsync())">Åpne dørside / QR-kode</button>
            }
            else
            {
                <a class="cancel-button" href="@($"/dor/{Dor.Id}")" target="_blank">Åpne dørside / QR-kode</a>
            }
            <button type="button" class="cancel-button" @onclick="Close">Lukk</button>
        </div>
    </div>

    <div class="klone-felt">
        <label>Klon denne døren, antall <input type="number" min="1" max="50" @bind="_kloneAntall" class="antall-input" /></label>
        <button type="button" class="cancel-button" @onclick="KlonDor">Klon dør</button>
    </div>

    <div class="field-grid">
        <label>Dørnummer<input @bind="Dor.Dornummer" /></label>
        <label>Romnr<input @bind="Dor.Romnr" /></label>
        <label>Dør til<input @bind="Dor.DorTil" placeholder="Rom døren går inn til" /></label>
        <label>Etasje<input @bind="Dor.Etasje" /></label>
        <label>Sone<input @bind="Dor.Sone" /></label>
        <label>Dørtype<input @bind="Dor.Dortype" /></label>
        <label>B x H<input @bind="Dor.BxH" placeholder="F.eks. 1000x2100" /></label>
        <label>Slagretning<input @bind="Dor.Slagretning" /></label>
        <label>Brann<input @bind="Dor.Brann" /></label>
        <label>Lyd<input @bind="Dor.Lyd" /></label>
        <label>
            Energi
            <select @bind="Dor.Energi">
                <option value="">Velg...</option>
                @foreach (var e in CeAlternativer.EnergiKlasser)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </label>
        <label>
            Fri bredde (min 0,86m)
            <select value="@FriBreddeValue(Dor.FriBredde086)" @onchange="@(e => Dor.FriBredde086 = ParseFriBredde(e))">
                <option value="">Ikke satt</option>
                <option value="Ja">Ja</option>
                <option value="Nei">Nei</option>
            </select>
        </label>
        <label>Bredde (mm)<input @bind="Dor.Bredde" /></label>
        <label>Høyde (mm)<input @bind="Dor.Hoyde" /></label>
        <label class="span-2">
            Notater
            <textarea rows="2" @bind="Dor.Notater"></textarea>
        </label>
    </div>

    <div class="dorid-field">
        <span class="status-label">Dør ID</span>
        <div class="dorid-bruk">
            <select @bind="_valgtDorIdMalId">
                <option value="">Velg Dør ID...</option>
                @foreach (var m in _alleDorIdMaler)
                {
                    <option value="@m.Id">@m.Kode</option>
                }
            </select>
            <button type="button" class="add-button" @onclick="BrukDorIdMal" disabled="@(_valgtDorIdMalId is null)">Bruk</button>
        </div>
        @if (Dor.DorIdMalId.HasValue)
        {
            var brukt = _alleDorIdMaler.FirstOrDefault(m => m.Id == Dor.DorIdMalId);
            @if (brukt is not null)
            {
                <span class="dorid-current">Basert på Dør ID: @brukt.Kode</span>
            }
        }
    </div>

    <div class="status-field">
        <span class="status-label">Montasjestatus</span>
        <div class="status-options">
            <label class="status-option status-option-ikke-startet">
                <input type="radio" name="status-@Dor.Id" checked="@(Dor.Status == MontasjeStatus.IkkeStartet)" @onchange="@(() => SettStatus(MontasjeStatus.IkkeStartet))" />
                @MontasjeStatus.IkkeStartet.Visningsnavn()
            </label>
            <label class="status-option status-option-montert">
                <input type="radio" name="status-@Dor.Id" checked="@(Dor.Status == MontasjeStatus.Montert)" @onchange="@(() => SettStatus(MontasjeStatus.Montert))" />
                @MontasjeStatus.Montert.Visningsnavn()
            </label>
            <label class="status-option status-option-ferdig">
                <input type="radio" name="status-@Dor.Id" checked="@(Dor.Status == MontasjeStatus.FerdigMontert)" @onchange="@(() => SettStatus(MontasjeStatus.FerdigMontert))" />
                @MontasjeStatus.FerdigMontert.Visningsnavn()
            </label>
        </div>
        @if (Dor.MontertDato.HasValue)
        {
            <span class="montert-dato">
                Ferdigstilt @Dor.MontertDato.Value.ToString("dd.MM.yyyy HH:mm")
                @(Dor.MontertAvBruker is not null ? $"({Dor.MontertAvBruker.Initialer})" : "")
            </span>
        }
        <div class="garanti-felt">
            <span class="status-label">Garanti</span>
            @if (ProsjektOverlevertDato is null)
            {
                <span class="garanti-info">Nedtelling starter når prosjektet settes til "Overlevert"</span>
            }
            else if (_garantiLinjer.Count == 0)
            {
                <span class="garanti-info">Ingen beslag med registrert garantitid på produktet</span>
            }
            else
            {
                <ul class="garanti-liste">
                    @foreach (var linje in _garantiLinjer)
                    {
                        <li>
                            @linje.ComponentNavn
                            @if (linje.UtlopsDato.HasValue)
                            {
                                <span class="@(linje.UtlopsDato.Value.Date < DateTime.Today ? "garanti-utlopt" : "garanti-ok")">
                                    @(linje.UtlopsDato.Value.Date < DateTime.Today ? $"Utløp {linje.UtlopsDato.Value:dd.MM.yyyy}" : $"Til {linje.UtlopsDato.Value:dd.MM.yyyy}")
                                </span>
                            }
                            else
                            {
                                <span class="garanti-info">Ingen garantitid satt på produktet</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="funksjon-field">
        <span class="status-label">Dørfunksjoner</span>
        <div class="funksjon-legg-til">
            <select @bind="_valgtFunksjonId">
                <option value="">Velg dørfunksjon...</option>
                @foreach (var f in _ledigeFunksjoner)
                {
                    <option value="@f.Id">@f.Navn</option>
                }
            </select>
            <button type="button" class="add-button" @onclick="LeggTilFunksjon" disabled="@(_valgtFunksjonId is null)">Legg til</button>
        </div>

        @if (Dor.Funksjoner.Count > 0)
        {
            <ul class="funksjon-chip-list">
                @foreach (var f in Dor.Funksjoner)
                {
                    <li @key="f.Id" class="funksjon-chip">
                        @f.Navn
                        <button type="button" @onclick="@(() => FjernFunksjon(f))">&times;</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="list-empty">Ingen dørfunksjoner lagt til.</p>
        }
    </div>

    <h3>Beslag</h3>

    <div class="component-search">
        <label>
            Søk i komponentregisteret
            <input @bind="_componentSearch" @bind:event="oninput" @bind:after="OnComponentSearchChanged" placeholder="Søk på navn, leverandør eller produktkode" />
        </label>

        @if (_searchResults.Count > 0)
        {
            <ul class="search-results">
                @foreach (var r in _searchResults)
                {
                    <li>
                        <button type="button" class="search-result" @onclick="@(() => AddFromSearch(r))">
                            <span class="search-result-name">@r.Navn</span>
                            <span class="search-result-meta">@r.Leverandor</span>
                        </button>
                    </li>
                }
            </ul>
        }
        else if (_componentSearch.Trim().Length >= 2)
        {
            <p class="search-empty">Ingen treff.</p>
        }

        @if (!_visEgendefinert)
        {
            <button type="button" class="egendefinert-toggle" @onclick="@(() => _visEgendefinert = true)">+ Legg til egendefinert vare (ikke i registeret)</button>
        }
        else
        {
            <div class="egendefinert-rad">
                <input @bind="_egendefinertNavn" @bind:event="oninput" placeholder="Navn på vare, f.eks. gammel låskasse" />
                <input @bind="_egendefinertEnhet" @bind:event="oninput" placeholder="Enhet (valgfritt)" class="egendefinert-enhet" />
                <button type="button" class="add-button" @onclick="LeggTilEgendefinert" disabled="@string.IsNullOrWhiteSpace(_egendefinertNavn)">Legg til</button>
                <button type="button" class="cancel-button" @onclick="@(() => _visEgendefinert = false)">Avbryt</button>
            </div>
        }
    </div>

    <div class="pakke-legg-til">
        <select @bind="_valgtPakkeId">
            <option value="">Velg pakke...</option>
            @foreach (var p in _pakker)
            {
                <option value="@p.Id" title="@p.Innhold">@p.Navn</option>
            }
        </select>
        <button type="button" class="add-button" @onclick="LeggTilPakke" disabled="@(_valgtPakkeId is null)">Legg til pakke</button>
    </div>
    @if (_valgtPakkeId is not null)
    {
        var valgtPakke = _pakker.FirstOrDefault(p => p.Id == _valgtPakkeId);
        if (valgtPakke is not null && !string.IsNullOrEmpty(valgtPakke.Innhold))
        {
            <p class="pakke-forhandsvisning">Innhold: @valgtPakke.Innhold</p>
        }
    }

    @if (Dor.Komponenter.Count > 0)
    {
        <table class="linje-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Navn</th>
                    <th>Antall</th>
                    <th>Enhet</th>
                    <th>Plassering</th>
                    <th>Levert av</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dk in Dor.Komponenter)
                {
                    <tr @key="dk.ComponentId">
                        <td><input type="checkbox" checked="@_valgteBeslagComponentIds.Contains(dk.ComponentId)" @onchange="@(() => ToggleBeslagValg(dk.ComponentId))" /></td>
                        <td>@dk.Component?.Navn</td>
                        <td><input class="antall-input" @bind="dk.Antall" /></td>
                        <td><input class="enhet-input" @bind="dk.Enhet" placeholder="stk" /></td>
                        <td>
                            <select @bind="dk.Plassering">
                                <option value="">-</option>
                                <option value="@DorKomponentPlassering.Hengselside">H</option>
                                <option value="@DorKomponentPlassering.Karmside">K</option>
                            </select>
                        </td>
                        <td>
                            <select @bind="dk.LevertAv" title="@dk.LevertAv.Forklaring()">
                                <option value="@LevertAv.F">F</option>
                                <option value="@LevertAv.Ld">Ld</option>
                                <option value="@LevertAv.Le">Le</option>
                            </select>
                        </td>
                        <td>
                            <button type="button" class="beslag-status @(dk.Montert ? "beslag-status-montert" : "beslag-status-ikke-montert")" @onclick="@(() => ToggleBeslagMontert(dk))">
                                @if (dk.Montert)
                                {
                                    <text>Montert @(dk.MontertDato?.ToString("dd.MM.yyyy HH:mm")) @(dk.MontertAvBruker is not null ? $"({dk.MontertAvBruker.Initialer})" : "")</text>
                                }
                                else
                                {
                                    <text>Ikke montert</text>
                                }
                            </button>
                        </td>
                        <td><button type="button" class="remove-button" @onclick="@(() => RemoveKomponent(dk))">Fjern</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="kopier-beslag-felt">
            <button type="button" class="cancel-button" disabled="@(_valgteBeslagComponentIds.Count == 0)" @onclick="@(() => _visKopierPanel = !_visKopierPanel)">
                Kopier valgte beslag til andre dører
            </button>
        </div>

        @if (_visKopierPanel)
        {
            <div class="kopier-panel">
                <p class="section-hint">Velg hvilke dører beslaget skal kopieres til.</p>
                @if (AndreDorer.Count == 0)
                {
                    <p class="list-empty">Ingen andre dører i prosjektet.</p>
                }
                else
                {
                    <ul class="kopier-dor-liste">
                        @foreach (var d in AndreDorer)
                        {
                            <li @key="d.Id">
                                <label>
                                    <input type="checkbox" checked="@_valgteMalDorIds.Contains(d.Id)" @onchange="@(() => ToggleMalDor(d.Id))" />
                                    @d.Dornummer
                                </label>
                            </li>
                        }
                    </ul>
                }
                <div class="kopier-panel-actions">
                    <button type="button" class="save-button" disabled="@(_valgteMalDorIds.Count == 0)" @onclick="KopierBeslagTilValgteDorer">Kopier</button>
                    <button type="button" class="cancel-button" @onclick="@(() => _visKopierPanel = false)">Avbryt</button>
                </div>
            </div>
        }
    }
    else
    {
        <p class="list-empty">Ingen beslag lagt til ennå.</p>
    }

    <h3>Avvik</h3>
    <div class="meld-avvik-rad">
        <input @bind="_nyAvvikBeskrivelse" @bind:event="oninput" placeholder="Beskriv avviket..." />
        <button type="button" class="add-button" @onclick="MeldAvvik" disabled="@string.IsNullOrWhiteSpace(_nyAvvikBeskrivelse)">Meld avvik</button>
    </div>
    @if (!string.IsNullOrEmpty(_avvikFeil))
    {
        <p class="form-error">@_avvikFeil</p>
    }
    @if (_avvikListe.Count == 0)
    {
        <p class="list-empty">Ingen avvik registrert på denne døren.</p>
    }
    else
    {
        <ul class="avvik-liste">
            @foreach (var a in _avvikListe)
            {
                <li @key="a.Id" class="avvik-kort">
                    <div class="avvik-header">
                        <span class="avvik-status avvik-status-@a.Status">@a.Status.Visningsnavn()</span>
                        <span class="avvik-dato">@a.OpprettetDato.ToString("dd.MM.yyyy")</span>
                    </div>
                    <p class="avvik-tekst">@a.Beskrivelse</p>
                </li>
            }
        </ul>
    }

    @if (!string.IsNullOrEmpty(_savedMessage))
    {
        <p class="save-success">@_savedMessage</p>
    }

    <div class="form-actions">
        <button type="button" class="save-button" @onclick="LagreDor">Lagre dør</button>

        @if (Dor.PlantegningId.HasValue)
        {
            <button type="button" class="cancel-button" @onclick="FjernFraTegning">Fjern fra tegning</button>
        }

        @if (_confirmingDelete)
        {
            <span class="delete-confirm">
                Er du sikker?
                <button type="button" class="delete-confirm-button" @onclick="SlettDor">Ja, slett</button>
                <button type="button" class="cancel-button" @onclick="@(() => _confirmingDelete = false)">Avbryt</button>
            </span>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="@(() => _confirmingDelete = true)">Slett dør</button>
        }
    </div>
</div>
}

@code {
    [Parameter, EditorRequired] public Dor Dor { get; set; } = null!;
    [Parameter] public List<Dor> AlleDorer { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnUnplaced { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback<List<Dor>> OnCloned { get; set; }

    // Satt når døren vises i popup-vinduet på plantegningen - da skal "Åpne dørside" vise
    // dørsiden inni samme popup (via denne callbacken) i stedet for å åpne en ny fane, som er
    // standard oppførsel når døren vises i det vanlige sidepanelet.
    [Parameter] public EventCallback OnVisDorside { get; set; }

    // Prosjektets overleveringsdato - garantien for beslagene på denne døren regnes fra
    // denne datoen (satt av den kallende siden, siden Dor selv ikke laster Prosjekt-navigasjonen).
    [Parameter] public DateTime? ProsjektOverlevertDato { get; set; }

    // Satt av den kallende siden (ProsjektSkjema/PlantegningVisning har allerede avgjort dette
    // selv - se MobilDeteksjon.cs) - på mobil vises en helt egen, forenklet fane-visning i stedet
    // for hele skrivebords-redigeringsskjemaet, siden montører kun skal se info + hooke av
    // montert/melde avvik, ikke redigere dørfelt, legge til/fjerne beslag eller klone dører.
    [Parameter] public bool ErMobilvisning { get; set; }

    private string _mobilFane = "beslag";
    private DorKomponent? _mobilValgtBeslag;
    private List<MobilSylinderRad> _mobilSylinderRader = [];

    private sealed class MobilSylinderRad
    {
        public required string Navn { get; set; }
        public List<string> Nokler { get; set; } = [];
    }

    private List<GarantiBeregning.GarantiLinje> _garantiLinjer =>
        GarantiBeregning.Linjer(Dor, ProsjektOverlevertDato);

    private int _kloneAntall = 1;
    private HashSet<int> _valgteBeslagComponentIds = [];
    private HashSet<int> _valgteMalDorIds = [];
    private bool _visKopierPanel;

    private List<Avvik> _avvikListe = [];
    private string _nyAvvikBeskrivelse = "";
    private string? _avvikFeil;
    private int? _avvikLastetForDorId;
    private bool _visMobilAvvikForm;

    private List<Dor> AndreDorer => AlleDorer.Where(d => d.Id != Dor.Id).OrderBy(d => d.Dornummer).ToList();

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int? _naverendeBrukerId;
    private Bruker? _naverendeBruker;

    private sealed class SearchResult
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string? Leverandor { get; set; }
    }

    private sealed class PakkeOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
        public string Innhold { get; set; } = "";
    }

    private sealed class FunksjonOption
    {
        public int Id { get; set; }
        public string Navn { get; set; } = "";
    }

    private List<PakkeOption> _pakker = [];
    private int? _valgtPakkeId;
    private string _componentSearch = "";
    private List<SearchResult> _searchResults = [];
    private bool _confirmingDelete;
    private string? _savedMessage;
    private List<FunksjonOption> _alleFunksjoner = [];
    private int? _valgtFunksjonId;
    private List<DorIdMal> _alleDorIdMaler = [];
    private int? _valgtDorIdMalId;

    private List<FunksjonOption> _ledigeFunksjoner =>
        _alleFunksjoner.Where(f => Dor.Funksjoner.All(df => df.Id != f.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _pakker = await Db.Packages
            .Include(p => p.Komponenter).ThenInclude(pc => pc.Component)
            .OrderBy(p => p.Navn)
            .Select(p => new PakkeOption
            {
                Id = p.Id,
                Navn = p.Navn,
                Innhold = string.Join(", ", p.Komponenter
                    .OrderBy(pc => pc.Component!.Navn)
                    .Select(pc => pc.Antall > 1 ? $"{pc.Component!.Navn} x{pc.Antall}" : pc.Component!.Navn))
            })
            .ToListAsync();

        _alleFunksjoner = await Db.DorFunksjoner
            .OrderBy(f => f.Navn)
            .Select(f => new FunksjonOption { Id = f.Id, Navn = f.Navn })
            .ToListAsync();

        _alleDorIdMaler = await Db.DorIdMaler
            .Where(m => m.ProsjektId == Dor.ProsjektId)
            .OrderBy(m => m.Kode)
            .ToListAsync();

        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            var claim = state.User.FindFirst("BrukerId")?.Value;
            if (claim is not null && int.TryParse(claim, out var id))
            {
                _naverendeBruker = await Db.Brukere.FindAsync(id);
                _naverendeBrukerId = _naverendeBruker?.Id;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_avvikLastetForDorId == Dor.Id)
        {
            return;
        }

        _avvikLastetForDorId = Dor.Id;
        _nyAvvikBeskrivelse = "";
        _avvikFeil = null;
        _mobilFane = "beslag";
        _mobilValgtBeslag = null;
        _avvikListe = await Db.Avvik
            .Where(a => a.DorId == Dor.Id)
            .OrderByDescending(a => a.OpprettetDato)
            .ToListAsync();

        if (ErMobilvisning)
        {
            var sylinderComponentIder = Dor.Komponenter
                .Where(k => k.Component?.ErSylinder == true)
                .Select(k => k.ComponentId)
                .ToList();

            var krysser = sylinderComponentIder.Count == 0
                ? []
                : await Db.NokkelSylindere
                    .Where(ns => ns.DorId == Dor.Id && sylinderComponentIder.Contains(ns.ComponentId))
                    .Include(ns => ns.Nokkel)
                    .ToListAsync();

            _mobilSylinderRader = Dor.Komponenter
                .Where(k => k.Component?.ErSylinder == true)
                .Select(k => new MobilSylinderRad
                {
                    Navn = k.Component!.Navn,
                    Nokler = krysser.Where(ns => ns.ComponentId == k.ComponentId)
                        .Select(ns => ns.Nokkel!.Merking ?? ns.Nokkel!.Navn)
                        .ToList()
                })
                .ToList();
        }
    }

    private async Task MeldAvvik()
    {
        _avvikFeil = null;
        var tekst = _nyAvvikBeskrivelse.Trim();
        if (tekst.Length == 0)
        {
            _avvikFeil = "Skriv en beskrivelse av avviket.";
            return;
        }

        var avvik = new Avvik
        {
            DorId = Dor.Id,
            Beskrivelse = tekst,
            OpprettetAvBrukerId = _naverendeBrukerId
        };
        Db.Avvik.Add(avvik);
        await Db.SaveChangesAsync();

        _avvikListe.Insert(0, avvik);
        _nyAvvikBeskrivelse = "";
    }

    private async Task MeldAvvikMobil()
    {
        await MeldAvvik();
        if (string.IsNullOrEmpty(_avvikFeil))
        {
            _visMobilAvvikForm = false;
        }
    }

    private static string FriBreddeValue(bool? verdi) => verdi switch
    {
        true => "Ja",
        false => "Nei",
        null => ""
    };

    private static bool? ParseFriBredde(ChangeEventArgs e) => e.Value?.ToString() switch
    {
        "Ja" => true,
        "Nei" => false,
        _ => null
    };

    private async Task BrukDorIdMal()
    {
        if (_valgtDorIdMalId is null)
        {
            return;
        }

        var mal = _alleDorIdMaler.FirstOrDefault(m => m.Id == _valgtDorIdMalId);
        if (mal is null)
        {
            return;
        }

        Dor.DorIdMalId = mal.Id;
        Dor.Brann = mal.Brann;
        Dor.Lyd = mal.Lyd;
        Dor.FriBredde086 = mal.FriBredde086;
        Dor.Bredde = mal.Bredde;
        Dor.Hoyde = mal.Hoyde;
        if (!string.IsNullOrWhiteSpace(mal.Dortype))
        {
            Dor.Dortype = mal.Dortype;
        }

        await Db.SaveChangesAsync();
        _savedMessage = $"Hentet felt fra Dør ID \"{mal.Kode}\".";
        await OnSaved.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task SettStatus(MontasjeStatus status)
    {
        Dor.Status = status;
        Dor.MontertDato = status == MontasjeStatus.FerdigMontert ? DateTime.Now : null;
        Dor.MontertAvBrukerId = status == MontasjeStatus.FerdigMontert ? _naverendeBrukerId : null;
        Dor.MontertAvBruker = status == MontasjeStatus.FerdigMontert ? _naverendeBruker : null;
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task OnComponentSearchChanged()
    {
        var term = _componentSearch.Trim();
        if (term.Length < 2)
        {
            _searchResults = [];
            return;
        }

        _searchResults = await Db.Components
            .Where(c => c.Aktiv && (
                EF.Functions.Like(c.Navn, $"%{term}%") ||
                (c.Leverandor != null && EF.Functions.Like(c.Leverandor, $"%{term}%")) ||
                (c.Produktkode != null && EF.Functions.Like(c.Produktkode, $"%{term}%"))))
            .OrderBy(c => c.Navn)
            .Take(20)
            .Select(c => new SearchResult { Id = c.Id, Navn = c.Navn, Leverandor = c.Leverandor })
            .ToListAsync();
    }

    private bool _visEgendefinert;
    private string _egendefinertNavn = "";
    private string? _egendefinertEnhet;

    private async Task LeggTilEgendefinert()
    {
        var navn = _egendefinertNavn.Trim();
        if (navn.Length == 0)
        {
            return;
        }

        var component = new Component
        {
            Navn = navn,
            Enhet = string.IsNullOrWhiteSpace(_egendefinertEnhet) ? null : _egendefinertEnhet.Trim(),
            Varegruppe = "Egendefinert",
            Aktiv = true
        };
        Db.Components.Add(component);
        await Db.SaveChangesAsync();

        var dk = new DorKomponent { DorId = Dor.Id, ComponentId = component.Id, Component = component, Antall = 1, Enhet = component.Enhet };
        Dor.Komponenter.Add(dk);
        Db.DorKomponenter.Add(dk);
        LoggHendelse($"La til egendefinert vare {component.Navn}");

        OppdaterStatusFraBeslag();
        await Db.SaveChangesAsync();

        _egendefinertNavn = "";
        _egendefinertEnhet = null;
        _visEgendefinert = false;
        await OnSaved.InvokeAsync();
    }

    private void LoggHendelse(string beskrivelse)
    {
        Db.DorHendelser.Add(new DorHendelse
        {
            DorId = Dor.Id,
            Beskrivelse = beskrivelse,
            UtfortAvBrukerId = _naverendeBrukerId
        });
    }

    private async Task AddFromSearch(SearchResult r)
    {
        var existing = Dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == r.Id);
        if (existing is not null)
        {
            existing.Antall += 1;
            LoggHendelse($"Økte antall på {existing.Component?.Navn ?? r.Navn}");
        }
        else
        {
            var component = await Db.Components.FindAsync(r.Id);
            var dk = new DorKomponent { DorId = Dor.Id, ComponentId = r.Id, Component = component, Antall = 1, Enhet = component?.Enhet };
            Dor.Komponenter.Add(dk);
            Db.DorKomponenter.Add(dk);
            LoggHendelse($"La til {component?.Navn ?? r.Navn}");
        }

        OppdaterStatusFraBeslag();
        await Db.SaveChangesAsync();
        await TilbudSync.SyncSylinderAsync(Dor.ProsjektId, r.Id);
        _componentSearch = "";
        _searchResults = [];
        await OnSaved.InvokeAsync();
    }

    private async Task LeggTilPakke()
    {
        if (_valgtPakkeId is null)
        {
            return;
        }

        var pakke = await Db.Packages
            .Include(p => p.Komponenter).ThenInclude(pc => pc.Component)
            .Include(p => p.DorFunksjoner)
            .FirstOrDefaultAsync(p => p.Id == _valgtPakkeId);

        if (pakke is null)
        {
            return;
        }

        foreach (var pk in pakke.Komponenter)
        {
            var existing = Dor.Komponenter.FirstOrDefault(dk => dk.ComponentId == pk.ComponentId);
            if (existing is not null)
            {
                existing.Antall += pk.Antall;
            }
            else
            {
                var dk = new DorKomponent { DorId = Dor.Id, ComponentId = pk.ComponentId, Component = pk.Component, Antall = pk.Antall, Enhet = pk.Component?.Enhet, LevertAv = pk.LevertAv ?? LevertAv.F };
                Dor.Komponenter.Add(dk);
                Db.DorKomponenter.Add(dk);
            }
        }

        foreach (var funksjon in pakke.DorFunksjoner)
        {
            if (Dor.Funksjoner.All(f => f.Id != funksjon.Id))
            {
                Dor.Funksjoner.Add(funksjon);
            }
        }

        OppdaterStatusFraBeslag();
        LoggHendelse($"La til pakke {pakke.Navn}");
        await Db.SaveChangesAsync();
        foreach (var pk in pakke.Komponenter)
        {
            await TilbudSync.SyncSylinderAsync(Dor.ProsjektId, pk.ComponentId);
        }
        _valgtPakkeId = null;
        await OnSaved.InvokeAsync();
    }

    private async Task LeggTilFunksjon()
    {
        if (_valgtFunksjonId is null)
        {
            return;
        }

        var funksjon = await Db.DorFunksjoner.FindAsync(_valgtFunksjonId);
        if (funksjon is null || Dor.Funksjoner.Any(f => f.Id == funksjon.Id))
        {
            return;
        }

        Dor.Funksjoner.Add(funksjon);
        await Db.SaveChangesAsync();
        _valgtFunksjonId = null;
        await OnSaved.InvokeAsync();
    }

    private async Task FjernFunksjon(DorFunksjon funksjon)
    {
        Dor.Funksjoner.Remove(funksjon);
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task ToggleBeslagMontert(DorKomponent dk)
    {
        dk.Montert = !dk.Montert;
        dk.MontertDato = dk.Montert ? DateTime.Now : null;
        dk.MontertAvBrukerId = dk.Montert ? _naverendeBrukerId : null;
        dk.MontertAvBruker = dk.Montert ? _naverendeBruker : null;
        OppdaterStatusFraBeslag();
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private void OppdaterStatusFraBeslag()
    {
        var antallTotalt = Dor.Komponenter.Sum(k => k.Antall);
        if (antallTotalt == 0)
        {
            return;
        }

        var antallMontert = Dor.Komponenter.Where(k => k.Montert).Sum(k => k.Antall);
        var status = antallMontert == 0
            ? MontasjeStatus.IkkeStartet
            : antallMontert < antallTotalt
                ? MontasjeStatus.Montert
                : MontasjeStatus.FerdigMontert;

        Dor.Status = status;
        Dor.MontertDato = status == MontasjeStatus.FerdigMontert ? DateTime.Now : null;
        Dor.MontertAvBrukerId = status == MontasjeStatus.FerdigMontert ? _naverendeBrukerId : null;
        Dor.MontertAvBruker = status == MontasjeStatus.FerdigMontert ? _naverendeBruker : null;
    }

    private async Task RemoveKomponent(DorKomponent dk)
    {
        LoggHendelse($"Fjernet {dk.Component?.Navn}");
        Db.DorKomponenter.Remove(dk);
        Dor.Komponenter.Remove(dk);
        OppdaterStatusFraBeslag();
        await Db.SaveChangesAsync();
        await OnSaved.InvokeAsync();
    }

    private async Task LagreDor()
    {
        Dor.OppdatertDato = DateTime.Now;
        Dor.OppdatertAvBrukerId = _naverendeBrukerId;
        Dor.OppdatertAvBruker = _naverendeBruker;
        await Db.SaveChangesAsync();
        _savedMessage = $"Døren \"{Dor.Dornummer}\" er lagret.";
        await OnSaved.InvokeAsync();
    }

    private async Task FjernFraTegning()
    {
        Dor.PlantegningId = null;
        Dor.PosX = null;
        Dor.PosY = null;
        await Db.SaveChangesAsync();
        await OnUnplaced.InvokeAsync();
    }

    private async Task SlettDor()
    {
        Db.Dorer.Remove(Dor);
        await Db.SaveChangesAsync();
        _confirmingDelete = false;
        await OnDeleted.InvokeAsync();
    }

    private async Task KlonDor()
    {
        if (_kloneAntall < 1)
        {
            return;
        }

        var nyeDorer = new List<Dor>();
        for (var i = 1; i <= _kloneAntall; i++)
        {
            var kopi = new Dor
            {
                ProsjektId = Dor.ProsjektId,
                Dornummer = $"{Dor.Dornummer} - kopi {i}",
                Romnr = Dor.Romnr,
                DorTil = Dor.DorTil,
                Etasje = Dor.Etasje,
                Sone = Dor.Sone,
                Dortype = Dor.Dortype,
                BxH = Dor.BxH,
                Slagretning = Dor.Slagretning,
                Brann = Dor.Brann,
                Lyd = Dor.Lyd,
                FriBredde086 = Dor.FriBredde086,
                Bredde = Dor.Bredde,
                Hoyde = Dor.Hoyde,
                DorIdMalId = Dor.DorIdMalId,
                Notater = Dor.Notater
            };
            Db.Dorer.Add(kopi);
            nyeDorer.Add(kopi);
        }

        await Db.SaveChangesAsync();

        foreach (var kopi in nyeDorer)
        {
            foreach (var f in Dor.Funksjoner)
            {
                kopi.Funksjoner.Add(f);
            }

            foreach (var dk in Dor.Komponenter)
            {
                var kopiDk = new DorKomponent
                {
                    DorId = kopi.Id,
                    ComponentId = dk.ComponentId,
                    Component = dk.Component,
                    Antall = dk.Antall,
                    Enhet = dk.Enhet,
                    LevertAv = dk.LevertAv
                };
                kopi.Komponenter.Add(kopiDk);
                Db.DorKomponenter.Add(kopiDk);
            }
        }

        await Db.SaveChangesAsync();
        foreach (var componentId in Dor.Komponenter.Select(dk => dk.ComponentId).Distinct())
        {
            await TilbudSync.SyncSylinderAsync(Dor.ProsjektId, componentId);
        }
        _savedMessage = $"{_kloneAntall} kopi(er) av \"{Dor.Dornummer}\" opprettet.";
        await OnCloned.InvokeAsync(nyeDorer);
    }

    private void ToggleBeslagValg(int componentId)
    {
        if (!_valgteBeslagComponentIds.Add(componentId))
        {
            _valgteBeslagComponentIds.Remove(componentId);
        }
    }

    private void ToggleMalDor(int dorId)
    {
        if (!_valgteMalDorIds.Add(dorId))
        {
            _valgteMalDorIds.Remove(dorId);
        }
    }

    private async Task KopierBeslagTilValgteDorer()
    {
        if (_valgteBeslagComponentIds.Count == 0 || _valgteMalDorIds.Count == 0)
        {
            return;
        }

        var kildeKomponenter = Dor.Komponenter.Where(dk => _valgteBeslagComponentIds.Contains(dk.ComponentId)).ToList();

        foreach (var malDorId in _valgteMalDorIds)
        {
            var malDor = AlleDorer.FirstOrDefault(d => d.Id == malDorId);
            if (malDor is null)
            {
                continue;
            }

            foreach (var kilde in kildeKomponenter)
            {
                var funnet = malDor.Komponenter.FirstOrDefault(dk => dk.ComponentId == kilde.ComponentId);
                if (funnet is not null)
                {
                    funnet.Antall += kilde.Antall;
                }
                else
                {
                    var ny = new DorKomponent
                    {
                        DorId = malDorId,
                        ComponentId = kilde.ComponentId,
                        Component = kilde.Component,
                        Antall = kilde.Antall,
                        Enhet = kilde.Enhet,
                        LevertAv = kilde.LevertAv
                    };
                    malDor.Komponenter.Add(ny);
                    Db.DorKomponenter.Add(ny);
                }
            }
        }

        await Db.SaveChangesAsync();
        foreach (var componentId in _valgteBeslagComponentIds)
        {
            await TilbudSync.SyncSylinderAsync(Dor.ProsjektId, componentId);
        }
        _savedMessage = $"Kopierte {_valgteBeslagComponentIds.Count} beslagstype(r) til {_valgteMalDorIds.Count} dør(er).";
        _valgteBeslagComponentIds.Clear();
        _valgteMalDorIds.Clear();
        _visKopierPanel = false;
        await OnSaved.InvokeAsync();
    }
}
