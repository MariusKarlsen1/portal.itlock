@using PortalItlock.Web.Services
@inject TilleggsmodulService Tilleggsmoduler
@inject NavigationManager Nav

@* Sender brukeren til forsiden hvis organisasjonen ikke har tilleggsmodulen
   siden hører til. Menyvalget er skjult fra før (se PortalModul.KreverModul);
   dette stopper den som går rett til adressen. *@

@code {
    [Parameter, EditorRequired] public string Modul { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await Tilleggsmoduler.HarAsync(Modul))
        {
            Nav.NavigateTo("/", replace: true);
        }
    }
}
