<label class="tri-field @(Warn ? "tri-field-warn" : "")">
    @Label
    <select value="@(Value.HasValue ? Value.Value.ToString() : "")" @onchange="OnChange" disabled="@Disabled">
        <option value="">Ikke satt</option>
        <option value="True">Ja</option>
        <option value="False">Nei</option>
    </select>
    @if (Warn)
    {
        <span class="tri-warn-hint">Dette svaret vil ikke bli godkjent</span>
    }
</label>

@code {
    [Parameter, Microsoft.AspNetCore.Components.EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool? Value { get; set; }
    [Parameter] public EventCallback<bool?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Warn { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        var raw = e.Value as string;
        bool? verdi = raw switch { "True" => true, "False" => false, _ => null };
        await ValueChanged.InvokeAsync(verdi);
    }
}
