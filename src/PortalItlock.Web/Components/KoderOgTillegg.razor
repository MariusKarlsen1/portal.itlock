@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using PortalItlock.Web.Data
@using PortalItlock.Web.Models
@using PortalItlock.Web.Services
@inject ApplicationDbContext Db
@inject PrisKodeService PrisKodeSvc
@inject TripletexService Tripletex
@inject TripletexSyncService TripletexSync
@inject PortalItlock.Web.Services.OkonomisystemService Okonomi

@* Koder og tillegg (forslag koder-komponentregister.html): alt som ikke er en vare -
   timer, kjøring, festemateriell og tillegg - gruppert etter type. Kodene er
   varenumrene i Tripletex og kommer opp når man søker på tilbudet. Alt lagres
   med en gang. Endringer gjelder nye linjer; tilbud som er laget, beholder sine priser. *@
<div class="kt">
    <div class="kt-hoved">
        <div class="kt-intro">
            <Icon Name="help-circle" />
            <div>
                <b>Alt som ikke er en vare: timer, kjøring, festemateriell og tillegg</b>
                <span>Kodene kommer opp når du søker på tilbudet, og koden er varenummeret @Okonomi.INavn. Klikk rett i feltene for å endre – alt lagres med en gang. Tilbud som allerede er laget, beholder sine priser.</span>
            </div>
            <span class="kt-intro-knapper">
                @if (Tripletex.ErKonfigurert)
                {
                    <button type="button" class="kt-knapp" @onclick="SynkTripletex" disabled="@_henter" title="Kodene synkes også av seg selv hvert 10. minutt"><Icon Name="download" />@(_henter ? "Synker …" : "Synk med Tripletex")</button>
                }
                <button type="button" class="kt-knapp kt-knapp-p" @onclick="@(() => ApneNy(PrisKodeType.Arbeid))"><Icon Name="plus" />Ny kode</button>
            </span>
        </div>

        @if (!string.IsNullOrEmpty(_melding))
        {
            <p class="kt-melding @(_feil ? "kt-melding-feil" : "")" role="status">
                @_melding
                @if (_angre is not null)
                {
                    <button type="button" class="kt-lenke" @onclick="Angre">Angre</button>
                }
            </p>
        }

        @if (_produkter is not null)
        {
            <section class="kt-gruppe">
                <div class="kt-gh">
                    <span class="kt-gi kt-gi-annet"><Icon Name="download" /></span>
                    <div><b>Produkter i Tripletex</b><small>Velg produktene som skal bli koder. Varenummeret blir koden, og pris og kost hentes med.</small></div>
                    <button type="button" class="kt-ik kt-hoyre" title="Lukk" @onclick="@(() => _produkter = null)"><Icon Name="x" /></button>
                </div>
                @if (_produkter.Count == 0)
                {
                    <p class="kt-tom">Fant ingen aktive produkter med varenummer i Tripletex.</p>
                }
                else
                {
                    <div class="kt-tw">
                        <table class="kt-tab">
                            <thead><tr><th></th><th>Varenummer</th><th>Navn</th><th class="n">Kost</th><th class="n">Salg</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in _produkter)
                                {
                                    var produkt = p;
                                    var finnes = _koder.Any(k => k.Kode == p.Nummer);
                                    <tr class="@(finnes ? "kt-inaktiv" : "")">
                                        <td><input type="checkbox" checked="@_valgte.Contains(p.Nummer)" disabled="@finnes" aria-label="Velg @p.Navn" @onchange="@(e => Velg(produkt.Nummer, e))" /></td>
                                        <td><b>@p.Nummer</b></td>
                                        <td>@p.Navn</td>
                                        <td class="n">@(p.Kostpris?.ToString("N2", Kultur) ?? "–")</td>
                                        <td class="n">@(p.Salgspris?.ToString("N2", Kultur) ?? "–")</td>
                                        <td>@if (finnes) {<span class="kt-pil">Finnes</span>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="kt-gfot"><button type="button" class="kt-knapp kt-knapp-p" disabled="@(_valgte.Count == 0)" @onclick="LeggTilValgte">Legg til @_valgte.Count @(_valgte.Count == 1 ? "kode" : "koder")</button></div>
                }
            </section>
        }

        @if (_lastet && _koder.Count == 0)
        {
            <section class="kt-gruppe kt-tomboks">
                <b>Ingen koder ennå</b>
                <p>Start med standardkodene (montasje, overtid, programmering, prosjektledelse, kjøring, utkjøringstillegg, småmateriell og rigg og drift), eller hent produktene fra Tripletex.</p>
                <span><button type="button" class="kt-knapp kt-knapp-p" @onclick="BrukStandard">Bruk standardkodene</button></span>
            </section>
        }

        @foreach (var g in Grupper)
        {
            var gruppe = g;
            var kk = _koder.Where(k => k.Type == g.Type).ToList();
            if (kk.Count == 0 && g.Type == PrisKodeType.Annet)
            {
                continue;
            }
            var erArbeid = g.Type == PrisKodeType.Arbeid;
            <section class="kt-gruppe">
                <div class="kt-gh">
                    <span class="kt-gi kt-gi-@g.Klasse"><Icon Name="@g.Ikon" /></span>
                    <div><b>@g.Navn</b><small>@g.Forklaring</small></div>
                    <button type="button" class="kt-knapp kt-knapp-s kt-hoyre" @onclick="@(() => ApneNy(gruppe.Type))"><Icon Name="plus" />Legg til</button>
                </div>
                @if (kk.Count == 0)
                {
                    <p class="kt-tom">Ingen koder her ennå.</p>
                }
                else
                {
                    <div class="kt-tw">
                        <table class="kt-tab">
                            <thead>
                                <tr>
                                    <th class="kt-kodek">Kode</th>
                                    <th>Navn</th>
                                    @if (erArbeid)
                                    {
                                        <th title="Lønnstype for timer på koden">Timetype</th>
                                    }
                                    else
                                    {
                                        <th>Enhet</th>
                                    }
                                    <th class="n">Kost</th>
                                    <th class="n">Salg</th>
                                    <th class="n">DG</th>
                                    <th>Vis</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in kk)
                                {
                                    var kode = k;
                                    var prosent = k.Enhet.ErProsent();
                                    var arbeidTime = k.Type == PrisKodeType.Arbeid && k.Enhet == PrisKodeEnhet.Time;
                                    <tr @key="k.Id" class="kt-rad @(k.Aktiv ? "" : "kt-inaktiv")">
                                        <td><input class="kt-inp kt-kode" value="@k.Kode" aria-label="Kode" @onchange="@(e => Endre(kode, x => x.Kode = (e.Value?.ToString() ?? "").Trim(), "Koden"))" /></td>
                                        <td>
                                            <div class="kt-navn">
                                                <input class="kt-inp" value="@k.Navn" aria-label="Navn" @onchange="@(e => Endre(kode, x => x.Navn = (e.Value?.ToString() ?? "").Trim(), "Navnet"))" />
                                                @if (arbeidTime)
                                                {
                                                    <button type="button" class="kt-std @(k.ErMontasje ? "pa" : "")" title="Timene fra varenes montasjetid legges på denne koden" @onclick="@(() => SettMontasje(kode))">@(k.ErMontasje ? "Montasjetid" : "Sett som montasje")</button>
                                                }
                                                @if (k.Type == PrisKodeType.Annet)
                                                {
                                                    <select class="kt-inp kt-sel kt-flytt" aria-label="Flytt til gruppe" @onchange="@(e => Endre(kode, x => x.Type = Enum.Parse<PrisKodeType>(e.Value!.ToString()!), "Gruppen"))">
                                                        <option value="@PrisKodeType.Annet" selected>Flytt til …</option>
                                                        @foreach (var gg in Grupper.Where(gg => gg.Type != PrisKodeType.Annet))
                                                        {
                                                            <option value="@gg.Type">@gg.Kort</option>
                                                        }
                                                    </select>
                                                }
                                                @if (!k.Aktiv)
                                                {
                                                    <span class="kt-pil">Inaktiv</span>
                                                }
                                            </div>
                                        </td>
                                        @if (erArbeid)
                                        {
                                            <td>
                                                @if (arbeidTime)
                                                {
                                                    <select class="kt-inp kt-sel" aria-label="Timetype" @onchange="@(e => Endre(kode, x => x.Timetype = Enum.Parse<TimeregistreringType>(e.Value!.ToString()!), "Timetypen"))">
                                                        @foreach (var tt in Timetyper)
                                                        {
                                                            <option value="@tt" selected="@(tt == k.Timetype)">@tt.Visningsnavn()</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <select class="kt-inp kt-sel" aria-label="Enhet" @onchange="@(e => Endre(kode, x => x.Enhet = Enum.Parse<PrisKodeEnhet>(e.Value!.ToString()!), "Enheten"))">
                                                        @foreach (var en in Enum.GetValues<PrisKodeEnhet>())
                                                        {
                                                            <option value="@en" selected="@(en == k.Enhet)">@en.Navn()</option>
                                                        }
                                                    </select>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <select class="kt-inp kt-sel" aria-label="Enhet" @onchange="@(e => Endre(kode, x => x.Enhet = Enum.Parse<PrisKodeEnhet>(e.Value!.ToString()!), "Enheten"))">
                                                    @foreach (var en in Enum.GetValues<PrisKodeEnhet>())
                                                    {
                                                        <option value="@en" selected="@(en == k.Enhet)">@en.Navn()</option>
                                                    }
                                                </select>
                                            </td>
                                        }
                                        <td class="n"><span class="kt-med">@if (!prosent) {<input class="kt-inp kt-tall" inputmode="decimal" value="@k.Kostpris.ToString("0.##", CultureInfo.InvariantCulture)" aria-label="Kostpris" @onchange="@(e => Endre(kode, x => x.Kostpris = Tall(e) ?? x.Kostpris, "Kostprisen"))" /><em>kr</em>} else {<span class="kt-svak">–</span>}</span></td>
                                        <td class="n"><span class="kt-med"><input class="kt-inp kt-tall" inputmode="decimal" value="@k.Salgspris.ToString("0.##", CultureInfo.InvariantCulture)" aria-label="Salgspris" @onchange="@(e => Endre(kode, x => x.Salgspris = Tall(e) ?? x.Salgspris, "Salgsprisen"))" /><em>@(prosent ? "%" : "kr")</em></span></td>
                                        <td class="n">
                                            @if (!prosent && k.Salgspris > 0)
                                            {
                                                var dg = (k.Salgspris - k.Kostpris) / k.Salgspris * 100;
                                                <span class="kt-dg @(dg >= 40 ? "ok" : dg >= 25 ? "lav" : "rod")">@dg.ToString("0", Kultur) %</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="kt-flagg">
                                                <label class="kt-tg" title="Kommer opp når man søker på tilbudet"><input type="checkbox" checked="@k.VisPaTilbud" @onchange="@(e => Endre(kode, x => x.VisPaTilbud = e.Value is true, null))" /><span class="kt-sw"></span>Tilbud</label>
                                                @if (!prosent)
                                                {
                                                    <label class="kt-tg" title="Montøren kan velge koden selv (timer, kjøring og tillegg på arbeidsordren)"><input type="checkbox" checked="@k.MontorKanFore" @onchange="@(e => Endre(kode, x => x.MontorKanFore = e.Value is true, null))" /><span class="kt-sw"></span>Montør</label>
                                                }
                                            </div>
                                        </td>
                                        <td class="kt-hoyre-c">
                                            @if (k.Aktiv)
                                            {
                                                <button type="button" class="kt-ik" title="Deaktiver – kommer ikke lenger opp på nye tilbud" @onclick="@(() => SettAktiv(kode, false))"><Icon Name="x" /></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="kt-knapp kt-knapp-s" @onclick="@(() => SettAktiv(kode, true))">Aktiver</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        <p class="kt-fot">Prosentkoder regner seg selv i tilbudet: «% av varer» av varenes utpris (som småmateriell), og «% av arbeid» / «% av montasje» av arbeidslinjene (som rigg og drift). Koden merket Montasjetid får timene fra varenes montasjetid, og kostprisen og salgsprisen på den er standard timekost og timepris på nye tilbud. Koden «Prosjektledelse» er standard for prosjektledelse. Kunder med fast timepris på kundekortet får sin egen timepris i stedet. Varer som skal på tilbudet, men ikke på plukklisten (skruer, plugger o.l.), merkes «Forbruksvare» på varen.</p>
    </div>

    <aside class="kt-side">
        <div class="kt-kort">
            <div class="kt-kh"><Icon Name="search" />Slik ser det ut på tilbudet</div>
            <div class="kt-kb">
                <label class="kt-sok"><Icon Name="search" /><input type="search" @bind="_sok" @bind:event="oninput" @bind:after="SokVarer" placeholder="Skriv kode eller navn …" /></label>
                @{ var treff = KodeTreff(); }
                @if (_sok.Trim().Length == 0)
                {
                    <span class="kt-svak">Prøv «km», «100» eller «overtid». Koder står øverst, varer under – som i søket på tilbudet.</span>
                }
                else if (treff.Count == 0 && _vareTreff.Count == 0)
                {
                    <span class="kt-svak">Ingen treff.</span>
                }
                else
                {
                    <div class="kt-res">
                        @if (treff.Count > 0)
                        {
                            <div class="kt-res-sk">Koder</div>
                            @foreach (var k in treff)
                            {
                                <div class="kt-res-r"><span class="kt-badge">@k.Kode</span><span><b>@k.Navn</b><small>@GruppeNavn(k.Type) · @(k.Enhet.ErProsent() ? $"{k.Salgspris.ToString("0.##", Kultur)} {k.Enhet.Navn()}" : $"{k.Salgspris.ToString("N0", Kultur)} kr / {k.Enhet.Navn()}")</small></span></div>
                            }
                        }
                        @if (_vareTreff.Count > 0)
                        {
                            <div class="kt-res-sk">Varer</div>
                            @foreach (var v in _vareTreff)
                            {
                                <div class="kt-res-r"><span class="kt-badge kt-badge-vare">vare</span><span><b>@v.Navn</b><small>@(string.Join(" · ", new[] { v.Leverandor, v.Produktkode }.Where(s => !string.IsNullOrWhiteSpace(s))))</small></span></div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        <div class="kt-kort">
            <div class="kt-kh"><Icon Name="check-circle" />Hvor kodene brukes</div>
            <div class="kt-kb kt-liste">
                <span><b>Tilbud</b>Koder med «Tilbud» på kommer opp i søket sammen med varene.</span>
                <span><b>Montør</b>Montøren kan velge koden selv når timer føres, og kjøring og tillegg på arbeidsordren.</span>
                <span><b>Plukkliste</b>Koder kommer aldri på plukklisten. Varer merket «Forbruksvare» heller ikke.</span>
                <span><b>@Okonomi.Navn</b>Koden er varenummeret fakturalinjen havner på.</span>
            </div>
        </div>
    </aside>
</div>

@if (_nyApen)
{
    <div class="kt-bak" @onclick="@(() => _nyApen = false)">
        <div class="kt-dlg" role="dialog" aria-modal="true" aria-label="Ny kode" @onclick:stopPropagation="true">
            <div class="kt-dh">Ny kode</div>
            <div class="kt-db">
                <div class="kt-felt">
                    <small>Hva slags kode</small>
                    <div class="kt-typer">
                        @foreach (var g in Grupper.Where(g => g.Type != PrisKodeType.Annet))
                        {
                            var gruppe = g;
                            <button type="button" class="@(_ny.Type == g.Type ? "pa" : "")" @onclick="@(() => VelgNyType(gruppe.Type))"><span class="kt-gi kt-gi-@g.Klasse"><Icon Name="@g.Ikon" /></span>@g.Kort</button>
                        }
                    </div>
                </div>
                <div class="kt-g2">
                    <div class="kt-felt"><small>Kode (varenr. @Okonomi.INavn)</small><input @bind="_ny.Kode" @bind:event="oninput" /></div>
                    <div class="kt-felt"><small>Navn</small><input @bind="_ny.Navn" @bind:event="oninput" placeholder="@NavnHint" /></div>
                </div>
                <div class="kt-g3">
                    <div class="kt-felt">
                        <small>Enhet</small>
                        <select @bind="_ny.Enhet">
                            @foreach (var en in Enum.GetValues<PrisKodeEnhet>())
                            {
                                <option value="@en">@en.Navn()</option>
                            }
                        </select>
                    </div>
                    <div class="kt-felt"><small>Kostpris</small><input type="number" step="any" @bind="_ny.Kostpris" disabled="@_ny.Enhet.ErProsent()" /></div>
                    <div class="kt-felt"><small>@(_ny.Enhet.ErProsent() ? "Prosent" : "Salgspris")</small><input type="number" step="any" @bind="_ny.Salgspris" /></div>
                </div>
                @if (!string.IsNullOrEmpty(_nyFeil))
                {
                    <p class="kt-melding kt-melding-feil">@_nyFeil</p>
                }
            </div>
            <div class="kt-df">
                <button type="button" class="kt-knapp" @onclick="@(() => _nyApen = false)">Avbryt</button>
                <button type="button" class="kt-knapp kt-knapp-p" @onclick="OpprettNy">Opprett</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Kultur = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly TimeregistreringType[] Timetyper = [TimeregistreringType.NormalArbeidstid, TimeregistreringType.Overtid50, TimeregistreringType.Overtid100];

    private sealed record Gruppe(PrisKodeType Type, string Navn, string Kort, string Forklaring, string Ikon, string Klasse);

    private static readonly Gruppe[] Grupper =
    [
        new(PrisKodeType.Arbeid, "Timer", "Timer", "Arbeidskoder – timetypen følger med til timeføring og lønn", "clock", "arbeid"),
        new(PrisKodeType.Kjoring, "Kjøring", "Kjøring", "Kilometer, utkjøringstillegg og bomtur", "map", "kjoring"),
        new(PrisKodeType.Materiell, "Festemateriell og forbruk", "Festemateriell", "Skruer, plugger, silikon og småmateriell – på tilbudet, ikke på plukklisten", "tool", "materiell"),
        new(PrisKodeType.Tillegg, "Tillegg", "Tillegg", "Rigg og drift, frakt og gebyrer", "plus", "tillegg"),
        new(PrisKodeType.Annet, "Annet", "Annet", "Koder hentet fra Tripletex som ikke har fått type ennå", "tag", "annet"),
    ];

    private static string GruppeNavn(PrisKodeType t) => Grupper.First(g => g.Type == t).Kort;

    private List<PrisKode> _koder = [];
    private bool _lastet;
    private string? _melding;
    private bool _feil;
    private Func<Task>? _angre;

    private string _sok = "";
    private List<Component> _vareTreff = [];

    private List<TripletexService.TripletexProdukt>? _produkter;
    private readonly HashSet<string> _valgte = [];
    private bool _henter;

    private bool _nyApen;
    private string? _nyFeil;
    private NyKode _ny = new();

    private sealed class NyKode
    {
        public PrisKodeType Type { get; set; }
        public string Kode { get; set; } = "";
        public string Navn { get; set; } = "";
        public PrisKodeEnhet Enhet { get; set; }
        public decimal Kostpris { get; set; }
        public decimal Salgspris { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Last();
        _lastet = true;
    }

    private async Task Last() =>
        _koder = (await PrisKodeSvc.AlleAsync()).OrderBy(k => !k.Aktiv).ThenBy(k => k.Rekkefolge).ThenBy(k => k.Kode).ToList();

    private static decimal? Tall(ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString()?.Replace(" ", "").Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) && v >= 0 ? v : null;

    private void Melding(string tekst, bool feil = false, Func<Task>? angre = null)
    {
        _melding = tekst;
        _feil = feil;
        _angre = angre;
    }

    private async Task Angre()
    {
        var a = _angre;
        _angre = null;
        _melding = null;
        if (a is not null)
        {
            await a();
        }
    }

    private async Task Endre(PrisKode k, Action<PrisKode> endring, string? hva)
    {
        var forKode = k.Kode;
        var entry = Db.Entry(k);
        var gamle = entry.CurrentValues.Clone();
        endring(k);
        if (string.IsNullOrWhiteSpace(k.Kode) || string.IsNullOrWhiteSpace(k.Navn))
        {
            entry.CurrentValues.SetValues(gamle);
            Melding("Kode og navn må fylles ut.", true);
            return;
        }

        if (k.Kode != forKode && _koder.Any(x => x != k && x.Kode == k.Kode))
        {
            entry.CurrentValues.SetValues(gamle);
            Melding($"Koden {k.Kode} finnes allerede.", true);
            return;
        }

        if (k.ErMontasje && (k.Type != PrisKodeType.Arbeid || k.Enhet != PrisKodeEnhet.Time))
        {
            k.ErMontasje = false;
        }

        await Db.SaveChangesAsync();
        var tekst = k.Kode != forKode
            ? $"Koden er endret fra {forKode} til {k.Kode}. Nye tilbud bruker {k.Kode}."
            : hva is null ? $"{k.Kode} {k.Navn} er lagret." : $"{hva} på {k.Kode} er lagret.";
        Melding(tekst, angre: async () =>
        {
            entry.CurrentValues.SetValues(gamle);
            await Db.SaveChangesAsync();
        });
    }

    private async Task SettMontasje(PrisKode valgt)
    {
        foreach (var k in _koder)
        {
            k.ErMontasje = k == valgt;
        }

        await Db.SaveChangesAsync();
        Melding($"Timene fra varenes montasjetid legges nå på {valgt.Kode} {valgt.Navn}.");
    }

    private async Task SettAktiv(PrisKode k, bool aktiv)
    {
        k.Aktiv = aktiv;
        await Db.SaveChangesAsync();
        Melding(aktiv ? $"{k.Kode} {k.Navn} er aktiv igjen." : $"{k.Kode} {k.Navn} er deaktivert. Tilbud som allerede har linjen, beholder den.",
            angre: async () =>
            {
                k.Aktiv = !aktiv;
                await Db.SaveChangesAsync();
            });
    }

    private List<PrisKode> KodeTreff()
    {
        var sok = _sok.Trim();
        if (sok.Length == 0)
        {
            return [];
        }

        return _koder
            .Where(k => k.Aktiv && k.VisPaTilbud)
            .Where(k => k.Kode.StartsWith(sok, StringComparison.OrdinalIgnoreCase) || k.Navn.Contains(sok, StringComparison.OrdinalIgnoreCase))
            .Take(6)
            .ToList();
    }

    private async Task SokVarer()
    {
        var sok = _sok.Trim();
        if (sok.Length < 2)
        {
            _vareTreff = [];
            return;
        }

        _vareTreff = await Db.Components.AsNoTracking()
            .Where(c => c.Aktiv && (ApplicationDbContext.InneholderUavhengigAvStorForbokstav(c.Navn, sok)
                || ApplicationDbContext.InneholderUavhengigAvStorForbokstav(c.Produktkode, sok)))
            .OrderBy(c => c.Navn)
            .Take(3)
            .ToListAsync();
    }

    // ---------- Ny kode ----------
    private string NavnHint => _ny.Type switch
    {
        PrisKodeType.Kjoring => "F.eks. Bomtur",
        PrisKodeType.Materiell => "F.eks. Festemateriell dør",
        PrisKodeType.Tillegg => "F.eks. Frakt",
        _ => "F.eks. Programmering"
    };

    private void ApneNy(PrisKodeType type)
    {
        _ny = new NyKode();
        VelgNyType(type);
        _nyFeil = null;
        _nyApen = true;
    }

    private void VelgNyType(PrisKodeType type)
    {
        _ny.Type = type;
        _ny.Enhet = type switch
        {
            PrisKodeType.Arbeid => PrisKodeEnhet.Time,
            PrisKodeType.Kjoring => PrisKodeEnhet.Km,
            PrisKodeType.Tillegg => PrisKodeEnhet.Stk,
            _ => PrisKodeEnhet.Stk
        };
        // Neste ledige nummer i samme serie som de andre kodene av samme type.
        var serie = _koder.Where(k => k.Type == type).Select(k => int.TryParse(k.Kode, out var n) ? n : (int?)null).Where(n => n is not null).Select(n => n!.Value).ToList();
        var forslag = serie.Count > 0 ? (serie.Max() + 1).ToString() : PrisKodeService.NesteKode(_koder);
        if (_koder.Any(k => k.Kode == forslag))
        {
            forslag = PrisKodeService.NesteKode(_koder);
        }
        _ny.Kode = forslag;
    }

    private async Task OpprettNy()
    {
        var kode = _ny.Kode.Trim();
        var navn = _ny.Navn.Trim();
        if (kode.Length == 0 || navn.Length == 0)
        {
            _nyFeil = "Kode og navn må fylles ut.";
            return;
        }

        if (_koder.Any(k => k.Kode == kode))
        {
            _nyFeil = $"Koden {kode} finnes allerede.";
            return;
        }

        var k = new PrisKode
        {
            Kode = kode,
            Navn = navn,
            Type = _ny.Type,
            Enhet = _ny.Enhet,
            Kostpris = _ny.Enhet.ErProsent() ? 0 : Math.Max(0, _ny.Kostpris),
            Salgspris = Math.Max(0, _ny.Salgspris),
            Rekkefolge = _koder.Count == 0 ? 0 : _koder.Max(x => x.Rekkefolge) + 1,
            MontorKanFore = _ny.Type != PrisKodeType.Tillegg
        };
        Db.PrisKoder.Add(k);
        await Db.SaveChangesAsync();
        await Last();
        _nyApen = false;
        Melding($"Kode {k.Kode} «{k.Navn}» er opprettet.");
    }

    private async Task BrukStandard()
    {
        await PrisKodeSvc.SikreStandardAsync();
        await Last();
        Melding("Standardkodene er lagt inn. Juster prisene så de stemmer med deres.");
    }

    // ---------- Tripletex ----------
    // Kodene synkes begge veier (se TripletexSyncService.SynkroniserVarerOgKoderAsync).
    private async Task SynkTripletex()
    {
        _henter = true;
        try
        {
            var r = await TripletexSync.SynkroniserVarerOgKoderAsync();
            await Last();
            var tekst = $"Synket med Tripletex: {r.KoderSendt} {(r.KoderSendt == 1 ? "kode" : "koder")} sendt, {r.KoderHentet} hentet, {r.VarerHentet} nye varer hentet.";
            Melding(r.Feil.Count == 0 ? tekst : $"{tekst} {r.Feil.Count} feil: {r.Feil[0]}", r.Feil.Count > 0);
        }
        finally
        {
            _henter = false;
        }
    }

    private async Task ApneTripletex()
    {
        _henter = true;
        try
        {
            var (produkter, feil) = await Tripletex.HentProdukterAsync();
            if (feil is not null)
            {
                Melding($"Fikk ikke hentet produktene fra Tripletex: {feil}", true);
                return;
            }

            _produkter = produkter;
            _valgte.Clear();
            _melding = null;
        }
        finally
        {
            _henter = false;
        }
    }

    private void Velg(string nummer, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _valgte.Add(nummer);
        }
        else
        {
            _valgte.Remove(nummer);
        }
    }

    private async Task LeggTilValgte()
    {
        if (_produkter is null)
        {
            return;
        }

        var rekkefolge = _koder.Count == 0 ? 0 : _koder.Max(x => x.Rekkefolge) + 1;
        var nye = _produkter.Where(p => _valgte.Contains(p.Nummer) && _koder.All(k => k.Kode != p.Nummer)).ToList();
        foreach (var p in nye)
        {
            Db.PrisKoder.Add(new PrisKode
            {
                Kode = p.Nummer,
                Navn = p.Navn,
                Type = PrisKodeType.Annet,
                Enhet = PrisKodeEnhet.Stk,
                Kostpris = p.Kostpris ?? 0,
                Salgspris = p.Salgspris ?? 0,
                Rekkefolge = rekkefolge++
            });
        }

        await Db.SaveChangesAsync();
        await Last();
        _produkter = null;
        _valgte.Clear();
        Melding($"{nye.Count} {(nye.Count == 1 ? "kode" : "koder")} er hentet fra Tripletex og ligger under «Annet». Bruk «Flytt til …» for å legge dem i riktig gruppe.");
    }
}
