@using PortalItlock.Web.Services
@inject VisningPreferanseService VisningPref

@* Felles hvitt kort for en hel side: ligger til venstre (1320 px) og kan
   utvides til hele vinduet med knappen øverst til høyre. Valget huskes per
   bruker og side (Nokkel). *@
<div class="sk @(_full ? "sk-full" : "")">
    <div class="sk-innhold">@ChildContent</div>
    <button type="button" class="sk-utvid" title="@(_full ? "Vanlig bredde" : "Utvid til hele vinduet")" @onclick="Veksl">
        <Icon Name="@(_full ? "minimize" : "maximize")" />
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Nokkel { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _full;

    protected override async Task OnInitializedAsync()
    {
        _full = await VisningPref.HentAsync($"{Nokkel}-bredde", "normal") == "full";
    }

    private async Task Veksl()
    {
        _full = !_full;
        await VisningPref.SettAsync($"{Nokkel}-bredde", _full ? "full" : "normal");
    }
}
