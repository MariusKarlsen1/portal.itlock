@code {
    // Organisasjonens valgte fargetema (satt av plattformeier på /plattform,
    // se OrganisasjonTema.Alle) overstyrer standardfargene for akkurat denne
    // organisasjonen. "Standard" er identisk med app.css sine standardverdier,
    // så den trenger ingen overstyring - kun ikke-standard temaer skriver
    // ut et :root-block.
    // Valgt tema for organisasjonen, eller null for standard (Varmbrun).
    private PortalItlock.Web.Models.OrganisasjonTema? Tema =>
        string.IsNullOrWhiteSpace(TenantCtx.Current?.Tema) || TenantCtx.Current!.Tema == PortalItlock.Web.Models.OrganisasjonTema.Standard.Id
            ? null
            : PortalItlock.Web.Models.OrganisasjonTema.FraId(TenantCtx.Current!.Tema);

    private string? ThemeStyleBlock
    {
        get
        {
            var temaId = TenantCtx.Current?.Tema;
            if (string.IsNullOrWhiteSpace(temaId) || temaId == PortalItlock.Web.Models.OrganisasjonTema.Standard.Id)
            {
                return null;
            }

            var tema = PortalItlock.Web.Models.OrganisasjonTema.FraId(temaId);
            var kant = tema.Kant is null ? "" : $":root:not([data-theme=\"dark\"]){{--itlock-border:{tema.Kant} !important;--itlock-korn:none !important;}}";
            // Bakgrunnsfargen er lys, så den gjelder bare i lys modus og på
            // mobil (som alltid er lys) - ellers ble mørk modus lys igjen.
            return ":root{" +
                $"--itlock-accent:{tema.Primaer} !important;" +
                $"--itlock-accent-hover:{tema.PrimaerHover} !important;" +
                $"--itlock-sekundaer:{tema.Sekundaer} !important;" +
                $"--itlock-sekundaer-lys:{tema.SekundaerLys} !important;" +
                $"--itlock-primaer-lys:{tema.PrimaerLys} !important;" +
                "}" +
                $":root:not([data-theme=\"dark\"]){{--itlock-bg:{tema.Bakgrunn} !important;}}" +
                $"@media (max-width:640.98px){{:root{{--itlock-bg:{tema.Bakgrunn} !important;--itlock-accent:{tema.Primaer} !important;--itlock-accent-hover:{tema.PrimaerHover} !important;}}}}" + kant;
        }
    }
}
