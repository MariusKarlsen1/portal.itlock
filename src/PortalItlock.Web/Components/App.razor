<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#835e41" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Full Kontroll" />
    <link rel="manifest" href="manifest.json" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Fraunces:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="app.css?v=10" />
    <link rel="stylesheet" href="PortalItlock.Web.styles.css?v=352" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <style>
        /* Blazor sin innebygde gjenoppkoblings-UI viser og skjuler disse
           klassene automatisk på #components-reconnect-modal etter hvert som
           SignalR-tilkoblingen endrer status. Uten denne CSS-en er elementet
           usynlig, og en mistet krets (f.eks. en stille avbrutt/gjenopprettet
           tilkobling - se kommentar i Program.cs om meldinger over 32 KB) gir
           ingen synlig tilbakemelding: siden ser ut som normalt, men klikk på
           knapper/markører gjør ingenting fordi de gamle JS-referansene peker
           mot en krets som ikke lenger finnes. Skriptet under tvinger derfor
           en automatisk sideoppfriskning når gjenoppkobling mislykkes eller
           blir avvist, slik at man alltid havner i en frisk, fungerende
           tilstand i stedet for å bli stående fast uten feilmelding.
        */
        #components-reconnect-modal {
            display: none;
        }

            #components-reconnect-modal.components-reconnect-show,
            #components-reconnect-modal.components-reconnect-failed,
            #components-reconnect-modal.components-reconnect-rejected {
                display: block;
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 3000;
                background: #835e41;
                color: #fff;
                text-align: center;
                padding: 0.5rem 1rem;
                font: 600 0.85rem system-ui, sans-serif;
            }
    </style>
    <script>
        (function () {
            var t = localStorage.getItem('itlock-theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-theme', t);
            }
            if (localStorage.getItem('itlock-biler') === 'kjorer') {
                document.documentElement.setAttribute('data-biler', 'kjorer');
            }
            if (localStorage.getItem('itlock-sidebar') === 'collapsed') {
                document.documentElement.setAttribute('data-sidebar', 'collapsed');
            }
            // Forsiden ("/") er full skrivebordsvisning (aktive prosjekter for
            // montører/admin/prosjektleder) og hører ikke hjemme i mobilvisningen,
            // som er begrenset til bunn-fanens 5 funksjoner. Send derfor rett til
            // Oppgaver (Min dag) hvis man havner på "/" på mobil - typisk rett
            // etter innlogging. Kjøres blokkerende i <head> før <body> males, så
            // skrivebordsinnholdet rekker ikke å vises.
            if (window.matchMedia('(max-width: 640.98px)').matches && window.location.pathname === '/') {
                window.location.replace('/min-dag');
            }
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="components-reconnect-modal">Kobler til på nytt …</div>
    <script src="_framework/blazor.web.js"></script>
    <script>
        (function () {
            var modal = document.getElementById('components-reconnect-modal');
            if (!modal) {
                return;
            }
            var harLastetPaNytt = false;
            new MutationObserver(function () {
                var mislykket = modal.classList.contains('components-reconnect-failed') ||
                    modal.classList.contains('components-reconnect-rejected');
                if (mislykket && !harLastetPaNytt) {
                    harLastetPaNytt = true;
                    window.location.reload();
                }
            }).observe(modal, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
    <script src="js/richtext.js?v=4"></script>
    <script src="js/signatur.js?v=2"></script>
    <script src="js/theme.js"></script>
    <script src="js/sidebar.js?v=19"></script>
    <script src="js/biler.js?v=2"></script>
    <script src="js/tabellscroll.js"></script>
    <script src="js/ressursplanlegger.js"></script>
    <script src="js/tilbudlinjer.js"></script>
    <script src="js/vareBilde.js"></script>
    <script src="js/aiassistent.js"></script>
    <script src="js/offline.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="js/kart.js?v=2"></script>
</body>

</html>
