<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script>
        // «Gå til fullversjon» på mobil: siden tegnes med PC-bredde, så alt ser
        // ut og virker som på PC (zoom med to fingre). Valget gjelder bare
        // økten (sessionStorage og en øktkapsel, se settFullversjon i
        // sidebar.js) og nullstilles på innloggingssiden, så mobilen alltid
        // starter i mobilvisning etter innlogging.
        try {
            localStorage.removeItem('itlock-fullversjon');
            if (location.pathname.toLowerCase().indexOf('/login') === 0) {
                sessionStorage.removeItem('itlock-fullversjon');
                document.cookie = 'itlock-fullversjon=; path=/; max-age=0; samesite=lax';
            }
            // Kapsel fra før valget ble øktbasert (husket i et år): fjernes når
            // økten ikke har valgt fullversjon.
            if (sessionStorage.getItem('itlock-fullversjon') !== '1' && location.search.indexOf('fullversjon=1') < 0) {
                document.cookie = 'itlock-fullversjon=; path=/; max-age=0; samesite=lax';
            }
            if (location.search.indexOf('fullversjon=1') >= 0 || sessionStorage.getItem('itlock-fullversjon') === '1') {
                document.querySelector('meta[name=viewport]').setAttribute('content', 'width=1280, viewport-fit=cover');
            }
        } catch (e) { }
    </script>
    <meta name="theme-color" content="#835e41" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Full Kontroll" />
    <link rel="manifest" href="manifest.json" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
    <link rel="stylesheet" href="@PortalItlock.Web.Services.TemaCss.Href(Tema, "app.css", 28)" />
    <link rel="stylesheet" href="@PortalItlock.Web.Services.TemaCss.Href(Tema, "montorapp.css", 20)" />
    <link rel="stylesheet" href="kassa.css?v=4" />
    <link rel="stylesheet" href="@PortalItlock.Web.Services.TemaCss.Href(Tema, "drift.css", 7)" />
    <link rel="stylesheet" href="@PortalItlock.Web.Services.TemaCss.Href(Tema, "PortalItlock.Web.styles.css", 909)" />
    @if (ThemeStyleBlock is not null)
    {
        <style>@((MarkupString)ThemeStyleBlock)</style>
    }
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        (function () {
            // Lys, Mørk eller Auto (følger systemet). Auto settes også som
            // data-theme, så de mørke reglene bare trenger å se på attributtet.
            var t = localStorage.getItem('itlock-theme');
            if (t !== 'dark' && t !== 'light') {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
            if (localStorage.getItem('itlock-font') === 'vanlig') {
                document.documentElement.setAttribute('data-font', 'vanlig');
            }
            if (localStorage.getItem('itlock-biler') === 'kjorer') {
                document.documentElement.setAttribute('data-biler', 'kjorer');
            }
            if (localStorage.getItem('itlock-sidebar') === 'collapsed') {
                document.documentElement.setAttribute('data-sidebar', 'collapsed');
            }
            // Sidebredde-valget i brukermenyen er fjernet - rydd bort det lagrede valget.
            localStorage.removeItem('itlock-bredde');
            // Forsiden ("/") er full skrivebordsvisning (aktive prosjekter for
            // montører/admin/prosjektleder) og hører ikke hjemme i mobilvisningen,
            // som er begrenset til bunn-fanens 5 funksjoner. Send derfor rett til
            // montørforsiden (/app) hvis man havner på "/" på mobil - typisk rett
            // etter innlogging. Kjøres blokkerende i <head> før <body> males, så
            // skrivebordsinnholdet rekker ikke å vises.
            // Unntak: «Gå til fullversjon» (?fullversjon=1 eller lagret valg) skal vise forsiden.
            var fullversjon = window.location.search.indexOf('fullversjon') >= 0;
            try { fullversjon = fullversjon || sessionStorage.getItem('itlock-fullversjon') === '1'; } catch (e) { }
            if (!fullversjon && window.matchMedia('(max-width: 640.98px)').matches && window.location.pathname === '/') {
                window.location.replace('/app');
            }
        })();
    </script>
    <HeadOutlet />
</head>

