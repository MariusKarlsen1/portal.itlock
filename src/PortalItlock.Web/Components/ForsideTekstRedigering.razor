<div class="tekstverktoy-toolbar">
    <button type="button" title="Fet skrift" @onclick="@(() => WrapSelection("**", "**"))"><b>B</b></button>
    <button type="button" title="STORE BOKSTAVER" @onclick="Uppercase">AA</button>
    <button type="button" title="Overskrift" @onclick="@(() => LinePrefix("# "))">H1</button>
    <button type="button" title="Underoverskrift" @onclick="@(() => LinePrefix("## "))">H2</button>
    <select @bind="_valgtStorrelse" @bind:after="ApplySize" title="Skriftstørrelse">
        <option value="">Størrelse...</option>
        <option value="8">Liten</option>
        <option value="14">Stor</option>
        <option value="20">Ekstra stor</option>
    </select>
    <select @bind="_valgtFont" @bind:after="ApplyFont" title="Skrifttype">
        <option value="">Skrifttype...</option>
        <option value="Arial">Arial</option>
        <option value="Georgia">Georgia</option>
        <option value="Courier New">Courier New</option>
        <option value="Times New Roman">Times New Roman</option>
    </select>
</div>
<textarea id="@_id" rows="@Rows" value="@Value" @oninput="OnInput" placeholder="@Placeholder"></textarea>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 8;
    [Parameter] public string? Placeholder { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private readonly string _id = $"forside-tekst-{Guid.NewGuid():N}";
    private string _valgtStorrelse = "";
    private string _valgtFont = "";
    private bool _sporingStartet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sporingStartet)
        {
            _sporingStartet = true;
            await JS.InvokeVoidAsync("tekstverktoy.trackSelection", _id);
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task WrapSelection(string before, string after)
    {
        Value = await JS.InvokeAsync<string>("tekstverktoy.wrapSelection", _id, before, after);
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task Uppercase()
    {
        Value = await JS.InvokeAsync<string>("tekstverktoy.uppercaseSelection", _id);
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task LinePrefix(string prefix)
    {
        Value = await JS.InvokeAsync<string>("tekstverktoy.insertAtLineStart", _id, prefix);
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ApplySize()
    {
        if (string.IsNullOrEmpty(_valgtStorrelse))
        {
            return;
        }

        await WrapSelection($"{{{{size={_valgtStorrelse}}}}}", "{{/size}}");
        _valgtStorrelse = "";
    }

    private async Task ApplyFont()
    {
        if (string.IsNullOrEmpty(_valgtFont))
        {
            return;
        }

        await WrapSelection($"{{{{font={_valgtFont}}}}}", "{{/font}}");
        _valgtFont = "";
    }
}
