@implements IAsyncDisposable

<div class="rte">
    <div class="rte-toolbar">
        <button type="button" title="Angre" @onclick="@(() => Exec("undo"))">↶</button>
        <button type="button" title="Gjør om" @onclick="@(() => Exec("redo"))">↷</button>
        <span class="rte-sep"></span>
        <select @onchange="OnFormatBlockChanged" title="Avsnittstype">
            <option value="p">Normal tekst</option>
            <option value="h1">Overskrift 1</option>
            <option value="h2">Overskrift 2</option>
            <option value="h3">Overskrift 3</option>
        </select>
        <span class="rte-sep"></span>
        <select id="@($"{_id}-size")" title="Skriftstørrelse">
            <option value="">Str.</option>
            @foreach (var s in FontSizes)
            {
                <option value="@s">@s</option>
            }
        </select>
        <span class="rte-sep"></span>
        <button type="button" title="Fet skrift" @onclick="@(() => Exec("bold"))"><b>F</b></button>
        <button type="button" title="Kursiv" @onclick="@(() => Exec("italic"))"><i>K</i></button>
        <button type="button" title="Understrek" @onclick="@(() => Exec("underline"))"><u>U</u></button>
        <span class="rte-sep"></span>
        <button type="button" title="Punktliste" @onclick="@(() => Exec("insertUnorderedList"))">• Liste</button>
        <button type="button" title="Nummerert liste" @onclick="@(() => Exec("insertOrderedList"))">1. Liste</button>
        <span class="rte-sep"></span>
        <button type="button" title="Venstrejuster" @onclick="@(() => Exec("justifyLeft"))">⟵</button>
        <button type="button" title="Midtstill" @onclick="@(() => Exec("justifyCenter"))">↔</button>
        <button type="button" title="Høyrejuster" @onclick="@(() => Exec("justifyRight"))">⟶</button>
        <span class="rte-sep"></span>
        <button type="button" title="Sett inn lenke" @onclick="InsertLink">🔗</button>
    </div>
    <div id="@_id" class="rte-content" contenteditable="true" style="min-height: @(Rows * 1.6)em"
         data-placeholder="@Placeholder"></div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 8;
    [Parameter] public string? Placeholder { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private readonly string _id = $"rte-{Guid.NewGuid():N}";
    private DotNetObjectReference<ForsideTekstRedigering>? _selfRef;
    private bool _initialized;
    private string? _lastAppliedValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _lastAppliedValue = Value;
            await JS.InvokeVoidAsync("richtext.init", _id, Value, _selfRef);
            _initialized = true;
        }
        else if (_initialized && Value != _lastAppliedValue)
        {
            _lastAppliedValue = Value;
            await JS.InvokeVoidAsync("richtext.setHtml", _id, Value);
        }
    }

    [JSInvokable]
    public async Task OnHtmlChanged(string html)
    {
        Value = html;
        _lastAppliedValue = html;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task Exec(string command)
    {
        await JS.InvokeVoidAsync("richtext.exec", _id, command);
    }

    private async Task OnFormatBlockChanged(ChangeEventArgs e)
    {
        var tag = e.Value?.ToString();
        if (!string.IsNullOrEmpty(tag))
        {
            await JS.InvokeVoidAsync("richtext.formatBlock", _id, tag);
        }
    }

    private static readonly int[] FontSizes = [12, 14, 16, 18, 20, 24, 28, 32, 40];

    private async Task InsertLink()
    {
        await JS.InvokeVoidAsync("richtext.insertLink", _id);
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        await Task.CompletedTask;
    }
}
